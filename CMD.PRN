  0B7F'   B7                    	ORA	A
  0B80'   CA 0B5E'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0B83'   CD 0BAF'              	CALL	LNINC
  0B86'   3E 01                 	MVI	A,1
  0B88'   C9                    	RET
  0B89'                         IC_END:
  0B89'   3E FF                 	MVI	A,0FFH
  0B8B'   B7                    	ORA	A
  0B8C'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0B8D'                         DECC:
  0B8D'   CD 0000*              	CALL	PEEKL
  0B90'   DA 0B89'              	JC	IC_END
  0B93'   F5                    	PUSH	PSW
  0B94'   CD 0000*              	CALL	PUTCUR
  0B97'   F1                    	POP	PSW
  0B98'   FE 0A                 	CPI	LF
  0B9A'   3E 00                 	MVI	A,0
  0B9C'   C0                    	RNZ
  0B9D'   CD 0BBD'              	CALL	LNDEC
  0BA0'   CD 0000*              	CALL	PEEKL		; onto its CR
  0BA3'   DA 0BAB'              	JC	DC_1
  0BA6'   FE 0D                 	CPI	CR
  0BA8'   CC 0000*              	CZ	PUTCUR
  0BAB'                         DC_1:
  0BAB'   3E 01                 	MVI	A,1
  0BAD'   B7                    	ORA	A
  0BAE'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0BAF'                         LNINC:
  0BAF'   E5                    	PUSH	H
  0BB0'   2A 0000*              	LHLD	LNDLT
  0BB3'   7C                    	MOV	A,H
  0BB4'   FE 40                 	CPI	40H
  0BB6'   CA 0BCB'              	JZ	LN_X
  0BB9'   23                    	INX	H
  0BBA'   C3 0BC8'              	JMP	LN_ST
  0BBD'                         LNDEC:
  0BBD'   E5                    	PUSH	H
  0BBE'   2A 0000*              	LHLD	LNDLT
  0BC1'   7C                    	MOV	A,H
  0BC2'   FE C0                 	CPI	0C0H
  0BC4'   CA 0BCB'              	JZ	LN_X
  0BC7'   2B                    	DCX	H
  0BC8'                         LN_ST:
  0BC8'   22 0000*              	SHLD	LNDLT
  0BCB'                         LN_X:
  0BCB'   E1                    	POP	H
  0BCC'   C9                    	RET
                                
  0BCD'   AF                    VC_E:	XRA	A
  0BCE'   32 2908'              	STA	WBIG
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0BD1'   C3 0BD9'              	JMP	EDO
  0BD4'   3E 01                 VCBGE:	MVI	A,1
  0BD6'   32 2908'              	STA	WBIG
  0BD9'   CD 06EB'              EDO:	CALL	SETMOV
  0BDC'   CD 067E'              	CALL	GETCNT
  0BDF'   22 2940'              	SHLD	CNTV
  0BE2'   2A 2940'              EDO_LP: LHLD	CNTV
  0BE5'   7C                    	MOV	A,H
  0BE6'   B5                    	ORA	L
  0BE7'   C8                    	RZ
  0BE8'   2B                    	DCX	H
  0BE9'   22 2940'              	SHLD	CNTV
  0BEC'   CD 0BF2'              	CALL	ESTEP
  0BEF'   C3 0BE2'              	JMP	EDO_LP
                                
                                ;ESTEP -- forward to the end of the next word.
  0BF2'                         ESTEP:
  0BF2'   CD 0000*              	CALL	CUROFF
  0BF5'   22 2944'              	SHLD	WKI
  0BF8'   CD 0000*              	CALL	LOGLEN
  0BFB'   22 2946'              	SHLD	WKN
  0BFE'   2A 2944'              	LHLD	WKI
  0C01'   23                    	INX	H
  0C02'   22 2944'              	SHLD	WKI
  0C05'                         ES_WS:
  0C05'   2A 2944'              	LHLD	WKI
  0C08'   EB                    	XCHG
  0C09'   2A 2946'              	LHLD	WKN
  0C0C'   CD 0000*              	CALL	CMP16
  0C0F'   D2 0C5D'              	JNC	ES_LND
  0C12'   2A 2944'              	LHLD	WKI
  0C15'   CD 0000*              	CALL	CHARAT
  0C18'   CD 06A0'              	CALL	CLASSF
  0C1B'   B7                    	ORA	A
  0C1C'   C2 0C29'              	JNZ	ES_WD
  0C1F'   2A 2944'              	LHLD	WKI
  0C22'   23                    	INX	H
  0C23'   22 2944'              	SHLD	WKI
  0C26'   C3 0C05'              	JMP	ES_WS
  0C29'                         ES_WD:
  0C29'   2A 2944'              	LHLD	WKI
  0C2C'   CD 0000*              	CALL	CHARAT
  0C2F'   CD 06A0'              	CALL	CLASSF
  0C32'   32 294C'              	STA	WKCLS
  0C35'                         ES_RUN:
  0C35'   2A 2944'              	LHLD	WKI
  0C38'   23                    	INX	H
  0C39'   EB                    	XCHG			; DE = i+1
  0C3A'   2A 2946'              	LHLD	WKN
  0C3D'   CD 0000*              	CALL	CMP16		; DE=(i+1) vs HL=n: CY iff (i+1) < n
  0C40'   D2 0C5D'              	JNC	ES_LND
  0C43'   2A 2944'              	LHLD	WKI
  0C46'   23                    	INX	H
  0C47'   E5                    	PUSH	H		; i+1
  0C48'   CD 0000*              	CALL	CHARAT
  0C4B'   CD 06A0'              	CALL	CLASSF
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0C4E'   E1                    	POP	H		; HL = i+1
  0C4F'   47                    	MOV	B,A
  0C50'   3A 294C'              	LDA	WKCLS
  0C53'   B8                    	CMP	B
  0C54'   C2 0C5D'              	JNZ	ES_LND
  0C57'   22 2944'              	SHLD	WKI
  0C5A'   C3 0C35'              	JMP	ES_RUN
  0C5D'                         ES_LND:
  0C5D'   2A 2946'              	LHLD	WKN
  0C60'   EB                    	XCHG
  0C61'   2A 2944'              	LHLD	WKI
  0C64'   CD 0000*              	CALL	CMP16		; DE=n vs HL=i: CY iff n < i
  0C67'   DA 0C73'              	JC	ES_CL
  0C6A'   CA 0C73'              	JZ	ES_CL
  0C6D'   2A 2944'              	LHLD	WKI
  0C70'   C3 056D'              	JMP	GOSET
  0C73'                         ES_CL:
  0C73'   2A 2946'              	LHLD	WKN
  0C76'   7C                    	MOV	A,H
  0C77'   B5                    	ORA	L
  0C78'   C8                    	RZ
  0C79'   2B                    	DCX	H
  0C7A'   C3 056D'              	JMP	GOSET
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0C7D'                         CURRW:
  0C7D'   2A 0000*              	LHLD	WINROW
  0C80'   EB                    	XCHG
  0C81'   2A 0000*              	LHLD	LNDLT
  0C84'   19                    	DAD	D		; HL = row (signed)
  0C85'   7C                    	MOV	A,H
  0C86'   B7                    	ORA	A
  0C87'   FA 0C9A'              	JM	CRW_0		; above the screen -> top row
  0C8A'   C2 0C95'              	JNZ	CRW_BT		; far below -> bottom row
  0C8D'   3A 0000*              	LDA	NEDIT
  0C90'   3D                    	DCR	A		; A = bottom row
  0C91'   BD                    	CMP	L		; CY iff bottom < row
  0C92'   D8                    	RC
  0C93'   7D                    	MOV	A,L
  0C94'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C95'                         CRW_BT:
  0C95'   3A 0000*              	LDA	NEDIT
  0C98'   3D                    	DCR	A
  0C99'   C9                    	RET
  0C9A'                         CRW_0:
  0C9A'   AF                    	XRA	A
  0C9B'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0C9C'                         SETRWT:
  0C9C'   2A 0000*              	LHLD	LNDLT
  0C9F'   EB                    	XCHG
  0CA0'   6F                    	MOV	L,A
  0CA1'   26 00                 	MVI	H,0
  0CA3'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0CA6'   22 0000*              	SHLD	WINROW
  0CA9'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0CAA'                         MVROW:
  0CAA'   47                    	MOV	B,A
  0CAB'   CD 0C7D'              	CALL	CURRW
  0CAE'   90                    	SUB	B		; A = row now - target
  0CAF'   C8                    	RZ
  0CB0'   DA 0CB9'              	JC	MR_DN
  0CB3'   6F                    	MOV	L,A
  0CB4'   26 00                 	MVI	H,0
  0CB6'   C3 0904'              	JMP	KCORE
  0CB9'                         MR_DN:
  0CB9'   2F                    	CMA
  0CBA'   3C                    	INR	A		; A = target - row now
  0CBB'   6F                    	MOV	L,A
  0CBC'   26 00                 	MVI	H,0
  0CBE'   C3 0867'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0CC1'                         VC_HIGH:
  0CC1'   CD 066B'              	CALL	MOVCNT		; a cursor motion, and its count
  0CC4'   2B                    	DCX	H		; row = count - 1
  0CC5'   7C                    	MOV	A,H
  0CC6'   B7                    	ORA	A
  0CC7'   3A 0000*              	LDA	SCBOT
  0CCA'   C2 0CD2'              	JNZ	VH_GO		; >= 256 -> the last text row
  0CCD'   BD                    	CMP	L		; CY iff SCBOT < row
  0CCE'   DA 0CD2'              	JC	VH_GO
  0CD1'   7D                    	MOV	A,L
  0CD2'                         VH_GO:
  0CD2'   CD 0CAA'              	CALL	MVROW
  0CD5'   C3 07B9'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0CD8'                         VC_MIDL:
  0CD8'   CD 066B'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0CDB'   3A 0000*              	LDA	SCBOT
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0CDE'   B7                    	ORA	A		; clear CY for the shift
  0CDF'   1F                    	RAR			; A = SCBOT / 2
  0CE0'   CD 0CAA'              	CALL	MVROW
  0CE3'   C3 07B9'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0CE6'                         VC_LOWL:
  0CE6'   CD 066B'              	CALL	MOVCNT		; a cursor motion, and its count
  0CE9'   2B                    	DCX	H		; count - 1
  0CEA'   3A 0000*              	LDA	SCBOT
  0CED'   5F                    	MOV	E,A
  0CEE'   16 00                 	MVI	D,0
  0CF0'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0CF1'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0CF4'   3E 00                 	MVI	A,0
  0CF6'   D2 0CFD'              	JNC	VL_GO		; at or past the top -> row 0
  0CF9'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0CFC'   7D                    	MOV	A,L
  0CFD'                         VL_GO:
  0CFD'   CD 0CAA'              	CALL	MVROW
  0D00'   C3 07B9'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0D03'                         VC_PGDN:
  0D03'   CD 066B'              	CALL	MOVCNT		; a cursor motion, and its count
  0D06'   3A 0000*              	LDA	SCEOF
  0D09'   B7                    	ORA	A
  0D0A'   CA 0D18'              	JZ	VPD_N
  0D0D'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0D10'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0D11'   C8                    	RZ			; it already is
  0D12'   CD 0CAA'              	CALL	MVROW
  0D15'   C3 0D29'              	JMP	VPD_TP
  0D18'                         VPD_N:
  0D18'   3A 0000*              	LDA	NEDIT
  0D1B'   D6 02                 	SUI	2
  0D1D'   CD 0D71'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0D20'   E5                    	PUSH	H
  0D21'   AF                    	XRA	A
  0D22'   CD 0CAA'              	CALL	MVROW		; the top line
  0D25'   E1                    	POP	H
  0D26'   CD 0867'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0D29'                         VPD_TP:
  0D29'   AF                    	XRA	A
  0D2A'   CD 0C9C'              	CALL	SETRWT		; to the top row
  0D2D'   C3 07B9'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D30'                         VC_PGUP:
  0D30'   CD 066B'              	CALL	MOVCNT		; a cursor motion, and its count
  0D33'   3A 0000*              	LDA	SCBOF
  0D36'   B7                    	ORA	A
  0D37'   C0                    	RNZ
  0D38'   3A 0000*              	LDA	NEDIT
  0D3B'   47                    	MOV	B,A
  0D3C'   3A 0000*              	LDA	SCEOF
  0D3F'   B7                    	ORA	A
  0D40'   CA 0D51'              	JZ	VPU_2
  0D43'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0D46'   FE 02                 	CPI	2
  0D48'   D2 0D51'              	JNC	VPU_2
  0D4B'   2F                    	CMA
  0D4C'   3C                    	INR	A
  0D4D'   80                    	ADD	B
  0D4E'   C3 0D54'              	JMP	VPU_P
  0D51'                         VPU_2:
  0D51'   78                    	MOV	A,B
  0D52'   D6 02                 	SUI	2
  0D54'                         VPU_P:
  0D54'   CD 0D71'              	CALL	MULSAT		; HL = count * page
  0D57'   E5                    	PUSH	H
  0D58'   AF                    	XRA	A
  0D59'   CD 0CAA'              	CALL	MVROW		; the top line
  0D5C'   E1                    	POP	H
  0D5D'   CD 0904'              	CALL	KCORE		; the new top line
  0D60'   AF                    	XRA	A
  0D61'   CD 0C9C'              	CALL	SETRWT		; on the top row
  0D64'   3A 0000*              	LDA	NEDIT
  0D67'   3D                    	DCR	A
  0D68'   6F                    	MOV	L,A
  0D69'   26 00                 	MVI	H,0
  0D6B'   CD 0867'              	CALL	JCORE		; the bottom row's line
  0D6E'   C3 07B9'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0D71'                         MULSAT:
  0D71'   EB                    	XCHG
  0D72'   21 0000               	LXI	H,0
  0D75'   B7                    	ORA	A
  0D76'   C8                    	RZ
  0D77'                         MS_LP:
  0D77'   19                    	DAD	D
  0D78'   DA 0D80'              	JC	MS_SAT
  0D7B'   3D                    	DCR	A
  0D7C'   C2 0D77'              	JNZ	MS_LP
  0D7F'   C9                    	RET
  0D80'                         MS_SAT:
  0D80'   21 FFFF               	LXI	H,0FFFFH
  0D83'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D84'                         VC_HFDN:
  0D84'   CD 06EB'              	CALL	SETMOV
  0D87'   CD 0C7D'              	CALL	CURRW
  0D8A'   32 290A'              	STA	HFROW
  0D8D'   CD 0DFB'              	CALL	HFCNT		; HL = lines
  0D90'   3A 290A'              	LDA	HFROW
  0D93'   47                    	MOV	B,A
  0D94'   3A 0000*              	LDA	SCEOF
  0D97'   B7                    	ORA	A
  0D98'   CA 0DA0'              	JZ	VHD_GO
  0D9B'   3A 0000*              	LDA	SCBOT		; the last line's row
  0D9E'   B8                    	CMP	B
  0D9F'   C8                    	RZ			; the cursor is on it
  0DA0'                         VHD_GO:
  0DA0'   CD 0867'              	CALL	JCORE
  0DA3'   3A 0000*              	LDA	SCEOF
  0DA6'   B7                    	ORA	A
  0DA7'   C2 07B9'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0DAA'   3A 290A'              	LDA	HFROW
  0DAD'   CD 0C9C'              	CALL	SETRWT
  0DB0'   3E 01                 	MVI	A,1
  0DB2'   32 0000*              	STA	WFILL		; not past the end of the file
  0DB5'   C3 07B9'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0DB8'                         VC_HFUP:
  0DB8'   CD 06EB'              	CALL	SETMOV
  0DBB'   CD 0C7D'              	CALL	CURRW
  0DBE'   32 290A'              	STA	HFROW
  0DC1'   CD 0DFB'              	CALL	HFCNT		; HL = lines
  0DC4'   CD 0DDB'              	CALL	ONFST
  0DC7'   C8                    	RZ			; the cursor is on the first line
  0DC8'   CD 0904'              	CALL	KCORE
  0DCB'   3A 0000*              	LDA	SCBOF
  0DCE'   B7                    	ORA	A
  0DCF'   C2 07B9'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0DD2'   3A 290A'              	LDA	HFROW
  0DD5'   CD 0C9C'              	CALL	SETRWT
  0DD8'   C3 07B9'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0DDB'                         ONFST:
  0DDB'   E5                    	PUSH	H
  0DDC'   2A 0000*              	LHLD	OUTPOS
  0DDF'   7C                    	MOV	A,H
  0DE0'   B5                    	ORA	L
  0DE1'   C2 0DF9'              	JNZ	OF_RET
  0DE4'   2A 0000*              	LHLD	TXTBEG
  0DE7'   EB                    	XCHG			; DE = TXTBEG
  0DE8'   2A 0000*              	LHLD	GAPBEG
  0DEB'                         OF_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0DEB'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0DEE'   CA 0DF9'              	JZ	OF_RET
  0DF1'   2B                    	DCX	H
  0DF2'   7E                    	MOV	A,M
  0DF3'   FE 0A                 	CPI	LF
  0DF5'   C2 0DEB'              	JNZ	OF_LP
  0DF8'   B7                    	ORA	A		; NZ
  0DF9'                         OF_RET:
  0DF9'   E1                    	POP	H
  0DFA'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0DFB'                         HFCNT:
  0DFB'   2A 28FE'              	LHLD	CMDCNT
  0DFE'   7C                    	MOV	A,H
  0DFF'   B5                    	ORA	L
  0E00'   CA 0E17'              	JZ	HFC_AM
  0E03'   CD 067E'              	CALL	GETCNT		; HL = count; clears it
  0E06'   3A 0000*              	LDA	NEDIT
  0E09'   5F                    	MOV	E,A
  0E0A'   16 00                 	MVI	D,0
  0E0C'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0E0F'   D2 0E13'              	JNC	HFC_ST
  0E12'   EB                    	XCHG			; HL = NEDIT
  0E13'                         HFC_ST:
  0E13'   7D                    	MOV	A,L
  0E14'   32 290B'              	STA	HFAMT
  0E17'                         HFC_AM:
  0E17'   3A 290B'              	LDA	HFAMT
  0E1A'   B7                    	ORA	A
  0E1B'   C2 0E28'              	JNZ	HFC_HL
  0E1E'   3A 0000*              	LDA	NEDIT
  0E21'   B7                    	ORA	A
  0E22'   1F                    	RAR
  0E23'   B7                    	ORA	A
  0E24'   C2 0E28'              	JNZ	HFC_HL
  0E27'   3C                    	INR	A		; at least one line
  0E28'                         HFC_HL:
  0E28'   6F                    	MOV	L,A
  0E29'   26 00                 	MVI	H,0
  0E2B'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0E2C'                         VC_REDR:
  0E2C'   C3 067E'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0E2F'                         VC_G:
  0E2F'   CD 06EB'              	CALL	SETMOV
  0E32'   CD 0EDF'              	CALL	GZONE		; the screen's top line, before the move
  0E35'   2A 28FE'              	LHLD	CMDCNT
  0E38'   7C                    	MOV	A,H
  0E39'   B5                    	ORA	L
  0E3A'   C2 0E47'              	JNZ	VG_N
  0E3D'   AF                    	XRA	A		; forward
  0E3E'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0E41'   CD 099B'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0E44'   C3 0EF7'              	JMP	GPLACE
  0E47'                         VG_N:
  0E47'   CD 067E'              	CALL	GETCNT		; HL = target line (1-based)
  0E4A'                         VG_LN:
  0E4A'   CD 0E50'              	CALL	GOLN
  0E4D'   C3 0EF7'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  0E50'                         GOLN:
  0E50'   E5                    	PUSH	H
  0E51'   CD 0000*              	CALL	CNTLF
  0E54'   23                    	INX	H		; HL = the cursor's line
  0E55'   D1                    	POP	D		; DE = the line wanted
  0E56'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  0E59'   DA 0E64'              	JC	GLN_BK
  0E5C'   EB                    	XCHG
  0E5D'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  0E60'   AF                    	XRA	A
  0E61'   C3 0E69'              	JMP	GLN_MV
  0E64'                         GLN_BK:
  0E64'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  0E67'   3E FF                 	MVI	A,0FFH
  0E69'                         GLN_MV:
  0E69'   CD 0000*              	CALL	MVLIND
  0E6C'   CD 0995'              	CALL	ATEOF
  0E6F'   DC 099B'              	CC	LASTLN		; past the last line: onto it
  0E72'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0E73'                         VC_LG:
  0E73'   CD 06EB'              	CALL	SETMOV
  0E76'   3A 2926'              	LDA	GSAVE
  0E79'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E7A'   C2 0E83'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0E7D'   3E 01                 	MVI	A,PG
  0E7F'   32 2925'              	STA	GPEND
  0E82'   C9                    	RET
  0E83'                         VLG_GG:
  0E83'   CD 0EDF'              	CALL	GZONE
  0E86'   CD 067E'              	CALL	GETCNT		; HL = target line (no count: 1)
  0E89'   C3 0E4A'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0E8C'                         SUB24:
  0E8C'   4F                    	MOV	C,A
  0E8D'   7D                    	MOV	A,L
  0E8E'   93                    	SUB	E
  0E8F'   6F                    	MOV	L,A
  0E90'   7C                    	MOV	A,H
  0E91'   9A                    	SBB	D
  0E92'   67                    	MOV	H,A
  0E93'   79                    	MOV	A,C
  0E94'   98                    	SBB	B
  0E95'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0E96'                         CURFP:
  0E96'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0E99'                         FPOS:
  0E99'   C5                    	PUSH	B
  0E9A'   D5                    	PUSH	D
  0E9B'   EB                    	XCHG
  0E9C'   2A 0000*              	LHLD	TXTBEG
  0E9F'   EB                    	XCHG
  0EA0'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0EA3'   EB                    	XCHG			; DE = that
  0EA4'   2A 0000*              	LHLD	OUTPOS
  0EA7'   7C                    	MOV	A,H
  0EA8'   B7                    	ORA	A		; CY = 0
  0EA9'   1F                    	RAR
  0EAA'   47                    	MOV	B,A
  0EAB'   7D                    	MOV	A,L
  0EAC'   1F                    	RAR
  0EAD'   67                    	MOV	H,A
  0EAE'   3E 00                 	MVI	A,0
  0EB0'   1F                    	RAR
  0EB1'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0EB2'   19                    	DAD	D
  0EB3'   78                    	MOV	A,B
  0EB4'   CE 00                 	ACI	0		; A:HL = the position
  0EB6'   D1                    	POP	D
  0EB7'   C1                    	POP	B
  0EB8'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0EB9'                         ZSAVE:
  0EB9'   2A 28FE'              	LHLD	CMDCNT
  0EBC'   22 2964'              	SHLD	ZSVCNT
  0EBF'   2A 0000*              	LHLD	AUXCNT
  0EC2'   22 2966'              	SHLD	ZSVAUX
  0EC5'   3A 0000*              	LDA	DIRFLG
  0EC8'   32 2968'              	STA	ZSVDIR
  0ECB'   C9                    	RET
  0ECC'                         ZREST:
  0ECC'   2A 2964'              	LHLD	ZSVCNT
  0ECF'   22 28FE'              	SHLD	CMDCNT
  0ED2'   2A 2966'              	LHLD	ZSVAUX
  0ED5'   22 0000*              	SHLD	AUXCNT
  0ED8'   3A 2968'              	LDA	ZSVDIR
  0EDB'   32 0000*              	STA	DIRFLG
  0EDE'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0EDF'                         GZONE:
  0EDF'   CD 0EB9'              	CALL	ZSAVE
  0EE2'   CD 0C7D'              	CALL	CURRW
  0EE5'   6F                    	MOV	L,A
  0EE6'   26 00                 	MVI	H,0
  0EE8'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0EEB'   CD 0E99'              	CALL	FPOS
  0EEE'   22 0000*              	SHLD	ZTOP
  0EF1'   32 0002*              	STA	ZTOP+2
  0EF4'   C3 0ECC'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0EF7'                         GPLACE:
  0EF7'   CD 0EB9'              	CALL	ZSAVE
  0EFA'   CD 0E96'              	CALL	CURFP
  0EFD'   EB                    	XCHG
  0EFE'   2A 0000*              	LHLD	ZTOP
  0F01'   EB                    	XCHG
  0F02'   4F                    	MOV	C,A		; C:HL = the target's position
  0F03'   3A 0002*              	LDA	ZTOP+2
  0F06'   47                    	MOV	B,A		; B:DE = the top's
  0F07'   79                    	MOV	A,C
  0F08'   CD 0E8C'              	CALL	SUB24
  0F0B'   22 2961'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  0F0E'   DA 0F5B'              	JC	GP_UP
  0F11'   B7                    	ORA	A
  0F12'   C2 0F9C'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0F15'   3A 0000*              	LDA	NEDIT
  0F18'   5F                    	MOV	E,A
  0F19'   16 00                 	MVI	D,0
  0F1B'   B7                    	ORA	A
  0F1C'   1F                    	RAR
  0F1D'   6F                    	MOV	L,A
  0F1E'   26 00                 	MVI	H,0
  0F20'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0F21'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0F24'   CD 0677'              	CALL	GBSUB		; HL = bytes from there to the target
  0F27'   EB                    	XCHG
  0F28'   2A 2961'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0F2B'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0F2E'   DA 0F9C'              	JC	GP_MID
  0F31'   CD 0677'              	CALL	GBSUB		; HL = the top line's start (resident)
  0F34'   01 0000               	LXI	B,0		; BC = lines from the top
  0F37'                         GP_CNT:
  0F37'   7A                    	MOV	A,D
  0F38'   B3                    	ORA	E
  0F39'   CA 0F48'              	JZ	GP_DN
  0F3C'   7E                    	MOV	A,M
  0F3D'   23                    	INX	H
  0F3E'   1B                    	DCX	D
  0F3F'   FE 0A                 	CPI	LF
  0F41'   C2 0F37'              	JNZ	GP_CNT
  0F44'   03                    	INX	B
  0F45'   C3 0F37'              	JMP	GP_CNT
  0F48'                         GP_DN:
  0F48'   3A 0000*              	LDA	NEDIT
  0F4B'   3D                    	DCR	A
  0F4C'   5F                    	MOV	E,A
  0F4D'   16 00                 	MVI	D,0		; DE = the bottom row
  0F4F'   60                    	MOV	H,B
  0F50'   69                    	MOV	L,C
  0F51'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0F54'   DA 0FA6'              	JC	GP_SET		; A = the bottom row
  0F57'   7D                    	MOV	A,L		; on the screen: its row
  0F58'   C3 0FC6'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0F5B'                         GP_UP:
  0F5B'   3C                    	INR	A
  0F5C'   C2 0F9C'              	JNZ	GP_MID		; 64K bytes or more above
  0F5F'   2A 2961'              	LHLD	ZDIF
  0F62'   EB                    	XCHG
  0F63'   21 0000               	LXI	H,0
  0F66'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0F69'   7C                    	MOV	A,H
  0F6A'   B5                    	ORA	L
  0F6B'   CA 0F9C'              	JZ	GP_MID		; exactly 64K
  0F6E'   EB                    	XCHG			; DE = bytes to read
  0F6F'   AF                    	XRA	A
  0F70'   32 2963'              	STA	ZLF
  0F73'   CD 0000*              	CALL	RGET0
  0F76'                         GP_RD:
  0F76'   CD 0000*              	CALL	RDGET		; (keeps DE)
  0F79'   DA 0F9C'              	JC	GP_MID
  0F7C'   FE 0A                 	CPI	LF
  0F7E'   C2 0F92'              	JNZ	GP_RN
  0F81'   3A 0000*              	LDA	NEDIT
  0F84'   B7                    	ORA	A
  0F85'   1F                    	RAR
  0F86'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  0F88'   E5                    	PUSH	H
  0F89'   21 2963'              	LXI	H,ZLF
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F8C'   34                    	INR	M
  0F8D'   BE                    	CMP	M		; CY iff more lines than that
  0F8E'   E1                    	POP	H
  0F8F'   DA 0F9C'              	JC	GP_MID
  0F92'                         GP_RN:
  0F92'   1B                    	DCX	D
  0F93'   7A                    	MOV	A,D
  0F94'   B3                    	ORA	E
  0F95'   C2 0F76'              	JNZ	GP_RD
  0F98'   AF                    	XRA	A		; the top row
  0F99'   C3 0FA6'              	JMP	GP_SET
  0F9C'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  0F9C'   3E 01                 	MVI	A,1
  0F9E'   32 0000*              	STA	WFILL		; not past the end of the file
  0FA1'   3A 0000*              	LDA	NEDIT
  0FA4'   B7                    	ORA	A
  0FA5'   1F                    	RAR			; the middle row
  0FA6'                         GP_SET:
  0FA6'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  0FA7'   26 00                 	MVI	H,0
  0FA9'   22 0000*              	SHLD	WINROW
  0FAC'   21 0000               	LXI	H,0
  0FAF'   22 0000*              	SHLD	LNDLT
  0FB2'   CD 070C'              	CALL	SETFUL		; the window may have paged: full repaint
  0FB5'                         GP_FIN:
  0FB5'   CD 0ECC'              	CALL	ZREST
  0FB8'   3A 298B'              	LDA	GPKEEP
  0FBB'   B7                    	ORA	A
  0FBC'   CA 07B9'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  0FBF'   AF                    	XRA	A
  0FC0'   32 298B'              	STA	GPKEEP
  0FC3'   C3 0570'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  0FC6'                         GP_ONS:
  0FC6'   6F                    	MOV	L,A
  0FC7'   26 00                 	MVI	H,0		; HL = the row it lands on
  0FC9'   EB                    	XCHG
  0FCA'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  0FCD'   EB                    	XCHG
  0FCE'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  0FD1'   22 0000*              	SHLD	LNDLT
  0FD4'   3E 01                 	MVI	A,R_MOVE
  0FD6'   32 2902'              	STA	RINTENT
  0FD9'   C3 0FB5'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  0FDC'                         OPPEND:
  0FDC'   AF                    	XRA	A
  0FDD'   32 292B'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  0FE0'   3A 2928'              	LDA	PSAVE
  0FE3'   FE 63                 	CPI	'c'
  0FE5'   C2 1002'              	JNZ	OPP_ND
  0FE8'   79                    	MOV	A,C
  0FE9'   FE 77                 	CPI	'w'
  0FEB'   CA 0FF3'              	JZ	OPP_W
  0FEE'   FE 57                 	CPI	'W'
  0FF0'   C2 1002'              	JNZ	OPP_ND
  0FF3'                         OPP_W:
  0FF3'   CD 11D5'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  0FF6'   DA 1002'              	JC	OPP_ND
  0FF9'   79                    	MOV	A,C
  0FFA'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  0FFC'   4F                    	MOV	C,A
  0FFD'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  0FFF'   32 292B'              	STA	CWEOL		;   see the clamp in OPA_F
  1002'                         OPP_ND:
  1002'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  1003'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  1005'   C2 1019'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  1008'   CD 0218'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  100B'   DA 10A9'              	JC	OPABRT
  100E'   79                    	MOV	A,C
  100F'   FE 67                 	CPI	'g'
  1011'   C2 10A9'              	JNZ	OPABRT
  1014'   3E 01                 	MVI	A,PG
  1016'   32 2926'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  1019'                         OPP_NG:
  1019'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  101A'   21 2928'              	LXI	H,PSAVE
  101D'   BE                    	CMP	M
  101E'   CA 11F6'              	JZ	OPLINE
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  1021'   79                    	MOV	A,C		; (OPCLS classifies the key)
  1022'   CD 120C'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1025'   DA 10A9'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  1028'   32 292A'              	STA	OPCLSV
  102B'   47                    	MOV	B,A		; B = the class
  102C'   3A 2928'              	LDA	PSAVE
  102F'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  1031'   C2 103D'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  1034'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  1035'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  1037'   C2 105F'              	JNZ	OPP_GO
  103A'   C3 1048'              	JMP	OPP_NO
  103D'                         OPP_NC:
  103D'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  103F'   C2 105F'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  1042'   78                    	MOV	A,B		;   a charwise register would need a type flag
  1043'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  1045'   CA 105F'              	JZ	OPP_GO		;   within a line -- neither of which is built
  1048'                         OPP_NO:
  1048'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  1049'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  104B'   CA 1059'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  104E'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  1050'   CA 1059'              	JZ	OPP_SW		;   so swallow it before dropping the command
  1053'   CD 0348'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  1056'   C2 10A9'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  1059'                         OPP_SW:
  1059'   CD 0218'              	CALL	MKGETK
  105C'   C3 10A9'              	JMP	OPABRT
  105F'                         OPP_GO:
  105F'   AF                    	XRA	A
  1060'   32 2909'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  1063'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  1066'   22 292C'              	SHLD	OPSTA
  1069'   C5                    	PUSH	B
  106A'   21 2930'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  106D'   CD 0442'              	CALL	FPSTO		;   only good until the motion pages the window
  1070'   3A 292A'              	LDA	OPCLSV
  1073'   FE 02                 	CPI	2
  1075'   CC 10AC'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  1078'   C1                    	POP	B
  1079'   21 282C'              	LXI	H,CMDTAB
  107C'   CD 00C5'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  107F'   3A 2928'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1082'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1083'   CA 06EB'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  1086'   CD 10D8'              	CALL	OPSFIX		; where the start is in the window NOW
  1089'   D2 10F4'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  108C'   22 292C'              	SHLD	OPSTA
  108F'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1092'   22 292E'              	SHLD	OPEND2
  1095'   3A 2928'              	LDA	PSAVE
  1098'   FE 79                 	CPI	'y'
  109A'   CA 16B9'              	JZ	OPYANK		; a yank takes the span without losing it
  109D'   CD 1247'              	CALL	OPAPPL		; delete the span
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  10A0'   3A 2928'              	LDA	PSAVE
  10A3'   FE 63                 	CPI	'c'
  10A5'   C0                    	RNZ
  10A6'   C3 1475'              	JMP	SETINS
  10A9'                         OPABRT:
  10A9'   C3 06EB'              	JMP	SETMOV		; not a motion -> operator cancelled, nothing drew
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  10AC'                         OPENDS:
  10AC'   2A 292C'              	LHLD	OPSTA
  10AF'   CD 05D7'              	CALL	BOL
  10B2'   11 2933'              	LXI	D,OPSLO
  10B5'   CD 10CA'              	CALL	OPE_ST
  10B8'   2A 292C'              	LHLD	OPSTA
  10BB'   CD 0607'              	CALL	NLSTART
  10BE'   11 2936'              	LXI	D,OPSHI
  10C1'   CD 10CA'              	CALL	OPE_ST
  10C4'   2A 292C'              	LHLD	OPSTA
  10C7'   C3 0000*              	JMP	GOTO
  10CA'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  10CA'   D5                    	PUSH	D
  10CB'   CD 0000*              	CALL	GOTO
  10CE'   E1                    	POP	H
  10CF'   C3 0442'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  10D2'                         CURBD:
  10D2'   CD 0E96'              	CALL	CURFP
  10D5'   EB                    	XCHG
  10D6'   47                    	MOV	B,A
  10D7'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  10D8'                         OPSFIX:
  10D8'   21 2930'              	LXI	H,OPSFP
  10DB'   CD 03F5'              	CALL	MKLOAD
  10DE'   CD 10D2'              	CALL	CURBD
  10E1'   2A 2995'              	LHLD	MKPOS
  10E4'   3A 2997'              	LDA	MKPOS+2
  10E7'   CD 0E8C'              	CALL	SUB24
  10EA'   B4                    	ORA	H
  10EB'   B5                    	ORA	L
  10EC'   C2 0402'              	JNZ	MKWIN
  10EF'   CD 0000*              	CALL	CUROFF
  10F2'   37                    	STC
  10F3'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  10F4'                         OPPGD:
  10F4'   47                    	MOV	B,A
  10F5'   3A 292A'              	LDA	OPCLSV
  10F8'   FE 02                 	CPI	2
  10FA'   C2 11B6'              	JNZ	OPG_NO
  10FD'   3A 2928'              	LDA	PSAVE
  1100'   FE 64                 	CPI	'd'
  1102'   C2 11B6'              	JNZ	OPG_NO
  1105'   04                    	INR	B
  1106'   CA 1115'              	JZ	OPG_FW
  1109'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  110C'   CD 05D7'              	CALL	BOL		;   and the high end is OPSHI as it stands
  110F'   CD 0000*              	CALL	GOTO
  1112'   C3 112D'              	JMP	OPG_GO
  1115'                         OPG_FW:
  1115'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  1118'   CD 0607'              	CALL	NLSTART		;   landed on, and the low one is where the
  111B'   11 2936'              	LXI	D,OPSHI		;   start line began
  111E'   CD 10CA'              	CALL	OPE_ST
  1121'   21 2933'              	LXI	H,OPSLO
  1124'   CD 03F5'              	CALL	MKLOAD
  1127'   CD 03C2'              	CALL	MKPAGE
  112A'   CD 0000*              	CALL	GOTO
  112D'                         OPG_GO:
  112D'   CD 10D2'              	CALL	CURBD
  1130'   2A 2936'              	LHLD	OPSHI
  1133'   3A 2938'              	LDA	OPSHI+2
  1136'   CD 0E8C'              	CALL	SUB24		; A:HL = the bytes to take
  1139'                         OPG_SV:
  1139'   22 2939'              	SHLD	OPTOGO
  113C'   32 293B'              	STA	OPTOGO+2
  113F'                         OPG_NX:
  113F'   CD 065A'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  1142'   CD 0000*              	CALL	SUBHD
  1145'   EB                    	XCHG			; DE = what the window holds past the cursor
  1146'   2A 2939'              	LHLD	OPTOGO
  1149'   3A 293B'              	LDA	OPTOGO+2
  114C'   B7                    	ORA	A
  114D'   C2 1180'              	JNZ	OPG_PG		; 64K or more to go
  1150'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  1153'   DA 1180'              	JC	OPG_PG
  1156'   CA 1180'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  1159'                         OPG_FN:				; the rest of it is here
  1159'   E5                    	PUSH	H
  115A'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  115D'   CD 0000*              	CALL	CUROFF
  1160'   22 293C'              	SHLD	OPLO
  1163'   D1                    	POP	D
  1164'   19                    	DAD	D
  1165'   22 293E'              	SHLD	OPHI
  1168'   CD 12E5'              	CALL	OPDSPN
  116B'   CD 0995'              	CALL	ATEOF
  116E'   D2 11CF'              	JNC	OPMID
  1171'   CD 0DDB'              	CALL	ONFST		; deleted to the end of the file: onto the new
  1174'   CA 11CF'              	JZ	OPMID		;   last line, if there is one -- and the pager
  1177'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  117A'   CD 0000*              	CALL	SETBWD
  117D'   C3 11CF'              	JMP	OPMID
  1180'                         OPG_PG:
  1180'   7A                    	MOV	A,D
  1181'   B3                    	ORA	E
  1182'   C2 119B'              	JNZ	OPG_DL
  1185'   CD 0995'              	CALL	ATEOF		; nothing held past the cursor
  1188'   21 0000               	LXI	H,0
  118B'   DA 1159'              	JC	OPG_FN		; ... and no more to come: the file ran out
  118E'   2B                    	DCX	H
  118F'   CD 0000*              	CALL	SETC0
  1192'   CD 0000*              	CALL	GOLINE
  1195'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  1198'   C3 113F'              	JMP	OPG_NX
  119B'                         OPG_DL:
  119B'   D5                    	PUSH	D
  119C'   21 FFFF               	LXI	H,0FFFFH
  119F'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  11A2'   E1                    	POP	H
  11A3'   E5                    	PUSH	H
  11A4'   CD 0000*              	CALL	DELFWD
  11A7'   D1                    	POP	D
  11A8'   06 00                 	MVI	B,0
  11AA'   2A 2939'              	LHLD	OPTOGO
  11AD'   3A 293B'              	LDA	OPTOGO+2
  11B0'   CD 0E8C'              	CALL	SUB24
  11B3'   C3 1139'              	JMP	OPG_SV
  11B6'                         OPG_NO:
  11B6'   0E 07                 	MVI	C,BEL
  11B8'   CD 0000*              	CALL	BCONOU
  11BB'                         OPG_HM:				; the cursor back where the command found it
  11BB'   21 2930'              	LXI	H,OPSFP
  11BE'   CD 03F5'              	CALL	MKLOAD
  11C1'   CD 03C2'              	CALL	MKPAGE
  11C4'   CD 0000*              	CALL	GOTO
  11C7'   AF                    	XRA	A
  11C8'   32 2928'              	STA	PSAVE
  11CB'   3C                    	INR	A
  11CC'   32 298B'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  11CF'                         OPMID:
  11CF'   CD 0EB9'              	CALL	ZSAVE
  11D2'   C3 0F9C'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  11D5'                         ONWHIT:
  11D5'   CD 065A'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  11D8'   CA 11F4'              	JZ	OW_YES
  11DB'   CD 0665'              	CALL	CURCHR		; A = the char under the cursor
  11DE'   FE 20                 	CPI	' '
  11E0'   CA 11F4'              	JZ	OW_YES
  11E3'   FE 09                 	CPI	TAB
  11E5'   CA 11F4'              	JZ	OW_YES
  11E8'   FE 0D                 	CPI	CR
  11EA'   CA 11F4'              	JZ	OW_YES
  11ED'   FE 0A                 	CPI	LF
  11EF'   CA 11F4'              	JZ	OW_YES
  11F2'   B7                    	ORA	A		; a char to change: CY clear
  11F3'   C9                    	RET
  11F4'                         OW_YES:
  11F4'   37                    	STC
  11F5'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  11F6'                         OPLINE:
  11F6'   3A 2928'              	LDA	PSAVE
  11F9'   FE 63                 	CPI	'c'
  11FB'   CA 06EB'              	JZ	SETMOV
  11FE'   FE 79                 	CPI	'y'
  1200'   CA 1698'              	JZ	VY_YY
  1203'   21 2930'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1206'   CD 0442'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1209'   C3 1611'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  120C'                         OPCLS:
  120C'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  120E'   CA 121B'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  1211'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  1213'   C2 122F'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1216'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1218'   C3 121D'              	JMP	OPC_FK
  121B'                         OPC_SEM:
  121B'   06 00                 	MVI	B,0		; ';' runs it as it stands
  121D'                         OPC_FK:
  121D'   3A 2981'              	LDA	FNDKND
  1220'   B7                    	ORA	A
  1221'   37                    	STC
  1222'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1223'   A8                    	XRA	B		; ... and now the direction ',' asked for
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  1224'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1226'   CA 122D'              	JZ	OPC_EXC
  1229'   3E 01                 	MVI	A,1
  122B'   B7                    	ORA	A		; CY clear: a motion, class 1
  122C'   C9                    	RET
  122D'                         OPC_EXC:
  122D'   AF                    	XRA	A		; class 0, CY clear
  122E'   C9                    	RET
  122F'                         OPC_TB:
  122F'   47                    	MOV	B,A
  1230'   21 1369'              	LXI	H,OPCTAB
  1233'                         OPC_LP:
  1233'   7E                    	MOV	A,M
  1234'   B7                    	ORA	A
  1235'   CA 1245'              	JZ	OPC_MS		; end of table -> not a motion
  1238'   B8                    	CMP	B
  1239'   CA 1241'              	JZ	OPC_HT
  123C'   23                    	INX	H
  123D'   23                    	INX	H
  123E'   C3 1233'              	JMP	OPC_LP
  1241'                         OPC_HT:
  1241'   23                    	INX	H
  1242'   7E                    	MOV	A,M		; class byte
  1243'   B7                    	ORA	A		; clear CY
  1244'   C9                    	RET
  1245'                         OPC_MS:
  1245'   37                    	STC
  1246'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  1247'                         OPAPPL:
  1247'   3A 292A'              	LDA	OPCLSV
  124A'   FE 02                 	CPI	2
  124C'   CA 134D'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  124F'   2A 292C'              	LHLD	OPSTA
  1252'   EB                    	XCHG			; DE = start
  1253'   2A 292E'              	LHLD	OPEND2		; HL = end
  1256'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  1259'   DA 1269'              	JC	OPA_F
  125C'   CA 1269'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  125F'   22 293C'              	SHLD	OPLO
  1262'   EB                    	XCHG
  1263'   22 293E'              	SHLD	OPHI
  1266'   C3 12C1'              	JMP	OPA_DO
  1269'                         OPA_F:
  1269'   EB                    	XCHG			; HL = start, DE = end
  126A'   22 293C'              	SHLD	OPLO
  126D'   EB                    	XCHG			; HL = end
  126E'   3A 292A'              	LDA	OPCLSV
  1271'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1273'   CA 12BE'              	JZ	OPA_HI		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


                                				;   of it, so it must not be cut back
  1276'   FE 01                 	CPI	1
  1278'   C2 129A'              	JNZ	OPA_EX
  127B'   23                    	INX	H		; inclusive endpoint -> hi = end+1
                                	;--- 'cw' stops at the line's content end, where a plain 'ce' (and 'de')
                                	;    runs on into the next line's word and 'd%' crosses to its mate --
                                	;    all four recorded from vim 9.1.  vim's 'cw' is not simply 'ce': the
                                	;    rewrite keeps 'w's own end-of-line stop, so the clamp hangs off
                                	;    CWEOL (the rewrite) and not off the inclusive class. ---
  127C'   3A 292B'              	LDA	CWEOL
  127F'   B7                    	ORA	A
  1280'   CA 12BE'              	JZ	OPA_HI
  1283'   22 293E'              	SHLD	OPHI		; park the motion's own end: CEND clobbers DE
  1286'   2A 293C'              	LHLD	OPLO
  1289'   CD 13F3'              	CALL	CEND		; HL = the start line's content end
  128C'   EB                    	XCHG			; DE = that content end
  128D'   2A 293E'              	LHLD	OPHI		; HL = hi
  1290'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  1293'   D2 12BE'              	JNC	OPA_HI		; hi is inside the line: keep it
  1296'   EB                    	XCHG			; HL = the content end: 'cw' stops there
  1297'   C3 12BE'              	JMP	OPA_HI
  129A'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  129A'   22 293E'              	SHLD	OPHI		; the motion's own end, for now
  129D'   2A 293C'              	LHLD	OPLO
  12A0'   CD 13F3'              	CALL	CEND		; HL = the start line's content end
  12A3'   EB                    	XCHG			; DE = that content end
  12A4'   3A 2909'              	LDA	WPULL		; the motion landed on a line's end and was
  12A7'   B7                    	ORA	A		;   pulled back onto its last char (the command
  12A8'   C2 12B4'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  12AB'   2A 293E'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  12AE'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  12B1'   D2 12C1'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  12B4'                         OPA_CE:				;   deletes the word, not all but its last char
  12B4'   2A 293C'              	LHLD	OPLO
  12B7'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  12BA'   CA 12FF'              	JZ	OPA_LN
  12BD'   EB                    	XCHG			; HL = the content end
  12BE'                         OPA_HI:
  12BE'   22 293E'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  12C1'                         OPA_DO:
  12C1'   CD 12E5'              	CALL	OPDSPN
  12C4'   3A 2928'              	LDA	PSAVE
  12C7'   FE 63                 	CPI	'c'
  12C9'   C8                    	RZ
  12CA'   C3 1404'              	JMP	CLAMPE
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


                                ; offset) stops short of it, and takes none.
  12CD'                         SPNBRK:
  12CD'   2A 293C'              	LHLD	OPLO
  12D0'   CD 05EA'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  12D3'   EB                    	XCHG			; DE = it
  12D4'   2A 293E'              	LHLD	OPHI
  12D7'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  12DA'                         OPSPNL:
  12DA'   2A 293E'              	LHLD	OPHI
  12DD'   EB                    	XCHG
  12DE'   2A 293C'              	LHLD	OPLO
  12E1'   EB                    	XCHG			; HL = hi, DE = lo
  12E2'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  12E5'                         OPDSPN:
  12E5'   CD 12CD'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  12E8'   F5                    	PUSH	PSW
  12E9'   2A 293C'              	LHLD	OPLO
  12EC'   CD 0000*              	CALL	GOTO
  12EF'   CD 12DA'              	CALL	OPSPNL		; HL = hi - lo
  12F2'   CD 0000*              	CALL	DELFWD
  12F5'   CD 0188'              	CALL	MARKMOD
  12F8'   F1                    	POP	PSW
  12F9'   DA 070C'              	JC	SETFUL		; a break went: every row below it moved up
  12FC'   C3 06F1'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  12FF'                         OPA_LN:
  12FF'   3A 2928'              	LDA	PSAVE
  1302'   FE 63                 	CPI	'c'
  1304'   C2 130D'              	JNZ	OPA_LD
  1307'   2A 293C'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  130A'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  130D'                         OPA_LD:
  130D'   2A 293C'              	LHLD	OPLO
  1310'   22 292C'              	SHLD	OPSTA
  1313'   22 292E'              	SHLD	OPEND2
  1316'   C3 134D'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  1319'                         OPALSP:
  1319'   2A 292C'              	LHLD	OPSTA
  131C'   EB                    	XCHG
  131D'   2A 292E'              	LHLD	OPEND2
  1320'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  1323'   DA 1330'              	JC	OPAL_F
  1326'   22 293C'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1329'   EB                    	XCHG
  132A'   22 293E'              	SHLD	OPHI		; hi-src = start
  132D'   C3 133A'              	JMP	OPAL_R
  1330'                         OPAL_F:
  1330'   EB                    	XCHG			; HL = start
  1331'   22 293C'              	SHLD	OPLO		; lo-src = start
  1334'   2A 292E'              	LHLD	OPEND2
  1337'   22 293E'              	SHLD	OPHI		; hi-src = end
  133A'                         OPAL_R:
  133A'   2A 293C'              	LHLD	OPLO
  133D'   CD 05D7'              	CALL	BOL
  1340'   22 293C'              	SHLD	OPLO		; lo = BOL(low line)
  1343'   2A 293E'              	LHLD	OPHI
  1346'   CD 0607'              	CALL	NLSTART
  1349'   22 293E'              	SHLD	OPHI		; hi = start of line past the high line
  134C'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  134D'                         OPALIN:
  134D'   CD 1319'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  1350'                         OPDLIN:
  1350'   CD 12E5'              	CALL	OPDSPN
  1353'   CD 065A'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1356'   DA 1366'              	JC	OPDL_NB
  1359'   CD 0000*              	CALL	LOGLEN
  135C'   7C                    	MOV	A,H
  135D'   B5                    	ORA	L
  135E'   C8                    	RZ			; empty buffer
  135F'   2B                    	DCX	H
  1360'   CD 05D7'              	CALL	BOL
  1363'   CD 0000*              	CALL	GOTO
  1366'                         OPDL_NB:
  1366'   C3 07B9'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1369'                         OPCTAB:
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  1369'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  136D'   62 00 42 00           
  1371'   68 00 6C 00           
  1375'   30 00 5E 00           
  1379'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  137B'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  137F'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1383'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1387'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  138B'   24 01                 
  138D'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1391'   47 02 48 02           
  1395'   4D 02 4C 02           
  1399'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  139B'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  139D'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  139E'                         VCB_C:
  139E'   CD 13AA'              	CALL	VCB_CD
  13A1'   C3 1475'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  13A4'                         VCB_D:
  13A4'   CD 13AA'              	CALL	VCB_CD
  13A7'   C3 1404'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  13AA'                         VCB_CD:
  13AA'   CD 0671'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  13AD'   22 293C'              	SHLD	OPLO
  13B0'   CD 0000*              	CALL	CUROFF
  13B3'   CD 13F3'              	CALL	CEND		; to the line's content end, the CR,LF left
  13B6'   22 293E'              	SHLD	OPHI
  13B9'   C3 12E5'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  13BC'                         VC_X:
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  13BC'   CD 085E'              	CALL	GLSTAL
  13BF'   CD 06F1'              	CALL	SETLIN
  13C2'   CD 067E'              	CALL	GETCNT
  13C5'   22 2940'              	SHLD	CNTV
  13C8'   CD 0000*              	CALL	CUROFF
  13CB'   22 2944'              	SHLD	WKI		; cur
  13CE'   CD 13F3'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  13D1'   EB                    	XCHG			; DE = contentend
  13D2'   2A 2944'              	LHLD	WKI		; HL = cur
  13D5'   EB                    	XCHG			; HL = contentend, DE = cur
  13D6'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  13D9'   7C                    	MOV	A,H
  13DA'   B5                    	ORA	L
  13DB'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  13DC'   EB                    	XCHG			; DE = available
  13DD'   2A 2940'              	LHLD	CNTV		; HL = count
  13E0'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  13E3'   DA 13E9'              	JC	VX_USEA
  13E6'   C3 13EA'              	JMP	VX_DEL		; count <= available -> HL = count = del
  13E9'                         VX_USEA:
  13E9'   EB                    	XCHG			; HL = available
  13EA'                         VX_DEL:
  13EA'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  13ED'   CD 0188'              	CALL	MARKMOD
  13F0'   C3 1404'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  13F3'                         CEND:
  13F3'   CD 05EA'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  13F6'   7C                    	MOV	A,H
  13F7'   B5                    	ORA	L
  13F8'   C8                    	RZ			; the start of the text: nothing before it
  13F9'   2B                    	DCX	H
  13FA'   E5                    	PUSH	H
  13FB'   CD 0000*              	CALL	CHARAT
  13FE'   E1                    	POP	H		; HL = term-1
  13FF'   FE 0D                 	CPI	CR
  1401'   C8                    	RZ			; a CR before the LF -> the content ends there
  1402'   23                    	INX	H
  1403'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  1404'                         CLAMPE:
  1404'   CD 0000*              	CALL	CUROFF
  1407'   E5                    	PUSH	H
  1408'   CD 0616'              	CALL	EOLC
  140B'   D1                    	POP	D		; DE = cur
  140C'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  140F'   D8                    	RC
  1410'   C8                    	RZ
  1411'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1414'                         VC_I:
  1414'   CD 067E'              	CALL	GETCNT
  1417'   C3 1472'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  141A'                         VC_A:
  141A'   CD 067E'              	CALL	GETCNT
  141D'   CD 065A'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1420'   CA 1437'              	JZ	VA_INS
  1423'   EB                    	XCHG			; HL = cur
  1424'   E5                    	PUSH	H
  1425'   CD 0000*              	CALL	CHARAT
  1428'   E1                    	POP	H
  1429'   FE 0A                 	CPI	LF
  142B'   CA 1437'              	JZ	VA_INS		; on the line terminator -> append in place
  142E'   FE 0D                 	CPI	CR
  1430'   CA 1437'              	JZ	VA_INS
  1433'   23                    	INX	H
  1434'   CD 0000*              	CALL	GOTO
  1437'                         VA_INS:
  1437'   C3 1472'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  143A'                         VCB_A:
  143A'   CD 0671'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  143D'   CD 0616'              	CALL	EOLC		; HL = last content char (the start when empty)
  1440'   E5                    	PUSH	H
  1441'   CD 0000*              	CALL	CHARAT
  1444'   E1                    	POP	H
  1445'   FE 0D                 	CPI	CR
  1447'   CA 1450'              	JZ	VBA_IN		; an empty line: insert at its start
  144A'   FE 0A                 	CPI	LF
  144C'   CA 1450'              	JZ	VBA_IN
  144F'   23                    	INX	H		; past the last content char
  1450'                         VBA_IN:
  1450'   CD 0000*              	CALL	GOTO
  1453'   C3 1472'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1456'                         VCB_I:
  1456'   CD 067E'              	CALL	GETCNT
  1459'   CD 07B9'              	CALL	FNBLNK
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  145C'   CD 0000*              	CALL	CUROFF
  145F'   E5                    	PUSH	H
  1460'   CD 0000*              	CALL	CHARAT
  1463'   E1                    	POP	H
  1464'   FE 20                 	CPI	' '
  1466'   CA 146E'              	JZ	VBI_SK
  1469'   FE 09                 	CPI	TAB
  146B'   C2 1472'              	JNZ	SETINM
  146E'                         VBI_SK:
  146E'   23                    	INX	H		; blanks only: past the last of them
  146F'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1472'                         SETINM:
  1472'   CD 06EB'              	CALL	SETMOV
  1475'                         SETINS:
  1475'   3E 01                 	MVI	A,EM_INS
  1477'   32 28FD'              	STA	EDMODE
  147A'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  147B'                         ATCEND:
  147B'   CD 065A'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  147E'   C8                    	RZ
  147F'   CD 0665'              	CALL	CURCHR		; A = the char under the cursor
  1482'   FE 0D                 	CPI	CR
  1484'   C8                    	RZ
  1485'   FE 0A                 	CPI	LF
  1487'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1488'                         OPNBRK:
  1488'   CD 1D7A'              	CALL	PUTBRK
  148B'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  148E'   23                    	INX	H
  148F'   22 0000*              	SHLD	LNDLT
  1492'   C3 0188'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1495'                         ENDBRK:
  1495'   CD 065A'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1498'   C0                    	RNZ
  1499'   CD 1488'              	CALL	OPNBRK
  149C'   CD 0000*              	CALL	CUROFF
  149F'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  14A0'   2B                    	DCX	H		;   line, with its own terminator after it
  14A1'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  14A4'                         VC_O:
  14A4'   CD 0671'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  14A7'   CD 13F3'              	CALL	CEND
  14AA'   CD 0000*              	CALL	GOTO
  14AD'   CD 1488'              	CALL	OPNBRK
  14B0'   CD 1495'              	CALL	ENDBRK		; a last line with no line end: the opened line
  14B3'   CD 06F7'              	CALL	SETILN		;   needs a terminator of its own to exist
  14B6'   C3 1475'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  14B9'                         VCB_O:
  14B9'   CD 0671'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  14BC'   CD 05D7'              	CALL	BOL
  14BF'   CD 0000*              	CALL	GOTO
  14C2'   CD 1488'              	CALL	OPNBRK
  14C5'   CD 0000*              	CALL	CUROFF
  14C8'   2B                    	DCX	H
  14C9'   2B                    	DCX	H
  14CA'   CD 0000*              	CALL	GOTO
  14CD'   CD 06F7'              	CALL	SETILN
  14D0'   C3 1475'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  14D3'                         VCB_J:
  14D3'   CD 0671'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  14D6'   CD 13F3'              	CALL	CEND		; the join point: this line's content end
  14D9'   22 293C'              	SHLD	OPLO
  14DC'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  14DF'   CD 0607'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  14E2'   E5                    	PUSH	H
  14E3'   CD 0000*              	CALL	LOGLEN
  14E6'   D1                    	POP	D		; DE = that start
  14E7'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  14EA'   CA 06EB'              	JZ	SETMOV
  14ED'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  14EE'                         VJ_WS:
  14EE'   E5                    	PUSH	H
  14EF'   CD 0000*              	CALL	LOGLEN
  14F2'   D1                    	POP	D		; DE = the scan
  14F3'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  14F6'   CA 150D'              	JZ	VJ_DEL
  14F9'   EB                    	XCHG			; HL = the scan
  14FA'   E5                    	PUSH	H
  14FB'   CD 0000*              	CALL	CHARAT
  14FE'   E1                    	POP	H
  14FF'   FE 20                 	CPI	' '
  1501'   CA 1509'              	JZ	VJ_SKIP
  1504'   FE 09                 	CPI	TAB
  1506'   C2 150D'              	JNZ	VJ_DEL
  1509'                         VJ_SKIP:
  1509'   23                    	INX	H
  150A'   C3 14EE'              	JMP	VJ_WS
  150D'                         VJ_DEL:
  150D'   22 293E'              	SHLD	OPHI
  1510'   CD 12E5'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1513'   CD 0706'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1516'   CD 065A'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1519'   CA 1404'              	JZ	CLAMPE
  151C'   CD 0665'              	CALL	CURCHR		; the first char of what was appended
  151F'   FE 0D                 	CPI	CR
  1521'   CA 1404'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1524'   FE 0A                 	CPI	LF
  1526'   CA 1404'              	JZ	CLAMPE
  1529'   FE 29                 	CPI	')'
  152B'   CA 1404'              	JZ	CLAMPE		; vim puts no space before a ')'
  152E'   CD 0000*              	CALL	CUROFF
  1531'   7C                    	MOV	A,H
  1532'   B5                    	ORA	L
  1533'   CA 1549'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1536'   2B                    	DCX	H
  1537'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  153A'   FE 20                 	CPI	' '
  153C'   CA 1404'              	JZ	CLAMPE
  153F'   FE 09                 	CPI	TAB
  1541'   CA 1404'              	JZ	CLAMPE
  1544'   FE 0A                 	CPI	LF
  1546'   CA 1404'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1549'                         VJ_SP:
  1549'   3E 20                 	MVI	A,' '
  154B'   CD 0000*              	CALL	PUTGAP
  154E'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1551'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  1552'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1555'                         VC_TILD:
  1555'   CD 067E'              	CALL	GETCNT
  1558'   CD 06F1'              	CALL	SETLIN		; only this row changes
  155B'   CD 085E'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  155E'   CD 065A'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1561'   CA 06EB'              	JZ	SETMOV
  1564'   CD 0665'              	CALL	CURCHR		; A = the char under the cursor
  1567'   FE 0D                 	CPI	CR
  1569'   CA 06EB'              	JZ	SETMOV		; the line's end: nothing to toggle
  156C'   FE 0A                 	CPI	LF
  156E'   CA 06EB'              	JZ	SETMOV
  1571'   47                    	MOV	B,A
  1572'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1574'   FE 41                 	CPI	'A'
  1576'   DA 1582'              	JC	VT_PUT		; below 'A': no case
  1579'   FE 5B                 	CPI	'Z'+1
  157B'   D2 1582'              	JNC	VT_PUT		; above 'Z': no case
  157E'   78                    	MOV	A,B
  157F'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1581'   47                    	MOV	B,A
  1582'                         VT_PUT:
  1582'   78                    	MOV	A,B
  1583'   32 294D'              	STA	VRCH		; the calls below do not preserve B
  1586'   CD 0188'              	CALL	MARKMOD
  1589'   21 0001               	LXI	H,1
  158C'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  158F'   3A 294D'              	LDA	VRCH
  1592'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1595'   C3 1404'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  1598'                         VC_R:
  1598'   CD 066B'              	CALL	MOVCNT		; a cursor motion, and its count
  159B'   3E 03                 	MVI	A,PR
  159D'   32 2925'              	STA	GPEND
  15A0'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  15A1'                         VR_DO:
  15A1'   AF                    	XRA	A
  15A2'   32 2925'              	STA	GPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  15A5'   79                    	MOV	A,C
  15A6'   32 294D'              	STA	VRCH		; the calls below do not preserve C
  15A9'   CD 06F1'              	CALL	SETLIN		; only this row changed
  15AC'   CD 085E'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  15AF'   CD 065A'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  15B2'   CA 06EB'              	JZ	SETMOV		; the end of the text: vim does nothing
  15B5'   CD 0665'              	CALL	CURCHR		; A = the char under the cursor
  15B8'   FE 0D                 	CPI	CR
  15BA'   CA 06EB'              	JZ	SETMOV		; the line's end: nothing to replace
  15BD'   FE 0A                 	CPI	LF
  15BF'   CA 06EB'              	JZ	SETMOV
  15C2'   CD 0188'              	CALL	MARKMOD
  15C5'   21 0001               	LXI	H,1
  15C8'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  15CB'   3A 294D'              	LDA	VRCH
  15CE'   FE 0D                 	CPI	CR
  15D0'   CA 15DD'              	JZ	VR_CR
  15D3'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  15D6'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  15D9'   2B                    	DCX	H		;   out, which moves every logical offset
  15DA'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  15DD'                         VR_CR:
  15DD'   CD 1488'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  15E0'   CD 1495'              	CALL	ENDBRK		;   replaced char may have been the text's last
  15E3'   CD 06F7'              	CALL	SETILN		;   row above it lost the char that was replaced,
  15E6'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  15E8'   32 2905'              	STA	ILABOV
  15EB'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  15EC'                         VCB_R:
  15EC'   CD 067E'              	CALL	GETCNT
  15EF'   CD 06EB'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  15F2'   21 0000               	LXI	H,0
  15F5'   22 294E'              	SHLD	RPDEL		; nothing of ours to put back yet
  15F8'   22 2950'              	SHLD	RPAPP
  15FB'   3E 02                 	MVI	A,EM_REP
  15FD'   32 28FD'              	STA	EDMODE
  1600'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1601'                         VC_D:
  1601'   3E 64                 	MVI	A,'d'
  1603'   32 2927'              	STA	PENDOP
  1606'   C3 06EB'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1609'                         VC_C:
  1609'   3E 63                 	MVI	A,'c'
  160B'   32 2927'              	STA	PENDOP
  160E'   C3 06EB'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1611'                         VD_DD:
  1611'   CD 085E'              	CALL	GLSTAL
  1614'   CD 067E'              	CALL	GETCNT
  1617'   22 2940'              	SHLD	CNTV
  161A'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  161C'   32 2929'              	STA	DDSNG
  161F'   2B                    	DCX	H
  1620'   7C                    	MOV	A,H
  1621'   B5                    	ORA	L
  1622'   C2 162D'              	JNZ	VDD_LS
  1625'   3E 01                 	MVI	A,1
  1627'   32 2929'              	STA	DDSNG
  162A'   C3 1633'              	JMP	VDD_GO
  162D'                         VDD_LS:
  162D'   CD 0824'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1630'   DA 06EB'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1633'                         VDD_GO:
  1633'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1636'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1639'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  163C'   CD 1FDD'              	CALL	COPY12		;   every mark in the lines has closed up by then
  163F'   CD 07A2'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1642'   2A 2940'              	LHLD	CNTV
  1645'   CD 0000*              	CALL	SETC0
  1648'                         VDD_FW:
  1648'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  164B'   DA 1799'              	JC	QREFUS		; ... which has no room for them
  164E'   CD 0693'              	CALL	CNTTST
  1651'   C2 1648'              	JNZ	VDD_FW
  1654'   CD 0188'              	CALL	MARKMOD
  1657'   CD 0995'              	CALL	ATEOF
  165A'   D2 1675'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  165D'   3E 00                 	MVI	A,0
  165F'   32 2929'              	STA	DDSNG		; deleted to the end: full repaint
  1662'   CD 0DDB'              	CALL	ONFST
  1665'   CA 07B9'              	JZ	FNBLNK		; nothing left before it
  1668'   21 0001               	LXI	H,1		; onto the new last line
  166B'   CD 0000*              	CALL	SETBWD
  166E'   2A 0000*              	LHLD	LNDLT
  1671'   2B                    	DCX	H
  1672'   22 0000*              	SHLD	LNDLT
  1675'                         VDD_UP:
  1675'   CD 07B9'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


                                	;    DL + a bottom redraw. ---
  1678'   3A 2929'              	LDA	DDSNG
  167B'   B7                    	ORA	A
  167C'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  167D'   3E 03                 	MVI	A,R_DLIN
  167F'   32 2902'              	STA	RINTENT
  1682'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1683'                         QEMPTY:
  1683'   2A 0000*              	LHLD	QBEG
  1686'   EB                    	XCHG
  1687'   2A 0000*              	LHLD	QEND
  168A'   7C                    	MOV	A,H
  168B'   BA                    	CMP	D
  168C'   C0                    	RNZ
  168D'   7D                    	MOV	A,L
  168E'   BB                    	CMP	E
  168F'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1690'                         VC_Y:
  1690'   3E 79                 	MVI	A,'y'
  1692'   32 2927'              	STA	PENDOP
  1695'   C3 06EB'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1698'                         VY_YY:
  1698'   21 2930'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  169B'   CD 0442'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  169E'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  16A1'   22 2971'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  16A4'   CD 05D7'              	CALL	BOL
  16A7'   22 2973'              	SHLD	YPT		; where the lines come from, to put them back
  16AA'   CD 17FF'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  16AD'   CD 1842'              	CALL	YNCOPY		; copied where they lie, if that can be done
  16B0'   D2 1806'              	JNC	YNDONE
  16B3'   21 1611'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  16B6'   C3 16E2'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  16B9'                         OPYANK:
  16B9'   CD 1319'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  16BC'   2A 292C'              	LHLD	OPSTA
  16BF'   EB                    	XCHG			; DE = start
  16C0'   2A 292E'              	LHLD	OPEND2		; HL = end
  16C3'   CD 0000*              	CALL	CMP16		; CY iff start < end
  16C6'   D2 16CA'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  16C9'   EB                    	XCHG			; ... otherwise the start is
  16CA'                         OPY_LO:
  16CA'   22 2971'              	SHLD	YOFF
  16CD'   2A 293C'              	LHLD	OPLO
  16D0'   22 2973'              	SHLD	YPT		; where the lines come from, to put them back
  16D3'   CD 17FF'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  16D6'   CD 18BA'              	CALL	YNSPAN		; copied where they lie, if there is room
  16D9'   D2 1806'              	JNC	YNDONE
  16DC'   21 17C0'              	LXI	H,YSPAN
  16DF'   C3 16E2'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  16E2'                         YKGO:
  16E2'   22 299A'              	SHLD	YACT
  16E5'   2A 2973'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  16E8'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  16E9'   2A 2971'              	LHLD	YOFF		;   survive this -- the put-back below can page
  16EC'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  16EF'   22 29A0'              	SHLD	YCOL		;   them -- but a distance within the lines does
  16F2'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  16F5'   E5                    	PUSH	H		;   pages the window on when the count's lines
  16F6'   2A 2973'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  16F9'   EB                    	XCHG			;   window as it was, then names other text
  16FA'   E1                    	POP	H
  16FB'   CD 0000*              	CALL	SUBHD
  16FE'   EB                    	XCHG			; DE = how far behind the cursor they start
  16FF'   CD 0E96'              	CALL	CURFP
  1702'   06 00                 	MVI	B,0
  1704'   CD 0E8C'              	CALL	SUB24
  1707'   22 29A2'              	SHLD	YPFP
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  170A'   32 29A4'              	STA	YPFP+2
  170D'   3A 2901'              	LDA	MODF
  1710'   32 296E'              	STA	YMODF
  1713'   3A 291A'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1716'   32 296F'              	STA	YDCHG		;   a yank must not become the last change
  1719'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  171C'   32 2970'              	STA	YURPL		;   back are not a change to undo either
  171F'   3E 01                 	MVI	A,1
  1721'   32 0000*              	STA	UNDRPL
  1724'   32 2999'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1727'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  172A'   22 297C'              	SHLD	YLDLT
  172D'   CD 0000*              	CALL	LOGLEN
  1730'   22 299E'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1733'   2A 299A'              	LHLD	YACT
  1736'   CD 1798'              	CALL	YCALL		; the lines out of the file, into the register
  1739'   3A 2969'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  173C'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  173E'   CA 177C'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1741'   CD 0000*              	CALL	LOGLEN
  1744'   EB                    	XCHG
  1745'   2A 299E'              	LHLD	YWAS
  1748'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  174B'   CA 175D'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  174E'   21 29A2'              	LXI	H,YPFP		; back to where they came from, by its place in
  1751'   CD 03F5'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1754'   CD 03C2'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1757'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  175A'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  175D'                         YK_FIN:				; (nothing came out: nothing went back, and the
  175D'   2A 29A2'              	LHLD	YPFP		;   cursor is still owed its place)
  1760'   EB                    	XCHG
  1761'   2A 29A0'              	LHLD	YCOL
  1764'   19                    	DAD	D
  1765'   22 2995'              	SHLD	MKPOS
  1768'   3A 29A4'              	LDA	YPFP+2
  176B'   CE 00                 	ACI	0
  176D'   32 2997'              	STA	MKPOS+2
  1770'   CD 03C2'              	CALL	MKPAGE
  1773'   CD 0000*              	CALL	GOTO
  1776'                         YK_RST:
  1776'   2A 297C'              	LHLD	YLDLT
  1779'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  177C'                         YK_RF:
  177C'   3A 296E'              	LDA	YMODF
  177F'   32 2901'              	STA	MODF
  1782'   3A 296F'              	LDA	YDCHG
  1785'   32 291A'              	STA	DOTCHG
  1788'   3A 2970'              	LDA	YURPL
  178B'   32 0000*              	STA	UNDRPL
  178E'   AF                    	XRA	A
  178F'   32 2999'              	STA	MKHOLD
  1792'   CD 085E'              	CALL	GLSTAL
  1795'   C3 070C'              	JMP	SETFUL		; the cheap paint cannot carry this
  1798'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1799'                         QREFUS:
  1799'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  179C'   CD 1683'              	CALL	QEMPTY
  179F'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  17A2'   CD 0000*              	CALL	QKILL
  17A5'   3A 2999'              	LDA	MKHOLD
  17A8'   B7                    	ORA	A
  17A9'   C2 17B8'              	JNZ	QRF_Y
  17AC'   21 0000*              	LXI	H,MKSAV
  17AF'   11 0000*              	LXI	D,MKTAB
  17B2'   CD 1FDD'              	CALL	COPY12
  17B5'   CD 0000*              	CALL	UNDCLR
  17B8'                         QRF_Y:
  17B8'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  17BA'   32 2969'              	STA	MSGWHT
  17BD'   C3 11BB'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  17C0'                         YSPAN:
  17C0'   CD 085E'              	CALL	GLSTAL
  17C3'   CD 12DA'              	CALL	OPSPNL		; HL = the span's length
  17C6'   22 299C'              	SHLD	YTGT
  17C9'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  17CC'   EB                    	XCHG			; DE = it
  17CD'   2A 299C'              	LHLD	YTGT
  17D0'   EB                    	XCHG			; HL = the text's, DE = the span's
  17D1'   CD 0000*              	CALL	SUBHD
  17D4'   22 299C'              	SHLD	YTGT		; what the text is left at when the span is out
  17D7'   2A 293C'              	LHLD	OPLO
  17DA'   CD 0000*              	CALL	GOTO
  17DD'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  17E0'                         YS_LP:
  17E0'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  17E3'   CD 0000*              	CALL	SETC0
  17E6'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  17E9'   DA 1799'              	JC	QREFUS		; ... which has no room for it
  17EC'   CD 0000*              	CALL	LOGLEN
  17EF'   EB                    	XCHG			; DE = what is left
  17F0'   2A 299C'              	LHLD	YTGT
  17F3'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  17F6'   DA 17FC'              	JC	YS_END		; below it -- cannot happen over whole lines,
  17F9'   C2 17E0'              	JNZ	YS_LP		;   but never spin here if it ever did
  17FC'                         YS_END:
  17FC'   C3 0188'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  17FF'                         YNPRE:
  17FF'   2A 0000*              	LHLD	PGTOPM
  1802'   22 29A5'              	SHLD	YNPG
  1805'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1806'                         YNDONE:
  1806'   2A 2971'              	LHLD	YOFF
  1809'   CD 0000*              	CALL	GOTO
  180C'   2A 0000*              	LHLD	PGTOPM
  180F'   EB                    	XCHG
  1810'   2A 29A5'              	LHLD	YNPG
  1813'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1816'   C2 070C'              	JNZ	SETFUL		; it moved under us: repaint after all
  1819'   C3 06EB'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  181C'                         YNROOM:
  181C'   11 0100               	LXI	D,100H
  181F'   19                    	DAD	D
  1820'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1821'   E5                    	PUSH	H		; the span plus its slack
  1822'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1825'   EB                    	XCHG			; HL = free
  1826'   D1                    	POP	D		; DE = the span plus its slack
  1827'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  182A'   DA 1832'              	JC	YNR_OK
  182D'   CA 1832'              	JZ	YNR_OK
  1830'   37                    	STC			; not enough: the delete-and-put-back path
  1831'   C9                    	RET
  1832'                         YNR_OK:
  1832'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1833'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1834'                         YNGO:
  1834'   C5                    	PUSH	B
  1835'   CD 067E'              	CALL	GETCNT		; spent here: this yank is happening
  1838'   CD 085E'              	CALL	GLSTAL
  183B'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  183E'   C1                    	POP	B
  183F'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1842'                         YNCOPY:
  1842'   2A 28FE'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1845'   7C                    	MOV	A,H		;   the count itself
  1846'   B5                    	ORA	L
  1847'   C2 184D'              	JNZ	YNC_HV
  184A'   21 0001               	LXI	H,1
  184D'                         YNC_HV:
  184D'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  184E'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  184F'   B4                    	ORA	H
  1850'   CA 185B'              	JZ	YNC_M
  1853'   E5                    	PUSH	H
  1854'   CD 0824'              	CALL	ONLAST		; vim: a count over one on the last line does
  1857'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1858'   DA 186D'              	JC	YNC_RF
  185B'                         YNC_M:
  185B'   E5                    	PUSH	H
  185C'   CD 07A2'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  185F'   E1                    	POP	H
  1860'   CD 1875'              	CALL	YNLINE		; BC = the span, measured where it stands
  1863'   D8                    	RC			; not measurable here: let the pager answer it
  1864'   60                    	MOV	H,B
  1865'   69                    	MOV	L,C
  1866'   CD 181C'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1869'   D8                    	RC			; no: the delete-and-put-back path
  186A'   C3 1834'              	JMP	YNGO
  186D'                         YNC_RF:
  186D'   CD 067E'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1870'   CD 085E'              	CALL	GLSTAL		;   register alone, and that is the command
  1873'   B7                    	ORA	A		; NC: done
  1874'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1875'                         YNLINE:
  1875'   22 29A7'              	SHLD	YNCNT		; the lines it still wants
  1878'   2A 0000*              	LHLD	GAPEND
  187B'                         YNL_LP:
  187B'   EB                    	XCHG			; DE = the scan
  187C'   2A 0000*              	LHLD	TXTEND
  187F'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1882'   EB                    	XCHG			; HL = the scan
  1883'   D2 18A3'              	JNC	YNL_EN		; the resident text ran out
  1886'   7E                    	MOV	A,M
  1887'   23                    	INX	H
  1888'   FE 0A                 	CPI	LF
  188A'   C2 187B'              	JNZ	YNL_LP
  188D'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  188E'   2A 29A7'              	LHLD	YNCNT
  1891'   2B                    	DCX	H
  1892'   22 29A7'              	SHLD	YNCNT
  1895'   7C                    	MOV	A,H
  1896'   B5                    	ORA	L
  1897'   E1                    	POP	H
  1898'   C2 187B'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  189B'   EB                    	XCHG			; DE = past the last of them
  189C'   2A 0000*              	LHLD	GAPEND
  189F'   EB                    	XCHG			; HL = past them, DE = GAPEND
  18A0'   C3 18B1'              	JMP	YNL_BC
  18A3'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  18A3'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  18A6'   C2 18B8'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  18A9'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  18AC'   EB                    	XCHG			;   count clamps to it as vim's does
  18AD'   2A 0000*              	LHLD	GAPEND
  18B0'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  18B1'                         YNL_BC:
  18B1'   CD 0000*              	CALL	SUBHD		; HL = the span
  18B4'   44                    	MOV	B,H
  18B5'   4D                    	MOV	C,L
  18B6'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  18B7'   C9                    	RET
  18B8'                         YNL_NO:
  18B8'   37                    	STC
  18B9'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  18BA'                         YNSPAN:
  18BA'   CD 12DA'              	CALL	OPSPNL		; HL = the span's length
  18BD'   44                    	MOV	B,H
  18BE'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  18BF'   CD 181C'              	CALL	YNROOM
  18C2'   D8                    	RC			; no room: the delete-and-put-back path
  18C3'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  18C4'   2A 293C'              	LHLD	OPLO
  18C7'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  18CA'   C1                    	POP	B
  18CB'   C3 1834'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  18CE'                         VC_P:
  18CE'   CD 1683'              	CALL	QEMPTY
  18D1'   CA 1989'              	JZ	VP_BEL
  18D4'   CD 067E'              	CALL	GETCNT
  18D7'   22 2975'              	SHLD	PCNT
  18DA'   CD 0000*              	CALL	CUROFF
  18DD'   CD 0607'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  18E0'   C3 18F5'              	JMP	VP_GO
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  18E3'                         VCB_P:
  18E3'   CD 1683'              	CALL	QEMPTY
  18E6'   CA 1989'              	JZ	VP_BEL
  18E9'   CD 067E'              	CALL	GETCNT
  18EC'   22 2975'              	SHLD	PCNT
  18EF'   CD 0000*              	CALL	CUROFF
  18F2'   CD 05D7'              	CALL	BOL
  18F5'                         VP_GO:
  18F5'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  18F8'   CD 0000*              	CALL	CUROFF
  18FB'   EB                    	XCHG
  18FC'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  18FF'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1902'   DA 1917'              	JC	VP_IN
  1905'   EB                    	XCHG			; HL = the put point = LOGLEN
  1906'   7C                    	MOV	A,H
  1907'   B5                    	ORA	L
  1908'   CA 1914'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  190B'   2B                    	DCX	H
  190C'   CD 0000*              	CALL	CHARAT
  190F'   FE 0A                 	CPI	LF
  1911'   CA 1917'              	JZ	VP_IN
  1914'                         VP_BRK:
  1914'   CD 1488'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1917'                         VP_IN:
  1917'   CD 0000*              	CALL	CUROFF
  191A'   22 2977'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  191D'   2A 0000*              	LHLD	QBEG
  1920'   EB                    	XCHG
  1921'   2A 0000*              	LHLD	QEND
  1924'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1927'   EB                    	XCHG
  1928'   22 2979'              	SHLD	PLFS
  192B'   2A 2975'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  192E'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  192F'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1930'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1932'   C2 1936'              	JNZ	VP_PZ
  1935'   7D                    	MOV	A,L
  1936'                         VP_PZ:
  1936'   32 297B'              	STA	PCPY
  1939'                         VP_LP:
  1939'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  193C'   2A 0000*              	LHLD	LNDLT
  193F'   EB                    	XCHG
  1940'   2A 2979'              	LHLD	PLFS
  1943'   19                    	DAD	D
  1944'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  1947'   2A 2975'              	LHLD	PCNT
  194A'   2B                    	DCX	H
  194B'   22 2975'              	SHLD	PCNT
  194E'   7C                    	MOV	A,H
  194F'   B5                    	ORA	L
  1950'   C2 1939'              	JNZ	VP_LP
  1953'   CD 0188'              	CALL	MARKMOD
  1956'   2A 2977'              	LHLD	PPT
  1959'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  195C'   CD 085E'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  195F'   3A 297B'              	LDA	PCPY
  1962'   B7                    	ORA	A
  1963'   CA 07B9'              	JZ	FNBLNK
  1966'   2A 2979'              	LHLD	PLFS
  1969'   7C                    	MOV	A,H
  196A'   B7                    	ORA	A
  196B'   C2 07B9'              	JNZ	FNBLNK
  196E'   3A 297B'              	LDA	PCPY
  1971'   CD 0D71'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1974'   7C                    	MOV	A,H
  1975'   B7                    	ORA	A
  1976'   C2 07B9'              	JNZ	FNBLNK
  1979'   7D                    	MOV	A,L
  197A'   B7                    	ORA	A
  197B'   CA 07B9'              	JZ	FNBLNK
  197E'   F5                    	PUSH	PSW
  197F'   CD 06F7'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1982'   F1                    	POP	PSW
  1983'   32 2903'              	STA	ILN		; ... which the lines put now replace
  1986'   C3 07B9'              	JMP	FNBLNK
  1989'                         VP_BEL:
  1989'   CD 067E'              	CALL	GETCNT		; the count is spent either way
  198C'   0E 07                 	MVI	C,BEL
  198E'   CD 0000*              	CALL	BCONOU
  1991'   C3 06EB'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  1994'                         VIREP:
  1994'   78                    	MOV	A,B
  1995'   FE 01                 	CPI	KT_ACT
  1997'   CA 1AC4'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  199A'   FE 02                 	CPI	KT_CHAR
  199C'   C0                    	RNZ			; ignore anything else
  199D'   79                    	MOV	A,C
  199E'   FE 0D                 	CPI	CR
  19A0'   CA 1A04'              	JZ	VP_CR
  19A3'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  19A5'   CA 1A04'              	JZ	VP_CR
  19A8'   FE 08                 	CPI	BS
  19AA'   CA 1A10'              	JZ	VP_BS
  19AD'   FE 7F                 	CPI	DEL
  19AF'   CA 1A10'              	JZ	VP_BS
  19B2'   32 294D'              	STA	VRCH		; the calls below do not preserve C
  19B5'   CD 06F1'              	CALL	SETLIN		; this row changed
  19B8'   CD 0188'              	CALL	MARKMOD
  19BB'   CD 147B'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  19BE'   CA 19F6'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  19C1'   3A 294D'              	LDA	VRCH
  19C4'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  19C7'   2A 294E'              	LHLD	RPDEL
  19CA'   7C                    	MOV	A,H
  19CB'   B5                    	ORA	L
  19CC'   CA 19E2'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  19CF'   2A 0000*              	LHLD	GAPEND
  19D2'   EB                    	XCHG
  19D3'   2A 2952'              	LHLD	RPGE
  19D6'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  19D9'   CA 19E2'              	JZ	VP_OVW
  19DC'   21 0000               	LXI	H,0
  19DF'   22 294E'              	SHLD	RPDEL		; the text moved: those originals are gone
  19E2'                         VP_OVW:
  19E2'   21 0001               	LXI	H,1
  19E5'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  19E8'   2A 0000*              	LHLD	GAPEND
  19EB'   22 2952'              	SHLD	RPGE
  19EE'   2A 294E'              	LHLD	RPDEL
  19F1'   23                    	INX	H
  19F2'   22 294E'              	SHLD	RPDEL
  19F5'   C9                    	RET
  19F6'                         VP_APP:
  19F6'   3A 294D'              	LDA	VRCH
  19F9'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  19FC'   2A 2950'              	LHLD	RPAPP
  19FF'   23                    	INX	H
  1A00'   22 2950'              	SHLD	RPAPP
  1A03'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  1A04'                         VP_CR:
  1A04'   21 0000               	LXI	H,0
  1A07'   22 294E'              	SHLD	RPDEL		; a line break ends what BS can put back
  1A0A'   22 2950'              	SHLD	RPAPP
  1A0D'   C3 1A9A'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1A10'                         VP_BS:
  1A10'   2A 2950'              	LHLD	RPAPP
  1A13'   7C                    	MOV	A,H
  1A14'   B5                    	ORA	L
  1A15'   CA 1A22'              	JZ	VP_BSD
  1A18'   2B                    	DCX	H
  1A19'   22 2950'              	SHLD	RPAPP		; an appended char: it just goes
  1A1C'   CD 06F1'              	CALL	SETLIN
  1A1F'   C3 0000*              	JMP	DELPRV
  1A22'                         VP_BSD:
  1A22'   2A 294E'              	LHLD	RPDEL
  1A25'   7C                    	MOV	A,H
  1A26'   B5                    	ORA	L
  1A27'   CA 1A4E'              	JZ	VP_BSM		; nothing of ours left
  1A2A'   2A 0000*              	LHLD	GAPEND
  1A2D'   EB                    	XCHG
  1A2E'   2A 2952'              	LHLD	RPGE
  1A31'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1A34'   C2 1A4E'              	JNZ	VP_BSM
  1A37'   2A 294E'              	LHLD	RPDEL
  1A3A'   2B                    	DCX	H
  1A3B'   22 294E'              	SHLD	RPDEL
  1A3E'   CD 06F1'              	CALL	SETLIN
  1A41'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1A44'   CD 0000*              	CALL	UNDELF		; the original comes back
  1A47'   2A 0000*              	LHLD	GAPEND
  1A4A'   22 2952'              	SHLD	RPGE
  1A4D'   C9                    	RET
  1A4E'                         VP_BSM:
  1A4E'   CD 06EB'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1A51'   C3 075A'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  1A54'                         VIINS:
  1A54'   78                    	MOV	A,B
  1A55'   FE 01                 	CPI	KT_ACT
  1A57'   CA 1AC4'              	JZ	VI_ACT
  1A5A'   FE 02                 	CPI	KT_CHAR
  1A5C'   C0                    	RNZ			; ignore anything else
  1A5D'   79                    	MOV	A,C
  1A5E'   FE 0D                 	CPI	CR
  1A60'   CA 1A9A'              	JZ	VI_CR
  1A63'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1A65'   CA 1A9A'              	JZ	VI_CR
  1A68'   FE 08                 	CPI	BS
  1A6A'   CA 1AB2'              	JZ	VI_BS
  1A6D'   FE 7F                 	CPI	DEL
  1A6F'   CA 1AB2'              	JZ	VI_BS
  1A72'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A73'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1A76'   CD 0188'              	CALL	MARKMOD
  1A79'   CD 06F1'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1A7C'   79                    	MOV	A,C
  1A7D'   FE 20                 	CPI	' '
  1A7F'   D8                    	RC			; control char -> keep R_LINE
  1A80'   FE 7F                 	CPI	DEL
  1A82'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1A83'   CD 0712'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1A86'   B7                    	ORA	A
  1A87'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1A88'   3E 04                 	MVI	A,R_ICH
  1A8A'   32 2902'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1A8D'   CD 147B'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1A90'   3E 00                 	MVI	A,0
  1A92'   C2 1A96'              	JNZ	VI_ICH
  1A95'   3C                    	INR	A
  1A96'                         VI_ICH:
  1A96'   32 2904'              	STA	ICHAPP
  1A99'   C9                    	RET
  1A9A'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1A9A'   CD 147B'              	CALL	ATCEND
  1A9D'   3E 00                 	MVI	A,0
  1A9F'   CA 1AA3'              	JZ	VI_CRS
  1AA2'   3C                    	INR	A
  1AA3'                         VI_CRS:
  1AA3'   F5                    	PUSH	PSW
  1AA4'   CD 1488'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1AA7'   CD 1495'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1AAA'   CD 06F7'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1AAD'   F1                    	POP	PSW
  1AAE'   32 2905'              	STA	ILABOV
  1AB1'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1AB2'                         VI_BS:
  1AB2'   CD 0000*              	CALL	PEEKL
  1AB5'   D8                    	RC			; start of the file: nothing to delete
  1AB6'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1AB8'   CA 1ABE'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1ABB'   CD 06F1'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1ABE'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1ABE'   CD 0188'              	CALL	MARKMOD
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1AC1'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1AC4'                         VI_ACT:
  1AC4'   79                    	MOV	A,C
  1AC5'   FE 0B                 	CPI	ACT_ESC
  1AC7'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  1AC8'   3E 00                 	MVI	A,EM_CMD
  1ACA'   32 28FD'              	STA	EDMODE
  1ACD'   CD 06EB'              	CALL	SETMOV
  1AD0'   CD 075A'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1AD3'   C3 085E'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1AD6'                         RDLINE:
  1AD6'   EB                    	XCHG			; HL = buffer
  1AD7'   22 2954'              	SHLD	RLPTR
  1ADA'   3E 00                 	MVI	A,0
  1ADC'   32 2956'              	STA	RLLEN
  1ADF'   78                    	MOV	A,B
  1AE0'   32 2957'              	STA	RLMAX
  1AE3'   79                    	MOV	A,C
  1AE4'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1AE7'                         RL_LP:
  1AE7'   CD 0000*              	CALL	GETKEY
  1AEA'   78                    	MOV	A,B
  1AEB'   FE 01                 	CPI	KT_ACT
  1AED'   CA 1B43'              	JZ	RL_ACT
  1AF0'   FE 02                 	CPI	KT_CHAR
  1AF2'   C2 1AE7'              	JNZ	RL_LP		; ignore other keys
  1AF5'   79                    	MOV	A,C
  1AF6'   FE 0D                 	CPI	CR
  1AF8'   CA 1B54'              	JZ	RL_DONE
  1AFB'   FE 08                 	CPI	BS
  1AFD'   CA 1B2B'              	JZ	RL_BS
  1B00'   FE 7F                 	CPI	DEL
  1B02'   CA 1B2B'              	JZ	RL_BS
  1B05'   FE 20                 	CPI	' '
  1B07'   DA 1AE7'              	JC	RL_LP		; control char -> ignore
  1B0A'   3A 2956'              	LDA	RLLEN
  1B0D'   47                    	MOV	B,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1B0E'   3A 2957'              	LDA	RLMAX
  1B11'   B8                    	CMP	B
  1B12'   CA 1AE7'              	JZ	RL_LP		; full -> ignore
  1B15'   2A 2954'              	LHLD	RLPTR
  1B18'   71                    	MOV	M,C
  1B19'   23                    	INX	H
  1B1A'   22 2954'              	SHLD	RLPTR
  1B1D'   3A 2956'              	LDA	RLLEN
  1B20'   3C                    	INR	A
  1B21'   32 2956'              	STA	RLLEN
  1B24'   79                    	MOV	A,C
  1B25'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1B28'   C3 1AE7'              	JMP	RL_LP
  1B2B'                         RL_BS:				; WM LINEPOP
  1B2B'   3A 2956'              	LDA	RLLEN
  1B2E'   B7                    	ORA	A
  1B2F'   CA 1B49'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1B32'   3D                    	DCR	A
  1B33'   32 2956'              	STA	RLLEN
  1B36'   2A 2954'              	LHLD	RLPTR
  1B39'   2B                    	DCX	H
  1B3A'   22 2954'              	SHLD	RLPTR
  1B3D'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1B40'   C3 1AE7'              	JMP	RL_LP
  1B43'                         RL_ACT:
  1B43'   79                    	MOV	A,C
  1B44'   FE 0B                 	CPI	ACT_ESC
  1B46'   C2 1AE7'              	JNZ	RL_LP
  1B49'                         RL_CAN:
  1B49'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1B4B'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1B4E'   CD 06F1'              	CALL	SETLIN		; redraw one row
  1B51'   3E FF                 	MVI	A,0FFH		; cancelled
  1B53'   C9                    	RET
  1B54'                         RL_DONE:
  1B54'   AF                    	XRA	A
  1B55'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1B56'                         VC_BZ:
  1B56'   CD 06EB'              	CALL	SETMOV
  1B59'   3A 2926'              	LDA	GSAVE
  1B5C'   FE 02                 	CPI	PZ
  1B5E'   CA 1B69'              	JZ	VZ_ZZ
  1B61'   B7                    	ORA	A
  1B62'   C0                    	RNZ			; 'g' was pending: vim drops both
  1B63'   3E 02                 	MVI	A,PZ
  1B65'   32 2925'              	STA	GPEND
  1B68'   C9                    	RET
  1B69'                         VZ_ZZ:
  1B69'   3E 04                 	MVI	A,EO_X
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1B6B'   32 2958'              	STA	EXOP
  1B6E'   3E 01                 	MVI	A,1
  1B70'   32 296B'              	STA	EXBANG		; no '!'
  1B73'   AF                    	XRA	A
  1B74'   32 2959'              	STA	EXARG		; no file name
  1B77'   3A 2901'              	LDA	MODF		; as ':x': a changed text is written first
  1B7A'   B7                    	ORA	A
  1B7B'   CA 1CBC'              	JZ	EX_Q
  1B7E'   C3 1C56'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1B81'                         VC_EX:
  1B81'   CD 067E'              	CALL	GETCNT
  1B84'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1B87'   11 0000*              	LXI	D,EXBUF
  1B8A'   06 28                 	MVI	B,EXMAX
  1B8C'   0E 3A                 	MVI	C,':'
  1B8E'   CD 1AD6'              	CALL	RDLINE
  1B91'   B7                    	ORA	A
  1B92'   C0                    	RNZ			; cancelled
  1B93'   3A 2956'              	LDA	RLLEN
  1B96'   5F                    	MOV	E,A
  1B97'   16 00                 	MVI	D,0
  1B99'   21 0000*              	LXI	H,EXBUF
  1B9C'   19                    	DAD	D
  1B9D'   36 00                 	MVI	M,0		; the line ends with a 0
  1B9F'   21 0000*              	LXI	H,EXBUF
  1BA2'   CD 2172'              	CALL	SKIPB
  1BA5'   C8                    	RZ			; nothing on it
  1BA6'   22 295B'              	SHLD	EXCMD
  1BA9'   CD 235A'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1BAC'   CD 2172'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1BAF'   56                    	MOV	D,M
  1BB0'   23                    	INX	H
  1BB1'   1E 00                 	MVI	E,0
  1BB3'   CD 217E'              	CALL	ISLOW
  1BB6'   DA 1BC1'              	JC	EX_LK
  1BB9'   5F                    	MOV	E,A
  1BBA'   23                    	INX	H
  1BBB'   CD 217E'              	CALL	ISLOW
  1BBE'   D2 1BDA'              	JNC	EX_NOT		; a third letter: none of ours
  1BC1'                         EX_LK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1BC1'   E5                    	PUSH	H
  1BC2'   21 2341'              	LXI	H,EXTAB
  1BC5'                         EX_TL:
  1BC5'   7E                    	MOV	A,M
  1BC6'   B7                    	ORA	A
  1BC7'   CA 1BD9'              	JZ	EX_NTP		; not in the table
  1BCA'   23                    	INX	H
  1BCB'   BA                    	CMP	D
  1BCC'   7E                    	MOV	A,M
  1BCD'   23                    	INX	H
  1BCE'   C2 1BD5'              	JNZ	EX_TN
  1BD1'   BB                    	CMP	E
  1BD2'   CA 1BE0'              	JZ	EX_TF
  1BD5'                         EX_TN:
  1BD5'   23                    	INX	H
  1BD6'   C3 1BC5'              	JMP	EX_TL
  1BD9'                         EX_NTP:
  1BD9'   E1                    	POP	H
  1BDA'                         EX_NOT:
  1BDA'   21 2236'              	LXI	H,SNOT
  1BDD'   C3 21B3'              	JMP	EXERT
  1BE0'                         EX_TF:
  1BE0'   7E                    	MOV	A,M
  1BE1'   32 2958'              	STA	EXOP
  1BE4'   E1                    	POP	H
  1BE5'   FE 06                 	CPI	EO_S
  1BE7'   CA 23C9'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1BEA'   FE 01                 	CPI	EO_W
  1BEC'   CA 1BFB'              	JZ	EX_RG		; ':N,Mw name' takes a range
  1BEF'   FE 08                 	CPI	EO_R
  1BF1'   CA 1BFB'              	JZ	EX_RG		; ... and ':Nr name' a line
  1BF4'   3A 29B1'              	LDA	SRNGF
  1BF7'   B7                    	ORA	A
  1BF8'   C2 1BDA'              	JNZ	EX_NOT		; a range on a command that does not take one
  1BFB'                         EX_RG:
                                	;--- '!', then the file name ---
  1BFB'   7E                    	MOV	A,M
  1BFC'   D6 21                 	SUI	'!'
  1BFE'   32 296B'              	STA	EXBANG		; 0 = '!'
  1C01'   C2 1C05'              	JNZ	EX_NB
  1C04'   23                    	INX	H
  1C05'                         EX_NB:
  1C05'   CD 2172'              	CALL	SKIPB
  1C08'   32 2959'              	STA	EXARG		; 0 = no file name
  1C0B'   CA 1C24'              	JZ	EX_RUN
  1C0E'   22 295B'              	SHLD	EXCMD
  1C11'   3A 2958'              	LDA	EXOP
  1C14'   FE 02                 	CPI	EO_Q
  1C16'   CA 21B0'              	JZ	EX_TRL		; :q takes none
  1C19'   FE 07                 	CPI	EO_V
  1C1B'   CA 21B0'              	JZ	EX_TRL		; nor :ve
  1C1E'   CD 20DC'              	CALL	PARSFN
  1C21'   C2 21A4'              	JNZ	EX_INV
  1C24'                         EX_RUN:
  1C24'   3A 2958'              	LDA	EXOP
  1C27'   FE 05                 	CPI	EO_E
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1C29'   CA 1CD3'              	JZ	EX_E
  1C2C'   FE 02                 	CPI	EO_Q
  1C2E'   CA 1CBC'              	JZ	EX_Q
  1C31'   FE 07                 	CPI	EO_V
  1C33'   CA 21AA'              	JZ	EX_V
  1C36'   FE 08                 	CPI	EO_R
  1C38'   CA 1E64'              	JZ	EX_R
  1C3B'   FE 04                 	CPI	EO_X
  1C3D'   CA 1C4F'              	JZ	EX_XM
  1C40'   FE 01                 	CPI	EO_W
  1C42'   C2 1C56'              	JNZ	EX_W		; :wq
  1C45'   3A 29B1'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  1C48'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  1C49'   C2 1D84'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  1C4C'   C3 1C56'              	JMP	EX_W
  1C4F'                         EX_XM:
  1C4F'   3A 2901'              	LDA	MODF		; :x writes only a changed text
  1C52'   B7                    	ORA	A
  1C53'   CA 1CBC'              	JZ	EX_Q
  1C56'                         EX_W:
  1C56'   CD 1F44'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1C59'   D8                    	RC			; refused (message shown)
  1C5A'   32 295A'              	STA	EXBAK
  1C5D'   3A 2958'              	LDA	EXOP
  1C60'   FE 01                 	CPI	EO_W
  1C62'   CA 1C79'              	JZ	EX_WK
  1C65'   3A 295A'              	LDA	EXBAK
  1C68'   B7                    	ORA	A
  1C69'   C2 1CB9'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1C6C'   3A 296B'              	LDA	EXBANG
  1C6F'   B7                    	ORA	A
  1C70'   CA 1CB9'              	JZ	EX_WQ		; so it does with '!'
  1C73'   CD 1C79'              	CALL	EX_WK		; else it may not: keep the text
  1C76'   C3 1CBC'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1C79'                         EX_WK:
  1C79'   CD 0C7D'              	CALL	CURRW		; the cursor's row and file position
  1C7C'   32 295D'              	STA	WPROW
  1C7F'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1C82'   7D                    	MOV	A,L
  1C83'   E6 7F                 	ANI	7FH
  1C85'   32 295E'              	STA	WPBYT
  1C88'   7D                    	MOV	A,L
  1C89'   17                    	RAL
  1C8A'   7C                    	MOV	A,H
  1C8B'   17                    	RAL
  1C8C'   5F                    	MOV	E,A
  1C8D'   3E 00                 	MVI	A,0
  1C8F'   17                    	RAL
  1C90'   57                    	MOV	D,A		; DE = HL / 128
  1C91'   2A 0000*              	LHLD	OUTPOS
  1C94'   19                    	DAD	D
  1C95'   22 295F'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1C98'   CD 1F79'              	CALL	WRITE
  1C9B'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1C9E'   2A 295F'              	LHLD	WPREC
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1CA1'   EB                    	XCHG
  1CA2'   3A 295E'              	LDA	WPBYT
  1CA5'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1CA8'   CD 0000*              	CALL	GOTO
  1CAB'                         EX_WRW:
  1CAB'   21 0000               	LXI	H,0
  1CAE'   22 0000*              	SHLD	LNDLT
  1CB1'   3A 295D'              	LDA	WPROW
  1CB4'   6F                    	MOV	L,A
  1CB5'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1CB8'   C9                    	RET
  1CB9'                         EX_WQ:
  1CB9'   CD 1F79'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1CBC'                         EX_Q:
  1CBC'   3A 296B'              	LDA	EXBANG
  1CBF'   B7                    	ORA	A
  1CC0'   CA 1CCA'              	JZ	EX_QT
  1CC3'   3A 2901'              	LDA	MODF
  1CC6'   B7                    	ORA	A
  1CC7'   C2 2198'              	JNZ	MSGNWR		; changed, no '!': stay
  1CCA'                         EX_QT:
  1CCA'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1CCD'   3E 01                 	MVI	A,1
  1CCF'   32 2900'              	STA	QUITF
  1CD2'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1CD3'                         EX_E:
  1CD3'   3A 296B'              	LDA	EXBANG
  1CD6'   B7                    	ORA	A
  1CD7'   CA 1CE1'              	JZ	EE_GO
  1CDA'   3A 2901'              	LDA	MODF
  1CDD'   B7                    	ORA	A
  1CDE'   C2 2198'              	JNZ	MSGNWR
  1CE1'                         EE_GO:
  1CE1'   3A 2959'              	LDA	EXARG
  1CE4'   B7                    	ORA	A
  1CE5'   C2 1CEC'              	JNZ	EE_ARG
  1CE8'   CD 1FB5'              	CALL	OWNTF		; no name: the buffer's own
  1CEB'   D8                    	RC
  1CEC'                         EE_ARG:
  1CEC'   CD 1FCB'              	CALL	ISOWN
  1CEF'   21 0001               	LXI	H,1
  1CF2'   C2 1CF9'              	JNZ	EE_LD		; another file: its first line
  1CF5'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1CF8'   23                    	INX	H		; HL = the cursor's line
  1CF9'                         EE_LD:
  1CF9'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1CFB'   32 2969'              	STA	MSGWHT
  1CFE'   E5                    	PUSH	H
  1CFF'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1D02'   21 0000*              	LXI	H,TFCB
  1D05'   11 0000*              	LXI	D,FNAME
  1D08'   CD 1FDD'              	CALL	COPY12		; the buffer's name
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1D0B'   CD 1FA2'              	CALL	SRCTF
  1D0E'   CD 0000*              	CALL	REOPEN
  1D11'   CD 020B'              	CALL	MKCLR		; the marks named the buffer that just went
  1D14'   AF                    	XRA	A
  1D15'   32 2901'              	STA	MODF
  1D18'   E1                    	POP	H
  1D19'   2B                    	DCX	H
  1D1A'   AF                    	XRA	A
  1D1B'   CD 0000*              	CALL	MVLIND		; down to the line
  1D1E'   CD 0995'              	CALL	ATEOF
  1D21'   DC 099B'              	CC	LASTLN		; past the last line: onto it
  1D24'   CD 0EB9'              	CALL	ZSAVE
  1D27'   C3 0F9C'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  1D2A'                         TFDOS:
  1D2A'   C5                    	PUSH	B
  1D2B'   11 0080               	LXI	D,CMDTAIL
  1D2E'   0E 1A                 	MVI	C,1AH		; set the DMA
  1D30'   CD 0005               	CALL	BDOS
  1D33'   C1                    	POP	B
  1D34'   11 0000*              	LXI	D,TFCB
  1D37'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  1D3A'                         EXRNG:
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1D3A'   2A 29B2'              	LHLD	SRNG1
  1D3D'   7C                    	MOV	A,H
  1D3E'   B5                    	ORA	L
  1D3F'   37                    	STC
  1D40'   C8                    	RZ
  1D41'   2A 29B4'              	LHLD	SRNG2
  1D44'   EB                    	XCHG
  1D45'   2A 29B2'              	LHLD	SRNG1
  1D48'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  1D4B'   D8                    	RC
  1D4C'   EB                    	XCHG			; HL = the last line, DE = the first
  1D4D'   CD 0000*              	CALL	SUBHD
  1D50'   23                    	INX	H
  1D51'   22 29BC'              	SHLD	SLINES
  1D54'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  1D55'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  1D56'                         GOLNX:
  1D56'   E5                    	PUSH	H
  1D57'   CD 0E50'              	CALL	GOLN
  1D5A'   CD 0000*              	CALL	CNTLF
  1D5D'   23                    	INX	H		; the line the cursor came to rest on
  1D5E'   D1                    	POP	D
  1D5F'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  1D62'                         EXSAVP:
  1D62'   CD 0C7D'              	CALL	CURRW
  1D65'   32 295D'              	STA	WPROW
  1D68'   21 2995'              	LXI	H,MKPOS
  1D6B'   C3 0442'              	JMP	FPSTO
  1D6E'                         EXRSTP:
  1D6E'   CD 0000*              	CALL	CLRCNT
  1D71'   CD 03C2'              	CALL	MKPAGE		; page until that place is in the window again
  1D74'   CD 0000*              	CALL	GOTO
  1D77'   C3 1CAB'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  1D7A'                         PUTBRK:
  1D7A'   3E 0D                 	MVI	A,CR
  1D7C'   CD 0000*              	CALL	PUTGAP
  1D7F'   3E 0A                 	MVI	A,LF
  1D81'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  1D84'                         EX_WR:
  1D84'   3A 2959'              	LDA	EXARG
  1D87'   B7                    	ORA	A
  1D88'   CA 2186'              	JZ	MSGNFN		; No file name
  1D8B'   CD 1FCB'              	CALL	ISOWN
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1D8E'   CA 1E2E'              	JZ	EXW_OW
  1D91'   CD 0000*              	CALL	TEXIST
  1D94'   32 29BF'              	STA	RWERR		; nonzero: a file of that name is there
  1D97'   CA 1DA1'              	JZ	EXW_GO
  1D9A'   3A 296B'              	LDA	EXBANG
  1D9D'   B7                    	ORA	A
  1D9E'   C2 218C'              	JNZ	MSGEXI		; File exists (! to force)
  1DA1'                         EXW_GO:
  1DA1'   CD 1D3A'              	CALL	EXRNG
  1DA4'   DA 1E28'              	JC	EXW_BD
  1DA7'   CD 1D62'              	CALL	EXSAVP
  1DAA'   2A 29B2'              	LHLD	SRNG1
  1DAD'   CD 1D56'              	CALL	GOLNX
  1DB0'   C2 1E25'              	JNZ	EXW_NL		; the text has no line N
  1DB3'   3A 29BF'              	LDA	RWERR		; a delete scans the whole directory, there or
  1DB6'   B7                    	ORA	A		;   not: only when TEXIST found one
  1DB7'   0E 13                 	MVI	C,13H
  1DB9'   C4 1D2A'              	CNZ	TFDOS		; delete what is there
  1DBC'   0E 16                 	MVI	C,16H
  1DBE'   CD 1D2A'              	CALL	TFDOS		; ... and make it
  1DC1'   3C                    	INR	A
  1DC2'   CA 1E17'              	JZ	EXW_FL		; no directory entry left
  1DC5'   3E 80                 	MVI	A,80H
  1DC7'   32 29BE'              	STA	RWPTR
  1DCA'   AF                    	XRA	A
  1DCB'   32 29BF'              	STA	RWERR
  1DCE'   2A 29BC'              	LHLD	SLINES
  1DD1'   CD 0000*              	CALL	SETC0		; that many lines, forward
  1DD4'                         EXW_LP:
  1DD4'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  1DD7'   E5                    	PUSH	H
  1DD8'   EB                    	XCHG
  1DD9'   2A 0000*              	LHLD	GAPEND
  1DDC'   CD 1E34'              	CALL	RWOUT		; the text from the cursor to there
  1DDF'   E1                    	POP	H
  1DE0'   3A 29BF'              	LDA	RWERR
  1DE3'   B7                    	ORA	A
  1DE4'   C2 1E00'              	JNZ	EXW_EN
  1DE7'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  1DEA'   CD 0693'              	CALL	CNTTST
  1DED'   C2 1DD4'              	JNZ	EXW_LP
  1DF0'                         EXW_PD:				; the last record is padded out with ^Z
  1DF0'   3A 29BE'              	LDA	RWPTR
  1DF3'   FE 80                 	CPI	80H
  1DF5'   CA 1E00'              	JZ	EXW_EN
  1DF8'   3E 1A                 	MVI	A,CPMEOF
  1DFA'   CD 1E40'              	CALL	RWPUT
  1DFD'   C3 1DF0'              	JMP	EXW_PD
  1E00'                         EXW_EN:
  1E00'   0E 10                 	MVI	C,10H
  1E02'   CD 1D2A'              	CALL	TFDOS		; close
  1E05'   3A 29BF'              	LDA	RWERR
  1E08'   B7                    	ORA	A
  1E09'   C2 1E17'              	JNZ	EXW_FL
  1E0C'   CD 1D6E'              	CALL	EXRSTP
  1E0F'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1E11'   32 2969'              	STA	MSGWHT
  1E14'   C3 06EB'              	JMP	SETMOV		; nothing on the screen has changed
  1E17'                         EXW_FL:				; no room: the part written is not left behind
  1E17'   0E 13                 	MVI	C,13H
  1E19'   CD 1D2A'              	CALL	TFDOS
  1E1C'   CD 1D6E'              	CALL	EXRSTP
  1E1F'   21 2337'              	LXI	H,SDFUL
  1E22'   C3 21BE'              	JMP	EXERR
  1E25'                         EXW_NL:
  1E25'   CD 1D6E'              	CALL	EXRSTP
  1E28'                         EXW_BD:
  1E28'   21 2329'              	LXI	H,SRNGE
  1E2B'   C3 21BE'              	JMP	EXERR
  1E2E'                         EXW_OW:
  1E2E'   21 21ED'              	LXI	H,SEXI
  1E31'   C3 21BE'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  1E34'                         RWOUT:
  1E34'   CD 0000*              	CALL	CMP16
  1E37'   C8                    	RZ
  1E38'   7E                    	MOV	A,M
  1E39'   23                    	INX	H
  1E3A'   CD 1E40'              	CALL	RWPUT
  1E3D'   C3 1E34'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  1E40'                         RWPUT:
  1E40'   E5                    	PUSH	H
  1E41'   F5                    	PUSH	PSW
  1E42'   3A 29BE'              	LDA	RWPTR
  1E45'   6F                    	MOV	L,A
  1E46'   26 00                 	MVI	H,0
  1E48'   F1                    	POP	PSW
  1E49'   77                    	MOV	M,A
  1E4A'   2C                    	INR	L		; Z: that was the record's last byte
  1E4B'   7D                    	MOV	A,L
  1E4C'   C2 1E5F'              	JNZ	RWP_ST
  1E4F'   D5                    	PUSH	D
  1E50'   0E 15                 	MVI	C,15H
  1E52'   CD 1D2A'              	CALL	TFDOS		; write it
  1E55'   D1                    	POP	D
  1E56'   B7                    	ORA	A
  1E57'   CA 1E5D'              	JZ	RWP_OK
  1E5A'   32 29BF'              	STA	RWERR
  1E5D'                         RWP_OK:
  1E5D'   3E 80                 	MVI	A,80H
  1E5F'                         RWP_ST:
  1E5F'   32 29BE'              	STA	RWPTR
  1E62'   E1                    	POP	H
  1E63'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  1E64'                         EX_R:
  1E64'   3A 2959'              	LDA	EXARG
  1E67'   B7                    	ORA	A
  1E68'   CA 2186'              	JZ	MSGNFN		; No file name
  1E6B'   0E 0F                 	MVI	C,0FH
  1E6D'   CD 1D2A'              	CALL	TFDOS		; open
  1E70'   3C                    	INR	A
  1E71'   CA 1F3E'              	JZ	ER_NOF
  1E74'   CD 0EDF'              	CALL	GZONE		; the screen's top line, before anything moves
  1E77'   CD 1D62'              	CALL	EXSAVP
  1E7A'   3A 29B1'              	LDA	SRNGF
  1E7D'   B7                    	ORA	A
  1E7E'   CA 1E97'              	JZ	ER_NXT		; no line given: below the cursor's
  1E81'   2A 29B4'              	LHLD	SRNG2
  1E84'   7C                    	MOV	A,H
  1E85'   B5                    	ORA	L
  1E86'   C2 1E91'              	JNZ	ER_LN
  1E89'   23                    	INX	H
  1E8A'   CD 0E50'              	CALL	GOLN		; ':0r': above line 1 ...
  1E8D'   AF                    	XRA	A		;   which never wants a line end put in first
  1E8E'   C3 1EB9'              	JMP	ER_BRK
  1E91'                         ER_LN:
  1E91'   CD 1D56'              	CALL	GOLNX
  1E94'   C2 1E25'              	JNZ	EXW_NL		; the text has no line N
  1E97'                         ER_NXT:
  1E97'   21 0001               	LXI	H,1
  1E9A'   AF                    	XRA	A
  1E9B'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  1E9E'   CD 0995'              	CALL	ATEOF
  1EA1'   3E 00                 	MVI	A,0
  1EA3'   D2 1EB9'              	JNC	ER_BRK		; text follows
  1EA6'   2A 0000*              	LHLD	GAPBEG
  1EA9'   EB                    	XCHG
  1EAA'   2A 0000*              	LHLD	TXTBEG
  1EAD'   CD 0000*              	CALL	CMP16
  1EB0'   3E 01                 	MVI	A,1
  1EB2'   CA 1EB9'              	JZ	ER_BRK		; nothing before the cursor either
  1EB5'   1B                    	DCX	D
  1EB6'   1A                    	LDAX	D
  1EB7'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  1EB9'                         ER_BRK:
  1EB9'   32 29C1'              	STA	RDBRK
  1EBC'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  1EBF'   AF                    	XRA	A
  1EC0'   32 29C0'              	STA	RDANY
  1EC3'                         ER_LP:
  1EC3'   0E 14                 	MVI	C,14H
  1EC5'   CD 1D2A'              	CALL	TFDOS		; the next record
  1EC8'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1EC9'   C2 1EFC'              	JNZ	ER_END
  1ECC'   21 0080               	LXI	H,CMDTAIL
  1ECF'   0E 00                 	MVI	C,0
  1ED1'                         ER_SC:				; C = its bytes, up to a ^Z
  1ED1'   7E                    	MOV	A,M
  1ED2'   FE 1A                 	CPI	CPMEOF
  1ED4'   CA 1EDC'              	JZ	ER_GOT
  1ED7'   23                    	INX	H
  1ED8'   0C                    	INR	C
  1ED9'   F2 1ED1'              	JP	ER_SC		; (minus: all 128)
  1EDC'                         ER_GOT:
  1EDC'   79                    	MOV	A,C
  1EDD'   B7                    	ORA	A
  1EDE'   CA 1EFC'              	JZ	ER_END
  1EE1'   C5                    	PUSH	B
  1EE2'   3A 29C0'              	LDA	RDANY
  1EE5'   B7                    	ORA	A
  1EE6'   CC 1F2D'              	CZ	ER_1ST
  1EE9'   C1                    	POP	B
  1EEA'   06 00                 	MVI	B,0
  1EEC'   11 0080               	LXI	D,CMDTAIL
  1EEF'   C5                    	PUSH	B
  1EF0'   CD 0000*              	CALL	INSBLK
  1EF3'   C1                    	POP	B
  1EF4'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  1EF7'   79                    	MOV	A,C
  1EF8'   17                    	RAL
  1EF9'   DA 1EC3'              	JC	ER_LP		; a full record: there may be more
  1EFC'                         ER_END:
  1EFC'   3A 29C0'              	LDA	RDANY
  1EFF'   B7                    	ORA	A
  1F00'   CA 1F1E'              	JZ	ER_PL		; nothing in the file: nothing has changed
  1F03'   CD 0995'              	CALL	ATEOF
  1F06'   DA 1F13'              	JC	ER_MD		; the text now ends as the file read ends
  1F09'   2A 0000*              	LHLD	GAPBEG
  1F0C'   2B                    	DCX	H
  1F0D'   7E                    	MOV	A,M
  1F0E'   FE 0A                 	CPI	LF
  1F10'   C4 1D7A'              	CNZ	PUTBRK		; text follows: what was read ends a line
  1F13'                         ER_MD:
  1F13'   3E 01                 	MVI	A,1
  1F15'   32 2901'              	STA	MODF
  1F18'   CD 03C2'              	CALL	MKPAGE		; back to the first line read
  1F1B'   CD 0000*              	CALL	GOTO
  1F1E'                         ER_PL:
  1F1E'   CD 0995'              	CALL	ATEOF
  1F21'   DC 099B'              	CC	LASTLN		; (nothing read, at the end: the last line)
  1F24'   CD 0000*              	CALL	CLRCNT
  1F27'   CD 0EF7'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  1F2A'   C3 070C'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  1F2D'                         ER_1ST:
  1F2D'   3C                    	INR	A
  1F2E'   32 29C0'              	STA	RDANY
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1F31'   3A 29C1'              	LDA	RDBRK
  1F34'   B7                    	ORA	A
  1F35'   C4 1D7A'              	CNZ	PUTBRK
  1F38'   21 2995'              	LXI	H,MKPOS
  1F3B'   C3 0442'              	JMP	FPSTO
  1F3E'                         ER_NOF:
  1F3E'   21 2318'              	LXI	H,SNOPN
  1F41'   C3 21B3'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  1F44'                         WRCHK:
  1F44'   3A 2959'              	LDA	EXARG
  1F47'   B7                    	ORA	A
  1F48'   C2 1F52'              	JNZ	WC_ARG
  1F4B'   CD 1FB5'              	CALL	OWNTF
  1F4E'   D8                    	RC
  1F4F'   C3 1F67'              	JMP	WC_OWN
  1F52'                         WC_ARG:
  1F52'   CD 1FCB'              	CALL	ISOWN
  1F55'   CA 1F67'              	JZ	WC_OWN
  1F58'   3A 296B'              	LDA	EXBANG
  1F5B'   B7                    	ORA	A
  1F5C'   CA 1F65'              	JZ	WC_OTH
  1F5F'   CD 0000*              	CALL	TEXIST
  1F62'   C2 218C'              	JNZ	MSGEXI		; File exists (! to force)
  1F65'                         WC_OTH:
  1F65'   AF                    	XRA	A		; (NC)
  1F66'   C9                    	RET
  1F67'                         WC_OWN:
  1F67'   3A 296C'              	LDA	ROFLAG		; '-R': this is the file it may not write
  1F6A'   B7                    	ORA	A
  1F6B'   CA 1F75'              	JZ	WC_OK
  1F6E'   3A 296B'              	LDA	EXBANG
  1F71'   B7                    	ORA	A
  1F72'   C2 2192'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  1F75'                         WC_OK:
  1F75'   3E 01                 	MVI	A,1
  1F77'   B7                    	ORA	A		; (NC)
  1F78'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  1F79'                         WRITE:
  1F79'   3A 295A'              	LDA	EXBAK
  1F7C'   CD 0000*              	CALL	WRTO
  1F7F'   3A 0001*              	LDA	FNAME+1
  1F82'   FE 20                 	CPI	' '
  1F84'   C2 1F90'              	JNZ	WR_HAS
  1F87'   21 0000*              	LXI	H,TFCB
  1F8A'   11 0000*              	LXI	D,FNAME
  1F8D'   CD 1FDD'              	CALL	COPY12
  1F90'                         WR_HAS:
  1F90'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F92'   32 2969'              	STA	MSGWHT
  1F95'   CD 1FCB'              	CALL	ISOWN
  1F98'   C2 1FA2'              	JNZ	SRCTF
  1F9B'   AF                    	XRA	A
  1F9C'   32 2901'              	STA	MODF
  1F9F'   32 296A'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  1FA2'                         SRCTF:
  1FA2'   21 0000*              	LXI	H,TFCB
  1FA5'   11 005C               	LXI	D,DFTFCB
  1FA8'   CD 1FDD'              	CALL	COPY12
  1FAB'   AF                    	XRA	A
  1FAC'   06 04                 	MVI	B,4
  1FAE'                         SRC_Z:
  1FAE'   12                    	STAX	D		; extent, s1, s2, record count: 0
  1FAF'   13                    	INX	D
  1FB0'   05                    	DCR	B
  1FB1'   C2 1FAE'              	JNZ	SRC_Z
  1FB4'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  1FB5'                         OWNTF:
  1FB5'   3A 0001*              	LDA	FNAME+1
  1FB8'   FE 20                 	CPI	' '
  1FBA'   CA 2186'              	JZ	MSGNFN
  1FBD'   CD 1FE8'              	CALL	TFCLR
  1FC0'   21 0000*              	LXI	H,FNAME
  1FC3'   11 0000*              	LXI	D,TFCB
  1FC6'   CD 1FDD'              	CALL	COPY12
  1FC9'   B7                    	ORA	A		; (NC)
  1FCA'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  1FCB'                         ISOWN:
  1FCB'   21 0000*              	LXI	H,TFCB
  1FCE'   11 0000*              	LXI	D,FNAME
  1FD1'   06 0C                 	MVI	B,12
  1FD3'                         IO_LP:
  1FD3'   1A                    	LDAX	D
  1FD4'   BE                    	CMP	M
  1FD5'   C0                    	RNZ
  1FD6'   23                    	INX	H
  1FD7'   13                    	INX	D
  1FD8'   05                    	DCR	B
  1FD9'   C2 1FD3'              	JNZ	IO_LP
  1FDC'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  1FDD'                         COPY12:
  1FDD'   06 0C                 	MVI	B,12
  1FDF'                         CP_LP:
  1FDF'   7E                    	MOV	A,M
  1FE0'   12                    	STAX	D
  1FE1'   23                    	INX	H
  1FE2'   13                    	INX	D
  1FE3'   05                    	DCR	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1FE4'   C2 1FDF'              	JNZ	CP_LP
  1FE7'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  1FE8'                         TFCLR:
  1FE8'   11 0000*              	LXI	D,TFCB
  1FEB'   06 24                 	MVI	B,36
  1FED'   AF                    	XRA	A
  1FEE'                         TC_LP:
  1FEE'   12                    	STAX	D
  1FEF'   13                    	INX	D
  1FF0'   05                    	DCR	B
  1FF1'   C2 1FEE'              	JNZ	TC_LP
  1FF4'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  1FF5'                         FOPEN:
  1FF5'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  1FF7'   32 2969'              	STA	MSGWHT
  1FFA'   21 005C               	LXI	H,DFTFCB
  1FFD'   CD 20CF'              	CALL	NRMDRV
  2000'   11 0000*              	LXI	D,FNAME
  2003'   CD 1FDD'              	CALL	COPY12
  2006'   CD 0000*              	CALL	OPENZ
  2009'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  200C'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  200E'   C8                    	RZ
  200F'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  2012'   32 296A'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  2015'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


                                ;============================================================
  2016'                         ARGSCN:
  2016'   3A 0080               	LDA	CMDTAIL
  2019'   47                    	MOV	B,A		; B = what is left of the line
  201A'   B7                    	ORA	A
  201B'   C8                    	RZ
  201C'   21 0081               	LXI	H,CMDTAIL+1
  201F'                         AS_TOK:				; at a token, or the blanks before one
  201F'   7E                    	MOV	A,M
  2020'   FE 20                 	CPI	' '
  2022'   C2 202B'              	JNZ	AS_OPT
  2025'   23                    	INX	H
  2026'   05                    	DCR	B
  2027'   C2 201F'              	JNZ	AS_TOK
  202A'   C9                    	RET
  202B'                         AS_OPT:
  202B'   FE 2B                 	CPI	'+'
  202D'   CA 2057'              	JZ	AS_PLS
  2030'   FE 2D                 	CPI	'-'
  2032'   CA 2046'              	JZ	AS_SW
  2035'   FE 2F                 	CPI	'/'
  2037'   CA 2046'              	JZ	AS_SW
  203A'                         AS_SKP:				; not ours (the file name): on to the next one
  203A'   23                    	INX	H
  203B'   05                    	DCR	B
  203C'   C8                    	RZ
  203D'   7E                    	MOV	A,M
  203E'   FE 20                 	CPI	' '
  2040'   C2 203A'              	JNZ	AS_SKP
  2043'   C3 201F'              	JMP	AS_TOK
  2046'                         AS_SW:
  2046'   23                    	INX	H
  2047'   05                    	DCR	B
  2048'   C8                    	RZ
  2049'   7E                    	MOV	A,M
  204A'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  204C'   FE 52                 	CPI	'R'
  204E'   C2 203A'              	JNZ	AS_SKP
  2051'   32 296C'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  2054'   C3 203A'              	JMP	AS_SKP
  2057'                         AS_PLS:
  2057'   3E 01                 	MVI	A,1
  2059'   32 296D'              	STA	PLUSF		; '+' gets the line even with no number on it
  205C'   11 0000*              	LXI	D,PLUSB
  205F'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  2061'   23                    	INX	H		;   line space, so it is taken as '+' alone
  2062'   05                    	DCR	B
  2063'   CA 209A'              	JZ	AS_PE
  2066'   7E                    	MOV	A,M
  2067'   FE 30                 	CPI	'0'
  2069'   C2 2081'              	JNZ	AS_PD
  206C'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  206C'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  206D'   05                    	DCR	B
  206E'   CA 20A2'              	JZ	AS_P1
  2071'   7E                    	MOV	A,M
