  0AE6'   AF                    	XRA	A		; the start of the file (NC)
  0AE7'   C9                    	RET
  0AE8'                         BK_WD:
  0AE8'   32 26D7'              	STA	WKCLS		; back to the start of this word
  0AEB'                         BK_WLP:
  0AEB'   CD 0B7D'              	CALL	DECC
  0AEE'   B7                    	ORA	A
  0AEF'   FA 0AFF'              	JM	BK_OK		; the start of the file
  0AF2'   CD 0B01'              	CALL	CCLS
  0AF5'   21 26D7'              	LXI	H,WKCLS
  0AF8'   BE                    	CMP	M
  0AF9'   CA 0AEB'              	JZ	BK_WLP
  0AFC'   CD 0B3B'              	CALL	INCC		; overshot: forward one
  0AFF'                         BK_OK:
  0AFF'   AF                    	XRA	A
  0B00'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0B01'                         CCLS:
  0B01'   CD 0985'              	CALL	ATEOF
  0B04'   D2 0690'              	JNC	CLASSF
  0B07'   AF                    	XRA	A
  0B08'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0B09'                         EMPTY:
  0B09'   CD 0985'              	CALL	ATEOF
  0B0C'   DA 0B17'              	JC	EM_ST
  0B0F'   FE 0D                 	CPI	CR
  0B11'   CA 0B17'              	JZ	EM_ST
  0B14'   FE 0A                 	CPI	LF
  0B16'   C0                    	RNZ
  0B17'                         EM_ST:
  0B17'   CD 0000*              	CALL	PEEKL
  0B1A'   DA 0B20'              	JC	EM_Y
  0B1D'   FE 0A                 	CPI	LF
  0B1F'   C9                    	RET
  0B20'                         EM_Y:
  0B20'   AF                    	XRA	A
  0B21'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0B22'                         NXLN:
  0B22'   FE 0A                 	CPI	LF
