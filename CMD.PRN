  2FF5'   C6 40                 	ADI	'A'-1
  2FF7'   CD 0000*              	CALL	OUTCH
  2FFA'   3E 3A                 	MVI	A,':'
  2FFC'   CD 0000*              	CALL	OUTCH
  2FFF'                         MN_NAM:
  2FFF'   E1                    	POP	H
  3000'   E5                    	PUSH	H
  3001'   23                    	INX	H
  3002'   0E 08                 	MVI	C,8
  3004'                         MN_NM:
  3004'   7E                    	MOV	A,M
  3005'   FE 20                 	CPI	' '
  3007'   CA 3012'              	JZ	MN_EXT
  300A'   CD 0000*              	CALL	OUTCH
  300D'   23                    	INX	H
  300E'   0D                    	DCR	C
  300F'   C2 3004'              	JNZ	MN_NM
  3012'                         MN_EXT:
  3012'   E1                    	POP	H
  3013'   11 0009               	LXI	D,9
  3016'   19                    	DAD	D		; the type field
  3017'   7E                    	MOV	A,M
  3018'   FE 20                 	CPI	' '
  301A'   CA 3032'              	JZ	MN_END
  301D'   3E 2E                 	MVI	A,'.'
  301F'   CD 0000*              	CALL	OUTCH
  3022'   0E 03                 	MVI	C,3
  3024'                         MN_XL:
  3024'   7E                    	MOV	A,M
  3025'   FE 20                 	CPI	' '
  3027'   CA 3032'              	JZ	MN_END
  302A'   CD 0000*              	CALL	OUTCH
  302D'   23                    	INX	H
