  2400'   00                    EDMODE: DB	EM_CMD
  2401'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  2403'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  2404'   00                    MODF:	DB	0		; 1 = unsaved changes
  2405'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  2406'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  2407'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  2408'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  2409'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  240B'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  240C'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  240D'   00                    HFROW:	DB	0		; ^D/^U: the cursor's row before the move
  240E'   00                    HFAMT:	DB	0		; ^D/^U: lines (vim's 'scroll'); 0 = NEDIT/2
  240F'   0000                  JKCNT:	DW	0		; j/k: count
  2411'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  2413'   0000                  JKMOV:	DW	0		; j: lines moved
  2415'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  2417'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  2418'   00                    JKLST:	DB	0		; j: last byte of the scan
  2419'   0000                  JKVC:	DW	0		; j/k landing: screen column
  241B'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  241D'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  241E'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  241F'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  2420'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  2421'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  2422'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  2424'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  2425'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  2426'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  2428'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  2429'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  242A'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  242B'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
  242C'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  242D'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  242E'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   so it stops at the line's content end
  242F'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  2431'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  2433'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  2435'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  2437'   0000                  CNTV:	DW	0		; motion repeat counter
  2439'   0000                  TTI:	DW	0		; TAILTAB scan index
  243B'   0000                  WKI:	DW	0		; scan index
  243D'   0000                  WKN:	DW	0		; cached LOGLEN
  243F'   0000                  WKTERM: DW	0		; line terminator offset
  2441'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  2443'   00                    WKCLS:	DB	0		; word motion: class of the current run
  2444'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  2445'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  2447'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  2449'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  244B'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  244D'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  244E'   00                    RLMAX:	DB	0		; RDLINE: capacity
  244F'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  2450'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  2451'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  2452'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  2454'   00                    WPROW:	DB	0		; :w -- the cursor's row
  2455'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  2456'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2458'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  245A'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  245B'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  245D'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  245F'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  2460'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  2461'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  2462'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  2463'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  2464'   00                    PLUSF:	DB	0		; command line: '+' was given
  2465'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  2466'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  2467'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  2468'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  246A'   0000                  YPT:	DW	0		; yy: where the lines came from
  246C'   0000                  PCNT:	DW	0		; p/P: copies still to put
  246E'   0000                  PPT:	DW	0		; p/P: the first line put
  2470'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  2472'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  2473'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  2475'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  2476'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  2477'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  2478'   00                    FNDKND: DB	0		; f/F/t/T: which find ';' repeats (0 = none yet)
  2479'   00                    FNDCH:	DB	0		; ... and the character it looked for
  247A'   00                    FNDRUN: DB	0		; the find THIS command is running (',' reverses)
  247B'   00                    FNDSTP: DB	0		; how far along it starts: 2 for a 't' repeat
  247C'   0000                  FNDN:	DW	0		; occurrences still to count off
  247E'   0000                  FNDCUR: DW	0		; the cursor it started from
  2480'   0000                  FNDLIM: DW	0		; ... and the end of the line it may not pass
  2482'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  2483'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  2486'   0000                  MKEDIT: DW	0		; MKDROP: where the edit that may drop them is
  2488'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  2489'   00                    MKHOLD: DB	0		; set across YKGO's delete + put back (a yank
                                				;   that could not copy): MKDROP must leave the
                                				;   marks alone through it
  248A'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  248C'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  248E'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  2490'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  2492'   0000                  YBLK:	DW	0		; ... and where they ended when they came back
                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  2494'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  2496'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
  2498'   0000                  SCNT:	DW	0		; searches still to do (the count)
  249A'   0000                  SOFF:	DW	0		; where the cursor was when the search began
  249C'   0000                  SLDLT:	DW	0		; ... and LNDLT, for the search that fails
  249E'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  249F'   00                    SRNGF:	DB	0		; ex: a line range was given
  24A0'   0000                  SRNG1:	DW	0		; ex: its first line
  24A2'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  24A4'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  24A5'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  24A6'   00                    SANY:	DB	0		; ':s' something in the range has changed
  24A7'   00                    SLCHG:	DB	0		; ':s' this line changed
  24A8'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  24AA'   0000                  SLINES: DW	0		; ':s' lines of the range still to do
  24AC'   0000                  SOFFS:	DW	0		; ':s' the cursor, for a substitute that
  24AE'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  24B0'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  24B1'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
