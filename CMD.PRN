                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  228D'                         NRMDRV:
  228D'   7E                    	MOV	A,M
  228E'   B7                    	ORA	A
  228F'   C0                    	RNZ
  2290'   E5                    	PUSH	H
  2291'   0E 19                 	MVI	C,BF_CURDSK
  2293'   CD 0005               	CALL	BDOS
  2296'   E1                    	POP	H
  2297'   3C                    	INR	A
  2298'   77                    	MOV	M,A
  2299'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  229A'                         PARSFN:
  229A'   CD 21A6'              	CALL	TFCLR
  229D'   11 0000*              	LXI	D,TFCB
  22A0'   23                    	INX	H
  22A1'   7E                    	MOV	A,M
  22A2'   2B                    	DCX	H
  22A3'   FE 3A                 	CPI	':'
  22A5'   C2 22B7'              	JNZ	PF_NM
  22A8'   CD 22FD'              	CALL	GETFNC
  22AB'   CA 22B7'              	JZ	PF_NM
  22AE'   D6 40                 	SUI	40H
  22B0'   12                    	STAX	D
  22B1'   FE 11                 	CPI	17
  22B3'   D2 22DB'              	JNC	PF_BAD
  22B6'   23                    	INX	H
  22B7'                         PF_NM:
  22B7'   13                    	INX	D
  22B8'   0E 08                 	MVI	C,8
  22BA'   CD 22DF'              	CALL	CPYNAM
  22BD'   FE 2E                 	CPI	'.'
  22BF'   0E 03                 	MVI	C,3
  22C1'   C4 22F2'              	CNZ	PADFLD		; no type: blanks
  22C4'   CC 22DE'              	CZ	CPYNM0		; '.': the type
  22C7'   3A 0001*              	LDA	TFCB+1
  22CA'   FE 20                 	CPI	' '
  22CC'   CA 22DB'              	JZ	PF_BAD		; no name
  22CF'   CD 2330'              	CALL	SKIPB
  22D2'   C0                    	RNZ			; more after it
  22D3'   21 0000*              	LXI	H,TFCB
  22D6'   CD 228D'              	CALL	NRMDRV
  22D9'   AF                    	XRA	A
  22DA'   C9                    	RET
  22DB'                         PF_BAD:
  22DB'   F6 01                 	ORI	1
  22DD'   C9                    	RET
                                
