  288C'   70 74 79 2D           
  2890'   2D 00                 
  2892'   20 77 72 69           SWRIT:	DB	' written',0
  2896'   74 74 65 6E           
  289A'   00                    
  289B'   43 61 6E 27           SNOPN:	DB	'Can''t open file ',0
  289F'   74 20 6F 70           
  28A3'   65 6E 20 66           
  28A7'   69 6C 65 20           
  28AB'   00                    
  28AC'   49 6E 76 61           SRNGE:	DB	'Invalid range',0
  28B0'   6C 69 64 20           
  28B4'   72 61 6E 67           
  28B8'   65 00                 
  28BA'   44 69 73 6B           SDFUL:	DB	'Disk full',0
  28BE'   20 66 75 6C           
  28C2'   6C 00                 
                                
                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  0008                          EO_R	EQU	8
  28C4'                         EXTAB:
  28C4'   77 00 01              	DB	'w',0,EO_W
  28C7'   71 00 02              	DB	'q',0,EO_Q
  28CA'   77 71 03              	DB	'w','q',EO_WQ
  28CD'   78 00 04              	DB	'x',0,EO_X
  28D0'   65 00 05              	DB	'e',0,EO_E
  28D3'   73 00 06              	DB	's',0,EO_S
  28D6'   76 65 07              	DB	'v','e',EO_V
  28D9'   72 00 08              	DB	'r',0,EO_R
  28DC'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
	MACRO-80 3.44	09-Dec-81	PAGE	1-126


                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  28DD'                         EXADDR:
	MACRO-80 3.44	09-Dec-81	PAGE	1-127


  28DD'   AF                    	XRA	A
  28DE'   32 2F2B'              	STA	SRNGF
  28E1'   7E                    	MOV	A,M
  28E2'   FE 25                 	CPI	'%'
  28E4'   CA 290D'              	JZ	EXA_AL
  28E7'   EB                    	XCHG			; DE walks the line, HL takes the number
  28E8'   CD 2922'              	CALL	EXNUM
  28EB'   DA 290B'              	JC	EXA_NO
  28EE'   22 2F2C'              	SHLD	SRNG1
  28F1'   22 2F2E'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  28F4'   1A                    	LDAX	D
  28F5'   FE 2C                 	CPI	','
  28F7'   C2 2904'              	JNZ	EXA_YS
  28FA'   13                    	INX	D
  28FB'   CD 2922'              	CALL	EXNUM
  28FE'   DA 290B'              	JC	EXA_NO		; ',' with no number: not a range at all
  2901'   22 2F2E'              	SHLD	SRNG2
  2904'                         EXA_YS:
  2904'   EB                    	XCHG
  2905'   3E 01                 	MVI	A,1
  2907'   32 2F2B'              	STA	SRNGF
  290A'   C9                    	RET
  290B'                         EXA_NO:
  290B'   EB                    	XCHG
  290C'   C9                    	RET
  290D'                         EXA_AL:
  290D'   23                    	INX	H
  290E'   E5                    	PUSH	H
  290F'   21 0001               	LXI	H,1
  2912'   22 2F2C'              	SHLD	SRNG1
  2915'   21 FFFF               	LXI	H,0FFFFH
  2918'   22 2F2E'              	SHLD	SRNG2
  291B'   E1                    	POP	H
  291C'   3E 01                 	MVI	A,1
  291E'   32 2F2B'              	STA	SRNGF
  2921'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  2922'                         EXNUM:
  2922'   1A                    	LDAX	D
  2923'   D6 30                 	SUI	'0'
  2925'   D8                    	RC
  2926'   FE 0A                 	CPI	10
  2928'   3F                    	CMC
  2929'   D8                    	RC
  292A'   21 0000               	LXI	H,0
  292D'                         EXN_LP:
  292D'   1A                    	LDAX	D
  292E'   D6 30                 	SUI	'0'
  2930'   DA 294A'              	JC	EXN_DN
  2933'   FE 0A                 	CPI	10
  2935'   D2 294A'              	JNC	EXN_DN
  2938'   13                    	INX	D
  2939'   C5                    	PUSH	B
  293A'   4F                    	MOV	C,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-128


  293B'   06 00                 	MVI	B,0		; BC = the digit
  293D'   D5                    	PUSH	D
  293E'   54                    	MOV	D,H
  293F'   5D                    	MOV	E,L
  2940'   29                    	DAD	H		; *2
  2941'   29                    	DAD	H		; *4
  2942'   19                    	DAD	D		; *5
  2943'   29                    	DAD	H		; *10
  2944'   D1                    	POP	D
  2945'   09                    	DAD	B
  2946'   C1                    	POP	B
  2947'   C3 292D'              	JMP	EXN_LP
  294A'                         EXN_DN:
  294A'   B7                    	ORA	A		; CY clear: there was a number
  294B'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  294C'                         EX_S:
  294C'   7E                    	MOV	A,M
  294D'   B7                    	ORA	A
  294E'   CA 2990'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  2951'   32 2F30'              	STA	SDELIM
  2954'   23                    	INX	H
  2955'   11 0000*              	LXI	D,SRCHST
  2958'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  295B'   4F                    	MOV	C,A
  295C'   CD 2996'              	CALL	SCOPY
  295F'   78                    	MOV	A,B
  2960'   B7                    	ORA	A
  2961'   CA 2990'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  2964'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  2967'   3E 01                 	MVI	A,1
  2969'   32 2EF8'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  296C'   11 2F42'              	LXI	D,SREPL
  296F'   0E 24                 	MVI	C,SREPMX
  2971'   CD 2996'              	CALL	SCOPY
  2974'   78                    	MOV	A,B
  2975'   32 2F41'              	STA	SREPLN
  2978'   AF                    	XRA	A
  2979'   32 2F31'              	STA	SGFLAG
  297C'   7E                    	MOV	A,M
  297D'   FE 67                 	CPI	'g'
  297F'   C2 2988'              	JNZ	EX_SG
  2982'   23                    	INX	H
  2983'   3E 01                 	MVI	A,1
  2985'   32 2F31'              	STA	SGFLAG
  2988'                         EX_SG:
  2988'   7E                    	MOV	A,M
  2989'   B7                    	ORA	A
  298A'   C2 2717'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  298D'   C3 29B6'              	JMP	SUBGO
  2990'                         SUBNOP:
  2990'   21 27DF'              	LXI	H,SNOPAT
  2993'   C3 2725'              	JMP	EXERR
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-129


                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  2996'                         SCOPY:
  2996'   06 00                 	MVI	B,0
  2998'                         SCP_LP:
  2998'   78                    	MOV	A,B
  2999'   B9                    	CMP	C
  299A'   D2 29B3'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  299D'   7E                    	MOV	A,M
  299E'   B7                    	ORA	A
  299F'   CA 29B3'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  29A2'   E5                    	PUSH	H
  29A3'   21 2F30'              	LXI	H,SDELIM
  29A6'   BE                    	CMP	M
  29A7'   E1                    	POP	H
  29A8'   CA 29B2'              	JZ	SCP_SK
  29AB'   12                    	STAX	D
  29AC'   13                    	INX	D
  29AD'   23                    	INX	H
  29AE'   04                    	INR	B
  29AF'   C3 2998'              	JMP	SCP_LP
  29B2'                         SCP_SK:
  29B2'   23                    	INX	H
  29B3'                         SCP_DN:
  29B3'   AF                    	XRA	A
  29B4'   12                    	STAX	D
  29B5'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  29B6'                         SUBGO:
  29B6'   CD 1333'              	CALL	GZONE
  29B9'   2A 0000*              	LHLD	LNDLT
  29BC'   22 2F3F'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  29BF'   21 2F3C'              	LXI	H,SOFFS		;   finds nothing puts both back, as the
  29C2'   CD 0429'              	CALL	FPSTO		;   search's SN_BAD does
  29C5'   AF                    	XRA	A
  29C6'   32 2F32'              	STA	SANY
  29C9'   21 0000               	LXI	H,0
  29CC'   22 2F34'              	SHLD	SBACK
  29CF'   3A 2F2B'              	LDA	SRNGF
  29D2'   B7                    	ORA	A
  29D3'   CA 29E5'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  29D6'   CD 22A5'              	CALL	EXRNG		; SLINES = the lines in the range
  29D9'   DA 2A61'              	JC	SUBBAD
  29DC'   2A 2F2C'              	LHLD	SRNG1
  29DF'   CD 12A1'              	CALL	GOLN
  29E2'   C3 29EB'              	JMP	SUBLP
  29E5'                         SUB_1L:
  29E5'   21 0001               	LXI	H,1
  29E8'   22 2F36'              	SHLD	SLINES
  29EB'                         SUBLP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-130


  29EB'   CD 2A67'              	CALL	SUBLIN		; A = 1 when this line changed
  29EE'   B7                    	ORA	A
  29EF'   CA 29FD'              	JZ	SUB_NX
  29F2'   3E 01                 	MVI	A,1
  29F4'   32 2F32'              	STA	SANY
  29F7'   21 0000               	LXI	H,0
  29FA'   22 2F34'              	SHLD	SBACK		; the cursor is ON the last line changed
  29FD'                         SUB_NX:
  29FD'   2A 2F36'              	LHLD	SLINES
  2A00'   2B                    	DCX	H
  2A01'   22 2F36'              	SHLD	SLINES
  2A04'   7C                    	MOV	A,H
  2A05'   B5                    	ORA	L
  2A06'   CA 2A24'              	JZ	SUBDON		; the range is spent
  2A09'   21 0001               	LXI	H,1
  2A0C'   AF                    	XRA	A
  2A0D'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  2A10'   3A 2F32'              	LDA	SANY
  2A13'   B7                    	ORA	A
  2A14'   CA 2A1E'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  2A17'   2A 2F34'              	LHLD	SBACK
  2A1A'   23                    	INX	H
  2A1B'   22 2F34'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  2A1E'                         SUB_AE:
  2A1E'   CD 0B3D'              	CALL	ATEOF
  2A21'   D2 29EB'              	JNC	SUBLP		; ... unless that ran off the end of the file
  2A24'                         SUBDON:
  2A24'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  2A27'   3A 2F32'              	LDA	SANY
  2A2A'   B7                    	ORA	A
  2A2B'   CA 2A49'              	JZ	SUBNFD
  2A2E'   3E 01                 	MVI	A,1
  2A30'   32 2E6C'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  2A33'   2A 2F34'              	LHLD	SBACK
  2A36'   7C                    	MOV	A,H
  2A37'   B5                    	ORA	L
  2A38'   CA 2A43'              	JZ	SUB_PL
  2A3B'   3E FF                 	MVI	A,0FFH
  2A3D'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  2A40'   CD 0000*              	CALL	CLRCNT
  2A43'                         SUB_PL:
  2A43'   CD 134B'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  2A46'   C3 0898'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
	MACRO-80 3.44	09-Dec-81	PAGE	1-131


                                				;   and can still act on the answer.
  2A49'                         SUBNFD:
  2A49'   21 2F3C'              	LXI	H,SOFFS
  2A4C'   CD 03D0'              	CALL	BACKTO
  2A4F'   2A 2F3F'              	LHLD	SLDLTS
  2A52'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  2A55'   21 27AF'              	LXI	H,SNOTFD
  2A58'   CD 2725'              	CALL	EXERR
  2A5B'   21 0000*              	LXI	H,SRCHST
  2A5E'   C3 2720'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  2A61'                         SUBBAD:
  2A61'   21 279D'              	LXI	H,SNOT
  2A64'   C3 271A'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  2A67'                         SUBLIN:
  2A67'   AF                    	XRA	A
  2A68'   32 2F33'              	STA	SLCHG
  2A6B'   CD 2AE6'              	CALL	SUBBOL
  2A6E'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  2A71'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  2A71'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  2A74'   DA 2A7C'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  2A77'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  2A79'   C2 2A71'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  2A7C'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  2A7C'   CD 0000*              	CALL	CUROFF
  2A7F'   E5                    	PUSH	H
  2A80'   CD 1926'              	CALL	CEND
  2A83'   D1                    	POP	D
  2A84'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  2A87'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  2A88'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  2A8B'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  2A8C'   B7                    	ORA	A		;   span is a line, not a pair.)
  2A8D'   FA 2ADF'              	JM	SUBL_D		; what is left is shorter than the pattern
  2A90'   44                    	MOV	B,H
  2A91'   4D                    	MOV	C,L		; BC = the start positions a match can take
  2A92'   11 0000*              	LXI	D,SRCHST
  2A95'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  2A98'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  2A9B'   DA 2ADF'              	JC	SUBL_D
  2A9E'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  2AA1'   EB                    	XCHG
  2AA2'   2A 0000*              	LHLD	GAPEND
  2AA5'   EB                    	XCHG
  2AA6'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
	MACRO-80 3.44	09-Dec-81	PAGE	1-132


  2AA9'   EB                    	XCHG
  2AAA'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  2AAB'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  2AAE'   D1                    	POP	D
  2AAF'   19                    	DAD	D		; ... and so the match's logical offset
  2AB0'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  2AB3'   3A 2F32'              	LDA	SANY
  2AB6'   B7                    	ORA	A
  2AB7'   C2 2AC4'              	JNZ	SUBL_C
  2ABA'   3A 2F33'              	LDA	SLCHG
  2ABD'   B7                    	ORA	A
  2ABE'   C2 2AC4'              	JNZ	SUBL_C
  2AC1'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  2AC4'                         SUBL_C:
  2AC4'   3A 0000*              	LDA	SRCHBF
  2AC7'   6F                    	MOV	L,A
  2AC8'   26 00                 	MVI	H,0
  2ACA'   CD 0000*              	CALL	DELFWD		; the match goes
  2ACD'   11 2F41'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  2AD0'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  2AD3'                         SUBL_I:
  2AD3'   3E 01                 	MVI	A,1
  2AD5'   32 2F33'              	STA	SLCHG
  2AD8'   3A 2F31'              	LDA	SGFLAG
  2ADB'   B7                    	ORA	A
  2ADC'   C2 2A7C'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  2ADF'                         SUBL_D:
  2ADF'   CD 2AE6'              	CALL	SUBBOL
  2AE2'   3A 2F33'              	LDA	SLCHG
  2AE5'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  2AE6'                         SUBBOL:
  2AE6'   CD 0000*              	CALL	CUROFF
  2AE9'   CD 0678'              	CALL	BOL
  2AEC'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  2AEF'                         VC_SRCH:
  2AEF'   CD 085B'              	CALL	SETMOV
  2AF2'   C5                    	PUSH	B
  2AF3'   CD 0786'              	CALL	GETCNT
  2AF6'   22 2F21'              	SHLD	SCNT
  2AF9'   C1                    	POP	B
  2AFA'   79                    	MOV	A,C
  2AFB'   FE 2F                 	CPI	'/'
  2AFD'   3E 00                 	MVI	A,0
  2AFF'   CA 2B04'              	JZ	VS_DIR
  2B02'   3E FF                 	MVI	A,0FFH		; '?' -- backward
	MACRO-80 3.44	09-Dec-81	PAGE	1-133


  2B04'                         VS_DIR:
  2B04'   32 2EF6'              	STA	SDIR
  2B07'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2B0A'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2B0D'   47                    	MOV	B,A
  2B0E'   CD 204E'              	CALL	RDLINE
  2B11'   B7                    	ORA	A
  2B12'   C0                    	RNZ			; cancelled: nothing happens at all
  2B13'   3A 2ECD'              	LDA	RLLEN
  2B16'   B7                    	ORA	A
  2B17'   CA 2B2C'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  2B1A'   5F                    	MOV	E,A
  2B1B'   16 00                 	MVI	D,0
  2B1D'   21 0000*              	LXI	H,SRCHST
  2B20'   19                    	DAD	D
  2B21'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  2B23'   7B                    	MOV	A,E
  2B24'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  2B27'   3E 01                 	MVI	A,1
  2B29'   32 2EF8'              	STA	SHAVE
  2B2C'                         VS_OLD:
  2B2C'   3A 2EF8'              	LDA	SHAVE
  2B2F'   B7                    	ORA	A
  2B30'   CA 2B3C'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  2B33'   3A 2EF6'              	LDA	SDIR
  2B36'   32 2EF7'              	STA	SDIRE
  2B39'   C3 2B65'              	JMP	SRCHN
  2B3C'                         VS_NOP:
  2B3C'   21 27DF'              	LXI	H,SNOPAT
  2B3F'   C3 2725'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  2B42'                         VC_N:
  2B42'   CD 085B'              	CALL	SETMOV
  2B45'   3A 2EF6'              	LDA	SDIR
  2B48'   C3 2B52'              	JMP	VN_GO
  2B4B'                         VCB_N:
  2B4B'   CD 085B'              	CALL	SETMOV
  2B4E'   3A 2EF6'              	LDA	SDIR
  2B51'   2F                    	CMA			; the other way: 0 <-> FFH
  2B52'                         VN_GO:
  2B52'   32 2EF7'              	STA	SDIRE
  2B55'   CD 0786'              	CALL	GETCNT
  2B58'   22 2F21'              	SHLD	SCNT
  2B5B'   3A 2EF8'              	LDA	SHAVE
  2B5E'   B7                    	ORA	A
  2B5F'   CA 2B3C'              	JZ	VS_NOP
  2B62'   C3 2B65'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  2B65'                         SRCHN:
  2B65'   CD 1333'              	CALL	GZONE		; the screen's top line, before the cursor moves
  2B68'   CD 07AF'              	CALL	BRKON		; where it started (the sweep moves the cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-134


                                				;   with PUTCUR, which does not maintain LNDLT;
                                				;   GOTO does), and an ESC may stop it
  2B6B'                         SN_LP:
  2B6B'   CD 2BA0'              	CALL	SRCHGO
  2B6E'   DA 2B8B'              	JC	SN_BAD
  2B71'   2A 2F21'              	LHLD	SCNT
  2B74'   2B                    	DCX	H
  2B75'   22 2F21'              	SHLD	SCNT
  2B78'   7C                    	MOV	A,H
  2B79'   B5                    	ORA	L
  2B7A'   C2 2B6B'              	JNZ	SN_LP
  2B7D'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  2B80'   CD 07EC'              	CALL	BRKOFF
  2B83'   3E 01                 	MVI	A,1
  2B85'   32 2F03'              	STA	GPKEEP		; land on the match, not the first non-blank
  2B88'   C3 134B'              	JMP	GPLACE		; (which sets LNDLT itself)
  2B8B'                         SN_BAD:
  2B8B'   CD 07EC'              	CALL	BRKOFF
  2B8E'   DA 0804'              	JC	BRKBAK		; stopped, which is not the same as not found
  2B91'   CD 07F7'              	CALL	RSTPL		; nothing moved: the row the cursor was on
  2B94'   21 27AF'              	LXI	H,SNOTFD
  2B97'   CD 2725'              	CALL	EXERR
  2B9A'   21 0000*              	LXI	H,SRCHST
  2B9D'   C3 2720'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  2BA0'                         SRCHGO:
  2BA0'   3E 01                 	MVI	A,1
  2BA2'   32 2F2A'              	STA	SSKIP		; this pass starts one past the cursor
  2BA5'   CD 2BBB'              	CALL	SRCHW
  2BA8'   D0                    	RNC
  2BA9'   CD 07F0'              	CALL	BRKQ
  2BAC'   D8                    	RC			; stopped: no second pass
  2BAD'   3A 2EF7'              	LDA	SDIRE
  2BB0'   2F                    	CMA
  2BB1'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  2BB4'   AF                    	XRA	A
  2BB5'   32 2F2A'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  2BB8'   C3 2BBB'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  2BBB'                         SRCHW:
  2BBB'   3A 2EF7'              	LDA	SDIRE
  2BBE'   32 0000*              	STA	DIRFLG
	MACRO-80 3.44	09-Dec-81	PAGE	1-135


  2BC1'   21 FFFF               	LXI	H,0FFFFH
  2BC4'   22 2E69'              	SHLD	CMDCNT
  2BC7'   AF                    	XRA	A
  2BC8'   32 0000*              	STA	AUXCNT
  2BCB'                         SW_LP:
  2BCB'   CD 07F0'              	CALL	BRKQ		; an ESC spent the count, here or on the way to
  2BCE'   D8                    	RC			;   the wrapped pass: SCRLST no longer pages
  2BCF'   CD 2BDB'              	CALL	SRCH1
  2BD2'   D0                    	RNC
  2BD3'   CD 0000*              	CALL	SCRLST
  2BD6'   D2 2BCB'              	JNC	SW_LP
  2BD9'   37                    	STC
  2BDA'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  2BDB'                         SRCH1:
  2BDB'   11 0000*              	LXI	D,SRCHST
  2BDE'   3A 0000*              	LDA	DIRFLG
  2BE1'   B7                    	ORA	A
  2BE2'   FA 2C06'              	JM	SR1_BK
  2BE5'   21 0000*              	LXI	H,GAPEND
  2BE8'   CD 0000*              	CALL	FWDCNT
  2BEB'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  2BEE'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  2BEF'   3A 2F2A'              	LDA	SSKIP
  2BF2'   B7                    	ORA	A
  2BF3'   CA 2BFC'              	JZ	SR1_FW
  2BF6'   78                    	MOV	A,B
  2BF7'   B1                    	ORA	C
  2BF8'   37                    	STC
  2BF9'   C8                    	RZ			; no room for a match even before the skip
  2BFA'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2BFB'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2BFC'                         SR1_FW:
  2BFC'   CD 0000*              	CALL	MATCHF
  2BFF'   D8                    	RC
  2C00'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2C03'   C3 0000*              	JMP	PUTCUR
  2C06'                         SR1_BK:
  2C06'   21 0000*              	LXI	H,TXTBEG
  2C09'   CD 0000*              	CALL	FWDCNT
  2C0C'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2C0F'   D8                    	RC
  2C10'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2C13'   CD 0000*              	CALL	MATCHB
  2C16'   D8                    	RC
  2C17'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-136


                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2C1A'                         MSGNAM:
  2C1A'   E5                    	PUSH	H
  2C1B'   3E 22                 	MVI	A,'"'
  2C1D'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  2C20'   E1                    	POP	H
  2C21'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  2C22'   23                    	INX	H
  2C23'   7E                    	MOV	A,M
  2C24'   FE 20                 	CPI	' '
  2C26'   C2 2C33'              	JNZ	MN_HAS
  2C29'   21 284D'              	LXI	H,SNONM
  2C2C'   CD 0000*              	CALL	OUTSTR
  2C2F'   E1                    	POP	H
  2C30'   C3 2C7D'              	JMP	MN_END
  2C33'                         MN_HAS:
  2C33'   0E 19                 	MVI	C,BF_CURDSK
  2C35'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  2C38'   E1                    	POP	H
  2C39'   E5                    	PUSH	H
  2C3A'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  2C3B'   BE                    	CMP	M
  2C3C'   CA 2C4A'              	JZ	MN_NAM
  2C3F'   7E                    	MOV	A,M
  2C40'   C6 40                 	ADI	'A'-1
  2C42'   CD 0000*              	CALL	OUTCH
  2C45'   3E 3A                 	MVI	A,':'
  2C47'   CD 0000*              	CALL	OUTCH
  2C4A'                         MN_NAM:
  2C4A'   E1                    	POP	H
  2C4B'   E5                    	PUSH	H
  2C4C'   23                    	INX	H
  2C4D'   0E 08                 	MVI	C,8
  2C4F'                         MN_NM:
  2C4F'   7E                    	MOV	A,M
  2C50'   FE 20                 	CPI	' '
  2C52'   CA 2C5D'              	JZ	MN_EXT
  2C55'   CD 0000*              	CALL	OUTCH
  2C58'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-137


  2C59'   0D                    	DCR	C
  2C5A'   C2 2C4F'              	JNZ	MN_NM
  2C5D'                         MN_EXT:
  2C5D'   E1                    	POP	H
  2C5E'   11 0009               	LXI	D,9
  2C61'   19                    	DAD	D		; the type field
  2C62'   7E                    	MOV	A,M
  2C63'   FE 20                 	CPI	' '
  2C65'   CA 2C7D'              	JZ	MN_END
  2C68'   3E 2E                 	MVI	A,'.'
  2C6A'   CD 0000*              	CALL	OUTCH
  2C6D'   0E 03                 	MVI	C,3
  2C6F'                         MN_XL:
  2C6F'   7E                    	MOV	A,M
  2C70'   FE 20                 	CPI	' '
  2C72'   CA 2C7D'              	JZ	MN_END
  2C75'   CD 0000*              	CALL	OUTCH
  2C78'   23                    	INX	H
  2C79'   0D                    	DCR	C
  2C7A'   C2 2C6F'              	JNZ	MN_XL
  2C7D'                         MN_END:
  2C7D'   3E 22                 	MVI	A,'"'
  2C7F'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  2C82'                         MSGFLG:
  2C82'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  2C84'   B7                    	ORA	A
  2C85'   CA 2C95'              	JZ	MF_RO
  2C88'   3A 2E6C'              	LDA	MODF
  2C8B'   B7                    	ORA	A
  2C8C'   CA 2C95'              	JZ	MF_RO
  2C8F'   21 2857'              	LXI	H,SMODM
  2C92'   CD 2CAA'              	CALL	MF_PUT
  2C95'                         MF_RO:
  2C95'   3A 2EE3'              	LDA	ROFLAG
  2C98'   B7                    	ORA	A
  2C99'   CA 2CA2'              	JZ	MF_NEW
  2C9C'   21 2862'              	LXI	H,SROM
  2C9F'   CD 2CAA'              	CALL	MF_PUT
  2CA2'                         MF_NEW:
  2CA2'   3A 2EE1'              	LDA	MSGNEW
  2CA5'   B7                    	ORA	A
  2CA6'   C8                    	RZ
  2CA7'   21 286D'              	LXI	H,SNEWM
  2CAA'                         MF_PUT:
  2CAA'   78                    	MOV	A,B
  2CAB'   B7                    	ORA	A
  2CAC'   C2 2CB8'              	JNZ	MF_STR
  2CAF'   06 01                 	MVI	B,1
  2CB1'   E5                    	PUSH	H
  2CB2'   3E 20                 	MVI	A,' '
  2CB4'   CD 0000*              	CALL	OUTCH
	MACRO-80 3.44	09-Dec-81	PAGE	1-138


  2CB7'   E1                    	POP	H
  2CB8'                         MF_STR:
  2CB8'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  2CBB'                         EMITW:
  2CBB'   C5                    	PUSH	B
  2CBC'   D5                    	PUSH	D
  2CBD'   06 00                 	MVI	B,0
  2CBF'   11 2710               	LXI	D,10000
  2CC2'   CD 2CE0'              	CALL	EWDIG
  2CC5'   11 03E8               	LXI	D,1000
  2CC8'   CD 2CE0'              	CALL	EWDIG
  2CCB'   11 0064               	LXI	D,100
  2CCE'   CD 2CE0'              	CALL	EWDIG
  2CD1'   11 000A               	LXI	D,10
  2CD4'   CD 2CE0'              	CALL	EWDIG
  2CD7'   7D                    	MOV	A,L		; the units digit is always printed
  2CD8'   C6 30                 	ADI	'0'
  2CDA'   CD 0000*              	CALL	OUTCH
  2CDD'   D1                    	POP	D
  2CDE'   C1                    	POP	B
  2CDF'   C9                    	RET
  2CE0'                         EWDIG:
  2CE0'   0E 00                 	MVI	C,0
  2CE2'                         EW_LP:
  2CE2'   7D                    	MOV	A,L
  2CE3'   93                    	SUB	E
  2CE4'   6F                    	MOV	L,A
  2CE5'   7C                    	MOV	A,H
  2CE6'   9A                    	SBB	D
  2CE7'   67                    	MOV	H,A
  2CE8'   DA 2CEF'              	JC	EW_DN
  2CEB'   0C                    	INR	C
  2CEC'   C3 2CE2'              	JMP	EW_LP
  2CEF'                         EW_DN:
  2CEF'   19                    	DAD	D		; one subtraction too many: give it back
  2CF0'   79                    	MOV	A,C
  2CF1'   B7                    	ORA	A
  2CF2'   C2 2CF8'              	JNZ	EW_PR
  2CF5'   78                    	MOV	A,B
  2CF6'   B7                    	ORA	A
  2CF7'   C8                    	RZ			; a leading zero: write nothing
  2CF8'                         EW_PR:
  2CF8'   79                    	MOV	A,C
  2CF9'   C6 30                 	ADI	'0'
  2CFB'   CD 0000*              	CALL	OUTCH
  2CFE'   06 01                 	MVI	B,1
  2D00'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  2D01'                         ISEMPT:
  2D01'   2A 0000*              	LHLD	OUTPOS
	MACRO-80 3.44	09-Dec-81	PAGE	1-139


  2D04'   7C                    	MOV	A,H
  2D05'   B5                    	ORA	L
  2D06'   C0                    	RNZ
  2D07'   CD 0000*              	CALL	LOGLEN
  2D0A'   7C                    	MOV	A,H
  2D0B'   B5                    	ORA	L
  2D0C'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  2D0D'                         MSGCTG:
  2D0D'   21 0000*              	LXI	H,FNAME
  2D10'   CD 2C1A'              	CALL	MSGNAM
  2D13'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  2D15'   CD 2C82'              	CALL	MSGFLG
  2D18'   CD 2D01'              	CALL	ISEMPT
  2D1B'   C2 2D24'              	JNZ	MG_POS
  2D1E'   21 2880'              	LXI	H,SNOLIN
  2D21'   C3 0000*              	JMP	OUTSTR
  2D24'                         MG_POS:
  2D24'   21 2873'              	LXI	H,SLINE
  2D27'   CD 0000*              	CALL	OUTSTR
  2D2A'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  2D2D'   23                    	INX	H		;   ... so the line it is on
  2D2E'   CD 2CBB'              	CALL	EMITW
  2D31'   21 287A'              	LXI	H,SCOLM
  2D34'   CD 0000*              	CALL	OUTSTR
  2D37'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  2D3A'   23                    	INX	H
  2D3B'   E5                    	PUSH	H
  2D3C'   CD 2CBB'              	CALL	EMITW
  2D3F'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  2D42'   23                    	INX	H
  2D43'   D1                    	POP	D
  2D44'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  2D47'   C8                    	RZ
  2D48'   E5                    	PUSH	H
  2D49'   3E 2D                 	MVI	A,'-'
  2D4B'   CD 0000*              	CALL	OUTCH
  2D4E'   E1                    	POP	H
  2D4F'   C3 2CBB'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  2D52'                         FILMSG:
  2D52'   3A 0001*              	LDA	FNAME+1
  2D55'   FE 20                 	CPI	' '
  2D57'   C8                    	RZ
  2D58'   21 0000*              	LXI	H,FNAME
  2D5B'   CD 2C1A'              	CALL	MSGNAM
  2D5E'   AF                    	XRA	A		; nothing has been changed yet
  2D5F'   C3 2C82'              	JMP	MSGFLG
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-140


                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  2D62'                         WRMSG:
  2D62'   21 0000*              	LXI	H,TFCB
  2D65'   CD 2C1A'              	CALL	MSGNAM
  2D68'   21 2892'              	LXI	H,SWRIT
  2D6B'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  2D6E'                         MSGPST:
  2D6E'   3A 2EE0'              	LDA	MSGWHT
  2D71'   B7                    	ORA	A
  2D72'   C8                    	RZ
  2D73'   47                    	MOV	B,A
  2D74'   AF                    	XRA	A
  2D75'   32 2EE0'              	STA	MSGWHT
  2D78'   78                    	MOV	A,B
  2D79'   FE 01                 	CPI	MW_FIL
  2D7B'   CA 2D97'              	JZ	MP_FIL
  2D7E'   FE 02                 	CPI	MW_WRT
  2D80'   CA 2D9D'              	JZ	MP_WRT
  2D83'   FE 04                 	CPI	MW_BIG
  2D85'   CA 2D8E'              	JZ	MP_BIG
  2D88'   CD 2D0D'              	CALL	MSGCTG
  2D8B'   C3 0000*              	JMP	SCURS
  2D8E'                         MP_BIG:
  2D8E'   21 282E'              	LXI	H,SQBIG
  2D91'   CD 0000*              	CALL	EXMSG
  2D94'   C3 0000*              	JMP	SCURS
  2D97'                         MP_FIL:
  2D97'   CD 2D52'              	CALL	FILMSG
  2D9A'   C3 0000*              	JMP	SCURS
  2D9D'                         MP_WRT:
  2D9D'   CD 2D62'              	CALL	WRMSG
  2DA0'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  2DA3'                         VC_CTLG:
  2DA3'   3E 03                 	MVI	A,MW_CTG
  2DA5'   32 2EE0'              	STA	MSGWHT
  2DA8'   3E 01                 	MVI	A,R_MOVE
  2DAA'   32 2E6D'              	STA	RINTENT
  2DAD'   C3 0786'              	JMP	GETCNT		; a count typed before it is spent here, not
                                				;   left for the next command
                                
  2DB0'                         CMDTAB:
  2DB0'   07                    	DB	07H			; ^G -- where am I?
  2DB1'   2DA3'                 	DW	VC_CTLG
  2DB3'   68                    	DB	'h'
  2DB4'   08D3'                 	DW	VC_H
  2DB6'   6C                    	DB	'l'
  2DB7'   08FD'                 	DW	VC_L
  2DB9'   6A                    	DB	'j'
	MACRO-80 3.44	09-Dec-81	PAGE	1-141


  2DBA'   09CE'                 	DW	VC_J
  2DBC'   6B                    	DB	'k'
  2DBD'   09E0'                 	DW	VC_K
  2DBF'   30                    	DB	'0'
  2DC0'   0930'                 	DW	VC_0
  2DC2'   5E                    	DB	'^'
  2DC3'   094E'                 	DW	VC_CRT
  2DC5'   24                    	DB	'$'
  2DC6'   098C'                 	DW	VC_EOL
  2DC8'   0D                    	DB	CR			; <CR> -- down to the first non-blank
  2DC9'   09B0'                 	DW	VC_CR
  2DCB'   77                    	DB	'w'
  2DCC'   0BBF'                 	DW	VC_W
  2DCE'   62                    	DB	'b'
  2DCF'   0C10'                 	DW	VC_B
  2DD1'   65                    	DB	'e'
  2DD2'   0DA6'                 	DW	VC_E
  2DD4'   57                    	DB	'W'
  2DD5'   0BC6'                 	DW	VCBGW
  2DD7'   42                    	DB	'B'
  2DD8'   0C17'                 	DW	VCBGB
  2DDA'   45                    	DB	'E'
  2DDB'   0DAD'                 	DW	VCBGE
  2DDD'   47                    	DB	'G'
  2DDE'   1271'                 	DW	VC_G
  2DE0'   67                    	DB	'g'
  2DE1'   12C4'                 	DW	VC_LG
  2DE3'   78                    	DB	'x'
  2DE4'   18BB'                 	DW	VC_X
  2DE6'   5A                    	DB	'Z'
  2DE7'   20C1'                 	DW	VC_BZ
  2DE9'   66                    	DB	'f'
  2DEA'   021A'                 	DW	VC_FF
  2DEC'   46                    	DB	'F'
  2DED'   021F'                 	DW	VC_FB
  2DEF'   74                    	DB	't'
  2DF0'   0224'                 	DW	VC_TF
  2DF2'   54                    	DB	'T'
  2DF3'   0229'                 	DW	VC_TB
  2DF5'   3B                    	DB	';'
  2DF6'   0240'                 	DW	VC_SEMI
  2DF8'   2C                    	DB	','
  2DF9'   024A'                 	DW	VC_COMMA
  2DFB'   79                    	DB	'y'
  2DFC'   1BCB'                 	DW	VC_Y
  2DFE'   59                    	DB	'Y'
  2DFF'   1BD3'                 	DW	VY_YY
  2E01'   70                    	DB	'p'
  2E02'   1E09'                 	DW	VC_P
  2E04'   50                    	DB	'P'
  2E05'   1E1E'                 	DW	VCB_P
  2E07'   69                    	DB	'i'
  2E08'   1947'                 	DW	VC_I
  2E0A'   61                    	DB	'a'
  2E0B'   194D'                 	DW	VC_A
  2E0D'   41                    	DB	'A'
	MACRO-80 3.44	09-Dec-81	PAGE	1-142


  2E0E'   196D'                 	DW	VCB_A
  2E10'   49                    	DB	'I'
  2E11'   1989'                 	DW	VCB_I
  2E13'   72                    	DB	'r'
  2E14'   1ACB'                 	DW	VC_R
  2E16'   52                    	DB	'R'
  2E17'   1B24'                 	DW	VCB_R
  2E19'   64                    	DB	'd'
  2E1A'   1B39'                 	DW	VC_D
  2E1C'   44                    	DB	'D'
  2E1D'   18A0'                 	DW	VCB_D
  2E1F'   43                    	DB	'C'
  2E20'   189A'                 	DW	VCB_C
  2E22'   63                    	DB	'c'
  2E23'   1B41'                 	DW	VC_C
  2E25'   6F                    	DB	'o'
  2E26'   19D7'                 	DW	VC_O
  2E28'   4F                    	DB	'O'
  2E29'   19EC'                 	DW	VCB_O
  2E2B'   4A                    	DB	'J'
  2E2C'   1A06'                 	DW	VCB_J
  2E2E'   7E                    	DB	'~'
  2E2F'   1A88'                 	DW	VC_TILD
  2E31'   3A                    	DB	':'
  2E32'   20EC'                 	DW	VC_EX
  2E34'   2F                    	DB	'/'
  2E35'   2AEF'                 	DW	VC_SRCH
  2E37'   3F                    	DB	'?'
  2E38'   2AEF'                 	DW	VC_SRCH
  2E3A'   6E                    	DB	'n'
  2E3B'   2B42'                 	DW	VC_N
  2E3D'   4E                    	DB	'N'
  2E3E'   2B4B'                 	DW	VCB_N
  2E40'   48                    	DB	'H'
  2E41'   0E6A'                 	DW	VC_HIGH
  2E43'   4D                    	DB	'M'
  2E44'   0E81'                 	DW	VC_MIDL
  2E46'   4C                    	DB	'L'
  2E47'   0E9C'                 	DW	VC_LOWL
  2E49'   06                    	DB	06H			; ^F -- page forward
  2E4A'   0EB9'                 	DW	VC_PGDN
  2E4C'   02                    	DB	02H			; ^B -- page back
  2E4D'   0F17'                 	DW	VC_PGUP
  2E4F'   04                    	DB	04H			; ^D -- half page down
  2E50'   0FF8'                 	DW	VC_HFDN
  2E52'   15                    	DB	15H			; ^U -- half page up
  2E53'   10BF'                 	DW	VC_HFUP
  2E55'   0C                    	DB	0CH			; ^L -- redraw
  2E56'   126E'                 	DW	VC_REDR
  2E58'   2E                    	DB	'.'			; '.' -- repeat the last change
  2E59'   017D'                 	DW	VC_DOT
  2E5B'   75                    	DB	'u'			; 'u' -- undo (and undo the undo)
  2E5C'   0545'                 	DW	VC_UNDO
  2E5E'   6D                    	DB	'm'		; m{a-c} -- set a mark
  2E5F'   032E'                 	DW	VC_MK
  2E61'   60                    	DB	60H		; `{a-c} -- back to its exact spot
	MACRO-80 3.44	09-Dec-81	PAGE	1-143


  2E62'   0333'                 	DW	VC_BQ
  2E64'   27                    	DB	27H		; '{a-c} -- back to its line's first non-blank
  2E65'   0338'                 	DW	VC_AQ
  2E67'   00                    	DB	0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  2E68'   00                    EDMODE: DB	EM_CMD
  2E69'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  2E6B'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  2E6C'   00                    MODF:	DB	0		; 1 = unsaved changes
  2E6D'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  2E6E'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  2E6F'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  2E70'   01                    DCHN:	DB	1		; the cells an R_DCH paint deletes (SCRN.MAC reads)
  2E71'   00                    DCHBS:	DB	0		; 1 = they went left of the cursor (insert's BS)
  2E72'   00                    LNALL:	DB	0		; 1 = this R_LINE is drawn from the line's first
                                				;   row, not the cursor's (SCRN.MAC clears it)
  2E73'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  2E74'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  2E76'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  2E77'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  2E78'   00                    HFAMT:	DB	0		; ^D/^U: rows (vim's 'scroll'); 0 = NEDIT/2
  2E79'   00                    HFN:	DB	0		; ^D/^U: the rows this one goes
  2E7A'   0000                  HFTP:	DW	0		; ^D/^U: -> the new top line's entry
  2E7C'   00                    HTN:	DB	0		; row table: its entries
  2E7D'   00                    HTCUR:	DB	0		; ... the cursor line's
  2E7E'   00                    HTTP:	DB	0		; ... the top line's
  2E7F'   00                    HTEOF:	DB	0		; ... 1 = its last is the file's last line
  2E80'   00                    HTBOF:	DB	0		; ... 1 = its first is the file's first
  2E81'   0000                  RWR:	DW	0		; ^F/^B: rows still to go
  2E83'   00                    RWMV:	DB	0		; ^F/^B: 1 = the table was made again on the way
  2E84'   00                    OVDIR:	DB	0		; OVLAP: 0 = h2.. are above h1 in the table
  2E85'   0000                  JKCNT:	DW	0		; j/k: count
  2E87'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  2E89'   0000                  JKMOV:	DW	0		; j: lines moved
  2E8B'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  2E8D'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  2E8E'   00                    JKLST:	DB	0		; j: last byte of the scan
  2E8F'   0000                  JKVC:	DW	0		; j/k landing: screen column
  2E91'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  2E93'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  2E94'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  2E95'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  2E96'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  2E97'   00                    DOTLK:	DB	0		; the last key recorded, encoded
	MACRO-80 3.44	09-Dec-81	PAGE	1-144


  2E98'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  2E9A'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  2E9B'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  2E9C'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  2E9E'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  2E9F'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  2EA0'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  2EA1'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
  2EA2'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  2EA3'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  2EA4'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   and its first word is yet to be stepped
  2EA5'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  2EA7'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  2EA9'   00 00 00              OPSFP:	DB	0,0,0		; operator: the start as a place in the file
  2EAC'   00 00 00              OPSLO:	DB	0,0,0		; ... where its line starts
  2EAF'   00 00 00              OPSHI:	DB	0,0,0		; ... where the next line does (OPPGD: the span's
                                				;   high end, whichever line that turned out to be)
  2EB2'   00 00 00              OPTOGO: DB	0,0,0		; OPPGD: bytes still to take
  2EB5'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  2EB7'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  2EB9'   0000                  CNTV:	DW	0		; motion repeat counter
  2EBB'   0000                  TTI:	DW	0		; TAILTAB scan index
  2EBD'   0000                  WKI:	DW	0		; scan index
  2EBF'   0000                  WKTERM: DW	0		; line terminator offset
  2EC1'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  2EC3'   00                    WKCLS:	DB	0		; word motion: class of the current run
  2EC4'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  2EC5'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  2EC7'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  2EC9'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
  2ECB'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  2ECD'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  2ECE'   00                    RLMAX:	DB	0		; RDLINE: capacity
  2ECF'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  2ED0'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  2ED1'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  2ED2'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  2ED4'   00                    WPROW:	DB	0		; :w -- the cursor's row
  2ED5'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  2ED6'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2ED8'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  2EDA'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  2EDB'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  2EDD'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  2EDF'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  2EE0'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  2EE1'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  2EE2'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  2EE3'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  2EE4'   00                    PLUSF:	DB	0		; command line: '+' was given
	MACRO-80 3.44	09-Dec-81	PAGE	1-145


  2EE5'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  2EE6'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  2EE7'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  2EE8'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  2EEA'   0000                  YPT:	DW	0		; yy: where the lines came from
  2EEC'   0000                  PCNT:	DW	0		; p/P: copies still to put
  2EEE'   00 00 00              PPFP:	DB	0,0,0		; p/P: the first line put, a file position
  2EF1'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  2EF3'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  2EF4'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  2EF6'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  2EF7'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  2EF8'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  2EF9'   00                    FNDKND: DB	0		; f/F/t/T: which find ';' repeats (0 = none yet)
  2EFA'   00                    FNDCH:	DB	0		; ... and the character it looked for
  2EFB'   00                    FNDRUN: DB	0		; the find THIS command is running (',' reverses)
  2EFC'   00                    FNDSTP: DB	0		; how far along it starts: 2 for a 't' repeat
  2EFD'   0000                  FNDN:	DW	0		; occurrences still to count off
  2EFF'   0000                  FNDCUR: DW	0		; the cursor it started from
  2F01'   0000                  FNDLIM: DW	0		; ... and the end of the line it may not pass
  2F03'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  2F04'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  2F07'   00 00 00              MKEDIT: DB	0,0,0		; MKSHFT: where in the file the edit is
  2F0A'   0000                  MKN:	DW	0		; ... how long it is
  2F0C'   00                    MKTYP:	DB	0		; ... and which way: 1 text went in, 2 came out
  2F0D'   00 00 00              MKPOS:	DB	0,0,0		; MKJMP: the file position being jumped to
  2F10'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  2F11'   00                    MKHOLD: DB	0		; set across YKGO's delete + put back (a yank
                                				;   that could not copy): MKSHFT must leave the
                                				;   marks alone through it
  2F12'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  2F14'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  2F16'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  2F18'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  2F1A'   00 00 00              YPFP:	DB	0,0,0		; ... and where in the file they start
                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  2F1D'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  2F1F'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
  2F21'   0000                  SCNT:	DW	0		; searches still to do (the count)
  2F23'   00 00 00              SOFF:	DB	0,0,0		; BRKON: where in the FILE the command began
  2F26'   0000                  SLDLT:	DW	0		; ... and LNDLT: for a search that fails, and
                                				;   any move an ESC stops
  2F28'   00                    BRKARM: DB	0		; nonzero: CNTTST looks for an ESC
  2F29'   00                    BRKHIT: DB	0		; nonzero: one was found, and the count spent
  2F2A'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
	MACRO-80 3.44	09-Dec-81	PAGE	1-146


                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  2F2B'   00                    SRNGF:	DB	0		; ex: a line range was given
  2F2C'   0000                  SRNG1:	DW	0		; ex: its first line
  2F2E'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  2F30'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  2F31'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  2F32'   00                    SANY:	DB	0		; ':s' something in the range has changed
  2F33'   00                    SLCHG:	DB	0		; ':s' this line changed
  2F34'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  2F36'   0000                  SLINES: DW	0		; ':s' / ':N,Mw' lines of the range still to do
  2F38'   00                    RWPTR:	DB	0		; ':N,Mw' the next free byte of the record at
                                				;   0080H, as that address's low byte
  2F39'   00                    RWERR:	DB	0		; ':N,Mw' a record would not go: the disk is full
  2F3A'   00                    RDANY:	DB	0		; ':r' something has been read in
  2F3B'   00                    RDBRK:	DB	0		; ':r' the line above wants a line end first
  2F3C'   00 00 00              SOFFS:	DB	0,0,0		; ':s' the cursor's place in the file, for one that
  2F3F'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  2F41'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  2F42'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
