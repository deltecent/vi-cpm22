  0AA1'   B7                    	ORA	A
  0AA2'   CA 0A80'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0AA5'   CD 0AD1'              	CALL	LNINC
  0AA8'   3E 01                 	MVI	A,1
  0AAA'   C9                    	RET
  0AAB'                         IC_END:
  0AAB'   3E FF                 	MVI	A,0FFH
  0AAD'   B7                    	ORA	A
  0AAE'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0AAF'                         DECC:
  0AAF'   CD 0000*              	CALL	PEEKL
  0AB2'   DA 0AAB'              	JC	IC_END
  0AB5'   F5                    	PUSH	PSW
