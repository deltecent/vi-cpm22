  18D3'   CD 1998'              	CALL	ISOWN
  18D6'   21 0001               	LXI	H,1
  18D9'   C2 18E0'              	JNZ	EE_LD		; another file: its first line
  18DC'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  18DF'   23                    	INX	H		; HL = the cursor's line
  18E0'                         EE_LD:
