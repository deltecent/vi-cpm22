                                	EXTRN	ZDIF, ZLF, ZSVCNT, ZSVAUX, ZSVDIR, MSGWHT
                                	EXTRN	MSGNEW, EXBANG, ROFLAG, PLUSF, YMODF, YDCHG
                                	EXTRN	YURPL, YOFF, YPT, PCNT, PPFP, PLFS
                                	EXTRN	PCPY, YLDLT, SDIR, SDIRE, SHAVE, FNDKND
                                	EXTRN	FNDCH, FNDRUN, FNDSTP, FNDN, FNDCUR, FNDLIM
                                	EXTRN	GPKEEP, MKVAL, MKEDIT, MKN, MKTYP, MKPOS
                                	EXTRN	MKWHAT, MKHOLD, YACT, YTGT, YWAS, YCOL
                                	EXTRN	YPFP, YNPG, YNCNT, SCNT, SOFF, SLDLT
                                	EXTRN	BRKARM, BRKHIT, SRNGF, SRNG1, SRNG2
                                	EXTRN	SGPOS, SCLIM, SCPOS, SCHIT, SCFND, SCCRY
