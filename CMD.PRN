  07EC'   D1                    	POP	D
  07ED'   19                    	DAD	D
  07EE'   C3 056D'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  07F1'                         VC_EOL:
  07F1'   CD 06EB'              	CALL	SETMOV
  07F4'   21 FFFF               	LXI	H,0FFFFH
  07F7'   22 2906'              	SHLD	GOALCOL
  07FA'   CD 067E'              	CALL	GETCNT
  07FD'   2B                    	DCX	H		; count-1
  07FE'   7C                    	MOV	A,H
  07FF'   B5                    	ORA	L
  0800'   CA 080F'              	JZ	VEOL_0
  0803'   E5                    	PUSH	H
  0804'   CD 0824'              	CALL	ONLAST
  0807'   E1                    	POP	H
  0808'   D8                    	RC			; the last line: no move (vim)
  0809'   CD 0867'              	CALL	JCORE
  080C'   C3 09B6'              	JMP	JKLAND
  080F'                         VEOL_0:
  080F'   CD 07A2'              	CALL	LNSTRT
  0812'   C3 09B6'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  0815'                         VC_CR:
  0815'   CD 066B'              	CALL	MOVCNT		; a cursor motion, and its count
  0818'   E5                    	PUSH	H
  0819'   CD 0824'              	CALL	ONLAST
  081C'   E1                    	POP	H
  081D'   D8                    	RC
  081E'   CD 0867'              	CALL	JCORE
  0821'   C3 07B9'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  0824'                         ONLAST:
  0824'   CD 0000*              	CALL	RGET0
  0827'                         OL_LP:
  0827'   CD 0000*              	CALL	RDGET
  082A'   D8                    	RC			; the file ends on this line
  082B'   FE 0A                 	CPI	LF
  082D'   C2 0827'              	JNZ	OL_LP
  0830'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  0833'                         VC_J:
  0833'   CD 06EB'              	CALL	SETMOV
  0836'   CD 0851'              	CALL	GLCHK		; the goal column, from the cursor if stale
  0839'   CD 067E'              	CALL	GETCNT		; HL = count
  083C'   CD 0867'              	CALL	JCORE
  083F'   C3 09B6'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  0842'                         VC_K:
  0842'   CD 06EB'              	CALL	SETMOV
  0845'   CD 0851'              	CALL	GLCHK
  0848'   CD 067E'              	CALL	GETCNT
  084B'   CD 0904'              	CALL	KCORE
  084E'   C3 09B6'              	JMP	JKLAND
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  0851'                         GLCHK:
  0851'   2A 2906'              	LHLD	GOALCOL
  0854'   7C                    	MOV	A,H
  0855'   3C                    	INR	A
  0856'   C0                    	RNZ
  0857'   7D                    	MOV	A,L
  0858'   FE FE                 	CPI	0FEH
  085A'   C0                    	RNZ
  085B'   C3 0570'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  085E'                         GLSTAL:
  085E'   E5                    	PUSH	H
  085F'   21 FFFE               	LXI	H,0FFFEH
  0862'   22 2906'              	SHLD	GOALCOL
  0865'   E1                    	POP	H
  0866'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  0867'                         JCORE:
  0867'   7C                    	MOV	A,H
  0868'   B5                    	ORA	L
  0869'   C8                    	RZ
  086A'   22 290C'              	SHLD	JKCNT
