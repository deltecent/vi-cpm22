                                ;============================================================
                                ; DATA -- what the image carries: the cells that start at something.
                                ;============================================================
                                ;The cells that start at zero are not in the image: RSV.MAC names them, in
                                ;the RAM just above it, and BUF.MAC's ZINIT clears them before anything runs.
                                ;Their order there is the order they had here, and code depends on it.
                                	EXTRN	EDMODE, CMDCNT, QUITF, MODF, RINTENT, ICHAPP
                                	EXTRN	DCHBS, LNALL, ILABOV, WBIG, WPULL, HFAMT
                                	EXTRN	HFN, HFTP, HTN, HTCUR, HTTP, HTEOF
                                	EXTRN	HTBOF, RWR, RWMV, OVDIR, JKCNT, JKN
                                	EXTRN	JKMOV, JKBK, JKPHN, JKLST, JKVC, JKLS
                                	EXTRN	DOTCHG, DOTRPL, DOTOVF, DOTLK, DOTLEN, DOTIX
                                	EXTRN	DOTNCT, GPEND, GSAVE, PENDOP, PSAVE, DDSNG
                                	EXTRN	OPCLSV, CWEOL, OPSTA, OPEND2, OPSFP, OPSLO
                                	EXTRN	OPSHI, OPTOGO, OPLO, OPHI, CNTV, TTI
                                	EXTRN	WKI, WKTERM, WKBOL, WKCLS, VRCH, RPDEL
                                	EXTRN	RPAPP, RPGE, RLPTR, RLLEN, RLMAX, EXOP
                                	EXTRN	EXARG, EXBAK, EXCMD, WPROW, WPBYT, WPREC
                                	EXTRN	ZDIF, ZLF, ZSVCNT, ZSVAUX, ZSVDIR, MSGWHT
                                	EXTRN	MSGNEW, EXBANG, ROFLAG, PLUSF, YMODF, YDCHG
                                	EXTRN	YURPL, YOFF, YPT, PCNT, PPFP, PLFS
                                	EXTRN	PCPY, YLDLT, SDIR, SDIRE, SHAVE, FNDKND
                                	EXTRN	FNDCH, FNDRUN, FNDSTP, FNDN, FNDCUR, FNDLIM
                                	EXTRN	GPKEEP, MKVAL, MKEDIT, MKN, MKTYP, MKPOS
                                	EXTRN	MKWHAT, MKHOLD, YACT, YTGT, YWAS, YCOL
                                	EXTRN	YPFP, YNPG, YNCNT, SCNT, SOFF, SLDLT
                                	EXTRN	BRKARM, BRKHIT, SRNGF, SRNG1, SRNG2
                                	EXTRN	SGPOS, SCLIM, SCPOS, SCHIT, SCFND, SCCRY
                                	EXTRN	SCPH, SCIX, SCEND
                                	EXTRN	ABTFLG, FORCEF, VISTK
	MACRO-80 3.44	09-Dec-81	PAGE	1-154


                                	EXTRN	SDELIM, SGFLAG, SANY, SLCHG, SBACK, SLINES
                                	EXTRN	RWPTR, RWERR, RDANY, RDBRK, SOFFS, SLDLTS
                                	EXTRN	SREPLN, SREPL
                                
  3228'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  3229'   01                    DCHN:	DB	1		; the cells an R_DCH paint deletes (SCRN.MAC reads)
  322A'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  322C'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  322D'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
                                
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                
                                	END
