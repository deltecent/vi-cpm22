                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the cursor's line is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
                         C      ; PLACE -- what a command asks of the next layout (SCRN.MAC), cleared by it.
  0000                   C      PL_ASK	EQU	0		; the cursor only moved: is its line on the screen
                         C      				;   still, near it, or far off? (vim's rule)
  0001                   C      PL_SET	EQU	1		; the command set the lines above it (WINROW)
  0002                   C      PL_MID	EQU	2		; mid-screen, as the rows fall
                         C      
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; the cursor's line changed only -> redraw it from the cursor's row
  0003                   C      R_DLIN	EQU	3		; the cursor's line deleted -> DL its rows + redraw the bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted, no TAB after it -> ICH
  0005                   C      R_ILIN	EQU	5		; ILN lines opened at the cursor -> IL + their rows (ILABOV: the line above)
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw it + DL the rows saved
  0007                   C      R_DCH	EQU	7		; chars deleted at the cursor, none after it a TAB -> DCH
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	COL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	DCHN				; ... the cells an R_DCH deletes
                                	PUBLIC	DCHBS				; ... 1 = left of the cursor (BS)
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	MKSHFT				; the marks follow an edit (VI.MAC hooks it)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	HTN, HTCUR, HTEOF, HTBOF	; the row table's facts (SCRN.MAC HTBLD)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	KBBRK, KBFLSH			; KEY.MAC -- an ESC waiting / drop type-ahead
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	MKSAV				; ... and a refused 'dd's copy of them
                                	EXTRN	MKUND				; ... and the copy 'u' puts back
                                	EXTRN	UNDST, UNDNEW			; BUF.MAC -- undone or not; no change yet
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
                                	EXTRN	UNDCLR				; ... nothing to undo
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	INSBLK, UNDINS			; BUF.MAC -- a block in at the cursor (':r')
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	SCBOT, SCEOF, SCBOF, PLACE	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	SKIPR, TALLF		; a top line taller than the screen
                                	EXTRN	TXEND, CSUB, HTBLD		; ... its rows of text, the cursor's row
                                						;   in its line, and the row table
                                	EXTRN	HTAB				; RSV.MAC -- the row table itself
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	SETC0				; BUF.MAC -- WM count set, forward
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GOLINE				; BUF.MAC -- WM 2228 (a mark's page loop)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   AF                    	XRA	A		; no command is ever left open to an ESC by the
  0001'   32 2EC1'              	STA	BRKARM		;   one before it (BRKON)
  0004'   CD 00D7'              	CALL	DOTPRE
  0007'   CD 000D'              	CALL	CDMODE
  000A'   C3 011C'              	JMP	DOTPOST
  000D'                         CDMODE:
  000D'   3A 2E02'              	LDA	EDMODE
  0010'   FE 01                 	CPI	EM_INS
  0012'   CA 001D'              	JZ	CD_INS
  0015'   FE 02                 	CPI	EM_REP
  0017'   CA 0020'              	JZ	CD_REP
  001A'   C3 0023'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  001D'                         CD_INS:
  001D'   C3 1F4F'              	JMP	VIINS
  0020'                         CD_REP:
  0020'   C3 1E84'              	JMP	VIREP
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


                                
                                ;============================================================
                                ; VICMD -- command-mode key.  C = the key.
                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  0023'                         VICMD:
  0023'   79                    	MOV	A,C
  0024'   FE 1B                 	CPI	ESC
  0026'   CA 00AC'              	JZ	VIC_ESC
  0029'   3A 2E37'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002C'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  002E'   CA 1A6E'              	JZ	VR_DO
                                	;--- maybe a count digit ---
  0031'   79                    	MOV	A,C
  0032'   FE 31                 	CPI	'1'
  0034'   DA 003F'              	JC	VIC_NOTD	; < '1'
  0037'   FE 3A                 	CPI	'9'+1
  0039'   D2 003F'              	JNC	VIC_NOTD	; > '9'
  003C'   C3 004F'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  003F'                         VIC_NOTD:
  003F'   79                    	MOV	A,C
  0040'   FE 30                 	CPI	'0'
  0042'   C2 0077'              	JNZ	VICDSP
  0045'   2A 2E03'              	LHLD	CMDCNT
  0048'   7C                    	MOV	A,H
  0049'   B5                    	ORA	L
  004A'   CA 0077'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  004D'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  004F'                         VICDIG:
  004F'   2A 2E03'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0052'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0053'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0054'   29                    	DAD	H		; *2
  0055'   DA 006E'              	JC	VIC_SAT
  0058'   29                    	DAD	H		; *4
  0059'   DA 006E'              	JC	VIC_SAT
  005C'   19                    	DAD	D		; *5
  005D'   DA 006E'              	JC	VIC_SAT
  0060'   29                    	DAD	H		; *10
  0061'   DA 006E'              	JC	VIC_SAT
  0064'   79                    	MOV	A,C
  0065'   D6 30                 	SUI	'0'
  0067'   5F                    	MOV	E,A
  0068'   16 00                 	MVI	D,0
  006A'   19                    	DAD	D
  006B'   D2 0071'              	JNC	VIC_CNT
  006E'                         VIC_SAT:
  006E'   21 FFFF               	LXI	H,0FFFFH
  0071'                         VIC_CNT:
  0071'   22 2E03'              	SHLD	CMDCNT
  0074'   C3 0807'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  0077'                         VICDSP:
  0077'   3A 2E37'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  007A'   32 2E38'              	STA	GSAVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  007D'   AF                    	XRA	A
  007E'   32 2E37'              	STA	GPEND
  0081'   3A 2E39'              	LDA	PENDOP
  0084'   32 2E3A'              	STA	PSAVE
  0087'   AF                    	XRA	A
  0088'   32 2E39'              	STA	PENDOP
  008B'   3A 2E3A'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  008E'   B7                    	ORA	A
  008F'   C2 13CE'              	JNZ	OPPEND
  0092'   3A 2E38'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0095'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  0097'   C2 00A0'              	JNZ	VIC_TB
  009A'   79                    	MOV	A,C
  009B'   FE 5A                 	CPI	'Z'
  009D'   C2 00A6'              	JNZ	VIC_SW
  00A0'                         VIC_TB:
  00A0'   21 2D4A'              	LXI	H,CMDTAB
  00A3'   C3 00BC'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A6'                         VIC_SW:
  00A6'   CD 0807'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00A9'   C3 0732'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AC'                         VIC_ESC:
  00AC'   AF                    	XRA	A		; ESC drops whatever was pending, the count too
  00AD'   32 2E37'              	STA	GPEND
  00B0'   32 2E38'              	STA	GSAVE
  00B3'   32 2E39'              	STA	PENDOP
  00B6'   32 2E3A'              	STA	PSAVE
  00B9'   C3 00A6'              	JMP	VIC_SW
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the TOP-LEVEL key table, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00BC'                         VSCANQ:
  00BC'   CD 00C8'              	CALL	VSCLK
  00BF'   CA 00A6'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C2'   E9                    	PCHL
  00C3'                         VSCAN:
  00C3'   CD 00C8'              	CALL	VSCLK
  00C6'   C8                    	RZ			; miss
  00C7'   E9                    	PCHL
  00C8'                         VSCLK:
  00C8'   7E                    VSCAN1: MOV	A,M
  00C9'   B7                    	ORA	A
  00CA'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00CB'   23                    	INX	H
  00CC'   B9                    	CMP	C
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00CD'   5E                    	MOV	E,M
  00CE'   23                    	INX	H
  00CF'   56                    	MOV	D,M
  00D0'   23                    	INX	H
  00D1'   C2 00C8'              	JNZ	VSCAN1
  00D4'   EB                    	XCHG			; HL = the handler
  00D5'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00D6'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00D7'                         DOTPRE:
  00D7'   3A 2E2E'              	LDA	DOTRPL
  00DA'   B7                    	ORA	A
  00DB'   C0                    	RNZ			; the replay's own keys are not recorded
  00DC'   C5                    	PUSH	B
  00DD'   D5                    	PUSH	D
  00DE'   E5                    	PUSH	H
  00DF'   3A 2E2D'              	LDA	DOTSTA
  00E2'   B7                    	ORA	A
  00E3'   CA 00F6'              	JZ	DOTP1
  00E6'   AF                    	XRA	A		; a new command: the recording starts over
  00E7'   32 2E2D'              	STA	DOTSTA
  00EA'   32 2E2F'              	STA	DOTOVF
  00ED'   21 0000*              	LXI	H,DOTSCR
  00F0'   22 2E31'              	SHLD	DOTSP
  00F3'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00F6'                         DOTP1:
  00F6'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00F7'   32 2E30'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  00FA'   47                    	MOV	B,A
  00FB'   2A 2E31'              	LHLD	DOTSP
  00FE'   EB                    	XCHG
  00FF'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  0102'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  0105'   D2 0114'              	JNC	DOTPOV
  0108'   2A 2E31'              	LHLD	DOTSP
  010B'   70                    	MOV	M,B
  010C'   23                    	INX	H
  010D'   22 2E31'              	SHLD	DOTSP
  0110'                         DOTPX:
  0110'   E1                    	POP	H
  0111'   D1                    	POP	D
  0112'   C1                    	POP	B
  0113'   C9                    	RET
  0114'                         DOTPOV:
  0114'   3E 01                 	MVI	A,1
  0116'   32 2E2F'              	STA	DOTOVF		; too long to record: give this recording up
  0119'   C3 0110'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  011C'                         DOTPOST:
  011C'   3A 2E2E'              	LDA	DOTRPL
  011F'   B7                    	ORA	A
  0120'   C0                    	RNZ
  0121'   3A 2E02'              	LDA	EDMODE
  0124'   B7                    	ORA	A
  0125'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  0126'   3A 2E37'              	LDA	GPEND
  0129'   B7                    	ORA	A
  012A'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  012B'   3A 2E39'              	LDA	PENDOP
  012E'   B7                    	ORA	A
  012F'   C0                    	RNZ			; an operator still waiting for its motion
  0130'   2A 2E03'              	LHLD	CMDCNT
  0133'   7C                    	MOV	A,H
  0134'   B5                    	ORA	L
  0135'   CA 0143'              	JZ	DOTQ1
  0138'   3A 2E30'              	LDA	DOTLK		; a digit with the count still up: the command
  013B'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  013D'   DA 0143'              	JC	DOTQ1
  0140'   FE 3A                 	CPI	'9'+1
  0142'   D8                    	RC
  0143'                         DOTQ1:
  0143'   3E 01                 	MVI	A,1
  0145'   32 2E2D'              	STA	DOTSTA		; the next key starts a new recording
  0148'   3A 2E2C'              	LDA	DOTCHG
  014B'   B7                    	ORA	A
  014C'   C8                    	RZ			; changed nothing: not a repeatable command
  014D'   AF                    	XRA	A
  014E'   32 2E2C'              	STA	DOTCHG
  0151'   32 2E33'              	STA	DOTLEN
  0154'   3A 2E2F'              	LDA	DOTOVF
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0157'   B7                    	ORA	A
  0158'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  0159'   2A 2E31'              	LHLD	DOTSP
  015C'   11 0000*              	LXI	D,DOTSCR
  015F'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  0162'   7D                    	MOV	A,L
  0163'   32 2E33'              	STA	DOTLEN
  0166'   B7                    	ORA	A
  0167'   C8                    	RZ
  0168'   4F                    	MOV	C,A
  0169'   06 00                 	MVI	B,0
  016B'   21 0000*              	LXI	H,DOTSCR
  016E'   11 0000*              	LXI	D,DOTBUF
  0171'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  0174'                         MARKMOD:
  0174'   3E 01                 	MVI	A,1
  0176'   32 2E06'              	STA	MODF
  0179'   32 2E2C'              	STA	DOTCHG
  017C'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  017D'                         VC_DOT:
  017D'   2A 2E03'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0180'   22 2E35'              	SHLD	DOTNCT
  0183'   21 0000               	LXI	H,0
  0186'   22 2E03'              	SHLD	CMDCNT
  0189'   3A 2E33'              	LDA	DOTLEN
  018C'   B7                    	ORA	A
  018D'   CA 01DC'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
  0190'   AF                    	XRA	A
  0191'   32 2E34'              	STA	DOTIX
  0194'   2A 2E35'              	LHLD	DOTNCT
  0197'   7C                    	MOV	A,H
  0198'   B5                    	ORA	L
  0199'   CA 01B9'              	JZ	DOTGO
  019C'   22 2E03'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  019F'                         DOTSKP:
  019F'   CD 05A4'              	CALL	DOTGET		; ... so step past the digits it recorded
  01A2'   DA 01B9'              	JC	DOTGO
  01A5'   FE 30                 	CPI	'0'
  01A7'   DA 01B9'              	JC	DOTGO
  01AA'   FE 3A                 	CPI	'9'+1
  01AC'   D2 01B9'              	JNC	DOTGO
  01AF'   3A 2E34'              	LDA	DOTIX
  01B2'   3C                    	INR	A
  01B3'   32 2E34'              	STA	DOTIX
  01B6'   C3 019F'              	JMP	DOTSKP
  01B9'                         DOTGO:
  01B9'   3E 01                 	MVI	A,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01BB'   32 2E2E'              	STA	DOTRPL
  01BE'                         DOTLP:
  01BE'   CD 05A4'              	CALL	DOTGET
  01C1'   DA 01D2'              	JC	DOTDN
  01C4'   4F                    	MOV	C,A
  01C5'   3A 2E34'              	LDA	DOTIX
  01C8'   3C                    	INR	A
  01C9'   32 2E34'              	STA	DOTIX
  01CC'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01CF'   C3 01BE'              	JMP	DOTLP
  01D2'                         DOTDN:
  01D2'   AF                    	XRA	A
  01D3'   32 2E2E'              	STA	DOTRPL
  01D6'   32 2E2C'              	STA	DOTCHG		; the '.' is not itself the new last change
  01D9'   C3 0844'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01DC'                         DOTBEL:
  01DC'   0E 07                 	MVI	C,BEL
  01DE'   CD 0000*              	CALL	BCONOU
  01E1'   C3 0807'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a 3-byte position in the FILE (FPOS: the records paged out ahead
                                ; of the window, plus the offset into it), so it does not care which part of
                                ; the file is resident: a jump pages until the window holds it (MKPAGE).  It
                                ; FOLLOWS its text, as vim's does: every edit passes MKSHFT, which moves the
                                ; marks past it by the bytes that went in or came out.
                                ;
                                ; DEVIATIONS from vim, in COMMANDS.md: a mark whose own text is deleted closes
                                ; up to where the delete was, where vim deletes the mark with its line; and
                                ; within its line a mark stays with its CHARACTER, where vim keeps the column
                                ; number.  'u' puts the marks back where they were when the change it
                                ; undoes began (MKSNAP / MKREST).
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  01E4'                         MKVAD:
  01E4'   16 00                 	MVI	D,0
  01E6'   59                    	MOV	E,C
  01E7'   21 2E9D'              	LXI	H,MKVAL
  01EA'   19                    	DAD	D
  01EB'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  01EC'                         MKCLR:
  01EC'   21 2E9D'              	LXI	H,MKVAL
  01EF'   06 03                 	MVI	B,MKMAX
  01F1'   AF                    	XRA	A
  01F2'                         MKC_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


  01F2'   77                    	MOV	M,A
  01F3'   23                    	INX	H
  01F4'   05                    	DCR	B
  01F5'   C2 01F2'              	JNZ	MKC_LP
  01F8'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was an ESC.
                                ;A key typed here did not come through the dispatcher, so it is handed to
                                ;DOTPRE to join the recording: that is what lets '.' repeat "dfa", "dgg" and
                                ;"d'a".
  01F9'                         MKGETK:
  01F9'   3A 2E2E'              	LDA	DOTRPL
  01FC'   B7                    	ORA	A
  01FD'   CA 020E'              	JZ	MKG_KB
  0200'   CD 05A4'              	CALL	DOTGET		; the recording's next key
  0203'   D8                    	RC
  0204'   4F                    	MOV	C,A
  0205'   3A 2E34'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  0208'   3C                    	INR	A
  0209'   32 2E34'              	STA	DOTIX
  020C'   B7                    	ORA	A		; CY clear
  020D'   C9                    	RET
  020E'                         MKG_KB:
  020E'   CD 0000*              	CALL	GETKEY
  0211'   FE 1B                 	CPI	ESC
  0213'   37                    	STC
  0214'   C8                    	RZ			; ESC cancels the command
  0215'   CD 00D7'              	CALL	DOTPRE		; C kept
  0218'   B7                    	ORA	A		; CY clear
  0219'   C9                    	RET
                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
                                ; the motion returns.  MKGETK puts the character in the '.' recording, so
                                ; '.' can repeat "dfa".
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
                                ;============================================================
  021A'                         VC_FF:				; 'f' -- forward, onto the character
  021A'   3E 66                 	MVI	A,'f'
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  021C'   C3 022B'              	JMP	FNDNEW
  021F'                         VC_FB:				; 'F' -- backward, onto it
  021F'   3E 46                 	MVI	A,'F'
  0221'   C3 022B'              	JMP	FNDNEW
  0224'                         VC_TF:				; 't' -- forward, up to it
  0224'   3E 74                 	MVI	A,'t'
  0226'   C3 022B'              	JMP	FNDNEW
  0229'                         VC_TB:				; 'T' -- backward, up to it
  0229'   3E 54                 	MVI	A,'T'
  022B'                         FNDNEW:
  022B'   32 2E92'              	STA	FNDKND		; the find ';' and ',' will repeat
  022E'   CD 01F9'              	CALL	MKGETK		; the character it looks for
  0231'   DA 0263'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0234'   79                    	MOV	A,C
  0235'   32 2E93'              	STA	FNDCH
  0238'   3A 2E92'              	LDA	FNDKND
  023B'   06 01                 	MVI	B,1		; a find starts at the next character along
  023D'   C3 026A'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0240'                         VC_SEMI:
  0240'   3A 2E92'              	LDA	FNDKND
  0243'   B7                    	ORA	A
  0244'   CA 0263'              	JZ	FNDNIL		; nothing has been looked for yet
  0247'   C3 0253'              	JMP	FNDREP
  024A'                         VC_COMMA:
  024A'   3A 2E92'              	LDA	FNDKND
  024D'   B7                    	ORA	A
  024E'   CA 0263'              	JZ	FNDNIL
  0251'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0253'                         FNDREP:
  0253'   06 01                 	MVI	B,1
  0255'   F5                    	PUSH	PSW
  0256'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  0258'   FE 54                 	CPI	'T'
  025A'   C2 025F'              	JNZ	FNDR_GO
  025D'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  025F'                         FNDR_GO:
  025F'   F1                    	POP	PSW
  0260'   C3 026A'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
  0263'                         FNDNIL:
  0263'   AF                    	XRA	A
  0264'   32 2E3A'              	STA	PSAVE
  0267'   C3 0807'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  026A'                         FNDGO:
  026A'   32 2E94'              	STA	FNDRUN
  026D'   78                    	MOV	A,B
  026E'   32 2E95'              	STA	FNDSTP
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  0271'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
  0274'   22 2E96'              	SHLD	FNDN		; the occurrence wanted
  0277'   CD 0000*              	CALL	CUROFF
  027A'   22 2E98'              	SHLD	FNDCUR
  027D'   3A 2E94'              	LDA	FNDRUN
  0280'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  0282'   CA 02B6'              	JZ	FNDBWD
  0285'   2A 2E98'              	LHLD	FNDCUR
  0288'   CD 06CA'              	CALL	EOLC		; HL = the line's last content character
  028B'   22 2E9A'              	SHLD	FNDLIM
  028E'   2A 2E98'              	LHLD	FNDCUR
  0291'   3A 2E95'              	LDA	FNDSTP
  0294'   5F                    	MOV	E,A
  0295'   16 00                 	MVI	D,0
  0297'   19                    	DAD	D		; HL = where the scan starts
  0298'                         FNDF_LP:
  0298'   EB                    	XCHG			; DE = the scan
  0299'   2A 2E9A'              	LHLD	FNDLIM
  029C'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  029F'   EB                    	XCHG			; HL = the scan
  02A0'   CA 02A6'              	JZ	FNDF_AT		; the last character is still a candidate
  02A3'   D2 0308'              	JNC	FNDMIS		; past it: not on this line
  02A6'                         FNDF_AT:
  02A6'   CD 030F'              	CALL	FNDSEE		; Z iff this is the character
  02A9'   C2 02B2'              	JNZ	FNDF_NX
  02AC'   CD 031A'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02AF'   CA 02EE'              	JZ	FNDHIT
  02B2'                         FNDF_NX:
  02B2'   23                    	INX	H
  02B3'   C3 0298'              	JMP	FNDF_LP
  02B6'                         FNDBWD:
  02B6'   2A 2E98'              	LHLD	FNDCUR
  02B9'   CD 0624'              	CALL	BOL		; HL = the line's first character
  02BC'   22 2E9A'              	SHLD	FNDLIM
  02BF'   2A 2E98'              	LHLD	FNDCUR
  02C2'   3A 2E95'              	LDA	FNDSTP
  02C5'   2F                    	CMA
  02C6'   5F                    	MOV	E,A
  02C7'   16 FF                 	MVI	D,0FFH
  02C9'   13                    	INX	D		; DE = -step
  02CA'   19                    	DAD	D		; HL = where the scan starts
  02CB'   D2 0308'              	JNC	FNDMIS		; ... off the front of the text altogether
  02CE'                         FNDB_LP:
  02CE'   EB                    	XCHG			; DE = the scan
  02CF'   2A 2E9A'              	LHLD	FNDLIM
  02D2'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02D5'   EB                    	XCHG			; HL = the scan
  02D6'   DA 0308'              	JC	FNDMIS		; before this line: not on it
  02D9'   CD 030F'              	CALL	FNDSEE
  02DC'   C2 02E5'              	JNZ	FNDB_NX
  02DF'   CD 031A'              	CALL	FNDCNT
  02E2'   CA 02EE'              	JZ	FNDHIT
  02E5'                         FNDB_NX:
  02E5'   7C                    	MOV	A,H
  02E6'   B5                    	ORA	L
  02E7'   CA 0308'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02EA'   2B                    	DCX	H
  02EB'   C3 02CE'              	JMP	FNDB_LP
                                
                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  02EE'                         FNDHIT:
  02EE'   3A 2E94'              	LDA	FNDRUN
  02F1'   E6 5F                 	ANI	5FH
  02F3'   FE 54                 	CPI	'T'
  02F5'   C2 0305'              	JNZ	FNDLND
  02F8'   3A 2E94'              	LDA	FNDRUN
  02FB'   E6 20                 	ANI	20H
  02FD'   CA 0304'              	JZ	FNDH_BW
  0300'   2B                    	DCX	H		; forward 't': the character before it
  0301'   C3 0305'              	JMP	FNDLND
  0304'                         FNDH_BW:
  0304'   23                    	INX	H		; backward 'T': the character after it
  0305'                         FNDLND:
  0305'   C3 05BA'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  0308'                         FNDMIS:
  0308'   AF                    	XRA	A
  0309'   32 2E3A'              	STA	PSAVE
  030C'   C3 01DC'              	JMP	DOTBEL
                                
                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
  030F'                         FNDSEE:
  030F'   E5                    	PUSH	H
  0310'   CD 0000*              	CALL	CHARAT
  0313'   E1                    	POP	H
  0314'   47                    	MOV	B,A
  0315'   3A 2E93'              	LDA	FNDCH
  0318'   B8                    	CMP	B
  0319'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
                                ; the scan and stays it.
  031A'                         FNDCNT:
  031A'   E5                    	PUSH	H
  031B'   2A 2E96'              	LHLD	FNDN
  031E'   2B                    	DCX	H
  031F'   22 2E96'              	SHLD	FNDN
  0322'   7C                    	MOV	A,H
  0323'   B5                    	ORA	L
  0324'   E1                    	POP	H
  0325'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  0326'                         ISFIND:
  0326'   E6 5F                 	ANI	5FH		; fold the case away
  0328'   FE 46                 	CPI	'F'
  032A'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  032B'   FE 54                 	CPI	'T'
  032D'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  032E'                         VC_MK:
  032E'   3E 04                 	MVI	A,PM
  0330'   C3 033A'              	JMP	MKGO
  0333'                         VC_BQ:
  0333'   3E 05                 	MVI	A,PJ
  0335'   C3 033A'              	JMP	MKGO
  0338'                         VC_AQ:
  0338'   3E 06                 	MVI	A,PJL
  033A'                         MKGO:
  033A'   32 2EA9'              	STA	MKWHAT
  033D'   CD 071F'              	CALL	MOVCNT		; a count means nothing on any of the three
  0340'   CD 01F9'              	CALL	MKGETK		; the key that names the mark
  0343'   DA 0422'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out.  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist: 'm' with any other key
                                ;drops the whole thing, as vim's 'Z{other}' does, and a jump to one is a jump
                                ;to a mark that is not set.
  0346'                         MKOP:
  0346'   79                    	MOV	A,C
  0347'   D6 61                 	SUI	'a'
  0349'   FE 03                 	CPI	MKMAX
  034B'   D2 041A'              	JNC	MKNOLT		; not a mark letter
  034E'   4F                    	MOV	C,A		; C = the mark's index
  034F'   87                    	ADD	A
  0350'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  0351'   5F                    	MOV	E,A
  0352'   16 00                 	MVI	D,0
  0354'   21 0000*              	LXI	H,MKTAB
  0357'   19                    	DAD	D		; HL -> this mark's slot
  0358'   3A 2EA9'              	LDA	MKWHAT
  035B'   FE 04                 	CPI	PM
  035D'   CA 0435'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark, paging to it if the window has left it.
                                ;'Mark not set', as vim says it, when it was never set.
                                ;Under an OPERATOR a mark the window does not hold is refused with the bell
                                ;and stays set, all but "d'a": a line delete is the one operator that can take
                                ;a span the window does not hold whole (OPPGD), and going there only to be
                                ;turned away by it would page the file twice for nothing.
  0360'                         MKJMP:
  0360'   E5                    	PUSH	H
  0361'   CD 01E4'              	CALL	MKVAD
  0364'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  0365'   E1                    	POP	H
  0366'   B7                    	ORA	A
  0367'   CA 0410'              	JZ	MKNSET		; never set
  036A'   CD 03DC'              	CALL	MKLOAD		; the file position it holds
  036D'   CD 03E9'              	CALL	MKWIN
  0370'   DA 0387'              	JC	MKJ_GO		; in the window: any command may go there
  0373'   3A 2E3A'              	LDA	PSAVE
  0376'   B7                    	ORA	A
  0377'   CA 0387'              	JZ	MKJ_GO
  037A'   FE 64                 	CPI	'd'		; paged out, and an operator wants the span
  037C'   C2 0422'              	JNZ	MKBAD
  037F'   3A 2EA9'              	LDA	MKWHAT
  0382'   FE 06                 	CPI	PJL
  0384'   C2 0422'              	JNZ	MKBAD
  0387'                         MKJ_GO:
  0387'   CD 12DF'              	CALL	GZONE		; the screen's top line, before the cursor
                                				;   moves: GPLACE measures the landing against
                                				;   it, and one left over from an earlier 'G'
                                				;   had it keep a window the line is not in
  038A'   CD 075B'              	CALL	BRKON		; ... and an ESC may stop it from here on
  038D'   CD 03A9'              	CALL	MKPAGE		; HL = the mark's offset in the window
  0390'   CD 0798'              	CALL	BRKOFF		; (A only)
  0393'   DA 07B0'              	JC	BRKBAK
  0396'   3A 2EA9'              	LDA	MKWHAT
  0399'   FE 06                 	CPI	PJL
  039B'   CA 03A3'              	JZ	MKJ_LN		; ''': GPKEEP is 0, so GPLACE finds the first
  039E'   3E 01                 	MVI	A,1		;   non-blank
  03A0'   32 2E9C'              	STA	GPKEEP		; '`': land on the column it was set at
  03A3'                         MKJ_LN:
  03A3'   CD 0000*              	CALL	GOTO
  03A6'   C3 12F7'              	JMP	GPLACE		; (which sets LNDLT itself)
                                
                                ;MKPAGE -- page until MKPOS is in the window: HL = its logical offset there.
                                ;The loop is WM's own whole-file line move (MVLMAX: GOLINE to the window's
                                ;edge, SCRLST to page one step), stopped by where the window is instead of by
                                ;the count.  A step cannot carry the window past the mark: the pager evicts
                                ;only behind the cursor, and the cursor is on the edge nearer the mark.
  03A9'                         MKPAGE:
  03A9'   CD 03E9'              	CALL	MKWIN
  03AC'   DA 0000*              	JC	CLRCNT		; there: and the count that paged is spent,
                                				;   not left for the next command to take
  03AF'   32 0000*              	STA	DIRFLG
  03B2'   21 FFFF               	LXI	H,0FFFFH
  03B5'   22 2E03'              	SHLD	CMDCNT
  03B8'   CD 0000*              	CALL	GOLINE
  03BB'   CD 0000*              	CALL	SCRLST
  03BE'   CD 0747'              	CALL	CNTTST
  03C1'   C2 03A9'              	JNZ	MKPAGE
  03C4'   CD 03E9'              	CALL	MKWIN		; the file ran out: that was its last step
  03C7'   DA 0000*              	JC	CLRCNT
  03CA'   21 FFFF               	LXI	H,0FFFFH	; the very end of the text, which MKWIN does not
  03CD'   C3 0000*              	JMP	CLRCNT		;   count as in the window: GOTO clamps it
                                
                                ;BACKTO -- back to the 3-byte file position at HL, paging to it: where a
                                ;command that came to nothing started.  The place has to be kept as a file
                                ;position -- a sweep of the whole file leaves the window at the far end of
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


                                ;it, and an offset into the window it started in means nothing there.
  03D0'                         BACKTO:
  03D0'   CD 03DC'              	CALL	MKLOAD
  03D3'   CD 0000*              	CALL	CLRCNT
  03D6'   CD 03A9'              	CALL	MKPAGE
  03D9'   C3 0000*              	JMP	GOTO
                                
                                ;MKLOAD -- MKPOS = the 3-byte file position at HL.
  03DC'                         MKLOAD:
  03DC'   5E                    	MOV	E,M
  03DD'   23                    	INX	H
  03DE'   56                    	MOV	D,M
  03DF'   23                    	INX	H
  03E0'   7E                    	MOV	A,M
  03E1'   EB                    	XCHG
  03E2'   22 2EA6'              	SHLD	MKPOS
  03E5'   32 2EA8'              	STA	MKPOS+2
  03E8'   C9                    	RET
                                
                                ;MKWIN -- CY and HL = MKPOS as a logical offset if the window holds it; NC and
                                ;A = the way to page for it, as DIRFLG has it (0 forward, FFH back), if not.
  03E9'                         MKWIN:
  03E9'   2A 0000*              	LHLD	TXTBEG
  03EC'   CD 1299'              	CALL	FPOS
  03EF'   EB                    	XCHG
  03F0'   47                    	MOV	B,A		; B:DE = the window's first byte
  03F1'   2A 2EA6'              	LHLD	MKPOS
  03F4'   3A 2EA8'              	LDA	MKPOS+2
  03F7'   CD 128C'              	CALL	SUB24		; A:HL = the mark, from the window's top
  03FA'   DA 040C'              	JC	MKW_BK		; above it
  03FD'   C2 040A'              	JNZ	MKW_FW		; 64K or more below it
  0400'   E5                    	PUSH	H
  0401'   CD 0000*              	CALL	LOGLEN
  0404'   D1                    	POP	D
  0405'   CD 0000*              	CALL	CMP16		; DE = the offset vs HL = the window's length
  0408'   EB                    	XCHG
  0409'   D8                    	RC			; inside
  040A'                         MKW_FW:
  040A'   AF                    	XRA	A
  040B'   C9                    	RET
  040C'                         MKW_BK:
  040C'   3E FF                 	MVI	A,0FFH
  040E'   B7                    	ORA	A
  040F'   C9                    	RET
                                
                                ;MKNSET -- a jump to a mark that will not answer: vim's E20 on the bottom row
                                ;(without the number, and without a bell, as every message here), the cursor
                                ;and the screen left alone.  The operator is cancelled as MKBAD cancels it.
  0410'                         MKNSET:
  0410'   AF                    	XRA	A
  0411'   32 2E3A'              	STA	PSAVE
  0414'   21 27DA'              	LXI	H,SMKNS
  0417'   C3 26BF'              	JMP	EXERR
  041A'                         MKNOLT:
  041A'   3A 2EA9'              	LDA	MKWHAT
  041D'   FE 04                 	CPI	PM
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  041F'   C2 0410'              	JNZ	MKNSET		; a jump: that mark is not set
                                				; 'm{other}': fall into MKBAD
                                
                                ;MKBAD -- no mark was named: 'm' with a key that is not a mark letter, ESC in
                                ;place of the letter, or a '.' replay that ran out.  The bell, and an operator
                                ;running the motion is cancelled whole: PSAVE is what OPPEND's tail reads to
                                ;decide whether to open an insert, so clearing it stops a "c`z" opening one
                                ;over a span of nothing.
  0422'                         MKBAD:
  0422'   AF                    	XRA	A
  0423'   32 2E3A'              	STA	PSAVE
  0426'   C3 01DC'              	JMP	DOTBEL
                                
                                ;FPSTO -- the cursor's file position into the 3 bytes at HL.  Keeps BC.
  0429'                         FPSTO:
  0429'   E5                    	PUSH	H
  042A'   CD 1296'              	CALL	CURFP		; A:HL = the cursor's file position
  042D'   EB                    	XCHG
  042E'   E1                    	POP	H
  042F'   73                    	MOV	M,E
  0430'   23                    	INX	H
  0431'   72                    	MOV	M,D
  0432'   23                    	INX	H
  0433'   77                    	MOV	M,A
  0434'   C9                    	RET
                                
                                ;MKSET -- remember where in the FILE the cursor is.
  0435'                         MKSET:
  0435'   CD 0429'              	CALL	FPSTO
  0438'   CD 01E4'              	CALL	MKVAD
  043B'   36 01                 	MVI	M,1		; ... and the mark is live
  043D'   C3 0807'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKSNAP -- keep the marks as they stand, for 'u' (MKREST).  Each copy's spare
                                ;fourth byte takes that mark's live flag.  HL and BC are kept.
  0440'                         MKSNAP:
  0440'   C5                    	PUSH	B
  0441'   E5                    	PUSH	H
  0442'   21 0000*              	LXI	H,MKTAB
  0445'   11 0000*              	LXI	D,MKUND
  0448'   CD 24E2'              	CALL	COPY12
  044B'   21 2E9D'              	LXI	H,MKVAL
  044E'   11 0003*              	LXI	D,MKUND+MKSIZ-1
  0451'   06 03                 	MVI	B,MKMAX
  0453'                         MSN_LP:
  0453'   7E                    	MOV	A,M
  0454'   12                    	STAX	D
  0455'   23                    	INX	H
  0456'   13                    	INX	D
  0457'   13                    	INX	D
  0458'   13                    	INX	D
  0459'   13                    	INX	D
  045A'   05                    	DCR	B
  045B'   C2 0453'              	JNZ	MSN_LP
  045E'   E1                    	POP	H
  045F'   C1                    	POP	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  0460'   C9                    	RET
                                
                                ;MKREST -- a change has been undone: every mark that was set when it began
                                ;goes back where it was then, whether the change ran over it or 'm' has moved
                                ;it since (vim keeps them with the undo too).  One first set AFTER the change
                                ;is left where the replay's own edits carried it.
  0461'                         MKREST:
  0461'   0E 02                 	MVI	C,MKMAX-1
  0463'                         MRS_LP:
  0463'   79                    	MOV	A,C
  0464'   87                    	ADD	A
  0465'   87                    	ADD	A
  0466'   5F                    	MOV	E,A
  0467'   16 00                 	MVI	D,0
  0469'   21 0003*              	LXI	H,MKUND+MKSIZ-1
  046C'   19                    	DAD	D
  046D'   7E                    	MOV	A,M
  046E'   B7                    	ORA	A
  046F'   CA 048B'              	JZ	MRS_NX		; it was not set then
  0472'   2B                    	DCX	H
  0473'   2B                    	DCX	H
  0474'   2B                    	DCX	H
  0475'   E5                    	PUSH	H
  0476'   21 0000*              	LXI	H,MKTAB
  0479'   19                    	DAD	D
  047A'   EB                    	XCHG			; DE -> the mark
  047B'   E1                    	POP	H		; HL -> its copy
  047C'   06 03                 	MVI	B,MKSIZ-1
  047E'                         MRS_CP:
  047E'   7E                    	MOV	A,M
  047F'   12                    	STAX	D
  0480'   23                    	INX	H
  0481'   13                    	INX	D
  0482'   05                    	DCR	B
  0483'   C2 047E'              	JNZ	MRS_CP
  0486'   CD 01E4'              	CALL	MKVAD
  0489'   36 01                 	MVI	M,1
  048B'                         MRS_NX:
  048B'   0D                    	DCR	C
  048C'   F2 0463'              	JP	MRS_LP
  048F'   C9                    	RET
                                
                                ;MKSHFT -- the text is changing: every mark follows its own text.  BUF.MAC's
                                ;UNDCHG calls this through EDTHK from all six edit primitives -- 'u's replay
                                ;of them included -- with A = 1 for an insert (the text is in) or 2 for a
                                ;delete (it is about to go), HL = the edit's logical offset and BC = its
                                ;length.  A mark before the edit stays; one after it moves by the length; one
                                ;INSIDE a delete closes up to where the delete was.  An insert AT a mark
                                ;leaves the mark in front of the new text, unless that text ends a line -- a
                                ;line opened or put above the mark's is above the mark too.
                                ;The edit is found from the CURSOR's file position less its distance behind
                                ;the cursor, never from the offset alone: a put bigger than the window pages
                                ;its own start out, and that offset has then wrapped.  BC is kept.
  0490'                         MKSHFT:
  0490'   32 2EA5'              	STA	MKTYP
  0493'   3A 2EAA'              	LDA	MKHOLD		; a yank that could not copy takes its lines out
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  0496'   B7                    	ORA	A		;   and puts them back unchanged (YKGO): the text
  0497'   C0                    	RNZ			;   every mark points into is still there
  0498'   3A 0000*              	LDA	UNDRPL
  049B'   B7                    	ORA	A
  049C'   C2 04A6'              	JNZ	MKS_GO		; 'u' replaying: not a new change
  049F'   3A 0000*              	LDA	UNDNEW		; the first edit of a new change (UNDCHG calls
  04A2'   B7                    	ORA	A		;   here BEFORE it claims the change): the marks
  04A3'   C4 0440'              	CNZ	MKSNAP		;   as they are now are the ones 'u' puts back
  04A6'                         MKS_GO:
  04A6'   C5                    	PUSH	B
  04A7'   50                    	MOV	D,B
  04A8'   59                    	MOV	E,C
  04A9'   EB                    	XCHG
  04AA'   22 2EA3'              	SHLD	MKN		; the edit's length
  04AD'   D5                    	PUSH	D		; ... and its offset
  04AE'   CD 0000*              	CALL	CUROFF
  04B1'   D1                    	POP	D
  04B2'   CD 0000*              	CALL	SUBHD
  04B5'   EB                    	XCHG			; DE = how far behind the cursor it is
  04B6'   CD 1296'              	CALL	CURFP		; A:HL = the cursor's file position
  04B9'   06 00                 	MVI	B,0
  04BB'   CD 128C'              	CALL	SUB24
  04BE'   22 2EA0'              	SHLD	MKEDIT
  04C1'   32 2EA2'              	STA	MKEDIT+2	; where in the file the edit is
  04C4'   21 2E9D'              	LXI	H,MKVAL
  04C7'   11 0000*              	LXI	D,MKTAB
  04CA'   06 03                 	MVI	B,MKMAX
  04CC'                         MKS_LP:
  04CC'   7E                    	MOV	A,M
  04CD'   B7                    	ORA	A
  04CE'   CA 053A'              	JZ	MKS_N0		; that mark is not set
  04D1'   E5                    	PUSH	H
  04D2'   C5                    	PUSH	B
  04D3'   21 2EA0'              	LXI	H,MKEDIT
  04D6'   1A                    	LDAX	D		; the mark's position less the edit's, a byte
  04D7'   96                    	SUB	M		;   at a time (neither INX nor LDAX touch CY)
  04D8'   4F                    	MOV	C,A
  04D9'   13                    	INX	D
  04DA'   23                    	INX	H
  04DB'   1A                    	LDAX	D
  04DC'   9E                    	SBB	M
  04DD'   47                    	MOV	B,A
  04DE'   13                    	INX	D
  04DF'   23                    	INX	H
  04E0'   1A                    	LDAX	D
  04E1'   9E                    	SBB	M		; A:BC = how far past the edit the mark is
  04E2'   DA 0535'              	JC	MKS_PP		; before it: nothing moves
  04E5'   6F                    	MOV	L,A
  04E6'   3A 2EA5'              	LDA	MKTYP
  04E9'   3D                    	DCR	A
  04EA'   CA 050F'              	JZ	MKS_IN
                                	;--- a delete: back by its length, or to it if the mark is inside ---
  04ED'   7D                    	MOV	A,L
  04EE'   2A 2EA3'              	LHLD	MKN
  04F1'   B7                    	ORA	A
  04F2'   C2 04FE'              	JNZ	MKS_DL		; 64K or more past it
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04F5'   79                    	MOV	A,C
  04F6'   95                    	SUB	L
  04F7'   78                    	MOV	A,B
  04F8'   9C                    	SBB	H
  04F9'   D2 04FE'              	JNC	MKS_DL		; past the end of what goes
  04FC'   60                    	MOV	H,B
  04FD'   69                    	MOV	L,C		; inside it: close up to the edit
  04FE'                         MKS_DL:
  04FE'   1B                    	DCX	D
  04FF'   1B                    	DCX	D
  0500'   1A                    	LDAX	D
  0501'   95                    	SUB	L
  0502'   12                    	STAX	D
  0503'   13                    	INX	D
  0504'   1A                    	LDAX	D
  0505'   9C                    	SBB	H
  0506'   12                    	STAX	D
  0507'   13                    	INX	D
  0508'   1A                    	LDAX	D
  0509'   DE 00                 	SBI	0
  050B'   12                    	STAX	D
  050C'   C3 0535'              	JMP	MKS_PP
                                	;--- an insert: on by its length ---
  050F'                         MKS_IN:
  050F'   7D                    	MOV	A,L
  0510'   B0                    	ORA	B
  0511'   B1                    	ORA	C
  0512'   C2 0524'              	JNZ	MKS_AD		; the mark is past it
  0515'   2A 0000*              	LHLD	GAPBEG		; AT the mark: only a line end carries it on
  0518'   2B                    	DCX	H
  0519'   7E                    	MOV	A,M		; the last byte that went in
  051A'   FE 0A                 	CPI	LF
  051C'   CA 0524'              	JZ	MKS_AD
  051F'   FE 0D                 	CPI	CR
  0521'   C2 0535'              	JNZ	MKS_PP
  0524'                         MKS_AD:
  0524'   2A 2EA3'              	LHLD	MKN
  0527'   1B                    	DCX	D
  0528'   1B                    	DCX	D
  0529'   1A                    	LDAX	D
  052A'   85                    	ADD	L
  052B'   12                    	STAX	D
  052C'   13                    	INX	D
  052D'   1A                    	LDAX	D
  052E'   8C                    	ADC	H
  052F'   12                    	STAX	D
  0530'   13                    	INX	D
  0531'   1A                    	LDAX	D
  0532'   CE 00                 	ACI	0
  0534'   12                    	STAX	D
  0535'                         MKS_PP:
  0535'   C1                    	POP	B
  0536'   E1                    	POP	H
  0537'   C3 053C'              	JMP	MKS_NX
  053A'                         MKS_N0:
  053A'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  053B'   13                    	INX	D
  053C'                         MKS_NX:
  053C'   13                    	INX	D
  053D'   13                    	INX	D
  053E'   23                    	INX	H
  053F'   05                    	DCR	B
  0540'   C2 04CC'              	JNZ	MKS_LP
  0543'   C1                    	POP	B
  0544'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  0545'                         VC_UNDO:
  0545'   21 0000               	LXI	H,0
  0548'   22 2E03'              	SHLD	CMDCNT
  054B'   CD 0000*              	CALL	UNDO
  054E'   DA 0587'              	JC	UNDNO
  0551'   3A 0000*              	LDA	UNDST
  0554'   FE 02                 	CPI	2
  0556'   CC 0461'              	CZ	MKREST		; undone (not redone): the marks go back too
  0559'   2A 0000*              	LHLD	UNDCUR
  055C'   CD 056D'              	CALL	UCLAMP		; vi never sits on a line terminator
  055F'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0562'   3E 01                 	MVI	A,1
  0564'   32 2E06'              	STA	MODF		; undone past a ':w' still differs from the file
  0567'   CD 09B2'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  056A'   C3 0844'              	JMP	SETFUL		; whole spans moved: repaint rather than guess
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  056D'                         UCLAMP:
  056D'   E5                    	PUSH	H
  056E'   CD 18C0'              	CALL	CEND		; HL = the line's content end
  0571'   D1                    	POP	D		; DE = the offset wanted
  0572'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  0575'   D2 057A'              	JNC	UCL_BK
  0578'   EB                    	XCHG
  0579'   C9                    	RET
  057A'                         UCL_BK:
  057A'   E5                    	PUSH	H		; the content end
  057B'   EB                    	XCHG			; HL = the offset wanted
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  057C'   CD 0624'              	CALL	BOL
  057F'   D1                    	POP	D		; DE = the content end, HL = the line's start
  0580'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  0583'   EB                    	XCHG			; HL = the content end
  0584'   C8                    	RZ
  0585'   2B                    	DCX	H		; ... its last character
  0586'   C9                    	RET
  0587'                         UNDNO:
  0587'   3A 0000*              	LDA	UNDWHY
  058A'   B7                    	ORA	A
  058B'   CA 059C'              	JZ	UNDBEL
  058E'   21 2794'              	LXI	H,SUNDW		; the change has paged away: say so
  0591'   FE 01                 	CPI	1
  0593'   CA 26BF'              	JZ	EXERR
  0596'   21 27B6'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  0599'   C3 26BF'              	JMP	EXERR
  059C'                         UNDBEL:
  059C'   0E 07                 	MVI	C,BEL
  059E'   CD 0000*              	CALL	BCONOU
  05A1'   C3 0807'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  05A4'                         DOTGET:
  05A4'   3A 2E34'              	LDA	DOTIX
  05A7'   5F                    	MOV	E,A
  05A8'   3A 2E33'              	LDA	DOTLEN
  05AB'   BB                    	CMP	E
  05AC'   CA 05B8'              	JZ	DOTGEF
  05AF'   16 00                 	MVI	D,0
  05B1'   21 0000*              	LXI	H,DOTBUF
  05B4'   19                    	DAD	D
  05B5'   7E                    	MOV	A,M
  05B6'   B7                    	ORA	A		; CY clear: a key was returned
  05B7'   C9                    	RET
  05B8'                         DOTGEF:
  05B8'   37                    	STC
  05B9'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
  05BA'                         GOSET:
  05BA'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  05BD'                         SETGL:
  05BD'   CD 12B9'              	CALL	ZSAVE
  05C0'   21 0000               	LXI	H,0
  05C3'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  05C6'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  05C7'   CD 12CC'              	CALL	ZREST
  05CA'   E1                    	POP	H
  05CB'   E5                    	PUSH	H
  05CC'   CD 072B'              	CALL	GBSUB		; HL = bytes to the cursor
  05CF'   44                    	MOV	B,H
  05D0'   4D                    	MOV	C,L
  05D1'   E1                    	POP	H		; HL = the line's start
  05D2'   11 0000               	LXI	D,0		; DE = screen column
  05D5'                         SG_LP:
  05D5'   78                    	MOV	A,B
  05D6'   B1                    	ORA	C
  05D7'   CA 05EC'              	JZ	SG_CUR
  05DA'   7E                    	MOV	A,M
  05DB'   23                    	INX	H
  05DC'   0B                    	DCX	B
  05DD'   E5                    	PUSH	H
  05DE'   6B                    	MOV	L,E
  05DF'   CD 0611'              	CALL	CWID
  05E2'   E1                    	POP	H
  05E3'   83                    	ADD	E
  05E4'   5F                    	MOV	E,A
  05E5'   D2 05D5'              	JNC	SG_LP
  05E8'   14                    	INR	D
  05E9'   C3 05D5'              	JMP	SG_LP
  05EC'                         SG_CUR:
  05EC'   2A 0000*              	LHLD	TXTEND
  05EF'   D5                    	PUSH	D
  05F0'   EB                    	XCHG
  05F1'   2A 0000*              	LHLD	GAPEND
  05F4'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  05F7'   D1                    	POP	D
  05F8'   CA 060C'              	JZ	SG_SET
  05FB'   7E                    	MOV	A,M
  05FC'   FE 09                 	CPI	TAB
  05FE'   C2 060C'              	JNZ	SG_SET
  0601'   6B                    	MOV	L,E
  0602'   CD 0611'              	CALL	CWID
  0605'   3D                    	DCR	A		; the TAB's last column
  0606'   83                    	ADD	E
  0607'   5F                    	MOV	E,A
  0608'   D2 060C'              	JNC	SG_SET
  060B'   14                    	INR	D
  060C'                         SG_SET:
  060C'   EB                    	XCHG
  060D'   22 2E0D'              	SHLD	GOALCOL
  0610'   C9                    	RET
                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  0611'                         CWID:
  0611'   FE 0D                 	CPI	CR
  0613'   CA 0622'              	JZ	CW_0
  0616'   FE 09                 	CPI	TAB
  0618'   3E 01                 	MVI	A,1
  061A'   C0                    	RNZ
  061B'   7D                    	MOV	A,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  061C'   E6 07                 	ANI	TABWID-1
  061E'   2F                    	CMA
  061F'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  0621'   C9                    	RET
  0622'                         CW_0:
  0622'   AF                    	XRA	A
  0623'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
                                ; The text is read where it lies, either side of the gap; keeps BC.
  0624'                         BOL:
  0624'   C5                    	PUSH	B
  0625'   E5                    	PUSH	H
  0626'   CD 0000*              	CALL	CUROFF
  0629'   D1                    	POP	D		; DE = off, HL = the bytes before the gap
  062A'   CD 0000*              	CALL	CMP16
  062D'   DA 0650'              	JC	BOL_B
  0630'   CA 0650'              	JZ	BOL_B
  0633'   D5                    	PUSH	D
  0634'   EB                    	XCHG
  0635'   CD 0000*              	CALL	SUBHD
  0638'   44                    	MOV	B,H
  0639'   4D                    	MOV	C,L		; BC = how far past the gap it is
  063A'   2A 0000*              	LHLD	GAPEND
  063D'   09                    	DAD	B
  063E'   D1                    	POP	D
  063F'                         BOL_A:
  063F'   78                    	MOV	A,B
  0640'   B1                    	ORA	C
  0641'   CA 0650'              	JZ	BOL_B		; back at the gap: the rest is before it
  0644'   2B                    	DCX	H
  0645'   7E                    	MOV	A,M
  0646'   FE 0A                 	CPI	LF
  0648'   CA 0664'              	JZ	BOL_X
  064B'   1B                    	DCX	D
  064C'   0B                    	DCX	B
  064D'   C3 063F'              	JMP	BOL_A
  0650'                         BOL_B:
  0650'   2A 0000*              	LHLD	TXTBEG
  0653'   19                    	DAD	D
  0654'                         BOL_C:
  0654'   7A                    	MOV	A,D
  0655'   B3                    	ORA	E
  0656'   CA 0664'              	JZ	BOL_X		; at 0
  0659'   2B                    	DCX	H
  065A'   7E                    	MOV	A,M
  065B'   FE 0A                 	CPI	LF
  065D'   CA 0664'              	JZ	BOL_X
  0660'   1B                    	DCX	D
  0661'   C3 0654'              	JMP	BOL_C
  0664'                         BOL_X:
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  0664'   EB                    	XCHG
  0665'   C1                    	POP	B
  0666'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
                                ; Read the same way; keeps BC.
  0667'                         EOLNL:
  0667'   C5                    	PUSH	B
  0668'   E5                    	PUSH	H
  0669'   CD 0000*              	CALL	CUROFF
  066C'   D1                    	POP	D		; DE = off, HL = the bytes before the gap
  066D'   CD 0000*              	CALL	CMP16
  0670'   D2 068E'              	JNC	ENL_A
  0673'   2A 0000*              	LHLD	GAPBEG
  0676'   44                    	MOV	B,H
  0677'   4D                    	MOV	C,L
  0678'   2A 0000*              	LHLD	TXTBEG
  067B'   19                    	DAD	D
  067C'                         ENL_B:
  067C'   7D                    	MOV	A,L
  067D'   91                    	SUB	C
  067E'   7C                    	MOV	A,H
  067F'   98                    	SBB	B
  0680'   D2 069C'              	JNC	ENL_G		; at the gap: on from its far side
  0683'   7E                    	MOV	A,M
  0684'   FE 0A                 	CPI	LF
  0686'   CA 06B8'              	JZ	ENL_X
  0689'   23                    	INX	H
  068A'   13                    	INX	D
  068B'   C3 067C'              	JMP	ENL_B
  068E'                         ENL_A:
  068E'   D5                    	PUSH	D
  068F'   EB                    	XCHG
  0690'   CD 0000*              	CALL	SUBHD
  0693'   EB                    	XCHG			; DE = how far past the gap it is
  0694'   2A 0000*              	LHLD	GAPEND
  0697'   19                    	DAD	D
  0698'   D1                    	POP	D
  0699'   C3 069F'              	JMP	ENL_S
  069C'                         ENL_G:
  069C'   2A 0000*              	LHLD	GAPEND
  069F'                         ENL_S:
  069F'   E5                    	PUSH	H
  06A0'   2A 0000*              	LHLD	TXTEND
  06A3'   44                    	MOV	B,H
  06A4'   4D                    	MOV	C,L
  06A5'   E1                    	POP	H
  06A6'                         ENL_C:
  06A6'   7D                    	MOV	A,L
  06A7'   91                    	SUB	C
  06A8'   7C                    	MOV	A,H
  06A9'   98                    	SBB	B
  06AA'   D2 06B8'              	JNC	ENL_X		; the end of the text
  06AD'   7E                    	MOV	A,M
  06AE'   FE 0A                 	CPI	LF
  06B0'   CA 06B8'              	JZ	ENL_X
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06B3'   23                    	INX	H
  06B4'   13                    	INX	D
  06B5'   C3 06A6'              	JMP	ENL_C
  06B8'                         ENL_X:
  06B8'   EB                    	XCHG
  06B9'   C1                    	POP	B
  06BA'   C9                    	RET
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  06BB'                         NLSTART:
  06BB'   CD 0667'              	CALL	EOLNL
  06BE'   E5                    	PUSH	H
  06BF'   CD 0000*              	CALL	LOGLEN
  06C2'   D1                    	POP	D		; DE = eol result
  06C3'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  06C6'   C8                    	RZ			; no next line: HL = LOGLEN
  06C7'   EB                    	XCHG			; HL = eol
  06C8'   23                    	INX	H
  06C9'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  06CA'                         EOLC:
  06CA'   E5                    	PUSH	H
  06CB'   CD 0667'              	CALL	EOLNL
  06CE'   22 2E58'              	SHLD	WKTERM
  06D1'   E1                    	POP	H
  06D2'   CD 0624'              	CALL	BOL
  06D5'   22 2E5A'              	SHLD	WKBOL
  06D8'   2A 2E58'              	LHLD	WKTERM
  06DB'   EB                    	XCHG			; DE = term
  06DC'   2A 2E5A'              	LHLD	WKBOL
  06DF'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  06E2'   CA 0701'              	JZ	EOLC_MT
  06E5'   EB                    	XCHG			; HL = term
  06E6'   2B                    	DCX	H		; term-1
  06E7'   E5                    	PUSH	H
  06E8'   CD 0000*              	CALL	CHARAT
  06EB'   E1                    	POP	H		; HL = term-1
  06EC'   FE 0D                 	CPI	CR
  06EE'   CA 06F4'              	JZ	EOLC_CR		; content ends at term-1
  06F1'   C3 06F5'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  06F4'                         EOLC_CR:
  06F4'   2B                    	DCX	H		; last = (term-1) - 1
  06F5'                         EOLC_LS:
  06F5'   EB                    	XCHG			; DE = last
  06F6'   2A 2E5A'              	LHLD	WKBOL
  06F9'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  06FC'   DA 0701'              	JC	EOLC_MT
  06FF'   EB                    	XCHG			; HL = last
  0700'   C9                    	RET
  0701'                         EOLC_MT:
  0701'   2A 2E5A'              	LHLD	WKBOL
  0704'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  0705'                         COL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  0705'   E5                    	PUSH	H
  0706'   CD 0624'              	CALL	BOL
  0709'   D1                    	POP	D		; DE = off
  070A'   EB                    	XCHG			; HL = off, DE = bol
  070B'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  070E'                         ATENDQ:
  070E'   CD 0000*              	CALL	CUROFF
  0711'   E5                    	PUSH	H
  0712'   CD 0000*              	CALL	LOGLEN
  0715'   D1                    	POP	D		; DE = cur
  0716'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0719'                         CURCHR:
  0719'   CD 0000*              	CALL	CUROFF
  071C'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  071F'                         MOVCNT:
  071F'   CD 0807'              	CALL	SETMOV
  0722'   C3 0732'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  0725'                         CNTOFF:
  0725'   CD 0732'              	CALL	GETCNT
  0728'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  072B'                         GBSUB:
  072B'   EB                    	XCHG
  072C'   2A 0000*              	LHLD	GAPBEG
  072F'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  0732'                         GETCNT:
  0732'   2A 2E03'              	LHLD	CMDCNT
  0735'   7C                    	MOV	A,H
  0736'   B5                    	ORA	L
  0737'   C2 073E'              	JNZ	GC_HAVE
  073A'   21 0001               	LXI	H,1
  073D'   C9                    	RET
  073E'                         GC_HAVE:
  073E'   E5                    	PUSH	H
  073F'   21 0000               	LXI	H,0
  0742'   22 2E03'              	SHLD	CMDCNT
  0745'   E1                    	POP	H
  0746'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for an ESC break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


                                ;PUSH/POP PSW), so the caller sees the count's Z.
  0747'                         CNTTST:				; WM 1175
  0747'   3A 2EC1'              	LDA	BRKARM
  074A'   B7                    	ORA	A
  074B'   C4 0775'              	CNZ	BRKTST		; an ESC spends the count: every loop stops here
  074E'   E5                    	PUSH	H
  074F'   2A 2E03'              	LHLD	CMDCNT
  0752'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  0755'   B4                    	ORA	H
  0756'   B5                    	ORA	L
  0757'   E1                    	POP	H
  0758'   C3 0000*              	JMP	POLLBRK
                                
                                ;============================================================
                                ; ESC -- abandon a search or a long move.
                                ;
                                ; Every loop that pages asks CNTTST whether to go on, so that is where an ESC is
                                ; looked for: it zeroes the count, and the loop ends the way it ends when the
                                ; count runs out.  Nothing is half done, because the commands that can be
                                ; stopped change nothing -- BRKON arms the test only with no operator pending,
                                ; and only 'G' 'gg' the mark jumps and the searches call it.  A 'dd' count, a
                                ; ':s', a put or a write asks the same CNTTST and is never stopped.
                                ;
                                ; The command then goes back to where it started (BRKBAK), as a search that
                                ; found nothing does: the screen was not repainted, so it is already right.
                                ; Going back pages, and that is not stopped by a second ESC.
                                ;============================================================
                                
                                ;BRKON -- a command that may page a long way is starting: keep the place it
                                ; started from (the cursor's position in the file, and LNDLT for its row), and
                                ; arm the ESC test unless an operator is waiting for this motion.
  075B'                         BRKON:
  075B'   21 2EBC'              	LXI	H,SOFF
  075E'   CD 0429'              	CALL	FPSTO
  0761'   2A 0000*              	LHLD	LNDLT
  0764'   22 2EBF'              	SHLD	SLDLT
  0767'   AF                    	XRA	A
  0768'   32 2EC2'              	STA	BRKHIT
  076B'   3A 2E3A'              	LDA	PSAVE
  076E'   B7                    	ORA	A
  076F'   C0                    	RNZ			; 'dG' changes text: it runs to its end
  0770'   3C                    	INR	A
  0771'   32 2EC1'              	STA	BRKARM
  0774'   C9                    	RET
                                
                                ;BRKTST -- CNTTST's question while armed.  Keeps BC, DE, HL.  The ESC is
                                ; answered on the bottom row at once: the way back pages, and that can take
                                ; as long again as the command had run, with nothing else to show for it.
                                ; BRKBAK's 'Interrupted' replaces it when the cursor is back.
  0775'                         BRKTST:
  0775'   C5                    	PUSH	B
  0776'   D5                    	PUSH	D
  0777'   E5                    	PUSH	H
  0778'   CD 0000*              	CALL	KBBRK
  077B'   CA 0794'              	JZ	BT_NO
  077E'   32 2EC2'              	STA	BRKHIT		; (A = FFH)
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  0781'   21 2769'              	LXI	H,SINTG
  0784'   CD 0000*              	CALL	EXMSG
  0787'   AF                    	XRA	A
  0788'   32 2EC1'              	STA	BRKARM		; the way back is not stopped in its turn
  078B'   32 0000*              	STA	AUXCNT
  078E'   21 0000               	LXI	H,0
  0791'   22 2E03'              	SHLD	CMDCNT
  0794'                         BT_NO:
  0794'   E1                    	POP	H
  0795'   D1                    	POP	D
  0796'   C1                    	POP	B
  0797'   C9                    	RET
                                
                                ;BRKOFF -- the move is over: disarm.  NOTE: falls into BRKQ.
  0798'                         BRKOFF:
  0798'   AF                    	XRA	A
  0799'   32 2EC1'              	STA	BRKARM
                                ;BRKQ -- CY iff an ESC stopped it.
  079C'                         BRKQ:
  079C'   3A 2EC2'              	LDA	BRKHIT
  079F'   B7                    	ORA	A
  07A0'   C8                    	RZ
  07A1'   37                    	STC
  07A2'   C9                    	RET
                                
                                ;RSTPL -- back to the place BRKON kept, on the row it was on.
  07A3'                         RSTPL:
  07A3'   21 2EBC'              	LXI	H,SOFF
  07A6'   CD 03D0'              	CALL	BACKTO
  07A9'   2A 2EBF'              	LHLD	SLDLT
  07AC'   22 0000*              	SHLD	LNDLT
  07AF'   C9                    	RET
                                
                                ;BRKBAK -- stopped: back to the start, drop whatever was typed meanwhile (it
                                ; was meant for a result that is not coming), and say so.  CY, as EXERR.
  07B0'                         BRKBAK:
  07B0'   CD 07A3'              	CALL	RSTPL
  07B3'   CD 0000*              	CALL	KBFLSH
  07B6'   21 275D'              	LXI	H,SINTR
  07B9'   C3 26BF'              	JMP	EXERR
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  07BC'                         CLASSF:
  07BC'   47                    	MOV	B,A
  07BD'   FE 20                 	CPI	' '
  07BF'   CA 07FF'              	JZ	CLS0
  07C2'   FE 09                 	CPI	TAB
  07C4'   CA 07FF'              	JZ	CLS0
  07C7'   FE 0A                 	CPI	LF
  07C9'   CA 07FF'              	JZ	CLS0
  07CC'   FE 0D                 	CPI	CR
  07CE'   CA 07FF'              	JZ	CLS0
  07D1'   3A 2E0F'              	LDA	WBIG
  07D4'   B7                    	ORA	A
  07D5'   C2 0801'              	JNZ	CLS1
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07D8'   78                    	MOV	A,B
  07D9'   FE 5F                 	CPI	'_'
  07DB'   CA 0801'              	JZ	CLS1
  07DE'   FE 30                 	CPI	'0'
  07E0'   DA 0804'              	JC	CLS2
  07E3'   FE 3A                 	CPI	'9'+1
  07E5'   DA 0801'              	JC	CLS1
  07E8'   FE 41                 	CPI	'A'
  07EA'   DA 0804'              	JC	CLS2
  07ED'   FE 5B                 	CPI	'Z'+1
  07EF'   DA 0801'              	JC	CLS1
  07F2'   FE 61                 	CPI	'a'
  07F4'   DA 0804'              	JC	CLS2
  07F7'   FE 7B                 	CPI	'z'+1
  07F9'   DA 0801'              	JC	CLS1
  07FC'   C3 0804'              	JMP	CLS2
  07FF'   AF                    CLS0:	XRA	A
  0800'   C9                    	RET
  0801'   3E 01                 CLS1:	MVI	A,1
  0803'   C9                    	RET
  0804'   3E 02                 CLS2:	MVI	A,2
  0806'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  0807'                         SETMOV:
  0807'   3E 01                 	MVI	A,R_MOVE
  0809'   32 2E07'              	STA	RINTENT
  080C'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  080D'                         SETLIN:
  080D'   3E 02                 	MVI	A,R_LINE
  080F'   32 2E07'              	STA	RINTENT
  0812'   C9                    	RET
                                
                                ;SETCEL -- one cell of the cursor's row was written over and nothing else
                                ; changed: the char alone is the paint (R_ICH with no cell opened), provided
                                ; the char that was there (A) and the one that is (VRCH) are each one cell
                                ; wide.  B = ICHAPP's value: 1 the cursor went past the char, 2 it is on it.
  0813'                         SETCEL:
  0813'   CD 0828'              	CALL	PLAINQ
  0816'   D0                    	RNC
  0817'   3A 2E5D'              	LDA	VRCH
  081A'   CD 0828'              	CALL	PLAINQ
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  081D'   D0                    	RNC
  081E'   78                    	MOV	A,B
  081F'   32 2E09'              	STA	ICHAPP
  0822'   3E 04                 	MVI	A,R_ICH
  0824'   32 2E07'              	STA	RINTENT
  0827'   C9                    	RET
                                
                                ;PLAINQ -- CY iff the char in A takes one cell: printable ASCII.  Keeps all
                                ; but the flags.
  0828'                         PLAINQ:
  0828'   FE 20                 	CPI	' '
  082A'   3F                    	CMC
  082B'   D0                    	RNC
  082C'   FE 7F                 	CPI	DEL
  082E'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  082F'                         SETILN:
  082F'   3E 01                 	MVI	A,1
  0831'   32 2E08'              	STA	ILN		; one line, unless a put overwrites it below
  0834'   3E 05                 	MVI	A,R_ILIN
  0836'   32 2E07'              	STA	RINTENT
  0839'   AF                    	XRA	A
  083A'   32 2E0C'              	STA	ILABOV		; the row above the opened ones is untouched
  083D'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  083E'                         SETJON:
  083E'   3E 06                 	MVI	A,R_JOIN
  0840'   32 2E07'              	STA	RINTENT
  0843'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  0844'                         SETFUL:
  0844'   3E 00                 	MVI	A,R_FULL
  0846'   32 2E07'              	STA	RINTENT
  0849'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB (or any control char) occurs from the cursor to the
                                ; end of its line, else 0; TTI = its offset when there is one.
                                ; The tail is read where it lies, after the gap.  Keeps BC.
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  084A'                         TAILTAB:
  084A'   C5                    	PUSH	B
  084B'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  084E'   E5                    	PUSH	H
  084F'   2A 0000*              	LHLD	TXTEND
  0852'   44                    	MOV	B,H
  0853'   4D                    	MOV	C,L
  0854'   2A 0000*              	LHLD	GAPEND
  0857'   D1                    	POP	D		; DE = the offset of the byte at HL
  0858'                         TT_LP:
  0858'   7D                    	MOV	A,L
  0859'   91                    	SUB	C
  085A'   7C                    	MOV	A,H
  085B'   98                    	SBB	B
  085C'   D2 087C'              	JNC	TT_NO		; reached end of text -> no tab
  085F'   7E                    	MOV	A,M
  0860'   FE 0A                 	CPI	LF
  0862'   CA 087C'              	JZ	TT_NO		; end of line -> no tab
  0865'   FE 0D                 	CPI	CR
  0867'   CA 086F'              	JZ	TT_NX		; (the line end's own)
  086A'   FE 20                 	CPI	' '
  086C'   DA 0874'              	JC	TT_YES
  086F'                         TT_NX:
  086F'   23                    	INX	H
  0870'   13                    	INX	D
  0871'   C3 0858'              	JMP	TT_LP
  0874'                         TT_YES:
  0874'   EB                    	XCHG
  0875'   22 2E54'              	SHLD	TTI
  0878'   C1                    	POP	B
  0879'   3E 01                 	MVI	A,1
  087B'   C9                    	RET
  087C'                         TT_NO:
  087C'   C1                    	POP	B
  087D'   AF                    	XRA	A
  087E'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  087F'                         VC_H:
  087F'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  0882'   22 2E52'              	SHLD	CNTV
  0885'                         VCH_LP:
  0885'   2A 2E52'              	LHLD	CNTV
  0888'   7C                    	MOV	A,H
  0889'   B5                    	ORA	L
  088A'   C8                    	RZ
  088B'   2B                    	DCX	H
  088C'   22 2E52'              	SHLD	CNTV
  088F'   CD 0895'              	CALL	HSTEP
  0892'   C3 0885'              	JMP	VCH_LP
  0895'                         HSTEP:
  0895'   CD 0000*              	CALL	CUROFF		; HL = cur
  0898'   7C                    	MOV	A,H
  0899'   B5                    	ORA	L
  089A'   C8                    	RZ			; at 0
  089B'   E5                    	PUSH	H
  089C'   CD 0624'              	CALL	BOL		; HL = bol
  089F'   D1                    	POP	D		; DE = cur
  08A0'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  08A3'   C8                    	RZ			; at BOL, cannot go left
  08A4'   EB                    	XCHG			; HL = cur
  08A5'   2B                    	DCX	H
  08A6'   C3 05BA'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  08A9'                         VC_L:
  08A9'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  08AC'   22 2E52'              	SHLD	CNTV
  08AF'                         VCL_LP:
  08AF'   2A 2E52'              	LHLD	CNTV
  08B2'   7C                    	MOV	A,H
  08B3'   B5                    	ORA	L
  08B4'   C8                    	RZ
  08B5'   2B                    	DCX	H
  08B6'   22 2E52'              	SHLD	CNTV
  08B9'   CD 08BF'              	CALL	LSTEP
  08BC'   C3 08AF'              	JMP	VCL_LP
  08BF'                         LSTEP:
  08BF'   CD 0000*              	CALL	CUROFF		; HL = cur
  08C2'   E5                    	PUSH	H
  08C3'   CD 06CA'              	CALL	EOLC		; HL = eolc
  08C6'   D1                    	POP	D		; DE = cur
  08C7'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  08CA'   D2 08D2'              	JNC	LS_NO		; cur >= eolc, cannot go right
  08CD'   EB                    	XCHG			; HL = cur
  08CE'   23                    	INX	H
  08CF'   C3 05BA'              	JMP	GOSET
  08D2'                         LS_NO:				; on the line's last char.  An operator waiting on
  08D2'   CD 0C9E'              	CALL	EMPTY		;   this 'l' takes that char too (vim makes the
  08D5'   C8                    	RZ			;   motion inclusive when it falls short), which
  08D6'   3E 01                 	MVI	A,1		;   is what WPULL tells OPA_EX: 'dl' there is 'x',
  08D8'   32 2E10'              	STA	WPULL		;   and 'd3l' two from the end takes both.  An
  08DB'   C9                    	RET			;   empty line has no char to take
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  08DC'                         VC_0:
  08DC'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  08DF'   CD 08E9'              	CALL	LNSTRT
  08E2'   21 0000               	LXI	H,0
  08E5'   22 2E0D'              	SHLD	GOALCOL
  08E8'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  08E9'                         LNSTRT:
  08E9'   CD 12B9'              	CALL	ZSAVE
  08EC'   21 0000               	LXI	H,0
  08EF'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  08F2'   E5                    	PUSH	H
  08F3'   CD 12CC'              	CALL	ZREST
  08F6'   E1                    	POP	H
  08F7'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  08FA'                         VC_CRT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  08FA'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  08FD'   C3 0900'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  0900'                         FNBLNK:
  0900'   CD 08E9'              	CALL	LNSTRT
  0903'   CD 0000*              	CALL	RGET0
  0906'   11 0000               	LXI	D,0		; DE = blanks skipped
  0909'                         FN_LP:
  0909'   CD 0000*              	CALL	RDGET
  090C'   DA 092F'              	JC	FN_GO		; the end of the file
  090F'   FE 20                 	CPI	' '
  0911'   CA 0919'              	JZ	FN_WH
  0914'   FE 09                 	CPI	TAB
  0916'   C2 092F'              	JNZ	FN_GO		; a non-blank, or the line's end
  0919'                         FN_WH:
  0919'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  091C'   DA 092F'              	JC	FN_GO
  091F'   FE 0D                 	CPI	CR
  0921'   CA 092F'              	JZ	FN_GO
  0924'   FE 0A                 	CPI	LF
  0926'   CA 092F'              	JZ	FN_GO
  0929'   2B                    	DCX	H		; not yet: read that char again
  092A'   03                    	INX	B
  092B'   13                    	INX	D
  092C'   C3 0909'              	JMP	FN_LP
  092F'                         FN_GO:
  092F'   D5                    	PUSH	D
  0930'   CD 0000*              	CALL	CUROFF
  0933'   D1                    	POP	D
  0934'   19                    	DAD	D
  0935'   C3 05BA'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  0938'                         VC_EOL:
  0938'   CD 0807'              	CALL	SETMOV
  093B'   21 FFFF               	LXI	H,0FFFFH
  093E'   22 2E0D'              	SHLD	GOALCOL
  0941'   CD 0732'              	CALL	GETCNT
  0944'   2B                    	DCX	H		; count-1
  0945'   7C                    	MOV	A,H
  0946'   B5                    	ORA	L
  0947'   CA 0956'              	JZ	VEOL_0
  094A'   E5                    	PUSH	H
  094B'   CD 096B'              	CALL	ONLAST
  094E'   E1                    	POP	H
  094F'   D8                    	RC			; the last line: no move (vim)
  0950'   CD 09BB'              	CALL	JCORE
  0953'   C3 0B0A'              	JMP	JKLAND
  0956'                         VEOL_0:
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0956'   CD 08E9'              	CALL	LNSTRT
  0959'   C3 0B0A'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  095C'                         VC_CR:
  095C'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  095F'   E5                    	PUSH	H
  0960'   CD 096B'              	CALL	ONLAST
  0963'   E1                    	POP	H
  0964'   D8                    	RC
  0965'   CD 09BB'              	CALL	JCORE
  0968'   C3 0900'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  096B'                         ONLAST:
  096B'   CD 0000*              	CALL	RGET0
  096E'                         OL_LP:
  096E'   CD 0000*              	CALL	RDGET
  0971'   D8                    	RC			; the file ends on this line
  0972'   FE 0A                 	CPI	LF
  0974'   C2 096E'              	JNZ	OL_LP
  0977'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  097A'                         VC_J:
  097A'   CD 0807'              	CALL	SETMOV
  097D'   CD 09A5'              	CALL	GLCHK		; the goal column, from the cursor if stale
  0980'   CD 0732'              	CALL	GETCNT		; HL = count
  0983'   CD 09BB'              	CALL	JCORE
  0986'   CD 099E'              	CALL	JKDRP
  0989'   C3 0B0A'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  098C'                         VC_K:
  098C'   CD 0807'              	CALL	SETMOV
  098F'   CD 09A5'              	CALL	GLCHK
  0992'   CD 0732'              	CALL	GETCNT
  0995'   CD 0A58'              	CALL	KCORE
  0998'   CD 099E'              	CALL	JKDRP
  099B'   C3 0B0A'              	JMP	JKLAND
                                
                                ;JKDRP -- DE = the lines JCORE / KCORE moved.  None -- 'j' on the last line,
                                ; 'k' on the first -- and the motion has failed: an operator waiting on it is
                                ; dropped, as vim drops it, where a line span that starts and ends on one line
                                ; would take that line ('dj' on the last line deleted it).  A count that runs
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


                                ; out of lines short has still moved, and its operator stands.  It is asked
                                ; here and not in the cores: 'dH' on the top row moves no lines either, and
                                ; takes its line.
  099E'                         JKDRP:
  099E'   7A                    	MOV	A,D
  099F'   B3                    	ORA	E
  09A0'   C0                    	RNZ
  09A1'   32 2E3A'              	STA	PSAVE
  09A4'   C9                    	RET
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  09A5'                         GLCHK:
  09A5'   2A 2E0D'              	LHLD	GOALCOL
  09A8'   7C                    	MOV	A,H
  09A9'   3C                    	INR	A
  09AA'   C0                    	RNZ
  09AB'   7D                    	MOV	A,L
  09AC'   FE FE                 	CPI	0FEH
  09AE'   C0                    	RNZ
  09AF'   C3 05BD'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  09B2'                         GLSTAL:
  09B2'   E5                    	PUSH	H
  09B3'   21 FFFE               	LXI	H,0FFFEH
  09B6'   22 2E0D'              	SHLD	GOALCOL
  09B9'   E1                    	POP	H
  09BA'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  09BB'                         JCORE:
  09BB'   7C                    	MOV	A,H
  09BC'   B5                    	ORA	L
  09BD'   C8                    	RZ
  09BE'   22 2E1E'              	SHLD	JKCNT
  09C1'   CD 0DCD'              	CALL	CURRW		; limit = lines under the cursor's + NEDIT + 2:
  09C4'   47                    	MOV	B,A		;   enough for LYFAR to know it for far off
  09C5'   3A 0000*              	LDA	NEDIT
  09C8'   3C                    	INR	A
  09C9'   90                    	SUB	B
  09CA'   5F                    	MOV	E,A
  09CB'   16 00                 	MVI	D,0
  09CD'   3A 0000*              	LDA	NEDIT
  09D0'   6F                    	MOV	L,A
  09D1'   26 00                 	MVI	H,0
  09D3'   19                    	DAD	D
  09D4'   EB                    	XCHG			; DE = limit
  09D5'   2A 2E1E'              	LHLD	JKCNT
  09D8'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  09DB'   D2 09DF'              	JNC	JC_N
  09DE'   EB                    	XCHG			; HL = limit
  09DF'                         JC_N:
  09DF'   22 2E20'              	SHLD	JKN		; N = min(count, limit)
  09E2'   EB                    	XCHG			; DE = LFs to find
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  09E3'   CD 0000*              	CALL	RGET0
  09E6'                         JC_SC:
  09E6'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  09E9'   DA 0A08'              	JC	JC_EOF
  09EC'   32 2E27'              	STA	JKLST
  09EF'   FE 0A                 	CPI	LF
  09F1'   C2 09E6'              	JNZ	JC_SC
  09F4'   1B                    	DCX	D
  09F5'   7A                    	MOV	A,D
  09F6'   B3                    	ORA	E
  09F7'   C2 09E6'              	JNZ	JC_SC
  09FA'   2A 2E1E'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  09FD'   22 2E22'              	SHLD	JKMOV		;   one if the last LF found ends the file
  0A00'   3E 01                 	MVI	A,1
  0A02'   32 2E26'              	STA	JKPHN
  0A05'   C3 0A23'              	JMP	JC_MV
  0A08'                         JC_EOF:
  0A08'   2A 2E20'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  0A0B'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  0A0E'   7C                    	MOV	A,H
  0A0F'   B5                    	ORA	L
  0A10'   CA 0A1C'              	JZ	JC_AV
  0A13'   3A 2E27'              	LDA	JKLST
  0A16'   FE 0A                 	CPI	LF
  0A18'   C2 0A1C'              	JNZ	JC_AV
  0A1B'   2B                    	DCX	H
  0A1C'                         JC_AV:
  0A1C'   22 2E22'              	SHLD	JKMOV
  0A1F'   AF                    	XRA	A
  0A20'   32 2E26'              	STA	JKPHN
  0A23'                         JC_MV:
  0A23'   2A 2E1E'              	LHLD	JKCNT
  0A26'   AF                    	XRA	A
  0A27'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  0A2A'   CD 0AE9'              	CALL	ATEOF
  0A2D'   D2 0A41'              	JNC	JC_DN
  0A30'   CD 0AEF'              	CALL	LASTLN		; ran past the last line: back onto it
  0A33'   3A 2E26'              	LDA	JKPHN
  0A36'   B7                    	ORA	A
  0A37'   CA 0A41'              	JZ	JC_DN
  0A3A'   2A 2E22'              	LHLD	JKMOV
  0A3D'   2B                    	DCX	H
  0A3E'   22 2E22'              	SHLD	JKMOV
  0A41'                         JC_DN:
  0A41'   2A 2E20'              	LHLD	JKN		; LNDLT += min(moved, N)
  0A44'   EB                    	XCHG
  0A45'   2A 2E22'              	LHLD	JKMOV
  0A48'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  0A4B'   D2 0A4F'              	JNC	JC_AD
  0A4E'   EB                    	XCHG
  0A4F'                         JC_AD:
  0A4F'   EB                    	XCHG			; DE = lines moved
  0A50'   2A 0000*              	LHLD	LNDLT
  0A53'   19                    	DAD	D
  0A54'   22 0000*              	SHLD	LNDLT
  0A57'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  0A58'                         KCORE:
  0A58'   7C                    	MOV	A,H
  0A59'   B5                    	ORA	L
  0A5A'   C8                    	RZ
  0A5B'   22 2E1E'              	SHLD	JKCNT
  0A5E'   CD 0DCD'              	CALL	CURRW		; limit = row + NEDIT
  0A61'   5F                    	MOV	E,A
  0A62'   16 00                 	MVI	D,0
  0A64'   3A 0000*              	LDA	NEDIT
  0A67'   6F                    	MOV	L,A
  0A68'   26 00                 	MVI	H,0
  0A6A'   19                    	DAD	D
  0A6B'   EB                    	XCHG			; DE = limit
  0A6C'   2A 2E1E'              	LHLD	JKCNT
  0A6F'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0A72'   D2 0A76'              	JNC	KC_N
  0A75'   EB                    	XCHG			; HL = limit
  0A76'                         KC_N:
  0A76'   22 2E20'              	SHLD	JKN		; N = min(count, limit)
  0A79'   EB                    	XCHG			; DE = LFs to find
  0A7A'   21 0000               	LXI	H,0
  0A7D'   22 2E24'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  0A80'                         KC_ED:
  0A80'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0A81'   2A 2E24'              	LHLD	JKBK
  0A84'   CD 072B'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0A87'   E5                    	PUSH	H
  0A88'   EB                    	XCHG
  0A89'   2A 0000*              	LHLD	TXTBEG
  0A8C'   EB                    	XCHG
  0A8D'   CD 0000*              	CALL	SUBHD
  0A90'   44                    	MOV	B,H
  0A91'   4D                    	MOV	C,L
  0A92'   E1                    	POP	H
  0A93'   D1                    	POP	D
  0A94'                         KC_SC:
  0A94'   78                    	MOV	A,B
  0A95'   B1                    	ORA	C
  0A96'   CA 0AAD'              	JZ	KC_TB
  0A99'   2B                    	DCX	H
  0A9A'   0B                    	DCX	B
  0A9B'   7E                    	MOV	A,M
  0A9C'   FE 0A                 	CPI	LF
  0A9E'   C2 0A94'              	JNZ	KC_SC
  0AA1'   1B                    	DCX	D
  0AA2'   7A                    	MOV	A,D
  0AA3'   B3                    	ORA	E
  0AA4'   C2 0A94'              	JNZ	KC_SC
  0AA7'   2A 2E1E'              	LHLD	JKCNT		; N lines above: the move is count lines
  0AAA'   C3 0ACD'              	JMP	KC_MV
  0AAD'                         KC_TB:
  0AAD'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0AAE'   CD 072B'              	CALL	GBSUB		; HL = GAPBEG - that pointer
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0AB1'   22 2E24'              	SHLD	JKBK
  0AB4'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0AB7'   7C                    	MOV	A,H
  0AB8'   B5                    	ORA	L
  0AB9'   CA 0AC6'              	JZ	KC_B0
  0ABC'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  0ABF'   D1                    	POP	D
  0AC0'   DA 0AC7'              	JC	KC_BOF
  0AC3'   C3 0A80'              	JMP	KC_ED
  0AC6'                         KC_B0:
  0AC6'   D1                    	POP	D
  0AC7'                         KC_BOF:
  0AC7'   2A 2E20'              	LHLD	JKN		; moved = LFs found
  0ACA'   CD 0000*              	CALL	SUBHD
  0ACD'                         KC_MV:
  0ACD'   E5                    	PUSH	H
  0ACE'   2A 2E1E'              	LHLD	JKCNT
  0AD1'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0AD4'   D1                    	POP	D		; DE = moved
  0AD5'   2A 2E20'              	LHLD	JKN
  0AD8'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0ADB'   DA 0ADF'              	JC	KC_AD
  0ADE'   EB                    	XCHG			; DE = N
  0ADF'                         KC_AD:
  0ADF'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0AE2'   CD 0000*              	CALL	SUBHD
  0AE5'   22 0000*              	SHLD	LNDLT
  0AE8'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0AE9'                         ATEOF:
  0AE9'   CD 0000*              	CALL	RGET0
  0AEC'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0AEF'                         LASTLN:
  0AEF'   2A 0000*              	LHLD	GAPBEG
  0AF2'   EB                    	XCHG
  0AF3'   2A 0000*              	LHLD	TXTBEG
  0AF6'   CD 0000*              	CALL	CMP16
  0AF9'   21 0000               	LXI	H,0
  0AFC'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0AFF'   1B                    	DCX	D
  0B00'   1A                    	LDAX	D
  0B01'   FE 0A                 	CPI	LF
  0B03'   C2 0000*              	JNZ	SETBWD
  0B06'   23                    	INX	H
  0B07'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0B0A'                         JKLAND:
  0B0A'   21 0000               	LXI	H,0
  0B0D'   22 2E28'              	SHLD	JKVC		; screen column
  0B10'   2B                    	DCX	H
  0B11'   22 2E2A'              	SHLD	JKLS		; last content char: none yet
  0B14'   CD 0000*              	CALL	RGET0
  0B17'   11 0000               	LXI	D,0		; DE = chars read
  0B1A'                         JL_RD:
  0B1A'   CD 0000*              	CALL	RDGET
  0B1D'   DA 0B57'              	JC	JL_END
  0B20'   FE 0A                 	CPI	LF
  0B22'   CA 0B57'              	JZ	JL_END
  0B25'   E5                    	PUSH	H
  0B26'   C5                    	PUSH	B
  0B27'   2A 2E28'              	LHLD	JKVC
  0B2A'   CD 0611'              	CALL	CWID
  0B2D'   B7                    	ORA	A
  0B2E'   CA 0B51'              	JZ	JL_NX		; a CR
  0B31'   EB                    	XCHG
  0B32'   22 2E2A'              	SHLD	JKLS		; the last content char so far
  0B35'   EB                    	XCHG
  0B36'   4F                    	MOV	C,A
  0B37'   06 00                 	MVI	B,0
  0B39'   09                    	DAD	B		; HL = the column after this char
  0B3A'   22 2E28'              	SHLD	JKVC
  0B3D'   D5                    	PUSH	D
  0B3E'   EB                    	XCHG
  0B3F'   2A 2E0D'              	LHLD	GOALCOL
  0B42'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0B45'   D1                    	POP	D
  0B46'   DA 0B51'              	JC	JL_NX
  0B49'   CA 0B51'              	JZ	JL_NX
  0B4C'   C1                    	POP	B		; this char holds the goal column
  0B4D'   E1                    	POP	H
  0B4E'   C3 0B62'              	JMP	JL_GO
  0B51'                         JL_NX:
  0B51'   C1                    	POP	B
  0B52'   E1                    	POP	H
  0B53'   13                    	INX	D
  0B54'   C3 0B1A'              	JMP	JL_RD
  0B57'                         JL_END:
  0B57'   2A 2E2A'              	LHLD	JKLS		; past the line's end: its last content char
  0B5A'   7C                    	MOV	A,H
  0B5B'   A5                    	ANA	L
  0B5C'   3C                    	INR	A
  0B5D'   C2 0B61'              	JNZ	JL_LS
  0B60'   23                    	INX	H		; no content: the line's start
  0B61'                         JL_LS:
  0B61'   EB                    	XCHG
  0B62'                         JL_GO:
  0B62'   D5                    	PUSH	D		; DE = step from the line start
  0B63'   CD 0000*              	CALL	CUROFF
  0B66'   D1                    	POP	D
  0B67'   19                    	DAD	D
  0B68'   C3 0000*              	JMP	GOTO
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0B6B'   AF                    VC_W:	XRA	A
  0B6C'   32 2E0F'              	STA	WBIG
  0B6F'   C3 0B77'              	JMP	WDO
  0B72'   3E 01                 VCBGW:	MVI	A,1
  0B74'   32 2E0F'              	STA	WBIG
  0B77'   CD 0807'              WDO:	CALL	SETMOV
  0B7A'   AF                    	XRA	A
  0B7B'   32 2E10'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0B7E'   CD 0732'              	CALL	GETCNT
  0B81'   22 2E52'              	SHLD	CNTV
  0B84'   2A 2E52'              WDO_LP: LHLD	CNTV
  0B87'   7C                    	MOV	A,H
  0B88'   B5                    	ORA	L
  0B89'   CA 0B96'              	JZ	WDO_DN
  0B8C'   2B                    	DCX	H
  0B8D'   22 2E52'              	SHLD	CNTV
  0B90'   CD 0BF3'              	CALL	FWD1
  0B93'   D2 0B84'              	JNC	WDO_LP
  0B96'                         WDO_DN:
  0B96'   CD 0AE9'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0B99'   DA 0BA6'              	JC	WDO_NL
  0B9C'   FE 0D                 	CPI	CR
  0B9E'   CA 0BA6'              	JZ	WDO_NL
  0BA1'   FE 0A                 	CPI	LF
  0BA3'   C2 05BD'              	JNZ	SETGL
  0BA6'                         WDO_NL:
  0BA6'   CD 0000*              	CALL	PEEKL
  0BA9'   DA 05BD'              	JC	SETGL
  0BAC'   FE 0A                 	CPI	LF
  0BAE'   CA 05BD'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0BB1'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0BB3'   32 2E10'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0BB6'   CD 0D12'              	CALL	DECC		; back onto its last char
  0BB9'   C3 05BD'              	JMP	SETGL
                                
  0BBC'   AF                    VC_B:	XRA	A
  0BBD'   32 2E0F'              	STA	WBIG
  0BC0'   C3 0BC8'              	JMP	BDO
  0BC3'   3E 01                 VCBGB:	MVI	A,1
  0BC5'   32 2E0F'              	STA	WBIG
  0BC8'   CD 0807'              BDO:	CALL	SETMOV
  0BCB'   CD 0732'              	CALL	GETCNT
  0BCE'   22 2E52'              	SHLD	CNTV
  0BD1'   CD 0C63'              	CALL	BCK1		; the first step, apart: with nowhere to go back
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0BD4'   D2 0BE4'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0BD7'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0BD8'   32 2E3A'              	STA	PSAVE		;   first char opened an insert).  A count that
  0BDB'   C3 05BD'              	JMP	SETGL		;   runs out at the start has still moved, and
  0BDE'                         BDO_LP:				;   its operator stands -- both as vim
  0BDE'   CD 0C63'              	CALL	BCK1
  0BE1'   DA 05BD'              	JC	SETGL
  0BE4'   2A 2E52'              BDO_NX: LHLD	CNTV
  0BE7'   2B                    	DCX	H
  0BE8'   22 2E52'              	SHLD	CNTV
  0BEB'   7C                    	MOV	A,H
  0BEC'   B5                    	ORA	L
  0BED'   C2 0BDE'              	JNZ	BDO_LP
  0BF0'   C3 05BD'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
                                ; words before the last run on freely -- 'd2w' there takes the line break and
                                ; the next line's first word as well.
  0BF3'                         FWD1:
  0BF3'   CD 0C96'              	CALL	CCLS
  0BF6'   32 2E5C'              	STA	WKCLS		; the starting class
  0BF9'   CD 0CD0'              	CALL	INCC
  0BFC'   B7                    	ORA	A
  0BFD'   CA 0C16'              	JZ	FW_WD
  0C00'   37                    	STC
  0C01'   F8                    	RM			; -1: already at the end
  0C02'   CD 0C4E'              	CALL	WLAST
  0C05'   C8                    	RZ
  0C06'   FE 02                 	CPI	2
  0C08'   C2 0C16'              	JNZ	FW_WD		; 1: a next line was reached
  0C0B'   CD 0AE9'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0C0E'   D4 0CB7'              	CNC	NXLN
  0C11'   D2 0C16'              	JNC	FW_WD
  0C14'   37                    	STC			; yes: failed
  0C15'   C9                    	RET
  0C16'                         FW_WD:
  0C16'   3A 2E5C'              	LDA	WKCLS		; go past the rest of this word
  0C19'   B7                    	ORA	A
  0C1A'   CA 0C36'              	JZ	FW_WS
  0C1D'                         FW_WLP:
  0C1D'   CD 0C96'              	CALL	CCLS
  0C20'   21 2E5C'              	LXI	H,WKCLS
  0C23'   BE                    	CMP	M
  0C24'   C2 0C36'              	JNZ	FW_WS
  0C27'   CD 0CD0'              	CALL	INCC
  0C2A'   B7                    	ORA	A
  0C2B'   F8                    	RM			; the end of the file (NC)
  0C2C'   CA 0C1D'              	JZ	FW_WLP
  0C2F'   CD 0C4E'              	CALL	WLAST
  0C32'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C33'   C3 0C1D'              	JMP	FW_WLP
  0C36'                         FW_WS:
  0C36'   CD 0C96'              	CALL	CCLS		; then over blanks to the next word
  0C39'   B7                    	ORA	A
  0C3A'   C0                    	RNZ
  0C3B'   CD 0C9E'              	CALL	EMPTY
  0C3E'   C8                    	RZ			; an empty line is a word
  0C3F'   CD 0CD0'              	CALL	INCC
  0C42'   B7                    	ORA	A
  0C43'   F8                    	RM
  0C44'   CA 0C36'              	JZ	FW_WS
  0C47'   CD 0C4E'              	CALL	WLAST
  0C4A'   C8                    	RZ
  0C4B'   C3 0C36'              	JMP	FW_WS
                                
                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0C4E'                         WLAST:
  0C4E'   47                    	MOV	B,A
  0C4F'   2A 2E52'              	LHLD	CNTV
  0C52'   7C                    	MOV	A,H
  0C53'   B5                    	ORA	L
  0C54'   C2 0C5F'              	JNZ	WL_X		; words still owed
  0C57'   3A 2E3A'              	LDA	PSAVE
  0C5A'   B7                    	ORA	A
  0C5B'   CA 0C61'              	JZ	WL_NO		; a plain 'w'
  0C5E'   AF                    	XRA	A
  0C5F'   78                    WL_X:	MOV	A,B
  0C60'   C9                    	RET
  0C61'   B0                    WL_NO:	ORA	B
  0C62'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0C63'                         BCK1:
  0C63'   CD 0D12'              	CALL	DECC
  0C66'   B7                    	ORA	A
  0C67'   37                    	STC
  0C68'   F8                    	RM
  0C69'                         BK_WS:
  0C69'   CD 0C96'              	CALL	CCLS		; back over blanks
  0C6C'   B7                    	ORA	A
  0C6D'   C2 0C7D'              	JNZ	BK_WD
  0C70'   CD 0C9E'              	CALL	EMPTY
  0C73'   C8                    	RZ			; an empty line is a word
  0C74'   CD 0D12'              	CALL	DECC
  0C77'   B7                    	ORA	A
  0C78'   F2 0C69'              	JP	BK_WS
  0C7B'   AF                    	XRA	A		; the start of the file (NC)
  0C7C'   C9                    	RET
  0C7D'                         BK_WD:
  0C7D'   32 2E5C'              	STA	WKCLS		; back to the start of this word
  0C80'                         BK_WLP:
  0C80'   CD 0D12'              	CALL	DECC
  0C83'   B7                    	ORA	A
  0C84'   FA 0C94'              	JM	BK_OK		; the start of the file
  0C87'   CD 0C96'              	CALL	CCLS
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0C8A'   21 2E5C'              	LXI	H,WKCLS
  0C8D'   BE                    	CMP	M
  0C8E'   CA 0C80'              	JZ	BK_WLP
  0C91'   CD 0CD0'              	CALL	INCC		; overshot: forward one
  0C94'                         BK_OK:
  0C94'   AF                    	XRA	A
  0C95'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0C96'                         CCLS:
  0C96'   CD 0AE9'              	CALL	ATEOF
  0C99'   D2 07BC'              	JNC	CLASSF
  0C9C'   AF                    	XRA	A
  0C9D'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0C9E'                         EMPTY:
  0C9E'   CD 0AE9'              	CALL	ATEOF
  0CA1'   DA 0CAC'              	JC	EM_ST
  0CA4'   FE 0D                 	CPI	CR
  0CA6'   CA 0CAC'              	JZ	EM_ST
  0CA9'   FE 0A                 	CPI	LF
  0CAB'   C0                    	RNZ
  0CAC'                         EM_ST:
  0CAC'   CD 0000*              	CALL	PEEKL
  0CAF'   DA 0CB5'              	JC	EM_Y
  0CB2'   FE 0A                 	CPI	LF
  0CB4'   C9                    	RET
  0CB5'                         EM_Y:
  0CB5'   AF                    	XRA	A
  0CB6'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0CB7'                         NXLN:
  0CB7'   FE 0A                 	CPI	LF
  0CB9'   CA 0CC8'              	JZ	NX_LF
  0CBC'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0CBF'   D8                    	RC
  0CC0'   FE 0A                 	CPI	LF
  0CC2'   CA 0CC8'              	JZ	NX_LF
  0CC5'   2B                    	DCX	H		; a lone CR
  0CC6'   AF                    	XRA	A
  0CC7'   C9                    	RET
  0CC8'                         NX_LF:
  0CC8'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0CCB'   D8                    	RC
  0CCC'   2B                    	DCX	H
  0CCD'   3E 01                 	MVI	A,1
  0CCF'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0CD0'                         INCC:
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0CD0'   CD 0AE9'              	CALL	ATEOF
  0CD3'   DA 0D0E'              	JC	IC_END
  0CD6'   FE 0D                 	CPI	CR
  0CD8'   CA 0CF9'              	JZ	IC_NL
  0CDB'   FE 0A                 	CPI	LF
  0CDD'   CA 0CF9'              	JZ	IC_NL
  0CE0'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0CE3'                         IC_CH:
  0CE3'   CD 0AE9'              	CALL	ATEOF
  0CE6'   DA 0CF5'              	JC	IC_2
  0CE9'   FE 0D                 	CPI	CR
  0CEB'   CA 0CF5'              	JZ	IC_2
  0CEE'   FE 0A                 	CPI	LF
  0CF0'   CA 0CF5'              	JZ	IC_2
  0CF3'   AF                    	XRA	A
  0CF4'   C9                    	RET
  0CF5'                         IC_2:
  0CF5'   3E 02                 	MVI	A,2
  0CF7'   B7                    	ORA	A
  0CF8'   C9                    	RET
  0CF9'                         IC_NL:
  0CF9'   CD 0CB7'              	CALL	NXLN
  0CFC'   DA 0D0E'              	JC	IC_END
  0CFF'   F5                    	PUSH	PSW
  0D00'   CD 0000*              	CALL	PUTCUR
  0D03'   F1                    	POP	PSW
  0D04'   B7                    	ORA	A
  0D05'   CA 0CE3'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0D08'   CD 0D34'              	CALL	LNINC
  0D0B'   3E 01                 	MVI	A,1
  0D0D'   C9                    	RET
  0D0E'                         IC_END:
  0D0E'   3E FF                 	MVI	A,0FFH
  0D10'   B7                    	ORA	A
  0D11'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0D12'                         DECC:
  0D12'   CD 0000*              	CALL	PEEKL
  0D15'   DA 0D0E'              	JC	IC_END
  0D18'   F5                    	PUSH	PSW
  0D19'   CD 0000*              	CALL	PUTCUR
  0D1C'   F1                    	POP	PSW
  0D1D'   FE 0A                 	CPI	LF
  0D1F'   3E 00                 	MVI	A,0
  0D21'   C0                    	RNZ
  0D22'   CD 0D42'              	CALL	LNDEC
  0D25'   CD 0000*              	CALL	PEEKL		; onto its CR
  0D28'   DA 0D30'              	JC	DC_1
  0D2B'   FE 0D                 	CPI	CR
  0D2D'   CC 0000*              	CZ	PUTCUR
  0D30'                         DC_1:
  0D30'   3E 01                 	MVI	A,1
  0D32'   B7                    	ORA	A
  0D33'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0D34'                         LNINC:
  0D34'   E5                    	PUSH	H
  0D35'   2A 0000*              	LHLD	LNDLT
  0D38'   7C                    	MOV	A,H
  0D39'   FE 40                 	CPI	40H
  0D3B'   CA 0D50'              	JZ	LN_X
  0D3E'   23                    	INX	H
  0D3F'   C3 0D4D'              	JMP	LN_ST
  0D42'                         LNDEC:
  0D42'   E5                    	PUSH	H
  0D43'   2A 0000*              	LHLD	LNDLT
  0D46'   7C                    	MOV	A,H
  0D47'   FE C0                 	CPI	0C0H
  0D49'   CA 0D50'              	JZ	LN_X
  0D4C'   2B                    	DCX	H
  0D4D'                         LN_ST:
  0D4D'   22 0000*              	SHLD	LNDLT
  0D50'                         LN_X:
  0D50'   E1                    	POP	H
  0D51'   C9                    	RET
                                
  0D52'   AF                    VC_E:	XRA	A
  0D53'   32 2E0F'              	STA	WBIG
  0D56'   C3 0D5E'              	JMP	EDO
  0D59'   3E 01                 VCBGE:	MVI	A,1
  0D5B'   32 2E0F'              	STA	WBIG
  0D5E'   CD 0807'              EDO:	CALL	SETMOV
  0D61'   CD 0732'              	CALL	GETCNT
  0D64'   22 2E52'              	SHLD	CNTV
  0D67'   2A 2E52'              EDO_LP: LHLD	CNTV
  0D6A'   7C                    	MOV	A,H
  0D6B'   B5                    	ORA	L
  0D6C'   CA 0B96'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0D6F'   2B                    	DCX	H
  0D70'   22 2E52'              	SHLD	CNTV
  0D73'   CD 0D81'              	CALL	ESTEP
  0D76'   21 2E3D'              	LXI	H,CWEOL		; only the count's first word stays where it is
  0D79'   36 00                 	MVI	M,0
  0D7B'   D2 0D67'              	JNC	EDO_LP
  0D7E'   C3 0B96'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0D81'                         ESTEP:
  0D81'   CD 0C96'              	CALL	CCLS
  0D84'   32 2E5C'              	STA	WKCLS		; the starting class
  0D87'   CD 0CD0'              	CALL	INCC
  0D8A'   B7                    	ORA	A
  0D8B'   FA 0DB1'              	JM	ES_F
  0D8E'   CD 0C96'              	CALL	CCLS
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0D91'   B7                    	ORA	A
  0D92'   CA 0D9C'              	JZ	ES_ST
  0D95'   21 2E5C'              	LXI	H,WKCLS
  0D98'   BE                    	CMP	M
  0D99'   CA 0DB3'              	JZ	ES_SK		; still in the word it started in: on to its end
  0D9C'                         ES_ST:
  0D9C'   3A 2E3D'              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0D9F'   B7                    	ORA	A		;   that char is the word's end already, and
  0DA0'   C2 0DCA'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
  0DA3'                         ES_WS:
  0DA3'   CD 0C96'              	CALL	CCLS		; over blanks, line ends and empty lines
  0DA6'   B7                    	ORA	A
  0DA7'   C2 0DB3'              	JNZ	ES_SK
  0DAA'   CD 0CD0'              	CALL	INCC
  0DAD'   B7                    	ORA	A
  0DAE'   F2 0DA3'              	JP	ES_WS
  0DB1'                         ES_F:
  0DB1'   37                    	STC
  0DB2'   C9                    	RET
  0DB3'                         ES_SK:
  0DB3'   CD 0C96'              	CALL	CCLS		; past the rest of this word ...
  0DB6'   32 2E5C'              	STA	WKCLS
  0DB9'                         ES_SL:
  0DB9'   CD 0CD0'              	CALL	INCC
  0DBC'   B7                    	ORA	A
  0DBD'   FA 0DB1'              	JM	ES_F
  0DC0'   CD 0C96'              	CALL	CCLS
  0DC3'   21 2E5C'              	LXI	H,WKCLS
  0DC6'   BE                    	CMP	M
  0DC7'   CA 0DB9'              	JZ	ES_SL
  0DCA'   C3 0D12'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's place among the screen's LINES (CURRW) and the
                                ; last layout's facts from SCRN.MAC: SCBOT (the last line shown), SCEOF / SCBOF
                                ; (the file's end / start is on the screen).  H and L count lines.  M and the
                                ; scrolls count screen ROWS, as vim does once lines wrap, and a line's rows
                                ; are not known without measuring it: SCRN.MAC's HTBLD measures the lines
                                ; about the screen into a table (HTAB), and the rest is arithmetic on that.
                                ; A scroll then moves the cursor and names the line the screen is to start
                                ; with (HTLAND -> SETRWT), so the text scrolls around it.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0DCD'                         CURRW:
  0DCD'   2A 0000*              	LHLD	WINROW
  0DD0'   EB                    	XCHG
  0DD1'   2A 0000*              	LHLD	LNDLT
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0DD4'   19                    	DAD	D		; HL = row (signed)
  0DD5'   7C                    	MOV	A,H
  0DD6'   B7                    	ORA	A
  0DD7'   FA 0DEA'              	JM	CRW_0		; above the screen -> top row
  0DDA'   C2 0DE5'              	JNZ	CRW_BT		; far below -> bottom row
  0DDD'   3A 0000*              	LDA	NEDIT
  0DE0'   3D                    	DCR	A		; A = bottom row
  0DE1'   BD                    	CMP	L		; CY iff bottom < row
  0DE2'   D8                    	RC
  0DE3'   7D                    	MOV	A,L
  0DE4'   C9                    	RET
  0DE5'                         CRW_BT:
  0DE5'   3A 0000*              	LDA	NEDIT
  0DE8'   3D                    	DCR	A
  0DE9'   C9                    	RET
  0DEA'                         CRW_0:
  0DEA'   AF                    	XRA	A
  0DEB'   C9                    	RET
                                
                                ;SETRWT -- A = lines: the next layout puts that many above the cursor's, and
                                ; does not ask whether the line has gone far (PLACE).
  0DEC'                         SETRWT:
  0DEC'   2A 0000*              	LHLD	LNDLT
  0DEF'   EB                    	XCHG
  0DF0'   6F                    	MOV	L,A
  0DF1'   26 00                 	MVI	H,0
  0DF3'   CD 0000*              	CALL	SUBHD		; HL = lines - LNDLT
  0DF6'   22 0000*              	SHLD	WINROW
  0DF9'   3E 01                 	MVI	A,PL_SET
  0DFB'   32 0000*              	STA	PLACE
  0DFE'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0DFF'                         MVROW:
  0DFF'   47                    	MOV	B,A
  0E00'   CD 0DCD'              	CALL	CURRW
  0E03'   90                    	SUB	B		; A = row now - target
  0E04'                         MR_GO:
  0E04'   C8                    	RZ
  0E05'   DA 0E0E'              	JC	MR_DN
  0E08'   6F                    	MOV	L,A
  0E09'   26 00                 	MVI	H,0
  0E0B'   C3 0A58'              	JMP	KCORE
  0E0E'                         MR_DN:
  0E0E'   2F                    	CMA
  0E0F'   3C                    	INR	A		; A = target - row now
  0E10'   6F                    	MOV	L,A
  0E11'   26 00                 	MVI	H,0
  0E13'   C3 09BB'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0E16'                         VC_HIGH:
  0E16'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  0E19'   2B                    	DCX	H		; row = count - 1
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E1A'   7C                    	MOV	A,H
  0E1B'   B7                    	ORA	A
  0E1C'   3A 0000*              	LDA	SCBOT
  0E1F'   C2 0E27'              	JNZ	VH_GO		; >= 256 -> the last text row
  0E22'   BD                    	CMP	L		; CY iff SCBOT < row
  0E23'   DA 0E27'              	JC	VH_GO
  0E26'   7D                    	MOV	A,L
  0E27'                         VH_GO:
  0E27'   CD 0DFF'              	CALL	MVROW
  0E2A'   C3 0900'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': the line the middle ROW of the text is on (vim: the first
                                ; whose rows, with those above it, come to half of them); count ignored.
  0E2D'                         VC_MIDL:
  0E2D'   CD 071F'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0E30'   CD 10BF'              	CALL	HTSCR		; HL -> the top line's rows
  0E33'   3A 0000*              	LDA	TXEND
  0E36'   3C                    	INR	A
  0E37'   B7                    	ORA	A
  0E38'   1F                    	RAR
  0E39'   3D                    	DCR	A
  0E3A'   4F                    	MOV	C,A		; C = (rows of text + 1) / 2 - 1
  0E3B'   CD 1105'              	CALL	HTFQ
  0E3E'   D2 0E42'              	JNC	VM_GO
  0E41'   2B                    	DCX	H
  0E42'                         VM_GO:
  0E42'   CD 10FA'              	CALL	HTGO
  0E45'   C3 0900'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0E48'                         VC_LOWL:
  0E48'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  0E4B'   2B                    	DCX	H		; count - 1
  0E4C'   3A 0000*              	LDA	SCBOT
  0E4F'   5F                    	MOV	E,A
  0E50'   16 00                 	MVI	D,0
  0E52'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0E53'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0E56'   3E 00                 	MVI	A,0
  0E58'   D2 0E5F'              	JNC	VL_GO		; at or past the top -> row 0
  0E5B'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0E5E'   7D                    	MOV	A,L
  0E5F'                         VL_GO:
  0E5F'   CD 0DFF'              	CALL	MVROW
  0E62'   C3 0900'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the text forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is the
                                ; screen's ROWS less the overlap (OVLAP), and the line that many rows down
                                ; becomes the top line -- from its first row, vim never showing part of one.
                                ; The top line stops at the last line ('~' rows below); no-op when it is
                                ; already there.
  0E65'                         VC_PGDN:
  0E65'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  0E68'   22 2E1A'              	SHLD	RWR
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0E6B'   3A 0000*              	LDA	SCEOF
  0E6E'   B7                    	ORA	A
  0E6F'   CA 0E77'              	JZ	VPD_N
  0E72'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: it becomes the
  0E75'   B7                    	ORA	A		;   top line
  0E76'   C8                    	RZ			; it already is
  0E77'                         VPD_N:
  0E77'   3A 0000*              	LDA	NEDIT
  0E7A'   3C                    	INR	A
  0E7B'   4F                    	MOV	C,A
  0E7C'   3E 02                 	MVI	A,2
  0E7E'   CD 10C6'              	CALL	HTSET		; HL -> the top line's rows
  0E81'   E5                    	PUSH	H
  0E82'   C5                    	PUSH	B
  0E83'   3A 0000*              	LDA	NEDIT
  0E86'   4F                    	MOV	C,A
  0E87'   CD 1105'              	CALL	HTFQ		; HL -> the first line the screen has not room for
  0E8A'   3A 0000*              	LDA	NEDIT
  0E8D'   DA 0E9A'              	JC	VPD_R		; there is none: no overlap
  0E90'   3A 2E15'              	LDA	HTN
  0E93'   90                    	SUB	B
  0E94'   3C                    	INR	A
  0E95'   47                    	MOV	B,A		; the lines from it up to the table's first
  0E96'   AF                    	XRA	A
  0E97'   CD 0F34'              	CALL	OVLAP
  0E9A'                         VPD_R:
  0E9A'   CD 0F83'              	CALL	PGROWS		; RWR = the rows to go
  0E9D'   C1                    	POP	B
  0E9E'   E1                    	POP	H
  0E9F'   CD 1146'              	CALL	RWFWD		; HL -> the line that row is in, C = which of its
  0EA2'   DA 0EBE'              	JC	VPD_TP		; the text ended: its last line
  0EA5'   79                    	MOV	A,C
  0EA6'   B7                    	ORA	A
  0EA7'   CA 0EBE'              	JZ	VPD_TP
  0EAA'   3A 2E1C'              	LDA	RWMV		; part of the way down a line: its start -- unless
  0EAD'   B7                    	ORA	A		;   that is the top line still, then the next
  0EAE'   C2 0EBE'              	JNZ	VPD_TP
  0EB1'   E5                    	PUSH	H
  0EB2'   CD 10F4'              	CALL	HTIX
  0EB5'   21 2E17'              	LXI	H,HTTP
  0EB8'   BE                    	CMP	M
  0EB9'   E1                    	POP	H
  0EBA'   C2 0EBE'              	JNZ	VPD_TP
  0EBD'   23                    	INX	H
  0EBE'                         VPD_TP:
  0EBE'   54                    	MOV	D,H
  0EBF'   5D                    	MOV	E,L
  0EC0'   C3 102D'              	JMP	HTLAND
                                
                                ;VC_PGUP -- '^B': the text back count pages, not above the first line, the
                                ; cursor on the last line that then shows whole, first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is the screen's ROWS less the overlap
                                ; (OVLAP).  Where that ends part of the way up a line, the top line is the one
                                ; under it -- but the line itself, when it is the first one back.  No-op when
                                ; the first line is already at the top.
  0EC3'                         VC_PGUP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0EC3'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  0EC6'   22 2E1A'              	SHLD	RWR
  0EC9'   3A 0000*              	LDA	SCBOF
  0ECC'   B7                    	ORA	A
  0ECD'   C0                    	RNZ
  0ECE'   CD 0DCD'              	CALL	CURRW		; OVLAP reads the top line and the two under it:
  0ED1'   FE 02                 	CPI	2		;   lines the cursor's is not below are read for
  0ED3'   0E 01                 	MVI	C,1
  0ED5'   D2 0EDC'              	JNC	VPU_1
  0ED8'   3A 0000*              	LDA	NEDIT
  0EDB'   4F                    	MOV	C,A
  0EDC'                         VPU_1:
  0EDC'   3A 0000*              	LDA	NEDIT
  0EDF'   CD 10C6'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  0EE2'   E5                    	PUSH	H
  0EE3'   D5                    	PUSH	D
  0EE4'   2B                    	DCX	H		; the line above the top one, and on down
  0EE5'   04                    	INR	B
  0EE6'   3E 01                 	MVI	A,1
  0EE8'   CD 0F34'              	CALL	OVLAP
  0EEB'   CD 0F83'              	CALL	PGROWS		; RWR = the rows to go
  0EEE'   D1                    	POP	D
  0EEF'   E1                    	POP	H
  0EF0'   43                    	MOV	B,E
  0EF1'   CD 1186'              	CALL	RWBAK		; HL -> the line that row is in, C = its rows
  0EF4'   DA 0F11'              	JC	VPU_3		;   above it; or the file's first line
  0EF7'   79                    	MOV	A,C
  0EF8'   B7                    	ORA	A
  0EF9'   CA 0F11'              	JZ	VPU_3
  0EFC'   3A 2E1C'              	LDA	RWMV
  0EFF'   B7                    	ORA	A
  0F00'   C2 0F10'              	JNZ	VPU_2
  0F03'   E5                    	PUSH	H
  0F04'   CD 10F4'              	CALL	HTIX
  0F07'   3C                    	INR	A
  0F08'   21 2E17'              	LXI	H,HTTP
  0F0B'   BE                    	CMP	M
  0F0C'   E1                    	POP	H
  0F0D'   CA 0F11'              	JZ	VPU_3		; the first line back: all of it
  0F10'                         VPU_2:
  0F10'   23                    	INX	H
  0F11'                         VPU_3:
  0F11'   CD 10FA'              	CALL	HTGO		; the cursor on the new top line ...
  0F14'   3A 0000*              	LDA	NEDIT
  0F17'   4F                    	MOV	C,A
  0F18'   06 00                 	MVI	B,0
  0F1A'   CD 10DB'              	CALL	HTRB		; ... and the lines under it measured
  0F1D'   E5                    	PUSH	H
  0F1E'   3A 0000*              	LDA	NEDIT
  0F21'   4F                    	MOV	C,A
  0F22'   CD 1105'              	CALL	HTFQ		; HL -> the first the screen has not room for
  0F25'   2B                    	DCX	H
  0F26'   D1                    	POP	D		; DE -> the top line's rows
  0F27'   EB                    	XCHG
  0F28'   CD 0000*              	CALL	CMP16		; CY iff that is above the top line (it alone
  0F2B'   D2 0F30'              	JNC	VPU_4		;   fills the screen)
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F2E'   54                    	MOV	D,H
  0F2F'   5D                    	MOV	E,L
  0F30'                         VPU_4:
  0F30'   EB                    	XCHG
  0F31'   C3 102D'              	JMP	HTLAND
                                
                                ;OVLAP -- A = the rows one page scrolls, as vim's get_scroll_overlap: the
                                ; screen less two lines of overlap -- or less one, or none, where the lines at
                                ; that edge are too tall to be shown twice or the file ends among them.
                                ;   in : HL -> the rows of the line just off the screen at that edge (h1),
                                ;        A = 0 when the next (h2, h3, h4) are above it in the table, 1 when
                                ;        below, B = the entries the table has that way, h1's among them
  0F34'                         OVLAP:
  0F34'   32 2E1D'              	STA	OVDIR
  0F37'   3A 0000*              	LDA	NEDIT
  0F3A'   D6 02                 	SUI	2
  0F3C'   4F                    	MOV	C,A		; C = the rows two lines of overlap leave
  0F3D'   56                    	MOV	D,M		; D = h1
  0F3E'   CD 0F75'              	CALL	OV_NX
  0F41'   DA 0F71'              	JC	OV_0
  0F44'   5E                    	MOV	E,M		; E = h2
  0F45'   7A                    	MOV	A,D
  0F46'   83                    	ADD	E
  0F47'   57                    	MOV	D,A		; D = h1 + h2
  0F48'   79                    	MOV	A,C
  0F49'   BA                    	CMP	D
  0F4A'   DA 0F71'              	JC	OV_0
  0F4D'   CD 0F75'              	CALL	OV_NX
  0F50'   DA 0F71'              	JC	OV_0
  0F53'   7B                    	MOV	A,E
  0F54'   86                    	ADD	M
  0F55'   5F                    	MOV	E,A		; E = h2 + h3
  0F56'   79                    	MOV	A,C
  0F57'   BB                    	CMP	E
  0F58'   DA 0F71'              	JC	OV_0
  0F5B'   7A                    	MOV	A,D
  0F5C'   86                    	ADD	M
  0F5D'   57                    	MOV	D,A		; D = h1 + h2 + h3
  0F5E'   CD 0F75'              	CALL	OV_NX
  0F61'   DA 0F6E'              	JC	OV_1
  0F64'   7B                    	MOV	A,E
  0F65'   86                    	ADD	M		; h2 + h3 + h4
  0F66'   5F                    	MOV	E,A
  0F67'   79                    	MOV	A,C
  0F68'   BB                    	CMP	E
  0F69'   DA 0F6E'              	JC	OV_1
  0F6C'   BA                    	CMP	D
  0F6D'   D0                    	RNC			; two lines of overlap
  0F6E'                         OV_1:
  0F6E'   79                    	MOV	A,C
  0F6F'   3C                    	INR	A
  0F70'   C9                    	RET
  0F71'                         OV_0:
  0F71'   79                    	MOV	A,C
  0F72'   C6 02                 	ADI	2
  0F74'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


                                ;OV_NX -- HL -> the next line's rows, that way.  CY if the table has no more.
  0F75'                         OV_NX:
  0F75'   05                    	DCR	B
  0F76'   37                    	STC
  0F77'   C8                    	RZ
  0F78'   3A 2E1D'              	LDA	OVDIR
  0F7B'   B7                    	ORA	A		; (CY off)
  0F7C'   CA 0F81'              	JZ	OV_UP
  0F7F'   23                    	INX	H
  0F80'   23                    	INX	H
  0F81'                         OV_UP:
  0F81'   2B                    	DCX	H
  0F82'   C9                    	RET
                                
                                ;PGROWS -- A = the rows of a page: RWR = the count (in RWR) of them, and no
                                ; line gone past yet (RWMV).
  0F83'                         PGROWS:
  0F83'   2A 2E1A'              	LHLD	RWR
  0F86'   CD 0F91'              	CALL	MULSAT
  0F89'   22 2E1A'              	SHLD	RWR
  0F8C'   AF                    	XRA	A
  0F8D'   32 2E1C'              	STA	RWMV
  0F90'   C9                    	RET
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0F91'                         MULSAT:
  0F91'   EB                    	XCHG
  0F92'   21 0000               	LXI	H,0
  0F95'   B7                    	ORA	A
  0F96'   C8                    	RZ
  0F97'                         MS_LP:
  0F97'   19                    	DAD	D
  0F98'   DA 0FA0'              	JC	MS_SAT
  0F9B'   3D                    	DCR	A
  0F9C'   C2 0F97'              	JNZ	MS_LP
  0F9F'   C9                    	RET
  0FA0'                         MS_SAT:
  0FA0'   21 FFFF               	LXI	H,0FFFFH
  0FA3'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': the text and the cursor down HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text goes
                                ; no farther than brings the last row of the file to the bottom row; the line
                                ; that many rows down becomes the top line -- from its first row, vim never
                                ; showing part of one, and the cursor moves as many rows less (more, where
                                ; the top line alone was taller than that and the text had to go past it).
                                ; On the last line nothing moves, the column included.
  0FA4'                         VC_HFDN:
  0FA4'   CD 0807'              	CALL	SETMOV
  0FA7'   CD 11E9'              	CALL	HFCNT		; HFN = the rows
  0FAA'   3A 0000*              	LDA	TALLF
  0FAD'   B7                    	ORA	A
  0FAE'   C2 1044'              	JNZ	VHD_TL
  0FB1'   CD 0DCD'              	CALL	CURRW
  0FB4'   47                    	MOV	B,A
  0FB5'   3A 0000*              	LDA	SCEOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FB8'   B7                    	ORA	A
  0FB9'   CA 0FC1'              	JZ	VHD_GO
  0FBC'   3A 0000*              	LDA	SCBOT		; the last line's place
  0FBF'   B8                    	CMP	B
  0FC0'   C8                    	RZ			; the cursor is on it
  0FC1'                         VHD_GO:
  0FC1'   3A 0000*              	LDA	NEDIT
  0FC4'   21 2E12'              	LXI	H,HFN
  0FC7'   86                    	ADD	M
  0FC8'   3C                    	INR	A
  0FC9'   4F                    	MOV	C,A
  0FCA'   AF                    	XRA	A
  0FCB'   CD 10C6'              	CALL	HTSET		; HL -> the top line's rows
  0FCE'   3A 2E12'              	LDA	HFN
  0FD1'   57                    	MOV	D,A		; D = the rows the text moves
  0FD2'   5F                    	MOV	E,A		; E = the rows the cursor moves
  0FD3'   3A 2E18'              	LDA	HTEOF
  0FD6'   B7                    	ORA	A
  0FD7'   CA 0FF6'              	JZ	VHD_1
  0FDA'   E5                    	PUSH	H
  0FDB'   C5                    	PUSH	B
  0FDC'   0E FF                 	MVI	C,255
  0FDE'   CD 1105'              	CALL	HTFQ		; (runs off: C = 255 - the rows to the file's end)
  0FE1'   3A 0000*              	LDA	NEDIT
  0FE4'   81                    	ADD	C
  0FE5'   2F                    	CMA			; A = those rows - NEDIT: the rows off the screen
  0FE6'   C1                    	POP	B
  0FE7'   E1                    	POP	H
  0FE8'   B7                    	ORA	A
  0FE9'   FA 0FF4'              	JM	VHD_0		; none
  0FEC'   BA                    	CMP	D
  0FED'   D2 0FF6'              	JNC	VHD_1
  0FF0'   57                    	MOV	D,A
  0FF1'   C3 0FF6'              	JMP	VHD_1
  0FF4'                         VHD_0:
  0FF4'   16 00                 	MVI	D,0
  0FF6'                         VHD_1:
  0FF6'   7A                    	MOV	A,D
  0FF7'   B7                    	ORA	A
  0FF8'   CA 1013'              	JZ	VHD_C		; the text stays
  0FFB'   4A                    	MOV	C,D
  0FFC'   CD 1105'              	CALL	HTFQ		; HL -> the line that row is in, C = which of its
  0FFF'   79                    	MOV	A,C
  1000'   B7                    	ORA	A
  1001'   CA 1013'              	JZ	VHD_C
  1004'   BA                    	CMP	D
  1005'   C2 1010'              	JNZ	VHD_R
  1008'   7E                    	MOV	A,M		; the top line still: past all of it
  1009'   91                    	SUB	C
  100A'   83                    	ADD	E
  100B'   5F                    	MOV	E,A
  100C'   23                    	INX	H
  100D'   C3 1013'              	JMP	VHD_C
  1010'                         VHD_R:
  1010'   7B                    	MOV	A,E		; part of the way down a line: its start
  1011'   91                    	SUB	C
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  1012'   5F                    	MOV	E,A
  1013'                         VHD_C:
  1013'   22 2E13'              	SHLD	HFTP
  1016'   3A 0000*              	LDA	CSUB		; the cursor: E rows down from the one it is on
  1019'   83                    	ADD	E
  101A'   4F                    	MOV	C,A
  101B'   3A 2E16'              	LDA	HTCUR
  101E'   CD 10E7'              	CALL	HTPT
  1021'   CD 1105'              	CALL	HTFQ
  1024'   D2 1028'              	JNC	HFEND
  1027'   2B                    	DCX	H		; the file ends first: its last line
                                ;HFEND -- ^D / ^U: HL -> the rows of the line the cursor goes to.
  1028'                         HFEND:
  1028'   EB                    	XCHG
  1029'   2A 2E13'              	LHLD	HFTP
  102C'   EB                    	XCHG
                                ;HTLAND -- the cursor to the line whose rows HL points at, DE -> those of the
                                ; line the screen is to start with (never one under it); first non-blank.
  102D'                         HTLAND:
  102D'   E5                    	PUSH	H
  102E'   D5                    	PUSH	D
  102F'   CD 10FA'              	CALL	HTGO
  1032'   D1                    	POP	D
  1033'   E1                    	POP	H
  1034'   CD 0000*              	CALL	SUBHD		; HL = the lines between them
  1037'   7C                    	MOV	A,H
  1038'   B7                    	ORA	A
  1039'   7D                    	MOV	A,L
  103A'   CA 103E'              	JZ	HL_SET
  103D'   AF                    	XRA	A
  103E'                         HL_SET:
  103E'   CD 0DEC'              	CALL	SETRWT
  1041'   C3 0900'              	JMP	FNBLNK
                                
                                ;--- the top line is taller than the screen, and the cursor in it: vim goes
                                ;    on scrolling until the next line is at the top, the cursor keeping its
                                ;    row of the screen ---
  1044'                         VHD_TL:
  1044'   3A 0000*              	LDA	SKIPR
  1047'   47                    	MOV	B,A
  1048'   3A 0000*              	LDA	CSUB
  104B'   90                    	SUB	B		; A = that row
  104C'   F5                    	PUSH	PSW
  104D'   21 0001               	LXI	H,1
  1050'   CD 09BB'              	CALL	JCORE		; (on the last line: nowhere to go)
  1053'   F1                    	POP	PSW
  1054'   4F                    	MOV	C,A
  1055'   C5                    	PUSH	B
  1056'   0C                    	INR	C
  1057'   06 00                 	MVI	B,0
  1059'   CD 10DB'              	CALL	HTRB		; HL -> the rows of the line now the cursor's
  105C'   22 2E13'              	SHLD	HFTP
  105F'   D1                    	POP	D
  1060'   4B                    	MOV	C,E
  1061'   CD 1105'              	CALL	HTFQ
  1064'   D2 1028'              	JNC	HFEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  1067'   2B                    	DCX	H
  1068'   C3 1028'              	JMP	HFEND
                                
                                ;VC_HFUP -- '^U': the text and the cursor up HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text
                                ; stops at the first line, the cursor goes on.  Where the rows end part of
                                ; the way up a line, the top line is the one under it and the cursor moves as
                                ; many rows less -- but the line itself, and as many more, when it is the
                                ; first one back.  On the first line nothing moves, the column included.
  106B'                         VC_HFUP:
  106B'   CD 0807'              	CALL	SETMOV
  106E'   CD 11E9'              	CALL	HFCNT		; HFN = the rows
  1071'   CD 11C9'              	CALL	ONFST
  1074'   C8                    	RZ			; the cursor is on the first line
  1075'   0E 01                 	MVI	C,1
  1077'   3A 2E12'              	LDA	HFN
  107A'   CD 10C6'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  107D'   43                    	MOV	B,E
  107E'   3A 2E12'              	LDA	HFN
  1081'   4F                    	MOV	C,A
  1082'   5F                    	MOV	E,A		; E = the rows the cursor moves
  1083'   CD 1116'              	CALL	HTBQ		; HL -> the line that row is in, C = its rows
  1086'   DA 10A1'              	JC	VHU_C		;   above it; or the file's first line
  1089'   79                    	MOV	A,C
  108A'   B7                    	ORA	A
  108B'   CA 10A1'              	JZ	VHU_C
  108E'   3A 2E17'              	LDA	HTTP
  1091'   3D                    	DCR	A
  1092'   B8                    	CMP	B
  1093'   CA 109E'              	JZ	VHU_F
  1096'   7B                    	MOV	A,E		; part of the way up a line: the one under it
  1097'   96                    	SUB	M
  1098'   81                    	ADD	C
  1099'   5F                    	MOV	E,A
  109A'   23                    	INX	H
  109B'   C3 10A1'              	JMP	VHU_C
  109E'                         VHU_F:
  109E'   7B                    	MOV	A,E		; ... the first line back: all of it
  109F'   81                    	ADD	C
  10A0'   5F                    	MOV	E,A
  10A1'                         VHU_C:
  10A1'   22 2E13'              	SHLD	HFTP
  10A4'   4B                    	MOV	C,E
  10A5'   3A 2E16'              	LDA	HTCUR
  10A8'   CD 10E7'              	CALL	HTPT		; HL -> the cursor line's rows, E = lines above it
  10AB'   3A 0000*              	LDA	CSUB
  10AE'   57                    	MOV	D,A
  10AF'   79                    	MOV	A,C
  10B0'   92                    	SUB	D		; the rows to go, less those of its own line above it
  10B1'   DA 1028'              	JC	HFEND
  10B4'   CA 1028'              	JZ	HFEND
  10B7'   4F                    	MOV	C,A
  10B8'   43                    	MOV	B,E
  10B9'   CD 1116'              	CALL	HTBQ		; (off the top: the file's first line)
  10BC'   C3 1028'              	JMP	HFEND
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
                                ;HTSCR -- the table as the last layout left it, which is the screen's own:
                                ; HL, B and E as HTSET gives them, and nothing measured.
  10BF'                         HTSCR:
  10BF'   CD 0DCD'              	CALL	CURRW
  10C2'   47                    	MOV	B,A
  10C3'   C3 10D1'              	JMP	HS_TP
  10C6'                         HTSET:
  10C6'   47                    	MOV	B,A
  10C7'   CD 0DCD'              	CALL	CURRW		; (keeps BC)
  10CA'   F5                    	PUSH	PSW
  10CB'   80                    	ADD	B
  10CC'   47                    	MOV	B,A
  10CD'   CD 10DB'              	CALL	HTRB
  10D0'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  10D1'                         HS_TP:
  10D1'   3A 2E16'              	LDA	HTCUR
  10D4'   90                    	SUB	B
  10D5'   32 2E17'              	STA	HTTP
  10D8'   C3 10E7'              	JMP	HTPT
  10DB'                         HTRB:
  10DB'   CD 12B9'              	CALL	ZSAVE
  10DE'   CD 0000*              	CALL	HTBLD
  10E1'   CD 12CC'              	CALL	ZREST
  10E4'   3A 2E16'              	LDA	HTCUR
  10E7'                         HTPT:
  10E7'   5F                    	MOV	E,A
  10E8'   16 00                 	MVI	D,0
  10EA'   21 0000*              	LXI	H,HTAB
  10ED'   19                    	DAD	D
  10EE'   3A 2E15'              	LDA	HTN
  10F1'   93                    	SUB	E
  10F2'   47                    	MOV	B,A
  10F3'   C9                    	RET
                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  10F4'                         HTIX:
  10F4'   11 0000*              	LXI	D,HTAB
  10F7'   7D                    	MOV	A,L
  10F8'   93                    	SUB	E
  10F9'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
  10FA'                         HTGO:
  10FA'   CD 10F4'              	CALL	HTIX
  10FD'   47                    	MOV	B,A
  10FE'   3A 2E16'              	LDA	HTCUR
  1101'   90                    	SUB	B		; A = the lines up to it
  1102'   C3 0E04'              	JMP	MR_GO
                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  1105'                         HTFQ:
  1105'   78                    	MOV	A,B
  1106'   B7                    	ORA	A
  1107'   37                    	STC
  1108'   C8                    	RZ
  1109'   79                    	MOV	A,C
  110A'   96                    	SUB	M
  110B'   DA 1114'              	JC	HF_IN
  110E'   4F                    	MOV	C,A
  110F'   23                    	INX	H
  1110'   05                    	DCR	B
  1111'   C3 1105'              	JMP	HTFQ
  1114'                         HF_IN:
  1114'   B7                    	ORA	A
  1115'   C9                    	RET
                                
                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
                                ;        the table starts first (HL -> its first entry, C = the rows short)
  1116'                         HTBQ:
  1116'   78                    	MOV	A,B
  1117'   B7                    	ORA	A
  1118'   37                    	STC
  1119'   C8                    	RZ
  111A'   2B                    	DCX	H
  111B'   05                    	DCR	B
  111C'   7E                    	MOV	A,M
  111D'   91                    	SUB	C
  111E'   D2 1127'              	JNC	HQ_IN
  1121'   2F                    	CMA
  1122'   3C                    	INR	A
  1123'   4F                    	MOV	C,A
  1124'   C3 1116'              	JMP	HTBQ
  1127'                         HQ_IN:
  1127'   4F                    	MOV	C,A
  1128'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
                                ; Keeps HL, B, DE.
  1129'                         RWQ:
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  1129'   0E 64                 	MVI	C,100
  112B'   3A 2E1B'              	LDA	RWR+1
  112E'   B7                    	ORA	A
  112F'   C0                    	RNZ
  1130'   3A 2E1A'              	LDA	RWR
  1133'   B9                    	CMP	C
  1134'   D0                    	RNC
  1135'   4F                    	MOV	C,A
  1136'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  1137'                         RWSUB:
  1137'   E5                    	PUSH	H
  1138'   5F                    	MOV	E,A
  1139'   16 00                 	MVI	D,0
  113B'   2A 2E1A'              	LHLD	RWR
  113E'   CD 0000*              	CALL	SUBHD
  1141'   22 2E1A'              	SHLD	RWR
  1144'   E1                    	POP	H
  1145'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
                                ; whose entry HL points at (B = the entries from it on), however far that is:
                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  1146'                         RWFWD:
  1146'   CD 1129'              	CALL	RWQ
  1149'   51                    	MOV	D,C
  114A'   CD 1105'              	CALL	HTFQ
  114D'   F5                    	PUSH	PSW
  114E'   7A                    	MOV	A,D
  114F'   91                    	SUB	C		; the rows that took it to that line's first
  1150'   CD 1137'              	CALL	RWSUB
  1153'   F1                    	POP	PSW
  1154'   DA 1168'              	JC	RF_OFF
  1157'   3A 2E1B'              	LDA	RWR+1		; is what is left inside this line?
  115A'   B7                    	ORA	A
  115B'   C2 1172'              	JNZ	RF_GO
  115E'   3A 2E1A'              	LDA	RWR
  1161'   BE                    	CMP	M
  1162'   D2 1172'              	JNC	RF_GO
  1165'   4F                    	MOV	C,A
  1166'   B7                    	ORA	A
  1167'   C9                    	RET
  1168'                         RF_OFF:
  1168'   3A 2E18'              	LDA	HTEOF
  116B'   B7                    	ORA	A
  116C'   CA 1172'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  116F'   2B                    	DCX	H
  1170'   37                    	STC
  1171'   C9                    	RET
  1172'                         RF_GO:
  1172'   CD 10FA'              	CALL	HTGO
  1175'   3E 01                 	MVI	A,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1177'   32 2E1C'              	STA	RWMV
  117A'   CD 1129'              	CALL	RWQ
  117D'   0C                    	INR	C
  117E'   06 00                 	MVI	B,0
  1180'   CD 10DB'              	CALL	HTRB
  1183'   C3 1146'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  1186'                         RWBAK:
  1186'   CD 1129'              	CALL	RWQ
  1189'   51                    	MOV	D,C
  118A'   CD 1116'              	CALL	HTBQ
  118D'   DA 11AA'              	JC	RB_OFF
  1190'   7A                    	MOV	A,D
  1191'   81                    	ADD	C
  1192'   5F                    	MOV	E,A		; E = the rows up to that line's first
  1193'   3A 2E1B'              	LDA	RWR+1
  1196'   B7                    	ORA	A
  1197'   C2 11A6'              	JNZ	RB_ON
  119A'   3A 2E1A'              	LDA	RWR
  119D'   57                    	MOV	D,A
  119E'   7B                    	MOV	A,E
  119F'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  11A0'   DA 11A6'              	JC	RB_ON
  11A3'   4F                    	MOV	C,A
  11A4'   B7                    	ORA	A
  11A5'   C9                    	RET
  11A6'                         RB_ON:
  11A6'   7B                    	MOV	A,E
  11A7'   C3 11B1'              	JMP	RB_GO
  11AA'                         RB_OFF:
  11AA'   3A 2E19'              	LDA	HTBOF
  11AD'   0F                    	RRC			; CY: that is the file's first line
  11AE'   D8                    	RC
  11AF'   7A                    	MOV	A,D
  11B0'   91                    	SUB	C
  11B1'                         RB_GO:
  11B1'   CD 1137'              	CALL	RWSUB
  11B4'   CD 10FA'              	CALL	HTGO
  11B7'   3E 01                 	MVI	A,1
  11B9'   32 2E1C'              	STA	RWMV
  11BC'   CD 1129'              	CALL	RWQ
  11BF'   41                    	MOV	B,C
  11C0'   0E 01                 	MVI	C,1
  11C2'   CD 10DB'              	CALL	HTRB
  11C5'   43                    	MOV	B,E
  11C6'   C3 1186'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  11C9'                         ONFST:
  11C9'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  11CA'   2A 0000*              	LHLD	OUTPOS
  11CD'   7C                    	MOV	A,H
  11CE'   B5                    	ORA	L
  11CF'   C2 11E7'              	JNZ	OF_RET
  11D2'   2A 0000*              	LHLD	TXTBEG
  11D5'   EB                    	XCHG			; DE = TXTBEG
  11D6'   2A 0000*              	LHLD	GAPBEG
  11D9'                         OF_LP:
  11D9'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  11DC'   CA 11E7'              	JZ	OF_RET
  11DF'   2B                    	DCX	H
  11E0'   7E                    	MOV	A,M
  11E1'   FE 0A                 	CPI	LF
  11E3'   C2 11D9'              	JNZ	OF_LP
  11E6'   B7                    	ORA	A		; NZ
  11E7'                         OF_RET:
  11E7'   E1                    	POP	H
  11E8'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  11E9'                         HFCNT:
  11E9'   2A 2E03'              	LHLD	CMDCNT
  11EC'   7C                    	MOV	A,H
  11ED'   B5                    	ORA	L
  11EE'   CA 1205'              	JZ	HFC_AM
  11F1'   CD 0732'              	CALL	GETCNT		; HL = count; clears it
  11F4'   3A 0000*              	LDA	NEDIT
  11F7'   5F                    	MOV	E,A
  11F8'   16 00                 	MVI	D,0
  11FA'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  11FD'   D2 1201'              	JNC	HFC_ST
  1200'   EB                    	XCHG			; HL = NEDIT
  1201'                         HFC_ST:
  1201'   7D                    	MOV	A,L
  1202'   32 2E11'              	STA	HFAMT
  1205'                         HFC_AM:
  1205'   3A 2E11'              	LDA	HFAMT
  1208'   B7                    	ORA	A
  1209'   C2 1216'              	JNZ	HFC_HL
  120C'   3A 0000*              	LDA	NEDIT
  120F'   B7                    	ORA	A
  1210'   1F                    	RAR
  1211'   B7                    	ORA	A
  1212'   C2 1216'              	JNZ	HFC_HL
  1215'   3C                    	INR	A		; at least one row
  1216'                         HFC_HL:
  1216'   32 2E12'              	STA	HFN
  1219'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  121A'                         VC_REDR:
  121A'   C3 0732'              	JMP	GETCNT
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (PLACE) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  121D'                         VC_G:
  121D'   CD 0807'              	CALL	SETMOV
  1220'   CD 12DF'              	CALL	GZONE		; the screen's top line, before the move
  1223'   CD 075B'              	CALL	BRKON		; ... and an ESC may stop it from here on
  1226'   2A 2E03'              	LHLD	CMDCNT
  1229'   7C                    	MOV	A,H
  122A'   B5                    	ORA	L
  122B'   C2 123E'              	JNZ	VG_N
  122E'   AF                    	XRA	A		; forward
  122F'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  1232'   CD 0798'              	CALL	BRKOFF
  1235'   DA 07B0'              	JC	BRKBAK
  1238'   CD 0AEF'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  123B'   C3 12F7'              	JMP	GPLACE
  123E'                         VG_N:
  123E'   CD 0732'              	CALL	GETCNT		; HL = target line (1-based)
  1241'                         VG_LN:
  1241'   CD 124D'              	CALL	GOLN
  1244'   CD 0798'              	CALL	BRKOFF
  1247'   DA 07B0'              	JC	BRKBAK
  124A'   C3 12F7'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  124D'                         GOLN:
  124D'   E5                    	PUSH	H
  124E'   CD 0000*              	CALL	CNTLF
  1251'   23                    	INX	H		; HL = the cursor's line
  1252'   D1                    	POP	D		; DE = the line wanted
  1253'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  1256'   DA 1261'              	JC	GLN_BK
  1259'   EB                    	XCHG
  125A'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  125D'   AF                    	XRA	A
  125E'   C3 1266'              	JMP	GLN_MV
  1261'                         GLN_BK:
  1261'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  1264'   3E FF                 	MVI	A,0FFH
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  1266'                         GLN_MV:
  1266'   CD 0000*              	CALL	MVLIND
  1269'   CD 0AE9'              	CALL	ATEOF
  126C'   DC 0AEF'              	CC	LASTLN		; past the last line: onto it
  126F'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  1270'                         VC_LG:
  1270'   CD 0807'              	CALL	SETMOV
  1273'   3A 2E38'              	LDA	GSAVE
  1276'   B7                    	ORA	A
  1277'   C2 1280'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  127A'   3E 01                 	MVI	A,PG
  127C'   32 2E37'              	STA	GPEND
  127F'   C9                    	RET
  1280'                         VLG_GG:
  1280'   CD 12DF'              	CALL	GZONE
  1283'   CD 075B'              	CALL	BRKON
  1286'   CD 0732'              	CALL	GETCNT		; HL = target line (no count: 1)
  1289'   C3 1241'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  128C'                         SUB24:
  128C'   4F                    	MOV	C,A
  128D'   7D                    	MOV	A,L
  128E'   93                    	SUB	E
  128F'   6F                    	MOV	L,A
  1290'   7C                    	MOV	A,H
  1291'   9A                    	SBB	D
  1292'   67                    	MOV	H,A
  1293'   79                    	MOV	A,C
  1294'   98                    	SBB	B
  1295'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  1296'                         CURFP:
  1296'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  1299'                         FPOS:
  1299'   C5                    	PUSH	B
  129A'   D5                    	PUSH	D
  129B'   EB                    	XCHG
  129C'   2A 0000*              	LHLD	TXTBEG
  129F'   EB                    	XCHG
  12A0'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  12A3'   EB                    	XCHG			; DE = that
  12A4'   2A 0000*              	LHLD	OUTPOS
  12A7'   7C                    	MOV	A,H
  12A8'   B7                    	ORA	A		; CY = 0
  12A9'   1F                    	RAR
  12AA'   47                    	MOV	B,A
  12AB'   7D                    	MOV	A,L
  12AC'   1F                    	RAR
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12AD'   67                    	MOV	H,A
  12AE'   3E 00                 	MVI	A,0
  12B0'   1F                    	RAR
  12B1'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  12B2'   19                    	DAD	D
  12B3'   78                    	MOV	A,B
  12B4'   CE 00                 	ACI	0		; A:HL = the position
  12B6'   D1                    	POP	D
  12B7'   C1                    	POP	B
  12B8'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  12B9'                         ZSAVE:
  12B9'   2A 2E03'              	LHLD	CMDCNT
  12BC'   22 2E74'              	SHLD	ZSVCNT
  12BF'   2A 0000*              	LHLD	AUXCNT
  12C2'   22 2E76'              	SHLD	ZSVAUX
  12C5'   3A 0000*              	LDA	DIRFLG
  12C8'   32 2E78'              	STA	ZSVDIR
  12CB'   C9                    	RET
  12CC'                         ZREST:
  12CC'   2A 2E74'              	LHLD	ZSVCNT
  12CF'   22 2E03'              	SHLD	CMDCNT
  12D2'   2A 2E76'              	LHLD	ZSVAUX
  12D5'   22 0000*              	SHLD	AUXCNT
  12D8'   3A 2E78'              	LDA	ZSVDIR
  12DB'   32 0000*              	STA	DIRFLG
  12DE'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  12DF'                         GZONE:
  12DF'   CD 12B9'              	CALL	ZSAVE
  12E2'   CD 0DCD'              	CALL	CURRW
  12E5'   6F                    	MOV	L,A
  12E6'   26 00                 	MVI	H,0
  12E8'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  12EB'   CD 1299'              	CALL	FPOS
  12EE'   22 0000*              	SHLD	ZTOP
  12F1'   32 0002*              	STA	ZTOP+2
  12F4'   C3 12CC'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  12F7'                         GPLACE:
  12F7'   CD 12B9'              	CALL	ZSAVE
  12FA'   CD 1296'              	CALL	CURFP
  12FD'   EB                    	XCHG
  12FE'   2A 0000*              	LHLD	ZTOP
  1301'   EB                    	XCHG
  1302'   4F                    	MOV	C,A		; C:HL = the target's position
  1303'   3A 0002*              	LDA	ZTOP+2
  1306'   47                    	MOV	B,A		; B:DE = the top's
  1307'   79                    	MOV	A,C
  1308'   CD 128C'              	CALL	SUB24
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  130B'   22 2E71'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  130E'   DA 1348'              	JC	GP_UP
  1311'   B7                    	ORA	A
  1312'   C2 138E'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  1315'   3A 0000*              	LDA	NEDIT
  1318'   87                    	ADD	A
  1319'   3C                    	INR	A
  131A'   6F                    	MOV	L,A
  131B'   26 00                 	MVI	H,0
  131D'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  1320'   CD 072B'              	CALL	GBSUB		; HL = bytes from there to the target
  1323'   EB                    	XCHG
  1324'   2A 2E71'              	LHLD	ZDIF		; HL = bytes from the top to the target
  1327'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  132A'   DA 138E'              	JC	GP_MID
  132D'   CD 072B'              	CALL	GBSUB		; HL = the top line's start (resident)
  1330'   01 0000               	LXI	B,0		; BC = lines from the top
  1333'                         GP_CNT:
  1333'   7A                    	MOV	A,D
  1334'   B3                    	ORA	E
  1335'   CA 1344'              	JZ	GP_DN
  1338'   7E                    	MOV	A,M
  1339'   23                    	INX	H
  133A'   1B                    	DCX	D
  133B'   FE 0A                 	CPI	LF
  133D'   C2 1333'              	JNZ	GP_CNT
  1340'   03                    	INX	B
  1341'   C3 1333'              	JMP	GP_CNT
  1344'                         GP_DN:
  1344'   79                    	MOV	A,C		; the lines from the top one to it
  1345'   C3 13B8'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  1348'                         GP_UP:
  1348'   3C                    	INR	A
  1349'   C2 138E'              	JNZ	GP_MID		; 64K bytes or more above
  134C'   2A 2E71'              	LHLD	ZDIF
  134F'   EB                    	XCHG
  1350'   21 0000               	LXI	H,0
  1353'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  1356'   7C                    	MOV	A,H
  1357'   B5                    	ORA	L
  1358'   CA 138E'              	JZ	GP_MID		; exactly 64K
  135B'   EB                    	XCHG			; DE = bytes to read
  135C'   AF                    	XRA	A
  135D'   32 2E73'              	STA	ZLF
  1360'   CD 0000*              	CALL	RGET0
  1363'                         GP_RD:
  1363'   CD 0000*              	CALL	RDGET		; (keeps DE)
  1366'   DA 138E'              	JC	GP_MID
  1369'   FE 0A                 	CPI	LF
  136B'   C2 137F'              	JNZ	GP_RN
  136E'   3A 0000*              	LDA	NEDIT
  1371'   B7                    	ORA	A
  1372'   1F                    	RAR
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  1373'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  1375'   E5                    	PUSH	H
  1376'   21 2E73'              	LXI	H,ZLF
  1379'   34                    	INR	M
  137A'   BE                    	CMP	M		; CY iff more lines than that
  137B'   E1                    	POP	H
  137C'   DA 138E'              	JC	GP_MID
  137F'                         GP_RN:
  137F'   1B                    	DCX	D
  1380'   7A                    	MOV	A,D
  1381'   B3                    	ORA	E
  1382'   C2 1363'              	JNZ	GP_RD
  1385'   3E 01                 	MVI	A,PL_SET	; the top row
  1387'   32 0000*              	STA	PLACE
  138A'   AF                    	XRA	A
  138B'   C3 1398'              	JMP	GP_SET
  138E'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  138E'   3E 02                 	MVI	A,PL_MID
  1390'   32 0000*              	STA	PLACE		; mid-screen, as the rows fall
  1393'   3A 0000*              	LDA	NEDIT
  1396'   B7                    	ORA	A
  1397'   1F                    	RAR			; (no more lines above it than this)
  1398'                         GP_SET:
  1398'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  1399'   26 00                 	MVI	H,0
  139B'   22 0000*              	SHLD	WINROW
  139E'   21 0000               	LXI	H,0
  13A1'   22 0000*              	SHLD	LNDLT
  13A4'   CD 0844'              	CALL	SETFUL		; the window may have paged: full repaint
  13A7'                         GP_FIN:
  13A7'   CD 12CC'              	CALL	ZREST
  13AA'   3A 2E9C'              	LDA	GPKEEP
  13AD'   B7                    	ORA	A
  13AE'   CA 0900'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  13B1'   AF                    	XRA	A
  13B2'   32 2E9C'              	STA	GPKEEP
  13B5'   C3 05BD'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
                                ; adds LNDLT to it and arrives at the same line.
  13B8'                         GP_ONS:
  13B8'   6F                    	MOV	L,A
  13B9'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  13BB'   EB                    	XCHG
  13BC'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  13BF'   EB                    	XCHG
  13C0'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  13C3'   22 0000*              	SHLD	LNDLT
  13C6'   3E 01                 	MVI	A,R_MOVE
  13C8'   32 2E07'              	STA	RINTENT
  13CB'   C3 13A7'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  13CE'                         OPPEND:
  13CE'   AF                    	XRA	A
  13CF'   32 2E3D'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  13D2'   3A 2E3A'              	LDA	PSAVE
  13D5'   FE 63                 	CPI	'c'
  13D7'   C2 13F4'              	JNZ	OPP_ND
  13DA'   79                    	MOV	A,C
  13DB'   FE 77                 	CPI	'w'
  13DD'   CA 13E5'              	JZ	OPP_W
  13E0'   FE 57                 	CPI	'W'
  13E2'   C2 13F4'              	JNZ	OPP_ND
  13E5'                         OPP_W:
  13E5'   CD 15C7'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  13E8'   DA 13F4'              	JC	OPP_ND
  13EB'   79                    	MOV	A,C
  13EC'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  13EE'   4F                    	MOV	C,A
  13EF'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  13F1'   32 2E3D'              	STA	CWEOL		;   char for the next word's: see ESTEP
  13F4'                         OPP_ND:
  13F4'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  13F5'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  13F7'   C2 140B'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  13FA'   CD 01F9'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  13FD'   DA 149B'              	JC	OPABRT
  1400'   79                    	MOV	A,C
  1401'   FE 67                 	CPI	'g'
  1403'   C2 149B'              	JNZ	OPABRT
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  1406'   3E 01                 	MVI	A,PG
  1408'   32 2E38'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  140B'                         OPP_NG:
  140B'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  140C'   21 2E3A'              	LXI	H,PSAVE
  140F'   BE                    	CMP	M
  1410'   CA 15E8'              	JZ	OPLINE
  1413'   79                    	MOV	A,C		; (OPCLS classifies the key)
  1414'   CD 15FE'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1417'   DA 149B'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  141A'   32 2E3C'              	STA	OPCLSV
  141D'   47                    	MOV	B,A		; B = the class
  141E'   3A 2E3A'              	LDA	PSAVE
  1421'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  1423'   C2 142F'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  1426'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  1427'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  1429'   C2 1451'              	JNZ	OPP_GO
  142C'   C3 143A'              	JMP	OPP_NO
  142F'                         OPP_NC:
  142F'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  1431'   C2 1451'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  1434'   78                    	MOV	A,B		;   a charwise register would need a type flag
  1435'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  1437'   CA 1451'              	JZ	OPP_GO		;   within a line -- neither of which is built
  143A'                         OPP_NO:
  143A'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  143B'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  143D'   CA 144B'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  1440'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  1442'   CA 144B'              	JZ	OPP_SW		;   so swallow it before dropping the command
  1445'   CD 0326'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  1448'   C2 149B'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  144B'                         OPP_SW:
  144B'   CD 01F9'              	CALL	MKGETK
  144E'   C3 149B'              	JMP	OPABRT
  1451'                         OPP_GO:
  1451'   AF                    	XRA	A
  1452'   32 2E10'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  1455'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  1458'   22 2E3E'              	SHLD	OPSTA
  145B'   C5                    	PUSH	B
  145C'   21 2E42'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  145F'   CD 0429'              	CALL	FPSTO		;   only good until the motion pages the window
  1462'   3A 2E3C'              	LDA	OPCLSV
  1465'   FE 02                 	CPI	2
  1467'   CC 149E'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  146A'   C1                    	POP	B
  146B'   21 2D4A'              	LXI	H,CMDTAB
  146E'   CD 00C3'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1471'   3A 2E3A'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1474'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1475'   CA 0807'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  1478'   CD 14CA'              	CALL	OPSFIX		; where the start is in the window NOW
  147B'   D2 14E6'              	JNC	OPPGD		; ... and it is not: the motion paged it out
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  147E'   22 2E3E'              	SHLD	OPSTA
  1481'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1484'   22 2E40'              	SHLD	OPEND2
  1487'   3A 2E3A'              	LDA	PSAVE
  148A'   FE 79                 	CPI	'y'
  148C'   CA 1B8E'              	JZ	OPYANK		; a yank takes the span without losing it
  148F'   CD 1639'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  1492'   3A 2E3A'              	LDA	PSAVE
  1495'   FE 63                 	CPI	'c'
  1497'   C0                    	RNZ
  1498'   C3 1942'              	JMP	SETINS
  149B'                         OPABRT:				; not a motion -> the operator is dropped and
  149B'   C3 00A6'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  149E'                         OPENDS:
  149E'   2A 2E3E'              	LHLD	OPSTA
  14A1'   CD 0624'              	CALL	BOL
  14A4'   11 2E45'              	LXI	D,OPSLO
  14A7'   CD 14BC'              	CALL	OPE_ST
  14AA'   2A 2E3E'              	LHLD	OPSTA
  14AD'   CD 06BB'              	CALL	NLSTART
  14B0'   11 2E48'              	LXI	D,OPSHI
  14B3'   CD 14BC'              	CALL	OPE_ST
  14B6'   2A 2E3E'              	LHLD	OPSTA
  14B9'   C3 0000*              	JMP	GOTO
  14BC'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  14BC'   D5                    	PUSH	D
  14BD'   CD 0000*              	CALL	GOTO
  14C0'   E1                    	POP	H
  14C1'   C3 0429'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  14C4'                         CURBD:
  14C4'   CD 1296'              	CALL	CURFP
  14C7'   EB                    	XCHG
  14C8'   47                    	MOV	B,A
  14C9'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  14CA'                         OPSFIX:
  14CA'   21 2E42'              	LXI	H,OPSFP
  14CD'   CD 03DC'              	CALL	MKLOAD
  14D0'   CD 14C4'              	CALL	CURBD
  14D3'   2A 2EA6'              	LHLD	MKPOS
  14D6'   3A 2EA8'              	LDA	MKPOS+2
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  14D9'   CD 128C'              	CALL	SUB24
  14DC'   B4                    	ORA	H
  14DD'   B5                    	ORA	L
  14DE'   C2 03E9'              	JNZ	MKWIN
  14E1'   CD 0000*              	CALL	CUROFF
  14E4'   37                    	STC
  14E5'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  14E6'                         OPPGD:
  14E6'   47                    	MOV	B,A
  14E7'   3A 2E3C'              	LDA	OPCLSV
  14EA'   FE 02                 	CPI	2
  14EC'   C2 15A8'              	JNZ	OPG_NO
  14EF'   3A 2E3A'              	LDA	PSAVE
  14F2'   FE 64                 	CPI	'd'
  14F4'   C2 15A8'              	JNZ	OPG_NO
  14F7'   04                    	INR	B
  14F8'   CA 1507'              	JZ	OPG_FW
  14FB'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  14FE'   CD 0624'              	CALL	BOL		;   and the high end is OPSHI as it stands
  1501'   CD 0000*              	CALL	GOTO
  1504'   C3 151F'              	JMP	OPG_GO
  1507'                         OPG_FW:
  1507'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  150A'   CD 06BB'              	CALL	NLSTART		;   landed on, and the low one is where the
  150D'   11 2E48'              	LXI	D,OPSHI		;   start line began
  1510'   CD 14BC'              	CALL	OPE_ST
  1513'   21 2E45'              	LXI	H,OPSLO
  1516'   CD 03DC'              	CALL	MKLOAD
  1519'   CD 03A9'              	CALL	MKPAGE
  151C'   CD 0000*              	CALL	GOTO
  151F'                         OPG_GO:
  151F'   CD 14C4'              	CALL	CURBD
  1522'   2A 2E48'              	LHLD	OPSHI
  1525'   3A 2E4A'              	LDA	OPSHI+2
  1528'   CD 128C'              	CALL	SUB24		; A:HL = the bytes to take
  152B'                         OPG_SV:
  152B'   22 2E4B'              	SHLD	OPTOGO
  152E'   32 2E4D'              	STA	OPTOGO+2
  1531'                         OPG_NX:
  1531'   CD 070E'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  1534'   CD 0000*              	CALL	SUBHD
  1537'   EB                    	XCHG			; DE = what the window holds past the cursor
  1538'   2A 2E4B'              	LHLD	OPTOGO
  153B'   3A 2E4D'              	LDA	OPTOGO+2
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  153E'   B7                    	ORA	A
  153F'   C2 1572'              	JNZ	OPG_PG		; 64K or more to go
  1542'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  1545'   DA 1572'              	JC	OPG_PG
  1548'   CA 1572'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  154B'                         OPG_FN:				; the rest of it is here
  154B'   E5                    	PUSH	H
  154C'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  154F'   CD 0000*              	CALL	CUROFF
  1552'   22 2E4E'              	SHLD	OPLO
  1555'   D1                    	POP	D
  1556'   19                    	DAD	D
  1557'   22 2E50'              	SHLD	OPHI
  155A'   CD 176C'              	CALL	OPDSPN
  155D'   CD 0AE9'              	CALL	ATEOF
  1560'   D2 15C1'              	JNC	OPMID
  1563'   CD 11C9'              	CALL	ONFST		; deleted to the end of the file: onto the new
  1566'   CA 15C1'              	JZ	OPMID		;   last line, if there is one -- and the pager
  1569'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  156C'   CD 0000*              	CALL	SETBWD
  156F'   C3 15C1'              	JMP	OPMID
  1572'                         OPG_PG:
  1572'   7A                    	MOV	A,D
  1573'   B3                    	ORA	E
  1574'   C2 158D'              	JNZ	OPG_DL
  1577'   CD 0AE9'              	CALL	ATEOF		; nothing held past the cursor
  157A'   21 0000               	LXI	H,0
  157D'   DA 154B'              	JC	OPG_FN		; ... and no more to come: the file ran out
  1580'   2B                    	DCX	H
  1581'   CD 0000*              	CALL	SETC0
  1584'   CD 0000*              	CALL	GOLINE
  1587'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  158A'   C3 1531'              	JMP	OPG_NX
  158D'                         OPG_DL:
  158D'   D5                    	PUSH	D
  158E'   21 FFFF               	LXI	H,0FFFFH
  1591'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1594'   E1                    	POP	H
  1595'   E5                    	PUSH	H
  1596'   CD 0000*              	CALL	DELFWD
  1599'   D1                    	POP	D
  159A'   06 00                 	MVI	B,0
  159C'   2A 2E4B'              	LHLD	OPTOGO
  159F'   3A 2E4D'              	LDA	OPTOGO+2
  15A2'   CD 128C'              	CALL	SUB24
  15A5'   C3 152B'              	JMP	OPG_SV
  15A8'                         OPG_NO:
  15A8'   0E 07                 	MVI	C,BEL
  15AA'   CD 0000*              	CALL	BCONOU
  15AD'                         OPG_HM:				; the cursor back where the command found it
  15AD'   21 2E42'              	LXI	H,OPSFP
  15B0'   CD 03DC'              	CALL	MKLOAD
  15B3'   CD 03A9'              	CALL	MKPAGE
  15B6'   CD 0000*              	CALL	GOTO
  15B9'   AF                    	XRA	A
  15BA'   32 2E3A'              	STA	PSAVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  15BD'   3C                    	INR	A
  15BE'   32 2E9C'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  15C1'                         OPMID:
  15C1'   CD 12B9'              	CALL	ZSAVE
  15C4'   C3 138E'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  15C7'                         ONWHIT:
  15C7'   CD 070E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  15CA'   CA 15E6'              	JZ	OW_YES
  15CD'   CD 0719'              	CALL	CURCHR		; A = the char under the cursor
  15D0'   FE 20                 	CPI	' '
  15D2'   CA 15E6'              	JZ	OW_YES
  15D5'   FE 09                 	CPI	TAB
  15D7'   CA 15E6'              	JZ	OW_YES
  15DA'   FE 0D                 	CPI	CR
  15DC'   CA 15E6'              	JZ	OW_YES
  15DF'   FE 0A                 	CPI	LF
  15E1'   CA 15E6'              	JZ	OW_YES
  15E4'   B7                    	ORA	A		; a char to change: CY clear
  15E5'   C9                    	RET
  15E6'                         OW_YES:
  15E6'   37                    	STC
  15E7'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  15E8'                         OPLINE:
  15E8'   3A 2E3A'              	LDA	PSAVE
  15EB'   FE 63                 	CPI	'c'
  15ED'   CA 0807'              	JZ	SETMOV
  15F0'   FE 79                 	CPI	'y'
  15F2'   CA 1B6D'              	JZ	VY_YY
  15F5'   21 2E42'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  15F8'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  15FB'   C3 1AE3'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  15FE'                         OPCLS:
  15FE'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  1600'   CA 160D'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  1603'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  1605'   C2 1621'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1608'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  160A'   C3 160F'              	JMP	OPC_FK
  160D'                         OPC_SEM:
  160D'   06 00                 	MVI	B,0		; ';' runs it as it stands
  160F'                         OPC_FK:
  160F'   3A 2E92'              	LDA	FNDKND
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  1612'   B7                    	ORA	A
  1613'   37                    	STC
  1614'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1615'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1616'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1618'   CA 161F'              	JZ	OPC_EXC
  161B'   3E 01                 	MVI	A,1
  161D'   B7                    	ORA	A		; CY clear: a motion, class 1
  161E'   C9                    	RET
  161F'                         OPC_EXC:
  161F'   AF                    	XRA	A		; class 0, CY clear
  1620'   C9                    	RET
  1621'                         OPC_TB:
  1621'   47                    	MOV	B,A
  1622'   21 1801'              	LXI	H,OPCTAB
  1625'                         OPC_LP:
  1625'   7E                    	MOV	A,M
  1626'   B7                    	ORA	A
  1627'   CA 1637'              	JZ	OPC_MS		; end of table -> not a motion
  162A'   B8                    	CMP	B
  162B'   CA 1633'              	JZ	OPC_HT
  162E'   23                    	INX	H
  162F'   23                    	INX	H
  1630'   C3 1625'              	JMP	OPC_LP
  1633'                         OPC_HT:
  1633'   23                    	INX	H
  1634'   7E                    	MOV	A,M		; class byte
  1635'   B7                    	ORA	A		; clear CY
  1636'   C9                    	RET
  1637'                         OPC_MS:
  1637'   37                    	STC
  1638'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  1639'                         OPAPPL:
  1639'   3A 2E3C'              	LDA	OPCLSV
  163C'   FE 02                 	CPI	2
  163E'   CA 17D5'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  1641'   2A 2E3E'              	LHLD	OPSTA
  1644'   EB                    	XCHG			; DE = start
  1645'   2A 2E40'              	LHLD	OPEND2		; HL = end
  1648'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  164B'   DA 165E'              	JC	OPA_F
  164E'   CA 165E'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  1651'   22 2E4E'              	SHLD	OPLO
  1654'   EB                    	XCHG
  1655'   22 2E50'              	SHLD	OPHI
  1658'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  165B'   C3 1715'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  165E'                         OPA_F:
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  165E'   EB                    	XCHG			; HL = start, DE = end
  165F'   22 2E4E'              	SHLD	OPLO
  1662'   EB                    	XCHG			; HL = end
  1663'   3A 2E3C'              	LDA	OPCLSV
  1666'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1668'   CA 1712'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  166B'   FE 01                 	CPI	1
  166D'   C2 168F'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  1670'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  1671'   22 2E50'              	SHLD	OPHI		; park it: CEND clobbers DE
  1674'   2B                    	DCX	H		; the line it landed on
  1675'   CD 18C0'              	CALL	CEND		; HL = that line's content end
  1678'   EB                    	XCHG			; DE = it
  1679'   2A 2E50'              	LHLD	OPHI		; HL = hi
  167C'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  167F'   D2 169A'              	JNC	OPA_HI		; hi is inside the line: keep it
  1682'   2A 2E4E'              	LHLD	OPLO
  1685'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1688'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  168B'   EB                    	XCHG			; HL = the content end: the span stops there
  168C'   C3 169A'              	JMP	OPA_HI
  168F'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  168F'   22 2E50'              	SHLD	OPHI
  1692'   3A 2E10'              	LDA	WPULL
  1695'   B7                    	ORA	A
  1696'   CA 1715'              	JZ	OPA_C1
  1699'   23                    	INX	H
  169A'                         OPA_HI:
  169A'   22 2E50'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  169D'                         OPA_DO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  169D'   CD 1761'              	CALL	OPSPNL
  16A0'   7C                    	MOV	A,H
  16A1'   B5                    	ORA	L
  16A2'   C2 16AB'              	JNZ	OPA_D1
  16A5'   2A 2E4E'              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  16A8'   C3 0000*              	JMP	GOTO		;   to where the span starts
  16AB'                         OPA_D1:
  16AB'   3A 2E3A'              	LDA	PSAVE
  16AE'   FE 63                 	CPI	'c'
  16B0'   CA 176C'              	JZ	OPDSPN
  16B3'   CD 1754'              	CALL	SPNBRK
  16B6'   D2 16D7'              	JNC	OPA_D2
  16B9'   2A 2E50'              	LHLD	OPHI
  16BC'   CD 18C0'              	CALL	CEND
  16BF'   EB                    	XCHG			; DE = the content end of the line it ends in
  16C0'   2A 2E50'              	LHLD	OPHI
  16C3'                         OPA_BL:
  16C3'   CD 0000*              	CALL	CMP16
  16C6'   CA 16DD'              	JZ	OPA_BI		; only blanks after it
  16C9'   D5                    	PUSH	D
  16CA'   E5                    	PUSH	H
  16CB'   CD 0000*              	CALL	CHARAT
  16CE'   E1                    	POP	H
  16CF'   D1                    	POP	D
  16D0'   23                    	INX	H
  16D1'   CD 170C'              	CALL	BLANKQ
  16D4'   CA 16C3'              	JZ	OPA_BL
  16D7'                         OPA_D2:
  16D7'   CD 176C'              	CALL	OPDSPN
  16DA'   C3 18D1'              	JMP	CLAMPE
  16DD'                         OPA_BI:
  16DD'   CD 16EF'              	CALL	LOIND
  16E0'   C2 16D7'              	JNZ	OPA_D2
  16E3'   2A 2E50'              	LHLD	OPHI
  16E6'   CD 06BB'              	CALL	NLSTART
  16E9'   22 2E50'              	SHLD	OPHI
  16EC'   C3 1740'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  16EF'                         LOIND:
  16EF'   2A 2E4E'              	LHLD	OPLO
  16F2'   CD 0624'              	CALL	BOL
  16F5'                         LI_LP:
  16F5'   E5                    	PUSH	H
  16F6'   EB                    	XCHG
  16F7'   2A 2E4E'              	LHLD	OPLO
  16FA'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  16FD'   E1                    	POP	H
  16FE'   C8                    	RZ
  16FF'   E5                    	PUSH	H
  1700'   CD 0000*              	CALL	CHARAT
  1703'   E1                    	POP	H
  1704'   23                    	INX	H
  1705'   CD 170C'              	CALL	BLANKQ
  1708'   CA 16F5'              	JZ	LI_LP
  170B'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


                                ;BLANKQ -- Z iff A is a space or a TAB.
  170C'                         BLANKQ:
  170C'   FE 20                 	CPI	' '
  170E'   C8                    	RZ
  170F'   FE 09                 	CPI	TAB
  1711'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  1712'                         OPA_JP:
  1712'   22 2E50'              	SHLD	OPHI
  1715'                         OPA_C1:
  1715'   CD 1761'              	CALL	OPSPNL
  1718'   7C                    	MOV	A,H
  1719'   B5                    	ORA	L
  171A'   CA 169D'              	JZ	OPA_DO		; nothing spanned
  171D'   2A 2E50'              	LHLD	OPHI
  1720'   CD 0624'              	CALL	BOL
  1723'   EB                    	XCHG
  1724'   2A 2E50'              	LHLD	OPHI
  1727'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  172A'   C2 169D'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  172D'   CD 16EF'              	CALL	LOIND
  1730'   CA 1740'              	JZ	C1_LW		; only blanks before lo: whole lines
  1733'                         C1_CH:
  1733'   2A 2E50'              	LHLD	OPHI		; back over the line break to the content end
  1736'   2B                    	DCX	H		;   of the line before
  1737'   CD 18C0'              	CALL	CEND
  173A'   22 2E50'              	SHLD	OPHI
  173D'   C3 169D'              	JMP	OPA_DO
  1740'                         C1_LW:
  1740'   2A 2E4E'              	LHLD	OPLO
  1743'   CD 0624'              	CALL	BOL
  1746'   22 2E4E'              	SHLD	OPLO
  1749'   3A 2E3A'              	LDA	PSAVE
  174C'   FE 63                 	CPI	'c'
  174E'   CA 1733'              	JZ	C1_CH
  1751'   C3 17E8'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  1754'                         SPNBRK:
  1754'   2A 2E4E'              	LHLD	OPLO
  1757'   CD 0667'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  175A'   EB                    	XCHG			; DE = it
  175B'   2A 2E50'              	LHLD	OPHI
  175E'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  1761'                         OPSPNL:
  1761'   2A 2E50'              	LHLD	OPHI
  1764'   EB                    	XCHG
  1765'   2A 2E4E'              	LHLD	OPLO
  1768'   EB                    	XCHG			; HL = hi, DE = lo
  1769'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  176C'                         OPDSPN:
  176C'   CD 1754'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  176F'   F5                    	PUSH	PSW
  1770'   2A 2E4E'              	LHLD	OPLO
  1773'   CD 0000*              	CALL	GOTO
  1776'   CD 1761'              	CALL	OPSPNL		; HL = hi - lo
  1779'   CD 0000*              	CALL	DELFWD
  177C'   CD 0174'              	CALL	MARKMOD
  177F'   F1                    	POP	PSW
  1780'   DA 0844'              	JC	SETFUL		; a break went: every row below it moved up
  1783'   C3 080D'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  1786'                         UNDFNB:
  1786'   CD 0000*              	CALL	CUROFF
  1789'   E5                    	PUSH	H
  178A'   CD 0900'              	CALL	FNBLNK
  178D'   CD 0000*              	CALL	CUROFF
  1790'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  1791'   CD 0000*              	CALL	CMP16
  1794'   D2 0000*              	JNC	UNDHER
  1797'   EB                    	XCHG
  1798'   CD 0000*              	CALL	GOTO
  179B'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  179E'                         OPALSP:
  179E'   2A 2E3E'              	LHLD	OPSTA
  17A1'   EB                    	XCHG
  17A2'   2A 2E40'              	LHLD	OPEND2
  17A5'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  17A8'   DA 17B8'              	JC	OPAL_F
  17AB'   22 2E4E'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  17AE'   EB                    	XCHG
  17AF'   22 2E50'              	SHLD	OPHI		; hi-src = start
  17B2'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  17B5'   C3 17C2'              	JMP	OPAL_R
  17B8'                         OPAL_F:
  17B8'   EB                    	XCHG			; HL = start
  17B9'   22 2E4E'              	SHLD	OPLO		; lo-src = start
  17BC'   2A 2E40'              	LHLD	OPEND2
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  17BF'   22 2E50'              	SHLD	OPHI		; hi-src = end
  17C2'                         OPAL_R:
  17C2'   2A 2E4E'              	LHLD	OPLO
  17C5'   CD 0624'              	CALL	BOL
  17C8'   22 2E4E'              	SHLD	OPLO		; lo = BOL(low line)
  17CB'   2A 2E50'              	LHLD	OPHI
  17CE'   CD 06BB'              	CALL	NLSTART
  17D1'   22 2E50'              	SHLD	OPHI		; hi = start of line past the high line
  17D4'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  17D5'                         OPALIN:
  17D5'   CD 179E'              	CALL	OPALSP
  17D8'   2A 2E4E'              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  17DB'   CD 06BB'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  17DE'   EB                    	XCHG			;   the column)
  17DF'   2A 2E50'              	LHLD	OPHI
  17E2'   CD 0000*              	CALL	CMP16
  17E5'   CC 1786'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  17E8'                         OPDLIN:
  17E8'   CD 176C'              	CALL	OPDSPN
  17EB'   CD 070E'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  17EE'   DA 17FE'              	JC	OPDL_NB
  17F1'   CD 0000*              	CALL	LOGLEN
  17F4'   7C                    	MOV	A,H
  17F5'   B5                    	ORA	L
  17F6'   C8                    	RZ			; empty buffer
  17F7'   2B                    	DCX	H
  17F8'   CD 0624'              	CALL	BOL
  17FB'   CD 0000*              	CALL	GOTO
  17FE'                         OPDL_NB:
  17FE'   C3 0900'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1801'                         OPCTAB:
  1801'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1805'   62 00 42 00           
  1809'   68 00 6C 00           
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  180D'   30 00 5E 00           
  1811'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1813'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1817'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  181B'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  181F'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1823'   24 01                 
  1825'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1829'   47 02 48 02           
  182D'   4D 02 4C 02           
  1831'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  1833'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1835'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1836'                         VCB_C:
  1836'   CD 1842'              	CALL	VCB_CD
  1839'   C3 1942'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  183C'                         VCB_D:
  183C'   CD 1842'              	CALL	VCB_CD
  183F'   C3 18D1'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  1842'                         VCB_CD:
  1842'   CD 0725'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1845'   22 2E4E'              	SHLD	OPLO
  1848'   CD 0000*              	CALL	CUROFF
  184B'   CD 18C0'              	CALL	CEND		; to the line's content end, the CR,LF left
  184E'   22 2E50'              	SHLD	OPHI
  1851'   C3 176C'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  1854'                         VC_X:
  1854'   CD 09B2'              	CALL	GLSTAL
  1857'   CD 080D'              	CALL	SETLIN
  185A'   CD 0732'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  185D'   22 2E52'              	SHLD	CNTV
  1860'   CD 0000*              	CALL	CUROFF
  1863'   22 2E56'              	SHLD	WKI		; cur
  1866'   CD 18C0'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  1869'   EB                    	XCHG			; DE = contentend
  186A'   2A 2E56'              	LHLD	WKI		; HL = cur
  186D'   EB                    	XCHG			; HL = contentend, DE = cur
  186E'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  1871'   7C                    	MOV	A,H
  1872'   B5                    	ORA	L
  1873'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  1874'   EB                    	XCHG			; DE = available
  1875'   2A 2E52'              	LHLD	CNTV		; HL = count
  1878'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  187B'   DA 1881'              	JC	VX_USEA
  187E'   C3 1882'              	JMP	VX_DEL		; count <= available -> HL = count = del
  1881'                         VX_USEA:
  1881'   EB                    	XCHG			; HL = available
  1882'                         VX_DEL:
                                	;--- plain chars, and plain chars after them: the terminal can close
                                	;    the cells up itself (R_DCH).  A TAB there would change width. ---
  1882'   E5                    	PUSH	H
  1883'   CD 084A'              	CALL	TAILTAB
  1886'   E1                    	POP	H
  1887'   47                    	MOV	B,A
  1888'   7C                    	MOV	A,H		; (more of them than a byte counts)
  1889'   B7                    	ORA	A
  188A'   C2 18B7'              	JNZ	VX_D1
  188D'   7D                    	MOV	A,L
  188E'   32 2E0A'              	STA	DCHN
  1891'   78                    	MOV	A,B
  1892'   87                    	ADD	A
  1893'   32 2E0B'              	STA	DCHBS		; 2: a TAB follows, to take the cells up
  1896'   CA 18B2'              	JZ	VX_D0
  1899'   7D                    	MOV	A,L		; ... if it is past what goes, and can
  189A'   FE 08                 	CPI	8
  189C'   D2 18B7'              	JNC	VX_D1
  189F'   E5                    	PUSH	H
  18A0'   2A 2E56'              	LHLD	WKI
  18A3'   EB                    	XCHG
  18A4'   2A 2E54'              	LHLD	TTI
  18A7'   CD 0000*              	CALL	SUBHD
  18AA'   EB                    	XCHG			; DE = the chars before it
  18AB'   E1                    	POP	H
  18AC'   CD 0000*              	CALL	CMP16
  18AF'   DA 18B7'              	JC	VX_D1
  18B2'                         VX_D0:
  18B2'   3E 07                 	MVI	A,R_DCH
  18B4'   32 2E07'              	STA	RINTENT
  18B7'                         VX_D1:
  18B7'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  18BA'   CD 0174'              	CALL	MARKMOD
  18BD'   C3 18D1'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  18C0'                         CEND:
  18C0'   CD 0667'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  18C3'   7C                    	MOV	A,H
  18C4'   B5                    	ORA	L
  18C5'   C8                    	RZ			; the start of the text: nothing before it
  18C6'   2B                    	DCX	H
  18C7'   E5                    	PUSH	H
  18C8'   CD 0000*              	CALL	CHARAT
  18CB'   E1                    	POP	H		; HL = term-1
  18CC'   FE 0D                 	CPI	CR
  18CE'   C8                    	RZ			; a CR before the LF -> the content ends there
  18CF'   23                    	INX	H
  18D0'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  18D1'                         CLAMPE:
  18D1'   CD 0000*              	CALL	CUROFF
  18D4'   E5                    	PUSH	H
  18D5'   CD 06CA'              	CALL	EOLC
  18D8'   D1                    	POP	D		; DE = cur
  18D9'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  18DC'   D8                    	RC
  18DD'   C8                    	RZ
  18DE'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  18E1'                         VC_I:
  18E1'   CD 0732'              	CALL	GETCNT
  18E4'   C3 193F'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  18E7'                         VC_A:
  18E7'   CD 0732'              	CALL	GETCNT
  18EA'   CD 070E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  18ED'   CA 1904'              	JZ	VA_INS
  18F0'   EB                    	XCHG			; HL = cur
  18F1'   E5                    	PUSH	H
  18F2'   CD 0000*              	CALL	CHARAT
  18F5'   E1                    	POP	H
  18F6'   FE 0A                 	CPI	LF
  18F8'   CA 1904'              	JZ	VA_INS		; on the line terminator -> append in place
  18FB'   FE 0D                 	CPI	CR
  18FD'   CA 1904'              	JZ	VA_INS
  1900'   23                    	INX	H
  1901'   CD 0000*              	CALL	GOTO
  1904'                         VA_INS:
  1904'   C3 193F'              	JMP	SETINM
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1907'                         VCB_A:
  1907'   CD 0725'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  190A'   CD 06CA'              	CALL	EOLC		; HL = last content char (the start when empty)
  190D'   E5                    	PUSH	H
  190E'   CD 0000*              	CALL	CHARAT
  1911'   E1                    	POP	H
  1912'   FE 0D                 	CPI	CR
  1914'   CA 191D'              	JZ	VBA_IN		; an empty line: insert at its start
  1917'   FE 0A                 	CPI	LF
  1919'   CA 191D'              	JZ	VBA_IN
  191C'   23                    	INX	H		; past the last content char
  191D'                         VBA_IN:
  191D'   CD 0000*              	CALL	GOTO
  1920'   C3 193F'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1923'                         VCB_I:
  1923'   CD 0732'              	CALL	GETCNT
  1926'   CD 0900'              	CALL	FNBLNK
  1929'   CD 0000*              	CALL	CUROFF
  192C'   E5                    	PUSH	H
  192D'   CD 0000*              	CALL	CHARAT
  1930'   E1                    	POP	H
  1931'   FE 20                 	CPI	' '
  1933'   CA 193B'              	JZ	VBI_SK
  1936'   FE 09                 	CPI	TAB
  1938'   C2 193F'              	JNZ	SETINM
  193B'                         VBI_SK:
  193B'   23                    	INX	H		; blanks only: past the last of them
  193C'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  193F'                         SETINM:
  193F'   CD 0807'              	CALL	SETMOV
  1942'                         SETINS:
  1942'   3E 01                 	MVI	A,EM_INS
  1944'   32 2E02'              	STA	EDMODE
  1947'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1948'                         ATCEND:
  1948'   CD 070E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  194B'   C8                    	RZ
  194C'   CD 0719'              	CALL	CURCHR		; A = the char under the cursor
  194F'   FE 0D                 	CPI	CR
  1951'   C8                    	RZ
  1952'   FE 0A                 	CPI	LF
  1954'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1955'                         OPNBRK:
  1955'   CD 227F'              	CALL	PUTBRK
  1958'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  195B'   23                    	INX	H
  195C'   22 0000*              	SHLD	LNDLT
  195F'   C3 0174'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1962'                         ENDBRK:
  1962'   CD 070E'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1965'   C0                    	RNZ
  1966'   CD 1955'              	CALL	OPNBRK
  1969'   CD 0000*              	CALL	CUROFF
  196C'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  196D'   2B                    	DCX	H		;   line, with its own terminator after it
  196E'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1971'                         VC_O:
  1971'   CD 0725'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1974'   CD 18C0'              	CALL	CEND
  1977'   CD 0000*              	CALL	GOTO
  197A'   CD 1955'              	CALL	OPNBRK
  197D'   CD 1962'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1980'   CD 082F'              	CALL	SETILN		;   needs a terminator of its own to exist
  1983'   C3 1942'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1986'                         VCB_O:
  1986'   CD 0725'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1989'   CD 0624'              	CALL	BOL
  198C'   CD 0000*              	CALL	GOTO
  198F'   CD 1955'              	CALL	OPNBRK
  1992'   CD 0000*              	CALL	CUROFF
  1995'   2B                    	DCX	H
  1996'   2B                    	DCX	H
  1997'   CD 0000*              	CALL	GOTO
  199A'   CD 082F'              	CALL	SETILN
  199D'   C3 1942'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  19A0'                         VCB_J:
  19A0'   CD 0725'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  19A3'   CD 18C0'              	CALL	CEND		; the join point: this line's content end
  19A6'   22 2E4E'              	SHLD	OPLO
  19A9'   CD 0000*              	CALL	CUROFF
  19AC'   CD 06BB'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  19AF'   E5                    	PUSH	H
  19B0'   CD 0000*              	CALL	LOGLEN
  19B3'   D1                    	POP	D		; DE = that start
  19B4'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  19B7'   CA 0807'              	JZ	SETMOV
  19BA'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  19BB'                         VJ_WS:
  19BB'   E5                    	PUSH	H
  19BC'   CD 0000*              	CALL	LOGLEN
  19BF'   D1                    	POP	D		; DE = the scan
  19C0'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  19C3'   CA 19DA'              	JZ	VJ_DEL
  19C6'   EB                    	XCHG			; HL = the scan
  19C7'   E5                    	PUSH	H
  19C8'   CD 0000*              	CALL	CHARAT
  19CB'   E1                    	POP	H
  19CC'   FE 20                 	CPI	' '
  19CE'   CA 19D6'              	JZ	VJ_SKIP
  19D1'   FE 09                 	CPI	TAB
  19D3'   C2 19DA'              	JNZ	VJ_DEL
  19D6'                         VJ_SKIP:
  19D6'   23                    	INX	H
  19D7'   C3 19BB'              	JMP	VJ_WS
  19DA'                         VJ_DEL:
  19DA'   22 2E50'              	SHLD	OPHI
  19DD'   CD 176C'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  19E0'   CD 083E'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  19E3'   CD 070E'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  19E6'   CA 18D1'              	JZ	CLAMPE
  19E9'   CD 0719'              	CALL	CURCHR		; the first char of what was appended
  19EC'   FE 0D                 	CPI	CR
  19EE'   CA 18D1'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  19F1'   FE 0A                 	CPI	LF
  19F3'   CA 18D1'              	JZ	CLAMPE
  19F6'   FE 29                 	CPI	')'
  19F8'   CA 18D1'              	JZ	CLAMPE		; vim puts no space before a ')'
  19FB'   CD 0000*              	CALL	CUROFF
  19FE'   7C                    	MOV	A,H
  19FF'   B5                    	ORA	L
  1A00'   CA 1A16'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1A03'   2B                    	DCX	H
  1A04'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1A07'   FE 20                 	CPI	' '
  1A09'   CA 18D1'              	JZ	CLAMPE
  1A0C'   FE 09                 	CPI	TAB
  1A0E'   CA 18D1'              	JZ	CLAMPE
  1A11'   FE 0A                 	CPI	LF
  1A13'   CA 18D1'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1A16'                         VJ_SP:
  1A16'   3E 20                 	MVI	A,' '
  1A18'   CD 0000*              	CALL	PUTGAP
  1A1B'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1A1E'   2B                    	DCX	H
  1A1F'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1A22'                         VC_TILD:
  1A22'   CD 0732'              	CALL	GETCNT
  1A25'   CD 080D'              	CALL	SETLIN		; only this row changes
  1A28'   CD 09B2'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1A2B'   CD 070E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1A2E'   CA 0807'              	JZ	SETMOV
  1A31'   CD 0719'              	CALL	CURCHR		; A = the char under the cursor
  1A34'   FE 0D                 	CPI	CR
  1A36'   CA 0807'              	JZ	SETMOV		; the line's end: nothing to toggle
  1A39'   FE 0A                 	CPI	LF
  1A3B'   CA 0807'              	JZ	SETMOV
  1A3E'   47                    	MOV	B,A
  1A3F'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1A41'   FE 41                 	CPI	'A'
  1A43'   DA 1A4F'              	JC	VT_PUT		; below 'A': no case
  1A46'   FE 5B                 	CPI	'Z'+1
  1A48'   D2 1A4F'              	JNC	VT_PUT		; above 'Z': no case
  1A4B'   78                    	MOV	A,B
  1A4C'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1A4E'   47                    	MOV	B,A
  1A4F'                         VT_PUT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1A4F'   78                    	MOV	A,B
  1A50'   32 2E5D'              	STA	VRCH		; the calls below do not preserve B
  1A53'   CD 0174'              	CALL	MARKMOD
  1A56'   21 0001               	LXI	H,1
  1A59'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1A5C'   3A 2E5D'              	LDA	VRCH
  1A5F'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1A62'   C3 18D1'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  1A65'                         VC_R:
  1A65'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  1A68'   3E 03                 	MVI	A,PR
  1A6A'   32 2E37'              	STA	GPEND
  1A6D'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1A6E'                         VR_DO:
  1A6E'   AF                    	XRA	A
  1A6F'   32 2E37'              	STA	GPEND
  1A72'   79                    	MOV	A,C
  1A73'   32 2E5D'              	STA	VRCH		; the calls below do not preserve C
  1A76'   CD 080D'              	CALL	SETLIN		; only this row changed
  1A79'   CD 09B2'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1A7C'   CD 070E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1A7F'   CA 0807'              	JZ	SETMOV		; the end of the text: vim does nothing
  1A82'   CD 0719'              	CALL	CURCHR		; A = the char under the cursor
  1A85'   FE 0D                 	CPI	CR
  1A87'   CA 0807'              	JZ	SETMOV		; the line's end: nothing to replace
  1A8A'   FE 0A                 	CPI	LF
  1A8C'   CA 0807'              	JZ	SETMOV
  1A8F'   06 02                 	MVI	B,2		; a cell for a cell: the char is the paint
  1A91'   CD 0813'              	CALL	SETCEL
  1A94'   CD 0174'              	CALL	MARKMOD
  1A97'   21 0001               	LXI	H,1
  1A9A'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1A9D'   3A 2E5D'              	LDA	VRCH
  1AA0'   FE 0D                 	CPI	CR
  1AA2'   CA 1AAF'              	JZ	VR_CR
  1AA5'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1AA8'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1AAB'   2B                    	DCX	H		;   out, which moves every logical offset
  1AAC'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1AAF'                         VR_CR:
  1AAF'   CD 1955'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1AB2'   CD 1962'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1AB5'   CD 082F'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1AB8'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1ABA'   32 2E0C'              	STA	ILABOV
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1ABD'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1ABE'                         VCB_R:
  1ABE'   CD 0732'              	CALL	GETCNT
  1AC1'   CD 0807'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1AC4'   21 0000               	LXI	H,0
  1AC7'   22 2E5E'              	SHLD	RPDEL		; nothing of ours to put back yet
  1ACA'   22 2E60'              	SHLD	RPAPP
  1ACD'   3E 02                 	MVI	A,EM_REP
  1ACF'   32 2E02'              	STA	EDMODE
  1AD2'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1AD3'                         VC_D:
  1AD3'   3E 64                 	MVI	A,'d'
  1AD5'   32 2E39'              	STA	PENDOP
  1AD8'   C3 0807'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1ADB'                         VC_C:
  1ADB'   3E 63                 	MVI	A,'c'
  1ADD'   32 2E39'              	STA	PENDOP
  1AE0'   C3 0807'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1AE3'                         VD_DD:
  1AE3'   CD 09B2'              	CALL	GLSTAL
  1AE6'   CD 0732'              	CALL	GETCNT
  1AE9'   22 2E52'              	SHLD	CNTV
  1AEC'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1AEE'   32 2E3B'              	STA	DDSNG
  1AF1'   2B                    	DCX	H
  1AF2'   7C                    	MOV	A,H
  1AF3'   B5                    	ORA	L
  1AF4'   C2 1B02'              	JNZ	VDD_LS
  1AF7'   3E 01                 	MVI	A,1
  1AF9'   32 2E3B'              	STA	DDSNG
  1AFC'   CD 1786'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1AFF'   C3 1B08'              	JMP	VDD_GO
  1B02'                         VDD_LS:
  1B02'   CD 096B'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1B05'   DA 0807'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1B08'                         VDD_GO:
  1B08'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1B0B'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1B0E'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1B11'   CD 24E2'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1B14'   CD 08E9'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1B17'   2A 2E52'              	LHLD	CNTV
  1B1A'   CD 0000*              	CALL	SETC0
  1B1D'                         VDD_FW:
  1B1D'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1B20'   DA 1C6E'              	JC	QREFUS		; ... which has no room for them
  1B23'   CD 0747'              	CALL	CNTTST
  1B26'   C2 1B1D'              	JNZ	VDD_FW
  1B29'   CD 0174'              	CALL	MARKMOD
  1B2C'   CD 0AE9'              	CALL	ATEOF
  1B2F'   D2 1B4A'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1B32'   3E 00                 	MVI	A,0
  1B34'   32 2E3B'              	STA	DDSNG		; deleted to the end: full repaint
  1B37'   CD 11C9'              	CALL	ONFST
  1B3A'   CA 0900'              	JZ	FNBLNK		; nothing left before it
  1B3D'   21 0001               	LXI	H,1		; onto the new last line
  1B40'   CD 0000*              	CALL	SETBWD
  1B43'   2A 0000*              	LHLD	LNDLT
  1B46'   2B                    	DCX	H
  1B47'   22 0000*              	SHLD	LNDLT
  1B4A'                         VDD_UP:
  1B4A'   CD 0900'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1B4D'   3A 2E3B'              	LDA	DDSNG
  1B50'   B7                    	ORA	A
  1B51'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1B52'   3E 03                 	MVI	A,R_DLIN
  1B54'   32 2E07'              	STA	RINTENT
  1B57'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1B58'                         QEMPTY:
  1B58'   2A 0000*              	LHLD	QBEG
  1B5B'   EB                    	XCHG
  1B5C'   2A 0000*              	LHLD	QEND
  1B5F'   7C                    	MOV	A,H
  1B60'   BA                    	CMP	D
  1B61'   C0                    	RNZ
  1B62'   7D                    	MOV	A,L
  1B63'   BB                    	CMP	E
  1B64'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1B65'                         VC_Y:
  1B65'   3E 79                 	MVI	A,'y'
  1B67'   32 2E39'              	STA	PENDOP
  1B6A'   C3 0807'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1B6D'                         VY_YY:
  1B6D'   21 2E42'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1B70'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1B73'   CD 0000*              	CALL	CUROFF
  1B76'   22 2E81'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1B79'   CD 0624'              	CALL	BOL
  1B7C'   22 2E83'              	SHLD	YPT		; where the lines come from, to put them back
  1B7F'   CD 1CD4'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1B82'   CD 1D17'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1B85'   D2 1CDB'              	JNC	YNDONE
  1B88'   21 1AE3'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1B8B'   C3 1BB7'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1B8E'                         OPYANK:
  1B8E'   CD 179E'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1B91'   2A 2E3E'              	LHLD	OPSTA
  1B94'   EB                    	XCHG			; DE = start
  1B95'   2A 2E40'              	LHLD	OPEND2		; HL = end
  1B98'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1B9B'   D2 1B9F'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1B9E'   EB                    	XCHG			; ... otherwise the start is
  1B9F'                         OPY_LO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1B9F'   22 2E81'              	SHLD	YOFF
  1BA2'   2A 2E4E'              	LHLD	OPLO
  1BA5'   22 2E83'              	SHLD	YPT		; where the lines come from, to put them back
  1BA8'   CD 1CD4'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1BAB'   CD 1D8F'              	CALL	YNSPAN		; copied where they lie, if there is room
  1BAE'   D2 1CDB'              	JNC	YNDONE
  1BB1'   21 1C95'              	LXI	H,YSPAN
  1BB4'   C3 1BB7'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1BB7'                         YKGO:
  1BB7'   22 2EAB'              	SHLD	YACT
  1BBA'   2A 2E83'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1BBD'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1BBE'   2A 2E81'              	LHLD	YOFF		;   survive this -- the put-back below can page
  1BC1'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1BC4'   22 2EB1'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1BC7'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1BCA'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1BCB'   2A 2E83'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1BCE'   EB                    	XCHG			;   window as it was, then names other text
  1BCF'   E1                    	POP	H
  1BD0'   CD 0000*              	CALL	SUBHD
  1BD3'   EB                    	XCHG			; DE = how far behind the cursor they start
  1BD4'   CD 1296'              	CALL	CURFP
  1BD7'   06 00                 	MVI	B,0
  1BD9'   CD 128C'              	CALL	SUB24
  1BDC'   22 2EB3'              	SHLD	YPFP
  1BDF'   32 2EB5'              	STA	YPFP+2
  1BE2'   3A 2E06'              	LDA	MODF
  1BE5'   32 2E7E'              	STA	YMODF
  1BE8'   3A 2E2C'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1BEB'   32 2E7F'              	STA	YDCHG		;   a yank must not become the last change
  1BEE'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1BF1'   32 2E80'              	STA	YURPL		;   back are not a change to undo either
  1BF4'   3E 01                 	MVI	A,1
  1BF6'   32 0000*              	STA	UNDRPL
  1BF9'   32 2EAA'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1BFC'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1BFF'   22 2E8D'              	SHLD	YLDLT
  1C02'   CD 0000*              	CALL	LOGLEN
  1C05'   22 2EAF'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1C08'   2A 2EAB'              	LHLD	YACT
  1C0B'   CD 1C6D'              	CALL	YCALL		; the lines out of the file, into the register
  1C0E'   3A 2E79'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1C11'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1C13'   CA 1C51'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1C16'   CD 0000*              	CALL	LOGLEN
  1C19'   EB                    	XCHG
  1C1A'   2A 2EAF'              	LHLD	YWAS
  1C1D'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1C20'   CA 1C32'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1C23'   21 2EB3'              	LXI	H,YPFP		; back to where they came from, by its place in
  1C26'   CD 03DC'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1C29'   CD 03A9'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1C2C'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1C2F'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1C32'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1C32'   2A 2EB3'              	LHLD	YPFP		;   cursor is still owed its place)
  1C35'   EB                    	XCHG
  1C36'   2A 2EB1'              	LHLD	YCOL
  1C39'   19                    	DAD	D
  1C3A'   22 2EA6'              	SHLD	MKPOS
  1C3D'   3A 2EB5'              	LDA	YPFP+2
  1C40'   CE 00                 	ACI	0
  1C42'   32 2EA8'              	STA	MKPOS+2
  1C45'   CD 03A9'              	CALL	MKPAGE
  1C48'   CD 0000*              	CALL	GOTO
  1C4B'                         YK_RST:
  1C4B'   2A 2E8D'              	LHLD	YLDLT
  1C4E'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1C51'                         YK_RF:
  1C51'   3A 2E7E'              	LDA	YMODF
  1C54'   32 2E06'              	STA	MODF
  1C57'   3A 2E7F'              	LDA	YDCHG
  1C5A'   32 2E2C'              	STA	DOTCHG
  1C5D'   3A 2E80'              	LDA	YURPL
  1C60'   32 0000*              	STA	UNDRPL
  1C63'   AF                    	XRA	A
  1C64'   32 2EAA'              	STA	MKHOLD
  1C67'   CD 09B2'              	CALL	GLSTAL
  1C6A'   C3 0844'              	JMP	SETFUL		; the cheap paint cannot carry this
  1C6D'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1C6E'                         QREFUS:
  1C6E'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1C71'   CD 1B58'              	CALL	QEMPTY
  1C74'   C4 0000*              	CNZ	QGET		; what went, back where it came from
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1C77'   CD 0000*              	CALL	QKILL
  1C7A'   3A 2EAA'              	LDA	MKHOLD
  1C7D'   B7                    	ORA	A
  1C7E'   C2 1C8D'              	JNZ	QRF_Y
  1C81'   21 0000*              	LXI	H,MKSAV
  1C84'   11 0000*              	LXI	D,MKTAB
  1C87'   CD 24E2'              	CALL	COPY12
  1C8A'   CD 0000*              	CALL	UNDCLR
  1C8D'                         QRF_Y:
  1C8D'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1C8F'   32 2E79'              	STA	MSGWHT
  1C92'   C3 15AD'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1C95'                         YSPAN:
  1C95'   CD 09B2'              	CALL	GLSTAL
  1C98'   CD 1761'              	CALL	OPSPNL		; HL = the span's length
  1C9B'   22 2EAD'              	SHLD	YTGT
  1C9E'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  1CA1'   EB                    	XCHG			; DE = it
  1CA2'   2A 2EAD'              	LHLD	YTGT
  1CA5'   EB                    	XCHG			; HL = the text's, DE = the span's
  1CA6'   CD 0000*              	CALL	SUBHD
  1CA9'   22 2EAD'              	SHLD	YTGT		; what the text is left at when the span is out
  1CAC'   2A 2E4E'              	LHLD	OPLO
  1CAF'   CD 0000*              	CALL	GOTO
  1CB2'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1CB5'                         YS_LP:
  1CB5'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1CB8'   CD 0000*              	CALL	SETC0
  1CBB'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1CBE'   DA 1C6E'              	JC	QREFUS		; ... which has no room for it
  1CC1'   CD 0000*              	CALL	LOGLEN
  1CC4'   EB                    	XCHG			; DE = what is left
  1CC5'   2A 2EAD'              	LHLD	YTGT
  1CC8'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1CCB'   DA 1CD1'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1CCE'   C2 1CB5'              	JNZ	YS_LP		;   but never spin here if it ever did
  1CD1'                         YS_END:
  1CD1'   C3 0174'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1CD4'                         YNPRE:
  1CD4'   2A 0000*              	LHLD	PGTOPM
  1CD7'   22 2EB6'              	SHLD	YNPG
  1CDA'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1CDB'                         YNDONE:
  1CDB'   2A 2E81'              	LHLD	YOFF
  1CDE'   CD 0000*              	CALL	GOTO
  1CE1'   2A 0000*              	LHLD	PGTOPM
  1CE4'   EB                    	XCHG
  1CE5'   2A 2EB6'              	LHLD	YNPG
  1CE8'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1CEB'   C2 0844'              	JNZ	SETFUL		; it moved under us: repaint after all
  1CEE'   C3 0807'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1CF1'                         YNROOM:
  1CF1'   11 0100               	LXI	D,100H
  1CF4'   19                    	DAD	D
  1CF5'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1CF6'   E5                    	PUSH	H		; the span plus its slack
  1CF7'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1CFA'   EB                    	XCHG			; HL = free
  1CFB'   D1                    	POP	D		; DE = the span plus its slack
  1CFC'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1CFF'   DA 1D07'              	JC	YNR_OK
  1D02'   CA 1D07'              	JZ	YNR_OK
  1D05'   37                    	STC			; not enough: the delete-and-put-back path
  1D06'   C9                    	RET
  1D07'                         YNR_OK:
  1D07'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1D08'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1D09'                         YNGO:
  1D09'   C5                    	PUSH	B
  1D0A'   CD 0732'              	CALL	GETCNT		; spent here: this yank is happening
  1D0D'   CD 09B2'              	CALL	GLSTAL
  1D10'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1D13'   C1                    	POP	B
  1D14'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1D17'                         YNCOPY:
  1D17'   2A 2E03'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1D1A'   7C                    	MOV	A,H		;   the count itself
  1D1B'   B5                    	ORA	L
  1D1C'   C2 1D22'              	JNZ	YNC_HV
  1D1F'   21 0001               	LXI	H,1
  1D22'                         YNC_HV:
  1D22'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1D23'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1D24'   B4                    	ORA	H
  1D25'   CA 1D30'              	JZ	YNC_M
  1D28'   E5                    	PUSH	H
  1D29'   CD 096B'              	CALL	ONLAST		; vim: a count over one on the last line does
  1D2C'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1D2D'   DA 1D42'              	JC	YNC_RF
  1D30'                         YNC_M:
  1D30'   E5                    	PUSH	H
  1D31'   CD 08E9'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1D34'   E1                    	POP	H
  1D35'   CD 1D4A'              	CALL	YNLINE		; BC = the span, measured where it stands
  1D38'   D8                    	RC			; not measurable here: let the pager answer it
  1D39'   60                    	MOV	H,B
  1D3A'   69                    	MOV	L,C
  1D3B'   CD 1CF1'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1D3E'   D8                    	RC			; no: the delete-and-put-back path
  1D3F'   C3 1D09'              	JMP	YNGO
  1D42'                         YNC_RF:
  1D42'   CD 0732'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1D45'   CD 09B2'              	CALL	GLSTAL		;   register alone, and that is the command
  1D48'   B7                    	ORA	A		; NC: done
  1D49'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1D4A'                         YNLINE:
  1D4A'   22 2EB8'              	SHLD	YNCNT		; the lines it still wants
  1D4D'   2A 0000*              	LHLD	GAPEND
  1D50'                         YNL_LP:
  1D50'   EB                    	XCHG			; DE = the scan
  1D51'   2A 0000*              	LHLD	TXTEND
  1D54'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1D57'   EB                    	XCHG			; HL = the scan
  1D58'   D2 1D78'              	JNC	YNL_EN		; the resident text ran out
  1D5B'   7E                    	MOV	A,M
  1D5C'   23                    	INX	H
  1D5D'   FE 0A                 	CPI	LF
  1D5F'   C2 1D50'              	JNZ	YNL_LP
  1D62'   E5                    	PUSH	H
  1D63'   2A 2EB8'              	LHLD	YNCNT
  1D66'   2B                    	DCX	H
  1D67'   22 2EB8'              	SHLD	YNCNT
  1D6A'   7C                    	MOV	A,H
  1D6B'   B5                    	ORA	L
  1D6C'   E1                    	POP	H
  1D6D'   C2 1D50'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1D70'   EB                    	XCHG			; DE = past the last of them
  1D71'   2A 0000*              	LHLD	GAPEND
  1D74'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1D75'   C3 1D86'              	JMP	YNL_BC
  1D78'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1D78'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1D7B'   C2 1D8D'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1D7E'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1D81'   EB                    	XCHG			;   count clamps to it as vim's does
  1D82'   2A 0000*              	LHLD	GAPEND
  1D85'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1D86'                         YNL_BC:
  1D86'   CD 0000*              	CALL	SUBHD		; HL = the span
  1D89'   44                    	MOV	B,H
  1D8A'   4D                    	MOV	C,L
  1D8B'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1D8C'   C9                    	RET
  1D8D'                         YNL_NO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1D8D'   37                    	STC
  1D8E'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1D8F'                         YNSPAN:
  1D8F'   CD 1761'              	CALL	OPSPNL		; HL = the span's length
  1D92'   44                    	MOV	B,H
  1D93'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1D94'   CD 1CF1'              	CALL	YNROOM
  1D97'   D8                    	RC			; no room: the delete-and-put-back path
  1D98'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1D99'   2A 2E4E'              	LHLD	OPLO
  1D9C'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1D9F'   C1                    	POP	B
  1DA0'   C3 1D09'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1DA3'                         VC_P:
  1DA3'   CD 1B58'              	CALL	QEMPTY
  1DA6'   CA 1E79'              	JZ	VP_BEL
  1DA9'   CD 0732'              	CALL	GETCNT
  1DAC'   22 2E85'              	SHLD	PCNT
  1DAF'   CD 0000*              	CALL	CUROFF
  1DB2'   CD 06BB'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1DB5'   C3 1DCA'              	JMP	VP_GO
  1DB8'                         VCB_P:
  1DB8'   CD 1B58'              	CALL	QEMPTY
  1DBB'   CA 1E79'              	JZ	VP_BEL
  1DBE'   CD 0732'              	CALL	GETCNT
  1DC1'   22 2E85'              	SHLD	PCNT
  1DC4'   CD 0000*              	CALL	CUROFF
  1DC7'   CD 0624'              	CALL	BOL
  1DCA'                         VP_GO:
  1DCA'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1DCD'   CD 0000*              	CALL	CUROFF
  1DD0'   EB                    	XCHG
  1DD1'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1DD4'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1DD7'   DA 1DEC'              	JC	VP_IN
  1DDA'   EB                    	XCHG			; HL = the put point = LOGLEN
  1DDB'   7C                    	MOV	A,H
  1DDC'   B5                    	ORA	L
  1DDD'   CA 1DE9'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1DE0'   2B                    	DCX	H
  1DE1'   CD 0000*              	CALL	CHARAT
  1DE4'   FE 0A                 	CPI	LF
  1DE6'   CA 1DEC'              	JZ	VP_IN
  1DE9'                         VP_BRK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1DE9'   CD 1955'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1DEC'                         VP_IN:
  1DEC'   21 2E87'              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1DEF'   CD 0429'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1DF2'   CD 12DF'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1DF5'   2A 0000*              	LHLD	QBEG
  1DF8'   EB                    	XCHG
  1DF9'   2A 0000*              	LHLD	QEND
  1DFC'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1DFF'   EB                    	XCHG
  1E00'   22 2E8A'              	SHLD	PLFS
  1E03'   2A 2E85'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1E06'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1E07'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1E08'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1E0A'   C2 1E0E'              	JNZ	VP_PZ
  1E0D'   7D                    	MOV	A,L
  1E0E'                         VP_PZ:
  1E0E'   32 2E8C'              	STA	PCPY
  1E11'                         VP_LP:
  1E11'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1E14'   2A 0000*              	LHLD	LNDLT
  1E17'   EB                    	XCHG
  1E18'   2A 2E8A'              	LHLD	PLFS
  1E1B'   19                    	DAD	D
  1E1C'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1E1F'   2A 2E85'              	LHLD	PCNT
  1E22'   2B                    	DCX	H
  1E23'   22 2E85'              	SHLD	PCNT
  1E26'   7C                    	MOV	A,H
  1E27'   B5                    	ORA	L
  1E28'   C2 1E11'              	JNZ	VP_LP
  1E2B'   CD 0174'              	CALL	MARKMOD
  1E2E'   21 2E87'              	LXI	H,PPFP
  1E31'   CD 03DC'              	CALL	MKLOAD
  1E34'   CD 03E9'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1E37'   D2 1E6A'              	JNC	VP_PGD
  1E3A'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1E3D'   CD 09B2'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1E40'   3A 2E8C'              	LDA	PCPY
  1E43'   B7                    	ORA	A
  1E44'   CA 0900'              	JZ	FNBLNK
  1E47'   2A 2E8A'              	LHLD	PLFS
  1E4A'   7C                    	MOV	A,H
  1E4B'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1E4C'   C2 0900'              	JNZ	FNBLNK
  1E4F'   3A 2E8C'              	LDA	PCPY
  1E52'   CD 0F91'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1E55'   7C                    	MOV	A,H
  1E56'   B7                    	ORA	A
  1E57'   C2 0900'              	JNZ	FNBLNK
  1E5A'   7D                    	MOV	A,L
  1E5B'   B7                    	ORA	A
  1E5C'   CA 0900'              	JZ	FNBLNK
  1E5F'   F5                    	PUSH	PSW
  1E60'   CD 082F'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1E63'   F1                    	POP	PSW
  1E64'   32 2E08'              	STA	ILN		; ... which the lines put now replace
  1E67'   C3 0900'              	JMP	FNBLNK
  1E6A'                         VP_PGD:				; the put paged its first line out: page back
  1E6A'   CD 03A9'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1E6D'   CD 0000*              	CALL	GOTO
  1E70'   CD 09B2'              	CALL	GLSTAL
  1E73'   CD 12F7'              	CALL	GPLACE
  1E76'   C3 0844'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  1E79'                         VP_BEL:
  1E79'   CD 0732'              	CALL	GETCNT		; the count is spent either way
  1E7C'   0E 07                 	MVI	C,BEL
  1E7E'   CD 0000*              	CALL	BCONOU
  1E81'   C3 0807'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  1E84'                         VIREP:
  1E84'   79                    	MOV	A,C
  1E85'   FE 1B                 	CPI	ESC
  1E87'   CA 1FDA'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  1E8A'   FE 0D                 	CPI	CR
  1E8C'   CA 1EFF'              	JZ	VP_CR
  1E8F'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1E91'   CA 1EFF'              	JZ	VP_CR
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1E94'   FE 08                 	CPI	BS
  1E96'   CA 1F0B'              	JZ	VP_BS
  1E99'   FE 7F                 	CPI	DEL
  1E9B'   CA 1F0B'              	JZ	VP_BS
  1E9E'   32 2E5D'              	STA	VRCH		; the calls below do not preserve C
  1EA1'   CD 080D'              	CALL	SETLIN		; this row changed
  1EA4'   CD 0174'              	CALL	MARKMOD
  1EA7'   CD 1948'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1EAA'   CA 1EEA'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1EAD'   CD 0719'              	CALL	CURCHR
  1EB0'   06 01                 	MVI	B,1
  1EB2'   CD 0813'              	CALL	SETCEL
  1EB5'   3A 2E5D'              	LDA	VRCH
  1EB8'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1EBB'   2A 2E5E'              	LHLD	RPDEL
  1EBE'   7C                    	MOV	A,H
  1EBF'   B5                    	ORA	L
  1EC0'   CA 1ED6'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1EC3'   2A 0000*              	LHLD	GAPEND
  1EC6'   EB                    	XCHG
  1EC7'   2A 2E62'              	LHLD	RPGE
  1ECA'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1ECD'   CA 1ED6'              	JZ	VP_OVW
  1ED0'   21 0000               	LXI	H,0
  1ED3'   22 2E5E'              	SHLD	RPDEL		; the text moved: those originals are gone
  1ED6'                         VP_OVW:
  1ED6'   21 0001               	LXI	H,1
  1ED9'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1EDC'   2A 0000*              	LHLD	GAPEND
  1EDF'   22 2E62'              	SHLD	RPGE
  1EE2'   2A 2E5E'              	LHLD	RPDEL
  1EE5'   23                    	INX	H
  1EE6'   22 2E5E'              	SHLD	RPDEL
  1EE9'   C9                    	RET
  1EEA'                         VP_APP:
  1EEA'   3E 20                 	MVI	A,' '		; (the cell there is blank)
  1EEC'   06 01                 	MVI	B,1
  1EEE'   CD 0813'              	CALL	SETCEL
  1EF1'   3A 2E5D'              	LDA	VRCH
  1EF4'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1EF7'   2A 2E60'              	LHLD	RPAPP
  1EFA'   23                    	INX	H
  1EFB'   22 2E60'              	SHLD	RPAPP
  1EFE'   C9                    	RET
  1EFF'                         VP_CR:
  1EFF'   21 0000               	LXI	H,0
  1F02'   22 2E5E'              	SHLD	RPDEL		; a line break ends what BS can put back
  1F05'   22 2E60'              	SHLD	RPAPP
  1F08'   C3 1F96'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1F0B'                         VP_BS:
  1F0B'   2A 2E60'              	LHLD	RPAPP
  1F0E'   7C                    	MOV	A,H
  1F0F'   B5                    	ORA	L
  1F10'   CA 1F1D'              	JZ	VP_BSD
  1F13'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1F14'   22 2E60'              	SHLD	RPAPP		; an appended char: it just goes
  1F17'   CD 080D'              	CALL	SETLIN
  1F1A'   C3 0000*              	JMP	DELPRV
  1F1D'                         VP_BSD:
  1F1D'   2A 2E5E'              	LHLD	RPDEL
  1F20'   7C                    	MOV	A,H
  1F21'   B5                    	ORA	L
  1F22'   CA 1F49'              	JZ	VP_BSM		; nothing of ours left
  1F25'   2A 0000*              	LHLD	GAPEND
  1F28'   EB                    	XCHG
  1F29'   2A 2E62'              	LHLD	RPGE
  1F2C'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1F2F'   C2 1F49'              	JNZ	VP_BSM
  1F32'   2A 2E5E'              	LHLD	RPDEL
  1F35'   2B                    	DCX	H
  1F36'   22 2E5E'              	SHLD	RPDEL
  1F39'   CD 080D'              	CALL	SETLIN
  1F3C'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1F3F'   CD 0000*              	CALL	UNDELF		; the original comes back
  1F42'   2A 0000*              	LHLD	GAPEND
  1F45'   22 2E62'              	SHLD	RPGE
  1F48'   C9                    	RET
  1F49'                         VP_BSM:
  1F49'   CD 0807'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1F4C'   C3 0895'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  1F4F'                         VIINS:
  1F4F'   79                    	MOV	A,C
  1F50'   FE 1B                 	CPI	ESC
  1F52'   CA 1FDA'              	JZ	VI_ESC
  1F55'   FE 0D                 	CPI	CR
  1F57'   CA 1F96'              	JZ	VI_CR
  1F5A'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1F5C'   CA 1F96'              	JZ	VI_CR
  1F5F'   FE 08                 	CPI	BS
  1F61'   CA 1FAE'              	JZ	VI_BS
  1F64'   FE 7F                 	CPI	DEL
  1F66'   CA 1FAE'              	JZ	VI_BS
  1F69'   79                    	MOV	A,C
  1F6A'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1F6D'   CD 0174'              	CALL	MARKMOD
  1F70'   CD 080D'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only for a plain printable char.  With
                                	;    a TAB after the cursor nothing past the TAB moves, so long as the
                                	;    TAB can give the cell up: the chars as far as it are the paint. ---
  1F73'   79                    	MOV	A,C
  1F74'   FE 20                 	CPI	' '
  1F76'   D8                    	RC			; control char -> keep R_LINE
  1F77'   FE 7F                 	CPI	DEL
  1F79'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1F7A'   CD 084A'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1F7D'   47                    	MOV	B,A
  1F7E'   3E 04                 	MVI	A,R_ICH
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  1F80'   32 2E07'              	STA	RINTENT
  1F83'   3E 03                 	MVI	A,3		; a TAB there: it takes the cell up if it can
  1F85'   05                    	DCR	B		;   (SCRN.MAC knows where it stands)
  1F86'   CA 1F92'              	JZ	VI_ICH
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1F89'   CD 1948'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1F8C'   3E 00                 	MVI	A,0
  1F8E'   C2 1F92'              	JNZ	VI_ICH
  1F91'   3C                    	INR	A
  1F92'                         VI_ICH:
  1F92'   32 2E09'              	STA	ICHAPP
  1F95'   C9                    	RET
  1F96'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1F96'   CD 1948'              	CALL	ATCEND
  1F99'   3E 00                 	MVI	A,0
  1F9B'   CA 1F9F'              	JZ	VI_CRS
  1F9E'   3C                    	INR	A
  1F9F'                         VI_CRS:
  1F9F'   F5                    	PUSH	PSW
  1FA0'   CD 1955'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1FA3'   CD 1962'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1FA6'   CD 082F'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1FA9'   F1                    	POP	PSW
  1FAA'   32 2E0C'              	STA	ILABOV
  1FAD'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1FAE'                         VI_BS:
  1FAE'   CD 0000*              	CALL	PEEKL
  1FB1'   D8                    	RC			; start of the file: nothing to delete
  1FB2'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1FB4'   CA 1FD4'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1FB7'   47                    	MOV	B,A		;   and the screen repaints in full.  Any other
  1FB8'   CD 080D'              	CALL	SETLIN		;   char is inside the row -- redraw just that row
  1FBB'   78                    	MOV	A,B
  1FBC'   CD 0828'              	CALL	PLAINQ		; ... or, when it is one cell and no TAB follows
  1FBF'   D2 1FD4'              	JNC	VI_BSJ		;   to be drawn up short, let the terminal close
  1FC2'   CD 084A'              	CALL	TAILTAB		;   the cell up (R_DCH, from the left of the
  1FC5'   87                    	ADD	A		;   cursor) -- or the TAB that follows take it
  1FC6'   3C                    	INR	A
  1FC7'   32 2E0B'              	STA	DCHBS		; 1, and 2 with it for the TAB
  1FCA'   3E 01                 	MVI	A,1
  1FCC'   32 2E0A'              	STA	DCHN
  1FCF'   3E 07                 	MVI	A,R_DCH
  1FD1'   32 2E07'              	STA	RINTENT
  1FD4'                         VI_BSJ:
  1FD4'   CD 0174'              	CALL	MARKMOD
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  1FD7'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1FDA'                         VI_ESC:
  1FDA'   3E 00                 	MVI	A,EM_CMD
  1FDC'   32 2E02'              	STA	EDMODE
  1FDF'   CD 0807'              	CALL	SETMOV
  1FE2'   CD 0895'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1FE5'   C3 09B2'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1FE8'                         RDLINE:
  1FE8'   EB                    	XCHG			; HL = buffer
  1FE9'   22 2E64'              	SHLD	RLPTR
  1FEC'   3E 00                 	MVI	A,0
  1FEE'   32 2E66'              	STA	RLLEN
  1FF1'   78                    	MOV	A,B
  1FF2'   32 2E67'              	STA	RLMAX
  1FF5'   79                    	MOV	A,C
  1FF6'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1FF9'                         RL_LP:
  1FF9'   CD 0000*              	CALL	GETKEY
  1FFC'   FE 1B                 	CPI	ESC
  1FFE'   CA 204E'              	JZ	RL_CAN
  2001'   FE 0D                 	CPI	CR
  2003'   CA 2059'              	JZ	RL_DONE
  2006'   FE 08                 	CPI	BS
  2008'   CA 2036'              	JZ	RL_BS
  200B'   FE 7F                 	CPI	DEL
  200D'   CA 2036'              	JZ	RL_BS
  2010'   FE 20                 	CPI	' '
  2012'   DA 1FF9'              	JC	RL_LP		; control char -> ignore
  2015'   3A 2E66'              	LDA	RLLEN
  2018'   47                    	MOV	B,A
  2019'   3A 2E67'              	LDA	RLMAX
  201C'   B8                    	CMP	B
  201D'   CA 1FF9'              	JZ	RL_LP		; full -> ignore
  2020'   2A 2E64'              	LHLD	RLPTR
  2023'   71                    	MOV	M,C
  2024'   23                    	INX	H
  2025'   22 2E64'              	SHLD	RLPTR
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  2028'   3A 2E66'              	LDA	RLLEN
  202B'   3C                    	INR	A
  202C'   32 2E66'              	STA	RLLEN
  202F'   79                    	MOV	A,C
  2030'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  2033'   C3 1FF9'              	JMP	RL_LP
  2036'                         RL_BS:				; WM LINEPOP
  2036'   3A 2E66'              	LDA	RLLEN
  2039'   B7                    	ORA	A
  203A'   CA 204E'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  203D'   3D                    	DCR	A
  203E'   32 2E66'              	STA	RLLEN
  2041'   2A 2E64'              	LHLD	RLPTR
  2044'   2B                    	DCX	H
  2045'   22 2E64'              	SHLD	RLPTR
  2048'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  204B'   C3 1FF9'              	JMP	RL_LP
  204E'                         RL_CAN:
  204E'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  2050'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  2053'   CD 080D'              	CALL	SETLIN		; redraw one row
  2056'   3E FF                 	MVI	A,0FFH		; cancelled
  2058'   C9                    	RET
  2059'                         RL_DONE:
  2059'   AF                    	XRA	A
  205A'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  205B'                         VC_BZ:
  205B'   CD 0807'              	CALL	SETMOV
  205E'   3A 2E38'              	LDA	GSAVE
  2061'   FE 02                 	CPI	PZ
  2063'   CA 206E'              	JZ	VZ_ZZ
  2066'   B7                    	ORA	A
  2067'   C0                    	RNZ			; 'g' was pending: vim drops both
  2068'   3E 02                 	MVI	A,PZ
  206A'   32 2E37'              	STA	GPEND
  206D'   C9                    	RET
  206E'                         VZ_ZZ:
  206E'   3E 04                 	MVI	A,EO_X
  2070'   32 2E68'              	STA	EXOP
  2073'   3E 01                 	MVI	A,1
  2075'   32 2E7B'              	STA	EXBANG		; no '!'
  2078'   AF                    	XRA	A
  2079'   32 2E69'              	STA	EXARG		; no file name
  207C'   3A 2E06'              	LDA	MODF		; as ':x': a changed text is written first
  207F'   B7                    	ORA	A
  2080'   CA 21C1'              	JZ	EX_Q
  2083'   C3 215B'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  2086'                         VC_EX:
  2086'   CD 0732'              	CALL	GETCNT
  2089'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  208C'   11 0000*              	LXI	D,EXBUF
  208F'   06 28                 	MVI	B,EXMAX
  2091'   0E 3A                 	MVI	C,':'
  2093'   CD 1FE8'              	CALL	RDLINE
  2096'   B7                    	ORA	A
  2097'   C0                    	RNZ			; cancelled
  2098'   3A 2E66'              	LDA	RLLEN
  209B'   5F                    	MOV	E,A
  209C'   16 00                 	MVI	D,0
  209E'   21 0000*              	LXI	H,EXBUF
  20A1'   19                    	DAD	D
  20A2'   36 00                 	MVI	M,0		; the line ends with a 0
  20A4'   21 0000*              	LXI	H,EXBUF
  20A7'   CD 2673'              	CALL	SKIPB
  20AA'   C8                    	RZ			; nothing on it
  20AB'   22 2E6B'              	SHLD	EXCMD
  20AE'   CD 2877'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  20B1'   CD 2673'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  20B4'   56                    	MOV	D,M
  20B5'   23                    	INX	H
  20B6'   1E 00                 	MVI	E,0
  20B8'   CD 267F'              	CALL	ISLOW
  20BB'   DA 20C6'              	JC	EX_LK
  20BE'   5F                    	MOV	E,A
  20BF'   23                    	INX	H
  20C0'   CD 267F'              	CALL	ISLOW
  20C3'   D2 20DF'              	JNC	EX_NOT		; a third letter: none of ours
  20C6'                         EX_LK:
  20C6'   E5                    	PUSH	H
  20C7'   21 285E'              	LXI	H,EXTAB
  20CA'                         EX_TL:
  20CA'   7E                    	MOV	A,M
  20CB'   B7                    	ORA	A
  20CC'   CA 20DE'              	JZ	EX_NTP		; not in the table
  20CF'   23                    	INX	H
  20D0'   BA                    	CMP	D
  20D1'   7E                    	MOV	A,M
  20D2'   23                    	INX	H
  20D3'   C2 20DA'              	JNZ	EX_TN
  20D6'   BB                    	CMP	E
  20D7'   CA 20E5'              	JZ	EX_TF
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  20DA'                         EX_TN:
  20DA'   23                    	INX	H
  20DB'   C3 20CA'              	JMP	EX_TL
  20DE'                         EX_NTP:
  20DE'   E1                    	POP	H
  20DF'                         EX_NOT:
  20DF'   21 2737'              	LXI	H,SNOT
  20E2'   C3 26B4'              	JMP	EXERT
  20E5'                         EX_TF:
  20E5'   7E                    	MOV	A,M
  20E6'   32 2E68'              	STA	EXOP
  20E9'   E1                    	POP	H
  20EA'   FE 06                 	CPI	EO_S
  20EC'   CA 28E6'              	JZ	EX_S		; ':s' reads the rest of the line itself
  20EF'   FE 01                 	CPI	EO_W
  20F1'   CA 2100'              	JZ	EX_RG		; ':N,Mw name' takes a range
  20F4'   FE 08                 	CPI	EO_R
  20F6'   CA 2100'              	JZ	EX_RG		; ... and ':Nr name' a line
  20F9'   3A 2EC4'              	LDA	SRNGF
  20FC'   B7                    	ORA	A
  20FD'   C2 20DF'              	JNZ	EX_NOT		; a range on a command that does not take one
  2100'                         EX_RG:
                                	;--- '!', then the file name ---
  2100'   7E                    	MOV	A,M
  2101'   D6 21                 	SUI	'!'
  2103'   32 2E7B'              	STA	EXBANG		; 0 = '!'
  2106'   C2 210A'              	JNZ	EX_NB
  2109'   23                    	INX	H
  210A'                         EX_NB:
  210A'   CD 2673'              	CALL	SKIPB
  210D'   32 2E69'              	STA	EXARG		; 0 = no file name
  2110'   CA 2129'              	JZ	EX_RUN
  2113'   22 2E6B'              	SHLD	EXCMD
  2116'   3A 2E68'              	LDA	EXOP
  2119'   FE 02                 	CPI	EO_Q
  211B'   CA 26B1'              	JZ	EX_TRL		; :q takes none
  211E'   FE 07                 	CPI	EO_V
  2120'   CA 26B1'              	JZ	EX_TRL		; nor :ve
  2123'   CD 25DD'              	CALL	PARSFN
  2126'   C2 26A5'              	JNZ	EX_INV
  2129'                         EX_RUN:
  2129'   3A 2E68'              	LDA	EXOP
  212C'   FE 05                 	CPI	EO_E
  212E'   CA 21D8'              	JZ	EX_E
  2131'   FE 02                 	CPI	EO_Q
  2133'   CA 21C1'              	JZ	EX_Q
  2136'   FE 07                 	CPI	EO_V
  2138'   CA 26AB'              	JZ	EX_V
  213B'   FE 08                 	CPI	EO_R
  213D'   CA 2369'              	JZ	EX_R
  2140'   FE 04                 	CPI	EO_X
  2142'   CA 2154'              	JZ	EX_XM
  2145'   FE 01                 	CPI	EO_W
  2147'   C2 215B'              	JNZ	EX_W		; :wq
  214A'   3A 2EC4'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  214D'   B7                    	ORA	A		;   there with whatever range the last ':' left)
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  214E'   C2 2289'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  2151'   C3 215B'              	JMP	EX_W
  2154'                         EX_XM:
  2154'   3A 2E06'              	LDA	MODF		; :x writes only a changed text
  2157'   B7                    	ORA	A
  2158'   CA 21C1'              	JZ	EX_Q
  215B'                         EX_W:
  215B'   CD 2449'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  215E'   D8                    	RC			; refused (message shown)
  215F'   32 2E6A'              	STA	EXBAK
  2162'   3A 2E68'              	LDA	EXOP
  2165'   FE 01                 	CPI	EO_W
  2167'   CA 217E'              	JZ	EX_WK
  216A'   3A 2E6A'              	LDA	EXBAK
  216D'   B7                    	ORA	A
  216E'   C2 21BE'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  2171'   3A 2E7B'              	LDA	EXBANG
  2174'   B7                    	ORA	A
  2175'   CA 21BE'              	JZ	EX_WQ		; so it does with '!'
  2178'   CD 217E'              	CALL	EX_WK		; else it may not: keep the text
  217B'   C3 21C1'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  217E'                         EX_WK:
  217E'   CD 0DCD'              	CALL	CURRW		; the cursor's row and file position
  2181'   32 2E6D'              	STA	WPROW
  2184'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  2187'   7D                    	MOV	A,L
  2188'   E6 7F                 	ANI	7FH
  218A'   32 2E6E'              	STA	WPBYT
  218D'   7D                    	MOV	A,L
  218E'   17                    	RAL
  218F'   7C                    	MOV	A,H
  2190'   17                    	RAL
  2191'   5F                    	MOV	E,A
  2192'   3E 00                 	MVI	A,0
  2194'   17                    	RAL
  2195'   57                    	MOV	D,A		; DE = HL / 128
  2196'   2A 0000*              	LHLD	OUTPOS
  2199'   19                    	DAD	D
  219A'   22 2E6F'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  219D'   CD 247E'              	CALL	WRITE
  21A0'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  21A3'   2A 2E6F'              	LHLD	WPREC
  21A6'   EB                    	XCHG
  21A7'   3A 2E6E'              	LDA	WPBYT
  21AA'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  21AD'   CD 0000*              	CALL	GOTO
  21B0'                         EX_WRW:
  21B0'   21 0000               	LXI	H,0
  21B3'   22 0000*              	SHLD	LNDLT
  21B6'   3A 2E6D'              	LDA	WPROW
  21B9'   6F                    	MOV	L,A
  21BA'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  21BD'   C9                    	RET
  21BE'                         EX_WQ:
  21BE'   CD 247E'              	CALL	WRITE		; :wq / :x -- nothing to come back to
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  21C1'                         EX_Q:
  21C1'   3A 2E7B'              	LDA	EXBANG
  21C4'   B7                    	ORA	A
  21C5'   CA 21CF'              	JZ	EX_QT
  21C8'   3A 2E06'              	LDA	MODF
  21CB'   B7                    	ORA	A
  21CC'   C2 2699'              	JNZ	MSGNWR		; changed, no '!': stay
  21CF'                         EX_QT:
  21CF'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  21D2'   3E 01                 	MVI	A,1
  21D4'   32 2E05'              	STA	QUITF
  21D7'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  21D8'                         EX_E:
  21D8'   3A 2E7B'              	LDA	EXBANG
  21DB'   B7                    	ORA	A
  21DC'   CA 21E6'              	JZ	EE_GO
  21DF'   3A 2E06'              	LDA	MODF
  21E2'   B7                    	ORA	A
  21E3'   C2 2699'              	JNZ	MSGNWR
  21E6'                         EE_GO:
  21E6'   3A 2E69'              	LDA	EXARG
  21E9'   B7                    	ORA	A
  21EA'   C2 21F1'              	JNZ	EE_ARG
  21ED'   CD 24BA'              	CALL	OWNTF		; no name: the buffer's own
  21F0'   D8                    	RC
  21F1'                         EE_ARG:
  21F1'   CD 24D0'              	CALL	ISOWN
  21F4'   21 0001               	LXI	H,1
  21F7'   C2 21FE'              	JNZ	EE_LD		; another file: its first line
  21FA'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  21FD'   23                    	INX	H		; HL = the cursor's line
  21FE'                         EE_LD:
  21FE'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  2200'   32 2E79'              	STA	MSGWHT
  2203'   E5                    	PUSH	H
  2204'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  2207'   21 0000*              	LXI	H,TFCB
  220A'   11 0000*              	LXI	D,FNAME
  220D'   CD 24E2'              	CALL	COPY12		; the buffer's name
  2210'   CD 24A7'              	CALL	SRCTF
  2213'   CD 0000*              	CALL	REOPEN
  2216'   CD 01EC'              	CALL	MKCLR		; the marks named the buffer that just went
  2219'   AF                    	XRA	A
  221A'   32 2E06'              	STA	MODF
  221D'   E1                    	POP	H
  221E'   2B                    	DCX	H
  221F'   AF                    	XRA	A
  2220'   CD 0000*              	CALL	MVLIND		; down to the line
  2223'   CD 0AE9'              	CALL	ATEOF
  2226'   DC 0AEF'              	CC	LASTLN		; past the last line: onto it
  2229'   CD 12B9'              	CALL	ZSAVE
  222C'   C3 138E'              	JMP	GP_MID
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  222F'                         TFDOS:
  222F'   C5                    	PUSH	B
  2230'   11 0080               	LXI	D,CMDTAIL
  2233'   0E 1A                 	MVI	C,1AH		; set the DMA
  2235'   CD 0005               	CALL	BDOS
  2238'   C1                    	POP	B
  2239'   11 0000*              	LXI	D,TFCB
  223C'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  223F'                         EXRNG:
  223F'   2A 2EC5'              	LHLD	SRNG1
  2242'   7C                    	MOV	A,H
  2243'   B5                    	ORA	L
  2244'   37                    	STC
  2245'   C8                    	RZ
  2246'   2A 2EC7'              	LHLD	SRNG2
  2249'   EB                    	XCHG
  224A'   2A 2EC5'              	LHLD	SRNG1
  224D'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  2250'   D8                    	RC
  2251'   EB                    	XCHG			; HL = the last line, DE = the first
  2252'   CD 0000*              	CALL	SUBHD
  2255'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  2256'   22 2ECF'              	SHLD	SLINES
  2259'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  225A'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  225B'                         GOLNX:
  225B'   E5                    	PUSH	H
  225C'   CD 124D'              	CALL	GOLN
  225F'   CD 0000*              	CALL	CNTLF
  2262'   23                    	INX	H		; the line the cursor came to rest on
  2263'   D1                    	POP	D
  2264'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  2267'                         EXSAVP:
  2267'   CD 0DCD'              	CALL	CURRW
  226A'   32 2E6D'              	STA	WPROW
  226D'   21 2EA6'              	LXI	H,MKPOS
  2270'   C3 0429'              	JMP	FPSTO
  2273'                         EXRSTP:
  2273'   CD 0000*              	CALL	CLRCNT
  2276'   CD 03A9'              	CALL	MKPAGE		; page until that place is in the window again
  2279'   CD 0000*              	CALL	GOTO
  227C'   C3 21B0'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  227F'                         PUTBRK:
  227F'   3E 0D                 	MVI	A,CR
  2281'   CD 0000*              	CALL	PUTGAP
  2284'   3E 0A                 	MVI	A,LF
  2286'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  2289'                         EX_WR:
  2289'   3A 2E69'              	LDA	EXARG
  228C'   B7                    	ORA	A
  228D'   CA 2687'              	JZ	MSGNFN		; No file name
  2290'   CD 24D0'              	CALL	ISOWN
  2293'   CA 2333'              	JZ	EXW_OW
  2296'   CD 0000*              	CALL	TEXIST
  2299'   32 2ED2'              	STA	RWERR		; nonzero: a file of that name is there
  229C'   CA 22A6'              	JZ	EXW_GO
  229F'   3A 2E7B'              	LDA	EXBANG
  22A2'   B7                    	ORA	A
  22A3'   C2 268D'              	JNZ	MSGEXI		; File exists (! to force)
  22A6'                         EXW_GO:
  22A6'   CD 223F'              	CALL	EXRNG
  22A9'   DA 232D'              	JC	EXW_BD
  22AC'   CD 2267'              	CALL	EXSAVP
  22AF'   2A 2EC5'              	LHLD	SRNG1
  22B2'   CD 225B'              	CALL	GOLNX
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  22B5'   C2 232A'              	JNZ	EXW_NL		; the text has no line N
  22B8'   3A 2ED2'              	LDA	RWERR		; a delete scans the whole directory, there or
  22BB'   B7                    	ORA	A		;   not: only when TEXIST found one
  22BC'   0E 13                 	MVI	C,13H
  22BE'   C4 222F'              	CNZ	TFDOS		; delete what is there
  22C1'   0E 16                 	MVI	C,16H
  22C3'   CD 222F'              	CALL	TFDOS		; ... and make it
  22C6'   3C                    	INR	A
  22C7'   CA 231C'              	JZ	EXW_FL		; no directory entry left
  22CA'   3E 80                 	MVI	A,80H
  22CC'   32 2ED1'              	STA	RWPTR
  22CF'   AF                    	XRA	A
  22D0'   32 2ED2'              	STA	RWERR
  22D3'   2A 2ECF'              	LHLD	SLINES
  22D6'   CD 0000*              	CALL	SETC0		; that many lines, forward
  22D9'                         EXW_LP:
  22D9'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  22DC'   E5                    	PUSH	H
  22DD'   EB                    	XCHG
  22DE'   2A 0000*              	LHLD	GAPEND
  22E1'   CD 2339'              	CALL	RWOUT		; the text from the cursor to there
  22E4'   E1                    	POP	H
  22E5'   3A 2ED2'              	LDA	RWERR
  22E8'   B7                    	ORA	A
  22E9'   C2 2305'              	JNZ	EXW_EN
  22EC'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  22EF'   CD 0747'              	CALL	CNTTST
  22F2'   C2 22D9'              	JNZ	EXW_LP
  22F5'                         EXW_PD:				; the last record is padded out with ^Z
  22F5'   3A 2ED1'              	LDA	RWPTR
  22F8'   FE 80                 	CPI	80H
  22FA'   CA 2305'              	JZ	EXW_EN
  22FD'   3E 1A                 	MVI	A,CPMEOF
  22FF'   CD 2345'              	CALL	RWPUT
  2302'   C3 22F5'              	JMP	EXW_PD
  2305'                         EXW_EN:
  2305'   0E 10                 	MVI	C,10H
  2307'   CD 222F'              	CALL	TFDOS		; close
  230A'   3A 2ED2'              	LDA	RWERR
  230D'   B7                    	ORA	A
  230E'   C2 231C'              	JNZ	EXW_FL
  2311'   CD 2273'              	CALL	EXRSTP
  2314'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  2316'   32 2E79'              	STA	MSGWHT
  2319'   C3 0807'              	JMP	SETMOV		; nothing on the screen has changed
  231C'                         EXW_FL:				; no room: the part written is not left behind
  231C'   0E 13                 	MVI	C,13H
  231E'   CD 222F'              	CALL	TFDOS
  2321'   CD 2273'              	CALL	EXRSTP
  2324'   21 2854'              	LXI	H,SDFUL
  2327'   C3 26BF'              	JMP	EXERR
  232A'                         EXW_NL:
  232A'   CD 2273'              	CALL	EXRSTP
  232D'                         EXW_BD:
  232D'   21 2846'              	LXI	H,SRNGE
  2330'   C3 26BF'              	JMP	EXERR
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  2333'                         EXW_OW:
  2333'   21 26EE'              	LXI	H,SEXI
  2336'   C3 26BF'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  2339'                         RWOUT:
  2339'   CD 0000*              	CALL	CMP16
  233C'   C8                    	RZ
  233D'   7E                    	MOV	A,M
  233E'   23                    	INX	H
  233F'   CD 2345'              	CALL	RWPUT
  2342'   C3 2339'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  2345'                         RWPUT:
  2345'   E5                    	PUSH	H
  2346'   F5                    	PUSH	PSW
  2347'   3A 2ED1'              	LDA	RWPTR
  234A'   6F                    	MOV	L,A
  234B'   26 00                 	MVI	H,0
  234D'   F1                    	POP	PSW
  234E'   77                    	MOV	M,A
  234F'   2C                    	INR	L		; Z: that was the record's last byte
  2350'   7D                    	MOV	A,L
  2351'   C2 2364'              	JNZ	RWP_ST
  2354'   D5                    	PUSH	D
  2355'   0E 15                 	MVI	C,15H
  2357'   CD 222F'              	CALL	TFDOS		; write it
  235A'   D1                    	POP	D
  235B'   B7                    	ORA	A
  235C'   CA 2362'              	JZ	RWP_OK
  235F'   32 2ED2'              	STA	RWERR
  2362'                         RWP_OK:
  2362'   3E 80                 	MVI	A,80H
  2364'                         RWP_ST:
  2364'   32 2ED1'              	STA	RWPTR
  2367'   E1                    	POP	H
  2368'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  2369'                         EX_R:
  2369'   3A 2E69'              	LDA	EXARG
  236C'   B7                    	ORA	A
  236D'   CA 2687'              	JZ	MSGNFN		; No file name
  2370'   0E 0F                 	MVI	C,0FH
  2372'   CD 222F'              	CALL	TFDOS		; open
  2375'   3C                    	INR	A
  2376'   CA 2443'              	JZ	ER_NOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  2379'   CD 12DF'              	CALL	GZONE		; the screen's top line, before anything moves
  237C'   CD 2267'              	CALL	EXSAVP
  237F'   3A 2EC4'              	LDA	SRNGF
  2382'   B7                    	ORA	A
  2383'   CA 239C'              	JZ	ER_NXT		; no line given: below the cursor's
  2386'   2A 2EC7'              	LHLD	SRNG2
  2389'   7C                    	MOV	A,H
  238A'   B5                    	ORA	L
  238B'   C2 2396'              	JNZ	ER_LN
  238E'   23                    	INX	H
  238F'   CD 124D'              	CALL	GOLN		; ':0r': above line 1 ...
  2392'   AF                    	XRA	A		;   which never wants a line end put in first
  2393'   C3 23BE'              	JMP	ER_BRK
  2396'                         ER_LN:
  2396'   CD 225B'              	CALL	GOLNX
  2399'   C2 232A'              	JNZ	EXW_NL		; the text has no line N
  239C'                         ER_NXT:
  239C'   21 0001               	LXI	H,1
  239F'   AF                    	XRA	A
  23A0'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  23A3'   CD 0AE9'              	CALL	ATEOF
  23A6'   3E 00                 	MVI	A,0
  23A8'   D2 23BE'              	JNC	ER_BRK		; text follows
  23AB'   2A 0000*              	LHLD	GAPBEG
  23AE'   EB                    	XCHG
  23AF'   2A 0000*              	LHLD	TXTBEG
  23B2'   CD 0000*              	CALL	CMP16
  23B5'   3E 01                 	MVI	A,1
  23B7'   CA 23BE'              	JZ	ER_BRK		; nothing before the cursor either
  23BA'   1B                    	DCX	D
  23BB'   1A                    	LDAX	D
  23BC'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  23BE'                         ER_BRK:
  23BE'   32 2ED4'              	STA	RDBRK
  23C1'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  23C4'   AF                    	XRA	A
  23C5'   32 2ED3'              	STA	RDANY
  23C8'                         ER_LP:
  23C8'   0E 14                 	MVI	C,14H
  23CA'   CD 222F'              	CALL	TFDOS		; the next record
  23CD'   B7                    	ORA	A
  23CE'   C2 2401'              	JNZ	ER_END
  23D1'   21 0080               	LXI	H,CMDTAIL
  23D4'   0E 00                 	MVI	C,0
  23D6'                         ER_SC:				; C = its bytes, up to a ^Z
  23D6'   7E                    	MOV	A,M
  23D7'   FE 1A                 	CPI	CPMEOF
  23D9'   CA 23E1'              	JZ	ER_GOT
  23DC'   23                    	INX	H
  23DD'   0C                    	INR	C
  23DE'   F2 23D6'              	JP	ER_SC		; (minus: all 128)
  23E1'                         ER_GOT:
  23E1'   79                    	MOV	A,C
  23E2'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  23E3'   CA 2401'              	JZ	ER_END
  23E6'   C5                    	PUSH	B
  23E7'   3A 2ED3'              	LDA	RDANY
  23EA'   B7                    	ORA	A
  23EB'   CC 2432'              	CZ	ER_1ST
  23EE'   C1                    	POP	B
  23EF'   06 00                 	MVI	B,0
  23F1'   11 0080               	LXI	D,CMDTAIL
  23F4'   C5                    	PUSH	B
  23F5'   CD 0000*              	CALL	INSBLK
  23F8'   C1                    	POP	B
  23F9'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  23FC'   79                    	MOV	A,C
  23FD'   17                    	RAL
  23FE'   DA 23C8'              	JC	ER_LP		; a full record: there may be more
  2401'                         ER_END:
  2401'   3A 2ED3'              	LDA	RDANY
  2404'   B7                    	ORA	A
  2405'   CA 2423'              	JZ	ER_PL		; nothing in the file: nothing has changed
  2408'   CD 0AE9'              	CALL	ATEOF
  240B'   DA 2418'              	JC	ER_MD		; the text now ends as the file read ends
  240E'   2A 0000*              	LHLD	GAPBEG
  2411'   2B                    	DCX	H
  2412'   7E                    	MOV	A,M
  2413'   FE 0A                 	CPI	LF
  2415'   C4 227F'              	CNZ	PUTBRK		; text follows: what was read ends a line
  2418'                         ER_MD:
  2418'   3E 01                 	MVI	A,1
  241A'   32 2E06'              	STA	MODF
  241D'   CD 03A9'              	CALL	MKPAGE		; back to the first line read
  2420'   CD 0000*              	CALL	GOTO
  2423'                         ER_PL:
  2423'   CD 0AE9'              	CALL	ATEOF
  2426'   DC 0AEF'              	CC	LASTLN		; (nothing read, at the end: the last line)
  2429'   CD 0000*              	CALL	CLRCNT
  242C'   CD 12F7'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  242F'   C3 0844'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  2432'                         ER_1ST:
  2432'   3C                    	INR	A
  2433'   32 2ED3'              	STA	RDANY
  2436'   3A 2ED4'              	LDA	RDBRK
  2439'   B7                    	ORA	A
  243A'   C4 227F'              	CNZ	PUTBRK
  243D'   21 2EA6'              	LXI	H,MKPOS
  2440'   C3 0429'              	JMP	FPSTO
  2443'                         ER_NOF:
  2443'   21 2835'              	LXI	H,SNOPN
  2446'   C3 26B4'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  2449'                         WRCHK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  2449'   3A 2E69'              	LDA	EXARG
  244C'   B7                    	ORA	A
  244D'   C2 2457'              	JNZ	WC_ARG
  2450'   CD 24BA'              	CALL	OWNTF
  2453'   D8                    	RC
  2454'   C3 246C'              	JMP	WC_OWN
  2457'                         WC_ARG:
  2457'   CD 24D0'              	CALL	ISOWN
  245A'   CA 246C'              	JZ	WC_OWN
  245D'   3A 2E7B'              	LDA	EXBANG
  2460'   B7                    	ORA	A
  2461'   CA 246A'              	JZ	WC_OTH
  2464'   CD 0000*              	CALL	TEXIST
  2467'   C2 268D'              	JNZ	MSGEXI		; File exists (! to force)
  246A'                         WC_OTH:
  246A'   AF                    	XRA	A		; (NC)
  246B'   C9                    	RET
  246C'                         WC_OWN:
  246C'   3A 2E7C'              	LDA	ROFLAG		; '-R': this is the file it may not write
  246F'   B7                    	ORA	A
  2470'   CA 247A'              	JZ	WC_OK
  2473'   3A 2E7B'              	LDA	EXBANG
  2476'   B7                    	ORA	A
  2477'   C2 2693'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  247A'                         WC_OK:
  247A'   3E 01                 	MVI	A,1
  247C'   B7                    	ORA	A		; (NC)
  247D'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  247E'                         WRITE:
  247E'   3A 2E6A'              	LDA	EXBAK
  2481'   CD 0000*              	CALL	WRTO
  2484'   3A 0001*              	LDA	FNAME+1
  2487'   FE 20                 	CPI	' '
  2489'   C2 2495'              	JNZ	WR_HAS
  248C'   21 0000*              	LXI	H,TFCB
  248F'   11 0000*              	LXI	D,FNAME
  2492'   CD 24E2'              	CALL	COPY12
  2495'                         WR_HAS:
  2495'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  2497'   32 2E79'              	STA	MSGWHT
  249A'   CD 24D0'              	CALL	ISOWN
  249D'   C2 24A7'              	JNZ	SRCTF
  24A0'   AF                    	XRA	A
  24A1'   32 2E06'              	STA	MODF
  24A4'   32 2E7A'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  24A7'                         SRCTF:
  24A7'   21 0000*              	LXI	H,TFCB
  24AA'   11 005C               	LXI	D,DFTFCB
  24AD'   CD 24E2'              	CALL	COPY12
  24B0'   AF                    	XRA	A
  24B1'   06 04                 	MVI	B,4
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  24B3'                         SRC_Z:
  24B3'   12                    	STAX	D		; extent, s1, s2, record count: 0
  24B4'   13                    	INX	D
  24B5'   05                    	DCR	B
  24B6'   C2 24B3'              	JNZ	SRC_Z
  24B9'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  24BA'                         OWNTF:
  24BA'   3A 0001*              	LDA	FNAME+1
  24BD'   FE 20                 	CPI	' '
  24BF'   CA 2687'              	JZ	MSGNFN
  24C2'   CD 24ED'              	CALL	TFCLR
  24C5'   21 0000*              	LXI	H,FNAME
  24C8'   11 0000*              	LXI	D,TFCB
  24CB'   CD 24E2'              	CALL	COPY12
  24CE'   B7                    	ORA	A		; (NC)
  24CF'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  24D0'                         ISOWN:
  24D0'   21 0000*              	LXI	H,TFCB
  24D3'   11 0000*              	LXI	D,FNAME
  24D6'   06 0C                 	MVI	B,12
  24D8'                         IO_LP:
  24D8'   1A                    	LDAX	D
  24D9'   BE                    	CMP	M
  24DA'   C0                    	RNZ
  24DB'   23                    	INX	H
  24DC'   13                    	INX	D
  24DD'   05                    	DCR	B
  24DE'   C2 24D8'              	JNZ	IO_LP
  24E1'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  24E2'                         COPY12:
  24E2'   06 0C                 	MVI	B,12
  24E4'                         CP_LP:
  24E4'   7E                    	MOV	A,M
  24E5'   12                    	STAX	D
  24E6'   23                    	INX	H
  24E7'   13                    	INX	D
  24E8'   05                    	DCR	B
  24E9'   C2 24E4'              	JNZ	CP_LP
  24EC'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  24ED'                         TFCLR:
  24ED'   11 0000*              	LXI	D,TFCB
  24F0'   06 24                 	MVI	B,36
  24F2'   AF                    	XRA	A
  24F3'                         TC_LP:
  24F3'   12                    	STAX	D
  24F4'   13                    	INX	D
  24F5'   05                    	DCR	B
  24F6'   C2 24F3'              	JNZ	TC_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  24F9'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  24FA'                         FOPEN:
  24FA'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  24FC'   32 2E79'              	STA	MSGWHT
  24FF'   21 005C               	LXI	H,DFTFCB
  2502'   CD 25D0'              	CALL	NRMDRV
  2505'   11 0000*              	LXI	D,FNAME
  2508'   CD 24E2'              	CALL	COPY12
  250B'   CD 0000*              	CALL	OPENZ
  250E'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  2511'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  2513'   C8                    	RZ
  2514'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  2517'   32 2E7A'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  251A'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  251B'                         ARGSCN:
  251B'   3A 0080               	LDA	CMDTAIL
  251E'   47                    	MOV	B,A		; B = what is left of the line
  251F'   B7                    	ORA	A
  2520'   C8                    	RZ
  2521'   21 0081               	LXI	H,CMDTAIL+1
  2524'                         AS_TOK:				; at a token, or the blanks before one
  2524'   7E                    	MOV	A,M
  2525'   FE 20                 	CPI	' '
  2527'   C2 2530'              	JNZ	AS_OPT
  252A'   23                    	INX	H
  252B'   05                    	DCR	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  252C'   C2 2524'              	JNZ	AS_TOK
  252F'   C9                    	RET
  2530'                         AS_OPT:
  2530'   FE 2B                 	CPI	'+'
  2532'   CA 255C'              	JZ	AS_PLS
  2535'   FE 2D                 	CPI	'-'
  2537'   CA 254B'              	JZ	AS_SW
  253A'   FE 2F                 	CPI	'/'
  253C'   CA 254B'              	JZ	AS_SW
  253F'                         AS_SKP:				; not ours (the file name): on to the next one
  253F'   23                    	INX	H
  2540'   05                    	DCR	B
  2541'   C8                    	RZ
  2542'   7E                    	MOV	A,M
  2543'   FE 20                 	CPI	' '
  2545'   C2 253F'              	JNZ	AS_SKP
  2548'   C3 2524'              	JMP	AS_TOK
  254B'                         AS_SW:
  254B'   23                    	INX	H
  254C'   05                    	DCR	B
  254D'   C8                    	RZ
  254E'   7E                    	MOV	A,M
  254F'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  2551'   FE 52                 	CPI	'R'
  2553'   C2 253F'              	JNZ	AS_SKP
  2556'   32 2E7C'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  2559'   C3 253F'              	JMP	AS_SKP
  255C'                         AS_PLS:
  255C'   3E 01                 	MVI	A,1
  255E'   32 2E7D'              	STA	PLUSF		; '+' gets the line even with no number on it
  2561'   11 0000*              	LXI	D,PLUSB
  2564'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  2566'   23                    	INX	H		;   line space, so it is taken as '+' alone
  2567'   05                    	DCR	B
  2568'   CA 259F'              	JZ	AS_PE
  256B'   7E                    	MOV	A,M
  256C'   FE 30                 	CPI	'0'
  256E'   C2 2586'              	JNZ	AS_PD
  2571'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  2571'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  2572'   05                    	DCR	B
  2573'   CA 25A7'              	JZ	AS_P1
  2576'   7E                    	MOV	A,M
  2577'   FE 30                 	CPI	'0'
  2579'   CA 2571'              	JZ	AS_PZ
  257C'   FE 31                 	CPI	'1'
  257E'   DA 25A7'              	JC	AS_P1		; zeros and then no digit at all: line 1
  2581'   FE 3A                 	CPI	'9'+1
  2583'   D2 25A7'              	JNC	AS_P1
  2586'                         AS_PD:				; the digits, as typed
  2586'   7E                    	MOV	A,M
  2587'   FE 30                 	CPI	'0'
  2589'   DA 259F'              	JC	AS_PE
  258C'   FE 3A                 	CPI	'9'+1
  258E'   D2 259F'              	JNC	AS_PE
  2591'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


  2592'   B7                    	ORA	A
  2593'   CA 25AE'              	JZ	AS_POV
  2596'   0D                    	DCR	C
  2597'   7E                    	MOV	A,M
  2598'   12                    	STAX	D
  2599'   13                    	INX	D
  259A'   23                    	INX	H
  259B'   05                    	DCR	B
  259C'   C2 2586'              	JNZ	AS_PD
  259F'                         AS_PE:
  259F'   AF                    	XRA	A
  25A0'   12                    	STAX	D		; the digits end with a 0
  25A1'   78                    	MOV	A,B
  25A2'   B7                    	ORA	A
  25A3'   C8                    	RZ
  25A4'   C3 2524'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  25A7'                         AS_P1:
  25A7'   3E 31                 	MVI	A,'1'
  25A9'   12                    	STAX	D
  25AA'   13                    	INX	D
  25AB'   C3 259F'              	JMP	AS_PE
  25AE'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  25AE'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  25B1'   C3 259F'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  25B4'                         ARGGO:
  25B4'   3A 2E7D'              	LDA	PLUSF
  25B7'   B7                    	ORA	A
  25B8'   C8                    	RZ
  25B9'   21 0000*              	LXI	H,PLUSB
  25BC'                         AG_LP:
  25BC'   7E                    	MOV	A,M
  25BD'   B7                    	ORA	A
  25BE'   CA 25CB'              	JZ	AG_G
  25C1'   4F                    	MOV	C,A
  25C2'   E5                    	PUSH	H
  25C3'   CD 0023'              	CALL	VICMD
  25C6'   E1                    	POP	H
  25C7'   23                    	INX	H
  25C8'   C3 25BC'              	JMP	AG_LP
  25CB'                         AG_G:
  25CB'   0E 47                 	MVI	C,'G'
  25CD'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  25D0'                         NRMDRV:
  25D0'   7E                    	MOV	A,M
  25D1'   B7                    	ORA	A
  25D2'   C0                    	RNZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  25D3'   E5                    	PUSH	H
  25D4'   0E 19                 	MVI	C,BF_CURDSK
  25D6'   CD 0005               	CALL	BDOS
  25D9'   E1                    	POP	H
  25DA'   3C                    	INR	A
  25DB'   77                    	MOV	M,A
  25DC'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  25DD'                         PARSFN:
  25DD'   CD 24ED'              	CALL	TFCLR
  25E0'   11 0000*              	LXI	D,TFCB
  25E3'   23                    	INX	H
  25E4'   7E                    	MOV	A,M
  25E5'   2B                    	DCX	H
  25E6'   FE 3A                 	CPI	':'
  25E8'   C2 25FA'              	JNZ	PF_NM
  25EB'   CD 2640'              	CALL	GETFNC
  25EE'   CA 25FA'              	JZ	PF_NM
  25F1'   D6 40                 	SUI	40H
  25F3'   12                    	STAX	D
  25F4'   FE 11                 	CPI	17
  25F6'   D2 261E'              	JNC	PF_BAD
  25F9'   23                    	INX	H
  25FA'                         PF_NM:
  25FA'   13                    	INX	D
  25FB'   0E 08                 	MVI	C,8
  25FD'   CD 2622'              	CALL	CPYNAM
  2600'   FE 2E                 	CPI	'.'
  2602'   0E 03                 	MVI	C,3
  2604'   C4 2635'              	CNZ	PADFLD		; no type: blanks
  2607'   CC 2621'              	CZ	CPYNM0		; '.': the type
  260A'   3A 0001*              	LDA	TFCB+1
  260D'   FE 20                 	CPI	' '
  260F'   CA 261E'              	JZ	PF_BAD		; no name
  2612'   CD 2673'              	CALL	SKIPB
  2615'   C0                    	RNZ			; more after it
  2616'   21 0000*              	LXI	H,TFCB
  2619'   CD 25D0'              	CALL	NRMDRV
  261C'   AF                    	XRA	A
  261D'   C9                    	RET
  261E'                         PF_BAD:
  261E'   F6 01                 	ORI	1
  2620'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  2621'                         CPYNM0:
  2621'   23                    	INX	H
  2622'                         CPYNAM:
  2622'   CD 2640'              	CALL	GETFNC
  2625'   CA 2635'              	JZ	PADFLD
  2628'   12                    	STAX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  2629'   13                    	INX	D
  262A'   0D                    	DCR	C
  262B'   C2 2622'              	JNZ	CPYNAM
