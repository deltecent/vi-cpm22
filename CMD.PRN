  095A'   CD 0677'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  095D'   22 2912'              	SHLD	JKBK
  0960'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0963'   7C                    	MOV	A,H
  0964'   B5                    	ORA	L
  0965'   CA 0972'              	JZ	KC_B0
  0968'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  096B'   D1                    	POP	D
  096C'   DA 0973'              	JC	KC_BOF
  096F'   C3 092C'              	JMP	KC_ED
  0972'                         KC_B0:
  0972'   D1                    	POP	D
  0973'                         KC_BOF:
  0973'   2A 290E'              	LHLD	JKN		; moved = LFs found
  0976'   CD 0000*              	CALL	SUBHD
  0979'                         KC_MV:
  0979'   E5                    	PUSH	H
  097A'   2A 290C'              	LHLD	JKCNT
