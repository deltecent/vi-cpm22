  247D'   15                    	DB	15H			; ^U -- half page up
  247E'   0D91'                 	DW	VC_HFUP
  2480'   0C                    	DB	0CH			; ^L -- redraw
  2481'   0E05'                 	DW	VC_REDR
  2483'   2E                    	DB	'.'			; '.' -- repeat the last change
  2484'   0191'                 	DW	VC_DOT
  2486'   75                    	DB	'u'			; 'u' -- undo (and undo the undo)
  2487'   04D9'                 	DW	VC_UNDO
  2489'   6D                    	DB	'm'		; m{a-c} -- set a mark
  248A'   0350'                 	DW	VC_MK
  248C'   60                    	DB	60H		; `{a-c} -- back to its exact spot
  248D'   0355'                 	DW	VC_BQ
  248F'   27                    	DB	27H		; '{a-c} -- back to its line's first non-blank
  2490'   035A'                 	DW	VC_AQ
  2492'   00                    	DB	0
                                
