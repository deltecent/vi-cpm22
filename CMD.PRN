  2909'   AF                    	XRA	A
  290A'   32 2A82'              	STA	MSGWHT
  290D'   78                    	MOV	A,B
  290E'   FE 01                 	CPI	MW_FIL
  2910'   CA 292C'              	JZ	MP_FIL
  2913'   FE 02                 	CPI	MW_WRT
  2915'   CA 2932'              	JZ	MP_WRT
  2918'   FE 04                 	CPI	MW_BIG
  291A'   CA 2923'              	JZ	MP_BIG
