                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  234E'                         EXADDR:
  234E'   AF                    	XRA	A
  234F'   32 29A7'              	STA	SRNGF
  2352'   7E                    	MOV	A,M
  2353'   FE 25                 	CPI	'%'
  2355'   CA 237E'              	JZ	EXA_AL
  2358'   EB                    	XCHG			; DE walks the line, HL takes the number
  2359'   CD 2393'              	CALL	EXNUM
  235C'   DA 237C'              	JC	EXA_NO
  235F'   22 29A8'              	SHLD	SRNG1
  2362'   22 29AA'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  2365'   1A                    	LDAX	D
  2366'   FE 2C                 	CPI	','
  2368'   C2 2375'              	JNZ	EXA_YS
  236B'   13                    	INX	D
  236C'   CD 2393'              	CALL	EXNUM
  236F'   DA 237C'              	JC	EXA_NO		; ',' with no number: not a range at all
  2372'   22 29AA'              	SHLD	SRNG2
  2375'                         EXA_YS:
  2375'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  2376'   3E 01                 	MVI	A,1
  2378'   32 29A7'              	STA	SRNGF
  237B'   C9                    	RET
  237C'                         EXA_NO:
  237C'   EB                    	XCHG
  237D'   C9                    	RET
  237E'                         EXA_AL:
  237E'   23                    	INX	H
  237F'   E5                    	PUSH	H
  2380'   21 0001               	LXI	H,1
  2383'   22 29A8'              	SHLD	SRNG1
  2386'   21 FFFF               	LXI	H,0FFFFH
  2389'   22 29AA'              	SHLD	SRNG2
  238C'   E1                    	POP	H
  238D'   3E 01                 	MVI	A,1
  238F'   32 29A7'              	STA	SRNGF
  2392'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  2393'                         EXNUM:
  2393'   1A                    	LDAX	D
  2394'   D6 30                 	SUI	'0'
  2396'   D8                    	RC
  2397'   FE 0A                 	CPI	10
  2399'   3F                    	CMC
  239A'   D8                    	RC
  239B'   21 0000               	LXI	H,0
  239E'                         EXN_LP:
  239E'   1A                    	LDAX	D
  239F'   D6 30                 	SUI	'0'
  23A1'   DA 23BB'              	JC	EXN_DN
  23A4'   FE 0A                 	CPI	10
  23A6'   D2 23BB'              	JNC	EXN_DN
  23A9'   13                    	INX	D
  23AA'   C5                    	PUSH	B
  23AB'   4F                    	MOV	C,A
  23AC'   06 00                 	MVI	B,0		; BC = the digit
  23AE'   D5                    	PUSH	D
  23AF'   54                    	MOV	D,H
  23B0'   5D                    	MOV	E,L
  23B1'   29                    	DAD	H		; *2
  23B2'   29                    	DAD	H		; *4
  23B3'   19                    	DAD	D		; *5
  23B4'   29                    	DAD	H		; *10
  23B5'   D1                    	POP	D
  23B6'   09                    	DAD	B
  23B7'   C1                    	POP	B
  23B8'   C3 239E'              	JMP	EXN_LP
  23BB'                         EXN_DN:
  23BB'   B7                    	ORA	A		; CY clear: there was a number
  23BC'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  23BD'                         EX_S:
  23BD'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  23BE'   B7                    	ORA	A
  23BF'   CA 2401'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  23C2'   32 29AC'              	STA	SDELIM
  23C5'   23                    	INX	H
  23C6'   11 0000*              	LXI	D,SRCHST
  23C9'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  23CC'   4F                    	MOV	C,A
  23CD'   CD 2407'              	CALL	SCOPY
  23D0'   78                    	MOV	A,B
  23D1'   B7                    	ORA	A
  23D2'   CA 2401'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  23D5'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  23D8'   3E 01                 	MVI	A,1
  23DA'   32 2977'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  23DD'   11 29BD'              	LXI	D,SREPL
  23E0'   0E 24                 	MVI	C,SREPMX
  23E2'   CD 2407'              	CALL	SCOPY
  23E5'   78                    	MOV	A,B
  23E6'   32 29BC'              	STA	SREPLN
  23E9'   AF                    	XRA	A
  23EA'   32 29AD'              	STA	SGFLAG
  23ED'   7E                    	MOV	A,M
  23EE'   FE 67                 	CPI	'g'
  23F0'   C2 23F9'              	JNZ	EX_SG
  23F3'   23                    	INX	H
  23F4'   3E 01                 	MVI	A,1
  23F6'   32 29AD'              	STA	SGFLAG
  23F9'                         EX_SG:
  23F9'   7E                    	MOV	A,M
  23FA'   B7                    	ORA	A
  23FB'   C2 21A4'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  23FE'   C3 2427'              	JMP	SUBGO
  2401'                         SUBNOP:
  2401'   21 2250'              	LXI	H,SNOPAT
  2404'   C3 21B2'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  2407'                         SCOPY:
  2407'   06 00                 	MVI	B,0
  2409'                         SCP_LP:
  2409'   78                    	MOV	A,B
  240A'   B9                    	CMP	C
  240B'   D2 2424'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  240E'   7E                    	MOV	A,M
  240F'   B7                    	ORA	A
  2410'   CA 2424'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  2413'   E5                    	PUSH	H
  2414'   21 29AC'              	LXI	H,SDELIM
  2417'   BE                    	CMP	M
  2418'   E1                    	POP	H
  2419'   CA 2423'              	JZ	SCP_SK
  241C'   12                    	STAX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  241D'   13                    	INX	D
  241E'   23                    	INX	H
  241F'   04                    	INR	B
  2420'   C3 2409'              	JMP	SCP_LP
  2423'                         SCP_SK:
  2423'   23                    	INX	H
  2424'                         SCP_DN:
  2424'   AF                    	XRA	A
  2425'   12                    	STAX	D
  2426'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  2427'                         SUBGO:
  2427'   CD 0ED3'              	CALL	GZONE
  242A'   2A 0000*              	LHLD	LNDLT
  242D'   22 29BA'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  2430'   CD 0000*              	CALL	CUROFF		;   finds nothing puts both back, as the
  2433'   22 29B8'              	SHLD	SOFFS		;   search's SN_BAD does
  2436'   AF                    	XRA	A
  2437'   32 29AE'              	STA	SANY
  243A'   21 0000               	LXI	H,0
  243D'   22 29B0'              	SHLD	SBACK
  2440'   3A 29A7'              	LDA	SRNGF
  2443'   B7                    	ORA	A
  2444'   CA 2456'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  2447'   CD 1D2E'              	CALL	EXRNG		; SLINES = the lines in the range
  244A'   DA 24D2'              	JC	SUBBAD
  244D'   2A 29A8'              	LHLD	SRNG1
  2450'   CD 0E44'              	CALL	GOLN
  2453'   C3 245C'              	JMP	SUBLP
  2456'                         SUB_1L:
  2456'   21 0001               	LXI	H,1
  2459'   22 29B2'              	SHLD	SLINES
  245C'                         SUBLP:
  245C'   CD 24D8'              	CALL	SUBLIN		; A = 1 when this line changed
  245F'   B7                    	ORA	A
  2460'   CA 246E'              	JZ	SUB_NX
  2463'   3E 01                 	MVI	A,1
  2465'   32 29AE'              	STA	SANY
  2468'   21 0000               	LXI	H,0
  246B'   22 29B0'              	SHLD	SBACK		; the cursor is ON the last line changed
  246E'                         SUB_NX:
  246E'   2A 29B2'              	LHLD	SLINES
  2471'   2B                    	DCX	H
  2472'   22 29B2'              	SHLD	SLINES
  2475'   7C                    	MOV	A,H
  2476'   B5                    	ORA	L
  2477'   CA 2495'              	JZ	SUBDON		; the range is spent
  247A'   21 0001               	LXI	H,1
  247D'   AF                    	XRA	A
  247E'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  2481'   3A 29AE'              	LDA	SANY
  2484'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  2485'   CA 248F'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  2488'   2A 29B0'              	LHLD	SBACK
  248B'   23                    	INX	H
  248C'   22 29B0'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  248F'                         SUB_AE:
  248F'   CD 0989'              	CALL	ATEOF
  2492'   D2 245C'              	JNC	SUBLP		; ... unless that ran off the end of the file
  2495'                         SUBDON:
  2495'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  2498'   3A 29AE'              	LDA	SANY
  249B'   B7                    	ORA	A
  249C'   CA 24BA'              	JZ	SUBNFD
  249F'   3E 01                 	MVI	A,1
  24A1'   32 28F8'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  24A4'   2A 29B0'              	LHLD	SBACK
  24A7'   7C                    	MOV	A,H
  24A8'   B5                    	ORA	L
  24A9'   CA 24B4'              	JZ	SUB_PL
  24AC'   3E FF                 	MVI	A,0FFH
  24AE'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  24B1'   CD 0000*              	CALL	CLRCNT
  24B4'                         SUB_PL:
  24B4'   CD 0EEB'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  24B7'   C3 0700'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  24BA'                         SUBNFD:
  24BA'   2A 29B8'              	LHLD	SOFFS
  24BD'   CD 0000*              	CALL	GOTO
  24C0'   2A 29BA'              	LHLD	SLDLTS
  24C3'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  24C6'   21 223C'              	LXI	H,SNOTFD
  24C9'   CD 21B2'              	CALL	EXERR
  24CC'   21 0000*              	LXI	H,SRCHST
  24CF'   C3 21AD'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  24D2'                         SUBBAD:
  24D2'   21 222A'              	LXI	H,SNOT
  24D5'   C3 21A7'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


                                ;bytes) and paging shifts every logical offset in the window.
  24D8'                         SUBLIN:
  24D8'   AF                    	XRA	A
  24D9'   32 29AF'              	STA	SLCHG
  24DC'   CD 2557'              	CALL	SUBBOL
  24DF'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  24E2'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  24E2'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  24E5'   DA 24ED'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  24E8'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  24EA'   C2 24E2'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  24ED'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  24ED'   CD 0000*              	CALL	CUROFF
  24F0'   E5                    	PUSH	H
  24F1'   CD 13E7'              	CALL	CEND
  24F4'   D1                    	POP	D
  24F5'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  24F8'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  24F9'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  24FC'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  24FD'   B7                    	ORA	A		;   span is a line, not a pair.)
  24FE'   FA 2550'              	JM	SUBL_D		; what is left is shorter than the pattern
  2501'   44                    	MOV	B,H
  2502'   4D                    	MOV	C,L		; BC = the start positions a match can take
  2503'   11 0000*              	LXI	D,SRCHST
  2506'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  2509'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  250C'   DA 2550'              	JC	SUBL_D
  250F'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  2512'   EB                    	XCHG
  2513'   2A 0000*              	LHLD	GAPEND
  2516'   EB                    	XCHG
  2517'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  251A'   EB                    	XCHG
  251B'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  251C'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  251F'   D1                    	POP	D
  2520'   19                    	DAD	D		; ... and so the match's logical offset
  2521'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  2524'   3A 29AE'              	LDA	SANY
  2527'   B7                    	ORA	A
  2528'   C2 2535'              	JNZ	SUBL_C
  252B'   3A 29AF'              	LDA	SLCHG
  252E'   B7                    	ORA	A
  252F'   C2 2535'              	JNZ	SUBL_C
  2532'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  2535'                         SUBL_C:
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  2535'   3A 0000*              	LDA	SRCHBF
  2538'   6F                    	MOV	L,A
  2539'   26 00                 	MVI	H,0
  253B'   CD 0000*              	CALL	DELFWD		; the match goes
  253E'   11 29BC'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  2541'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  2544'                         SUBL_I:
  2544'   3E 01                 	MVI	A,1
  2546'   32 29AF'              	STA	SLCHG
  2549'   3A 29AD'              	LDA	SGFLAG
  254C'   B7                    	ORA	A
  254D'   C2 24ED'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  2550'                         SUBL_D:
  2550'   CD 2557'              	CALL	SUBBOL
  2553'   3A 29AF'              	LDA	SLCHG
  2556'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  2557'                         SUBBOL:
  2557'   CD 0000*              	CALL	CUROFF
  255A'   CD 05CB'              	CALL	BOL
  255D'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  2560'                         VC_SRCH:
  2560'   CD 06DF'              	CALL	SETMOV
  2563'   C5                    	PUSH	B
  2564'   CD 0672'              	CALL	GETCNT
  2567'   22 29A0'              	SHLD	SCNT
  256A'   C1                    	POP	B
  256B'   79                    	MOV	A,C
  256C'   FE 2F                 	CPI	'/'
  256E'   3E 00                 	MVI	A,0
  2570'   CA 2575'              	JZ	VS_DIR
  2573'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  2575'                         VS_DIR:
  2575'   32 2975'              	STA	SDIR
  2578'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  257B'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  257E'   47                    	MOV	B,A
  257F'   CD 1ACA'              	CALL	RDLINE
  2582'   B7                    	ORA	A
  2583'   C0                    	RNZ			; cancelled: nothing happens at all
  2584'   3A 294D'              	LDA	RLLEN
  2587'   B7                    	ORA	A
  2588'   CA 259D'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  258B'   5F                    	MOV	E,A
  258C'   16 00                 	MVI	D,0
  258E'   21 0000*              	LXI	H,SRCHST
  2591'   19                    	DAD	D
  2592'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  2594'   7B                    	MOV	A,E
  2595'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  2598'   3E 01                 	MVI	A,1
  259A'   32 2977'              	STA	SHAVE
  259D'                         VS_OLD:
  259D'   3A 2977'              	LDA	SHAVE
  25A0'   B7                    	ORA	A
  25A1'   CA 25AD'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  25A4'   3A 2975'              	LDA	SDIR
  25A7'   32 2976'              	STA	SDIRE
  25AA'   C3 25D6'              	JMP	SRCHN
  25AD'                         VS_NOP:
  25AD'   21 2250'              	LXI	H,SNOPAT
  25B0'   C3 21B2'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  25B3'                         VC_N:
  25B3'   CD 06DF'              	CALL	SETMOV
  25B6'   3A 2975'              	LDA	SDIR
  25B9'   C3 25C3'              	JMP	VN_GO
  25BC'                         VCB_N:
  25BC'   CD 06DF'              	CALL	SETMOV
  25BF'   3A 2975'              	LDA	SDIR
  25C2'   2F                    	CMA			; the other way: 0 <-> FFH
  25C3'                         VN_GO:
  25C3'   32 2976'              	STA	SDIRE
  25C6'   CD 0672'              	CALL	GETCNT
  25C9'   22 29A0'              	SHLD	SCNT
  25CC'   3A 2977'              	LDA	SHAVE
  25CF'   B7                    	ORA	A
  25D0'   CA 25AD'              	JZ	VS_NOP
  25D3'   C3 25D6'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  25D6'                         SRCHN:
  25D6'   CD 0ED3'              	CALL	GZONE		; the screen's top line, before the cursor moves
  25D9'   2A 0000*              	LHLD	LNDLT
  25DC'   22 29A4'              	SHLD	SLDLT		; the sweep moves the cursor with PUTCUR, which
                                				;   does not maintain LNDLT (GOTO does)
  25DF'   CD 0000*              	CALL	CUROFF
  25E2'   22 29A2'              	SHLD	SOFF
  25E5'                         SN_LP:
  25E5'   CD 261D'              	CALL	SRCHGO
  25E8'   DA 2602'              	JC	SN_BAD
  25EB'   2A 29A0'              	LHLD	SCNT
  25EE'   2B                    	DCX	H
  25EF'   22 29A0'              	SHLD	SCNT
  25F2'   7C                    	MOV	A,H
  25F3'   B5                    	ORA	L
  25F4'   C2 25E5'              	JNZ	SN_LP
  25F7'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  25FA'   3E 01                 	MVI	A,1
  25FC'   32 2982'              	STA	GPKEEP		; land on the match, not the first non-blank
  25FF'   C3 0EEB'              	JMP	GPLACE		; (which sets LNDLT itself)
  2602'                         SN_BAD:
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  2602'   CD 0000*              	CALL	CLRCNT
  2605'   2A 29A2'              	LHLD	SOFF
  2608'   CD 0000*              	CALL	GOTO
  260B'   2A 29A4'              	LHLD	SLDLT
  260E'   22 0000*              	SHLD	LNDLT		; nothing moved: the row the cursor was on
  2611'   21 223C'              	LXI	H,SNOTFD
  2614'   CD 21B2'              	CALL	EXERR
  2617'   21 0000*              	LXI	H,SRCHST
  261A'   C3 21AD'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  261D'                         SRCHGO:
  261D'   3E 01                 	MVI	A,1
  261F'   32 29A6'              	STA	SSKIP		; this pass starts one past the cursor
  2622'   CD 2634'              	CALL	SRCHW
  2625'   D0                    	RNC
  2626'   3A 2976'              	LDA	SDIRE
  2629'   2F                    	CMA
  262A'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  262D'   AF                    	XRA	A
  262E'   32 29A6'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  2631'   C3 2634'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  2634'                         SRCHW:
  2634'   3A 2976'              	LDA	SDIRE
  2637'   32 0000*              	STA	DIRFLG
  263A'   21 FFFF               	LXI	H,0FFFFH
  263D'   22 28F5'              	SHLD	CMDCNT
  2640'   AF                    	XRA	A
  2641'   32 0000*              	STA	AUXCNT
  2644'                         SW_LP:
  2644'   CD 2650'              	CALL	SRCH1
  2647'   D0                    	RNC
  2648'   CD 0000*              	CALL	SCRLST
  264B'   D2 2644'              	JNC	SW_LP
  264E'   37                    	STC
  264F'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  2650'                         SRCH1:
  2650'   11 0000*              	LXI	D,SRCHST
  2653'   3A 0000*              	LDA	DIRFLG
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  2656'   B7                    	ORA	A
  2657'   FA 267B'              	JM	SR1_BK
  265A'   21 0000*              	LXI	H,GAPEND
  265D'   CD 0000*              	CALL	FWDCNT
  2660'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  2663'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  2664'   3A 29A6'              	LDA	SSKIP
  2667'   B7                    	ORA	A
  2668'   CA 2671'              	JZ	SR1_FW
  266B'   78                    	MOV	A,B
  266C'   B1                    	ORA	C
  266D'   37                    	STC
  266E'   C8                    	RZ			; no room for a match even before the skip
  266F'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2670'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2671'                         SR1_FW:
  2671'   CD 0000*              	CALL	MATCHF
  2674'   D8                    	RC
  2675'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2678'   C3 0000*              	JMP	PUTCUR
  267B'                         SR1_BK:
  267B'   21 0000*              	LXI	H,TXTBEG
  267E'   CD 0000*              	CALL	FWDCNT
  2681'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2684'   D8                    	RC
  2685'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2688'   CD 0000*              	CALL	MATCHB
  268B'   D8                    	RC
  268C'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  268F'                         MSGNAM:
  268F'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


  2690'   3E 22                 	MVI	A,'"'
  2692'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  2695'   E1                    	POP	H
  2696'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  2697'   23                    	INX	H
  2698'   7E                    	MOV	A,M
  2699'   FE 20                 	CPI	' '
  269B'   C2 26A8'              	JNZ	MN_HAS
  269E'   21 22BE'              	LXI	H,SNONM
  26A1'   CD 0000*              	CALL	OUTSTR
  26A4'   E1                    	POP	H
  26A5'   C3 26F2'              	JMP	MN_END
  26A8'                         MN_HAS:
  26A8'   0E 19                 	MVI	C,BF_CURDSK
  26AA'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  26AD'   E1                    	POP	H
  26AE'   E5                    	PUSH	H
  26AF'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  26B0'   BE                    	CMP	M
  26B1'   CA 26BF'              	JZ	MN_NAM
  26B4'   7E                    	MOV	A,M
  26B5'   C6 40                 	ADI	'A'-1
  26B7'   CD 0000*              	CALL	OUTCH
  26BA'   3E 3A                 	MVI	A,':'
  26BC'   CD 0000*              	CALL	OUTCH
  26BF'                         MN_NAM:
  26BF'   E1                    	POP	H
  26C0'   E5                    	PUSH	H
  26C1'   23                    	INX	H
  26C2'   0E 08                 	MVI	C,8
  26C4'                         MN_NM:
  26C4'   7E                    	MOV	A,M
  26C5'   FE 20                 	CPI	' '
  26C7'   CA 26D2'              	JZ	MN_EXT
  26CA'   CD 0000*              	CALL	OUTCH
  26CD'   23                    	INX	H
  26CE'   0D                    	DCR	C
  26CF'   C2 26C4'              	JNZ	MN_NM
  26D2'                         MN_EXT:
  26D2'   E1                    	POP	H
  26D3'   11 0009               	LXI	D,9
  26D6'   19                    	DAD	D		; the type field
  26D7'   7E                    	MOV	A,M
  26D8'   FE 20                 	CPI	' '
  26DA'   CA 26F2'              	JZ	MN_END
  26DD'   3E 2E                 	MVI	A,'.'
  26DF'   CD 0000*              	CALL	OUTCH
  26E2'   0E 03                 	MVI	C,3
  26E4'                         MN_XL:
  26E4'   7E                    	MOV	A,M
  26E5'   FE 20                 	CPI	' '
  26E7'   CA 26F2'              	JZ	MN_END
  26EA'   CD 0000*              	CALL	OUTCH
  26ED'   23                    	INX	H
  26EE'   0D                    	DCR	C
  26EF'   C2 26E4'              	JNZ	MN_XL
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  26F2'                         MN_END:
  26F2'   3E 22                 	MVI	A,'"'
  26F4'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  26F7'                         MSGFLG:
  26F7'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  26F9'   B7                    	ORA	A
  26FA'   CA 270A'              	JZ	MF_RO
  26FD'   3A 28F8'              	LDA	MODF
  2700'   B7                    	ORA	A
  2701'   CA 270A'              	JZ	MF_RO
  2704'   21 22C8'              	LXI	H,SMODM
  2707'   CD 271F'              	CALL	MF_PUT
  270A'                         MF_RO:
  270A'   3A 2963'              	LDA	ROFLAG
  270D'   B7                    	ORA	A
  270E'   CA 2717'              	JZ	MF_NEW
  2711'   21 22D3'              	LXI	H,SROM
  2714'   CD 271F'              	CALL	MF_PUT
  2717'                         MF_NEW:
  2717'   3A 2961'              	LDA	MSGNEW
  271A'   B7                    	ORA	A
  271B'   C8                    	RZ
  271C'   21 22DE'              	LXI	H,SNEWM
  271F'                         MF_PUT:
  271F'   78                    	MOV	A,B
  2720'   B7                    	ORA	A
  2721'   C2 272D'              	JNZ	MF_STR
  2724'   06 01                 	MVI	B,1
  2726'   E5                    	PUSH	H
  2727'   3E 20                 	MVI	A,' '
  2729'   CD 0000*              	CALL	OUTCH
  272C'   E1                    	POP	H
  272D'                         MF_STR:
  272D'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  2730'                         EMITW:
  2730'   C5                    	PUSH	B
  2731'   D5                    	PUSH	D
  2732'   06 00                 	MVI	B,0
  2734'   11 2710               	LXI	D,10000
  2737'   CD 2755'              	CALL	EWDIG
  273A'   11 03E8               	LXI	D,1000
  273D'   CD 2755'              	CALL	EWDIG
  2740'   11 0064               	LXI	D,100
  2743'   CD 2755'              	CALL	EWDIG
  2746'   11 000A               	LXI	D,10
  2749'   CD 2755'              	CALL	EWDIG
  274C'   7D                    	MOV	A,L		; the units digit is always printed
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  274D'   C6 30                 	ADI	'0'
  274F'   CD 0000*              	CALL	OUTCH
  2752'   D1                    	POP	D
  2753'   C1                    	POP	B
  2754'   C9                    	RET
  2755'                         EWDIG:
  2755'   0E 00                 	MVI	C,0
  2757'                         EW_LP:
  2757'   7D                    	MOV	A,L
  2758'   93                    	SUB	E
  2759'   6F                    	MOV	L,A
  275A'   7C                    	MOV	A,H
  275B'   9A                    	SBB	D
  275C'   67                    	MOV	H,A
  275D'   DA 2764'              	JC	EW_DN
  2760'   0C                    	INR	C
  2761'   C3 2757'              	JMP	EW_LP
  2764'                         EW_DN:
  2764'   19                    	DAD	D		; one subtraction too many: give it back
  2765'   79                    	MOV	A,C
  2766'   B7                    	ORA	A
  2767'   C2 276D'              	JNZ	EW_PR
  276A'   78                    	MOV	A,B
  276B'   B7                    	ORA	A
  276C'   C8                    	RZ			; a leading zero: write nothing
  276D'                         EW_PR:
  276D'   79                    	MOV	A,C
  276E'   C6 30                 	ADI	'0'
  2770'   CD 0000*              	CALL	OUTCH
  2773'   06 01                 	MVI	B,1
  2775'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  2776'                         ISEMPT:
  2776'   2A 0000*              	LHLD	OUTPOS
  2779'   7C                    	MOV	A,H
  277A'   B5                    	ORA	L
  277B'   C0                    	RNZ
  277C'   CD 0000*              	CALL	LOGLEN
  277F'   7C                    	MOV	A,H
  2780'   B5                    	ORA	L
  2781'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  2782'                         MSGCTG:
  2782'   21 0000*              	LXI	H,FNAME
  2785'   CD 268F'              	CALL	MSGNAM
  2788'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  278A'   CD 26F7'              	CALL	MSGFLG
  278D'   CD 2776'              	CALL	ISEMPT
  2790'   C2 2799'              	JNZ	MG_POS
  2793'   21 22F1'              	LXI	H,SNOLIN
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


  2796'   C3 0000*              	JMP	OUTSTR
  2799'                         MG_POS:
  2799'   21 22E4'              	LXI	H,SLINE
  279C'   CD 0000*              	CALL	OUTSTR
  279F'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  27A2'   23                    	INX	H		;   ... so the line it is on
  27A3'   CD 2730'              	CALL	EMITW
  27A6'   21 22EB'              	LXI	H,SCOLM
  27A9'   CD 0000*              	CALL	OUTSTR
  27AC'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  27AF'   23                    	INX	H
  27B0'   E5                    	PUSH	H
  27B1'   CD 2730'              	CALL	EMITW
  27B4'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  27B7'   23                    	INX	H
  27B8'   D1                    	POP	D
  27B9'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  27BC'   C8                    	RZ
  27BD'   E5                    	PUSH	H
  27BE'   3E 2D                 	MVI	A,'-'
  27C0'   CD 0000*              	CALL	OUTCH
  27C3'   E1                    	POP	H
  27C4'   C3 2730'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  27C7'                         FILMSG:
  27C7'   3A 0001*              	LDA	FNAME+1
  27CA'   FE 20                 	CPI	' '
  27CC'   C8                    	RZ
  27CD'   21 0000*              	LXI	H,FNAME
  27D0'   CD 268F'              	CALL	MSGNAM
  27D3'   AF                    	XRA	A		; nothing has been changed yet
  27D4'   C3 26F7'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  27D7'                         WRMSG:
  27D7'   21 0000*              	LXI	H,TFCB
  27DA'   CD 268F'              	CALL	MSGNAM
  27DD'   21 2303'              	LXI	H,SWRIT
  27E0'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  27E3'                         MSGPST:
  27E3'   3A 2960'              	LDA	MSGWHT
  27E6'   B7                    	ORA	A
  27E7'   C8                    	RZ
  27E8'   47                    	MOV	B,A
  27E9'   AF                    	XRA	A
  27EA'   32 2960'              	STA	MSGWHT
  27ED'   78                    	MOV	A,B
  27EE'   FE 01                 	CPI	MW_FIL
	MACRO-80 3.44	09-Dec-81	PAGE	1-122


  27F0'   CA 280C'              	JZ	MP_FIL
  27F3'   FE 02                 	CPI	MW_WRT
  27F5'   CA 2812'              	JZ	MP_WRT
  27F8'   FE 04                 	CPI	MW_BIG
  27FA'   CA 2803'              	JZ	MP_BIG
  27FD'   CD 2782'              	CALL	MSGCTG
  2800'   C3 0000*              	JMP	SCURS
  2803'                         MP_BIG:
  2803'   21 229F'              	LXI	H,SQBIG
  2806'   CD 0000*              	CALL	EXMSG
  2809'   C3 0000*              	JMP	SCURS
  280C'                         MP_FIL:
  280C'   CD 27C7'              	CALL	FILMSG
  280F'   C3 0000*              	JMP	SCURS
  2812'                         MP_WRT:
  2812'   CD 27D7'              	CALL	WRMSG
  2815'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  2818'                         VC_CTLG:
  2818'   3E 03                 	MVI	A,MW_CTG
  281A'   32 2960'              	STA	MSGWHT
  281D'   3E 01                 	MVI	A,R_MOVE
  281F'   32 28F9'              	STA	RINTENT
  2822'   C9                    	RET
                                
  2823'                         CMDTAB:
