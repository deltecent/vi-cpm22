                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  0003                   C      CTRLC	EQU	03H		; ^C -- abandons a search or a long move
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the current row is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; current line changed only -> redraw that one row
  0003                   C      R_DLIN	EQU	3		; one line deleted at the cursor row -> DL + redraw bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted mid-line -> ICH (no tail redraw)
  0005                   C      R_ILIN	EQU	5		; one line opened at the cursor row -> IL + redraw that row and the one above
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw that row + DL the one under it
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; KEY DECODER -- GETKEY return types (B) and action codes (C when B=KT_ACT).
                         C      ; See KEY.MAC.
                         C      ;------------------------------------------------------------
  0000                   C      KT_NONE EQU	0		; no key (unrecognised ESC sequence, discarded)
  0001                   C      KT_ACT	EQU	1		; C = ACT_xxx action code
  0002                   C      KT_CHAR EQU	2		; C = ASCII character (printable or control)
                         C      
  0001                   C      ACT_CURUP EQU	1		; cursor up    (ESC[A / ESC OA)
  0002                   C      ACT_CURDN EQU	2		; cursor down  (ESC[B / ESC OB)
  0003                   C      ACT_CURRT EQU	3		; cursor right (ESC[C / ESC OC)
  0004                   C      ACT_CURLT EQU	4		; cursor left  (ESC[D / ESC OD)
  0005                   C      ACT_LINST EQU	5		; Home / line start (ESC[H / ESC[1~)
  0006                   C      ACT_LINEN EQU	6		; End  / line end   (ESC[F / ESC[4~)
  0007                   C      ACT_PGUP  EQU	7		; page up   (ESC[5~)
  0008                   C      ACT_PGDN  EQU	8		; page down (ESC[6~)
  0009                   C      ACT_INS	  EQU	9		; Insert key (ESC[2~)
  000A                   C      ACT_DEL	  EQU	10		; Delete key (ESC[3~)
  000B                   C      ACT_ESC	  EQU	11		; lone ESC (after timeout)
  000B                   C      ACT_MAX	  EQU	11		; highest defined action code
                         C      
  01F4                   C      ESCTMO	EQU	500		; polls before a lone ESC is confirmed
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	COL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	MKSHFT				; the marks follow an edit (VI.MAC hooks it)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	KBBRK, KBFLSH			; KEY.MAC -- a ^C waiting / drop type-ahead
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	MKSAV				; ... and a refused 'dd's copy of them
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	UNDCLR				; ... nothing to undo
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	INSBLK, UNDINS			; BUF.MAC -- a block in at the cursor (':r')
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
                                	EXTRN	SCBOT, SCEOF, SCBOF, WFILL	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	SETC0				; BUF.MAC -- WM count set, forward
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GOLINE				; BUF.MAC -- WM 2228 (a mark's page loop)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   AF                    	XRA	A		; no command is ever left open to a ^C by the
  0001'   32 2ACB'              	STA	BRKARM		;   one before it (BRKON)
  0004'   CD 00DD'              	CALL	DOTPRE
  0007'   CD 000D'              	CALL	CDMODE
  000A'   C3 0134'              	JMP	DOTPOST
  000D'                         CDMODE:
  000D'   3A 2A18'              	LDA	EDMODE
  0010'   FE 01                 	CPI	EM_INS
  0012'   CA 001D'              	JZ	CD_INS
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  0015'   FE 02                 	CPI	EM_REP
  0017'   CA 0020'              	JZ	CD_REP
  001A'   C3 0023'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  001D'                         CD_INS:
  001D'   C3 1B62'              	JMP	VIINS
  0020'                         CD_REP:
  0020'   C3 1AA2'              	JMP	VIREP
                                
                                ;============================================================
                                ; VICMD -- command-mode key.  B = KT type, C = char / action.
                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  0023'                         VICMD:
  0023'   78                    	MOV	A,B
  0024'   FE 00                 	CPI	KT_NONE
  0026'   C8                    	RZ			; discarded key
  0027'   FE 01                 	CPI	KT_ACT
  0029'   CA 00AF'              	JZ	VIC_ACT
  002C'   3A 2A40'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002F'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  0031'   CA 16AF'              	JZ	VR_DO
                                	;--- KT_CHAR: maybe a count digit ---
  0034'   79                    	MOV	A,C
  0035'   FE 31                 	CPI	'1'
  0037'   DA 0042'              	JC	VIC_NOTD	; < '1'
  003A'   FE 3A                 	CPI	'9'+1
  003C'   D2 0042'              	JNC	VIC_NOTD	; > '9'
  003F'   C3 0052'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  0042'                         VIC_NOTD:
  0042'   79                    	MOV	A,C
  0043'   FE 30                 	CPI	'0'
  0045'   C2 007A'              	JNZ	VICDSP
  0048'   2A 2A19'              	LHLD	CMDCNT
  004B'   7C                    	MOV	A,H
  004C'   B5                    	ORA	L
  004D'   CA 007A'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  0050'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  0052'                         VICDIG:
  0052'   2A 2A19'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0055'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0056'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0057'   29                    	DAD	H		; *2
  0058'   DA 0071'              	JC	VIC_SAT
  005B'   29                    	DAD	H		; *4
  005C'   DA 0071'              	JC	VIC_SAT
  005F'   19                    	DAD	D		; *5
  0060'   DA 0071'              	JC	VIC_SAT
  0063'   29                    	DAD	H		; *10
  0064'   DA 0071'              	JC	VIC_SAT
  0067'   79                    	MOV	A,C
  0068'   D6 30                 	SUI	'0'
  006A'   5F                    	MOV	E,A
  006B'   16 00                 	MVI	D,0
  006D'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  006E'   D2 0074'              	JNC	VIC_CNT
  0071'                         VIC_SAT:
  0071'   21 FFFF               	LXI	H,0FFFFH
  0074'                         VIC_CNT:
  0074'   22 2A19'              	SHLD	CMDCNT
  0077'   C3 075A'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  007A'                         VICDSP:
  007A'   3A 2A40'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  007D'   32 2A41'              	STA	GSAVE
  0080'   AF                    	XRA	A
  0081'   32 2A40'              	STA	GPEND
  0084'   3A 2A42'              	LDA	PENDOP
  0087'   32 2A43'              	STA	PSAVE
  008A'   AF                    	XRA	A
  008B'   32 2A42'              	STA	PENDOP
  008E'   3A 2A43'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  0091'   B7                    	ORA	A
  0092'   C2 1072'              	JNZ	OPPEND
  0095'   3A 2A41'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0098'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  009A'   C2 00A3'              	JNZ	VIC_TB
  009D'   79                    	MOV	A,C
  009E'   FE 5A                 	CPI	'Z'
  00A0'   C2 00A9'              	JNZ	VIC_SW
  00A3'                         VIC_TB:
  00A3'   21 2947'              	LXI	H,CMDTAB
  00A6'   C3 00C2'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A9'                         VIC_SW:
  00A9'   CD 075A'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00AC'   C3 068B'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AF'                         VIC_ACT:
  00AF'   AF                    	XRA	A		; action key clears all pending state
  00B0'   32 2A40'              	STA	GPEND
  00B3'   32 2A41'              	STA	GSAVE
  00B6'   32 2A42'              	STA	PENDOP
  00B9'   32 2A43'              	STA	PSAVE
  00BC'   21 29FF'              	LXI	H,ACTTAB
  00BF'   C3 00C2'              	JMP	VSCANQ
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the two TOP-LEVEL key tables, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00C2'                         VSCANQ:
  00C2'   CD 00CE'              	CALL	VSCLK
  00C5'   CA 00A9'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C8'   E9                    	PCHL
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00C9'                         VSCAN:
  00C9'   CD 00CE'              	CALL	VSCLK
  00CC'   C8                    	RZ			; miss
  00CD'   E9                    	PCHL
  00CE'                         VSCLK:
  00CE'   7E                    VSCAN1: MOV	A,M
  00CF'   B7                    	ORA	A
  00D0'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00D1'   23                    	INX	H
  00D2'   B9                    	CMP	C
  00D3'   5E                    	MOV	E,M
  00D4'   23                    	INX	H
  00D5'   56                    	MOV	D,M
  00D6'   23                    	INX	H
  00D7'   C2 00CE'              	JNZ	VSCAN1
  00DA'   EB                    	XCHG			; HL = the handler
  00DB'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00DC'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00DD'                         DOTPRE:
  00DD'   3A 2A37'              	LDA	DOTRPL
  00E0'   B7                    	ORA	A
  00E1'   C0                    	RNZ			; the replay's own keys are not recorded
  00E2'   C5                    	PUSH	B
  00E3'   D5                    	PUSH	D
  00E4'   E5                    	PUSH	H
  00E5'   3A 2A36'              	LDA	DOTSTA
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00E8'   B7                    	ORA	A
  00E9'   CA 00FC'              	JZ	DOTP1
  00EC'   AF                    	XRA	A		; a new command: the recording starts over
  00ED'   32 2A36'              	STA	DOTSTA
  00F0'   32 2A38'              	STA	DOTOVF
  00F3'   21 0000*              	LXI	H,DOTSCR
  00F6'   22 2A3A'              	SHLD	DOTSP
  00F9'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00FC'                         DOTP1:
  00FC'   78                    	MOV	A,B
  00FD'   FE 00                 	CPI	KT_NONE
  00FF'   CA 0128'              	JZ	DOTPX		; a discarded key is not a keystroke
  0102'   FE 01                 	CPI	KT_ACT
  0104'   79                    	MOV	A,C
  0105'   CA 010D'              	JZ	DOTP2
  0108'   E6 7F                 	ANI	7FH		; a char stands for itself (CPYGAP masks inserts
  010A'   C3 010F'              	JMP	DOTP3		;   the same way), bit 7 marks an action key
  010D'                         DOTP2:
  010D'   F6 80                 	ORI	80H		; an action key (an arrow) rides in bit 7
  010F'                         DOTP3:
  010F'   32 2A39'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  0112'   47                    	MOV	B,A
  0113'   2A 2A3A'              	LHLD	DOTSP
  0116'   EB                    	XCHG
  0117'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  011A'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  011D'   D2 012C'              	JNC	DOTPOV
  0120'   2A 2A3A'              	LHLD	DOTSP
  0123'   70                    	MOV	M,B
  0124'   23                    	INX	H
  0125'   22 2A3A'              	SHLD	DOTSP
  0128'                         DOTPX:
  0128'   E1                    	POP	H
  0129'   D1                    	POP	D
  012A'   C1                    	POP	B
  012B'   C9                    	RET
  012C'                         DOTPOV:
  012C'   3E 01                 	MVI	A,1
  012E'   32 2A38'              	STA	DOTOVF		; too long to record: give this recording up
  0131'   C3 0128'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  0134'                         DOTPOST:
  0134'   3A 2A37'              	LDA	DOTRPL
  0137'   B7                    	ORA	A
  0138'   C0                    	RNZ
  0139'   3A 2A18'              	LDA	EDMODE
  013C'   B7                    	ORA	A
  013D'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  013E'   3A 2A40'              	LDA	GPEND
  0141'   B7                    	ORA	A
  0142'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  0143'   3A 2A42'              	LDA	PENDOP
  0146'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0147'   C0                    	RNZ			; an operator still waiting for its motion
  0148'   2A 2A19'              	LHLD	CMDCNT
  014B'   7C                    	MOV	A,H
  014C'   B5                    	ORA	L
  014D'   CA 015B'              	JZ	DOTQ1
  0150'   3A 2A39'              	LDA	DOTLK		; a digit with the count still up: the command
  0153'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  0155'   DA 015B'              	JC	DOTQ1
  0158'   FE 3A                 	CPI	'9'+1
  015A'   D8                    	RC
  015B'                         DOTQ1:
  015B'   3E 01                 	MVI	A,1
  015D'   32 2A36'              	STA	DOTSTA		; the next key starts a new recording
  0160'   3A 2A35'              	LDA	DOTCHG
  0163'   B7                    	ORA	A
  0164'   C8                    	RZ			; changed nothing: not a repeatable command
  0165'   AF                    	XRA	A
  0166'   32 2A35'              	STA	DOTCHG
  0169'   32 2A3C'              	STA	DOTLEN
  016C'   3A 2A38'              	LDA	DOTOVF
  016F'   B7                    	ORA	A
  0170'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  0171'   2A 2A3A'              	LHLD	DOTSP
  0174'   11 0000*              	LXI	D,DOTSCR
  0177'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  017A'   7D                    	MOV	A,L
  017B'   32 2A3C'              	STA	DOTLEN
  017E'   B7                    	ORA	A
  017F'   C8                    	RZ
  0180'   4F                    	MOV	C,A
  0181'   06 00                 	MVI	B,0
  0183'   21 0000*              	LXI	H,DOTSCR
  0186'   11 0000*              	LXI	D,DOTBUF
  0189'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  018C'                         MARKMOD:
  018C'   3E 01                 	MVI	A,1
  018E'   32 2A1C'              	STA	MODF
  0191'   32 2A35'              	STA	DOTCHG
  0194'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  0195'                         VC_DOT:
  0195'   2A 2A19'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0198'   22 2A3E'              	SHLD	DOTNCT
  019B'   21 0000               	LXI	H,0
  019E'   22 2A19'              	SHLD	CMDCNT
  01A1'   3A 2A3C'              	LDA	DOTLEN
  01A4'   B7                    	ORA	A
  01A5'   CA 01FF'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01A8'   AF                    	XRA	A
  01A9'   32 2A3D'              	STA	DOTIX
  01AC'   2A 2A3E'              	LHLD	DOTNCT
  01AF'   7C                    	MOV	A,H
  01B0'   B5                    	ORA	L
  01B1'   CA 01D1'              	JZ	DOTGO
  01B4'   22 2A19'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  01B7'                         DOTSKP:
  01B7'   CD 0564'              	CALL	DOTGET		; ... so step past the digits it recorded
  01BA'   DA 01D1'              	JC	DOTGO
  01BD'   FE 30                 	CPI	'0'
  01BF'   DA 01D1'              	JC	DOTGO
  01C2'   FE 3A                 	CPI	'9'+1
  01C4'   D2 01D1'              	JNC	DOTGO
  01C7'   3A 2A3D'              	LDA	DOTIX
  01CA'   3C                    	INR	A
  01CB'   32 2A3D'              	STA	DOTIX
  01CE'   C3 01B7'              	JMP	DOTSKP
  01D1'                         DOTGO:
  01D1'   3E 01                 	MVI	A,1
  01D3'   32 2A37'              	STA	DOTRPL
  01D6'                         DOTLP:
  01D6'   CD 0564'              	CALL	DOTGET
  01D9'   DA 01F5'              	JC	DOTDN
  01DC'   4F                    	MOV	C,A
  01DD'   06 02                 	MVI	B,KT_CHAR
  01DF'   B7                    	ORA	A
  01E0'   F2 01E8'              	JP	DOTLP2
  01E3'   E6 7F                 	ANI	7FH		; bit 7: the key was an action, not a char
  01E5'   4F                    	MOV	C,A
  01E6'   06 01                 	MVI	B,KT_ACT
  01E8'                         DOTLP2:
  01E8'   3A 2A3D'              	LDA	DOTIX
  01EB'   3C                    	INR	A
  01EC'   32 2A3D'              	STA	DOTIX
  01EF'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01F2'   C3 01D6'              	JMP	DOTLP
  01F5'                         DOTDN:
  01F5'   AF                    	XRA	A
  01F6'   32 2A37'              	STA	DOTRPL
  01F9'   32 2A35'              	STA	DOTCHG		; the '.' is not itself the new last change
  01FC'   C3 077B'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01FF'                         DOTBEL:
  01FF'   0E 07                 	MVI	C,BEL
  0201'   CD 0000*              	CALL	BCONOU
  0204'   C3 075A'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a 3-byte position in the FILE (FPOS: the records paged out ahead
                                ; of the window, plus the offset into it), so it does not care which part of
                                ; the file is resident: a jump pages until the window holds it (MKPAGE).  It
                                ; FOLLOWS its text, as vim's does: every edit passes MKSHFT, which moves the
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


                                ; marks past it by the bytes that went in or came out.
                                ;
                                ; DEVIATIONS from vim, in COMMANDS.md: a mark whose own text is deleted closes
                                ; up to where the delete was, where vim deletes the mark with its line; and
                                ; within its line a mark stays with its CHARACTER, where vim keeps the column
                                ; number.  '.' after a 'd''a' still refuses: the mark letter is read inside
                                ; the command and never recorded.
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  0207'                         MKVAD:
  0207'   16 00                 	MVI	D,0
  0209'   59                    	MOV	E,C
  020A'   21 2AA7'              	LXI	H,MKVAL
  020D'   19                    	DAD	D
  020E'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  020F'                         MKCLR:
  020F'   21 2AA7'              	LXI	H,MKVAL
  0212'   06 03                 	MVI	B,MKMAX
  0214'   AF                    	XRA	A
  0215'                         MKC_LP:
  0215'   77                    	MOV	M,A
  0216'   23                    	INX	H
  0217'   05                    	DCR	B
  0218'   C2 0215'              	JNZ	MKC_LP
  021B'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was not a character.
  021C'                         MKGETK:
  021C'   3A 2A37'              	LDA	DOTRPL
  021F'   B7                    	ORA	A
  0220'   CA 0231'              	JZ	MKG_KB
  0223'   CD 0564'              	CALL	DOTGET		; the recording's next key
  0226'   D8                    	RC
  0227'   4F                    	MOV	C,A
  0228'   3A 2A3D'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  022B'   3C                    	INR	A
  022C'   32 2A3D'              	STA	DOTIX
  022F'   B7                    	ORA	A		; CY clear
  0230'   C9                    	RET
  0231'                         MKG_KB:
  0231'   CD 0000*              	CALL	GETKEY
  0234'   78                    	MOV	A,B
  0235'   FE 02                 	CPI	KT_CHAR
  0237'   37                    	STC
  0238'   C0                    	RNZ			; an action key (ESC) cancels the command
  0239'   B7                    	ORA	A		; CY clear
  023A'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
                                ; the motion returns.  Unlike the marks, the character is then handed to
                                ; DOTPRE, so it joins the recording and '.' can repeat "dfa" -- MKGETK's
                                ; keyboard path does not record for itself.
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
                                ;============================================================
  023B'                         VC_FF:				; 'f' -- forward, onto the character
  023B'   3E 66                 	MVI	A,'f'
  023D'   C3 024C'              	JMP	FNDNEW
  0240'                         VC_FB:				; 'F' -- backward, onto it
  0240'   3E 46                 	MVI	A,'F'
  0242'   C3 024C'              	JMP	FNDNEW
  0245'                         VC_TF:				; 't' -- forward, up to it
  0245'   3E 74                 	MVI	A,'t'
  0247'   C3 024C'              	JMP	FNDNEW
  024A'                         VC_TB:				; 'T' -- backward, up to it
  024A'   3E 54                 	MVI	A,'T'
  024C'                         FNDNEW:
  024C'   32 2A9C'              	STA	FNDKND		; the find ';' and ',' will repeat
  024F'   CD 021C'              	CALL	MKGETK		; the character it looks for
  0252'   DA 0289'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0255'   79                    	MOV	A,C
  0256'   32 2A9D'              	STA	FNDCH
  0259'   06 02                 	MVI	B,KT_CHAR	; ... and into the '.' recording (see the head)
  025B'   CD 00DD'              	CALL	DOTPRE
  025E'   3A 2A9C'              	LDA	FNDKND
  0261'   06 01                 	MVI	B,1		; a find starts at the next character along
  0263'   C3 0290'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0266'                         VC_SEMI:
  0266'   3A 2A9C'              	LDA	FNDKND
  0269'   B7                    	ORA	A
  026A'   CA 0289'              	JZ	FNDNIL		; nothing has been looked for yet
  026D'   C3 0279'              	JMP	FNDREP
  0270'                         VC_COMMA:
  0270'   3A 2A9C'              	LDA	FNDKND
  0273'   B7                    	ORA	A
  0274'   CA 0289'              	JZ	FNDNIL
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  0277'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0279'                         FNDREP:
  0279'   06 01                 	MVI	B,1
  027B'   F5                    	PUSH	PSW
  027C'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  027E'   FE 54                 	CPI	'T'
  0280'   C2 0285'              	JNZ	FNDR_GO
  0283'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  0285'                         FNDR_GO:
  0285'   F1                    	POP	PSW
  0286'   C3 0290'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
  0289'                         FNDNIL:
  0289'   AF                    	XRA	A
  028A'   32 2A43'              	STA	PSAVE
  028D'   C3 075A'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  0290'                         FNDGO:
  0290'   32 2A9E'              	STA	FNDRUN
  0293'   78                    	MOV	A,B
  0294'   32 2A9F'              	STA	FNDSTP
  0297'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
  029A'   22 2AA0'              	SHLD	FNDN		; the occurrence wanted
  029D'   CD 0000*              	CALL	CUROFF
  02A0'   22 2AA2'              	SHLD	FNDCUR
  02A3'   3A 2A9E'              	LDA	FNDRUN
  02A6'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  02A8'   CA 02DC'              	JZ	FNDBWD
  02AB'   2A 2AA2'              	LHLD	FNDCUR
  02AE'   CD 0623'              	CALL	EOLC		; HL = the line's last content character
  02B1'   22 2AA4'              	SHLD	FNDLIM
  02B4'   2A 2AA2'              	LHLD	FNDCUR
  02B7'   3A 2A9F'              	LDA	FNDSTP
  02BA'   5F                    	MOV	E,A
  02BB'   16 00                 	MVI	D,0
  02BD'   19                    	DAD	D		; HL = where the scan starts
  02BE'                         FNDF_LP:
  02BE'   EB                    	XCHG			; DE = the scan
  02BF'   2A 2AA4'              	LHLD	FNDLIM
  02C2'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  02C5'   EB                    	XCHG			; HL = the scan
  02C6'   CA 02CC'              	JZ	FNDF_AT		; the last character is still a candidate
  02C9'   D2 032E'              	JNC	FNDMIS		; past it: not on this line
  02CC'                         FNDF_AT:
  02CC'   CD 0335'              	CALL	FNDSEE		; Z iff this is the character
  02CF'   C2 02D8'              	JNZ	FNDF_NX
  02D2'   CD 0340'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02D5'   CA 0314'              	JZ	FNDHIT
  02D8'                         FNDF_NX:
  02D8'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02D9'   C3 02BE'              	JMP	FNDF_LP
  02DC'                         FNDBWD:
  02DC'   2A 2AA2'              	LHLD	FNDCUR
  02DF'   CD 05E4'              	CALL	BOL		; HL = the line's first character
  02E2'   22 2AA4'              	SHLD	FNDLIM
  02E5'   2A 2AA2'              	LHLD	FNDCUR
  02E8'   3A 2A9F'              	LDA	FNDSTP
  02EB'   2F                    	CMA
  02EC'   5F                    	MOV	E,A
  02ED'   16 FF                 	MVI	D,0FFH
  02EF'   13                    	INX	D		; DE = -step
  02F0'   19                    	DAD	D		; HL = where the scan starts
  02F1'   D2 032E'              	JNC	FNDMIS		; ... off the front of the text altogether
  02F4'                         FNDB_LP:
  02F4'   EB                    	XCHG			; DE = the scan
  02F5'   2A 2AA4'              	LHLD	FNDLIM
  02F8'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02FB'   EB                    	XCHG			; HL = the scan
  02FC'   DA 032E'              	JC	FNDMIS		; before this line: not on it
  02FF'   CD 0335'              	CALL	FNDSEE
  0302'   C2 030B'              	JNZ	FNDB_NX
  0305'   CD 0340'              	CALL	FNDCNT
  0308'   CA 0314'              	JZ	FNDHIT
  030B'                         FNDB_NX:
  030B'   7C                    	MOV	A,H
  030C'   B5                    	ORA	L
  030D'   CA 032E'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
  0310'   2B                    	DCX	H
  0311'   C3 02F4'              	JMP	FNDB_LP
                                
                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  0314'                         FNDHIT:
  0314'   3A 2A9E'              	LDA	FNDRUN
  0317'   E6 5F                 	ANI	5FH
  0319'   FE 54                 	CPI	'T'
  031B'   C2 032B'              	JNZ	FNDLND
  031E'   3A 2A9E'              	LDA	FNDRUN
  0321'   E6 20                 	ANI	20H
  0323'   CA 032A'              	JZ	FNDH_BW
  0326'   2B                    	DCX	H		; forward 't': the character before it
  0327'   C3 032B'              	JMP	FNDLND
  032A'                         FNDH_BW:
  032A'   23                    	INX	H		; backward 'T': the character after it
  032B'                         FNDLND:
  032B'   C3 057A'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  032E'                         FNDMIS:
  032E'   AF                    	XRA	A
  032F'   32 2A43'              	STA	PSAVE
  0332'   C3 01FF'              	JMP	DOTBEL
                                
                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  0335'                         FNDSEE:
  0335'   E5                    	PUSH	H
  0336'   CD 0000*              	CALL	CHARAT
  0339'   E1                    	POP	H
  033A'   47                    	MOV	B,A
  033B'   3A 2A9D'              	LDA	FNDCH
  033E'   B8                    	CMP	B
  033F'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
                                ; the scan and stays it.
  0340'                         FNDCNT:
  0340'   E5                    	PUSH	H
  0341'   2A 2AA0'              	LHLD	FNDN
  0344'   2B                    	DCX	H
  0345'   22 2AA0'              	SHLD	FNDN
  0348'   7C                    	MOV	A,H
  0349'   B5                    	ORA	L
  034A'   E1                    	POP	H
  034B'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  034C'                         ISFIND:
  034C'   E6 5F                 	ANI	5FH		; fold the case away
  034E'   FE 46                 	CPI	'F'
  0350'   C8                    	RZ
  0351'   FE 54                 	CPI	'T'
  0353'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  0354'                         VC_MK:
  0354'   3E 04                 	MVI	A,PM
  0356'   C3 0360'              	JMP	MKGO
  0359'                         VC_BQ:
  0359'   3E 05                 	MVI	A,PJ
  035B'   C3 0360'              	JMP	MKGO
  035E'                         VC_AQ:
  035E'   3E 06                 	MVI	A,PJL
  0360'                         MKGO:
  0360'   32 2AB3'              	STA	MKWHAT
  0363'   CD 0678'              	CALL	MOVCNT		; a count means nothing on any of the three
  0366'   CD 021C'              	CALL	MKGETK		; the key that names the mark
  0369'   DA 0448'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out -- the letter is read here and so
                                				;   was never recorded, which is why a '.'
                                				;   after "d'a" refuses (COMMANDS.md).  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist: 'm' with any other key
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


                                ;drops the whole thing, as vim's 'Z{other}' does, and a jump to one is a jump
                                ;to a mark that is not set.
  036C'                         MKOP:
  036C'   79                    	MOV	A,C
  036D'   D6 61                 	SUI	'a'
  036F'   FE 03                 	CPI	MKMAX
  0371'   D2 0440'              	JNC	MKNOLT		; not a mark letter
  0374'   4F                    	MOV	C,A		; C = the mark's index
  0375'   87                    	ADD	A
  0376'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  0377'   5F                    	MOV	E,A
  0378'   16 00                 	MVI	D,0
  037A'   21 0000*              	LXI	H,MKTAB
  037D'   19                    	DAD	D		; HL -> this mark's slot
  037E'   3A 2AB3'              	LDA	MKWHAT
  0381'   FE 04                 	CPI	PM
  0383'   CA 045B'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark, paging to it if the window has left it.
                                ;'Mark not set', as vim says it, when it was never set.
                                ;Under an OPERATOR a mark the window does not hold is refused with the bell
                                ;and stays set, all but "d'a": a line delete is the one operator that can take
                                ;a span the window does not hold whole (OPPGD), and going there only to be
                                ;turned away by it would page the file twice for nothing.
  0386'                         MKJMP:
  0386'   E5                    	PUSH	H
  0387'   CD 0207'              	CALL	MKVAD
  038A'   7E                    	MOV	A,M
  038B'   E1                    	POP	H
  038C'   B7                    	ORA	A
  038D'   CA 0436'              	JZ	MKNSET		; never set
  0390'   CD 0402'              	CALL	MKLOAD		; the file position it holds
  0393'   CD 040F'              	CALL	MKWIN
  0396'   DA 03AD'              	JC	MKJ_GO		; in the window: any command may go there
  0399'   3A 2A43'              	LDA	PSAVE
  039C'   B7                    	ORA	A
  039D'   CA 03AD'              	JZ	MKJ_GO
  03A0'   FE 64                 	CPI	'd'		; paged out, and an operator wants the span
  03A2'   C2 0448'              	JNZ	MKBAD
  03A5'   3A 2AB3'              	LDA	MKWHAT
  03A8'   FE 06                 	CPI	PJL
  03AA'   C2 0448'              	JNZ	MKBAD
  03AD'                         MKJ_GO:
  03AD'   CD 0F75'              	CALL	GZONE		; the screen's top line, before the cursor
                                				;   moves: GPLACE measures the landing against
                                				;   it, and one left over from an earlier 'G'
                                				;   had it keep a window the line is not in
  03B0'   CD 06B4'              	CALL	BRKON		; ... and a ^C may stop it from here on
  03B3'   CD 03CF'              	CALL	MKPAGE		; HL = the mark's offset in the window
  03B6'   CD 06EB'              	CALL	BRKOFF		; (A only)
  03B9'   DA 0703'              	JC	BRKBAK
  03BC'   3A 2AB3'              	LDA	MKWHAT
  03BF'   FE 06                 	CPI	PJL
  03C1'   CA 03C9'              	JZ	MKJ_LN		; ''': GPKEEP is 0, so GPLACE finds the first
  03C4'   3E 01                 	MVI	A,1		;   non-blank
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  03C6'   32 2AA6'              	STA	GPKEEP		; '`': land on the column it was set at
  03C9'                         MKJ_LN:
  03C9'   CD 0000*              	CALL	GOTO
  03CC'   C3 0F8D'              	JMP	GPLACE		; (which sets LNDLT itself)
                                
                                ;MKPAGE -- page until MKPOS is in the window: HL = its logical offset there.
                                ;The loop is WM's own whole-file line move (MVLMAX: GOLINE to the window's
                                ;edge, SCRLST to page one step), stopped by where the window is instead of by
                                ;the count.  A step cannot carry the window past the mark: the pager evicts
                                ;only behind the cursor, and the cursor is on the edge nearer the mark.
  03CF'                         MKPAGE:
  03CF'   CD 040F'              	CALL	MKWIN
  03D2'   DA 0000*              	JC	CLRCNT		; there: and the count that paged is spent,
                                				;   not left for the next command to take
  03D5'   32 0000*              	STA	DIRFLG
  03D8'   21 FFFF               	LXI	H,0FFFFH
  03DB'   22 2A19'              	SHLD	CMDCNT
  03DE'   CD 0000*              	CALL	GOLINE
  03E1'   CD 0000*              	CALL	SCRLST
  03E4'   CD 06A0'              	CALL	CNTTST
  03E7'   C2 03CF'              	JNZ	MKPAGE
  03EA'   CD 040F'              	CALL	MKWIN		; the file ran out: that was its last step
  03ED'   DA 0000*              	JC	CLRCNT
  03F0'   21 FFFF               	LXI	H,0FFFFH	; the very end of the text, which MKWIN does not
  03F3'   C3 0000*              	JMP	CLRCNT		;   count as in the window: GOTO clamps it
                                
                                ;BACKTO -- back to the 3-byte file position at HL, paging to it: where a
                                ;command that came to nothing started.  The place has to be kept as a file
                                ;position -- a sweep of the whole file leaves the window at the far end of
                                ;it, and an offset into the window it started in means nothing there.
  03F6'                         BACKTO:
  03F6'   CD 0402'              	CALL	MKLOAD
  03F9'   CD 0000*              	CALL	CLRCNT
  03FC'   CD 03CF'              	CALL	MKPAGE
  03FF'   C3 0000*              	JMP	GOTO
                                
                                ;MKLOAD -- MKPOS = the 3-byte file position at HL.
  0402'                         MKLOAD:
  0402'   5E                    	MOV	E,M
  0403'   23                    	INX	H
  0404'   56                    	MOV	D,M
  0405'   23                    	INX	H
  0406'   7E                    	MOV	A,M
  0407'   EB                    	XCHG
  0408'   22 2AB0'              	SHLD	MKPOS
  040B'   32 2AB2'              	STA	MKPOS+2
  040E'   C9                    	RET
                                
                                ;MKWIN -- CY and HL = MKPOS as a logical offset if the window holds it; NC and
                                ;A = the way to page for it, as DIRFLG has it (0 forward, FFH back), if not.
  040F'                         MKWIN:
  040F'   2A 0000*              	LHLD	TXTBEG
  0412'   CD 0F2F'              	CALL	FPOS
  0415'   EB                    	XCHG
  0416'   47                    	MOV	B,A		; B:DE = the window's first byte
  0417'   2A 2AB0'              	LHLD	MKPOS
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  041A'   3A 2AB2'              	LDA	MKPOS+2
  041D'   CD 0F22'              	CALL	SUB24		; A:HL = the mark, from the window's top
  0420'   DA 0432'              	JC	MKW_BK		; above it
  0423'   C2 0430'              	JNZ	MKW_FW		; 64K or more below it
  0426'   E5                    	PUSH	H
  0427'   CD 0000*              	CALL	LOGLEN
  042A'   D1                    	POP	D
  042B'   CD 0000*              	CALL	CMP16		; DE = the offset vs HL = the window's length
  042E'   EB                    	XCHG
  042F'   D8                    	RC			; inside
  0430'                         MKW_FW:
  0430'   AF                    	XRA	A
  0431'   C9                    	RET
  0432'                         MKW_BK:
  0432'   3E FF                 	MVI	A,0FFH
  0434'   B7                    	ORA	A
  0435'   C9                    	RET
                                
                                ;MKNSET -- a jump to a mark that will not answer: vim's E20 on the bottom row
                                ;(without the number, and without a bell, as every message here), the cursor
                                ;and the screen left alone.  The operator is cancelled as MKBAD cancels it.
  0436'                         MKNSET:
  0436'   AF                    	XRA	A
  0437'   32 2A43'              	STA	PSAVE
  043A'   21 23D7'              	LXI	H,SMKNS
  043D'   C3 22CC'              	JMP	EXERR
  0440'                         MKNOLT:
  0440'   3A 2AB3'              	LDA	MKWHAT
  0443'   FE 04                 	CPI	PM
  0445'   C2 0436'              	JNZ	MKNSET		; a jump: that mark is not set
                                				; 'm{other}': fall into MKBAD
                                
                                ;MKBAD -- no mark was named: 'm' with a key that is not a mark letter, ESC in
                                ;place of the letter, or a '.' replay that ran out.  The bell, and an operator
                                ;running the motion is cancelled whole: PSAVE is what OPPEND's tail reads to
                                ;decide whether to open an insert, so clearing it stops a "c`z" opening one
                                ;over a span of nothing.
  0448'                         MKBAD:
  0448'   AF                    	XRA	A
  0449'   32 2A43'              	STA	PSAVE
  044C'   C3 01FF'              	JMP	DOTBEL
                                
                                ;FPSTO -- the cursor's file position into the 3 bytes at HL.  Keeps BC.
  044F'                         FPSTO:
  044F'   E5                    	PUSH	H
  0450'   CD 0F2C'              	CALL	CURFP		; A:HL = the cursor's file position
  0453'   EB                    	XCHG
  0454'   E1                    	POP	H
  0455'   73                    	MOV	M,E
  0456'   23                    	INX	H
  0457'   72                    	MOV	M,D
  0458'   23                    	INX	H
  0459'   77                    	MOV	M,A
  045A'   C9                    	RET
                                
                                ;MKSET -- remember where in the FILE the cursor is.
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  045B'                         MKSET:
  045B'   CD 044F'              	CALL	FPSTO
  045E'   CD 0207'              	CALL	MKVAD
  0461'   36 01                 	MVI	M,1		; ... and the mark is live
  0463'   C3 075A'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKSHFT -- the text is changing: every mark follows its own text.  BUF.MAC's
                                ;UNDCHG calls this through EDTHK from all six edit primitives -- 'u's replay
                                ;of them included -- with A = 1 for an insert (the text is in) or 2 for a
                                ;delete (it is about to go), HL = the edit's logical offset and BC = its
                                ;length.  A mark before the edit stays; one after it moves by the length; one
                                ;INSIDE a delete closes up to where the delete was.  An insert AT a mark
                                ;leaves the mark in front of the new text, unless that text ends a line -- a
                                ;line opened or put above the mark's is above the mark too.
                                ;The edit is found from the CURSOR's file position less its distance behind
                                ;the cursor, never from the offset alone: a put bigger than the window pages
                                ;its own start out, and that offset has then wrapped.  BC is kept.
  0466'                         MKSHFT:
  0466'   32 2AAF'              	STA	MKTYP
  0469'   3A 2AB4'              	LDA	MKHOLD		; a yank that could not copy takes its lines out
  046C'   B7                    	ORA	A		;   and puts them back unchanged (YKGO): the text
  046D'   C0                    	RNZ			;   every mark points into is still there
  046E'   C5                    	PUSH	B
  046F'   50                    	MOV	D,B
  0470'   59                    	MOV	E,C
  0471'   EB                    	XCHG
  0472'   22 2AAD'              	SHLD	MKN		; the edit's length
  0475'   D5                    	PUSH	D		; ... and its offset
  0476'   CD 0000*              	CALL	CUROFF
  0479'   D1                    	POP	D
  047A'   CD 0000*              	CALL	SUBHD
  047D'   EB                    	XCHG			; DE = how far behind the cursor it is
  047E'   CD 0F2C'              	CALL	CURFP		; A:HL = the cursor's file position
  0481'   06 00                 	MVI	B,0
  0483'   CD 0F22'              	CALL	SUB24
  0486'   22 2AAA'              	SHLD	MKEDIT
  0489'   32 2AAC'              	STA	MKEDIT+2	; where in the file the edit is
  048C'   21 2AA7'              	LXI	H,MKVAL
  048F'   11 0000*              	LXI	D,MKTAB
  0492'   06 03                 	MVI	B,MKMAX
  0494'                         MKS_LP:
  0494'   7E                    	MOV	A,M
  0495'   B7                    	ORA	A
  0496'   CA 0502'              	JZ	MKS_N0		; that mark is not set
  0499'   E5                    	PUSH	H
  049A'   C5                    	PUSH	B
  049B'   21 2AAA'              	LXI	H,MKEDIT
  049E'   1A                    	LDAX	D		; the mark's position less the edit's, a byte
  049F'   96                    	SUB	M		;   at a time (neither INX nor LDAX touch CY)
  04A0'   4F                    	MOV	C,A
  04A1'   13                    	INX	D
  04A2'   23                    	INX	H
  04A3'   1A                    	LDAX	D
  04A4'   9E                    	SBB	M
  04A5'   47                    	MOV	B,A
  04A6'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  04A7'   23                    	INX	H
  04A8'   1A                    	LDAX	D
  04A9'   9E                    	SBB	M		; A:BC = how far past the edit the mark is
  04AA'   DA 04FD'              	JC	MKS_PP		; before it: nothing moves
  04AD'   6F                    	MOV	L,A
  04AE'   3A 2AAF'              	LDA	MKTYP
  04B1'   3D                    	DCR	A
  04B2'   CA 04D7'              	JZ	MKS_IN
                                	;--- a delete: back by its length, or to it if the mark is inside ---
  04B5'   7D                    	MOV	A,L
  04B6'   2A 2AAD'              	LHLD	MKN
  04B9'   B7                    	ORA	A
  04BA'   C2 04C6'              	JNZ	MKS_DL		; 64K or more past it
  04BD'   79                    	MOV	A,C
  04BE'   95                    	SUB	L
  04BF'   78                    	MOV	A,B
  04C0'   9C                    	SBB	H
  04C1'   D2 04C6'              	JNC	MKS_DL		; past the end of what goes
  04C4'   60                    	MOV	H,B
  04C5'   69                    	MOV	L,C		; inside it: close up to the edit
  04C6'                         MKS_DL:
  04C6'   1B                    	DCX	D
  04C7'   1B                    	DCX	D
  04C8'   1A                    	LDAX	D
  04C9'   95                    	SUB	L
  04CA'   12                    	STAX	D
  04CB'   13                    	INX	D
  04CC'   1A                    	LDAX	D
  04CD'   9C                    	SBB	H
  04CE'   12                    	STAX	D
  04CF'   13                    	INX	D
  04D0'   1A                    	LDAX	D
  04D1'   DE 00                 	SBI	0
  04D3'   12                    	STAX	D
  04D4'   C3 04FD'              	JMP	MKS_PP
                                	;--- an insert: on by its length ---
  04D7'                         MKS_IN:
  04D7'   7D                    	MOV	A,L
  04D8'   B0                    	ORA	B
  04D9'   B1                    	ORA	C
  04DA'   C2 04EC'              	JNZ	MKS_AD		; the mark is past it
  04DD'   2A 0000*              	LHLD	GAPBEG		; AT the mark: only a line end carries it on
  04E0'   2B                    	DCX	H
  04E1'   7E                    	MOV	A,M		; the last byte that went in
  04E2'   FE 0A                 	CPI	LF
  04E4'   CA 04EC'              	JZ	MKS_AD
  04E7'   FE 0D                 	CPI	CR
  04E9'   C2 04FD'              	JNZ	MKS_PP
  04EC'                         MKS_AD:
  04EC'   2A 2AAD'              	LHLD	MKN
  04EF'   1B                    	DCX	D
  04F0'   1B                    	DCX	D
  04F1'   1A                    	LDAX	D
  04F2'   85                    	ADD	L
  04F3'   12                    	STAX	D
  04F4'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04F5'   1A                    	LDAX	D
  04F6'   8C                    	ADC	H
  04F7'   12                    	STAX	D
  04F8'   13                    	INX	D
  04F9'   1A                    	LDAX	D
  04FA'   CE 00                 	ACI	0
  04FC'   12                    	STAX	D
  04FD'                         MKS_PP:
  04FD'   C1                    	POP	B
  04FE'   E1                    	POP	H
  04FF'   C3 0504'              	JMP	MKS_NX
  0502'                         MKS_N0:
  0502'   13                    	INX	D
  0503'   13                    	INX	D
  0504'                         MKS_NX:
  0504'   13                    	INX	D
  0505'   13                    	INX	D
  0506'   23                    	INX	H
  0507'   05                    	DCR	B
  0508'   C2 0494'              	JNZ	MKS_LP
  050B'   C1                    	POP	B
  050C'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  050D'                         VC_UNDO:
  050D'   21 0000               	LXI	H,0
  0510'   22 2A19'              	SHLD	CMDCNT
  0513'   CD 0000*              	CALL	UNDO
  0516'   DA 0547'              	JC	UNDNO
  0519'   2A 0000*              	LHLD	UNDCUR
  051C'   CD 052D'              	CALL	UCLAMP		; vi never sits on a line terminator
  051F'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0522'   3E 01                 	MVI	A,1
  0524'   32 2A1C'              	STA	MODF		; undone past a ':w' still differs from the file
  0527'   CD 08E6'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  052A'   C3 077B'              	JMP	SETFUL		; whole spans moved: repaint rather than guess
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  052D'                         UCLAMP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  052D'   E5                    	PUSH	H
  052E'   CD 1501'              	CALL	CEND		; HL = the line's content end
  0531'   D1                    	POP	D		; DE = the offset wanted
  0532'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  0535'   D2 053A'              	JNC	UCL_BK
  0538'   EB                    	XCHG
  0539'   C9                    	RET
  053A'                         UCL_BK:
  053A'   E5                    	PUSH	H		; the content end
  053B'   EB                    	XCHG			; HL = the offset wanted
  053C'   CD 05E4'              	CALL	BOL
  053F'   D1                    	POP	D		; DE = the content end, HL = the line's start
  0540'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  0543'   EB                    	XCHG			; HL = the content end
  0544'   C8                    	RZ
  0545'   2B                    	DCX	H		; ... its last character
  0546'   C9                    	RET
  0547'                         UNDNO:
  0547'   3A 0000*              	LDA	UNDWHY
  054A'   B7                    	ORA	A
  054B'   CA 055C'              	JZ	UNDBEL
  054E'   21 2391'              	LXI	H,SUNDW		; the change has paged away: say so
  0551'   FE 01                 	CPI	1
  0553'   CA 22CC'              	JZ	EXERR
  0556'   21 23B3'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  0559'   C3 22CC'              	JMP	EXERR
  055C'                         UNDBEL:
  055C'   0E 07                 	MVI	C,BEL
  055E'   CD 0000*              	CALL	BCONOU
  0561'   C3 075A'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  0564'                         DOTGET:
  0564'   3A 2A3D'              	LDA	DOTIX
  0567'   5F                    	MOV	E,A
  0568'   3A 2A3C'              	LDA	DOTLEN
  056B'   BB                    	CMP	E
  056C'   CA 0578'              	JZ	DOTGEF
  056F'   16 00                 	MVI	D,0
  0571'   21 0000*              	LXI	H,DOTBUF
  0574'   19                    	DAD	D
  0575'   7E                    	MOV	A,M
  0576'   B7                    	ORA	A		; CY clear: a key was returned
  0577'   C9                    	RET
  0578'                         DOTGEF:
  0578'   37                    	STC
  0579'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  057A'                         GOSET:
  057A'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  057D'                         SETGL:
  057D'   CD 0F4F'              	CALL	ZSAVE
  0580'   21 0000               	LXI	H,0
  0583'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  0586'   E5                    	PUSH	H
  0587'   CD 0F62'              	CALL	ZREST
  058A'   E1                    	POP	H
  058B'   E5                    	PUSH	H
  058C'   CD 0684'              	CALL	GBSUB		; HL = bytes to the cursor
  058F'   44                    	MOV	B,H
  0590'   4D                    	MOV	C,L
  0591'   E1                    	POP	H		; HL = the line's start
  0592'   11 0000               	LXI	D,0		; DE = screen column
  0595'                         SG_LP:
  0595'   78                    	MOV	A,B
  0596'   B1                    	ORA	C
  0597'   CA 05AC'              	JZ	SG_CUR
  059A'   7E                    	MOV	A,M
  059B'   23                    	INX	H
  059C'   0B                    	DCX	B
  059D'   E5                    	PUSH	H
  059E'   6B                    	MOV	L,E
  059F'   CD 05D1'              	CALL	CWID
  05A2'   E1                    	POP	H
  05A3'   83                    	ADD	E
  05A4'   5F                    	MOV	E,A
  05A5'   D2 0595'              	JNC	SG_LP
  05A8'   14                    	INR	D
  05A9'   C3 0595'              	JMP	SG_LP
  05AC'                         SG_CUR:
  05AC'   2A 0000*              	LHLD	TXTEND
  05AF'   D5                    	PUSH	D
  05B0'   EB                    	XCHG
  05B1'   2A 0000*              	LHLD	GAPEND
  05B4'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  05B7'   D1                    	POP	D
  05B8'   CA 05CC'              	JZ	SG_SET
  05BB'   7E                    	MOV	A,M
  05BC'   FE 09                 	CPI	TAB
  05BE'   C2 05CC'              	JNZ	SG_SET
  05C1'   6B                    	MOV	L,E
  05C2'   CD 05D1'              	CALL	CWID
  05C5'   3D                    	DCR	A		; the TAB's last column
  05C6'   83                    	ADD	E
  05C7'   5F                    	MOV	E,A
  05C8'   D2 05CC'              	JNC	SG_SET
  05CB'   14                    	INR	D
  05CC'                         SG_SET:
  05CC'   EB                    	XCHG
  05CD'   22 2A21'              	SHLD	GOALCOL
  05D0'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  05D1'                         CWID:
  05D1'   FE 0D                 	CPI	CR
  05D3'   CA 05E2'              	JZ	CW_0
  05D6'   FE 09                 	CPI	TAB
  05D8'   3E 01                 	MVI	A,1
  05DA'   C0                    	RNZ
  05DB'   7D                    	MOV	A,L
  05DC'   E6 07                 	ANI	TABWID-1
  05DE'   2F                    	CMA
  05DF'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  05E1'   C9                    	RET
  05E2'                         CW_0:
  05E2'   AF                    	XRA	A
  05E3'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
  05E4'                         BOL:
  05E4'                         BOL_LP:
  05E4'   7C                    	MOV	A,H
  05E5'   B5                    	ORA	L
  05E6'   C8                    	RZ			; at 0
  05E7'   2B                    	DCX	H		; look at off-1
  05E8'   E5                    	PUSH	H
  05E9'   CD 0000*              	CALL	CHARAT
  05EC'   E1                    	POP	H		; HL = off-1
  05ED'   FE 0A                 	CPI	LF
  05EF'   CA 05F5'              	JZ	BOL_DN
  05F2'   C3 05E4'              	JMP	BOL_LP
  05F5'                         BOL_DN:
  05F5'   23                    	INX	H		; line starts just after the LF
  05F6'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
  05F7'                         EOLNL:
  05F7'   E5                    	PUSH	H
  05F8'   CD 0000*              	CALL	LOGLEN
  05FB'   22 2A61'              	SHLD	WKN
  05FE'   E1                    	POP	H
  05FF'                         ENL_LP:
  05FF'   EB                    	XCHG			; DE = i
  0600'   2A 2A61'              	LHLD	WKN
  0603'   CD 0000*              	CALL	CMP16		; DE=i vs HL=n: CY iff i < n
  0606'   EB                    	XCHG			; HL = i, DE = n
  0607'   D0                    	RNC			; i >= n: no LF on this line
  0608'   E5                    	PUSH	H
  0609'   CD 0000*              	CALL	CHARAT
  060C'   E1                    	POP	H
  060D'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  060F'   C8                    	RZ			; the LF: HL is its offset
  0610'   23                    	INX	H
  0611'   C3 05FF'              	JMP	ENL_LP
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  0614'                         NLSTART:
  0614'   CD 05F7'              	CALL	EOLNL
  0617'   E5                    	PUSH	H
  0618'   CD 0000*              	CALL	LOGLEN
  061B'   D1                    	POP	D		; DE = eol result
  061C'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  061F'   C8                    	RZ			; no next line: HL = LOGLEN
  0620'   EB                    	XCHG			; HL = eol
  0621'   23                    	INX	H
  0622'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  0623'                         EOLC:
  0623'   E5                    	PUSH	H
  0624'   CD 05F7'              	CALL	EOLNL
  0627'   22 2A63'              	SHLD	WKTERM
  062A'   E1                    	POP	H
  062B'   CD 05E4'              	CALL	BOL
  062E'   22 2A65'              	SHLD	WKBOL
  0631'   2A 2A63'              	LHLD	WKTERM
  0634'   EB                    	XCHG			; DE = term
  0635'   2A 2A65'              	LHLD	WKBOL
  0638'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  063B'   CA 065A'              	JZ	EOLC_MT
  063E'   EB                    	XCHG			; HL = term
  063F'   2B                    	DCX	H		; term-1
  0640'   E5                    	PUSH	H
  0641'   CD 0000*              	CALL	CHARAT
  0644'   E1                    	POP	H		; HL = term-1
  0645'   FE 0D                 	CPI	CR
  0647'   CA 064D'              	JZ	EOLC_CR		; content ends at term-1
  064A'   C3 064E'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  064D'                         EOLC_CR:
  064D'   2B                    	DCX	H		; last = (term-1) - 1
  064E'                         EOLC_LS:
  064E'   EB                    	XCHG			; DE = last
  064F'   2A 2A65'              	LHLD	WKBOL
  0652'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  0655'   DA 065A'              	JC	EOLC_MT
  0658'   EB                    	XCHG			; HL = last
  0659'   C9                    	RET
  065A'                         EOLC_MT:
  065A'   2A 2A65'              	LHLD	WKBOL
  065D'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  065E'                         COL:
  065E'   E5                    	PUSH	H
  065F'   CD 05E4'              	CALL	BOL
  0662'   D1                    	POP	D		; DE = off
  0663'   EB                    	XCHG			; HL = off, DE = bol
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  0664'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  0667'                         ATENDQ:
  0667'   CD 0000*              	CALL	CUROFF
  066A'   E5                    	PUSH	H
  066B'   CD 0000*              	CALL	LOGLEN
  066E'   D1                    	POP	D		; DE = cur
  066F'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0672'                         CURCHR:
  0672'   CD 0000*              	CALL	CUROFF
  0675'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  0678'                         MOVCNT:
  0678'   CD 075A'              	CALL	SETMOV
  067B'   C3 068B'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  067E'                         CNTOFF:
  067E'   CD 068B'              	CALL	GETCNT
  0681'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  0684'                         GBSUB:
  0684'   EB                    	XCHG
  0685'   2A 0000*              	LHLD	GAPBEG
  0688'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  068B'                         GETCNT:
  068B'   2A 2A19'              	LHLD	CMDCNT
  068E'   7C                    	MOV	A,H
  068F'   B5                    	ORA	L
  0690'   C2 0697'              	JNZ	GC_HAVE
  0693'   21 0001               	LXI	H,1
  0696'   C9                    	RET
  0697'                         GC_HAVE:
  0697'   E5                    	PUSH	H
  0698'   21 0000               	LXI	H,0
  069B'   22 2A19'              	SHLD	CMDCNT
  069E'   E1                    	POP	H
  069F'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for a ^C break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  06A0'                         CNTTST:				; WM 1175
  06A0'   3A 2ACB'              	LDA	BRKARM
  06A3'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06A4'   C4 06CE'              	CNZ	BRKTST		; a ^C spends the count: every loop stops here
  06A7'   E5                    	PUSH	H
  06A8'   2A 2A19'              	LHLD	CMDCNT
  06AB'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  06AE'   B4                    	ORA	H
  06AF'   B5                    	ORA	L
  06B0'   E1                    	POP	H
  06B1'   C3 0000*              	JMP	POLLBRK
                                
                                ;============================================================
                                ; ^C -- abandon a search or a long move.
                                ;
                                ; Every loop that pages asks CNTTST whether to go on, so that is where a ^C is
                                ; looked for: it zeroes the count, and the loop ends the way it ends when the
                                ; count runs out.  Nothing is half done, because the commands that can be
                                ; stopped change nothing -- BRKON arms the test only with no operator pending,
                                ; and only 'G' 'gg' the mark jumps and the searches call it.  A 'dd' count, a
                                ; ':s', a put or a write asks the same CNTTST and is never stopped.
                                ;
                                ; The command then goes back to where it started (BRKBAK), as a search that
                                ; found nothing does: the screen was not repainted, so it is already right.
                                ; Going back pages, and that is not stopped by a second ^C.
                                ;============================================================
                                
                                ;BRKON -- a command that may page a long way is starting: keep the place it
                                ; started from (the cursor's position in the file, and LNDLT for its row), and
                                ; arm the ^C test unless an operator is waiting for this motion.
  06B4'                         BRKON:
  06B4'   21 2AC6'              	LXI	H,SOFF
  06B7'   CD 044F'              	CALL	FPSTO
  06BA'   2A 0000*              	LHLD	LNDLT
  06BD'   22 2AC9'              	SHLD	SLDLT
  06C0'   AF                    	XRA	A
  06C1'   32 2ACC'              	STA	BRKHIT
  06C4'   3A 2A43'              	LDA	PSAVE
  06C7'   B7                    	ORA	A
  06C8'   C0                    	RNZ			; 'dG' changes text: it runs to its end
  06C9'   3C                    	INR	A
  06CA'   32 2ACB'              	STA	BRKARM
  06CD'   C9                    	RET
                                
                                ;BRKTST -- CNTTST's question while armed.  Keeps BC, DE, HL.
  06CE'                         BRKTST:
  06CE'   C5                    	PUSH	B
  06CF'   D5                    	PUSH	D
  06D0'   E5                    	PUSH	H
  06D1'   CD 0000*              	CALL	KBBRK
  06D4'   CA 06E7'              	JZ	BT_NO
  06D7'   32 2ACC'              	STA	BRKHIT		; (A = FFH)
  06DA'   AF                    	XRA	A
  06DB'   32 2ACB'              	STA	BRKARM		; the way back is not stopped in its turn
  06DE'   32 0000*              	STA	AUXCNT
  06E1'   21 0000               	LXI	H,0
  06E4'   22 2A19'              	SHLD	CMDCNT
  06E7'                         BT_NO:
  06E7'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  06E8'   D1                    	POP	D
  06E9'   C1                    	POP	B
  06EA'   C9                    	RET
                                
                                ;BRKOFF -- the move is over: disarm.  NOTE: falls into BRKQ.
  06EB'                         BRKOFF:
  06EB'   AF                    	XRA	A
  06EC'   32 2ACB'              	STA	BRKARM
                                ;BRKQ -- CY iff a ^C stopped it.
  06EF'                         BRKQ:
  06EF'   3A 2ACC'              	LDA	BRKHIT
  06F2'   B7                    	ORA	A
  06F3'   C8                    	RZ
  06F4'   37                    	STC
  06F5'   C9                    	RET
                                
                                ;RSTPL -- back to the place BRKON kept, on the row it was on.
  06F6'                         RSTPL:
  06F6'   21 2AC6'              	LXI	H,SOFF
  06F9'   CD 03F6'              	CALL	BACKTO
  06FC'   2A 2AC9'              	LHLD	SLDLT
  06FF'   22 0000*              	SHLD	LNDLT
  0702'   C9                    	RET
                                
                                ;BRKBAK -- stopped: back to the start, drop whatever was typed meanwhile (it
                                ; was meant for a result that is not coming), and say so.  CY, as EXERR.
  0703'                         BRKBAK:
  0703'   CD 06F6'              	CALL	RSTPL
  0706'   CD 0000*              	CALL	KBFLSH
  0709'   21 236A'              	LXI	H,SINTR
  070C'   C3 22CC'              	JMP	EXERR
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  070F'                         CLASSF:
  070F'   47                    	MOV	B,A
  0710'   FE 20                 	CPI	' '
  0712'   CA 0752'              	JZ	CLS0
  0715'   FE 09                 	CPI	TAB
  0717'   CA 0752'              	JZ	CLS0
  071A'   FE 0A                 	CPI	LF
  071C'   CA 0752'              	JZ	CLS0
  071F'   FE 0D                 	CPI	CR
  0721'   CA 0752'              	JZ	CLS0
  0724'   3A 2A23'              	LDA	WBIG
  0727'   B7                    	ORA	A
  0728'   C2 0754'              	JNZ	CLS1
  072B'   78                    	MOV	A,B
  072C'   FE 5F                 	CPI	'_'
  072E'   CA 0754'              	JZ	CLS1
  0731'   FE 30                 	CPI	'0'
  0733'   DA 0757'              	JC	CLS2
  0736'   FE 3A                 	CPI	'9'+1
  0738'   DA 0754'              	JC	CLS1
  073B'   FE 41                 	CPI	'A'
  073D'   DA 0757'              	JC	CLS2
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0740'   FE 5B                 	CPI	'Z'+1
  0742'   DA 0754'              	JC	CLS1
  0745'   FE 61                 	CPI	'a'
  0747'   DA 0757'              	JC	CLS2
  074A'   FE 7B                 	CPI	'z'+1
  074C'   DA 0754'              	JC	CLS1
  074F'   C3 0757'              	JMP	CLS2
  0752'   AF                    CLS0:	XRA	A
  0753'   C9                    	RET
  0754'   3E 01                 CLS1:	MVI	A,1
  0756'   C9                    	RET
  0757'   3E 02                 CLS2:	MVI	A,2
  0759'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  075A'                         SETMOV:
  075A'   3E 01                 	MVI	A,R_MOVE
  075C'   32 2A1D'              	STA	RINTENT
  075F'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  0760'                         SETLIN:
  0760'   3E 02                 	MVI	A,R_LINE
  0762'   32 2A1D'              	STA	RINTENT
  0765'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  0766'                         SETILN:
  0766'   3E 01                 	MVI	A,1
  0768'   32 2A1E'              	STA	ILN		; one line, unless a put overwrites it below
  076B'   3E 05                 	MVI	A,R_ILIN
  076D'   32 2A1D'              	STA	RINTENT
  0770'   AF                    	XRA	A
  0771'   32 2A20'              	STA	ILABOV		; the row above the opened ones is untouched
  0774'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  0775'                         SETJON:
  0775'   3E 06                 	MVI	A,R_JOIN
  0777'   32 2A1D'              	STA	RINTENT
  077A'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  077B'                         SETFUL:
  077B'   3E 00                 	MVI	A,R_FULL
  077D'   32 2A1D'              	STA	RINTENT
  0780'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB occurs from the cursor to the end of its line, else 0.
                                ; Scans forward from the cursor via CHARAT until LF or end of text (no gap move).
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  0781'                         TAILTAB:
  0781'   CD 0000*              	CALL	CUROFF
  0784'   22 2A5D'              	SHLD	TTI
  0787'                         TT_LP:
  0787'   2A 2A5D'              	LHLD	TTI
  078A'   EB                    	XCHG			; DE = TTI
  078B'   CD 0000*              	CALL	LOGLEN		; HL = LOGLEN
  078E'   CD 0000*              	CALL	CMP16		; CY iff TTI < LOGLEN
  0791'   D2 07B1'              	JNC	TT_NO		; reached end of text -> no tab
  0794'   2A 2A5D'              	LHLD	TTI
  0797'   CD 0000*              	CALL	CHARAT
  079A'   FE 0A                 	CPI	LF
  079C'   CA 07B1'              	JZ	TT_NO		; end of line -> no tab
  079F'   FE 09                 	CPI	TAB
  07A1'   CA 07AE'              	JZ	TT_YES
  07A4'   2A 2A5D'              	LHLD	TTI
  07A7'   23                    	INX	H
  07A8'   22 2A5D'              	SHLD	TTI
  07AB'   C3 0787'              	JMP	TT_LP
  07AE'                         TT_YES:
  07AE'   3E 01                 	MVI	A,1
  07B0'   C9                    	RET
  07B1'                         TT_NO:
  07B1'   AF                    	XRA	A
  07B2'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  07B3'                         VC_H:
  07B3'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  07B6'   22 2A5B'              	SHLD	CNTV
  07B9'                         VCH_LP:
  07B9'   2A 2A5B'              	LHLD	CNTV
  07BC'   7C                    	MOV	A,H
  07BD'   B5                    	ORA	L
  07BE'   C8                    	RZ
  07BF'   2B                    	DCX	H
  07C0'   22 2A5B'              	SHLD	CNTV
  07C3'   CD 07C9'              	CALL	HSTEP
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07C6'   C3 07B9'              	JMP	VCH_LP
  07C9'                         HSTEP:
  07C9'   CD 0000*              	CALL	CUROFF		; HL = cur
  07CC'   7C                    	MOV	A,H
  07CD'   B5                    	ORA	L
  07CE'   C8                    	RZ			; at 0
  07CF'   E5                    	PUSH	H
  07D0'   CD 05E4'              	CALL	BOL		; HL = bol
  07D3'   D1                    	POP	D		; DE = cur
  07D4'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  07D7'   C8                    	RZ			; at BOL, cannot go left
  07D8'   EB                    	XCHG			; HL = cur
  07D9'   2B                    	DCX	H
  07DA'   C3 057A'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  07DD'                         VC_L:
  07DD'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  07E0'   22 2A5B'              	SHLD	CNTV
  07E3'                         VCL_LP:
  07E3'   2A 2A5B'              	LHLD	CNTV
  07E6'   7C                    	MOV	A,H
  07E7'   B5                    	ORA	L
  07E8'   C8                    	RZ
  07E9'   2B                    	DCX	H
  07EA'   22 2A5B'              	SHLD	CNTV
  07ED'   CD 07F3'              	CALL	LSTEP
  07F0'   C3 07E3'              	JMP	VCL_LP
  07F3'                         LSTEP:
  07F3'   CD 0000*              	CALL	CUROFF		; HL = cur
  07F6'   E5                    	PUSH	H
  07F7'   CD 0623'              	CALL	EOLC		; HL = eolc
  07FA'   D1                    	POP	D		; DE = cur
  07FB'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  07FE'   D2 0806'              	JNC	LS_NO		; cur >= eolc, cannot go right
  0801'   EB                    	XCHG			; HL = cur
  0802'   23                    	INX	H
  0803'   C3 057A'              	JMP	GOSET
  0806'                         LS_NO:				; on the line's last char.  An operator waiting on
  0806'   CD 0BD2'              	CALL	EMPTY		;   this 'l' takes that char too (vim makes the
  0809'   C8                    	RZ			;   motion inclusive when it falls short), which
  080A'   3E 01                 	MVI	A,1		;   is what WPULL tells OPA_EX: 'dl' there is 'x',
  080C'   32 2A24'              	STA	WPULL		;   and 'd3l' two from the end takes both.  An
  080F'   C9                    	RET			;   empty line has no char to take
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  0810'                         VC_0:
  0810'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0813'   CD 081D'              	CALL	LNSTRT
  0816'   21 0000               	LXI	H,0
  0819'   22 2A21'              	SHLD	GOALCOL
  081C'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  081D'                         LNSTRT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  081D'   CD 0F4F'              	CALL	ZSAVE
  0820'   21 0000               	LXI	H,0
  0823'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  0826'   E5                    	PUSH	H
  0827'   CD 0F62'              	CALL	ZREST
  082A'   E1                    	POP	H
  082B'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  082E'                         VC_CRT:
  082E'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0831'   C3 0834'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  0834'                         FNBLNK:
  0834'   CD 081D'              	CALL	LNSTRT
  0837'   CD 0000*              	CALL	RGET0
  083A'   11 0000               	LXI	D,0		; DE = blanks skipped
  083D'                         FN_LP:
  083D'   CD 0000*              	CALL	RDGET
  0840'   DA 0863'              	JC	FN_GO		; the end of the file
  0843'   FE 20                 	CPI	' '
  0845'   CA 084D'              	JZ	FN_WH
  0848'   FE 09                 	CPI	TAB
  084A'   C2 0863'              	JNZ	FN_GO		; a non-blank, or the line's end
  084D'                         FN_WH:
  084D'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  0850'   DA 0863'              	JC	FN_GO
  0853'   FE 0D                 	CPI	CR
  0855'   CA 0863'              	JZ	FN_GO
  0858'   FE 0A                 	CPI	LF
  085A'   CA 0863'              	JZ	FN_GO
  085D'   2B                    	DCX	H		; not yet: read that char again
  085E'   03                    	INX	B
  085F'   13                    	INX	D
  0860'   C3 083D'              	JMP	FN_LP
  0863'                         FN_GO:
  0863'   D5                    	PUSH	D
  0864'   CD 0000*              	CALL	CUROFF
  0867'   D1                    	POP	D
  0868'   19                    	DAD	D
  0869'   C3 057A'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  086C'                         VC_EOL:
  086C'   CD 075A'              	CALL	SETMOV
  086F'   21 FFFF               	LXI	H,0FFFFH
  0872'   22 2A21'              	SHLD	GOALCOL
  0875'   CD 068B'              	CALL	GETCNT
  0878'   2B                    	DCX	H		; count-1
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  0879'   7C                    	MOV	A,H
  087A'   B5                    	ORA	L
  087B'   CA 088A'              	JZ	VEOL_0
  087E'   E5                    	PUSH	H
  087F'   CD 089F'              	CALL	ONLAST
  0882'   E1                    	POP	H
  0883'   D8                    	RC			; the last line: no move (vim)
  0884'   CD 08EF'              	CALL	JCORE
  0887'   C3 0A3E'              	JMP	JKLAND
  088A'                         VEOL_0:
  088A'   CD 081D'              	CALL	LNSTRT
  088D'   C3 0A3E'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  0890'                         VC_CR:
  0890'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0893'   E5                    	PUSH	H
  0894'   CD 089F'              	CALL	ONLAST
  0897'   E1                    	POP	H
  0898'   D8                    	RC
  0899'   CD 08EF'              	CALL	JCORE
  089C'   C3 0834'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  089F'                         ONLAST:
  089F'   CD 0000*              	CALL	RGET0
  08A2'                         OL_LP:
  08A2'   CD 0000*              	CALL	RDGET
  08A5'   D8                    	RC			; the file ends on this line
  08A6'   FE 0A                 	CPI	LF
  08A8'   C2 08A2'              	JNZ	OL_LP
  08AB'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  08AE'                         VC_J:
  08AE'   CD 075A'              	CALL	SETMOV
  08B1'   CD 08D9'              	CALL	GLCHK		; the goal column, from the cursor if stale
  08B4'   CD 068B'              	CALL	GETCNT		; HL = count
  08B7'   CD 08EF'              	CALL	JCORE
  08BA'   CD 08D2'              	CALL	JKDRP
  08BD'   C3 0A3E'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  08C0'                         VC_K:
  08C0'   CD 075A'              	CALL	SETMOV
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  08C3'   CD 08D9'              	CALL	GLCHK
  08C6'   CD 068B'              	CALL	GETCNT
  08C9'   CD 098C'              	CALL	KCORE
  08CC'   CD 08D2'              	CALL	JKDRP
  08CF'   C3 0A3E'              	JMP	JKLAND
                                
                                ;JKDRP -- DE = the lines JCORE / KCORE moved.  None -- 'j' on the last line,
                                ; 'k' on the first -- and the motion has failed: an operator waiting on it is
                                ; dropped, as vim drops it, where a line span that starts and ends on one line
                                ; would take that line ('dj' on the last line deleted it).  A count that runs
                                ; out of lines short has still moved, and its operator stands.  It is asked
                                ; here and not in the cores: 'dH' on the top row moves no lines either, and
                                ; takes its line.
  08D2'                         JKDRP:
  08D2'   7A                    	MOV	A,D
  08D3'   B3                    	ORA	E
  08D4'   C0                    	RNZ
  08D5'   32 2A43'              	STA	PSAVE
  08D8'   C9                    	RET
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  08D9'                         GLCHK:
  08D9'   2A 2A21'              	LHLD	GOALCOL
  08DC'   7C                    	MOV	A,H
  08DD'   3C                    	INR	A
  08DE'   C0                    	RNZ
  08DF'   7D                    	MOV	A,L
  08E0'   FE FE                 	CPI	0FEH
  08E2'   C0                    	RNZ
  08E3'   C3 057D'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  08E6'                         GLSTAL:
  08E6'   E5                    	PUSH	H
  08E7'   21 FFFE               	LXI	H,0FFFEH
  08EA'   22 2A21'              	SHLD	GOALCOL
  08ED'   E1                    	POP	H
  08EE'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  08EF'                         JCORE:
  08EF'   7C                    	MOV	A,H
  08F0'   B5                    	ORA	L
  08F1'   C8                    	RZ
  08F2'   22 2A27'              	SHLD	JKCNT
  08F5'   CD 0D01'              	CALL	CURRW		; limit = rows under the cursor's + NEDIT
  08F8'   47                    	MOV	B,A
  08F9'   3A 0000*              	LDA	NEDIT
  08FC'   3D                    	DCR	A
  08FD'   90                    	SUB	B
  08FE'   5F                    	MOV	E,A
  08FF'   16 00                 	MVI	D,0
  0901'   3A 0000*              	LDA	NEDIT
  0904'   6F                    	MOV	L,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0905'   26 00                 	MVI	H,0
  0907'   19                    	DAD	D
  0908'   EB                    	XCHG			; DE = limit
  0909'   2A 2A27'              	LHLD	JKCNT
  090C'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  090F'   D2 0913'              	JNC	JC_N
  0912'   EB                    	XCHG			; HL = limit
  0913'                         JC_N:
  0913'   22 2A29'              	SHLD	JKN		; N = min(count, limit)
  0916'   EB                    	XCHG			; DE = LFs to find
  0917'   CD 0000*              	CALL	RGET0
  091A'                         JC_SC:
  091A'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  091D'   DA 093C'              	JC	JC_EOF
  0920'   32 2A30'              	STA	JKLST
  0923'   FE 0A                 	CPI	LF
  0925'   C2 091A'              	JNZ	JC_SC
  0928'   1B                    	DCX	D
  0929'   7A                    	MOV	A,D
  092A'   B3                    	ORA	E
  092B'   C2 091A'              	JNZ	JC_SC
  092E'   2A 2A27'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  0931'   22 2A2B'              	SHLD	JKMOV		;   one if the last LF found ends the file
  0934'   3E 01                 	MVI	A,1
  0936'   32 2A2F'              	STA	JKPHN
  0939'   C3 0957'              	JMP	JC_MV
  093C'                         JC_EOF:
  093C'   2A 2A29'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  093F'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  0942'   7C                    	MOV	A,H
  0943'   B5                    	ORA	L
  0944'   CA 0950'              	JZ	JC_AV
  0947'   3A 2A30'              	LDA	JKLST
  094A'   FE 0A                 	CPI	LF
  094C'   C2 0950'              	JNZ	JC_AV
  094F'   2B                    	DCX	H
  0950'                         JC_AV:
  0950'   22 2A2B'              	SHLD	JKMOV
  0953'   AF                    	XRA	A
  0954'   32 2A2F'              	STA	JKPHN
  0957'                         JC_MV:
  0957'   2A 2A27'              	LHLD	JKCNT
  095A'   AF                    	XRA	A
  095B'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  095E'   CD 0A1D'              	CALL	ATEOF
  0961'   D2 0975'              	JNC	JC_DN
  0964'   CD 0A23'              	CALL	LASTLN		; ran past the last line: back onto it
  0967'   3A 2A2F'              	LDA	JKPHN
  096A'   B7                    	ORA	A
  096B'   CA 0975'              	JZ	JC_DN
  096E'   2A 2A2B'              	LHLD	JKMOV
  0971'   2B                    	DCX	H
  0972'   22 2A2B'              	SHLD	JKMOV
  0975'                         JC_DN:
  0975'   2A 2A29'              	LHLD	JKN		; LNDLT += min(moved, N)
  0978'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0979'   2A 2A2B'              	LHLD	JKMOV
  097C'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  097F'   D2 0983'              	JNC	JC_AD
  0982'   EB                    	XCHG
  0983'                         JC_AD:
  0983'   EB                    	XCHG			; DE = lines moved
  0984'   2A 0000*              	LHLD	LNDLT
  0987'   19                    	DAD	D
  0988'   22 0000*              	SHLD	LNDLT
  098B'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  098C'                         KCORE:
  098C'   7C                    	MOV	A,H
  098D'   B5                    	ORA	L
  098E'   C8                    	RZ
  098F'   22 2A27'              	SHLD	JKCNT
  0992'   CD 0D01'              	CALL	CURRW		; limit = row + NEDIT
  0995'   5F                    	MOV	E,A
  0996'   16 00                 	MVI	D,0
  0998'   3A 0000*              	LDA	NEDIT
  099B'   6F                    	MOV	L,A
  099C'   26 00                 	MVI	H,0
  099E'   19                    	DAD	D
  099F'   EB                    	XCHG			; DE = limit
  09A0'   2A 2A27'              	LHLD	JKCNT
  09A3'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  09A6'   D2 09AA'              	JNC	KC_N
  09A9'   EB                    	XCHG			; HL = limit
  09AA'                         KC_N:
  09AA'   22 2A29'              	SHLD	JKN		; N = min(count, limit)
  09AD'   EB                    	XCHG			; DE = LFs to find
  09AE'   21 0000               	LXI	H,0
  09B1'   22 2A2D'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  09B4'                         KC_ED:
  09B4'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  09B5'   2A 2A2D'              	LHLD	JKBK
  09B8'   CD 0684'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  09BB'   E5                    	PUSH	H
  09BC'   EB                    	XCHG
  09BD'   2A 0000*              	LHLD	TXTBEG
  09C0'   EB                    	XCHG
  09C1'   CD 0000*              	CALL	SUBHD
  09C4'   44                    	MOV	B,H
  09C5'   4D                    	MOV	C,L
  09C6'   E1                    	POP	H
  09C7'   D1                    	POP	D
  09C8'                         KC_SC:
  09C8'   78                    	MOV	A,B
  09C9'   B1                    	ORA	C
  09CA'   CA 09E1'              	JZ	KC_TB
  09CD'   2B                    	DCX	H
  09CE'   0B                    	DCX	B
  09CF'   7E                    	MOV	A,M
  09D0'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  09D2'   C2 09C8'              	JNZ	KC_SC
  09D5'   1B                    	DCX	D
  09D6'   7A                    	MOV	A,D
  09D7'   B3                    	ORA	E
  09D8'   C2 09C8'              	JNZ	KC_SC
  09DB'   2A 2A27'              	LHLD	JKCNT		; N lines above: the move is count lines
  09DE'   C3 0A01'              	JMP	KC_MV
  09E1'                         KC_TB:
  09E1'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  09E2'   CD 0684'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  09E5'   22 2A2D'              	SHLD	JKBK
  09E8'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  09EB'   7C                    	MOV	A,H
  09EC'   B5                    	ORA	L
  09ED'   CA 09FA'              	JZ	KC_B0
  09F0'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  09F3'   D1                    	POP	D
  09F4'   DA 09FB'              	JC	KC_BOF
  09F7'   C3 09B4'              	JMP	KC_ED
  09FA'                         KC_B0:
  09FA'   D1                    	POP	D
  09FB'                         KC_BOF:
  09FB'   2A 2A29'              	LHLD	JKN		; moved = LFs found
  09FE'   CD 0000*              	CALL	SUBHD
  0A01'                         KC_MV:
  0A01'   E5                    	PUSH	H
  0A02'   2A 2A27'              	LHLD	JKCNT
  0A05'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0A08'   D1                    	POP	D		; DE = moved
  0A09'   2A 2A29'              	LHLD	JKN
  0A0C'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0A0F'   DA 0A13'              	JC	KC_AD
  0A12'   EB                    	XCHG			; DE = N
  0A13'                         KC_AD:
  0A13'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0A16'   CD 0000*              	CALL	SUBHD
  0A19'   22 0000*              	SHLD	LNDLT
  0A1C'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0A1D'                         ATEOF:
  0A1D'   CD 0000*              	CALL	RGET0
  0A20'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0A23'                         LASTLN:
  0A23'   2A 0000*              	LHLD	GAPBEG
  0A26'   EB                    	XCHG
  0A27'   2A 0000*              	LHLD	TXTBEG
  0A2A'   CD 0000*              	CALL	CMP16
  0A2D'   21 0000               	LXI	H,0
  0A30'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0A33'   1B                    	DCX	D
  0A34'   1A                    	LDAX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0A35'   FE 0A                 	CPI	LF
  0A37'   C2 0000*              	JNZ	SETBWD
  0A3A'   23                    	INX	H
  0A3B'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0A3E'                         JKLAND:
  0A3E'   21 0000               	LXI	H,0
  0A41'   22 2A31'              	SHLD	JKVC		; screen column
  0A44'   2B                    	DCX	H
  0A45'   22 2A33'              	SHLD	JKLS		; last content char: none yet
  0A48'   CD 0000*              	CALL	RGET0
  0A4B'   11 0000               	LXI	D,0		; DE = chars read
  0A4E'                         JL_RD:
  0A4E'   CD 0000*              	CALL	RDGET
  0A51'   DA 0A8B'              	JC	JL_END
  0A54'   FE 0A                 	CPI	LF
  0A56'   CA 0A8B'              	JZ	JL_END
  0A59'   E5                    	PUSH	H
  0A5A'   C5                    	PUSH	B
  0A5B'   2A 2A31'              	LHLD	JKVC
  0A5E'   CD 05D1'              	CALL	CWID
  0A61'   B7                    	ORA	A
  0A62'   CA 0A85'              	JZ	JL_NX		; a CR
  0A65'   EB                    	XCHG
  0A66'   22 2A33'              	SHLD	JKLS		; the last content char so far
  0A69'   EB                    	XCHG
  0A6A'   4F                    	MOV	C,A
  0A6B'   06 00                 	MVI	B,0
  0A6D'   09                    	DAD	B		; HL = the column after this char
  0A6E'   22 2A31'              	SHLD	JKVC
  0A71'   D5                    	PUSH	D
  0A72'   EB                    	XCHG
  0A73'   2A 2A21'              	LHLD	GOALCOL
  0A76'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0A79'   D1                    	POP	D
  0A7A'   DA 0A85'              	JC	JL_NX
  0A7D'   CA 0A85'              	JZ	JL_NX
  0A80'   C1                    	POP	B		; this char holds the goal column
  0A81'   E1                    	POP	H
  0A82'   C3 0A96'              	JMP	JL_GO
  0A85'                         JL_NX:
  0A85'   C1                    	POP	B
  0A86'   E1                    	POP	H
  0A87'   13                    	INX	D
  0A88'   C3 0A4E'              	JMP	JL_RD
  0A8B'                         JL_END:
  0A8B'   2A 2A33'              	LHLD	JKLS		; past the line's end: its last content char
  0A8E'   7C                    	MOV	A,H
  0A8F'   A5                    	ANA	L
  0A90'   3C                    	INR	A
  0A91'   C2 0A95'              	JNZ	JL_LS
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0A94'   23                    	INX	H		; no content: the line's start
  0A95'                         JL_LS:
  0A95'   EB                    	XCHG
  0A96'                         JL_GO:
  0A96'   D5                    	PUSH	D		; DE = step from the line start
  0A97'   CD 0000*              	CALL	CUROFF
  0A9A'   D1                    	POP	D
  0A9B'   19                    	DAD	D
  0A9C'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0A9F'   AF                    VC_W:	XRA	A
  0AA0'   32 2A23'              	STA	WBIG
  0AA3'   C3 0AAB'              	JMP	WDO
  0AA6'   3E 01                 VCBGW:	MVI	A,1
  0AA8'   32 2A23'              	STA	WBIG
  0AAB'   CD 075A'              WDO:	CALL	SETMOV
  0AAE'   AF                    	XRA	A
  0AAF'   32 2A24'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0AB2'   CD 068B'              	CALL	GETCNT
  0AB5'   22 2A5B'              	SHLD	CNTV
  0AB8'   2A 2A5B'              WDO_LP: LHLD	CNTV
  0ABB'   7C                    	MOV	A,H
  0ABC'   B5                    	ORA	L
  0ABD'   CA 0ACA'              	JZ	WDO_DN
  0AC0'   2B                    	DCX	H
  0AC1'   22 2A5B'              	SHLD	CNTV
  0AC4'   CD 0B27'              	CALL	FWD1
  0AC7'   D2 0AB8'              	JNC	WDO_LP
  0ACA'                         WDO_DN:
  0ACA'   CD 0A1D'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0ACD'   DA 0ADA'              	JC	WDO_NL
  0AD0'   FE 0D                 	CPI	CR
  0AD2'   CA 0ADA'              	JZ	WDO_NL
  0AD5'   FE 0A                 	CPI	LF
  0AD7'   C2 057D'              	JNZ	SETGL
  0ADA'                         WDO_NL:
  0ADA'   CD 0000*              	CALL	PEEKL
  0ADD'   DA 057D'              	JC	SETGL
  0AE0'   FE 0A                 	CPI	LF
  0AE2'   CA 057D'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0AE5'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0AE7'   32 2A24'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0AEA'   CD 0C46'              	CALL	DECC		; back onto its last char
  0AED'   C3 057D'              	JMP	SETGL
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


                                
  0AF0'   AF                    VC_B:	XRA	A
  0AF1'   32 2A23'              	STA	WBIG
  0AF4'   C3 0AFC'              	JMP	BDO
  0AF7'   3E 01                 VCBGB:	MVI	A,1
  0AF9'   32 2A23'              	STA	WBIG
  0AFC'   CD 075A'              BDO:	CALL	SETMOV
  0AFF'   CD 068B'              	CALL	GETCNT
  0B02'   22 2A5B'              	SHLD	CNTV
  0B05'   CD 0B97'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0B08'   D2 0B18'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0B0B'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0B0C'   32 2A43'              	STA	PSAVE		;   first char opened an insert).  A count that
  0B0F'   C3 057D'              	JMP	SETGL		;   runs out at the start has still moved, and
  0B12'                         BDO_LP:				;   its operator stands -- both as vim
  0B12'   CD 0B97'              	CALL	BCK1
  0B15'   DA 057D'              	JC	SETGL
  0B18'   2A 2A5B'              BDO_NX: LHLD	CNTV
  0B1B'   2B                    	DCX	H
  0B1C'   22 2A5B'              	SHLD	CNTV
  0B1F'   7C                    	MOV	A,H
  0B20'   B5                    	ORA	L
  0B21'   C2 0B12'              	JNZ	BDO_LP
  0B24'   C3 057D'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
                                ; words before the last run on freely -- 'd2w' there takes the line break and
                                ; the next line's first word as well.
  0B27'                         FWD1:
  0B27'   CD 0BCA'              	CALL	CCLS
  0B2A'   32 2A67'              	STA	WKCLS		; the starting class
  0B2D'   CD 0C04'              	CALL	INCC
  0B30'   B7                    	ORA	A
  0B31'   CA 0B4A'              	JZ	FW_WD
  0B34'   37                    	STC
  0B35'   F8                    	RM			; -1: already at the end
  0B36'   CD 0B82'              	CALL	WLAST
  0B39'   C8                    	RZ
  0B3A'   FE 02                 	CPI	2
  0B3C'   C2 0B4A'              	JNZ	FW_WD		; 1: a next line was reached
  0B3F'   CD 0A1D'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0B42'   D4 0BEB'              	CNC	NXLN
  0B45'   D2 0B4A'              	JNC	FW_WD
  0B48'   37                    	STC			; yes: failed
  0B49'   C9                    	RET
  0B4A'                         FW_WD:
  0B4A'   3A 2A67'              	LDA	WKCLS		; go past the rest of this word
  0B4D'   B7                    	ORA	A
  0B4E'   CA 0B6A'              	JZ	FW_WS
  0B51'                         FW_WLP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0B51'   CD 0BCA'              	CALL	CCLS
  0B54'   21 2A67'              	LXI	H,WKCLS
  0B57'   BE                    	CMP	M
  0B58'   C2 0B6A'              	JNZ	FW_WS
  0B5B'   CD 0C04'              	CALL	INCC
  0B5E'   B7                    	ORA	A
  0B5F'   F8                    	RM			; the end of the file (NC)
  0B60'   CA 0B51'              	JZ	FW_WLP
  0B63'   CD 0B82'              	CALL	WLAST
  0B66'   C8                    	RZ
  0B67'   C3 0B51'              	JMP	FW_WLP
  0B6A'                         FW_WS:
  0B6A'   CD 0BCA'              	CALL	CCLS		; then over blanks to the next word
  0B6D'   B7                    	ORA	A
  0B6E'   C0                    	RNZ
  0B6F'   CD 0BD2'              	CALL	EMPTY
  0B72'   C8                    	RZ			; an empty line is a word
  0B73'   CD 0C04'              	CALL	INCC
  0B76'   B7                    	ORA	A
  0B77'   F8                    	RM
  0B78'   CA 0B6A'              	JZ	FW_WS
  0B7B'   CD 0B82'              	CALL	WLAST
  0B7E'   C8                    	RZ
  0B7F'   C3 0B6A'              	JMP	FW_WS
                                
                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0B82'                         WLAST:
  0B82'   47                    	MOV	B,A
  0B83'   2A 2A5B'              	LHLD	CNTV
  0B86'   7C                    	MOV	A,H
  0B87'   B5                    	ORA	L
  0B88'   C2 0B93'              	JNZ	WL_X		; words still owed
  0B8B'   3A 2A43'              	LDA	PSAVE
  0B8E'   B7                    	ORA	A
  0B8F'   CA 0B95'              	JZ	WL_NO		; a plain 'w'
  0B92'   AF                    	XRA	A
  0B93'   78                    WL_X:	MOV	A,B
  0B94'   C9                    	RET
  0B95'   B0                    WL_NO:	ORA	B
  0B96'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0B97'                         BCK1:
  0B97'   CD 0C46'              	CALL	DECC
  0B9A'   B7                    	ORA	A
  0B9B'   37                    	STC
  0B9C'   F8                    	RM
  0B9D'                         BK_WS:
  0B9D'   CD 0BCA'              	CALL	CCLS		; back over blanks
  0BA0'   B7                    	ORA	A
  0BA1'   C2 0BB1'              	JNZ	BK_WD
  0BA4'   CD 0BD2'              	CALL	EMPTY
  0BA7'   C8                    	RZ			; an empty line is a word
  0BA8'   CD 0C46'              	CALL	DECC
  0BAB'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0BAC'   F2 0B9D'              	JP	BK_WS
  0BAF'   AF                    	XRA	A		; the start of the file (NC)
  0BB0'   C9                    	RET
  0BB1'                         BK_WD:
  0BB1'   32 2A67'              	STA	WKCLS		; back to the start of this word
  0BB4'                         BK_WLP:
  0BB4'   CD 0C46'              	CALL	DECC
  0BB7'   B7                    	ORA	A
  0BB8'   FA 0BC8'              	JM	BK_OK		; the start of the file
  0BBB'   CD 0BCA'              	CALL	CCLS
  0BBE'   21 2A67'              	LXI	H,WKCLS
  0BC1'   BE                    	CMP	M
  0BC2'   CA 0BB4'              	JZ	BK_WLP
  0BC5'   CD 0C04'              	CALL	INCC		; overshot: forward one
  0BC8'                         BK_OK:
  0BC8'   AF                    	XRA	A
  0BC9'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0BCA'                         CCLS:
  0BCA'   CD 0A1D'              	CALL	ATEOF
  0BCD'   D2 070F'              	JNC	CLASSF
  0BD0'   AF                    	XRA	A
  0BD1'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0BD2'                         EMPTY:
  0BD2'   CD 0A1D'              	CALL	ATEOF
  0BD5'   DA 0BE0'              	JC	EM_ST
  0BD8'   FE 0D                 	CPI	CR
  0BDA'   CA 0BE0'              	JZ	EM_ST
  0BDD'   FE 0A                 	CPI	LF
  0BDF'   C0                    	RNZ
  0BE0'                         EM_ST:
  0BE0'   CD 0000*              	CALL	PEEKL
  0BE3'   DA 0BE9'              	JC	EM_Y
  0BE6'   FE 0A                 	CPI	LF
  0BE8'   C9                    	RET
  0BE9'                         EM_Y:
  0BE9'   AF                    	XRA	A
  0BEA'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0BEB'                         NXLN:
  0BEB'   FE 0A                 	CPI	LF
  0BED'   CA 0BFC'              	JZ	NX_LF
  0BF0'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0BF3'   D8                    	RC
  0BF4'   FE 0A                 	CPI	LF
  0BF6'   CA 0BFC'              	JZ	NX_LF
  0BF9'   2B                    	DCX	H		; a lone CR
  0BFA'   AF                    	XRA	A
  0BFB'   C9                    	RET
  0BFC'                         NX_LF:
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0BFC'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0BFF'   D8                    	RC
  0C00'   2B                    	DCX	H
  0C01'   3E 01                 	MVI	A,1
  0C03'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0C04'                         INCC:
  0C04'   CD 0A1D'              	CALL	ATEOF
  0C07'   DA 0C42'              	JC	IC_END
  0C0A'   FE 0D                 	CPI	CR
  0C0C'   CA 0C2D'              	JZ	IC_NL
  0C0F'   FE 0A                 	CPI	LF
  0C11'   CA 0C2D'              	JZ	IC_NL
  0C14'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0C17'                         IC_CH:
  0C17'   CD 0A1D'              	CALL	ATEOF
  0C1A'   DA 0C29'              	JC	IC_2
  0C1D'   FE 0D                 	CPI	CR
  0C1F'   CA 0C29'              	JZ	IC_2
  0C22'   FE 0A                 	CPI	LF
  0C24'   CA 0C29'              	JZ	IC_2
  0C27'   AF                    	XRA	A
  0C28'   C9                    	RET
  0C29'                         IC_2:
  0C29'   3E 02                 	MVI	A,2
  0C2B'   B7                    	ORA	A
  0C2C'   C9                    	RET
  0C2D'                         IC_NL:
  0C2D'   CD 0BEB'              	CALL	NXLN
  0C30'   DA 0C42'              	JC	IC_END
  0C33'   F5                    	PUSH	PSW
  0C34'   CD 0000*              	CALL	PUTCUR
  0C37'   F1                    	POP	PSW
  0C38'   B7                    	ORA	A
  0C39'   CA 0C17'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0C3C'   CD 0C68'              	CALL	LNINC
  0C3F'   3E 01                 	MVI	A,1
  0C41'   C9                    	RET
  0C42'                         IC_END:
  0C42'   3E FF                 	MVI	A,0FFH
  0C44'   B7                    	ORA	A
  0C45'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0C46'                         DECC:
  0C46'   CD 0000*              	CALL	PEEKL
  0C49'   DA 0C42'              	JC	IC_END
  0C4C'   F5                    	PUSH	PSW
  0C4D'   CD 0000*              	CALL	PUTCUR
  0C50'   F1                    	POP	PSW
  0C51'   FE 0A                 	CPI	LF
  0C53'   3E 00                 	MVI	A,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C55'   C0                    	RNZ
  0C56'   CD 0C76'              	CALL	LNDEC
  0C59'   CD 0000*              	CALL	PEEKL		; onto its CR
  0C5C'   DA 0C64'              	JC	DC_1
  0C5F'   FE 0D                 	CPI	CR
  0C61'   CC 0000*              	CZ	PUTCUR
  0C64'                         DC_1:
  0C64'   3E 01                 	MVI	A,1
  0C66'   B7                    	ORA	A
  0C67'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0C68'                         LNINC:
  0C68'   E5                    	PUSH	H
  0C69'   2A 0000*              	LHLD	LNDLT
  0C6C'   7C                    	MOV	A,H
  0C6D'   FE 40                 	CPI	40H
  0C6F'   CA 0C84'              	JZ	LN_X
  0C72'   23                    	INX	H
  0C73'   C3 0C81'              	JMP	LN_ST
  0C76'                         LNDEC:
  0C76'   E5                    	PUSH	H
  0C77'   2A 0000*              	LHLD	LNDLT
  0C7A'   7C                    	MOV	A,H
  0C7B'   FE C0                 	CPI	0C0H
  0C7D'   CA 0C84'              	JZ	LN_X
  0C80'   2B                    	DCX	H
  0C81'                         LN_ST:
  0C81'   22 0000*              	SHLD	LNDLT
  0C84'                         LN_X:
  0C84'   E1                    	POP	H
  0C85'   C9                    	RET
                                
  0C86'   AF                    VC_E:	XRA	A
  0C87'   32 2A23'              	STA	WBIG
  0C8A'   C3 0C92'              	JMP	EDO
  0C8D'   3E 01                 VCBGE:	MVI	A,1
  0C8F'   32 2A23'              	STA	WBIG
  0C92'   CD 075A'              EDO:	CALL	SETMOV
  0C95'   CD 068B'              	CALL	GETCNT
  0C98'   22 2A5B'              	SHLD	CNTV
  0C9B'   2A 2A5B'              EDO_LP: LHLD	CNTV
  0C9E'   7C                    	MOV	A,H
  0C9F'   B5                    	ORA	L
  0CA0'   CA 0ACA'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0CA3'   2B                    	DCX	H
  0CA4'   22 2A5B'              	SHLD	CNTV
  0CA7'   CD 0CB5'              	CALL	ESTEP
  0CAA'   21 2A46'              	LXI	H,CWEOL		; only the count's first word stays where it is
  0CAD'   36 00                 	MVI	M,0
  0CAF'   D2 0C9B'              	JNC	EDO_LP
  0CB2'   C3 0ACA'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0CB5'                         ESTEP:
  0CB5'   CD 0BCA'              	CALL	CCLS
  0CB8'   32 2A67'              	STA	WKCLS		; the starting class
  0CBB'   CD 0C04'              	CALL	INCC
  0CBE'   B7                    	ORA	A
  0CBF'   FA 0CE5'              	JM	ES_F
  0CC2'   CD 0BCA'              	CALL	CCLS
  0CC5'   B7                    	ORA	A
  0CC6'   CA 0CD0'              	JZ	ES_ST
  0CC9'   21 2A67'              	LXI	H,WKCLS
  0CCC'   BE                    	CMP	M
  0CCD'   CA 0CE7'              	JZ	ES_SK		; still in the word it started in: on to its end
  0CD0'                         ES_ST:
  0CD0'   3A 2A46'              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0CD3'   B7                    	ORA	A		;   that char is the word's end already, and
  0CD4'   C2 0CFE'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
  0CD7'                         ES_WS:
  0CD7'   CD 0BCA'              	CALL	CCLS		; over blanks, line ends and empty lines
  0CDA'   B7                    	ORA	A
  0CDB'   C2 0CE7'              	JNZ	ES_SK
  0CDE'   CD 0C04'              	CALL	INCC
  0CE1'   B7                    	ORA	A
  0CE2'   F2 0CD7'              	JP	ES_WS
  0CE5'                         ES_F:
  0CE5'   37                    	STC
  0CE6'   C9                    	RET
  0CE7'                         ES_SK:
  0CE7'   CD 0BCA'              	CALL	CCLS		; past the rest of this word ...
  0CEA'   32 2A67'              	STA	WKCLS
  0CED'                         ES_SL:
  0CED'   CD 0C04'              	CALL	INCC
  0CF0'   B7                    	ORA	A
  0CF1'   FA 0CE5'              	JM	ES_F
  0CF4'   CD 0BCA'              	CALL	CCLS
  0CF7'   21 2A67'              	LXI	H,WKCLS
  0CFA'   BE                    	CMP	M
  0CFB'   CA 0CED'              	JZ	ES_SL
  0CFE'   C3 0C46'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0D01'                         CURRW:
  0D01'   2A 0000*              	LHLD	WINROW
  0D04'   EB                    	XCHG
  0D05'   2A 0000*              	LHLD	LNDLT
  0D08'   19                    	DAD	D		; HL = row (signed)
  0D09'   7C                    	MOV	A,H
  0D0A'   B7                    	ORA	A
  0D0B'   FA 0D1E'              	JM	CRW_0		; above the screen -> top row
  0D0E'   C2 0D19'              	JNZ	CRW_BT		; far below -> bottom row
  0D11'   3A 0000*              	LDA	NEDIT
  0D14'   3D                    	DCR	A		; A = bottom row
  0D15'   BD                    	CMP	L		; CY iff bottom < row
  0D16'   D8                    	RC
  0D17'   7D                    	MOV	A,L
  0D18'   C9                    	RET
  0D19'                         CRW_BT:
  0D19'   3A 0000*              	LDA	NEDIT
  0D1C'   3D                    	DCR	A
  0D1D'   C9                    	RET
  0D1E'                         CRW_0:
  0D1E'   AF                    	XRA	A
  0D1F'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0D20'                         SETRWT:
  0D20'   2A 0000*              	LHLD	LNDLT
  0D23'   EB                    	XCHG
  0D24'   6F                    	MOV	L,A
  0D25'   26 00                 	MVI	H,0
  0D27'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0D2A'   22 0000*              	SHLD	WINROW
  0D2D'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0D2E'                         MVROW:
  0D2E'   47                    	MOV	B,A
  0D2F'   CD 0D01'              	CALL	CURRW
  0D32'   90                    	SUB	B		; A = row now - target
  0D33'   C8                    	RZ
  0D34'   DA 0D3D'              	JC	MR_DN
  0D37'   6F                    	MOV	L,A
  0D38'   26 00                 	MVI	H,0
  0D3A'   C3 098C'              	JMP	KCORE
  0D3D'                         MR_DN:
  0D3D'   2F                    	CMA
  0D3E'   3C                    	INR	A		; A = target - row now
  0D3F'   6F                    	MOV	L,A
  0D40'   26 00                 	MVI	H,0
  0D42'   C3 08EF'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D45'                         VC_HIGH:
  0D45'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D48'   2B                    	DCX	H		; row = count - 1
  0D49'   7C                    	MOV	A,H
  0D4A'   B7                    	ORA	A
  0D4B'   3A 0000*              	LDA	SCBOT
  0D4E'   C2 0D56'              	JNZ	VH_GO		; >= 256 -> the last text row
  0D51'   BD                    	CMP	L		; CY iff SCBOT < row
  0D52'   DA 0D56'              	JC	VH_GO
  0D55'   7D                    	MOV	A,L
  0D56'                         VH_GO:
  0D56'   CD 0D2E'              	CALL	MVROW
  0D59'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0D5C'                         VC_MIDL:
  0D5C'   CD 0678'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0D5F'   3A 0000*              	LDA	SCBOT
  0D62'   B7                    	ORA	A		; clear CY for the shift
  0D63'   1F                    	RAR			; A = SCBOT / 2
  0D64'   CD 0D2E'              	CALL	MVROW
  0D67'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0D6A'                         VC_LOWL:
  0D6A'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D6D'   2B                    	DCX	H		; count - 1
  0D6E'   3A 0000*              	LDA	SCBOT
  0D71'   5F                    	MOV	E,A
  0D72'   16 00                 	MVI	D,0
  0D74'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0D75'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0D78'   3E 00                 	MVI	A,0
  0D7A'   D2 0D81'              	JNC	VL_GO		; at or past the top -> row 0
  0D7D'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0D80'   7D                    	MOV	A,L
  0D81'                         VL_GO:
  0D81'   CD 0D2E'              	CALL	MVROW
  0D84'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0D87'                         VC_PGDN:
  0D87'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D8A'   3A 0000*              	LDA	SCEOF
  0D8D'   B7                    	ORA	A
  0D8E'   CA 0D9C'              	JZ	VPD_N
  0D91'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0D94'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0D95'   C8                    	RZ			; it already is
  0D96'   CD 0D2E'              	CALL	MVROW
  0D99'   C3 0DAD'              	JMP	VPD_TP
  0D9C'                         VPD_N:
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0D9C'   3A 0000*              	LDA	NEDIT
  0D9F'   D6 02                 	SUI	2
  0DA1'   CD 0DF5'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0DA4'   E5                    	PUSH	H
  0DA5'   AF                    	XRA	A
  0DA6'   CD 0D2E'              	CALL	MVROW		; the top line
  0DA9'   E1                    	POP	H
  0DAA'   CD 08EF'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0DAD'                         VPD_TP:
  0DAD'   AF                    	XRA	A
  0DAE'   CD 0D20'              	CALL	SETRWT		; to the top row
  0DB1'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0DB4'                         VC_PGUP:
  0DB4'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0DB7'   3A 0000*              	LDA	SCBOF
  0DBA'   B7                    	ORA	A
  0DBB'   C0                    	RNZ
  0DBC'   3A 0000*              	LDA	NEDIT
  0DBF'   47                    	MOV	B,A
  0DC0'   3A 0000*              	LDA	SCEOF
  0DC3'   B7                    	ORA	A
  0DC4'   CA 0DD5'              	JZ	VPU_2
  0DC7'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0DCA'   FE 02                 	CPI	2
  0DCC'   D2 0DD5'              	JNC	VPU_2
  0DCF'   2F                    	CMA
  0DD0'   3C                    	INR	A
  0DD1'   80                    	ADD	B
  0DD2'   C3 0DD8'              	JMP	VPU_P
  0DD5'                         VPU_2:
  0DD5'   78                    	MOV	A,B
  0DD6'   D6 02                 	SUI	2
  0DD8'                         VPU_P:
  0DD8'   CD 0DF5'              	CALL	MULSAT		; HL = count * page
  0DDB'   E5                    	PUSH	H
  0DDC'   AF                    	XRA	A
  0DDD'   CD 0D2E'              	CALL	MVROW		; the top line
  0DE0'   E1                    	POP	H
  0DE1'   CD 098C'              	CALL	KCORE		; the new top line
  0DE4'   AF                    	XRA	A
  0DE5'   CD 0D20'              	CALL	SETRWT		; on the top row
  0DE8'   3A 0000*              	LDA	NEDIT
  0DEB'   3D                    	DCR	A
  0DEC'   6F                    	MOV	L,A
  0DED'   26 00                 	MVI	H,0
  0DEF'   CD 08EF'              	CALL	JCORE		; the bottom row's line
  0DF2'   C3 0834'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0DF5'                         MULSAT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0DF5'   EB                    	XCHG
  0DF6'   21 0000               	LXI	H,0
  0DF9'   B7                    	ORA	A
  0DFA'   C8                    	RZ
  0DFB'                         MS_LP:
  0DFB'   19                    	DAD	D
  0DFC'   DA 0E04'              	JC	MS_SAT
  0DFF'   3D                    	DCR	A
  0E00'   C2 0DFB'              	JNZ	MS_LP
  0E03'   C9                    	RET
  0E04'                         MS_SAT:
  0E04'   21 FFFF               	LXI	H,0FFFFH
  0E07'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0E08'                         VC_HFDN:
  0E08'   CD 075A'              	CALL	SETMOV
  0E0B'   CD 0D01'              	CALL	CURRW
  0E0E'   32 2A25'              	STA	HFROW
  0E11'   CD 0E7F'              	CALL	HFCNT		; HL = lines
  0E14'   3A 2A25'              	LDA	HFROW
  0E17'   47                    	MOV	B,A
  0E18'   3A 0000*              	LDA	SCEOF
  0E1B'   B7                    	ORA	A
  0E1C'   CA 0E24'              	JZ	VHD_GO
  0E1F'   3A 0000*              	LDA	SCBOT		; the last line's row
  0E22'   B8                    	CMP	B
  0E23'   C8                    	RZ			; the cursor is on it
  0E24'                         VHD_GO:
  0E24'   CD 08EF'              	CALL	JCORE
  0E27'   3A 0000*              	LDA	SCEOF
  0E2A'   B7                    	ORA	A
  0E2B'   C2 0834'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0E2E'   3A 2A25'              	LDA	HFROW
  0E31'   CD 0D20'              	CALL	SETRWT
  0E34'   3E 01                 	MVI	A,1
  0E36'   32 0000*              	STA	WFILL		; not past the end of the file
  0E39'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0E3C'                         VC_HFUP:
  0E3C'   CD 075A'              	CALL	SETMOV
  0E3F'   CD 0D01'              	CALL	CURRW
  0E42'   32 2A25'              	STA	HFROW
  0E45'   CD 0E7F'              	CALL	HFCNT		; HL = lines
  0E48'   CD 0E5F'              	CALL	ONFST
  0E4B'   C8                    	RZ			; the cursor is on the first line
  0E4C'   CD 098C'              	CALL	KCORE
  0E4F'   3A 0000*              	LDA	SCBOF
  0E52'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E53'   C2 0834'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0E56'   3A 2A25'              	LDA	HFROW
  0E59'   CD 0D20'              	CALL	SETRWT
  0E5C'   C3 0834'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0E5F'                         ONFST:
  0E5F'   E5                    	PUSH	H
  0E60'   2A 0000*              	LHLD	OUTPOS
  0E63'   7C                    	MOV	A,H
  0E64'   B5                    	ORA	L
  0E65'   C2 0E7D'              	JNZ	OF_RET
  0E68'   2A 0000*              	LHLD	TXTBEG
  0E6B'   EB                    	XCHG			; DE = TXTBEG
  0E6C'   2A 0000*              	LHLD	GAPBEG
  0E6F'                         OF_LP:
  0E6F'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0E72'   CA 0E7D'              	JZ	OF_RET
  0E75'   2B                    	DCX	H
  0E76'   7E                    	MOV	A,M
  0E77'   FE 0A                 	CPI	LF
  0E79'   C2 0E6F'              	JNZ	OF_LP
  0E7C'   B7                    	ORA	A		; NZ
  0E7D'                         OF_RET:
  0E7D'   E1                    	POP	H
  0E7E'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0E7F'                         HFCNT:
  0E7F'   2A 2A19'              	LHLD	CMDCNT
  0E82'   7C                    	MOV	A,H
  0E83'   B5                    	ORA	L
  0E84'   CA 0E9B'              	JZ	HFC_AM
  0E87'   CD 068B'              	CALL	GETCNT		; HL = count; clears it
  0E8A'   3A 0000*              	LDA	NEDIT
  0E8D'   5F                    	MOV	E,A
  0E8E'   16 00                 	MVI	D,0
  0E90'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0E93'   D2 0E97'              	JNC	HFC_ST
  0E96'   EB                    	XCHG			; HL = NEDIT
  0E97'                         HFC_ST:
  0E97'   7D                    	MOV	A,L
  0E98'   32 2A26'              	STA	HFAMT
  0E9B'                         HFC_AM:
  0E9B'   3A 2A26'              	LDA	HFAMT
  0E9E'   B7                    	ORA	A
  0E9F'   C2 0EAC'              	JNZ	HFC_HL
  0EA2'   3A 0000*              	LDA	NEDIT
  0EA5'   B7                    	ORA	A
  0EA6'   1F                    	RAR
  0EA7'   B7                    	ORA	A
  0EA8'   C2 0EAC'              	JNZ	HFC_HL
  0EAB'   3C                    	INR	A		; at least one line
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0EAC'                         HFC_HL:
  0EAC'   6F                    	MOV	L,A
  0EAD'   26 00                 	MVI	H,0
  0EAF'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0EB0'                         VC_REDR:
  0EB0'   C3 068B'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0EB3'                         VC_G:
  0EB3'   CD 075A'              	CALL	SETMOV
  0EB6'   CD 0F75'              	CALL	GZONE		; the screen's top line, before the move
  0EB9'   CD 06B4'              	CALL	BRKON		; ... and a ^C may stop it from here on
  0EBC'   2A 2A19'              	LHLD	CMDCNT
  0EBF'   7C                    	MOV	A,H
  0EC0'   B5                    	ORA	L
  0EC1'   C2 0ED4'              	JNZ	VG_N
  0EC4'   AF                    	XRA	A		; forward
  0EC5'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0EC8'   CD 06EB'              	CALL	BRKOFF
  0ECB'   DA 0703'              	JC	BRKBAK
  0ECE'   CD 0A23'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0ED1'   C3 0F8D'              	JMP	GPLACE
  0ED4'                         VG_N:
  0ED4'   CD 068B'              	CALL	GETCNT		; HL = target line (1-based)
  0ED7'                         VG_LN:
  0ED7'   CD 0EE3'              	CALL	GOLN
  0EDA'   CD 06EB'              	CALL	BRKOFF
  0EDD'   DA 0703'              	JC	BRKBAK
  0EE0'   C3 0F8D'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  0EE3'                         GOLN:
  0EE3'   E5                    	PUSH	H
  0EE4'   CD 0000*              	CALL	CNTLF
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0EE7'   23                    	INX	H		; HL = the cursor's line
  0EE8'   D1                    	POP	D		; DE = the line wanted
  0EE9'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  0EEC'   DA 0EF7'              	JC	GLN_BK
  0EEF'   EB                    	XCHG
  0EF0'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  0EF3'   AF                    	XRA	A
  0EF4'   C3 0EFC'              	JMP	GLN_MV
  0EF7'                         GLN_BK:
  0EF7'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  0EFA'   3E FF                 	MVI	A,0FFH
  0EFC'                         GLN_MV:
  0EFC'   CD 0000*              	CALL	MVLIND
  0EFF'   CD 0A1D'              	CALL	ATEOF
  0F02'   DC 0A23'              	CC	LASTLN		; past the last line: onto it
  0F05'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0F06'                         VC_LG:
  0F06'   CD 075A'              	CALL	SETMOV
  0F09'   3A 2A41'              	LDA	GSAVE
  0F0C'   B7                    	ORA	A
  0F0D'   C2 0F16'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0F10'   3E 01                 	MVI	A,PG
  0F12'   32 2A40'              	STA	GPEND
  0F15'   C9                    	RET
  0F16'                         VLG_GG:
  0F16'   CD 0F75'              	CALL	GZONE
  0F19'   CD 06B4'              	CALL	BRKON
  0F1C'   CD 068B'              	CALL	GETCNT		; HL = target line (no count: 1)
  0F1F'   C3 0ED7'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0F22'                         SUB24:
  0F22'   4F                    	MOV	C,A
  0F23'   7D                    	MOV	A,L
  0F24'   93                    	SUB	E
  0F25'   6F                    	MOV	L,A
  0F26'   7C                    	MOV	A,H
  0F27'   9A                    	SBB	D
  0F28'   67                    	MOV	H,A
  0F29'   79                    	MOV	A,C
  0F2A'   98                    	SBB	B
  0F2B'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0F2C'                         CURFP:
  0F2C'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0F2F'                         FPOS:
  0F2F'   C5                    	PUSH	B
  0F30'   D5                    	PUSH	D
  0F31'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F32'   2A 0000*              	LHLD	TXTBEG
  0F35'   EB                    	XCHG
  0F36'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0F39'   EB                    	XCHG			; DE = that
  0F3A'   2A 0000*              	LHLD	OUTPOS
  0F3D'   7C                    	MOV	A,H
  0F3E'   B7                    	ORA	A		; CY = 0
  0F3F'   1F                    	RAR
  0F40'   47                    	MOV	B,A
  0F41'   7D                    	MOV	A,L
  0F42'   1F                    	RAR
  0F43'   67                    	MOV	H,A
  0F44'   3E 00                 	MVI	A,0
  0F46'   1F                    	RAR
  0F47'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0F48'   19                    	DAD	D
  0F49'   78                    	MOV	A,B
  0F4A'   CE 00                 	ACI	0		; A:HL = the position
  0F4C'   D1                    	POP	D
  0F4D'   C1                    	POP	B
  0F4E'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0F4F'                         ZSAVE:
  0F4F'   2A 2A19'              	LHLD	CMDCNT
  0F52'   22 2A7F'              	SHLD	ZSVCNT
  0F55'   2A 0000*              	LHLD	AUXCNT
  0F58'   22 2A81'              	SHLD	ZSVAUX
  0F5B'   3A 0000*              	LDA	DIRFLG
  0F5E'   32 2A83'              	STA	ZSVDIR
  0F61'   C9                    	RET
  0F62'                         ZREST:
  0F62'   2A 2A7F'              	LHLD	ZSVCNT
  0F65'   22 2A19'              	SHLD	CMDCNT
  0F68'   2A 2A81'              	LHLD	ZSVAUX
  0F6B'   22 0000*              	SHLD	AUXCNT
  0F6E'   3A 2A83'              	LDA	ZSVDIR
  0F71'   32 0000*              	STA	DIRFLG
  0F74'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0F75'                         GZONE:
  0F75'   CD 0F4F'              	CALL	ZSAVE
  0F78'   CD 0D01'              	CALL	CURRW
  0F7B'   6F                    	MOV	L,A
  0F7C'   26 00                 	MVI	H,0
  0F7E'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0F81'   CD 0F2F'              	CALL	FPOS
  0F84'   22 0000*              	SHLD	ZTOP
  0F87'   32 0002*              	STA	ZTOP+2
  0F8A'   C3 0F62'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F8D'                         GPLACE:
  0F8D'   CD 0F4F'              	CALL	ZSAVE
  0F90'   CD 0F2C'              	CALL	CURFP
  0F93'   EB                    	XCHG
  0F94'   2A 0000*              	LHLD	ZTOP
  0F97'   EB                    	XCHG
  0F98'   4F                    	MOV	C,A		; C:HL = the target's position
  0F99'   3A 0002*              	LDA	ZTOP+2
  0F9C'   47                    	MOV	B,A		; B:DE = the top's
  0F9D'   79                    	MOV	A,C
  0F9E'   CD 0F22'              	CALL	SUB24
  0FA1'   22 2A7C'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  0FA4'   DA 0FF1'              	JC	GP_UP
  0FA7'   B7                    	ORA	A
  0FA8'   C2 1032'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0FAB'   3A 0000*              	LDA	NEDIT
  0FAE'   5F                    	MOV	E,A
  0FAF'   16 00                 	MVI	D,0
  0FB1'   B7                    	ORA	A
  0FB2'   1F                    	RAR
  0FB3'   6F                    	MOV	L,A
  0FB4'   26 00                 	MVI	H,0
  0FB6'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0FB7'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0FBA'   CD 0684'              	CALL	GBSUB		; HL = bytes from there to the target
  0FBD'   EB                    	XCHG
  0FBE'   2A 2A7C'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0FC1'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0FC4'   DA 1032'              	JC	GP_MID
  0FC7'   CD 0684'              	CALL	GBSUB		; HL = the top line's start (resident)
  0FCA'   01 0000               	LXI	B,0		; BC = lines from the top
  0FCD'                         GP_CNT:
  0FCD'   7A                    	MOV	A,D
  0FCE'   B3                    	ORA	E
  0FCF'   CA 0FDE'              	JZ	GP_DN
  0FD2'   7E                    	MOV	A,M
  0FD3'   23                    	INX	H
  0FD4'   1B                    	DCX	D
  0FD5'   FE 0A                 	CPI	LF
  0FD7'   C2 0FCD'              	JNZ	GP_CNT
  0FDA'   03                    	INX	B
  0FDB'   C3 0FCD'              	JMP	GP_CNT
  0FDE'                         GP_DN:
  0FDE'   3A 0000*              	LDA	NEDIT
  0FE1'   3D                    	DCR	A
  0FE2'   5F                    	MOV	E,A
  0FE3'   16 00                 	MVI	D,0		; DE = the bottom row
  0FE5'   60                    	MOV	H,B
  0FE6'   69                    	MOV	L,C
  0FE7'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0FEA'   DA 103C'              	JC	GP_SET		; A = the bottom row
  0FED'   7D                    	MOV	A,L		; on the screen: its row
  0FEE'   C3 105C'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0FF1'                         GP_UP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FF1'   3C                    	INR	A
  0FF2'   C2 1032'              	JNZ	GP_MID		; 64K bytes or more above
  0FF5'   2A 2A7C'              	LHLD	ZDIF
  0FF8'   EB                    	XCHG
  0FF9'   21 0000               	LXI	H,0
  0FFC'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0FFF'   7C                    	MOV	A,H
  1000'   B5                    	ORA	L
  1001'   CA 1032'              	JZ	GP_MID		; exactly 64K
  1004'   EB                    	XCHG			; DE = bytes to read
  1005'   AF                    	XRA	A
  1006'   32 2A7E'              	STA	ZLF
  1009'   CD 0000*              	CALL	RGET0
  100C'                         GP_RD:
  100C'   CD 0000*              	CALL	RDGET		; (keeps DE)
  100F'   DA 1032'              	JC	GP_MID
  1012'   FE 0A                 	CPI	LF
  1014'   C2 1028'              	JNZ	GP_RN
  1017'   3A 0000*              	LDA	NEDIT
  101A'   B7                    	ORA	A
  101B'   1F                    	RAR
  101C'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  101E'   E5                    	PUSH	H
  101F'   21 2A7E'              	LXI	H,ZLF
  1022'   34                    	INR	M
  1023'   BE                    	CMP	M		; CY iff more lines than that
  1024'   E1                    	POP	H
  1025'   DA 1032'              	JC	GP_MID
  1028'                         GP_RN:
  1028'   1B                    	DCX	D
  1029'   7A                    	MOV	A,D
  102A'   B3                    	ORA	E
  102B'   C2 100C'              	JNZ	GP_RD
  102E'   AF                    	XRA	A		; the top row
  102F'   C3 103C'              	JMP	GP_SET
  1032'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  1032'   3E 01                 	MVI	A,1
  1034'   32 0000*              	STA	WFILL		; not past the end of the file
  1037'   3A 0000*              	LDA	NEDIT
  103A'   B7                    	ORA	A
  103B'   1F                    	RAR			; the middle row
  103C'                         GP_SET:
  103C'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  103D'   26 00                 	MVI	H,0
  103F'   22 0000*              	SHLD	WINROW
  1042'   21 0000               	LXI	H,0
  1045'   22 0000*              	SHLD	LNDLT
  1048'   CD 077B'              	CALL	SETFUL		; the window may have paged: full repaint
  104B'                         GP_FIN:
  104B'   CD 0F62'              	CALL	ZREST
  104E'   3A 2AA6'              	LDA	GPKEEP
  1051'   B7                    	ORA	A
  1052'   CA 0834'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  1055'   AF                    	XRA	A
  1056'   32 2AA6'              	STA	GPKEEP
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  1059'   C3 057D'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  105C'                         GP_ONS:
  105C'   6F                    	MOV	L,A
  105D'   26 00                 	MVI	H,0		; HL = the row it lands on
  105F'   EB                    	XCHG
  1060'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  1063'   EB                    	XCHG
  1064'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  1067'   22 0000*              	SHLD	LNDLT
  106A'   3E 01                 	MVI	A,R_MOVE
  106C'   32 2A1D'              	STA	RINTENT
  106F'   C3 104B'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  1072'                         OPPEND:
  1072'   AF                    	XRA	A
  1073'   32 2A46'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  1076'   3A 2A43'              	LDA	PSAVE
  1079'   FE 63                 	CPI	'c'
  107B'   C2 1098'              	JNZ	OPP_ND
  107E'   79                    	MOV	A,C
  107F'   FE 77                 	CPI	'w'
  1081'   CA 1089'              	JZ	OPP_W
  1084'   FE 57                 	CPI	'W'
  1086'   C2 1098'              	JNZ	OPP_ND
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  1089'                         OPP_W:
  1089'   CD 126B'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  108C'   DA 1098'              	JC	OPP_ND
  108F'   79                    	MOV	A,C
  1090'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  1092'   4F                    	MOV	C,A
  1093'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  1095'   32 2A46'              	STA	CWEOL		;   char for the next word's: see ESTEP
  1098'                         OPP_ND:
  1098'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  1099'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  109B'   C2 10AF'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  109E'   CD 021C'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  10A1'   DA 113F'              	JC	OPABRT
  10A4'   79                    	MOV	A,C
  10A5'   FE 67                 	CPI	'g'
  10A7'   C2 113F'              	JNZ	OPABRT
  10AA'   3E 01                 	MVI	A,PG
  10AC'   32 2A41'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  10AF'                         OPP_NG:
  10AF'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  10B0'   21 2A43'              	LXI	H,PSAVE
  10B3'   BE                    	CMP	M
  10B4'   CA 128C'              	JZ	OPLINE
  10B7'   79                    	MOV	A,C		; (OPCLS classifies the key)
  10B8'   CD 12A2'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  10BB'   DA 113F'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  10BE'   32 2A45'              	STA	OPCLSV
  10C1'   47                    	MOV	B,A		; B = the class
  10C2'   3A 2A43'              	LDA	PSAVE
  10C5'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  10C7'   C2 10D3'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  10CA'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  10CB'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  10CD'   C2 10F5'              	JNZ	OPP_GO
  10D0'   C3 10DE'              	JMP	OPP_NO
  10D3'                         OPP_NC:
  10D3'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  10D5'   C2 10F5'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  10D8'   78                    	MOV	A,B		;   a charwise register would need a type flag
  10D9'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  10DB'   CA 10F5'              	JZ	OPP_GO		;   within a line -- neither of which is built
  10DE'                         OPP_NO:
  10DE'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  10DF'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  10E1'   CA 10EF'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  10E4'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  10E6'   CA 10EF'              	JZ	OPP_SW		;   so swallow it before dropping the command
  10E9'   CD 034C'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  10EC'   C2 113F'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  10EF'                         OPP_SW:
  10EF'   CD 021C'              	CALL	MKGETK
  10F2'   C3 113F'              	JMP	OPABRT
  10F5'                         OPP_GO:
  10F5'   AF                    	XRA	A
  10F6'   32 2A24'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  10F9'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  10FC'   22 2A47'              	SHLD	OPSTA
  10FF'   C5                    	PUSH	B
  1100'   21 2A4B'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  1103'   CD 044F'              	CALL	FPSTO		;   only good until the motion pages the window
  1106'   3A 2A45'              	LDA	OPCLSV
  1109'   FE 02                 	CPI	2
  110B'   CC 1142'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  110E'   C1                    	POP	B
  110F'   21 2947'              	LXI	H,CMDTAB
  1112'   CD 00C9'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1115'   3A 2A43'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1118'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1119'   CA 075A'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  111C'   CD 116E'              	CALL	OPSFIX		; where the start is in the window NOW
  111F'   D2 118A'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  1122'   22 2A47'              	SHLD	OPSTA
  1125'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1128'   22 2A49'              	SHLD	OPEND2
  112B'   3A 2A43'              	LDA	PSAVE
  112E'   FE 79                 	CPI	'y'
  1130'   CA 17C7'              	JZ	OPYANK		; a yank takes the span without losing it
  1133'   CD 12DD'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  1136'   3A 2A43'              	LDA	PSAVE
  1139'   FE 63                 	CPI	'c'
  113B'   C0                    	RNZ
  113C'   C3 1583'              	JMP	SETINS
  113F'                         OPABRT:				; not a motion -> the operator is dropped and
  113F'   C3 00A9'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  1142'                         OPENDS:
  1142'   2A 2A47'              	LHLD	OPSTA
  1145'   CD 05E4'              	CALL	BOL
  1148'   11 2A4E'              	LXI	D,OPSLO
  114B'   CD 1160'              	CALL	OPE_ST
  114E'   2A 2A47'              	LHLD	OPSTA
  1151'   CD 0614'              	CALL	NLSTART
  1154'   11 2A51'              	LXI	D,OPSHI
  1157'   CD 1160'              	CALL	OPE_ST
  115A'   2A 2A47'              	LHLD	OPSTA
  115D'   C3 0000*              	JMP	GOTO
  1160'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  1160'   D5                    	PUSH	D
  1161'   CD 0000*              	CALL	GOTO
  1164'   E1                    	POP	H
  1165'   C3 044F'              	JMP	FPSTO
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  1168'                         CURBD:
  1168'   CD 0F2C'              	CALL	CURFP
  116B'   EB                    	XCHG
  116C'   47                    	MOV	B,A
  116D'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  116E'                         OPSFIX:
  116E'   21 2A4B'              	LXI	H,OPSFP
  1171'   CD 0402'              	CALL	MKLOAD
  1174'   CD 1168'              	CALL	CURBD
  1177'   2A 2AB0'              	LHLD	MKPOS
  117A'   3A 2AB2'              	LDA	MKPOS+2
  117D'   CD 0F22'              	CALL	SUB24
  1180'   B4                    	ORA	H
  1181'   B5                    	ORA	L
  1182'   C2 040F'              	JNZ	MKWIN
  1185'   CD 0000*              	CALL	CUROFF
  1188'   37                    	STC
  1189'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  118A'                         OPPGD:
  118A'   47                    	MOV	B,A
  118B'   3A 2A45'              	LDA	OPCLSV
  118E'   FE 02                 	CPI	2
  1190'   C2 124C'              	JNZ	OPG_NO
  1193'   3A 2A43'              	LDA	PSAVE
  1196'   FE 64                 	CPI	'd'
  1198'   C2 124C'              	JNZ	OPG_NO
  119B'   04                    	INR	B
  119C'   CA 11AB'              	JZ	OPG_FW
  119F'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  11A2'   CD 05E4'              	CALL	BOL		;   and the high end is OPSHI as it stands
  11A5'   CD 0000*              	CALL	GOTO
  11A8'   C3 11C3'              	JMP	OPG_GO
  11AB'                         OPG_FW:
  11AB'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  11AE'   CD 0614'              	CALL	NLSTART		;   landed on, and the low one is where the
  11B1'   11 2A51'              	LXI	D,OPSHI		;   start line began
  11B4'   CD 1160'              	CALL	OPE_ST
  11B7'   21 2A4E'              	LXI	H,OPSLO
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  11BA'   CD 0402'              	CALL	MKLOAD
  11BD'   CD 03CF'              	CALL	MKPAGE
  11C0'   CD 0000*              	CALL	GOTO
  11C3'                         OPG_GO:
  11C3'   CD 1168'              	CALL	CURBD
  11C6'   2A 2A51'              	LHLD	OPSHI
  11C9'   3A 2A53'              	LDA	OPSHI+2
  11CC'   CD 0F22'              	CALL	SUB24		; A:HL = the bytes to take
  11CF'                         OPG_SV:
  11CF'   22 2A54'              	SHLD	OPTOGO
  11D2'   32 2A56'              	STA	OPTOGO+2
  11D5'                         OPG_NX:
  11D5'   CD 0667'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  11D8'   CD 0000*              	CALL	SUBHD
  11DB'   EB                    	XCHG			; DE = what the window holds past the cursor
  11DC'   2A 2A54'              	LHLD	OPTOGO
  11DF'   3A 2A56'              	LDA	OPTOGO+2
  11E2'   B7                    	ORA	A
  11E3'   C2 1216'              	JNZ	OPG_PG		; 64K or more to go
  11E6'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  11E9'   DA 1216'              	JC	OPG_PG
  11EC'   CA 1216'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  11EF'                         OPG_FN:				; the rest of it is here
  11EF'   E5                    	PUSH	H
  11F0'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  11F3'   CD 0000*              	CALL	CUROFF
  11F6'   22 2A57'              	SHLD	OPLO
  11F9'   D1                    	POP	D
  11FA'   19                    	DAD	D
  11FB'   22 2A59'              	SHLD	OPHI
  11FE'   CD 140D'              	CALL	OPDSPN
  1201'   CD 0A1D'              	CALL	ATEOF
  1204'   D2 1265'              	JNC	OPMID
  1207'   CD 0E5F'              	CALL	ONFST		; deleted to the end of the file: onto the new
  120A'   CA 1265'              	JZ	OPMID		;   last line, if there is one -- and the pager
  120D'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  1210'   CD 0000*              	CALL	SETBWD
  1213'   C3 1265'              	JMP	OPMID
  1216'                         OPG_PG:
  1216'   7A                    	MOV	A,D
  1217'   B3                    	ORA	E
  1218'   C2 1231'              	JNZ	OPG_DL
  121B'   CD 0A1D'              	CALL	ATEOF		; nothing held past the cursor
  121E'   21 0000               	LXI	H,0
  1221'   DA 11EF'              	JC	OPG_FN		; ... and no more to come: the file ran out
  1224'   2B                    	DCX	H
  1225'   CD 0000*              	CALL	SETC0
  1228'   CD 0000*              	CALL	GOLINE
  122B'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  122E'   C3 11D5'              	JMP	OPG_NX
  1231'                         OPG_DL:
  1231'   D5                    	PUSH	D
  1232'   21 FFFF               	LXI	H,0FFFFH
  1235'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1238'   E1                    	POP	H
  1239'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  123A'   CD 0000*              	CALL	DELFWD
  123D'   D1                    	POP	D
  123E'   06 00                 	MVI	B,0
  1240'   2A 2A54'              	LHLD	OPTOGO
  1243'   3A 2A56'              	LDA	OPTOGO+2
  1246'   CD 0F22'              	CALL	SUB24
  1249'   C3 11CF'              	JMP	OPG_SV
  124C'                         OPG_NO:
  124C'   0E 07                 	MVI	C,BEL
  124E'   CD 0000*              	CALL	BCONOU
  1251'                         OPG_HM:				; the cursor back where the command found it
  1251'   21 2A4B'              	LXI	H,OPSFP
  1254'   CD 0402'              	CALL	MKLOAD
  1257'   CD 03CF'              	CALL	MKPAGE
  125A'   CD 0000*              	CALL	GOTO
  125D'   AF                    	XRA	A
  125E'   32 2A43'              	STA	PSAVE
  1261'   3C                    	INR	A
  1262'   32 2AA6'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  1265'                         OPMID:
  1265'   CD 0F4F'              	CALL	ZSAVE
  1268'   C3 1032'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  126B'                         ONWHIT:
  126B'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  126E'   CA 128A'              	JZ	OW_YES
  1271'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  1274'   FE 20                 	CPI	' '
  1276'   CA 128A'              	JZ	OW_YES
  1279'   FE 09                 	CPI	TAB
  127B'   CA 128A'              	JZ	OW_YES
  127E'   FE 0D                 	CPI	CR
  1280'   CA 128A'              	JZ	OW_YES
  1283'   FE 0A                 	CPI	LF
  1285'   CA 128A'              	JZ	OW_YES
  1288'   B7                    	ORA	A		; a char to change: CY clear
  1289'   C9                    	RET
  128A'                         OW_YES:
  128A'   37                    	STC
  128B'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  128C'                         OPLINE:
  128C'   3A 2A43'              	LDA	PSAVE
  128F'   FE 63                 	CPI	'c'
  1291'   CA 075A'              	JZ	SETMOV
  1294'   FE 79                 	CPI	'y'
  1296'   CA 17A6'              	JZ	VY_YY
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  1299'   21 2A4B'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  129C'   CD 044F'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  129F'   C3 171F'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  12A2'                         OPCLS:
  12A2'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  12A4'   CA 12B1'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  12A7'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  12A9'   C2 12C5'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  12AC'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  12AE'   C3 12B3'              	JMP	OPC_FK
  12B1'                         OPC_SEM:
  12B1'   06 00                 	MVI	B,0		; ';' runs it as it stands
  12B3'                         OPC_FK:
  12B3'   3A 2A9C'              	LDA	FNDKND
  12B6'   B7                    	ORA	A
  12B7'   37                    	STC
  12B8'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  12B9'   A8                    	XRA	B		; ... and now the direction ',' asked for
  12BA'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  12BC'   CA 12C3'              	JZ	OPC_EXC
  12BF'   3E 01                 	MVI	A,1
  12C1'   B7                    	ORA	A		; CY clear: a motion, class 1
  12C2'   C9                    	RET
  12C3'                         OPC_EXC:
  12C3'   AF                    	XRA	A		; class 0, CY clear
  12C4'   C9                    	RET
  12C5'                         OPC_TB:
  12C5'   47                    	MOV	B,A
  12C6'   21 1477'              	LXI	H,OPCTAB
  12C9'                         OPC_LP:
  12C9'   7E                    	MOV	A,M
  12CA'   B7                    	ORA	A
  12CB'   CA 12DB'              	JZ	OPC_MS		; end of table -> not a motion
  12CE'   B8                    	CMP	B
  12CF'   CA 12D7'              	JZ	OPC_HT
  12D2'   23                    	INX	H
  12D3'   23                    	INX	H
  12D4'   C3 12C9'              	JMP	OPC_LP
  12D7'                         OPC_HT:
  12D7'   23                    	INX	H
  12D8'   7E                    	MOV	A,M		; class byte
  12D9'   B7                    	ORA	A		; clear CY
  12DA'   C9                    	RET
  12DB'                         OPC_MS:
  12DB'   37                    	STC
  12DC'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  12DD'                         OPAPPL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  12DD'   3A 2A45'              	LDA	OPCLSV
  12E0'   FE 02                 	CPI	2
  12E2'   CA 145B'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  12E5'   2A 2A47'              	LHLD	OPSTA
  12E8'   EB                    	XCHG			; DE = start
  12E9'   2A 2A49'              	LHLD	OPEND2		; HL = end
  12EC'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  12EF'   DA 12FF'              	JC	OPA_F
  12F2'   CA 12FF'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  12F5'   22 2A57'              	SHLD	OPLO
  12F8'   EB                    	XCHG
  12F9'   22 2A59'              	SHLD	OPHI
  12FC'   C3 13B6'              	JMP	OPA_C1
  12FF'                         OPA_F:
  12FF'   EB                    	XCHG			; HL = start, DE = end
  1300'   22 2A57'              	SHLD	OPLO
  1303'   EB                    	XCHG			; HL = end
  1304'   3A 2A45'              	LDA	OPCLSV
  1307'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1309'   CA 13B3'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  130C'   FE 01                 	CPI	1
  130E'   C2 1330'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  1311'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  1312'   22 2A59'              	SHLD	OPHI		; park it: CEND clobbers DE
  1315'   2B                    	DCX	H		; the line it landed on
  1316'   CD 1501'              	CALL	CEND		; HL = that line's content end
  1319'   EB                    	XCHG			; DE = it
  131A'   2A 2A59'              	LHLD	OPHI		; HL = hi
  131D'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  1320'   D2 133B'              	JNC	OPA_HI		; hi is inside the line: keep it
  1323'   2A 2A57'              	LHLD	OPLO
  1326'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1329'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  132C'   EB                    	XCHG			; HL = the content end: the span stops there
  132D'   C3 133B'              	JMP	OPA_HI
  1330'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  1330'   22 2A59'              	SHLD	OPHI
  1333'   3A 2A24'              	LDA	WPULL
  1336'   B7                    	ORA	A
  1337'   CA 13B6'              	JZ	OPA_C1
  133A'   23                    	INX	H
  133B'                         OPA_HI:
  133B'   22 2A59'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  133E'                         OPA_DO:
  133E'   CD 1402'              	CALL	OPSPNL
  1341'   7C                    	MOV	A,H
  1342'   B5                    	ORA	L
  1343'   C2 134C'              	JNZ	OPA_D1
  1346'   2A 2A57'              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  1349'   C3 0000*              	JMP	GOTO		;   to where the span starts
  134C'                         OPA_D1:
  134C'   3A 2A43'              	LDA	PSAVE
  134F'   FE 63                 	CPI	'c'
  1351'   CA 140D'              	JZ	OPDSPN
  1354'   CD 13F5'              	CALL	SPNBRK
  1357'   D2 1378'              	JNC	OPA_D2
  135A'   2A 2A59'              	LHLD	OPHI
  135D'   CD 1501'              	CALL	CEND
  1360'   EB                    	XCHG			; DE = the content end of the line it ends in
  1361'   2A 2A59'              	LHLD	OPHI
  1364'                         OPA_BL:
  1364'   CD 0000*              	CALL	CMP16
  1367'   CA 137E'              	JZ	OPA_BI		; only blanks after it
  136A'   D5                    	PUSH	D
  136B'   E5                    	PUSH	H
  136C'   CD 0000*              	CALL	CHARAT
  136F'   E1                    	POP	H
  1370'   D1                    	POP	D
  1371'   23                    	INX	H
  1372'   CD 13AD'              	CALL	BLANKQ
  1375'   CA 1364'              	JZ	OPA_BL
  1378'                         OPA_D2:
  1378'   CD 140D'              	CALL	OPDSPN
  137B'   C3 1512'              	JMP	CLAMPE
  137E'                         OPA_BI:
  137E'   CD 1390'              	CALL	LOIND
  1381'   C2 1378'              	JNZ	OPA_D2
  1384'   2A 2A59'              	LHLD	OPHI
  1387'   CD 0614'              	CALL	NLSTART
  138A'   22 2A59'              	SHLD	OPHI
  138D'   C3 13E1'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  1390'                         LOIND:
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  1390'   2A 2A57'              	LHLD	OPLO
  1393'   CD 05E4'              	CALL	BOL
  1396'                         LI_LP:
  1396'   E5                    	PUSH	H
  1397'   EB                    	XCHG
  1398'   2A 2A57'              	LHLD	OPLO
  139B'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  139E'   E1                    	POP	H
  139F'   C8                    	RZ
  13A0'   E5                    	PUSH	H
  13A1'   CD 0000*              	CALL	CHARAT
  13A4'   E1                    	POP	H
  13A5'   23                    	INX	H
  13A6'   CD 13AD'              	CALL	BLANKQ
  13A9'   CA 1396'              	JZ	LI_LP
  13AC'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  13AD'                         BLANKQ:
  13AD'   FE 20                 	CPI	' '
  13AF'   C8                    	RZ
  13B0'   FE 09                 	CPI	TAB
  13B2'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  13B3'                         OPA_JP:
  13B3'   22 2A59'              	SHLD	OPHI
  13B6'                         OPA_C1:
  13B6'   CD 1402'              	CALL	OPSPNL
  13B9'   7C                    	MOV	A,H
  13BA'   B5                    	ORA	L
  13BB'   CA 133E'              	JZ	OPA_DO		; nothing spanned
  13BE'   2A 2A59'              	LHLD	OPHI
  13C1'   CD 05E4'              	CALL	BOL
  13C4'   EB                    	XCHG
  13C5'   2A 2A59'              	LHLD	OPHI
  13C8'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  13CB'   C2 133E'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  13CE'   CD 1390'              	CALL	LOIND
  13D1'   CA 13E1'              	JZ	C1_LW		; only blanks before lo: whole lines
  13D4'                         C1_CH:
  13D4'   2A 2A59'              	LHLD	OPHI		; back over the line break to the content end
  13D7'   2B                    	DCX	H		;   of the line before
  13D8'   CD 1501'              	CALL	CEND
  13DB'   22 2A59'              	SHLD	OPHI
  13DE'   C3 133E'              	JMP	OPA_DO
  13E1'                         C1_LW:
  13E1'   2A 2A57'              	LHLD	OPLO
  13E4'   CD 05E4'              	CALL	BOL
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  13E7'   22 2A57'              	SHLD	OPLO
  13EA'   3A 2A43'              	LDA	PSAVE
  13ED'   FE 63                 	CPI	'c'
  13EF'   CA 13D4'              	JZ	C1_CH
  13F2'   C3 145E'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  13F5'                         SPNBRK:
  13F5'   2A 2A57'              	LHLD	OPLO
  13F8'   CD 05F7'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  13FB'   EB                    	XCHG			; DE = it
  13FC'   2A 2A59'              	LHLD	OPHI
  13FF'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  1402'                         OPSPNL:
  1402'   2A 2A59'              	LHLD	OPHI
  1405'   EB                    	XCHG
  1406'   2A 2A57'              	LHLD	OPLO
  1409'   EB                    	XCHG			; HL = hi, DE = lo
  140A'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  140D'                         OPDSPN:
  140D'   CD 13F5'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  1410'   F5                    	PUSH	PSW
  1411'   2A 2A57'              	LHLD	OPLO
  1414'   CD 0000*              	CALL	GOTO
  1417'   CD 1402'              	CALL	OPSPNL		; HL = hi - lo
  141A'   CD 0000*              	CALL	DELFWD
  141D'   CD 018C'              	CALL	MARKMOD
  1420'   F1                    	POP	PSW
  1421'   DA 077B'              	JC	SETFUL		; a break went: every row below it moved up
  1424'   C3 0760'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  1427'                         OPALSP:
  1427'   2A 2A47'              	LHLD	OPSTA
  142A'   EB                    	XCHG
  142B'   2A 2A49'              	LHLD	OPEND2
  142E'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  1431'   DA 143E'              	JC	OPAL_F
  1434'   22 2A57'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1437'   EB                    	XCHG
  1438'   22 2A59'              	SHLD	OPHI		; hi-src = start
  143B'   C3 1448'              	JMP	OPAL_R
  143E'                         OPAL_F:
  143E'   EB                    	XCHG			; HL = start
  143F'   22 2A57'              	SHLD	OPLO		; lo-src = start
  1442'   2A 2A49'              	LHLD	OPEND2
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  1445'   22 2A59'              	SHLD	OPHI		; hi-src = end
  1448'                         OPAL_R:
  1448'   2A 2A57'              	LHLD	OPLO
  144B'   CD 05E4'              	CALL	BOL
  144E'   22 2A57'              	SHLD	OPLO		; lo = BOL(low line)
  1451'   2A 2A59'              	LHLD	OPHI
  1454'   CD 0614'              	CALL	NLSTART
  1457'   22 2A59'              	SHLD	OPHI		; hi = start of line past the high line
  145A'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  145B'                         OPALIN:
  145B'   CD 1427'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  145E'                         OPDLIN:
  145E'   CD 140D'              	CALL	OPDSPN
  1461'   CD 0667'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1464'   DA 1474'              	JC	OPDL_NB
  1467'   CD 0000*              	CALL	LOGLEN
  146A'   7C                    	MOV	A,H
  146B'   B5                    	ORA	L
  146C'   C8                    	RZ			; empty buffer
  146D'   2B                    	DCX	H
  146E'   CD 05E4'              	CALL	BOL
  1471'   CD 0000*              	CALL	GOTO
  1474'                         OPDL_NB:
  1474'   C3 0834'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1477'                         OPCTAB:
  1477'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  147B'   62 00 42 00           
  147F'   68 00 6C 00           
  1483'   30 00 5E 00           
  1487'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1489'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  148D'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1491'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


                                				;   these two only have to be IN the table
  1495'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1499'   24 01                 
  149B'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  149F'   47 02 48 02           
  14A3'   4D 02 4C 02           
  14A7'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  14A9'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  14AB'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  14AC'                         VCB_C:
  14AC'   CD 14B8'              	CALL	VCB_CD
  14AF'   C3 1583'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  14B2'                         VCB_D:
  14B2'   CD 14B8'              	CALL	VCB_CD
  14B5'   C3 1512'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  14B8'                         VCB_CD:
  14B8'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  14BB'   22 2A57'              	SHLD	OPLO
  14BE'   CD 0000*              	CALL	CUROFF
  14C1'   CD 1501'              	CALL	CEND		; to the line's content end, the CR,LF left
  14C4'   22 2A59'              	SHLD	OPHI
  14C7'   C3 140D'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  14CA'                         VC_X:
  14CA'   CD 08E6'              	CALL	GLSTAL
  14CD'   CD 0760'              	CALL	SETLIN
  14D0'   CD 068B'              	CALL	GETCNT
  14D3'   22 2A5B'              	SHLD	CNTV
  14D6'   CD 0000*              	CALL	CUROFF
  14D9'   22 2A5F'              	SHLD	WKI		; cur
  14DC'   CD 1501'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  14DF'   EB                    	XCHG			; DE = contentend
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  14E0'   2A 2A5F'              	LHLD	WKI		; HL = cur
  14E3'   EB                    	XCHG			; HL = contentend, DE = cur
  14E4'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  14E7'   7C                    	MOV	A,H
  14E8'   B5                    	ORA	L
  14E9'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  14EA'   EB                    	XCHG			; DE = available
  14EB'   2A 2A5B'              	LHLD	CNTV		; HL = count
  14EE'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  14F1'   DA 14F7'              	JC	VX_USEA
  14F4'   C3 14F8'              	JMP	VX_DEL		; count <= available -> HL = count = del
  14F7'                         VX_USEA:
  14F7'   EB                    	XCHG			; HL = available
  14F8'                         VX_DEL:
  14F8'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  14FB'   CD 018C'              	CALL	MARKMOD
  14FE'   C3 1512'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  1501'                         CEND:
  1501'   CD 05F7'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1504'   7C                    	MOV	A,H
  1505'   B5                    	ORA	L
  1506'   C8                    	RZ			; the start of the text: nothing before it
  1507'   2B                    	DCX	H
  1508'   E5                    	PUSH	H
  1509'   CD 0000*              	CALL	CHARAT
  150C'   E1                    	POP	H		; HL = term-1
  150D'   FE 0D                 	CPI	CR
  150F'   C8                    	RZ			; a CR before the LF -> the content ends there
  1510'   23                    	INX	H
  1511'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  1512'                         CLAMPE:
  1512'   CD 0000*              	CALL	CUROFF
  1515'   E5                    	PUSH	H
  1516'   CD 0623'              	CALL	EOLC
  1519'   D1                    	POP	D		; DE = cur
  151A'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  151D'   D8                    	RC
  151E'   C8                    	RZ
  151F'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1522'                         VC_I:
  1522'   CD 068B'              	CALL	GETCNT
  1525'   C3 1580'              	JMP	SETINM
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1528'                         VC_A:
  1528'   CD 068B'              	CALL	GETCNT
  152B'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  152E'   CA 1545'              	JZ	VA_INS
  1531'   EB                    	XCHG			; HL = cur
  1532'   E5                    	PUSH	H
  1533'   CD 0000*              	CALL	CHARAT
  1536'   E1                    	POP	H
  1537'   FE 0A                 	CPI	LF
  1539'   CA 1545'              	JZ	VA_INS		; on the line terminator -> append in place
  153C'   FE 0D                 	CPI	CR
  153E'   CA 1545'              	JZ	VA_INS
  1541'   23                    	INX	H
  1542'   CD 0000*              	CALL	GOTO
  1545'                         VA_INS:
  1545'   C3 1580'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1548'                         VCB_A:
  1548'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  154B'   CD 0623'              	CALL	EOLC		; HL = last content char (the start when empty)
  154E'   E5                    	PUSH	H
  154F'   CD 0000*              	CALL	CHARAT
  1552'   E1                    	POP	H
  1553'   FE 0D                 	CPI	CR
  1555'   CA 155E'              	JZ	VBA_IN		; an empty line: insert at its start
  1558'   FE 0A                 	CPI	LF
  155A'   CA 155E'              	JZ	VBA_IN
  155D'   23                    	INX	H		; past the last content char
  155E'                         VBA_IN:
  155E'   CD 0000*              	CALL	GOTO
  1561'   C3 1580'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1564'                         VCB_I:
  1564'   CD 068B'              	CALL	GETCNT
  1567'   CD 0834'              	CALL	FNBLNK
  156A'   CD 0000*              	CALL	CUROFF
  156D'   E5                    	PUSH	H
  156E'   CD 0000*              	CALL	CHARAT
  1571'   E1                    	POP	H
  1572'   FE 20                 	CPI	' '
  1574'   CA 157C'              	JZ	VBI_SK
  1577'   FE 09                 	CPI	TAB
  1579'   C2 1580'              	JNZ	SETINM
  157C'                         VBI_SK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  157C'   23                    	INX	H		; blanks only: past the last of them
  157D'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1580'                         SETINM:
  1580'   CD 075A'              	CALL	SETMOV
  1583'                         SETINS:
  1583'   3E 01                 	MVI	A,EM_INS
  1585'   32 2A18'              	STA	EDMODE
  1588'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1589'                         ATCEND:
  1589'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  158C'   C8                    	RZ
  158D'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  1590'   FE 0D                 	CPI	CR
  1592'   C8                    	RZ
  1593'   FE 0A                 	CPI	LF
  1595'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1596'                         OPNBRK:
  1596'   CD 1E88'              	CALL	PUTBRK
  1599'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  159C'   23                    	INX	H
  159D'   22 0000*              	SHLD	LNDLT
  15A0'   C3 018C'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  15A3'                         ENDBRK:
  15A3'   CD 0667'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  15A6'   C0                    	RNZ
  15A7'   CD 1596'              	CALL	OPNBRK
  15AA'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  15AD'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  15AE'   2B                    	DCX	H		;   line, with its own terminator after it
  15AF'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  15B2'                         VC_O:
  15B2'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15B5'   CD 1501'              	CALL	CEND
  15B8'   CD 0000*              	CALL	GOTO
  15BB'   CD 1596'              	CALL	OPNBRK
  15BE'   CD 15A3'              	CALL	ENDBRK		; a last line with no line end: the opened line
  15C1'   CD 0766'              	CALL	SETILN		;   needs a terminator of its own to exist
  15C4'   C3 1583'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  15C7'                         VCB_O:
  15C7'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15CA'   CD 05E4'              	CALL	BOL
  15CD'   CD 0000*              	CALL	GOTO
  15D0'   CD 1596'              	CALL	OPNBRK
  15D3'   CD 0000*              	CALL	CUROFF
  15D6'   2B                    	DCX	H
  15D7'   2B                    	DCX	H
  15D8'   CD 0000*              	CALL	GOTO
  15DB'   CD 0766'              	CALL	SETILN
  15DE'   C3 1583'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  15E1'                         VCB_J:
  15E1'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15E4'   CD 1501'              	CALL	CEND		; the join point: this line's content end
  15E7'   22 2A57'              	SHLD	OPLO
  15EA'   CD 0000*              	CALL	CUROFF
  15ED'   CD 0614'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  15F0'   E5                    	PUSH	H
  15F1'   CD 0000*              	CALL	LOGLEN
  15F4'   D1                    	POP	D		; DE = that start
  15F5'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  15F8'   CA 075A'              	JZ	SETMOV
  15FB'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  15FC'                         VJ_WS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  15FC'   E5                    	PUSH	H
  15FD'   CD 0000*              	CALL	LOGLEN
  1600'   D1                    	POP	D		; DE = the scan
  1601'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1604'   CA 161B'              	JZ	VJ_DEL
  1607'   EB                    	XCHG			; HL = the scan
  1608'   E5                    	PUSH	H
  1609'   CD 0000*              	CALL	CHARAT
  160C'   E1                    	POP	H
  160D'   FE 20                 	CPI	' '
  160F'   CA 1617'              	JZ	VJ_SKIP
  1612'   FE 09                 	CPI	TAB
  1614'   C2 161B'              	JNZ	VJ_DEL
  1617'                         VJ_SKIP:
  1617'   23                    	INX	H
  1618'   C3 15FC'              	JMP	VJ_WS
  161B'                         VJ_DEL:
  161B'   22 2A59'              	SHLD	OPHI
  161E'   CD 140D'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1621'   CD 0775'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1624'   CD 0667'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1627'   CA 1512'              	JZ	CLAMPE
  162A'   CD 0672'              	CALL	CURCHR		; the first char of what was appended
  162D'   FE 0D                 	CPI	CR
  162F'   CA 1512'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1632'   FE 0A                 	CPI	LF
  1634'   CA 1512'              	JZ	CLAMPE
  1637'   FE 29                 	CPI	')'
  1639'   CA 1512'              	JZ	CLAMPE		; vim puts no space before a ')'
  163C'   CD 0000*              	CALL	CUROFF
  163F'   7C                    	MOV	A,H
  1640'   B5                    	ORA	L
  1641'   CA 1657'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1644'   2B                    	DCX	H
  1645'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1648'   FE 20                 	CPI	' '
  164A'   CA 1512'              	JZ	CLAMPE
  164D'   FE 09                 	CPI	TAB
  164F'   CA 1512'              	JZ	CLAMPE
  1652'   FE 0A                 	CPI	LF
  1654'   CA 1512'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1657'                         VJ_SP:
  1657'   3E 20                 	MVI	A,' '
  1659'   CD 0000*              	CALL	PUTGAP
  165C'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  165F'   2B                    	DCX	H
  1660'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1663'                         VC_TILD:
  1663'   CD 068B'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  1666'   CD 0760'              	CALL	SETLIN		; only this row changes
  1669'   CD 08E6'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  166C'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  166F'   CA 075A'              	JZ	SETMOV
  1672'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  1675'   FE 0D                 	CPI	CR
  1677'   CA 075A'              	JZ	SETMOV		; the line's end: nothing to toggle
  167A'   FE 0A                 	CPI	LF
  167C'   CA 075A'              	JZ	SETMOV
  167F'   47                    	MOV	B,A
  1680'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1682'   FE 41                 	CPI	'A'
  1684'   DA 1690'              	JC	VT_PUT		; below 'A': no case
  1687'   FE 5B                 	CPI	'Z'+1
  1689'   D2 1690'              	JNC	VT_PUT		; above 'Z': no case
  168C'   78                    	MOV	A,B
  168D'   EE 20                 	XRI	20H		; a letter: flip the case bit
  168F'   47                    	MOV	B,A
  1690'                         VT_PUT:
  1690'   78                    	MOV	A,B
  1691'   32 2A68'              	STA	VRCH		; the calls below do not preserve B
  1694'   CD 018C'              	CALL	MARKMOD
  1697'   21 0001               	LXI	H,1
  169A'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  169D'   3A 2A68'              	LDA	VRCH
  16A0'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  16A3'   C3 1512'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  16A6'                         VC_R:
  16A6'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  16A9'   3E 03                 	MVI	A,PR
  16AB'   32 2A40'              	STA	GPEND
  16AE'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  16AF'                         VR_DO:
  16AF'   AF                    	XRA	A
  16B0'   32 2A40'              	STA	GPEND
  16B3'   79                    	MOV	A,C
  16B4'   32 2A68'              	STA	VRCH		; the calls below do not preserve C
  16B7'   CD 0760'              	CALL	SETLIN		; only this row changed
  16BA'   CD 08E6'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  16BD'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  16C0'   CA 075A'              	JZ	SETMOV		; the end of the text: vim does nothing
  16C3'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  16C6'   FE 0D                 	CPI	CR
  16C8'   CA 075A'              	JZ	SETMOV		; the line's end: nothing to replace
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  16CB'   FE 0A                 	CPI	LF
  16CD'   CA 075A'              	JZ	SETMOV
  16D0'   CD 018C'              	CALL	MARKMOD
  16D3'   21 0001               	LXI	H,1
  16D6'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  16D9'   3A 2A68'              	LDA	VRCH
  16DC'   FE 0D                 	CPI	CR
  16DE'   CA 16EB'              	JZ	VR_CR
  16E1'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  16E4'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  16E7'   2B                    	DCX	H		;   out, which moves every logical offset
  16E8'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  16EB'                         VR_CR:
  16EB'   CD 1596'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  16EE'   CD 15A3'              	CALL	ENDBRK		;   replaced char may have been the text's last
  16F1'   CD 0766'              	CALL	SETILN		;   row above it lost the char that was replaced,
  16F4'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  16F6'   32 2A20'              	STA	ILABOV
  16F9'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  16FA'                         VCB_R:
  16FA'   CD 068B'              	CALL	GETCNT
  16FD'   CD 075A'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1700'   21 0000               	LXI	H,0
  1703'   22 2A69'              	SHLD	RPDEL		; nothing of ours to put back yet
  1706'   22 2A6B'              	SHLD	RPAPP
  1709'   3E 02                 	MVI	A,EM_REP
  170B'   32 2A18'              	STA	EDMODE
  170E'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  170F'                         VC_D:
  170F'   3E 64                 	MVI	A,'d'
  1711'   32 2A42'              	STA	PENDOP
  1714'   C3 075A'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1717'                         VC_C:
  1717'   3E 63                 	MVI	A,'c'
  1719'   32 2A42'              	STA	PENDOP
  171C'   C3 075A'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  171F'                         VD_DD:
  171F'   CD 08E6'              	CALL	GLSTAL
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  1722'   CD 068B'              	CALL	GETCNT
  1725'   22 2A5B'              	SHLD	CNTV
  1728'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  172A'   32 2A44'              	STA	DDSNG
  172D'   2B                    	DCX	H
  172E'   7C                    	MOV	A,H
  172F'   B5                    	ORA	L
  1730'   C2 173B'              	JNZ	VDD_LS
  1733'   3E 01                 	MVI	A,1
  1735'   32 2A44'              	STA	DDSNG
  1738'   C3 1741'              	JMP	VDD_GO
  173B'                         VDD_LS:
  173B'   CD 089F'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  173E'   DA 075A'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1741'                         VDD_GO:
  1741'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1744'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1747'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  174A'   CD 20EB'              	CALL	COPY12		;   every mark in the lines has closed up by then
  174D'   CD 081D'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1750'   2A 2A5B'              	LHLD	CNTV
  1753'   CD 0000*              	CALL	SETC0
  1756'                         VDD_FW:
  1756'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1759'   DA 18A7'              	JC	QREFUS		; ... which has no room for them
  175C'   CD 06A0'              	CALL	CNTTST
  175F'   C2 1756'              	JNZ	VDD_FW
  1762'   CD 018C'              	CALL	MARKMOD
  1765'   CD 0A1D'              	CALL	ATEOF
  1768'   D2 1783'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  176B'   3E 00                 	MVI	A,0
  176D'   32 2A44'              	STA	DDSNG		; deleted to the end: full repaint
  1770'   CD 0E5F'              	CALL	ONFST
  1773'   CA 0834'              	JZ	FNBLNK		; nothing left before it
  1776'   21 0001               	LXI	H,1		; onto the new last line
  1779'   CD 0000*              	CALL	SETBWD
  177C'   2A 0000*              	LHLD	LNDLT
  177F'   2B                    	DCX	H
  1780'   22 0000*              	SHLD	LNDLT
  1783'                         VDD_UP:
  1783'   CD 0834'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1786'   3A 2A44'              	LDA	DDSNG
  1789'   B7                    	ORA	A
  178A'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  178B'   3E 03                 	MVI	A,R_DLIN
  178D'   32 2A1D'              	STA	RINTENT
  1790'   C9                    	RET
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1791'                         QEMPTY:
  1791'   2A 0000*              	LHLD	QBEG
  1794'   EB                    	XCHG
  1795'   2A 0000*              	LHLD	QEND
  1798'   7C                    	MOV	A,H
  1799'   BA                    	CMP	D
  179A'   C0                    	RNZ
  179B'   7D                    	MOV	A,L
  179C'   BB                    	CMP	E
  179D'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  179E'                         VC_Y:
  179E'   3E 79                 	MVI	A,'y'
  17A0'   32 2A42'              	STA	PENDOP
  17A3'   C3 075A'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  17A6'                         VY_YY:
  17A6'   21 2A4B'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  17A9'   CD 044F'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  17AC'   CD 0000*              	CALL	CUROFF
  17AF'   22 2A8C'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  17B2'   CD 05E4'              	CALL	BOL
  17B5'   22 2A8E'              	SHLD	YPT		; where the lines come from, to put them back
  17B8'   CD 190D'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  17BB'   CD 1950'              	CALL	YNCOPY		; copied where they lie, if that can be done
  17BE'   D2 1914'              	JNC	YNDONE
  17C1'   21 171F'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  17C4'   C3 17F0'              	JMP	YKGO
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  17C7'                         OPYANK:
  17C7'   CD 1427'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  17CA'   2A 2A47'              	LHLD	OPSTA
  17CD'   EB                    	XCHG			; DE = start
  17CE'   2A 2A49'              	LHLD	OPEND2		; HL = end
  17D1'   CD 0000*              	CALL	CMP16		; CY iff start < end
  17D4'   D2 17D8'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  17D7'   EB                    	XCHG			; ... otherwise the start is
  17D8'                         OPY_LO:
  17D8'   22 2A8C'              	SHLD	YOFF
  17DB'   2A 2A57'              	LHLD	OPLO
  17DE'   22 2A8E'              	SHLD	YPT		; where the lines come from, to put them back
  17E1'   CD 190D'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  17E4'   CD 19C8'              	CALL	YNSPAN		; copied where they lie, if there is room
  17E7'   D2 1914'              	JNC	YNDONE
  17EA'   21 18CE'              	LXI	H,YSPAN
  17ED'   C3 17F0'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  17F0'                         YKGO:
  17F0'   22 2AB5'              	SHLD	YACT
  17F3'   2A 2A8E'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  17F6'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  17F7'   2A 2A8C'              	LHLD	YOFF		;   survive this -- the put-back below can page
  17FA'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  17FD'   22 2ABB'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1800'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1803'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1804'   2A 2A8E'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1807'   EB                    	XCHG			;   window as it was, then names other text
  1808'   E1                    	POP	H
  1809'   CD 0000*              	CALL	SUBHD
  180C'   EB                    	XCHG			; DE = how far behind the cursor they start
  180D'   CD 0F2C'              	CALL	CURFP
  1810'   06 00                 	MVI	B,0
  1812'   CD 0F22'              	CALL	SUB24
  1815'   22 2ABD'              	SHLD	YPFP
  1818'   32 2ABF'              	STA	YPFP+2
  181B'   3A 2A1C'              	LDA	MODF
  181E'   32 2A89'              	STA	YMODF
  1821'   3A 2A35'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1824'   32 2A8A'              	STA	YDCHG		;   a yank must not become the last change
  1827'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  182A'   32 2A8B'              	STA	YURPL		;   back are not a change to undo either
  182D'   3E 01                 	MVI	A,1
  182F'   32 0000*              	STA	UNDRPL
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  1832'   32 2AB4'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1835'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1838'   22 2A97'              	SHLD	YLDLT
  183B'   CD 0000*              	CALL	LOGLEN
  183E'   22 2AB9'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1841'   2A 2AB5'              	LHLD	YACT
  1844'   CD 18A6'              	CALL	YCALL		; the lines out of the file, into the register
  1847'   3A 2A84'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  184A'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  184C'   CA 188A'              	JZ	YK_RF		;   cursor: only the flags are still owed
  184F'   CD 0000*              	CALL	LOGLEN
  1852'   EB                    	XCHG
  1853'   2A 2AB9'              	LHLD	YWAS
  1856'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1859'   CA 186B'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  185C'   21 2ABD'              	LXI	H,YPFP		; back to where they came from, by its place in
  185F'   CD 0402'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1862'   CD 03CF'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1865'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1868'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  186B'                         YK_FIN:				; (nothing came out: nothing went back, and the
  186B'   2A 2ABD'              	LHLD	YPFP		;   cursor is still owed its place)
  186E'   EB                    	XCHG
  186F'   2A 2ABB'              	LHLD	YCOL
  1872'   19                    	DAD	D
  1873'   22 2AB0'              	SHLD	MKPOS
  1876'   3A 2ABF'              	LDA	YPFP+2
  1879'   CE 00                 	ACI	0
  187B'   32 2AB2'              	STA	MKPOS+2
  187E'   CD 03CF'              	CALL	MKPAGE
  1881'   CD 0000*              	CALL	GOTO
  1884'                         YK_RST:
  1884'   2A 2A97'              	LHLD	YLDLT
  1887'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  188A'                         YK_RF:
  188A'   3A 2A89'              	LDA	YMODF
  188D'   32 2A1C'              	STA	MODF
  1890'   3A 2A8A'              	LDA	YDCHG
  1893'   32 2A35'              	STA	DOTCHG
  1896'   3A 2A8B'              	LDA	YURPL
  1899'   32 0000*              	STA	UNDRPL
  189C'   AF                    	XRA	A
  189D'   32 2AB4'              	STA	MKHOLD
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  18A0'   CD 08E6'              	CALL	GLSTAL
  18A3'   C3 077B'              	JMP	SETFUL		; the cheap paint cannot carry this
  18A6'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  18A7'                         QREFUS:
  18A7'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  18AA'   CD 1791'              	CALL	QEMPTY
  18AD'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  18B0'   CD 0000*              	CALL	QKILL
  18B3'   3A 2AB4'              	LDA	MKHOLD
  18B6'   B7                    	ORA	A
  18B7'   C2 18C6'              	JNZ	QRF_Y
  18BA'   21 0000*              	LXI	H,MKSAV
  18BD'   11 0000*              	LXI	D,MKTAB
  18C0'   CD 20EB'              	CALL	COPY12
  18C3'   CD 0000*              	CALL	UNDCLR
  18C6'                         QRF_Y:
  18C6'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  18C8'   32 2A84'              	STA	MSGWHT
  18CB'   C3 1251'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  18CE'                         YSPAN:
  18CE'   CD 08E6'              	CALL	GLSTAL
  18D1'   CD 1402'              	CALL	OPSPNL		; HL = the span's length
  18D4'   22 2AB7'              	SHLD	YTGT
  18D7'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  18DA'   EB                    	XCHG			; DE = it
  18DB'   2A 2AB7'              	LHLD	YTGT
  18DE'   EB                    	XCHG			; HL = the text's, DE = the span's
  18DF'   CD 0000*              	CALL	SUBHD
  18E2'   22 2AB7'              	SHLD	YTGT		; what the text is left at when the span is out
  18E5'   2A 2A57'              	LHLD	OPLO
  18E8'   CD 0000*              	CALL	GOTO
  18EB'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  18EE'                         YS_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  18EE'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  18F1'   CD 0000*              	CALL	SETC0
  18F4'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  18F7'   DA 18A7'              	JC	QREFUS		; ... which has no room for it
  18FA'   CD 0000*              	CALL	LOGLEN
  18FD'   EB                    	XCHG			; DE = what is left
  18FE'   2A 2AB7'              	LHLD	YTGT
  1901'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1904'   DA 190A'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1907'   C2 18EE'              	JNZ	YS_LP		;   but never spin here if it ever did
  190A'                         YS_END:
  190A'   C3 018C'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  190D'                         YNPRE:
  190D'   2A 0000*              	LHLD	PGTOPM
  1910'   22 2AC0'              	SHLD	YNPG
  1913'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1914'                         YNDONE:
  1914'   2A 2A8C'              	LHLD	YOFF
  1917'   CD 0000*              	CALL	GOTO
  191A'   2A 0000*              	LHLD	PGTOPM
  191D'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  191E'   2A 2AC0'              	LHLD	YNPG
  1921'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1924'   C2 077B'              	JNZ	SETFUL		; it moved under us: repaint after all
  1927'   C3 075A'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  192A'                         YNROOM:
  192A'   11 0100               	LXI	D,100H
  192D'   19                    	DAD	D
  192E'   D8                    	RC			; within a chunk of 64K: no arena holds that
  192F'   E5                    	PUSH	H		; the span plus its slack
  1930'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1933'   EB                    	XCHG			; HL = free
  1934'   D1                    	POP	D		; DE = the span plus its slack
  1935'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1938'   DA 1940'              	JC	YNR_OK
  193B'   CA 1940'              	JZ	YNR_OK
  193E'   37                    	STC			; not enough: the delete-and-put-back path
  193F'   C9                    	RET
  1940'                         YNR_OK:
  1940'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1941'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1942'                         YNGO:
  1942'   C5                    	PUSH	B
  1943'   CD 068B'              	CALL	GETCNT		; spent here: this yank is happening
  1946'   CD 08E6'              	CALL	GLSTAL
  1949'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  194C'   C1                    	POP	B
  194D'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1950'                         YNCOPY:
  1950'   2A 2A19'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1953'   7C                    	MOV	A,H		;   the count itself
  1954'   B5                    	ORA	L
  1955'   C2 195B'              	JNZ	YNC_HV
  1958'   21 0001               	LXI	H,1
  195B'                         YNC_HV:
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  195B'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  195C'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  195D'   B4                    	ORA	H
  195E'   CA 1969'              	JZ	YNC_M
  1961'   E5                    	PUSH	H
  1962'   CD 089F'              	CALL	ONLAST		; vim: a count over one on the last line does
  1965'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1966'   DA 197B'              	JC	YNC_RF
  1969'                         YNC_M:
  1969'   E5                    	PUSH	H
  196A'   CD 081D'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  196D'   E1                    	POP	H
  196E'   CD 1983'              	CALL	YNLINE		; BC = the span, measured where it stands
  1971'   D8                    	RC			; not measurable here: let the pager answer it
  1972'   60                    	MOV	H,B
  1973'   69                    	MOV	L,C
  1974'   CD 192A'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1977'   D8                    	RC			; no: the delete-and-put-back path
  1978'   C3 1942'              	JMP	YNGO
  197B'                         YNC_RF:
  197B'   CD 068B'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  197E'   CD 08E6'              	CALL	GLSTAL		;   register alone, and that is the command
  1981'   B7                    	ORA	A		; NC: done
  1982'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1983'                         YNLINE:
  1983'   22 2AC2'              	SHLD	YNCNT		; the lines it still wants
  1986'   2A 0000*              	LHLD	GAPEND
  1989'                         YNL_LP:
  1989'   EB                    	XCHG			; DE = the scan
  198A'   2A 0000*              	LHLD	TXTEND
  198D'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1990'   EB                    	XCHG			; HL = the scan
  1991'   D2 19B1'              	JNC	YNL_EN		; the resident text ran out
  1994'   7E                    	MOV	A,M
  1995'   23                    	INX	H
  1996'   FE 0A                 	CPI	LF
  1998'   C2 1989'              	JNZ	YNL_LP
  199B'   E5                    	PUSH	H
  199C'   2A 2AC2'              	LHLD	YNCNT
  199F'   2B                    	DCX	H
  19A0'   22 2AC2'              	SHLD	YNCNT
  19A3'   7C                    	MOV	A,H
  19A4'   B5                    	ORA	L
  19A5'   E1                    	POP	H
  19A6'   C2 1989'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  19A9'   EB                    	XCHG			; DE = past the last of them
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  19AA'   2A 0000*              	LHLD	GAPEND
  19AD'   EB                    	XCHG			; HL = past them, DE = GAPEND
  19AE'   C3 19BF'              	JMP	YNL_BC
  19B1'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  19B1'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  19B4'   C2 19C6'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  19B7'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  19BA'   EB                    	XCHG			;   count clamps to it as vim's does
  19BB'   2A 0000*              	LHLD	GAPEND
  19BE'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  19BF'                         YNL_BC:
  19BF'   CD 0000*              	CALL	SUBHD		; HL = the span
  19C2'   44                    	MOV	B,H
  19C3'   4D                    	MOV	C,L
  19C4'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  19C5'   C9                    	RET
  19C6'                         YNL_NO:
  19C6'   37                    	STC
  19C7'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  19C8'                         YNSPAN:
  19C8'   CD 1402'              	CALL	OPSPNL		; HL = the span's length
  19CB'   44                    	MOV	B,H
  19CC'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  19CD'   CD 192A'              	CALL	YNROOM
  19D0'   D8                    	RC			; no room: the delete-and-put-back path
  19D1'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  19D2'   2A 2A57'              	LHLD	OPLO
  19D5'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  19D8'   C1                    	POP	B
  19D9'   C3 1942'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  19DC'                         VC_P:
  19DC'   CD 1791'              	CALL	QEMPTY
  19DF'   CA 1A97'              	JZ	VP_BEL
  19E2'   CD 068B'              	CALL	GETCNT
  19E5'   22 2A90'              	SHLD	PCNT
  19E8'   CD 0000*              	CALL	CUROFF
  19EB'   CD 0614'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  19EE'   C3 1A03'              	JMP	VP_GO
  19F1'                         VCB_P:
  19F1'   CD 1791'              	CALL	QEMPTY
  19F4'   CA 1A97'              	JZ	VP_BEL
  19F7'   CD 068B'              	CALL	GETCNT
  19FA'   22 2A90'              	SHLD	PCNT
  19FD'   CD 0000*              	CALL	CUROFF
  1A00'   CD 05E4'              	CALL	BOL
  1A03'                         VP_GO:
  1A03'   CD 0000*              	CALL	GOTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1A06'   CD 0000*              	CALL	CUROFF
  1A09'   EB                    	XCHG
  1A0A'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1A0D'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1A10'   DA 1A25'              	JC	VP_IN
  1A13'   EB                    	XCHG			; HL = the put point = LOGLEN
  1A14'   7C                    	MOV	A,H
  1A15'   B5                    	ORA	L
  1A16'   CA 1A22'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1A19'   2B                    	DCX	H
  1A1A'   CD 0000*              	CALL	CHARAT
  1A1D'   FE 0A                 	CPI	LF
  1A1F'   CA 1A25'              	JZ	VP_IN
  1A22'                         VP_BRK:
  1A22'   CD 1596'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1A25'                         VP_IN:
  1A25'   CD 0000*              	CALL	CUROFF
  1A28'   22 2A92'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1A2B'   2A 0000*              	LHLD	QBEG
  1A2E'   EB                    	XCHG
  1A2F'   2A 0000*              	LHLD	QEND
  1A32'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1A35'   EB                    	XCHG
  1A36'   22 2A94'              	SHLD	PLFS
  1A39'   2A 2A90'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1A3C'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1A3D'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1A3E'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1A40'   C2 1A44'              	JNZ	VP_PZ
  1A43'   7D                    	MOV	A,L
  1A44'                         VP_PZ:
  1A44'   32 2A96'              	STA	PCPY
  1A47'                         VP_LP:
  1A47'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1A4A'   2A 0000*              	LHLD	LNDLT
  1A4D'   EB                    	XCHG
  1A4E'   2A 2A94'              	LHLD	PLFS
  1A51'   19                    	DAD	D
  1A52'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1A55'   2A 2A90'              	LHLD	PCNT
  1A58'   2B                    	DCX	H
  1A59'   22 2A90'              	SHLD	PCNT
  1A5C'   7C                    	MOV	A,H
  1A5D'   B5                    	ORA	L
  1A5E'   C2 1A47'              	JNZ	VP_LP
  1A61'   CD 018C'              	CALL	MARKMOD
  1A64'   2A 2A92'              	LHLD	PPT
  1A67'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


                                				;   arithmetic now has the lines to subtract
  1A6A'   CD 08E6'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1A6D'   3A 2A96'              	LDA	PCPY
  1A70'   B7                    	ORA	A
  1A71'   CA 0834'              	JZ	FNBLNK
  1A74'   2A 2A94'              	LHLD	PLFS
  1A77'   7C                    	MOV	A,H
  1A78'   B7                    	ORA	A
  1A79'   C2 0834'              	JNZ	FNBLNK
  1A7C'   3A 2A96'              	LDA	PCPY
  1A7F'   CD 0DF5'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1A82'   7C                    	MOV	A,H
  1A83'   B7                    	ORA	A
  1A84'   C2 0834'              	JNZ	FNBLNK
  1A87'   7D                    	MOV	A,L
  1A88'   B7                    	ORA	A
  1A89'   CA 0834'              	JZ	FNBLNK
  1A8C'   F5                    	PUSH	PSW
  1A8D'   CD 0766'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1A90'   F1                    	POP	PSW
  1A91'   32 2A1E'              	STA	ILN		; ... which the lines put now replace
  1A94'   C3 0834'              	JMP	FNBLNK
  1A97'                         VP_BEL:
  1A97'   CD 068B'              	CALL	GETCNT		; the count is spent either way
  1A9A'   0E 07                 	MVI	C,BEL
  1A9C'   CD 0000*              	CALL	BCONOU
  1A9F'   C3 075A'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  1AA2'                         VIREP:
  1AA2'   78                    	MOV	A,B
  1AA3'   FE 01                 	CPI	KT_ACT
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1AA5'   CA 1BD2'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  1AA8'   FE 02                 	CPI	KT_CHAR
  1AAA'   C0                    	RNZ			; ignore anything else
  1AAB'   79                    	MOV	A,C
  1AAC'   FE 0D                 	CPI	CR
  1AAE'   CA 1B12'              	JZ	VP_CR
  1AB1'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1AB3'   CA 1B12'              	JZ	VP_CR
  1AB6'   FE 08                 	CPI	BS
  1AB8'   CA 1B1E'              	JZ	VP_BS
  1ABB'   FE 7F                 	CPI	DEL
  1ABD'   CA 1B1E'              	JZ	VP_BS
  1AC0'   32 2A68'              	STA	VRCH		; the calls below do not preserve C
  1AC3'   CD 0760'              	CALL	SETLIN		; this row changed
  1AC6'   CD 018C'              	CALL	MARKMOD
  1AC9'   CD 1589'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1ACC'   CA 1B04'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1ACF'   3A 2A68'              	LDA	VRCH
  1AD2'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1AD5'   2A 2A69'              	LHLD	RPDEL
  1AD8'   7C                    	MOV	A,H
  1AD9'   B5                    	ORA	L
  1ADA'   CA 1AF0'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1ADD'   2A 0000*              	LHLD	GAPEND
  1AE0'   EB                    	XCHG
  1AE1'   2A 2A6D'              	LHLD	RPGE
  1AE4'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1AE7'   CA 1AF0'              	JZ	VP_OVW
  1AEA'   21 0000               	LXI	H,0
  1AED'   22 2A69'              	SHLD	RPDEL		; the text moved: those originals are gone
  1AF0'                         VP_OVW:
  1AF0'   21 0001               	LXI	H,1
  1AF3'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1AF6'   2A 0000*              	LHLD	GAPEND
  1AF9'   22 2A6D'              	SHLD	RPGE
  1AFC'   2A 2A69'              	LHLD	RPDEL
  1AFF'   23                    	INX	H
  1B00'   22 2A69'              	SHLD	RPDEL
  1B03'   C9                    	RET
  1B04'                         VP_APP:
  1B04'   3A 2A68'              	LDA	VRCH
  1B07'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1B0A'   2A 2A6B'              	LHLD	RPAPP
  1B0D'   23                    	INX	H
  1B0E'   22 2A6B'              	SHLD	RPAPP
  1B11'   C9                    	RET
  1B12'                         VP_CR:
  1B12'   21 0000               	LXI	H,0
  1B15'   22 2A69'              	SHLD	RPDEL		; a line break ends what BS can put back
  1B18'   22 2A6B'              	SHLD	RPAPP
  1B1B'   C3 1BA8'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1B1E'                         VP_BS:
  1B1E'   2A 2A6B'              	LHLD	RPAPP
  1B21'   7C                    	MOV	A,H
  1B22'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1B23'   CA 1B30'              	JZ	VP_BSD
  1B26'   2B                    	DCX	H
  1B27'   22 2A6B'              	SHLD	RPAPP		; an appended char: it just goes
  1B2A'   CD 0760'              	CALL	SETLIN
  1B2D'   C3 0000*              	JMP	DELPRV
  1B30'                         VP_BSD:
  1B30'   2A 2A69'              	LHLD	RPDEL
  1B33'   7C                    	MOV	A,H
  1B34'   B5                    	ORA	L
  1B35'   CA 1B5C'              	JZ	VP_BSM		; nothing of ours left
  1B38'   2A 0000*              	LHLD	GAPEND
  1B3B'   EB                    	XCHG
  1B3C'   2A 2A6D'              	LHLD	RPGE
  1B3F'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1B42'   C2 1B5C'              	JNZ	VP_BSM
  1B45'   2A 2A69'              	LHLD	RPDEL
  1B48'   2B                    	DCX	H
  1B49'   22 2A69'              	SHLD	RPDEL
  1B4C'   CD 0760'              	CALL	SETLIN
  1B4F'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1B52'   CD 0000*              	CALL	UNDELF		; the original comes back
  1B55'   2A 0000*              	LHLD	GAPEND
  1B58'   22 2A6D'              	SHLD	RPGE
  1B5B'   C9                    	RET
  1B5C'                         VP_BSM:
  1B5C'   CD 075A'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1B5F'   C3 07C9'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  1B62'                         VIINS:
  1B62'   78                    	MOV	A,B
  1B63'   FE 01                 	CPI	KT_ACT
  1B65'   CA 1BD2'              	JZ	VI_ACT
  1B68'   FE 02                 	CPI	KT_CHAR
  1B6A'   C0                    	RNZ			; ignore anything else
  1B6B'   79                    	MOV	A,C
  1B6C'   FE 0D                 	CPI	CR
  1B6E'   CA 1BA8'              	JZ	VI_CR
  1B71'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1B73'   CA 1BA8'              	JZ	VI_CR
  1B76'   FE 08                 	CPI	BS
  1B78'   CA 1BC0'              	JZ	VI_BS
  1B7B'   FE 7F                 	CPI	DEL
  1B7D'   CA 1BC0'              	JZ	VI_BS
  1B80'   79                    	MOV	A,C
  1B81'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1B84'   CD 018C'              	CALL	MARKMOD
  1B87'   CD 0760'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1B8A'   79                    	MOV	A,C
  1B8B'   FE 20                 	CPI	' '
  1B8D'   D8                    	RC			; control char -> keep R_LINE
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1B8E'   FE 7F                 	CPI	DEL
  1B90'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1B91'   CD 0781'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1B94'   B7                    	ORA	A
  1B95'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1B96'   3E 04                 	MVI	A,R_ICH
  1B98'   32 2A1D'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1B9B'   CD 1589'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1B9E'   3E 00                 	MVI	A,0
  1BA0'   C2 1BA4'              	JNZ	VI_ICH
  1BA3'   3C                    	INR	A
  1BA4'                         VI_ICH:
  1BA4'   32 2A1F'              	STA	ICHAPP
  1BA7'   C9                    	RET
  1BA8'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1BA8'   CD 1589'              	CALL	ATCEND
  1BAB'   3E 00                 	MVI	A,0
  1BAD'   CA 1BB1'              	JZ	VI_CRS
  1BB0'   3C                    	INR	A
  1BB1'                         VI_CRS:
  1BB1'   F5                    	PUSH	PSW
  1BB2'   CD 1596'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1BB5'   CD 15A3'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1BB8'   CD 0766'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1BBB'   F1                    	POP	PSW
  1BBC'   32 2A20'              	STA	ILABOV
  1BBF'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1BC0'                         VI_BS:
  1BC0'   CD 0000*              	CALL	PEEKL
  1BC3'   D8                    	RC			; start of the file: nothing to delete
  1BC4'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1BC6'   CA 1BCC'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1BC9'   CD 0760'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1BCC'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1BCC'   CD 018C'              	CALL	MARKMOD
  1BCF'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1BD2'                         VI_ACT:
  1BD2'   79                    	MOV	A,C
  1BD3'   FE 0B                 	CPI	ACT_ESC
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1BD5'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  1BD6'   3E 00                 	MVI	A,EM_CMD
  1BD8'   32 2A18'              	STA	EDMODE
  1BDB'   CD 075A'              	CALL	SETMOV
  1BDE'   CD 07C9'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1BE1'   C3 08E6'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1BE4'                         RDLINE:
  1BE4'   EB                    	XCHG			; HL = buffer
  1BE5'   22 2A6F'              	SHLD	RLPTR
  1BE8'   3E 00                 	MVI	A,0
  1BEA'   32 2A71'              	STA	RLLEN
  1BED'   78                    	MOV	A,B
  1BEE'   32 2A72'              	STA	RLMAX
  1BF1'   79                    	MOV	A,C
  1BF2'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1BF5'                         RL_LP:
  1BF5'   CD 0000*              	CALL	GETKEY
  1BF8'   78                    	MOV	A,B
  1BF9'   FE 01                 	CPI	KT_ACT
  1BFB'   CA 1C51'              	JZ	RL_ACT
  1BFE'   FE 02                 	CPI	KT_CHAR
  1C00'   C2 1BF5'              	JNZ	RL_LP		; ignore other keys
  1C03'   79                    	MOV	A,C
  1C04'   FE 0D                 	CPI	CR
  1C06'   CA 1C62'              	JZ	RL_DONE
  1C09'   FE 08                 	CPI	BS
  1C0B'   CA 1C39'              	JZ	RL_BS
  1C0E'   FE 7F                 	CPI	DEL
  1C10'   CA 1C39'              	JZ	RL_BS
  1C13'   FE 20                 	CPI	' '
  1C15'   DA 1BF5'              	JC	RL_LP		; control char -> ignore
  1C18'   3A 2A71'              	LDA	RLLEN
  1C1B'   47                    	MOV	B,A
  1C1C'   3A 2A72'              	LDA	RLMAX
  1C1F'   B8                    	CMP	B
  1C20'   CA 1BF5'              	JZ	RL_LP		; full -> ignore
  1C23'   2A 2A6F'              	LHLD	RLPTR
  1C26'   71                    	MOV	M,C
  1C27'   23                    	INX	H
  1C28'   22 2A6F'              	SHLD	RLPTR
  1C2B'   3A 2A71'              	LDA	RLLEN
  1C2E'   3C                    	INR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1C2F'   32 2A71'              	STA	RLLEN
  1C32'   79                    	MOV	A,C
  1C33'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1C36'   C3 1BF5'              	JMP	RL_LP
  1C39'                         RL_BS:				; WM LINEPOP
  1C39'   3A 2A71'              	LDA	RLLEN
  1C3C'   B7                    	ORA	A
  1C3D'   CA 1C57'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1C40'   3D                    	DCR	A
  1C41'   32 2A71'              	STA	RLLEN
  1C44'   2A 2A6F'              	LHLD	RLPTR
  1C47'   2B                    	DCX	H
  1C48'   22 2A6F'              	SHLD	RLPTR
  1C4B'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1C4E'   C3 1BF5'              	JMP	RL_LP
  1C51'                         RL_ACT:
  1C51'   79                    	MOV	A,C
  1C52'   FE 0B                 	CPI	ACT_ESC
  1C54'   C2 1BF5'              	JNZ	RL_LP
  1C57'                         RL_CAN:
  1C57'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1C59'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1C5C'   CD 0760'              	CALL	SETLIN		; redraw one row
  1C5F'   3E FF                 	MVI	A,0FFH		; cancelled
  1C61'   C9                    	RET
  1C62'                         RL_DONE:
  1C62'   AF                    	XRA	A
  1C63'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1C64'                         VC_BZ:
  1C64'   CD 075A'              	CALL	SETMOV
  1C67'   3A 2A41'              	LDA	GSAVE
  1C6A'   FE 02                 	CPI	PZ
  1C6C'   CA 1C77'              	JZ	VZ_ZZ
  1C6F'   B7                    	ORA	A
  1C70'   C0                    	RNZ			; 'g' was pending: vim drops both
  1C71'   3E 02                 	MVI	A,PZ
  1C73'   32 2A40'              	STA	GPEND
  1C76'   C9                    	RET
  1C77'                         VZ_ZZ:
  1C77'   3E 04                 	MVI	A,EO_X
  1C79'   32 2A73'              	STA	EXOP
  1C7C'   3E 01                 	MVI	A,1
  1C7E'   32 2A86'              	STA	EXBANG		; no '!'
  1C81'   AF                    	XRA	A
  1C82'   32 2A74'              	STA	EXARG		; no file name
  1C85'   3A 2A1C'              	LDA	MODF		; as ':x': a changed text is written first
  1C88'   B7                    	ORA	A
  1C89'   CA 1DCA'              	JZ	EX_Q
  1C8C'   C3 1D64'              	JMP	EX_W
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1C8F'                         VC_EX:
  1C8F'   CD 068B'              	CALL	GETCNT
  1C92'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1C95'   11 0000*              	LXI	D,EXBUF
  1C98'   06 28                 	MVI	B,EXMAX
  1C9A'   0E 3A                 	MVI	C,':'
  1C9C'   CD 1BE4'              	CALL	RDLINE
  1C9F'   B7                    	ORA	A
  1CA0'   C0                    	RNZ			; cancelled
  1CA1'   3A 2A71'              	LDA	RLLEN
  1CA4'   5F                    	MOV	E,A
  1CA5'   16 00                 	MVI	D,0
  1CA7'   21 0000*              	LXI	H,EXBUF
  1CAA'   19                    	DAD	D
  1CAB'   36 00                 	MVI	M,0		; the line ends with a 0
  1CAD'   21 0000*              	LXI	H,EXBUF
  1CB0'   CD 2280'              	CALL	SKIPB
  1CB3'   C8                    	RZ			; nothing on it
  1CB4'   22 2A76'              	SHLD	EXCMD
  1CB7'   CD 2474'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1CBA'   CD 2280'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1CBD'   56                    	MOV	D,M
  1CBE'   23                    	INX	H
  1CBF'   1E 00                 	MVI	E,0
  1CC1'   CD 228C'              	CALL	ISLOW
  1CC4'   DA 1CCF'              	JC	EX_LK
  1CC7'   5F                    	MOV	E,A
  1CC8'   23                    	INX	H
  1CC9'   CD 228C'              	CALL	ISLOW
  1CCC'   D2 1CE8'              	JNC	EX_NOT		; a third letter: none of ours
  1CCF'                         EX_LK:
  1CCF'   E5                    	PUSH	H
  1CD0'   21 245B'              	LXI	H,EXTAB
  1CD3'                         EX_TL:
  1CD3'   7E                    	MOV	A,M
  1CD4'   B7                    	ORA	A
  1CD5'   CA 1CE7'              	JZ	EX_NTP		; not in the table
  1CD8'   23                    	INX	H
  1CD9'   BA                    	CMP	D
  1CDA'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1CDB'   23                    	INX	H
  1CDC'   C2 1CE3'              	JNZ	EX_TN
  1CDF'   BB                    	CMP	E
  1CE0'   CA 1CEE'              	JZ	EX_TF
  1CE3'                         EX_TN:
  1CE3'   23                    	INX	H
  1CE4'   C3 1CD3'              	JMP	EX_TL
  1CE7'                         EX_NTP:
  1CE7'   E1                    	POP	H
  1CE8'                         EX_NOT:
  1CE8'   21 2344'              	LXI	H,SNOT
  1CEB'   C3 22C1'              	JMP	EXERT
  1CEE'                         EX_TF:
  1CEE'   7E                    	MOV	A,M
  1CEF'   32 2A73'              	STA	EXOP
  1CF2'   E1                    	POP	H
  1CF3'   FE 06                 	CPI	EO_S
  1CF5'   CA 24E3'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1CF8'   FE 01                 	CPI	EO_W
  1CFA'   CA 1D09'              	JZ	EX_RG		; ':N,Mw name' takes a range
  1CFD'   FE 08                 	CPI	EO_R
  1CFF'   CA 1D09'              	JZ	EX_RG		; ... and ':Nr name' a line
  1D02'   3A 2ACE'              	LDA	SRNGF
  1D05'   B7                    	ORA	A
  1D06'   C2 1CE8'              	JNZ	EX_NOT		; a range on a command that does not take one
  1D09'                         EX_RG:
                                	;--- '!', then the file name ---
  1D09'   7E                    	MOV	A,M
  1D0A'   D6 21                 	SUI	'!'
  1D0C'   32 2A86'              	STA	EXBANG		; 0 = '!'
  1D0F'   C2 1D13'              	JNZ	EX_NB
  1D12'   23                    	INX	H
  1D13'                         EX_NB:
  1D13'   CD 2280'              	CALL	SKIPB
  1D16'   32 2A74'              	STA	EXARG		; 0 = no file name
  1D19'   CA 1D32'              	JZ	EX_RUN
  1D1C'   22 2A76'              	SHLD	EXCMD
  1D1F'   3A 2A73'              	LDA	EXOP
  1D22'   FE 02                 	CPI	EO_Q
  1D24'   CA 22BE'              	JZ	EX_TRL		; :q takes none
  1D27'   FE 07                 	CPI	EO_V
  1D29'   CA 22BE'              	JZ	EX_TRL		; nor :ve
  1D2C'   CD 21EA'              	CALL	PARSFN
  1D2F'   C2 22B2'              	JNZ	EX_INV
  1D32'                         EX_RUN:
  1D32'   3A 2A73'              	LDA	EXOP
  1D35'   FE 05                 	CPI	EO_E
  1D37'   CA 1DE1'              	JZ	EX_E
  1D3A'   FE 02                 	CPI	EO_Q
  1D3C'   CA 1DCA'              	JZ	EX_Q
  1D3F'   FE 07                 	CPI	EO_V
  1D41'   CA 22B8'              	JZ	EX_V
  1D44'   FE 08                 	CPI	EO_R
  1D46'   CA 1F72'              	JZ	EX_R
  1D49'   FE 04                 	CPI	EO_X
  1D4B'   CA 1D5D'              	JZ	EX_XM
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1D4E'   FE 01                 	CPI	EO_W
  1D50'   C2 1D64'              	JNZ	EX_W		; :wq
  1D53'   3A 2ACE'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  1D56'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  1D57'   C2 1E92'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  1D5A'   C3 1D64'              	JMP	EX_W
  1D5D'                         EX_XM:
  1D5D'   3A 2A1C'              	LDA	MODF		; :x writes only a changed text
  1D60'   B7                    	ORA	A
  1D61'   CA 1DCA'              	JZ	EX_Q
  1D64'                         EX_W:
  1D64'   CD 2052'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1D67'   D8                    	RC			; refused (message shown)
  1D68'   32 2A75'              	STA	EXBAK
  1D6B'   3A 2A73'              	LDA	EXOP
  1D6E'   FE 01                 	CPI	EO_W
  1D70'   CA 1D87'              	JZ	EX_WK
  1D73'   3A 2A75'              	LDA	EXBAK
  1D76'   B7                    	ORA	A
  1D77'   C2 1DC7'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1D7A'   3A 2A86'              	LDA	EXBANG
  1D7D'   B7                    	ORA	A
  1D7E'   CA 1DC7'              	JZ	EX_WQ		; so it does with '!'
  1D81'   CD 1D87'              	CALL	EX_WK		; else it may not: keep the text
  1D84'   C3 1DCA'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1D87'                         EX_WK:
  1D87'   CD 0D01'              	CALL	CURRW		; the cursor's row and file position
  1D8A'   32 2A78'              	STA	WPROW
  1D8D'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1D90'   7D                    	MOV	A,L
  1D91'   E6 7F                 	ANI	7FH
  1D93'   32 2A79'              	STA	WPBYT
  1D96'   7D                    	MOV	A,L
  1D97'   17                    	RAL
  1D98'   7C                    	MOV	A,H
  1D99'   17                    	RAL
  1D9A'   5F                    	MOV	E,A
  1D9B'   3E 00                 	MVI	A,0
  1D9D'   17                    	RAL
  1D9E'   57                    	MOV	D,A		; DE = HL / 128
  1D9F'   2A 0000*              	LHLD	OUTPOS
  1DA2'   19                    	DAD	D
  1DA3'   22 2A7A'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1DA6'   CD 2087'              	CALL	WRITE
  1DA9'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1DAC'   2A 2A7A'              	LHLD	WPREC
  1DAF'   EB                    	XCHG
  1DB0'   3A 2A79'              	LDA	WPBYT
  1DB3'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1DB6'   CD 0000*              	CALL	GOTO
  1DB9'                         EX_WRW:
  1DB9'   21 0000               	LXI	H,0
  1DBC'   22 0000*              	SHLD	LNDLT
  1DBF'   3A 2A78'              	LDA	WPROW
  1DC2'   6F                    	MOV	L,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1DC3'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1DC6'   C9                    	RET
  1DC7'                         EX_WQ:
  1DC7'   CD 2087'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1DCA'                         EX_Q:
  1DCA'   3A 2A86'              	LDA	EXBANG
  1DCD'   B7                    	ORA	A
  1DCE'   CA 1DD8'              	JZ	EX_QT
  1DD1'   3A 2A1C'              	LDA	MODF
  1DD4'   B7                    	ORA	A
  1DD5'   C2 22A6'              	JNZ	MSGNWR		; changed, no '!': stay
  1DD8'                         EX_QT:
  1DD8'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1DDB'   3E 01                 	MVI	A,1
  1DDD'   32 2A1B'              	STA	QUITF
  1DE0'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1DE1'                         EX_E:
  1DE1'   3A 2A86'              	LDA	EXBANG
  1DE4'   B7                    	ORA	A
  1DE5'   CA 1DEF'              	JZ	EE_GO
  1DE8'   3A 2A1C'              	LDA	MODF
  1DEB'   B7                    	ORA	A
  1DEC'   C2 22A6'              	JNZ	MSGNWR
  1DEF'                         EE_GO:
  1DEF'   3A 2A74'              	LDA	EXARG
  1DF2'   B7                    	ORA	A
  1DF3'   C2 1DFA'              	JNZ	EE_ARG
  1DF6'   CD 20C3'              	CALL	OWNTF		; no name: the buffer's own
  1DF9'   D8                    	RC
  1DFA'                         EE_ARG:
  1DFA'   CD 20D9'              	CALL	ISOWN
  1DFD'   21 0001               	LXI	H,1
  1E00'   C2 1E07'              	JNZ	EE_LD		; another file: its first line
  1E03'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1E06'   23                    	INX	H		; HL = the cursor's line
  1E07'                         EE_LD:
  1E07'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1E09'   32 2A84'              	STA	MSGWHT
  1E0C'   E5                    	PUSH	H
  1E0D'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1E10'   21 0000*              	LXI	H,TFCB
  1E13'   11 0000*              	LXI	D,FNAME
  1E16'   CD 20EB'              	CALL	COPY12		; the buffer's name
  1E19'   CD 20B0'              	CALL	SRCTF
  1E1C'   CD 0000*              	CALL	REOPEN
  1E1F'   CD 020F'              	CALL	MKCLR		; the marks named the buffer that just went
  1E22'   AF                    	XRA	A
  1E23'   32 2A1C'              	STA	MODF
  1E26'   E1                    	POP	H
  1E27'   2B                    	DCX	H
  1E28'   AF                    	XRA	A
  1E29'   CD 0000*              	CALL	MVLIND		; down to the line
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1E2C'   CD 0A1D'              	CALL	ATEOF
  1E2F'   DC 0A23'              	CC	LASTLN		; past the last line: onto it
  1E32'   CD 0F4F'              	CALL	ZSAVE
  1E35'   C3 1032'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  1E38'                         TFDOS:
  1E38'   C5                    	PUSH	B
  1E39'   11 0080               	LXI	D,CMDTAIL
  1E3C'   0E 1A                 	MVI	C,1AH		; set the DMA
  1E3E'   CD 0005               	CALL	BDOS
  1E41'   C1                    	POP	B
  1E42'   11 0000*              	LXI	D,TFCB
  1E45'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  1E48'                         EXRNG:
  1E48'   2A 2ACF'              	LHLD	SRNG1
  1E4B'   7C                    	MOV	A,H
  1E4C'   B5                    	ORA	L
  1E4D'   37                    	STC
  1E4E'   C8                    	RZ
  1E4F'   2A 2AD1'              	LHLD	SRNG2
  1E52'   EB                    	XCHG
  1E53'   2A 2ACF'              	LHLD	SRNG1
  1E56'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1E59'   D8                    	RC
  1E5A'   EB                    	XCHG			; HL = the last line, DE = the first
  1E5B'   CD 0000*              	CALL	SUBHD
  1E5E'   23                    	INX	H
  1E5F'   22 2AD9'              	SHLD	SLINES
  1E62'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  1E63'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  1E64'                         GOLNX:
  1E64'   E5                    	PUSH	H
  1E65'   CD 0EE3'              	CALL	GOLN
  1E68'   CD 0000*              	CALL	CNTLF
  1E6B'   23                    	INX	H		; the line the cursor came to rest on
  1E6C'   D1                    	POP	D
  1E6D'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  1E70'                         EXSAVP:
  1E70'   CD 0D01'              	CALL	CURRW
  1E73'   32 2A78'              	STA	WPROW
  1E76'   21 2AB0'              	LXI	H,MKPOS
  1E79'   C3 044F'              	JMP	FPSTO
  1E7C'                         EXRSTP:
  1E7C'   CD 0000*              	CALL	CLRCNT
  1E7F'   CD 03CF'              	CALL	MKPAGE		; page until that place is in the window again
  1E82'   CD 0000*              	CALL	GOTO
  1E85'   C3 1DB9'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  1E88'                         PUTBRK:
  1E88'   3E 0D                 	MVI	A,CR
  1E8A'   CD 0000*              	CALL	PUTGAP
  1E8D'   3E 0A                 	MVI	A,LF
  1E8F'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  1E92'                         EX_WR:
  1E92'   3A 2A74'              	LDA	EXARG
  1E95'   B7                    	ORA	A
  1E96'   CA 2294'              	JZ	MSGNFN		; No file name
  1E99'   CD 20D9'              	CALL	ISOWN
  1E9C'   CA 1F3C'              	JZ	EXW_OW
  1E9F'   CD 0000*              	CALL	TEXIST
  1EA2'   32 2ADC'              	STA	RWERR		; nonzero: a file of that name is there
  1EA5'   CA 1EAF'              	JZ	EXW_GO
  1EA8'   3A 2A86'              	LDA	EXBANG
  1EAB'   B7                    	ORA	A
  1EAC'   C2 229A'              	JNZ	MSGEXI		; File exists (! to force)
  1EAF'                         EXW_GO:
  1EAF'   CD 1E48'              	CALL	EXRNG
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1EB2'   DA 1F36'              	JC	EXW_BD
  1EB5'   CD 1E70'              	CALL	EXSAVP
  1EB8'   2A 2ACF'              	LHLD	SRNG1
  1EBB'   CD 1E64'              	CALL	GOLNX
  1EBE'   C2 1F33'              	JNZ	EXW_NL		; the text has no line N
  1EC1'   3A 2ADC'              	LDA	RWERR		; a delete scans the whole directory, there or
  1EC4'   B7                    	ORA	A		;   not: only when TEXIST found one
  1EC5'   0E 13                 	MVI	C,13H
  1EC7'   C4 1E38'              	CNZ	TFDOS		; delete what is there
  1ECA'   0E 16                 	MVI	C,16H
  1ECC'   CD 1E38'              	CALL	TFDOS		; ... and make it
  1ECF'   3C                    	INR	A
  1ED0'   CA 1F25'              	JZ	EXW_FL		; no directory entry left
  1ED3'   3E 80                 	MVI	A,80H
  1ED5'   32 2ADB'              	STA	RWPTR
  1ED8'   AF                    	XRA	A
  1ED9'   32 2ADC'              	STA	RWERR
  1EDC'   2A 2AD9'              	LHLD	SLINES
  1EDF'   CD 0000*              	CALL	SETC0		; that many lines, forward
  1EE2'                         EXW_LP:
  1EE2'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  1EE5'   E5                    	PUSH	H
  1EE6'   EB                    	XCHG
  1EE7'   2A 0000*              	LHLD	GAPEND
  1EEA'   CD 1F42'              	CALL	RWOUT		; the text from the cursor to there
  1EED'   E1                    	POP	H
  1EEE'   3A 2ADC'              	LDA	RWERR
  1EF1'   B7                    	ORA	A
  1EF2'   C2 1F0E'              	JNZ	EXW_EN
  1EF5'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  1EF8'   CD 06A0'              	CALL	CNTTST
  1EFB'   C2 1EE2'              	JNZ	EXW_LP
  1EFE'                         EXW_PD:				; the last record is padded out with ^Z
  1EFE'   3A 2ADB'              	LDA	RWPTR
  1F01'   FE 80                 	CPI	80H
  1F03'   CA 1F0E'              	JZ	EXW_EN
  1F06'   3E 1A                 	MVI	A,CPMEOF
  1F08'   CD 1F4E'              	CALL	RWPUT
  1F0B'   C3 1EFE'              	JMP	EXW_PD
  1F0E'                         EXW_EN:
  1F0E'   0E 10                 	MVI	C,10H
  1F10'   CD 1E38'              	CALL	TFDOS		; close
  1F13'   3A 2ADC'              	LDA	RWERR
  1F16'   B7                    	ORA	A
  1F17'   C2 1F25'              	JNZ	EXW_FL
  1F1A'   CD 1E7C'              	CALL	EXRSTP
  1F1D'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  1F1F'   32 2A84'              	STA	MSGWHT
  1F22'   C3 075A'              	JMP	SETMOV		; nothing on the screen has changed
  1F25'                         EXW_FL:				; no room: the part written is not left behind
  1F25'   0E 13                 	MVI	C,13H
  1F27'   CD 1E38'              	CALL	TFDOS
  1F2A'   CD 1E7C'              	CALL	EXRSTP
  1F2D'   21 2451'              	LXI	H,SDFUL
  1F30'   C3 22CC'              	JMP	EXERR
  1F33'                         EXW_NL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F33'   CD 1E7C'              	CALL	EXRSTP
  1F36'                         EXW_BD:
  1F36'   21 2443'              	LXI	H,SRNGE
  1F39'   C3 22CC'              	JMP	EXERR
  1F3C'                         EXW_OW:
  1F3C'   21 22FB'              	LXI	H,SEXI
  1F3F'   C3 22CC'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  1F42'                         RWOUT:
  1F42'   CD 0000*              	CALL	CMP16
  1F45'   C8                    	RZ
  1F46'   7E                    	MOV	A,M
  1F47'   23                    	INX	H
  1F48'   CD 1F4E'              	CALL	RWPUT
  1F4B'   C3 1F42'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  1F4E'                         RWPUT:
  1F4E'   E5                    	PUSH	H
  1F4F'   F5                    	PUSH	PSW
  1F50'   3A 2ADB'              	LDA	RWPTR
  1F53'   6F                    	MOV	L,A
  1F54'   26 00                 	MVI	H,0
  1F56'   F1                    	POP	PSW
  1F57'   77                    	MOV	M,A
  1F58'   2C                    	INR	L		; Z: that was the record's last byte
  1F59'   7D                    	MOV	A,L
  1F5A'   C2 1F6D'              	JNZ	RWP_ST
  1F5D'   D5                    	PUSH	D
  1F5E'   0E 15                 	MVI	C,15H
  1F60'   CD 1E38'              	CALL	TFDOS		; write it
  1F63'   D1                    	POP	D
  1F64'   B7                    	ORA	A
  1F65'   CA 1F6B'              	JZ	RWP_OK
  1F68'   32 2ADC'              	STA	RWERR
  1F6B'                         RWP_OK:
  1F6B'   3E 80                 	MVI	A,80H
  1F6D'                         RWP_ST:
  1F6D'   32 2ADB'              	STA	RWPTR
  1F70'   E1                    	POP	H
  1F71'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  1F72'                         EX_R:
  1F72'   3A 2A74'              	LDA	EXARG
  1F75'   B7                    	ORA	A
  1F76'   CA 2294'              	JZ	MSGNFN		; No file name
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1F79'   0E 0F                 	MVI	C,0FH
  1F7B'   CD 1E38'              	CALL	TFDOS		; open
  1F7E'   3C                    	INR	A
  1F7F'   CA 204C'              	JZ	ER_NOF
  1F82'   CD 0F75'              	CALL	GZONE		; the screen's top line, before anything moves
  1F85'   CD 1E70'              	CALL	EXSAVP
  1F88'   3A 2ACE'              	LDA	SRNGF
  1F8B'   B7                    	ORA	A
  1F8C'   CA 1FA5'              	JZ	ER_NXT		; no line given: below the cursor's
  1F8F'   2A 2AD1'              	LHLD	SRNG2
  1F92'   7C                    	MOV	A,H
  1F93'   B5                    	ORA	L
  1F94'   C2 1F9F'              	JNZ	ER_LN
  1F97'   23                    	INX	H
  1F98'   CD 0EE3'              	CALL	GOLN		; ':0r': above line 1 ...
  1F9B'   AF                    	XRA	A		;   which never wants a line end put in first
  1F9C'   C3 1FC7'              	JMP	ER_BRK
  1F9F'                         ER_LN:
  1F9F'   CD 1E64'              	CALL	GOLNX
  1FA2'   C2 1F33'              	JNZ	EXW_NL		; the text has no line N
  1FA5'                         ER_NXT:
  1FA5'   21 0001               	LXI	H,1
  1FA8'   AF                    	XRA	A
  1FA9'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  1FAC'   CD 0A1D'              	CALL	ATEOF
  1FAF'   3E 00                 	MVI	A,0
  1FB1'   D2 1FC7'              	JNC	ER_BRK		; text follows
  1FB4'   2A 0000*              	LHLD	GAPBEG
  1FB7'   EB                    	XCHG
  1FB8'   2A 0000*              	LHLD	TXTBEG
  1FBB'   CD 0000*              	CALL	CMP16
  1FBE'   3E 01                 	MVI	A,1
  1FC0'   CA 1FC7'              	JZ	ER_BRK		; nothing before the cursor either
  1FC3'   1B                    	DCX	D
  1FC4'   1A                    	LDAX	D
  1FC5'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  1FC7'                         ER_BRK:
  1FC7'   32 2ADE'              	STA	RDBRK
  1FCA'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  1FCD'   AF                    	XRA	A
  1FCE'   32 2ADD'              	STA	RDANY
  1FD1'                         ER_LP:
  1FD1'   0E 14                 	MVI	C,14H
  1FD3'   CD 1E38'              	CALL	TFDOS		; the next record
  1FD6'   B7                    	ORA	A
  1FD7'   C2 200A'              	JNZ	ER_END
  1FDA'   21 0080               	LXI	H,CMDTAIL
  1FDD'   0E 00                 	MVI	C,0
  1FDF'                         ER_SC:				; C = its bytes, up to a ^Z
  1FDF'   7E                    	MOV	A,M
  1FE0'   FE 1A                 	CPI	CPMEOF
  1FE2'   CA 1FEA'              	JZ	ER_GOT
  1FE5'   23                    	INX	H
  1FE6'   0C                    	INR	C
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1FE7'   F2 1FDF'              	JP	ER_SC		; (minus: all 128)
  1FEA'                         ER_GOT:
  1FEA'   79                    	MOV	A,C
  1FEB'   B7                    	ORA	A
  1FEC'   CA 200A'              	JZ	ER_END
  1FEF'   C5                    	PUSH	B
  1FF0'   3A 2ADD'              	LDA	RDANY
  1FF3'   B7                    	ORA	A
  1FF4'   CC 203B'              	CZ	ER_1ST
  1FF7'   C1                    	POP	B
  1FF8'   06 00                 	MVI	B,0
  1FFA'   11 0080               	LXI	D,CMDTAIL
  1FFD'   C5                    	PUSH	B
  1FFE'   CD 0000*              	CALL	INSBLK
  2001'   C1                    	POP	B
  2002'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  2005'   79                    	MOV	A,C
  2006'   17                    	RAL
  2007'   DA 1FD1'              	JC	ER_LP		; a full record: there may be more
  200A'                         ER_END:
  200A'   3A 2ADD'              	LDA	RDANY
  200D'   B7                    	ORA	A
  200E'   CA 202C'              	JZ	ER_PL		; nothing in the file: nothing has changed
  2011'   CD 0A1D'              	CALL	ATEOF
  2014'   DA 2021'              	JC	ER_MD		; the text now ends as the file read ends
  2017'   2A 0000*              	LHLD	GAPBEG
  201A'   2B                    	DCX	H
  201B'   7E                    	MOV	A,M
  201C'   FE 0A                 	CPI	LF
  201E'   C4 1E88'              	CNZ	PUTBRK		; text follows: what was read ends a line
  2021'                         ER_MD:
  2021'   3E 01                 	MVI	A,1
  2023'   32 2A1C'              	STA	MODF
  2026'   CD 03CF'              	CALL	MKPAGE		; back to the first line read
  2029'   CD 0000*              	CALL	GOTO
  202C'                         ER_PL:
  202C'   CD 0A1D'              	CALL	ATEOF
  202F'   DC 0A23'              	CC	LASTLN		; (nothing read, at the end: the last line)
  2032'   CD 0000*              	CALL	CLRCNT
  2035'   CD 0F8D'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  2038'   C3 077B'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  203B'                         ER_1ST:
  203B'   3C                    	INR	A
  203C'   32 2ADD'              	STA	RDANY
  203F'   3A 2ADE'              	LDA	RDBRK
  2042'   B7                    	ORA	A
  2043'   C4 1E88'              	CNZ	PUTBRK
  2046'   21 2AB0'              	LXI	H,MKPOS
  2049'   C3 044F'              	JMP	FPSTO
  204C'                         ER_NOF:
  204C'   21 2432'              	LXI	H,SNOPN
  204F'   C3 22C1'              	JMP	EXERT
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  2052'                         WRCHK:
  2052'   3A 2A74'              	LDA	EXARG
  2055'   B7                    	ORA	A
  2056'   C2 2060'              	JNZ	WC_ARG
  2059'   CD 20C3'              	CALL	OWNTF
  205C'   D8                    	RC
  205D'   C3 2075'              	JMP	WC_OWN
  2060'                         WC_ARG:
  2060'   CD 20D9'              	CALL	ISOWN
  2063'   CA 2075'              	JZ	WC_OWN
  2066'   3A 2A86'              	LDA	EXBANG
  2069'   B7                    	ORA	A
  206A'   CA 2073'              	JZ	WC_OTH
  206D'   CD 0000*              	CALL	TEXIST
  2070'   C2 229A'              	JNZ	MSGEXI		; File exists (! to force)
  2073'                         WC_OTH:
  2073'   AF                    	XRA	A		; (NC)
  2074'   C9                    	RET
  2075'                         WC_OWN:
  2075'   3A 2A87'              	LDA	ROFLAG		; '-R': this is the file it may not write
  2078'   B7                    	ORA	A
  2079'   CA 2083'              	JZ	WC_OK
  207C'   3A 2A86'              	LDA	EXBANG
  207F'   B7                    	ORA	A
  2080'   C2 22A0'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  2083'                         WC_OK:
  2083'   3E 01                 	MVI	A,1
  2085'   B7                    	ORA	A		; (NC)
  2086'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  2087'                         WRITE:
  2087'   3A 2A75'              	LDA	EXBAK
  208A'   CD 0000*              	CALL	WRTO
  208D'   3A 0001*              	LDA	FNAME+1
  2090'   FE 20                 	CPI	' '
  2092'   C2 209E'              	JNZ	WR_HAS
  2095'   21 0000*              	LXI	H,TFCB
  2098'   11 0000*              	LXI	D,FNAME
  209B'   CD 20EB'              	CALL	COPY12
  209E'                         WR_HAS:
  209E'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  20A0'   32 2A84'              	STA	MSGWHT
  20A3'   CD 20D9'              	CALL	ISOWN
  20A6'   C2 20B0'              	JNZ	SRCTF
  20A9'   AF                    	XRA	A
  20AA'   32 2A1C'              	STA	MODF
  20AD'   32 2A85'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  20B0'                         SRCTF:
  20B0'   21 0000*              	LXI	H,TFCB
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  20B3'   11 005C               	LXI	D,DFTFCB
  20B6'   CD 20EB'              	CALL	COPY12
  20B9'   AF                    	XRA	A
  20BA'   06 04                 	MVI	B,4
  20BC'                         SRC_Z:
  20BC'   12                    	STAX	D		; extent, s1, s2, record count: 0
  20BD'   13                    	INX	D
  20BE'   05                    	DCR	B
  20BF'   C2 20BC'              	JNZ	SRC_Z
  20C2'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  20C3'                         OWNTF:
  20C3'   3A 0001*              	LDA	FNAME+1
  20C6'   FE 20                 	CPI	' '
  20C8'   CA 2294'              	JZ	MSGNFN
  20CB'   CD 20F6'              	CALL	TFCLR
  20CE'   21 0000*              	LXI	H,FNAME
  20D1'   11 0000*              	LXI	D,TFCB
  20D4'   CD 20EB'              	CALL	COPY12
  20D7'   B7                    	ORA	A		; (NC)
  20D8'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  20D9'                         ISOWN:
  20D9'   21 0000*              	LXI	H,TFCB
  20DC'   11 0000*              	LXI	D,FNAME
  20DF'   06 0C                 	MVI	B,12
  20E1'                         IO_LP:
  20E1'   1A                    	LDAX	D
  20E2'   BE                    	CMP	M
  20E3'   C0                    	RNZ
  20E4'   23                    	INX	H
  20E5'   13                    	INX	D
  20E6'   05                    	DCR	B
  20E7'   C2 20E1'              	JNZ	IO_LP
  20EA'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  20EB'                         COPY12:
  20EB'   06 0C                 	MVI	B,12
  20ED'                         CP_LP:
  20ED'   7E                    	MOV	A,M
  20EE'   12                    	STAX	D
  20EF'   23                    	INX	H
  20F0'   13                    	INX	D
  20F1'   05                    	DCR	B
  20F2'   C2 20ED'              	JNZ	CP_LP
  20F5'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  20F6'                         TFCLR:
  20F6'   11 0000*              	LXI	D,TFCB
  20F9'   06 24                 	MVI	B,36
  20FB'   AF                    	XRA	A
  20FC'                         TC_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  20FC'   12                    	STAX	D
  20FD'   13                    	INX	D
  20FE'   05                    	DCR	B
  20FF'   C2 20FC'              	JNZ	TC_LP
  2102'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  2103'                         FOPEN:
  2103'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  2105'   32 2A84'              	STA	MSGWHT
  2108'   21 005C               	LXI	H,DFTFCB
  210B'   CD 21DD'              	CALL	NRMDRV
  210E'   11 0000*              	LXI	D,FNAME
  2111'   CD 20EB'              	CALL	COPY12
  2114'   CD 0000*              	CALL	OPENZ
  2117'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  211A'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  211C'   C8                    	RZ
  211D'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  2120'   32 2A85'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  2123'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  2124'                         ARGSCN:
  2124'   3A 0080               	LDA	CMDTAIL
  2127'   47                    	MOV	B,A		; B = what is left of the line
  2128'   B7                    	ORA	A
  2129'   C8                    	RZ
  212A'   21 0081               	LXI	H,CMDTAIL+1
  212D'                         AS_TOK:				; at a token, or the blanks before one
  212D'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  212E'   FE 20                 	CPI	' '
  2130'   C2 2139'              	JNZ	AS_OPT
  2133'   23                    	INX	H
  2134'   05                    	DCR	B
  2135'   C2 212D'              	JNZ	AS_TOK
  2138'   C9                    	RET
  2139'                         AS_OPT:
  2139'   FE 2B                 	CPI	'+'
  213B'   CA 2165'              	JZ	AS_PLS
  213E'   FE 2D                 	CPI	'-'
  2140'   CA 2154'              	JZ	AS_SW
  2143'   FE 2F                 	CPI	'/'
  2145'   CA 2154'              	JZ	AS_SW
  2148'                         AS_SKP:				; not ours (the file name): on to the next one
  2148'   23                    	INX	H
  2149'   05                    	DCR	B
  214A'   C8                    	RZ
  214B'   7E                    	MOV	A,M
  214C'   FE 20                 	CPI	' '
  214E'   C2 2148'              	JNZ	AS_SKP
  2151'   C3 212D'              	JMP	AS_TOK
  2154'                         AS_SW:
  2154'   23                    	INX	H
  2155'   05                    	DCR	B
  2156'   C8                    	RZ
  2157'   7E                    	MOV	A,M
  2158'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  215A'   FE 52                 	CPI	'R'
  215C'   C2 2148'              	JNZ	AS_SKP
  215F'   32 2A87'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  2162'   C3 2148'              	JMP	AS_SKP
  2165'                         AS_PLS:
  2165'   3E 01                 	MVI	A,1
  2167'   32 2A88'              	STA	PLUSF		; '+' gets the line even with no number on it
  216A'   11 0000*              	LXI	D,PLUSB
  216D'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  216F'   23                    	INX	H		;   line space, so it is taken as '+' alone
  2170'   05                    	DCR	B
  2171'   CA 21A8'              	JZ	AS_PE
  2174'   7E                    	MOV	A,M
  2175'   FE 30                 	CPI	'0'
  2177'   C2 218F'              	JNZ	AS_PD
  217A'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  217A'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  217B'   05                    	DCR	B
  217C'   CA 21B0'              	JZ	AS_P1
  217F'   7E                    	MOV	A,M
  2180'   FE 30                 	CPI	'0'
  2182'   CA 217A'              	JZ	AS_PZ
  2185'   FE 31                 	CPI	'1'
  2187'   DA 21B0'              	JC	AS_P1		; zeros and then no digit at all: line 1
  218A'   FE 3A                 	CPI	'9'+1
  218C'   D2 21B0'              	JNC	AS_P1
  218F'                         AS_PD:				; the digits, as typed
  218F'   7E                    	MOV	A,M
  2190'   FE 30                 	CPI	'0'
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  2192'   DA 21A8'              	JC	AS_PE
  2195'   FE 3A                 	CPI	'9'+1
  2197'   D2 21A8'              	JNC	AS_PE
  219A'   79                    	MOV	A,C
  219B'   B7                    	ORA	A
  219C'   CA 21B7'              	JZ	AS_POV
  219F'   0D                    	DCR	C
  21A0'   7E                    	MOV	A,M
  21A1'   12                    	STAX	D
  21A2'   13                    	INX	D
  21A3'   23                    	INX	H
  21A4'   05                    	DCR	B
  21A5'   C2 218F'              	JNZ	AS_PD
  21A8'                         AS_PE:
  21A8'   AF                    	XRA	A
  21A9'   12                    	STAX	D		; the digits end with a 0
  21AA'   78                    	MOV	A,B
  21AB'   B7                    	ORA	A
  21AC'   C8                    	RZ
  21AD'   C3 212D'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  21B0'                         AS_P1:
  21B0'   3E 31                 	MVI	A,'1'
  21B2'   12                    	STAX	D
  21B3'   13                    	INX	D
  21B4'   C3 21A8'              	JMP	AS_PE
  21B7'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  21B7'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  21BA'   C3 21A8'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  21BD'                         ARGGO:
  21BD'   3A 2A88'              	LDA	PLUSF
  21C0'   B7                    	ORA	A
  21C1'   C8                    	RZ
  21C2'   21 0000*              	LXI	H,PLUSB
  21C5'                         AG_LP:
  21C5'   7E                    	MOV	A,M
  21C6'   B7                    	ORA	A
  21C7'   CA 21D6'              	JZ	AG_G
  21CA'   4F                    	MOV	C,A
  21CB'   06 02                 	MVI	B,KT_CHAR
  21CD'   E5                    	PUSH	H
  21CE'   CD 0023'              	CALL	VICMD
  21D1'   E1                    	POP	H
  21D2'   23                    	INX	H
  21D3'   C3 21C5'              	JMP	AG_LP
  21D6'                         AG_G:
  21D6'   0E 47                 	MVI	C,'G'
  21D8'   06 02                 	MVI	B,KT_CHAR
  21DA'   C3 0023'              	JMP	VICMD
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  21DD'                         NRMDRV:
  21DD'   7E                    	MOV	A,M
  21DE'   B7                    	ORA	A
  21DF'   C0                    	RNZ
  21E0'   E5                    	PUSH	H
  21E1'   0E 19                 	MVI	C,BF_CURDSK
  21E3'   CD 0005               	CALL	BDOS
  21E6'   E1                    	POP	H
  21E7'   3C                    	INR	A
  21E8'   77                    	MOV	M,A
  21E9'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  21EA'                         PARSFN:
  21EA'   CD 20F6'              	CALL	TFCLR
  21ED'   11 0000*              	LXI	D,TFCB
  21F0'   23                    	INX	H
  21F1'   7E                    	MOV	A,M
  21F2'   2B                    	DCX	H
  21F3'   FE 3A                 	CPI	':'
  21F5'   C2 2207'              	JNZ	PF_NM
  21F8'   CD 224D'              	CALL	GETFNC
  21FB'   CA 2207'              	JZ	PF_NM
  21FE'   D6 40                 	SUI	40H
  2200'   12                    	STAX	D
  2201'   FE 11                 	CPI	17
  2203'   D2 222B'              	JNC	PF_BAD
  2206'   23                    	INX	H
  2207'                         PF_NM:
  2207'   13                    	INX	D
  2208'   0E 08                 	MVI	C,8
  220A'   CD 222F'              	CALL	CPYNAM
  220D'   FE 2E                 	CPI	'.'
  220F'   0E 03                 	MVI	C,3
  2211'   C4 2242'              	CNZ	PADFLD		; no type: blanks
  2214'   CC 222E'              	CZ	CPYNM0		; '.': the type
  2217'   3A 0001*              	LDA	TFCB+1
  221A'   FE 20                 	CPI	' '
  221C'   CA 222B'              	JZ	PF_BAD		; no name
  221F'   CD 2280'              	CALL	SKIPB
  2222'   C0                    	RNZ			; more after it
  2223'   21 0000*              	LXI	H,TFCB
  2226'   CD 21DD'              	CALL	NRMDRV
  2229'   AF                    	XRA	A
  222A'   C9                    	RET
  222B'                         PF_BAD:
  222B'   F6 01                 	ORI	1
  222D'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  222E'                         CPYNM0:
  222E'   23                    	INX	H
  222F'                         CPYNAM:
  222F'   CD 224D'              	CALL	GETFNC
  2232'   CA 2242'              	JZ	PADFLD
  2235'   12                    	STAX	D
  2236'   13                    	INX	D
  2237'   0D                    	DCR	C
  2238'   C2 222F'              	JNZ	CPYNAM
  223B'                         CN_SKP:
  223B'   CD 224D'              	CALL	GETFNC
  223E'   C2 223B'              	JNZ	CN_SKP
  2241'   C9                    	RET
  2242'                         PADFLD:
  2242'   F5                    	PUSH	PSW
  2243'                         PD_LP:
  2243'   3E 20                 	MVI	A,' '
  2245'   12                    	STAX	D
  2246'   13                    	INX	D
  2247'   0D                    	DCR	C
  2248'   C2 2243'              	JNZ	PD_LP
  224B'   F1                    	POP	PSW
  224C'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  224D'                         GETFNC:
  224D'   7E                    	MOV	A,M
  224E'   FE 3D                 	CPI	'='
  2250'   C8                    	RZ
  2251'   FE 5F                 	CPI	'_'
  2253'   C8                    	RZ
  2254'   FE 3B                 	CPI	';'
  2256'   C8                    	RZ
  2257'   FE 3C                 	CPI	'<'
  2259'   C8                    	RZ
  225A'   FE 3E                 	CPI	'>'
  225C'   C8                    	RZ
  225D'   FE 2E                 	CPI	'.'
  225F'   C8                    	RZ
  2260'   FE 3A                 	CPI	':'
  2262'   C8                    	RZ
  2263'   FE 2A                 	CPI	'*'
  2265'   C8                    	RZ
  2266'   FE 3F                 	CPI	'?'
  2268'   C8                    	RZ
  2269'   FE 20                 	CPI	' '
  226B'   DA 227E'              	JC	GF_CTL
  226E'   C8                    	RZ
  226F'   23                    	INX	H
  2270'   FE 61                 	CPI	'a'
  2272'   DA 227C'              	JC	GF_DN
  2275'   FE 7B                 	CPI	'z'+1
  2277'   D2 227C'              	JNC	GF_DN
