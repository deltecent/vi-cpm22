  2ABC'   0874'                 	DW	VC_0
  2ABE'   06                    	DB	ACT_LINEN
  2ABF'   08D0'                 	DW	VC_EOL
  2AC1'   07                    	DB	ACT_PGUP
  2AC2'   0E18'                 	DW	VC_PGUP
  2AC4'   08                    	DB	ACT_PGDN
  2AC5'   0DEB'                 	DW	VC_PGDN
  2AC7'   00                    	DB	0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  2AC8'   00                    EDMODE: DB	EM_CMD
  2AC9'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  2ACB'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  2ACC'   00                    MODF:	DB	0		; 1 = unsaved changes
  2ACD'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  2ACE'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  2ACF'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  2AD0'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  2AD1'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  2AD3'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  2AD4'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  2AD5'   00                    HFROW:	DB	0		; ^D/^U: the cursor's row before the move
  2AD6'   00                    HFAMT:	DB	0		; ^D/^U: lines (vim's 'scroll'); 0 = NEDIT/2
  2AD7'   0000                  JKCNT:	DW	0		; j/k: count
  2AD9'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  2ADB'   0000                  JKMOV:	DW	0		; j: lines moved
  2ADD'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  2ADF'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  2AE0'   00                    JKLST:	DB	0		; j: last byte of the scan
  2AE1'   0000                  JKVC:	DW	0		; j/k landing: screen column
  2AE3'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  2AE5'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  2AE6'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  2AE7'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  2AE8'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  2AE9'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  2AEA'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  2AEC'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  2AED'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  2AEE'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  2AF0'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  2AF1'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  2AF2'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  2AF3'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
	MACRO-80 3.44	09-Dec-81	PAGE	1-132


  2AF4'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  2AF5'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  2AF6'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   and its first word is yet to be stepped
  2AF7'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  2AF9'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  2AFB'   00 00 00              OPSFP:	DB	0,0,0		; operator: the start as a place in the file
  2AFE'   00 00 00              OPSLO:	DB	0,0,0		; ... where its line starts
  2B01'   00 00 00              OPSHI:	DB	0,0,0		; ... where the next line does (OPPGD: the span's
                                				;   high end, whichever line that turned out to be)
  2B04'   00 00 00              OPTOGO: DB	0,0,0		; OPPGD: bytes still to take
  2B07'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  2B09'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  2B0B'   0000                  CNTV:	DW	0		; motion repeat counter
  2B0D'   0000                  TTI:	DW	0		; TAILTAB scan index
  2B0F'   0000                  WKI:	DW	0		; scan index
  2B11'   0000                  WKN:	DW	0		; cached LOGLEN
  2B13'   0000                  WKTERM: DW	0		; line terminator offset
  2B15'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  2B17'   00                    WKCLS:	DB	0		; word motion: class of the current run
  2B18'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  2B19'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  2B1B'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  2B1D'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
  2B1F'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  2B21'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  2B22'   00                    RLMAX:	DB	0		; RDLINE: capacity
  2B23'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  2B24'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  2B25'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  2B26'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  2B28'   00                    WPROW:	DB	0		; :w -- the cursor's row
  2B29'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  2B2A'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2B2C'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  2B2E'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  2B2F'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  2B31'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  2B33'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  2B34'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  2B35'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  2B36'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  2B37'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  2B38'   00                    PLUSF:	DB	0		; command line: '+' was given
  2B39'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  2B3A'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  2B3B'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  2B3C'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  2B3E'   0000                  YPT:	DW	0		; yy: where the lines came from
  2B40'   0000                  PCNT:	DW	0		; p/P: copies still to put
  2B42'   00 00 00              PPFP:	DB	0,0,0		; p/P: the first line put, a file position
  2B45'   0000                  PLFS:	DW	0		; p/P: the lines in the register
	MACRO-80 3.44	09-Dec-81	PAGE	1-133


  2B47'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  2B48'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  2B4A'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  2B4B'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  2B4C'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  2B4D'   00                    FNDKND: DB	0		; f/F/t/T: which find ';' repeats (0 = none yet)
  2B4E'   00                    FNDCH:	DB	0		; ... and the character it looked for
  2B4F'   00                    FNDRUN: DB	0		; the find THIS command is running (',' reverses)
  2B50'   00                    FNDSTP: DB	0		; how far along it starts: 2 for a 't' repeat
  2B51'   0000                  FNDN:	DW	0		; occurrences still to count off
  2B53'   0000                  FNDCUR: DW	0		; the cursor it started from
  2B55'   0000                  FNDLIM: DW	0		; ... and the end of the line it may not pass
  2B57'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  2B58'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  2B5B'   00 00 00              MKEDIT: DB	0,0,0		; MKSHFT: where in the file the edit is
  2B5E'   0000                  MKN:	DW	0		; ... how long it is
  2B60'   00                    MKTYP:	DB	0		; ... and which way: 1 text went in, 2 came out
  2B61'   00 00 00              MKPOS:	DB	0,0,0		; MKJMP: the file position being jumped to
  2B64'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  2B65'   00                    MKHOLD: DB	0		; set across YKGO's delete + put back (a yank
                                				;   that could not copy): MKSHFT must leave the
                                				;   marks alone through it
  2B66'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  2B68'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  2B6A'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  2B6C'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  2B6E'   00 00 00              YPFP:	DB	0,0,0		; ... and where in the file they start
                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  2B71'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  2B73'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
  2B75'   0000                  SCNT:	DW	0		; searches still to do (the count)
  2B77'   00 00 00              SOFF:	DB	0,0,0		; BRKON: where in the FILE the command began
  2B7A'   0000                  SLDLT:	DW	0		; ... and LNDLT: for a search that fails, and
                                				;   any move a ^C stops
  2B7C'   00                    BRKARM: DB	0		; nonzero: CNTTST looks for a ^C
  2B7D'   00                    BRKHIT: DB	0		; nonzero: one was found, and the count spent
  2B7E'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  2B7F'   00                    SRNGF:	DB	0		; ex: a line range was given
  2B80'   0000                  SRNG1:	DW	0		; ex: its first line
  2B82'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  2B84'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  2B85'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
	MACRO-80 3.44	09-Dec-81	PAGE	1-134


  2B86'   00                    SANY:	DB	0		; ':s' something in the range has changed
  2B87'   00                    SLCHG:	DB	0		; ':s' this line changed
  2B88'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  2B8A'   0000                  SLINES: DW	0		; ':s' / ':N,Mw' lines of the range still to do
  2B8C'   00                    RWPTR:	DB	0		; ':N,Mw' the next free byte of the record at
                                				;   0080H, as that address's low byte
  2B8D'   00                    RWERR:	DB	0		; ':N,Mw' a record would not go: the disk is full
  2B8E'   00                    RDANY:	DB	0		; ':r' something has been read in
  2B8F'   00                    RDBRK:	DB	0		; ':r' the line above wants a line end first
  2B90'   00 00 00              SOFFS:	DB	0,0,0		; ':s' the cursor's place in the file, for one that
  2B93'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  2B95'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  2B96'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
