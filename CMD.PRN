  2DB8'   1DD1'                 	DW	VCB_P
  2DBA'   69                    	DB	'i'
  2DBB'   18FA'                 	DW	VC_I
  2DBD'   61                    	DB	'a'
  2DBE'   1900'                 	DW	VC_A
  2DC0'   41                    	DB	'A'
  2DC1'   1920'                 	DW	VCB_A
  2DC3'   49                    	DB	'I'
  2DC4'   193C'                 	DW	VCB_I
  2DC6'   72                    	DB	'r'
  2DC7'   1A7E'                 	DW	VC_R
