  1885'   2A 22CF'              	LHLD	WPREC
  1888'   EB                    	XCHG
  1889'   3A 22CE'              	LDA	WPBYT
  188C'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  188F'   CD 0000*              	CALL	GOTO
