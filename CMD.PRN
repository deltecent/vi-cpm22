  1074'   23                    	INX	H
  1075'   23                    	INX	H
  1076'                         OV_UP:
  1076'   2B                    	DCX	H
  1077'   C9                    	RET
                                
                                ;PGROWS -- A = the rows of a page: RWR = the count (in RWR) of them, and no
                                ; line gone past yet (RWMV).
  1078'                         PGROWS:
  1078'   2A 0000*              	LHLD	RWR
  107B'   CD 1086'              	CALL	MULSAT
  107E'   22 0000*              	SHLD	RWR
  1081'   AF                    	XRA	A
  1082'   32 0000*              	STA	RWMV
  1085'   C9                    	RET
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  1086'                         MULSAT:
  1086'   EB                    	XCHG
  1087'   21 0000               	LXI	H,0
  108A'   B7                    	ORA	A
  108B'   C8                    	RZ
