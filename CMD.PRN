                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the current row is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
                         C      ; PLACE -- what a command asks of the next layout (SCRN.MAC), cleared by it.
  0000                   C      PL_ASK	EQU	0		; the cursor only moved: is its line on the screen
                         C      				;   still, near it, or far off? (vim's rule)
  0001                   C      PL_SET	EQU	1		; the command set the lines above it (WINROW)
  0002                   C      PL_MID	EQU	2		; mid-screen, as the rows fall
                         C      
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; current line changed only -> redraw that one row
  0003                   C      R_DLIN	EQU	3		; one line deleted at the cursor row -> DL + redraw bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted mid-line -> ICH (no tail redraw)
  0005                   C      R_ILIN	EQU	5		; one line opened at the cursor row -> IL + redraw that row and the one above
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw that row + DL the one under it
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	COL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	MKSHFT				; the marks follow an edit (VI.MAC hooks it)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	HTN, HTCUR, HTEOF, HTBOF	; the row table's facts (SCRN.MAC HTBLD)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	KBBRK, KBFLSH			; KEY.MAC -- an ESC waiting / drop type-ahead
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	MKSAV				; ... and a refused 'dd's copy of them
                                	EXTRN	MKUND				; ... and the copy 'u' puts back
                                	EXTRN	UNDST, UNDNEW			; BUF.MAC -- undone or not; no change yet
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
                                	EXTRN	UNDCLR				; ... nothing to undo
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	INSBLK, UNDINS			; BUF.MAC -- a block in at the cursor (':r')
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
                                	EXTRN	SCBOT, SCEOF, SCBOF, PLACE	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	SKIPR, TALLF		; a top line taller than the screen
                                	EXTRN	TXEND, CSUB, HTBLD		; ... its rows of text, the cursor's row
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                						;   in its line, and the row table
                                	EXTRN	HTAB				; RSV.MAC -- the row table itself
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	SETC0				; BUF.MAC -- WM count set, forward
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GOLINE				; BUF.MAC -- WM 2228 (a mark's page loop)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   AF                    	XRA	A		; no command is ever left open to an ESC by the
  0001'   32 2DD3'              	STA	BRKARM		;   one before it (BRKON)
  0004'   CD 00D7'              	CALL	DOTPRE
  0007'   CD 000D'              	CALL	CDMODE
  000A'   C3 011C'              	JMP	DOTPOST
  000D'                         CDMODE:
  000D'   3A 2D14'              	LDA	EDMODE
  0010'   FE 01                 	CPI	EM_INS
  0012'   CA 001D'              	JZ	CD_INS
  0015'   FE 02                 	CPI	EM_REP
  0017'   CA 0020'              	JZ	CD_REP
  001A'   C3 0023'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  001D'                         CD_INS:
  001D'   C3 1E80'              	JMP	VIINS
  0020'                         CD_REP:
  0020'   C3 1DC4'              	JMP	VIREP
                                
                                ;============================================================
                                ; VICMD -- command-mode key.  C = the key.
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  0023'                         VICMD:
  0023'   79                    	MOV	A,C
  0024'   FE 1B                 	CPI	ESC
  0026'   CA 00AC'              	JZ	VIC_ESC
  0029'   3A 2D47'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002C'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  002E'   CA 19B3'              	JZ	VR_DO
                                	;--- maybe a count digit ---
  0031'   79                    	MOV	A,C
  0032'   FE 31                 	CPI	'1'
  0034'   DA 003F'              	JC	VIC_NOTD	; < '1'
  0037'   FE 3A                 	CPI	'9'+1
  0039'   D2 003F'              	JNC	VIC_NOTD	; > '9'
  003C'   C3 004F'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  003F'                         VIC_NOTD:
  003F'   79                    	MOV	A,C
  0040'   FE 30                 	CPI	'0'
  0042'   C2 0077'              	JNZ	VICDSP
  0045'   2A 2D15'              	LHLD	CMDCNT
  0048'   7C                    	MOV	A,H
  0049'   B5                    	ORA	L
  004A'   CA 0077'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  004D'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  004F'                         VICDIG:
  004F'   2A 2D15'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0052'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0053'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0054'   29                    	DAD	H		; *2
  0055'   DA 006E'              	JC	VIC_SAT
  0058'   29                    	DAD	H		; *4
  0059'   DA 006E'              	JC	VIC_SAT
  005C'   19                    	DAD	D		; *5
  005D'   DA 006E'              	JC	VIC_SAT
  0060'   29                    	DAD	H		; *10
  0061'   DA 006E'              	JC	VIC_SAT
  0064'   79                    	MOV	A,C
  0065'   D6 30                 	SUI	'0'
  0067'   5F                    	MOV	E,A
  0068'   16 00                 	MVI	D,0
  006A'   19                    	DAD	D
  006B'   D2 0071'              	JNC	VIC_CNT
  006E'                         VIC_SAT:
  006E'   21 FFFF               	LXI	H,0FFFFH
  0071'                         VIC_CNT:
  0071'   22 2D15'              	SHLD	CMDCNT
  0074'   C3 07A0'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  0077'                         VICDSP:
  0077'   3A 2D47'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  007A'   32 2D48'              	STA	GSAVE
  007D'   AF                    	XRA	A
  007E'   32 2D47'              	STA	GPEND
  0081'   3A 2D49'              	LDA	PENDOP
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  0084'   32 2D4A'              	STA	PSAVE
  0087'   AF                    	XRA	A
  0088'   32 2D49'              	STA	PENDOP
  008B'   3A 2D4A'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  008E'   B7                    	ORA	A
  008F'   C2 1348'              	JNZ	OPPEND
  0092'   3A 2D48'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0095'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  0097'   C2 00A0'              	JNZ	VIC_TB
  009A'   79                    	MOV	A,C
  009B'   FE 5A                 	CPI	'Z'
  009D'   C2 00A6'              	JNZ	VIC_SW
  00A0'                         VIC_TB:
  00A0'   21 2C5C'              	LXI	H,CMDTAB
  00A3'   C3 00BC'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A6'                         VIC_SW:
  00A6'   CD 07A0'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00A9'   C3 06CB'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AC'                         VIC_ESC:
  00AC'   AF                    	XRA	A		; ESC drops whatever was pending, the count too
  00AD'   32 2D47'              	STA	GPEND
  00B0'   32 2D48'              	STA	GSAVE
  00B3'   32 2D49'              	STA	PENDOP
  00B6'   32 2D4A'              	STA	PSAVE
  00B9'   C3 00A6'              	JMP	VIC_SW
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the TOP-LEVEL key table, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00BC'                         VSCANQ:
  00BC'   CD 00C8'              	CALL	VSCLK
  00BF'   CA 00A6'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C2'   E9                    	PCHL
  00C3'                         VSCAN:
  00C3'   CD 00C8'              	CALL	VSCLK
  00C6'   C8                    	RZ			; miss
  00C7'   E9                    	PCHL
  00C8'                         VSCLK:
  00C8'   7E                    VSCAN1: MOV	A,M
  00C9'   B7                    	ORA	A
  00CA'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00CB'   23                    	INX	H
  00CC'   B9                    	CMP	C
  00CD'   5E                    	MOV	E,M
  00CE'   23                    	INX	H
  00CF'   56                    	MOV	D,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00D0'   23                    	INX	H
  00D1'   C2 00C8'              	JNZ	VSCAN1
  00D4'   EB                    	XCHG			; HL = the handler
  00D5'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00D6'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00D7'                         DOTPRE:
  00D7'   3A 2D3E'              	LDA	DOTRPL
  00DA'   B7                    	ORA	A
  00DB'   C0                    	RNZ			; the replay's own keys are not recorded
  00DC'   C5                    	PUSH	B
  00DD'   D5                    	PUSH	D
  00DE'   E5                    	PUSH	H
  00DF'   3A 2D3D'              	LDA	DOTSTA
  00E2'   B7                    	ORA	A
  00E3'   CA 00F6'              	JZ	DOTP1
  00E6'   AF                    	XRA	A		; a new command: the recording starts over
  00E7'   32 2D3D'              	STA	DOTSTA
  00EA'   32 2D3F'              	STA	DOTOVF
  00ED'   21 0000*              	LXI	H,DOTSCR
  00F0'   22 2D41'              	SHLD	DOTSP
  00F3'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00F6'                         DOTP1:
  00F6'   79                    	MOV	A,C
  00F7'   32 2D40'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  00FA'   47                    	MOV	B,A
  00FB'   2A 2D41'              	LHLD	DOTSP
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00FE'   EB                    	XCHG
  00FF'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  0102'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  0105'   D2 0114'              	JNC	DOTPOV
  0108'   2A 2D41'              	LHLD	DOTSP
  010B'   70                    	MOV	M,B
  010C'   23                    	INX	H
  010D'   22 2D41'              	SHLD	DOTSP
  0110'                         DOTPX:
  0110'   E1                    	POP	H
  0111'   D1                    	POP	D
  0112'   C1                    	POP	B
  0113'   C9                    	RET
  0114'                         DOTPOV:
  0114'   3E 01                 	MVI	A,1
  0116'   32 2D3F'              	STA	DOTOVF		; too long to record: give this recording up
  0119'   C3 0110'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  011C'                         DOTPOST:
  011C'   3A 2D3E'              	LDA	DOTRPL
  011F'   B7                    	ORA	A
  0120'   C0                    	RNZ
  0121'   3A 2D14'              	LDA	EDMODE
  0124'   B7                    	ORA	A
  0125'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  0126'   3A 2D47'              	LDA	GPEND
  0129'   B7                    	ORA	A
  012A'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  012B'   3A 2D49'              	LDA	PENDOP
  012E'   B7                    	ORA	A
  012F'   C0                    	RNZ			; an operator still waiting for its motion
  0130'   2A 2D15'              	LHLD	CMDCNT
  0133'   7C                    	MOV	A,H
  0134'   B5                    	ORA	L
  0135'   CA 0143'              	JZ	DOTQ1
  0138'   3A 2D40'              	LDA	DOTLK		; a digit with the count still up: the command
  013B'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  013D'   DA 0143'              	JC	DOTQ1
  0140'   FE 3A                 	CPI	'9'+1
  0142'   D8                    	RC
  0143'                         DOTQ1:
  0143'   3E 01                 	MVI	A,1
  0145'   32 2D3D'              	STA	DOTSTA		; the next key starts a new recording
  0148'   3A 2D3C'              	LDA	DOTCHG
  014B'   B7                    	ORA	A
  014C'   C8                    	RZ			; changed nothing: not a repeatable command
  014D'   AF                    	XRA	A
  014E'   32 2D3C'              	STA	DOTCHG
  0151'   32 2D43'              	STA	DOTLEN
  0154'   3A 2D3F'              	LDA	DOTOVF
  0157'   B7                    	ORA	A
  0158'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  0159'   2A 2D41'              	LHLD	DOTSP
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  015C'   11 0000*              	LXI	D,DOTSCR
  015F'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  0162'   7D                    	MOV	A,L
  0163'   32 2D43'              	STA	DOTLEN
  0166'   B7                    	ORA	A
  0167'   C8                    	RZ
  0168'   4F                    	MOV	C,A
  0169'   06 00                 	MVI	B,0
  016B'   21 0000*              	LXI	H,DOTSCR
  016E'   11 0000*              	LXI	D,DOTBUF
  0171'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  0174'                         MARKMOD:
  0174'   3E 01                 	MVI	A,1
  0176'   32 2D18'              	STA	MODF
  0179'   32 2D3C'              	STA	DOTCHG
  017C'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  017D'                         VC_DOT:
  017D'   2A 2D15'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0180'   22 2D45'              	SHLD	DOTNCT
  0183'   21 0000               	LXI	H,0
  0186'   22 2D15'              	SHLD	CMDCNT
  0189'   3A 2D43'              	LDA	DOTLEN
  018C'   B7                    	ORA	A
  018D'   CA 01DC'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
  0190'   AF                    	XRA	A
  0191'   32 2D44'              	STA	DOTIX
  0194'   2A 2D45'              	LHLD	DOTNCT
  0197'   7C                    	MOV	A,H
  0198'   B5                    	ORA	L
  0199'   CA 01B9'              	JZ	DOTGO
  019C'   22 2D15'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  019F'                         DOTSKP:
  019F'   CD 05A4'              	CALL	DOTGET		; ... so step past the digits it recorded
  01A2'   DA 01B9'              	JC	DOTGO
  01A5'   FE 30                 	CPI	'0'
  01A7'   DA 01B9'              	JC	DOTGO
  01AA'   FE 3A                 	CPI	'9'+1
  01AC'   D2 01B9'              	JNC	DOTGO
  01AF'   3A 2D44'              	LDA	DOTIX
  01B2'   3C                    	INR	A
  01B3'   32 2D44'              	STA	DOTIX
  01B6'   C3 019F'              	JMP	DOTSKP
  01B9'                         DOTGO:
  01B9'   3E 01                 	MVI	A,1
  01BB'   32 2D3E'              	STA	DOTRPL
  01BE'                         DOTLP:
  01BE'   CD 05A4'              	CALL	DOTGET
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01C1'   DA 01D2'              	JC	DOTDN
  01C4'   4F                    	MOV	C,A
  01C5'   3A 2D44'              	LDA	DOTIX
  01C8'   3C                    	INR	A
  01C9'   32 2D44'              	STA	DOTIX
  01CC'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01CF'   C3 01BE'              	JMP	DOTLP
  01D2'                         DOTDN:
  01D2'   AF                    	XRA	A
  01D3'   32 2D3E'              	STA	DOTRPL
  01D6'   32 2D3C'              	STA	DOTCHG		; the '.' is not itself the new last change
  01D9'   C3 07C1'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01DC'                         DOTBEL:
  01DC'   0E 07                 	MVI	C,BEL
  01DE'   CD 0000*              	CALL	BCONOU
  01E1'   C3 07A0'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a 3-byte position in the FILE (FPOS: the records paged out ahead
                                ; of the window, plus the offset into it), so it does not care which part of
                                ; the file is resident: a jump pages until the window holds it (MKPAGE).  It
                                ; FOLLOWS its text, as vim's does: every edit passes MKSHFT, which moves the
                                ; marks past it by the bytes that went in or came out.
                                ;
                                ; DEVIATIONS from vim, in COMMANDS.md: a mark whose own text is deleted closes
                                ; up to where the delete was, where vim deletes the mark with its line; and
                                ; within its line a mark stays with its CHARACTER, where vim keeps the column
                                ; number.  'u' puts the marks back where they were when the change it
                                ; undoes began (MKSNAP / MKREST).
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  01E4'                         MKVAD:
  01E4'   16 00                 	MVI	D,0
  01E6'   59                    	MOV	E,C
  01E7'   21 2DAF'              	LXI	H,MKVAL
  01EA'   19                    	DAD	D
  01EB'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  01EC'                         MKCLR:
  01EC'   21 2DAF'              	LXI	H,MKVAL
  01EF'   06 03                 	MVI	B,MKMAX
  01F1'   AF                    	XRA	A
  01F2'                         MKC_LP:
  01F2'   77                    	MOV	M,A
  01F3'   23                    	INX	H
  01F4'   05                    	DCR	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


  01F5'   C2 01F2'              	JNZ	MKC_LP
  01F8'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was an ESC.
                                ;A key typed here did not come through the dispatcher, so it is handed to
                                ;DOTPRE to join the recording: that is what lets '.' repeat "dfa", "dgg" and
                                ;"d'a".
  01F9'                         MKGETK:
  01F9'   3A 2D3E'              	LDA	DOTRPL
  01FC'   B7                    	ORA	A
  01FD'   CA 020E'              	JZ	MKG_KB
  0200'   CD 05A4'              	CALL	DOTGET		; the recording's next key
  0203'   D8                    	RC
  0204'   4F                    	MOV	C,A
  0205'   3A 2D44'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  0208'   3C                    	INR	A
  0209'   32 2D44'              	STA	DOTIX
  020C'   B7                    	ORA	A		; CY clear
  020D'   C9                    	RET
  020E'                         MKG_KB:
  020E'   CD 0000*              	CALL	GETKEY
  0211'   FE 1B                 	CPI	ESC
  0213'   37                    	STC
  0214'   C8                    	RZ			; ESC cancels the command
  0215'   CD 00D7'              	CALL	DOTPRE		; C kept
  0218'   B7                    	ORA	A		; CY clear
  0219'   C9                    	RET
                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
                                ; the motion returns.  MKGETK puts the character in the '.' recording, so
                                ; '.' can repeat "dfa".
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
                                ;============================================================
  021A'                         VC_FF:				; 'f' -- forward, onto the character
  021A'   3E 66                 	MVI	A,'f'
  021C'   C3 022B'              	JMP	FNDNEW
  021F'                         VC_FB:				; 'F' -- backward, onto it
  021F'   3E 46                 	MVI	A,'F'
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  0221'   C3 022B'              	JMP	FNDNEW
  0224'                         VC_TF:				; 't' -- forward, up to it
  0224'   3E 74                 	MVI	A,'t'
  0226'   C3 022B'              	JMP	FNDNEW
  0229'                         VC_TB:				; 'T' -- backward, up to it
  0229'   3E 54                 	MVI	A,'T'
  022B'                         FNDNEW:
  022B'   32 2DA4'              	STA	FNDKND		; the find ';' and ',' will repeat
  022E'   CD 01F9'              	CALL	MKGETK		; the character it looks for
  0231'   DA 0263'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0234'   79                    	MOV	A,C
  0235'   32 2DA5'              	STA	FNDCH
  0238'   3A 2DA4'              	LDA	FNDKND
  023B'   06 01                 	MVI	B,1		; a find starts at the next character along
  023D'   C3 026A'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0240'                         VC_SEMI:
  0240'   3A 2DA4'              	LDA	FNDKND
  0243'   B7                    	ORA	A
  0244'   CA 0263'              	JZ	FNDNIL		; nothing has been looked for yet
  0247'   C3 0253'              	JMP	FNDREP
  024A'                         VC_COMMA:
  024A'   3A 2DA4'              	LDA	FNDKND
  024D'   B7                    	ORA	A
  024E'   CA 0263'              	JZ	FNDNIL
  0251'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0253'                         FNDREP:
  0253'   06 01                 	MVI	B,1
  0255'   F5                    	PUSH	PSW
  0256'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  0258'   FE 54                 	CPI	'T'
  025A'   C2 025F'              	JNZ	FNDR_GO
  025D'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  025F'                         FNDR_GO:
  025F'   F1                    	POP	PSW
  0260'   C3 026A'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
  0263'                         FNDNIL:
  0263'   AF                    	XRA	A
  0264'   32 2D4A'              	STA	PSAVE
  0267'   C3 07A0'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  026A'                         FNDGO:
  026A'   32 2DA6'              	STA	FNDRUN
  026D'   78                    	MOV	A,B
  026E'   32 2DA7'              	STA	FNDSTP
  0271'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
  0274'   22 2DA8'              	SHLD	FNDN		; the occurrence wanted
  0277'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  027A'   22 2DAA'              	SHLD	FNDCUR
  027D'   3A 2DA6'              	LDA	FNDRUN
  0280'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  0282'   CA 02B6'              	JZ	FNDBWD
  0285'   2A 2DAA'              	LHLD	FNDCUR
  0288'   CD 0663'              	CALL	EOLC		; HL = the line's last content character
  028B'   22 2DAC'              	SHLD	FNDLIM
  028E'   2A 2DAA'              	LHLD	FNDCUR
  0291'   3A 2DA7'              	LDA	FNDSTP
  0294'   5F                    	MOV	E,A
  0295'   16 00                 	MVI	D,0
  0297'   19                    	DAD	D		; HL = where the scan starts
  0298'                         FNDF_LP:
  0298'   EB                    	XCHG			; DE = the scan
  0299'   2A 2DAC'              	LHLD	FNDLIM
  029C'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  029F'   EB                    	XCHG			; HL = the scan
  02A0'   CA 02A6'              	JZ	FNDF_AT		; the last character is still a candidate
  02A3'   D2 0308'              	JNC	FNDMIS		; past it: not on this line
  02A6'                         FNDF_AT:
  02A6'   CD 030F'              	CALL	FNDSEE		; Z iff this is the character
  02A9'   C2 02B2'              	JNZ	FNDF_NX
  02AC'   CD 031A'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02AF'   CA 02EE'              	JZ	FNDHIT
  02B2'                         FNDF_NX:
  02B2'   23                    	INX	H
  02B3'   C3 0298'              	JMP	FNDF_LP
  02B6'                         FNDBWD:
  02B6'   2A 2DAA'              	LHLD	FNDCUR
  02B9'   CD 0624'              	CALL	BOL		; HL = the line's first character
  02BC'   22 2DAC'              	SHLD	FNDLIM
  02BF'   2A 2DAA'              	LHLD	FNDCUR
  02C2'   3A 2DA7'              	LDA	FNDSTP
  02C5'   2F                    	CMA
  02C6'   5F                    	MOV	E,A
  02C7'   16 FF                 	MVI	D,0FFH
  02C9'   13                    	INX	D		; DE = -step
  02CA'   19                    	DAD	D		; HL = where the scan starts
  02CB'   D2 0308'              	JNC	FNDMIS		; ... off the front of the text altogether
  02CE'                         FNDB_LP:
  02CE'   EB                    	XCHG			; DE = the scan
  02CF'   2A 2DAC'              	LHLD	FNDLIM
  02D2'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02D5'   EB                    	XCHG			; HL = the scan
  02D6'   DA 0308'              	JC	FNDMIS		; before this line: not on it
  02D9'   CD 030F'              	CALL	FNDSEE
  02DC'   C2 02E5'              	JNZ	FNDB_NX
  02DF'   CD 031A'              	CALL	FNDCNT
  02E2'   CA 02EE'              	JZ	FNDHIT
  02E5'                         FNDB_NX:
  02E5'   7C                    	MOV	A,H
  02E6'   B5                    	ORA	L
  02E7'   CA 0308'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
  02EA'   2B                    	DCX	H
  02EB'   C3 02CE'              	JMP	FNDB_LP
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  02EE'                         FNDHIT:
  02EE'   3A 2DA6'              	LDA	FNDRUN
  02F1'   E6 5F                 	ANI	5FH
  02F3'   FE 54                 	CPI	'T'
  02F5'   C2 0305'              	JNZ	FNDLND
  02F8'   3A 2DA6'              	LDA	FNDRUN
  02FB'   E6 20                 	ANI	20H
  02FD'   CA 0304'              	JZ	FNDH_BW
  0300'   2B                    	DCX	H		; forward 't': the character before it
  0301'   C3 0305'              	JMP	FNDLND
  0304'                         FNDH_BW:
  0304'   23                    	INX	H		; backward 'T': the character after it
  0305'                         FNDLND:
  0305'   C3 05BA'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  0308'                         FNDMIS:
  0308'   AF                    	XRA	A
  0309'   32 2D4A'              	STA	PSAVE
  030C'   C3 01DC'              	JMP	DOTBEL
                                
                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
  030F'                         FNDSEE:
  030F'   E5                    	PUSH	H
  0310'   CD 0000*              	CALL	CHARAT
  0313'   E1                    	POP	H
  0314'   47                    	MOV	B,A
  0315'   3A 2DA5'              	LDA	FNDCH
  0318'   B8                    	CMP	B
  0319'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
                                ; the scan and stays it.
  031A'                         FNDCNT:
  031A'   E5                    	PUSH	H
  031B'   2A 2DA8'              	LHLD	FNDN
  031E'   2B                    	DCX	H
  031F'   22 2DA8'              	SHLD	FNDN
  0322'   7C                    	MOV	A,H
  0323'   B5                    	ORA	L
  0324'   E1                    	POP	H
  0325'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  0326'                         ISFIND:
  0326'   E6 5F                 	ANI	5FH		; fold the case away
  0328'   FE 46                 	CPI	'F'
  032A'   C8                    	RZ
  032B'   FE 54                 	CPI	'T'
  032D'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  032E'                         VC_MK:
  032E'   3E 04                 	MVI	A,PM
  0330'   C3 033A'              	JMP	MKGO
  0333'                         VC_BQ:
  0333'   3E 05                 	MVI	A,PJ
  0335'   C3 033A'              	JMP	MKGO
  0338'                         VC_AQ:
  0338'   3E 06                 	MVI	A,PJL
  033A'                         MKGO:
  033A'   32 2DBB'              	STA	MKWHAT
  033D'   CD 06B8'              	CALL	MOVCNT		; a count means nothing on any of the three
  0340'   CD 01F9'              	CALL	MKGETK		; the key that names the mark
  0343'   DA 0422'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out.  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist: 'm' with any other key
                                ;drops the whole thing, as vim's 'Z{other}' does, and a jump to one is a jump
                                ;to a mark that is not set.
  0346'                         MKOP:
  0346'   79                    	MOV	A,C
  0347'   D6 61                 	SUI	'a'
  0349'   FE 03                 	CPI	MKMAX
  034B'   D2 041A'              	JNC	MKNOLT		; not a mark letter
  034E'   4F                    	MOV	C,A		; C = the mark's index
  034F'   87                    	ADD	A
  0350'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  0351'   5F                    	MOV	E,A
  0352'   16 00                 	MVI	D,0
  0354'   21 0000*              	LXI	H,MKTAB
  0357'   19                    	DAD	D		; HL -> this mark's slot
  0358'   3A 2DBB'              	LDA	MKWHAT
  035B'   FE 04                 	CPI	PM
  035D'   CA 0435'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark, paging to it if the window has left it.
                                ;'Mark not set', as vim says it, when it was never set.
                                ;Under an OPERATOR a mark the window does not hold is refused with the bell
                                ;and stays set, all but "d'a": a line delete is the one operator that can take
                                ;a span the window does not hold whole (OPPGD), and going there only to be
                                ;turned away by it would page the file twice for nothing.
  0360'                         MKJMP:
  0360'   E5                    	PUSH	H
  0361'   CD 01E4'              	CALL	MKVAD
  0364'   7E                    	MOV	A,M
  0365'   E1                    	POP	H
  0366'   B7                    	ORA	A
  0367'   CA 0410'              	JZ	MKNSET		; never set
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  036A'   CD 03DC'              	CALL	MKLOAD		; the file position it holds
  036D'   CD 03E9'              	CALL	MKWIN
  0370'   DA 0387'              	JC	MKJ_GO		; in the window: any command may go there
  0373'   3A 2D4A'              	LDA	PSAVE
  0376'   B7                    	ORA	A
  0377'   CA 0387'              	JZ	MKJ_GO
  037A'   FE 64                 	CPI	'd'		; paged out, and an operator wants the span
  037C'   C2 0422'              	JNZ	MKBAD
  037F'   3A 2DBB'              	LDA	MKWHAT
  0382'   FE 06                 	CPI	PJL
  0384'   C2 0422'              	JNZ	MKBAD
  0387'                         MKJ_GO:
  0387'   CD 1259'              	CALL	GZONE		; the screen's top line, before the cursor
                                				;   moves: GPLACE measures the landing against
                                				;   it, and one left over from an earlier 'G'
                                				;   had it keep a window the line is not in
  038A'   CD 06F4'              	CALL	BRKON		; ... and an ESC may stop it from here on
  038D'   CD 03A9'              	CALL	MKPAGE		; HL = the mark's offset in the window
  0390'   CD 0731'              	CALL	BRKOFF		; (A only)
  0393'   DA 0749'              	JC	BRKBAK
  0396'   3A 2DBB'              	LDA	MKWHAT
  0399'   FE 06                 	CPI	PJL
  039B'   CA 03A3'              	JZ	MKJ_LN		; ''': GPKEEP is 0, so GPLACE finds the first
  039E'   3E 01                 	MVI	A,1		;   non-blank
  03A0'   32 2DAE'              	STA	GPKEEP		; '`': land on the column it was set at
  03A3'                         MKJ_LN:
  03A3'   CD 0000*              	CALL	GOTO
  03A6'   C3 1271'              	JMP	GPLACE		; (which sets LNDLT itself)
                                
                                ;MKPAGE -- page until MKPOS is in the window: HL = its logical offset there.
                                ;The loop is WM's own whole-file line move (MVLMAX: GOLINE to the window's
                                ;edge, SCRLST to page one step), stopped by where the window is instead of by
                                ;the count.  A step cannot carry the window past the mark: the pager evicts
                                ;only behind the cursor, and the cursor is on the edge nearer the mark.
  03A9'                         MKPAGE:
  03A9'   CD 03E9'              	CALL	MKWIN
  03AC'   DA 0000*              	JC	CLRCNT		; there: and the count that paged is spent,
                                				;   not left for the next command to take
  03AF'   32 0000*              	STA	DIRFLG
  03B2'   21 FFFF               	LXI	H,0FFFFH
  03B5'   22 2D15'              	SHLD	CMDCNT
  03B8'   CD 0000*              	CALL	GOLINE
  03BB'   CD 0000*              	CALL	SCRLST
  03BE'   CD 06E0'              	CALL	CNTTST
  03C1'   C2 03A9'              	JNZ	MKPAGE
  03C4'   CD 03E9'              	CALL	MKWIN		; the file ran out: that was its last step
  03C7'   DA 0000*              	JC	CLRCNT
  03CA'   21 FFFF               	LXI	H,0FFFFH	; the very end of the text, which MKWIN does not
  03CD'   C3 0000*              	JMP	CLRCNT		;   count as in the window: GOTO clamps it
                                
                                ;BACKTO -- back to the 3-byte file position at HL, paging to it: where a
                                ;command that came to nothing started.  The place has to be kept as a file
                                ;position -- a sweep of the whole file leaves the window at the far end of
                                ;it, and an offset into the window it started in means nothing there.
  03D0'                         BACKTO:
  03D0'   CD 03DC'              	CALL	MKLOAD
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  03D3'   CD 0000*              	CALL	CLRCNT
  03D6'   CD 03A9'              	CALL	MKPAGE
  03D9'   C3 0000*              	JMP	GOTO
                                
                                ;MKLOAD -- MKPOS = the 3-byte file position at HL.
  03DC'                         MKLOAD:
  03DC'   5E                    	MOV	E,M
  03DD'   23                    	INX	H
  03DE'   56                    	MOV	D,M
  03DF'   23                    	INX	H
  03E0'   7E                    	MOV	A,M
  03E1'   EB                    	XCHG
  03E2'   22 2DB8'              	SHLD	MKPOS
  03E5'   32 2DBA'              	STA	MKPOS+2
  03E8'   C9                    	RET
                                
                                ;MKWIN -- CY and HL = MKPOS as a logical offset if the window holds it; NC and
                                ;A = the way to page for it, as DIRFLG has it (0 forward, FFH back), if not.
  03E9'                         MKWIN:
  03E9'   2A 0000*              	LHLD	TXTBEG
  03EC'   CD 1213'              	CALL	FPOS
  03EF'   EB                    	XCHG
  03F0'   47                    	MOV	B,A		; B:DE = the window's first byte
  03F1'   2A 2DB8'              	LHLD	MKPOS
  03F4'   3A 2DBA'              	LDA	MKPOS+2
  03F7'   CD 1206'              	CALL	SUB24		; A:HL = the mark, from the window's top
  03FA'   DA 040C'              	JC	MKW_BK		; above it
  03FD'   C2 040A'              	JNZ	MKW_FW		; 64K or more below it
  0400'   E5                    	PUSH	H
  0401'   CD 0000*              	CALL	LOGLEN
  0404'   D1                    	POP	D
  0405'   CD 0000*              	CALL	CMP16		; DE = the offset vs HL = the window's length
  0408'   EB                    	XCHG
  0409'   D8                    	RC			; inside
  040A'                         MKW_FW:
  040A'   AF                    	XRA	A
  040B'   C9                    	RET
  040C'                         MKW_BK:
  040C'   3E FF                 	MVI	A,0FFH
  040E'   B7                    	ORA	A
  040F'   C9                    	RET
                                
                                ;MKNSET -- a jump to a mark that will not answer: vim's E20 on the bottom row
                                ;(without the number, and without a bell, as every message here), the cursor
                                ;and the screen left alone.  The operator is cancelled as MKBAD cancels it.
  0410'                         MKNSET:
  0410'   AF                    	XRA	A
  0411'   32 2D4A'              	STA	PSAVE
  0414'   21 26EC'              	LXI	H,SMKNS
  0417'   C3 25D1'              	JMP	EXERR
  041A'                         MKNOLT:
  041A'   3A 2DBB'              	LDA	MKWHAT
  041D'   FE 04                 	CPI	PM
  041F'   C2 0410'              	JNZ	MKNSET		; a jump: that mark is not set
                                				; 'm{other}': fall into MKBAD
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


                                ;MKBAD -- no mark was named: 'm' with a key that is not a mark letter, ESC in
                                ;place of the letter, or a '.' replay that ran out.  The bell, and an operator
                                ;running the motion is cancelled whole: PSAVE is what OPPEND's tail reads to
                                ;decide whether to open an insert, so clearing it stops a "c`z" opening one
                                ;over a span of nothing.
  0422'                         MKBAD:
  0422'   AF                    	XRA	A
  0423'   32 2D4A'              	STA	PSAVE
  0426'   C3 01DC'              	JMP	DOTBEL
                                
                                ;FPSTO -- the cursor's file position into the 3 bytes at HL.  Keeps BC.
  0429'                         FPSTO:
  0429'   E5                    	PUSH	H
  042A'   CD 1210'              	CALL	CURFP		; A:HL = the cursor's file position
  042D'   EB                    	XCHG
  042E'   E1                    	POP	H
  042F'   73                    	MOV	M,E
  0430'   23                    	INX	H
  0431'   72                    	MOV	M,D
  0432'   23                    	INX	H
  0433'   77                    	MOV	M,A
  0434'   C9                    	RET
                                
                                ;MKSET -- remember where in the FILE the cursor is.
  0435'                         MKSET:
  0435'   CD 0429'              	CALL	FPSTO
  0438'   CD 01E4'              	CALL	MKVAD
  043B'   36 01                 	MVI	M,1		; ... and the mark is live
  043D'   C3 07A0'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKSNAP -- keep the marks as they stand, for 'u' (MKREST).  Each copy's spare
                                ;fourth byte takes that mark's live flag.  HL and BC are kept.
  0440'                         MKSNAP:
  0440'   C5                    	PUSH	B
  0441'   E5                    	PUSH	H
  0442'   21 0000*              	LXI	H,MKTAB
  0445'   11 0000*              	LXI	D,MKUND
  0448'   CD 23F4'              	CALL	COPY12
  044B'   21 2DAF'              	LXI	H,MKVAL
  044E'   11 0003*              	LXI	D,MKUND+MKSIZ-1
  0451'   06 03                 	MVI	B,MKMAX
  0453'                         MSN_LP:
  0453'   7E                    	MOV	A,M
  0454'   12                    	STAX	D
  0455'   23                    	INX	H
  0456'   13                    	INX	D
  0457'   13                    	INX	D
  0458'   13                    	INX	D
  0459'   13                    	INX	D
  045A'   05                    	DCR	B
  045B'   C2 0453'              	JNZ	MSN_LP
  045E'   E1                    	POP	H
  045F'   C1                    	POP	B
  0460'   C9                    	RET
                                
                                ;MKREST -- a change has been undone: every mark that was set when it began
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


                                ;goes back where it was then, whether the change ran over it or 'm' has moved
                                ;it since (vim keeps them with the undo too).  One first set AFTER the change
                                ;is left where the replay's own edits carried it.
  0461'                         MKREST:
  0461'   0E 02                 	MVI	C,MKMAX-1
  0463'                         MRS_LP:
  0463'   79                    	MOV	A,C
  0464'   87                    	ADD	A
  0465'   87                    	ADD	A
  0466'   5F                    	MOV	E,A
  0467'   16 00                 	MVI	D,0
  0469'   21 0003*              	LXI	H,MKUND+MKSIZ-1
  046C'   19                    	DAD	D
  046D'   7E                    	MOV	A,M
  046E'   B7                    	ORA	A
  046F'   CA 048B'              	JZ	MRS_NX		; it was not set then
  0472'   2B                    	DCX	H
  0473'   2B                    	DCX	H
  0474'   2B                    	DCX	H
  0475'   E5                    	PUSH	H
  0476'   21 0000*              	LXI	H,MKTAB
  0479'   19                    	DAD	D
  047A'   EB                    	XCHG			; DE -> the mark
  047B'   E1                    	POP	H		; HL -> its copy
  047C'   06 03                 	MVI	B,MKSIZ-1
  047E'                         MRS_CP:
  047E'   7E                    	MOV	A,M
  047F'   12                    	STAX	D
  0480'   23                    	INX	H
  0481'   13                    	INX	D
  0482'   05                    	DCR	B
  0483'   C2 047E'              	JNZ	MRS_CP
  0486'   CD 01E4'              	CALL	MKVAD
  0489'   36 01                 	MVI	M,1
  048B'                         MRS_NX:
  048B'   0D                    	DCR	C
  048C'   F2 0463'              	JP	MRS_LP
  048F'   C9                    	RET
                                
                                ;MKSHFT -- the text is changing: every mark follows its own text.  BUF.MAC's
                                ;UNDCHG calls this through EDTHK from all six edit primitives -- 'u's replay
                                ;of them included -- with A = 1 for an insert (the text is in) or 2 for a
                                ;delete (it is about to go), HL = the edit's logical offset and BC = its
                                ;length.  A mark before the edit stays; one after it moves by the length; one
                                ;INSIDE a delete closes up to where the delete was.  An insert AT a mark
                                ;leaves the mark in front of the new text, unless that text ends a line -- a
                                ;line opened or put above the mark's is above the mark too.
                                ;The edit is found from the CURSOR's file position less its distance behind
                                ;the cursor, never from the offset alone: a put bigger than the window pages
                                ;its own start out, and that offset has then wrapped.  BC is kept.
  0490'                         MKSHFT:
  0490'   32 2DB7'              	STA	MKTYP
  0493'   3A 2DBC'              	LDA	MKHOLD		; a yank that could not copy takes its lines out
  0496'   B7                    	ORA	A		;   and puts them back unchanged (YKGO): the text
  0497'   C0                    	RNZ			;   every mark points into is still there
  0498'   3A 0000*              	LDA	UNDRPL
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  049B'   B7                    	ORA	A
  049C'   C2 04A6'              	JNZ	MKS_GO		; 'u' replaying: not a new change
  049F'   3A 0000*              	LDA	UNDNEW		; the first edit of a new change (UNDCHG calls
  04A2'   B7                    	ORA	A		;   here BEFORE it claims the change): the marks
  04A3'   C4 0440'              	CNZ	MKSNAP		;   as they are now are the ones 'u' puts back
  04A6'                         MKS_GO:
  04A6'   C5                    	PUSH	B
  04A7'   50                    	MOV	D,B
  04A8'   59                    	MOV	E,C
  04A9'   EB                    	XCHG
  04AA'   22 2DB5'              	SHLD	MKN		; the edit's length
  04AD'   D5                    	PUSH	D		; ... and its offset
  04AE'   CD 0000*              	CALL	CUROFF
  04B1'   D1                    	POP	D
  04B2'   CD 0000*              	CALL	SUBHD
  04B5'   EB                    	XCHG			; DE = how far behind the cursor it is
  04B6'   CD 1210'              	CALL	CURFP		; A:HL = the cursor's file position
  04B9'   06 00                 	MVI	B,0
  04BB'   CD 1206'              	CALL	SUB24
  04BE'   22 2DB2'              	SHLD	MKEDIT
  04C1'   32 2DB4'              	STA	MKEDIT+2	; where in the file the edit is
  04C4'   21 2DAF'              	LXI	H,MKVAL
  04C7'   11 0000*              	LXI	D,MKTAB
  04CA'   06 03                 	MVI	B,MKMAX
  04CC'                         MKS_LP:
  04CC'   7E                    	MOV	A,M
  04CD'   B7                    	ORA	A
  04CE'   CA 053A'              	JZ	MKS_N0		; that mark is not set
  04D1'   E5                    	PUSH	H
  04D2'   C5                    	PUSH	B
  04D3'   21 2DB2'              	LXI	H,MKEDIT
  04D6'   1A                    	LDAX	D		; the mark's position less the edit's, a byte
  04D7'   96                    	SUB	M		;   at a time (neither INX nor LDAX touch CY)
  04D8'   4F                    	MOV	C,A
  04D9'   13                    	INX	D
  04DA'   23                    	INX	H
  04DB'   1A                    	LDAX	D
  04DC'   9E                    	SBB	M
  04DD'   47                    	MOV	B,A
  04DE'   13                    	INX	D
  04DF'   23                    	INX	H
  04E0'   1A                    	LDAX	D
  04E1'   9E                    	SBB	M		; A:BC = how far past the edit the mark is
  04E2'   DA 0535'              	JC	MKS_PP		; before it: nothing moves
  04E5'   6F                    	MOV	L,A
  04E6'   3A 2DB7'              	LDA	MKTYP
  04E9'   3D                    	DCR	A
  04EA'   CA 050F'              	JZ	MKS_IN
                                	;--- a delete: back by its length, or to it if the mark is inside ---
  04ED'   7D                    	MOV	A,L
  04EE'   2A 2DB5'              	LHLD	MKN
  04F1'   B7                    	ORA	A
  04F2'   C2 04FE'              	JNZ	MKS_DL		; 64K or more past it
  04F5'   79                    	MOV	A,C
  04F6'   95                    	SUB	L
  04F7'   78                    	MOV	A,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04F8'   9C                    	SBB	H
  04F9'   D2 04FE'              	JNC	MKS_DL		; past the end of what goes
  04FC'   60                    	MOV	H,B
  04FD'   69                    	MOV	L,C		; inside it: close up to the edit
  04FE'                         MKS_DL:
  04FE'   1B                    	DCX	D
  04FF'   1B                    	DCX	D
  0500'   1A                    	LDAX	D
  0501'   95                    	SUB	L
  0502'   12                    	STAX	D
  0503'   13                    	INX	D
  0504'   1A                    	LDAX	D
  0505'   9C                    	SBB	H
  0506'   12                    	STAX	D
  0507'   13                    	INX	D
  0508'   1A                    	LDAX	D
  0509'   DE 00                 	SBI	0
  050B'   12                    	STAX	D
  050C'   C3 0535'              	JMP	MKS_PP
                                	;--- an insert: on by its length ---
  050F'                         MKS_IN:
  050F'   7D                    	MOV	A,L
  0510'   B0                    	ORA	B
  0511'   B1                    	ORA	C
  0512'   C2 0524'              	JNZ	MKS_AD		; the mark is past it
  0515'   2A 0000*              	LHLD	GAPBEG		; AT the mark: only a line end carries it on
  0518'   2B                    	DCX	H
  0519'   7E                    	MOV	A,M		; the last byte that went in
  051A'   FE 0A                 	CPI	LF
  051C'   CA 0524'              	JZ	MKS_AD
  051F'   FE 0D                 	CPI	CR
  0521'   C2 0535'              	JNZ	MKS_PP
  0524'                         MKS_AD:
  0524'   2A 2DB5'              	LHLD	MKN
  0527'   1B                    	DCX	D
  0528'   1B                    	DCX	D
  0529'   1A                    	LDAX	D
  052A'   85                    	ADD	L
  052B'   12                    	STAX	D
  052C'   13                    	INX	D
  052D'   1A                    	LDAX	D
  052E'   8C                    	ADC	H
  052F'   12                    	STAX	D
  0530'   13                    	INX	D
  0531'   1A                    	LDAX	D
  0532'   CE 00                 	ACI	0
  0534'   12                    	STAX	D
  0535'                         MKS_PP:
  0535'   C1                    	POP	B
  0536'   E1                    	POP	H
  0537'   C3 053C'              	JMP	MKS_NX
  053A'                         MKS_N0:
  053A'   13                    	INX	D
  053B'   13                    	INX	D
  053C'                         MKS_NX:
  053C'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  053D'   13                    	INX	D
  053E'   23                    	INX	H
  053F'   05                    	DCR	B
  0540'   C2 04CC'              	JNZ	MKS_LP
  0543'   C1                    	POP	B
  0544'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  0545'                         VC_UNDO:
  0545'   21 0000               	LXI	H,0
  0548'   22 2D15'              	SHLD	CMDCNT
  054B'   CD 0000*              	CALL	UNDO
  054E'   DA 0587'              	JC	UNDNO
  0551'   3A 0000*              	LDA	UNDST
  0554'   FE 02                 	CPI	2
  0556'   CC 0461'              	CZ	MKREST		; undone (not redone): the marks go back too
  0559'   2A 0000*              	LHLD	UNDCUR
  055C'   CD 056D'              	CALL	UCLAMP		; vi never sits on a line terminator
  055F'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0562'   3E 01                 	MVI	A,1
  0564'   32 2D18'              	STA	MODF		; undone past a ':w' still differs from the file
  0567'   CD 092C'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  056A'   C3 07C1'              	JMP	SETFUL		; whole spans moved: repaint rather than guess
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  056D'                         UCLAMP:
  056D'   E5                    	PUSH	H
  056E'   CD 1805'              	CALL	CEND		; HL = the line's content end
  0571'   D1                    	POP	D		; DE = the offset wanted
  0572'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  0575'   D2 057A'              	JNC	UCL_BK
  0578'   EB                    	XCHG
  0579'   C9                    	RET
  057A'                         UCL_BK:
  057A'   E5                    	PUSH	H		; the content end
  057B'   EB                    	XCHG			; HL = the offset wanted
  057C'   CD 0624'              	CALL	BOL
  057F'   D1                    	POP	D		; DE = the content end, HL = the line's start
  0580'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  0583'   EB                    	XCHG			; HL = the content end
  0584'   C8                    	RZ
  0585'   2B                    	DCX	H		; ... its last character
  0586'   C9                    	RET
  0587'                         UNDNO:
  0587'   3A 0000*              	LDA	UNDWHY
  058A'   B7                    	ORA	A
  058B'   CA 059C'              	JZ	UNDBEL
  058E'   21 26A6'              	LXI	H,SUNDW		; the change has paged away: say so
  0591'   FE 01                 	CPI	1
  0593'   CA 25D1'              	JZ	EXERR
  0596'   21 26C8'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  0599'   C3 25D1'              	JMP	EXERR
  059C'                         UNDBEL:
  059C'   0E 07                 	MVI	C,BEL
  059E'   CD 0000*              	CALL	BCONOU
  05A1'   C3 07A0'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  05A4'                         DOTGET:
  05A4'   3A 2D44'              	LDA	DOTIX
  05A7'   5F                    	MOV	E,A
  05A8'   3A 2D43'              	LDA	DOTLEN
  05AB'   BB                    	CMP	E
  05AC'   CA 05B8'              	JZ	DOTGEF
  05AF'   16 00                 	MVI	D,0
  05B1'   21 0000*              	LXI	H,DOTBUF
  05B4'   19                    	DAD	D
  05B5'   7E                    	MOV	A,M
  05B6'   B7                    	ORA	A		; CY clear: a key was returned
  05B7'   C9                    	RET
  05B8'                         DOTGEF:
  05B8'   37                    	STC
  05B9'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
  05BA'                         GOSET:
  05BA'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  05BD'                         SETGL:
  05BD'   CD 1233'              	CALL	ZSAVE
  05C0'   21 0000               	LXI	H,0
  05C3'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  05C6'   E5                    	PUSH	H
  05C7'   CD 1246'              	CALL	ZREST
  05CA'   E1                    	POP	H
  05CB'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  05CC'   CD 06C4'              	CALL	GBSUB		; HL = bytes to the cursor
  05CF'   44                    	MOV	B,H
  05D0'   4D                    	MOV	C,L
  05D1'   E1                    	POP	H		; HL = the line's start
  05D2'   11 0000               	LXI	D,0		; DE = screen column
  05D5'                         SG_LP:
  05D5'   78                    	MOV	A,B
  05D6'   B1                    	ORA	C
  05D7'   CA 05EC'              	JZ	SG_CUR
  05DA'   7E                    	MOV	A,M
  05DB'   23                    	INX	H
  05DC'   0B                    	DCX	B
  05DD'   E5                    	PUSH	H
  05DE'   6B                    	MOV	L,E
  05DF'   CD 0611'              	CALL	CWID
  05E2'   E1                    	POP	H
  05E3'   83                    	ADD	E
  05E4'   5F                    	MOV	E,A
  05E5'   D2 05D5'              	JNC	SG_LP
  05E8'   14                    	INR	D
  05E9'   C3 05D5'              	JMP	SG_LP
  05EC'                         SG_CUR:
  05EC'   2A 0000*              	LHLD	TXTEND
  05EF'   D5                    	PUSH	D
  05F0'   EB                    	XCHG
  05F1'   2A 0000*              	LHLD	GAPEND
  05F4'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  05F7'   D1                    	POP	D
  05F8'   CA 060C'              	JZ	SG_SET
  05FB'   7E                    	MOV	A,M
  05FC'   FE 09                 	CPI	TAB
  05FE'   C2 060C'              	JNZ	SG_SET
  0601'   6B                    	MOV	L,E
  0602'   CD 0611'              	CALL	CWID
  0605'   3D                    	DCR	A		; the TAB's last column
  0606'   83                    	ADD	E
  0607'   5F                    	MOV	E,A
  0608'   D2 060C'              	JNC	SG_SET
  060B'   14                    	INR	D
  060C'                         SG_SET:
  060C'   EB                    	XCHG
  060D'   22 2D1D'              	SHLD	GOALCOL
  0610'   C9                    	RET
                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  0611'                         CWID:
  0611'   FE 0D                 	CPI	CR
  0613'   CA 0622'              	JZ	CW_0
  0616'   FE 09                 	CPI	TAB
  0618'   3E 01                 	MVI	A,1
  061A'   C0                    	RNZ
  061B'   7D                    	MOV	A,L
  061C'   E6 07                 	ANI	TABWID-1
  061E'   2F                    	CMA
  061F'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  0621'   C9                    	RET
  0622'                         CW_0:
  0622'   AF                    	XRA	A
  0623'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
  0624'                         BOL:
  0624'                         BOL_LP:
  0624'   7C                    	MOV	A,H
  0625'   B5                    	ORA	L
  0626'   C8                    	RZ			; at 0
  0627'   2B                    	DCX	H		; look at off-1
  0628'   E5                    	PUSH	H
  0629'   CD 0000*              	CALL	CHARAT
  062C'   E1                    	POP	H		; HL = off-1
  062D'   FE 0A                 	CPI	LF
  062F'   CA 0635'              	JZ	BOL_DN
  0632'   C3 0624'              	JMP	BOL_LP
  0635'                         BOL_DN:
  0635'   23                    	INX	H		; line starts just after the LF
  0636'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
  0637'                         EOLNL:
  0637'   E5                    	PUSH	H
  0638'   CD 0000*              	CALL	LOGLEN
  063B'   22 2D68'              	SHLD	WKN
  063E'   E1                    	POP	H
  063F'                         ENL_LP:
  063F'   EB                    	XCHG			; DE = i
  0640'   2A 2D68'              	LHLD	WKN
  0643'   CD 0000*              	CALL	CMP16		; DE=i vs HL=n: CY iff i < n
  0646'   EB                    	XCHG			; HL = i, DE = n
  0647'   D0                    	RNC			; i >= n: no LF on this line
  0648'   E5                    	PUSH	H
  0649'   CD 0000*              	CALL	CHARAT
  064C'   E1                    	POP	H
  064D'   FE 0A                 	CPI	LF
  064F'   C8                    	RZ			; the LF: HL is its offset
  0650'   23                    	INX	H
  0651'   C3 063F'              	JMP	ENL_LP
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  0654'                         NLSTART:
  0654'   CD 0637'              	CALL	EOLNL
  0657'   E5                    	PUSH	H
  0658'   CD 0000*              	CALL	LOGLEN
  065B'   D1                    	POP	D		; DE = eol result
  065C'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  065F'   C8                    	RZ			; no next line: HL = LOGLEN
  0660'   EB                    	XCHG			; HL = eol
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  0661'   23                    	INX	H
  0662'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  0663'                         EOLC:
  0663'   E5                    	PUSH	H
  0664'   CD 0637'              	CALL	EOLNL
  0667'   22 2D6A'              	SHLD	WKTERM
  066A'   E1                    	POP	H
  066B'   CD 0624'              	CALL	BOL
  066E'   22 2D6C'              	SHLD	WKBOL
  0671'   2A 2D6A'              	LHLD	WKTERM
  0674'   EB                    	XCHG			; DE = term
  0675'   2A 2D6C'              	LHLD	WKBOL
  0678'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  067B'   CA 069A'              	JZ	EOLC_MT
  067E'   EB                    	XCHG			; HL = term
  067F'   2B                    	DCX	H		; term-1
  0680'   E5                    	PUSH	H
  0681'   CD 0000*              	CALL	CHARAT
  0684'   E1                    	POP	H		; HL = term-1
  0685'   FE 0D                 	CPI	CR
  0687'   CA 068D'              	JZ	EOLC_CR		; content ends at term-1
  068A'   C3 068E'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  068D'                         EOLC_CR:
  068D'   2B                    	DCX	H		; last = (term-1) - 1
  068E'                         EOLC_LS:
  068E'   EB                    	XCHG			; DE = last
  068F'   2A 2D6C'              	LHLD	WKBOL
  0692'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  0695'   DA 069A'              	JC	EOLC_MT
  0698'   EB                    	XCHG			; HL = last
  0699'   C9                    	RET
  069A'                         EOLC_MT:
  069A'   2A 2D6C'              	LHLD	WKBOL
  069D'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  069E'                         COL:
  069E'   E5                    	PUSH	H
  069F'   CD 0624'              	CALL	BOL
  06A2'   D1                    	POP	D		; DE = off
  06A3'   EB                    	XCHG			; HL = off, DE = bol
  06A4'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  06A7'                         ATENDQ:
  06A7'   CD 0000*              	CALL	CUROFF
  06AA'   E5                    	PUSH	H
  06AB'   CD 0000*              	CALL	LOGLEN
  06AE'   D1                    	POP	D		; DE = cur
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06AF'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  06B2'                         CURCHR:
  06B2'   CD 0000*              	CALL	CUROFF
  06B5'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  06B8'                         MOVCNT:
  06B8'   CD 07A0'              	CALL	SETMOV
  06BB'   C3 06CB'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  06BE'                         CNTOFF:
  06BE'   CD 06CB'              	CALL	GETCNT
  06C1'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  06C4'                         GBSUB:
  06C4'   EB                    	XCHG
  06C5'   2A 0000*              	LHLD	GAPBEG
  06C8'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  06CB'                         GETCNT:
  06CB'   2A 2D15'              	LHLD	CMDCNT
  06CE'   7C                    	MOV	A,H
  06CF'   B5                    	ORA	L
  06D0'   C2 06D7'              	JNZ	GC_HAVE
  06D3'   21 0001               	LXI	H,1
  06D6'   C9                    	RET
  06D7'                         GC_HAVE:
  06D7'   E5                    	PUSH	H
  06D8'   21 0000               	LXI	H,0
  06DB'   22 2D15'              	SHLD	CMDCNT
  06DE'   E1                    	POP	H
  06DF'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for an ESC break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  06E0'                         CNTTST:				; WM 1175
  06E0'   3A 2DD3'              	LDA	BRKARM
  06E3'   B7                    	ORA	A
  06E4'   C4 070E'              	CNZ	BRKTST		; an ESC spends the count: every loop stops here
  06E7'   E5                    	PUSH	H
  06E8'   2A 2D15'              	LHLD	CMDCNT
  06EB'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  06EE'   B4                    	ORA	H
  06EF'   B5                    	ORA	L
  06F0'   E1                    	POP	H
  06F1'   C3 0000*              	JMP	POLLBRK
                                
                                ;============================================================
                                ; ESC -- abandon a search or a long move.
                                ;
                                ; Every loop that pages asks CNTTST whether to go on, so that is where an ESC is
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


                                ; looked for: it zeroes the count, and the loop ends the way it ends when the
                                ; count runs out.  Nothing is half done, because the commands that can be
                                ; stopped change nothing -- BRKON arms the test only with no operator pending,
                                ; and only 'G' 'gg' the mark jumps and the searches call it.  A 'dd' count, a
                                ; ':s', a put or a write asks the same CNTTST and is never stopped.
                                ;
                                ; The command then goes back to where it started (BRKBAK), as a search that
                                ; found nothing does: the screen was not repainted, so it is already right.
                                ; Going back pages, and that is not stopped by a second ESC.
                                ;============================================================
                                
                                ;BRKON -- a command that may page a long way is starting: keep the place it
                                ; started from (the cursor's position in the file, and LNDLT for its row), and
                                ; arm the ESC test unless an operator is waiting for this motion.
  06F4'                         BRKON:
  06F4'   21 2DCE'              	LXI	H,SOFF
  06F7'   CD 0429'              	CALL	FPSTO
  06FA'   2A 0000*              	LHLD	LNDLT
  06FD'   22 2DD1'              	SHLD	SLDLT
  0700'   AF                    	XRA	A
  0701'   32 2DD4'              	STA	BRKHIT
  0704'   3A 2D4A'              	LDA	PSAVE
  0707'   B7                    	ORA	A
  0708'   C0                    	RNZ			; 'dG' changes text: it runs to its end
  0709'   3C                    	INR	A
  070A'   32 2DD3'              	STA	BRKARM
  070D'   C9                    	RET
                                
                                ;BRKTST -- CNTTST's question while armed.  Keeps BC, DE, HL.  The ESC is
                                ; answered on the bottom row at once: the way back pages, and that can take
                                ; as long again as the command had run, with nothing else to show for it.
                                ; BRKBAK's 'Interrupted' replaces it when the cursor is back.
  070E'                         BRKTST:
  070E'   C5                    	PUSH	B
  070F'   D5                    	PUSH	D
  0710'   E5                    	PUSH	H
  0711'   CD 0000*              	CALL	KBBRK
  0714'   CA 072D'              	JZ	BT_NO
  0717'   32 2DD4'              	STA	BRKHIT		; (A = FFH)
  071A'   21 267B'              	LXI	H,SINTG
  071D'   CD 0000*              	CALL	EXMSG
  0720'   AF                    	XRA	A
  0721'   32 2DD3'              	STA	BRKARM		; the way back is not stopped in its turn
  0724'   32 0000*              	STA	AUXCNT
  0727'   21 0000               	LXI	H,0
  072A'   22 2D15'              	SHLD	CMDCNT
  072D'                         BT_NO:
  072D'   E1                    	POP	H
  072E'   D1                    	POP	D
  072F'   C1                    	POP	B
  0730'   C9                    	RET
                                
                                ;BRKOFF -- the move is over: disarm.  NOTE: falls into BRKQ.
  0731'                         BRKOFF:
  0731'   AF                    	XRA	A
  0732'   32 2DD3'              	STA	BRKARM
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


                                ;BRKQ -- CY iff an ESC stopped it.
  0735'                         BRKQ:
  0735'   3A 2DD4'              	LDA	BRKHIT
  0738'   B7                    	ORA	A
  0739'   C8                    	RZ
  073A'   37                    	STC
  073B'   C9                    	RET
                                
                                ;RSTPL -- back to the place BRKON kept, on the row it was on.
  073C'                         RSTPL:
  073C'   21 2DCE'              	LXI	H,SOFF
  073F'   CD 03D0'              	CALL	BACKTO
  0742'   2A 2DD1'              	LHLD	SLDLT
  0745'   22 0000*              	SHLD	LNDLT
  0748'   C9                    	RET
                                
                                ;BRKBAK -- stopped: back to the start, drop whatever was typed meanwhile (it
                                ; was meant for a result that is not coming), and say so.  CY, as EXERR.
  0749'                         BRKBAK:
  0749'   CD 073C'              	CALL	RSTPL
  074C'   CD 0000*              	CALL	KBFLSH
  074F'   21 266F'              	LXI	H,SINTR
  0752'   C3 25D1'              	JMP	EXERR
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  0755'                         CLASSF:
  0755'   47                    	MOV	B,A
  0756'   FE 20                 	CPI	' '
  0758'   CA 0798'              	JZ	CLS0
  075B'   FE 09                 	CPI	TAB
  075D'   CA 0798'              	JZ	CLS0
  0760'   FE 0A                 	CPI	LF
  0762'   CA 0798'              	JZ	CLS0
  0765'   FE 0D                 	CPI	CR
  0767'   CA 0798'              	JZ	CLS0
  076A'   3A 2D1F'              	LDA	WBIG
  076D'   B7                    	ORA	A
  076E'   C2 079A'              	JNZ	CLS1
  0771'   78                    	MOV	A,B
  0772'   FE 5F                 	CPI	'_'
  0774'   CA 079A'              	JZ	CLS1
  0777'   FE 30                 	CPI	'0'
  0779'   DA 079D'              	JC	CLS2
  077C'   FE 3A                 	CPI	'9'+1
  077E'   DA 079A'              	JC	CLS1
  0781'   FE 41                 	CPI	'A'
  0783'   DA 079D'              	JC	CLS2
  0786'   FE 5B                 	CPI	'Z'+1
  0788'   DA 079A'              	JC	CLS1
  078B'   FE 61                 	CPI	'a'
  078D'   DA 079D'              	JC	CLS2
  0790'   FE 7B                 	CPI	'z'+1
  0792'   DA 079A'              	JC	CLS1
  0795'   C3 079D'              	JMP	CLS2
  0798'   AF                    CLS0:	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  0799'   C9                    	RET
  079A'   3E 01                 CLS1:	MVI	A,1
  079C'   C9                    	RET
  079D'   3E 02                 CLS2:	MVI	A,2
  079F'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  07A0'                         SETMOV:
  07A0'   3E 01                 	MVI	A,R_MOVE
  07A2'   32 2D19'              	STA	RINTENT
  07A5'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  07A6'                         SETLIN:
  07A6'   3E 02                 	MVI	A,R_LINE
  07A8'   32 2D19'              	STA	RINTENT
  07AB'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  07AC'                         SETILN:
  07AC'   3E 01                 	MVI	A,1
  07AE'   32 2D1A'              	STA	ILN		; one line, unless a put overwrites it below
  07B1'   3E 05                 	MVI	A,R_ILIN
  07B3'   32 2D19'              	STA	RINTENT
  07B6'   AF                    	XRA	A
  07B7'   32 2D1C'              	STA	ILABOV		; the row above the opened ones is untouched
  07BA'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  07BB'                         SETJON:
  07BB'   3E 06                 	MVI	A,R_JOIN
  07BD'   32 2D19'              	STA	RINTENT
  07C0'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  07C1'                         SETFUL:
  07C1'   3E 00                 	MVI	A,R_FULL
  07C3'   32 2D19'              	STA	RINTENT
  07C6'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB occurs from the cursor to the end of its line, else 0.
                                ; Scans forward from the cursor via CHARAT until LF or end of text (no gap move).
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  07C7'                         TAILTAB:
  07C7'   CD 0000*              	CALL	CUROFF
  07CA'   22 2D64'              	SHLD	TTI
  07CD'                         TT_LP:
  07CD'   2A 2D64'              	LHLD	TTI
  07D0'   EB                    	XCHG			; DE = TTI
  07D1'   CD 0000*              	CALL	LOGLEN		; HL = LOGLEN
  07D4'   CD 0000*              	CALL	CMP16		; CY iff TTI < LOGLEN
  07D7'   D2 07F7'              	JNC	TT_NO		; reached end of text -> no tab
  07DA'   2A 2D64'              	LHLD	TTI
  07DD'   CD 0000*              	CALL	CHARAT
  07E0'   FE 0A                 	CPI	LF
  07E2'   CA 07F7'              	JZ	TT_NO		; end of line -> no tab
  07E5'   FE 09                 	CPI	TAB
  07E7'   CA 07F4'              	JZ	TT_YES
  07EA'   2A 2D64'              	LHLD	TTI
  07ED'   23                    	INX	H
  07EE'   22 2D64'              	SHLD	TTI
  07F1'   C3 07CD'              	JMP	TT_LP
  07F4'                         TT_YES:
  07F4'   3E 01                 	MVI	A,1
  07F6'   C9                    	RET
  07F7'                         TT_NO:
  07F7'   AF                    	XRA	A
  07F8'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  07F9'                         VC_H:
  07F9'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  07FC'   22 2D62'              	SHLD	CNTV
  07FF'                         VCH_LP:
  07FF'   2A 2D62'              	LHLD	CNTV
  0802'   7C                    	MOV	A,H
  0803'   B5                    	ORA	L
  0804'   C8                    	RZ
  0805'   2B                    	DCX	H
  0806'   22 2D62'              	SHLD	CNTV
  0809'   CD 080F'              	CALL	HSTEP
  080C'   C3 07FF'              	JMP	VCH_LP
  080F'                         HSTEP:
  080F'   CD 0000*              	CALL	CUROFF		; HL = cur
  0812'   7C                    	MOV	A,H
  0813'   B5                    	ORA	L
  0814'   C8                    	RZ			; at 0
  0815'   E5                    	PUSH	H
  0816'   CD 0624'              	CALL	BOL		; HL = bol
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  0819'   D1                    	POP	D		; DE = cur
  081A'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  081D'   C8                    	RZ			; at BOL, cannot go left
  081E'   EB                    	XCHG			; HL = cur
  081F'   2B                    	DCX	H
  0820'   C3 05BA'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  0823'                         VC_L:
  0823'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0826'   22 2D62'              	SHLD	CNTV
  0829'                         VCL_LP:
  0829'   2A 2D62'              	LHLD	CNTV
  082C'   7C                    	MOV	A,H
  082D'   B5                    	ORA	L
  082E'   C8                    	RZ
  082F'   2B                    	DCX	H
  0830'   22 2D62'              	SHLD	CNTV
  0833'   CD 0839'              	CALL	LSTEP
  0836'   C3 0829'              	JMP	VCL_LP
  0839'                         LSTEP:
  0839'   CD 0000*              	CALL	CUROFF		; HL = cur
  083C'   E5                    	PUSH	H
  083D'   CD 0663'              	CALL	EOLC		; HL = eolc
  0840'   D1                    	POP	D		; DE = cur
  0841'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  0844'   D2 084C'              	JNC	LS_NO		; cur >= eolc, cannot go right
  0847'   EB                    	XCHG			; HL = cur
  0848'   23                    	INX	H
  0849'   C3 05BA'              	JMP	GOSET
  084C'                         LS_NO:				; on the line's last char.  An operator waiting on
  084C'   CD 0C18'              	CALL	EMPTY		;   this 'l' takes that char too (vim makes the
  084F'   C8                    	RZ			;   motion inclusive when it falls short), which
  0850'   3E 01                 	MVI	A,1		;   is what WPULL tells OPA_EX: 'dl' there is 'x',
  0852'   32 2D20'              	STA	WPULL		;   and 'd3l' two from the end takes both.  An
  0855'   C9                    	RET			;   empty line has no char to take
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  0856'                         VC_0:
  0856'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0859'   CD 0863'              	CALL	LNSTRT
  085C'   21 0000               	LXI	H,0
  085F'   22 2D1D'              	SHLD	GOALCOL
  0862'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  0863'                         LNSTRT:
  0863'   CD 1233'              	CALL	ZSAVE
  0866'   21 0000               	LXI	H,0
  0869'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  086C'   E5                    	PUSH	H
  086D'   CD 1246'              	CALL	ZREST
  0870'   E1                    	POP	H
  0871'   C3 0000*              	JMP	PUTCUR
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  0874'                         VC_CRT:
  0874'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0877'   C3 087A'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  087A'                         FNBLNK:
  087A'   CD 0863'              	CALL	LNSTRT
  087D'   CD 0000*              	CALL	RGET0
  0880'   11 0000               	LXI	D,0		; DE = blanks skipped
  0883'                         FN_LP:
  0883'   CD 0000*              	CALL	RDGET
  0886'   DA 08A9'              	JC	FN_GO		; the end of the file
  0889'   FE 20                 	CPI	' '
  088B'   CA 0893'              	JZ	FN_WH
  088E'   FE 09                 	CPI	TAB
  0890'   C2 08A9'              	JNZ	FN_GO		; a non-blank, or the line's end
  0893'                         FN_WH:
  0893'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  0896'   DA 08A9'              	JC	FN_GO
  0899'   FE 0D                 	CPI	CR
  089B'   CA 08A9'              	JZ	FN_GO
  089E'   FE 0A                 	CPI	LF
  08A0'   CA 08A9'              	JZ	FN_GO
  08A3'   2B                    	DCX	H		; not yet: read that char again
  08A4'   03                    	INX	B
  08A5'   13                    	INX	D
  08A6'   C3 0883'              	JMP	FN_LP
  08A9'                         FN_GO:
  08A9'   D5                    	PUSH	D
  08AA'   CD 0000*              	CALL	CUROFF
  08AD'   D1                    	POP	D
  08AE'   19                    	DAD	D
  08AF'   C3 05BA'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  08B2'                         VC_EOL:
  08B2'   CD 07A0'              	CALL	SETMOV
  08B5'   21 FFFF               	LXI	H,0FFFFH
  08B8'   22 2D1D'              	SHLD	GOALCOL
  08BB'   CD 06CB'              	CALL	GETCNT
  08BE'   2B                    	DCX	H		; count-1
  08BF'   7C                    	MOV	A,H
  08C0'   B5                    	ORA	L
  08C1'   CA 08D0'              	JZ	VEOL_0
  08C4'   E5                    	PUSH	H
  08C5'   CD 08E5'              	CALL	ONLAST
  08C8'   E1                    	POP	H
  08C9'   D8                    	RC			; the last line: no move (vim)
  08CA'   CD 0935'              	CALL	JCORE
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  08CD'   C3 0A84'              	JMP	JKLAND
  08D0'                         VEOL_0:
  08D0'   CD 0863'              	CALL	LNSTRT
  08D3'   C3 0A84'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  08D6'                         VC_CR:
  08D6'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  08D9'   E5                    	PUSH	H
  08DA'   CD 08E5'              	CALL	ONLAST
  08DD'   E1                    	POP	H
  08DE'   D8                    	RC
  08DF'   CD 0935'              	CALL	JCORE
  08E2'   C3 087A'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  08E5'                         ONLAST:
  08E5'   CD 0000*              	CALL	RGET0
  08E8'                         OL_LP:
  08E8'   CD 0000*              	CALL	RDGET
  08EB'   D8                    	RC			; the file ends on this line
  08EC'   FE 0A                 	CPI	LF
  08EE'   C2 08E8'              	JNZ	OL_LP
  08F1'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  08F4'                         VC_J:
  08F4'   CD 07A0'              	CALL	SETMOV
  08F7'   CD 091F'              	CALL	GLCHK		; the goal column, from the cursor if stale
  08FA'   CD 06CB'              	CALL	GETCNT		; HL = count
  08FD'   CD 0935'              	CALL	JCORE
  0900'   CD 0918'              	CALL	JKDRP
  0903'   C3 0A84'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  0906'                         VC_K:
  0906'   CD 07A0'              	CALL	SETMOV
  0909'   CD 091F'              	CALL	GLCHK
  090C'   CD 06CB'              	CALL	GETCNT
  090F'   CD 09D2'              	CALL	KCORE
  0912'   CD 0918'              	CALL	JKDRP
  0915'   C3 0A84'              	JMP	JKLAND
                                
                                ;JKDRP -- DE = the lines JCORE / KCORE moved.  None -- 'j' on the last line,
                                ; 'k' on the first -- and the motion has failed: an operator waiting on it is
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


                                ; dropped, as vim drops it, where a line span that starts and ends on one line
                                ; would take that line ('dj' on the last line deleted it).  A count that runs
                                ; out of lines short has still moved, and its operator stands.  It is asked
                                ; here and not in the cores: 'dH' on the top row moves no lines either, and
                                ; takes its line.
  0918'                         JKDRP:
  0918'   7A                    	MOV	A,D
  0919'   B3                    	ORA	E
  091A'   C0                    	RNZ
  091B'   32 2D4A'              	STA	PSAVE
  091E'   C9                    	RET
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  091F'                         GLCHK:
  091F'   2A 2D1D'              	LHLD	GOALCOL
  0922'   7C                    	MOV	A,H
  0923'   3C                    	INR	A
  0924'   C0                    	RNZ
  0925'   7D                    	MOV	A,L
  0926'   FE FE                 	CPI	0FEH
  0928'   C0                    	RNZ
  0929'   C3 05BD'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  092C'                         GLSTAL:
  092C'   E5                    	PUSH	H
  092D'   21 FFFE               	LXI	H,0FFFEH
  0930'   22 2D1D'              	SHLD	GOALCOL
  0933'   E1                    	POP	H
  0934'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  0935'                         JCORE:
  0935'   7C                    	MOV	A,H
  0936'   B5                    	ORA	L
  0937'   C8                    	RZ
  0938'   22 2D2E'              	SHLD	JKCNT
  093B'   CD 0D47'              	CALL	CURRW		; limit = lines under the cursor's + NEDIT + 2:
  093E'   47                    	MOV	B,A		;   enough for LYFAR to know it for far off
  093F'   3A 0000*              	LDA	NEDIT
  0942'   3C                    	INR	A
  0943'   90                    	SUB	B
  0944'   5F                    	MOV	E,A
  0945'   16 00                 	MVI	D,0
  0947'   3A 0000*              	LDA	NEDIT
  094A'   6F                    	MOV	L,A
  094B'   26 00                 	MVI	H,0
  094D'   19                    	DAD	D
  094E'   EB                    	XCHG			; DE = limit
  094F'   2A 2D2E'              	LHLD	JKCNT
  0952'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0955'   D2 0959'              	JNC	JC_N
  0958'   EB                    	XCHG			; HL = limit
  0959'                         JC_N:
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0959'   22 2D30'              	SHLD	JKN		; N = min(count, limit)
  095C'   EB                    	XCHG			; DE = LFs to find
  095D'   CD 0000*              	CALL	RGET0
  0960'                         JC_SC:
  0960'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0963'   DA 0982'              	JC	JC_EOF
  0966'   32 2D37'              	STA	JKLST
  0969'   FE 0A                 	CPI	LF
  096B'   C2 0960'              	JNZ	JC_SC
  096E'   1B                    	DCX	D
  096F'   7A                    	MOV	A,D
  0970'   B3                    	ORA	E
  0971'   C2 0960'              	JNZ	JC_SC
  0974'   2A 2D2E'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  0977'   22 2D32'              	SHLD	JKMOV		;   one if the last LF found ends the file
  097A'   3E 01                 	MVI	A,1
  097C'   32 2D36'              	STA	JKPHN
  097F'   C3 099D'              	JMP	JC_MV
  0982'                         JC_EOF:
  0982'   2A 2D30'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  0985'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  0988'   7C                    	MOV	A,H
  0989'   B5                    	ORA	L
  098A'   CA 0996'              	JZ	JC_AV
  098D'   3A 2D37'              	LDA	JKLST
  0990'   FE 0A                 	CPI	LF
  0992'   C2 0996'              	JNZ	JC_AV
  0995'   2B                    	DCX	H
  0996'                         JC_AV:
  0996'   22 2D32'              	SHLD	JKMOV
  0999'   AF                    	XRA	A
  099A'   32 2D36'              	STA	JKPHN
  099D'                         JC_MV:
  099D'   2A 2D2E'              	LHLD	JKCNT
  09A0'   AF                    	XRA	A
  09A1'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  09A4'   CD 0A63'              	CALL	ATEOF
  09A7'   D2 09BB'              	JNC	JC_DN
  09AA'   CD 0A69'              	CALL	LASTLN		; ran past the last line: back onto it
  09AD'   3A 2D36'              	LDA	JKPHN
  09B0'   B7                    	ORA	A
  09B1'   CA 09BB'              	JZ	JC_DN
  09B4'   2A 2D32'              	LHLD	JKMOV
  09B7'   2B                    	DCX	H
  09B8'   22 2D32'              	SHLD	JKMOV
  09BB'                         JC_DN:
  09BB'   2A 2D30'              	LHLD	JKN		; LNDLT += min(moved, N)
  09BE'   EB                    	XCHG
  09BF'   2A 2D32'              	LHLD	JKMOV
  09C2'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  09C5'   D2 09C9'              	JNC	JC_AD
  09C8'   EB                    	XCHG
  09C9'                         JC_AD:
  09C9'   EB                    	XCHG			; DE = lines moved
  09CA'   2A 0000*              	LHLD	LNDLT
  09CD'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  09CE'   22 0000*              	SHLD	LNDLT
  09D1'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  09D2'                         KCORE:
  09D2'   7C                    	MOV	A,H
  09D3'   B5                    	ORA	L
  09D4'   C8                    	RZ
  09D5'   22 2D2E'              	SHLD	JKCNT
  09D8'   CD 0D47'              	CALL	CURRW		; limit = row + NEDIT
  09DB'   5F                    	MOV	E,A
  09DC'   16 00                 	MVI	D,0
  09DE'   3A 0000*              	LDA	NEDIT
  09E1'   6F                    	MOV	L,A
  09E2'   26 00                 	MVI	H,0
  09E4'   19                    	DAD	D
  09E5'   EB                    	XCHG			; DE = limit
  09E6'   2A 2D2E'              	LHLD	JKCNT
  09E9'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  09EC'   D2 09F0'              	JNC	KC_N
  09EF'   EB                    	XCHG			; HL = limit
  09F0'                         KC_N:
  09F0'   22 2D30'              	SHLD	JKN		; N = min(count, limit)
  09F3'   EB                    	XCHG			; DE = LFs to find
  09F4'   21 0000               	LXI	H,0
  09F7'   22 2D34'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  09FA'                         KC_ED:
  09FA'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  09FB'   2A 2D34'              	LHLD	JKBK
  09FE'   CD 06C4'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0A01'   E5                    	PUSH	H
  0A02'   EB                    	XCHG
  0A03'   2A 0000*              	LHLD	TXTBEG
  0A06'   EB                    	XCHG
  0A07'   CD 0000*              	CALL	SUBHD
  0A0A'   44                    	MOV	B,H
  0A0B'   4D                    	MOV	C,L
  0A0C'   E1                    	POP	H
  0A0D'   D1                    	POP	D
  0A0E'                         KC_SC:
  0A0E'   78                    	MOV	A,B
  0A0F'   B1                    	ORA	C
  0A10'   CA 0A27'              	JZ	KC_TB
  0A13'   2B                    	DCX	H
  0A14'   0B                    	DCX	B
  0A15'   7E                    	MOV	A,M
  0A16'   FE 0A                 	CPI	LF
  0A18'   C2 0A0E'              	JNZ	KC_SC
  0A1B'   1B                    	DCX	D
  0A1C'   7A                    	MOV	A,D
  0A1D'   B3                    	ORA	E
  0A1E'   C2 0A0E'              	JNZ	KC_SC
  0A21'   2A 2D2E'              	LHLD	JKCNT		; N lines above: the move is count lines
  0A24'   C3 0A47'              	JMP	KC_MV
  0A27'                         KC_TB:
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0A27'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0A28'   CD 06C4'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0A2B'   22 2D34'              	SHLD	JKBK
  0A2E'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0A31'   7C                    	MOV	A,H
  0A32'   B5                    	ORA	L
  0A33'   CA 0A40'              	JZ	KC_B0
  0A36'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  0A39'   D1                    	POP	D
  0A3A'   DA 0A41'              	JC	KC_BOF
  0A3D'   C3 09FA'              	JMP	KC_ED
  0A40'                         KC_B0:
  0A40'   D1                    	POP	D
  0A41'                         KC_BOF:
  0A41'   2A 2D30'              	LHLD	JKN		; moved = LFs found
  0A44'   CD 0000*              	CALL	SUBHD
  0A47'                         KC_MV:
  0A47'   E5                    	PUSH	H
  0A48'   2A 2D2E'              	LHLD	JKCNT
  0A4B'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0A4E'   D1                    	POP	D		; DE = moved
  0A4F'   2A 2D30'              	LHLD	JKN
  0A52'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0A55'   DA 0A59'              	JC	KC_AD
  0A58'   EB                    	XCHG			; DE = N
  0A59'                         KC_AD:
  0A59'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0A5C'   CD 0000*              	CALL	SUBHD
  0A5F'   22 0000*              	SHLD	LNDLT
  0A62'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0A63'                         ATEOF:
  0A63'   CD 0000*              	CALL	RGET0
  0A66'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0A69'                         LASTLN:
  0A69'   2A 0000*              	LHLD	GAPBEG
  0A6C'   EB                    	XCHG
  0A6D'   2A 0000*              	LHLD	TXTBEG
  0A70'   CD 0000*              	CALL	CMP16
  0A73'   21 0000               	LXI	H,0
  0A76'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0A79'   1B                    	DCX	D
  0A7A'   1A                    	LDAX	D
  0A7B'   FE 0A                 	CPI	LF
  0A7D'   C2 0000*              	JNZ	SETBWD
  0A80'   23                    	INX	H
  0A81'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0A84'                         JKLAND:
  0A84'   21 0000               	LXI	H,0
  0A87'   22 2D38'              	SHLD	JKVC		; screen column
  0A8A'   2B                    	DCX	H
  0A8B'   22 2D3A'              	SHLD	JKLS		; last content char: none yet
  0A8E'   CD 0000*              	CALL	RGET0
  0A91'   11 0000               	LXI	D,0		; DE = chars read
  0A94'                         JL_RD:
  0A94'   CD 0000*              	CALL	RDGET
  0A97'   DA 0AD1'              	JC	JL_END
  0A9A'   FE 0A                 	CPI	LF
  0A9C'   CA 0AD1'              	JZ	JL_END
  0A9F'   E5                    	PUSH	H
  0AA0'   C5                    	PUSH	B
  0AA1'   2A 2D38'              	LHLD	JKVC
  0AA4'   CD 0611'              	CALL	CWID
  0AA7'   B7                    	ORA	A
  0AA8'   CA 0ACB'              	JZ	JL_NX		; a CR
  0AAB'   EB                    	XCHG
  0AAC'   22 2D3A'              	SHLD	JKLS		; the last content char so far
  0AAF'   EB                    	XCHG
  0AB0'   4F                    	MOV	C,A
  0AB1'   06 00                 	MVI	B,0
  0AB3'   09                    	DAD	B		; HL = the column after this char
  0AB4'   22 2D38'              	SHLD	JKVC
  0AB7'   D5                    	PUSH	D
  0AB8'   EB                    	XCHG
  0AB9'   2A 2D1D'              	LHLD	GOALCOL
  0ABC'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0ABF'   D1                    	POP	D
  0AC0'   DA 0ACB'              	JC	JL_NX
  0AC3'   CA 0ACB'              	JZ	JL_NX
  0AC6'   C1                    	POP	B		; this char holds the goal column
  0AC7'   E1                    	POP	H
  0AC8'   C3 0ADC'              	JMP	JL_GO
  0ACB'                         JL_NX:
  0ACB'   C1                    	POP	B
  0ACC'   E1                    	POP	H
  0ACD'   13                    	INX	D
  0ACE'   C3 0A94'              	JMP	JL_RD
  0AD1'                         JL_END:
  0AD1'   2A 2D3A'              	LHLD	JKLS		; past the line's end: its last content char
  0AD4'   7C                    	MOV	A,H
  0AD5'   A5                    	ANA	L
  0AD6'   3C                    	INR	A
  0AD7'   C2 0ADB'              	JNZ	JL_LS
  0ADA'   23                    	INX	H		; no content: the line's start
  0ADB'                         JL_LS:
  0ADB'   EB                    	XCHG
  0ADC'                         JL_GO:
  0ADC'   D5                    	PUSH	D		; DE = step from the line start
  0ADD'   CD 0000*              	CALL	CUROFF
  0AE0'   D1                    	POP	D
  0AE1'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0AE2'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0AE5'   AF                    VC_W:	XRA	A
  0AE6'   32 2D1F'              	STA	WBIG
  0AE9'   C3 0AF1'              	JMP	WDO
  0AEC'   3E 01                 VCBGW:	MVI	A,1
  0AEE'   32 2D1F'              	STA	WBIG
  0AF1'   CD 07A0'              WDO:	CALL	SETMOV
  0AF4'   AF                    	XRA	A
  0AF5'   32 2D20'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0AF8'   CD 06CB'              	CALL	GETCNT
  0AFB'   22 2D62'              	SHLD	CNTV
  0AFE'   2A 2D62'              WDO_LP: LHLD	CNTV
  0B01'   7C                    	MOV	A,H
  0B02'   B5                    	ORA	L
  0B03'   CA 0B10'              	JZ	WDO_DN
  0B06'   2B                    	DCX	H
  0B07'   22 2D62'              	SHLD	CNTV
  0B0A'   CD 0B6D'              	CALL	FWD1
  0B0D'   D2 0AFE'              	JNC	WDO_LP
  0B10'                         WDO_DN:
  0B10'   CD 0A63'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0B13'   DA 0B20'              	JC	WDO_NL
  0B16'   FE 0D                 	CPI	CR
  0B18'   CA 0B20'              	JZ	WDO_NL
  0B1B'   FE 0A                 	CPI	LF
  0B1D'   C2 05BD'              	JNZ	SETGL
  0B20'                         WDO_NL:
  0B20'   CD 0000*              	CALL	PEEKL
  0B23'   DA 05BD'              	JC	SETGL
  0B26'   FE 0A                 	CPI	LF
  0B28'   CA 05BD'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0B2B'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0B2D'   32 2D20'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0B30'   CD 0C8C'              	CALL	DECC		; back onto its last char
  0B33'   C3 05BD'              	JMP	SETGL
                                
  0B36'   AF                    VC_B:	XRA	A
  0B37'   32 2D1F'              	STA	WBIG
  0B3A'   C3 0B42'              	JMP	BDO
  0B3D'   3E 01                 VCBGB:	MVI	A,1
  0B3F'   32 2D1F'              	STA	WBIG
  0B42'   CD 07A0'              BDO:	CALL	SETMOV
  0B45'   CD 06CB'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0B48'   22 2D62'              	SHLD	CNTV
  0B4B'   CD 0BDD'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0B4E'   D2 0B5E'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0B51'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0B52'   32 2D4A'              	STA	PSAVE		;   first char opened an insert).  A count that
  0B55'   C3 05BD'              	JMP	SETGL		;   runs out at the start has still moved, and
  0B58'                         BDO_LP:				;   its operator stands -- both as vim
  0B58'   CD 0BDD'              	CALL	BCK1
  0B5B'   DA 05BD'              	JC	SETGL
  0B5E'   2A 2D62'              BDO_NX: LHLD	CNTV
  0B61'   2B                    	DCX	H
  0B62'   22 2D62'              	SHLD	CNTV
  0B65'   7C                    	MOV	A,H
  0B66'   B5                    	ORA	L
  0B67'   C2 0B58'              	JNZ	BDO_LP
  0B6A'   C3 05BD'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
                                ; words before the last run on freely -- 'd2w' there takes the line break and
                                ; the next line's first word as well.
  0B6D'                         FWD1:
  0B6D'   CD 0C10'              	CALL	CCLS
  0B70'   32 2D6E'              	STA	WKCLS		; the starting class
  0B73'   CD 0C4A'              	CALL	INCC
  0B76'   B7                    	ORA	A
  0B77'   CA 0B90'              	JZ	FW_WD
  0B7A'   37                    	STC
  0B7B'   F8                    	RM			; -1: already at the end
  0B7C'   CD 0BC8'              	CALL	WLAST
  0B7F'   C8                    	RZ
  0B80'   FE 02                 	CPI	2
  0B82'   C2 0B90'              	JNZ	FW_WD		; 1: a next line was reached
  0B85'   CD 0A63'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0B88'   D4 0C31'              	CNC	NXLN
  0B8B'   D2 0B90'              	JNC	FW_WD
  0B8E'   37                    	STC			; yes: failed
  0B8F'   C9                    	RET
  0B90'                         FW_WD:
  0B90'   3A 2D6E'              	LDA	WKCLS		; go past the rest of this word
  0B93'   B7                    	ORA	A
  0B94'   CA 0BB0'              	JZ	FW_WS
  0B97'                         FW_WLP:
  0B97'   CD 0C10'              	CALL	CCLS
  0B9A'   21 2D6E'              	LXI	H,WKCLS
  0B9D'   BE                    	CMP	M
  0B9E'   C2 0BB0'              	JNZ	FW_WS
  0BA1'   CD 0C4A'              	CALL	INCC
  0BA4'   B7                    	ORA	A
  0BA5'   F8                    	RM			; the end of the file (NC)
  0BA6'   CA 0B97'              	JZ	FW_WLP
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0BA9'   CD 0BC8'              	CALL	WLAST
  0BAC'   C8                    	RZ
  0BAD'   C3 0B97'              	JMP	FW_WLP
  0BB0'                         FW_WS:
  0BB0'   CD 0C10'              	CALL	CCLS		; then over blanks to the next word
  0BB3'   B7                    	ORA	A
  0BB4'   C0                    	RNZ
  0BB5'   CD 0C18'              	CALL	EMPTY
  0BB8'   C8                    	RZ			; an empty line is a word
  0BB9'   CD 0C4A'              	CALL	INCC
  0BBC'   B7                    	ORA	A
  0BBD'   F8                    	RM
  0BBE'   CA 0BB0'              	JZ	FW_WS
  0BC1'   CD 0BC8'              	CALL	WLAST
  0BC4'   C8                    	RZ
  0BC5'   C3 0BB0'              	JMP	FW_WS
                                
                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0BC8'                         WLAST:
  0BC8'   47                    	MOV	B,A
  0BC9'   2A 2D62'              	LHLD	CNTV
  0BCC'   7C                    	MOV	A,H
  0BCD'   B5                    	ORA	L
  0BCE'   C2 0BD9'              	JNZ	WL_X		; words still owed
  0BD1'   3A 2D4A'              	LDA	PSAVE
  0BD4'   B7                    	ORA	A
  0BD5'   CA 0BDB'              	JZ	WL_NO		; a plain 'w'
  0BD8'   AF                    	XRA	A
  0BD9'   78                    WL_X:	MOV	A,B
  0BDA'   C9                    	RET
  0BDB'   B0                    WL_NO:	ORA	B
  0BDC'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0BDD'                         BCK1:
  0BDD'   CD 0C8C'              	CALL	DECC
  0BE0'   B7                    	ORA	A
  0BE1'   37                    	STC
  0BE2'   F8                    	RM
  0BE3'                         BK_WS:
  0BE3'   CD 0C10'              	CALL	CCLS		; back over blanks
  0BE6'   B7                    	ORA	A
  0BE7'   C2 0BF7'              	JNZ	BK_WD
  0BEA'   CD 0C18'              	CALL	EMPTY
  0BED'   C8                    	RZ			; an empty line is a word
  0BEE'   CD 0C8C'              	CALL	DECC
  0BF1'   B7                    	ORA	A
  0BF2'   F2 0BE3'              	JP	BK_WS
  0BF5'   AF                    	XRA	A		; the start of the file (NC)
  0BF6'   C9                    	RET
  0BF7'                         BK_WD:
  0BF7'   32 2D6E'              	STA	WKCLS		; back to the start of this word
  0BFA'                         BK_WLP:
  0BFA'   CD 0C8C'              	CALL	DECC
  0BFD'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0BFE'   FA 0C0E'              	JM	BK_OK		; the start of the file
  0C01'   CD 0C10'              	CALL	CCLS
  0C04'   21 2D6E'              	LXI	H,WKCLS
  0C07'   BE                    	CMP	M
  0C08'   CA 0BFA'              	JZ	BK_WLP
  0C0B'   CD 0C4A'              	CALL	INCC		; overshot: forward one
  0C0E'                         BK_OK:
  0C0E'   AF                    	XRA	A
  0C0F'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0C10'                         CCLS:
  0C10'   CD 0A63'              	CALL	ATEOF
  0C13'   D2 0755'              	JNC	CLASSF
  0C16'   AF                    	XRA	A
  0C17'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0C18'                         EMPTY:
  0C18'   CD 0A63'              	CALL	ATEOF
  0C1B'   DA 0C26'              	JC	EM_ST
  0C1E'   FE 0D                 	CPI	CR
  0C20'   CA 0C26'              	JZ	EM_ST
  0C23'   FE 0A                 	CPI	LF
  0C25'   C0                    	RNZ
  0C26'                         EM_ST:
  0C26'   CD 0000*              	CALL	PEEKL
  0C29'   DA 0C2F'              	JC	EM_Y
  0C2C'   FE 0A                 	CPI	LF
  0C2E'   C9                    	RET
  0C2F'                         EM_Y:
  0C2F'   AF                    	XRA	A
  0C30'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0C31'                         NXLN:
  0C31'   FE 0A                 	CPI	LF
  0C33'   CA 0C42'              	JZ	NX_LF
  0C36'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0C39'   D8                    	RC
  0C3A'   FE 0A                 	CPI	LF
  0C3C'   CA 0C42'              	JZ	NX_LF
  0C3F'   2B                    	DCX	H		; a lone CR
  0C40'   AF                    	XRA	A
  0C41'   C9                    	RET
  0C42'                         NX_LF:
  0C42'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0C45'   D8                    	RC
  0C46'   2B                    	DCX	H
  0C47'   3E 01                 	MVI	A,1
  0C49'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


                                ; the file: no move).
  0C4A'                         INCC:
  0C4A'   CD 0A63'              	CALL	ATEOF
  0C4D'   DA 0C88'              	JC	IC_END
  0C50'   FE 0D                 	CPI	CR
  0C52'   CA 0C73'              	JZ	IC_NL
  0C55'   FE 0A                 	CPI	LF
  0C57'   CA 0C73'              	JZ	IC_NL
  0C5A'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0C5D'                         IC_CH:
  0C5D'   CD 0A63'              	CALL	ATEOF
  0C60'   DA 0C6F'              	JC	IC_2
  0C63'   FE 0D                 	CPI	CR
  0C65'   CA 0C6F'              	JZ	IC_2
  0C68'   FE 0A                 	CPI	LF
  0C6A'   CA 0C6F'              	JZ	IC_2
  0C6D'   AF                    	XRA	A
  0C6E'   C9                    	RET
  0C6F'                         IC_2:
  0C6F'   3E 02                 	MVI	A,2
  0C71'   B7                    	ORA	A
  0C72'   C9                    	RET
  0C73'                         IC_NL:
  0C73'   CD 0C31'              	CALL	NXLN
  0C76'   DA 0C88'              	JC	IC_END
  0C79'   F5                    	PUSH	PSW
  0C7A'   CD 0000*              	CALL	PUTCUR
  0C7D'   F1                    	POP	PSW
  0C7E'   B7                    	ORA	A
  0C7F'   CA 0C5D'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0C82'   CD 0CAE'              	CALL	LNINC
  0C85'   3E 01                 	MVI	A,1
  0C87'   C9                    	RET
  0C88'                         IC_END:
  0C88'   3E FF                 	MVI	A,0FFH
  0C8A'   B7                    	ORA	A
  0C8B'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0C8C'                         DECC:
  0C8C'   CD 0000*              	CALL	PEEKL
  0C8F'   DA 0C88'              	JC	IC_END
  0C92'   F5                    	PUSH	PSW
  0C93'   CD 0000*              	CALL	PUTCUR
  0C96'   F1                    	POP	PSW
  0C97'   FE 0A                 	CPI	LF
  0C99'   3E 00                 	MVI	A,0
  0C9B'   C0                    	RNZ
  0C9C'   CD 0CBC'              	CALL	LNDEC
  0C9F'   CD 0000*              	CALL	PEEKL		; onto its CR
  0CA2'   DA 0CAA'              	JC	DC_1
  0CA5'   FE 0D                 	CPI	CR
  0CA7'   CC 0000*              	CZ	PUTCUR
  0CAA'                         DC_1:
  0CAA'   3E 01                 	MVI	A,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0CAC'   B7                    	ORA	A
  0CAD'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0CAE'                         LNINC:
  0CAE'   E5                    	PUSH	H
  0CAF'   2A 0000*              	LHLD	LNDLT
  0CB2'   7C                    	MOV	A,H
  0CB3'   FE 40                 	CPI	40H
  0CB5'   CA 0CCA'              	JZ	LN_X
  0CB8'   23                    	INX	H
  0CB9'   C3 0CC7'              	JMP	LN_ST
  0CBC'                         LNDEC:
  0CBC'   E5                    	PUSH	H
  0CBD'   2A 0000*              	LHLD	LNDLT
  0CC0'   7C                    	MOV	A,H
  0CC1'   FE C0                 	CPI	0C0H
  0CC3'   CA 0CCA'              	JZ	LN_X
  0CC6'   2B                    	DCX	H
  0CC7'                         LN_ST:
  0CC7'   22 0000*              	SHLD	LNDLT
  0CCA'                         LN_X:
  0CCA'   E1                    	POP	H
  0CCB'   C9                    	RET
                                
  0CCC'   AF                    VC_E:	XRA	A
  0CCD'   32 2D1F'              	STA	WBIG
  0CD0'   C3 0CD8'              	JMP	EDO
  0CD3'   3E 01                 VCBGE:	MVI	A,1
  0CD5'   32 2D1F'              	STA	WBIG
  0CD8'   CD 07A0'              EDO:	CALL	SETMOV
  0CDB'   CD 06CB'              	CALL	GETCNT
  0CDE'   22 2D62'              	SHLD	CNTV
  0CE1'   2A 2D62'              EDO_LP: LHLD	CNTV
  0CE4'   7C                    	MOV	A,H
  0CE5'   B5                    	ORA	L
  0CE6'   CA 0B10'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0CE9'   2B                    	DCX	H
  0CEA'   22 2D62'              	SHLD	CNTV
  0CED'   CD 0CFB'              	CALL	ESTEP
  0CF0'   21 2D4D'              	LXI	H,CWEOL		; only the count's first word stays where it is
  0CF3'   36 00                 	MVI	M,0
  0CF5'   D2 0CE1'              	JNC	EDO_LP
  0CF8'   C3 0B10'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0CFB'                         ESTEP:
  0CFB'   CD 0C10'              	CALL	CCLS
  0CFE'   32 2D6E'              	STA	WKCLS		; the starting class
  0D01'   CD 0C4A'              	CALL	INCC
  0D04'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D05'   FA 0D2B'              	JM	ES_F
  0D08'   CD 0C10'              	CALL	CCLS
  0D0B'   B7                    	ORA	A
  0D0C'   CA 0D16'              	JZ	ES_ST
  0D0F'   21 2D6E'              	LXI	H,WKCLS
  0D12'   BE                    	CMP	M
  0D13'   CA 0D2D'              	JZ	ES_SK		; still in the word it started in: on to its end
  0D16'                         ES_ST:
  0D16'   3A 2D4D'              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0D19'   B7                    	ORA	A		;   that char is the word's end already, and
  0D1A'   C2 0D44'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
  0D1D'                         ES_WS:
  0D1D'   CD 0C10'              	CALL	CCLS		; over blanks, line ends and empty lines
  0D20'   B7                    	ORA	A
  0D21'   C2 0D2D'              	JNZ	ES_SK
  0D24'   CD 0C4A'              	CALL	INCC
  0D27'   B7                    	ORA	A
  0D28'   F2 0D1D'              	JP	ES_WS
  0D2B'                         ES_F:
  0D2B'   37                    	STC
  0D2C'   C9                    	RET
  0D2D'                         ES_SK:
  0D2D'   CD 0C10'              	CALL	CCLS		; past the rest of this word ...
  0D30'   32 2D6E'              	STA	WKCLS
  0D33'                         ES_SL:
  0D33'   CD 0C4A'              	CALL	INCC
  0D36'   B7                    	ORA	A
  0D37'   FA 0D2B'              	JM	ES_F
  0D3A'   CD 0C10'              	CALL	CCLS
  0D3D'   21 2D6E'              	LXI	H,WKCLS
  0D40'   BE                    	CMP	M
  0D41'   CA 0D33'              	JZ	ES_SL
  0D44'   C3 0C8C'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's place among the screen's LINES (CURRW) and the
                                ; last layout's facts from SCRN.MAC: SCBOT (the last line shown), SCEOF / SCBOF
                                ; (the file's end / start is on the screen).  H and L count lines.  M and the
                                ; scrolls count screen ROWS, as vim does once lines wrap, and a line's rows
                                ; are not known without measuring it: SCRN.MAC's HTBLD measures the lines
                                ; about the screen into a table (HTAB), and the rest is arithmetic on that.
                                ; A scroll then moves the cursor and names the line the screen is to start
                                ; with (HTLAND -> SETRWT), so the text scrolls around it.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0D47'                         CURRW:
  0D47'   2A 0000*              	LHLD	WINROW
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D4A'   EB                    	XCHG
  0D4B'   2A 0000*              	LHLD	LNDLT
  0D4E'   19                    	DAD	D		; HL = row (signed)
  0D4F'   7C                    	MOV	A,H
  0D50'   B7                    	ORA	A
  0D51'   FA 0D64'              	JM	CRW_0		; above the screen -> top row
  0D54'   C2 0D5F'              	JNZ	CRW_BT		; far below -> bottom row
  0D57'   3A 0000*              	LDA	NEDIT
  0D5A'   3D                    	DCR	A		; A = bottom row
  0D5B'   BD                    	CMP	L		; CY iff bottom < row
  0D5C'   D8                    	RC
  0D5D'   7D                    	MOV	A,L
  0D5E'   C9                    	RET
  0D5F'                         CRW_BT:
  0D5F'   3A 0000*              	LDA	NEDIT
  0D62'   3D                    	DCR	A
  0D63'   C9                    	RET
  0D64'                         CRW_0:
  0D64'   AF                    	XRA	A
  0D65'   C9                    	RET
                                
                                ;SETRWT -- A = lines: the next layout puts that many above the cursor's, and
                                ; does not ask whether the line has gone far (PLACE).
  0D66'                         SETRWT:
  0D66'   2A 0000*              	LHLD	LNDLT
  0D69'   EB                    	XCHG
  0D6A'   6F                    	MOV	L,A
  0D6B'   26 00                 	MVI	H,0
  0D6D'   CD 0000*              	CALL	SUBHD		; HL = lines - LNDLT
  0D70'   22 0000*              	SHLD	WINROW
  0D73'   3E 01                 	MVI	A,PL_SET
  0D75'   32 0000*              	STA	PLACE
  0D78'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0D79'                         MVROW:
  0D79'   47                    	MOV	B,A
  0D7A'   CD 0D47'              	CALL	CURRW
  0D7D'   90                    	SUB	B		; A = row now - target
  0D7E'                         MR_GO:
  0D7E'   C8                    	RZ
  0D7F'   DA 0D88'              	JC	MR_DN
  0D82'   6F                    	MOV	L,A
  0D83'   26 00                 	MVI	H,0
  0D85'   C3 09D2'              	JMP	KCORE
  0D88'                         MR_DN:
  0D88'   2F                    	CMA
  0D89'   3C                    	INR	A		; A = target - row now
  0D8A'   6F                    	MOV	L,A
  0D8B'   26 00                 	MVI	H,0
  0D8D'   C3 0935'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0D90'                         VC_HIGH:
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0D90'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0D93'   2B                    	DCX	H		; row = count - 1
  0D94'   7C                    	MOV	A,H
  0D95'   B7                    	ORA	A
  0D96'   3A 0000*              	LDA	SCBOT
  0D99'   C2 0DA1'              	JNZ	VH_GO		; >= 256 -> the last text row
  0D9C'   BD                    	CMP	L		; CY iff SCBOT < row
  0D9D'   DA 0DA1'              	JC	VH_GO
  0DA0'   7D                    	MOV	A,L
  0DA1'                         VH_GO:
  0DA1'   CD 0D79'              	CALL	MVROW
  0DA4'   C3 087A'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': the line the middle ROW of the text is on (vim: the first
                                ; whose rows, with those above it, come to half of them); count ignored.
  0DA7'                         VC_MIDL:
  0DA7'   CD 06B8'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0DAA'   CD 1039'              	CALL	HTSCR		; HL -> the top line's rows
  0DAD'   3A 0000*              	LDA	TXEND
  0DB0'   3C                    	INR	A
  0DB1'   B7                    	ORA	A
  0DB2'   1F                    	RAR
  0DB3'   3D                    	DCR	A
  0DB4'   4F                    	MOV	C,A		; C = (rows of text + 1) / 2 - 1
  0DB5'   CD 107F'              	CALL	HTFQ
  0DB8'   D2 0DBC'              	JNC	VM_GO
  0DBB'   2B                    	DCX	H
  0DBC'                         VM_GO:
  0DBC'   CD 1074'              	CALL	HTGO
  0DBF'   C3 087A'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0DC2'                         VC_LOWL:
  0DC2'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0DC5'   2B                    	DCX	H		; count - 1
  0DC6'   3A 0000*              	LDA	SCBOT
  0DC9'   5F                    	MOV	E,A
  0DCA'   16 00                 	MVI	D,0
  0DCC'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0DCD'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0DD0'   3E 00                 	MVI	A,0
  0DD2'   D2 0DD9'              	JNC	VL_GO		; at or past the top -> row 0
  0DD5'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0DD8'   7D                    	MOV	A,L
  0DD9'                         VL_GO:
  0DD9'   CD 0D79'              	CALL	MVROW
  0DDC'   C3 087A'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the text forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is the
                                ; screen's ROWS less the overlap (OVLAP), and the line that many rows down
                                ; becomes the top line -- from its first row, vim never showing part of one.
                                ; The top line stops at the last line ('~' rows below); no-op when it is
                                ; already there.
  0DDF'                         VC_PGDN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0DDF'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0DE2'   22 2D2A'              	SHLD	RWR
  0DE5'   3A 0000*              	LDA	SCEOF
  0DE8'   B7                    	ORA	A
  0DE9'   CA 0DF1'              	JZ	VPD_N
  0DEC'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: it becomes the
  0DEF'   B7                    	ORA	A		;   top line
  0DF0'   C8                    	RZ			; it already is
  0DF1'                         VPD_N:
  0DF1'   3A 0000*              	LDA	NEDIT
  0DF4'   3C                    	INR	A
  0DF5'   4F                    	MOV	C,A
  0DF6'   3E 02                 	MVI	A,2
  0DF8'   CD 1040'              	CALL	HTSET		; HL -> the top line's rows
  0DFB'   E5                    	PUSH	H
  0DFC'   C5                    	PUSH	B
  0DFD'   3A 0000*              	LDA	NEDIT
  0E00'   4F                    	MOV	C,A
  0E01'   CD 107F'              	CALL	HTFQ		; HL -> the first line the screen has not room for
  0E04'   3A 0000*              	LDA	NEDIT
  0E07'   DA 0E14'              	JC	VPD_R		; there is none: no overlap
  0E0A'   3A 2D25'              	LDA	HTN
  0E0D'   90                    	SUB	B
  0E0E'   3C                    	INR	A
  0E0F'   47                    	MOV	B,A		; the lines from it up to the table's first
  0E10'   AF                    	XRA	A
  0E11'   CD 0EAE'              	CALL	OVLAP
  0E14'                         VPD_R:
  0E14'   CD 0EFD'              	CALL	PGROWS		; RWR = the rows to go
  0E17'   C1                    	POP	B
  0E18'   E1                    	POP	H
  0E19'   CD 10C0'              	CALL	RWFWD		; HL -> the line that row is in, C = which of its
  0E1C'   DA 0E38'              	JC	VPD_TP		; the text ended: its last line
  0E1F'   79                    	MOV	A,C
  0E20'   B7                    	ORA	A
  0E21'   CA 0E38'              	JZ	VPD_TP
  0E24'   3A 2D2C'              	LDA	RWMV		; part of the way down a line: its start -- unless
  0E27'   B7                    	ORA	A		;   that is the top line still, then the next
  0E28'   C2 0E38'              	JNZ	VPD_TP
  0E2B'   E5                    	PUSH	H
  0E2C'   CD 106E'              	CALL	HTIX
  0E2F'   21 2D27'              	LXI	H,HTTP
  0E32'   BE                    	CMP	M
  0E33'   E1                    	POP	H
  0E34'   C2 0E38'              	JNZ	VPD_TP
  0E37'   23                    	INX	H
  0E38'                         VPD_TP:
  0E38'   54                    	MOV	D,H
  0E39'   5D                    	MOV	E,L
  0E3A'   C3 0FA7'              	JMP	HTLAND
                                
                                ;VC_PGUP -- '^B': the text back count pages, not above the first line, the
                                ; cursor on the last line that then shows whole, first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is the screen's ROWS less the overlap
                                ; (OVLAP).  Where that ends part of the way up a line, the top line is the one
                                ; under it -- but the line itself, when it is the first one back.  No-op when
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


                                ; the first line is already at the top.
  0E3D'                         VC_PGUP:
  0E3D'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0E40'   22 2D2A'              	SHLD	RWR
  0E43'   3A 0000*              	LDA	SCBOF
  0E46'   B7                    	ORA	A
  0E47'   C0                    	RNZ
  0E48'   CD 0D47'              	CALL	CURRW		; OVLAP reads the top line and the two under it:
  0E4B'   FE 02                 	CPI	2		;   lines the cursor's is not below are read for
  0E4D'   0E 01                 	MVI	C,1
  0E4F'   D2 0E56'              	JNC	VPU_1
  0E52'   3A 0000*              	LDA	NEDIT
  0E55'   4F                    	MOV	C,A
  0E56'                         VPU_1:
  0E56'   3A 0000*              	LDA	NEDIT
  0E59'   CD 1040'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  0E5C'   E5                    	PUSH	H
  0E5D'   D5                    	PUSH	D
  0E5E'   2B                    	DCX	H		; the line above the top one, and on down
  0E5F'   04                    	INR	B
  0E60'   3E 01                 	MVI	A,1
  0E62'   CD 0EAE'              	CALL	OVLAP
  0E65'   CD 0EFD'              	CALL	PGROWS		; RWR = the rows to go
  0E68'   D1                    	POP	D
  0E69'   E1                    	POP	H
  0E6A'   43                    	MOV	B,E
  0E6B'   CD 1100'              	CALL	RWBAK		; HL -> the line that row is in, C = its rows
  0E6E'   DA 0E8B'              	JC	VPU_3		;   above it; or the file's first line
  0E71'   79                    	MOV	A,C
  0E72'   B7                    	ORA	A
  0E73'   CA 0E8B'              	JZ	VPU_3
  0E76'   3A 2D2C'              	LDA	RWMV
  0E79'   B7                    	ORA	A
  0E7A'   C2 0E8A'              	JNZ	VPU_2
  0E7D'   E5                    	PUSH	H
  0E7E'   CD 106E'              	CALL	HTIX
  0E81'   3C                    	INR	A
  0E82'   21 2D27'              	LXI	H,HTTP
  0E85'   BE                    	CMP	M
  0E86'   E1                    	POP	H
  0E87'   CA 0E8B'              	JZ	VPU_3		; the first line back: all of it
  0E8A'                         VPU_2:
  0E8A'   23                    	INX	H
  0E8B'                         VPU_3:
  0E8B'   CD 1074'              	CALL	HTGO		; the cursor on the new top line ...
  0E8E'   3A 0000*              	LDA	NEDIT
  0E91'   4F                    	MOV	C,A
  0E92'   06 00                 	MVI	B,0
  0E94'   CD 1055'              	CALL	HTRB		; ... and the lines under it measured
  0E97'   E5                    	PUSH	H
  0E98'   3A 0000*              	LDA	NEDIT
  0E9B'   4F                    	MOV	C,A
  0E9C'   CD 107F'              	CALL	HTFQ		; HL -> the first the screen has not room for
  0E9F'   2B                    	DCX	H
  0EA0'   D1                    	POP	D		; DE -> the top line's rows
  0EA1'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0EA2'   CD 0000*              	CALL	CMP16		; CY iff that is above the top line (it alone
  0EA5'   D2 0EAA'              	JNC	VPU_4		;   fills the screen)
  0EA8'   54                    	MOV	D,H
  0EA9'   5D                    	MOV	E,L
  0EAA'                         VPU_4:
  0EAA'   EB                    	XCHG
  0EAB'   C3 0FA7'              	JMP	HTLAND
                                
                                ;OVLAP -- A = the rows one page scrolls, as vim's get_scroll_overlap: the
                                ; screen less two lines of overlap -- or less one, or none, where the lines at
                                ; that edge are too tall to be shown twice or the file ends among them.
                                ;   in : HL -> the rows of the line just off the screen at that edge (h1),
                                ;        A = 0 when the next (h2, h3, h4) are above it in the table, 1 when
                                ;        below, B = the entries the table has that way, h1's among them
  0EAE'                         OVLAP:
  0EAE'   32 2D2D'              	STA	OVDIR
  0EB1'   3A 0000*              	LDA	NEDIT
  0EB4'   D6 02                 	SUI	2
  0EB6'   4F                    	MOV	C,A		; C = the rows two lines of overlap leave
  0EB7'   56                    	MOV	D,M		; D = h1
  0EB8'   CD 0EEF'              	CALL	OV_NX
  0EBB'   DA 0EEB'              	JC	OV_0
  0EBE'   5E                    	MOV	E,M		; E = h2
  0EBF'   7A                    	MOV	A,D
  0EC0'   83                    	ADD	E
  0EC1'   57                    	MOV	D,A		; D = h1 + h2
  0EC2'   79                    	MOV	A,C
  0EC3'   BA                    	CMP	D
  0EC4'   DA 0EEB'              	JC	OV_0
  0EC7'   CD 0EEF'              	CALL	OV_NX
  0ECA'   DA 0EEB'              	JC	OV_0
  0ECD'   7B                    	MOV	A,E
  0ECE'   86                    	ADD	M
  0ECF'   5F                    	MOV	E,A		; E = h2 + h3
  0ED0'   79                    	MOV	A,C
  0ED1'   BB                    	CMP	E
  0ED2'   DA 0EEB'              	JC	OV_0
  0ED5'   7A                    	MOV	A,D
  0ED6'   86                    	ADD	M
  0ED7'   57                    	MOV	D,A		; D = h1 + h2 + h3
  0ED8'   CD 0EEF'              	CALL	OV_NX
  0EDB'   DA 0EE8'              	JC	OV_1
  0EDE'   7B                    	MOV	A,E
  0EDF'   86                    	ADD	M		; h2 + h3 + h4
  0EE0'   5F                    	MOV	E,A
  0EE1'   79                    	MOV	A,C
  0EE2'   BB                    	CMP	E
  0EE3'   DA 0EE8'              	JC	OV_1
  0EE6'   BA                    	CMP	D
  0EE7'   D0                    	RNC			; two lines of overlap
  0EE8'                         OV_1:
  0EE8'   79                    	MOV	A,C
  0EE9'   3C                    	INR	A
  0EEA'   C9                    	RET
  0EEB'                         OV_0:
  0EEB'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0EEC'   C6 02                 	ADI	2
  0EEE'   C9                    	RET
                                ;OV_NX -- HL -> the next line's rows, that way.  CY if the table has no more.
  0EEF'                         OV_NX:
  0EEF'   05                    	DCR	B
  0EF0'   37                    	STC
  0EF1'   C8                    	RZ
  0EF2'   3A 2D2D'              	LDA	OVDIR
  0EF5'   B7                    	ORA	A		; (CY off)
  0EF6'   CA 0EFB'              	JZ	OV_UP
  0EF9'   23                    	INX	H
  0EFA'   23                    	INX	H
  0EFB'                         OV_UP:
  0EFB'   2B                    	DCX	H
  0EFC'   C9                    	RET
                                
                                ;PGROWS -- A = the rows of a page: RWR = the count (in RWR) of them, and no
                                ; line gone past yet (RWMV).
  0EFD'                         PGROWS:
  0EFD'   2A 2D2A'              	LHLD	RWR
  0F00'   CD 0F0B'              	CALL	MULSAT
  0F03'   22 2D2A'              	SHLD	RWR
  0F06'   AF                    	XRA	A
  0F07'   32 2D2C'              	STA	RWMV
  0F0A'   C9                    	RET
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0F0B'                         MULSAT:
  0F0B'   EB                    	XCHG
  0F0C'   21 0000               	LXI	H,0
  0F0F'   B7                    	ORA	A
  0F10'   C8                    	RZ
  0F11'                         MS_LP:
  0F11'   19                    	DAD	D
  0F12'   DA 0F1A'              	JC	MS_SAT
  0F15'   3D                    	DCR	A
  0F16'   C2 0F11'              	JNZ	MS_LP
  0F19'   C9                    	RET
  0F1A'                         MS_SAT:
  0F1A'   21 FFFF               	LXI	H,0FFFFH
  0F1D'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': the text and the cursor down HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text goes
                                ; no farther than brings the last row of the file to the bottom row; the line
                                ; that many rows down becomes the top line -- from its first row, vim never
                                ; showing part of one, and the cursor moves as many rows less (more, where
                                ; the top line alone was taller than that and the text had to go past it).
                                ; On the last line nothing moves, the column included.
  0F1E'                         VC_HFDN:
  0F1E'   CD 07A0'              	CALL	SETMOV
  0F21'   CD 1163'              	CALL	HFCNT		; HFN = the rows
  0F24'   3A 0000*              	LDA	TALLF
  0F27'   B7                    	ORA	A
  0F28'   C2 0FBE'              	JNZ	VHD_TL
  0F2B'   CD 0D47'              	CALL	CURRW
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F2E'   47                    	MOV	B,A
  0F2F'   3A 0000*              	LDA	SCEOF
  0F32'   B7                    	ORA	A
  0F33'   CA 0F3B'              	JZ	VHD_GO
  0F36'   3A 0000*              	LDA	SCBOT		; the last line's place
  0F39'   B8                    	CMP	B
  0F3A'   C8                    	RZ			; the cursor is on it
  0F3B'                         VHD_GO:
  0F3B'   3A 0000*              	LDA	NEDIT
  0F3E'   21 2D22'              	LXI	H,HFN
  0F41'   86                    	ADD	M
  0F42'   3C                    	INR	A
  0F43'   4F                    	MOV	C,A
  0F44'   AF                    	XRA	A
  0F45'   CD 1040'              	CALL	HTSET		; HL -> the top line's rows
  0F48'   3A 2D22'              	LDA	HFN
  0F4B'   57                    	MOV	D,A		; D = the rows the text moves
  0F4C'   5F                    	MOV	E,A		; E = the rows the cursor moves
  0F4D'   3A 2D28'              	LDA	HTEOF
  0F50'   B7                    	ORA	A
  0F51'   CA 0F70'              	JZ	VHD_1
  0F54'   E5                    	PUSH	H
  0F55'   C5                    	PUSH	B
  0F56'   0E FF                 	MVI	C,255
  0F58'   CD 107F'              	CALL	HTFQ		; (runs off: C = 255 - the rows to the file's end)
  0F5B'   3A 0000*              	LDA	NEDIT
  0F5E'   81                    	ADD	C
  0F5F'   2F                    	CMA			; A = those rows - NEDIT: the rows off the screen
  0F60'   C1                    	POP	B
  0F61'   E1                    	POP	H
  0F62'   B7                    	ORA	A
  0F63'   FA 0F6E'              	JM	VHD_0		; none
  0F66'   BA                    	CMP	D
  0F67'   D2 0F70'              	JNC	VHD_1
  0F6A'   57                    	MOV	D,A
  0F6B'   C3 0F70'              	JMP	VHD_1
  0F6E'                         VHD_0:
  0F6E'   16 00                 	MVI	D,0
  0F70'                         VHD_1:
  0F70'   7A                    	MOV	A,D
  0F71'   B7                    	ORA	A
  0F72'   CA 0F8D'              	JZ	VHD_C		; the text stays
  0F75'   4A                    	MOV	C,D
  0F76'   CD 107F'              	CALL	HTFQ		; HL -> the line that row is in, C = which of its
  0F79'   79                    	MOV	A,C
  0F7A'   B7                    	ORA	A
  0F7B'   CA 0F8D'              	JZ	VHD_C
  0F7E'   BA                    	CMP	D
  0F7F'   C2 0F8A'              	JNZ	VHD_R
  0F82'   7E                    	MOV	A,M		; the top line still: past all of it
  0F83'   91                    	SUB	C
  0F84'   83                    	ADD	E
  0F85'   5F                    	MOV	E,A
  0F86'   23                    	INX	H
  0F87'   C3 0F8D'              	JMP	VHD_C
  0F8A'                         VHD_R:
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F8A'   7B                    	MOV	A,E		; part of the way down a line: its start
  0F8B'   91                    	SUB	C
  0F8C'   5F                    	MOV	E,A
  0F8D'                         VHD_C:
  0F8D'   22 2D23'              	SHLD	HFTP
  0F90'   3A 0000*              	LDA	CSUB		; the cursor: E rows down from the one it is on
  0F93'   83                    	ADD	E
  0F94'   4F                    	MOV	C,A
  0F95'   3A 2D26'              	LDA	HTCUR
  0F98'   CD 1061'              	CALL	HTPT
  0F9B'   CD 107F'              	CALL	HTFQ
  0F9E'   D2 0FA2'              	JNC	HFEND
  0FA1'   2B                    	DCX	H		; the file ends first: its last line
                                ;HFEND -- ^D / ^U: HL -> the rows of the line the cursor goes to.
  0FA2'                         HFEND:
  0FA2'   EB                    	XCHG
  0FA3'   2A 2D23'              	LHLD	HFTP
  0FA6'   EB                    	XCHG
                                ;HTLAND -- the cursor to the line whose rows HL points at, DE -> those of the
                                ; line the screen is to start with (never one under it); first non-blank.
  0FA7'                         HTLAND:
  0FA7'   E5                    	PUSH	H
  0FA8'   D5                    	PUSH	D
  0FA9'   CD 1074'              	CALL	HTGO
  0FAC'   D1                    	POP	D
  0FAD'   E1                    	POP	H
  0FAE'   CD 0000*              	CALL	SUBHD		; HL = the lines between them
  0FB1'   7C                    	MOV	A,H
  0FB2'   B7                    	ORA	A
  0FB3'   7D                    	MOV	A,L
  0FB4'   CA 0FB8'              	JZ	HL_SET
  0FB7'   AF                    	XRA	A
  0FB8'                         HL_SET:
  0FB8'   CD 0D66'              	CALL	SETRWT
  0FBB'   C3 087A'              	JMP	FNBLNK
                                
                                ;--- the top line is taller than the screen, and the cursor in it: vim goes
                                ;    on scrolling until the next line is at the top, the cursor keeping its
                                ;    row of the screen ---
  0FBE'                         VHD_TL:
  0FBE'   3A 0000*              	LDA	SKIPR
  0FC1'   47                    	MOV	B,A
  0FC2'   3A 0000*              	LDA	CSUB
  0FC5'   90                    	SUB	B		; A = that row
  0FC6'   F5                    	PUSH	PSW
  0FC7'   21 0001               	LXI	H,1
  0FCA'   CD 0935'              	CALL	JCORE		; (on the last line: nowhere to go)
  0FCD'   F1                    	POP	PSW
  0FCE'   4F                    	MOV	C,A
  0FCF'   C5                    	PUSH	B
  0FD0'   0C                    	INR	C
  0FD1'   06 00                 	MVI	B,0
  0FD3'   CD 1055'              	CALL	HTRB		; HL -> the rows of the line now the cursor's
  0FD6'   22 2D23'              	SHLD	HFTP
  0FD9'   D1                    	POP	D
  0FDA'   4B                    	MOV	C,E
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FDB'   CD 107F'              	CALL	HTFQ
  0FDE'   D2 0FA2'              	JNC	HFEND
  0FE1'   2B                    	DCX	H
  0FE2'   C3 0FA2'              	JMP	HFEND
                                
                                ;VC_HFUP -- '^U': the text and the cursor up HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text
                                ; stops at the first line, the cursor goes on.  Where the rows end part of
                                ; the way up a line, the top line is the one under it and the cursor moves as
                                ; many rows less -- but the line itself, and as many more, when it is the
                                ; first one back.  On the first line nothing moves, the column included.
  0FE5'                         VC_HFUP:
  0FE5'   CD 07A0'              	CALL	SETMOV
  0FE8'   CD 1163'              	CALL	HFCNT		; HFN = the rows
  0FEB'   CD 1143'              	CALL	ONFST
  0FEE'   C8                    	RZ			; the cursor is on the first line
  0FEF'   0E 01                 	MVI	C,1
  0FF1'   3A 2D22'              	LDA	HFN
  0FF4'   CD 1040'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  0FF7'   43                    	MOV	B,E
  0FF8'   3A 2D22'              	LDA	HFN
  0FFB'   4F                    	MOV	C,A
  0FFC'   5F                    	MOV	E,A		; E = the rows the cursor moves
  0FFD'   CD 1090'              	CALL	HTBQ		; HL -> the line that row is in, C = its rows
  1000'   DA 101B'              	JC	VHU_C		;   above it; or the file's first line
  1003'   79                    	MOV	A,C
  1004'   B7                    	ORA	A
  1005'   CA 101B'              	JZ	VHU_C
  1008'   3A 2D27'              	LDA	HTTP
  100B'   3D                    	DCR	A
  100C'   B8                    	CMP	B
  100D'   CA 1018'              	JZ	VHU_F
  1010'   7B                    	MOV	A,E		; part of the way up a line: the one under it
  1011'   96                    	SUB	M
  1012'   81                    	ADD	C
  1013'   5F                    	MOV	E,A
  1014'   23                    	INX	H
  1015'   C3 101B'              	JMP	VHU_C
  1018'                         VHU_F:
  1018'   7B                    	MOV	A,E		; ... the first line back: all of it
  1019'   81                    	ADD	C
  101A'   5F                    	MOV	E,A
  101B'                         VHU_C:
  101B'   22 2D23'              	SHLD	HFTP
  101E'   4B                    	MOV	C,E
  101F'   3A 2D26'              	LDA	HTCUR
  1022'   CD 1061'              	CALL	HTPT		; HL -> the cursor line's rows, E = lines above it
  1025'   3A 0000*              	LDA	CSUB
  1028'   57                    	MOV	D,A
  1029'   79                    	MOV	A,C
  102A'   92                    	SUB	D		; the rows to go, less those of its own line above it
  102B'   DA 0FA2'              	JC	HFEND
  102E'   CA 0FA2'              	JZ	HFEND
  1031'   4F                    	MOV	C,A
  1032'   43                    	MOV	B,E
  1033'   CD 1090'              	CALL	HTBQ		; (off the top: the file's first line)
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  1036'   C3 0FA2'              	JMP	HFEND
                                
                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
                                ;HTSCR -- the table as the last layout left it, which is the screen's own:
                                ; HL, B and E as HTSET gives them, and nothing measured.
  1039'                         HTSCR:
  1039'   CD 0D47'              	CALL	CURRW
  103C'   47                    	MOV	B,A
  103D'   C3 104B'              	JMP	HS_TP
  1040'                         HTSET:
  1040'   47                    	MOV	B,A
  1041'   CD 0D47'              	CALL	CURRW		; (keeps BC)
  1044'   F5                    	PUSH	PSW
  1045'   80                    	ADD	B
  1046'   47                    	MOV	B,A
  1047'   CD 1055'              	CALL	HTRB
  104A'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  104B'                         HS_TP:
  104B'   3A 2D26'              	LDA	HTCUR
  104E'   90                    	SUB	B
  104F'   32 2D27'              	STA	HTTP
  1052'   C3 1061'              	JMP	HTPT
  1055'                         HTRB:
  1055'   CD 1233'              	CALL	ZSAVE
  1058'   CD 0000*              	CALL	HTBLD
  105B'   CD 1246'              	CALL	ZREST
  105E'   3A 2D26'              	LDA	HTCUR
  1061'                         HTPT:
  1061'   5F                    	MOV	E,A
  1062'   16 00                 	MVI	D,0
  1064'   21 0000*              	LXI	H,HTAB
  1067'   19                    	DAD	D
  1068'   3A 2D25'              	LDA	HTN
  106B'   93                    	SUB	E
  106C'   47                    	MOV	B,A
  106D'   C9                    	RET
                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  106E'                         HTIX:
  106E'   11 0000*              	LXI	D,HTAB
  1071'   7D                    	MOV	A,L
  1072'   93                    	SUB	E
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  1073'   C9                    	RET
                                
                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
  1074'                         HTGO:
  1074'   CD 106E'              	CALL	HTIX
  1077'   47                    	MOV	B,A
  1078'   3A 2D26'              	LDA	HTCUR
  107B'   90                    	SUB	B		; A = the lines up to it
  107C'   C3 0D7E'              	JMP	MR_GO
                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  107F'                         HTFQ:
  107F'   78                    	MOV	A,B
  1080'   B7                    	ORA	A
  1081'   37                    	STC
  1082'   C8                    	RZ
  1083'   79                    	MOV	A,C
  1084'   96                    	SUB	M
  1085'   DA 108E'              	JC	HF_IN
  1088'   4F                    	MOV	C,A
  1089'   23                    	INX	H
  108A'   05                    	DCR	B
  108B'   C3 107F'              	JMP	HTFQ
  108E'                         HF_IN:
  108E'   B7                    	ORA	A
  108F'   C9                    	RET
                                
                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
                                ;        the table starts first (HL -> its first entry, C = the rows short)
  1090'                         HTBQ:
  1090'   78                    	MOV	A,B
  1091'   B7                    	ORA	A
  1092'   37                    	STC
  1093'   C8                    	RZ
  1094'   2B                    	DCX	H
  1095'   05                    	DCR	B
  1096'   7E                    	MOV	A,M
  1097'   91                    	SUB	C
  1098'   D2 10A1'              	JNC	HQ_IN
  109B'   2F                    	CMA
  109C'   3C                    	INR	A
  109D'   4F                    	MOV	C,A
  109E'   C3 1090'              	JMP	HTBQ
  10A1'                         HQ_IN:
  10A1'   4F                    	MOV	C,A
  10A2'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


                                ; Keeps HL, B, DE.
  10A3'                         RWQ:
  10A3'   0E 64                 	MVI	C,100
  10A5'   3A 2D2B'              	LDA	RWR+1
  10A8'   B7                    	ORA	A
  10A9'   C0                    	RNZ
  10AA'   3A 2D2A'              	LDA	RWR
  10AD'   B9                    	CMP	C
  10AE'   D0                    	RNC
  10AF'   4F                    	MOV	C,A
  10B0'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  10B1'                         RWSUB:
  10B1'   E5                    	PUSH	H
  10B2'   5F                    	MOV	E,A
  10B3'   16 00                 	MVI	D,0
  10B5'   2A 2D2A'              	LHLD	RWR
  10B8'   CD 0000*              	CALL	SUBHD
  10BB'   22 2D2A'              	SHLD	RWR
  10BE'   E1                    	POP	H
  10BF'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
                                ; whose entry HL points at (B = the entries from it on), however far that is:
                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  10C0'                         RWFWD:
  10C0'   CD 10A3'              	CALL	RWQ
  10C3'   51                    	MOV	D,C
  10C4'   CD 107F'              	CALL	HTFQ
  10C7'   F5                    	PUSH	PSW
  10C8'   7A                    	MOV	A,D
  10C9'   91                    	SUB	C		; the rows that took it to that line's first
  10CA'   CD 10B1'              	CALL	RWSUB
  10CD'   F1                    	POP	PSW
  10CE'   DA 10E2'              	JC	RF_OFF
  10D1'   3A 2D2B'              	LDA	RWR+1		; is what is left inside this line?
  10D4'   B7                    	ORA	A
  10D5'   C2 10EC'              	JNZ	RF_GO
  10D8'   3A 2D2A'              	LDA	RWR
  10DB'   BE                    	CMP	M
  10DC'   D2 10EC'              	JNC	RF_GO
  10DF'   4F                    	MOV	C,A
  10E0'   B7                    	ORA	A
  10E1'   C9                    	RET
  10E2'                         RF_OFF:
  10E2'   3A 2D28'              	LDA	HTEOF
  10E5'   B7                    	ORA	A
  10E6'   CA 10EC'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  10E9'   2B                    	DCX	H
  10EA'   37                    	STC
  10EB'   C9                    	RET
  10EC'                         RF_GO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  10EC'   CD 1074'              	CALL	HTGO
  10EF'   3E 01                 	MVI	A,1
  10F1'   32 2D2C'              	STA	RWMV
  10F4'   CD 10A3'              	CALL	RWQ
  10F7'   0C                    	INR	C
  10F8'   06 00                 	MVI	B,0
  10FA'   CD 1055'              	CALL	HTRB
  10FD'   C3 10C0'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  1100'                         RWBAK:
  1100'   CD 10A3'              	CALL	RWQ
  1103'   51                    	MOV	D,C
  1104'   CD 1090'              	CALL	HTBQ
  1107'   DA 1124'              	JC	RB_OFF
  110A'   7A                    	MOV	A,D
  110B'   81                    	ADD	C
  110C'   5F                    	MOV	E,A		; E = the rows up to that line's first
  110D'   3A 2D2B'              	LDA	RWR+1
  1110'   B7                    	ORA	A
  1111'   C2 1120'              	JNZ	RB_ON
  1114'   3A 2D2A'              	LDA	RWR
  1117'   57                    	MOV	D,A
  1118'   7B                    	MOV	A,E
  1119'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  111A'   DA 1120'              	JC	RB_ON
  111D'   4F                    	MOV	C,A
  111E'   B7                    	ORA	A
  111F'   C9                    	RET
  1120'                         RB_ON:
  1120'   7B                    	MOV	A,E
  1121'   C3 112B'              	JMP	RB_GO
  1124'                         RB_OFF:
  1124'   3A 2D29'              	LDA	HTBOF
  1127'   0F                    	RRC			; CY: that is the file's first line
  1128'   D8                    	RC
  1129'   7A                    	MOV	A,D
  112A'   91                    	SUB	C
  112B'                         RB_GO:
  112B'   CD 10B1'              	CALL	RWSUB
  112E'   CD 1074'              	CALL	HTGO
  1131'   3E 01                 	MVI	A,1
  1133'   32 2D2C'              	STA	RWMV
  1136'   CD 10A3'              	CALL	RWQ
  1139'   41                    	MOV	B,C
  113A'   0E 01                 	MVI	C,1
  113C'   CD 1055'              	CALL	HTRB
  113F'   43                    	MOV	B,E
  1140'   C3 1100'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  1143'                         ONFST:
  1143'   E5                    	PUSH	H
  1144'   2A 0000*              	LHLD	OUTPOS
  1147'   7C                    	MOV	A,H
  1148'   B5                    	ORA	L
  1149'   C2 1161'              	JNZ	OF_RET
  114C'   2A 0000*              	LHLD	TXTBEG
  114F'   EB                    	XCHG			; DE = TXTBEG
  1150'   2A 0000*              	LHLD	GAPBEG
  1153'                         OF_LP:
  1153'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  1156'   CA 1161'              	JZ	OF_RET
  1159'   2B                    	DCX	H
  115A'   7E                    	MOV	A,M
  115B'   FE 0A                 	CPI	LF
  115D'   C2 1153'              	JNZ	OF_LP
  1160'   B7                    	ORA	A		; NZ
  1161'                         OF_RET:
  1161'   E1                    	POP	H
  1162'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  1163'                         HFCNT:
  1163'   2A 2D15'              	LHLD	CMDCNT
  1166'   7C                    	MOV	A,H
  1167'   B5                    	ORA	L
  1168'   CA 117F'              	JZ	HFC_AM
  116B'   CD 06CB'              	CALL	GETCNT		; HL = count; clears it
  116E'   3A 0000*              	LDA	NEDIT
  1171'   5F                    	MOV	E,A
  1172'   16 00                 	MVI	D,0
  1174'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  1177'   D2 117B'              	JNC	HFC_ST
  117A'   EB                    	XCHG			; HL = NEDIT
  117B'                         HFC_ST:
  117B'   7D                    	MOV	A,L
  117C'   32 2D21'              	STA	HFAMT
  117F'                         HFC_AM:
  117F'   3A 2D21'              	LDA	HFAMT
  1182'   B7                    	ORA	A
  1183'   C2 1190'              	JNZ	HFC_HL
  1186'   3A 0000*              	LDA	NEDIT
  1189'   B7                    	ORA	A
  118A'   1F                    	RAR
  118B'   B7                    	ORA	A
  118C'   C2 1190'              	JNZ	HFC_HL
  118F'   3C                    	INR	A		; at least one row
  1190'                         HFC_HL:
  1190'   32 2D22'              	STA	HFN
  1193'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  1194'                         VC_REDR:
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1194'   C3 06CB'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (PLACE) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  1197'                         VC_G:
  1197'   CD 07A0'              	CALL	SETMOV
  119A'   CD 1259'              	CALL	GZONE		; the screen's top line, before the move
  119D'   CD 06F4'              	CALL	BRKON		; ... and an ESC may stop it from here on
  11A0'   2A 2D15'              	LHLD	CMDCNT
  11A3'   7C                    	MOV	A,H
  11A4'   B5                    	ORA	L
  11A5'   C2 11B8'              	JNZ	VG_N
  11A8'   AF                    	XRA	A		; forward
  11A9'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  11AC'   CD 0731'              	CALL	BRKOFF
  11AF'   DA 0749'              	JC	BRKBAK
  11B2'   CD 0A69'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  11B5'   C3 1271'              	JMP	GPLACE
  11B8'                         VG_N:
  11B8'   CD 06CB'              	CALL	GETCNT		; HL = target line (1-based)
  11BB'                         VG_LN:
  11BB'   CD 11C7'              	CALL	GOLN
  11BE'   CD 0731'              	CALL	BRKOFF
  11C1'   DA 0749'              	JC	BRKBAK
  11C4'   C3 1271'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  11C7'                         GOLN:
  11C7'   E5                    	PUSH	H
  11C8'   CD 0000*              	CALL	CNTLF
  11CB'   23                    	INX	H		; HL = the cursor's line
  11CC'   D1                    	POP	D		; DE = the line wanted
  11CD'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  11D0'   DA 11DB'              	JC	GLN_BK
  11D3'   EB                    	XCHG
  11D4'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  11D7'   AF                    	XRA	A
  11D8'   C3 11E0'              	JMP	GLN_MV
  11DB'                         GLN_BK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  11DB'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  11DE'   3E FF                 	MVI	A,0FFH
  11E0'                         GLN_MV:
  11E0'   CD 0000*              	CALL	MVLIND
  11E3'   CD 0A63'              	CALL	ATEOF
  11E6'   DC 0A69'              	CC	LASTLN		; past the last line: onto it
  11E9'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  11EA'                         VC_LG:
  11EA'   CD 07A0'              	CALL	SETMOV
  11ED'   3A 2D48'              	LDA	GSAVE
  11F0'   B7                    	ORA	A
  11F1'   C2 11FA'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  11F4'   3E 01                 	MVI	A,PG
  11F6'   32 2D47'              	STA	GPEND
  11F9'   C9                    	RET
  11FA'                         VLG_GG:
  11FA'   CD 1259'              	CALL	GZONE
  11FD'   CD 06F4'              	CALL	BRKON
  1200'   CD 06CB'              	CALL	GETCNT		; HL = target line (no count: 1)
  1203'   C3 11BB'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  1206'                         SUB24:
  1206'   4F                    	MOV	C,A
  1207'   7D                    	MOV	A,L
  1208'   93                    	SUB	E
  1209'   6F                    	MOV	L,A
  120A'   7C                    	MOV	A,H
  120B'   9A                    	SBB	D
  120C'   67                    	MOV	H,A
  120D'   79                    	MOV	A,C
  120E'   98                    	SBB	B
  120F'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  1210'                         CURFP:
  1210'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  1213'                         FPOS:
  1213'   C5                    	PUSH	B
  1214'   D5                    	PUSH	D
  1215'   EB                    	XCHG
  1216'   2A 0000*              	LHLD	TXTBEG
  1219'   EB                    	XCHG
  121A'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  121D'   EB                    	XCHG			; DE = that
  121E'   2A 0000*              	LHLD	OUTPOS
  1221'   7C                    	MOV	A,H
  1222'   B7                    	ORA	A		; CY = 0
  1223'   1F                    	RAR
  1224'   47                    	MOV	B,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  1225'   7D                    	MOV	A,L
  1226'   1F                    	RAR
  1227'   67                    	MOV	H,A
  1228'   3E 00                 	MVI	A,0
  122A'   1F                    	RAR
  122B'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  122C'   19                    	DAD	D
  122D'   78                    	MOV	A,B
  122E'   CE 00                 	ACI	0		; A:HL = the position
  1230'   D1                    	POP	D
  1231'   C1                    	POP	B
  1232'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  1233'                         ZSAVE:
  1233'   2A 2D15'              	LHLD	CMDCNT
  1236'   22 2D86'              	SHLD	ZSVCNT
  1239'   2A 0000*              	LHLD	AUXCNT
  123C'   22 2D88'              	SHLD	ZSVAUX
  123F'   3A 0000*              	LDA	DIRFLG
  1242'   32 2D8A'              	STA	ZSVDIR
  1245'   C9                    	RET
  1246'                         ZREST:
  1246'   2A 2D86'              	LHLD	ZSVCNT
  1249'   22 2D15'              	SHLD	CMDCNT
  124C'   2A 2D88'              	LHLD	ZSVAUX
  124F'   22 0000*              	SHLD	AUXCNT
  1252'   3A 2D8A'              	LDA	ZSVDIR
  1255'   32 0000*              	STA	DIRFLG
  1258'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  1259'                         GZONE:
  1259'   CD 1233'              	CALL	ZSAVE
  125C'   CD 0D47'              	CALL	CURRW
  125F'   6F                    	MOV	L,A
  1260'   26 00                 	MVI	H,0
  1262'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  1265'   CD 1213'              	CALL	FPOS
  1268'   22 0000*              	SHLD	ZTOP
  126B'   32 0002*              	STA	ZTOP+2
  126E'   C3 1246'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  1271'                         GPLACE:
  1271'   CD 1233'              	CALL	ZSAVE
  1274'   CD 1210'              	CALL	CURFP
  1277'   EB                    	XCHG
  1278'   2A 0000*              	LHLD	ZTOP
  127B'   EB                    	XCHG
  127C'   4F                    	MOV	C,A		; C:HL = the target's position
  127D'   3A 0002*              	LDA	ZTOP+2
  1280'   47                    	MOV	B,A		; B:DE = the top's
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  1281'   79                    	MOV	A,C
  1282'   CD 1206'              	CALL	SUB24
  1285'   22 2D83'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  1288'   DA 12C2'              	JC	GP_UP
  128B'   B7                    	ORA	A
  128C'   C2 1308'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  128F'   3A 0000*              	LDA	NEDIT
  1292'   87                    	ADD	A
  1293'   3C                    	INR	A
  1294'   6F                    	MOV	L,A
  1295'   26 00                 	MVI	H,0
  1297'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  129A'   CD 06C4'              	CALL	GBSUB		; HL = bytes from there to the target
  129D'   EB                    	XCHG
  129E'   2A 2D83'              	LHLD	ZDIF		; HL = bytes from the top to the target
  12A1'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  12A4'   DA 1308'              	JC	GP_MID
  12A7'   CD 06C4'              	CALL	GBSUB		; HL = the top line's start (resident)
  12AA'   01 0000               	LXI	B,0		; BC = lines from the top
  12AD'                         GP_CNT:
  12AD'   7A                    	MOV	A,D
  12AE'   B3                    	ORA	E
  12AF'   CA 12BE'              	JZ	GP_DN
  12B2'   7E                    	MOV	A,M
  12B3'   23                    	INX	H
  12B4'   1B                    	DCX	D
  12B5'   FE 0A                 	CPI	LF
  12B7'   C2 12AD'              	JNZ	GP_CNT
  12BA'   03                    	INX	B
  12BB'   C3 12AD'              	JMP	GP_CNT
  12BE'                         GP_DN:
  12BE'   79                    	MOV	A,C		; the lines from the top one to it
  12BF'   C3 1332'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  12C2'                         GP_UP:
  12C2'   3C                    	INR	A
  12C3'   C2 1308'              	JNZ	GP_MID		; 64K bytes or more above
  12C6'   2A 2D83'              	LHLD	ZDIF
  12C9'   EB                    	XCHG
  12CA'   21 0000               	LXI	H,0
  12CD'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  12D0'   7C                    	MOV	A,H
  12D1'   B5                    	ORA	L
  12D2'   CA 1308'              	JZ	GP_MID		; exactly 64K
  12D5'   EB                    	XCHG			; DE = bytes to read
  12D6'   AF                    	XRA	A
  12D7'   32 2D85'              	STA	ZLF
  12DA'   CD 0000*              	CALL	RGET0
  12DD'                         GP_RD:
  12DD'   CD 0000*              	CALL	RDGET		; (keeps DE)
  12E0'   DA 1308'              	JC	GP_MID
  12E3'   FE 0A                 	CPI	LF
  12E5'   C2 12F9'              	JNZ	GP_RN
  12E8'   3A 0000*              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12EB'   B7                    	ORA	A
  12EC'   1F                    	RAR
  12ED'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  12EF'   E5                    	PUSH	H
  12F0'   21 2D85'              	LXI	H,ZLF
  12F3'   34                    	INR	M
  12F4'   BE                    	CMP	M		; CY iff more lines than that
  12F5'   E1                    	POP	H
  12F6'   DA 1308'              	JC	GP_MID
  12F9'                         GP_RN:
  12F9'   1B                    	DCX	D
  12FA'   7A                    	MOV	A,D
  12FB'   B3                    	ORA	E
  12FC'   C2 12DD'              	JNZ	GP_RD
  12FF'   3E 01                 	MVI	A,PL_SET	; the top row
  1301'   32 0000*              	STA	PLACE
  1304'   AF                    	XRA	A
  1305'   C3 1312'              	JMP	GP_SET
  1308'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  1308'   3E 02                 	MVI	A,PL_MID
  130A'   32 0000*              	STA	PLACE		; mid-screen, as the rows fall
  130D'   3A 0000*              	LDA	NEDIT
  1310'   B7                    	ORA	A
  1311'   1F                    	RAR			; (no more lines above it than this)
  1312'                         GP_SET:
  1312'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  1313'   26 00                 	MVI	H,0
  1315'   22 0000*              	SHLD	WINROW
  1318'   21 0000               	LXI	H,0
  131B'   22 0000*              	SHLD	LNDLT
  131E'   CD 07C1'              	CALL	SETFUL		; the window may have paged: full repaint
  1321'                         GP_FIN:
  1321'   CD 1246'              	CALL	ZREST
  1324'   3A 2DAE'              	LDA	GPKEEP
  1327'   B7                    	ORA	A
  1328'   CA 087A'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  132B'   AF                    	XRA	A
  132C'   32 2DAE'              	STA	GPKEEP
  132F'   C3 05BD'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
                                ; adds LNDLT to it and arrives at the same line.
  1332'                         GP_ONS:
  1332'   6F                    	MOV	L,A
  1333'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  1335'   EB                    	XCHG
  1336'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  1339'   EB                    	XCHG
  133A'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  133D'   22 0000*              	SHLD	LNDLT
  1340'   3E 01                 	MVI	A,R_MOVE
  1342'   32 2D19'              	STA	RINTENT
  1345'   C3 1321'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  1348'                         OPPEND:
  1348'   AF                    	XRA	A
  1349'   32 2D4D'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  134C'   3A 2D4A'              	LDA	PSAVE
  134F'   FE 63                 	CPI	'c'
  1351'   C2 136E'              	JNZ	OPP_ND
  1354'   79                    	MOV	A,C
  1355'   FE 77                 	CPI	'w'
  1357'   CA 135F'              	JZ	OPP_W
  135A'   FE 57                 	CPI	'W'
  135C'   C2 136E'              	JNZ	OPP_ND
  135F'                         OPP_W:
  135F'   CD 1541'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  1362'   DA 136E'              	JC	OPP_ND
  1365'   79                    	MOV	A,C
  1366'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  1368'   4F                    	MOV	C,A
  1369'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  136B'   32 2D4D'              	STA	CWEOL		;   char for the next word's: see ESTEP
  136E'                         OPP_ND:
  136E'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  136F'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  1371'   C2 1385'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  1374'   CD 01F9'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  1377'   DA 1415'              	JC	OPABRT
  137A'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  137B'   FE 67                 	CPI	'g'
  137D'   C2 1415'              	JNZ	OPABRT
  1380'   3E 01                 	MVI	A,PG
  1382'   32 2D48'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  1385'                         OPP_NG:
  1385'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  1386'   21 2D4A'              	LXI	H,PSAVE
  1389'   BE                    	CMP	M
  138A'   CA 1562'              	JZ	OPLINE
  138D'   79                    	MOV	A,C		; (OPCLS classifies the key)
  138E'   CD 1578'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1391'   DA 1415'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  1394'   32 2D4C'              	STA	OPCLSV
  1397'   47                    	MOV	B,A		; B = the class
  1398'   3A 2D4A'              	LDA	PSAVE
  139B'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  139D'   C2 13A9'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  13A0'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  13A1'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  13A3'   C2 13CB'              	JNZ	OPP_GO
  13A6'   C3 13B4'              	JMP	OPP_NO
  13A9'                         OPP_NC:
  13A9'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  13AB'   C2 13CB'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  13AE'   78                    	MOV	A,B		;   a charwise register would need a type flag
  13AF'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  13B1'   CA 13CB'              	JZ	OPP_GO		;   within a line -- neither of which is built
  13B4'                         OPP_NO:
  13B4'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  13B5'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  13B7'   CA 13C5'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  13BA'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  13BC'   CA 13C5'              	JZ	OPP_SW		;   so swallow it before dropping the command
  13BF'   CD 0326'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  13C2'   C2 1415'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  13C5'                         OPP_SW:
  13C5'   CD 01F9'              	CALL	MKGETK
  13C8'   C3 1415'              	JMP	OPABRT
  13CB'                         OPP_GO:
  13CB'   AF                    	XRA	A
  13CC'   32 2D20'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  13CF'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  13D2'   22 2D4E'              	SHLD	OPSTA
  13D5'   C5                    	PUSH	B
  13D6'   21 2D52'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  13D9'   CD 0429'              	CALL	FPSTO		;   only good until the motion pages the window
  13DC'   3A 2D4C'              	LDA	OPCLSV
  13DF'   FE 02                 	CPI	2
  13E1'   CC 1418'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  13E4'   C1                    	POP	B
  13E5'   21 2C5C'              	LXI	H,CMDTAB
  13E8'   CD 00C3'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  13EB'   3A 2D4A'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  13EE'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  13EF'   CA 07A0'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  13F2'   CD 1444'              	CALL	OPSFIX		; where the start is in the window NOW
  13F5'   D2 1460'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  13F8'   22 2D4E'              	SHLD	OPSTA
  13FB'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  13FE'   22 2D50'              	SHLD	OPEND2
  1401'   3A 2D4A'              	LDA	PSAVE
  1404'   FE 79                 	CPI	'y'
  1406'   CA 1ACE'              	JZ	OPYANK		; a yank takes the span without losing it
  1409'   CD 15B3'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  140C'   3A 2D4A'              	LDA	PSAVE
  140F'   FE 63                 	CPI	'c'
  1411'   C0                    	RNZ
  1412'   C3 1887'              	JMP	SETINS
  1415'                         OPABRT:				; not a motion -> the operator is dropped and
  1415'   C3 00A6'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  1418'                         OPENDS:
  1418'   2A 2D4E'              	LHLD	OPSTA
  141B'   CD 0624'              	CALL	BOL
  141E'   11 2D55'              	LXI	D,OPSLO
  1421'   CD 1436'              	CALL	OPE_ST
  1424'   2A 2D4E'              	LHLD	OPSTA
  1427'   CD 0654'              	CALL	NLSTART
  142A'   11 2D58'              	LXI	D,OPSHI
  142D'   CD 1436'              	CALL	OPE_ST
  1430'   2A 2D4E'              	LHLD	OPSTA
  1433'   C3 0000*              	JMP	GOTO
  1436'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  1436'   D5                    	PUSH	D
  1437'   CD 0000*              	CALL	GOTO
  143A'   E1                    	POP	H
  143B'   C3 0429'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  143E'                         CURBD:
  143E'   CD 1210'              	CALL	CURFP
  1441'   EB                    	XCHG
  1442'   47                    	MOV	B,A
  1443'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  1444'                         OPSFIX:
  1444'   21 2D52'              	LXI	H,OPSFP
  1447'   CD 03DC'              	CALL	MKLOAD
  144A'   CD 143E'              	CALL	CURBD
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  144D'   2A 2DB8'              	LHLD	MKPOS
  1450'   3A 2DBA'              	LDA	MKPOS+2
  1453'   CD 1206'              	CALL	SUB24
  1456'   B4                    	ORA	H
  1457'   B5                    	ORA	L
  1458'   C2 03E9'              	JNZ	MKWIN
  145B'   CD 0000*              	CALL	CUROFF
  145E'   37                    	STC
  145F'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  1460'                         OPPGD:
  1460'   47                    	MOV	B,A
  1461'   3A 2D4C'              	LDA	OPCLSV
  1464'   FE 02                 	CPI	2
  1466'   C2 1522'              	JNZ	OPG_NO
  1469'   3A 2D4A'              	LDA	PSAVE
  146C'   FE 64                 	CPI	'd'
  146E'   C2 1522'              	JNZ	OPG_NO
  1471'   04                    	INR	B
  1472'   CA 1481'              	JZ	OPG_FW
  1475'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  1478'   CD 0624'              	CALL	BOL		;   and the high end is OPSHI as it stands
  147B'   CD 0000*              	CALL	GOTO
  147E'   C3 1499'              	JMP	OPG_GO
  1481'                         OPG_FW:
  1481'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  1484'   CD 0654'              	CALL	NLSTART		;   landed on, and the low one is where the
  1487'   11 2D58'              	LXI	D,OPSHI		;   start line began
  148A'   CD 1436'              	CALL	OPE_ST
  148D'   21 2D55'              	LXI	H,OPSLO
  1490'   CD 03DC'              	CALL	MKLOAD
  1493'   CD 03A9'              	CALL	MKPAGE
  1496'   CD 0000*              	CALL	GOTO
  1499'                         OPG_GO:
  1499'   CD 143E'              	CALL	CURBD
  149C'   2A 2D58'              	LHLD	OPSHI
  149F'   3A 2D5A'              	LDA	OPSHI+2
  14A2'   CD 1206'              	CALL	SUB24		; A:HL = the bytes to take
  14A5'                         OPG_SV:
  14A5'   22 2D5B'              	SHLD	OPTOGO
  14A8'   32 2D5D'              	STA	OPTOGO+2
  14AB'                         OPG_NX:
  14AB'   CD 06A7'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  14AE'   CD 0000*              	CALL	SUBHD
  14B1'   EB                    	XCHG			; DE = what the window holds past the cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  14B2'   2A 2D5B'              	LHLD	OPTOGO
  14B5'   3A 2D5D'              	LDA	OPTOGO+2
  14B8'   B7                    	ORA	A
  14B9'   C2 14EC'              	JNZ	OPG_PG		; 64K or more to go
  14BC'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  14BF'   DA 14EC'              	JC	OPG_PG
  14C2'   CA 14EC'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  14C5'                         OPG_FN:				; the rest of it is here
  14C5'   E5                    	PUSH	H
  14C6'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  14C9'   CD 0000*              	CALL	CUROFF
  14CC'   22 2D5E'              	SHLD	OPLO
  14CF'   D1                    	POP	D
  14D0'   19                    	DAD	D
  14D1'   22 2D60'              	SHLD	OPHI
  14D4'   CD 16E6'              	CALL	OPDSPN
  14D7'   CD 0A63'              	CALL	ATEOF
  14DA'   D2 153B'              	JNC	OPMID
  14DD'   CD 1143'              	CALL	ONFST		; deleted to the end of the file: onto the new
  14E0'   CA 153B'              	JZ	OPMID		;   last line, if there is one -- and the pager
  14E3'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  14E6'   CD 0000*              	CALL	SETBWD
  14E9'   C3 153B'              	JMP	OPMID
  14EC'                         OPG_PG:
  14EC'   7A                    	MOV	A,D
  14ED'   B3                    	ORA	E
  14EE'   C2 1507'              	JNZ	OPG_DL
  14F1'   CD 0A63'              	CALL	ATEOF		; nothing held past the cursor
  14F4'   21 0000               	LXI	H,0
  14F7'   DA 14C5'              	JC	OPG_FN		; ... and no more to come: the file ran out
  14FA'   2B                    	DCX	H
  14FB'   CD 0000*              	CALL	SETC0
  14FE'   CD 0000*              	CALL	GOLINE
  1501'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  1504'   C3 14AB'              	JMP	OPG_NX
  1507'                         OPG_DL:
  1507'   D5                    	PUSH	D
  1508'   21 FFFF               	LXI	H,0FFFFH
  150B'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  150E'   E1                    	POP	H
  150F'   E5                    	PUSH	H
  1510'   CD 0000*              	CALL	DELFWD
  1513'   D1                    	POP	D
  1514'   06 00                 	MVI	B,0
  1516'   2A 2D5B'              	LHLD	OPTOGO
  1519'   3A 2D5D'              	LDA	OPTOGO+2
  151C'   CD 1206'              	CALL	SUB24
  151F'   C3 14A5'              	JMP	OPG_SV
  1522'                         OPG_NO:
  1522'   0E 07                 	MVI	C,BEL
  1524'   CD 0000*              	CALL	BCONOU
  1527'                         OPG_HM:				; the cursor back where the command found it
  1527'   21 2D52'              	LXI	H,OPSFP
  152A'   CD 03DC'              	CALL	MKLOAD
  152D'   CD 03A9'              	CALL	MKPAGE
  1530'   CD 0000*              	CALL	GOTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  1533'   AF                    	XRA	A
  1534'   32 2D4A'              	STA	PSAVE
  1537'   3C                    	INR	A
  1538'   32 2DAE'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  153B'                         OPMID:
  153B'   CD 1233'              	CALL	ZSAVE
  153E'   C3 1308'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  1541'                         ONWHIT:
  1541'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1544'   CA 1560'              	JZ	OW_YES
  1547'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  154A'   FE 20                 	CPI	' '
  154C'   CA 1560'              	JZ	OW_YES
  154F'   FE 09                 	CPI	TAB
  1551'   CA 1560'              	JZ	OW_YES
  1554'   FE 0D                 	CPI	CR
  1556'   CA 1560'              	JZ	OW_YES
  1559'   FE 0A                 	CPI	LF
  155B'   CA 1560'              	JZ	OW_YES
  155E'   B7                    	ORA	A		; a char to change: CY clear
  155F'   C9                    	RET
  1560'                         OW_YES:
  1560'   37                    	STC
  1561'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  1562'                         OPLINE:
  1562'   3A 2D4A'              	LDA	PSAVE
  1565'   FE 63                 	CPI	'c'
  1567'   CA 07A0'              	JZ	SETMOV
  156A'   FE 79                 	CPI	'y'
  156C'   CA 1AAD'              	JZ	VY_YY
  156F'   21 2D52'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1572'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1575'   C3 1A23'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  1578'                         OPCLS:
  1578'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  157A'   CA 1587'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  157D'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  157F'   C2 159B'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1582'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1584'   C3 1589'              	JMP	OPC_FK
  1587'                         OPC_SEM:
  1587'   06 00                 	MVI	B,0		; ';' runs it as it stands
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  1589'                         OPC_FK:
  1589'   3A 2DA4'              	LDA	FNDKND
  158C'   B7                    	ORA	A
  158D'   37                    	STC
  158E'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  158F'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1590'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1592'   CA 1599'              	JZ	OPC_EXC
  1595'   3E 01                 	MVI	A,1
  1597'   B7                    	ORA	A		; CY clear: a motion, class 1
  1598'   C9                    	RET
  1599'                         OPC_EXC:
  1599'   AF                    	XRA	A		; class 0, CY clear
  159A'   C9                    	RET
  159B'                         OPC_TB:
  159B'   47                    	MOV	B,A
  159C'   21 177B'              	LXI	H,OPCTAB
  159F'                         OPC_LP:
  159F'   7E                    	MOV	A,M
  15A0'   B7                    	ORA	A
  15A1'   CA 15B1'              	JZ	OPC_MS		; end of table -> not a motion
  15A4'   B8                    	CMP	B
  15A5'   CA 15AD'              	JZ	OPC_HT
  15A8'   23                    	INX	H
  15A9'   23                    	INX	H
  15AA'   C3 159F'              	JMP	OPC_LP
  15AD'                         OPC_HT:
  15AD'   23                    	INX	H
  15AE'   7E                    	MOV	A,M		; class byte
  15AF'   B7                    	ORA	A		; clear CY
  15B0'   C9                    	RET
  15B1'                         OPC_MS:
  15B1'   37                    	STC
  15B2'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  15B3'                         OPAPPL:
  15B3'   3A 2D4C'              	LDA	OPCLSV
  15B6'   FE 02                 	CPI	2
  15B8'   CA 174F'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  15BB'   2A 2D4E'              	LHLD	OPSTA
  15BE'   EB                    	XCHG			; DE = start
  15BF'   2A 2D50'              	LHLD	OPEND2		; HL = end
  15C2'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  15C5'   DA 15D8'              	JC	OPA_F
  15C8'   CA 15D8'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  15CB'   22 2D5E'              	SHLD	OPLO
  15CE'   EB                    	XCHG
  15CF'   22 2D60'              	SHLD	OPHI
  15D2'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  15D5'   C3 168F'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  15D8'                         OPA_F:
  15D8'   EB                    	XCHG			; HL = start, DE = end
  15D9'   22 2D5E'              	SHLD	OPLO
  15DC'   EB                    	XCHG			; HL = end
  15DD'   3A 2D4C'              	LDA	OPCLSV
  15E0'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  15E2'   CA 168C'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  15E5'   FE 01                 	CPI	1
  15E7'   C2 1609'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  15EA'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  15EB'   22 2D60'              	SHLD	OPHI		; park it: CEND clobbers DE
  15EE'   2B                    	DCX	H		; the line it landed on
  15EF'   CD 1805'              	CALL	CEND		; HL = that line's content end
  15F2'   EB                    	XCHG			; DE = it
  15F3'   2A 2D60'              	LHLD	OPHI		; HL = hi
  15F6'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  15F9'   D2 1614'              	JNC	OPA_HI		; hi is inside the line: keep it
  15FC'   2A 2D5E'              	LHLD	OPLO
  15FF'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1602'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  1605'   EB                    	XCHG			; HL = the content end: the span stops there
  1606'   C3 1614'              	JMP	OPA_HI
  1609'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  1609'   22 2D60'              	SHLD	OPHI
  160C'   3A 2D20'              	LDA	WPULL
  160F'   B7                    	ORA	A
  1610'   CA 168F'              	JZ	OPA_C1
  1613'   23                    	INX	H
  1614'                         OPA_HI:
  1614'   22 2D60'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


                                ; all).  A change never does.
  1617'                         OPA_DO:
  1617'   CD 16DB'              	CALL	OPSPNL
  161A'   7C                    	MOV	A,H
  161B'   B5                    	ORA	L
  161C'   C2 1625'              	JNZ	OPA_D1
  161F'   2A 2D5E'              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  1622'   C3 0000*              	JMP	GOTO		;   to where the span starts
  1625'                         OPA_D1:
  1625'   3A 2D4A'              	LDA	PSAVE
  1628'   FE 63                 	CPI	'c'
  162A'   CA 16E6'              	JZ	OPDSPN
  162D'   CD 16CE'              	CALL	SPNBRK
  1630'   D2 1651'              	JNC	OPA_D2
  1633'   2A 2D60'              	LHLD	OPHI
  1636'   CD 1805'              	CALL	CEND
  1639'   EB                    	XCHG			; DE = the content end of the line it ends in
  163A'   2A 2D60'              	LHLD	OPHI
  163D'                         OPA_BL:
  163D'   CD 0000*              	CALL	CMP16
  1640'   CA 1657'              	JZ	OPA_BI		; only blanks after it
  1643'   D5                    	PUSH	D
  1644'   E5                    	PUSH	H
  1645'   CD 0000*              	CALL	CHARAT
  1648'   E1                    	POP	H
  1649'   D1                    	POP	D
  164A'   23                    	INX	H
  164B'   CD 1686'              	CALL	BLANKQ
  164E'   CA 163D'              	JZ	OPA_BL
  1651'                         OPA_D2:
  1651'   CD 16E6'              	CALL	OPDSPN
  1654'   C3 1816'              	JMP	CLAMPE
  1657'                         OPA_BI:
  1657'   CD 1669'              	CALL	LOIND
  165A'   C2 1651'              	JNZ	OPA_D2
  165D'   2A 2D60'              	LHLD	OPHI
  1660'   CD 0654'              	CALL	NLSTART
  1663'   22 2D60'              	SHLD	OPHI
  1666'   C3 16BA'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  1669'                         LOIND:
  1669'   2A 2D5E'              	LHLD	OPLO
  166C'   CD 0624'              	CALL	BOL
  166F'                         LI_LP:
  166F'   E5                    	PUSH	H
  1670'   EB                    	XCHG
  1671'   2A 2D5E'              	LHLD	OPLO
  1674'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  1677'   E1                    	POP	H
  1678'   C8                    	RZ
  1679'   E5                    	PUSH	H
  167A'   CD 0000*              	CALL	CHARAT
  167D'   E1                    	POP	H
  167E'   23                    	INX	H
  167F'   CD 1686'              	CALL	BLANKQ
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  1682'   CA 166F'              	JZ	LI_LP
  1685'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  1686'                         BLANKQ:
  1686'   FE 20                 	CPI	' '
  1688'   C8                    	RZ
  1689'   FE 09                 	CPI	TAB
  168B'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  168C'                         OPA_JP:
  168C'   22 2D60'              	SHLD	OPHI
  168F'                         OPA_C1:
  168F'   CD 16DB'              	CALL	OPSPNL
  1692'   7C                    	MOV	A,H
  1693'   B5                    	ORA	L
  1694'   CA 1617'              	JZ	OPA_DO		; nothing spanned
  1697'   2A 2D60'              	LHLD	OPHI
  169A'   CD 0624'              	CALL	BOL
  169D'   EB                    	XCHG
  169E'   2A 2D60'              	LHLD	OPHI
  16A1'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  16A4'   C2 1617'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  16A7'   CD 1669'              	CALL	LOIND
  16AA'   CA 16BA'              	JZ	C1_LW		; only blanks before lo: whole lines
  16AD'                         C1_CH:
  16AD'   2A 2D60'              	LHLD	OPHI		; back over the line break to the content end
  16B0'   2B                    	DCX	H		;   of the line before
  16B1'   CD 1805'              	CALL	CEND
  16B4'   22 2D60'              	SHLD	OPHI
  16B7'   C3 1617'              	JMP	OPA_DO
  16BA'                         C1_LW:
  16BA'   2A 2D5E'              	LHLD	OPLO
  16BD'   CD 0624'              	CALL	BOL
  16C0'   22 2D5E'              	SHLD	OPLO
  16C3'   3A 2D4A'              	LDA	PSAVE
  16C6'   FE 63                 	CPI	'c'
  16C8'   CA 16AD'              	JZ	C1_CH
  16CB'   C3 1762'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  16CE'                         SPNBRK:
  16CE'   2A 2D5E'              	LHLD	OPLO
  16D1'   CD 0637'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  16D4'   EB                    	XCHG			; DE = it
  16D5'   2A 2D60'              	LHLD	OPHI
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  16D8'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  16DB'                         OPSPNL:
  16DB'   2A 2D60'              	LHLD	OPHI
  16DE'   EB                    	XCHG
  16DF'   2A 2D5E'              	LHLD	OPLO
  16E2'   EB                    	XCHG			; HL = hi, DE = lo
  16E3'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  16E6'                         OPDSPN:
  16E6'   CD 16CE'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  16E9'   F5                    	PUSH	PSW
  16EA'   2A 2D5E'              	LHLD	OPLO
  16ED'   CD 0000*              	CALL	GOTO
  16F0'   CD 16DB'              	CALL	OPSPNL		; HL = hi - lo
  16F3'   CD 0000*              	CALL	DELFWD
  16F6'   CD 0174'              	CALL	MARKMOD
  16F9'   F1                    	POP	PSW
  16FA'   DA 07C1'              	JC	SETFUL		; a break went: every row below it moved up
  16FD'   C3 07A6'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  1700'                         UNDFNB:
  1700'   CD 0000*              	CALL	CUROFF
  1703'   E5                    	PUSH	H
  1704'   CD 087A'              	CALL	FNBLNK
  1707'   CD 0000*              	CALL	CUROFF
  170A'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  170B'   CD 0000*              	CALL	CMP16
  170E'   D2 0000*              	JNC	UNDHER
  1711'   EB                    	XCHG
  1712'   CD 0000*              	CALL	GOTO
  1715'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  1718'                         OPALSP:
  1718'   2A 2D4E'              	LHLD	OPSTA
  171B'   EB                    	XCHG
  171C'   2A 2D50'              	LHLD	OPEND2
  171F'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  1722'   DA 1732'              	JC	OPAL_F
  1725'   22 2D5E'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1728'   EB                    	XCHG
  1729'   22 2D60'              	SHLD	OPHI		; hi-src = start
  172C'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  172F'   C3 173C'              	JMP	OPAL_R
  1732'                         OPAL_F:
  1732'   EB                    	XCHG			; HL = start
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  1733'   22 2D5E'              	SHLD	OPLO		; lo-src = start
  1736'   2A 2D50'              	LHLD	OPEND2
  1739'   22 2D60'              	SHLD	OPHI		; hi-src = end
  173C'                         OPAL_R:
  173C'   2A 2D5E'              	LHLD	OPLO
  173F'   CD 0624'              	CALL	BOL
  1742'   22 2D5E'              	SHLD	OPLO		; lo = BOL(low line)
  1745'   2A 2D60'              	LHLD	OPHI
  1748'   CD 0654'              	CALL	NLSTART
  174B'   22 2D60'              	SHLD	OPHI		; hi = start of line past the high line
  174E'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  174F'                         OPALIN:
  174F'   CD 1718'              	CALL	OPALSP
  1752'   2A 2D5E'              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  1755'   CD 0654'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  1758'   EB                    	XCHG			;   the column)
  1759'   2A 2D60'              	LHLD	OPHI
  175C'   CD 0000*              	CALL	CMP16
  175F'   CC 1700'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  1762'                         OPDLIN:
  1762'   CD 16E6'              	CALL	OPDSPN
  1765'   CD 06A7'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1768'   DA 1778'              	JC	OPDL_NB
  176B'   CD 0000*              	CALL	LOGLEN
  176E'   7C                    	MOV	A,H
  176F'   B5                    	ORA	L
  1770'   C8                    	RZ			; empty buffer
  1771'   2B                    	DCX	H
  1772'   CD 0624'              	CALL	BOL
  1775'   CD 0000*              	CALL	GOTO
  1778'                         OPDL_NB:
  1778'   C3 087A'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  177B'                         OPCTAB:
  177B'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  177F'   62 00 42 00           
  1783'   68 00 6C 00           
  1787'   30 00 5E 00           
  178B'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  178D'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1791'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1795'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1799'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  179D'   24 01                 
  179F'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  17A3'   47 02 48 02           
  17A7'   4D 02 4C 02           
  17AB'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  17AD'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  17AF'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  17B0'                         VCB_C:
  17B0'   CD 17BC'              	CALL	VCB_CD
  17B3'   C3 1887'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  17B6'                         VCB_D:
  17B6'   CD 17BC'              	CALL	VCB_CD
  17B9'   C3 1816'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  17BC'                         VCB_CD:
  17BC'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  17BF'   22 2D5E'              	SHLD	OPLO
  17C2'   CD 0000*              	CALL	CUROFF
  17C5'   CD 1805'              	CALL	CEND		; to the line's content end, the CR,LF left
  17C8'   22 2D60'              	SHLD	OPHI
  17CB'   C3 16E6'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  17CE'                         VC_X:
  17CE'   CD 092C'              	CALL	GLSTAL
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  17D1'   CD 07A6'              	CALL	SETLIN
  17D4'   CD 06CB'              	CALL	GETCNT
  17D7'   22 2D62'              	SHLD	CNTV
  17DA'   CD 0000*              	CALL	CUROFF
  17DD'   22 2D66'              	SHLD	WKI		; cur
  17E0'   CD 1805'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  17E3'   EB                    	XCHG			; DE = contentend
  17E4'   2A 2D66'              	LHLD	WKI		; HL = cur
  17E7'   EB                    	XCHG			; HL = contentend, DE = cur
  17E8'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  17EB'   7C                    	MOV	A,H
  17EC'   B5                    	ORA	L
  17ED'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  17EE'   EB                    	XCHG			; DE = available
  17EF'   2A 2D62'              	LHLD	CNTV		; HL = count
  17F2'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  17F5'   DA 17FB'              	JC	VX_USEA
  17F8'   C3 17FC'              	JMP	VX_DEL		; count <= available -> HL = count = del
  17FB'                         VX_USEA:
  17FB'   EB                    	XCHG			; HL = available
  17FC'                         VX_DEL:
  17FC'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  17FF'   CD 0174'              	CALL	MARKMOD
  1802'   C3 1816'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  1805'                         CEND:
  1805'   CD 0637'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1808'   7C                    	MOV	A,H
  1809'   B5                    	ORA	L
  180A'   C8                    	RZ			; the start of the text: nothing before it
  180B'   2B                    	DCX	H
  180C'   E5                    	PUSH	H
  180D'   CD 0000*              	CALL	CHARAT
  1810'   E1                    	POP	H		; HL = term-1
  1811'   FE 0D                 	CPI	CR
  1813'   C8                    	RZ			; a CR before the LF -> the content ends there
  1814'   23                    	INX	H
  1815'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  1816'                         CLAMPE:
  1816'   CD 0000*              	CALL	CUROFF
  1819'   E5                    	PUSH	H
  181A'   CD 0663'              	CALL	EOLC
  181D'   D1                    	POP	D		; DE = cur
  181E'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  1821'   D8                    	RC
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  1822'   C8                    	RZ
  1823'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1826'                         VC_I:
  1826'   CD 06CB'              	CALL	GETCNT
  1829'   C3 1884'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  182C'                         VC_A:
  182C'   CD 06CB'              	CALL	GETCNT
  182F'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1832'   CA 1849'              	JZ	VA_INS
  1835'   EB                    	XCHG			; HL = cur
  1836'   E5                    	PUSH	H
  1837'   CD 0000*              	CALL	CHARAT
  183A'   E1                    	POP	H
  183B'   FE 0A                 	CPI	LF
  183D'   CA 1849'              	JZ	VA_INS		; on the line terminator -> append in place
  1840'   FE 0D                 	CPI	CR
  1842'   CA 1849'              	JZ	VA_INS
  1845'   23                    	INX	H
  1846'   CD 0000*              	CALL	GOTO
  1849'                         VA_INS:
  1849'   C3 1884'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  184C'                         VCB_A:
  184C'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  184F'   CD 0663'              	CALL	EOLC		; HL = last content char (the start when empty)
  1852'   E5                    	PUSH	H
  1853'   CD 0000*              	CALL	CHARAT
  1856'   E1                    	POP	H
  1857'   FE 0D                 	CPI	CR
  1859'   CA 1862'              	JZ	VBA_IN		; an empty line: insert at its start
  185C'   FE 0A                 	CPI	LF
  185E'   CA 1862'              	JZ	VBA_IN
  1861'   23                    	INX	H		; past the last content char
  1862'                         VBA_IN:
  1862'   CD 0000*              	CALL	GOTO
  1865'   C3 1884'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1868'                         VCB_I:
  1868'   CD 06CB'              	CALL	GETCNT
  186B'   CD 087A'              	CALL	FNBLNK
  186E'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  1871'   E5                    	PUSH	H
  1872'   CD 0000*              	CALL	CHARAT
  1875'   E1                    	POP	H
  1876'   FE 20                 	CPI	' '
  1878'   CA 1880'              	JZ	VBI_SK
  187B'   FE 09                 	CPI	TAB
  187D'   C2 1884'              	JNZ	SETINM
  1880'                         VBI_SK:
  1880'   23                    	INX	H		; blanks only: past the last of them
  1881'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1884'                         SETINM:
  1884'   CD 07A0'              	CALL	SETMOV
  1887'                         SETINS:
  1887'   3E 01                 	MVI	A,EM_INS
  1889'   32 2D14'              	STA	EDMODE
  188C'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  188D'                         ATCEND:
  188D'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1890'   C8                    	RZ
  1891'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  1894'   FE 0D                 	CPI	CR
  1896'   C8                    	RZ
  1897'   FE 0A                 	CPI	LF
  1899'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  189A'                         OPNBRK:
  189A'   CD 2191'              	CALL	PUTBRK
  189D'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  18A0'   23                    	INX	H
  18A1'   22 0000*              	SHLD	LNDLT
  18A4'   C3 0174'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  18A7'                         ENDBRK:
  18A7'   CD 06A7'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  18AA'   C0                    	RNZ
  18AB'   CD 189A'              	CALL	OPNBRK
  18AE'   CD 0000*              	CALL	CUROFF
  18B1'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  18B2'   2B                    	DCX	H		;   line, with its own terminator after it
  18B3'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  18B6'                         VC_O:
  18B6'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  18B9'   CD 1805'              	CALL	CEND
  18BC'   CD 0000*              	CALL	GOTO
  18BF'   CD 189A'              	CALL	OPNBRK
  18C2'   CD 18A7'              	CALL	ENDBRK		; a last line with no line end: the opened line
  18C5'   CD 07AC'              	CALL	SETILN		;   needs a terminator of its own to exist
  18C8'   C3 1887'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  18CB'                         VCB_O:
  18CB'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  18CE'   CD 0624'              	CALL	BOL
  18D1'   CD 0000*              	CALL	GOTO
  18D4'   CD 189A'              	CALL	OPNBRK
  18D7'   CD 0000*              	CALL	CUROFF
  18DA'   2B                    	DCX	H
  18DB'   2B                    	DCX	H
  18DC'   CD 0000*              	CALL	GOTO
  18DF'   CD 07AC'              	CALL	SETILN
  18E2'   C3 1887'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  18E5'                         VCB_J:
  18E5'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  18E8'   CD 1805'              	CALL	CEND		; the join point: this line's content end
  18EB'   22 2D5E'              	SHLD	OPLO
  18EE'   CD 0000*              	CALL	CUROFF
  18F1'   CD 0654'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  18F4'   E5                    	PUSH	H
  18F5'   CD 0000*              	CALL	LOGLEN
  18F8'   D1                    	POP	D		; DE = that start
  18F9'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  18FC'   CA 07A0'              	JZ	SETMOV
  18FF'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1900'                         VJ_WS:
  1900'   E5                    	PUSH	H
  1901'   CD 0000*              	CALL	LOGLEN
  1904'   D1                    	POP	D		; DE = the scan
  1905'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1908'   CA 191F'              	JZ	VJ_DEL
  190B'   EB                    	XCHG			; HL = the scan
  190C'   E5                    	PUSH	H
  190D'   CD 0000*              	CALL	CHARAT
  1910'   E1                    	POP	H
  1911'   FE 20                 	CPI	' '
  1913'   CA 191B'              	JZ	VJ_SKIP
  1916'   FE 09                 	CPI	TAB
  1918'   C2 191F'              	JNZ	VJ_DEL
  191B'                         VJ_SKIP:
  191B'   23                    	INX	H
  191C'   C3 1900'              	JMP	VJ_WS
  191F'                         VJ_DEL:
  191F'   22 2D60'              	SHLD	OPHI
  1922'   CD 16E6'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1925'   CD 07BB'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1928'   CD 06A7'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  192B'   CA 1816'              	JZ	CLAMPE
  192E'   CD 06B2'              	CALL	CURCHR		; the first char of what was appended
  1931'   FE 0D                 	CPI	CR
  1933'   CA 1816'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1936'   FE 0A                 	CPI	LF
  1938'   CA 1816'              	JZ	CLAMPE
  193B'   FE 29                 	CPI	')'
  193D'   CA 1816'              	JZ	CLAMPE		; vim puts no space before a ')'
  1940'   CD 0000*              	CALL	CUROFF
  1943'   7C                    	MOV	A,H
  1944'   B5                    	ORA	L
  1945'   CA 195B'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1948'   2B                    	DCX	H
  1949'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  194C'   FE 20                 	CPI	' '
  194E'   CA 1816'              	JZ	CLAMPE
  1951'   FE 09                 	CPI	TAB
  1953'   CA 1816'              	JZ	CLAMPE
  1956'   FE 0A                 	CPI	LF
  1958'   CA 1816'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  195B'                         VJ_SP:
  195B'   3E 20                 	MVI	A,' '
  195D'   CD 0000*              	CALL	PUTGAP
  1960'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1963'   2B                    	DCX	H
  1964'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1967'                         VC_TILD:
  1967'   CD 06CB'              	CALL	GETCNT
  196A'   CD 07A6'              	CALL	SETLIN		; only this row changes
  196D'   CD 092C'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1970'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1973'   CA 07A0'              	JZ	SETMOV
  1976'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  1979'   FE 0D                 	CPI	CR
  197B'   CA 07A0'              	JZ	SETMOV		; the line's end: nothing to toggle
  197E'   FE 0A                 	CPI	LF
  1980'   CA 07A0'              	JZ	SETMOV
  1983'   47                    	MOV	B,A
  1984'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1986'   FE 41                 	CPI	'A'
  1988'   DA 1994'              	JC	VT_PUT		; below 'A': no case
  198B'   FE 5B                 	CPI	'Z'+1
  198D'   D2 1994'              	JNC	VT_PUT		; above 'Z': no case
  1990'   78                    	MOV	A,B
  1991'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1993'   47                    	MOV	B,A
  1994'                         VT_PUT:
  1994'   78                    	MOV	A,B
  1995'   32 2D6F'              	STA	VRCH		; the calls below do not preserve B
  1998'   CD 0174'              	CALL	MARKMOD
  199B'   21 0001               	LXI	H,1
  199E'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  19A1'   3A 2D6F'              	LDA	VRCH
  19A4'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  19A7'   C3 1816'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  19AA'                         VC_R:
  19AA'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  19AD'   3E 03                 	MVI	A,PR
  19AF'   32 2D47'              	STA	GPEND
  19B2'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  19B3'                         VR_DO:
  19B3'   AF                    	XRA	A
  19B4'   32 2D47'              	STA	GPEND
  19B7'   79                    	MOV	A,C
  19B8'   32 2D6F'              	STA	VRCH		; the calls below do not preserve C
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  19BB'   CD 07A6'              	CALL	SETLIN		; only this row changed
  19BE'   CD 092C'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  19C1'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  19C4'   CA 07A0'              	JZ	SETMOV		; the end of the text: vim does nothing
  19C7'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  19CA'   FE 0D                 	CPI	CR
  19CC'   CA 07A0'              	JZ	SETMOV		; the line's end: nothing to replace
  19CF'   FE 0A                 	CPI	LF
  19D1'   CA 07A0'              	JZ	SETMOV
  19D4'   CD 0174'              	CALL	MARKMOD
  19D7'   21 0001               	LXI	H,1
  19DA'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  19DD'   3A 2D6F'              	LDA	VRCH
  19E0'   FE 0D                 	CPI	CR
  19E2'   CA 19EF'              	JZ	VR_CR
  19E5'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  19E8'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  19EB'   2B                    	DCX	H		;   out, which moves every logical offset
  19EC'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  19EF'                         VR_CR:
  19EF'   CD 189A'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  19F2'   CD 18A7'              	CALL	ENDBRK		;   replaced char may have been the text's last
  19F5'   CD 07AC'              	CALL	SETILN		;   row above it lost the char that was replaced,
  19F8'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  19FA'   32 2D1C'              	STA	ILABOV
  19FD'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  19FE'                         VCB_R:
  19FE'   CD 06CB'              	CALL	GETCNT
  1A01'   CD 07A0'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1A04'   21 0000               	LXI	H,0
  1A07'   22 2D70'              	SHLD	RPDEL		; nothing of ours to put back yet
  1A0A'   22 2D72'              	SHLD	RPAPP
  1A0D'   3E 02                 	MVI	A,EM_REP
  1A0F'   32 2D14'              	STA	EDMODE
  1A12'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1A13'                         VC_D:
  1A13'   3E 64                 	MVI	A,'d'
  1A15'   32 2D49'              	STA	PENDOP
  1A18'   C3 07A0'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1A1B'                         VC_C:
  1A1B'   3E 63                 	MVI	A,'c'
  1A1D'   32 2D49'              	STA	PENDOP
  1A20'   C3 07A0'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1A23'                         VD_DD:
  1A23'   CD 092C'              	CALL	GLSTAL
  1A26'   CD 06CB'              	CALL	GETCNT
  1A29'   22 2D62'              	SHLD	CNTV
  1A2C'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1A2E'   32 2D4B'              	STA	DDSNG
  1A31'   2B                    	DCX	H
  1A32'   7C                    	MOV	A,H
  1A33'   B5                    	ORA	L
  1A34'   C2 1A42'              	JNZ	VDD_LS
  1A37'   3E 01                 	MVI	A,1
  1A39'   32 2D4B'              	STA	DDSNG
  1A3C'   CD 1700'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1A3F'   C3 1A48'              	JMP	VDD_GO
  1A42'                         VDD_LS:
  1A42'   CD 08E5'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1A45'   DA 07A0'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1A48'                         VDD_GO:
  1A48'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1A4B'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1A4E'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1A51'   CD 23F4'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1A54'   CD 0863'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1A57'   2A 2D62'              	LHLD	CNTV
  1A5A'   CD 0000*              	CALL	SETC0
  1A5D'                         VDD_FW:
  1A5D'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1A60'   DA 1BAE'              	JC	QREFUS		; ... which has no room for them
  1A63'   CD 06E0'              	CALL	CNTTST
  1A66'   C2 1A5D'              	JNZ	VDD_FW
  1A69'   CD 0174'              	CALL	MARKMOD
  1A6C'   CD 0A63'              	CALL	ATEOF
  1A6F'   D2 1A8A'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1A72'   3E 00                 	MVI	A,0
  1A74'   32 2D4B'              	STA	DDSNG		; deleted to the end: full repaint
  1A77'   CD 1143'              	CALL	ONFST
  1A7A'   CA 087A'              	JZ	FNBLNK		; nothing left before it
  1A7D'   21 0001               	LXI	H,1		; onto the new last line
  1A80'   CD 0000*              	CALL	SETBWD
  1A83'   2A 0000*              	LHLD	LNDLT
  1A86'   2B                    	DCX	H
  1A87'   22 0000*              	SHLD	LNDLT
  1A8A'                         VDD_UP:
  1A8A'   CD 087A'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1A8D'   3A 2D4B'              	LDA	DDSNG
  1A90'   B7                    	ORA	A
  1A91'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1A92'   3E 03                 	MVI	A,R_DLIN
  1A94'   32 2D19'              	STA	RINTENT
  1A97'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1A98'                         QEMPTY:
  1A98'   2A 0000*              	LHLD	QBEG
  1A9B'   EB                    	XCHG
  1A9C'   2A 0000*              	LHLD	QEND
  1A9F'   7C                    	MOV	A,H
  1AA0'   BA                    	CMP	D
  1AA1'   C0                    	RNZ
  1AA2'   7D                    	MOV	A,L
  1AA3'   BB                    	CMP	E
  1AA4'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1AA5'                         VC_Y:
  1AA5'   3E 79                 	MVI	A,'y'
  1AA7'   32 2D49'              	STA	PENDOP
  1AAA'   C3 07A0'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1AAD'                         VY_YY:
  1AAD'   21 2D52'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1AB0'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1AB3'   CD 0000*              	CALL	CUROFF
  1AB6'   22 2D93'              	SHLD	YOFF		; the cursor, which a yank leaves alone
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1AB9'   CD 0624'              	CALL	BOL
  1ABC'   22 2D95'              	SHLD	YPT		; where the lines come from, to put them back
  1ABF'   CD 1C14'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1AC2'   CD 1C57'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1AC5'   D2 1C1B'              	JNC	YNDONE
  1AC8'   21 1A23'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1ACB'   C3 1AF7'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1ACE'                         OPYANK:
  1ACE'   CD 1718'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1AD1'   2A 2D4E'              	LHLD	OPSTA
  1AD4'   EB                    	XCHG			; DE = start
  1AD5'   2A 2D50'              	LHLD	OPEND2		; HL = end
  1AD8'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1ADB'   D2 1ADF'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1ADE'   EB                    	XCHG			; ... otherwise the start is
  1ADF'                         OPY_LO:
  1ADF'   22 2D93'              	SHLD	YOFF
  1AE2'   2A 2D5E'              	LHLD	OPLO
  1AE5'   22 2D95'              	SHLD	YPT		; where the lines come from, to put them back
  1AE8'   CD 1C14'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1AEB'   CD 1CCF'              	CALL	YNSPAN		; copied where they lie, if there is room
  1AEE'   D2 1C1B'              	JNC	YNDONE
  1AF1'   21 1BD5'              	LXI	H,YSPAN
  1AF4'   C3 1AF7'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1AF7'                         YKGO:
  1AF7'   22 2DBD'              	SHLD	YACT
  1AFA'   2A 2D95'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1AFD'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1AFE'   2A 2D93'              	LHLD	YOFF		;   survive this -- the put-back below can page
  1B01'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1B04'   22 2DC3'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1B07'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1B0A'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1B0B'   2A 2D95'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1B0E'   EB                    	XCHG			;   window as it was, then names other text
  1B0F'   E1                    	POP	H
  1B10'   CD 0000*              	CALL	SUBHD
  1B13'   EB                    	XCHG			; DE = how far behind the cursor they start
  1B14'   CD 1210'              	CALL	CURFP
  1B17'   06 00                 	MVI	B,0
  1B19'   CD 1206'              	CALL	SUB24
  1B1C'   22 2DC5'              	SHLD	YPFP
  1B1F'   32 2DC7'              	STA	YPFP+2
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1B22'   3A 2D18'              	LDA	MODF
  1B25'   32 2D90'              	STA	YMODF
  1B28'   3A 2D3C'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1B2B'   32 2D91'              	STA	YDCHG		;   a yank must not become the last change
  1B2E'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1B31'   32 2D92'              	STA	YURPL		;   back are not a change to undo either
  1B34'   3E 01                 	MVI	A,1
  1B36'   32 0000*              	STA	UNDRPL
  1B39'   32 2DBC'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1B3C'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1B3F'   22 2D9F'              	SHLD	YLDLT
  1B42'   CD 0000*              	CALL	LOGLEN
  1B45'   22 2DC1'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1B48'   2A 2DBD'              	LHLD	YACT
  1B4B'   CD 1BAD'              	CALL	YCALL		; the lines out of the file, into the register
  1B4E'   3A 2D8B'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1B51'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1B53'   CA 1B91'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1B56'   CD 0000*              	CALL	LOGLEN
  1B59'   EB                    	XCHG
  1B5A'   2A 2DC1'              	LHLD	YWAS
  1B5D'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1B60'   CA 1B72'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1B63'   21 2DC5'              	LXI	H,YPFP		; back to where they came from, by its place in
  1B66'   CD 03DC'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1B69'   CD 03A9'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1B6C'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1B6F'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1B72'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1B72'   2A 2DC5'              	LHLD	YPFP		;   cursor is still owed its place)
  1B75'   EB                    	XCHG
  1B76'   2A 2DC3'              	LHLD	YCOL
  1B79'   19                    	DAD	D
  1B7A'   22 2DB8'              	SHLD	MKPOS
  1B7D'   3A 2DC7'              	LDA	YPFP+2
  1B80'   CE 00                 	ACI	0
  1B82'   32 2DBA'              	STA	MKPOS+2
  1B85'   CD 03A9'              	CALL	MKPAGE
  1B88'   CD 0000*              	CALL	GOTO
  1B8B'                         YK_RST:
  1B8B'   2A 2D9F'              	LHLD	YLDLT
  1B8E'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1B91'                         YK_RF:
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1B91'   3A 2D90'              	LDA	YMODF
  1B94'   32 2D18'              	STA	MODF
  1B97'   3A 2D91'              	LDA	YDCHG
  1B9A'   32 2D3C'              	STA	DOTCHG
  1B9D'   3A 2D92'              	LDA	YURPL
  1BA0'   32 0000*              	STA	UNDRPL
  1BA3'   AF                    	XRA	A
  1BA4'   32 2DBC'              	STA	MKHOLD
  1BA7'   CD 092C'              	CALL	GLSTAL
  1BAA'   C3 07C1'              	JMP	SETFUL		; the cheap paint cannot carry this
  1BAD'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1BAE'                         QREFUS:
  1BAE'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1BB1'   CD 1A98'              	CALL	QEMPTY
  1BB4'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1BB7'   CD 0000*              	CALL	QKILL
  1BBA'   3A 2DBC'              	LDA	MKHOLD
  1BBD'   B7                    	ORA	A
  1BBE'   C2 1BCD'              	JNZ	QRF_Y
  1BC1'   21 0000*              	LXI	H,MKSAV
  1BC4'   11 0000*              	LXI	D,MKTAB
  1BC7'   CD 23F4'              	CALL	COPY12
  1BCA'   CD 0000*              	CALL	UNDCLR
  1BCD'                         QRF_Y:
  1BCD'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1BCF'   32 2D8B'              	STA	MSGWHT
  1BD2'   C3 1527'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1BD5'                         YSPAN:
  1BD5'   CD 092C'              	CALL	GLSTAL
  1BD8'   CD 16DB'              	CALL	OPSPNL		; HL = the span's length
  1BDB'   22 2DBF'              	SHLD	YTGT
  1BDE'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  1BE1'   EB                    	XCHG			; DE = it
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1BE2'   2A 2DBF'              	LHLD	YTGT
  1BE5'   EB                    	XCHG			; HL = the text's, DE = the span's
  1BE6'   CD 0000*              	CALL	SUBHD
  1BE9'   22 2DBF'              	SHLD	YTGT		; what the text is left at when the span is out
  1BEC'   2A 2D5E'              	LHLD	OPLO
  1BEF'   CD 0000*              	CALL	GOTO
  1BF2'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1BF5'                         YS_LP:
  1BF5'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1BF8'   CD 0000*              	CALL	SETC0
  1BFB'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1BFE'   DA 1BAE'              	JC	QREFUS		; ... which has no room for it
  1C01'   CD 0000*              	CALL	LOGLEN
  1C04'   EB                    	XCHG			; DE = what is left
  1C05'   2A 2DBF'              	LHLD	YTGT
  1C08'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1C0B'   DA 1C11'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1C0E'   C2 1BF5'              	JNZ	YS_LP		;   but never spin here if it ever did
  1C11'                         YS_END:
  1C11'   C3 0174'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1C14'                         YNPRE:
  1C14'   2A 0000*              	LHLD	PGTOPM
  1C17'   22 2DC8'              	SHLD	YNPG
  1C1A'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1C1B'                         YNDONE:
  1C1B'   2A 2D93'              	LHLD	YOFF
  1C1E'   CD 0000*              	CALL	GOTO
  1C21'   2A 0000*              	LHLD	PGTOPM
  1C24'   EB                    	XCHG
  1C25'   2A 2DC8'              	LHLD	YNPG
  1C28'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1C2B'   C2 07C1'              	JNZ	SETFUL		; it moved under us: repaint after all
  1C2E'   C3 07A0'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1C31'                         YNROOM:
  1C31'   11 0100               	LXI	D,100H
  1C34'   19                    	DAD	D
  1C35'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1C36'   E5                    	PUSH	H		; the span plus its slack
  1C37'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1C3A'   EB                    	XCHG			; HL = free
  1C3B'   D1                    	POP	D		; DE = the span plus its slack
  1C3C'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1C3F'   DA 1C47'              	JC	YNR_OK
  1C42'   CA 1C47'              	JZ	YNR_OK
  1C45'   37                    	STC			; not enough: the delete-and-put-back path
  1C46'   C9                    	RET
  1C47'                         YNR_OK:
  1C47'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1C48'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1C49'                         YNGO:
  1C49'   C5                    	PUSH	B
  1C4A'   CD 06CB'              	CALL	GETCNT		; spent here: this yank is happening
  1C4D'   CD 092C'              	CALL	GLSTAL
  1C50'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1C53'   C1                    	POP	B
  1C54'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


                                ; left with nothing to decide but where the count clamps.
  1C57'                         YNCOPY:
  1C57'   2A 2D15'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1C5A'   7C                    	MOV	A,H		;   the count itself
  1C5B'   B5                    	ORA	L
  1C5C'   C2 1C62'              	JNZ	YNC_HV
  1C5F'   21 0001               	LXI	H,1
  1C62'                         YNC_HV:
  1C62'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1C63'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1C64'   B4                    	ORA	H
  1C65'   CA 1C70'              	JZ	YNC_M
  1C68'   E5                    	PUSH	H
  1C69'   CD 08E5'              	CALL	ONLAST		; vim: a count over one on the last line does
  1C6C'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1C6D'   DA 1C82'              	JC	YNC_RF
  1C70'                         YNC_M:
  1C70'   E5                    	PUSH	H
  1C71'   CD 0863'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1C74'   E1                    	POP	H
  1C75'   CD 1C8A'              	CALL	YNLINE		; BC = the span, measured where it stands
  1C78'   D8                    	RC			; not measurable here: let the pager answer it
  1C79'   60                    	MOV	H,B
  1C7A'   69                    	MOV	L,C
  1C7B'   CD 1C31'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1C7E'   D8                    	RC			; no: the delete-and-put-back path
  1C7F'   C3 1C49'              	JMP	YNGO
  1C82'                         YNC_RF:
  1C82'   CD 06CB'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1C85'   CD 092C'              	CALL	GLSTAL		;   register alone, and that is the command
  1C88'   B7                    	ORA	A		; NC: done
  1C89'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1C8A'                         YNLINE:
  1C8A'   22 2DCA'              	SHLD	YNCNT		; the lines it still wants
  1C8D'   2A 0000*              	LHLD	GAPEND
  1C90'                         YNL_LP:
  1C90'   EB                    	XCHG			; DE = the scan
  1C91'   2A 0000*              	LHLD	TXTEND
  1C94'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1C97'   EB                    	XCHG			; HL = the scan
  1C98'   D2 1CB8'              	JNC	YNL_EN		; the resident text ran out
  1C9B'   7E                    	MOV	A,M
  1C9C'   23                    	INX	H
  1C9D'   FE 0A                 	CPI	LF
  1C9F'   C2 1C90'              	JNZ	YNL_LP
  1CA2'   E5                    	PUSH	H
  1CA3'   2A 2DCA'              	LHLD	YNCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1CA6'   2B                    	DCX	H
  1CA7'   22 2DCA'              	SHLD	YNCNT
  1CAA'   7C                    	MOV	A,H
  1CAB'   B5                    	ORA	L
  1CAC'   E1                    	POP	H
  1CAD'   C2 1C90'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1CB0'   EB                    	XCHG			; DE = past the last of them
  1CB1'   2A 0000*              	LHLD	GAPEND
  1CB4'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1CB5'   C3 1CC6'              	JMP	YNL_BC
  1CB8'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1CB8'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1CBB'   C2 1CCD'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1CBE'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1CC1'   EB                    	XCHG			;   count clamps to it as vim's does
  1CC2'   2A 0000*              	LHLD	GAPEND
  1CC5'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1CC6'                         YNL_BC:
  1CC6'   CD 0000*              	CALL	SUBHD		; HL = the span
  1CC9'   44                    	MOV	B,H
  1CCA'   4D                    	MOV	C,L
  1CCB'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1CCC'   C9                    	RET
  1CCD'                         YNL_NO:
  1CCD'   37                    	STC
  1CCE'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1CCF'                         YNSPAN:
  1CCF'   CD 16DB'              	CALL	OPSPNL		; HL = the span's length
  1CD2'   44                    	MOV	B,H
  1CD3'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1CD4'   CD 1C31'              	CALL	YNROOM
  1CD7'   D8                    	RC			; no room: the delete-and-put-back path
  1CD8'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1CD9'   2A 2D5E'              	LHLD	OPLO
  1CDC'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1CDF'   C1                    	POP	B
  1CE0'   C3 1C49'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1CE3'                         VC_P:
  1CE3'   CD 1A98'              	CALL	QEMPTY
  1CE6'   CA 1DB9'              	JZ	VP_BEL
  1CE9'   CD 06CB'              	CALL	GETCNT
  1CEC'   22 2D97'              	SHLD	PCNT
  1CEF'   CD 0000*              	CALL	CUROFF
  1CF2'   CD 0654'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1CF5'   C3 1D0A'              	JMP	VP_GO
  1CF8'                         VCB_P:
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1CF8'   CD 1A98'              	CALL	QEMPTY
  1CFB'   CA 1DB9'              	JZ	VP_BEL
  1CFE'   CD 06CB'              	CALL	GETCNT
  1D01'   22 2D97'              	SHLD	PCNT
  1D04'   CD 0000*              	CALL	CUROFF
  1D07'   CD 0624'              	CALL	BOL
  1D0A'                         VP_GO:
  1D0A'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1D0D'   CD 0000*              	CALL	CUROFF
  1D10'   EB                    	XCHG
  1D11'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1D14'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1D17'   DA 1D2C'              	JC	VP_IN
  1D1A'   EB                    	XCHG			; HL = the put point = LOGLEN
  1D1B'   7C                    	MOV	A,H
  1D1C'   B5                    	ORA	L
  1D1D'   CA 1D29'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1D20'   2B                    	DCX	H
  1D21'   CD 0000*              	CALL	CHARAT
  1D24'   FE 0A                 	CPI	LF
  1D26'   CA 1D2C'              	JZ	VP_IN
  1D29'                         VP_BRK:
  1D29'   CD 189A'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1D2C'                         VP_IN:
  1D2C'   21 2D99'              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1D2F'   CD 0429'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1D32'   CD 1259'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1D35'   2A 0000*              	LHLD	QBEG
  1D38'   EB                    	XCHG
  1D39'   2A 0000*              	LHLD	QEND
  1D3C'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1D3F'   EB                    	XCHG
  1D40'   22 2D9C'              	SHLD	PLFS
  1D43'   2A 2D97'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1D46'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1D47'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1D48'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1D4A'   C2 1D4E'              	JNZ	VP_PZ
  1D4D'   7D                    	MOV	A,L
  1D4E'                         VP_PZ:
  1D4E'   32 2D9E'              	STA	PCPY
  1D51'                         VP_LP:
  1D51'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1D54'   2A 0000*              	LHLD	LNDLT
  1D57'   EB                    	XCHG
  1D58'   2A 2D9C'              	LHLD	PLFS
  1D5B'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1D5C'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1D5F'   2A 2D97'              	LHLD	PCNT
  1D62'   2B                    	DCX	H
  1D63'   22 2D97'              	SHLD	PCNT
  1D66'   7C                    	MOV	A,H
  1D67'   B5                    	ORA	L
  1D68'   C2 1D51'              	JNZ	VP_LP
  1D6B'   CD 0174'              	CALL	MARKMOD
  1D6E'   21 2D99'              	LXI	H,PPFP
  1D71'   CD 03DC'              	CALL	MKLOAD
  1D74'   CD 03E9'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1D77'   D2 1DAA'              	JNC	VP_PGD
  1D7A'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1D7D'   CD 092C'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1D80'   3A 2D9E'              	LDA	PCPY
  1D83'   B7                    	ORA	A
  1D84'   CA 087A'              	JZ	FNBLNK
  1D87'   2A 2D9C'              	LHLD	PLFS
  1D8A'   7C                    	MOV	A,H
  1D8B'   B7                    	ORA	A
  1D8C'   C2 087A'              	JNZ	FNBLNK
  1D8F'   3A 2D9E'              	LDA	PCPY
  1D92'   CD 0F0B'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1D95'   7C                    	MOV	A,H
  1D96'   B7                    	ORA	A
  1D97'   C2 087A'              	JNZ	FNBLNK
  1D9A'   7D                    	MOV	A,L
  1D9B'   B7                    	ORA	A
  1D9C'   CA 087A'              	JZ	FNBLNK
  1D9F'   F5                    	PUSH	PSW
  1DA0'   CD 07AC'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1DA3'   F1                    	POP	PSW
  1DA4'   32 2D1A'              	STA	ILN		; ... which the lines put now replace
  1DA7'   C3 087A'              	JMP	FNBLNK
  1DAA'                         VP_PGD:				; the put paged its first line out: page back
  1DAA'   CD 03A9'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1DAD'   CD 0000*              	CALL	GOTO
  1DB0'   CD 092C'              	CALL	GLSTAL
  1DB3'   CD 1271'              	CALL	GPLACE
  1DB6'   C3 07C1'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  1DB9'                         VP_BEL:
  1DB9'   CD 06CB'              	CALL	GETCNT		; the count is spent either way
  1DBC'   0E 07                 	MVI	C,BEL
  1DBE'   CD 0000*              	CALL	BCONOU
  1DC1'   C3 07A0'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  1DC4'                         VIREP:
  1DC4'   79                    	MOV	A,C
  1DC5'   FE 1B                 	CPI	ESC
  1DC7'   CA 1EEC'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  1DCA'   FE 0D                 	CPI	CR
  1DCC'   CA 1E30'              	JZ	VP_CR
  1DCF'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1DD1'   CA 1E30'              	JZ	VP_CR
  1DD4'   FE 08                 	CPI	BS
  1DD6'   CA 1E3C'              	JZ	VP_BS
  1DD9'   FE 7F                 	CPI	DEL
  1DDB'   CA 1E3C'              	JZ	VP_BS
  1DDE'   32 2D6F'              	STA	VRCH		; the calls below do not preserve C
  1DE1'   CD 07A6'              	CALL	SETLIN		; this row changed
  1DE4'   CD 0174'              	CALL	MARKMOD
  1DE7'   CD 188D'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1DEA'   CA 1E22'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1DED'   3A 2D6F'              	LDA	VRCH
  1DF0'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1DF3'   2A 2D70'              	LHLD	RPDEL
  1DF6'   7C                    	MOV	A,H
  1DF7'   B5                    	ORA	L
  1DF8'   CA 1E0E'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1DFB'   2A 0000*              	LHLD	GAPEND
  1DFE'   EB                    	XCHG
  1DFF'   2A 2D74'              	LHLD	RPGE
  1E02'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1E05'   CA 1E0E'              	JZ	VP_OVW
  1E08'   21 0000               	LXI	H,0
  1E0B'   22 2D70'              	SHLD	RPDEL		; the text moved: those originals are gone
  1E0E'                         VP_OVW:
  1E0E'   21 0001               	LXI	H,1
  1E11'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1E14'   2A 0000*              	LHLD	GAPEND
  1E17'   22 2D74'              	SHLD	RPGE
  1E1A'   2A 2D70'              	LHLD	RPDEL
  1E1D'   23                    	INX	H
  1E1E'   22 2D70'              	SHLD	RPDEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1E21'   C9                    	RET
  1E22'                         VP_APP:
  1E22'   3A 2D6F'              	LDA	VRCH
  1E25'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1E28'   2A 2D72'              	LHLD	RPAPP
  1E2B'   23                    	INX	H
  1E2C'   22 2D72'              	SHLD	RPAPP
  1E2F'   C9                    	RET
  1E30'                         VP_CR:
  1E30'   21 0000               	LXI	H,0
  1E33'   22 2D70'              	SHLD	RPDEL		; a line break ends what BS can put back
  1E36'   22 2D72'              	SHLD	RPAPP
  1E39'   C3 1EC2'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1E3C'                         VP_BS:
  1E3C'   2A 2D72'              	LHLD	RPAPP
  1E3F'   7C                    	MOV	A,H
  1E40'   B5                    	ORA	L
  1E41'   CA 1E4E'              	JZ	VP_BSD
  1E44'   2B                    	DCX	H
  1E45'   22 2D72'              	SHLD	RPAPP		; an appended char: it just goes
  1E48'   CD 07A6'              	CALL	SETLIN
  1E4B'   C3 0000*              	JMP	DELPRV
  1E4E'                         VP_BSD:
  1E4E'   2A 2D70'              	LHLD	RPDEL
  1E51'   7C                    	MOV	A,H
  1E52'   B5                    	ORA	L
  1E53'   CA 1E7A'              	JZ	VP_BSM		; nothing of ours left
  1E56'   2A 0000*              	LHLD	GAPEND
  1E59'   EB                    	XCHG
  1E5A'   2A 2D74'              	LHLD	RPGE
  1E5D'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1E60'   C2 1E7A'              	JNZ	VP_BSM
  1E63'   2A 2D70'              	LHLD	RPDEL
  1E66'   2B                    	DCX	H
  1E67'   22 2D70'              	SHLD	RPDEL
  1E6A'   CD 07A6'              	CALL	SETLIN
  1E6D'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1E70'   CD 0000*              	CALL	UNDELF		; the original comes back
  1E73'   2A 0000*              	LHLD	GAPEND
  1E76'   22 2D74'              	SHLD	RPGE
  1E79'   C9                    	RET
  1E7A'                         VP_BSM:
  1E7A'   CD 07A0'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1E7D'   C3 080F'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  1E80'                         VIINS:
  1E80'   79                    	MOV	A,C
  1E81'   FE 1B                 	CPI	ESC
  1E83'   CA 1EEC'              	JZ	VI_ESC
  1E86'   FE 0D                 	CPI	CR
  1E88'   CA 1EC2'              	JZ	VI_CR
  1E8B'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1E8D'   CA 1EC2'              	JZ	VI_CR
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1E90'   FE 08                 	CPI	BS
  1E92'   CA 1EDA'              	JZ	VI_BS
  1E95'   FE 7F                 	CPI	DEL
  1E97'   CA 1EDA'              	JZ	VI_BS
  1E9A'   79                    	MOV	A,C
  1E9B'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1E9E'   CD 0174'              	CALL	MARKMOD
  1EA1'   CD 07A6'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1EA4'   79                    	MOV	A,C
  1EA5'   FE 20                 	CPI	' '
  1EA7'   D8                    	RC			; control char -> keep R_LINE
  1EA8'   FE 7F                 	CPI	DEL
  1EAA'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1EAB'   CD 07C7'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1EAE'   B7                    	ORA	A
  1EAF'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1EB0'   3E 04                 	MVI	A,R_ICH
  1EB2'   32 2D19'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1EB5'   CD 188D'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1EB8'   3E 00                 	MVI	A,0
  1EBA'   C2 1EBE'              	JNZ	VI_ICH
  1EBD'   3C                    	INR	A
  1EBE'                         VI_ICH:
  1EBE'   32 2D1B'              	STA	ICHAPP
  1EC1'   C9                    	RET
  1EC2'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1EC2'   CD 188D'              	CALL	ATCEND
  1EC5'   3E 00                 	MVI	A,0
  1EC7'   CA 1ECB'              	JZ	VI_CRS
  1ECA'   3C                    	INR	A
  1ECB'                         VI_CRS:
  1ECB'   F5                    	PUSH	PSW
  1ECC'   CD 189A'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1ECF'   CD 18A7'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1ED2'   CD 07AC'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1ED5'   F1                    	POP	PSW
  1ED6'   32 2D1C'              	STA	ILABOV
  1ED9'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1EDA'                         VI_BS:
  1EDA'   CD 0000*              	CALL	PEEKL
  1EDD'   D8                    	RC			; start of the file: nothing to delete
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1EDE'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1EE0'   CA 1EE6'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1EE3'   CD 07A6'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1EE6'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1EE6'   CD 0174'              	CALL	MARKMOD
  1EE9'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1EEC'                         VI_ESC:
  1EEC'   3E 00                 	MVI	A,EM_CMD
  1EEE'   32 2D14'              	STA	EDMODE
  1EF1'   CD 07A0'              	CALL	SETMOV
  1EF4'   CD 080F'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1EF7'   C3 092C'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1EFA'                         RDLINE:
  1EFA'   EB                    	XCHG			; HL = buffer
  1EFB'   22 2D76'              	SHLD	RLPTR
  1EFE'   3E 00                 	MVI	A,0
  1F00'   32 2D78'              	STA	RLLEN
  1F03'   78                    	MOV	A,B
  1F04'   32 2D79'              	STA	RLMAX
  1F07'   79                    	MOV	A,C
  1F08'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1F0B'                         RL_LP:
  1F0B'   CD 0000*              	CALL	GETKEY
  1F0E'   FE 1B                 	CPI	ESC
  1F10'   CA 1F60'              	JZ	RL_CAN
  1F13'   FE 0D                 	CPI	CR
  1F15'   CA 1F6B'              	JZ	RL_DONE
  1F18'   FE 08                 	CPI	BS
  1F1A'   CA 1F48'              	JZ	RL_BS
  1F1D'   FE 7F                 	CPI	DEL
  1F1F'   CA 1F48'              	JZ	RL_BS
  1F22'   FE 20                 	CPI	' '
  1F24'   DA 1F0B'              	JC	RL_LP		; control char -> ignore
  1F27'   3A 2D78'              	LDA	RLLEN
  1F2A'   47                    	MOV	B,A
  1F2B'   3A 2D79'              	LDA	RLMAX
  1F2E'   B8                    	CMP	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1F2F'   CA 1F0B'              	JZ	RL_LP		; full -> ignore
  1F32'   2A 2D76'              	LHLD	RLPTR
  1F35'   71                    	MOV	M,C
  1F36'   23                    	INX	H
  1F37'   22 2D76'              	SHLD	RLPTR
  1F3A'   3A 2D78'              	LDA	RLLEN
  1F3D'   3C                    	INR	A
  1F3E'   32 2D78'              	STA	RLLEN
  1F41'   79                    	MOV	A,C
  1F42'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1F45'   C3 1F0B'              	JMP	RL_LP
  1F48'                         RL_BS:				; WM LINEPOP
  1F48'   3A 2D78'              	LDA	RLLEN
  1F4B'   B7                    	ORA	A
  1F4C'   CA 1F60'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1F4F'   3D                    	DCR	A
  1F50'   32 2D78'              	STA	RLLEN
  1F53'   2A 2D76'              	LHLD	RLPTR
  1F56'   2B                    	DCX	H
  1F57'   22 2D76'              	SHLD	RLPTR
  1F5A'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1F5D'   C3 1F0B'              	JMP	RL_LP
  1F60'                         RL_CAN:
  1F60'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1F62'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1F65'   CD 07A6'              	CALL	SETLIN		; redraw one row
  1F68'   3E FF                 	MVI	A,0FFH		; cancelled
  1F6A'   C9                    	RET
  1F6B'                         RL_DONE:
  1F6B'   AF                    	XRA	A
  1F6C'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  1F6D'                         VC_BZ:
  1F6D'   CD 07A0'              	CALL	SETMOV
  1F70'   3A 2D48'              	LDA	GSAVE
  1F73'   FE 02                 	CPI	PZ
  1F75'   CA 1F80'              	JZ	VZ_ZZ
  1F78'   B7                    	ORA	A
  1F79'   C0                    	RNZ			; 'g' was pending: vim drops both
  1F7A'   3E 02                 	MVI	A,PZ
  1F7C'   32 2D47'              	STA	GPEND
  1F7F'   C9                    	RET
  1F80'                         VZ_ZZ:
  1F80'   3E 04                 	MVI	A,EO_X
  1F82'   32 2D7A'              	STA	EXOP
  1F85'   3E 01                 	MVI	A,1
  1F87'   32 2D8D'              	STA	EXBANG		; no '!'
  1F8A'   AF                    	XRA	A
  1F8B'   32 2D7B'              	STA	EXARG		; no file name
  1F8E'   3A 2D18'              	LDA	MODF		; as ':x': a changed text is written first
  1F91'   B7                    	ORA	A
  1F92'   CA 20D3'              	JZ	EX_Q
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  1F95'   C3 206D'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1F98'                         VC_EX:
  1F98'   CD 06CB'              	CALL	GETCNT
  1F9B'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1F9E'   11 0000*              	LXI	D,EXBUF
  1FA1'   06 28                 	MVI	B,EXMAX
  1FA3'   0E 3A                 	MVI	C,':'
  1FA5'   CD 1EFA'              	CALL	RDLINE
  1FA8'   B7                    	ORA	A
  1FA9'   C0                    	RNZ			; cancelled
  1FAA'   3A 2D78'              	LDA	RLLEN
  1FAD'   5F                    	MOV	E,A
  1FAE'   16 00                 	MVI	D,0
  1FB0'   21 0000*              	LXI	H,EXBUF
  1FB3'   19                    	DAD	D
  1FB4'   36 00                 	MVI	M,0		; the line ends with a 0
  1FB6'   21 0000*              	LXI	H,EXBUF
  1FB9'   CD 2585'              	CALL	SKIPB
  1FBC'   C8                    	RZ			; nothing on it
  1FBD'   22 2D7D'              	SHLD	EXCMD
  1FC0'   CD 2789'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1FC3'   CD 2585'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1FC6'   56                    	MOV	D,M
  1FC7'   23                    	INX	H
  1FC8'   1E 00                 	MVI	E,0
  1FCA'   CD 2591'              	CALL	ISLOW
  1FCD'   DA 1FD8'              	JC	EX_LK
  1FD0'   5F                    	MOV	E,A
  1FD1'   23                    	INX	H
  1FD2'   CD 2591'              	CALL	ISLOW
  1FD5'   D2 1FF1'              	JNC	EX_NOT		; a third letter: none of ours
  1FD8'                         EX_LK:
  1FD8'   E5                    	PUSH	H
  1FD9'   21 2770'              	LXI	H,EXTAB
  1FDC'                         EX_TL:
  1FDC'   7E                    	MOV	A,M
  1FDD'   B7                    	ORA	A
  1FDE'   CA 1FF0'              	JZ	EX_NTP		; not in the table
  1FE1'   23                    	INX	H
  1FE2'   BA                    	CMP	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  1FE3'   7E                    	MOV	A,M
  1FE4'   23                    	INX	H
  1FE5'   C2 1FEC'              	JNZ	EX_TN
  1FE8'   BB                    	CMP	E
  1FE9'   CA 1FF7'              	JZ	EX_TF
  1FEC'                         EX_TN:
  1FEC'   23                    	INX	H
  1FED'   C3 1FDC'              	JMP	EX_TL
  1FF0'                         EX_NTP:
  1FF0'   E1                    	POP	H
  1FF1'                         EX_NOT:
  1FF1'   21 2649'              	LXI	H,SNOT
  1FF4'   C3 25C6'              	JMP	EXERT
  1FF7'                         EX_TF:
  1FF7'   7E                    	MOV	A,M
  1FF8'   32 2D7A'              	STA	EXOP
  1FFB'   E1                    	POP	H
  1FFC'   FE 06                 	CPI	EO_S
  1FFE'   CA 27F8'              	JZ	EX_S		; ':s' reads the rest of the line itself
  2001'   FE 01                 	CPI	EO_W
  2003'   CA 2012'              	JZ	EX_RG		; ':N,Mw name' takes a range
  2006'   FE 08                 	CPI	EO_R
  2008'   CA 2012'              	JZ	EX_RG		; ... and ':Nr name' a line
  200B'   3A 2DD6'              	LDA	SRNGF
  200E'   B7                    	ORA	A
  200F'   C2 1FF1'              	JNZ	EX_NOT		; a range on a command that does not take one
  2012'                         EX_RG:
                                	;--- '!', then the file name ---
  2012'   7E                    	MOV	A,M
  2013'   D6 21                 	SUI	'!'
  2015'   32 2D8D'              	STA	EXBANG		; 0 = '!'
  2018'   C2 201C'              	JNZ	EX_NB
  201B'   23                    	INX	H
  201C'                         EX_NB:
  201C'   CD 2585'              	CALL	SKIPB
  201F'   32 2D7B'              	STA	EXARG		; 0 = no file name
  2022'   CA 203B'              	JZ	EX_RUN
  2025'   22 2D7D'              	SHLD	EXCMD
  2028'   3A 2D7A'              	LDA	EXOP
  202B'   FE 02                 	CPI	EO_Q
  202D'   CA 25C3'              	JZ	EX_TRL		; :q takes none
  2030'   FE 07                 	CPI	EO_V
  2032'   CA 25C3'              	JZ	EX_TRL		; nor :ve
  2035'   CD 24EF'              	CALL	PARSFN
  2038'   C2 25B7'              	JNZ	EX_INV
  203B'                         EX_RUN:
  203B'   3A 2D7A'              	LDA	EXOP
  203E'   FE 05                 	CPI	EO_E
  2040'   CA 20EA'              	JZ	EX_E
  2043'   FE 02                 	CPI	EO_Q
  2045'   CA 20D3'              	JZ	EX_Q
  2048'   FE 07                 	CPI	EO_V
  204A'   CA 25BD'              	JZ	EX_V
  204D'   FE 08                 	CPI	EO_R
  204F'   CA 227B'              	JZ	EX_R
  2052'   FE 04                 	CPI	EO_X
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  2054'   CA 2066'              	JZ	EX_XM
  2057'   FE 01                 	CPI	EO_W
  2059'   C2 206D'              	JNZ	EX_W		; :wq
  205C'   3A 2DD6'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  205F'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  2060'   C2 219B'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  2063'   C3 206D'              	JMP	EX_W
  2066'                         EX_XM:
  2066'   3A 2D18'              	LDA	MODF		; :x writes only a changed text
  2069'   B7                    	ORA	A
  206A'   CA 20D3'              	JZ	EX_Q
  206D'                         EX_W:
  206D'   CD 235B'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  2070'   D8                    	RC			; refused (message shown)
  2071'   32 2D7C'              	STA	EXBAK
  2074'   3A 2D7A'              	LDA	EXOP
  2077'   FE 01                 	CPI	EO_W
  2079'   CA 2090'              	JZ	EX_WK
  207C'   3A 2D7C'              	LDA	EXBAK
  207F'   B7                    	ORA	A
  2080'   C2 20D0'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  2083'   3A 2D8D'              	LDA	EXBANG
  2086'   B7                    	ORA	A
  2087'   CA 20D0'              	JZ	EX_WQ		; so it does with '!'
  208A'   CD 2090'              	CALL	EX_WK		; else it may not: keep the text
  208D'   C3 20D3'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  2090'                         EX_WK:
  2090'   CD 0D47'              	CALL	CURRW		; the cursor's row and file position
  2093'   32 2D7F'              	STA	WPROW
  2096'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  2099'   7D                    	MOV	A,L
  209A'   E6 7F                 	ANI	7FH
  209C'   32 2D80'              	STA	WPBYT
  209F'   7D                    	MOV	A,L
  20A0'   17                    	RAL
  20A1'   7C                    	MOV	A,H
  20A2'   17                    	RAL
  20A3'   5F                    	MOV	E,A
  20A4'   3E 00                 	MVI	A,0
  20A6'   17                    	RAL
  20A7'   57                    	MOV	D,A		; DE = HL / 128
  20A8'   2A 0000*              	LHLD	OUTPOS
  20AB'   19                    	DAD	D
  20AC'   22 2D81'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  20AF'   CD 2390'              	CALL	WRITE
  20B2'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  20B5'   2A 2D81'              	LHLD	WPREC
  20B8'   EB                    	XCHG
  20B9'   3A 2D80'              	LDA	WPBYT
  20BC'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  20BF'   CD 0000*              	CALL	GOTO
  20C2'                         EX_WRW:
  20C2'   21 0000               	LXI	H,0
  20C5'   22 0000*              	SHLD	LNDLT
  20C8'   3A 2D7F'              	LDA	WPROW
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  20CB'   6F                    	MOV	L,A
  20CC'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  20CF'   C9                    	RET
  20D0'                         EX_WQ:
  20D0'   CD 2390'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  20D3'                         EX_Q:
  20D3'   3A 2D8D'              	LDA	EXBANG
  20D6'   B7                    	ORA	A
  20D7'   CA 20E1'              	JZ	EX_QT
  20DA'   3A 2D18'              	LDA	MODF
  20DD'   B7                    	ORA	A
  20DE'   C2 25AB'              	JNZ	MSGNWR		; changed, no '!': stay
  20E1'                         EX_QT:
  20E1'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  20E4'   3E 01                 	MVI	A,1
  20E6'   32 2D17'              	STA	QUITF
  20E9'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  20EA'                         EX_E:
  20EA'   3A 2D8D'              	LDA	EXBANG
  20ED'   B7                    	ORA	A
  20EE'   CA 20F8'              	JZ	EE_GO
  20F1'   3A 2D18'              	LDA	MODF
  20F4'   B7                    	ORA	A
  20F5'   C2 25AB'              	JNZ	MSGNWR
  20F8'                         EE_GO:
  20F8'   3A 2D7B'              	LDA	EXARG
  20FB'   B7                    	ORA	A
  20FC'   C2 2103'              	JNZ	EE_ARG
  20FF'   CD 23CC'              	CALL	OWNTF		; no name: the buffer's own
  2102'   D8                    	RC
  2103'                         EE_ARG:
  2103'   CD 23E2'              	CALL	ISOWN
  2106'   21 0001               	LXI	H,1
  2109'   C2 2110'              	JNZ	EE_LD		; another file: its first line
  210C'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  210F'   23                    	INX	H		; HL = the cursor's line
  2110'                         EE_LD:
  2110'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  2112'   32 2D8B'              	STA	MSGWHT
  2115'   E5                    	PUSH	H
  2116'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  2119'   21 0000*              	LXI	H,TFCB
  211C'   11 0000*              	LXI	D,FNAME
  211F'   CD 23F4'              	CALL	COPY12		; the buffer's name
  2122'   CD 23B9'              	CALL	SRCTF
  2125'   CD 0000*              	CALL	REOPEN
  2128'   CD 01EC'              	CALL	MKCLR		; the marks named the buffer that just went
  212B'   AF                    	XRA	A
  212C'   32 2D18'              	STA	MODF
  212F'   E1                    	POP	H
  2130'   2B                    	DCX	H
  2131'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  2132'   CD 0000*              	CALL	MVLIND		; down to the line
  2135'   CD 0A63'              	CALL	ATEOF
  2138'   DC 0A69'              	CC	LASTLN		; past the last line: onto it
  213B'   CD 1233'              	CALL	ZSAVE
  213E'   C3 1308'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  2141'                         TFDOS:
  2141'   C5                    	PUSH	B
  2142'   11 0080               	LXI	D,CMDTAIL
  2145'   0E 1A                 	MVI	C,1AH		; set the DMA
  2147'   CD 0005               	CALL	BDOS
  214A'   C1                    	POP	B
  214B'   11 0000*              	LXI	D,TFCB
  214E'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  2151'                         EXRNG:
  2151'   2A 2DD7'              	LHLD	SRNG1
  2154'   7C                    	MOV	A,H
  2155'   B5                    	ORA	L
  2156'   37                    	STC
  2157'   C8                    	RZ
  2158'   2A 2DD9'              	LHLD	SRNG2
  215B'   EB                    	XCHG
  215C'   2A 2DD7'              	LHLD	SRNG1
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  215F'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  2162'   D8                    	RC
  2163'   EB                    	XCHG			; HL = the last line, DE = the first
  2164'   CD 0000*              	CALL	SUBHD
  2167'   23                    	INX	H
  2168'   22 2DE1'              	SHLD	SLINES
  216B'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  216C'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  216D'                         GOLNX:
  216D'   E5                    	PUSH	H
  216E'   CD 11C7'              	CALL	GOLN
  2171'   CD 0000*              	CALL	CNTLF
  2174'   23                    	INX	H		; the line the cursor came to rest on
  2175'   D1                    	POP	D
  2176'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  2179'                         EXSAVP:
  2179'   CD 0D47'              	CALL	CURRW
  217C'   32 2D7F'              	STA	WPROW
  217F'   21 2DB8'              	LXI	H,MKPOS
  2182'   C3 0429'              	JMP	FPSTO
  2185'                         EXRSTP:
  2185'   CD 0000*              	CALL	CLRCNT
  2188'   CD 03A9'              	CALL	MKPAGE		; page until that place is in the window again
  218B'   CD 0000*              	CALL	GOTO
  218E'   C3 20C2'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  2191'                         PUTBRK:
  2191'   3E 0D                 	MVI	A,CR
  2193'   CD 0000*              	CALL	PUTGAP
  2196'   3E 0A                 	MVI	A,LF
  2198'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  219B'                         EX_WR:
  219B'   3A 2D7B'              	LDA	EXARG
  219E'   B7                    	ORA	A
  219F'   CA 2599'              	JZ	MSGNFN		; No file name
  21A2'   CD 23E2'              	CALL	ISOWN
  21A5'   CA 2245'              	JZ	EXW_OW
  21A8'   CD 0000*              	CALL	TEXIST
  21AB'   32 2DE4'              	STA	RWERR		; nonzero: a file of that name is there
  21AE'   CA 21B8'              	JZ	EXW_GO
  21B1'   3A 2D8D'              	LDA	EXBANG
  21B4'   B7                    	ORA	A
  21B5'   C2 259F'              	JNZ	MSGEXI		; File exists (! to force)
  21B8'                         EXW_GO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  21B8'   CD 2151'              	CALL	EXRNG
  21BB'   DA 223F'              	JC	EXW_BD
  21BE'   CD 2179'              	CALL	EXSAVP
  21C1'   2A 2DD7'              	LHLD	SRNG1
  21C4'   CD 216D'              	CALL	GOLNX
  21C7'   C2 223C'              	JNZ	EXW_NL		; the text has no line N
  21CA'   3A 2DE4'              	LDA	RWERR		; a delete scans the whole directory, there or
  21CD'   B7                    	ORA	A		;   not: only when TEXIST found one
  21CE'   0E 13                 	MVI	C,13H
  21D0'   C4 2141'              	CNZ	TFDOS		; delete what is there
  21D3'   0E 16                 	MVI	C,16H
  21D5'   CD 2141'              	CALL	TFDOS		; ... and make it
  21D8'   3C                    	INR	A
  21D9'   CA 222E'              	JZ	EXW_FL		; no directory entry left
  21DC'   3E 80                 	MVI	A,80H
  21DE'   32 2DE3'              	STA	RWPTR
  21E1'   AF                    	XRA	A
  21E2'   32 2DE4'              	STA	RWERR
  21E5'   2A 2DE1'              	LHLD	SLINES
  21E8'   CD 0000*              	CALL	SETC0		; that many lines, forward
  21EB'                         EXW_LP:
  21EB'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  21EE'   E5                    	PUSH	H
  21EF'   EB                    	XCHG
  21F0'   2A 0000*              	LHLD	GAPEND
  21F3'   CD 224B'              	CALL	RWOUT		; the text from the cursor to there
  21F6'   E1                    	POP	H
  21F7'   3A 2DE4'              	LDA	RWERR
  21FA'   B7                    	ORA	A
  21FB'   C2 2217'              	JNZ	EXW_EN
  21FE'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  2201'   CD 06E0'              	CALL	CNTTST
  2204'   C2 21EB'              	JNZ	EXW_LP
  2207'                         EXW_PD:				; the last record is padded out with ^Z
  2207'   3A 2DE3'              	LDA	RWPTR
  220A'   FE 80                 	CPI	80H
  220C'   CA 2217'              	JZ	EXW_EN
  220F'   3E 1A                 	MVI	A,CPMEOF
  2211'   CD 2257'              	CALL	RWPUT
  2214'   C3 2207'              	JMP	EXW_PD
  2217'                         EXW_EN:
  2217'   0E 10                 	MVI	C,10H
  2219'   CD 2141'              	CALL	TFDOS		; close
  221C'   3A 2DE4'              	LDA	RWERR
  221F'   B7                    	ORA	A
  2220'   C2 222E'              	JNZ	EXW_FL
  2223'   CD 2185'              	CALL	EXRSTP
  2226'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  2228'   32 2D8B'              	STA	MSGWHT
  222B'   C3 07A0'              	JMP	SETMOV		; nothing on the screen has changed
  222E'                         EXW_FL:				; no room: the part written is not left behind
  222E'   0E 13                 	MVI	C,13H
  2230'   CD 2141'              	CALL	TFDOS
  2233'   CD 2185'              	CALL	EXRSTP
  2236'   21 2766'              	LXI	H,SDFUL
  2239'   C3 25D1'              	JMP	EXERR
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  223C'                         EXW_NL:
  223C'   CD 2185'              	CALL	EXRSTP
  223F'                         EXW_BD:
  223F'   21 2758'              	LXI	H,SRNGE
  2242'   C3 25D1'              	JMP	EXERR
  2245'                         EXW_OW:
  2245'   21 2600'              	LXI	H,SEXI
  2248'   C3 25D1'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  224B'                         RWOUT:
  224B'   CD 0000*              	CALL	CMP16
  224E'   C8                    	RZ
  224F'   7E                    	MOV	A,M
  2250'   23                    	INX	H
  2251'   CD 2257'              	CALL	RWPUT
  2254'   C3 224B'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  2257'                         RWPUT:
  2257'   E5                    	PUSH	H
  2258'   F5                    	PUSH	PSW
  2259'   3A 2DE3'              	LDA	RWPTR
  225C'   6F                    	MOV	L,A
  225D'   26 00                 	MVI	H,0
  225F'   F1                    	POP	PSW
  2260'   77                    	MOV	M,A
  2261'   2C                    	INR	L		; Z: that was the record's last byte
  2262'   7D                    	MOV	A,L
  2263'   C2 2276'              	JNZ	RWP_ST
  2266'   D5                    	PUSH	D
  2267'   0E 15                 	MVI	C,15H
  2269'   CD 2141'              	CALL	TFDOS		; write it
  226C'   D1                    	POP	D
  226D'   B7                    	ORA	A
  226E'   CA 2274'              	JZ	RWP_OK
  2271'   32 2DE4'              	STA	RWERR
  2274'                         RWP_OK:
  2274'   3E 80                 	MVI	A,80H
  2276'                         RWP_ST:
  2276'   32 2DE3'              	STA	RWPTR
  2279'   E1                    	POP	H
  227A'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  227B'                         EX_R:
  227B'   3A 2D7B'              	LDA	EXARG
  227E'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  227F'   CA 2599'              	JZ	MSGNFN		; No file name
  2282'   0E 0F                 	MVI	C,0FH
  2284'   CD 2141'              	CALL	TFDOS		; open
  2287'   3C                    	INR	A
  2288'   CA 2355'              	JZ	ER_NOF
  228B'   CD 1259'              	CALL	GZONE		; the screen's top line, before anything moves
  228E'   CD 2179'              	CALL	EXSAVP
  2291'   3A 2DD6'              	LDA	SRNGF
  2294'   B7                    	ORA	A
  2295'   CA 22AE'              	JZ	ER_NXT		; no line given: below the cursor's
  2298'   2A 2DD9'              	LHLD	SRNG2
  229B'   7C                    	MOV	A,H
  229C'   B5                    	ORA	L
  229D'   C2 22A8'              	JNZ	ER_LN
  22A0'   23                    	INX	H
  22A1'   CD 11C7'              	CALL	GOLN		; ':0r': above line 1 ...
  22A4'   AF                    	XRA	A		;   which never wants a line end put in first
  22A5'   C3 22D0'              	JMP	ER_BRK
  22A8'                         ER_LN:
  22A8'   CD 216D'              	CALL	GOLNX
  22AB'   C2 223C'              	JNZ	EXW_NL		; the text has no line N
  22AE'                         ER_NXT:
  22AE'   21 0001               	LXI	H,1
  22B1'   AF                    	XRA	A
  22B2'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  22B5'   CD 0A63'              	CALL	ATEOF
  22B8'   3E 00                 	MVI	A,0
  22BA'   D2 22D0'              	JNC	ER_BRK		; text follows
  22BD'   2A 0000*              	LHLD	GAPBEG
  22C0'   EB                    	XCHG
  22C1'   2A 0000*              	LHLD	TXTBEG
  22C4'   CD 0000*              	CALL	CMP16
  22C7'   3E 01                 	MVI	A,1
  22C9'   CA 22D0'              	JZ	ER_BRK		; nothing before the cursor either
  22CC'   1B                    	DCX	D
  22CD'   1A                    	LDAX	D
  22CE'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  22D0'                         ER_BRK:
  22D0'   32 2DE6'              	STA	RDBRK
  22D3'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  22D6'   AF                    	XRA	A
  22D7'   32 2DE5'              	STA	RDANY
  22DA'                         ER_LP:
  22DA'   0E 14                 	MVI	C,14H
  22DC'   CD 2141'              	CALL	TFDOS		; the next record
  22DF'   B7                    	ORA	A
  22E0'   C2 2313'              	JNZ	ER_END
  22E3'   21 0080               	LXI	H,CMDTAIL
  22E6'   0E 00                 	MVI	C,0
  22E8'                         ER_SC:				; C = its bytes, up to a ^Z
  22E8'   7E                    	MOV	A,M
  22E9'   FE 1A                 	CPI	CPMEOF
  22EB'   CA 22F3'              	JZ	ER_GOT
  22EE'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  22EF'   0C                    	INR	C
  22F0'   F2 22E8'              	JP	ER_SC		; (minus: all 128)
  22F3'                         ER_GOT:
  22F3'   79                    	MOV	A,C
  22F4'   B7                    	ORA	A
  22F5'   CA 2313'              	JZ	ER_END
  22F8'   C5                    	PUSH	B
  22F9'   3A 2DE5'              	LDA	RDANY
  22FC'   B7                    	ORA	A
  22FD'   CC 2344'              	CZ	ER_1ST
  2300'   C1                    	POP	B
  2301'   06 00                 	MVI	B,0
  2303'   11 0080               	LXI	D,CMDTAIL
  2306'   C5                    	PUSH	B
  2307'   CD 0000*              	CALL	INSBLK
  230A'   C1                    	POP	B
  230B'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  230E'   79                    	MOV	A,C
  230F'   17                    	RAL
  2310'   DA 22DA'              	JC	ER_LP		; a full record: there may be more
  2313'                         ER_END:
  2313'   3A 2DE5'              	LDA	RDANY
  2316'   B7                    	ORA	A
  2317'   CA 2335'              	JZ	ER_PL		; nothing in the file: nothing has changed
  231A'   CD 0A63'              	CALL	ATEOF
  231D'   DA 232A'              	JC	ER_MD		; the text now ends as the file read ends
  2320'   2A 0000*              	LHLD	GAPBEG
  2323'   2B                    	DCX	H
  2324'   7E                    	MOV	A,M
  2325'   FE 0A                 	CPI	LF
  2327'   C4 2191'              	CNZ	PUTBRK		; text follows: what was read ends a line
  232A'                         ER_MD:
  232A'   3E 01                 	MVI	A,1
  232C'   32 2D18'              	STA	MODF
  232F'   CD 03A9'              	CALL	MKPAGE		; back to the first line read
  2332'   CD 0000*              	CALL	GOTO
  2335'                         ER_PL:
  2335'   CD 0A63'              	CALL	ATEOF
  2338'   DC 0A69'              	CC	LASTLN		; (nothing read, at the end: the last line)
  233B'   CD 0000*              	CALL	CLRCNT
  233E'   CD 1271'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  2341'   C3 07C1'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  2344'                         ER_1ST:
  2344'   3C                    	INR	A
  2345'   32 2DE5'              	STA	RDANY
  2348'   3A 2DE6'              	LDA	RDBRK
  234B'   B7                    	ORA	A
  234C'   C4 2191'              	CNZ	PUTBRK
  234F'   21 2DB8'              	LXI	H,MKPOS
  2352'   C3 0429'              	JMP	FPSTO
  2355'                         ER_NOF:
  2355'   21 2747'              	LXI	H,SNOPN
  2358'   C3 25C6'              	JMP	EXERT
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  235B'                         WRCHK:
  235B'   3A 2D7B'              	LDA	EXARG
  235E'   B7                    	ORA	A
  235F'   C2 2369'              	JNZ	WC_ARG
  2362'   CD 23CC'              	CALL	OWNTF
  2365'   D8                    	RC
  2366'   C3 237E'              	JMP	WC_OWN
  2369'                         WC_ARG:
  2369'   CD 23E2'              	CALL	ISOWN
  236C'   CA 237E'              	JZ	WC_OWN
  236F'   3A 2D8D'              	LDA	EXBANG
  2372'   B7                    	ORA	A
  2373'   CA 237C'              	JZ	WC_OTH
  2376'   CD 0000*              	CALL	TEXIST
  2379'   C2 259F'              	JNZ	MSGEXI		; File exists (! to force)
  237C'                         WC_OTH:
  237C'   AF                    	XRA	A		; (NC)
  237D'   C9                    	RET
  237E'                         WC_OWN:
  237E'   3A 2D8E'              	LDA	ROFLAG		; '-R': this is the file it may not write
  2381'   B7                    	ORA	A
  2382'   CA 238C'              	JZ	WC_OK
  2385'   3A 2D8D'              	LDA	EXBANG
  2388'   B7                    	ORA	A
  2389'   C2 25A5'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  238C'                         WC_OK:
  238C'   3E 01                 	MVI	A,1
  238E'   B7                    	ORA	A		; (NC)
  238F'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  2390'                         WRITE:
  2390'   3A 2D7C'              	LDA	EXBAK
  2393'   CD 0000*              	CALL	WRTO
  2396'   3A 0001*              	LDA	FNAME+1
  2399'   FE 20                 	CPI	' '
  239B'   C2 23A7'              	JNZ	WR_HAS
  239E'   21 0000*              	LXI	H,TFCB
  23A1'   11 0000*              	LXI	D,FNAME
  23A4'   CD 23F4'              	CALL	COPY12
  23A7'                         WR_HAS:
  23A7'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  23A9'   32 2D8B'              	STA	MSGWHT
  23AC'   CD 23E2'              	CALL	ISOWN
  23AF'   C2 23B9'              	JNZ	SRCTF
  23B2'   AF                    	XRA	A
  23B3'   32 2D18'              	STA	MODF
  23B6'   32 2D8C'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  23B9'                         SRCTF:
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  23B9'   21 0000*              	LXI	H,TFCB
  23BC'   11 005C               	LXI	D,DFTFCB
  23BF'   CD 23F4'              	CALL	COPY12
  23C2'   AF                    	XRA	A
  23C3'   06 04                 	MVI	B,4
  23C5'                         SRC_Z:
  23C5'   12                    	STAX	D		; extent, s1, s2, record count: 0
  23C6'   13                    	INX	D
  23C7'   05                    	DCR	B
  23C8'   C2 23C5'              	JNZ	SRC_Z
  23CB'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  23CC'                         OWNTF:
  23CC'   3A 0001*              	LDA	FNAME+1
  23CF'   FE 20                 	CPI	' '
  23D1'   CA 2599'              	JZ	MSGNFN
  23D4'   CD 23FF'              	CALL	TFCLR
  23D7'   21 0000*              	LXI	H,FNAME
  23DA'   11 0000*              	LXI	D,TFCB
  23DD'   CD 23F4'              	CALL	COPY12
  23E0'   B7                    	ORA	A		; (NC)
  23E1'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  23E2'                         ISOWN:
  23E2'   21 0000*              	LXI	H,TFCB
  23E5'   11 0000*              	LXI	D,FNAME
  23E8'   06 0C                 	MVI	B,12
  23EA'                         IO_LP:
  23EA'   1A                    	LDAX	D
  23EB'   BE                    	CMP	M
  23EC'   C0                    	RNZ
  23ED'   23                    	INX	H
  23EE'   13                    	INX	D
  23EF'   05                    	DCR	B
  23F0'   C2 23EA'              	JNZ	IO_LP
  23F3'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  23F4'                         COPY12:
  23F4'   06 0C                 	MVI	B,12
  23F6'                         CP_LP:
  23F6'   7E                    	MOV	A,M
  23F7'   12                    	STAX	D
  23F8'   23                    	INX	H
  23F9'   13                    	INX	D
  23FA'   05                    	DCR	B
  23FB'   C2 23F6'              	JNZ	CP_LP
  23FE'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  23FF'                         TFCLR:
  23FF'   11 0000*              	LXI	D,TFCB
  2402'   06 24                 	MVI	B,36
  2404'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  2405'                         TC_LP:
  2405'   12                    	STAX	D
  2406'   13                    	INX	D
  2407'   05                    	DCR	B
  2408'   C2 2405'              	JNZ	TC_LP
  240B'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  240C'                         FOPEN:
  240C'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  240E'   32 2D8B'              	STA	MSGWHT
  2411'   21 005C               	LXI	H,DFTFCB
  2414'   CD 24E2'              	CALL	NRMDRV
  2417'   11 0000*              	LXI	D,FNAME
  241A'   CD 23F4'              	CALL	COPY12
  241D'   CD 0000*              	CALL	OPENZ
  2420'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  2423'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  2425'   C8                    	RZ
  2426'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  2429'   32 2D8C'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  242C'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  242D'                         ARGSCN:
  242D'   3A 0080               	LDA	CMDTAIL
  2430'   47                    	MOV	B,A		; B = what is left of the line
  2431'   B7                    	ORA	A
  2432'   C8                    	RZ
  2433'   21 0081               	LXI	H,CMDTAIL+1
  2436'                         AS_TOK:				; at a token, or the blanks before one
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  2436'   7E                    	MOV	A,M
  2437'   FE 20                 	CPI	' '
  2439'   C2 2442'              	JNZ	AS_OPT
  243C'   23                    	INX	H
  243D'   05                    	DCR	B
  243E'   C2 2436'              	JNZ	AS_TOK
  2441'   C9                    	RET
  2442'                         AS_OPT:
  2442'   FE 2B                 	CPI	'+'
  2444'   CA 246E'              	JZ	AS_PLS
  2447'   FE 2D                 	CPI	'-'
  2449'   CA 245D'              	JZ	AS_SW
  244C'   FE 2F                 	CPI	'/'
  244E'   CA 245D'              	JZ	AS_SW
  2451'                         AS_SKP:				; not ours (the file name): on to the next one
  2451'   23                    	INX	H
  2452'   05                    	DCR	B
  2453'   C8                    	RZ
  2454'   7E                    	MOV	A,M
  2455'   FE 20                 	CPI	' '
  2457'   C2 2451'              	JNZ	AS_SKP
  245A'   C3 2436'              	JMP	AS_TOK
  245D'                         AS_SW:
  245D'   23                    	INX	H
  245E'   05                    	DCR	B
  245F'   C8                    	RZ
  2460'   7E                    	MOV	A,M
  2461'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  2463'   FE 52                 	CPI	'R'
  2465'   C2 2451'              	JNZ	AS_SKP
  2468'   32 2D8E'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  246B'   C3 2451'              	JMP	AS_SKP
  246E'                         AS_PLS:
  246E'   3E 01                 	MVI	A,1
  2470'   32 2D8F'              	STA	PLUSF		; '+' gets the line even with no number on it
  2473'   11 0000*              	LXI	D,PLUSB
  2476'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  2478'   23                    	INX	H		;   line space, so it is taken as '+' alone
  2479'   05                    	DCR	B
  247A'   CA 24B1'              	JZ	AS_PE
  247D'   7E                    	MOV	A,M
  247E'   FE 30                 	CPI	'0'
  2480'   C2 2498'              	JNZ	AS_PD
  2483'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  2483'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  2484'   05                    	DCR	B
  2485'   CA 24B9'              	JZ	AS_P1
  2488'   7E                    	MOV	A,M
  2489'   FE 30                 	CPI	'0'
  248B'   CA 2483'              	JZ	AS_PZ
  248E'   FE 31                 	CPI	'1'
  2490'   DA 24B9'              	JC	AS_P1		; zeros and then no digit at all: line 1
  2493'   FE 3A                 	CPI	'9'+1
  2495'   D2 24B9'              	JNC	AS_P1
  2498'                         AS_PD:				; the digits, as typed
  2498'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  2499'   FE 30                 	CPI	'0'
  249B'   DA 24B1'              	JC	AS_PE
  249E'   FE 3A                 	CPI	'9'+1
  24A0'   D2 24B1'              	JNC	AS_PE
  24A3'   79                    	MOV	A,C
  24A4'   B7                    	ORA	A
  24A5'   CA 24C0'              	JZ	AS_POV
  24A8'   0D                    	DCR	C
  24A9'   7E                    	MOV	A,M
  24AA'   12                    	STAX	D
  24AB'   13                    	INX	D
  24AC'   23                    	INX	H
  24AD'   05                    	DCR	B
  24AE'   C2 2498'              	JNZ	AS_PD
  24B1'                         AS_PE:
  24B1'   AF                    	XRA	A
  24B2'   12                    	STAX	D		; the digits end with a 0
  24B3'   78                    	MOV	A,B
  24B4'   B7                    	ORA	A
  24B5'   C8                    	RZ
  24B6'   C3 2436'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  24B9'                         AS_P1:
  24B9'   3E 31                 	MVI	A,'1'
  24BB'   12                    	STAX	D
  24BC'   13                    	INX	D
  24BD'   C3 24B1'              	JMP	AS_PE
  24C0'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  24C0'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  24C3'   C3 24B1'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  24C6'                         ARGGO:
  24C6'   3A 2D8F'              	LDA	PLUSF
  24C9'   B7                    	ORA	A
