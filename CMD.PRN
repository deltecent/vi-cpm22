  0A09'   B1                    	ORA	C
  0A0A'   CA 0A21'              	JZ	KC_TB
  0A0D'   2B                    	DCX	H
  0A0E'   0B                    	DCX	B
  0A0F'   7E                    	MOV	A,M
  0A10'   FE 0A                 	CPI	LF
  0A12'   C2 0A08'              	JNZ	KC_SC
  0A15'   1B                    	DCX	D
  0A16'   7A                    	MOV	A,D
  0A17'   B3                    	ORA	E
  0A18'   C2 0A08'              	JNZ	KC_SC
  0A1B'   2A 2A7D'              	LHLD	JKCNT		; N lines above: the move is count lines
  0A1E'   C3 0A41'              	JMP	KC_MV
  0A21'                         KC_TB:
  0A21'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0A22'   CD 06C4'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0A25'   22 2A83'              	SHLD	JKBK
  0A28'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0A2B'   7C                    	MOV	A,H
  0A2C'   B5                    	ORA	L
  0A2D'   CA 0A3A'              	JZ	KC_B0
