  098B'                         KC_AD:
  098B'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  098E'   CD 0000*              	CALL	SUBHD
  0991'   22 0000*              	SHLD	LNDLT
  0994'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0995'                         ATEOF:
  0995'   CD 0000*              	CALL	RGET0
  0998'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  099B'                         LASTLN:
  099B'   2A 0000*              	LHLD	GAPBEG
  099E'   EB                    	XCHG
  099F'   2A 0000*              	LHLD	TXTBEG
  09A2'   CD 0000*              	CALL	CMP16
  09A5'   21 0000               	LXI	H,0
  09A8'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  09AB'   1B                    	DCX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  09AC'   1A                    	LDAX	D
  09AD'   FE 0A                 	CPI	LF
  09AF'   C2 0000*              	JNZ	SETBWD
  09B2'   23                    	INX	H
  09B3'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  09B6'                         JKLAND:
  09B6'   21 0000               	LXI	H,0
  09B9'   22 2916'              	SHLD	JKVC		; screen column
  09BC'   2B                    	DCX	H
  09BD'   22 2918'              	SHLD	JKLS		; last content char: none yet
  09C0'   CD 0000*              	CALL	RGET0
  09C3'   11 0000               	LXI	D,0		; DE = chars read
  09C6'                         JL_RD:
  09C6'   CD 0000*              	CALL	RDGET
  09C9'   DA 0A03'              	JC	JL_END
  09CC'   FE 0A                 	CPI	LF
  09CE'   CA 0A03'              	JZ	JL_END
  09D1'   E5                    	PUSH	H
  09D2'   C5                    	PUSH	B
  09D3'   2A 2916'              	LHLD	JKVC
  09D6'   CD 05C4'              	CALL	CWID
  09D9'   B7                    	ORA	A
  09DA'   CA 09FD'              	JZ	JL_NX		; a CR
  09DD'   EB                    	XCHG
  09DE'   22 2918'              	SHLD	JKLS		; the last content char so far
  09E1'   EB                    	XCHG
  09E2'   4F                    	MOV	C,A
  09E3'   06 00                 	MVI	B,0
  09E5'   09                    	DAD	B		; HL = the column after this char
  09E6'   22 2916'              	SHLD	JKVC
  09E9'   D5                    	PUSH	D
  09EA'   EB                    	XCHG
  09EB'   2A 2906'              	LHLD	GOALCOL
  09EE'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  09F1'   D1                    	POP	D
  09F2'   DA 09FD'              	JC	JL_NX
  09F5'   CA 09FD'              	JZ	JL_NX
  09F8'   C1                    	POP	B		; this char holds the goal column
  09F9'   E1                    	POP	H
  09FA'   C3 0A0E'              	JMP	JL_GO
  09FD'                         JL_NX:
  09FD'   C1                    	POP	B
  09FE'   E1                    	POP	H
  09FF'   13                    	INX	D
  0A00'   C3 09C6'              	JMP	JL_RD
