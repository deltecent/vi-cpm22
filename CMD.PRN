                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the cursor's line is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
                         C      ; PLACE -- what a command asks of the next layout (SCRN.MAC), cleared by it.
  0000                   C      PL_ASK	EQU	0		; the cursor only moved: is its line on the screen
                         C      				;   still, near it, or far off? (vim's rule)
  0001                   C      PL_SET	EQU	1		; the command set the lines above it (WINROW)
  0002                   C      PL_MID	EQU	2		; mid-screen, as the rows fall
                         C      
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; the cursor's line changed only -> redraw it from the cursor's row
  0003                   C      R_DLIN	EQU	3		; the cursor's line deleted -> DL its rows + redraw the bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted, no TAB after it -> ICH
  0005                   C      R_ILIN	EQU	5		; ILN lines opened at the cursor -> IL + their rows (ILABOV: the line above)
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw it + DL the rows saved
  0007                   C      R_DCH	EQU	7		; chars deleted at the cursor, none after it a TAB -> DCH
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	COL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	DCHN				; ... the cells an R_DCH deletes
                                	PUBLIC	DCHBS				; ... 1 = left of the cursor (BS)
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	LNALL				; ... 1 = an R_LINE from its first row
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	MKSHFT				; the marks follow an edit (VI.MAC hooks it)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	HTN, HTCUR, HTEOF, HTBOF	; the row table's facts (SCRN.MAC HTBLD)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	KBBRK, KBFLSH			; KEY.MAC -- an ESC waiting / drop type-ahead
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	MKSAV				; ... and a refused 'dd's copy of them
                                	EXTRN	MKUND				; ... and the copy 'u' puts back
                                	EXTRN	UNDST, UNDNEW			; BUF.MAC -- undone or not; no change yet
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
                                	EXTRN	UNDCLR				; ... nothing to undo
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	INSBLK, UNDINS			; BUF.MAC -- a block in at the cursor (':r')
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	UNDML, UNDL0			; ... and whether one line changed
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
                                	EXTRN	SCBOT, SCEOF, SCBOF, PLACE	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	SKIPR, TALLF		; a top line taller than the screen
                                	EXTRN	TXEND, CSUB, HTBLD		; ... its rows of text, the cursor's row
                                						;   in its line, and the row table
                                	EXTRN	HTAB				; RSV.MAC -- the row table itself
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	SETC0				; BUF.MAC -- WM count set, forward
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GOLINE				; BUF.MAC -- WM 2228 (a mark's page loop)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   AF                    	XRA	A		; no command is ever left open to an ESC by the
  0001'   32 2EDB'              	STA	BRKARM		;   one before it (BRKON)
  0004'   CD 00D7'              	CALL	DOTPRE
  0007'   CD 000D'              	CALL	CDMODE
  000A'   C3 011C'              	JMP	DOTPOST
  000D'                         CDMODE:
  000D'   3A 2E1B'              	LDA	EDMODE
  0010'   FE 01                 	CPI	EM_INS
  0012'   CA 001D'              	JZ	CD_INS
  0015'   FE 02                 	CPI	EM_REP
  0017'   CA 0020'              	JZ	CD_REP
  001A'   C3 0023'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  001D'                         CD_INS:
  001D'   C3 1F68'              	JMP	VIINS
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  0020'                         CD_REP:
  0020'   C3 1E9D'              	JMP	VIREP
                                
                                ;============================================================
                                ; VICMD -- command-mode key.  C = the key.
                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  0023'                         VICMD:
  0023'   79                    	MOV	A,C
  0024'   FE 1B                 	CPI	ESC
  0026'   CA 00AC'              	JZ	VIC_ESC
  0029'   3A 2E51'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002C'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  002E'   CA 1A87'              	JZ	VR_DO
                                	;--- maybe a count digit ---
  0031'   79                    	MOV	A,C
  0032'   FE 31                 	CPI	'1'
  0034'   DA 003F'              	JC	VIC_NOTD	; < '1'
  0037'   FE 3A                 	CPI	'9'+1
  0039'   D2 003F'              	JNC	VIC_NOTD	; > '9'
  003C'   C3 004F'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  003F'                         VIC_NOTD:
  003F'   79                    	MOV	A,C
  0040'   FE 30                 	CPI	'0'
  0042'   C2 0077'              	JNZ	VICDSP
  0045'   2A 2E1C'              	LHLD	CMDCNT
  0048'   7C                    	MOV	A,H
  0049'   B5                    	ORA	L
  004A'   CA 0077'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  004D'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  004F'                         VICDIG:
  004F'   2A 2E1C'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0052'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0053'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0054'   29                    	DAD	H		; *2
  0055'   DA 006E'              	JC	VIC_SAT
  0058'   29                    	DAD	H		; *4
  0059'   DA 006E'              	JC	VIC_SAT
  005C'   19                    	DAD	D		; *5
  005D'   DA 006E'              	JC	VIC_SAT
  0060'   29                    	DAD	H		; *10
  0061'   DA 006E'              	JC	VIC_SAT
  0064'   79                    	MOV	A,C
  0065'   D6 30                 	SUI	'0'
  0067'   5F                    	MOV	E,A
  0068'   16 00                 	MVI	D,0
  006A'   19                    	DAD	D
  006B'   D2 0071'              	JNC	VIC_CNT
  006E'                         VIC_SAT:
  006E'   21 FFFF               	LXI	H,0FFFFH
  0071'                         VIC_CNT:
  0071'   22 2E1C'              	SHLD	CMDCNT
  0074'   C3 0820'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  0077'                         VICDSP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  0077'   3A 2E51'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  007A'   32 2E52'              	STA	GSAVE
  007D'   AF                    	XRA	A
  007E'   32 2E51'              	STA	GPEND
  0081'   3A 2E53'              	LDA	PENDOP
  0084'   32 2E54'              	STA	PSAVE
  0087'   AF                    	XRA	A
  0088'   32 2E53'              	STA	PENDOP
  008B'   3A 2E54'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  008E'   B7                    	ORA	A
  008F'   C2 13E7'              	JNZ	OPPEND
  0092'   3A 2E52'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0095'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  0097'   C2 00A0'              	JNZ	VIC_TB
  009A'   79                    	MOV	A,C
  009B'   FE 5A                 	CPI	'Z'
  009D'   C2 00A6'              	JNZ	VIC_SW
  00A0'                         VIC_TB:
  00A0'   21 2D63'              	LXI	H,CMDTAB
  00A3'   C3 00BC'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A6'                         VIC_SW:
  00A6'   CD 0820'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00A9'   C3 074B'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AC'                         VIC_ESC:
  00AC'   AF                    	XRA	A		; ESC drops whatever was pending, the count too
  00AD'   32 2E51'              	STA	GPEND
  00B0'   32 2E52'              	STA	GSAVE
  00B3'   32 2E53'              	STA	PENDOP
  00B6'   32 2E54'              	STA	PSAVE
  00B9'   C3 00A6'              	JMP	VIC_SW
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the TOP-LEVEL key table, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00BC'                         VSCANQ:
  00BC'   CD 00C8'              	CALL	VSCLK
  00BF'   CA 00A6'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C2'   E9                    	PCHL
  00C3'                         VSCAN:
  00C3'   CD 00C8'              	CALL	VSCLK
  00C6'   C8                    	RZ			; miss
  00C7'   E9                    	PCHL
  00C8'                         VSCLK:
  00C8'   7E                    VSCAN1: MOV	A,M
  00C9'   B7                    	ORA	A
  00CA'   C8                    	RZ			; miss: Z, and A = the terminating 0
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00CB'   23                    	INX	H
  00CC'   B9                    	CMP	C
  00CD'   5E                    	MOV	E,M
  00CE'   23                    	INX	H
  00CF'   56                    	MOV	D,M
  00D0'   23                    	INX	H
  00D1'   C2 00C8'              	JNZ	VSCAN1
  00D4'   EB                    	XCHG			; HL = the handler
  00D5'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00D6'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00D7'                         DOTPRE:
  00D7'   3A 2E48'              	LDA	DOTRPL
  00DA'   B7                    	ORA	A
  00DB'   C0                    	RNZ			; the replay's own keys are not recorded
  00DC'   C5                    	PUSH	B
  00DD'   D5                    	PUSH	D
  00DE'   E5                    	PUSH	H
  00DF'   3A 2E47'              	LDA	DOTSTA
  00E2'   B7                    	ORA	A
  00E3'   CA 00F6'              	JZ	DOTP1
  00E6'   AF                    	XRA	A		; a new command: the recording starts over
  00E7'   32 2E47'              	STA	DOTSTA
  00EA'   32 2E49'              	STA	DOTOVF
  00ED'   21 0000*              	LXI	H,DOTSCR
  00F0'   22 2E4B'              	SHLD	DOTSP
  00F3'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00F6'                         DOTP1:
  00F6'   79                    	MOV	A,C
  00F7'   32 2E4A'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  00FA'   47                    	MOV	B,A
  00FB'   2A 2E4B'              	LHLD	DOTSP
  00FE'   EB                    	XCHG
  00FF'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  0102'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  0105'   D2 0114'              	JNC	DOTPOV
  0108'   2A 2E4B'              	LHLD	DOTSP
  010B'   70                    	MOV	M,B
  010C'   23                    	INX	H
  010D'   22 2E4B'              	SHLD	DOTSP
  0110'                         DOTPX:
  0110'   E1                    	POP	H
  0111'   D1                    	POP	D
  0112'   C1                    	POP	B
  0113'   C9                    	RET
  0114'                         DOTPOV:
  0114'   3E 01                 	MVI	A,1
  0116'   32 2E49'              	STA	DOTOVF		; too long to record: give this recording up
  0119'   C3 0110'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  011C'                         DOTPOST:
  011C'   3A 2E48'              	LDA	DOTRPL
  011F'   B7                    	ORA	A
  0120'   C0                    	RNZ
  0121'   3A 2E1B'              	LDA	EDMODE
  0124'   B7                    	ORA	A
  0125'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  0126'   3A 2E51'              	LDA	GPEND
  0129'   B7                    	ORA	A
  012A'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  012B'   3A 2E53'              	LDA	PENDOP
  012E'   B7                    	ORA	A
  012F'   C0                    	RNZ			; an operator still waiting for its motion
  0130'   2A 2E1C'              	LHLD	CMDCNT
  0133'   7C                    	MOV	A,H
  0134'   B5                    	ORA	L
  0135'   CA 0143'              	JZ	DOTQ1
  0138'   3A 2E4A'              	LDA	DOTLK		; a digit with the count still up: the command
  013B'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  013D'   DA 0143'              	JC	DOTQ1
  0140'   FE 3A                 	CPI	'9'+1
  0142'   D8                    	RC
  0143'                         DOTQ1:
  0143'   3E 01                 	MVI	A,1
  0145'   32 2E47'              	STA	DOTSTA		; the next key starts a new recording
  0148'   3A 2E46'              	LDA	DOTCHG
  014B'   B7                    	ORA	A
  014C'   C8                    	RZ			; changed nothing: not a repeatable command
  014D'   AF                    	XRA	A
  014E'   32 2E46'              	STA	DOTCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0151'   32 2E4D'              	STA	DOTLEN
  0154'   3A 2E49'              	LDA	DOTOVF
  0157'   B7                    	ORA	A
  0158'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  0159'   2A 2E4B'              	LHLD	DOTSP
  015C'   11 0000*              	LXI	D,DOTSCR
  015F'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  0162'   7D                    	MOV	A,L
  0163'   32 2E4D'              	STA	DOTLEN
  0166'   B7                    	ORA	A
  0167'   C8                    	RZ
  0168'   4F                    	MOV	C,A
  0169'   06 00                 	MVI	B,0
  016B'   21 0000*              	LXI	H,DOTSCR
  016E'   11 0000*              	LXI	D,DOTBUF
  0171'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  0174'                         MARKMOD:
  0174'   3E 01                 	MVI	A,1
  0176'   32 2E1F'              	STA	MODF
  0179'   32 2E46'              	STA	DOTCHG
  017C'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  017D'                         VC_DOT:
  017D'   2A 2E1C'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0180'   22 2E4F'              	SHLD	DOTNCT
  0183'   21 0000               	LXI	H,0
  0186'   22 2E1C'              	SHLD	CMDCNT
  0189'   3A 2E4D'              	LDA	DOTLEN
  018C'   B7                    	ORA	A
  018D'   CA 01DC'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
  0190'   AF                    	XRA	A
  0191'   32 2E4E'              	STA	DOTIX
  0194'   2A 2E4F'              	LHLD	DOTNCT
  0197'   7C                    	MOV	A,H
  0198'   B5                    	ORA	L
  0199'   CA 01B9'              	JZ	DOTGO
  019C'   22 2E1C'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  019F'                         DOTSKP:
  019F'   CD 05BD'              	CALL	DOTGET		; ... so step past the digits it recorded
  01A2'   DA 01B9'              	JC	DOTGO
  01A5'   FE 30                 	CPI	'0'
  01A7'   DA 01B9'              	JC	DOTGO
  01AA'   FE 3A                 	CPI	'9'+1
  01AC'   D2 01B9'              	JNC	DOTGO
  01AF'   3A 2E4E'              	LDA	DOTIX
  01B2'   3C                    	INR	A
  01B3'   32 2E4E'              	STA	DOTIX
  01B6'   C3 019F'              	JMP	DOTSKP
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01B9'                         DOTGO:
  01B9'   3E 01                 	MVI	A,1
  01BB'   32 2E48'              	STA	DOTRPL
  01BE'                         DOTLP:
  01BE'   CD 05BD'              	CALL	DOTGET
  01C1'   DA 01D2'              	JC	DOTDN
  01C4'   4F                    	MOV	C,A
  01C5'   3A 2E4E'              	LDA	DOTIX
  01C8'   3C                    	INR	A
  01C9'   32 2E4E'              	STA	DOTIX
  01CC'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01CF'   C3 01BE'              	JMP	DOTLP
  01D2'                         DOTDN:
  01D2'   AF                    	XRA	A
  01D3'   32 2E48'              	STA	DOTRPL
  01D6'   32 2E46'              	STA	DOTCHG		; the '.' is not itself the new last change
  01D9'   C3 085D'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01DC'                         DOTBEL:
  01DC'   0E 07                 	MVI	C,BEL
  01DE'   CD 0000*              	CALL	BCONOU
  01E1'   C3 0820'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a 3-byte position in the FILE (FPOS: the records paged out ahead
                                ; of the window, plus the offset into it), so it does not care which part of
                                ; the file is resident: a jump pages until the window holds it (MKPAGE).  It
                                ; FOLLOWS its text, as vim's does: every edit passes MKSHFT, which moves the
                                ; marks past it by the bytes that went in or came out.
                                ;
                                ; DEVIATIONS from vim, in COMMANDS.md: a mark whose own text is deleted closes
                                ; up to where the delete was, where vim deletes the mark with its line; and
                                ; within its line a mark stays with its CHARACTER, where vim keeps the column
                                ; number.  'u' puts the marks back where they were when the change it
                                ; undoes began (MKSNAP / MKREST).
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  01E4'                         MKVAD:
  01E4'   16 00                 	MVI	D,0
  01E6'   59                    	MOV	E,C
  01E7'   21 2EB7'              	LXI	H,MKVAL
  01EA'   19                    	DAD	D
  01EB'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  01EC'                         MKCLR:
  01EC'   21 2EB7'              	LXI	H,MKVAL
  01EF'   06 03                 	MVI	B,MKMAX
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


  01F1'   AF                    	XRA	A
  01F2'                         MKC_LP:
  01F2'   77                    	MOV	M,A
  01F3'   23                    	INX	H
  01F4'   05                    	DCR	B
  01F5'   C2 01F2'              	JNZ	MKC_LP
  01F8'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was an ESC.
                                ;A key typed here did not come through the dispatcher, so it is handed to
                                ;DOTPRE to join the recording: that is what lets '.' repeat "dfa", "dgg" and
                                ;"d'a".
  01F9'                         MKGETK:
  01F9'   3A 2E48'              	LDA	DOTRPL
  01FC'   B7                    	ORA	A
  01FD'   CA 020E'              	JZ	MKG_KB
  0200'   CD 05BD'              	CALL	DOTGET		; the recording's next key
  0203'   D8                    	RC
  0204'   4F                    	MOV	C,A
  0205'   3A 2E4E'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  0208'   3C                    	INR	A
  0209'   32 2E4E'              	STA	DOTIX
  020C'   B7                    	ORA	A		; CY clear
  020D'   C9                    	RET
  020E'                         MKG_KB:
  020E'   CD 0000*              	CALL	GETKEY
  0211'   FE 1B                 	CPI	ESC
  0213'   37                    	STC
  0214'   C8                    	RZ			; ESC cancels the command
  0215'   CD 00D7'              	CALL	DOTPRE		; C kept
  0218'   B7                    	ORA	A		; CY clear
  0219'   C9                    	RET
                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
                                ; the motion returns.  MKGETK puts the character in the '.' recording, so
                                ; '.' can repeat "dfa".
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  021A'                         VC_FF:				; 'f' -- forward, onto the character
  021A'   3E 66                 	MVI	A,'f'
  021C'   C3 022B'              	JMP	FNDNEW
  021F'                         VC_FB:				; 'F' -- backward, onto it
  021F'   3E 46                 	MVI	A,'F'
  0221'   C3 022B'              	JMP	FNDNEW
  0224'                         VC_TF:				; 't' -- forward, up to it
  0224'   3E 74                 	MVI	A,'t'
  0226'   C3 022B'              	JMP	FNDNEW
  0229'                         VC_TB:				; 'T' -- backward, up to it
  0229'   3E 54                 	MVI	A,'T'
  022B'                         FNDNEW:
  022B'   32 2EAC'              	STA	FNDKND		; the find ';' and ',' will repeat
  022E'   CD 01F9'              	CALL	MKGETK		; the character it looks for
  0231'   DA 0263'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0234'   79                    	MOV	A,C
  0235'   32 2EAD'              	STA	FNDCH
  0238'   3A 2EAC'              	LDA	FNDKND
  023B'   06 01                 	MVI	B,1		; a find starts at the next character along
  023D'   C3 026A'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0240'                         VC_SEMI:
  0240'   3A 2EAC'              	LDA	FNDKND
  0243'   B7                    	ORA	A
  0244'   CA 0263'              	JZ	FNDNIL		; nothing has been looked for yet
  0247'   C3 0253'              	JMP	FNDREP
  024A'                         VC_COMMA:
  024A'   3A 2EAC'              	LDA	FNDKND
  024D'   B7                    	ORA	A
  024E'   CA 0263'              	JZ	FNDNIL
  0251'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0253'                         FNDREP:
  0253'   06 01                 	MVI	B,1
  0255'   F5                    	PUSH	PSW
  0256'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  0258'   FE 54                 	CPI	'T'
  025A'   C2 025F'              	JNZ	FNDR_GO
  025D'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  025F'                         FNDR_GO:
  025F'   F1                    	POP	PSW
  0260'   C3 026A'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
  0263'                         FNDNIL:
  0263'   AF                    	XRA	A
  0264'   32 2E54'              	STA	PSAVE
  0267'   C3 0820'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  026A'                         FNDGO:
  026A'   32 2EAE'              	STA	FNDRUN
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  026D'   78                    	MOV	A,B
  026E'   32 2EAF'              	STA	FNDSTP
  0271'   CD 0738'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
  0274'   22 2EB0'              	SHLD	FNDN		; the occurrence wanted
  0277'   CD 0000*              	CALL	CUROFF
  027A'   22 2EB2'              	SHLD	FNDCUR
  027D'   3A 2EAE'              	LDA	FNDRUN
  0280'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  0282'   CA 02B6'              	JZ	FNDBWD
  0285'   2A 2EB2'              	LHLD	FNDCUR
  0288'   CD 06E3'              	CALL	EOLC		; HL = the line's last content character
  028B'   22 2EB4'              	SHLD	FNDLIM
  028E'   2A 2EB2'              	LHLD	FNDCUR
  0291'   3A 2EAF'              	LDA	FNDSTP
  0294'   5F                    	MOV	E,A
  0295'   16 00                 	MVI	D,0
  0297'   19                    	DAD	D		; HL = where the scan starts
  0298'                         FNDF_LP:
  0298'   EB                    	XCHG			; DE = the scan
  0299'   2A 2EB4'              	LHLD	FNDLIM
  029C'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  029F'   EB                    	XCHG			; HL = the scan
  02A0'   CA 02A6'              	JZ	FNDF_AT		; the last character is still a candidate
  02A3'   D2 0308'              	JNC	FNDMIS		; past it: not on this line
  02A6'                         FNDF_AT:
  02A6'   CD 030F'              	CALL	FNDSEE		; Z iff this is the character
  02A9'   C2 02B2'              	JNZ	FNDF_NX
  02AC'   CD 031A'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02AF'   CA 02EE'              	JZ	FNDHIT
  02B2'                         FNDF_NX:
  02B2'   23                    	INX	H
  02B3'   C3 0298'              	JMP	FNDF_LP
  02B6'                         FNDBWD:
  02B6'   2A 2EB2'              	LHLD	FNDCUR
  02B9'   CD 063D'              	CALL	BOL		; HL = the line's first character
  02BC'   22 2EB4'              	SHLD	FNDLIM
  02BF'   2A 2EB2'              	LHLD	FNDCUR
  02C2'   3A 2EAF'              	LDA	FNDSTP
  02C5'   2F                    	CMA
  02C6'   5F                    	MOV	E,A
  02C7'   16 FF                 	MVI	D,0FFH
  02C9'   13                    	INX	D		; DE = -step
  02CA'   19                    	DAD	D		; HL = where the scan starts
  02CB'   D2 0308'              	JNC	FNDMIS		; ... off the front of the text altogether
  02CE'                         FNDB_LP:
  02CE'   EB                    	XCHG			; DE = the scan
  02CF'   2A 2EB4'              	LHLD	FNDLIM
  02D2'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02D5'   EB                    	XCHG			; HL = the scan
  02D6'   DA 0308'              	JC	FNDMIS		; before this line: not on it
  02D9'   CD 030F'              	CALL	FNDSEE
  02DC'   C2 02E5'              	JNZ	FNDB_NX
  02DF'   CD 031A'              	CALL	FNDCNT
  02E2'   CA 02EE'              	JZ	FNDHIT
  02E5'                         FNDB_NX:
  02E5'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02E6'   B5                    	ORA	L
  02E7'   CA 0308'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
  02EA'   2B                    	DCX	H
  02EB'   C3 02CE'              	JMP	FNDB_LP
                                
                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  02EE'                         FNDHIT:
  02EE'   3A 2EAE'              	LDA	FNDRUN
  02F1'   E6 5F                 	ANI	5FH
  02F3'   FE 54                 	CPI	'T'
  02F5'   C2 0305'              	JNZ	FNDLND
  02F8'   3A 2EAE'              	LDA	FNDRUN
  02FB'   E6 20                 	ANI	20H
  02FD'   CA 0304'              	JZ	FNDH_BW
  0300'   2B                    	DCX	H		; forward 't': the character before it
  0301'   C3 0305'              	JMP	FNDLND
  0304'                         FNDH_BW:
  0304'   23                    	INX	H		; backward 'T': the character after it
  0305'                         FNDLND:
  0305'   C3 05D3'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  0308'                         FNDMIS:
  0308'   AF                    	XRA	A
  0309'   32 2E54'              	STA	PSAVE
  030C'   C3 01DC'              	JMP	DOTBEL
                                
                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
  030F'                         FNDSEE:
  030F'   E5                    	PUSH	H
  0310'   CD 0000*              	CALL	CHARAT
  0313'   E1                    	POP	H
  0314'   47                    	MOV	B,A
  0315'   3A 2EAD'              	LDA	FNDCH
  0318'   B8                    	CMP	B
  0319'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
                                ; the scan and stays it.
  031A'                         FNDCNT:
  031A'   E5                    	PUSH	H
  031B'   2A 2EB0'              	LHLD	FNDN
  031E'   2B                    	DCX	H
  031F'   22 2EB0'              	SHLD	FNDN
  0322'   7C                    	MOV	A,H
  0323'   B5                    	ORA	L
  0324'   E1                    	POP	H
  0325'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  0326'                         ISFIND:
  0326'   E6 5F                 	ANI	5FH		; fold the case away
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  0328'   FE 46                 	CPI	'F'
  032A'   C8                    	RZ
  032B'   FE 54                 	CPI	'T'
  032D'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  032E'                         VC_MK:
  032E'   3E 04                 	MVI	A,PM
  0330'   C3 033A'              	JMP	MKGO
  0333'                         VC_BQ:
  0333'   3E 05                 	MVI	A,PJ
  0335'   C3 033A'              	JMP	MKGO
  0338'                         VC_AQ:
  0338'   3E 06                 	MVI	A,PJL
  033A'                         MKGO:
  033A'   32 2EC3'              	STA	MKWHAT
  033D'   CD 0738'              	CALL	MOVCNT		; a count means nothing on any of the three
  0340'   CD 01F9'              	CALL	MKGETK		; the key that names the mark
  0343'   DA 0422'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out.  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist: 'm' with any other key
                                ;drops the whole thing, as vim's 'Z{other}' does, and a jump to one is a jump
                                ;to a mark that is not set.
  0346'                         MKOP:
  0346'   79                    	MOV	A,C
  0347'   D6 61                 	SUI	'a'
  0349'   FE 03                 	CPI	MKMAX
  034B'   D2 041A'              	JNC	MKNOLT		; not a mark letter
  034E'   4F                    	MOV	C,A		; C = the mark's index
  034F'   87                    	ADD	A
  0350'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  0351'   5F                    	MOV	E,A
  0352'   16 00                 	MVI	D,0
  0354'   21 0000*              	LXI	H,MKTAB
  0357'   19                    	DAD	D		; HL -> this mark's slot
  0358'   3A 2EC3'              	LDA	MKWHAT
  035B'   FE 04                 	CPI	PM
  035D'   CA 0435'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark, paging to it if the window has left it.
                                ;'Mark not set', as vim says it, when it was never set.
                                ;Under an OPERATOR a mark the window does not hold is refused with the bell
                                ;and stays set, all but "d'a": a line delete is the one operator that can take
                                ;a span the window does not hold whole (OPPGD), and going there only to be
                                ;turned away by it would page the file twice for nothing.
  0360'                         MKJMP:
  0360'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  0361'   CD 01E4'              	CALL	MKVAD
  0364'   7E                    	MOV	A,M
  0365'   E1                    	POP	H
  0366'   B7                    	ORA	A
  0367'   CA 0410'              	JZ	MKNSET		; never set
  036A'   CD 03DC'              	CALL	MKLOAD		; the file position it holds
  036D'   CD 03E9'              	CALL	MKWIN
  0370'   DA 0387'              	JC	MKJ_GO		; in the window: any command may go there
  0373'   3A 2E54'              	LDA	PSAVE
  0376'   B7                    	ORA	A
  0377'   CA 0387'              	JZ	MKJ_GO
  037A'   FE 64                 	CPI	'd'		; paged out, and an operator wants the span
  037C'   C2 0422'              	JNZ	MKBAD
  037F'   3A 2EC3'              	LDA	MKWHAT
  0382'   FE 06                 	CPI	PJL
  0384'   C2 0422'              	JNZ	MKBAD
  0387'                         MKJ_GO:
  0387'   CD 12F8'              	CALL	GZONE		; the screen's top line, before the cursor
                                				;   moves: GPLACE measures the landing against
                                				;   it, and one left over from an earlier 'G'
                                				;   had it keep a window the line is not in
  038A'   CD 0774'              	CALL	BRKON		; ... and an ESC may stop it from here on
  038D'   CD 03A9'              	CALL	MKPAGE		; HL = the mark's offset in the window
  0390'   CD 07B1'              	CALL	BRKOFF		; (A only)
  0393'   DA 07C9'              	JC	BRKBAK
  0396'   3A 2EC3'              	LDA	MKWHAT
  0399'   FE 06                 	CPI	PJL
  039B'   CA 03A3'              	JZ	MKJ_LN		; ''': GPKEEP is 0, so GPLACE finds the first
  039E'   3E 01                 	MVI	A,1		;   non-blank
  03A0'   32 2EB6'              	STA	GPKEEP		; '`': land on the column it was set at
  03A3'                         MKJ_LN:
  03A3'   CD 0000*              	CALL	GOTO
  03A6'   C3 1310'              	JMP	GPLACE		; (which sets LNDLT itself)
                                
                                ;MKPAGE -- page until MKPOS is in the window: HL = its logical offset there.
                                ;The loop is WM's own whole-file line move (MVLMAX: GOLINE to the window's
                                ;edge, SCRLST to page one step), stopped by where the window is instead of by
                                ;the count.  A step cannot carry the window past the mark: the pager evicts
                                ;only behind the cursor, and the cursor is on the edge nearer the mark.
  03A9'                         MKPAGE:
  03A9'   CD 03E9'              	CALL	MKWIN
  03AC'   DA 0000*              	JC	CLRCNT		; there: and the count that paged is spent,
                                				;   not left for the next command to take
  03AF'   32 0000*              	STA	DIRFLG
  03B2'   21 FFFF               	LXI	H,0FFFFH
  03B5'   22 2E1C'              	SHLD	CMDCNT
  03B8'   CD 0000*              	CALL	GOLINE
  03BB'   CD 0000*              	CALL	SCRLST
  03BE'   CD 0760'              	CALL	CNTTST
  03C1'   C2 03A9'              	JNZ	MKPAGE
  03C4'   CD 03E9'              	CALL	MKWIN		; the file ran out: that was its last step
  03C7'   DA 0000*              	JC	CLRCNT
  03CA'   21 FFFF               	LXI	H,0FFFFH	; the very end of the text, which MKWIN does not
  03CD'   C3 0000*              	JMP	CLRCNT		;   count as in the window: GOTO clamps it
                                
                                ;BACKTO -- back to the 3-byte file position at HL, paging to it: where a
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


                                ;command that came to nothing started.  The place has to be kept as a file
                                ;position -- a sweep of the whole file leaves the window at the far end of
                                ;it, and an offset into the window it started in means nothing there.
  03D0'                         BACKTO:
  03D0'   CD 03DC'              	CALL	MKLOAD
  03D3'   CD 0000*              	CALL	CLRCNT
  03D6'   CD 03A9'              	CALL	MKPAGE
  03D9'   C3 0000*              	JMP	GOTO
                                
                                ;MKLOAD -- MKPOS = the 3-byte file position at HL.
  03DC'                         MKLOAD:
  03DC'   5E                    	MOV	E,M
  03DD'   23                    	INX	H
  03DE'   56                    	MOV	D,M
  03DF'   23                    	INX	H
  03E0'   7E                    	MOV	A,M
  03E1'   EB                    	XCHG
  03E2'   22 2EC0'              	SHLD	MKPOS
  03E5'   32 2EC2'              	STA	MKPOS+2
  03E8'   C9                    	RET
                                
                                ;MKWIN -- CY and HL = MKPOS as a logical offset if the window holds it; NC and
                                ;A = the way to page for it, as DIRFLG has it (0 forward, FFH back), if not.
  03E9'                         MKWIN:
  03E9'   2A 0000*              	LHLD	TXTBEG
  03EC'   CD 12B2'              	CALL	FPOS
  03EF'   EB                    	XCHG
  03F0'   47                    	MOV	B,A		; B:DE = the window's first byte
  03F1'   2A 2EC0'              	LHLD	MKPOS
  03F4'   3A 2EC2'              	LDA	MKPOS+2
  03F7'   CD 12A5'              	CALL	SUB24		; A:HL = the mark, from the window's top
  03FA'   DA 040C'              	JC	MKW_BK		; above it
  03FD'   C2 040A'              	JNZ	MKW_FW		; 64K or more below it
  0400'   E5                    	PUSH	H
  0401'   CD 0000*              	CALL	LOGLEN
  0404'   D1                    	POP	D
  0405'   CD 0000*              	CALL	CMP16		; DE = the offset vs HL = the window's length
  0408'   EB                    	XCHG
  0409'   D8                    	RC			; inside
  040A'                         MKW_FW:
  040A'   AF                    	XRA	A
  040B'   C9                    	RET
  040C'                         MKW_BK:
  040C'   3E FF                 	MVI	A,0FFH
  040E'   B7                    	ORA	A
  040F'   C9                    	RET
                                
                                ;MKNSET -- a jump to a mark that will not answer: vim's E20 on the bottom row
                                ;(without the number, and without a bell, as every message here), the cursor
                                ;and the screen left alone.  The operator is cancelled as MKBAD cancels it.
  0410'                         MKNSET:
  0410'   AF                    	XRA	A
  0411'   32 2E54'              	STA	PSAVE
  0414'   21 27F3'              	LXI	H,SMKNS
  0417'   C3 26D8'              	JMP	EXERR
  041A'                         MKNOLT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  041A'   3A 2EC3'              	LDA	MKWHAT
  041D'   FE 04                 	CPI	PM
  041F'   C2 0410'              	JNZ	MKNSET		; a jump: that mark is not set
                                				; 'm{other}': fall into MKBAD
                                
                                ;MKBAD -- no mark was named: 'm' with a key that is not a mark letter, ESC in
                                ;place of the letter, or a '.' replay that ran out.  The bell, and an operator
                                ;running the motion is cancelled whole: PSAVE is what OPPEND's tail reads to
                                ;decide whether to open an insert, so clearing it stops a "c`z" opening one
                                ;over a span of nothing.
  0422'                         MKBAD:
  0422'   AF                    	XRA	A
  0423'   32 2E54'              	STA	PSAVE
  0426'   C3 01DC'              	JMP	DOTBEL
                                
                                ;FPSTO -- the cursor's file position into the 3 bytes at HL.  Keeps BC.
  0429'                         FPSTO:
  0429'   E5                    	PUSH	H
  042A'   CD 12AF'              	CALL	CURFP		; A:HL = the cursor's file position
  042D'   EB                    	XCHG
  042E'   E1                    	POP	H
  042F'   73                    	MOV	M,E
  0430'   23                    	INX	H
  0431'   72                    	MOV	M,D
  0432'   23                    	INX	H
  0433'   77                    	MOV	M,A
  0434'   C9                    	RET
                                
                                ;MKSET -- remember where in the FILE the cursor is.
  0435'                         MKSET:
  0435'   CD 0429'              	CALL	FPSTO
  0438'   CD 01E4'              	CALL	MKVAD
  043B'   36 01                 	MVI	M,1		; ... and the mark is live
  043D'   C3 0820'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKSNAP -- keep the marks as they stand, for 'u' (MKREST).  Each copy's spare
                                ;fourth byte takes that mark's live flag.  HL and BC are kept.
  0440'                         MKSNAP:
  0440'   C5                    	PUSH	B
  0441'   E5                    	PUSH	H
  0442'   21 0000*              	LXI	H,MKTAB
  0445'   11 0000*              	LXI	D,MKUND
  0448'   CD 24FB'              	CALL	COPY12
  044B'   21 2EB7'              	LXI	H,MKVAL
  044E'   11 0003*              	LXI	D,MKUND+MKSIZ-1
  0451'   06 03                 	MVI	B,MKMAX
  0453'                         MSN_LP:
  0453'   7E                    	MOV	A,M
  0454'   12                    	STAX	D
  0455'   23                    	INX	H
  0456'   13                    	INX	D
  0457'   13                    	INX	D
  0458'   13                    	INX	D
  0459'   13                    	INX	D
  045A'   05                    	DCR	B
  045B'   C2 0453'              	JNZ	MSN_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  045E'   E1                    	POP	H
  045F'   C1                    	POP	B
  0460'   C9                    	RET
                                
                                ;MKREST -- a change has been undone: every mark that was set when it began
                                ;goes back where it was then, whether the change ran over it or 'm' has moved
                                ;it since (vim keeps them with the undo too).  One first set AFTER the change
                                ;is left where the replay's own edits carried it.
  0461'                         MKREST:
  0461'   0E 02                 	MVI	C,MKMAX-1
  0463'                         MRS_LP:
  0463'   79                    	MOV	A,C
  0464'   87                    	ADD	A
  0465'   87                    	ADD	A
  0466'   5F                    	MOV	E,A
  0467'   16 00                 	MVI	D,0
  0469'   21 0003*              	LXI	H,MKUND+MKSIZ-1
  046C'   19                    	DAD	D
  046D'   7E                    	MOV	A,M
  046E'   B7                    	ORA	A
  046F'   CA 048B'              	JZ	MRS_NX		; it was not set then
  0472'   2B                    	DCX	H
  0473'   2B                    	DCX	H
  0474'   2B                    	DCX	H
  0475'   E5                    	PUSH	H
  0476'   21 0000*              	LXI	H,MKTAB
  0479'   19                    	DAD	D
  047A'   EB                    	XCHG			; DE -> the mark
  047B'   E1                    	POP	H		; HL -> its copy
  047C'   06 03                 	MVI	B,MKSIZ-1
  047E'                         MRS_CP:
  047E'   7E                    	MOV	A,M
  047F'   12                    	STAX	D
  0480'   23                    	INX	H
  0481'   13                    	INX	D
  0482'   05                    	DCR	B
  0483'   C2 047E'              	JNZ	MRS_CP
  0486'   CD 01E4'              	CALL	MKVAD
  0489'   36 01                 	MVI	M,1
  048B'                         MRS_NX:
  048B'   0D                    	DCR	C
  048C'   F2 0463'              	JP	MRS_LP
  048F'   C9                    	RET
                                
                                ;MKSHFT -- the text is changing: every mark follows its own text.  BUF.MAC's
                                ;UNDCHG calls this through EDTHK from all six edit primitives -- 'u's replay
                                ;of them included -- with A = 1 for an insert (the text is in) or 2 for a
                                ;delete (it is about to go), HL = the edit's logical offset and BC = its
                                ;length.  A mark before the edit stays; one after it moves by the length; one
                                ;INSIDE a delete closes up to where the delete was.  An insert AT a mark
                                ;leaves the mark in front of the new text, unless that text ends a line -- a
                                ;line opened or put above the mark's is above the mark too.
                                ;The edit is found from the CURSOR's file position less its distance behind
                                ;the cursor, never from the offset alone: a put bigger than the window pages
                                ;its own start out, and that offset has then wrapped.  BC is kept.
  0490'                         MKSHFT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  0490'   32 2EBF'              	STA	MKTYP
  0493'   3A 2EC4'              	LDA	MKHOLD		; a yank that could not copy takes its lines out
  0496'   B7                    	ORA	A		;   and puts them back unchanged (YKGO): the text
  0497'   C0                    	RNZ			;   every mark points into is still there
  0498'   3A 0000*              	LDA	UNDRPL
  049B'   B7                    	ORA	A
  049C'   C2 04A6'              	JNZ	MKS_GO		; 'u' replaying: not a new change
  049F'   3A 0000*              	LDA	UNDNEW		; the first edit of a new change (UNDCHG calls
  04A2'   B7                    	ORA	A		;   here BEFORE it claims the change): the marks
  04A3'   C4 0440'              	CNZ	MKSNAP		;   as they are now are the ones 'u' puts back
  04A6'                         MKS_GO:
  04A6'   C5                    	PUSH	B
  04A7'   50                    	MOV	D,B
  04A8'   59                    	MOV	E,C
  04A9'   EB                    	XCHG
  04AA'   22 2EBD'              	SHLD	MKN		; the edit's length
  04AD'   D5                    	PUSH	D		; ... and its offset
  04AE'   CD 0000*              	CALL	CUROFF
  04B1'   D1                    	POP	D
  04B2'   CD 0000*              	CALL	SUBHD
  04B5'   EB                    	XCHG			; DE = how far behind the cursor it is
  04B6'   CD 12AF'              	CALL	CURFP		; A:HL = the cursor's file position
  04B9'   06 00                 	MVI	B,0
  04BB'   CD 12A5'              	CALL	SUB24
  04BE'   22 2EBA'              	SHLD	MKEDIT
  04C1'   32 2EBC'              	STA	MKEDIT+2	; where in the file the edit is
  04C4'   21 2EB7'              	LXI	H,MKVAL
  04C7'   11 0000*              	LXI	D,MKTAB
  04CA'   06 03                 	MVI	B,MKMAX
  04CC'                         MKS_LP:
  04CC'   7E                    	MOV	A,M
  04CD'   B7                    	ORA	A
  04CE'   CA 053A'              	JZ	MKS_N0		; that mark is not set
  04D1'   E5                    	PUSH	H
  04D2'   C5                    	PUSH	B
  04D3'   21 2EBA'              	LXI	H,MKEDIT
  04D6'   1A                    	LDAX	D		; the mark's position less the edit's, a byte
  04D7'   96                    	SUB	M		;   at a time (neither INX nor LDAX touch CY)
  04D8'   4F                    	MOV	C,A
  04D9'   13                    	INX	D
  04DA'   23                    	INX	H
  04DB'   1A                    	LDAX	D
  04DC'   9E                    	SBB	M
  04DD'   47                    	MOV	B,A
  04DE'   13                    	INX	D
  04DF'   23                    	INX	H
  04E0'   1A                    	LDAX	D
  04E1'   9E                    	SBB	M		; A:BC = how far past the edit the mark is
  04E2'   DA 0535'              	JC	MKS_PP		; before it: nothing moves
  04E5'   6F                    	MOV	L,A
  04E6'   3A 2EBF'              	LDA	MKTYP
  04E9'   3D                    	DCR	A
  04EA'   CA 050F'              	JZ	MKS_IN
                                	;--- a delete: back by its length, or to it if the mark is inside ---
  04ED'   7D                    	MOV	A,L
  04EE'   2A 2EBD'              	LHLD	MKN
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04F1'   B7                    	ORA	A
  04F2'   C2 04FE'              	JNZ	MKS_DL		; 64K or more past it
  04F5'   79                    	MOV	A,C
  04F6'   95                    	SUB	L
  04F7'   78                    	MOV	A,B
  04F8'   9C                    	SBB	H
  04F9'   D2 04FE'              	JNC	MKS_DL		; past the end of what goes
  04FC'   60                    	MOV	H,B
  04FD'   69                    	MOV	L,C		; inside it: close up to the edit
  04FE'                         MKS_DL:
  04FE'   1B                    	DCX	D
  04FF'   1B                    	DCX	D
  0500'   1A                    	LDAX	D
  0501'   95                    	SUB	L
  0502'   12                    	STAX	D
  0503'   13                    	INX	D
  0504'   1A                    	LDAX	D
  0505'   9C                    	SBB	H
  0506'   12                    	STAX	D
  0507'   13                    	INX	D
  0508'   1A                    	LDAX	D
  0509'   DE 00                 	SBI	0
  050B'   12                    	STAX	D
  050C'   C3 0535'              	JMP	MKS_PP
                                	;--- an insert: on by its length ---
  050F'                         MKS_IN:
  050F'   7D                    	MOV	A,L
  0510'   B0                    	ORA	B
  0511'   B1                    	ORA	C
  0512'   C2 0524'              	JNZ	MKS_AD		; the mark is past it
  0515'   2A 0000*              	LHLD	GAPBEG		; AT the mark: only a line end carries it on
  0518'   2B                    	DCX	H
  0519'   7E                    	MOV	A,M		; the last byte that went in
  051A'   FE 0A                 	CPI	LF
  051C'   CA 0524'              	JZ	MKS_AD
  051F'   FE 0D                 	CPI	CR
  0521'   C2 0535'              	JNZ	MKS_PP
  0524'                         MKS_AD:
  0524'   2A 2EBD'              	LHLD	MKN
  0527'   1B                    	DCX	D
  0528'   1B                    	DCX	D
  0529'   1A                    	LDAX	D
  052A'   85                    	ADD	L
  052B'   12                    	STAX	D
  052C'   13                    	INX	D
  052D'   1A                    	LDAX	D
  052E'   8C                    	ADC	H
  052F'   12                    	STAX	D
  0530'   13                    	INX	D
  0531'   1A                    	LDAX	D
  0532'   CE 00                 	ACI	0
  0534'   12                    	STAX	D
  0535'                         MKS_PP:
  0535'   C1                    	POP	B
  0536'   E1                    	POP	H
  0537'   C3 053C'              	JMP	MKS_NX
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  053A'                         MKS_N0:
  053A'   13                    	INX	D
  053B'   13                    	INX	D
  053C'                         MKS_NX:
  053C'   13                    	INX	D
  053D'   13                    	INX	D
  053E'   23                    	INX	H
  053F'   05                    	DCR	B
  0540'   C2 04CC'              	JNZ	MKS_LP
  0543'   C1                    	POP	B
  0544'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  0545'                         VC_UNDO:
  0545'   21 0000               	LXI	H,0
  0548'   22 2E1C'              	SHLD	CMDCNT
  054B'   CD 0000*              	CALL	UNDO
  054E'   DA 05A0'              	JC	UNDNO
  0551'   3A 0000*              	LDA	UNDST
  0554'   FE 02                 	CPI	2
  0556'   CC 0461'              	CZ	MKREST		; undone (not redone): the marks go back too
  0559'   2A 0000*              	LHLD	UNDCUR
  055C'   CD 0586'              	CALL	UCLAMP		; vi never sits on a line terminator
  055F'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0562'   3E 01                 	MVI	A,1
  0564'   32 2E1F'              	STA	MODF		; undone past a ':w' still differs from the file
  0567'   CD 09CB'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  056A'   3A 0000*              	LDA	UNDML		; every step on one line, no line end among
  056D'   B7                    	ORA	A		;   them, and the cursor back on that line:
  056E'   C2 085D'              	JNZ	SETFUL		;   the line is the repaint -- all of it, the
  0571'   2A 0000*              	LHLD	UNDL0		;   cursor need not be where the change began.
  0574'   EB                    	XCHG			;   Anything else, and whole spans moved:
  0575'   2A 0000*              	LHLD	LNDLT		;   repaint rather than guess
  0578'   CD 0000*              	CALL	CMP16
  057B'   C2 085D'              	JNZ	SETFUL
  057E'   3E 01                 	MVI	A,1
  0580'   32 2E25'              	STA	LNALL
  0583'   C3 0826'              	JMP	SETLIN
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  0586'                         UCLAMP:
  0586'   E5                    	PUSH	H
  0587'   CD 18D9'              	CALL	CEND		; HL = the line's content end
  058A'   D1                    	POP	D		; DE = the offset wanted
  058B'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  058E'   D2 0593'              	JNC	UCL_BK
  0591'   EB                    	XCHG
  0592'   C9                    	RET
  0593'                         UCL_BK:
  0593'   E5                    	PUSH	H		; the content end
  0594'   EB                    	XCHG			; HL = the offset wanted
  0595'   CD 063D'              	CALL	BOL
  0598'   D1                    	POP	D		; DE = the content end, HL = the line's start
  0599'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  059C'   EB                    	XCHG			; HL = the content end
  059D'   C8                    	RZ
  059E'   2B                    	DCX	H		; ... its last character
  059F'   C9                    	RET
  05A0'                         UNDNO:
  05A0'   3A 0000*              	LDA	UNDWHY
  05A3'   B7                    	ORA	A
  05A4'   CA 05B5'              	JZ	UNDBEL
  05A7'   21 27AD'              	LXI	H,SUNDW		; the change has paged away: say so
  05AA'   FE 01                 	CPI	1
  05AC'   CA 26D8'              	JZ	EXERR
  05AF'   21 27CF'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  05B2'   C3 26D8'              	JMP	EXERR
  05B5'                         UNDBEL:
  05B5'   0E 07                 	MVI	C,BEL
  05B7'   CD 0000*              	CALL	BCONOU
  05BA'   C3 0820'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  05BD'                         DOTGET:
  05BD'   3A 2E4E'              	LDA	DOTIX
  05C0'   5F                    	MOV	E,A
  05C1'   3A 2E4D'              	LDA	DOTLEN
  05C4'   BB                    	CMP	E
  05C5'   CA 05D1'              	JZ	DOTGEF
  05C8'   16 00                 	MVI	D,0
  05CA'   21 0000*              	LXI	H,DOTBUF
  05CD'   19                    	DAD	D
  05CE'   7E                    	MOV	A,M
  05CF'   B7                    	ORA	A		; CY clear: a key was returned
  05D0'   C9                    	RET
  05D1'                         DOTGEF:
  05D1'   37                    	STC
  05D2'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
  05D3'                         GOSET:
  05D3'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  05D6'                         SETGL:
  05D6'   CD 12D2'              	CALL	ZSAVE
  05D9'   21 0000               	LXI	H,0
  05DC'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  05DF'   E5                    	PUSH	H
  05E0'   CD 12E5'              	CALL	ZREST
  05E3'   E1                    	POP	H
  05E4'   E5                    	PUSH	H
  05E5'   CD 0744'              	CALL	GBSUB		; HL = bytes to the cursor
  05E8'   44                    	MOV	B,H
  05E9'   4D                    	MOV	C,L
  05EA'   E1                    	POP	H		; HL = the line's start
  05EB'   11 0000               	LXI	D,0		; DE = screen column
  05EE'                         SG_LP:
  05EE'   78                    	MOV	A,B
  05EF'   B1                    	ORA	C
  05F0'   CA 0605'              	JZ	SG_CUR
  05F3'   7E                    	MOV	A,M
  05F4'   23                    	INX	H
  05F5'   0B                    	DCX	B
  05F6'   E5                    	PUSH	H
  05F7'   6B                    	MOV	L,E
  05F8'   CD 062A'              	CALL	CWID
  05FB'   E1                    	POP	H
  05FC'   83                    	ADD	E
  05FD'   5F                    	MOV	E,A
  05FE'   D2 05EE'              	JNC	SG_LP
  0601'   14                    	INR	D
  0602'   C3 05EE'              	JMP	SG_LP
  0605'                         SG_CUR:
  0605'   2A 0000*              	LHLD	TXTEND
  0608'   D5                    	PUSH	D
  0609'   EB                    	XCHG
  060A'   2A 0000*              	LHLD	GAPEND
  060D'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  0610'   D1                    	POP	D
  0611'   CA 0625'              	JZ	SG_SET
  0614'   7E                    	MOV	A,M
  0615'   FE 09                 	CPI	TAB
  0617'   C2 0625'              	JNZ	SG_SET
  061A'   6B                    	MOV	L,E
  061B'   CD 062A'              	CALL	CWID
  061E'   3D                    	DCR	A		; the TAB's last column
  061F'   83                    	ADD	E
  0620'   5F                    	MOV	E,A
  0621'   D2 0625'              	JNC	SG_SET
  0624'   14                    	INR	D
  0625'                         SG_SET:
  0625'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  0626'   22 2E27'              	SHLD	GOALCOL
  0629'   C9                    	RET
                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  062A'                         CWID:
  062A'   FE 0D                 	CPI	CR
  062C'   CA 063B'              	JZ	CW_0
  062F'   FE 09                 	CPI	TAB
  0631'   3E 01                 	MVI	A,1
  0633'   C0                    	RNZ
  0634'   7D                    	MOV	A,L
  0635'   E6 07                 	ANI	TABWID-1
  0637'   2F                    	CMA
  0638'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  063A'   C9                    	RET
  063B'                         CW_0:
  063B'   AF                    	XRA	A
  063C'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
                                ; The text is read where it lies, either side of the gap; keeps BC.
  063D'                         BOL:
  063D'   C5                    	PUSH	B
  063E'   E5                    	PUSH	H
  063F'   CD 0000*              	CALL	CUROFF
  0642'   D1                    	POP	D		; DE = off, HL = the bytes before the gap
  0643'   CD 0000*              	CALL	CMP16
  0646'   DA 0669'              	JC	BOL_B
  0649'   CA 0669'              	JZ	BOL_B
  064C'   D5                    	PUSH	D
  064D'   EB                    	XCHG
  064E'   CD 0000*              	CALL	SUBHD
  0651'   44                    	MOV	B,H
  0652'   4D                    	MOV	C,L		; BC = how far past the gap it is
  0653'   2A 0000*              	LHLD	GAPEND
  0656'   09                    	DAD	B
  0657'   D1                    	POP	D
  0658'                         BOL_A:
  0658'   78                    	MOV	A,B
  0659'   B1                    	ORA	C
  065A'   CA 0669'              	JZ	BOL_B		; back at the gap: the rest is before it
  065D'   2B                    	DCX	H
  065E'   7E                    	MOV	A,M
  065F'   FE 0A                 	CPI	LF
  0661'   CA 067D'              	JZ	BOL_X
  0664'   1B                    	DCX	D
  0665'   0B                    	DCX	B
  0666'   C3 0658'              	JMP	BOL_A
  0669'                         BOL_B:
  0669'   2A 0000*              	LHLD	TXTBEG
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  066C'   19                    	DAD	D
  066D'                         BOL_C:
  066D'   7A                    	MOV	A,D
  066E'   B3                    	ORA	E
  066F'   CA 067D'              	JZ	BOL_X		; at 0
  0672'   2B                    	DCX	H
  0673'   7E                    	MOV	A,M
  0674'   FE 0A                 	CPI	LF
  0676'   CA 067D'              	JZ	BOL_X
  0679'   1B                    	DCX	D
  067A'   C3 066D'              	JMP	BOL_C
  067D'                         BOL_X:
  067D'   EB                    	XCHG
  067E'   C1                    	POP	B
  067F'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
                                ; Read the same way; keeps BC.
  0680'                         EOLNL:
  0680'   C5                    	PUSH	B
  0681'   E5                    	PUSH	H
  0682'   CD 0000*              	CALL	CUROFF
  0685'   D1                    	POP	D		; DE = off, HL = the bytes before the gap
  0686'   CD 0000*              	CALL	CMP16
  0689'   D2 06A7'              	JNC	ENL_A
  068C'   2A 0000*              	LHLD	GAPBEG
  068F'   44                    	MOV	B,H
  0690'   4D                    	MOV	C,L
  0691'   2A 0000*              	LHLD	TXTBEG
  0694'   19                    	DAD	D
  0695'                         ENL_B:
  0695'   7D                    	MOV	A,L
  0696'   91                    	SUB	C
  0697'   7C                    	MOV	A,H
  0698'   98                    	SBB	B
  0699'   D2 06B5'              	JNC	ENL_G		; at the gap: on from its far side
  069C'   7E                    	MOV	A,M
  069D'   FE 0A                 	CPI	LF
  069F'   CA 06D1'              	JZ	ENL_X
  06A2'   23                    	INX	H
  06A3'   13                    	INX	D
  06A4'   C3 0695'              	JMP	ENL_B
  06A7'                         ENL_A:
  06A7'   D5                    	PUSH	D
  06A8'   EB                    	XCHG
  06A9'   CD 0000*              	CALL	SUBHD
  06AC'   EB                    	XCHG			; DE = how far past the gap it is
  06AD'   2A 0000*              	LHLD	GAPEND
  06B0'   19                    	DAD	D
  06B1'   D1                    	POP	D
  06B2'   C3 06B8'              	JMP	ENL_S
  06B5'                         ENL_G:
  06B5'   2A 0000*              	LHLD	GAPEND
  06B8'                         ENL_S:
  06B8'   E5                    	PUSH	H
  06B9'   2A 0000*              	LHLD	TXTEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06BC'   44                    	MOV	B,H
  06BD'   4D                    	MOV	C,L
  06BE'   E1                    	POP	H
  06BF'                         ENL_C:
  06BF'   7D                    	MOV	A,L
  06C0'   91                    	SUB	C
  06C1'   7C                    	MOV	A,H
  06C2'   98                    	SBB	B
  06C3'   D2 06D1'              	JNC	ENL_X		; the end of the text
  06C6'   7E                    	MOV	A,M
  06C7'   FE 0A                 	CPI	LF
  06C9'   CA 06D1'              	JZ	ENL_X
  06CC'   23                    	INX	H
  06CD'   13                    	INX	D
  06CE'   C3 06BF'              	JMP	ENL_C
  06D1'                         ENL_X:
  06D1'   EB                    	XCHG
  06D2'   C1                    	POP	B
  06D3'   C9                    	RET
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  06D4'                         NLSTART:
  06D4'   CD 0680'              	CALL	EOLNL
  06D7'   E5                    	PUSH	H
  06D8'   CD 0000*              	CALL	LOGLEN
  06DB'   D1                    	POP	D		; DE = eol result
  06DC'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  06DF'   C8                    	RZ			; no next line: HL = LOGLEN
  06E0'   EB                    	XCHG			; HL = eol
  06E1'   23                    	INX	H
  06E2'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  06E3'                         EOLC:
  06E3'   E5                    	PUSH	H
  06E4'   CD 0680'              	CALL	EOLNL
  06E7'   22 2E72'              	SHLD	WKTERM
  06EA'   E1                    	POP	H
  06EB'   CD 063D'              	CALL	BOL
  06EE'   22 2E74'              	SHLD	WKBOL
  06F1'   2A 2E72'              	LHLD	WKTERM
  06F4'   EB                    	XCHG			; DE = term
  06F5'   2A 2E74'              	LHLD	WKBOL
  06F8'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  06FB'   CA 071A'              	JZ	EOLC_MT
  06FE'   EB                    	XCHG			; HL = term
  06FF'   2B                    	DCX	H		; term-1
  0700'   E5                    	PUSH	H
  0701'   CD 0000*              	CALL	CHARAT
  0704'   E1                    	POP	H		; HL = term-1
  0705'   FE 0D                 	CPI	CR
  0707'   CA 070D'              	JZ	EOLC_CR		; content ends at term-1
  070A'   C3 070E'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  070D'                         EOLC_CR:
  070D'   2B                    	DCX	H		; last = (term-1) - 1
  070E'                         EOLC_LS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  070E'   EB                    	XCHG			; DE = last
  070F'   2A 2E74'              	LHLD	WKBOL
  0712'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  0715'   DA 071A'              	JC	EOLC_MT
  0718'   EB                    	XCHG			; HL = last
  0719'   C9                    	RET
  071A'                         EOLC_MT:
  071A'   2A 2E74'              	LHLD	WKBOL
  071D'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  071E'                         COL:
  071E'   E5                    	PUSH	H
  071F'   CD 063D'              	CALL	BOL
  0722'   D1                    	POP	D		; DE = off
  0723'   EB                    	XCHG			; HL = off, DE = bol
  0724'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  0727'                         ATENDQ:
  0727'   CD 0000*              	CALL	CUROFF
  072A'   E5                    	PUSH	H
  072B'   CD 0000*              	CALL	LOGLEN
  072E'   D1                    	POP	D		; DE = cur
  072F'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0732'                         CURCHR:
  0732'   CD 0000*              	CALL	CUROFF
  0735'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  0738'                         MOVCNT:
  0738'   CD 0820'              	CALL	SETMOV
  073B'   C3 074B'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  073E'                         CNTOFF:
  073E'   CD 074B'              	CALL	GETCNT
  0741'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  0744'                         GBSUB:
  0744'   EB                    	XCHG
  0745'   2A 0000*              	LHLD	GAPBEG
  0748'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  074B'                         GETCNT:
  074B'   2A 2E1C'              	LHLD	CMDCNT
  074E'   7C                    	MOV	A,H
  074F'   B5                    	ORA	L
  0750'   C2 0757'              	JNZ	GC_HAVE
  0753'   21 0001               	LXI	H,1
  0756'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0757'                         GC_HAVE:
  0757'   E5                    	PUSH	H
  0758'   21 0000               	LXI	H,0
  075B'   22 2E1C'              	SHLD	CMDCNT
  075E'   E1                    	POP	H
  075F'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for an ESC break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  0760'                         CNTTST:				; WM 1175
  0760'   3A 2EDB'              	LDA	BRKARM
  0763'   B7                    	ORA	A
  0764'   C4 078E'              	CNZ	BRKTST		; an ESC spends the count: every loop stops here
  0767'   E5                    	PUSH	H
  0768'   2A 2E1C'              	LHLD	CMDCNT
  076B'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  076E'   B4                    	ORA	H
  076F'   B5                    	ORA	L
  0770'   E1                    	POP	H
  0771'   C3 0000*              	JMP	POLLBRK
                                
                                ;============================================================
                                ; ESC -- abandon a search or a long move.
                                ;
                                ; Every loop that pages asks CNTTST whether to go on, so that is where an ESC is
                                ; looked for: it zeroes the count, and the loop ends the way it ends when the
                                ; count runs out.  Nothing is half done, because the commands that can be
                                ; stopped change nothing -- BRKON arms the test only with no operator pending,
                                ; and only 'G' 'gg' the mark jumps and the searches call it.  A 'dd' count, a
                                ; ':s', a put or a write asks the same CNTTST and is never stopped.
                                ;
                                ; The command then goes back to where it started (BRKBAK), as a search that
                                ; found nothing does: the screen was not repainted, so it is already right.
                                ; Going back pages, and that is not stopped by a second ESC.
                                ;============================================================
                                
                                ;BRKON -- a command that may page a long way is starting: keep the place it
                                ; started from (the cursor's position in the file, and LNDLT for its row), and
                                ; arm the ESC test unless an operator is waiting for this motion.
  0774'                         BRKON:
  0774'   21 2ED6'              	LXI	H,SOFF
  0777'   CD 0429'              	CALL	FPSTO
  077A'   2A 0000*              	LHLD	LNDLT
  077D'   22 2ED9'              	SHLD	SLDLT
  0780'   AF                    	XRA	A
  0781'   32 2EDC'              	STA	BRKHIT
  0784'   3A 2E54'              	LDA	PSAVE
  0787'   B7                    	ORA	A
  0788'   C0                    	RNZ			; 'dG' changes text: it runs to its end
  0789'   3C                    	INR	A
  078A'   32 2EDB'              	STA	BRKARM
  078D'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                                
                                ;BRKTST -- CNTTST's question while armed.  Keeps BC, DE, HL.  The ESC is
                                ; answered on the bottom row at once: the way back pages, and that can take
                                ; as long again as the command had run, with nothing else to show for it.
                                ; BRKBAK's 'Interrupted' replaces it when the cursor is back.
  078E'                         BRKTST:
  078E'   C5                    	PUSH	B
  078F'   D5                    	PUSH	D
  0790'   E5                    	PUSH	H
  0791'   CD 0000*              	CALL	KBBRK
  0794'   CA 07AD'              	JZ	BT_NO
  0797'   32 2EDC'              	STA	BRKHIT		; (A = FFH)
  079A'   21 2782'              	LXI	H,SINTG
  079D'   CD 0000*              	CALL	EXMSG
  07A0'   AF                    	XRA	A
  07A1'   32 2EDB'              	STA	BRKARM		; the way back is not stopped in its turn
  07A4'   32 0000*              	STA	AUXCNT
  07A7'   21 0000               	LXI	H,0
  07AA'   22 2E1C'              	SHLD	CMDCNT
  07AD'                         BT_NO:
  07AD'   E1                    	POP	H
  07AE'   D1                    	POP	D
  07AF'   C1                    	POP	B
  07B0'   C9                    	RET
                                
                                ;BRKOFF -- the move is over: disarm.  NOTE: falls into BRKQ.
  07B1'                         BRKOFF:
  07B1'   AF                    	XRA	A
  07B2'   32 2EDB'              	STA	BRKARM
                                ;BRKQ -- CY iff an ESC stopped it.
  07B5'                         BRKQ:
  07B5'   3A 2EDC'              	LDA	BRKHIT
  07B8'   B7                    	ORA	A
  07B9'   C8                    	RZ
  07BA'   37                    	STC
  07BB'   C9                    	RET
                                
                                ;RSTPL -- back to the place BRKON kept, on the row it was on.
  07BC'                         RSTPL:
  07BC'   21 2ED6'              	LXI	H,SOFF
  07BF'   CD 03D0'              	CALL	BACKTO
  07C2'   2A 2ED9'              	LHLD	SLDLT
  07C5'   22 0000*              	SHLD	LNDLT
  07C8'   C9                    	RET
                                
                                ;BRKBAK -- stopped: back to the start, drop whatever was typed meanwhile (it
                                ; was meant for a result that is not coming), and say so.  CY, as EXERR.
  07C9'                         BRKBAK:
  07C9'   CD 07BC'              	CALL	RSTPL
  07CC'   CD 0000*              	CALL	KBFLSH
  07CF'   21 2776'              	LXI	H,SINTR
  07D2'   C3 26D8'              	JMP	EXERR
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  07D5'                         CLASSF:
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07D5'   47                    	MOV	B,A
  07D6'   FE 20                 	CPI	' '
  07D8'   CA 0818'              	JZ	CLS0
  07DB'   FE 09                 	CPI	TAB
  07DD'   CA 0818'              	JZ	CLS0
  07E0'   FE 0A                 	CPI	LF
  07E2'   CA 0818'              	JZ	CLS0
  07E5'   FE 0D                 	CPI	CR
  07E7'   CA 0818'              	JZ	CLS0
  07EA'   3A 2E29'              	LDA	WBIG
  07ED'   B7                    	ORA	A
  07EE'   C2 081A'              	JNZ	CLS1
  07F1'   78                    	MOV	A,B
  07F2'   FE 5F                 	CPI	'_'
  07F4'   CA 081A'              	JZ	CLS1
  07F7'   FE 30                 	CPI	'0'
  07F9'   DA 081D'              	JC	CLS2
  07FC'   FE 3A                 	CPI	'9'+1
  07FE'   DA 081A'              	JC	CLS1
  0801'   FE 41                 	CPI	'A'
  0803'   DA 081D'              	JC	CLS2
  0806'   FE 5B                 	CPI	'Z'+1
  0808'   DA 081A'              	JC	CLS1
  080B'   FE 61                 	CPI	'a'
  080D'   DA 081D'              	JC	CLS2
  0810'   FE 7B                 	CPI	'z'+1
  0812'   DA 081A'              	JC	CLS1
  0815'   C3 081D'              	JMP	CLS2
  0818'   AF                    CLS0:	XRA	A
  0819'   C9                    	RET
  081A'   3E 01                 CLS1:	MVI	A,1
  081C'   C9                    	RET
  081D'   3E 02                 CLS2:	MVI	A,2
  081F'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  0820'                         SETMOV:
  0820'   3E 01                 	MVI	A,R_MOVE
  0822'   32 2E20'              	STA	RINTENT
  0825'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  0826'                         SETLIN:
  0826'   3E 02                 	MVI	A,R_LINE
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  0828'   32 2E20'              	STA	RINTENT
  082B'   C9                    	RET
                                
                                ;SETCEL -- one cell of the cursor's row was written over and nothing else
                                ; changed: the char alone is the paint (R_ICH with no cell opened), provided
                                ; the char that was there (A) and the one that is (VRCH) are each one cell
                                ; wide.  B = ICHAPP's value: 1 the cursor went past the char, 2 it is on it.
  082C'                         SETCEL:
  082C'   CD 0841'              	CALL	PLAINQ
  082F'   D0                    	RNC
  0830'   3A 2E77'              	LDA	VRCH
  0833'   CD 0841'              	CALL	PLAINQ
  0836'   D0                    	RNC
  0837'   78                    	MOV	A,B
  0838'   32 2E22'              	STA	ICHAPP
  083B'   3E 04                 	MVI	A,R_ICH
  083D'   32 2E20'              	STA	RINTENT
  0840'   C9                    	RET
                                
                                ;PLAINQ -- CY iff the char in A takes one cell: printable ASCII.  Keeps all
                                ; but the flags.
  0841'                         PLAINQ:
  0841'   FE 20                 	CPI	' '
  0843'   3F                    	CMC
  0844'   D0                    	RNC
  0845'   FE 7F                 	CPI	DEL
  0847'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  0848'                         SETILN:
  0848'   3E 01                 	MVI	A,1
  084A'   32 2E21'              	STA	ILN		; one line, unless a put overwrites it below
  084D'   3E 05                 	MVI	A,R_ILIN
  084F'   32 2E20'              	STA	RINTENT
  0852'   AF                    	XRA	A
  0853'   32 2E26'              	STA	ILABOV		; the row above the opened ones is untouched
  0856'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  0857'                         SETJON:
  0857'   3E 06                 	MVI	A,R_JOIN
  0859'   32 2E20'              	STA	RINTENT
  085C'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  085D'                         SETFUL:
  085D'   3E 00                 	MVI	A,R_FULL
  085F'   32 2E20'              	STA	RINTENT
  0862'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB (or any control char) occurs from the cursor to the
                                ; end of its line, else 0; TTI = its offset when there is one.
                                ; The tail is read where it lies, after the gap.  Keeps BC.
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  0863'                         TAILTAB:
  0863'   C5                    	PUSH	B
  0864'   CD 0000*              	CALL	CUROFF
  0867'   E5                    	PUSH	H
  0868'   2A 0000*              	LHLD	TXTEND
  086B'   44                    	MOV	B,H
  086C'   4D                    	MOV	C,L
  086D'   2A 0000*              	LHLD	GAPEND
  0870'   D1                    	POP	D		; DE = the offset of the byte at HL
  0871'                         TT_LP:
  0871'   7D                    	MOV	A,L
  0872'   91                    	SUB	C
  0873'   7C                    	MOV	A,H
  0874'   98                    	SBB	B
  0875'   D2 0895'              	JNC	TT_NO		; reached end of text -> no tab
  0878'   7E                    	MOV	A,M
  0879'   FE 0A                 	CPI	LF
  087B'   CA 0895'              	JZ	TT_NO		; end of line -> no tab
  087E'   FE 0D                 	CPI	CR
  0880'   CA 0888'              	JZ	TT_NX		; (the line end's own)
  0883'   FE 20                 	CPI	' '
  0885'   DA 088D'              	JC	TT_YES
  0888'                         TT_NX:
  0888'   23                    	INX	H
  0889'   13                    	INX	D
  088A'   C3 0871'              	JMP	TT_LP
  088D'                         TT_YES:
  088D'   EB                    	XCHG
  088E'   22 2E6E'              	SHLD	TTI
  0891'   C1                    	POP	B
  0892'   3E 01                 	MVI	A,1
  0894'   C9                    	RET
  0895'                         TT_NO:
  0895'   C1                    	POP	B
  0896'   AF                    	XRA	A
  0897'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  0898'                         VC_H:
  0898'   CD 0738'              	CALL	MOVCNT		; a cursor motion, and its count
  089B'   22 2E6C'              	SHLD	CNTV
  089E'                         VCH_LP:
  089E'   2A 2E6C'              	LHLD	CNTV
  08A1'   7C                    	MOV	A,H
  08A2'   B5                    	ORA	L
  08A3'   C8                    	RZ
  08A4'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  08A5'   22 2E6C'              	SHLD	CNTV
  08A8'   CD 08AE'              	CALL	HSTEP
  08AB'   C3 089E'              	JMP	VCH_LP
  08AE'                         HSTEP:
  08AE'   CD 0000*              	CALL	CUROFF		; HL = cur
  08B1'   7C                    	MOV	A,H
  08B2'   B5                    	ORA	L
  08B3'   C8                    	RZ			; at 0
  08B4'   E5                    	PUSH	H
  08B5'   CD 063D'              	CALL	BOL		; HL = bol
  08B8'   D1                    	POP	D		; DE = cur
  08B9'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  08BC'   C8                    	RZ			; at BOL, cannot go left
  08BD'   EB                    	XCHG			; HL = cur
  08BE'   2B                    	DCX	H
  08BF'   C3 05D3'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  08C2'                         VC_L:
  08C2'   CD 0738'              	CALL	MOVCNT		; a cursor motion, and its count
  08C5'   22 2E6C'              	SHLD	CNTV
  08C8'                         VCL_LP:
  08C8'   2A 2E6C'              	LHLD	CNTV
  08CB'   7C                    	MOV	A,H
  08CC'   B5                    	ORA	L
  08CD'   C8                    	RZ
  08CE'   2B                    	DCX	H
  08CF'   22 2E6C'              	SHLD	CNTV
  08D2'   CD 08D8'              	CALL	LSTEP
  08D5'   C3 08C8'              	JMP	VCL_LP
  08D8'                         LSTEP:
  08D8'   CD 0000*              	CALL	CUROFF		; HL = cur
  08DB'   E5                    	PUSH	H
  08DC'   CD 06E3'              	CALL	EOLC		; HL = eolc
  08DF'   D1                    	POP	D		; DE = cur
  08E0'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  08E3'   D2 08EB'              	JNC	LS_NO		; cur >= eolc, cannot go right
  08E6'   EB                    	XCHG			; HL = cur
  08E7'   23                    	INX	H
  08E8'   C3 05D3'              	JMP	GOSET
  08EB'                         LS_NO:				; on the line's last char.  An operator waiting on
  08EB'   CD 0CB7'              	CALL	EMPTY		;   this 'l' takes that char too (vim makes the
  08EE'   C8                    	RZ			;   motion inclusive when it falls short), which
  08EF'   3E 01                 	MVI	A,1		;   is what WPULL tells OPA_EX: 'dl' there is 'x',
  08F1'   32 2E2A'              	STA	WPULL		;   and 'd3l' two from the end takes both.  An
  08F4'   C9                    	RET			;   empty line has no char to take
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  08F5'                         VC_0:
  08F5'   CD 0738'              	CALL	MOVCNT		; a cursor motion, and its count
  08F8'   CD 0902'              	CALL	LNSTRT
  08FB'   21 0000               	LXI	H,0
  08FE'   22 2E27'              	SHLD	GOALCOL
  0901'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  0902'                         LNSTRT:
  0902'   CD 12D2'              	CALL	ZSAVE
  0905'   21 0000               	LXI	H,0
  0908'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  090B'   E5                    	PUSH	H
  090C'   CD 12E5'              	CALL	ZREST
  090F'   E1                    	POP	H
  0910'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  0913'                         VC_CRT:
  0913'   CD 0738'              	CALL	MOVCNT		; a cursor motion, and its count
  0916'   C3 0919'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  0919'                         FNBLNK:
  0919'   CD 0902'              	CALL	LNSTRT
  091C'   CD 0000*              	CALL	RGET0
  091F'   11 0000               	LXI	D,0		; DE = blanks skipped
  0922'                         FN_LP:
  0922'   CD 0000*              	CALL	RDGET
  0925'   DA 0948'              	JC	FN_GO		; the end of the file
  0928'   FE 20                 	CPI	' '
  092A'   CA 0932'              	JZ	FN_WH
  092D'   FE 09                 	CPI	TAB
  092F'   C2 0948'              	JNZ	FN_GO		; a non-blank, or the line's end
  0932'                         FN_WH:
  0932'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  0935'   DA 0948'              	JC	FN_GO
  0938'   FE 0D                 	CPI	CR
  093A'   CA 0948'              	JZ	FN_GO
  093D'   FE 0A                 	CPI	LF
  093F'   CA 0948'              	JZ	FN_GO
  0942'   2B                    	DCX	H		; not yet: read that char again
  0943'   03                    	INX	B
  0944'   13                    	INX	D
  0945'   C3 0922'              	JMP	FN_LP
  0948'                         FN_GO:
  0948'   D5                    	PUSH	D
  0949'   CD 0000*              	CALL	CUROFF
  094C'   D1                    	POP	D
  094D'   19                    	DAD	D
  094E'   C3 05D3'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  0951'                         VC_EOL:
  0951'   CD 0820'              	CALL	SETMOV
  0954'   21 FFFF               	LXI	H,0FFFFH
  0957'   22 2E27'              	SHLD	GOALCOL
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  095A'   CD 074B'              	CALL	GETCNT
  095D'   2B                    	DCX	H		; count-1
  095E'   7C                    	MOV	A,H
  095F'   B5                    	ORA	L
  0960'   CA 096F'              	JZ	VEOL_0
  0963'   E5                    	PUSH	H
  0964'   CD 0984'              	CALL	ONLAST
  0967'   E1                    	POP	H
  0968'   D8                    	RC			; the last line: no move (vim)
  0969'   CD 09D4'              	CALL	JCORE
  096C'   C3 0B23'              	JMP	JKLAND
  096F'                         VEOL_0:
  096F'   CD 0902'              	CALL	LNSTRT
  0972'   C3 0B23'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  0975'                         VC_CR:
  0975'   CD 0738'              	CALL	MOVCNT		; a cursor motion, and its count
  0978'   E5                    	PUSH	H
  0979'   CD 0984'              	CALL	ONLAST
  097C'   E1                    	POP	H
  097D'   D8                    	RC
  097E'   CD 09D4'              	CALL	JCORE
  0981'   C3 0919'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  0984'                         ONLAST:
  0984'   CD 0000*              	CALL	RGET0
  0987'                         OL_LP:
  0987'   CD 0000*              	CALL	RDGET
  098A'   D8                    	RC			; the file ends on this line
  098B'   FE 0A                 	CPI	LF
  098D'   C2 0987'              	JNZ	OL_LP
  0990'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  0993'                         VC_J:
  0993'   CD 0820'              	CALL	SETMOV
  0996'   CD 09BE'              	CALL	GLCHK		; the goal column, from the cursor if stale
  0999'   CD 074B'              	CALL	GETCNT		; HL = count
  099C'   CD 09D4'              	CALL	JCORE
  099F'   CD 09B7'              	CALL	JKDRP
  09A2'   C3 0B23'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  09A5'                         VC_K:
  09A5'   CD 0820'              	CALL	SETMOV
  09A8'   CD 09BE'              	CALL	GLCHK
  09AB'   CD 074B'              	CALL	GETCNT
  09AE'   CD 0A71'              	CALL	KCORE
  09B1'   CD 09B7'              	CALL	JKDRP
  09B4'   C3 0B23'              	JMP	JKLAND
                                
                                ;JKDRP -- DE = the lines JCORE / KCORE moved.  None -- 'j' on the last line,
                                ; 'k' on the first -- and the motion has failed: an operator waiting on it is
                                ; dropped, as vim drops it, where a line span that starts and ends on one line
                                ; would take that line ('dj' on the last line deleted it).  A count that runs
                                ; out of lines short has still moved, and its operator stands.  It is asked
                                ; here and not in the cores: 'dH' on the top row moves no lines either, and
                                ; takes its line.
  09B7'                         JKDRP:
  09B7'   7A                    	MOV	A,D
  09B8'   B3                    	ORA	E
  09B9'   C0                    	RNZ
  09BA'   32 2E54'              	STA	PSAVE
  09BD'   C9                    	RET
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  09BE'                         GLCHK:
  09BE'   2A 2E27'              	LHLD	GOALCOL
  09C1'   7C                    	MOV	A,H
  09C2'   3C                    	INR	A
  09C3'   C0                    	RNZ
  09C4'   7D                    	MOV	A,L
  09C5'   FE FE                 	CPI	0FEH
  09C7'   C0                    	RNZ
  09C8'   C3 05D6'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  09CB'                         GLSTAL:
  09CB'   E5                    	PUSH	H
  09CC'   21 FFFE               	LXI	H,0FFFEH
  09CF'   22 2E27'              	SHLD	GOALCOL
  09D2'   E1                    	POP	H
  09D3'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  09D4'                         JCORE:
  09D4'   7C                    	MOV	A,H
  09D5'   B5                    	ORA	L
  09D6'   C8                    	RZ
  09D7'   22 2E38'              	SHLD	JKCNT
  09DA'   CD 0DE6'              	CALL	CURRW		; limit = lines under the cursor's + NEDIT + 2:
  09DD'   47                    	MOV	B,A		;   enough for LYFAR to know it for far off
  09DE'   3A 0000*              	LDA	NEDIT
  09E1'   3C                    	INR	A
  09E2'   90                    	SUB	B
  09E3'   5F                    	MOV	E,A
  09E4'   16 00                 	MVI	D,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  09E6'   3A 0000*              	LDA	NEDIT
  09E9'   6F                    	MOV	L,A
  09EA'   26 00                 	MVI	H,0
  09EC'   19                    	DAD	D
  09ED'   EB                    	XCHG			; DE = limit
  09EE'   2A 2E38'              	LHLD	JKCNT
  09F1'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  09F4'   D2 09F8'              	JNC	JC_N
  09F7'   EB                    	XCHG			; HL = limit
  09F8'                         JC_N:
  09F8'   22 2E3A'              	SHLD	JKN		; N = min(count, limit)
  09FB'   EB                    	XCHG			; DE = LFs to find
  09FC'   CD 0000*              	CALL	RGET0
  09FF'                         JC_SC:
  09FF'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0A02'   DA 0A21'              	JC	JC_EOF
  0A05'   32 2E41'              	STA	JKLST
  0A08'   FE 0A                 	CPI	LF
  0A0A'   C2 09FF'              	JNZ	JC_SC
  0A0D'   1B                    	DCX	D
  0A0E'   7A                    	MOV	A,D
  0A0F'   B3                    	ORA	E
  0A10'   C2 09FF'              	JNZ	JC_SC
  0A13'   2A 2E38'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  0A16'   22 2E3C'              	SHLD	JKMOV		;   one if the last LF found ends the file
  0A19'   3E 01                 	MVI	A,1
  0A1B'   32 2E40'              	STA	JKPHN
  0A1E'   C3 0A3C'              	JMP	JC_MV
  0A21'                         JC_EOF:
  0A21'   2A 2E3A'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  0A24'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  0A27'   7C                    	MOV	A,H
  0A28'   B5                    	ORA	L
  0A29'   CA 0A35'              	JZ	JC_AV
  0A2C'   3A 2E41'              	LDA	JKLST
  0A2F'   FE 0A                 	CPI	LF
  0A31'   C2 0A35'              	JNZ	JC_AV
  0A34'   2B                    	DCX	H
  0A35'                         JC_AV:
  0A35'   22 2E3C'              	SHLD	JKMOV
  0A38'   AF                    	XRA	A
  0A39'   32 2E40'              	STA	JKPHN
  0A3C'                         JC_MV:
  0A3C'   2A 2E38'              	LHLD	JKCNT
  0A3F'   AF                    	XRA	A
  0A40'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  0A43'   CD 0B02'              	CALL	ATEOF
  0A46'   D2 0A5A'              	JNC	JC_DN
  0A49'   CD 0B08'              	CALL	LASTLN		; ran past the last line: back onto it
  0A4C'   3A 2E40'              	LDA	JKPHN
  0A4F'   B7                    	ORA	A
  0A50'   CA 0A5A'              	JZ	JC_DN
  0A53'   2A 2E3C'              	LHLD	JKMOV
  0A56'   2B                    	DCX	H
  0A57'   22 2E3C'              	SHLD	JKMOV
  0A5A'                         JC_DN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0A5A'   2A 2E3A'              	LHLD	JKN		; LNDLT += min(moved, N)
  0A5D'   EB                    	XCHG
  0A5E'   2A 2E3C'              	LHLD	JKMOV
  0A61'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  0A64'   D2 0A68'              	JNC	JC_AD
  0A67'   EB                    	XCHG
  0A68'                         JC_AD:
  0A68'   EB                    	XCHG			; DE = lines moved
  0A69'   2A 0000*              	LHLD	LNDLT
  0A6C'   19                    	DAD	D
  0A6D'   22 0000*              	SHLD	LNDLT
  0A70'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  0A71'                         KCORE:
  0A71'   7C                    	MOV	A,H
  0A72'   B5                    	ORA	L
  0A73'   C8                    	RZ
  0A74'   22 2E38'              	SHLD	JKCNT
  0A77'   CD 0DE6'              	CALL	CURRW		; limit = row + NEDIT
  0A7A'   5F                    	MOV	E,A
  0A7B'   16 00                 	MVI	D,0
  0A7D'   3A 0000*              	LDA	NEDIT
  0A80'   6F                    	MOV	L,A
  0A81'   26 00                 	MVI	H,0
  0A83'   19                    	DAD	D
  0A84'   EB                    	XCHG			; DE = limit
  0A85'   2A 2E38'              	LHLD	JKCNT
  0A88'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0A8B'   D2 0A8F'              	JNC	KC_N
  0A8E'   EB                    	XCHG			; HL = limit
  0A8F'                         KC_N:
  0A8F'   22 2E3A'              	SHLD	JKN		; N = min(count, limit)
  0A92'   EB                    	XCHG			; DE = LFs to find
  0A93'   21 0000               	LXI	H,0
  0A96'   22 2E3E'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  0A99'                         KC_ED:
  0A99'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0A9A'   2A 2E3E'              	LHLD	JKBK
  0A9D'   CD 0744'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0AA0'   E5                    	PUSH	H
  0AA1'   EB                    	XCHG
  0AA2'   2A 0000*              	LHLD	TXTBEG
  0AA5'   EB                    	XCHG
  0AA6'   CD 0000*              	CALL	SUBHD
  0AA9'   44                    	MOV	B,H
  0AAA'   4D                    	MOV	C,L
  0AAB'   E1                    	POP	H
  0AAC'   D1                    	POP	D
  0AAD'                         KC_SC:
  0AAD'   78                    	MOV	A,B
  0AAE'   B1                    	ORA	C
  0AAF'   CA 0AC6'              	JZ	KC_TB
  0AB2'   2B                    	DCX	H
  0AB3'   0B                    	DCX	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0AB4'   7E                    	MOV	A,M
  0AB5'   FE 0A                 	CPI	LF
  0AB7'   C2 0AAD'              	JNZ	KC_SC
  0ABA'   1B                    	DCX	D
  0ABB'   7A                    	MOV	A,D
  0ABC'   B3                    	ORA	E
  0ABD'   C2 0AAD'              	JNZ	KC_SC
  0AC0'   2A 2E38'              	LHLD	JKCNT		; N lines above: the move is count lines
  0AC3'   C3 0AE6'              	JMP	KC_MV
  0AC6'                         KC_TB:
  0AC6'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0AC7'   CD 0744'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0ACA'   22 2E3E'              	SHLD	JKBK
  0ACD'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0AD0'   7C                    	MOV	A,H
  0AD1'   B5                    	ORA	L
  0AD2'   CA 0ADF'              	JZ	KC_B0
  0AD5'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  0AD8'   D1                    	POP	D
  0AD9'   DA 0AE0'              	JC	KC_BOF
  0ADC'   C3 0A99'              	JMP	KC_ED
  0ADF'                         KC_B0:
  0ADF'   D1                    	POP	D
  0AE0'                         KC_BOF:
  0AE0'   2A 2E3A'              	LHLD	JKN		; moved = LFs found
  0AE3'   CD 0000*              	CALL	SUBHD
  0AE6'                         KC_MV:
  0AE6'   E5                    	PUSH	H
  0AE7'   2A 2E38'              	LHLD	JKCNT
  0AEA'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0AED'   D1                    	POP	D		; DE = moved
  0AEE'   2A 2E3A'              	LHLD	JKN
  0AF1'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0AF4'   DA 0AF8'              	JC	KC_AD
  0AF7'   EB                    	XCHG			; DE = N
  0AF8'                         KC_AD:
  0AF8'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0AFB'   CD 0000*              	CALL	SUBHD
  0AFE'   22 0000*              	SHLD	LNDLT
  0B01'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0B02'                         ATEOF:
  0B02'   CD 0000*              	CALL	RGET0
  0B05'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0B08'                         LASTLN:
  0B08'   2A 0000*              	LHLD	GAPBEG
  0B0B'   EB                    	XCHG
  0B0C'   2A 0000*              	LHLD	TXTBEG
  0B0F'   CD 0000*              	CALL	CMP16
  0B12'   21 0000               	LXI	H,0
  0B15'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0B18'   1B                    	DCX	D
  0B19'   1A                    	LDAX	D
  0B1A'   FE 0A                 	CPI	LF
  0B1C'   C2 0000*              	JNZ	SETBWD
  0B1F'   23                    	INX	H
  0B20'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0B23'                         JKLAND:
  0B23'   21 0000               	LXI	H,0
  0B26'   22 2E42'              	SHLD	JKVC		; screen column
  0B29'   2B                    	DCX	H
  0B2A'   22 2E44'              	SHLD	JKLS		; last content char: none yet
  0B2D'   CD 0000*              	CALL	RGET0
  0B30'   11 0000               	LXI	D,0		; DE = chars read
  0B33'                         JL_RD:
  0B33'   CD 0000*              	CALL	RDGET
  0B36'   DA 0B70'              	JC	JL_END
  0B39'   FE 0A                 	CPI	LF
  0B3B'   CA 0B70'              	JZ	JL_END
  0B3E'   E5                    	PUSH	H
  0B3F'   C5                    	PUSH	B
  0B40'   2A 2E42'              	LHLD	JKVC
  0B43'   CD 062A'              	CALL	CWID
  0B46'   B7                    	ORA	A
  0B47'   CA 0B6A'              	JZ	JL_NX		; a CR
  0B4A'   EB                    	XCHG
  0B4B'   22 2E44'              	SHLD	JKLS		; the last content char so far
  0B4E'   EB                    	XCHG
  0B4F'   4F                    	MOV	C,A
  0B50'   06 00                 	MVI	B,0
  0B52'   09                    	DAD	B		; HL = the column after this char
  0B53'   22 2E42'              	SHLD	JKVC
  0B56'   D5                    	PUSH	D
  0B57'   EB                    	XCHG
  0B58'   2A 2E27'              	LHLD	GOALCOL
  0B5B'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0B5E'   D1                    	POP	D
  0B5F'   DA 0B6A'              	JC	JL_NX
  0B62'   CA 0B6A'              	JZ	JL_NX
  0B65'   C1                    	POP	B		; this char holds the goal column
  0B66'   E1                    	POP	H
  0B67'   C3 0B7B'              	JMP	JL_GO
  0B6A'                         JL_NX:
  0B6A'   C1                    	POP	B
  0B6B'   E1                    	POP	H
  0B6C'   13                    	INX	D
  0B6D'   C3 0B33'              	JMP	JL_RD
  0B70'                         JL_END:
  0B70'   2A 2E44'              	LHLD	JKLS		; past the line's end: its last content char
  0B73'   7C                    	MOV	A,H
  0B74'   A5                    	ANA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0B75'   3C                    	INR	A
  0B76'   C2 0B7A'              	JNZ	JL_LS
  0B79'   23                    	INX	H		; no content: the line's start
  0B7A'                         JL_LS:
  0B7A'   EB                    	XCHG
  0B7B'                         JL_GO:
  0B7B'   D5                    	PUSH	D		; DE = step from the line start
  0B7C'   CD 0000*              	CALL	CUROFF
  0B7F'   D1                    	POP	D
  0B80'   19                    	DAD	D
  0B81'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0B84'   AF                    VC_W:	XRA	A
  0B85'   32 2E29'              	STA	WBIG
  0B88'   C3 0B90'              	JMP	WDO
  0B8B'   3E 01                 VCBGW:	MVI	A,1
  0B8D'   32 2E29'              	STA	WBIG
  0B90'   CD 0820'              WDO:	CALL	SETMOV
  0B93'   AF                    	XRA	A
  0B94'   32 2E2A'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0B97'   CD 074B'              	CALL	GETCNT
  0B9A'   22 2E6C'              	SHLD	CNTV
  0B9D'   2A 2E6C'              WDO_LP: LHLD	CNTV
  0BA0'   7C                    	MOV	A,H
  0BA1'   B5                    	ORA	L
  0BA2'   CA 0BAF'              	JZ	WDO_DN
  0BA5'   2B                    	DCX	H
  0BA6'   22 2E6C'              	SHLD	CNTV
  0BA9'   CD 0C0C'              	CALL	FWD1
  0BAC'   D2 0B9D'              	JNC	WDO_LP
  0BAF'                         WDO_DN:
  0BAF'   CD 0B02'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0BB2'   DA 0BBF'              	JC	WDO_NL
  0BB5'   FE 0D                 	CPI	CR
  0BB7'   CA 0BBF'              	JZ	WDO_NL
  0BBA'   FE 0A                 	CPI	LF
  0BBC'   C2 05D6'              	JNZ	SETGL
  0BBF'                         WDO_NL:
  0BBF'   CD 0000*              	CALL	PEEKL
  0BC2'   DA 05D6'              	JC	SETGL
  0BC5'   FE 0A                 	CPI	LF
  0BC7'   CA 05D6'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0BCA'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0BCC'   32 2E2A'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0BCF'   CD 0D2B'              	CALL	DECC		; back onto its last char
  0BD2'   C3 05D6'              	JMP	SETGL
                                
  0BD5'   AF                    VC_B:	XRA	A
  0BD6'   32 2E29'              	STA	WBIG
  0BD9'   C3 0BE1'              	JMP	BDO
  0BDC'   3E 01                 VCBGB:	MVI	A,1
  0BDE'   32 2E29'              	STA	WBIG
  0BE1'   CD 0820'              BDO:	CALL	SETMOV
  0BE4'   CD 074B'              	CALL	GETCNT
  0BE7'   22 2E6C'              	SHLD	CNTV
  0BEA'   CD 0C7C'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0BED'   D2 0BFD'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0BF0'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0BF1'   32 2E54'              	STA	PSAVE		;   first char opened an insert).  A count that
  0BF4'   C3 05D6'              	JMP	SETGL		;   runs out at the start has still moved, and
  0BF7'                         BDO_LP:				;   its operator stands -- both as vim
  0BF7'   CD 0C7C'              	CALL	BCK1
  0BFA'   DA 05D6'              	JC	SETGL
  0BFD'   2A 2E6C'              BDO_NX: LHLD	CNTV
  0C00'   2B                    	DCX	H
  0C01'   22 2E6C'              	SHLD	CNTV
  0C04'   7C                    	MOV	A,H
  0C05'   B5                    	ORA	L
  0C06'   C2 0BF7'              	JNZ	BDO_LP
  0C09'   C3 05D6'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
                                ; words before the last run on freely -- 'd2w' there takes the line break and
                                ; the next line's first word as well.
  0C0C'                         FWD1:
  0C0C'   CD 0CAF'              	CALL	CCLS
  0C0F'   32 2E76'              	STA	WKCLS		; the starting class
  0C12'   CD 0CE9'              	CALL	INCC
  0C15'   B7                    	ORA	A
  0C16'   CA 0C2F'              	JZ	FW_WD
  0C19'   37                    	STC
  0C1A'   F8                    	RM			; -1: already at the end
  0C1B'   CD 0C67'              	CALL	WLAST
  0C1E'   C8                    	RZ
  0C1F'   FE 02                 	CPI	2
  0C21'   C2 0C2F'              	JNZ	FW_WD		; 1: a next line was reached
  0C24'   CD 0B02'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0C27'   D4 0CD0'              	CNC	NXLN
  0C2A'   D2 0C2F'              	JNC	FW_WD
  0C2D'   37                    	STC			; yes: failed
  0C2E'   C9                    	RET
  0C2F'                         FW_WD:
  0C2F'   3A 2E76'              	LDA	WKCLS		; go past the rest of this word
  0C32'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C33'   CA 0C4F'              	JZ	FW_WS
  0C36'                         FW_WLP:
  0C36'   CD 0CAF'              	CALL	CCLS
  0C39'   21 2E76'              	LXI	H,WKCLS
  0C3C'   BE                    	CMP	M
  0C3D'   C2 0C4F'              	JNZ	FW_WS
  0C40'   CD 0CE9'              	CALL	INCC
  0C43'   B7                    	ORA	A
  0C44'   F8                    	RM			; the end of the file (NC)
  0C45'   CA 0C36'              	JZ	FW_WLP
  0C48'   CD 0C67'              	CALL	WLAST
  0C4B'   C8                    	RZ
  0C4C'   C3 0C36'              	JMP	FW_WLP
  0C4F'                         FW_WS:
  0C4F'   CD 0CAF'              	CALL	CCLS		; then over blanks to the next word
  0C52'   B7                    	ORA	A
  0C53'   C0                    	RNZ
  0C54'   CD 0CB7'              	CALL	EMPTY
  0C57'   C8                    	RZ			; an empty line is a word
  0C58'   CD 0CE9'              	CALL	INCC
  0C5B'   B7                    	ORA	A
  0C5C'   F8                    	RM
  0C5D'   CA 0C4F'              	JZ	FW_WS
  0C60'   CD 0C67'              	CALL	WLAST
  0C63'   C8                    	RZ
  0C64'   C3 0C4F'              	JMP	FW_WS
                                
                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0C67'                         WLAST:
  0C67'   47                    	MOV	B,A
  0C68'   2A 2E6C'              	LHLD	CNTV
  0C6B'   7C                    	MOV	A,H
  0C6C'   B5                    	ORA	L
  0C6D'   C2 0C78'              	JNZ	WL_X		; words still owed
  0C70'   3A 2E54'              	LDA	PSAVE
  0C73'   B7                    	ORA	A
  0C74'   CA 0C7A'              	JZ	WL_NO		; a plain 'w'
  0C77'   AF                    	XRA	A
  0C78'   78                    WL_X:	MOV	A,B
  0C79'   C9                    	RET
  0C7A'   B0                    WL_NO:	ORA	B
  0C7B'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0C7C'                         BCK1:
  0C7C'   CD 0D2B'              	CALL	DECC
  0C7F'   B7                    	ORA	A
  0C80'   37                    	STC
  0C81'   F8                    	RM
  0C82'                         BK_WS:
  0C82'   CD 0CAF'              	CALL	CCLS		; back over blanks
  0C85'   B7                    	ORA	A
  0C86'   C2 0C96'              	JNZ	BK_WD
  0C89'   CD 0CB7'              	CALL	EMPTY
  0C8C'   C8                    	RZ			; an empty line is a word
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0C8D'   CD 0D2B'              	CALL	DECC
  0C90'   B7                    	ORA	A
  0C91'   F2 0C82'              	JP	BK_WS
  0C94'   AF                    	XRA	A		; the start of the file (NC)
  0C95'   C9                    	RET
  0C96'                         BK_WD:
  0C96'   32 2E76'              	STA	WKCLS		; back to the start of this word
  0C99'                         BK_WLP:
  0C99'   CD 0D2B'              	CALL	DECC
  0C9C'   B7                    	ORA	A
  0C9D'   FA 0CAD'              	JM	BK_OK		; the start of the file
  0CA0'   CD 0CAF'              	CALL	CCLS
  0CA3'   21 2E76'              	LXI	H,WKCLS
  0CA6'   BE                    	CMP	M
  0CA7'   CA 0C99'              	JZ	BK_WLP
  0CAA'   CD 0CE9'              	CALL	INCC		; overshot: forward one
  0CAD'                         BK_OK:
  0CAD'   AF                    	XRA	A
  0CAE'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0CAF'                         CCLS:
  0CAF'   CD 0B02'              	CALL	ATEOF
  0CB2'   D2 07D5'              	JNC	CLASSF
  0CB5'   AF                    	XRA	A
  0CB6'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0CB7'                         EMPTY:
  0CB7'   CD 0B02'              	CALL	ATEOF
  0CBA'   DA 0CC5'              	JC	EM_ST
  0CBD'   FE 0D                 	CPI	CR
  0CBF'   CA 0CC5'              	JZ	EM_ST
  0CC2'   FE 0A                 	CPI	LF
  0CC4'   C0                    	RNZ
  0CC5'                         EM_ST:
  0CC5'   CD 0000*              	CALL	PEEKL
  0CC8'   DA 0CCE'              	JC	EM_Y
  0CCB'   FE 0A                 	CPI	LF
  0CCD'   C9                    	RET
  0CCE'                         EM_Y:
  0CCE'   AF                    	XRA	A
  0CCF'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0CD0'                         NXLN:
  0CD0'   FE 0A                 	CPI	LF
  0CD2'   CA 0CE1'              	JZ	NX_LF
  0CD5'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0CD8'   D8                    	RC
  0CD9'   FE 0A                 	CPI	LF
  0CDB'   CA 0CE1'              	JZ	NX_LF
  0CDE'   2B                    	DCX	H		; a lone CR
  0CDF'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0CE0'   C9                    	RET
  0CE1'                         NX_LF:
  0CE1'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0CE4'   D8                    	RC
  0CE5'   2B                    	DCX	H
  0CE6'   3E 01                 	MVI	A,1
  0CE8'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0CE9'                         INCC:
  0CE9'   CD 0B02'              	CALL	ATEOF
  0CEC'   DA 0D27'              	JC	IC_END
  0CEF'   FE 0D                 	CPI	CR
  0CF1'   CA 0D12'              	JZ	IC_NL
  0CF4'   FE 0A                 	CPI	LF
  0CF6'   CA 0D12'              	JZ	IC_NL
  0CF9'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0CFC'                         IC_CH:
  0CFC'   CD 0B02'              	CALL	ATEOF
  0CFF'   DA 0D0E'              	JC	IC_2
  0D02'   FE 0D                 	CPI	CR
  0D04'   CA 0D0E'              	JZ	IC_2
  0D07'   FE 0A                 	CPI	LF
  0D09'   CA 0D0E'              	JZ	IC_2
  0D0C'   AF                    	XRA	A
  0D0D'   C9                    	RET
  0D0E'                         IC_2:
  0D0E'   3E 02                 	MVI	A,2
  0D10'   B7                    	ORA	A
  0D11'   C9                    	RET
  0D12'                         IC_NL:
  0D12'   CD 0CD0'              	CALL	NXLN
  0D15'   DA 0D27'              	JC	IC_END
  0D18'   F5                    	PUSH	PSW
  0D19'   CD 0000*              	CALL	PUTCUR
  0D1C'   F1                    	POP	PSW
  0D1D'   B7                    	ORA	A
  0D1E'   CA 0CFC'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0D21'   CD 0D4D'              	CALL	LNINC
  0D24'   3E 01                 	MVI	A,1
  0D26'   C9                    	RET
  0D27'                         IC_END:
  0D27'   3E FF                 	MVI	A,0FFH
  0D29'   B7                    	ORA	A
  0D2A'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0D2B'                         DECC:
  0D2B'   CD 0000*              	CALL	PEEKL
  0D2E'   DA 0D27'              	JC	IC_END
  0D31'   F5                    	PUSH	PSW
  0D32'   CD 0000*              	CALL	PUTCUR
  0D35'   F1                    	POP	PSW
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D36'   FE 0A                 	CPI	LF
  0D38'   3E 00                 	MVI	A,0
  0D3A'   C0                    	RNZ
  0D3B'   CD 0D5B'              	CALL	LNDEC
  0D3E'   CD 0000*              	CALL	PEEKL		; onto its CR
  0D41'   DA 0D49'              	JC	DC_1
  0D44'   FE 0D                 	CPI	CR
  0D46'   CC 0000*              	CZ	PUTCUR
  0D49'                         DC_1:
  0D49'   3E 01                 	MVI	A,1
  0D4B'   B7                    	ORA	A
  0D4C'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0D4D'                         LNINC:
  0D4D'   E5                    	PUSH	H
  0D4E'   2A 0000*              	LHLD	LNDLT
  0D51'   7C                    	MOV	A,H
  0D52'   FE 40                 	CPI	40H
  0D54'   CA 0D69'              	JZ	LN_X
  0D57'   23                    	INX	H
  0D58'   C3 0D66'              	JMP	LN_ST
  0D5B'                         LNDEC:
  0D5B'   E5                    	PUSH	H
  0D5C'   2A 0000*              	LHLD	LNDLT
  0D5F'   7C                    	MOV	A,H
  0D60'   FE C0                 	CPI	0C0H
  0D62'   CA 0D69'              	JZ	LN_X
  0D65'   2B                    	DCX	H
  0D66'                         LN_ST:
  0D66'   22 0000*              	SHLD	LNDLT
  0D69'                         LN_X:
  0D69'   E1                    	POP	H
  0D6A'   C9                    	RET
                                
  0D6B'   AF                    VC_E:	XRA	A
  0D6C'   32 2E29'              	STA	WBIG
  0D6F'   C3 0D77'              	JMP	EDO
  0D72'   3E 01                 VCBGE:	MVI	A,1
  0D74'   32 2E29'              	STA	WBIG
  0D77'   CD 0820'              EDO:	CALL	SETMOV
  0D7A'   CD 074B'              	CALL	GETCNT
  0D7D'   22 2E6C'              	SHLD	CNTV
  0D80'   2A 2E6C'              EDO_LP: LHLD	CNTV
  0D83'   7C                    	MOV	A,H
  0D84'   B5                    	ORA	L
  0D85'   CA 0BAF'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0D88'   2B                    	DCX	H
  0D89'   22 2E6C'              	SHLD	CNTV
  0D8C'   CD 0D9A'              	CALL	ESTEP
  0D8F'   21 2E57'              	LXI	H,CWEOL		; only the count's first word stays where it is
  0D92'   36 00                 	MVI	M,0
  0D94'   D2 0D80'              	JNC	EDO_LP
  0D97'   C3 0BAF'              	JMP	WDO_DN
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0D9A'                         ESTEP:
  0D9A'   CD 0CAF'              	CALL	CCLS
  0D9D'   32 2E76'              	STA	WKCLS		; the starting class
  0DA0'   CD 0CE9'              	CALL	INCC
  0DA3'   B7                    	ORA	A
  0DA4'   FA 0DCA'              	JM	ES_F
  0DA7'   CD 0CAF'              	CALL	CCLS
  0DAA'   B7                    	ORA	A
  0DAB'   CA 0DB5'              	JZ	ES_ST
  0DAE'   21 2E76'              	LXI	H,WKCLS
  0DB1'   BE                    	CMP	M
  0DB2'   CA 0DCC'              	JZ	ES_SK		; still in the word it started in: on to its end
  0DB5'                         ES_ST:
  0DB5'   3A 2E57'              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0DB8'   B7                    	ORA	A		;   that char is the word's end already, and
  0DB9'   C2 0DE3'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
  0DBC'                         ES_WS:
  0DBC'   CD 0CAF'              	CALL	CCLS		; over blanks, line ends and empty lines
  0DBF'   B7                    	ORA	A
  0DC0'   C2 0DCC'              	JNZ	ES_SK
  0DC3'   CD 0CE9'              	CALL	INCC
  0DC6'   B7                    	ORA	A
  0DC7'   F2 0DBC'              	JP	ES_WS
  0DCA'                         ES_F:
  0DCA'   37                    	STC
  0DCB'   C9                    	RET
  0DCC'                         ES_SK:
  0DCC'   CD 0CAF'              	CALL	CCLS		; past the rest of this word ...
  0DCF'   32 2E76'              	STA	WKCLS
  0DD2'                         ES_SL:
  0DD2'   CD 0CE9'              	CALL	INCC
  0DD5'   B7                    	ORA	A
  0DD6'   FA 0DCA'              	JM	ES_F
  0DD9'   CD 0CAF'              	CALL	CCLS
  0DDC'   21 2E76'              	LXI	H,WKCLS
  0DDF'   BE                    	CMP	M
  0DE0'   CA 0DD2'              	JZ	ES_SL
  0DE3'   C3 0D2B'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's place among the screen's LINES (CURRW) and the
                                ; last layout's facts from SCRN.MAC: SCBOT (the last line shown), SCEOF / SCBOF
                                ; (the file's end / start is on the screen).  H and L count lines.  M and the
                                ; scrolls count screen ROWS, as vim does once lines wrap, and a line's rows
                                ; are not known without measuring it: SCRN.MAC's HTBLD measures the lines
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


                                ; about the screen into a table (HTAB), and the rest is arithmetic on that.
                                ; A scroll then moves the cursor and names the line the screen is to start
                                ; with (HTLAND -> SETRWT), so the text scrolls around it.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0DE6'                         CURRW:
  0DE6'   2A 0000*              	LHLD	WINROW
  0DE9'   EB                    	XCHG
  0DEA'   2A 0000*              	LHLD	LNDLT
  0DED'   19                    	DAD	D		; HL = row (signed)
  0DEE'   7C                    	MOV	A,H
  0DEF'   B7                    	ORA	A
  0DF0'   FA 0E03'              	JM	CRW_0		; above the screen -> top row
  0DF3'   C2 0DFE'              	JNZ	CRW_BT		; far below -> bottom row
  0DF6'   3A 0000*              	LDA	NEDIT
  0DF9'   3D                    	DCR	A		; A = bottom row
  0DFA'   BD                    	CMP	L		; CY iff bottom < row
  0DFB'   D8                    	RC
  0DFC'   7D                    	MOV	A,L
  0DFD'   C9                    	RET
  0DFE'                         CRW_BT:
  0DFE'   3A 0000*              	LDA	NEDIT
  0E01'   3D                    	DCR	A
  0E02'   C9                    	RET
  0E03'                         CRW_0:
  0E03'   AF                    	XRA	A
  0E04'   C9                    	RET
                                
                                ;SETRWT -- A = lines: the next layout puts that many above the cursor's, and
                                ; does not ask whether the line has gone far (PLACE).
  0E05'                         SETRWT:
  0E05'   2A 0000*              	LHLD	LNDLT
  0E08'   EB                    	XCHG
  0E09'   6F                    	MOV	L,A
  0E0A'   26 00                 	MVI	H,0
  0E0C'   CD 0000*              	CALL	SUBHD		; HL = lines - LNDLT
  0E0F'   22 0000*              	SHLD	WINROW
  0E12'   3E 01                 	MVI	A,PL_SET
  0E14'   32 0000*              	STA	PLACE
  0E17'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0E18'                         MVROW:
  0E18'   47                    	MOV	B,A
  0E19'   CD 0DE6'              	CALL	CURRW
  0E1C'   90                    	SUB	B		; A = row now - target
  0E1D'                         MR_GO:
  0E1D'   C8                    	RZ
  0E1E'   DA 0E27'              	JC	MR_DN
  0E21'   6F                    	MOV	L,A
  0E22'   26 00                 	MVI	H,0
  0E24'   C3 0A71'              	JMP	KCORE
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E27'                         MR_DN:
  0E27'   2F                    	CMA
  0E28'   3C                    	INR	A		; A = target - row now
  0E29'   6F                    	MOV	L,A
  0E2A'   26 00                 	MVI	H,0
  0E2C'   C3 09D4'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0E2F'                         VC_HIGH:
  0E2F'   CD 0738'              	CALL	MOVCNT		; a cursor motion, and its count
  0E32'   2B                    	DCX	H		; row = count - 1
  0E33'   7C                    	MOV	A,H
  0E34'   B7                    	ORA	A
  0E35'   3A 0000*              	LDA	SCBOT
  0E38'   C2 0E40'              	JNZ	VH_GO		; >= 256 -> the last text row
  0E3B'   BD                    	CMP	L		; CY iff SCBOT < row
  0E3C'   DA 0E40'              	JC	VH_GO
  0E3F'   7D                    	MOV	A,L
  0E40'                         VH_GO:
  0E40'   CD 0E18'              	CALL	MVROW
  0E43'   C3 0919'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': the line the middle ROW of the text is on (vim: the first
                                ; whose rows, with those above it, come to half of them); count ignored.
  0E46'                         VC_MIDL:
  0E46'   CD 0738'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0E49'   CD 10D8'              	CALL	HTSCR		; HL -> the top line's rows
  0E4C'   3A 0000*              	LDA	TXEND
  0E4F'   3C                    	INR	A
  0E50'   B7                    	ORA	A
  0E51'   1F                    	RAR
  0E52'   3D                    	DCR	A
  0E53'   4F                    	MOV	C,A		; C = (rows of text + 1) / 2 - 1
  0E54'   CD 111E'              	CALL	HTFQ
  0E57'   D2 0E5B'              	JNC	VM_GO
  0E5A'   2B                    	DCX	H
  0E5B'                         VM_GO:
  0E5B'   CD 1113'              	CALL	HTGO
  0E5E'   C3 0919'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0E61'                         VC_LOWL:
  0E61'   CD 0738'              	CALL	MOVCNT		; a cursor motion, and its count
  0E64'   2B                    	DCX	H		; count - 1
  0E65'   3A 0000*              	LDA	SCBOT
  0E68'   5F                    	MOV	E,A
  0E69'   16 00                 	MVI	D,0
  0E6B'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0E6C'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0E6F'   3E 00                 	MVI	A,0
  0E71'   D2 0E78'              	JNC	VL_GO		; at or past the top -> row 0
  0E74'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0E77'   7D                    	MOV	A,L
  0E78'                         VL_GO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0E78'   CD 0E18'              	CALL	MVROW
  0E7B'   C3 0919'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the text forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is the
                                ; screen's ROWS less the overlap (OVLAP), and the line that many rows down
                                ; becomes the top line -- from its first row, vim never showing part of one.
                                ; The top line stops at the last line ('~' rows below); no-op when it is
                                ; already there.
  0E7E'                         VC_PGDN:
  0E7E'   CD 0738'              	CALL	MOVCNT		; a cursor motion, and its count
  0E81'   22 2E34'              	SHLD	RWR
  0E84'   3A 0000*              	LDA	SCEOF
  0E87'   B7                    	ORA	A
  0E88'   CA 0E90'              	JZ	VPD_N
  0E8B'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: it becomes the
  0E8E'   B7                    	ORA	A		;   top line
  0E8F'   C8                    	RZ			; it already is
  0E90'                         VPD_N:
  0E90'   3A 0000*              	LDA	NEDIT
  0E93'   3C                    	INR	A
  0E94'   4F                    	MOV	C,A
  0E95'   3E 02                 	MVI	A,2
  0E97'   CD 10DF'              	CALL	HTSET		; HL -> the top line's rows
  0E9A'   E5                    	PUSH	H
  0E9B'   C5                    	PUSH	B
  0E9C'   3A 0000*              	LDA	NEDIT
  0E9F'   4F                    	MOV	C,A
  0EA0'   CD 111E'              	CALL	HTFQ		; HL -> the first line the screen has not room for
  0EA3'   3A 0000*              	LDA	NEDIT
  0EA6'   DA 0EB3'              	JC	VPD_R		; there is none: no overlap
  0EA9'   3A 2E2F'              	LDA	HTN
  0EAC'   90                    	SUB	B
  0EAD'   3C                    	INR	A
  0EAE'   47                    	MOV	B,A		; the lines from it up to the table's first
  0EAF'   AF                    	XRA	A
  0EB0'   CD 0F4D'              	CALL	OVLAP
  0EB3'                         VPD_R:
  0EB3'   CD 0F9C'              	CALL	PGROWS		; RWR = the rows to go
  0EB6'   C1                    	POP	B
  0EB7'   E1                    	POP	H
  0EB8'   CD 115F'              	CALL	RWFWD		; HL -> the line that row is in, C = which of its
  0EBB'   DA 0ED7'              	JC	VPD_TP		; the text ended: its last line
  0EBE'   79                    	MOV	A,C
  0EBF'   B7                    	ORA	A
  0EC0'   CA 0ED7'              	JZ	VPD_TP
  0EC3'   3A 2E36'              	LDA	RWMV		; part of the way down a line: its start -- unless
  0EC6'   B7                    	ORA	A		;   that is the top line still, then the next
  0EC7'   C2 0ED7'              	JNZ	VPD_TP
  0ECA'   E5                    	PUSH	H
  0ECB'   CD 110D'              	CALL	HTIX
  0ECE'   21 2E31'              	LXI	H,HTTP
  0ED1'   BE                    	CMP	M
  0ED2'   E1                    	POP	H
  0ED3'   C2 0ED7'              	JNZ	VPD_TP
  0ED6'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0ED7'                         VPD_TP:
  0ED7'   54                    	MOV	D,H
  0ED8'   5D                    	MOV	E,L
  0ED9'   C3 1046'              	JMP	HTLAND
                                
                                ;VC_PGUP -- '^B': the text back count pages, not above the first line, the
                                ; cursor on the last line that then shows whole, first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is the screen's ROWS less the overlap
                                ; (OVLAP).  Where that ends part of the way up a line, the top line is the one
                                ; under it -- but the line itself, when it is the first one back.  No-op when
                                ; the first line is already at the top.
  0EDC'                         VC_PGUP:
  0EDC'   CD 0738'              	CALL	MOVCNT		; a cursor motion, and its count
  0EDF'   22 2E34'              	SHLD	RWR
  0EE2'   3A 0000*              	LDA	SCBOF
  0EE5'   B7                    	ORA	A
  0EE6'   C0                    	RNZ
  0EE7'   CD 0DE6'              	CALL	CURRW		; OVLAP reads the top line and the two under it:
  0EEA'   FE 02                 	CPI	2		;   lines the cursor's is not below are read for
  0EEC'   0E 01                 	MVI	C,1
  0EEE'   D2 0EF5'              	JNC	VPU_1
  0EF1'   3A 0000*              	LDA	NEDIT
  0EF4'   4F                    	MOV	C,A
  0EF5'                         VPU_1:
  0EF5'   3A 0000*              	LDA	NEDIT
  0EF8'   CD 10DF'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  0EFB'   E5                    	PUSH	H
  0EFC'   D5                    	PUSH	D
  0EFD'   2B                    	DCX	H		; the line above the top one, and on down
  0EFE'   04                    	INR	B
  0EFF'   3E 01                 	MVI	A,1
  0F01'   CD 0F4D'              	CALL	OVLAP
  0F04'   CD 0F9C'              	CALL	PGROWS		; RWR = the rows to go
  0F07'   D1                    	POP	D
  0F08'   E1                    	POP	H
  0F09'   43                    	MOV	B,E
  0F0A'   CD 119F'              	CALL	RWBAK		; HL -> the line that row is in, C = its rows
  0F0D'   DA 0F2A'              	JC	VPU_3		;   above it; or the file's first line
  0F10'   79                    	MOV	A,C
  0F11'   B7                    	ORA	A
  0F12'   CA 0F2A'              	JZ	VPU_3
  0F15'   3A 2E36'              	LDA	RWMV
  0F18'   B7                    	ORA	A
  0F19'   C2 0F29'              	JNZ	VPU_2
  0F1C'   E5                    	PUSH	H
  0F1D'   CD 110D'              	CALL	HTIX
  0F20'   3C                    	INR	A
  0F21'   21 2E31'              	LXI	H,HTTP
  0F24'   BE                    	CMP	M
  0F25'   E1                    	POP	H
  0F26'   CA 0F2A'              	JZ	VPU_3		; the first line back: all of it
  0F29'                         VPU_2:
  0F29'   23                    	INX	H
  0F2A'                         VPU_3:
  0F2A'   CD 1113'              	CALL	HTGO		; the cursor on the new top line ...
  0F2D'   3A 0000*              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F30'   4F                    	MOV	C,A
  0F31'   06 00                 	MVI	B,0
  0F33'   CD 10F4'              	CALL	HTRB		; ... and the lines under it measured
  0F36'   E5                    	PUSH	H
  0F37'   3A 0000*              	LDA	NEDIT
  0F3A'   4F                    	MOV	C,A
  0F3B'   CD 111E'              	CALL	HTFQ		; HL -> the first the screen has not room for
  0F3E'   2B                    	DCX	H
  0F3F'   D1                    	POP	D		; DE -> the top line's rows
  0F40'   EB                    	XCHG
  0F41'   CD 0000*              	CALL	CMP16		; CY iff that is above the top line (it alone
  0F44'   D2 0F49'              	JNC	VPU_4		;   fills the screen)
  0F47'   54                    	MOV	D,H
  0F48'   5D                    	MOV	E,L
  0F49'                         VPU_4:
  0F49'   EB                    	XCHG
  0F4A'   C3 1046'              	JMP	HTLAND
                                
                                ;OVLAP -- A = the rows one page scrolls, as vim's get_scroll_overlap: the
                                ; screen less two lines of overlap -- or less one, or none, where the lines at
                                ; that edge are too tall to be shown twice or the file ends among them.
                                ;   in : HL -> the rows of the line just off the screen at that edge (h1),
                                ;        A = 0 when the next (h2, h3, h4) are above it in the table, 1 when
                                ;        below, B = the entries the table has that way, h1's among them
  0F4D'                         OVLAP:
  0F4D'   32 2E37'              	STA	OVDIR
  0F50'   3A 0000*              	LDA	NEDIT
  0F53'   D6 02                 	SUI	2
  0F55'   4F                    	MOV	C,A		; C = the rows two lines of overlap leave
  0F56'   56                    	MOV	D,M		; D = h1
  0F57'   CD 0F8E'              	CALL	OV_NX
  0F5A'   DA 0F8A'              	JC	OV_0
  0F5D'   5E                    	MOV	E,M		; E = h2
  0F5E'   7A                    	MOV	A,D
  0F5F'   83                    	ADD	E
  0F60'   57                    	MOV	D,A		; D = h1 + h2
  0F61'   79                    	MOV	A,C
  0F62'   BA                    	CMP	D
  0F63'   DA 0F8A'              	JC	OV_0
  0F66'   CD 0F8E'              	CALL	OV_NX
  0F69'   DA 0F8A'              	JC	OV_0
  0F6C'   7B                    	MOV	A,E
  0F6D'   86                    	ADD	M
  0F6E'   5F                    	MOV	E,A		; E = h2 + h3
  0F6F'   79                    	MOV	A,C
  0F70'   BB                    	CMP	E
  0F71'   DA 0F8A'              	JC	OV_0
  0F74'   7A                    	MOV	A,D
  0F75'   86                    	ADD	M
  0F76'   57                    	MOV	D,A		; D = h1 + h2 + h3
  0F77'   CD 0F8E'              	CALL	OV_NX
  0F7A'   DA 0F87'              	JC	OV_1
  0F7D'   7B                    	MOV	A,E
  0F7E'   86                    	ADD	M		; h2 + h3 + h4
  0F7F'   5F                    	MOV	E,A
  0F80'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F81'   BB                    	CMP	E
  0F82'   DA 0F87'              	JC	OV_1
  0F85'   BA                    	CMP	D
  0F86'   D0                    	RNC			; two lines of overlap
  0F87'                         OV_1:
  0F87'   79                    	MOV	A,C
  0F88'   3C                    	INR	A
  0F89'   C9                    	RET
  0F8A'                         OV_0:
  0F8A'   79                    	MOV	A,C
  0F8B'   C6 02                 	ADI	2
  0F8D'   C9                    	RET
                                ;OV_NX -- HL -> the next line's rows, that way.  CY if the table has no more.
  0F8E'                         OV_NX:
  0F8E'   05                    	DCR	B
  0F8F'   37                    	STC
  0F90'   C8                    	RZ
  0F91'   3A 2E37'              	LDA	OVDIR
  0F94'   B7                    	ORA	A		; (CY off)
  0F95'   CA 0F9A'              	JZ	OV_UP
  0F98'   23                    	INX	H
  0F99'   23                    	INX	H
  0F9A'                         OV_UP:
  0F9A'   2B                    	DCX	H
  0F9B'   C9                    	RET
                                
                                ;PGROWS -- A = the rows of a page: RWR = the count (in RWR) of them, and no
                                ; line gone past yet (RWMV).
  0F9C'                         PGROWS:
  0F9C'   2A 2E34'              	LHLD	RWR
  0F9F'   CD 0FAA'              	CALL	MULSAT
  0FA2'   22 2E34'              	SHLD	RWR
  0FA5'   AF                    	XRA	A
  0FA6'   32 2E36'              	STA	RWMV
  0FA9'   C9                    	RET
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0FAA'                         MULSAT:
  0FAA'   EB                    	XCHG
  0FAB'   21 0000               	LXI	H,0
  0FAE'   B7                    	ORA	A
  0FAF'   C8                    	RZ
  0FB0'                         MS_LP:
  0FB0'   19                    	DAD	D
  0FB1'   DA 0FB9'              	JC	MS_SAT
  0FB4'   3D                    	DCR	A
  0FB5'   C2 0FB0'              	JNZ	MS_LP
  0FB8'   C9                    	RET
  0FB9'                         MS_SAT:
  0FB9'   21 FFFF               	LXI	H,0FFFFH
  0FBC'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': the text and the cursor down HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text goes
                                ; no farther than brings the last row of the file to the bottom row; the line
                                ; that many rows down becomes the top line -- from its first row, vim never
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


                                ; showing part of one, and the cursor moves as many rows less (more, where
                                ; the top line alone was taller than that and the text had to go past it).
                                ; On the last line nothing moves, the column included.
  0FBD'                         VC_HFDN:
  0FBD'   CD 0820'              	CALL	SETMOV
  0FC0'   CD 1202'              	CALL	HFCNT		; HFN = the rows
  0FC3'   3A 0000*              	LDA	TALLF
  0FC6'   B7                    	ORA	A
  0FC7'   C2 105D'              	JNZ	VHD_TL
  0FCA'   CD 0DE6'              	CALL	CURRW
  0FCD'   47                    	MOV	B,A
  0FCE'   3A 0000*              	LDA	SCEOF
  0FD1'   B7                    	ORA	A
  0FD2'   CA 0FDA'              	JZ	VHD_GO
  0FD5'   3A 0000*              	LDA	SCBOT		; the last line's place
  0FD8'   B8                    	CMP	B
  0FD9'   C8                    	RZ			; the cursor is on it
  0FDA'                         VHD_GO:
  0FDA'   3A 0000*              	LDA	NEDIT
  0FDD'   21 2E2C'              	LXI	H,HFN
  0FE0'   86                    	ADD	M
  0FE1'   3C                    	INR	A
  0FE2'   4F                    	MOV	C,A
  0FE3'   AF                    	XRA	A
  0FE4'   CD 10DF'              	CALL	HTSET		; HL -> the top line's rows
  0FE7'   3A 2E2C'              	LDA	HFN
  0FEA'   57                    	MOV	D,A		; D = the rows the text moves
  0FEB'   5F                    	MOV	E,A		; E = the rows the cursor moves
  0FEC'   3A 2E32'              	LDA	HTEOF
  0FEF'   B7                    	ORA	A
  0FF0'   CA 100F'              	JZ	VHD_1
  0FF3'   E5                    	PUSH	H
  0FF4'   C5                    	PUSH	B
  0FF5'   0E FF                 	MVI	C,255
  0FF7'   CD 111E'              	CALL	HTFQ		; (runs off: C = 255 - the rows to the file's end)
  0FFA'   3A 0000*              	LDA	NEDIT
  0FFD'   81                    	ADD	C
  0FFE'   2F                    	CMA			; A = those rows - NEDIT: the rows off the screen
  0FFF'   C1                    	POP	B
  1000'   E1                    	POP	H
  1001'   B7                    	ORA	A
  1002'   FA 100D'              	JM	VHD_0		; none
  1005'   BA                    	CMP	D
  1006'   D2 100F'              	JNC	VHD_1
  1009'   57                    	MOV	D,A
  100A'   C3 100F'              	JMP	VHD_1
  100D'                         VHD_0:
  100D'   16 00                 	MVI	D,0
  100F'                         VHD_1:
  100F'   7A                    	MOV	A,D
  1010'   B7                    	ORA	A
  1011'   CA 102C'              	JZ	VHD_C		; the text stays
  1014'   4A                    	MOV	C,D
  1015'   CD 111E'              	CALL	HTFQ		; HL -> the line that row is in, C = which of its
  1018'   79                    	MOV	A,C
  1019'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  101A'   CA 102C'              	JZ	VHD_C
  101D'   BA                    	CMP	D
  101E'   C2 1029'              	JNZ	VHD_R
  1021'   7E                    	MOV	A,M		; the top line still: past all of it
  1022'   91                    	SUB	C
  1023'   83                    	ADD	E
  1024'   5F                    	MOV	E,A
  1025'   23                    	INX	H
  1026'   C3 102C'              	JMP	VHD_C
  1029'                         VHD_R:
  1029'   7B                    	MOV	A,E		; part of the way down a line: its start
  102A'   91                    	SUB	C
  102B'   5F                    	MOV	E,A
  102C'                         VHD_C:
  102C'   22 2E2D'              	SHLD	HFTP
  102F'   3A 0000*              	LDA	CSUB		; the cursor: E rows down from the one it is on
  1032'   83                    	ADD	E
  1033'   4F                    	MOV	C,A
  1034'   3A 2E30'              	LDA	HTCUR
  1037'   CD 1100'              	CALL	HTPT
  103A'   CD 111E'              	CALL	HTFQ
  103D'   D2 1041'              	JNC	HFEND
  1040'   2B                    	DCX	H		; the file ends first: its last line
                                ;HFEND -- ^D / ^U: HL -> the rows of the line the cursor goes to.
  1041'                         HFEND:
  1041'   EB                    	XCHG
  1042'   2A 2E2D'              	LHLD	HFTP
  1045'   EB                    	XCHG
                                ;HTLAND -- the cursor to the line whose rows HL points at, DE -> those of the
                                ; line the screen is to start with (never one under it); first non-blank.
  1046'                         HTLAND:
  1046'   E5                    	PUSH	H
  1047'   D5                    	PUSH	D
  1048'   CD 1113'              	CALL	HTGO
  104B'   D1                    	POP	D
  104C'   E1                    	POP	H
  104D'   CD 0000*              	CALL	SUBHD		; HL = the lines between them
  1050'   7C                    	MOV	A,H
  1051'   B7                    	ORA	A
  1052'   7D                    	MOV	A,L
  1053'   CA 1057'              	JZ	HL_SET
  1056'   AF                    	XRA	A
  1057'                         HL_SET:
  1057'   CD 0E05'              	CALL	SETRWT
  105A'   C3 0919'              	JMP	FNBLNK
                                
                                ;--- the top line is taller than the screen, and the cursor in it: vim goes
                                ;    on scrolling until the next line is at the top, the cursor keeping its
                                ;    row of the screen ---
  105D'                         VHD_TL:
  105D'   3A 0000*              	LDA	SKIPR
  1060'   47                    	MOV	B,A
  1061'   3A 0000*              	LDA	CSUB
  1064'   90                    	SUB	B		; A = that row
  1065'   F5                    	PUSH	PSW
  1066'   21 0001               	LXI	H,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  1069'   CD 09D4'              	CALL	JCORE		; (on the last line: nowhere to go)
  106C'   F1                    	POP	PSW
  106D'   4F                    	MOV	C,A
  106E'   C5                    	PUSH	B
  106F'   0C                    	INR	C
  1070'   06 00                 	MVI	B,0
  1072'   CD 10F4'              	CALL	HTRB		; HL -> the rows of the line now the cursor's
  1075'   22 2E2D'              	SHLD	HFTP
  1078'   D1                    	POP	D
  1079'   4B                    	MOV	C,E
  107A'   CD 111E'              	CALL	HTFQ
  107D'   D2 1041'              	JNC	HFEND
  1080'   2B                    	DCX	H
  1081'   C3 1041'              	JMP	HFEND
                                
                                ;VC_HFUP -- '^U': the text and the cursor up HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text
                                ; stops at the first line, the cursor goes on.  Where the rows end part of
                                ; the way up a line, the top line is the one under it and the cursor moves as
                                ; many rows less -- but the line itself, and as many more, when it is the
                                ; first one back.  On the first line nothing moves, the column included.
  1084'                         VC_HFUP:
  1084'   CD 0820'              	CALL	SETMOV
  1087'   CD 1202'              	CALL	HFCNT		; HFN = the rows
  108A'   CD 11E2'              	CALL	ONFST
  108D'   C8                    	RZ			; the cursor is on the first line
  108E'   0E 01                 	MVI	C,1
  1090'   3A 2E2C'              	LDA	HFN
  1093'   CD 10DF'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  1096'   43                    	MOV	B,E
  1097'   3A 2E2C'              	LDA	HFN
  109A'   4F                    	MOV	C,A
  109B'   5F                    	MOV	E,A		; E = the rows the cursor moves
  109C'   CD 112F'              	CALL	HTBQ		; HL -> the line that row is in, C = its rows
  109F'   DA 10BA'              	JC	VHU_C		;   above it; or the file's first line
  10A2'   79                    	MOV	A,C
  10A3'   B7                    	ORA	A
  10A4'   CA 10BA'              	JZ	VHU_C
  10A7'   3A 2E31'              	LDA	HTTP
  10AA'   3D                    	DCR	A
  10AB'   B8                    	CMP	B
  10AC'   CA 10B7'              	JZ	VHU_F
  10AF'   7B                    	MOV	A,E		; part of the way up a line: the one under it
  10B0'   96                    	SUB	M
  10B1'   81                    	ADD	C
  10B2'   5F                    	MOV	E,A
  10B3'   23                    	INX	H
  10B4'   C3 10BA'              	JMP	VHU_C
  10B7'                         VHU_F:
  10B7'   7B                    	MOV	A,E		; ... the first line back: all of it
  10B8'   81                    	ADD	C
  10B9'   5F                    	MOV	E,A
  10BA'                         VHU_C:
  10BA'   22 2E2D'              	SHLD	HFTP
  10BD'   4B                    	MOV	C,E
  10BE'   3A 2E30'              	LDA	HTCUR
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  10C1'   CD 1100'              	CALL	HTPT		; HL -> the cursor line's rows, E = lines above it
  10C4'   3A 0000*              	LDA	CSUB
  10C7'   57                    	MOV	D,A
  10C8'   79                    	MOV	A,C
  10C9'   92                    	SUB	D		; the rows to go, less those of its own line above it
  10CA'   DA 1041'              	JC	HFEND
  10CD'   CA 1041'              	JZ	HFEND
  10D0'   4F                    	MOV	C,A
  10D1'   43                    	MOV	B,E
  10D2'   CD 112F'              	CALL	HTBQ		; (off the top: the file's first line)
  10D5'   C3 1041'              	JMP	HFEND
                                
                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
                                ;HTSCR -- the table as the last layout left it, which is the screen's own:
                                ; HL, B and E as HTSET gives them, and nothing measured.
  10D8'                         HTSCR:
  10D8'   CD 0DE6'              	CALL	CURRW
  10DB'   47                    	MOV	B,A
  10DC'   C3 10EA'              	JMP	HS_TP
  10DF'                         HTSET:
  10DF'   47                    	MOV	B,A
  10E0'   CD 0DE6'              	CALL	CURRW		; (keeps BC)
  10E3'   F5                    	PUSH	PSW
  10E4'   80                    	ADD	B
  10E5'   47                    	MOV	B,A
  10E6'   CD 10F4'              	CALL	HTRB
  10E9'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  10EA'                         HS_TP:
  10EA'   3A 2E30'              	LDA	HTCUR
  10ED'   90                    	SUB	B
  10EE'   32 2E31'              	STA	HTTP
  10F1'   C3 1100'              	JMP	HTPT
  10F4'                         HTRB:
  10F4'   CD 12D2'              	CALL	ZSAVE
  10F7'   CD 0000*              	CALL	HTBLD
  10FA'   CD 12E5'              	CALL	ZREST
  10FD'   3A 2E30'              	LDA	HTCUR
  1100'                         HTPT:
  1100'   5F                    	MOV	E,A
  1101'   16 00                 	MVI	D,0
  1103'   21 0000*              	LXI	H,HTAB
  1106'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  1107'   3A 2E2F'              	LDA	HTN
  110A'   93                    	SUB	E
  110B'   47                    	MOV	B,A
  110C'   C9                    	RET
                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  110D'                         HTIX:
  110D'   11 0000*              	LXI	D,HTAB
  1110'   7D                    	MOV	A,L
  1111'   93                    	SUB	E
  1112'   C9                    	RET
                                
                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
  1113'                         HTGO:
  1113'   CD 110D'              	CALL	HTIX
  1116'   47                    	MOV	B,A
  1117'   3A 2E30'              	LDA	HTCUR
  111A'   90                    	SUB	B		; A = the lines up to it
  111B'   C3 0E1D'              	JMP	MR_GO
                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  111E'                         HTFQ:
  111E'   78                    	MOV	A,B
  111F'   B7                    	ORA	A
  1120'   37                    	STC
  1121'   C8                    	RZ
  1122'   79                    	MOV	A,C
  1123'   96                    	SUB	M
  1124'   DA 112D'              	JC	HF_IN
  1127'   4F                    	MOV	C,A
  1128'   23                    	INX	H
  1129'   05                    	DCR	B
  112A'   C3 111E'              	JMP	HTFQ
  112D'                         HF_IN:
  112D'   B7                    	ORA	A
  112E'   C9                    	RET
                                
                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
                                ;        the table starts first (HL -> its first entry, C = the rows short)
  112F'                         HTBQ:
  112F'   78                    	MOV	A,B
  1130'   B7                    	ORA	A
  1131'   37                    	STC
  1132'   C8                    	RZ
  1133'   2B                    	DCX	H
  1134'   05                    	DCR	B
  1135'   7E                    	MOV	A,M
  1136'   91                    	SUB	C
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  1137'   D2 1140'              	JNC	HQ_IN
  113A'   2F                    	CMA
  113B'   3C                    	INR	A
  113C'   4F                    	MOV	C,A
  113D'   C3 112F'              	JMP	HTBQ
  1140'                         HQ_IN:
  1140'   4F                    	MOV	C,A
  1141'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
                                ; Keeps HL, B, DE.
  1142'                         RWQ:
  1142'   0E 64                 	MVI	C,100
  1144'   3A 2E35'              	LDA	RWR+1
  1147'   B7                    	ORA	A
  1148'   C0                    	RNZ
  1149'   3A 2E34'              	LDA	RWR
  114C'   B9                    	CMP	C
  114D'   D0                    	RNC
  114E'   4F                    	MOV	C,A
  114F'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  1150'                         RWSUB:
  1150'   E5                    	PUSH	H
  1151'   5F                    	MOV	E,A
  1152'   16 00                 	MVI	D,0
  1154'   2A 2E34'              	LHLD	RWR
  1157'   CD 0000*              	CALL	SUBHD
  115A'   22 2E34'              	SHLD	RWR
  115D'   E1                    	POP	H
  115E'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
                                ; whose entry HL points at (B = the entries from it on), however far that is:
                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  115F'                         RWFWD:
  115F'   CD 1142'              	CALL	RWQ
  1162'   51                    	MOV	D,C
  1163'   CD 111E'              	CALL	HTFQ
  1166'   F5                    	PUSH	PSW
  1167'   7A                    	MOV	A,D
  1168'   91                    	SUB	C		; the rows that took it to that line's first
  1169'   CD 1150'              	CALL	RWSUB
  116C'   F1                    	POP	PSW
  116D'   DA 1181'              	JC	RF_OFF
  1170'   3A 2E35'              	LDA	RWR+1		; is what is left inside this line?
  1173'   B7                    	ORA	A
  1174'   C2 118B'              	JNZ	RF_GO
  1177'   3A 2E34'              	LDA	RWR
  117A'   BE                    	CMP	M
  117B'   D2 118B'              	JNC	RF_GO
  117E'   4F                    	MOV	C,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  117F'   B7                    	ORA	A
  1180'   C9                    	RET
  1181'                         RF_OFF:
  1181'   3A 2E32'              	LDA	HTEOF
  1184'   B7                    	ORA	A
  1185'   CA 118B'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  1188'   2B                    	DCX	H
  1189'   37                    	STC
  118A'   C9                    	RET
  118B'                         RF_GO:
  118B'   CD 1113'              	CALL	HTGO
  118E'   3E 01                 	MVI	A,1
  1190'   32 2E36'              	STA	RWMV
  1193'   CD 1142'              	CALL	RWQ
  1196'   0C                    	INR	C
  1197'   06 00                 	MVI	B,0
  1199'   CD 10F4'              	CALL	HTRB
  119C'   C3 115F'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  119F'                         RWBAK:
  119F'   CD 1142'              	CALL	RWQ
  11A2'   51                    	MOV	D,C
  11A3'   CD 112F'              	CALL	HTBQ
  11A6'   DA 11C3'              	JC	RB_OFF
  11A9'   7A                    	MOV	A,D
  11AA'   81                    	ADD	C
  11AB'   5F                    	MOV	E,A		; E = the rows up to that line's first
  11AC'   3A 2E35'              	LDA	RWR+1
  11AF'   B7                    	ORA	A
  11B0'   C2 11BF'              	JNZ	RB_ON
  11B3'   3A 2E34'              	LDA	RWR
  11B6'   57                    	MOV	D,A
  11B7'   7B                    	MOV	A,E
  11B8'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  11B9'   DA 11BF'              	JC	RB_ON
  11BC'   4F                    	MOV	C,A
  11BD'   B7                    	ORA	A
  11BE'   C9                    	RET
  11BF'                         RB_ON:
  11BF'   7B                    	MOV	A,E
  11C0'   C3 11CA'              	JMP	RB_GO
  11C3'                         RB_OFF:
  11C3'   3A 2E33'              	LDA	HTBOF
  11C6'   0F                    	RRC			; CY: that is the file's first line
  11C7'   D8                    	RC
  11C8'   7A                    	MOV	A,D
  11C9'   91                    	SUB	C
  11CA'                         RB_GO:
  11CA'   CD 1150'              	CALL	RWSUB
  11CD'   CD 1113'              	CALL	HTGO
  11D0'   3E 01                 	MVI	A,1
  11D2'   32 2E36'              	STA	RWMV
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  11D5'   CD 1142'              	CALL	RWQ
  11D8'   41                    	MOV	B,C
  11D9'   0E 01                 	MVI	C,1
  11DB'   CD 10F4'              	CALL	HTRB
  11DE'   43                    	MOV	B,E
  11DF'   C3 119F'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  11E2'                         ONFST:
  11E2'   E5                    	PUSH	H
  11E3'   2A 0000*              	LHLD	OUTPOS
  11E6'   7C                    	MOV	A,H
  11E7'   B5                    	ORA	L
  11E8'   C2 1200'              	JNZ	OF_RET
  11EB'   2A 0000*              	LHLD	TXTBEG
  11EE'   EB                    	XCHG			; DE = TXTBEG
  11EF'   2A 0000*              	LHLD	GAPBEG
  11F2'                         OF_LP:
  11F2'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  11F5'   CA 1200'              	JZ	OF_RET
  11F8'   2B                    	DCX	H
  11F9'   7E                    	MOV	A,M
  11FA'   FE 0A                 	CPI	LF
  11FC'   C2 11F2'              	JNZ	OF_LP
  11FF'   B7                    	ORA	A		; NZ
  1200'                         OF_RET:
  1200'   E1                    	POP	H
  1201'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  1202'                         HFCNT:
  1202'   2A 2E1C'              	LHLD	CMDCNT
  1205'   7C                    	MOV	A,H
  1206'   B5                    	ORA	L
  1207'   CA 121E'              	JZ	HFC_AM
  120A'   CD 074B'              	CALL	GETCNT		; HL = count; clears it
  120D'   3A 0000*              	LDA	NEDIT
  1210'   5F                    	MOV	E,A
  1211'   16 00                 	MVI	D,0
  1213'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  1216'   D2 121A'              	JNC	HFC_ST
  1219'   EB                    	XCHG			; HL = NEDIT
  121A'                         HFC_ST:
  121A'   7D                    	MOV	A,L
  121B'   32 2E2B'              	STA	HFAMT
  121E'                         HFC_AM:
  121E'   3A 2E2B'              	LDA	HFAMT
  1221'   B7                    	ORA	A
  1222'   C2 122F'              	JNZ	HFC_HL
  1225'   3A 0000*              	LDA	NEDIT
  1228'   B7                    	ORA	A
  1229'   1F                    	RAR
  122A'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  122B'   C2 122F'              	JNZ	HFC_HL
  122E'   3C                    	INR	A		; at least one row
  122F'                         HFC_HL:
  122F'   32 2E2C'              	STA	HFN
  1232'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  1233'                         VC_REDR:
  1233'   C3 074B'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (PLACE) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  1236'                         VC_G:
  1236'   CD 0820'              	CALL	SETMOV
  1239'   CD 12F8'              	CALL	GZONE		; the screen's top line, before the move
  123C'   CD 0774'              	CALL	BRKON		; ... and an ESC may stop it from here on
  123F'   2A 2E1C'              	LHLD	CMDCNT
  1242'   7C                    	MOV	A,H
  1243'   B5                    	ORA	L
  1244'   C2 1257'              	JNZ	VG_N
  1247'   AF                    	XRA	A		; forward
  1248'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  124B'   CD 07B1'              	CALL	BRKOFF
  124E'   DA 07C9'              	JC	BRKBAK
  1251'   CD 0B08'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  1254'   C3 1310'              	JMP	GPLACE
  1257'                         VG_N:
  1257'   CD 074B'              	CALL	GETCNT		; HL = target line (1-based)
  125A'                         VG_LN:
  125A'   CD 1266'              	CALL	GOLN
  125D'   CD 07B1'              	CALL	BRKOFF
  1260'   DA 07C9'              	JC	BRKBAK
  1263'   C3 1310'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  1266'                         GOLN:
  1266'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  1267'   CD 0000*              	CALL	CNTLF
  126A'   23                    	INX	H		; HL = the cursor's line
  126B'   D1                    	POP	D		; DE = the line wanted
  126C'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  126F'   DA 127A'              	JC	GLN_BK
  1272'   EB                    	XCHG
  1273'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  1276'   AF                    	XRA	A
  1277'   C3 127F'              	JMP	GLN_MV
  127A'                         GLN_BK:
  127A'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  127D'   3E FF                 	MVI	A,0FFH
  127F'                         GLN_MV:
  127F'   CD 0000*              	CALL	MVLIND
  1282'   CD 0B02'              	CALL	ATEOF
  1285'   DC 0B08'              	CC	LASTLN		; past the last line: onto it
  1288'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  1289'                         VC_LG:
  1289'   CD 0820'              	CALL	SETMOV
  128C'   3A 2E52'              	LDA	GSAVE
  128F'   B7                    	ORA	A
  1290'   C2 1299'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  1293'   3E 01                 	MVI	A,PG
  1295'   32 2E51'              	STA	GPEND
  1298'   C9                    	RET
  1299'                         VLG_GG:
  1299'   CD 12F8'              	CALL	GZONE
  129C'   CD 0774'              	CALL	BRKON
  129F'   CD 074B'              	CALL	GETCNT		; HL = target line (no count: 1)
  12A2'   C3 125A'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  12A5'                         SUB24:
  12A5'   4F                    	MOV	C,A
  12A6'   7D                    	MOV	A,L
  12A7'   93                    	SUB	E
  12A8'   6F                    	MOV	L,A
  12A9'   7C                    	MOV	A,H
  12AA'   9A                    	SBB	D
  12AB'   67                    	MOV	H,A
  12AC'   79                    	MOV	A,C
  12AD'   98                    	SBB	B
  12AE'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  12AF'                         CURFP:
  12AF'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  12B2'                         FPOS:
  12B2'   C5                    	PUSH	B
  12B3'   D5                    	PUSH	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12B4'   EB                    	XCHG
  12B5'   2A 0000*              	LHLD	TXTBEG
  12B8'   EB                    	XCHG
  12B9'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  12BC'   EB                    	XCHG			; DE = that
  12BD'   2A 0000*              	LHLD	OUTPOS
  12C0'   7C                    	MOV	A,H
  12C1'   B7                    	ORA	A		; CY = 0
  12C2'   1F                    	RAR
  12C3'   47                    	MOV	B,A
  12C4'   7D                    	MOV	A,L
  12C5'   1F                    	RAR
  12C6'   67                    	MOV	H,A
  12C7'   3E 00                 	MVI	A,0
  12C9'   1F                    	RAR
  12CA'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  12CB'   19                    	DAD	D
  12CC'   78                    	MOV	A,B
  12CD'   CE 00                 	ACI	0		; A:HL = the position
  12CF'   D1                    	POP	D
  12D0'   C1                    	POP	B
  12D1'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  12D2'                         ZSAVE:
  12D2'   2A 2E1C'              	LHLD	CMDCNT
  12D5'   22 2E8E'              	SHLD	ZSVCNT
  12D8'   2A 0000*              	LHLD	AUXCNT
  12DB'   22 2E90'              	SHLD	ZSVAUX
  12DE'   3A 0000*              	LDA	DIRFLG
  12E1'   32 2E92'              	STA	ZSVDIR
  12E4'   C9                    	RET
  12E5'                         ZREST:
  12E5'   2A 2E8E'              	LHLD	ZSVCNT
  12E8'   22 2E1C'              	SHLD	CMDCNT
  12EB'   2A 2E90'              	LHLD	ZSVAUX
  12EE'   22 0000*              	SHLD	AUXCNT
  12F1'   3A 2E92'              	LDA	ZSVDIR
  12F4'   32 0000*              	STA	DIRFLG
  12F7'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  12F8'                         GZONE:
  12F8'   CD 12D2'              	CALL	ZSAVE
  12FB'   CD 0DE6'              	CALL	CURRW
  12FE'   6F                    	MOV	L,A
  12FF'   26 00                 	MVI	H,0
  1301'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  1304'   CD 12B2'              	CALL	FPOS
  1307'   22 0000*              	SHLD	ZTOP
  130A'   32 0002*              	STA	ZTOP+2
  130D'   C3 12E5'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


                                ; rule above), ask for a full repaint, and land on the first non-blank.
  1310'                         GPLACE:
  1310'   CD 12D2'              	CALL	ZSAVE
  1313'   CD 12AF'              	CALL	CURFP
  1316'   EB                    	XCHG
  1317'   2A 0000*              	LHLD	ZTOP
  131A'   EB                    	XCHG
  131B'   4F                    	MOV	C,A		; C:HL = the target's position
  131C'   3A 0002*              	LDA	ZTOP+2
  131F'   47                    	MOV	B,A		; B:DE = the top's
  1320'   79                    	MOV	A,C
  1321'   CD 12A5'              	CALL	SUB24
  1324'   22 2E8B'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  1327'   DA 1361'              	JC	GP_UP
  132A'   B7                    	ORA	A
  132B'   C2 13A7'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  132E'   3A 0000*              	LDA	NEDIT
  1331'   87                    	ADD	A
  1332'   3C                    	INR	A
  1333'   6F                    	MOV	L,A
  1334'   26 00                 	MVI	H,0
  1336'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  1339'   CD 0744'              	CALL	GBSUB		; HL = bytes from there to the target
  133C'   EB                    	XCHG
  133D'   2A 2E8B'              	LHLD	ZDIF		; HL = bytes from the top to the target
  1340'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  1343'   DA 13A7'              	JC	GP_MID
  1346'   CD 0744'              	CALL	GBSUB		; HL = the top line's start (resident)
  1349'   01 0000               	LXI	B,0		; BC = lines from the top
  134C'                         GP_CNT:
  134C'   7A                    	MOV	A,D
  134D'   B3                    	ORA	E
  134E'   CA 135D'              	JZ	GP_DN
  1351'   7E                    	MOV	A,M
  1352'   23                    	INX	H
  1353'   1B                    	DCX	D
  1354'   FE 0A                 	CPI	LF
  1356'   C2 134C'              	JNZ	GP_CNT
  1359'   03                    	INX	B
  135A'   C3 134C'              	JMP	GP_CNT
  135D'                         GP_DN:
  135D'   79                    	MOV	A,C		; the lines from the top one to it
  135E'   C3 13D1'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  1361'                         GP_UP:
  1361'   3C                    	INR	A
  1362'   C2 13A7'              	JNZ	GP_MID		; 64K bytes or more above
  1365'   2A 2E8B'              	LHLD	ZDIF
  1368'   EB                    	XCHG
  1369'   21 0000               	LXI	H,0
  136C'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  136F'   7C                    	MOV	A,H
  1370'   B5                    	ORA	L
  1371'   CA 13A7'              	JZ	GP_MID		; exactly 64K
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  1374'   EB                    	XCHG			; DE = bytes to read
  1375'   AF                    	XRA	A
  1376'   32 2E8D'              	STA	ZLF
  1379'   CD 0000*              	CALL	RGET0
  137C'                         GP_RD:
  137C'   CD 0000*              	CALL	RDGET		; (keeps DE)
  137F'   DA 13A7'              	JC	GP_MID
  1382'   FE 0A                 	CPI	LF
  1384'   C2 1398'              	JNZ	GP_RN
  1387'   3A 0000*              	LDA	NEDIT
  138A'   B7                    	ORA	A
  138B'   1F                    	RAR
  138C'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  138E'   E5                    	PUSH	H
  138F'   21 2E8D'              	LXI	H,ZLF
  1392'   34                    	INR	M
  1393'   BE                    	CMP	M		; CY iff more lines than that
  1394'   E1                    	POP	H
  1395'   DA 13A7'              	JC	GP_MID
  1398'                         GP_RN:
  1398'   1B                    	DCX	D
  1399'   7A                    	MOV	A,D
  139A'   B3                    	ORA	E
  139B'   C2 137C'              	JNZ	GP_RD
  139E'   3E 01                 	MVI	A,PL_SET	; the top row
  13A0'   32 0000*              	STA	PLACE
  13A3'   AF                    	XRA	A
  13A4'   C3 13B1'              	JMP	GP_SET
  13A7'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  13A7'   3E 02                 	MVI	A,PL_MID
  13A9'   32 0000*              	STA	PLACE		; mid-screen, as the rows fall
  13AC'   3A 0000*              	LDA	NEDIT
  13AF'   B7                    	ORA	A
  13B0'   1F                    	RAR			; (no more lines above it than this)
  13B1'                         GP_SET:
  13B1'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  13B2'   26 00                 	MVI	H,0
  13B4'   22 0000*              	SHLD	WINROW
  13B7'   21 0000               	LXI	H,0
  13BA'   22 0000*              	SHLD	LNDLT
  13BD'   CD 085D'              	CALL	SETFUL		; the window may have paged: full repaint
  13C0'                         GP_FIN:
  13C0'   CD 12E5'              	CALL	ZREST
  13C3'   3A 2EB6'              	LDA	GPKEEP
  13C6'   B7                    	ORA	A
  13C7'   CA 0919'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  13CA'   AF                    	XRA	A
  13CB'   32 2EB6'              	STA	GPKEEP
  13CE'   C3 05D6'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
                                ; adds LNDLT to it and arrives at the same line.
  13D1'                         GP_ONS:
  13D1'   6F                    	MOV	L,A
  13D2'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  13D4'   EB                    	XCHG
  13D5'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  13D8'   EB                    	XCHG
  13D9'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  13DC'   22 0000*              	SHLD	LNDLT
  13DF'   3E 01                 	MVI	A,R_MOVE
  13E1'   32 2E20'              	STA	RINTENT
  13E4'   C3 13C0'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  13E7'                         OPPEND:
  13E7'   AF                    	XRA	A
  13E8'   32 2E57'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  13EB'   3A 2E54'              	LDA	PSAVE
  13EE'   FE 63                 	CPI	'c'
  13F0'   C2 140D'              	JNZ	OPP_ND
  13F3'   79                    	MOV	A,C
  13F4'   FE 77                 	CPI	'w'
  13F6'   CA 13FE'              	JZ	OPP_W
  13F9'   FE 57                 	CPI	'W'
  13FB'   C2 140D'              	JNZ	OPP_ND
  13FE'                         OPP_W:
  13FE'   CD 15E0'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  1401'   DA 140D'              	JC	OPP_ND
  1404'   79                    	MOV	A,C
  1405'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  1407'   4F                    	MOV	C,A
  1408'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  140A'   32 2E57'              	STA	CWEOL		;   char for the next word's: see ESTEP
  140D'                         OPP_ND:
  140D'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  140E'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  1410'   C2 1424'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  1413'   CD 01F9'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  1416'   DA 14B4'              	JC	OPABRT
  1419'   79                    	MOV	A,C
  141A'   FE 67                 	CPI	'g'
  141C'   C2 14B4'              	JNZ	OPABRT
  141F'   3E 01                 	MVI	A,PG
  1421'   32 2E52'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  1424'                         OPP_NG:
  1424'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  1425'   21 2E54'              	LXI	H,PSAVE
  1428'   BE                    	CMP	M
  1429'   CA 1601'              	JZ	OPLINE
  142C'   79                    	MOV	A,C		; (OPCLS classifies the key)
  142D'   CD 1617'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1430'   DA 14B4'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  1433'   32 2E56'              	STA	OPCLSV
  1436'   47                    	MOV	B,A		; B = the class
  1437'   3A 2E54'              	LDA	PSAVE
  143A'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  143C'   C2 1448'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  143F'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  1440'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  1442'   C2 146A'              	JNZ	OPP_GO
  1445'   C3 1453'              	JMP	OPP_NO
  1448'                         OPP_NC:
  1448'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  144A'   C2 146A'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  144D'   78                    	MOV	A,B		;   a charwise register would need a type flag
  144E'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  1450'   CA 146A'              	JZ	OPP_GO		;   within a line -- neither of which is built
  1453'                         OPP_NO:
  1453'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  1454'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  1456'   CA 1464'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  1459'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  145B'   CA 1464'              	JZ	OPP_SW		;   so swallow it before dropping the command
  145E'   CD 0326'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  1461'   C2 14B4'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  1464'                         OPP_SW:
  1464'   CD 01F9'              	CALL	MKGETK
  1467'   C3 14B4'              	JMP	OPABRT
  146A'                         OPP_GO:
  146A'   AF                    	XRA	A
  146B'   32 2E2A'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  146E'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  1471'   22 2E58'              	SHLD	OPSTA
  1474'   C5                    	PUSH	B
  1475'   21 2E5C'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  1478'   CD 0429'              	CALL	FPSTO		;   only good until the motion pages the window
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  147B'   3A 2E56'              	LDA	OPCLSV
  147E'   FE 02                 	CPI	2
  1480'   CC 14B7'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  1483'   C1                    	POP	B
  1484'   21 2D63'              	LXI	H,CMDTAB
  1487'   CD 00C3'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  148A'   3A 2E54'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  148D'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  148E'   CA 0820'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  1491'   CD 14E3'              	CALL	OPSFIX		; where the start is in the window NOW
  1494'   D2 14FF'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  1497'   22 2E58'              	SHLD	OPSTA
  149A'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  149D'   22 2E5A'              	SHLD	OPEND2
  14A0'   3A 2E54'              	LDA	PSAVE
  14A3'   FE 79                 	CPI	'y'
  14A5'   CA 1BA7'              	JZ	OPYANK		; a yank takes the span without losing it
  14A8'   CD 1652'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  14AB'   3A 2E54'              	LDA	PSAVE
  14AE'   FE 63                 	CPI	'c'
  14B0'   C0                    	RNZ
  14B1'   C3 195B'              	JMP	SETINS
  14B4'                         OPABRT:				; not a motion -> the operator is dropped and
  14B4'   C3 00A6'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  14B7'                         OPENDS:
  14B7'   2A 2E58'              	LHLD	OPSTA
  14BA'   CD 063D'              	CALL	BOL
  14BD'   11 2E5F'              	LXI	D,OPSLO
  14C0'   CD 14D5'              	CALL	OPE_ST
  14C3'   2A 2E58'              	LHLD	OPSTA
  14C6'   CD 06D4'              	CALL	NLSTART
  14C9'   11 2E62'              	LXI	D,OPSHI
  14CC'   CD 14D5'              	CALL	OPE_ST
  14CF'   2A 2E58'              	LHLD	OPSTA
  14D2'   C3 0000*              	JMP	GOTO
  14D5'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  14D5'   D5                    	PUSH	D
  14D6'   CD 0000*              	CALL	GOTO
  14D9'   E1                    	POP	H
  14DA'   C3 0429'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  14DD'                         CURBD:
  14DD'   CD 12AF'              	CALL	CURFP
  14E0'   EB                    	XCHG
  14E1'   47                    	MOV	B,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  14E2'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  14E3'                         OPSFIX:
  14E3'   21 2E5C'              	LXI	H,OPSFP
  14E6'   CD 03DC'              	CALL	MKLOAD
  14E9'   CD 14DD'              	CALL	CURBD
  14EC'   2A 2EC0'              	LHLD	MKPOS
  14EF'   3A 2EC2'              	LDA	MKPOS+2
  14F2'   CD 12A5'              	CALL	SUB24
  14F5'   B4                    	ORA	H
  14F6'   B5                    	ORA	L
  14F7'   C2 03E9'              	JNZ	MKWIN
  14FA'   CD 0000*              	CALL	CUROFF
  14FD'   37                    	STC
  14FE'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  14FF'                         OPPGD:
  14FF'   47                    	MOV	B,A
  1500'   3A 2E56'              	LDA	OPCLSV
  1503'   FE 02                 	CPI	2
  1505'   C2 15C1'              	JNZ	OPG_NO
  1508'   3A 2E54'              	LDA	PSAVE
  150B'   FE 64                 	CPI	'd'
  150D'   C2 15C1'              	JNZ	OPG_NO
  1510'   04                    	INR	B
  1511'   CA 1520'              	JZ	OPG_FW
  1514'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  1517'   CD 063D'              	CALL	BOL		;   and the high end is OPSHI as it stands
  151A'   CD 0000*              	CALL	GOTO
  151D'   C3 1538'              	JMP	OPG_GO
  1520'                         OPG_FW:
  1520'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  1523'   CD 06D4'              	CALL	NLSTART		;   landed on, and the low one is where the
  1526'   11 2E62'              	LXI	D,OPSHI		;   start line began
  1529'   CD 14D5'              	CALL	OPE_ST
  152C'   21 2E5F'              	LXI	H,OPSLO
  152F'   CD 03DC'              	CALL	MKLOAD
  1532'   CD 03A9'              	CALL	MKPAGE
  1535'   CD 0000*              	CALL	GOTO
  1538'                         OPG_GO:
  1538'   CD 14DD'              	CALL	CURBD
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  153B'   2A 2E62'              	LHLD	OPSHI
  153E'   3A 2E64'              	LDA	OPSHI+2
  1541'   CD 12A5'              	CALL	SUB24		; A:HL = the bytes to take
  1544'                         OPG_SV:
  1544'   22 2E65'              	SHLD	OPTOGO
  1547'   32 2E67'              	STA	OPTOGO+2
  154A'                         OPG_NX:
  154A'   CD 0727'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  154D'   CD 0000*              	CALL	SUBHD
  1550'   EB                    	XCHG			; DE = what the window holds past the cursor
  1551'   2A 2E65'              	LHLD	OPTOGO
  1554'   3A 2E67'              	LDA	OPTOGO+2
  1557'   B7                    	ORA	A
  1558'   C2 158B'              	JNZ	OPG_PG		; 64K or more to go
  155B'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  155E'   DA 158B'              	JC	OPG_PG
  1561'   CA 158B'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  1564'                         OPG_FN:				; the rest of it is here
  1564'   E5                    	PUSH	H
  1565'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  1568'   CD 0000*              	CALL	CUROFF
  156B'   22 2E68'              	SHLD	OPLO
  156E'   D1                    	POP	D
  156F'   19                    	DAD	D
  1570'   22 2E6A'              	SHLD	OPHI
  1573'   CD 1785'              	CALL	OPDSPN
  1576'   CD 0B02'              	CALL	ATEOF
  1579'   D2 15DA'              	JNC	OPMID
  157C'   CD 11E2'              	CALL	ONFST		; deleted to the end of the file: onto the new
  157F'   CA 15DA'              	JZ	OPMID		;   last line, if there is one -- and the pager
  1582'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  1585'   CD 0000*              	CALL	SETBWD
  1588'   C3 15DA'              	JMP	OPMID
  158B'                         OPG_PG:
  158B'   7A                    	MOV	A,D
  158C'   B3                    	ORA	E
  158D'   C2 15A6'              	JNZ	OPG_DL
  1590'   CD 0B02'              	CALL	ATEOF		; nothing held past the cursor
  1593'   21 0000               	LXI	H,0
  1596'   DA 1564'              	JC	OPG_FN		; ... and no more to come: the file ran out
  1599'   2B                    	DCX	H
  159A'   CD 0000*              	CALL	SETC0
  159D'   CD 0000*              	CALL	GOLINE
  15A0'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  15A3'   C3 154A'              	JMP	OPG_NX
  15A6'                         OPG_DL:
  15A6'   D5                    	PUSH	D
  15A7'   21 FFFF               	LXI	H,0FFFFH
  15AA'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  15AD'   E1                    	POP	H
  15AE'   E5                    	PUSH	H
  15AF'   CD 0000*              	CALL	DELFWD
  15B2'   D1                    	POP	D
  15B3'   06 00                 	MVI	B,0
  15B5'   2A 2E65'              	LHLD	OPTOGO
  15B8'   3A 2E67'              	LDA	OPTOGO+2
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  15BB'   CD 12A5'              	CALL	SUB24
  15BE'   C3 1544'              	JMP	OPG_SV
  15C1'                         OPG_NO:
  15C1'   0E 07                 	MVI	C,BEL
  15C3'   CD 0000*              	CALL	BCONOU
  15C6'                         OPG_HM:				; the cursor back where the command found it
  15C6'   21 2E5C'              	LXI	H,OPSFP
  15C9'   CD 03DC'              	CALL	MKLOAD
  15CC'   CD 03A9'              	CALL	MKPAGE
  15CF'   CD 0000*              	CALL	GOTO
  15D2'   AF                    	XRA	A
  15D3'   32 2E54'              	STA	PSAVE
  15D6'   3C                    	INR	A
  15D7'   32 2EB6'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  15DA'                         OPMID:
  15DA'   CD 12D2'              	CALL	ZSAVE
  15DD'   C3 13A7'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  15E0'                         ONWHIT:
  15E0'   CD 0727'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  15E3'   CA 15FF'              	JZ	OW_YES
  15E6'   CD 0732'              	CALL	CURCHR		; A = the char under the cursor
  15E9'   FE 20                 	CPI	' '
  15EB'   CA 15FF'              	JZ	OW_YES
  15EE'   FE 09                 	CPI	TAB
  15F0'   CA 15FF'              	JZ	OW_YES
  15F3'   FE 0D                 	CPI	CR
  15F5'   CA 15FF'              	JZ	OW_YES
  15F8'   FE 0A                 	CPI	LF
  15FA'   CA 15FF'              	JZ	OW_YES
  15FD'   B7                    	ORA	A		; a char to change: CY clear
  15FE'   C9                    	RET
  15FF'                         OW_YES:
  15FF'   37                    	STC
  1600'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  1601'                         OPLINE:
  1601'   3A 2E54'              	LDA	PSAVE
  1604'   FE 63                 	CPI	'c'
  1606'   CA 0820'              	JZ	SETMOV
  1609'   FE 79                 	CPI	'y'
  160B'   CA 1B86'              	JZ	VY_YY
  160E'   21 2E5C'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1611'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1614'   C3 1AFC'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


                                ; is not an operator-usable motion (scan OPCTAB).
  1617'                         OPCLS:
  1617'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  1619'   CA 1626'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  161C'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  161E'   C2 163A'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1621'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1623'   C3 1628'              	JMP	OPC_FK
  1626'                         OPC_SEM:
  1626'   06 00                 	MVI	B,0		; ';' runs it as it stands
  1628'                         OPC_FK:
  1628'   3A 2EAC'              	LDA	FNDKND
  162B'   B7                    	ORA	A
  162C'   37                    	STC
  162D'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  162E'   A8                    	XRA	B		; ... and now the direction ',' asked for
  162F'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1631'   CA 1638'              	JZ	OPC_EXC
  1634'   3E 01                 	MVI	A,1
  1636'   B7                    	ORA	A		; CY clear: a motion, class 1
  1637'   C9                    	RET
  1638'                         OPC_EXC:
  1638'   AF                    	XRA	A		; class 0, CY clear
  1639'   C9                    	RET
  163A'                         OPC_TB:
  163A'   47                    	MOV	B,A
  163B'   21 181A'              	LXI	H,OPCTAB
  163E'                         OPC_LP:
  163E'   7E                    	MOV	A,M
  163F'   B7                    	ORA	A
  1640'   CA 1650'              	JZ	OPC_MS		; end of table -> not a motion
  1643'   B8                    	CMP	B
  1644'   CA 164C'              	JZ	OPC_HT
  1647'   23                    	INX	H
  1648'   23                    	INX	H
  1649'   C3 163E'              	JMP	OPC_LP
  164C'                         OPC_HT:
  164C'   23                    	INX	H
  164D'   7E                    	MOV	A,M		; class byte
  164E'   B7                    	ORA	A		; clear CY
  164F'   C9                    	RET
  1650'                         OPC_MS:
  1650'   37                    	STC
  1651'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  1652'                         OPAPPL:
  1652'   3A 2E56'              	LDA	OPCLSV
  1655'   FE 02                 	CPI	2
  1657'   CA 17EE'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  165A'   2A 2E58'              	LHLD	OPSTA
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  165D'   EB                    	XCHG			; DE = start
  165E'   2A 2E5A'              	LHLD	OPEND2		; HL = end
  1661'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  1664'   DA 1677'              	JC	OPA_F
  1667'   CA 1677'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  166A'   22 2E68'              	SHLD	OPLO
  166D'   EB                    	XCHG
  166E'   22 2E6A'              	SHLD	OPHI
  1671'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  1674'   C3 172E'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  1677'                         OPA_F:
  1677'   EB                    	XCHG			; HL = start, DE = end
  1678'   22 2E68'              	SHLD	OPLO
  167B'   EB                    	XCHG			; HL = end
  167C'   3A 2E56'              	LDA	OPCLSV
  167F'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1681'   CA 172B'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  1684'   FE 01                 	CPI	1
  1686'   C2 16A8'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  1689'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  168A'   22 2E6A'              	SHLD	OPHI		; park it: CEND clobbers DE
  168D'   2B                    	DCX	H		; the line it landed on
  168E'   CD 18D9'              	CALL	CEND		; HL = that line's content end
  1691'   EB                    	XCHG			; DE = it
  1692'   2A 2E6A'              	LHLD	OPHI		; HL = hi
  1695'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  1698'   D2 16B3'              	JNC	OPA_HI		; hi is inside the line: keep it
  169B'   2A 2E68'              	LHLD	OPLO
  169E'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  16A1'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  16A4'   EB                    	XCHG			; HL = the content end: the span stops there
  16A5'   C3 16B3'              	JMP	OPA_HI
  16A8'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  16A8'   22 2E6A'              	SHLD	OPHI
  16AB'   3A 2E2A'              	LDA	WPULL
  16AE'   B7                    	ORA	A
  16AF'   CA 172E'              	JZ	OPA_C1
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  16B2'   23                    	INX	H
  16B3'                         OPA_HI:
  16B3'   22 2E6A'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  16B6'                         OPA_DO:
  16B6'   CD 177A'              	CALL	OPSPNL
  16B9'   7C                    	MOV	A,H
  16BA'   B5                    	ORA	L
  16BB'   C2 16C4'              	JNZ	OPA_D1
  16BE'   2A 2E68'              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  16C1'   C3 0000*              	JMP	GOTO		;   to where the span starts
  16C4'                         OPA_D1:
  16C4'   3A 2E54'              	LDA	PSAVE
  16C7'   FE 63                 	CPI	'c'
  16C9'   CA 1785'              	JZ	OPDSPN
  16CC'   CD 176D'              	CALL	SPNBRK
  16CF'   D2 16F0'              	JNC	OPA_D2
  16D2'   2A 2E6A'              	LHLD	OPHI
  16D5'   CD 18D9'              	CALL	CEND
  16D8'   EB                    	XCHG			; DE = the content end of the line it ends in
  16D9'   2A 2E6A'              	LHLD	OPHI
  16DC'                         OPA_BL:
  16DC'   CD 0000*              	CALL	CMP16
  16DF'   CA 16F6'              	JZ	OPA_BI		; only blanks after it
  16E2'   D5                    	PUSH	D
  16E3'   E5                    	PUSH	H
  16E4'   CD 0000*              	CALL	CHARAT
  16E7'   E1                    	POP	H
  16E8'   D1                    	POP	D
  16E9'   23                    	INX	H
  16EA'   CD 1725'              	CALL	BLANKQ
  16ED'   CA 16DC'              	JZ	OPA_BL
  16F0'                         OPA_D2:
  16F0'   CD 1785'              	CALL	OPDSPN
  16F3'   C3 18EA'              	JMP	CLAMPE
  16F6'                         OPA_BI:
  16F6'   CD 1708'              	CALL	LOIND
  16F9'   C2 16F0'              	JNZ	OPA_D2
  16FC'   2A 2E6A'              	LHLD	OPHI
  16FF'   CD 06D4'              	CALL	NLSTART
  1702'   22 2E6A'              	SHLD	OPHI
  1705'   C3 1759'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  1708'                         LOIND:
  1708'   2A 2E68'              	LHLD	OPLO
  170B'   CD 063D'              	CALL	BOL
  170E'                         LI_LP:
  170E'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  170F'   EB                    	XCHG
  1710'   2A 2E68'              	LHLD	OPLO
  1713'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  1716'   E1                    	POP	H
  1717'   C8                    	RZ
  1718'   E5                    	PUSH	H
  1719'   CD 0000*              	CALL	CHARAT
  171C'   E1                    	POP	H
  171D'   23                    	INX	H
  171E'   CD 1725'              	CALL	BLANKQ
  1721'   CA 170E'              	JZ	LI_LP
  1724'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  1725'                         BLANKQ:
  1725'   FE 20                 	CPI	' '
  1727'   C8                    	RZ
  1728'   FE 09                 	CPI	TAB
  172A'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  172B'                         OPA_JP:
  172B'   22 2E6A'              	SHLD	OPHI
  172E'                         OPA_C1:
  172E'   CD 177A'              	CALL	OPSPNL
  1731'   7C                    	MOV	A,H
  1732'   B5                    	ORA	L
  1733'   CA 16B6'              	JZ	OPA_DO		; nothing spanned
  1736'   2A 2E6A'              	LHLD	OPHI
  1739'   CD 063D'              	CALL	BOL
  173C'   EB                    	XCHG
  173D'   2A 2E6A'              	LHLD	OPHI
  1740'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  1743'   C2 16B6'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  1746'   CD 1708'              	CALL	LOIND
  1749'   CA 1759'              	JZ	C1_LW		; only blanks before lo: whole lines
  174C'                         C1_CH:
  174C'   2A 2E6A'              	LHLD	OPHI		; back over the line break to the content end
  174F'   2B                    	DCX	H		;   of the line before
  1750'   CD 18D9'              	CALL	CEND
  1753'   22 2E6A'              	SHLD	OPHI
  1756'   C3 16B6'              	JMP	OPA_DO
  1759'                         C1_LW:
  1759'   2A 2E68'              	LHLD	OPLO
  175C'   CD 063D'              	CALL	BOL
  175F'   22 2E68'              	SHLD	OPLO
  1762'   3A 2E54'              	LDA	PSAVE
  1765'   FE 63                 	CPI	'c'
  1767'   CA 174C'              	JZ	C1_CH
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  176A'   C3 1801'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  176D'                         SPNBRK:
  176D'   2A 2E68'              	LHLD	OPLO
  1770'   CD 0680'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  1773'   EB                    	XCHG			; DE = it
  1774'   2A 2E6A'              	LHLD	OPHI
  1777'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  177A'                         OPSPNL:
  177A'   2A 2E6A'              	LHLD	OPHI
  177D'   EB                    	XCHG
  177E'   2A 2E68'              	LHLD	OPLO
  1781'   EB                    	XCHG			; HL = hi, DE = lo
  1782'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  1785'                         OPDSPN:
  1785'   CD 176D'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  1788'   F5                    	PUSH	PSW
  1789'   2A 2E68'              	LHLD	OPLO
  178C'   CD 0000*              	CALL	GOTO
  178F'   CD 177A'              	CALL	OPSPNL		; HL = hi - lo
  1792'   CD 0000*              	CALL	DELFWD
  1795'   CD 0174'              	CALL	MARKMOD
  1798'   F1                    	POP	PSW
  1799'   DA 085D'              	JC	SETFUL		; a break went: every row below it moved up
  179C'   C3 0826'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  179F'                         UNDFNB:
  179F'   CD 0000*              	CALL	CUROFF
  17A2'   E5                    	PUSH	H
  17A3'   CD 0919'              	CALL	FNBLNK
  17A6'   CD 0000*              	CALL	CUROFF
  17A9'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  17AA'   CD 0000*              	CALL	CMP16
  17AD'   D2 0000*              	JNC	UNDHER
  17B0'   EB                    	XCHG
  17B1'   CD 0000*              	CALL	GOTO
  17B4'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  17B7'                         OPALSP:
  17B7'   2A 2E58'              	LHLD	OPSTA
  17BA'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  17BB'   2A 2E5A'              	LHLD	OPEND2
  17BE'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  17C1'   DA 17D1'              	JC	OPAL_F
  17C4'   22 2E68'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  17C7'   EB                    	XCHG
  17C8'   22 2E6A'              	SHLD	OPHI		; hi-src = start
  17CB'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  17CE'   C3 17DB'              	JMP	OPAL_R
  17D1'                         OPAL_F:
  17D1'   EB                    	XCHG			; HL = start
  17D2'   22 2E68'              	SHLD	OPLO		; lo-src = start
  17D5'   2A 2E5A'              	LHLD	OPEND2
  17D8'   22 2E6A'              	SHLD	OPHI		; hi-src = end
  17DB'                         OPAL_R:
  17DB'   2A 2E68'              	LHLD	OPLO
  17DE'   CD 063D'              	CALL	BOL
  17E1'   22 2E68'              	SHLD	OPLO		; lo = BOL(low line)
  17E4'   2A 2E6A'              	LHLD	OPHI
  17E7'   CD 06D4'              	CALL	NLSTART
  17EA'   22 2E6A'              	SHLD	OPHI		; hi = start of line past the high line
  17ED'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  17EE'                         OPALIN:
  17EE'   CD 17B7'              	CALL	OPALSP
  17F1'   2A 2E68'              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  17F4'   CD 06D4'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  17F7'   EB                    	XCHG			;   the column)
  17F8'   2A 2E6A'              	LHLD	OPHI
  17FB'   CD 0000*              	CALL	CMP16
  17FE'   CC 179F'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  1801'                         OPDLIN:
  1801'   CD 1785'              	CALL	OPDSPN
  1804'   CD 0727'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1807'   DA 1817'              	JC	OPDL_NB
  180A'   CD 0000*              	CALL	LOGLEN
  180D'   7C                    	MOV	A,H
  180E'   B5                    	ORA	L
  180F'   C8                    	RZ			; empty buffer
  1810'   2B                    	DCX	H
  1811'   CD 063D'              	CALL	BOL
  1814'   CD 0000*              	CALL	GOTO
  1817'                         OPDL_NB:
  1817'   C3 0919'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  181A'                         OPCTAB:
  181A'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  181E'   62 00 42 00           
  1822'   68 00 6C 00           
  1826'   30 00 5E 00           
  182A'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  182C'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1830'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1834'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1838'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  183C'   24 01                 
  183E'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1842'   47 02 48 02           
  1846'   4D 02 4C 02           
  184A'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  184C'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  184E'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  184F'                         VCB_C:
  184F'   CD 185B'              	CALL	VCB_CD
  1852'   C3 195B'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  1855'                         VCB_D:
  1855'   CD 185B'              	CALL	VCB_CD
  1858'   C3 18EA'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  185B'                         VCB_CD:
  185B'   CD 073E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  185E'   22 2E68'              	SHLD	OPLO
  1861'   CD 0000*              	CALL	CUROFF
  1864'   CD 18D9'              	CALL	CEND		; to the line's content end, the CR,LF left
  1867'   22 2E6A'              	SHLD	OPHI
  186A'   C3 1785'              	JMP	OPDSPN
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  186D'                         VC_X:
  186D'   CD 09CB'              	CALL	GLSTAL
  1870'   CD 0826'              	CALL	SETLIN
  1873'   CD 074B'              	CALL	GETCNT
  1876'   22 2E6C'              	SHLD	CNTV
  1879'   CD 0000*              	CALL	CUROFF
  187C'   22 2E70'              	SHLD	WKI		; cur
  187F'   CD 18D9'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  1882'   EB                    	XCHG			; DE = contentend
  1883'   2A 2E70'              	LHLD	WKI		; HL = cur
  1886'   EB                    	XCHG			; HL = contentend, DE = cur
  1887'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  188A'   7C                    	MOV	A,H
  188B'   B5                    	ORA	L
  188C'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  188D'   EB                    	XCHG			; DE = available
  188E'   2A 2E6C'              	LHLD	CNTV		; HL = count
  1891'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  1894'   DA 189A'              	JC	VX_USEA
  1897'   C3 189B'              	JMP	VX_DEL		; count <= available -> HL = count = del
  189A'                         VX_USEA:
  189A'   EB                    	XCHG			; HL = available
  189B'                         VX_DEL:
                                	;--- plain chars, and plain chars after them: the terminal can close
                                	;    the cells up itself (R_DCH).  A TAB there would change width. ---
  189B'   E5                    	PUSH	H
  189C'   CD 0863'              	CALL	TAILTAB
  189F'   E1                    	POP	H
  18A0'   47                    	MOV	B,A
  18A1'   7C                    	MOV	A,H		; (more of them than a byte counts)
  18A2'   B7                    	ORA	A
  18A3'   C2 18D0'              	JNZ	VX_D1
  18A6'   7D                    	MOV	A,L
  18A7'   32 2E23'              	STA	DCHN
  18AA'   78                    	MOV	A,B
  18AB'   87                    	ADD	A
  18AC'   32 2E24'              	STA	DCHBS		; 2: a TAB follows, to take the cells up
  18AF'   CA 18CB'              	JZ	VX_D0
  18B2'   7D                    	MOV	A,L		; ... if it is past what goes, and can
  18B3'   FE 08                 	CPI	8
  18B5'   D2 18D0'              	JNC	VX_D1
  18B8'   E5                    	PUSH	H
  18B9'   2A 2E70'              	LHLD	WKI
  18BC'   EB                    	XCHG
  18BD'   2A 2E6E'              	LHLD	TTI
  18C0'   CD 0000*              	CALL	SUBHD
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  18C3'   EB                    	XCHG			; DE = the chars before it
  18C4'   E1                    	POP	H
  18C5'   CD 0000*              	CALL	CMP16
  18C8'   DA 18D0'              	JC	VX_D1
  18CB'                         VX_D0:
  18CB'   3E 07                 	MVI	A,R_DCH
  18CD'   32 2E20'              	STA	RINTENT
  18D0'                         VX_D1:
  18D0'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  18D3'   CD 0174'              	CALL	MARKMOD
  18D6'   C3 18EA'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  18D9'                         CEND:
  18D9'   CD 0680'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  18DC'   7C                    	MOV	A,H
  18DD'   B5                    	ORA	L
  18DE'   C8                    	RZ			; the start of the text: nothing before it
  18DF'   2B                    	DCX	H
  18E0'   E5                    	PUSH	H
  18E1'   CD 0000*              	CALL	CHARAT
  18E4'   E1                    	POP	H		; HL = term-1
  18E5'   FE 0D                 	CPI	CR
  18E7'   C8                    	RZ			; a CR before the LF -> the content ends there
  18E8'   23                    	INX	H
  18E9'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  18EA'                         CLAMPE:
  18EA'   CD 0000*              	CALL	CUROFF
  18ED'   E5                    	PUSH	H
  18EE'   CD 06E3'              	CALL	EOLC
  18F1'   D1                    	POP	D		; DE = cur
  18F2'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  18F5'   D8                    	RC
  18F6'   C8                    	RZ
  18F7'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  18FA'                         VC_I:
  18FA'   CD 074B'              	CALL	GETCNT
  18FD'   C3 1958'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1900'                         VC_A:
  1900'   CD 074B'              	CALL	GETCNT
  1903'   CD 0727'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1906'   CA 191D'              	JZ	VA_INS
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  1909'   EB                    	XCHG			; HL = cur
  190A'   E5                    	PUSH	H
  190B'   CD 0000*              	CALL	CHARAT
  190E'   E1                    	POP	H
  190F'   FE 0A                 	CPI	LF
  1911'   CA 191D'              	JZ	VA_INS		; on the line terminator -> append in place
  1914'   FE 0D                 	CPI	CR
  1916'   CA 191D'              	JZ	VA_INS
  1919'   23                    	INX	H
  191A'   CD 0000*              	CALL	GOTO
  191D'                         VA_INS:
  191D'   C3 1958'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1920'                         VCB_A:
  1920'   CD 073E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1923'   CD 06E3'              	CALL	EOLC		; HL = last content char (the start when empty)
  1926'   E5                    	PUSH	H
  1927'   CD 0000*              	CALL	CHARAT
  192A'   E1                    	POP	H
  192B'   FE 0D                 	CPI	CR
  192D'   CA 1936'              	JZ	VBA_IN		; an empty line: insert at its start
  1930'   FE 0A                 	CPI	LF
  1932'   CA 1936'              	JZ	VBA_IN
  1935'   23                    	INX	H		; past the last content char
  1936'                         VBA_IN:
  1936'   CD 0000*              	CALL	GOTO
  1939'   C3 1958'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  193C'                         VCB_I:
  193C'   CD 074B'              	CALL	GETCNT
  193F'   CD 0919'              	CALL	FNBLNK
  1942'   CD 0000*              	CALL	CUROFF
  1945'   E5                    	PUSH	H
  1946'   CD 0000*              	CALL	CHARAT
  1949'   E1                    	POP	H
  194A'   FE 20                 	CPI	' '
  194C'   CA 1954'              	JZ	VBI_SK
  194F'   FE 09                 	CPI	TAB
  1951'   C2 1958'              	JNZ	SETINM
  1954'                         VBI_SK:
  1954'   23                    	INX	H		; blanks only: past the last of them
  1955'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


                                ; span has already said what it changed.
  1958'                         SETINM:
  1958'   CD 0820'              	CALL	SETMOV
  195B'                         SETINS:
  195B'   3E 01                 	MVI	A,EM_INS
  195D'   32 2E1B'              	STA	EDMODE
  1960'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1961'                         ATCEND:
  1961'   CD 0727'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1964'   C8                    	RZ
  1965'   CD 0732'              	CALL	CURCHR		; A = the char under the cursor
  1968'   FE 0D                 	CPI	CR
  196A'   C8                    	RZ
  196B'   FE 0A                 	CPI	LF
  196D'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  196E'                         OPNBRK:
  196E'   CD 2298'              	CALL	PUTBRK
  1971'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1974'   23                    	INX	H
  1975'   22 0000*              	SHLD	LNDLT
  1978'   C3 0174'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  197B'                         ENDBRK:
  197B'   CD 0727'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  197E'   C0                    	RNZ
  197F'   CD 196E'              	CALL	OPNBRK
  1982'   CD 0000*              	CALL	CUROFF
  1985'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1986'   2B                    	DCX	H		;   line, with its own terminator after it
  1987'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  198A'                         VC_O:
  198A'   CD 073E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  198D'   CD 18D9'              	CALL	CEND
  1990'   CD 0000*              	CALL	GOTO
  1993'   CD 196E'              	CALL	OPNBRK
  1996'   CD 197B'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1999'   CD 0848'              	CALL	SETILN		;   needs a terminator of its own to exist
  199C'   C3 195B'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  199F'                         VCB_O:
  199F'   CD 073E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  19A2'   CD 063D'              	CALL	BOL
  19A5'   CD 0000*              	CALL	GOTO
  19A8'   CD 196E'              	CALL	OPNBRK
  19AB'   CD 0000*              	CALL	CUROFF
  19AE'   2B                    	DCX	H
  19AF'   2B                    	DCX	H
  19B0'   CD 0000*              	CALL	GOTO
  19B3'   CD 0848'              	CALL	SETILN
  19B6'   C3 195B'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  19B9'                         VCB_J:
  19B9'   CD 073E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  19BC'   CD 18D9'              	CALL	CEND		; the join point: this line's content end
  19BF'   22 2E68'              	SHLD	OPLO
  19C2'   CD 0000*              	CALL	CUROFF
  19C5'   CD 06D4'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  19C8'   E5                    	PUSH	H
  19C9'   CD 0000*              	CALL	LOGLEN
  19CC'   D1                    	POP	D		; DE = that start
  19CD'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  19D0'   CA 0820'              	JZ	SETMOV
  19D3'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  19D4'                         VJ_WS:
  19D4'   E5                    	PUSH	H
  19D5'   CD 0000*              	CALL	LOGLEN
  19D8'   D1                    	POP	D		; DE = the scan
  19D9'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  19DC'   CA 19F3'              	JZ	VJ_DEL
  19DF'   EB                    	XCHG			; HL = the scan
  19E0'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  19E1'   CD 0000*              	CALL	CHARAT
  19E4'   E1                    	POP	H
  19E5'   FE 20                 	CPI	' '
  19E7'   CA 19EF'              	JZ	VJ_SKIP
  19EA'   FE 09                 	CPI	TAB
  19EC'   C2 19F3'              	JNZ	VJ_DEL
  19EF'                         VJ_SKIP:
  19EF'   23                    	INX	H
  19F0'   C3 19D4'              	JMP	VJ_WS
  19F3'                         VJ_DEL:
  19F3'   22 2E6A'              	SHLD	OPHI
  19F6'   CD 1785'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  19F9'   CD 0857'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  19FC'   CD 0727'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  19FF'   CA 18EA'              	JZ	CLAMPE
  1A02'   CD 0732'              	CALL	CURCHR		; the first char of what was appended
  1A05'   FE 0D                 	CPI	CR
  1A07'   CA 18EA'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1A0A'   FE 0A                 	CPI	LF
  1A0C'   CA 18EA'              	JZ	CLAMPE
  1A0F'   FE 29                 	CPI	')'
  1A11'   CA 18EA'              	JZ	CLAMPE		; vim puts no space before a ')'
  1A14'   CD 0000*              	CALL	CUROFF
  1A17'   7C                    	MOV	A,H
  1A18'   B5                    	ORA	L
  1A19'   CA 1A2F'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1A1C'   2B                    	DCX	H
  1A1D'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1A20'   FE 20                 	CPI	' '
  1A22'   CA 18EA'              	JZ	CLAMPE
  1A25'   FE 09                 	CPI	TAB
  1A27'   CA 18EA'              	JZ	CLAMPE
  1A2A'   FE 0A                 	CPI	LF
  1A2C'   CA 18EA'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1A2F'                         VJ_SP:
  1A2F'   3E 20                 	MVI	A,' '
  1A31'   CD 0000*              	CALL	PUTGAP
  1A34'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1A37'   2B                    	DCX	H
  1A38'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1A3B'                         VC_TILD:
  1A3B'   CD 074B'              	CALL	GETCNT
  1A3E'   CD 0826'              	CALL	SETLIN		; only this row changes
  1A41'   CD 09CB'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1A44'   CD 0727'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1A47'   CA 0820'              	JZ	SETMOV
  1A4A'   CD 0732'              	CALL	CURCHR		; A = the char under the cursor
  1A4D'   FE 0D                 	CPI	CR
  1A4F'   CA 0820'              	JZ	SETMOV		; the line's end: nothing to toggle
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1A52'   FE 0A                 	CPI	LF
  1A54'   CA 0820'              	JZ	SETMOV
  1A57'   47                    	MOV	B,A
  1A58'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1A5A'   FE 41                 	CPI	'A'
  1A5C'   DA 1A68'              	JC	VT_PUT		; below 'A': no case
  1A5F'   FE 5B                 	CPI	'Z'+1
  1A61'   D2 1A68'              	JNC	VT_PUT		; above 'Z': no case
  1A64'   78                    	MOV	A,B
  1A65'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1A67'   47                    	MOV	B,A
  1A68'                         VT_PUT:
  1A68'   78                    	MOV	A,B
  1A69'   32 2E77'              	STA	VRCH		; the calls below do not preserve B
  1A6C'   CD 0174'              	CALL	MARKMOD
  1A6F'   21 0001               	LXI	H,1
  1A72'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1A75'   3A 2E77'              	LDA	VRCH
  1A78'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1A7B'   C3 18EA'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  1A7E'                         VC_R:
  1A7E'   CD 0738'              	CALL	MOVCNT		; a cursor motion, and its count
  1A81'   3E 03                 	MVI	A,PR
  1A83'   32 2E51'              	STA	GPEND
  1A86'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1A87'                         VR_DO:
  1A87'   AF                    	XRA	A
  1A88'   32 2E51'              	STA	GPEND
  1A8B'   79                    	MOV	A,C
  1A8C'   32 2E77'              	STA	VRCH		; the calls below do not preserve C
  1A8F'   CD 0826'              	CALL	SETLIN		; only this row changed
  1A92'   CD 09CB'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1A95'   CD 0727'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1A98'   CA 0820'              	JZ	SETMOV		; the end of the text: vim does nothing
  1A9B'   CD 0732'              	CALL	CURCHR		; A = the char under the cursor
  1A9E'   FE 0D                 	CPI	CR
  1AA0'   CA 0820'              	JZ	SETMOV		; the line's end: nothing to replace
  1AA3'   FE 0A                 	CPI	LF
  1AA5'   CA 0820'              	JZ	SETMOV
  1AA8'   06 02                 	MVI	B,2		; a cell for a cell: the char is the paint
  1AAA'   CD 082C'              	CALL	SETCEL
  1AAD'   CD 0174'              	CALL	MARKMOD
  1AB0'   21 0001               	LXI	H,1
  1AB3'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1AB6'   3A 2E77'              	LDA	VRCH
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1AB9'   FE 0D                 	CPI	CR
  1ABB'   CA 1AC8'              	JZ	VR_CR
  1ABE'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1AC1'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1AC4'   2B                    	DCX	H		;   out, which moves every logical offset
  1AC5'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1AC8'                         VR_CR:
  1AC8'   CD 196E'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1ACB'   CD 197B'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1ACE'   CD 0848'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1AD1'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1AD3'   32 2E26'              	STA	ILABOV
  1AD6'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1AD7'                         VCB_R:
  1AD7'   CD 074B'              	CALL	GETCNT
  1ADA'   CD 0820'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1ADD'   21 0000               	LXI	H,0
  1AE0'   22 2E78'              	SHLD	RPDEL		; nothing of ours to put back yet
  1AE3'   22 2E7A'              	SHLD	RPAPP
  1AE6'   3E 02                 	MVI	A,EM_REP
  1AE8'   32 2E1B'              	STA	EDMODE
  1AEB'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1AEC'                         VC_D:
  1AEC'   3E 64                 	MVI	A,'d'
  1AEE'   32 2E53'              	STA	PENDOP
  1AF1'   C3 0820'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1AF4'                         VC_C:
  1AF4'   3E 63                 	MVI	A,'c'
  1AF6'   32 2E53'              	STA	PENDOP
  1AF9'   C3 0820'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1AFC'                         VD_DD:
  1AFC'   CD 09CB'              	CALL	GLSTAL
  1AFF'   CD 074B'              	CALL	GETCNT
  1B02'   22 2E6C'              	SHLD	CNTV
  1B05'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1B07'   32 2E55'              	STA	DDSNG
  1B0A'   2B                    	DCX	H
  1B0B'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1B0C'   B5                    	ORA	L
  1B0D'   C2 1B1B'              	JNZ	VDD_LS
  1B10'   3E 01                 	MVI	A,1
  1B12'   32 2E55'              	STA	DDSNG
  1B15'   CD 179F'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1B18'   C3 1B21'              	JMP	VDD_GO
  1B1B'                         VDD_LS:
  1B1B'   CD 0984'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1B1E'   DA 0820'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1B21'                         VDD_GO:
  1B21'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1B24'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1B27'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1B2A'   CD 24FB'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1B2D'   CD 0902'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1B30'   2A 2E6C'              	LHLD	CNTV
  1B33'   CD 0000*              	CALL	SETC0
  1B36'                         VDD_FW:
  1B36'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1B39'   DA 1C87'              	JC	QREFUS		; ... which has no room for them
  1B3C'   CD 0760'              	CALL	CNTTST
  1B3F'   C2 1B36'              	JNZ	VDD_FW
  1B42'   CD 0174'              	CALL	MARKMOD
  1B45'   CD 0B02'              	CALL	ATEOF
  1B48'   D2 1B63'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1B4B'   3E 00                 	MVI	A,0
  1B4D'   32 2E55'              	STA	DDSNG		; deleted to the end: full repaint
  1B50'   CD 11E2'              	CALL	ONFST
  1B53'   CA 0919'              	JZ	FNBLNK		; nothing left before it
  1B56'   21 0001               	LXI	H,1		; onto the new last line
  1B59'   CD 0000*              	CALL	SETBWD
  1B5C'   2A 0000*              	LHLD	LNDLT
  1B5F'   2B                    	DCX	H
  1B60'   22 0000*              	SHLD	LNDLT
  1B63'                         VDD_UP:
  1B63'   CD 0919'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1B66'   3A 2E55'              	LDA	DDSNG
  1B69'   B7                    	ORA	A
  1B6A'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1B6B'   3E 03                 	MVI	A,R_DLIN
  1B6D'   32 2E20'              	STA	RINTENT
  1B70'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1B71'                         QEMPTY:
  1B71'   2A 0000*              	LHLD	QBEG
  1B74'   EB                    	XCHG
  1B75'   2A 0000*              	LHLD	QEND
  1B78'   7C                    	MOV	A,H
  1B79'   BA                    	CMP	D
  1B7A'   C0                    	RNZ
  1B7B'   7D                    	MOV	A,L
  1B7C'   BB                    	CMP	E
  1B7D'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1B7E'                         VC_Y:
  1B7E'   3E 79                 	MVI	A,'y'
  1B80'   32 2E53'              	STA	PENDOP
  1B83'   C3 0820'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1B86'                         VY_YY:
  1B86'   21 2E5C'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1B89'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1B8C'   CD 0000*              	CALL	CUROFF
  1B8F'   22 2E9B'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1B92'   CD 063D'              	CALL	BOL
  1B95'   22 2E9D'              	SHLD	YPT		; where the lines come from, to put them back
  1B98'   CD 1CED'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1B9B'   CD 1D30'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1B9E'   D2 1CF4'              	JNC	YNDONE
  1BA1'   21 1AFC'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1BA4'   C3 1BD0'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1BA7'                         OPYANK:
  1BA7'   CD 17B7'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1BAA'   2A 2E58'              	LHLD	OPSTA
  1BAD'   EB                    	XCHG			; DE = start
  1BAE'   2A 2E5A'              	LHLD	OPEND2		; HL = end
  1BB1'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1BB4'   D2 1BB8'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1BB7'   EB                    	XCHG			; ... otherwise the start is
  1BB8'                         OPY_LO:
  1BB8'   22 2E9B'              	SHLD	YOFF
  1BBB'   2A 2E68'              	LHLD	OPLO
  1BBE'   22 2E9D'              	SHLD	YPT		; where the lines come from, to put them back
  1BC1'   CD 1CED'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1BC4'   CD 1DA8'              	CALL	YNSPAN		; copied where they lie, if there is room
  1BC7'   D2 1CF4'              	JNC	YNDONE
  1BCA'   21 1CAE'              	LXI	H,YSPAN
  1BCD'   C3 1BD0'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1BD0'                         YKGO:
  1BD0'   22 2EC5'              	SHLD	YACT
  1BD3'   2A 2E9D'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1BD6'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1BD7'   2A 2E9B'              	LHLD	YOFF		;   survive this -- the put-back below can page
  1BDA'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1BDD'   22 2ECB'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1BE0'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1BE3'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1BE4'   2A 2E9D'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1BE7'   EB                    	XCHG			;   window as it was, then names other text
  1BE8'   E1                    	POP	H
  1BE9'   CD 0000*              	CALL	SUBHD
  1BEC'   EB                    	XCHG			; DE = how far behind the cursor they start
  1BED'   CD 12AF'              	CALL	CURFP
  1BF0'   06 00                 	MVI	B,0
  1BF2'   CD 12A5'              	CALL	SUB24
  1BF5'   22 2ECD'              	SHLD	YPFP
  1BF8'   32 2ECF'              	STA	YPFP+2
  1BFB'   3A 2E1F'              	LDA	MODF
  1BFE'   32 2E98'              	STA	YMODF
  1C01'   3A 2E46'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1C04'   32 2E99'              	STA	YDCHG		;   a yank must not become the last change
  1C07'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1C0A'   32 2E9A'              	STA	YURPL		;   back are not a change to undo either
  1C0D'   3E 01                 	MVI	A,1
  1C0F'   32 0000*              	STA	UNDRPL
  1C12'   32 2EC4'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1C15'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1C18'   22 2EA7'              	SHLD	YLDLT
  1C1B'   CD 0000*              	CALL	LOGLEN
  1C1E'   22 2EC9'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


                                				;   took lines from one that took none
  1C21'   2A 2EC5'              	LHLD	YACT
  1C24'   CD 1C86'              	CALL	YCALL		; the lines out of the file, into the register
  1C27'   3A 2E93'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1C2A'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1C2C'   CA 1C6A'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1C2F'   CD 0000*              	CALL	LOGLEN
  1C32'   EB                    	XCHG
  1C33'   2A 2EC9'              	LHLD	YWAS
  1C36'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1C39'   CA 1C4B'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1C3C'   21 2ECD'              	LXI	H,YPFP		; back to where they came from, by its place in
  1C3F'   CD 03DC'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1C42'   CD 03A9'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1C45'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1C48'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1C4B'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1C4B'   2A 2ECD'              	LHLD	YPFP		;   cursor is still owed its place)
  1C4E'   EB                    	XCHG
  1C4F'   2A 2ECB'              	LHLD	YCOL
  1C52'   19                    	DAD	D
  1C53'   22 2EC0'              	SHLD	MKPOS
  1C56'   3A 2ECF'              	LDA	YPFP+2
  1C59'   CE 00                 	ACI	0
  1C5B'   32 2EC2'              	STA	MKPOS+2
  1C5E'   CD 03A9'              	CALL	MKPAGE
  1C61'   CD 0000*              	CALL	GOTO
  1C64'                         YK_RST:
  1C64'   2A 2EA7'              	LHLD	YLDLT
  1C67'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1C6A'                         YK_RF:
  1C6A'   3A 2E98'              	LDA	YMODF
  1C6D'   32 2E1F'              	STA	MODF
  1C70'   3A 2E99'              	LDA	YDCHG
  1C73'   32 2E46'              	STA	DOTCHG
  1C76'   3A 2E9A'              	LDA	YURPL
  1C79'   32 0000*              	STA	UNDRPL
  1C7C'   AF                    	XRA	A
  1C7D'   32 2EC4'              	STA	MKHOLD
  1C80'   CD 09CB'              	CALL	GLSTAL
  1C83'   C3 085D'              	JMP	SETFUL		; the cheap paint cannot carry this
  1C86'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1C87'                         QREFUS:
  1C87'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1C8A'   CD 1B71'              	CALL	QEMPTY
  1C8D'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1C90'   CD 0000*              	CALL	QKILL
  1C93'   3A 2EC4'              	LDA	MKHOLD
  1C96'   B7                    	ORA	A
  1C97'   C2 1CA6'              	JNZ	QRF_Y
  1C9A'   21 0000*              	LXI	H,MKSAV
  1C9D'   11 0000*              	LXI	D,MKTAB
  1CA0'   CD 24FB'              	CALL	COPY12
  1CA3'   CD 0000*              	CALL	UNDCLR
  1CA6'                         QRF_Y:
  1CA6'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1CA8'   32 2E93'              	STA	MSGWHT
  1CAB'   C3 15C6'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1CAE'                         YSPAN:
  1CAE'   CD 09CB'              	CALL	GLSTAL
  1CB1'   CD 177A'              	CALL	OPSPNL		; HL = the span's length
  1CB4'   22 2EC7'              	SHLD	YTGT
  1CB7'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  1CBA'   EB                    	XCHG			; DE = it
  1CBB'   2A 2EC7'              	LHLD	YTGT
  1CBE'   EB                    	XCHG			; HL = the text's, DE = the span's
  1CBF'   CD 0000*              	CALL	SUBHD
  1CC2'   22 2EC7'              	SHLD	YTGT		; what the text is left at when the span is out
  1CC5'   2A 2E68'              	LHLD	OPLO
  1CC8'   CD 0000*              	CALL	GOTO
  1CCB'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1CCE'                         YS_LP:
  1CCE'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1CD1'   CD 0000*              	CALL	SETC0
  1CD4'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1CD7'   DA 1C87'              	JC	QREFUS		; ... which has no room for it
  1CDA'   CD 0000*              	CALL	LOGLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1CDD'   EB                    	XCHG			; DE = what is left
  1CDE'   2A 2EC7'              	LHLD	YTGT
  1CE1'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1CE4'   DA 1CEA'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1CE7'   C2 1CCE'              	JNZ	YS_LP		;   but never spin here if it ever did
  1CEA'                         YS_END:
  1CEA'   C3 0174'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1CED'                         YNPRE:
  1CED'   2A 0000*              	LHLD	PGTOPM
  1CF0'   22 2ED0'              	SHLD	YNPG
  1CF3'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1CF4'                         YNDONE:
  1CF4'   2A 2E9B'              	LHLD	YOFF
  1CF7'   CD 0000*              	CALL	GOTO
  1CFA'   2A 0000*              	LHLD	PGTOPM
  1CFD'   EB                    	XCHG
  1CFE'   2A 2ED0'              	LHLD	YNPG
  1D01'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1D04'   C2 085D'              	JNZ	SETFUL		; it moved under us: repaint after all
  1D07'   C3 0820'              	JMP	SETMOV		; nothing on the screen changed
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1D0A'                         YNROOM:
  1D0A'   11 0100               	LXI	D,100H
  1D0D'   19                    	DAD	D
  1D0E'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1D0F'   E5                    	PUSH	H		; the span plus its slack
  1D10'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1D13'   EB                    	XCHG			; HL = free
  1D14'   D1                    	POP	D		; DE = the span plus its slack
  1D15'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1D18'   DA 1D20'              	JC	YNR_OK
  1D1B'   CA 1D20'              	JZ	YNR_OK
  1D1E'   37                    	STC			; not enough: the delete-and-put-back path
  1D1F'   C9                    	RET
  1D20'                         YNR_OK:
  1D20'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1D21'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1D22'                         YNGO:
  1D22'   C5                    	PUSH	B
  1D23'   CD 074B'              	CALL	GETCNT		; spent here: this yank is happening
  1D26'   CD 09CB'              	CALL	GLSTAL
  1D29'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1D2C'   C1                    	POP	B
  1D2D'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1D30'                         YNCOPY:
  1D30'   2A 2E1C'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1D33'   7C                    	MOV	A,H		;   the count itself
  1D34'   B5                    	ORA	L
  1D35'   C2 1D3B'              	JNZ	YNC_HV
  1D38'   21 0001               	LXI	H,1
  1D3B'                         YNC_HV:
  1D3B'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1D3C'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1D3D'   B4                    	ORA	H
  1D3E'   CA 1D49'              	JZ	YNC_M
  1D41'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1D42'   CD 0984'              	CALL	ONLAST		; vim: a count over one on the last line does
  1D45'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1D46'   DA 1D5B'              	JC	YNC_RF
  1D49'                         YNC_M:
  1D49'   E5                    	PUSH	H
  1D4A'   CD 0902'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1D4D'   E1                    	POP	H
  1D4E'   CD 1D63'              	CALL	YNLINE		; BC = the span, measured where it stands
  1D51'   D8                    	RC			; not measurable here: let the pager answer it
  1D52'   60                    	MOV	H,B
  1D53'   69                    	MOV	L,C
  1D54'   CD 1D0A'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1D57'   D8                    	RC			; no: the delete-and-put-back path
  1D58'   C3 1D22'              	JMP	YNGO
  1D5B'                         YNC_RF:
  1D5B'   CD 074B'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1D5E'   CD 09CB'              	CALL	GLSTAL		;   register alone, and that is the command
  1D61'   B7                    	ORA	A		; NC: done
  1D62'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1D63'                         YNLINE:
  1D63'   22 2ED2'              	SHLD	YNCNT		; the lines it still wants
  1D66'   2A 0000*              	LHLD	GAPEND
  1D69'                         YNL_LP:
  1D69'   EB                    	XCHG			; DE = the scan
  1D6A'   2A 0000*              	LHLD	TXTEND
  1D6D'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1D70'   EB                    	XCHG			; HL = the scan
  1D71'   D2 1D91'              	JNC	YNL_EN		; the resident text ran out
  1D74'   7E                    	MOV	A,M
  1D75'   23                    	INX	H
  1D76'   FE 0A                 	CPI	LF
  1D78'   C2 1D69'              	JNZ	YNL_LP
  1D7B'   E5                    	PUSH	H
  1D7C'   2A 2ED2'              	LHLD	YNCNT
  1D7F'   2B                    	DCX	H
  1D80'   22 2ED2'              	SHLD	YNCNT
  1D83'   7C                    	MOV	A,H
  1D84'   B5                    	ORA	L
  1D85'   E1                    	POP	H
  1D86'   C2 1D69'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1D89'   EB                    	XCHG			; DE = past the last of them
  1D8A'   2A 0000*              	LHLD	GAPEND
  1D8D'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1D8E'   C3 1D9F'              	JMP	YNL_BC
  1D91'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1D91'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1D94'   C2 1DA6'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1D97'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1D9A'   EB                    	XCHG			;   count clamps to it as vim's does
  1D9B'   2A 0000*              	LHLD	GAPEND
  1D9E'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1D9F'                         YNL_BC:
  1D9F'   CD 0000*              	CALL	SUBHD		; HL = the span
  1DA2'   44                    	MOV	B,H
  1DA3'   4D                    	MOV	C,L
  1DA4'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1DA5'   C9                    	RET
  1DA6'                         YNL_NO:
  1DA6'   37                    	STC
  1DA7'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1DA8'                         YNSPAN:
  1DA8'   CD 177A'              	CALL	OPSPNL		; HL = the span's length
  1DAB'   44                    	MOV	B,H
  1DAC'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1DAD'   CD 1D0A'              	CALL	YNROOM
  1DB0'   D8                    	RC			; no room: the delete-and-put-back path
  1DB1'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1DB2'   2A 2E68'              	LHLD	OPLO
  1DB5'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1DB8'   C1                    	POP	B
  1DB9'   C3 1D22'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1DBC'                         VC_P:
  1DBC'   CD 1B71'              	CALL	QEMPTY
  1DBF'   CA 1E92'              	JZ	VP_BEL
  1DC2'   CD 074B'              	CALL	GETCNT
  1DC5'   22 2E9F'              	SHLD	PCNT
  1DC8'   CD 0000*              	CALL	CUROFF
  1DCB'   CD 06D4'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1DCE'   C3 1DE3'              	JMP	VP_GO
  1DD1'                         VCB_P:
  1DD1'   CD 1B71'              	CALL	QEMPTY
  1DD4'   CA 1E92'              	JZ	VP_BEL
  1DD7'   CD 074B'              	CALL	GETCNT
  1DDA'   22 2E9F'              	SHLD	PCNT
  1DDD'   CD 0000*              	CALL	CUROFF
  1DE0'   CD 063D'              	CALL	BOL
  1DE3'                         VP_GO:
  1DE3'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1DE6'   CD 0000*              	CALL	CUROFF
  1DE9'   EB                    	XCHG
  1DEA'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1DED'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1DF0'   DA 1E05'              	JC	VP_IN
  1DF3'   EB                    	XCHG			; HL = the put point = LOGLEN
  1DF4'   7C                    	MOV	A,H
  1DF5'   B5                    	ORA	L
  1DF6'   CA 1E02'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1DF9'   2B                    	DCX	H
  1DFA'   CD 0000*              	CALL	CHARAT
  1DFD'   FE 0A                 	CPI	LF
  1DFF'   CA 1E05'              	JZ	VP_IN
  1E02'                         VP_BRK:
  1E02'   CD 196E'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1E05'                         VP_IN:
  1E05'   21 2EA1'              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1E08'   CD 0429'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1E0B'   CD 12F8'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1E0E'   2A 0000*              	LHLD	QBEG
  1E11'   EB                    	XCHG
  1E12'   2A 0000*              	LHLD	QEND
  1E15'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1E18'   EB                    	XCHG
  1E19'   22 2EA4'              	SHLD	PLFS
  1E1C'   2A 2E9F'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1E1F'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1E20'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1E21'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1E23'   C2 1E27'              	JNZ	VP_PZ
  1E26'   7D                    	MOV	A,L
  1E27'                         VP_PZ:
  1E27'   32 2EA6'              	STA	PCPY
  1E2A'                         VP_LP:
  1E2A'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1E2D'   2A 0000*              	LHLD	LNDLT
  1E30'   EB                    	XCHG
  1E31'   2A 2EA4'              	LHLD	PLFS
  1E34'   19                    	DAD	D
  1E35'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1E38'   2A 2E9F'              	LHLD	PCNT
  1E3B'   2B                    	DCX	H
  1E3C'   22 2E9F'              	SHLD	PCNT
  1E3F'   7C                    	MOV	A,H
  1E40'   B5                    	ORA	L
  1E41'   C2 1E2A'              	JNZ	VP_LP
  1E44'   CD 0174'              	CALL	MARKMOD
  1E47'   21 2EA1'              	LXI	H,PPFP
  1E4A'   CD 03DC'              	CALL	MKLOAD
  1E4D'   CD 03E9'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1E50'   D2 1E83'              	JNC	VP_PGD
  1E53'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


                                				;   arithmetic now has the lines to subtract
  1E56'   CD 09CB'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1E59'   3A 2EA6'              	LDA	PCPY
  1E5C'   B7                    	ORA	A
  1E5D'   CA 0919'              	JZ	FNBLNK
  1E60'   2A 2EA4'              	LHLD	PLFS
  1E63'   7C                    	MOV	A,H
  1E64'   B7                    	ORA	A
  1E65'   C2 0919'              	JNZ	FNBLNK
  1E68'   3A 2EA6'              	LDA	PCPY
  1E6B'   CD 0FAA'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1E6E'   7C                    	MOV	A,H
  1E6F'   B7                    	ORA	A
  1E70'   C2 0919'              	JNZ	FNBLNK
  1E73'   7D                    	MOV	A,L
  1E74'   B7                    	ORA	A
  1E75'   CA 0919'              	JZ	FNBLNK
  1E78'   F5                    	PUSH	PSW
  1E79'   CD 0848'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1E7C'   F1                    	POP	PSW
  1E7D'   32 2E21'              	STA	ILN		; ... which the lines put now replace
  1E80'   C3 0919'              	JMP	FNBLNK
  1E83'                         VP_PGD:				; the put paged its first line out: page back
  1E83'   CD 03A9'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1E86'   CD 0000*              	CALL	GOTO
  1E89'   CD 09CB'              	CALL	GLSTAL
  1E8C'   CD 1310'              	CALL	GPLACE
  1E8F'   C3 085D'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  1E92'                         VP_BEL:
  1E92'   CD 074B'              	CALL	GETCNT		; the count is spent either way
  1E95'   0E 07                 	MVI	C,BEL
  1E97'   CD 0000*              	CALL	BCONOU
  1E9A'   C3 0820'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  1E9D'                         VIREP:
  1E9D'   79                    	MOV	A,C
  1E9E'   FE 1B                 	CPI	ESC
  1EA0'   CA 1FF3'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  1EA3'   FE 0D                 	CPI	CR
  1EA5'   CA 1F18'              	JZ	VP_CR
  1EA8'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1EAA'   CA 1F18'              	JZ	VP_CR
  1EAD'   FE 08                 	CPI	BS
  1EAF'   CA 1F24'              	JZ	VP_BS
  1EB2'   FE 7F                 	CPI	DEL
  1EB4'   CA 1F24'              	JZ	VP_BS
  1EB7'   32 2E77'              	STA	VRCH		; the calls below do not preserve C
  1EBA'   CD 0826'              	CALL	SETLIN		; this row changed
  1EBD'   CD 0174'              	CALL	MARKMOD
  1EC0'   CD 1961'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1EC3'   CA 1F03'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1EC6'   CD 0732'              	CALL	CURCHR
  1EC9'   06 01                 	MVI	B,1
  1ECB'   CD 082C'              	CALL	SETCEL
  1ECE'   3A 2E77'              	LDA	VRCH
  1ED1'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1ED4'   2A 2E78'              	LHLD	RPDEL
  1ED7'   7C                    	MOV	A,H
  1ED8'   B5                    	ORA	L
  1ED9'   CA 1EEF'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1EDC'   2A 0000*              	LHLD	GAPEND
  1EDF'   EB                    	XCHG
  1EE0'   2A 2E7C'              	LHLD	RPGE
  1EE3'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1EE6'   CA 1EEF'              	JZ	VP_OVW
  1EE9'   21 0000               	LXI	H,0
  1EEC'   22 2E78'              	SHLD	RPDEL		; the text moved: those originals are gone
  1EEF'                         VP_OVW:
  1EEF'   21 0001               	LXI	H,1
  1EF2'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1EF5'   2A 0000*              	LHLD	GAPEND
  1EF8'   22 2E7C'              	SHLD	RPGE
  1EFB'   2A 2E78'              	LHLD	RPDEL
  1EFE'   23                    	INX	H
  1EFF'   22 2E78'              	SHLD	RPDEL
  1F02'   C9                    	RET
  1F03'                         VP_APP:
  1F03'   3E 20                 	MVI	A,' '		; (the cell there is blank)
  1F05'   06 01                 	MVI	B,1
  1F07'   CD 082C'              	CALL	SETCEL
  1F0A'   3A 2E77'              	LDA	VRCH
  1F0D'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1F10'   2A 2E7A'              	LHLD	RPAPP
  1F13'   23                    	INX	H
  1F14'   22 2E7A'              	SHLD	RPAPP
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1F17'   C9                    	RET
  1F18'                         VP_CR:
  1F18'   21 0000               	LXI	H,0
  1F1B'   22 2E78'              	SHLD	RPDEL		; a line break ends what BS can put back
  1F1E'   22 2E7A'              	SHLD	RPAPP
  1F21'   C3 1FAF'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1F24'                         VP_BS:
  1F24'   2A 2E7A'              	LHLD	RPAPP
  1F27'   7C                    	MOV	A,H
  1F28'   B5                    	ORA	L
  1F29'   CA 1F36'              	JZ	VP_BSD
  1F2C'   2B                    	DCX	H
  1F2D'   22 2E7A'              	SHLD	RPAPP		; an appended char: it just goes
  1F30'   CD 0826'              	CALL	SETLIN
  1F33'   C3 0000*              	JMP	DELPRV
  1F36'                         VP_BSD:
  1F36'   2A 2E78'              	LHLD	RPDEL
  1F39'   7C                    	MOV	A,H
  1F3A'   B5                    	ORA	L
  1F3B'   CA 1F62'              	JZ	VP_BSM		; nothing of ours left
  1F3E'   2A 0000*              	LHLD	GAPEND
  1F41'   EB                    	XCHG
  1F42'   2A 2E7C'              	LHLD	RPGE
  1F45'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1F48'   C2 1F62'              	JNZ	VP_BSM
  1F4B'   2A 2E78'              	LHLD	RPDEL
  1F4E'   2B                    	DCX	H
  1F4F'   22 2E78'              	SHLD	RPDEL
  1F52'   CD 0826'              	CALL	SETLIN
  1F55'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1F58'   CD 0000*              	CALL	UNDELF		; the original comes back
  1F5B'   2A 0000*              	LHLD	GAPEND
  1F5E'   22 2E7C'              	SHLD	RPGE
  1F61'   C9                    	RET
  1F62'                         VP_BSM:
  1F62'   CD 0820'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1F65'   C3 08AE'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  1F68'                         VIINS:
  1F68'   79                    	MOV	A,C
  1F69'   FE 1B                 	CPI	ESC
  1F6B'   CA 1FF3'              	JZ	VI_ESC
  1F6E'   FE 0D                 	CPI	CR
  1F70'   CA 1FAF'              	JZ	VI_CR
  1F73'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1F75'   CA 1FAF'              	JZ	VI_CR
  1F78'   FE 08                 	CPI	BS
  1F7A'   CA 1FC7'              	JZ	VI_BS
  1F7D'   FE 7F                 	CPI	DEL
  1F7F'   CA 1FC7'              	JZ	VI_BS
  1F82'   79                    	MOV	A,C
  1F83'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1F86'   CD 0174'              	CALL	MARKMOD
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  1F89'   CD 0826'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only for a plain printable char.  With
                                	;    a TAB after the cursor nothing past the TAB moves, so long as the
                                	;    TAB can give the cell up: the chars as far as it are the paint. ---
  1F8C'   79                    	MOV	A,C
  1F8D'   FE 20                 	CPI	' '
  1F8F'   D8                    	RC			; control char -> keep R_LINE
  1F90'   FE 7F                 	CPI	DEL
  1F92'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1F93'   CD 0863'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1F96'   47                    	MOV	B,A
  1F97'   3E 04                 	MVI	A,R_ICH
  1F99'   32 2E20'              	STA	RINTENT
  1F9C'   3E 03                 	MVI	A,3		; a TAB there: it takes the cell up if it can
  1F9E'   05                    	DCR	B		;   (SCRN.MAC knows where it stands)
  1F9F'   CA 1FAB'              	JZ	VI_ICH
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1FA2'   CD 1961'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1FA5'   3E 00                 	MVI	A,0
  1FA7'   C2 1FAB'              	JNZ	VI_ICH
  1FAA'   3C                    	INR	A
  1FAB'                         VI_ICH:
  1FAB'   32 2E22'              	STA	ICHAPP
  1FAE'   C9                    	RET
  1FAF'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1FAF'   CD 1961'              	CALL	ATCEND
  1FB2'   3E 00                 	MVI	A,0
  1FB4'   CA 1FB8'              	JZ	VI_CRS
  1FB7'   3C                    	INR	A
  1FB8'                         VI_CRS:
  1FB8'   F5                    	PUSH	PSW
  1FB9'   CD 196E'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1FBC'   CD 197B'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1FBF'   CD 0848'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1FC2'   F1                    	POP	PSW
  1FC3'   32 2E26'              	STA	ILABOV
  1FC6'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1FC7'                         VI_BS:
  1FC7'   CD 0000*              	CALL	PEEKL
  1FCA'   D8                    	RC			; start of the file: nothing to delete
  1FCB'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1FCD'   CA 1FED'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1FD0'   47                    	MOV	B,A		;   and the screen repaints in full.  Any other
  1FD1'   CD 0826'              	CALL	SETLIN		;   char is inside the row -- redraw just that row
  1FD4'   78                    	MOV	A,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  1FD5'   CD 0841'              	CALL	PLAINQ		; ... or, when it is one cell and no TAB follows
  1FD8'   D2 1FED'              	JNC	VI_BSJ		;   to be drawn up short, let the terminal close
  1FDB'   CD 0863'              	CALL	TAILTAB		;   the cell up (R_DCH, from the left of the
  1FDE'   87                    	ADD	A		;   cursor) -- or the TAB that follows take it
  1FDF'   3C                    	INR	A
  1FE0'   32 2E24'              	STA	DCHBS		; 1, and 2 with it for the TAB
  1FE3'   3E 01                 	MVI	A,1
  1FE5'   32 2E23'              	STA	DCHN
  1FE8'   3E 07                 	MVI	A,R_DCH
  1FEA'   32 2E20'              	STA	RINTENT
  1FED'                         VI_BSJ:
  1FED'   CD 0174'              	CALL	MARKMOD
  1FF0'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1FF3'                         VI_ESC:
  1FF3'   3E 00                 	MVI	A,EM_CMD
  1FF5'   32 2E1B'              	STA	EDMODE
  1FF8'   CD 0820'              	CALL	SETMOV
  1FFB'   CD 08AE'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1FFE'   C3 09CB'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  2001'                         RDLINE:
  2001'   EB                    	XCHG			; HL = buffer
  2002'   22 2E7E'              	SHLD	RLPTR
  2005'   3E 00                 	MVI	A,0
  2007'   32 2E80'              	STA	RLLEN
  200A'   78                    	MOV	A,B
  200B'   32 2E81'              	STA	RLMAX
  200E'   79                    	MOV	A,C
  200F'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  2012'                         RL_LP:
  2012'   CD 0000*              	CALL	GETKEY
  2015'   FE 1B                 	CPI	ESC
  2017'   CA 2067'              	JZ	RL_CAN
  201A'   FE 0D                 	CPI	CR
  201C'   CA 2072'              	JZ	RL_DONE
  201F'   FE 08                 	CPI	BS
  2021'   CA 204F'              	JZ	RL_BS
  2024'   FE 7F                 	CPI	DEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  2026'   CA 204F'              	JZ	RL_BS
  2029'   FE 20                 	CPI	' '
  202B'   DA 2012'              	JC	RL_LP		; control char -> ignore
  202E'   3A 2E80'              	LDA	RLLEN
  2031'   47                    	MOV	B,A
  2032'   3A 2E81'              	LDA	RLMAX
  2035'   B8                    	CMP	B
  2036'   CA 2012'              	JZ	RL_LP		; full -> ignore
  2039'   2A 2E7E'              	LHLD	RLPTR
  203C'   71                    	MOV	M,C
  203D'   23                    	INX	H
  203E'   22 2E7E'              	SHLD	RLPTR
  2041'   3A 2E80'              	LDA	RLLEN
  2044'   3C                    	INR	A
  2045'   32 2E80'              	STA	RLLEN
  2048'   79                    	MOV	A,C
  2049'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  204C'   C3 2012'              	JMP	RL_LP
  204F'                         RL_BS:				; WM LINEPOP
  204F'   3A 2E80'              	LDA	RLLEN
  2052'   B7                    	ORA	A
  2053'   CA 2067'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  2056'   3D                    	DCR	A
  2057'   32 2E80'              	STA	RLLEN
  205A'   2A 2E7E'              	LHLD	RLPTR
  205D'   2B                    	DCX	H
  205E'   22 2E7E'              	SHLD	RLPTR
  2061'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  2064'   C3 2012'              	JMP	RL_LP
  2067'                         RL_CAN:
  2067'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  2069'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  206C'   CD 0826'              	CALL	SETLIN		; redraw one row
  206F'   3E FF                 	MVI	A,0FFH		; cancelled
  2071'   C9                    	RET
  2072'                         RL_DONE:
  2072'   AF                    	XRA	A
  2073'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  2074'                         VC_BZ:
  2074'   CD 0820'              	CALL	SETMOV
  2077'   3A 2E52'              	LDA	GSAVE
  207A'   FE 02                 	CPI	PZ
  207C'   CA 2087'              	JZ	VZ_ZZ
  207F'   B7                    	ORA	A
  2080'   C0                    	RNZ			; 'g' was pending: vim drops both
  2081'   3E 02                 	MVI	A,PZ
  2083'   32 2E51'              	STA	GPEND
  2086'   C9                    	RET
  2087'                         VZ_ZZ:
  2087'   3E 04                 	MVI	A,EO_X
  2089'   32 2E82'              	STA	EXOP
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  208C'   3E 01                 	MVI	A,1
  208E'   32 2E95'              	STA	EXBANG		; no '!'
  2091'   AF                    	XRA	A
  2092'   32 2E83'              	STA	EXARG		; no file name
  2095'   3A 2E1F'              	LDA	MODF		; as ':x': a changed text is written first
  2098'   B7                    	ORA	A
  2099'   CA 21DA'              	JZ	EX_Q
  209C'   C3 2174'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  209F'                         VC_EX:
  209F'   CD 074B'              	CALL	GETCNT
  20A2'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  20A5'   11 0000*              	LXI	D,EXBUF
  20A8'   06 28                 	MVI	B,EXMAX
  20AA'   0E 3A                 	MVI	C,':'
  20AC'   CD 2001'              	CALL	RDLINE
  20AF'   B7                    	ORA	A
  20B0'   C0                    	RNZ			; cancelled
  20B1'   3A 2E80'              	LDA	RLLEN
  20B4'   5F                    	MOV	E,A
  20B5'   16 00                 	MVI	D,0
  20B7'   21 0000*              	LXI	H,EXBUF
  20BA'   19                    	DAD	D
  20BB'   36 00                 	MVI	M,0		; the line ends with a 0
  20BD'   21 0000*              	LXI	H,EXBUF
  20C0'   CD 268C'              	CALL	SKIPB
  20C3'   C8                    	RZ			; nothing on it
  20C4'   22 2E85'              	SHLD	EXCMD
  20C7'   CD 2890'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  20CA'   CD 268C'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  20CD'   56                    	MOV	D,M
  20CE'   23                    	INX	H
  20CF'   1E 00                 	MVI	E,0
  20D1'   CD 2698'              	CALL	ISLOW
  20D4'   DA 20DF'              	JC	EX_LK
  20D7'   5F                    	MOV	E,A
  20D8'   23                    	INX	H
  20D9'   CD 2698'              	CALL	ISLOW
  20DC'   D2 20F8'              	JNC	EX_NOT		; a third letter: none of ours
  20DF'                         EX_LK:
  20DF'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  20E0'   21 2877'              	LXI	H,EXTAB
  20E3'                         EX_TL:
  20E3'   7E                    	MOV	A,M
  20E4'   B7                    	ORA	A
  20E5'   CA 20F7'              	JZ	EX_NTP		; not in the table
  20E8'   23                    	INX	H
  20E9'   BA                    	CMP	D
  20EA'   7E                    	MOV	A,M
  20EB'   23                    	INX	H
  20EC'   C2 20F3'              	JNZ	EX_TN
  20EF'   BB                    	CMP	E
  20F0'   CA 20FE'              	JZ	EX_TF
  20F3'                         EX_TN:
  20F3'   23                    	INX	H
  20F4'   C3 20E3'              	JMP	EX_TL
  20F7'                         EX_NTP:
  20F7'   E1                    	POP	H
  20F8'                         EX_NOT:
  20F8'   21 2750'              	LXI	H,SNOT
  20FB'   C3 26CD'              	JMP	EXERT
  20FE'                         EX_TF:
  20FE'   7E                    	MOV	A,M
  20FF'   32 2E82'              	STA	EXOP
  2102'   E1                    	POP	H
  2103'   FE 06                 	CPI	EO_S
  2105'   CA 28FF'              	JZ	EX_S		; ':s' reads the rest of the line itself
  2108'   FE 01                 	CPI	EO_W
  210A'   CA 2119'              	JZ	EX_RG		; ':N,Mw name' takes a range
  210D'   FE 08                 	CPI	EO_R
  210F'   CA 2119'              	JZ	EX_RG		; ... and ':Nr name' a line
  2112'   3A 2EDE'              	LDA	SRNGF
  2115'   B7                    	ORA	A
  2116'   C2 20F8'              	JNZ	EX_NOT		; a range on a command that does not take one
  2119'                         EX_RG:
                                	;--- '!', then the file name ---
  2119'   7E                    	MOV	A,M
  211A'   D6 21                 	SUI	'!'
  211C'   32 2E95'              	STA	EXBANG		; 0 = '!'
  211F'   C2 2123'              	JNZ	EX_NB
  2122'   23                    	INX	H
  2123'                         EX_NB:
  2123'   CD 268C'              	CALL	SKIPB
  2126'   32 2E83'              	STA	EXARG		; 0 = no file name
  2129'   CA 2142'              	JZ	EX_RUN
  212C'   22 2E85'              	SHLD	EXCMD
  212F'   3A 2E82'              	LDA	EXOP
  2132'   FE 02                 	CPI	EO_Q
  2134'   CA 26CA'              	JZ	EX_TRL		; :q takes none
  2137'   FE 07                 	CPI	EO_V
  2139'   CA 26CA'              	JZ	EX_TRL		; nor :ve
  213C'   CD 25F6'              	CALL	PARSFN
  213F'   C2 26BE'              	JNZ	EX_INV
  2142'                         EX_RUN:
  2142'   3A 2E82'              	LDA	EXOP
  2145'   FE 05                 	CPI	EO_E
  2147'   CA 21F1'              	JZ	EX_E
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  214A'   FE 02                 	CPI	EO_Q
  214C'   CA 21DA'              	JZ	EX_Q
  214F'   FE 07                 	CPI	EO_V
  2151'   CA 26C4'              	JZ	EX_V
  2154'   FE 08                 	CPI	EO_R
  2156'   CA 2382'              	JZ	EX_R
  2159'   FE 04                 	CPI	EO_X
  215B'   CA 216D'              	JZ	EX_XM
  215E'   FE 01                 	CPI	EO_W
  2160'   C2 2174'              	JNZ	EX_W		; :wq
  2163'   3A 2EDE'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  2166'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  2167'   C2 22A2'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  216A'   C3 2174'              	JMP	EX_W
  216D'                         EX_XM:
  216D'   3A 2E1F'              	LDA	MODF		; :x writes only a changed text
  2170'   B7                    	ORA	A
  2171'   CA 21DA'              	JZ	EX_Q
  2174'                         EX_W:
  2174'   CD 2462'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  2177'   D8                    	RC			; refused (message shown)
  2178'   32 2E84'              	STA	EXBAK
  217B'   3A 2E82'              	LDA	EXOP
  217E'   FE 01                 	CPI	EO_W
  2180'   CA 2197'              	JZ	EX_WK
  2183'   3A 2E84'              	LDA	EXBAK
  2186'   B7                    	ORA	A
  2187'   C2 21D7'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  218A'   3A 2E95'              	LDA	EXBANG
  218D'   B7                    	ORA	A
  218E'   CA 21D7'              	JZ	EX_WQ		; so it does with '!'
  2191'   CD 2197'              	CALL	EX_WK		; else it may not: keep the text
  2194'   C3 21DA'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  2197'                         EX_WK:
  2197'   CD 0DE6'              	CALL	CURRW		; the cursor's row and file position
  219A'   32 2E87'              	STA	WPROW
  219D'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  21A0'   7D                    	MOV	A,L
  21A1'   E6 7F                 	ANI	7FH
  21A3'   32 2E88'              	STA	WPBYT
  21A6'   7D                    	MOV	A,L
  21A7'   17                    	RAL
  21A8'   7C                    	MOV	A,H
  21A9'   17                    	RAL
  21AA'   5F                    	MOV	E,A
  21AB'   3E 00                 	MVI	A,0
  21AD'   17                    	RAL
  21AE'   57                    	MOV	D,A		; DE = HL / 128
  21AF'   2A 0000*              	LHLD	OUTPOS
  21B2'   19                    	DAD	D
  21B3'   22 2E89'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  21B6'   CD 2497'              	CALL	WRITE
  21B9'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  21BC'   2A 2E89'              	LHLD	WPREC
  21BF'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  21C0'   3A 2E88'              	LDA	WPBYT
  21C3'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  21C6'   CD 0000*              	CALL	GOTO
  21C9'                         EX_WRW:
  21C9'   21 0000               	LXI	H,0
  21CC'   22 0000*              	SHLD	LNDLT
  21CF'   3A 2E87'              	LDA	WPROW
  21D2'   6F                    	MOV	L,A
  21D3'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  21D6'   C9                    	RET
  21D7'                         EX_WQ:
  21D7'   CD 2497'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  21DA'                         EX_Q:
  21DA'   3A 2E95'              	LDA	EXBANG
  21DD'   B7                    	ORA	A
  21DE'   CA 21E8'              	JZ	EX_QT
  21E1'   3A 2E1F'              	LDA	MODF
  21E4'   B7                    	ORA	A
  21E5'   C2 26B2'              	JNZ	MSGNWR		; changed, no '!': stay
  21E8'                         EX_QT:
  21E8'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  21EB'   3E 01                 	MVI	A,1
  21ED'   32 2E1E'              	STA	QUITF
  21F0'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  21F1'                         EX_E:
  21F1'   3A 2E95'              	LDA	EXBANG
  21F4'   B7                    	ORA	A
  21F5'   CA 21FF'              	JZ	EE_GO
  21F8'   3A 2E1F'              	LDA	MODF
  21FB'   B7                    	ORA	A
  21FC'   C2 26B2'              	JNZ	MSGNWR
  21FF'                         EE_GO:
  21FF'   3A 2E83'              	LDA	EXARG
  2202'   B7                    	ORA	A
  2203'   C2 220A'              	JNZ	EE_ARG
  2206'   CD 24D3'              	CALL	OWNTF		; no name: the buffer's own
  2209'   D8                    	RC
  220A'                         EE_ARG:
  220A'   CD 24E9'              	CALL	ISOWN
  220D'   21 0001               	LXI	H,1
  2210'   C2 2217'              	JNZ	EE_LD		; another file: its first line
  2213'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  2216'   23                    	INX	H		; HL = the cursor's line
  2217'                         EE_LD:
  2217'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  2219'   32 2E93'              	STA	MSGWHT
  221C'   E5                    	PUSH	H
  221D'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  2220'   21 0000*              	LXI	H,TFCB
  2223'   11 0000*              	LXI	D,FNAME
  2226'   CD 24FB'              	CALL	COPY12		; the buffer's name
  2229'   CD 24C0'              	CALL	SRCTF
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  222C'   CD 0000*              	CALL	REOPEN
  222F'   CD 01EC'              	CALL	MKCLR		; the marks named the buffer that just went
  2232'   AF                    	XRA	A
  2233'   32 2E1F'              	STA	MODF
  2236'   E1                    	POP	H
  2237'   2B                    	DCX	H
  2238'   AF                    	XRA	A
  2239'   CD 0000*              	CALL	MVLIND		; down to the line
  223C'   CD 0B02'              	CALL	ATEOF
  223F'   DC 0B08'              	CC	LASTLN		; past the last line: onto it
  2242'   CD 12D2'              	CALL	ZSAVE
  2245'   C3 13A7'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  2248'                         TFDOS:
  2248'   C5                    	PUSH	B
  2249'   11 0080               	LXI	D,CMDTAIL
  224C'   0E 1A                 	MVI	C,1AH		; set the DMA
  224E'   CD 0005               	CALL	BDOS
  2251'   C1                    	POP	B
  2252'   11 0000*              	LXI	D,TFCB
  2255'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  2258'                         EXRNG:
  2258'   2A 2EDF'              	LHLD	SRNG1
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  225B'   7C                    	MOV	A,H
  225C'   B5                    	ORA	L
  225D'   37                    	STC
  225E'   C8                    	RZ
  225F'   2A 2EE1'              	LHLD	SRNG2
  2262'   EB                    	XCHG
  2263'   2A 2EDF'              	LHLD	SRNG1
  2266'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  2269'   D8                    	RC
  226A'   EB                    	XCHG			; HL = the last line, DE = the first
  226B'   CD 0000*              	CALL	SUBHD
  226E'   23                    	INX	H
  226F'   22 2EE9'              	SHLD	SLINES
  2272'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  2273'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  2274'                         GOLNX:
  2274'   E5                    	PUSH	H
  2275'   CD 1266'              	CALL	GOLN
  2278'   CD 0000*              	CALL	CNTLF
  227B'   23                    	INX	H		; the line the cursor came to rest on
  227C'   D1                    	POP	D
  227D'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  2280'                         EXSAVP:
  2280'   CD 0DE6'              	CALL	CURRW
  2283'   32 2E87'              	STA	WPROW
  2286'   21 2EC0'              	LXI	H,MKPOS
  2289'   C3 0429'              	JMP	FPSTO
  228C'                         EXRSTP:
  228C'   CD 0000*              	CALL	CLRCNT
  228F'   CD 03A9'              	CALL	MKPAGE		; page until that place is in the window again
  2292'   CD 0000*              	CALL	GOTO
  2295'   C3 21C9'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  2298'                         PUTBRK:
  2298'   3E 0D                 	MVI	A,CR
  229A'   CD 0000*              	CALL	PUTGAP
  229D'   3E 0A                 	MVI	A,LF
  229F'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  22A2'                         EX_WR:
  22A2'   3A 2E83'              	LDA	EXARG
  22A5'   B7                    	ORA	A
  22A6'   CA 26A0'              	JZ	MSGNFN		; No file name
  22A9'   CD 24E9'              	CALL	ISOWN
  22AC'   CA 234C'              	JZ	EXW_OW
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  22AF'   CD 0000*              	CALL	TEXIST
  22B2'   32 2EEC'              	STA	RWERR		; nonzero: a file of that name is there
  22B5'   CA 22BF'              	JZ	EXW_GO
  22B8'   3A 2E95'              	LDA	EXBANG
  22BB'   B7                    	ORA	A
  22BC'   C2 26A6'              	JNZ	MSGEXI		; File exists (! to force)
  22BF'                         EXW_GO:
  22BF'   CD 2258'              	CALL	EXRNG
  22C2'   DA 2346'              	JC	EXW_BD
  22C5'   CD 2280'              	CALL	EXSAVP
  22C8'   2A 2EDF'              	LHLD	SRNG1
  22CB'   CD 2274'              	CALL	GOLNX
  22CE'   C2 2343'              	JNZ	EXW_NL		; the text has no line N
  22D1'   3A 2EEC'              	LDA	RWERR		; a delete scans the whole directory, there or
  22D4'   B7                    	ORA	A		;   not: only when TEXIST found one
  22D5'   0E 13                 	MVI	C,13H
  22D7'   C4 2248'              	CNZ	TFDOS		; delete what is there
  22DA'   0E 16                 	MVI	C,16H
  22DC'   CD 2248'              	CALL	TFDOS		; ... and make it
  22DF'   3C                    	INR	A
  22E0'   CA 2335'              	JZ	EXW_FL		; no directory entry left
  22E3'   3E 80                 	MVI	A,80H
  22E5'   32 2EEB'              	STA	RWPTR
  22E8'   AF                    	XRA	A
  22E9'   32 2EEC'              	STA	RWERR
  22EC'   2A 2EE9'              	LHLD	SLINES
  22EF'   CD 0000*              	CALL	SETC0		; that many lines, forward
  22F2'                         EXW_LP:
  22F2'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  22F5'   E5                    	PUSH	H
  22F6'   EB                    	XCHG
  22F7'   2A 0000*              	LHLD	GAPEND
  22FA'   CD 2352'              	CALL	RWOUT		; the text from the cursor to there
  22FD'   E1                    	POP	H
  22FE'   3A 2EEC'              	LDA	RWERR
  2301'   B7                    	ORA	A
  2302'   C2 231E'              	JNZ	EXW_EN
  2305'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  2308'   CD 0760'              	CALL	CNTTST
  230B'   C2 22F2'              	JNZ	EXW_LP
  230E'                         EXW_PD:				; the last record is padded out with ^Z
  230E'   3A 2EEB'              	LDA	RWPTR
  2311'   FE 80                 	CPI	80H
  2313'   CA 231E'              	JZ	EXW_EN
  2316'   3E 1A                 	MVI	A,CPMEOF
  2318'   CD 235E'              	CALL	RWPUT
  231B'   C3 230E'              	JMP	EXW_PD
  231E'                         EXW_EN:
  231E'   0E 10                 	MVI	C,10H
  2320'   CD 2248'              	CALL	TFDOS		; close
  2323'   3A 2EEC'              	LDA	RWERR
  2326'   B7                    	ORA	A
  2327'   C2 2335'              	JNZ	EXW_FL
  232A'   CD 228C'              	CALL	EXRSTP
  232D'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  232F'   32 2E93'              	STA	MSGWHT
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  2332'   C3 0820'              	JMP	SETMOV		; nothing on the screen has changed
  2335'                         EXW_FL:				; no room: the part written is not left behind
  2335'   0E 13                 	MVI	C,13H
  2337'   CD 2248'              	CALL	TFDOS
  233A'   CD 228C'              	CALL	EXRSTP
  233D'   21 286D'              	LXI	H,SDFUL
  2340'   C3 26D8'              	JMP	EXERR
  2343'                         EXW_NL:
  2343'   CD 228C'              	CALL	EXRSTP
  2346'                         EXW_BD:
  2346'   21 285F'              	LXI	H,SRNGE
  2349'   C3 26D8'              	JMP	EXERR
  234C'                         EXW_OW:
  234C'   21 2707'              	LXI	H,SEXI
  234F'   C3 26D8'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  2352'                         RWOUT:
  2352'   CD 0000*              	CALL	CMP16
  2355'   C8                    	RZ
  2356'   7E                    	MOV	A,M
  2357'   23                    	INX	H
  2358'   CD 235E'              	CALL	RWPUT
  235B'   C3 2352'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  235E'                         RWPUT:
  235E'   E5                    	PUSH	H
  235F'   F5                    	PUSH	PSW
  2360'   3A 2EEB'              	LDA	RWPTR
  2363'   6F                    	MOV	L,A
  2364'   26 00                 	MVI	H,0
  2366'   F1                    	POP	PSW
  2367'   77                    	MOV	M,A
  2368'   2C                    	INR	L		; Z: that was the record's last byte
  2369'   7D                    	MOV	A,L
  236A'   C2 237D'              	JNZ	RWP_ST
  236D'   D5                    	PUSH	D
  236E'   0E 15                 	MVI	C,15H
  2370'   CD 2248'              	CALL	TFDOS		; write it
  2373'   D1                    	POP	D
  2374'   B7                    	ORA	A
  2375'   CA 237B'              	JZ	RWP_OK
  2378'   32 2EEC'              	STA	RWERR
  237B'                         RWP_OK:
  237B'   3E 80                 	MVI	A,80H
  237D'                         RWP_ST:
  237D'   32 2EEB'              	STA	RWPTR
  2380'   E1                    	POP	H
  2381'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  2382'                         EX_R:
  2382'   3A 2E83'              	LDA	EXARG
  2385'   B7                    	ORA	A
  2386'   CA 26A0'              	JZ	MSGNFN		; No file name
  2389'   0E 0F                 	MVI	C,0FH
  238B'   CD 2248'              	CALL	TFDOS		; open
  238E'   3C                    	INR	A
  238F'   CA 245C'              	JZ	ER_NOF
  2392'   CD 12F8'              	CALL	GZONE		; the screen's top line, before anything moves
  2395'   CD 2280'              	CALL	EXSAVP
  2398'   3A 2EDE'              	LDA	SRNGF
  239B'   B7                    	ORA	A
  239C'   CA 23B5'              	JZ	ER_NXT		; no line given: below the cursor's
  239F'   2A 2EE1'              	LHLD	SRNG2
  23A2'   7C                    	MOV	A,H
  23A3'   B5                    	ORA	L
  23A4'   C2 23AF'              	JNZ	ER_LN
  23A7'   23                    	INX	H
  23A8'   CD 1266'              	CALL	GOLN		; ':0r': above line 1 ...
  23AB'   AF                    	XRA	A		;   which never wants a line end put in first
  23AC'   C3 23D7'              	JMP	ER_BRK
  23AF'                         ER_LN:
  23AF'   CD 2274'              	CALL	GOLNX
  23B2'   C2 2343'              	JNZ	EXW_NL		; the text has no line N
  23B5'                         ER_NXT:
  23B5'   21 0001               	LXI	H,1
  23B8'   AF                    	XRA	A
  23B9'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  23BC'   CD 0B02'              	CALL	ATEOF
  23BF'   3E 00                 	MVI	A,0
  23C1'   D2 23D7'              	JNC	ER_BRK		; text follows
  23C4'   2A 0000*              	LHLD	GAPBEG
  23C7'   EB                    	XCHG
  23C8'   2A 0000*              	LHLD	TXTBEG
  23CB'   CD 0000*              	CALL	CMP16
  23CE'   3E 01                 	MVI	A,1
  23D0'   CA 23D7'              	JZ	ER_BRK		; nothing before the cursor either
  23D3'   1B                    	DCX	D
  23D4'   1A                    	LDAX	D
  23D5'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  23D7'                         ER_BRK:
  23D7'   32 2EEE'              	STA	RDBRK
  23DA'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  23DD'   AF                    	XRA	A
  23DE'   32 2EED'              	STA	RDANY
  23E1'                         ER_LP:
  23E1'   0E 14                 	MVI	C,14H
  23E3'   CD 2248'              	CALL	TFDOS		; the next record
  23E6'   B7                    	ORA	A
  23E7'   C2 241A'              	JNZ	ER_END
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  23EA'   21 0080               	LXI	H,CMDTAIL
  23ED'   0E 00                 	MVI	C,0
  23EF'                         ER_SC:				; C = its bytes, up to a ^Z
  23EF'   7E                    	MOV	A,M
  23F0'   FE 1A                 	CPI	CPMEOF
  23F2'   CA 23FA'              	JZ	ER_GOT
  23F5'   23                    	INX	H
  23F6'   0C                    	INR	C
  23F7'   F2 23EF'              	JP	ER_SC		; (minus: all 128)
  23FA'                         ER_GOT:
  23FA'   79                    	MOV	A,C
  23FB'   B7                    	ORA	A
  23FC'   CA 241A'              	JZ	ER_END
  23FF'   C5                    	PUSH	B
  2400'   3A 2EED'              	LDA	RDANY
  2403'   B7                    	ORA	A
  2404'   CC 244B'              	CZ	ER_1ST
  2407'   C1                    	POP	B
  2408'   06 00                 	MVI	B,0
  240A'   11 0080               	LXI	D,CMDTAIL
  240D'   C5                    	PUSH	B
  240E'   CD 0000*              	CALL	INSBLK
  2411'   C1                    	POP	B
  2412'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  2415'   79                    	MOV	A,C
  2416'   17                    	RAL
  2417'   DA 23E1'              	JC	ER_LP		; a full record: there may be more
  241A'                         ER_END:
  241A'   3A 2EED'              	LDA	RDANY
  241D'   B7                    	ORA	A
  241E'   CA 243C'              	JZ	ER_PL		; nothing in the file: nothing has changed
  2421'   CD 0B02'              	CALL	ATEOF
  2424'   DA 2431'              	JC	ER_MD		; the text now ends as the file read ends
  2427'   2A 0000*              	LHLD	GAPBEG
  242A'   2B                    	DCX	H
  242B'   7E                    	MOV	A,M
  242C'   FE 0A                 	CPI	LF
  242E'   C4 2298'              	CNZ	PUTBRK		; text follows: what was read ends a line
  2431'                         ER_MD:
  2431'   3E 01                 	MVI	A,1
  2433'   32 2E1F'              	STA	MODF
  2436'   CD 03A9'              	CALL	MKPAGE		; back to the first line read
  2439'   CD 0000*              	CALL	GOTO
  243C'                         ER_PL:
  243C'   CD 0B02'              	CALL	ATEOF
  243F'   DC 0B08'              	CC	LASTLN		; (nothing read, at the end: the last line)
  2442'   CD 0000*              	CALL	CLRCNT
  2445'   CD 1310'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  2448'   C3 085D'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  244B'                         ER_1ST:
  244B'   3C                    	INR	A
  244C'   32 2EED'              	STA	RDANY
  244F'   3A 2EEE'              	LDA	RDBRK
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  2452'   B7                    	ORA	A
  2453'   C4 2298'              	CNZ	PUTBRK
  2456'   21 2EC0'              	LXI	H,MKPOS
  2459'   C3 0429'              	JMP	FPSTO
  245C'                         ER_NOF:
  245C'   21 284E'              	LXI	H,SNOPN
  245F'   C3 26CD'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  2462'                         WRCHK:
  2462'   3A 2E83'              	LDA	EXARG
  2465'   B7                    	ORA	A
  2466'   C2 2470'              	JNZ	WC_ARG
  2469'   CD 24D3'              	CALL	OWNTF
  246C'   D8                    	RC
  246D'   C3 2485'              	JMP	WC_OWN
  2470'                         WC_ARG:
  2470'   CD 24E9'              	CALL	ISOWN
  2473'   CA 2485'              	JZ	WC_OWN
  2476'   3A 2E95'              	LDA	EXBANG
  2479'   B7                    	ORA	A
  247A'   CA 2483'              	JZ	WC_OTH
  247D'   CD 0000*              	CALL	TEXIST
  2480'   C2 26A6'              	JNZ	MSGEXI		; File exists (! to force)
  2483'                         WC_OTH:
  2483'   AF                    	XRA	A		; (NC)
  2484'   C9                    	RET
  2485'                         WC_OWN:
  2485'   3A 2E96'              	LDA	ROFLAG		; '-R': this is the file it may not write
  2488'   B7                    	ORA	A
  2489'   CA 2493'              	JZ	WC_OK
  248C'   3A 2E95'              	LDA	EXBANG
  248F'   B7                    	ORA	A
  2490'   C2 26AC'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  2493'                         WC_OK:
  2493'   3E 01                 	MVI	A,1
  2495'   B7                    	ORA	A		; (NC)
  2496'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  2497'                         WRITE:
  2497'   3A 2E84'              	LDA	EXBAK
  249A'   CD 0000*              	CALL	WRTO
  249D'   3A 0001*              	LDA	FNAME+1
  24A0'   FE 20                 	CPI	' '
  24A2'   C2 24AE'              	JNZ	WR_HAS
  24A5'   21 0000*              	LXI	H,TFCB
  24A8'   11 0000*              	LXI	D,FNAME
  24AB'   CD 24FB'              	CALL	COPY12
  24AE'                         WR_HAS:
  24AE'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  24B0'   32 2E93'              	STA	MSGWHT
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  24B3'   CD 24E9'              	CALL	ISOWN
  24B6'   C2 24C0'              	JNZ	SRCTF
  24B9'   AF                    	XRA	A
  24BA'   32 2E1F'              	STA	MODF
  24BD'   32 2E94'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  24C0'                         SRCTF:
  24C0'   21 0000*              	LXI	H,TFCB
  24C3'   11 005C               	LXI	D,DFTFCB
  24C6'   CD 24FB'              	CALL	COPY12
  24C9'   AF                    	XRA	A
  24CA'   06 04                 	MVI	B,4
  24CC'                         SRC_Z:
  24CC'   12                    	STAX	D		; extent, s1, s2, record count: 0
  24CD'   13                    	INX	D
  24CE'   05                    	DCR	B
  24CF'   C2 24CC'              	JNZ	SRC_Z
  24D2'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  24D3'                         OWNTF:
  24D3'   3A 0001*              	LDA	FNAME+1
  24D6'   FE 20                 	CPI	' '
  24D8'   CA 26A0'              	JZ	MSGNFN
  24DB'   CD 2506'              	CALL	TFCLR
  24DE'   21 0000*              	LXI	H,FNAME
  24E1'   11 0000*              	LXI	D,TFCB
  24E4'   CD 24FB'              	CALL	COPY12
  24E7'   B7                    	ORA	A		; (NC)
  24E8'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  24E9'                         ISOWN:
  24E9'   21 0000*              	LXI	H,TFCB
  24EC'   11 0000*              	LXI	D,FNAME
  24EF'   06 0C                 	MVI	B,12
  24F1'                         IO_LP:
  24F1'   1A                    	LDAX	D
  24F2'   BE                    	CMP	M
  24F3'   C0                    	RNZ
  24F4'   23                    	INX	H
  24F5'   13                    	INX	D
  24F6'   05                    	DCR	B
  24F7'   C2 24F1'              	JNZ	IO_LP
  24FA'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  24FB'                         COPY12:
  24FB'   06 0C                 	MVI	B,12
  24FD'                         CP_LP:
  24FD'   7E                    	MOV	A,M
  24FE'   12                    	STAX	D
  24FF'   23                    	INX	H
  2500'   13                    	INX	D
  2501'   05                    	DCR	B
  2502'   C2 24FD'              	JNZ	CP_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  2505'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  2506'                         TFCLR:
  2506'   11 0000*              	LXI	D,TFCB
  2509'   06 24                 	MVI	B,36
  250B'   AF                    	XRA	A
  250C'                         TC_LP:
  250C'   12                    	STAX	D
  250D'   13                    	INX	D
  250E'   05                    	DCR	B
  250F'   C2 250C'              	JNZ	TC_LP
  2512'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  2513'                         FOPEN:
  2513'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  2515'   32 2E93'              	STA	MSGWHT
  2518'   21 005C               	LXI	H,DFTFCB
  251B'   CD 25E9'              	CALL	NRMDRV
  251E'   11 0000*              	LXI	D,FNAME
  2521'   CD 24FB'              	CALL	COPY12
  2524'   CD 0000*              	CALL	OPENZ
  2527'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  252A'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  252C'   C8                    	RZ
  252D'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  2530'   32 2E94'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  2533'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  2534'                         ARGSCN:
  2534'   3A 0080               	LDA	CMDTAIL
  2537'   47                    	MOV	B,A		; B = what is left of the line
  2538'   B7                    	ORA	A
  2539'   C8                    	RZ
  253A'   21 0081               	LXI	H,CMDTAIL+1
  253D'                         AS_TOK:				; at a token, or the blanks before one
  253D'   7E                    	MOV	A,M
  253E'   FE 20                 	CPI	' '
  2540'   C2 2549'              	JNZ	AS_OPT
  2543'   23                    	INX	H
  2544'   05                    	DCR	B
  2545'   C2 253D'              	JNZ	AS_TOK
  2548'   C9                    	RET
  2549'                         AS_OPT:
  2549'   FE 2B                 	CPI	'+'
  254B'   CA 2575'              	JZ	AS_PLS
  254E'   FE 2D                 	CPI	'-'
  2550'   CA 2564'              	JZ	AS_SW
  2553'   FE 2F                 	CPI	'/'
  2555'   CA 2564'              	JZ	AS_SW
  2558'                         AS_SKP:				; not ours (the file name): on to the next one
  2558'   23                    	INX	H
  2559'   05                    	DCR	B
  255A'   C8                    	RZ
  255B'   7E                    	MOV	A,M
  255C'   FE 20                 	CPI	' '
  255E'   C2 2558'              	JNZ	AS_SKP
  2561'   C3 253D'              	JMP	AS_TOK
  2564'                         AS_SW:
  2564'   23                    	INX	H
  2565'   05                    	DCR	B
  2566'   C8                    	RZ
  2567'   7E                    	MOV	A,M
  2568'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  256A'   FE 52                 	CPI	'R'
  256C'   C2 2558'              	JNZ	AS_SKP
  256F'   32 2E96'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  2572'   C3 2558'              	JMP	AS_SKP
  2575'                         AS_PLS:
  2575'   3E 01                 	MVI	A,1
  2577'   32 2E97'              	STA	PLUSF		; '+' gets the line even with no number on it
  257A'   11 0000*              	LXI	D,PLUSB
  257D'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  257F'   23                    	INX	H		;   line space, so it is taken as '+' alone
  2580'   05                    	DCR	B
  2581'   CA 25B8'              	JZ	AS_PE
  2584'   7E                    	MOV	A,M
  2585'   FE 30                 	CPI	'0'
  2587'   C2 259F'              	JNZ	AS_PD
  258A'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  258A'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  258B'   05                    	DCR	B
  258C'   CA 25C0'              	JZ	AS_P1
  258F'   7E                    	MOV	A,M
  2590'   FE 30                 	CPI	'0'
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


  2592'   CA 258A'              	JZ	AS_PZ
  2595'   FE 31                 	CPI	'1'
  2597'   DA 25C0'              	JC	AS_P1		; zeros and then no digit at all: line 1
  259A'   FE 3A                 	CPI	'9'+1
  259C'   D2 25C0'              	JNC	AS_P1
  259F'                         AS_PD:				; the digits, as typed
  259F'   7E                    	MOV	A,M
  25A0'   FE 30                 	CPI	'0'
  25A2'   DA 25B8'              	JC	AS_PE
  25A5'   FE 3A                 	CPI	'9'+1
  25A7'   D2 25B8'              	JNC	AS_PE
  25AA'   79                    	MOV	A,C
  25AB'   B7                    	ORA	A
  25AC'   CA 25C7'              	JZ	AS_POV
  25AF'   0D                    	DCR	C
  25B0'   7E                    	MOV	A,M
  25B1'   12                    	STAX	D
  25B2'   13                    	INX	D
  25B3'   23                    	INX	H
  25B4'   05                    	DCR	B
  25B5'   C2 259F'              	JNZ	AS_PD
  25B8'                         AS_PE:
  25B8'   AF                    	XRA	A
  25B9'   12                    	STAX	D		; the digits end with a 0
  25BA'   78                    	MOV	A,B
  25BB'   B7                    	ORA	A
  25BC'   C8                    	RZ
  25BD'   C3 253D'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  25C0'                         AS_P1:
  25C0'   3E 31                 	MVI	A,'1'
  25C2'   12                    	STAX	D
  25C3'   13                    	INX	D
  25C4'   C3 25B8'              	JMP	AS_PE
  25C7'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  25C7'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  25CA'   C3 25B8'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  25CD'                         ARGGO:
  25CD'   3A 2E97'              	LDA	PLUSF
  25D0'   B7                    	ORA	A
  25D1'   C8                    	RZ
  25D2'   21 0000*              	LXI	H,PLUSB
  25D5'                         AG_LP:
  25D5'   7E                    	MOV	A,M
  25D6'   B7                    	ORA	A
  25D7'   CA 25E4'              	JZ	AG_G
  25DA'   4F                    	MOV	C,A
  25DB'   E5                    	PUSH	H
  25DC'   CD 0023'              	CALL	VICMD
  25DF'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  25E0'   23                    	INX	H
  25E1'   C3 25D5'              	JMP	AG_LP
  25E4'                         AG_G:
  25E4'   0E 47                 	MVI	C,'G'
  25E6'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  25E9'                         NRMDRV:
  25E9'   7E                    	MOV	A,M
  25EA'   B7                    	ORA	A
  25EB'   C0                    	RNZ
  25EC'   E5                    	PUSH	H
  25ED'   0E 19                 	MVI	C,BF_CURDSK
  25EF'   CD 0005               	CALL	BDOS
  25F2'   E1                    	POP	H
  25F3'   3C                    	INR	A
  25F4'   77                    	MOV	M,A
  25F5'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  25F6'                         PARSFN:
  25F6'   CD 2506'              	CALL	TFCLR
  25F9'   11 0000*              	LXI	D,TFCB
  25FC'   23                    	INX	H
  25FD'   7E                    	MOV	A,M
  25FE'   2B                    	DCX	H
  25FF'   FE 3A                 	CPI	':'
  2601'   C2 2613'              	JNZ	PF_NM
  2604'   CD 2659'              	CALL	GETFNC
  2607'   CA 2613'              	JZ	PF_NM
  260A'   D6 40                 	SUI	40H
  260C'   12                    	STAX	D
  260D'   FE 11                 	CPI	17
  260F'   D2 2637'              	JNC	PF_BAD
  2612'   23                    	INX	H
  2613'                         PF_NM:
  2613'   13                    	INX	D
  2614'   0E 08                 	MVI	C,8
  2616'   CD 263B'              	CALL	CPYNAM
  2619'   FE 2E                 	CPI	'.'
  261B'   0E 03                 	MVI	C,3
  261D'   C4 264E'              	CNZ	PADFLD		; no type: blanks
  2620'   CC 263A'              	CZ	CPYNM0		; '.': the type
  2623'   3A 0001*              	LDA	TFCB+1
  2626'   FE 20                 	CPI	' '
  2628'   CA 2637'              	JZ	PF_BAD		; no name
  262B'   CD 268C'              	CALL	SKIPB
  262E'   C0                    	RNZ			; more after it
  262F'   21 0000*              	LXI	H,TFCB
  2632'   CD 25E9'              	CALL	NRMDRV
  2635'   AF                    	XRA	A
  2636'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  2637'                         PF_BAD:
  2637'   F6 01                 	ORI	1
  2639'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  263A'                         CPYNM0:
  263A'   23                    	INX	H
  263B'                         CPYNAM:
  263B'   CD 2659'              	CALL	GETFNC
  263E'   CA 264E'              	JZ	PADFLD
  2641'   12                    	STAX	D
  2642'   13                    	INX	D
  2643'   0D                    	DCR	C
  2644'   C2 263B'              	JNZ	CPYNAM
  2647'                         CN_SKP:
  2647'   CD 2659'              	CALL	GETFNC
  264A'   C2 2647'              	JNZ	CN_SKP
  264D'   C9                    	RET
  264E'                         PADFLD:
  264E'   F5                    	PUSH	PSW
  264F'                         PD_LP:
  264F'   3E 20                 	MVI	A,' '
  2651'   12                    	STAX	D
  2652'   13                    	INX	D
  2653'   0D                    	DCR	C
  2654'   C2 264F'              	JNZ	PD_LP
  2657'   F1                    	POP	PSW
  2658'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  2659'                         GETFNC:
  2659'   7E                    	MOV	A,M
  265A'   FE 3D                 	CPI	'='
  265C'   C8                    	RZ
  265D'   FE 5F                 	CPI	'_'
  265F'   C8                    	RZ
  2660'   FE 3B                 	CPI	';'
  2662'   C8                    	RZ
  2663'   FE 3C                 	CPI	'<'
  2665'   C8                    	RZ
  2666'   FE 3E                 	CPI	'>'
  2668'   C8                    	RZ
  2669'   FE 2E                 	CPI	'.'
  266B'   C8                    	RZ
  266C'   FE 3A                 	CPI	':'
  266E'   C8                    	RZ
  266F'   FE 2A                 	CPI	'*'
  2671'   C8                    	RZ
  2672'   FE 3F                 	CPI	'?'
  2674'   C8                    	RZ
  2675'   FE 20                 	CPI	' '
  2677'   DA 268A'              	JC	GF_CTL
  267A'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


  267B'   23                    	INX	H
  267C'   FE 61                 	CPI	'a'
