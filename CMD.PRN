                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  0003                   C      CTRLC	EQU	03H		; ^C -- abandons a search or a long move
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the current row is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; current line changed only -> redraw that one row
  0003                   C      R_DLIN	EQU	3		; one line deleted at the cursor row -> DL + redraw bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted mid-line -> ICH (no tail redraw)
  0005                   C      R_ILIN	EQU	5		; one line opened at the cursor row -> IL + redraw that row and the one above
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw that row + DL the one under it
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; KEY DECODER -- GETKEY return types (B) and action codes (C when B=KT_ACT).
                         C      ; See KEY.MAC.
                         C      ;------------------------------------------------------------
  0000                   C      KT_NONE EQU	0		; no key (unrecognised ESC sequence, discarded)
  0001                   C      KT_ACT	EQU	1		; C = ACT_xxx action code
  0002                   C      KT_CHAR EQU	2		; C = ASCII character (printable or control)
                         C      
  0001                   C      ACT_CURUP EQU	1		; cursor up    (ESC[A / ESC OA)
  0002                   C      ACT_CURDN EQU	2		; cursor down  (ESC[B / ESC OB)
  0003                   C      ACT_CURRT EQU	3		; cursor right (ESC[C / ESC OC)
  0004                   C      ACT_CURLT EQU	4		; cursor left  (ESC[D / ESC OD)
  0005                   C      ACT_LINST EQU	5		; Home / line start (ESC[H / ESC[1~)
  0006                   C      ACT_LINEN EQU	6		; End  / line end   (ESC[F / ESC[4~)
  0007                   C      ACT_PGUP  EQU	7		; page up   (ESC[5~)
  0008                   C      ACT_PGDN  EQU	8		; page down (ESC[6~)
  0009                   C      ACT_INS	  EQU	9		; Insert key (ESC[2~)
  000A                   C      ACT_DEL	  EQU	10		; Delete key (ESC[3~)
  000B                   C      ACT_ESC	  EQU	11		; lone ESC (after timeout)
  000B                   C      ACT_MAX	  EQU	11		; highest defined action code
                         C      
  01F4                   C      ESCTMO	EQU	500		; polls before a lone ESC is confirmed
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	COL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	MKSHFT				; the marks follow an edit (VI.MAC hooks it)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	KBBRK, KBFLSH			; KEY.MAC -- a ^C waiting / drop type-ahead
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	MKSAV				; ... and a refused 'dd's copy of them
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	UNDCLR				; ... nothing to undo
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	INSBLK, UNDINS			; BUF.MAC -- a block in at the cursor (':r')
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
                                	EXTRN	SCBOT, SCEOF, SCBOF, WFILL	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	SETC0				; BUF.MAC -- WM count set, forward
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GOLINE				; BUF.MAC -- WM 2228 (a mark's page loop)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   AF                    	XRA	A		; no command is ever left open to a ^C by the
  0001'   32 2AB3'              	STA	BRKARM		;   one before it (BRKON)
  0004'   CD 00DD'              	CALL	DOTPRE
  0007'   CD 000D'              	CALL	CDMODE
  000A'   C3 0134'              	JMP	DOTPOST
  000D'                         CDMODE:
  000D'   3A 2A00'              	LDA	EDMODE
  0010'   FE 01                 	CPI	EM_INS
  0012'   CA 001D'              	JZ	CD_INS
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  0015'   FE 02                 	CPI	EM_REP
  0017'   CA 0020'              	JZ	CD_REP
  001A'   C3 0023'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  001D'                         CD_INS:
  001D'   C3 1B4A'              	JMP	VIINS
  0020'                         CD_REP:
  0020'   C3 1A8A'              	JMP	VIREP
                                
                                ;============================================================
                                ; VICMD -- command-mode key.  B = KT type, C = char / action.
                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  0023'                         VICMD:
  0023'   78                    	MOV	A,B
  0024'   FE 00                 	CPI	KT_NONE
  0026'   C8                    	RZ			; discarded key
  0027'   FE 01                 	CPI	KT_ACT
  0029'   CA 00AF'              	JZ	VIC_ACT
  002C'   3A 2A28'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002F'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  0031'   CA 1697'              	JZ	VR_DO
                                	;--- KT_CHAR: maybe a count digit ---
  0034'   79                    	MOV	A,C
  0035'   FE 31                 	CPI	'1'
  0037'   DA 0042'              	JC	VIC_NOTD	; < '1'
  003A'   FE 3A                 	CPI	'9'+1
  003C'   D2 0042'              	JNC	VIC_NOTD	; > '9'
  003F'   C3 0052'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  0042'                         VIC_NOTD:
  0042'   79                    	MOV	A,C
  0043'   FE 30                 	CPI	'0'
  0045'   C2 007A'              	JNZ	VICDSP
  0048'   2A 2A01'              	LHLD	CMDCNT
  004B'   7C                    	MOV	A,H
  004C'   B5                    	ORA	L
  004D'   CA 007A'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  0050'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  0052'                         VICDIG:
  0052'   2A 2A01'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0055'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0056'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0057'   29                    	DAD	H		; *2
  0058'   DA 0071'              	JC	VIC_SAT
  005B'   29                    	DAD	H		; *4
  005C'   DA 0071'              	JC	VIC_SAT
  005F'   19                    	DAD	D		; *5
  0060'   DA 0071'              	JC	VIC_SAT
  0063'   29                    	DAD	H		; *10
  0064'   DA 0071'              	JC	VIC_SAT
  0067'   79                    	MOV	A,C
  0068'   D6 30                 	SUI	'0'
  006A'   5F                    	MOV	E,A
  006B'   16 00                 	MVI	D,0
  006D'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  006E'   D2 0074'              	JNC	VIC_CNT
  0071'                         VIC_SAT:
  0071'   21 FFFF               	LXI	H,0FFFFH
  0074'                         VIC_CNT:
  0074'   22 2A01'              	SHLD	CMDCNT
  0077'   C3 075A'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  007A'                         VICDSP:
  007A'   3A 2A28'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  007D'   32 2A29'              	STA	GSAVE
  0080'   AF                    	XRA	A
  0081'   32 2A28'              	STA	GPEND
  0084'   3A 2A2A'              	LDA	PENDOP
  0087'   32 2A2B'              	STA	PSAVE
  008A'   AF                    	XRA	A
  008B'   32 2A2A'              	STA	PENDOP
  008E'   3A 2A2B'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  0091'   B7                    	ORA	A
  0092'   C2 106A'              	JNZ	OPPEND
  0095'   3A 2A29'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0098'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  009A'   C2 00A3'              	JNZ	VIC_TB
  009D'   79                    	MOV	A,C
  009E'   FE 5A                 	CPI	'Z'
  00A0'   C2 00A9'              	JNZ	VIC_SW
  00A3'                         VIC_TB:
  00A3'   21 292F'              	LXI	H,CMDTAB
  00A6'   C3 00C2'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A9'                         VIC_SW:
  00A9'   CD 075A'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00AC'   C3 068B'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AF'                         VIC_ACT:
  00AF'   AF                    	XRA	A		; action key clears all pending state
  00B0'   32 2A28'              	STA	GPEND
  00B3'   32 2A29'              	STA	GSAVE
  00B6'   32 2A2A'              	STA	PENDOP
  00B9'   32 2A2B'              	STA	PSAVE
  00BC'   21 29E7'              	LXI	H,ACTTAB
  00BF'   C3 00C2'              	JMP	VSCANQ
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the two TOP-LEVEL key tables, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00C2'                         VSCANQ:
  00C2'   CD 00CE'              	CALL	VSCLK
  00C5'   CA 00A9'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C8'   E9                    	PCHL
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00C9'                         VSCAN:
  00C9'   CD 00CE'              	CALL	VSCLK
  00CC'   C8                    	RZ			; miss
  00CD'   E9                    	PCHL
  00CE'                         VSCLK:
  00CE'   7E                    VSCAN1: MOV	A,M
  00CF'   B7                    	ORA	A
  00D0'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00D1'   23                    	INX	H
  00D2'   B9                    	CMP	C
  00D3'   5E                    	MOV	E,M
  00D4'   23                    	INX	H
  00D5'   56                    	MOV	D,M
  00D6'   23                    	INX	H
  00D7'   C2 00CE'              	JNZ	VSCAN1
  00DA'   EB                    	XCHG			; HL = the handler
  00DB'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00DC'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00DD'                         DOTPRE:
  00DD'   3A 2A1F'              	LDA	DOTRPL
  00E0'   B7                    	ORA	A
  00E1'   C0                    	RNZ			; the replay's own keys are not recorded
  00E2'   C5                    	PUSH	B
  00E3'   D5                    	PUSH	D
  00E4'   E5                    	PUSH	H
  00E5'   3A 2A1E'              	LDA	DOTSTA
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00E8'   B7                    	ORA	A
  00E9'   CA 00FC'              	JZ	DOTP1
  00EC'   AF                    	XRA	A		; a new command: the recording starts over
  00ED'   32 2A1E'              	STA	DOTSTA
  00F0'   32 2A20'              	STA	DOTOVF
  00F3'   21 0000*              	LXI	H,DOTSCR
  00F6'   22 2A22'              	SHLD	DOTSP
  00F9'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00FC'                         DOTP1:
  00FC'   78                    	MOV	A,B
  00FD'   FE 00                 	CPI	KT_NONE
  00FF'   CA 0128'              	JZ	DOTPX		; a discarded key is not a keystroke
  0102'   FE 01                 	CPI	KT_ACT
  0104'   79                    	MOV	A,C
  0105'   CA 010D'              	JZ	DOTP2
  0108'   E6 7F                 	ANI	7FH		; a char stands for itself (CPYGAP masks inserts
  010A'   C3 010F'              	JMP	DOTP3		;   the same way), bit 7 marks an action key
  010D'                         DOTP2:
  010D'   F6 80                 	ORI	80H		; an action key (an arrow) rides in bit 7
  010F'                         DOTP3:
  010F'   32 2A21'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  0112'   47                    	MOV	B,A
  0113'   2A 2A22'              	LHLD	DOTSP
  0116'   EB                    	XCHG
  0117'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  011A'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  011D'   D2 012C'              	JNC	DOTPOV
  0120'   2A 2A22'              	LHLD	DOTSP
  0123'   70                    	MOV	M,B
  0124'   23                    	INX	H
  0125'   22 2A22'              	SHLD	DOTSP
  0128'                         DOTPX:
  0128'   E1                    	POP	H
  0129'   D1                    	POP	D
  012A'   C1                    	POP	B
  012B'   C9                    	RET
  012C'                         DOTPOV:
  012C'   3E 01                 	MVI	A,1
  012E'   32 2A20'              	STA	DOTOVF		; too long to record: give this recording up
  0131'   C3 0128'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  0134'                         DOTPOST:
  0134'   3A 2A1F'              	LDA	DOTRPL
  0137'   B7                    	ORA	A
  0138'   C0                    	RNZ
  0139'   3A 2A00'              	LDA	EDMODE
  013C'   B7                    	ORA	A
  013D'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  013E'   3A 2A28'              	LDA	GPEND
  0141'   B7                    	ORA	A
  0142'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  0143'   3A 2A2A'              	LDA	PENDOP
  0146'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0147'   C0                    	RNZ			; an operator still waiting for its motion
  0148'   2A 2A01'              	LHLD	CMDCNT
  014B'   7C                    	MOV	A,H
  014C'   B5                    	ORA	L
  014D'   CA 015B'              	JZ	DOTQ1
  0150'   3A 2A21'              	LDA	DOTLK		; a digit with the count still up: the command
  0153'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  0155'   DA 015B'              	JC	DOTQ1
  0158'   FE 3A                 	CPI	'9'+1
  015A'   D8                    	RC
  015B'                         DOTQ1:
  015B'   3E 01                 	MVI	A,1
  015D'   32 2A1E'              	STA	DOTSTA		; the next key starts a new recording
  0160'   3A 2A1D'              	LDA	DOTCHG
  0163'   B7                    	ORA	A
  0164'   C8                    	RZ			; changed nothing: not a repeatable command
  0165'   AF                    	XRA	A
  0166'   32 2A1D'              	STA	DOTCHG
  0169'   32 2A24'              	STA	DOTLEN
  016C'   3A 2A20'              	LDA	DOTOVF
  016F'   B7                    	ORA	A
  0170'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  0171'   2A 2A22'              	LHLD	DOTSP
  0174'   11 0000*              	LXI	D,DOTSCR
  0177'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  017A'   7D                    	MOV	A,L
  017B'   32 2A24'              	STA	DOTLEN
  017E'   B7                    	ORA	A
  017F'   C8                    	RZ
  0180'   4F                    	MOV	C,A
  0181'   06 00                 	MVI	B,0
  0183'   21 0000*              	LXI	H,DOTSCR
  0186'   11 0000*              	LXI	D,DOTBUF
  0189'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  018C'                         MARKMOD:
  018C'   3E 01                 	MVI	A,1
  018E'   32 2A04'              	STA	MODF
  0191'   32 2A1D'              	STA	DOTCHG
  0194'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  0195'                         VC_DOT:
  0195'   2A 2A01'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0198'   22 2A26'              	SHLD	DOTNCT
  019B'   21 0000               	LXI	H,0
  019E'   22 2A01'              	SHLD	CMDCNT
  01A1'   3A 2A24'              	LDA	DOTLEN
  01A4'   B7                    	ORA	A
  01A5'   CA 01FF'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01A8'   AF                    	XRA	A
  01A9'   32 2A25'              	STA	DOTIX
  01AC'   2A 2A26'              	LHLD	DOTNCT
  01AF'   7C                    	MOV	A,H
  01B0'   B5                    	ORA	L
  01B1'   CA 01D1'              	JZ	DOTGO
  01B4'   22 2A01'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  01B7'                         DOTSKP:
  01B7'   CD 0564'              	CALL	DOTGET		; ... so step past the digits it recorded
  01BA'   DA 01D1'              	JC	DOTGO
  01BD'   FE 30                 	CPI	'0'
  01BF'   DA 01D1'              	JC	DOTGO
  01C2'   FE 3A                 	CPI	'9'+1
  01C4'   D2 01D1'              	JNC	DOTGO
  01C7'   3A 2A25'              	LDA	DOTIX
  01CA'   3C                    	INR	A
  01CB'   32 2A25'              	STA	DOTIX
  01CE'   C3 01B7'              	JMP	DOTSKP
  01D1'                         DOTGO:
  01D1'   3E 01                 	MVI	A,1
  01D3'   32 2A1F'              	STA	DOTRPL
  01D6'                         DOTLP:
  01D6'   CD 0564'              	CALL	DOTGET
  01D9'   DA 01F5'              	JC	DOTDN
  01DC'   4F                    	MOV	C,A
  01DD'   06 02                 	MVI	B,KT_CHAR
  01DF'   B7                    	ORA	A
  01E0'   F2 01E8'              	JP	DOTLP2
  01E3'   E6 7F                 	ANI	7FH		; bit 7: the key was an action, not a char
  01E5'   4F                    	MOV	C,A
  01E6'   06 01                 	MVI	B,KT_ACT
  01E8'                         DOTLP2:
  01E8'   3A 2A25'              	LDA	DOTIX
  01EB'   3C                    	INR	A
  01EC'   32 2A25'              	STA	DOTIX
  01EF'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01F2'   C3 01D6'              	JMP	DOTLP
  01F5'                         DOTDN:
  01F5'   AF                    	XRA	A
  01F6'   32 2A1F'              	STA	DOTRPL
  01F9'   32 2A1D'              	STA	DOTCHG		; the '.' is not itself the new last change
  01FC'   C3 077B'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01FF'                         DOTBEL:
  01FF'   0E 07                 	MVI	C,BEL
  0201'   CD 0000*              	CALL	BCONOU
  0204'   C3 075A'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a 3-byte position in the FILE (FPOS: the records paged out ahead
                                ; of the window, plus the offset into it), so it does not care which part of
                                ; the file is resident: a jump pages until the window holds it (MKPAGE).  It
                                ; FOLLOWS its text, as vim's does: every edit passes MKSHFT, which moves the
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


                                ; marks past it by the bytes that went in or came out.
                                ;
                                ; DEVIATIONS from vim, in COMMANDS.md: a mark whose own text is deleted closes
                                ; up to where the delete was, where vim deletes the mark with its line; and
                                ; within its line a mark stays with its CHARACTER, where vim keeps the column
                                ; number.  '.' after a 'd''a' still refuses: the mark letter is read inside
                                ; the command and never recorded.
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  0207'                         MKVAD:
  0207'   16 00                 	MVI	D,0
  0209'   59                    	MOV	E,C
  020A'   21 2A8F'              	LXI	H,MKVAL
  020D'   19                    	DAD	D
  020E'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  020F'                         MKCLR:
  020F'   21 2A8F'              	LXI	H,MKVAL
  0212'   06 03                 	MVI	B,MKMAX
  0214'   AF                    	XRA	A
  0215'                         MKC_LP:
  0215'   77                    	MOV	M,A
  0216'   23                    	INX	H
  0217'   05                    	DCR	B
  0218'   C2 0215'              	JNZ	MKC_LP
  021B'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was not a character.
  021C'                         MKGETK:
  021C'   3A 2A1F'              	LDA	DOTRPL
  021F'   B7                    	ORA	A
  0220'   CA 0231'              	JZ	MKG_KB
  0223'   CD 0564'              	CALL	DOTGET		; the recording's next key
  0226'   D8                    	RC
  0227'   4F                    	MOV	C,A
  0228'   3A 2A25'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  022B'   3C                    	INR	A
  022C'   32 2A25'              	STA	DOTIX
  022F'   B7                    	ORA	A		; CY clear
  0230'   C9                    	RET
  0231'                         MKG_KB:
  0231'   CD 0000*              	CALL	GETKEY
  0234'   78                    	MOV	A,B
  0235'   FE 02                 	CPI	KT_CHAR
  0237'   37                    	STC
  0238'   C0                    	RNZ			; an action key (ESC) cancels the command
  0239'   B7                    	ORA	A		; CY clear
  023A'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
                                ; the motion returns.  Unlike the marks, the character is then handed to
                                ; DOTPRE, so it joins the recording and '.' can repeat "dfa" -- MKGETK's
                                ; keyboard path does not record for itself.
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
                                ;============================================================
  023B'                         VC_FF:				; 'f' -- forward, onto the character
  023B'   3E 66                 	MVI	A,'f'
  023D'   C3 024C'              	JMP	FNDNEW
  0240'                         VC_FB:				; 'F' -- backward, onto it
  0240'   3E 46                 	MVI	A,'F'
  0242'   C3 024C'              	JMP	FNDNEW
  0245'                         VC_TF:				; 't' -- forward, up to it
  0245'   3E 74                 	MVI	A,'t'
  0247'   C3 024C'              	JMP	FNDNEW
  024A'                         VC_TB:				; 'T' -- backward, up to it
  024A'   3E 54                 	MVI	A,'T'
  024C'                         FNDNEW:
  024C'   32 2A84'              	STA	FNDKND		; the find ';' and ',' will repeat
  024F'   CD 021C'              	CALL	MKGETK		; the character it looks for
  0252'   DA 0289'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0255'   79                    	MOV	A,C
  0256'   32 2A85'              	STA	FNDCH
  0259'   06 02                 	MVI	B,KT_CHAR	; ... and into the '.' recording (see the head)
  025B'   CD 00DD'              	CALL	DOTPRE
  025E'   3A 2A84'              	LDA	FNDKND
  0261'   06 01                 	MVI	B,1		; a find starts at the next character along
  0263'   C3 0290'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0266'                         VC_SEMI:
  0266'   3A 2A84'              	LDA	FNDKND
  0269'   B7                    	ORA	A
  026A'   CA 0289'              	JZ	FNDNIL		; nothing has been looked for yet
  026D'   C3 0279'              	JMP	FNDREP
  0270'                         VC_COMMA:
  0270'   3A 2A84'              	LDA	FNDKND
  0273'   B7                    	ORA	A
  0274'   CA 0289'              	JZ	FNDNIL
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  0277'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0279'                         FNDREP:
  0279'   06 01                 	MVI	B,1
  027B'   F5                    	PUSH	PSW
  027C'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  027E'   FE 54                 	CPI	'T'
  0280'   C2 0285'              	JNZ	FNDR_GO
  0283'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  0285'                         FNDR_GO:
  0285'   F1                    	POP	PSW
  0286'   C3 0290'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
  0289'                         FNDNIL:
  0289'   AF                    	XRA	A
  028A'   32 2A2B'              	STA	PSAVE
  028D'   C3 075A'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  0290'                         FNDGO:
  0290'   32 2A86'              	STA	FNDRUN
  0293'   78                    	MOV	A,B
  0294'   32 2A87'              	STA	FNDSTP
  0297'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
  029A'   22 2A88'              	SHLD	FNDN		; the occurrence wanted
  029D'   CD 0000*              	CALL	CUROFF
  02A0'   22 2A8A'              	SHLD	FNDCUR
  02A3'   3A 2A86'              	LDA	FNDRUN
  02A6'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  02A8'   CA 02DC'              	JZ	FNDBWD
  02AB'   2A 2A8A'              	LHLD	FNDCUR
  02AE'   CD 0623'              	CALL	EOLC		; HL = the line's last content character
  02B1'   22 2A8C'              	SHLD	FNDLIM
  02B4'   2A 2A8A'              	LHLD	FNDCUR
  02B7'   3A 2A87'              	LDA	FNDSTP
  02BA'   5F                    	MOV	E,A
  02BB'   16 00                 	MVI	D,0
  02BD'   19                    	DAD	D		; HL = where the scan starts
  02BE'                         FNDF_LP:
  02BE'   EB                    	XCHG			; DE = the scan
  02BF'   2A 2A8C'              	LHLD	FNDLIM
  02C2'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  02C5'   EB                    	XCHG			; HL = the scan
  02C6'   CA 02CC'              	JZ	FNDF_AT		; the last character is still a candidate
  02C9'   D2 032E'              	JNC	FNDMIS		; past it: not on this line
  02CC'                         FNDF_AT:
  02CC'   CD 0335'              	CALL	FNDSEE		; Z iff this is the character
  02CF'   C2 02D8'              	JNZ	FNDF_NX
  02D2'   CD 0340'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02D5'   CA 0314'              	JZ	FNDHIT
  02D8'                         FNDF_NX:
  02D8'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02D9'   C3 02BE'              	JMP	FNDF_LP
  02DC'                         FNDBWD:
  02DC'   2A 2A8A'              	LHLD	FNDCUR
  02DF'   CD 05E4'              	CALL	BOL		; HL = the line's first character
  02E2'   22 2A8C'              	SHLD	FNDLIM
  02E5'   2A 2A8A'              	LHLD	FNDCUR
  02E8'   3A 2A87'              	LDA	FNDSTP
  02EB'   2F                    	CMA
  02EC'   5F                    	MOV	E,A
  02ED'   16 FF                 	MVI	D,0FFH
  02EF'   13                    	INX	D		; DE = -step
  02F0'   19                    	DAD	D		; HL = where the scan starts
  02F1'   D2 032E'              	JNC	FNDMIS		; ... off the front of the text altogether
  02F4'                         FNDB_LP:
  02F4'   EB                    	XCHG			; DE = the scan
  02F5'   2A 2A8C'              	LHLD	FNDLIM
  02F8'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02FB'   EB                    	XCHG			; HL = the scan
  02FC'   DA 032E'              	JC	FNDMIS		; before this line: not on it
  02FF'   CD 0335'              	CALL	FNDSEE
  0302'   C2 030B'              	JNZ	FNDB_NX
  0305'   CD 0340'              	CALL	FNDCNT
  0308'   CA 0314'              	JZ	FNDHIT
  030B'                         FNDB_NX:
  030B'   7C                    	MOV	A,H
  030C'   B5                    	ORA	L
  030D'   CA 032E'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
  0310'   2B                    	DCX	H
  0311'   C3 02F4'              	JMP	FNDB_LP
                                
                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  0314'                         FNDHIT:
  0314'   3A 2A86'              	LDA	FNDRUN
  0317'   E6 5F                 	ANI	5FH
  0319'   FE 54                 	CPI	'T'
  031B'   C2 032B'              	JNZ	FNDLND
  031E'   3A 2A86'              	LDA	FNDRUN
  0321'   E6 20                 	ANI	20H
  0323'   CA 032A'              	JZ	FNDH_BW
  0326'   2B                    	DCX	H		; forward 't': the character before it
  0327'   C3 032B'              	JMP	FNDLND
  032A'                         FNDH_BW:
  032A'   23                    	INX	H		; backward 'T': the character after it
  032B'                         FNDLND:
  032B'   C3 057A'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  032E'                         FNDMIS:
  032E'   AF                    	XRA	A
  032F'   32 2A2B'              	STA	PSAVE
  0332'   C3 01FF'              	JMP	DOTBEL
                                
                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  0335'                         FNDSEE:
  0335'   E5                    	PUSH	H
  0336'   CD 0000*              	CALL	CHARAT
  0339'   E1                    	POP	H
  033A'   47                    	MOV	B,A
  033B'   3A 2A85'              	LDA	FNDCH
  033E'   B8                    	CMP	B
  033F'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
                                ; the scan and stays it.
  0340'                         FNDCNT:
  0340'   E5                    	PUSH	H
  0341'   2A 2A88'              	LHLD	FNDN
  0344'   2B                    	DCX	H
  0345'   22 2A88'              	SHLD	FNDN
  0348'   7C                    	MOV	A,H
  0349'   B5                    	ORA	L
  034A'   E1                    	POP	H
  034B'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  034C'                         ISFIND:
  034C'   E6 5F                 	ANI	5FH		; fold the case away
  034E'   FE 46                 	CPI	'F'
  0350'   C8                    	RZ
  0351'   FE 54                 	CPI	'T'
  0353'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  0354'                         VC_MK:
  0354'   3E 04                 	MVI	A,PM
  0356'   C3 0360'              	JMP	MKGO
  0359'                         VC_BQ:
  0359'   3E 05                 	MVI	A,PJ
  035B'   C3 0360'              	JMP	MKGO
  035E'                         VC_AQ:
  035E'   3E 06                 	MVI	A,PJL
  0360'                         MKGO:
  0360'   32 2A9B'              	STA	MKWHAT
  0363'   CD 0678'              	CALL	MOVCNT		; a count means nothing on any of the three
  0366'   CD 021C'              	CALL	MKGETK		; the key that names the mark
  0369'   DA 0448'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out -- the letter is read here and so
                                				;   was never recorded, which is why a '.'
                                				;   after "d'a" refuses (COMMANDS.md).  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist: 'm' with any other key
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


                                ;drops the whole thing, as vim's 'Z{other}' does, and a jump to one is a jump
                                ;to a mark that is not set.
  036C'                         MKOP:
  036C'   79                    	MOV	A,C
  036D'   D6 61                 	SUI	'a'
  036F'   FE 03                 	CPI	MKMAX
  0371'   D2 0440'              	JNC	MKNOLT		; not a mark letter
  0374'   4F                    	MOV	C,A		; C = the mark's index
  0375'   87                    	ADD	A
  0376'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  0377'   5F                    	MOV	E,A
  0378'   16 00                 	MVI	D,0
  037A'   21 0000*              	LXI	H,MKTAB
  037D'   19                    	DAD	D		; HL -> this mark's slot
  037E'   3A 2A9B'              	LDA	MKWHAT
  0381'   FE 04                 	CPI	PM
  0383'   CA 045B'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark, paging to it if the window has left it.
                                ;'Mark not set', as vim says it, when it was never set.
                                ;Under an OPERATOR a mark the window does not hold is refused with the bell
                                ;and stays set, all but "d'a": a line delete is the one operator that can take
                                ;a span the window does not hold whole (OPPGD), and going there only to be
                                ;turned away by it would page the file twice for nothing.
  0386'                         MKJMP:
  0386'   E5                    	PUSH	H
  0387'   CD 0207'              	CALL	MKVAD
  038A'   7E                    	MOV	A,M
  038B'   E1                    	POP	H
  038C'   B7                    	ORA	A
  038D'   CA 0436'              	JZ	MKNSET		; never set
  0390'   CD 0402'              	CALL	MKLOAD		; the file position it holds
  0393'   CD 040F'              	CALL	MKWIN
  0396'   DA 03AD'              	JC	MKJ_GO		; in the window: any command may go there
  0399'   3A 2A2B'              	LDA	PSAVE
  039C'   B7                    	ORA	A
  039D'   CA 03AD'              	JZ	MKJ_GO
  03A0'   FE 64                 	CPI	'd'		; paged out, and an operator wants the span
  03A2'   C2 0448'              	JNZ	MKBAD
  03A5'   3A 2A9B'              	LDA	MKWHAT
  03A8'   FE 06                 	CPI	PJL
  03AA'   C2 0448'              	JNZ	MKBAD
  03AD'                         MKJ_GO:
  03AD'   CD 0F6D'              	CALL	GZONE		; the screen's top line, before the cursor
                                				;   moves: GPLACE measures the landing against
                                				;   it, and one left over from an earlier 'G'
                                				;   had it keep a window the line is not in
  03B0'   CD 06B4'              	CALL	BRKON		; ... and a ^C may stop it from here on
  03B3'   CD 03CF'              	CALL	MKPAGE		; HL = the mark's offset in the window
  03B6'   CD 06EB'              	CALL	BRKOFF		; (A only)
  03B9'   DA 0703'              	JC	BRKBAK
  03BC'   3A 2A9B'              	LDA	MKWHAT
  03BF'   FE 06                 	CPI	PJL
  03C1'   CA 03C9'              	JZ	MKJ_LN		; ''': GPKEEP is 0, so GPLACE finds the first
  03C4'   3E 01                 	MVI	A,1		;   non-blank
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  03C6'   32 2A8E'              	STA	GPKEEP		; '`': land on the column it was set at
  03C9'                         MKJ_LN:
  03C9'   CD 0000*              	CALL	GOTO
  03CC'   C3 0F85'              	JMP	GPLACE		; (which sets LNDLT itself)
                                
                                ;MKPAGE -- page until MKPOS is in the window: HL = its logical offset there.
                                ;The loop is WM's own whole-file line move (MVLMAX: GOLINE to the window's
                                ;edge, SCRLST to page one step), stopped by where the window is instead of by
                                ;the count.  A step cannot carry the window past the mark: the pager evicts
                                ;only behind the cursor, and the cursor is on the edge nearer the mark.
  03CF'                         MKPAGE:
  03CF'   CD 040F'              	CALL	MKWIN
  03D2'   DA 0000*              	JC	CLRCNT		; there: and the count that paged is spent,
                                				;   not left for the next command to take
  03D5'   32 0000*              	STA	DIRFLG
  03D8'   21 FFFF               	LXI	H,0FFFFH
  03DB'   22 2A01'              	SHLD	CMDCNT
  03DE'   CD 0000*              	CALL	GOLINE
  03E1'   CD 0000*              	CALL	SCRLST
  03E4'   CD 06A0'              	CALL	CNTTST
  03E7'   C2 03CF'              	JNZ	MKPAGE
  03EA'   CD 040F'              	CALL	MKWIN		; the file ran out: that was its last step
  03ED'   DA 0000*              	JC	CLRCNT
  03F0'   21 FFFF               	LXI	H,0FFFFH	; the very end of the text, which MKWIN does not
  03F3'   C3 0000*              	JMP	CLRCNT		;   count as in the window: GOTO clamps it
                                
                                ;BACKTO -- back to the 3-byte file position at HL, paging to it: where a
                                ;command that came to nothing started.  The place has to be kept as a file
                                ;position -- a sweep of the whole file leaves the window at the far end of
                                ;it, and an offset into the window it started in means nothing there.
  03F6'                         BACKTO:
  03F6'   CD 0402'              	CALL	MKLOAD
  03F9'   CD 0000*              	CALL	CLRCNT
  03FC'   CD 03CF'              	CALL	MKPAGE
  03FF'   C3 0000*              	JMP	GOTO
                                
                                ;MKLOAD -- MKPOS = the 3-byte file position at HL.
  0402'                         MKLOAD:
  0402'   5E                    	MOV	E,M
  0403'   23                    	INX	H
  0404'   56                    	MOV	D,M
  0405'   23                    	INX	H
  0406'   7E                    	MOV	A,M
  0407'   EB                    	XCHG
  0408'   22 2A98'              	SHLD	MKPOS
  040B'   32 2A9A'              	STA	MKPOS+2
  040E'   C9                    	RET
                                
                                ;MKWIN -- CY and HL = MKPOS as a logical offset if the window holds it; NC and
                                ;A = the way to page for it, as DIRFLG has it (0 forward, FFH back), if not.
  040F'                         MKWIN:
  040F'   2A 0000*              	LHLD	TXTBEG
  0412'   CD 0F27'              	CALL	FPOS
  0415'   EB                    	XCHG
  0416'   47                    	MOV	B,A		; B:DE = the window's first byte
  0417'   2A 2A98'              	LHLD	MKPOS
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  041A'   3A 2A9A'              	LDA	MKPOS+2
  041D'   CD 0F1A'              	CALL	SUB24		; A:HL = the mark, from the window's top
  0420'   DA 0432'              	JC	MKW_BK		; above it
  0423'   C2 0430'              	JNZ	MKW_FW		; 64K or more below it
  0426'   E5                    	PUSH	H
  0427'   CD 0000*              	CALL	LOGLEN
  042A'   D1                    	POP	D
  042B'   CD 0000*              	CALL	CMP16		; DE = the offset vs HL = the window's length
  042E'   EB                    	XCHG
  042F'   D8                    	RC			; inside
  0430'                         MKW_FW:
  0430'   AF                    	XRA	A
  0431'   C9                    	RET
  0432'                         MKW_BK:
  0432'   3E FF                 	MVI	A,0FFH
  0434'   B7                    	ORA	A
  0435'   C9                    	RET
                                
                                ;MKNSET -- a jump to a mark that will not answer: vim's E20 on the bottom row
                                ;(without the number, and without a bell, as every message here), the cursor
                                ;and the screen left alone.  The operator is cancelled as MKBAD cancels it.
  0436'                         MKNSET:
  0436'   AF                    	XRA	A
  0437'   32 2A2B'              	STA	PSAVE
  043A'   21 23BF'              	LXI	H,SMKNS
  043D'   C3 22B4'              	JMP	EXERR
  0440'                         MKNOLT:
  0440'   3A 2A9B'              	LDA	MKWHAT
  0443'   FE 04                 	CPI	PM
  0445'   C2 0436'              	JNZ	MKNSET		; a jump: that mark is not set
                                				; 'm{other}': fall into MKBAD
                                
                                ;MKBAD -- no mark was named: 'm' with a key that is not a mark letter, ESC in
                                ;place of the letter, or a '.' replay that ran out.  The bell, and an operator
                                ;running the motion is cancelled whole: PSAVE is what OPPEND's tail reads to
                                ;decide whether to open an insert, so clearing it stops a "c`z" opening one
                                ;over a span of nothing.
  0448'                         MKBAD:
  0448'   AF                    	XRA	A
  0449'   32 2A2B'              	STA	PSAVE
  044C'   C3 01FF'              	JMP	DOTBEL
                                
                                ;FPSTO -- the cursor's file position into the 3 bytes at HL.  Keeps BC.
  044F'                         FPSTO:
  044F'   E5                    	PUSH	H
  0450'   CD 0F24'              	CALL	CURFP		; A:HL = the cursor's file position
  0453'   EB                    	XCHG
  0454'   E1                    	POP	H
  0455'   73                    	MOV	M,E
  0456'   23                    	INX	H
  0457'   72                    	MOV	M,D
  0458'   23                    	INX	H
  0459'   77                    	MOV	M,A
  045A'   C9                    	RET
                                
                                ;MKSET -- remember where in the FILE the cursor is.
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  045B'                         MKSET:
  045B'   CD 044F'              	CALL	FPSTO
  045E'   CD 0207'              	CALL	MKVAD
  0461'   36 01                 	MVI	M,1		; ... and the mark is live
  0463'   C3 075A'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKSHFT -- the text is changing: every mark follows its own text.  BUF.MAC's
                                ;UNDCHG calls this through EDTHK from all six edit primitives -- 'u's replay
                                ;of them included -- with A = 1 for an insert (the text is in) or 2 for a
                                ;delete (it is about to go), HL = the edit's logical offset and BC = its
                                ;length.  A mark before the edit stays; one after it moves by the length; one
                                ;INSIDE a delete closes up to where the delete was.  An insert AT a mark
                                ;leaves the mark in front of the new text, unless that text ends a line -- a
                                ;line opened or put above the mark's is above the mark too.
                                ;The edit is found from the CURSOR's file position less its distance behind
                                ;the cursor, never from the offset alone: a put bigger than the window pages
                                ;its own start out, and that offset has then wrapped.  BC is kept.
  0466'                         MKSHFT:
  0466'   32 2A97'              	STA	MKTYP
  0469'   3A 2A9C'              	LDA	MKHOLD		; a yank that could not copy takes its lines out
  046C'   B7                    	ORA	A		;   and puts them back unchanged (YKGO): the text
  046D'   C0                    	RNZ			;   every mark points into is still there
  046E'   C5                    	PUSH	B
  046F'   50                    	MOV	D,B
  0470'   59                    	MOV	E,C
  0471'   EB                    	XCHG
  0472'   22 2A95'              	SHLD	MKN		; the edit's length
  0475'   D5                    	PUSH	D		; ... and its offset
  0476'   CD 0000*              	CALL	CUROFF
  0479'   D1                    	POP	D
  047A'   CD 0000*              	CALL	SUBHD
  047D'   EB                    	XCHG			; DE = how far behind the cursor it is
  047E'   CD 0F24'              	CALL	CURFP		; A:HL = the cursor's file position
  0481'   06 00                 	MVI	B,0
  0483'   CD 0F1A'              	CALL	SUB24
  0486'   22 2A92'              	SHLD	MKEDIT
  0489'   32 2A94'              	STA	MKEDIT+2	; where in the file the edit is
  048C'   21 2A8F'              	LXI	H,MKVAL
  048F'   11 0000*              	LXI	D,MKTAB
  0492'   06 03                 	MVI	B,MKMAX
  0494'                         MKS_LP:
  0494'   7E                    	MOV	A,M
  0495'   B7                    	ORA	A
  0496'   CA 0502'              	JZ	MKS_N0		; that mark is not set
  0499'   E5                    	PUSH	H
  049A'   C5                    	PUSH	B
  049B'   21 2A92'              	LXI	H,MKEDIT
  049E'   1A                    	LDAX	D		; the mark's position less the edit's, a byte
  049F'   96                    	SUB	M		;   at a time (neither INX nor LDAX touch CY)
  04A0'   4F                    	MOV	C,A
  04A1'   13                    	INX	D
  04A2'   23                    	INX	H
  04A3'   1A                    	LDAX	D
  04A4'   9E                    	SBB	M
  04A5'   47                    	MOV	B,A
  04A6'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  04A7'   23                    	INX	H
  04A8'   1A                    	LDAX	D
  04A9'   9E                    	SBB	M		; A:BC = how far past the edit the mark is
  04AA'   DA 04FD'              	JC	MKS_PP		; before it: nothing moves
  04AD'   6F                    	MOV	L,A
  04AE'   3A 2A97'              	LDA	MKTYP
  04B1'   3D                    	DCR	A
  04B2'   CA 04D7'              	JZ	MKS_IN
                                	;--- a delete: back by its length, or to it if the mark is inside ---
  04B5'   7D                    	MOV	A,L
  04B6'   2A 2A95'              	LHLD	MKN
  04B9'   B7                    	ORA	A
  04BA'   C2 04C6'              	JNZ	MKS_DL		; 64K or more past it
  04BD'   79                    	MOV	A,C
  04BE'   95                    	SUB	L
  04BF'   78                    	MOV	A,B
  04C0'   9C                    	SBB	H
  04C1'   D2 04C6'              	JNC	MKS_DL		; past the end of what goes
  04C4'   60                    	MOV	H,B
  04C5'   69                    	MOV	L,C		; inside it: close up to the edit
  04C6'                         MKS_DL:
  04C6'   1B                    	DCX	D
  04C7'   1B                    	DCX	D
  04C8'   1A                    	LDAX	D
  04C9'   95                    	SUB	L
  04CA'   12                    	STAX	D
  04CB'   13                    	INX	D
  04CC'   1A                    	LDAX	D
  04CD'   9C                    	SBB	H
  04CE'   12                    	STAX	D
  04CF'   13                    	INX	D
  04D0'   1A                    	LDAX	D
  04D1'   DE 00                 	SBI	0
  04D3'   12                    	STAX	D
  04D4'   C3 04FD'              	JMP	MKS_PP
                                	;--- an insert: on by its length ---
  04D7'                         MKS_IN:
  04D7'   7D                    	MOV	A,L
  04D8'   B0                    	ORA	B
  04D9'   B1                    	ORA	C
  04DA'   C2 04EC'              	JNZ	MKS_AD		; the mark is past it
  04DD'   2A 0000*              	LHLD	GAPBEG		; AT the mark: only a line end carries it on
  04E0'   2B                    	DCX	H
  04E1'   7E                    	MOV	A,M		; the last byte that went in
  04E2'   FE 0A                 	CPI	LF
  04E4'   CA 04EC'              	JZ	MKS_AD
  04E7'   FE 0D                 	CPI	CR
  04E9'   C2 04FD'              	JNZ	MKS_PP
  04EC'                         MKS_AD:
  04EC'   2A 2A95'              	LHLD	MKN
  04EF'   1B                    	DCX	D
  04F0'   1B                    	DCX	D
  04F1'   1A                    	LDAX	D
  04F2'   85                    	ADD	L
  04F3'   12                    	STAX	D
  04F4'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04F5'   1A                    	LDAX	D
  04F6'   8C                    	ADC	H
  04F7'   12                    	STAX	D
  04F8'   13                    	INX	D
  04F9'   1A                    	LDAX	D
  04FA'   CE 00                 	ACI	0
  04FC'   12                    	STAX	D
  04FD'                         MKS_PP:
  04FD'   C1                    	POP	B
  04FE'   E1                    	POP	H
  04FF'   C3 0504'              	JMP	MKS_NX
  0502'                         MKS_N0:
  0502'   13                    	INX	D
  0503'   13                    	INX	D
  0504'                         MKS_NX:
  0504'   13                    	INX	D
  0505'   13                    	INX	D
  0506'   23                    	INX	H
  0507'   05                    	DCR	B
  0508'   C2 0494'              	JNZ	MKS_LP
  050B'   C1                    	POP	B
  050C'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  050D'                         VC_UNDO:
  050D'   21 0000               	LXI	H,0
  0510'   22 2A01'              	SHLD	CMDCNT
  0513'   CD 0000*              	CALL	UNDO
  0516'   DA 0547'              	JC	UNDNO
  0519'   2A 0000*              	LHLD	UNDCUR
  051C'   CD 052D'              	CALL	UCLAMP		; vi never sits on a line terminator
  051F'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0522'   3E 01                 	MVI	A,1
  0524'   32 2A04'              	STA	MODF		; undone past a ':w' still differs from the file
  0527'   CD 08DA'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  052A'   C3 077B'              	JMP	SETFUL		; whole spans moved: repaint rather than guess
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  052D'                         UCLAMP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  052D'   E5                    	PUSH	H
  052E'   CD 14E9'              	CALL	CEND		; HL = the line's content end
  0531'   D1                    	POP	D		; DE = the offset wanted
  0532'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  0535'   D2 053A'              	JNC	UCL_BK
  0538'   EB                    	XCHG
  0539'   C9                    	RET
  053A'                         UCL_BK:
  053A'   E5                    	PUSH	H		; the content end
  053B'   EB                    	XCHG			; HL = the offset wanted
  053C'   CD 05E4'              	CALL	BOL
  053F'   D1                    	POP	D		; DE = the content end, HL = the line's start
  0540'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  0543'   EB                    	XCHG			; HL = the content end
  0544'   C8                    	RZ
  0545'   2B                    	DCX	H		; ... its last character
  0546'   C9                    	RET
  0547'                         UNDNO:
  0547'   3A 0000*              	LDA	UNDWHY
  054A'   B7                    	ORA	A
  054B'   CA 055C'              	JZ	UNDBEL
  054E'   21 2379'              	LXI	H,SUNDW		; the change has paged away: say so
  0551'   FE 01                 	CPI	1
  0553'   CA 22B4'              	JZ	EXERR
  0556'   21 239B'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  0559'   C3 22B4'              	JMP	EXERR
  055C'                         UNDBEL:
  055C'   0E 07                 	MVI	C,BEL
  055E'   CD 0000*              	CALL	BCONOU
  0561'   C3 075A'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  0564'                         DOTGET:
  0564'   3A 2A25'              	LDA	DOTIX
  0567'   5F                    	MOV	E,A
  0568'   3A 2A24'              	LDA	DOTLEN
  056B'   BB                    	CMP	E
  056C'   CA 0578'              	JZ	DOTGEF
  056F'   16 00                 	MVI	D,0
  0571'   21 0000*              	LXI	H,DOTBUF
  0574'   19                    	DAD	D
  0575'   7E                    	MOV	A,M
  0576'   B7                    	ORA	A		; CY clear: a key was returned
  0577'   C9                    	RET
  0578'                         DOTGEF:
  0578'   37                    	STC
  0579'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  057A'                         GOSET:
  057A'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  057D'                         SETGL:
  057D'   CD 0F47'              	CALL	ZSAVE
  0580'   21 0000               	LXI	H,0
  0583'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  0586'   E5                    	PUSH	H
  0587'   CD 0F5A'              	CALL	ZREST
  058A'   E1                    	POP	H
  058B'   E5                    	PUSH	H
  058C'   CD 0684'              	CALL	GBSUB		; HL = bytes to the cursor
  058F'   44                    	MOV	B,H
  0590'   4D                    	MOV	C,L
  0591'   E1                    	POP	H		; HL = the line's start
  0592'   11 0000               	LXI	D,0		; DE = screen column
  0595'                         SG_LP:
  0595'   78                    	MOV	A,B
  0596'   B1                    	ORA	C
  0597'   CA 05AC'              	JZ	SG_CUR
  059A'   7E                    	MOV	A,M
  059B'   23                    	INX	H
  059C'   0B                    	DCX	B
  059D'   E5                    	PUSH	H
  059E'   6B                    	MOV	L,E
  059F'   CD 05D1'              	CALL	CWID
  05A2'   E1                    	POP	H
  05A3'   83                    	ADD	E
  05A4'   5F                    	MOV	E,A
  05A5'   D2 0595'              	JNC	SG_LP
  05A8'   14                    	INR	D
  05A9'   C3 0595'              	JMP	SG_LP
  05AC'                         SG_CUR:
  05AC'   2A 0000*              	LHLD	TXTEND
  05AF'   D5                    	PUSH	D
  05B0'   EB                    	XCHG
  05B1'   2A 0000*              	LHLD	GAPEND
  05B4'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  05B7'   D1                    	POP	D
  05B8'   CA 05CC'              	JZ	SG_SET
  05BB'   7E                    	MOV	A,M
  05BC'   FE 09                 	CPI	TAB
  05BE'   C2 05CC'              	JNZ	SG_SET
  05C1'   6B                    	MOV	L,E
  05C2'   CD 05D1'              	CALL	CWID
  05C5'   3D                    	DCR	A		; the TAB's last column
  05C6'   83                    	ADD	E
  05C7'   5F                    	MOV	E,A
  05C8'   D2 05CC'              	JNC	SG_SET
  05CB'   14                    	INR	D
  05CC'                         SG_SET:
  05CC'   EB                    	XCHG
  05CD'   22 2A09'              	SHLD	GOALCOL
  05D0'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  05D1'                         CWID:
  05D1'   FE 0D                 	CPI	CR
  05D3'   CA 05E2'              	JZ	CW_0
  05D6'   FE 09                 	CPI	TAB
  05D8'   3E 01                 	MVI	A,1
  05DA'   C0                    	RNZ
  05DB'   7D                    	MOV	A,L
  05DC'   E6 07                 	ANI	TABWID-1
  05DE'   2F                    	CMA
  05DF'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  05E1'   C9                    	RET
  05E2'                         CW_0:
  05E2'   AF                    	XRA	A
  05E3'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
  05E4'                         BOL:
  05E4'                         BOL_LP:
  05E4'   7C                    	MOV	A,H
  05E5'   B5                    	ORA	L
  05E6'   C8                    	RZ			; at 0
  05E7'   2B                    	DCX	H		; look at off-1
  05E8'   E5                    	PUSH	H
  05E9'   CD 0000*              	CALL	CHARAT
  05EC'   E1                    	POP	H		; HL = off-1
  05ED'   FE 0A                 	CPI	LF
  05EF'   CA 05F5'              	JZ	BOL_DN
  05F2'   C3 05E4'              	JMP	BOL_LP
  05F5'                         BOL_DN:
  05F5'   23                    	INX	H		; line starts just after the LF
  05F6'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
  05F7'                         EOLNL:
  05F7'   E5                    	PUSH	H
  05F8'   CD 0000*              	CALL	LOGLEN
  05FB'   22 2A49'              	SHLD	WKN
  05FE'   E1                    	POP	H
  05FF'                         ENL_LP:
  05FF'   EB                    	XCHG			; DE = i
  0600'   2A 2A49'              	LHLD	WKN
  0603'   CD 0000*              	CALL	CMP16		; DE=i vs HL=n: CY iff i < n
  0606'   EB                    	XCHG			; HL = i, DE = n
  0607'   D0                    	RNC			; i >= n: no LF on this line
  0608'   E5                    	PUSH	H
  0609'   CD 0000*              	CALL	CHARAT
  060C'   E1                    	POP	H
  060D'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  060F'   C8                    	RZ			; the LF: HL is its offset
  0610'   23                    	INX	H
  0611'   C3 05FF'              	JMP	ENL_LP
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  0614'                         NLSTART:
  0614'   CD 05F7'              	CALL	EOLNL
  0617'   E5                    	PUSH	H
  0618'   CD 0000*              	CALL	LOGLEN
  061B'   D1                    	POP	D		; DE = eol result
  061C'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  061F'   C8                    	RZ			; no next line: HL = LOGLEN
  0620'   EB                    	XCHG			; HL = eol
  0621'   23                    	INX	H
  0622'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  0623'                         EOLC:
  0623'   E5                    	PUSH	H
  0624'   CD 05F7'              	CALL	EOLNL
  0627'   22 2A4B'              	SHLD	WKTERM
  062A'   E1                    	POP	H
  062B'   CD 05E4'              	CALL	BOL
  062E'   22 2A4D'              	SHLD	WKBOL
  0631'   2A 2A4B'              	LHLD	WKTERM
  0634'   EB                    	XCHG			; DE = term
  0635'   2A 2A4D'              	LHLD	WKBOL
  0638'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  063B'   CA 065A'              	JZ	EOLC_MT
  063E'   EB                    	XCHG			; HL = term
  063F'   2B                    	DCX	H		; term-1
  0640'   E5                    	PUSH	H
  0641'   CD 0000*              	CALL	CHARAT
  0644'   E1                    	POP	H		; HL = term-1
  0645'   FE 0D                 	CPI	CR
  0647'   CA 064D'              	JZ	EOLC_CR		; content ends at term-1
  064A'   C3 064E'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  064D'                         EOLC_CR:
  064D'   2B                    	DCX	H		; last = (term-1) - 1
  064E'                         EOLC_LS:
  064E'   EB                    	XCHG			; DE = last
  064F'   2A 2A4D'              	LHLD	WKBOL
  0652'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  0655'   DA 065A'              	JC	EOLC_MT
  0658'   EB                    	XCHG			; HL = last
  0659'   C9                    	RET
  065A'                         EOLC_MT:
  065A'   2A 2A4D'              	LHLD	WKBOL
  065D'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  065E'                         COL:
  065E'   E5                    	PUSH	H
  065F'   CD 05E4'              	CALL	BOL
  0662'   D1                    	POP	D		; DE = off
  0663'   EB                    	XCHG			; HL = off, DE = bol
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  0664'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  0667'                         ATENDQ:
  0667'   CD 0000*              	CALL	CUROFF
  066A'   E5                    	PUSH	H
  066B'   CD 0000*              	CALL	LOGLEN
  066E'   D1                    	POP	D		; DE = cur
  066F'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0672'                         CURCHR:
  0672'   CD 0000*              	CALL	CUROFF
  0675'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  0678'                         MOVCNT:
  0678'   CD 075A'              	CALL	SETMOV
  067B'   C3 068B'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  067E'                         CNTOFF:
  067E'   CD 068B'              	CALL	GETCNT
  0681'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  0684'                         GBSUB:
  0684'   EB                    	XCHG
  0685'   2A 0000*              	LHLD	GAPBEG
  0688'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  068B'                         GETCNT:
  068B'   2A 2A01'              	LHLD	CMDCNT
  068E'   7C                    	MOV	A,H
  068F'   B5                    	ORA	L
  0690'   C2 0697'              	JNZ	GC_HAVE
  0693'   21 0001               	LXI	H,1
  0696'   C9                    	RET
  0697'                         GC_HAVE:
  0697'   E5                    	PUSH	H
  0698'   21 0000               	LXI	H,0
  069B'   22 2A01'              	SHLD	CMDCNT
  069E'   E1                    	POP	H
  069F'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for a ^C break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  06A0'                         CNTTST:				; WM 1175
  06A0'   3A 2AB3'              	LDA	BRKARM
  06A3'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06A4'   C4 06CE'              	CNZ	BRKTST		; a ^C spends the count: every loop stops here
  06A7'   E5                    	PUSH	H
  06A8'   2A 2A01'              	LHLD	CMDCNT
  06AB'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  06AE'   B4                    	ORA	H
  06AF'   B5                    	ORA	L
  06B0'   E1                    	POP	H
  06B1'   C3 0000*              	JMP	POLLBRK
                                
                                ;============================================================
                                ; ^C -- abandon a search or a long move.
                                ;
                                ; Every loop that pages asks CNTTST whether to go on, so that is where a ^C is
                                ; looked for: it zeroes the count, and the loop ends the way it ends when the
                                ; count runs out.  Nothing is half done, because the commands that can be
                                ; stopped change nothing -- BRKON arms the test only with no operator pending,
                                ; and only 'G' 'gg' the mark jumps and the searches call it.  A 'dd' count, a
                                ; ':s', a put or a write asks the same CNTTST and is never stopped.
                                ;
                                ; The command then goes back to where it started (BRKBAK), as a search that
                                ; found nothing does: the screen was not repainted, so it is already right.
                                ; Going back pages, and that is not stopped by a second ^C.
                                ;============================================================
                                
                                ;BRKON -- a command that may page a long way is starting: keep the place it
                                ; started from (the cursor's position in the file, and LNDLT for its row), and
                                ; arm the ^C test unless an operator is waiting for this motion.
  06B4'                         BRKON:
  06B4'   21 2AAE'              	LXI	H,SOFF
  06B7'   CD 044F'              	CALL	FPSTO
  06BA'   2A 0000*              	LHLD	LNDLT
  06BD'   22 2AB1'              	SHLD	SLDLT
  06C0'   AF                    	XRA	A
  06C1'   32 2AB4'              	STA	BRKHIT
  06C4'   3A 2A2B'              	LDA	PSAVE
  06C7'   B7                    	ORA	A
  06C8'   C0                    	RNZ			; 'dG' changes text: it runs to its end
  06C9'   3C                    	INR	A
  06CA'   32 2AB3'              	STA	BRKARM
  06CD'   C9                    	RET
                                
                                ;BRKTST -- CNTTST's question while armed.  Keeps BC, DE, HL.
  06CE'                         BRKTST:
  06CE'   C5                    	PUSH	B
  06CF'   D5                    	PUSH	D
  06D0'   E5                    	PUSH	H
  06D1'   CD 0000*              	CALL	KBBRK
  06D4'   CA 06E7'              	JZ	BT_NO
  06D7'   32 2AB4'              	STA	BRKHIT		; (A = FFH)
  06DA'   AF                    	XRA	A
  06DB'   32 2AB3'              	STA	BRKARM		; the way back is not stopped in its turn
  06DE'   32 0000*              	STA	AUXCNT
  06E1'   21 0000               	LXI	H,0
  06E4'   22 2A01'              	SHLD	CMDCNT
  06E7'                         BT_NO:
  06E7'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  06E8'   D1                    	POP	D
  06E9'   C1                    	POP	B
  06EA'   C9                    	RET
                                
                                ;BRKOFF -- the move is over: disarm.  NOTE: falls into BRKQ.
  06EB'                         BRKOFF:
  06EB'   AF                    	XRA	A
  06EC'   32 2AB3'              	STA	BRKARM
                                ;BRKQ -- CY iff a ^C stopped it.
  06EF'                         BRKQ:
  06EF'   3A 2AB4'              	LDA	BRKHIT
  06F2'   B7                    	ORA	A
  06F3'   C8                    	RZ
  06F4'   37                    	STC
  06F5'   C9                    	RET
                                
                                ;RSTPL -- back to the place BRKON kept, on the row it was on.
  06F6'                         RSTPL:
  06F6'   21 2AAE'              	LXI	H,SOFF
  06F9'   CD 03F6'              	CALL	BACKTO
  06FC'   2A 2AB1'              	LHLD	SLDLT
  06FF'   22 0000*              	SHLD	LNDLT
  0702'   C9                    	RET
                                
                                ;BRKBAK -- stopped: back to the start, drop whatever was typed meanwhile (it
                                ; was meant for a result that is not coming), and say so.  CY, as EXERR.
  0703'                         BRKBAK:
  0703'   CD 06F6'              	CALL	RSTPL
  0706'   CD 0000*              	CALL	KBFLSH
  0709'   21 2352'              	LXI	H,SINTR
  070C'   C3 22B4'              	JMP	EXERR
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  070F'                         CLASSF:
  070F'   47                    	MOV	B,A
  0710'   FE 20                 	CPI	' '
  0712'   CA 0752'              	JZ	CLS0
  0715'   FE 09                 	CPI	TAB
  0717'   CA 0752'              	JZ	CLS0
  071A'   FE 0A                 	CPI	LF
  071C'   CA 0752'              	JZ	CLS0
  071F'   FE 0D                 	CPI	CR
  0721'   CA 0752'              	JZ	CLS0
  0724'   3A 2A0B'              	LDA	WBIG
  0727'   B7                    	ORA	A
  0728'   C2 0754'              	JNZ	CLS1
  072B'   78                    	MOV	A,B
  072C'   FE 5F                 	CPI	'_'
  072E'   CA 0754'              	JZ	CLS1
  0731'   FE 30                 	CPI	'0'
  0733'   DA 0757'              	JC	CLS2
  0736'   FE 3A                 	CPI	'9'+1
  0738'   DA 0754'              	JC	CLS1
  073B'   FE 41                 	CPI	'A'
  073D'   DA 0757'              	JC	CLS2
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0740'   FE 5B                 	CPI	'Z'+1
  0742'   DA 0754'              	JC	CLS1
  0745'   FE 61                 	CPI	'a'
  0747'   DA 0757'              	JC	CLS2
  074A'   FE 7B                 	CPI	'z'+1
  074C'   DA 0754'              	JC	CLS1
  074F'   C3 0757'              	JMP	CLS2
  0752'   AF                    CLS0:	XRA	A
  0753'   C9                    	RET
  0754'   3E 01                 CLS1:	MVI	A,1
  0756'   C9                    	RET
  0757'   3E 02                 CLS2:	MVI	A,2
  0759'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  075A'                         SETMOV:
  075A'   3E 01                 	MVI	A,R_MOVE
  075C'   32 2A05'              	STA	RINTENT
  075F'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  0760'                         SETLIN:
  0760'   3E 02                 	MVI	A,R_LINE
  0762'   32 2A05'              	STA	RINTENT
  0765'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  0766'                         SETILN:
  0766'   3E 01                 	MVI	A,1
  0768'   32 2A06'              	STA	ILN		; one line, unless a put overwrites it below
  076B'   3E 05                 	MVI	A,R_ILIN
  076D'   32 2A05'              	STA	RINTENT
  0770'   AF                    	XRA	A
  0771'   32 2A08'              	STA	ILABOV		; the row above the opened ones is untouched
  0774'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  0775'                         SETJON:
  0775'   3E 06                 	MVI	A,R_JOIN
  0777'   32 2A05'              	STA	RINTENT
  077A'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  077B'                         SETFUL:
  077B'   3E 00                 	MVI	A,R_FULL
  077D'   32 2A05'              	STA	RINTENT
  0780'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB occurs from the cursor to the end of its line, else 0.
                                ; Scans forward from the cursor via CHARAT until LF or end of text (no gap move).
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  0781'                         TAILTAB:
  0781'   CD 0000*              	CALL	CUROFF
  0784'   22 2A45'              	SHLD	TTI
  0787'                         TT_LP:
  0787'   2A 2A45'              	LHLD	TTI
  078A'   EB                    	XCHG			; DE = TTI
  078B'   CD 0000*              	CALL	LOGLEN		; HL = LOGLEN
  078E'   CD 0000*              	CALL	CMP16		; CY iff TTI < LOGLEN
  0791'   D2 07B1'              	JNC	TT_NO		; reached end of text -> no tab
  0794'   2A 2A45'              	LHLD	TTI
  0797'   CD 0000*              	CALL	CHARAT
  079A'   FE 0A                 	CPI	LF
  079C'   CA 07B1'              	JZ	TT_NO		; end of line -> no tab
  079F'   FE 09                 	CPI	TAB
  07A1'   CA 07AE'              	JZ	TT_YES
  07A4'   2A 2A45'              	LHLD	TTI
  07A7'   23                    	INX	H
  07A8'   22 2A45'              	SHLD	TTI
  07AB'   C3 0787'              	JMP	TT_LP
  07AE'                         TT_YES:
  07AE'   3E 01                 	MVI	A,1
  07B0'   C9                    	RET
  07B1'                         TT_NO:
  07B1'   AF                    	XRA	A
  07B2'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  07B3'                         VC_H:
  07B3'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  07B6'   22 2A43'              	SHLD	CNTV
  07B9'                         VCH_LP:
  07B9'   2A 2A43'              	LHLD	CNTV
  07BC'   7C                    	MOV	A,H
  07BD'   B5                    	ORA	L
  07BE'   C8                    	RZ
  07BF'   2B                    	DCX	H
  07C0'   22 2A43'              	SHLD	CNTV
  07C3'   CD 07C9'              	CALL	HSTEP
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07C6'   C3 07B9'              	JMP	VCH_LP
  07C9'                         HSTEP:
  07C9'   CD 0000*              	CALL	CUROFF		; HL = cur
  07CC'   7C                    	MOV	A,H
  07CD'   B5                    	ORA	L
  07CE'   C8                    	RZ			; at 0
  07CF'   E5                    	PUSH	H
  07D0'   CD 05E4'              	CALL	BOL		; HL = bol
  07D3'   D1                    	POP	D		; DE = cur
  07D4'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  07D7'   C8                    	RZ			; at BOL, cannot go left
  07D8'   EB                    	XCHG			; HL = cur
  07D9'   2B                    	DCX	H
  07DA'   C3 057A'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  07DD'                         VC_L:
  07DD'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  07E0'   22 2A43'              	SHLD	CNTV
  07E3'                         VCL_LP:
  07E3'   2A 2A43'              	LHLD	CNTV
  07E6'   7C                    	MOV	A,H
  07E7'   B5                    	ORA	L
  07E8'   C8                    	RZ
  07E9'   2B                    	DCX	H
  07EA'   22 2A43'              	SHLD	CNTV
  07ED'   CD 07F3'              	CALL	LSTEP
  07F0'   C3 07E3'              	JMP	VCL_LP
  07F3'                         LSTEP:
  07F3'   CD 0000*              	CALL	CUROFF		; HL = cur
  07F6'   E5                    	PUSH	H
  07F7'   CD 0623'              	CALL	EOLC		; HL = eolc
  07FA'   D1                    	POP	D		; DE = cur
  07FB'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  07FE'   D0                    	RNC			; cur >= eolc, cannot go right
  07FF'   EB                    	XCHG			; HL = cur
  0800'   23                    	INX	H
  0801'   C3 057A'              	JMP	GOSET
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  0804'                         VC_0:
  0804'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0807'   CD 0811'              	CALL	LNSTRT
  080A'   21 0000               	LXI	H,0
  080D'   22 2A09'              	SHLD	GOALCOL
  0810'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  0811'                         LNSTRT:
  0811'   CD 0F47'              	CALL	ZSAVE
  0814'   21 0000               	LXI	H,0
  0817'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  081A'   E5                    	PUSH	H
  081B'   CD 0F5A'              	CALL	ZREST
  081E'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  081F'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  0822'                         VC_CRT:
  0822'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0825'   C3 0828'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  0828'                         FNBLNK:
  0828'   CD 0811'              	CALL	LNSTRT
  082B'   CD 0000*              	CALL	RGET0
  082E'   11 0000               	LXI	D,0		; DE = blanks skipped
  0831'                         FN_LP:
  0831'   CD 0000*              	CALL	RDGET
  0834'   DA 0857'              	JC	FN_GO		; the end of the file
  0837'   FE 20                 	CPI	' '
  0839'   CA 0841'              	JZ	FN_WH
  083C'   FE 09                 	CPI	TAB
  083E'   C2 0857'              	JNZ	FN_GO		; a non-blank, or the line's end
  0841'                         FN_WH:
  0841'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  0844'   DA 0857'              	JC	FN_GO
  0847'   FE 0D                 	CPI	CR
  0849'   CA 0857'              	JZ	FN_GO
  084C'   FE 0A                 	CPI	LF
  084E'   CA 0857'              	JZ	FN_GO
  0851'   2B                    	DCX	H		; not yet: read that char again
  0852'   03                    	INX	B
  0853'   13                    	INX	D
  0854'   C3 0831'              	JMP	FN_LP
  0857'                         FN_GO:
  0857'   D5                    	PUSH	D
  0858'   CD 0000*              	CALL	CUROFF
  085B'   D1                    	POP	D
  085C'   19                    	DAD	D
  085D'   C3 057A'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  0860'                         VC_EOL:
  0860'   CD 075A'              	CALL	SETMOV
  0863'   21 FFFF               	LXI	H,0FFFFH
  0866'   22 2A09'              	SHLD	GOALCOL
  0869'   CD 068B'              	CALL	GETCNT
  086C'   2B                    	DCX	H		; count-1
  086D'   7C                    	MOV	A,H
  086E'   B5                    	ORA	L
  086F'   CA 087E'              	JZ	VEOL_0
  0872'   E5                    	PUSH	H
  0873'   CD 0893'              	CALL	ONLAST
  0876'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  0877'   D8                    	RC			; the last line: no move (vim)
  0878'   CD 08E3'              	CALL	JCORE
  087B'   C3 0A32'              	JMP	JKLAND
  087E'                         VEOL_0:
  087E'   CD 0811'              	CALL	LNSTRT
  0881'   C3 0A32'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  0884'                         VC_CR:
  0884'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0887'   E5                    	PUSH	H
  0888'   CD 0893'              	CALL	ONLAST
  088B'   E1                    	POP	H
  088C'   D8                    	RC
  088D'   CD 08E3'              	CALL	JCORE
  0890'   C3 0828'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  0893'                         ONLAST:
  0893'   CD 0000*              	CALL	RGET0
  0896'                         OL_LP:
  0896'   CD 0000*              	CALL	RDGET
  0899'   D8                    	RC			; the file ends on this line
  089A'   FE 0A                 	CPI	LF
  089C'   C2 0896'              	JNZ	OL_LP
  089F'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  08A2'                         VC_J:
  08A2'   CD 075A'              	CALL	SETMOV
  08A5'   CD 08CD'              	CALL	GLCHK		; the goal column, from the cursor if stale
  08A8'   CD 068B'              	CALL	GETCNT		; HL = count
  08AB'   CD 08E3'              	CALL	JCORE
  08AE'   CD 08C6'              	CALL	JKDRP
  08B1'   C3 0A32'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  08B4'                         VC_K:
  08B4'   CD 075A'              	CALL	SETMOV
  08B7'   CD 08CD'              	CALL	GLCHK
  08BA'   CD 068B'              	CALL	GETCNT
  08BD'   CD 0980'              	CALL	KCORE
  08C0'   CD 08C6'              	CALL	JKDRP
  08C3'   C3 0A32'              	JMP	JKLAND
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


                                ;JKDRP -- DE = the lines JCORE / KCORE moved.  None -- 'j' on the last line,
                                ; 'k' on the first -- and the motion has failed: an operator waiting on it is
                                ; dropped, as vim drops it, where a line span that starts and ends on one line
                                ; would take that line ('dj' on the last line deleted it).  A count that runs
                                ; out of lines short has still moved, and its operator stands.  It is asked
                                ; here and not in the cores: 'dH' on the top row moves no lines either, and
                                ; takes its line.
  08C6'                         JKDRP:
  08C6'   7A                    	MOV	A,D
  08C7'   B3                    	ORA	E
  08C8'   C0                    	RNZ
  08C9'   32 2A2B'              	STA	PSAVE
  08CC'   C9                    	RET
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  08CD'                         GLCHK:
  08CD'   2A 2A09'              	LHLD	GOALCOL
  08D0'   7C                    	MOV	A,H
  08D1'   3C                    	INR	A
  08D2'   C0                    	RNZ
  08D3'   7D                    	MOV	A,L
  08D4'   FE FE                 	CPI	0FEH
  08D6'   C0                    	RNZ
  08D7'   C3 057D'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  08DA'                         GLSTAL:
  08DA'   E5                    	PUSH	H
  08DB'   21 FFFE               	LXI	H,0FFFEH
  08DE'   22 2A09'              	SHLD	GOALCOL
  08E1'   E1                    	POP	H
  08E2'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  08E3'                         JCORE:
  08E3'   7C                    	MOV	A,H
  08E4'   B5                    	ORA	L
  08E5'   C8                    	RZ
  08E6'   22 2A0F'              	SHLD	JKCNT
  08E9'   CD 0CF9'              	CALL	CURRW		; limit = rows under the cursor's + NEDIT
  08EC'   47                    	MOV	B,A
  08ED'   3A 0000*              	LDA	NEDIT
  08F0'   3D                    	DCR	A
  08F1'   90                    	SUB	B
  08F2'   5F                    	MOV	E,A
  08F3'   16 00                 	MVI	D,0
  08F5'   3A 0000*              	LDA	NEDIT
  08F8'   6F                    	MOV	L,A
  08F9'   26 00                 	MVI	H,0
  08FB'   19                    	DAD	D
  08FC'   EB                    	XCHG			; DE = limit
  08FD'   2A 2A0F'              	LHLD	JKCNT
  0900'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0903'   D2 0907'              	JNC	JC_N
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0906'   EB                    	XCHG			; HL = limit
  0907'                         JC_N:
  0907'   22 2A11'              	SHLD	JKN		; N = min(count, limit)
  090A'   EB                    	XCHG			; DE = LFs to find
  090B'   CD 0000*              	CALL	RGET0
  090E'                         JC_SC:
  090E'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0911'   DA 0930'              	JC	JC_EOF
  0914'   32 2A18'              	STA	JKLST
  0917'   FE 0A                 	CPI	LF
  0919'   C2 090E'              	JNZ	JC_SC
  091C'   1B                    	DCX	D
  091D'   7A                    	MOV	A,D
  091E'   B3                    	ORA	E
  091F'   C2 090E'              	JNZ	JC_SC
  0922'   2A 2A0F'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  0925'   22 2A13'              	SHLD	JKMOV		;   one if the last LF found ends the file
  0928'   3E 01                 	MVI	A,1
  092A'   32 2A17'              	STA	JKPHN
  092D'   C3 094B'              	JMP	JC_MV
  0930'                         JC_EOF:
  0930'   2A 2A11'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  0933'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  0936'   7C                    	MOV	A,H
  0937'   B5                    	ORA	L
  0938'   CA 0944'              	JZ	JC_AV
  093B'   3A 2A18'              	LDA	JKLST
  093E'   FE 0A                 	CPI	LF
  0940'   C2 0944'              	JNZ	JC_AV
  0943'   2B                    	DCX	H
  0944'                         JC_AV:
  0944'   22 2A13'              	SHLD	JKMOV
  0947'   AF                    	XRA	A
  0948'   32 2A17'              	STA	JKPHN
  094B'                         JC_MV:
  094B'   2A 2A0F'              	LHLD	JKCNT
  094E'   AF                    	XRA	A
  094F'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  0952'   CD 0A11'              	CALL	ATEOF
  0955'   D2 0969'              	JNC	JC_DN
  0958'   CD 0A17'              	CALL	LASTLN		; ran past the last line: back onto it
  095B'   3A 2A17'              	LDA	JKPHN
  095E'   B7                    	ORA	A
  095F'   CA 0969'              	JZ	JC_DN
  0962'   2A 2A13'              	LHLD	JKMOV
  0965'   2B                    	DCX	H
  0966'   22 2A13'              	SHLD	JKMOV
  0969'                         JC_DN:
  0969'   2A 2A11'              	LHLD	JKN		; LNDLT += min(moved, N)
  096C'   EB                    	XCHG
  096D'   2A 2A13'              	LHLD	JKMOV
  0970'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  0973'   D2 0977'              	JNC	JC_AD
  0976'   EB                    	XCHG
  0977'                         JC_AD:
  0977'   EB                    	XCHG			; DE = lines moved
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0978'   2A 0000*              	LHLD	LNDLT
  097B'   19                    	DAD	D
  097C'   22 0000*              	SHLD	LNDLT
  097F'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  0980'                         KCORE:
  0980'   7C                    	MOV	A,H
  0981'   B5                    	ORA	L
  0982'   C8                    	RZ
  0983'   22 2A0F'              	SHLD	JKCNT
  0986'   CD 0CF9'              	CALL	CURRW		; limit = row + NEDIT
  0989'   5F                    	MOV	E,A
  098A'   16 00                 	MVI	D,0
  098C'   3A 0000*              	LDA	NEDIT
  098F'   6F                    	MOV	L,A
  0990'   26 00                 	MVI	H,0
  0992'   19                    	DAD	D
  0993'   EB                    	XCHG			; DE = limit
  0994'   2A 2A0F'              	LHLD	JKCNT
  0997'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  099A'   D2 099E'              	JNC	KC_N
  099D'   EB                    	XCHG			; HL = limit
  099E'                         KC_N:
  099E'   22 2A11'              	SHLD	JKN		; N = min(count, limit)
  09A1'   EB                    	XCHG			; DE = LFs to find
  09A2'   21 0000               	LXI	H,0
  09A5'   22 2A15'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  09A8'                         KC_ED:
  09A8'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  09A9'   2A 2A15'              	LHLD	JKBK
  09AC'   CD 0684'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  09AF'   E5                    	PUSH	H
  09B0'   EB                    	XCHG
  09B1'   2A 0000*              	LHLD	TXTBEG
  09B4'   EB                    	XCHG
  09B5'   CD 0000*              	CALL	SUBHD
  09B8'   44                    	MOV	B,H
  09B9'   4D                    	MOV	C,L
  09BA'   E1                    	POP	H
  09BB'   D1                    	POP	D
  09BC'                         KC_SC:
  09BC'   78                    	MOV	A,B
  09BD'   B1                    	ORA	C
  09BE'   CA 09D5'              	JZ	KC_TB
  09C1'   2B                    	DCX	H
  09C2'   0B                    	DCX	B
  09C3'   7E                    	MOV	A,M
  09C4'   FE 0A                 	CPI	LF
  09C6'   C2 09BC'              	JNZ	KC_SC
  09C9'   1B                    	DCX	D
  09CA'   7A                    	MOV	A,D
  09CB'   B3                    	ORA	E
  09CC'   C2 09BC'              	JNZ	KC_SC
  09CF'   2A 2A0F'              	LHLD	JKCNT		; N lines above: the move is count lines
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  09D2'   C3 09F5'              	JMP	KC_MV
  09D5'                         KC_TB:
  09D5'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  09D6'   CD 0684'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  09D9'   22 2A15'              	SHLD	JKBK
  09DC'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  09DF'   7C                    	MOV	A,H
  09E0'   B5                    	ORA	L
  09E1'   CA 09EE'              	JZ	KC_B0
  09E4'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  09E7'   D1                    	POP	D
  09E8'   DA 09EF'              	JC	KC_BOF
  09EB'   C3 09A8'              	JMP	KC_ED
  09EE'                         KC_B0:
  09EE'   D1                    	POP	D
  09EF'                         KC_BOF:
  09EF'   2A 2A11'              	LHLD	JKN		; moved = LFs found
  09F2'   CD 0000*              	CALL	SUBHD
  09F5'                         KC_MV:
  09F5'   E5                    	PUSH	H
  09F6'   2A 2A0F'              	LHLD	JKCNT
  09F9'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  09FC'   D1                    	POP	D		; DE = moved
  09FD'   2A 2A11'              	LHLD	JKN
  0A00'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0A03'   DA 0A07'              	JC	KC_AD
  0A06'   EB                    	XCHG			; DE = N
  0A07'                         KC_AD:
  0A07'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0A0A'   CD 0000*              	CALL	SUBHD
  0A0D'   22 0000*              	SHLD	LNDLT
  0A10'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0A11'                         ATEOF:
  0A11'   CD 0000*              	CALL	RGET0
  0A14'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0A17'                         LASTLN:
  0A17'   2A 0000*              	LHLD	GAPBEG
  0A1A'   EB                    	XCHG
  0A1B'   2A 0000*              	LHLD	TXTBEG
  0A1E'   CD 0000*              	CALL	CMP16
  0A21'   21 0000               	LXI	H,0
  0A24'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0A27'   1B                    	DCX	D
  0A28'   1A                    	LDAX	D
  0A29'   FE 0A                 	CPI	LF
  0A2B'   C2 0000*              	JNZ	SETBWD
  0A2E'   23                    	INX	H
  0A2F'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0A32'                         JKLAND:
  0A32'   21 0000               	LXI	H,0
  0A35'   22 2A19'              	SHLD	JKVC		; screen column
  0A38'   2B                    	DCX	H
  0A39'   22 2A1B'              	SHLD	JKLS		; last content char: none yet
  0A3C'   CD 0000*              	CALL	RGET0
  0A3F'   11 0000               	LXI	D,0		; DE = chars read
  0A42'                         JL_RD:
  0A42'   CD 0000*              	CALL	RDGET
  0A45'   DA 0A7F'              	JC	JL_END
  0A48'   FE 0A                 	CPI	LF
  0A4A'   CA 0A7F'              	JZ	JL_END
  0A4D'   E5                    	PUSH	H
  0A4E'   C5                    	PUSH	B
  0A4F'   2A 2A19'              	LHLD	JKVC
  0A52'   CD 05D1'              	CALL	CWID
  0A55'   B7                    	ORA	A
  0A56'   CA 0A79'              	JZ	JL_NX		; a CR
  0A59'   EB                    	XCHG
  0A5A'   22 2A1B'              	SHLD	JKLS		; the last content char so far
  0A5D'   EB                    	XCHG
  0A5E'   4F                    	MOV	C,A
  0A5F'   06 00                 	MVI	B,0
  0A61'   09                    	DAD	B		; HL = the column after this char
  0A62'   22 2A19'              	SHLD	JKVC
  0A65'   D5                    	PUSH	D
  0A66'   EB                    	XCHG
  0A67'   2A 2A09'              	LHLD	GOALCOL
  0A6A'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0A6D'   D1                    	POP	D
  0A6E'   DA 0A79'              	JC	JL_NX
  0A71'   CA 0A79'              	JZ	JL_NX
  0A74'   C1                    	POP	B		; this char holds the goal column
  0A75'   E1                    	POP	H
  0A76'   C3 0A8A'              	JMP	JL_GO
  0A79'                         JL_NX:
  0A79'   C1                    	POP	B
  0A7A'   E1                    	POP	H
  0A7B'   13                    	INX	D
  0A7C'   C3 0A42'              	JMP	JL_RD
  0A7F'                         JL_END:
  0A7F'   2A 2A1B'              	LHLD	JKLS		; past the line's end: its last content char
  0A82'   7C                    	MOV	A,H
  0A83'   A5                    	ANA	L
  0A84'   3C                    	INR	A
  0A85'   C2 0A89'              	JNZ	JL_LS
  0A88'   23                    	INX	H		; no content: the line's start
  0A89'                         JL_LS:
  0A89'   EB                    	XCHG
  0A8A'                         JL_GO:
  0A8A'   D5                    	PUSH	D		; DE = step from the line start
  0A8B'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0A8E'   D1                    	POP	D
  0A8F'   19                    	DAD	D
  0A90'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0A93'   AF                    VC_W:	XRA	A
  0A94'   32 2A0B'              	STA	WBIG
  0A97'   C3 0A9F'              	JMP	WDO
  0A9A'   3E 01                 VCBGW:	MVI	A,1
  0A9C'   32 2A0B'              	STA	WBIG
  0A9F'   CD 075A'              WDO:	CALL	SETMOV
  0AA2'   AF                    	XRA	A
  0AA3'   32 2A0C'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0AA6'   CD 068B'              	CALL	GETCNT
  0AA9'   22 2A43'              	SHLD	CNTV
  0AAC'   2A 2A43'              WDO_LP: LHLD	CNTV
  0AAF'   7C                    	MOV	A,H
  0AB0'   B5                    	ORA	L
  0AB1'   CA 0ABE'              	JZ	WDO_DN
  0AB4'   2B                    	DCX	H
  0AB5'   22 2A43'              	SHLD	CNTV
  0AB8'   CD 0B0E'              	CALL	FWD1
  0ABB'   D2 0AAC'              	JNC	WDO_LP
  0ABE'                         WDO_DN:
  0ABE'   CD 0A11'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0AC1'   DA 0ACE'              	JC	WDO_NL
  0AC4'   FE 0D                 	CPI	CR
  0AC6'   CA 0ACE'              	JZ	WDO_NL
  0AC9'   FE 0A                 	CPI	LF
  0ACB'   C2 057D'              	JNZ	SETGL
  0ACE'                         WDO_NL:
  0ACE'   CD 0000*              	CALL	PEEKL
  0AD1'   DA 057D'              	JC	SETGL
  0AD4'   FE 0A                 	CPI	LF
  0AD6'   CA 057D'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0AD9'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0ADB'   32 2A0C'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0ADE'   CD 0C09'              	CALL	DECC		; back onto its last char
  0AE1'   C3 057D'              	JMP	SETGL
                                
  0AE4'   AF                    VC_B:	XRA	A
  0AE5'   32 2A0B'              	STA	WBIG
  0AE8'   C3 0AF0'              	JMP	BDO
  0AEB'   3E 01                 VCBGB:	MVI	A,1
  0AED'   32 2A0B'              	STA	WBIG
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0AF0'   CD 075A'              BDO:	CALL	SETMOV
  0AF3'   CD 068B'              	CALL	GETCNT
  0AF6'   22 2A43'              	SHLD	CNTV
  0AF9'   2A 2A43'              BDO_LP: LHLD	CNTV
  0AFC'   7C                    	MOV	A,H
  0AFD'   B5                    	ORA	L
  0AFE'   CA 057D'              	JZ	SETGL
  0B01'   2B                    	DCX	H
  0B02'   22 2A43'              	SHLD	CNTV
  0B05'   CD 0B5A'              	CALL	BCK1
  0B08'   D2 0AF9'              	JNC	BDO_LP
  0B0B'   C3 057D'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char (it is left there).
  0B0E'                         FWD1:
  0B0E'   CD 0B8D'              	CALL	CCLS
  0B11'   32 2A4F'              	STA	WKCLS		; the starting class
  0B14'   CD 0BC7'              	CALL	INCC
  0B17'   B7                    	ORA	A
  0B18'   CA 0B30'              	JZ	FW_WD
  0B1B'   37                    	STC
  0B1C'   F8                    	RM			; -1: already at the end
  0B1D'   FE 02                 	CPI	2
  0B1F'   C2 0B30'              	JNZ	FW_WD		; 1: a next line was reached
  0B22'   CD 0A11'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0B25'   D4 0BAE'              	CNC	NXLN
  0B28'   D2 0B30'              	JNC	FW_WD
  0B2B'   CD 0C09'              	CALL	DECC		; yes: back onto its last char, failed
  0B2E'   37                    	STC
  0B2F'   C9                    	RET
  0B30'                         FW_WD:
  0B30'   3A 2A4F'              	LDA	WKCLS		; go past the rest of this word
  0B33'   B7                    	ORA	A
  0B34'   CA 0B49'              	JZ	FW_WS
  0B37'                         FW_WLP:
  0B37'   CD 0B8D'              	CALL	CCLS
  0B3A'   21 2A4F'              	LXI	H,WKCLS
  0B3D'   BE                    	CMP	M
  0B3E'   C2 0B49'              	JNZ	FW_WS
  0B41'   CD 0BC7'              	CALL	INCC
  0B44'   B7                    	ORA	A
  0B45'   F8                    	RM			; the end of the file (NC)
  0B46'   C3 0B37'              	JMP	FW_WLP
  0B49'                         FW_WS:
  0B49'   CD 0B8D'              	CALL	CCLS		; then over blanks to the next word
  0B4C'   B7                    	ORA	A
  0B4D'   C0                    	RNZ
  0B4E'   CD 0B95'              	CALL	EMPTY
  0B51'   C8                    	RZ			; an empty line is a word
  0B52'   CD 0BC7'              	CALL	INCC
  0B55'   B7                    	ORA	A
  0B56'   F8                    	RM
  0B57'   C3 0B49'              	JMP	FW_WS
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0B5A'                         BCK1:
  0B5A'   CD 0C09'              	CALL	DECC
  0B5D'   B7                    	ORA	A
  0B5E'   37                    	STC
  0B5F'   F8                    	RM
  0B60'                         BK_WS:
  0B60'   CD 0B8D'              	CALL	CCLS		; back over blanks
  0B63'   B7                    	ORA	A
  0B64'   C2 0B74'              	JNZ	BK_WD
  0B67'   CD 0B95'              	CALL	EMPTY
  0B6A'   C8                    	RZ			; an empty line is a word
  0B6B'   CD 0C09'              	CALL	DECC
  0B6E'   B7                    	ORA	A
  0B6F'   F2 0B60'              	JP	BK_WS
  0B72'   AF                    	XRA	A		; the start of the file (NC)
  0B73'   C9                    	RET
  0B74'                         BK_WD:
  0B74'   32 2A4F'              	STA	WKCLS		; back to the start of this word
  0B77'                         BK_WLP:
  0B77'   CD 0C09'              	CALL	DECC
  0B7A'   B7                    	ORA	A
  0B7B'   FA 0B8B'              	JM	BK_OK		; the start of the file
  0B7E'   CD 0B8D'              	CALL	CCLS
  0B81'   21 2A4F'              	LXI	H,WKCLS
  0B84'   BE                    	CMP	M
  0B85'   CA 0B77'              	JZ	BK_WLP
  0B88'   CD 0BC7'              	CALL	INCC		; overshot: forward one
  0B8B'                         BK_OK:
  0B8B'   AF                    	XRA	A
  0B8C'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0B8D'                         CCLS:
  0B8D'   CD 0A11'              	CALL	ATEOF
  0B90'   D2 070F'              	JNC	CLASSF
  0B93'   AF                    	XRA	A
  0B94'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0B95'                         EMPTY:
  0B95'   CD 0A11'              	CALL	ATEOF
  0B98'   DA 0BA3'              	JC	EM_ST
  0B9B'   FE 0D                 	CPI	CR
  0B9D'   CA 0BA3'              	JZ	EM_ST
  0BA0'   FE 0A                 	CPI	LF
  0BA2'   C0                    	RNZ
  0BA3'                         EM_ST:
  0BA3'   CD 0000*              	CALL	PEEKL
  0BA6'   DA 0BAC'              	JC	EM_Y
  0BA9'   FE 0A                 	CPI	LF
  0BAB'   C9                    	RET
  0BAC'                         EM_Y:
  0BAC'   AF                    	XRA	A
  0BAD'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0BAE'                         NXLN:
  0BAE'   FE 0A                 	CPI	LF
  0BB0'   CA 0BBF'              	JZ	NX_LF
  0BB3'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0BB6'   D8                    	RC
  0BB7'   FE 0A                 	CPI	LF
  0BB9'   CA 0BBF'              	JZ	NX_LF
  0BBC'   2B                    	DCX	H		; a lone CR
  0BBD'   AF                    	XRA	A
  0BBE'   C9                    	RET
  0BBF'                         NX_LF:
  0BBF'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0BC2'   D8                    	RC
  0BC3'   2B                    	DCX	H
  0BC4'   3E 01                 	MVI	A,1
  0BC6'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0BC7'                         INCC:
  0BC7'   CD 0A11'              	CALL	ATEOF
  0BCA'   DA 0C05'              	JC	IC_END
  0BCD'   FE 0D                 	CPI	CR
  0BCF'   CA 0BF0'              	JZ	IC_NL
  0BD2'   FE 0A                 	CPI	LF
  0BD4'   CA 0BF0'              	JZ	IC_NL
  0BD7'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0BDA'                         IC_CH:
  0BDA'   CD 0A11'              	CALL	ATEOF
  0BDD'   DA 0BEC'              	JC	IC_2
  0BE0'   FE 0D                 	CPI	CR
  0BE2'   CA 0BEC'              	JZ	IC_2
  0BE5'   FE 0A                 	CPI	LF
  0BE7'   CA 0BEC'              	JZ	IC_2
  0BEA'   AF                    	XRA	A
  0BEB'   C9                    	RET
  0BEC'                         IC_2:
  0BEC'   3E 02                 	MVI	A,2
  0BEE'   B7                    	ORA	A
  0BEF'   C9                    	RET
  0BF0'                         IC_NL:
  0BF0'   CD 0BAE'              	CALL	NXLN
  0BF3'   DA 0C05'              	JC	IC_END
  0BF6'   F5                    	PUSH	PSW
  0BF7'   CD 0000*              	CALL	PUTCUR
  0BFA'   F1                    	POP	PSW
  0BFB'   B7                    	ORA	A
  0BFC'   CA 0BDA'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0BFF'   CD 0C2B'              	CALL	LNINC
  0C02'   3E 01                 	MVI	A,1
  0C04'   C9                    	RET
  0C05'                         IC_END:
  0C05'   3E FF                 	MVI	A,0FFH
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0C07'   B7                    	ORA	A
  0C08'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0C09'                         DECC:
  0C09'   CD 0000*              	CALL	PEEKL
  0C0C'   DA 0C05'              	JC	IC_END
  0C0F'   F5                    	PUSH	PSW
  0C10'   CD 0000*              	CALL	PUTCUR
  0C13'   F1                    	POP	PSW
  0C14'   FE 0A                 	CPI	LF
  0C16'   3E 00                 	MVI	A,0
  0C18'   C0                    	RNZ
  0C19'   CD 0C39'              	CALL	LNDEC
  0C1C'   CD 0000*              	CALL	PEEKL		; onto its CR
  0C1F'   DA 0C27'              	JC	DC_1
  0C22'   FE 0D                 	CPI	CR
  0C24'   CC 0000*              	CZ	PUTCUR
  0C27'                         DC_1:
  0C27'   3E 01                 	MVI	A,1
  0C29'   B7                    	ORA	A
  0C2A'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0C2B'                         LNINC:
  0C2B'   E5                    	PUSH	H
  0C2C'   2A 0000*              	LHLD	LNDLT
  0C2F'   7C                    	MOV	A,H
  0C30'   FE 40                 	CPI	40H
  0C32'   CA 0C47'              	JZ	LN_X
  0C35'   23                    	INX	H
  0C36'   C3 0C44'              	JMP	LN_ST
  0C39'                         LNDEC:
  0C39'   E5                    	PUSH	H
  0C3A'   2A 0000*              	LHLD	LNDLT
  0C3D'   7C                    	MOV	A,H
  0C3E'   FE C0                 	CPI	0C0H
  0C40'   CA 0C47'              	JZ	LN_X
  0C43'   2B                    	DCX	H
  0C44'                         LN_ST:
  0C44'   22 0000*              	SHLD	LNDLT
  0C47'                         LN_X:
  0C47'   E1                    	POP	H
  0C48'   C9                    	RET
                                
  0C49'   AF                    VC_E:	XRA	A
  0C4A'   32 2A0B'              	STA	WBIG
  0C4D'   C3 0C55'              	JMP	EDO
  0C50'   3E 01                 VCBGE:	MVI	A,1
  0C52'   32 2A0B'              	STA	WBIG
  0C55'   CD 075A'              EDO:	CALL	SETMOV
  0C58'   CD 068B'              	CALL	GETCNT
  0C5B'   22 2A43'              	SHLD	CNTV
  0C5E'   2A 2A43'              EDO_LP: LHLD	CNTV
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C61'   7C                    	MOV	A,H
  0C62'   B5                    	ORA	L
  0C63'   C8                    	RZ
  0C64'   2B                    	DCX	H
  0C65'   22 2A43'              	SHLD	CNTV
  0C68'   CD 0C6E'              	CALL	ESTEP
  0C6B'   C3 0C5E'              	JMP	EDO_LP
                                
                                ;ESTEP -- forward to the end of the next word.
  0C6E'                         ESTEP:
  0C6E'   CD 0000*              	CALL	CUROFF
  0C71'   22 2A47'              	SHLD	WKI
  0C74'   CD 0000*              	CALL	LOGLEN
  0C77'   22 2A49'              	SHLD	WKN
  0C7A'   2A 2A47'              	LHLD	WKI
  0C7D'   23                    	INX	H
  0C7E'   22 2A47'              	SHLD	WKI
  0C81'                         ES_WS:
  0C81'   2A 2A47'              	LHLD	WKI
  0C84'   EB                    	XCHG
  0C85'   2A 2A49'              	LHLD	WKN
  0C88'   CD 0000*              	CALL	CMP16
  0C8B'   D2 0CD9'              	JNC	ES_LND
  0C8E'   2A 2A47'              	LHLD	WKI
  0C91'   CD 0000*              	CALL	CHARAT
  0C94'   CD 070F'              	CALL	CLASSF
  0C97'   B7                    	ORA	A
  0C98'   C2 0CA5'              	JNZ	ES_WD
  0C9B'   2A 2A47'              	LHLD	WKI
  0C9E'   23                    	INX	H
  0C9F'   22 2A47'              	SHLD	WKI
  0CA2'   C3 0C81'              	JMP	ES_WS
  0CA5'                         ES_WD:
  0CA5'   2A 2A47'              	LHLD	WKI
  0CA8'   CD 0000*              	CALL	CHARAT
  0CAB'   CD 070F'              	CALL	CLASSF
  0CAE'   32 2A4F'              	STA	WKCLS
  0CB1'                         ES_RUN:
  0CB1'   2A 2A47'              	LHLD	WKI
  0CB4'   23                    	INX	H
  0CB5'   EB                    	XCHG			; DE = i+1
  0CB6'   2A 2A49'              	LHLD	WKN
  0CB9'   CD 0000*              	CALL	CMP16		; DE=(i+1) vs HL=n: CY iff (i+1) < n
  0CBC'   D2 0CD9'              	JNC	ES_LND
  0CBF'   2A 2A47'              	LHLD	WKI
  0CC2'   23                    	INX	H
  0CC3'   E5                    	PUSH	H		; i+1
  0CC4'   CD 0000*              	CALL	CHARAT
  0CC7'   CD 070F'              	CALL	CLASSF
  0CCA'   E1                    	POP	H		; HL = i+1
  0CCB'   47                    	MOV	B,A
  0CCC'   3A 2A4F'              	LDA	WKCLS
  0CCF'   B8                    	CMP	B
  0CD0'   C2 0CD9'              	JNZ	ES_LND
  0CD3'   22 2A47'              	SHLD	WKI
  0CD6'   C3 0CB1'              	JMP	ES_RUN
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0CD9'                         ES_LND:
  0CD9'   2A 2A49'              	LHLD	WKN
  0CDC'   EB                    	XCHG
  0CDD'   2A 2A47'              	LHLD	WKI
  0CE0'   CD 0000*              	CALL	CMP16		; DE=n vs HL=i: CY iff n < i
  0CE3'   DA 0CEF'              	JC	ES_CL
  0CE6'   CA 0CEF'              	JZ	ES_CL
  0CE9'   2A 2A47'              	LHLD	WKI
  0CEC'   C3 057A'              	JMP	GOSET
  0CEF'                         ES_CL:
  0CEF'   2A 2A49'              	LHLD	WKN
  0CF2'   7C                    	MOV	A,H
  0CF3'   B5                    	ORA	L
  0CF4'   C8                    	RZ
  0CF5'   2B                    	DCX	H
  0CF6'   C3 057A'              	JMP	GOSET
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0CF9'                         CURRW:
  0CF9'   2A 0000*              	LHLD	WINROW
  0CFC'   EB                    	XCHG
  0CFD'   2A 0000*              	LHLD	LNDLT
  0D00'   19                    	DAD	D		; HL = row (signed)
  0D01'   7C                    	MOV	A,H
  0D02'   B7                    	ORA	A
  0D03'   FA 0D16'              	JM	CRW_0		; above the screen -> top row
  0D06'   C2 0D11'              	JNZ	CRW_BT		; far below -> bottom row
  0D09'   3A 0000*              	LDA	NEDIT
  0D0C'   3D                    	DCR	A		; A = bottom row
  0D0D'   BD                    	CMP	L		; CY iff bottom < row
  0D0E'   D8                    	RC
  0D0F'   7D                    	MOV	A,L
  0D10'   C9                    	RET
  0D11'                         CRW_BT:
  0D11'   3A 0000*              	LDA	NEDIT
  0D14'   3D                    	DCR	A
  0D15'   C9                    	RET
  0D16'                         CRW_0:
  0D16'   AF                    	XRA	A
  0D17'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0D18'                         SETRWT:
  0D18'   2A 0000*              	LHLD	LNDLT
  0D1B'   EB                    	XCHG
  0D1C'   6F                    	MOV	L,A
  0D1D'   26 00                 	MVI	H,0
  0D1F'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0D22'   22 0000*              	SHLD	WINROW
  0D25'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0D26'                         MVROW:
  0D26'   47                    	MOV	B,A
  0D27'   CD 0CF9'              	CALL	CURRW
  0D2A'   90                    	SUB	B		; A = row now - target
  0D2B'   C8                    	RZ
  0D2C'   DA 0D35'              	JC	MR_DN
  0D2F'   6F                    	MOV	L,A
  0D30'   26 00                 	MVI	H,0
  0D32'   C3 0980'              	JMP	KCORE
  0D35'                         MR_DN:
  0D35'   2F                    	CMA
  0D36'   3C                    	INR	A		; A = target - row now
  0D37'   6F                    	MOV	L,A
  0D38'   26 00                 	MVI	H,0
  0D3A'   C3 08E3'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0D3D'                         VC_HIGH:
  0D3D'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D40'   2B                    	DCX	H		; row = count - 1
  0D41'   7C                    	MOV	A,H
  0D42'   B7                    	ORA	A
  0D43'   3A 0000*              	LDA	SCBOT
  0D46'   C2 0D4E'              	JNZ	VH_GO		; >= 256 -> the last text row
  0D49'   BD                    	CMP	L		; CY iff SCBOT < row
  0D4A'   DA 0D4E'              	JC	VH_GO
  0D4D'   7D                    	MOV	A,L
  0D4E'                         VH_GO:
  0D4E'   CD 0D26'              	CALL	MVROW
  0D51'   C3 0828'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0D54'                         VC_MIDL:
  0D54'   CD 0678'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0D57'   3A 0000*              	LDA	SCBOT
  0D5A'   B7                    	ORA	A		; clear CY for the shift
  0D5B'   1F                    	RAR			; A = SCBOT / 2
  0D5C'   CD 0D26'              	CALL	MVROW
  0D5F'   C3 0828'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D62'                         VC_LOWL:
  0D62'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D65'   2B                    	DCX	H		; count - 1
  0D66'   3A 0000*              	LDA	SCBOT
  0D69'   5F                    	MOV	E,A
  0D6A'   16 00                 	MVI	D,0
  0D6C'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0D6D'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0D70'   3E 00                 	MVI	A,0
  0D72'   D2 0D79'              	JNC	VL_GO		; at or past the top -> row 0
  0D75'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0D78'   7D                    	MOV	A,L
  0D79'                         VL_GO:
  0D79'   CD 0D26'              	CALL	MVROW
  0D7C'   C3 0828'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0D7F'                         VC_PGDN:
  0D7F'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D82'   3A 0000*              	LDA	SCEOF
  0D85'   B7                    	ORA	A
  0D86'   CA 0D94'              	JZ	VPD_N
  0D89'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0D8C'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0D8D'   C8                    	RZ			; it already is
  0D8E'   CD 0D26'              	CALL	MVROW
  0D91'   C3 0DA5'              	JMP	VPD_TP
  0D94'                         VPD_N:
  0D94'   3A 0000*              	LDA	NEDIT
  0D97'   D6 02                 	SUI	2
  0D99'   CD 0DED'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0D9C'   E5                    	PUSH	H
  0D9D'   AF                    	XRA	A
  0D9E'   CD 0D26'              	CALL	MVROW		; the top line
  0DA1'   E1                    	POP	H
  0DA2'   CD 08E3'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0DA5'                         VPD_TP:
  0DA5'   AF                    	XRA	A
  0DA6'   CD 0D18'              	CALL	SETRWT		; to the top row
  0DA9'   C3 0828'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0DAC'                         VC_PGUP:
  0DAC'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0DAF'   3A 0000*              	LDA	SCBOF
  0DB2'   B7                    	ORA	A
  0DB3'   C0                    	RNZ
  0DB4'   3A 0000*              	LDA	NEDIT
  0DB7'   47                    	MOV	B,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0DB8'   3A 0000*              	LDA	SCEOF
  0DBB'   B7                    	ORA	A
  0DBC'   CA 0DCD'              	JZ	VPU_2
  0DBF'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0DC2'   FE 02                 	CPI	2
  0DC4'   D2 0DCD'              	JNC	VPU_2
  0DC7'   2F                    	CMA
  0DC8'   3C                    	INR	A
  0DC9'   80                    	ADD	B
  0DCA'   C3 0DD0'              	JMP	VPU_P
  0DCD'                         VPU_2:
  0DCD'   78                    	MOV	A,B
  0DCE'   D6 02                 	SUI	2
  0DD0'                         VPU_P:
  0DD0'   CD 0DED'              	CALL	MULSAT		; HL = count * page
  0DD3'   E5                    	PUSH	H
  0DD4'   AF                    	XRA	A
  0DD5'   CD 0D26'              	CALL	MVROW		; the top line
  0DD8'   E1                    	POP	H
  0DD9'   CD 0980'              	CALL	KCORE		; the new top line
  0DDC'   AF                    	XRA	A
  0DDD'   CD 0D18'              	CALL	SETRWT		; on the top row
  0DE0'   3A 0000*              	LDA	NEDIT
  0DE3'   3D                    	DCR	A
  0DE4'   6F                    	MOV	L,A
  0DE5'   26 00                 	MVI	H,0
  0DE7'   CD 08E3'              	CALL	JCORE		; the bottom row's line
  0DEA'   C3 0828'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0DED'                         MULSAT:
  0DED'   EB                    	XCHG
  0DEE'   21 0000               	LXI	H,0
  0DF1'   B7                    	ORA	A
  0DF2'   C8                    	RZ
  0DF3'                         MS_LP:
  0DF3'   19                    	DAD	D
  0DF4'   DA 0DFC'              	JC	MS_SAT
  0DF7'   3D                    	DCR	A
  0DF8'   C2 0DF3'              	JNZ	MS_LP
  0DFB'   C9                    	RET
  0DFC'                         MS_SAT:
  0DFC'   21 FFFF               	LXI	H,0FFFFH
  0DFF'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0E00'                         VC_HFDN:
  0E00'   CD 075A'              	CALL	SETMOV
  0E03'   CD 0CF9'              	CALL	CURRW
  0E06'   32 2A0D'              	STA	HFROW
  0E09'   CD 0E77'              	CALL	HFCNT		; HL = lines
  0E0C'   3A 2A0D'              	LDA	HFROW
  0E0F'   47                    	MOV	B,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0E10'   3A 0000*              	LDA	SCEOF
  0E13'   B7                    	ORA	A
  0E14'   CA 0E1C'              	JZ	VHD_GO
  0E17'   3A 0000*              	LDA	SCBOT		; the last line's row
  0E1A'   B8                    	CMP	B
  0E1B'   C8                    	RZ			; the cursor is on it
  0E1C'                         VHD_GO:
  0E1C'   CD 08E3'              	CALL	JCORE
  0E1F'   3A 0000*              	LDA	SCEOF
  0E22'   B7                    	ORA	A
  0E23'   C2 0828'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0E26'   3A 2A0D'              	LDA	HFROW
  0E29'   CD 0D18'              	CALL	SETRWT
  0E2C'   3E 01                 	MVI	A,1
  0E2E'   32 0000*              	STA	WFILL		; not past the end of the file
  0E31'   C3 0828'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0E34'                         VC_HFUP:
  0E34'   CD 075A'              	CALL	SETMOV
  0E37'   CD 0CF9'              	CALL	CURRW
  0E3A'   32 2A0D'              	STA	HFROW
  0E3D'   CD 0E77'              	CALL	HFCNT		; HL = lines
  0E40'   CD 0E57'              	CALL	ONFST
  0E43'   C8                    	RZ			; the cursor is on the first line
  0E44'   CD 0980'              	CALL	KCORE
  0E47'   3A 0000*              	LDA	SCBOF
  0E4A'   B7                    	ORA	A
  0E4B'   C2 0828'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0E4E'   3A 2A0D'              	LDA	HFROW
  0E51'   CD 0D18'              	CALL	SETRWT
  0E54'   C3 0828'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0E57'                         ONFST:
  0E57'   E5                    	PUSH	H
  0E58'   2A 0000*              	LHLD	OUTPOS
  0E5B'   7C                    	MOV	A,H
  0E5C'   B5                    	ORA	L
  0E5D'   C2 0E75'              	JNZ	OF_RET
  0E60'   2A 0000*              	LHLD	TXTBEG
  0E63'   EB                    	XCHG			; DE = TXTBEG
  0E64'   2A 0000*              	LHLD	GAPBEG
  0E67'                         OF_LP:
  0E67'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0E6A'   CA 0E75'              	JZ	OF_RET
  0E6D'   2B                    	DCX	H
  0E6E'   7E                    	MOV	A,M
  0E6F'   FE 0A                 	CPI	LF
  0E71'   C2 0E67'              	JNZ	OF_LP
  0E74'   B7                    	ORA	A		; NZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E75'                         OF_RET:
  0E75'   E1                    	POP	H
  0E76'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0E77'                         HFCNT:
  0E77'   2A 2A01'              	LHLD	CMDCNT
  0E7A'   7C                    	MOV	A,H
  0E7B'   B5                    	ORA	L
  0E7C'   CA 0E93'              	JZ	HFC_AM
  0E7F'   CD 068B'              	CALL	GETCNT		; HL = count; clears it
  0E82'   3A 0000*              	LDA	NEDIT
  0E85'   5F                    	MOV	E,A
  0E86'   16 00                 	MVI	D,0
  0E88'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0E8B'   D2 0E8F'              	JNC	HFC_ST
  0E8E'   EB                    	XCHG			; HL = NEDIT
  0E8F'                         HFC_ST:
  0E8F'   7D                    	MOV	A,L
  0E90'   32 2A0E'              	STA	HFAMT
  0E93'                         HFC_AM:
  0E93'   3A 2A0E'              	LDA	HFAMT
  0E96'   B7                    	ORA	A
  0E97'   C2 0EA4'              	JNZ	HFC_HL
  0E9A'   3A 0000*              	LDA	NEDIT
  0E9D'   B7                    	ORA	A
  0E9E'   1F                    	RAR
  0E9F'   B7                    	ORA	A
  0EA0'   C2 0EA4'              	JNZ	HFC_HL
  0EA3'   3C                    	INR	A		; at least one line
  0EA4'                         HFC_HL:
  0EA4'   6F                    	MOV	L,A
  0EA5'   26 00                 	MVI	H,0
  0EA7'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0EA8'                         VC_REDR:
  0EA8'   C3 068B'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0EAB'                         VC_G:
  0EAB'   CD 075A'              	CALL	SETMOV
  0EAE'   CD 0F6D'              	CALL	GZONE		; the screen's top line, before the move
  0EB1'   CD 06B4'              	CALL	BRKON		; ... and a ^C may stop it from here on
  0EB4'   2A 2A01'              	LHLD	CMDCNT
  0EB7'   7C                    	MOV	A,H
  0EB8'   B5                    	ORA	L
  0EB9'   C2 0ECC'              	JNZ	VG_N
  0EBC'   AF                    	XRA	A		; forward
  0EBD'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0EC0'   CD 06EB'              	CALL	BRKOFF
  0EC3'   DA 0703'              	JC	BRKBAK
  0EC6'   CD 0A17'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0EC9'   C3 0F85'              	JMP	GPLACE
  0ECC'                         VG_N:
  0ECC'   CD 068B'              	CALL	GETCNT		; HL = target line (1-based)
  0ECF'                         VG_LN:
  0ECF'   CD 0EDB'              	CALL	GOLN
  0ED2'   CD 06EB'              	CALL	BRKOFF
  0ED5'   DA 0703'              	JC	BRKBAK
  0ED8'   C3 0F85'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  0EDB'                         GOLN:
  0EDB'   E5                    	PUSH	H
  0EDC'   CD 0000*              	CALL	CNTLF
  0EDF'   23                    	INX	H		; HL = the cursor's line
  0EE0'   D1                    	POP	D		; DE = the line wanted
  0EE1'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  0EE4'   DA 0EEF'              	JC	GLN_BK
  0EE7'   EB                    	XCHG
  0EE8'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  0EEB'   AF                    	XRA	A
  0EEC'   C3 0EF4'              	JMP	GLN_MV
  0EEF'                         GLN_BK:
  0EEF'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  0EF2'   3E FF                 	MVI	A,0FFH
  0EF4'                         GLN_MV:
  0EF4'   CD 0000*              	CALL	MVLIND
  0EF7'   CD 0A11'              	CALL	ATEOF
  0EFA'   DC 0A17'              	CC	LASTLN		; past the last line: onto it
  0EFD'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0EFE'                         VC_LG:
  0EFE'   CD 075A'              	CALL	SETMOV
  0F01'   3A 2A29'              	LDA	GSAVE
  0F04'   B7                    	ORA	A
  0F05'   C2 0F0E'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0F08'   3E 01                 	MVI	A,PG
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0F0A'   32 2A28'              	STA	GPEND
  0F0D'   C9                    	RET
  0F0E'                         VLG_GG:
  0F0E'   CD 0F6D'              	CALL	GZONE
  0F11'   CD 06B4'              	CALL	BRKON
  0F14'   CD 068B'              	CALL	GETCNT		; HL = target line (no count: 1)
  0F17'   C3 0ECF'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0F1A'                         SUB24:
  0F1A'   4F                    	MOV	C,A
  0F1B'   7D                    	MOV	A,L
  0F1C'   93                    	SUB	E
  0F1D'   6F                    	MOV	L,A
  0F1E'   7C                    	MOV	A,H
  0F1F'   9A                    	SBB	D
  0F20'   67                    	MOV	H,A
  0F21'   79                    	MOV	A,C
  0F22'   98                    	SBB	B
  0F23'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0F24'                         CURFP:
  0F24'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0F27'                         FPOS:
  0F27'   C5                    	PUSH	B
  0F28'   D5                    	PUSH	D
  0F29'   EB                    	XCHG
  0F2A'   2A 0000*              	LHLD	TXTBEG
  0F2D'   EB                    	XCHG
  0F2E'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0F31'   EB                    	XCHG			; DE = that
  0F32'   2A 0000*              	LHLD	OUTPOS
  0F35'   7C                    	MOV	A,H
  0F36'   B7                    	ORA	A		; CY = 0
  0F37'   1F                    	RAR
  0F38'   47                    	MOV	B,A
  0F39'   7D                    	MOV	A,L
  0F3A'   1F                    	RAR
  0F3B'   67                    	MOV	H,A
  0F3C'   3E 00                 	MVI	A,0
  0F3E'   1F                    	RAR
  0F3F'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0F40'   19                    	DAD	D
  0F41'   78                    	MOV	A,B
  0F42'   CE 00                 	ACI	0		; A:HL = the position
  0F44'   D1                    	POP	D
  0F45'   C1                    	POP	B
  0F46'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0F47'                         ZSAVE:
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F47'   2A 2A01'              	LHLD	CMDCNT
  0F4A'   22 2A67'              	SHLD	ZSVCNT
  0F4D'   2A 0000*              	LHLD	AUXCNT
  0F50'   22 2A69'              	SHLD	ZSVAUX
  0F53'   3A 0000*              	LDA	DIRFLG
  0F56'   32 2A6B'              	STA	ZSVDIR
  0F59'   C9                    	RET
  0F5A'                         ZREST:
  0F5A'   2A 2A67'              	LHLD	ZSVCNT
  0F5D'   22 2A01'              	SHLD	CMDCNT
  0F60'   2A 2A69'              	LHLD	ZSVAUX
  0F63'   22 0000*              	SHLD	AUXCNT
  0F66'   3A 2A6B'              	LDA	ZSVDIR
  0F69'   32 0000*              	STA	DIRFLG
  0F6C'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0F6D'                         GZONE:
  0F6D'   CD 0F47'              	CALL	ZSAVE
  0F70'   CD 0CF9'              	CALL	CURRW
  0F73'   6F                    	MOV	L,A
  0F74'   26 00                 	MVI	H,0
  0F76'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0F79'   CD 0F27'              	CALL	FPOS
  0F7C'   22 0000*              	SHLD	ZTOP
  0F7F'   32 0002*              	STA	ZTOP+2
  0F82'   C3 0F5A'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0F85'                         GPLACE:
  0F85'   CD 0F47'              	CALL	ZSAVE
  0F88'   CD 0F24'              	CALL	CURFP
  0F8B'   EB                    	XCHG
  0F8C'   2A 0000*              	LHLD	ZTOP
  0F8F'   EB                    	XCHG
  0F90'   4F                    	MOV	C,A		; C:HL = the target's position
  0F91'   3A 0002*              	LDA	ZTOP+2
  0F94'   47                    	MOV	B,A		; B:DE = the top's
  0F95'   79                    	MOV	A,C
  0F96'   CD 0F1A'              	CALL	SUB24
  0F99'   22 2A64'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  0F9C'   DA 0FE9'              	JC	GP_UP
  0F9F'   B7                    	ORA	A
  0FA0'   C2 102A'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0FA3'   3A 0000*              	LDA	NEDIT
  0FA6'   5F                    	MOV	E,A
  0FA7'   16 00                 	MVI	D,0
  0FA9'   B7                    	ORA	A
  0FAA'   1F                    	RAR
  0FAB'   6F                    	MOV	L,A
  0FAC'   26 00                 	MVI	H,0
  0FAE'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0FAF'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0FB2'   CD 0684'              	CALL	GBSUB		; HL = bytes from there to the target
  0FB5'   EB                    	XCHG
  0FB6'   2A 2A64'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0FB9'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0FBC'   DA 102A'              	JC	GP_MID
  0FBF'   CD 0684'              	CALL	GBSUB		; HL = the top line's start (resident)
  0FC2'   01 0000               	LXI	B,0		; BC = lines from the top
  0FC5'                         GP_CNT:
  0FC5'   7A                    	MOV	A,D
  0FC6'   B3                    	ORA	E
  0FC7'   CA 0FD6'              	JZ	GP_DN
  0FCA'   7E                    	MOV	A,M
  0FCB'   23                    	INX	H
  0FCC'   1B                    	DCX	D
  0FCD'   FE 0A                 	CPI	LF
  0FCF'   C2 0FC5'              	JNZ	GP_CNT
  0FD2'   03                    	INX	B
  0FD3'   C3 0FC5'              	JMP	GP_CNT
  0FD6'                         GP_DN:
  0FD6'   3A 0000*              	LDA	NEDIT
  0FD9'   3D                    	DCR	A
  0FDA'   5F                    	MOV	E,A
  0FDB'   16 00                 	MVI	D,0		; DE = the bottom row
  0FDD'   60                    	MOV	H,B
  0FDE'   69                    	MOV	L,C
  0FDF'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0FE2'   DA 1034'              	JC	GP_SET		; A = the bottom row
  0FE5'   7D                    	MOV	A,L		; on the screen: its row
  0FE6'   C3 1054'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0FE9'                         GP_UP:
  0FE9'   3C                    	INR	A
  0FEA'   C2 102A'              	JNZ	GP_MID		; 64K bytes or more above
  0FED'   2A 2A64'              	LHLD	ZDIF
  0FF0'   EB                    	XCHG
  0FF1'   21 0000               	LXI	H,0
  0FF4'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0FF7'   7C                    	MOV	A,H
  0FF8'   B5                    	ORA	L
  0FF9'   CA 102A'              	JZ	GP_MID		; exactly 64K
  0FFC'   EB                    	XCHG			; DE = bytes to read
  0FFD'   AF                    	XRA	A
  0FFE'   32 2A66'              	STA	ZLF
  1001'   CD 0000*              	CALL	RGET0
  1004'                         GP_RD:
  1004'   CD 0000*              	CALL	RDGET		; (keeps DE)
  1007'   DA 102A'              	JC	GP_MID
  100A'   FE 0A                 	CPI	LF
  100C'   C2 1020'              	JNZ	GP_RN
  100F'   3A 0000*              	LDA	NEDIT
  1012'   B7                    	ORA	A
  1013'   1F                    	RAR
  1014'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  1016'   E5                    	PUSH	H
  1017'   21 2A66'              	LXI	H,ZLF
  101A'   34                    	INR	M
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  101B'   BE                    	CMP	M		; CY iff more lines than that
  101C'   E1                    	POP	H
  101D'   DA 102A'              	JC	GP_MID
  1020'                         GP_RN:
  1020'   1B                    	DCX	D
  1021'   7A                    	MOV	A,D
  1022'   B3                    	ORA	E
  1023'   C2 1004'              	JNZ	GP_RD
  1026'   AF                    	XRA	A		; the top row
  1027'   C3 1034'              	JMP	GP_SET
  102A'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  102A'   3E 01                 	MVI	A,1
  102C'   32 0000*              	STA	WFILL		; not past the end of the file
  102F'   3A 0000*              	LDA	NEDIT
  1032'   B7                    	ORA	A
  1033'   1F                    	RAR			; the middle row
  1034'                         GP_SET:
  1034'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  1035'   26 00                 	MVI	H,0
  1037'   22 0000*              	SHLD	WINROW
  103A'   21 0000               	LXI	H,0
  103D'   22 0000*              	SHLD	LNDLT
  1040'   CD 077B'              	CALL	SETFUL		; the window may have paged: full repaint
  1043'                         GP_FIN:
  1043'   CD 0F5A'              	CALL	ZREST
  1046'   3A 2A8E'              	LDA	GPKEEP
  1049'   B7                    	ORA	A
  104A'   CA 0828'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  104D'   AF                    	XRA	A
  104E'   32 2A8E'              	STA	GPKEEP
  1051'   C3 057D'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  1054'                         GP_ONS:
  1054'   6F                    	MOV	L,A
  1055'   26 00                 	MVI	H,0		; HL = the row it lands on
  1057'   EB                    	XCHG
  1058'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  105B'   EB                    	XCHG
  105C'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  105F'   22 0000*              	SHLD	LNDLT
  1062'   3E 01                 	MVI	A,R_MOVE
  1064'   32 2A05'              	STA	RINTENT
  1067'   C3 1043'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  106A'                         OPPEND:
  106A'   AF                    	XRA	A
  106B'   32 2A2E'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  106E'   3A 2A2B'              	LDA	PSAVE
  1071'   FE 63                 	CPI	'c'
  1073'   C2 1090'              	JNZ	OPP_ND
  1076'   79                    	MOV	A,C
  1077'   FE 77                 	CPI	'w'
  1079'   CA 1081'              	JZ	OPP_W
  107C'   FE 57                 	CPI	'W'
  107E'   C2 1090'              	JNZ	OPP_ND
  1081'                         OPP_W:
  1081'   CD 1263'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  1084'   DA 1090'              	JC	OPP_ND
  1087'   79                    	MOV	A,C
  1088'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  108A'   4F                    	MOV	C,A
  108B'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  108D'   32 2A2E'              	STA	CWEOL		;   see the clamp in OPA_F
  1090'                         OPP_ND:
  1090'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  1091'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  1093'   C2 10A7'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  1096'   CD 021C'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  1099'   DA 1137'              	JC	OPABRT
  109C'   79                    	MOV	A,C
  109D'   FE 67                 	CPI	'g'
  109F'   C2 1137'              	JNZ	OPABRT
  10A2'   3E 01                 	MVI	A,PG
  10A4'   32 2A29'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  10A7'                         OPP_NG:
  10A7'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  10A8'   21 2A2B'              	LXI	H,PSAVE
  10AB'   BE                    	CMP	M
  10AC'   CA 1284'              	JZ	OPLINE
  10AF'   79                    	MOV	A,C		; (OPCLS classifies the key)
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  10B0'   CD 129A'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  10B3'   DA 1137'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  10B6'   32 2A2D'              	STA	OPCLSV
  10B9'   47                    	MOV	B,A		; B = the class
  10BA'   3A 2A2B'              	LDA	PSAVE
  10BD'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  10BF'   C2 10CB'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  10C2'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  10C3'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  10C5'   C2 10ED'              	JNZ	OPP_GO
  10C8'   C3 10D6'              	JMP	OPP_NO
  10CB'                         OPP_NC:
  10CB'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  10CD'   C2 10ED'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  10D0'   78                    	MOV	A,B		;   a charwise register would need a type flag
  10D1'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  10D3'   CA 10ED'              	JZ	OPP_GO		;   within a line -- neither of which is built
  10D6'                         OPP_NO:
  10D6'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  10D7'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  10D9'   CA 10E7'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  10DC'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  10DE'   CA 10E7'              	JZ	OPP_SW		;   so swallow it before dropping the command
  10E1'   CD 034C'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  10E4'   C2 1137'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  10E7'                         OPP_SW:
  10E7'   CD 021C'              	CALL	MKGETK
  10EA'   C3 1137'              	JMP	OPABRT
  10ED'                         OPP_GO:
  10ED'   AF                    	XRA	A
  10EE'   32 2A0C'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  10F1'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  10F4'   22 2A2F'              	SHLD	OPSTA
  10F7'   C5                    	PUSH	B
  10F8'   21 2A33'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  10FB'   CD 044F'              	CALL	FPSTO		;   only good until the motion pages the window
  10FE'   3A 2A2D'              	LDA	OPCLSV
  1101'   FE 02                 	CPI	2
  1103'   CC 113A'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  1106'   C1                    	POP	B
  1107'   21 292F'              	LXI	H,CMDTAB
  110A'   CD 00C9'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  110D'   3A 2A2B'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1110'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1111'   CA 075A'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  1114'   CD 1166'              	CALL	OPSFIX		; where the start is in the window NOW
  1117'   D2 1182'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  111A'   22 2A2F'              	SHLD	OPSTA
  111D'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1120'   22 2A31'              	SHLD	OPEND2
  1123'   3A 2A2B'              	LDA	PSAVE
  1126'   FE 79                 	CPI	'y'
  1128'   CA 17AF'              	JZ	OPYANK		; a yank takes the span without losing it
  112B'   CD 12D5'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  112E'   3A 2A2B'              	LDA	PSAVE
  1131'   FE 63                 	CPI	'c'
  1133'   C0                    	RNZ
  1134'   C3 156B'              	JMP	SETINS
  1137'                         OPABRT:				; not a motion -> the operator is dropped and
  1137'   C3 00A9'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  113A'                         OPENDS:
  113A'   2A 2A2F'              	LHLD	OPSTA
  113D'   CD 05E4'              	CALL	BOL
  1140'   11 2A36'              	LXI	D,OPSLO
  1143'   CD 1158'              	CALL	OPE_ST
  1146'   2A 2A2F'              	LHLD	OPSTA
  1149'   CD 0614'              	CALL	NLSTART
  114C'   11 2A39'              	LXI	D,OPSHI
  114F'   CD 1158'              	CALL	OPE_ST
  1152'   2A 2A2F'              	LHLD	OPSTA
  1155'   C3 0000*              	JMP	GOTO
  1158'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  1158'   D5                    	PUSH	D
  1159'   CD 0000*              	CALL	GOTO
  115C'   E1                    	POP	H
  115D'   C3 044F'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  1160'                         CURBD:
  1160'   CD 0F24'              	CALL	CURFP
  1163'   EB                    	XCHG
  1164'   47                    	MOV	B,A
  1165'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  1166'                         OPSFIX:
  1166'   21 2A33'              	LXI	H,OPSFP
  1169'   CD 0402'              	CALL	MKLOAD
  116C'   CD 1160'              	CALL	CURBD
  116F'   2A 2A98'              	LHLD	MKPOS
  1172'   3A 2A9A'              	LDA	MKPOS+2
  1175'   CD 0F1A'              	CALL	SUB24
  1178'   B4                    	ORA	H
  1179'   B5                    	ORA	L
  117A'   C2 040F'              	JNZ	MKWIN
  117D'   CD 0000*              	CALL	CUROFF
  1180'   37                    	STC
  1181'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  1182'                         OPPGD:
  1182'   47                    	MOV	B,A
  1183'   3A 2A2D'              	LDA	OPCLSV
  1186'   FE 02                 	CPI	2
  1188'   C2 1244'              	JNZ	OPG_NO
  118B'   3A 2A2B'              	LDA	PSAVE
  118E'   FE 64                 	CPI	'd'
  1190'   C2 1244'              	JNZ	OPG_NO
  1193'   04                    	INR	B
  1194'   CA 11A3'              	JZ	OPG_FW
  1197'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  119A'   CD 05E4'              	CALL	BOL		;   and the high end is OPSHI as it stands
  119D'   CD 0000*              	CALL	GOTO
  11A0'   C3 11BB'              	JMP	OPG_GO
  11A3'                         OPG_FW:
  11A3'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  11A6'   CD 0614'              	CALL	NLSTART		;   landed on, and the low one is where the
  11A9'   11 2A39'              	LXI	D,OPSHI		;   start line began
  11AC'   CD 1158'              	CALL	OPE_ST
  11AF'   21 2A36'              	LXI	H,OPSLO
  11B2'   CD 0402'              	CALL	MKLOAD
  11B5'   CD 03CF'              	CALL	MKPAGE
  11B8'   CD 0000*              	CALL	GOTO
  11BB'                         OPG_GO:
  11BB'   CD 1160'              	CALL	CURBD
  11BE'   2A 2A39'              	LHLD	OPSHI
  11C1'   3A 2A3B'              	LDA	OPSHI+2
  11C4'   CD 0F1A'              	CALL	SUB24		; A:HL = the bytes to take
  11C7'                         OPG_SV:
  11C7'   22 2A3C'              	SHLD	OPTOGO
  11CA'   32 2A3E'              	STA	OPTOGO+2
  11CD'                         OPG_NX:
  11CD'   CD 0667'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  11D0'   CD 0000*              	CALL	SUBHD
  11D3'   EB                    	XCHG			; DE = what the window holds past the cursor
  11D4'   2A 2A3C'              	LHLD	OPTOGO
  11D7'   3A 2A3E'              	LDA	OPTOGO+2
  11DA'   B7                    	ORA	A
  11DB'   C2 120E'              	JNZ	OPG_PG		; 64K or more to go
  11DE'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  11E1'   DA 120E'              	JC	OPG_PG
  11E4'   CA 120E'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  11E7'                         OPG_FN:				; the rest of it is here
  11E7'   E5                    	PUSH	H
  11E8'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  11EB'   CD 0000*              	CALL	CUROFF
  11EE'   22 2A3F'              	SHLD	OPLO
  11F1'   D1                    	POP	D
  11F2'   19                    	DAD	D
  11F3'   22 2A41'              	SHLD	OPHI
  11F6'   CD 13DB'              	CALL	OPDSPN
  11F9'   CD 0A11'              	CALL	ATEOF
  11FC'   D2 125D'              	JNC	OPMID
  11FF'   CD 0E57'              	CALL	ONFST		; deleted to the end of the file: onto the new
  1202'   CA 125D'              	JZ	OPMID		;   last line, if there is one -- and the pager
  1205'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  1208'   CD 0000*              	CALL	SETBWD
  120B'   C3 125D'              	JMP	OPMID
  120E'                         OPG_PG:
  120E'   7A                    	MOV	A,D
  120F'   B3                    	ORA	E
  1210'   C2 1229'              	JNZ	OPG_DL
  1213'   CD 0A11'              	CALL	ATEOF		; nothing held past the cursor
  1216'   21 0000               	LXI	H,0
  1219'   DA 11E7'              	JC	OPG_FN		; ... and no more to come: the file ran out
  121C'   2B                    	DCX	H
  121D'   CD 0000*              	CALL	SETC0
  1220'   CD 0000*              	CALL	GOLINE
  1223'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  1226'   C3 11CD'              	JMP	OPG_NX
  1229'                         OPG_DL:
  1229'   D5                    	PUSH	D
  122A'   21 FFFF               	LXI	H,0FFFFH
  122D'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1230'   E1                    	POP	H
  1231'   E5                    	PUSH	H
  1232'   CD 0000*              	CALL	DELFWD
  1235'   D1                    	POP	D
  1236'   06 00                 	MVI	B,0
  1238'   2A 2A3C'              	LHLD	OPTOGO
  123B'   3A 2A3E'              	LDA	OPTOGO+2
  123E'   CD 0F1A'              	CALL	SUB24
  1241'   C3 11C7'              	JMP	OPG_SV
  1244'                         OPG_NO:
  1244'   0E 07                 	MVI	C,BEL
  1246'   CD 0000*              	CALL	BCONOU
  1249'                         OPG_HM:				; the cursor back where the command found it
  1249'   21 2A33'              	LXI	H,OPSFP
  124C'   CD 0402'              	CALL	MKLOAD
  124F'   CD 03CF'              	CALL	MKPAGE
  1252'   CD 0000*              	CALL	GOTO
  1255'   AF                    	XRA	A
  1256'   32 2A2B'              	STA	PSAVE
  1259'   3C                    	INR	A
  125A'   32 2A8E'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  125D'                         OPMID:
  125D'   CD 0F47'              	CALL	ZSAVE
  1260'   C3 102A'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  1263'                         ONWHIT:
  1263'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1266'   CA 1282'              	JZ	OW_YES
  1269'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  126C'   FE 20                 	CPI	' '
  126E'   CA 1282'              	JZ	OW_YES
  1271'   FE 09                 	CPI	TAB
  1273'   CA 1282'              	JZ	OW_YES
  1276'   FE 0D                 	CPI	CR
  1278'   CA 1282'              	JZ	OW_YES
  127B'   FE 0A                 	CPI	LF
  127D'   CA 1282'              	JZ	OW_YES
  1280'   B7                    	ORA	A		; a char to change: CY clear
  1281'   C9                    	RET
  1282'                         OW_YES:
  1282'   37                    	STC
  1283'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  1284'                         OPLINE:
  1284'   3A 2A2B'              	LDA	PSAVE
  1287'   FE 63                 	CPI	'c'
  1289'   CA 075A'              	JZ	SETMOV
  128C'   FE 79                 	CPI	'y'
  128E'   CA 178E'              	JZ	VY_YY
  1291'   21 2A33'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1294'   CD 044F'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1297'   C3 1707'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  129A'                         OPCLS:
  129A'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  129C'   CA 12A9'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  129F'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  12A1'   C2 12BD'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  12A4'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  12A6'   C3 12AB'              	JMP	OPC_FK
  12A9'                         OPC_SEM:
  12A9'   06 00                 	MVI	B,0		; ';' runs it as it stands
  12AB'                         OPC_FK:
  12AB'   3A 2A84'              	LDA	FNDKND
  12AE'   B7                    	ORA	A
  12AF'   37                    	STC
  12B0'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  12B1'   A8                    	XRA	B		; ... and now the direction ',' asked for
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  12B2'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  12B4'   CA 12BB'              	JZ	OPC_EXC
  12B7'   3E 01                 	MVI	A,1
  12B9'   B7                    	ORA	A		; CY clear: a motion, class 1
  12BA'   C9                    	RET
  12BB'                         OPC_EXC:
  12BB'   AF                    	XRA	A		; class 0, CY clear
  12BC'   C9                    	RET
  12BD'                         OPC_TB:
  12BD'   47                    	MOV	B,A
  12BE'   21 145F'              	LXI	H,OPCTAB
  12C1'                         OPC_LP:
  12C1'   7E                    	MOV	A,M
  12C2'   B7                    	ORA	A
  12C3'   CA 12D3'              	JZ	OPC_MS		; end of table -> not a motion
  12C6'   B8                    	CMP	B
  12C7'   CA 12CF'              	JZ	OPC_HT
  12CA'   23                    	INX	H
  12CB'   23                    	INX	H
  12CC'   C3 12C1'              	JMP	OPC_LP
  12CF'                         OPC_HT:
  12CF'   23                    	INX	H
  12D0'   7E                    	MOV	A,M		; class byte
  12D1'   B7                    	ORA	A		; clear CY
  12D2'   C9                    	RET
  12D3'                         OPC_MS:
  12D3'   37                    	STC
  12D4'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  12D5'                         OPAPPL:
  12D5'   3A 2A2D'              	LDA	OPCLSV
  12D8'   FE 02                 	CPI	2
  12DA'   CA 1443'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  12DD'   2A 2A2F'              	LHLD	OPSTA
  12E0'   EB                    	XCHG			; DE = start
  12E1'   2A 2A31'              	LHLD	OPEND2		; HL = end
  12E4'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  12E7'   DA 12F7'              	JC	OPA_F
  12EA'   CA 12F7'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  12ED'   22 2A3F'              	SHLD	OPLO
  12F0'   EB                    	XCHG
  12F1'   22 2A41'              	SHLD	OPHI
  12F4'   C3 1368'              	JMP	OPA_C1
  12F7'                         OPA_F:
  12F7'   EB                    	XCHG			; HL = start, DE = end
  12F8'   22 2A3F'              	SHLD	OPLO
  12FB'   EB                    	XCHG			; HL = end
  12FC'   3A 2A2D'              	LDA	OPCLSV
  12FF'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1301'   CA 1365'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


                                				;   of it, so it must not be cut back
  1304'   FE 01                 	CPI	1
  1306'   C2 1332'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end).
                                	;    'cw' stops at the content end of the line it STARTED on, where a
                                	;    plain 'ce' (and 'de') runs on into the next line's word and 'd%'
                                	;    crosses to its mate -- all four recorded from vim 9.1.  vim's 'cw'
                                	;    is not simply 'ce': the rewrite keeps 'w's own end-of-line stop, so
                                	;    that clamp hangs off CWEOL (the rewrite) and not off the class. ---
  1309'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  130A'   22 2A41'              	SHLD	OPHI		; park it: CEND clobbers DE
  130D'   2B                    	DCX	H		; the line it landed on ...
  130E'   3A 2A2E'              	LDA	CWEOL
  1311'   B7                    	ORA	A
  1312'   CA 1318'              	JZ	OPA_LE
  1315'   2A 2A3F'              	LHLD	OPLO		; ... or, for 'cw', the one it started on
  1318'                         OPA_LE:
  1318'   CD 14E9'              	CALL	CEND		; HL = that line's content end
  131B'   EB                    	XCHG			; DE = it
  131C'   2A 2A41'              	LHLD	OPHI		; HL = hi
  131F'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  1322'   D2 1356'              	JNC	OPA_HI		; hi is inside the line: keep it
  1325'   2A 2A3F'              	LHLD	OPLO
  1328'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  132B'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  132E'   EB                    	XCHG			; HL = the content end: the span stops there
  132F'   C3 1356'              	JMP	OPA_HI
  1332'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  1332'   22 2A41'              	SHLD	OPHI		; the motion's own end, for now
  1335'   2A 2A3F'              	LHLD	OPLO
  1338'   CD 14E9'              	CALL	CEND		; HL = the start line's content end
  133B'   EB                    	XCHG			; DE = that content end
  133C'   3A 2A0C'              	LDA	WPULL		; the motion landed on a line's end and was
  133F'   B7                    	ORA	A		;   pulled back onto its last char (the command
  1340'   C2 134C'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  1343'   2A 2A41'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  1346'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  1349'   D2 1359'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  134C'                         OPA_CE:				;   deletes the word, not all but its last char
  134C'   2A 2A3F'              	LHLD	OPLO
  134F'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1352'   CA 13F5'              	JZ	OPA_LN
  1355'   EB                    	XCHG			; HL = the content end
  1356'                         OPA_HI:
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  1356'   22 2A41'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  1359'                         OPA_DO:
  1359'   CD 13DB'              	CALL	OPDSPN
  135C'   3A 2A2B'              	LDA	PSAVE
  135F'   FE 63                 	CPI	'c'
  1361'   C8                    	RZ
  1362'   C3 14FA'              	JMP	CLAMPE
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  1365'                         OPA_JP:
  1365'   22 2A41'              	SHLD	OPHI
  1368'                         OPA_C1:
  1368'   CD 13D0'              	CALL	OPSPNL
  136B'   7C                    	MOV	A,H
  136C'   B5                    	ORA	L
  136D'   CA 1359'              	JZ	OPA_DO		; nothing spanned
  1370'   2A 2A41'              	LHLD	OPHI
  1373'   CD 05E4'              	CALL	BOL
  1376'   EB                    	XCHG
  1377'   2A 2A41'              	LHLD	OPHI
  137A'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  137D'   C2 1359'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  1380'   2A 2A3F'              	LHLD	OPLO
  1383'   CD 05E4'              	CALL	BOL
  1386'                         C1_LP:
  1386'   E5                    	PUSH	H
  1387'   EB                    	XCHG
  1388'   2A 2A3F'              	LHLD	OPLO
  138B'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  138E'   E1                    	POP	H
  138F'   CA 13AF'              	JZ	C1_LW		; only blanks before lo: whole lines
  1392'   E5                    	PUSH	H
  1393'   CD 0000*              	CALL	CHARAT
  1396'   E1                    	POP	H
  1397'   23                    	INX	H
  1398'   FE 20                 	CPI	' '
  139A'   CA 1386'              	JZ	C1_LP
  139D'   FE 09                 	CPI	TAB
  139F'   CA 1386'              	JZ	C1_LP
  13A2'                         C1_CH:
  13A2'   2A 2A41'              	LHLD	OPHI		; back over the line break to the content end
  13A5'   2B                    	DCX	H		;   of the line before
  13A6'   CD 14E9'              	CALL	CEND
  13A9'   22 2A41'              	SHLD	OPHI
  13AC'   C3 1359'              	JMP	OPA_DO
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  13AF'                         C1_LW:
  13AF'   2A 2A3F'              	LHLD	OPLO
  13B2'   CD 05E4'              	CALL	BOL
  13B5'   22 2A3F'              	SHLD	OPLO
  13B8'   3A 2A2B'              	LDA	PSAVE
  13BB'   FE 63                 	CPI	'c'
  13BD'   CA 13A2'              	JZ	C1_CH
  13C0'   C3 1446'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  13C3'                         SPNBRK:
  13C3'   2A 2A3F'              	LHLD	OPLO
  13C6'   CD 05F7'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  13C9'   EB                    	XCHG			; DE = it
  13CA'   2A 2A41'              	LHLD	OPHI
  13CD'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  13D0'                         OPSPNL:
  13D0'   2A 2A41'              	LHLD	OPHI
  13D3'   EB                    	XCHG
  13D4'   2A 2A3F'              	LHLD	OPLO
  13D7'   EB                    	XCHG			; HL = hi, DE = lo
  13D8'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  13DB'                         OPDSPN:
  13DB'   CD 13C3'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  13DE'   F5                    	PUSH	PSW
  13DF'   2A 2A3F'              	LHLD	OPLO
  13E2'   CD 0000*              	CALL	GOTO
  13E5'   CD 13D0'              	CALL	OPSPNL		; HL = hi - lo
  13E8'   CD 0000*              	CALL	DELFWD
  13EB'   CD 018C'              	CALL	MARKMOD
  13EE'   F1                    	POP	PSW
  13EF'   DA 077B'              	JC	SETFUL		; a break went: every row below it moved up
  13F2'   C3 0760'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  13F5'                         OPA_LN:
  13F5'   3A 2A2B'              	LDA	PSAVE
  13F8'   FE 63                 	CPI	'c'
  13FA'   C2 1403'              	JNZ	OPA_LD
  13FD'   2A 2A3F'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  1400'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  1403'                         OPA_LD:
  1403'   2A 2A3F'              	LHLD	OPLO
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  1406'   22 2A2F'              	SHLD	OPSTA
  1409'   22 2A31'              	SHLD	OPEND2
  140C'   C3 1443'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  140F'                         OPALSP:
  140F'   2A 2A2F'              	LHLD	OPSTA
  1412'   EB                    	XCHG
  1413'   2A 2A31'              	LHLD	OPEND2
  1416'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  1419'   DA 1426'              	JC	OPAL_F
  141C'   22 2A3F'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  141F'   EB                    	XCHG
  1420'   22 2A41'              	SHLD	OPHI		; hi-src = start
  1423'   C3 1430'              	JMP	OPAL_R
  1426'                         OPAL_F:
  1426'   EB                    	XCHG			; HL = start
  1427'   22 2A3F'              	SHLD	OPLO		; lo-src = start
  142A'   2A 2A31'              	LHLD	OPEND2
  142D'   22 2A41'              	SHLD	OPHI		; hi-src = end
  1430'                         OPAL_R:
  1430'   2A 2A3F'              	LHLD	OPLO
  1433'   CD 05E4'              	CALL	BOL
  1436'   22 2A3F'              	SHLD	OPLO		; lo = BOL(low line)
  1439'   2A 2A41'              	LHLD	OPHI
  143C'   CD 0614'              	CALL	NLSTART
  143F'   22 2A41'              	SHLD	OPHI		; hi = start of line past the high line
  1442'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  1443'                         OPALIN:
  1443'   CD 140F'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  1446'                         OPDLIN:
  1446'   CD 13DB'              	CALL	OPDSPN
  1449'   CD 0667'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  144C'   DA 145C'              	JC	OPDL_NB
  144F'   CD 0000*              	CALL	LOGLEN
  1452'   7C                    	MOV	A,H
  1453'   B5                    	ORA	L
  1454'   C8                    	RZ			; empty buffer
  1455'   2B                    	DCX	H
  1456'   CD 05E4'              	CALL	BOL
  1459'   CD 0000*              	CALL	GOTO
  145C'                         OPDL_NB:
  145C'   C3 0828'              	JMP	FNBLNK
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  145F'                         OPCTAB:
  145F'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1463'   62 00 42 00           
  1467'   68 00 6C 00           
  146B'   30 00 5E 00           
  146F'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1471'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1475'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1479'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  147D'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1481'   24 01                 
  1483'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1487'   47 02 48 02           
  148B'   4D 02 4C 02           
  148F'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  1491'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1493'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1494'                         VCB_C:
  1494'   CD 14A0'              	CALL	VCB_CD
  1497'   C3 156B'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  149A'                         VCB_D:
  149A'   CD 14A0'              	CALL	VCB_CD
  149D'   C3 14FA'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  14A0'                         VCB_CD:
  14A0'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  14A3'   22 2A3F'              	SHLD	OPLO
  14A6'   CD 0000*              	CALL	CUROFF
  14A9'   CD 14E9'              	CALL	CEND		; to the line's content end, the CR,LF left
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  14AC'   22 2A41'              	SHLD	OPHI
  14AF'   C3 13DB'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  14B2'                         VC_X:
  14B2'   CD 08DA'              	CALL	GLSTAL
  14B5'   CD 0760'              	CALL	SETLIN
  14B8'   CD 068B'              	CALL	GETCNT
  14BB'   22 2A43'              	SHLD	CNTV
  14BE'   CD 0000*              	CALL	CUROFF
  14C1'   22 2A47'              	SHLD	WKI		; cur
  14C4'   CD 14E9'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  14C7'   EB                    	XCHG			; DE = contentend
  14C8'   2A 2A47'              	LHLD	WKI		; HL = cur
  14CB'   EB                    	XCHG			; HL = contentend, DE = cur
  14CC'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  14CF'   7C                    	MOV	A,H
  14D0'   B5                    	ORA	L
  14D1'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  14D2'   EB                    	XCHG			; DE = available
  14D3'   2A 2A43'              	LHLD	CNTV		; HL = count
  14D6'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  14D9'   DA 14DF'              	JC	VX_USEA
  14DC'   C3 14E0'              	JMP	VX_DEL		; count <= available -> HL = count = del
  14DF'                         VX_USEA:
  14DF'   EB                    	XCHG			; HL = available
  14E0'                         VX_DEL:
  14E0'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  14E3'   CD 018C'              	CALL	MARKMOD
  14E6'   C3 14FA'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  14E9'                         CEND:
  14E9'   CD 05F7'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  14EC'   7C                    	MOV	A,H
  14ED'   B5                    	ORA	L
  14EE'   C8                    	RZ			; the start of the text: nothing before it
  14EF'   2B                    	DCX	H
  14F0'   E5                    	PUSH	H
  14F1'   CD 0000*              	CALL	CHARAT
  14F4'   E1                    	POP	H		; HL = term-1
  14F5'   FE 0D                 	CPI	CR
  14F7'   C8                    	RZ			; a CR before the LF -> the content ends there
  14F8'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  14F9'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  14FA'                         CLAMPE:
  14FA'   CD 0000*              	CALL	CUROFF
  14FD'   E5                    	PUSH	H
  14FE'   CD 0623'              	CALL	EOLC
  1501'   D1                    	POP	D		; DE = cur
  1502'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  1505'   D8                    	RC
  1506'   C8                    	RZ
  1507'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  150A'                         VC_I:
  150A'   CD 068B'              	CALL	GETCNT
  150D'   C3 1568'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1510'                         VC_A:
  1510'   CD 068B'              	CALL	GETCNT
  1513'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1516'   CA 152D'              	JZ	VA_INS
  1519'   EB                    	XCHG			; HL = cur
  151A'   E5                    	PUSH	H
  151B'   CD 0000*              	CALL	CHARAT
  151E'   E1                    	POP	H
  151F'   FE 0A                 	CPI	LF
  1521'   CA 152D'              	JZ	VA_INS		; on the line terminator -> append in place
  1524'   FE 0D                 	CPI	CR
  1526'   CA 152D'              	JZ	VA_INS
  1529'   23                    	INX	H
  152A'   CD 0000*              	CALL	GOTO
  152D'                         VA_INS:
  152D'   C3 1568'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1530'                         VCB_A:
  1530'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1533'   CD 0623'              	CALL	EOLC		; HL = last content char (the start when empty)
  1536'   E5                    	PUSH	H
  1537'   CD 0000*              	CALL	CHARAT
  153A'   E1                    	POP	H
  153B'   FE 0D                 	CPI	CR
  153D'   CA 1546'              	JZ	VBA_IN		; an empty line: insert at its start
  1540'   FE 0A                 	CPI	LF
  1542'   CA 1546'              	JZ	VBA_IN
  1545'   23                    	INX	H		; past the last content char
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  1546'                         VBA_IN:
  1546'   CD 0000*              	CALL	GOTO
  1549'   C3 1568'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  154C'                         VCB_I:
  154C'   CD 068B'              	CALL	GETCNT
  154F'   CD 0828'              	CALL	FNBLNK
  1552'   CD 0000*              	CALL	CUROFF
  1555'   E5                    	PUSH	H
  1556'   CD 0000*              	CALL	CHARAT
  1559'   E1                    	POP	H
  155A'   FE 20                 	CPI	' '
  155C'   CA 1564'              	JZ	VBI_SK
  155F'   FE 09                 	CPI	TAB
  1561'   C2 1568'              	JNZ	SETINM
  1564'                         VBI_SK:
  1564'   23                    	INX	H		; blanks only: past the last of them
  1565'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1568'                         SETINM:
  1568'   CD 075A'              	CALL	SETMOV
  156B'                         SETINS:
  156B'   3E 01                 	MVI	A,EM_INS
  156D'   32 2A00'              	STA	EDMODE
  1570'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1571'                         ATCEND:
  1571'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1574'   C8                    	RZ
  1575'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  1578'   FE 0D                 	CPI	CR
  157A'   C8                    	RZ
  157B'   FE 0A                 	CPI	LF
  157D'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  157E'                         OPNBRK:
  157E'   CD 1E70'              	CALL	PUTBRK
  1581'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1584'   23                    	INX	H
  1585'   22 0000*              	SHLD	LNDLT
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  1588'   C3 018C'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  158B'                         ENDBRK:
  158B'   CD 0667'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  158E'   C0                    	RNZ
  158F'   CD 157E'              	CALL	OPNBRK
  1592'   CD 0000*              	CALL	CUROFF
  1595'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1596'   2B                    	DCX	H		;   line, with its own terminator after it
  1597'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  159A'                         VC_O:
  159A'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  159D'   CD 14E9'              	CALL	CEND
  15A0'   CD 0000*              	CALL	GOTO
  15A3'   CD 157E'              	CALL	OPNBRK
  15A6'   CD 158B'              	CALL	ENDBRK		; a last line with no line end: the opened line
  15A9'   CD 0766'              	CALL	SETILN		;   needs a terminator of its own to exist
  15AC'   C3 156B'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  15AF'                         VCB_O:
  15AF'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15B2'   CD 05E4'              	CALL	BOL
  15B5'   CD 0000*              	CALL	GOTO
  15B8'   CD 157E'              	CALL	OPNBRK
  15BB'   CD 0000*              	CALL	CUROFF
  15BE'   2B                    	DCX	H
  15BF'   2B                    	DCX	H
  15C0'   CD 0000*              	CALL	GOTO
  15C3'   CD 0766'              	CALL	SETILN
  15C6'   C3 156B'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  15C9'                         VCB_J:
  15C9'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15CC'   CD 14E9'              	CALL	CEND		; the join point: this line's content end
  15CF'   22 2A3F'              	SHLD	OPLO
  15D2'   CD 0000*              	CALL	CUROFF
  15D5'   CD 0614'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  15D8'   E5                    	PUSH	H
  15D9'   CD 0000*              	CALL	LOGLEN
  15DC'   D1                    	POP	D		; DE = that start
  15DD'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  15E0'   CA 075A'              	JZ	SETMOV
  15E3'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  15E4'                         VJ_WS:
  15E4'   E5                    	PUSH	H
  15E5'   CD 0000*              	CALL	LOGLEN
  15E8'   D1                    	POP	D		; DE = the scan
  15E9'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  15EC'   CA 1603'              	JZ	VJ_DEL
  15EF'   EB                    	XCHG			; HL = the scan
  15F0'   E5                    	PUSH	H
  15F1'   CD 0000*              	CALL	CHARAT
  15F4'   E1                    	POP	H
  15F5'   FE 20                 	CPI	' '
  15F7'   CA 15FF'              	JZ	VJ_SKIP
  15FA'   FE 09                 	CPI	TAB
  15FC'   C2 1603'              	JNZ	VJ_DEL
  15FF'                         VJ_SKIP:
  15FF'   23                    	INX	H
  1600'   C3 15E4'              	JMP	VJ_WS
  1603'                         VJ_DEL:
  1603'   22 2A41'              	SHLD	OPHI
  1606'   CD 13DB'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1609'   CD 0775'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  160C'   CD 0667'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  160F'   CA 14FA'              	JZ	CLAMPE
  1612'   CD 0672'              	CALL	CURCHR		; the first char of what was appended
  1615'   FE 0D                 	CPI	CR
  1617'   CA 14FA'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  161A'   FE 0A                 	CPI	LF
  161C'   CA 14FA'              	JZ	CLAMPE
  161F'   FE 29                 	CPI	')'
  1621'   CA 14FA'              	JZ	CLAMPE		; vim puts no space before a ')'
  1624'   CD 0000*              	CALL	CUROFF
  1627'   7C                    	MOV	A,H
  1628'   B5                    	ORA	L
  1629'   CA 163F'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  162C'   2B                    	DCX	H
  162D'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  1630'   FE 20                 	CPI	' '
  1632'   CA 14FA'              	JZ	CLAMPE
  1635'   FE 09                 	CPI	TAB
  1637'   CA 14FA'              	JZ	CLAMPE
  163A'   FE 0A                 	CPI	LF
  163C'   CA 14FA'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  163F'                         VJ_SP:
  163F'   3E 20                 	MVI	A,' '
  1641'   CD 0000*              	CALL	PUTGAP
  1644'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1647'   2B                    	DCX	H
  1648'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  164B'                         VC_TILD:
  164B'   CD 068B'              	CALL	GETCNT
  164E'   CD 0760'              	CALL	SETLIN		; only this row changes
  1651'   CD 08DA'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1654'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1657'   CA 075A'              	JZ	SETMOV
  165A'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  165D'   FE 0D                 	CPI	CR
  165F'   CA 075A'              	JZ	SETMOV		; the line's end: nothing to toggle
  1662'   FE 0A                 	CPI	LF
  1664'   CA 075A'              	JZ	SETMOV
  1667'   47                    	MOV	B,A
  1668'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  166A'   FE 41                 	CPI	'A'
  166C'   DA 1678'              	JC	VT_PUT		; below 'A': no case
  166F'   FE 5B                 	CPI	'Z'+1
  1671'   D2 1678'              	JNC	VT_PUT		; above 'Z': no case
  1674'   78                    	MOV	A,B
  1675'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1677'   47                    	MOV	B,A
  1678'                         VT_PUT:
  1678'   78                    	MOV	A,B
  1679'   32 2A50'              	STA	VRCH		; the calls below do not preserve B
  167C'   CD 018C'              	CALL	MARKMOD
  167F'   21 0001               	LXI	H,1
  1682'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1685'   3A 2A50'              	LDA	VRCH
  1688'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  168B'   C3 14FA'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  168E'                         VC_R:
  168E'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  1691'   3E 03                 	MVI	A,PR
  1693'   32 2A28'              	STA	GPEND
  1696'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1697'                         VR_DO:
  1697'   AF                    	XRA	A
  1698'   32 2A28'              	STA	GPEND
  169B'   79                    	MOV	A,C
  169C'   32 2A50'              	STA	VRCH		; the calls below do not preserve C
  169F'   CD 0760'              	CALL	SETLIN		; only this row changed
  16A2'   CD 08DA'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  16A5'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  16A8'   CA 075A'              	JZ	SETMOV		; the end of the text: vim does nothing
  16AB'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  16AE'   FE 0D                 	CPI	CR
  16B0'   CA 075A'              	JZ	SETMOV		; the line's end: nothing to replace
  16B3'   FE 0A                 	CPI	LF
  16B5'   CA 075A'              	JZ	SETMOV
  16B8'   CD 018C'              	CALL	MARKMOD
  16BB'   21 0001               	LXI	H,1
  16BE'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  16C1'   3A 2A50'              	LDA	VRCH
  16C4'   FE 0D                 	CPI	CR
  16C6'   CA 16D3'              	JZ	VR_CR
  16C9'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  16CC'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  16CF'   2B                    	DCX	H		;   out, which moves every logical offset
  16D0'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  16D3'                         VR_CR:
  16D3'   CD 157E'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  16D6'   CD 158B'              	CALL	ENDBRK		;   replaced char may have been the text's last
  16D9'   CD 0766'              	CALL	SETILN		;   row above it lost the char that was replaced,
  16DC'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  16DE'   32 2A08'              	STA	ILABOV
  16E1'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  16E2'                         VCB_R:
  16E2'   CD 068B'              	CALL	GETCNT
  16E5'   CD 075A'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  16E8'   21 0000               	LXI	H,0
  16EB'   22 2A51'              	SHLD	RPDEL		; nothing of ours to put back yet
  16EE'   22 2A53'              	SHLD	RPAPP
  16F1'   3E 02                 	MVI	A,EM_REP
  16F3'   32 2A00'              	STA	EDMODE
  16F6'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  16F7'                         VC_D:
  16F7'   3E 64                 	MVI	A,'d'
  16F9'   32 2A2A'              	STA	PENDOP
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  16FC'   C3 075A'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  16FF'                         VC_C:
  16FF'   3E 63                 	MVI	A,'c'
  1701'   32 2A2A'              	STA	PENDOP
  1704'   C3 075A'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1707'                         VD_DD:
  1707'   CD 08DA'              	CALL	GLSTAL
  170A'   CD 068B'              	CALL	GETCNT
  170D'   22 2A43'              	SHLD	CNTV
  1710'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1712'   32 2A2C'              	STA	DDSNG
  1715'   2B                    	DCX	H
  1716'   7C                    	MOV	A,H
  1717'   B5                    	ORA	L
  1718'   C2 1723'              	JNZ	VDD_LS
  171B'   3E 01                 	MVI	A,1
  171D'   32 2A2C'              	STA	DDSNG
  1720'   C3 1729'              	JMP	VDD_GO
  1723'                         VDD_LS:
  1723'   CD 0893'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1726'   DA 075A'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1729'                         VDD_GO:
  1729'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  172C'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  172F'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1732'   CD 20D3'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1735'   CD 0811'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1738'   2A 2A43'              	LHLD	CNTV
  173B'   CD 0000*              	CALL	SETC0
  173E'                         VDD_FW:
  173E'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1741'   DA 188F'              	JC	QREFUS		; ... which has no room for them
  1744'   CD 06A0'              	CALL	CNTTST
  1747'   C2 173E'              	JNZ	VDD_FW
  174A'   CD 018C'              	CALL	MARKMOD
  174D'   CD 0A11'              	CALL	ATEOF
  1750'   D2 176B'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1753'   3E 00                 	MVI	A,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  1755'   32 2A2C'              	STA	DDSNG		; deleted to the end: full repaint
  1758'   CD 0E57'              	CALL	ONFST
  175B'   CA 0828'              	JZ	FNBLNK		; nothing left before it
  175E'   21 0001               	LXI	H,1		; onto the new last line
  1761'   CD 0000*              	CALL	SETBWD
  1764'   2A 0000*              	LHLD	LNDLT
  1767'   2B                    	DCX	H
  1768'   22 0000*              	SHLD	LNDLT
  176B'                         VDD_UP:
  176B'   CD 0828'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  176E'   3A 2A2C'              	LDA	DDSNG
  1771'   B7                    	ORA	A
  1772'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1773'   3E 03                 	MVI	A,R_DLIN
  1775'   32 2A05'              	STA	RINTENT
  1778'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1779'                         QEMPTY:
  1779'   2A 0000*              	LHLD	QBEG
  177C'   EB                    	XCHG
  177D'   2A 0000*              	LHLD	QEND
  1780'   7C                    	MOV	A,H
  1781'   BA                    	CMP	D
  1782'   C0                    	RNZ
  1783'   7D                    	MOV	A,L
  1784'   BB                    	CMP	E
  1785'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1786'                         VC_Y:
  1786'   3E 79                 	MVI	A,'y'
  1788'   32 2A2A'              	STA	PENDOP
  178B'   C3 075A'              	JMP	SETMOV
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  178E'                         VY_YY:
  178E'   21 2A33'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1791'   CD 044F'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1794'   CD 0000*              	CALL	CUROFF
  1797'   22 2A74'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  179A'   CD 05E4'              	CALL	BOL
  179D'   22 2A76'              	SHLD	YPT		; where the lines come from, to put them back
  17A0'   CD 18F5'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  17A3'   CD 1938'              	CALL	YNCOPY		; copied where they lie, if that can be done
  17A6'   D2 18FC'              	JNC	YNDONE
  17A9'   21 1707'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  17AC'   C3 17D8'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  17AF'                         OPYANK:
  17AF'   CD 140F'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  17B2'   2A 2A2F'              	LHLD	OPSTA
  17B5'   EB                    	XCHG			; DE = start
  17B6'   2A 2A31'              	LHLD	OPEND2		; HL = end
  17B9'   CD 0000*              	CALL	CMP16		; CY iff start < end
  17BC'   D2 17C0'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  17BF'   EB                    	XCHG			; ... otherwise the start is
  17C0'                         OPY_LO:
  17C0'   22 2A74'              	SHLD	YOFF
  17C3'   2A 2A3F'              	LHLD	OPLO
  17C6'   22 2A76'              	SHLD	YPT		; where the lines come from, to put them back
  17C9'   CD 18F5'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  17CC'   CD 19B0'              	CALL	YNSPAN		; copied where they lie, if there is room
  17CF'   D2 18FC'              	JNC	YNDONE
  17D2'   21 18B6'              	LXI	H,YSPAN
  17D5'   C3 17D8'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  17D8'                         YKGO:
  17D8'   22 2A9D'              	SHLD	YACT
  17DB'   2A 2A76'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  17DE'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  17DF'   2A 2A74'              	LHLD	YOFF		;   survive this -- the put-back below can page
  17E2'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  17E5'   22 2AA3'              	SHLD	YCOL		;   them -- but a distance within the lines does
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  17E8'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  17EB'   E5                    	PUSH	H		;   pages the window on when the count's lines
  17EC'   2A 2A76'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  17EF'   EB                    	XCHG			;   window as it was, then names other text
  17F0'   E1                    	POP	H
  17F1'   CD 0000*              	CALL	SUBHD
  17F4'   EB                    	XCHG			; DE = how far behind the cursor they start
  17F5'   CD 0F24'              	CALL	CURFP
  17F8'   06 00                 	MVI	B,0
  17FA'   CD 0F1A'              	CALL	SUB24
  17FD'   22 2AA5'              	SHLD	YPFP
  1800'   32 2AA7'              	STA	YPFP+2
  1803'   3A 2A04'              	LDA	MODF
  1806'   32 2A71'              	STA	YMODF
  1809'   3A 2A1D'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  180C'   32 2A72'              	STA	YDCHG		;   a yank must not become the last change
  180F'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1812'   32 2A73'              	STA	YURPL		;   back are not a change to undo either
  1815'   3E 01                 	MVI	A,1
  1817'   32 0000*              	STA	UNDRPL
  181A'   32 2A9C'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  181D'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1820'   22 2A7F'              	SHLD	YLDLT
  1823'   CD 0000*              	CALL	LOGLEN
  1826'   22 2AA1'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1829'   2A 2A9D'              	LHLD	YACT
  182C'   CD 188E'              	CALL	YCALL		; the lines out of the file, into the register
  182F'   3A 2A6C'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1832'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1834'   CA 1872'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1837'   CD 0000*              	CALL	LOGLEN
  183A'   EB                    	XCHG
  183B'   2A 2AA1'              	LHLD	YWAS
  183E'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1841'   CA 1853'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1844'   21 2AA5'              	LXI	H,YPFP		; back to where they came from, by its place in
  1847'   CD 0402'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  184A'   CD 03CF'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  184D'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1850'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1853'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1853'   2A 2AA5'              	LHLD	YPFP		;   cursor is still owed its place)
  1856'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  1857'   2A 2AA3'              	LHLD	YCOL
  185A'   19                    	DAD	D
  185B'   22 2A98'              	SHLD	MKPOS
  185E'   3A 2AA7'              	LDA	YPFP+2
  1861'   CE 00                 	ACI	0
  1863'   32 2A9A'              	STA	MKPOS+2
  1866'   CD 03CF'              	CALL	MKPAGE
  1869'   CD 0000*              	CALL	GOTO
  186C'                         YK_RST:
  186C'   2A 2A7F'              	LHLD	YLDLT
  186F'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1872'                         YK_RF:
  1872'   3A 2A71'              	LDA	YMODF
  1875'   32 2A04'              	STA	MODF
  1878'   3A 2A72'              	LDA	YDCHG
  187B'   32 2A1D'              	STA	DOTCHG
  187E'   3A 2A73'              	LDA	YURPL
  1881'   32 0000*              	STA	UNDRPL
  1884'   AF                    	XRA	A
  1885'   32 2A9C'              	STA	MKHOLD
  1888'   CD 08DA'              	CALL	GLSTAL
  188B'   C3 077B'              	JMP	SETFUL		; the cheap paint cannot carry this
  188E'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  188F'                         QREFUS:
  188F'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1892'   CD 1779'              	CALL	QEMPTY
  1895'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1898'   CD 0000*              	CALL	QKILL
  189B'   3A 2A9C'              	LDA	MKHOLD
  189E'   B7                    	ORA	A
  189F'   C2 18AE'              	JNZ	QRF_Y
  18A2'   21 0000*              	LXI	H,MKSAV
  18A5'   11 0000*              	LXI	D,MKTAB
  18A8'   CD 20D3'              	CALL	COPY12
  18AB'   CD 0000*              	CALL	UNDCLR
  18AE'                         QRF_Y:
  18AE'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  18B0'   32 2A6C'              	STA	MSGWHT
  18B3'   C3 1249'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  18B6'                         YSPAN:
  18B6'   CD 08DA'              	CALL	GLSTAL
  18B9'   CD 13D0'              	CALL	OPSPNL		; HL = the span's length
  18BC'   22 2A9F'              	SHLD	YTGT
  18BF'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  18C2'   EB                    	XCHG			; DE = it
  18C3'   2A 2A9F'              	LHLD	YTGT
  18C6'   EB                    	XCHG			; HL = the text's, DE = the span's
  18C7'   CD 0000*              	CALL	SUBHD
  18CA'   22 2A9F'              	SHLD	YTGT		; what the text is left at when the span is out
  18CD'   2A 2A3F'              	LHLD	OPLO
  18D0'   CD 0000*              	CALL	GOTO
  18D3'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  18D6'                         YS_LP:
  18D6'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  18D9'   CD 0000*              	CALL	SETC0
  18DC'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  18DF'   DA 188F'              	JC	QREFUS		; ... which has no room for it
  18E2'   CD 0000*              	CALL	LOGLEN
  18E5'   EB                    	XCHG			; DE = what is left
  18E6'   2A 2A9F'              	LHLD	YTGT
  18E9'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  18EC'   DA 18F2'              	JC	YS_END		; below it -- cannot happen over whole lines,
  18EF'   C2 18D6'              	JNZ	YS_LP		;   but never spin here if it ever did
  18F2'                         YS_END:
  18F2'   C3 018C'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  18F5'                         YNPRE:
  18F5'   2A 0000*              	LHLD	PGTOPM
  18F8'   22 2AA8'              	SHLD	YNPG
  18FB'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  18FC'                         YNDONE:
  18FC'   2A 2A74'              	LHLD	YOFF
  18FF'   CD 0000*              	CALL	GOTO
  1902'   2A 0000*              	LHLD	PGTOPM
  1905'   EB                    	XCHG
  1906'   2A 2AA8'              	LHLD	YNPG
  1909'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  190C'   C2 077B'              	JNZ	SETFUL		; it moved under us: repaint after all
  190F'   C3 075A'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1912'                         YNROOM:
  1912'   11 0100               	LXI	D,100H
  1915'   19                    	DAD	D
  1916'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1917'   E5                    	PUSH	H		; the span plus its slack
  1918'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  191B'   EB                    	XCHG			; HL = free
  191C'   D1                    	POP	D		; DE = the span plus its slack
  191D'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1920'   DA 1928'              	JC	YNR_OK
  1923'   CA 1928'              	JZ	YNR_OK
  1926'   37                    	STC			; not enough: the delete-and-put-back path
  1927'   C9                    	RET
  1928'                         YNR_OK:
  1928'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1929'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  192A'                         YNGO:
  192A'   C5                    	PUSH	B
  192B'   CD 068B'              	CALL	GETCNT		; spent here: this yank is happening
  192E'   CD 08DA'              	CALL	GLSTAL
  1931'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  1934'   C1                    	POP	B
  1935'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1938'                         YNCOPY:
  1938'   2A 2A01'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  193B'   7C                    	MOV	A,H		;   the count itself
  193C'   B5                    	ORA	L
  193D'   C2 1943'              	JNZ	YNC_HV
  1940'   21 0001               	LXI	H,1
  1943'                         YNC_HV:
  1943'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1944'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1945'   B4                    	ORA	H
  1946'   CA 1951'              	JZ	YNC_M
  1949'   E5                    	PUSH	H
  194A'   CD 0893'              	CALL	ONLAST		; vim: a count over one on the last line does
  194D'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  194E'   DA 1963'              	JC	YNC_RF
  1951'                         YNC_M:
  1951'   E5                    	PUSH	H
  1952'   CD 0811'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1955'   E1                    	POP	H
  1956'   CD 196B'              	CALL	YNLINE		; BC = the span, measured where it stands
  1959'   D8                    	RC			; not measurable here: let the pager answer it
  195A'   60                    	MOV	H,B
  195B'   69                    	MOV	L,C
  195C'   CD 1912'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  195F'   D8                    	RC			; no: the delete-and-put-back path
  1960'   C3 192A'              	JMP	YNGO
  1963'                         YNC_RF:
  1963'   CD 068B'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1966'   CD 08DA'              	CALL	GLSTAL		;   register alone, and that is the command
  1969'   B7                    	ORA	A		; NC: done
  196A'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  196B'                         YNLINE:
  196B'   22 2AAA'              	SHLD	YNCNT		; the lines it still wants
  196E'   2A 0000*              	LHLD	GAPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  1971'                         YNL_LP:
  1971'   EB                    	XCHG			; DE = the scan
  1972'   2A 0000*              	LHLD	TXTEND
  1975'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1978'   EB                    	XCHG			; HL = the scan
  1979'   D2 1999'              	JNC	YNL_EN		; the resident text ran out
  197C'   7E                    	MOV	A,M
  197D'   23                    	INX	H
  197E'   FE 0A                 	CPI	LF
  1980'   C2 1971'              	JNZ	YNL_LP
  1983'   E5                    	PUSH	H
  1984'   2A 2AAA'              	LHLD	YNCNT
  1987'   2B                    	DCX	H
  1988'   22 2AAA'              	SHLD	YNCNT
  198B'   7C                    	MOV	A,H
  198C'   B5                    	ORA	L
  198D'   E1                    	POP	H
  198E'   C2 1971'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1991'   EB                    	XCHG			; DE = past the last of them
  1992'   2A 0000*              	LHLD	GAPEND
  1995'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1996'   C3 19A7'              	JMP	YNL_BC
  1999'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1999'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  199C'   C2 19AE'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  199F'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  19A2'   EB                    	XCHG			;   count clamps to it as vim's does
  19A3'   2A 0000*              	LHLD	GAPEND
  19A6'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  19A7'                         YNL_BC:
  19A7'   CD 0000*              	CALL	SUBHD		; HL = the span
  19AA'   44                    	MOV	B,H
  19AB'   4D                    	MOV	C,L
  19AC'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  19AD'   C9                    	RET
  19AE'                         YNL_NO:
  19AE'   37                    	STC
  19AF'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  19B0'                         YNSPAN:
  19B0'   CD 13D0'              	CALL	OPSPNL		; HL = the span's length
  19B3'   44                    	MOV	B,H
  19B4'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  19B5'   CD 1912'              	CALL	YNROOM
  19B8'   D8                    	RC			; no room: the delete-and-put-back path
  19B9'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  19BA'   2A 2A3F'              	LHLD	OPLO
  19BD'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  19C0'   C1                    	POP	B
  19C1'   C3 192A'              	JMP	YNGO
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  19C4'                         VC_P:
  19C4'   CD 1779'              	CALL	QEMPTY
  19C7'   CA 1A7F'              	JZ	VP_BEL
  19CA'   CD 068B'              	CALL	GETCNT
  19CD'   22 2A78'              	SHLD	PCNT
  19D0'   CD 0000*              	CALL	CUROFF
  19D3'   CD 0614'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  19D6'   C3 19EB'              	JMP	VP_GO
  19D9'                         VCB_P:
  19D9'   CD 1779'              	CALL	QEMPTY
  19DC'   CA 1A7F'              	JZ	VP_BEL
  19DF'   CD 068B'              	CALL	GETCNT
  19E2'   22 2A78'              	SHLD	PCNT
  19E5'   CD 0000*              	CALL	CUROFF
  19E8'   CD 05E4'              	CALL	BOL
  19EB'                         VP_GO:
  19EB'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  19EE'   CD 0000*              	CALL	CUROFF
  19F1'   EB                    	XCHG
  19F2'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  19F5'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  19F8'   DA 1A0D'              	JC	VP_IN
  19FB'   EB                    	XCHG			; HL = the put point = LOGLEN
  19FC'   7C                    	MOV	A,H
  19FD'   B5                    	ORA	L
  19FE'   CA 1A0A'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1A01'   2B                    	DCX	H
  1A02'   CD 0000*              	CALL	CHARAT
  1A05'   FE 0A                 	CPI	LF
  1A07'   CA 1A0D'              	JZ	VP_IN
  1A0A'                         VP_BRK:
  1A0A'   CD 157E'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1A0D'                         VP_IN:
  1A0D'   CD 0000*              	CALL	CUROFF
  1A10'   22 2A7A'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1A13'   2A 0000*              	LHLD	QBEG
  1A16'   EB                    	XCHG
  1A17'   2A 0000*              	LHLD	QEND
  1A1A'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1A1D'   EB                    	XCHG
  1A1E'   22 2A7C'              	SHLD	PLFS
  1A21'   2A 2A78'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1A24'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1A25'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1A26'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A28'   C2 1A2C'              	JNZ	VP_PZ
  1A2B'   7D                    	MOV	A,L
  1A2C'                         VP_PZ:
  1A2C'   32 2A7E'              	STA	PCPY
  1A2F'                         VP_LP:
  1A2F'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1A32'   2A 0000*              	LHLD	LNDLT
  1A35'   EB                    	XCHG
  1A36'   2A 2A7C'              	LHLD	PLFS
  1A39'   19                    	DAD	D
  1A3A'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1A3D'   2A 2A78'              	LHLD	PCNT
  1A40'   2B                    	DCX	H
  1A41'   22 2A78'              	SHLD	PCNT
  1A44'   7C                    	MOV	A,H
  1A45'   B5                    	ORA	L
  1A46'   C2 1A2F'              	JNZ	VP_LP
  1A49'   CD 018C'              	CALL	MARKMOD
  1A4C'   2A 2A7A'              	LHLD	PPT
  1A4F'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1A52'   CD 08DA'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1A55'   3A 2A7E'              	LDA	PCPY
  1A58'   B7                    	ORA	A
  1A59'   CA 0828'              	JZ	FNBLNK
  1A5C'   2A 2A7C'              	LHLD	PLFS
  1A5F'   7C                    	MOV	A,H
  1A60'   B7                    	ORA	A
  1A61'   C2 0828'              	JNZ	FNBLNK
  1A64'   3A 2A7E'              	LDA	PCPY
  1A67'   CD 0DED'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1A6A'   7C                    	MOV	A,H
  1A6B'   B7                    	ORA	A
  1A6C'   C2 0828'              	JNZ	FNBLNK
  1A6F'   7D                    	MOV	A,L
  1A70'   B7                    	ORA	A
  1A71'   CA 0828'              	JZ	FNBLNK
  1A74'   F5                    	PUSH	PSW
  1A75'   CD 0766'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1A78'   F1                    	POP	PSW
  1A79'   32 2A06'              	STA	ILN		; ... which the lines put now replace
  1A7C'   C3 0828'              	JMP	FNBLNK
  1A7F'                         VP_BEL:
  1A7F'   CD 068B'              	CALL	GETCNT		; the count is spent either way
  1A82'   0E 07                 	MVI	C,BEL
  1A84'   CD 0000*              	CALL	BCONOU
  1A87'   C3 075A'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  1A8A'                         VIREP:
  1A8A'   78                    	MOV	A,B
  1A8B'   FE 01                 	CPI	KT_ACT
  1A8D'   CA 1BBA'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  1A90'   FE 02                 	CPI	KT_CHAR
  1A92'   C0                    	RNZ			; ignore anything else
  1A93'   79                    	MOV	A,C
  1A94'   FE 0D                 	CPI	CR
  1A96'   CA 1AFA'              	JZ	VP_CR
  1A99'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1A9B'   CA 1AFA'              	JZ	VP_CR
  1A9E'   FE 08                 	CPI	BS
  1AA0'   CA 1B06'              	JZ	VP_BS
  1AA3'   FE 7F                 	CPI	DEL
  1AA5'   CA 1B06'              	JZ	VP_BS
  1AA8'   32 2A50'              	STA	VRCH		; the calls below do not preserve C
  1AAB'   CD 0760'              	CALL	SETLIN		; this row changed
  1AAE'   CD 018C'              	CALL	MARKMOD
  1AB1'   CD 1571'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1AB4'   CA 1AEC'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1AB7'   3A 2A50'              	LDA	VRCH
  1ABA'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1ABD'   2A 2A51'              	LHLD	RPDEL
  1AC0'   7C                    	MOV	A,H
  1AC1'   B5                    	ORA	L
  1AC2'   CA 1AD8'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1AC5'   2A 0000*              	LHLD	GAPEND
  1AC8'   EB                    	XCHG
  1AC9'   2A 2A55'              	LHLD	RPGE
  1ACC'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1ACF'   CA 1AD8'              	JZ	VP_OVW
  1AD2'   21 0000               	LXI	H,0
  1AD5'   22 2A51'              	SHLD	RPDEL		; the text moved: those originals are gone
  1AD8'                         VP_OVW:
  1AD8'   21 0001               	LXI	H,1
  1ADB'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1ADE'   2A 0000*              	LHLD	GAPEND
  1AE1'   22 2A55'              	SHLD	RPGE
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1AE4'   2A 2A51'              	LHLD	RPDEL
  1AE7'   23                    	INX	H
  1AE8'   22 2A51'              	SHLD	RPDEL
  1AEB'   C9                    	RET
  1AEC'                         VP_APP:
  1AEC'   3A 2A50'              	LDA	VRCH
  1AEF'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1AF2'   2A 2A53'              	LHLD	RPAPP
  1AF5'   23                    	INX	H
  1AF6'   22 2A53'              	SHLD	RPAPP
  1AF9'   C9                    	RET
  1AFA'                         VP_CR:
  1AFA'   21 0000               	LXI	H,0
  1AFD'   22 2A51'              	SHLD	RPDEL		; a line break ends what BS can put back
  1B00'   22 2A53'              	SHLD	RPAPP
  1B03'   C3 1B90'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1B06'                         VP_BS:
  1B06'   2A 2A53'              	LHLD	RPAPP
  1B09'   7C                    	MOV	A,H
  1B0A'   B5                    	ORA	L
  1B0B'   CA 1B18'              	JZ	VP_BSD
  1B0E'   2B                    	DCX	H
  1B0F'   22 2A53'              	SHLD	RPAPP		; an appended char: it just goes
  1B12'   CD 0760'              	CALL	SETLIN
  1B15'   C3 0000*              	JMP	DELPRV
  1B18'                         VP_BSD:
  1B18'   2A 2A51'              	LHLD	RPDEL
  1B1B'   7C                    	MOV	A,H
  1B1C'   B5                    	ORA	L
  1B1D'   CA 1B44'              	JZ	VP_BSM		; nothing of ours left
  1B20'   2A 0000*              	LHLD	GAPEND
  1B23'   EB                    	XCHG
  1B24'   2A 2A55'              	LHLD	RPGE
  1B27'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1B2A'   C2 1B44'              	JNZ	VP_BSM
  1B2D'   2A 2A51'              	LHLD	RPDEL
  1B30'   2B                    	DCX	H
  1B31'   22 2A51'              	SHLD	RPDEL
  1B34'   CD 0760'              	CALL	SETLIN
  1B37'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1B3A'   CD 0000*              	CALL	UNDELF		; the original comes back
  1B3D'   2A 0000*              	LHLD	GAPEND
  1B40'   22 2A55'              	SHLD	RPGE
  1B43'   C9                    	RET
  1B44'                         VP_BSM:
  1B44'   CD 075A'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1B47'   C3 07C9'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  1B4A'                         VIINS:
  1B4A'   78                    	MOV	A,B
  1B4B'   FE 01                 	CPI	KT_ACT
  1B4D'   CA 1BBA'              	JZ	VI_ACT
  1B50'   FE 02                 	CPI	KT_CHAR
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1B52'   C0                    	RNZ			; ignore anything else
  1B53'   79                    	MOV	A,C
  1B54'   FE 0D                 	CPI	CR
  1B56'   CA 1B90'              	JZ	VI_CR
  1B59'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1B5B'   CA 1B90'              	JZ	VI_CR
  1B5E'   FE 08                 	CPI	BS
  1B60'   CA 1BA8'              	JZ	VI_BS
  1B63'   FE 7F                 	CPI	DEL
  1B65'   CA 1BA8'              	JZ	VI_BS
  1B68'   79                    	MOV	A,C
  1B69'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1B6C'   CD 018C'              	CALL	MARKMOD
  1B6F'   CD 0760'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1B72'   79                    	MOV	A,C
  1B73'   FE 20                 	CPI	' '
  1B75'   D8                    	RC			; control char -> keep R_LINE
  1B76'   FE 7F                 	CPI	DEL
  1B78'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1B79'   CD 0781'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1B7C'   B7                    	ORA	A
  1B7D'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1B7E'   3E 04                 	MVI	A,R_ICH
  1B80'   32 2A05'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1B83'   CD 1571'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1B86'   3E 00                 	MVI	A,0
  1B88'   C2 1B8C'              	JNZ	VI_ICH
  1B8B'   3C                    	INR	A
  1B8C'                         VI_ICH:
  1B8C'   32 2A07'              	STA	ICHAPP
  1B8F'   C9                    	RET
  1B90'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1B90'   CD 1571'              	CALL	ATCEND
  1B93'   3E 00                 	MVI	A,0
  1B95'   CA 1B99'              	JZ	VI_CRS
  1B98'   3C                    	INR	A
  1B99'                         VI_CRS:
  1B99'   F5                    	PUSH	PSW
  1B9A'   CD 157E'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1B9D'   CD 158B'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1BA0'   CD 0766'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1BA3'   F1                    	POP	PSW
  1BA4'   32 2A08'              	STA	ILABOV
  1BA7'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1BA8'                         VI_BS:
  1BA8'   CD 0000*              	CALL	PEEKL
  1BAB'   D8                    	RC			; start of the file: nothing to delete
  1BAC'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1BAE'   CA 1BB4'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1BB1'   CD 0760'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1BB4'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1BB4'   CD 018C'              	CALL	MARKMOD
  1BB7'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1BBA'                         VI_ACT:
  1BBA'   79                    	MOV	A,C
  1BBB'   FE 0B                 	CPI	ACT_ESC
  1BBD'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  1BBE'   3E 00                 	MVI	A,EM_CMD
  1BC0'   32 2A00'              	STA	EDMODE
  1BC3'   CD 075A'              	CALL	SETMOV
  1BC6'   CD 07C9'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1BC9'   C3 08DA'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1BCC'                         RDLINE:
  1BCC'   EB                    	XCHG			; HL = buffer
  1BCD'   22 2A57'              	SHLD	RLPTR
  1BD0'   3E 00                 	MVI	A,0
  1BD2'   32 2A59'              	STA	RLLEN
  1BD5'   78                    	MOV	A,B
  1BD6'   32 2A5A'              	STA	RLMAX
  1BD9'   79                    	MOV	A,C
  1BDA'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1BDD'                         RL_LP:
  1BDD'   CD 0000*              	CALL	GETKEY
  1BE0'   78                    	MOV	A,B
  1BE1'   FE 01                 	CPI	KT_ACT
  1BE3'   CA 1C39'              	JZ	RL_ACT
  1BE6'   FE 02                 	CPI	KT_CHAR
  1BE8'   C2 1BDD'              	JNZ	RL_LP		; ignore other keys
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1BEB'   79                    	MOV	A,C
  1BEC'   FE 0D                 	CPI	CR
  1BEE'   CA 1C4A'              	JZ	RL_DONE
  1BF1'   FE 08                 	CPI	BS
  1BF3'   CA 1C21'              	JZ	RL_BS
  1BF6'   FE 7F                 	CPI	DEL
  1BF8'   CA 1C21'              	JZ	RL_BS
  1BFB'   FE 20                 	CPI	' '
  1BFD'   DA 1BDD'              	JC	RL_LP		; control char -> ignore
  1C00'   3A 2A59'              	LDA	RLLEN
  1C03'   47                    	MOV	B,A
  1C04'   3A 2A5A'              	LDA	RLMAX
  1C07'   B8                    	CMP	B
  1C08'   CA 1BDD'              	JZ	RL_LP		; full -> ignore
  1C0B'   2A 2A57'              	LHLD	RLPTR
  1C0E'   71                    	MOV	M,C
  1C0F'   23                    	INX	H
  1C10'   22 2A57'              	SHLD	RLPTR
  1C13'   3A 2A59'              	LDA	RLLEN
  1C16'   3C                    	INR	A
  1C17'   32 2A59'              	STA	RLLEN
  1C1A'   79                    	MOV	A,C
  1C1B'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1C1E'   C3 1BDD'              	JMP	RL_LP
  1C21'                         RL_BS:				; WM LINEPOP
  1C21'   3A 2A59'              	LDA	RLLEN
  1C24'   B7                    	ORA	A
  1C25'   CA 1C3F'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1C28'   3D                    	DCR	A
  1C29'   32 2A59'              	STA	RLLEN
  1C2C'   2A 2A57'              	LHLD	RLPTR
  1C2F'   2B                    	DCX	H
  1C30'   22 2A57'              	SHLD	RLPTR
  1C33'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1C36'   C3 1BDD'              	JMP	RL_LP
  1C39'                         RL_ACT:
  1C39'   79                    	MOV	A,C
  1C3A'   FE 0B                 	CPI	ACT_ESC
  1C3C'   C2 1BDD'              	JNZ	RL_LP
  1C3F'                         RL_CAN:
  1C3F'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1C41'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1C44'   CD 0760'              	CALL	SETLIN		; redraw one row
  1C47'   3E FF                 	MVI	A,0FFH		; cancelled
  1C49'   C9                    	RET
  1C4A'                         RL_DONE:
  1C4A'   AF                    	XRA	A
  1C4B'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1C4C'                         VC_BZ:
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1C4C'   CD 075A'              	CALL	SETMOV
  1C4F'   3A 2A29'              	LDA	GSAVE
  1C52'   FE 02                 	CPI	PZ
  1C54'   CA 1C5F'              	JZ	VZ_ZZ
  1C57'   B7                    	ORA	A
  1C58'   C0                    	RNZ			; 'g' was pending: vim drops both
  1C59'   3E 02                 	MVI	A,PZ
  1C5B'   32 2A28'              	STA	GPEND
  1C5E'   C9                    	RET
  1C5F'                         VZ_ZZ:
  1C5F'   3E 04                 	MVI	A,EO_X
  1C61'   32 2A5B'              	STA	EXOP
  1C64'   3E 01                 	MVI	A,1
  1C66'   32 2A6E'              	STA	EXBANG		; no '!'
  1C69'   AF                    	XRA	A
  1C6A'   32 2A5C'              	STA	EXARG		; no file name
  1C6D'   3A 2A04'              	LDA	MODF		; as ':x': a changed text is written first
  1C70'   B7                    	ORA	A
  1C71'   CA 1DB2'              	JZ	EX_Q
  1C74'   C3 1D4C'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1C77'                         VC_EX:
  1C77'   CD 068B'              	CALL	GETCNT
  1C7A'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1C7D'   11 0000*              	LXI	D,EXBUF
  1C80'   06 28                 	MVI	B,EXMAX
  1C82'   0E 3A                 	MVI	C,':'
  1C84'   CD 1BCC'              	CALL	RDLINE
  1C87'   B7                    	ORA	A
  1C88'   C0                    	RNZ			; cancelled
  1C89'   3A 2A59'              	LDA	RLLEN
  1C8C'   5F                    	MOV	E,A
  1C8D'   16 00                 	MVI	D,0
  1C8F'   21 0000*              	LXI	H,EXBUF
  1C92'   19                    	DAD	D
  1C93'   36 00                 	MVI	M,0		; the line ends with a 0
  1C95'   21 0000*              	LXI	H,EXBUF
  1C98'   CD 2268'              	CALL	SKIPB
  1C9B'   C8                    	RZ			; nothing on it
  1C9C'   22 2A5E'              	SHLD	EXCMD
  1C9F'   CD 245C'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1CA2'   CD 2268'              	CALL	SKIPB		; blanks between the range and the command name
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1CA5'   56                    	MOV	D,M
  1CA6'   23                    	INX	H
  1CA7'   1E 00                 	MVI	E,0
  1CA9'   CD 2274'              	CALL	ISLOW
  1CAC'   DA 1CB7'              	JC	EX_LK
  1CAF'   5F                    	MOV	E,A
  1CB0'   23                    	INX	H
  1CB1'   CD 2274'              	CALL	ISLOW
  1CB4'   D2 1CD0'              	JNC	EX_NOT		; a third letter: none of ours
  1CB7'                         EX_LK:
  1CB7'   E5                    	PUSH	H
  1CB8'   21 2443'              	LXI	H,EXTAB
  1CBB'                         EX_TL:
  1CBB'   7E                    	MOV	A,M
  1CBC'   B7                    	ORA	A
  1CBD'   CA 1CCF'              	JZ	EX_NTP		; not in the table
  1CC0'   23                    	INX	H
  1CC1'   BA                    	CMP	D
  1CC2'   7E                    	MOV	A,M
  1CC3'   23                    	INX	H
  1CC4'   C2 1CCB'              	JNZ	EX_TN
  1CC7'   BB                    	CMP	E
  1CC8'   CA 1CD6'              	JZ	EX_TF
  1CCB'                         EX_TN:
  1CCB'   23                    	INX	H
  1CCC'   C3 1CBB'              	JMP	EX_TL
  1CCF'                         EX_NTP:
  1CCF'   E1                    	POP	H
  1CD0'                         EX_NOT:
  1CD0'   21 232C'              	LXI	H,SNOT
  1CD3'   C3 22A9'              	JMP	EXERT
  1CD6'                         EX_TF:
  1CD6'   7E                    	MOV	A,M
  1CD7'   32 2A5B'              	STA	EXOP
  1CDA'   E1                    	POP	H
  1CDB'   FE 06                 	CPI	EO_S
  1CDD'   CA 24CB'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1CE0'   FE 01                 	CPI	EO_W
  1CE2'   CA 1CF1'              	JZ	EX_RG		; ':N,Mw name' takes a range
  1CE5'   FE 08                 	CPI	EO_R
  1CE7'   CA 1CF1'              	JZ	EX_RG		; ... and ':Nr name' a line
  1CEA'   3A 2AB6'              	LDA	SRNGF
  1CED'   B7                    	ORA	A
  1CEE'   C2 1CD0'              	JNZ	EX_NOT		; a range on a command that does not take one
  1CF1'                         EX_RG:
                                	;--- '!', then the file name ---
  1CF1'   7E                    	MOV	A,M
  1CF2'   D6 21                 	SUI	'!'
  1CF4'   32 2A6E'              	STA	EXBANG		; 0 = '!'
  1CF7'   C2 1CFB'              	JNZ	EX_NB
  1CFA'   23                    	INX	H
  1CFB'                         EX_NB:
  1CFB'   CD 2268'              	CALL	SKIPB
  1CFE'   32 2A5C'              	STA	EXARG		; 0 = no file name
  1D01'   CA 1D1A'              	JZ	EX_RUN
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1D04'   22 2A5E'              	SHLD	EXCMD
  1D07'   3A 2A5B'              	LDA	EXOP
  1D0A'   FE 02                 	CPI	EO_Q
  1D0C'   CA 22A6'              	JZ	EX_TRL		; :q takes none
  1D0F'   FE 07                 	CPI	EO_V
  1D11'   CA 22A6'              	JZ	EX_TRL		; nor :ve
  1D14'   CD 21D2'              	CALL	PARSFN
  1D17'   C2 229A'              	JNZ	EX_INV
  1D1A'                         EX_RUN:
  1D1A'   3A 2A5B'              	LDA	EXOP
  1D1D'   FE 05                 	CPI	EO_E
  1D1F'   CA 1DC9'              	JZ	EX_E
  1D22'   FE 02                 	CPI	EO_Q
  1D24'   CA 1DB2'              	JZ	EX_Q
  1D27'   FE 07                 	CPI	EO_V
  1D29'   CA 22A0'              	JZ	EX_V
  1D2C'   FE 08                 	CPI	EO_R
  1D2E'   CA 1F5A'              	JZ	EX_R
  1D31'   FE 04                 	CPI	EO_X
  1D33'   CA 1D45'              	JZ	EX_XM
  1D36'   FE 01                 	CPI	EO_W
  1D38'   C2 1D4C'              	JNZ	EX_W		; :wq
  1D3B'   3A 2AB6'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  1D3E'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  1D3F'   C2 1E7A'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  1D42'   C3 1D4C'              	JMP	EX_W
  1D45'                         EX_XM:
  1D45'   3A 2A04'              	LDA	MODF		; :x writes only a changed text
  1D48'   B7                    	ORA	A
  1D49'   CA 1DB2'              	JZ	EX_Q
  1D4C'                         EX_W:
  1D4C'   CD 203A'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1D4F'   D8                    	RC			; refused (message shown)
  1D50'   32 2A5D'              	STA	EXBAK
  1D53'   3A 2A5B'              	LDA	EXOP
  1D56'   FE 01                 	CPI	EO_W
  1D58'   CA 1D6F'              	JZ	EX_WK
  1D5B'   3A 2A5D'              	LDA	EXBAK
  1D5E'   B7                    	ORA	A
  1D5F'   C2 1DAF'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1D62'   3A 2A6E'              	LDA	EXBANG
  1D65'   B7                    	ORA	A
  1D66'   CA 1DAF'              	JZ	EX_WQ		; so it does with '!'
  1D69'   CD 1D6F'              	CALL	EX_WK		; else it may not: keep the text
  1D6C'   C3 1DB2'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1D6F'                         EX_WK:
  1D6F'   CD 0CF9'              	CALL	CURRW		; the cursor's row and file position
  1D72'   32 2A60'              	STA	WPROW
  1D75'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1D78'   7D                    	MOV	A,L
  1D79'   E6 7F                 	ANI	7FH
  1D7B'   32 2A61'              	STA	WPBYT
  1D7E'   7D                    	MOV	A,L
  1D7F'   17                    	RAL
  1D80'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1D81'   17                    	RAL
  1D82'   5F                    	MOV	E,A
  1D83'   3E 00                 	MVI	A,0
  1D85'   17                    	RAL
  1D86'   57                    	MOV	D,A		; DE = HL / 128
  1D87'   2A 0000*              	LHLD	OUTPOS
  1D8A'   19                    	DAD	D
  1D8B'   22 2A62'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1D8E'   CD 206F'              	CALL	WRITE
  1D91'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1D94'   2A 2A62'              	LHLD	WPREC
  1D97'   EB                    	XCHG
  1D98'   3A 2A61'              	LDA	WPBYT
  1D9B'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1D9E'   CD 0000*              	CALL	GOTO
  1DA1'                         EX_WRW:
  1DA1'   21 0000               	LXI	H,0
  1DA4'   22 0000*              	SHLD	LNDLT
  1DA7'   3A 2A60'              	LDA	WPROW
  1DAA'   6F                    	MOV	L,A
  1DAB'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1DAE'   C9                    	RET
  1DAF'                         EX_WQ:
  1DAF'   CD 206F'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1DB2'                         EX_Q:
  1DB2'   3A 2A6E'              	LDA	EXBANG
  1DB5'   B7                    	ORA	A
  1DB6'   CA 1DC0'              	JZ	EX_QT
  1DB9'   3A 2A04'              	LDA	MODF
  1DBC'   B7                    	ORA	A
  1DBD'   C2 228E'              	JNZ	MSGNWR		; changed, no '!': stay
  1DC0'                         EX_QT:
  1DC0'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1DC3'   3E 01                 	MVI	A,1
  1DC5'   32 2A03'              	STA	QUITF
  1DC8'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1DC9'                         EX_E:
  1DC9'   3A 2A6E'              	LDA	EXBANG
  1DCC'   B7                    	ORA	A
  1DCD'   CA 1DD7'              	JZ	EE_GO
  1DD0'   3A 2A04'              	LDA	MODF
  1DD3'   B7                    	ORA	A
  1DD4'   C2 228E'              	JNZ	MSGNWR
  1DD7'                         EE_GO:
  1DD7'   3A 2A5C'              	LDA	EXARG
  1DDA'   B7                    	ORA	A
  1DDB'   C2 1DE2'              	JNZ	EE_ARG
  1DDE'   CD 20AB'              	CALL	OWNTF		; no name: the buffer's own
  1DE1'   D8                    	RC
  1DE2'                         EE_ARG:
  1DE2'   CD 20C1'              	CALL	ISOWN
  1DE5'   21 0001               	LXI	H,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1DE8'   C2 1DEF'              	JNZ	EE_LD		; another file: its first line
  1DEB'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1DEE'   23                    	INX	H		; HL = the cursor's line
  1DEF'                         EE_LD:
  1DEF'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1DF1'   32 2A6C'              	STA	MSGWHT
  1DF4'   E5                    	PUSH	H
  1DF5'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1DF8'   21 0000*              	LXI	H,TFCB
  1DFB'   11 0000*              	LXI	D,FNAME
  1DFE'   CD 20D3'              	CALL	COPY12		; the buffer's name
  1E01'   CD 2098'              	CALL	SRCTF
  1E04'   CD 0000*              	CALL	REOPEN
  1E07'   CD 020F'              	CALL	MKCLR		; the marks named the buffer that just went
  1E0A'   AF                    	XRA	A
  1E0B'   32 2A04'              	STA	MODF
  1E0E'   E1                    	POP	H
  1E0F'   2B                    	DCX	H
  1E10'   AF                    	XRA	A
  1E11'   CD 0000*              	CALL	MVLIND		; down to the line
  1E14'   CD 0A11'              	CALL	ATEOF
  1E17'   DC 0A17'              	CC	LASTLN		; past the last line: onto it
  1E1A'   CD 0F47'              	CALL	ZSAVE
  1E1D'   C3 102A'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  1E20'                         TFDOS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1E20'   C5                    	PUSH	B
  1E21'   11 0080               	LXI	D,CMDTAIL
  1E24'   0E 1A                 	MVI	C,1AH		; set the DMA
  1E26'   CD 0005               	CALL	BDOS
  1E29'   C1                    	POP	B
  1E2A'   11 0000*              	LXI	D,TFCB
  1E2D'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  1E30'                         EXRNG:
  1E30'   2A 2AB7'              	LHLD	SRNG1
  1E33'   7C                    	MOV	A,H
  1E34'   B5                    	ORA	L
  1E35'   37                    	STC
  1E36'   C8                    	RZ
  1E37'   2A 2AB9'              	LHLD	SRNG2
  1E3A'   EB                    	XCHG
  1E3B'   2A 2AB7'              	LHLD	SRNG1
  1E3E'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  1E41'   D8                    	RC
  1E42'   EB                    	XCHG			; HL = the last line, DE = the first
  1E43'   CD 0000*              	CALL	SUBHD
  1E46'   23                    	INX	H
  1E47'   22 2AC1'              	SHLD	SLINES
  1E4A'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  1E4B'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  1E4C'                         GOLNX:
  1E4C'   E5                    	PUSH	H
  1E4D'   CD 0EDB'              	CALL	GOLN
  1E50'   CD 0000*              	CALL	CNTLF
  1E53'   23                    	INX	H		; the line the cursor came to rest on
  1E54'   D1                    	POP	D
  1E55'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  1E58'                         EXSAVP:
  1E58'   CD 0CF9'              	CALL	CURRW
  1E5B'   32 2A60'              	STA	WPROW
  1E5E'   21 2A98'              	LXI	H,MKPOS
  1E61'   C3 044F'              	JMP	FPSTO
  1E64'                         EXRSTP:
  1E64'   CD 0000*              	CALL	CLRCNT
  1E67'   CD 03CF'              	CALL	MKPAGE		; page until that place is in the window again
  1E6A'   CD 0000*              	CALL	GOTO
  1E6D'   C3 1DA1'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  1E70'                         PUTBRK:
  1E70'   3E 0D                 	MVI	A,CR
  1E72'   CD 0000*              	CALL	PUTGAP
  1E75'   3E 0A                 	MVI	A,LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1E77'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  1E7A'                         EX_WR:
  1E7A'   3A 2A5C'              	LDA	EXARG
  1E7D'   B7                    	ORA	A
  1E7E'   CA 227C'              	JZ	MSGNFN		; No file name
  1E81'   CD 20C1'              	CALL	ISOWN
  1E84'   CA 1F24'              	JZ	EXW_OW
  1E87'   CD 0000*              	CALL	TEXIST
  1E8A'   32 2AC4'              	STA	RWERR		; nonzero: a file of that name is there
  1E8D'   CA 1E97'              	JZ	EXW_GO
  1E90'   3A 2A6E'              	LDA	EXBANG
  1E93'   B7                    	ORA	A
  1E94'   C2 2282'              	JNZ	MSGEXI		; File exists (! to force)
  1E97'                         EXW_GO:
  1E97'   CD 1E30'              	CALL	EXRNG
  1E9A'   DA 1F1E'              	JC	EXW_BD
  1E9D'   CD 1E58'              	CALL	EXSAVP
  1EA0'   2A 2AB7'              	LHLD	SRNG1
  1EA3'   CD 1E4C'              	CALL	GOLNX
  1EA6'   C2 1F1B'              	JNZ	EXW_NL		; the text has no line N
  1EA9'   3A 2AC4'              	LDA	RWERR		; a delete scans the whole directory, there or
  1EAC'   B7                    	ORA	A		;   not: only when TEXIST found one
  1EAD'   0E 13                 	MVI	C,13H
  1EAF'   C4 1E20'              	CNZ	TFDOS		; delete what is there
  1EB2'   0E 16                 	MVI	C,16H
  1EB4'   CD 1E20'              	CALL	TFDOS		; ... and make it
  1EB7'   3C                    	INR	A
  1EB8'   CA 1F0D'              	JZ	EXW_FL		; no directory entry left
  1EBB'   3E 80                 	MVI	A,80H
  1EBD'   32 2AC3'              	STA	RWPTR
  1EC0'   AF                    	XRA	A
  1EC1'   32 2AC4'              	STA	RWERR
  1EC4'   2A 2AC1'              	LHLD	SLINES
  1EC7'   CD 0000*              	CALL	SETC0		; that many lines, forward
  1ECA'                         EXW_LP:
  1ECA'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  1ECD'   E5                    	PUSH	H
  1ECE'   EB                    	XCHG
  1ECF'   2A 0000*              	LHLD	GAPEND
  1ED2'   CD 1F2A'              	CALL	RWOUT		; the text from the cursor to there
  1ED5'   E1                    	POP	H
  1ED6'   3A 2AC4'              	LDA	RWERR
  1ED9'   B7                    	ORA	A
  1EDA'   C2 1EF6'              	JNZ	EXW_EN
  1EDD'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  1EE0'   CD 06A0'              	CALL	CNTTST
  1EE3'   C2 1ECA'              	JNZ	EXW_LP
  1EE6'                         EXW_PD:				; the last record is padded out with ^Z
  1EE6'   3A 2AC3'              	LDA	RWPTR
  1EE9'   FE 80                 	CPI	80H
  1EEB'   CA 1EF6'              	JZ	EXW_EN
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1EEE'   3E 1A                 	MVI	A,CPMEOF
  1EF0'   CD 1F36'              	CALL	RWPUT
  1EF3'   C3 1EE6'              	JMP	EXW_PD
  1EF6'                         EXW_EN:
  1EF6'   0E 10                 	MVI	C,10H
  1EF8'   CD 1E20'              	CALL	TFDOS		; close
  1EFB'   3A 2AC4'              	LDA	RWERR
  1EFE'   B7                    	ORA	A
  1EFF'   C2 1F0D'              	JNZ	EXW_FL
  1F02'   CD 1E64'              	CALL	EXRSTP
  1F05'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  1F07'   32 2A6C'              	STA	MSGWHT
  1F0A'   C3 075A'              	JMP	SETMOV		; nothing on the screen has changed
  1F0D'                         EXW_FL:				; no room: the part written is not left behind
  1F0D'   0E 13                 	MVI	C,13H
  1F0F'   CD 1E20'              	CALL	TFDOS
  1F12'   CD 1E64'              	CALL	EXRSTP
  1F15'   21 2439'              	LXI	H,SDFUL
  1F18'   C3 22B4'              	JMP	EXERR
  1F1B'                         EXW_NL:
  1F1B'   CD 1E64'              	CALL	EXRSTP
  1F1E'                         EXW_BD:
  1F1E'   21 242B'              	LXI	H,SRNGE
  1F21'   C3 22B4'              	JMP	EXERR
  1F24'                         EXW_OW:
  1F24'   21 22E3'              	LXI	H,SEXI
  1F27'   C3 22B4'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  1F2A'                         RWOUT:
  1F2A'   CD 0000*              	CALL	CMP16
  1F2D'   C8                    	RZ
  1F2E'   7E                    	MOV	A,M
  1F2F'   23                    	INX	H
  1F30'   CD 1F36'              	CALL	RWPUT
  1F33'   C3 1F2A'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  1F36'                         RWPUT:
  1F36'   E5                    	PUSH	H
  1F37'   F5                    	PUSH	PSW
  1F38'   3A 2AC3'              	LDA	RWPTR
  1F3B'   6F                    	MOV	L,A
  1F3C'   26 00                 	MVI	H,0
  1F3E'   F1                    	POP	PSW
  1F3F'   77                    	MOV	M,A
  1F40'   2C                    	INR	L		; Z: that was the record's last byte
  1F41'   7D                    	MOV	A,L
  1F42'   C2 1F55'              	JNZ	RWP_ST
  1F45'   D5                    	PUSH	D
  1F46'   0E 15                 	MVI	C,15H
  1F48'   CD 1E20'              	CALL	TFDOS		; write it
  1F4B'   D1                    	POP	D
  1F4C'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F4D'   CA 1F53'              	JZ	RWP_OK
  1F50'   32 2AC4'              	STA	RWERR
  1F53'                         RWP_OK:
  1F53'   3E 80                 	MVI	A,80H
  1F55'                         RWP_ST:
  1F55'   32 2AC3'              	STA	RWPTR
  1F58'   E1                    	POP	H
  1F59'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  1F5A'                         EX_R:
  1F5A'   3A 2A5C'              	LDA	EXARG
  1F5D'   B7                    	ORA	A
  1F5E'   CA 227C'              	JZ	MSGNFN		; No file name
  1F61'   0E 0F                 	MVI	C,0FH
  1F63'   CD 1E20'              	CALL	TFDOS		; open
  1F66'   3C                    	INR	A
  1F67'   CA 2034'              	JZ	ER_NOF
  1F6A'   CD 0F6D'              	CALL	GZONE		; the screen's top line, before anything moves
  1F6D'   CD 1E58'              	CALL	EXSAVP
  1F70'   3A 2AB6'              	LDA	SRNGF
  1F73'   B7                    	ORA	A
  1F74'   CA 1F8D'              	JZ	ER_NXT		; no line given: below the cursor's
  1F77'   2A 2AB9'              	LHLD	SRNG2
  1F7A'   7C                    	MOV	A,H
  1F7B'   B5                    	ORA	L
  1F7C'   C2 1F87'              	JNZ	ER_LN
  1F7F'   23                    	INX	H
  1F80'   CD 0EDB'              	CALL	GOLN		; ':0r': above line 1 ...
  1F83'   AF                    	XRA	A		;   which never wants a line end put in first
  1F84'   C3 1FAF'              	JMP	ER_BRK
  1F87'                         ER_LN:
  1F87'   CD 1E4C'              	CALL	GOLNX
  1F8A'   C2 1F1B'              	JNZ	EXW_NL		; the text has no line N
  1F8D'                         ER_NXT:
  1F8D'   21 0001               	LXI	H,1
  1F90'   AF                    	XRA	A
  1F91'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  1F94'   CD 0A11'              	CALL	ATEOF
  1F97'   3E 00                 	MVI	A,0
  1F99'   D2 1FAF'              	JNC	ER_BRK		; text follows
  1F9C'   2A 0000*              	LHLD	GAPBEG
  1F9F'   EB                    	XCHG
  1FA0'   2A 0000*              	LHLD	TXTBEG
  1FA3'   CD 0000*              	CALL	CMP16
  1FA6'   3E 01                 	MVI	A,1
  1FA8'   CA 1FAF'              	JZ	ER_BRK		; nothing before the cursor either
  1FAB'   1B                    	DCX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1FAC'   1A                    	LDAX	D
  1FAD'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  1FAF'                         ER_BRK:
  1FAF'   32 2AC6'              	STA	RDBRK
  1FB2'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  1FB5'   AF                    	XRA	A
  1FB6'   32 2AC5'              	STA	RDANY
  1FB9'                         ER_LP:
  1FB9'   0E 14                 	MVI	C,14H
  1FBB'   CD 1E20'              	CALL	TFDOS		; the next record
  1FBE'   B7                    	ORA	A
  1FBF'   C2 1FF2'              	JNZ	ER_END
  1FC2'   21 0080               	LXI	H,CMDTAIL
  1FC5'   0E 00                 	MVI	C,0
  1FC7'                         ER_SC:				; C = its bytes, up to a ^Z
  1FC7'   7E                    	MOV	A,M
  1FC8'   FE 1A                 	CPI	CPMEOF
  1FCA'   CA 1FD2'              	JZ	ER_GOT
  1FCD'   23                    	INX	H
  1FCE'   0C                    	INR	C
  1FCF'   F2 1FC7'              	JP	ER_SC		; (minus: all 128)
  1FD2'                         ER_GOT:
  1FD2'   79                    	MOV	A,C
  1FD3'   B7                    	ORA	A
  1FD4'   CA 1FF2'              	JZ	ER_END
  1FD7'   C5                    	PUSH	B
  1FD8'   3A 2AC5'              	LDA	RDANY
  1FDB'   B7                    	ORA	A
  1FDC'   CC 2023'              	CZ	ER_1ST
  1FDF'   C1                    	POP	B
  1FE0'   06 00                 	MVI	B,0
  1FE2'   11 0080               	LXI	D,CMDTAIL
  1FE5'   C5                    	PUSH	B
  1FE6'   CD 0000*              	CALL	INSBLK
  1FE9'   C1                    	POP	B
  1FEA'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  1FED'   79                    	MOV	A,C
  1FEE'   17                    	RAL
  1FEF'   DA 1FB9'              	JC	ER_LP		; a full record: there may be more
  1FF2'                         ER_END:
  1FF2'   3A 2AC5'              	LDA	RDANY
  1FF5'   B7                    	ORA	A
  1FF6'   CA 2014'              	JZ	ER_PL		; nothing in the file: nothing has changed
  1FF9'   CD 0A11'              	CALL	ATEOF
  1FFC'   DA 2009'              	JC	ER_MD		; the text now ends as the file read ends
  1FFF'   2A 0000*              	LHLD	GAPBEG
  2002'   2B                    	DCX	H
  2003'   7E                    	MOV	A,M
  2004'   FE 0A                 	CPI	LF
  2006'   C4 1E70'              	CNZ	PUTBRK		; text follows: what was read ends a line
  2009'                         ER_MD:
  2009'   3E 01                 	MVI	A,1
  200B'   32 2A04'              	STA	MODF
  200E'   CD 03CF'              	CALL	MKPAGE		; back to the first line read
  2011'   CD 0000*              	CALL	GOTO
  2014'                         ER_PL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  2014'   CD 0A11'              	CALL	ATEOF
  2017'   DC 0A17'              	CC	LASTLN		; (nothing read, at the end: the last line)
  201A'   CD 0000*              	CALL	CLRCNT
  201D'   CD 0F85'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  2020'   C3 077B'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  2023'                         ER_1ST:
  2023'   3C                    	INR	A
  2024'   32 2AC5'              	STA	RDANY
  2027'   3A 2AC6'              	LDA	RDBRK
  202A'   B7                    	ORA	A
  202B'   C4 1E70'              	CNZ	PUTBRK
  202E'   21 2A98'              	LXI	H,MKPOS
  2031'   C3 044F'              	JMP	FPSTO
  2034'                         ER_NOF:
  2034'   21 241A'              	LXI	H,SNOPN
  2037'   C3 22A9'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  203A'                         WRCHK:
  203A'   3A 2A5C'              	LDA	EXARG
  203D'   B7                    	ORA	A
  203E'   C2 2048'              	JNZ	WC_ARG
  2041'   CD 20AB'              	CALL	OWNTF
  2044'   D8                    	RC
  2045'   C3 205D'              	JMP	WC_OWN
  2048'                         WC_ARG:
  2048'   CD 20C1'              	CALL	ISOWN
  204B'   CA 205D'              	JZ	WC_OWN
  204E'   3A 2A6E'              	LDA	EXBANG
  2051'   B7                    	ORA	A
  2052'   CA 205B'              	JZ	WC_OTH
  2055'   CD 0000*              	CALL	TEXIST
  2058'   C2 2282'              	JNZ	MSGEXI		; File exists (! to force)
  205B'                         WC_OTH:
  205B'   AF                    	XRA	A		; (NC)
  205C'   C9                    	RET
  205D'                         WC_OWN:
  205D'   3A 2A6F'              	LDA	ROFLAG		; '-R': this is the file it may not write
  2060'   B7                    	ORA	A
  2061'   CA 206B'              	JZ	WC_OK
  2064'   3A 2A6E'              	LDA	EXBANG
  2067'   B7                    	ORA	A
  2068'   C2 2288'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  206B'                         WC_OK:
  206B'   3E 01                 	MVI	A,1
  206D'   B7                    	ORA	A		; (NC)
  206E'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  206F'                         WRITE:
  206F'   3A 2A5D'              	LDA	EXBAK
  2072'   CD 0000*              	CALL	WRTO
  2075'   3A 0001*              	LDA	FNAME+1
  2078'   FE 20                 	CPI	' '
  207A'   C2 2086'              	JNZ	WR_HAS
  207D'   21 0000*              	LXI	H,TFCB
  2080'   11 0000*              	LXI	D,FNAME
  2083'   CD 20D3'              	CALL	COPY12
  2086'                         WR_HAS:
  2086'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  2088'   32 2A6C'              	STA	MSGWHT
  208B'   CD 20C1'              	CALL	ISOWN
  208E'   C2 2098'              	JNZ	SRCTF
  2091'   AF                    	XRA	A
  2092'   32 2A04'              	STA	MODF
  2095'   32 2A6D'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  2098'                         SRCTF:
  2098'   21 0000*              	LXI	H,TFCB
  209B'   11 005C               	LXI	D,DFTFCB
  209E'   CD 20D3'              	CALL	COPY12
  20A1'   AF                    	XRA	A
  20A2'   06 04                 	MVI	B,4
  20A4'                         SRC_Z:
  20A4'   12                    	STAX	D		; extent, s1, s2, record count: 0
  20A5'   13                    	INX	D
  20A6'   05                    	DCR	B
  20A7'   C2 20A4'              	JNZ	SRC_Z
  20AA'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  20AB'                         OWNTF:
  20AB'   3A 0001*              	LDA	FNAME+1
  20AE'   FE 20                 	CPI	' '
  20B0'   CA 227C'              	JZ	MSGNFN
  20B3'   CD 20DE'              	CALL	TFCLR
  20B6'   21 0000*              	LXI	H,FNAME
  20B9'   11 0000*              	LXI	D,TFCB
  20BC'   CD 20D3'              	CALL	COPY12
  20BF'   B7                    	ORA	A		; (NC)
  20C0'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  20C1'                         ISOWN:
  20C1'   21 0000*              	LXI	H,TFCB
  20C4'   11 0000*              	LXI	D,FNAME
  20C7'   06 0C                 	MVI	B,12
  20C9'                         IO_LP:
  20C9'   1A                    	LDAX	D
  20CA'   BE                    	CMP	M
  20CB'   C0                    	RNZ
  20CC'   23                    	INX	H
  20CD'   13                    	INX	D
  20CE'   05                    	DCR	B
  20CF'   C2 20C9'              	JNZ	IO_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  20D2'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  20D3'                         COPY12:
  20D3'   06 0C                 	MVI	B,12
  20D5'                         CP_LP:
  20D5'   7E                    	MOV	A,M
  20D6'   12                    	STAX	D
  20D7'   23                    	INX	H
  20D8'   13                    	INX	D
  20D9'   05                    	DCR	B
  20DA'   C2 20D5'              	JNZ	CP_LP
  20DD'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  20DE'                         TFCLR:
  20DE'   11 0000*              	LXI	D,TFCB
  20E1'   06 24                 	MVI	B,36
  20E3'   AF                    	XRA	A
  20E4'                         TC_LP:
  20E4'   12                    	STAX	D
  20E5'   13                    	INX	D
  20E6'   05                    	DCR	B
  20E7'   C2 20E4'              	JNZ	TC_LP
  20EA'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  20EB'                         FOPEN:
  20EB'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  20ED'   32 2A6C'              	STA	MSGWHT
  20F0'   21 005C               	LXI	H,DFTFCB
  20F3'   CD 21C5'              	CALL	NRMDRV
  20F6'   11 0000*              	LXI	D,FNAME
  20F9'   CD 20D3'              	CALL	COPY12
  20FC'   CD 0000*              	CALL	OPENZ
  20FF'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  2102'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  2104'   C8                    	RZ
  2105'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  2108'   32 2A6D'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  210B'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  210C'                         ARGSCN:
  210C'   3A 0080               	LDA	CMDTAIL
  210F'   47                    	MOV	B,A		; B = what is left of the line
  2110'   B7                    	ORA	A
  2111'   C8                    	RZ
  2112'   21 0081               	LXI	H,CMDTAIL+1
  2115'                         AS_TOK:				; at a token, or the blanks before one
  2115'   7E                    	MOV	A,M
  2116'   FE 20                 	CPI	' '
  2118'   C2 2121'              	JNZ	AS_OPT
  211B'   23                    	INX	H
  211C'   05                    	DCR	B
  211D'   C2 2115'              	JNZ	AS_TOK
  2120'   C9                    	RET
  2121'                         AS_OPT:
  2121'   FE 2B                 	CPI	'+'
  2123'   CA 214D'              	JZ	AS_PLS
  2126'   FE 2D                 	CPI	'-'
  2128'   CA 213C'              	JZ	AS_SW
  212B'   FE 2F                 	CPI	'/'
  212D'   CA 213C'              	JZ	AS_SW
  2130'                         AS_SKP:				; not ours (the file name): on to the next one
  2130'   23                    	INX	H
  2131'   05                    	DCR	B
  2132'   C8                    	RZ
  2133'   7E                    	MOV	A,M
  2134'   FE 20                 	CPI	' '
  2136'   C2 2130'              	JNZ	AS_SKP
  2139'   C3 2115'              	JMP	AS_TOK
  213C'                         AS_SW:
  213C'   23                    	INX	H
  213D'   05                    	DCR	B
  213E'   C8                    	RZ
  213F'   7E                    	MOV	A,M
  2140'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  2142'   FE 52                 	CPI	'R'
  2144'   C2 2130'              	JNZ	AS_SKP
  2147'   32 2A6F'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  214A'   C3 2130'              	JMP	AS_SKP
  214D'                         AS_PLS:
  214D'   3E 01                 	MVI	A,1
  214F'   32 2A70'              	STA	PLUSF		; '+' gets the line even with no number on it
  2152'   11 0000*              	LXI	D,PLUSB
  2155'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2157'   23                    	INX	H		;   line space, so it is taken as '+' alone
  2158'   05                    	DCR	B
  2159'   CA 2190'              	JZ	AS_PE
  215C'   7E                    	MOV	A,M
  215D'   FE 30                 	CPI	'0'
  215F'   C2 2177'              	JNZ	AS_PD
  2162'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  2162'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  2163'   05                    	DCR	B
  2164'   CA 2198'              	JZ	AS_P1
  2167'   7E                    	MOV	A,M
  2168'   FE 30                 	CPI	'0'
  216A'   CA 2162'              	JZ	AS_PZ
  216D'   FE 31                 	CPI	'1'
  216F'   DA 2198'              	JC	AS_P1		; zeros and then no digit at all: line 1
  2172'   FE 3A                 	CPI	'9'+1
  2174'   D2 2198'              	JNC	AS_P1
  2177'                         AS_PD:				; the digits, as typed
  2177'   7E                    	MOV	A,M
  2178'   FE 30                 	CPI	'0'
  217A'   DA 2190'              	JC	AS_PE
  217D'   FE 3A                 	CPI	'9'+1
  217F'   D2 2190'              	JNC	AS_PE
  2182'   79                    	MOV	A,C
  2183'   B7                    	ORA	A
  2184'   CA 219F'              	JZ	AS_POV
  2187'   0D                    	DCR	C
  2188'   7E                    	MOV	A,M
  2189'   12                    	STAX	D
  218A'   13                    	INX	D
  218B'   23                    	INX	H
  218C'   05                    	DCR	B
  218D'   C2 2177'              	JNZ	AS_PD
  2190'                         AS_PE:
  2190'   AF                    	XRA	A
  2191'   12                    	STAX	D		; the digits end with a 0
  2192'   78                    	MOV	A,B
  2193'   B7                    	ORA	A
  2194'   C8                    	RZ
  2195'   C3 2115'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  2198'                         AS_P1:
  2198'   3E 31                 	MVI	A,'1'
  219A'   12                    	STAX	D
  219B'   13                    	INX	D
  219C'   C3 2190'              	JMP	AS_PE
  219F'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  219F'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  21A2'   C3 2190'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  21A5'                         ARGGO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  21A5'   3A 2A70'              	LDA	PLUSF
  21A8'   B7                    	ORA	A
  21A9'   C8                    	RZ
  21AA'   21 0000*              	LXI	H,PLUSB
  21AD'                         AG_LP:
  21AD'   7E                    	MOV	A,M
  21AE'   B7                    	ORA	A
  21AF'   CA 21BE'              	JZ	AG_G
  21B2'   4F                    	MOV	C,A
  21B3'   06 02                 	MVI	B,KT_CHAR
  21B5'   E5                    	PUSH	H
  21B6'   CD 0023'              	CALL	VICMD
  21B9'   E1                    	POP	H
  21BA'   23                    	INX	H
  21BB'   C3 21AD'              	JMP	AG_LP
  21BE'                         AG_G:
  21BE'   0E 47                 	MVI	C,'G'
  21C0'   06 02                 	MVI	B,KT_CHAR
  21C2'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  21C5'                         NRMDRV:
  21C5'   7E                    	MOV	A,M
  21C6'   B7                    	ORA	A
  21C7'   C0                    	RNZ
  21C8'   E5                    	PUSH	H
  21C9'   0E 19                 	MVI	C,BF_CURDSK
  21CB'   CD 0005               	CALL	BDOS
  21CE'   E1                    	POP	H
  21CF'   3C                    	INR	A
  21D0'   77                    	MOV	M,A
  21D1'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  21D2'                         PARSFN:
  21D2'   CD 20DE'              	CALL	TFCLR
  21D5'   11 0000*              	LXI	D,TFCB
  21D8'   23                    	INX	H
  21D9'   7E                    	MOV	A,M
  21DA'   2B                    	DCX	H
  21DB'   FE 3A                 	CPI	':'
  21DD'   C2 21EF'              	JNZ	PF_NM
  21E0'   CD 2235'              	CALL	GETFNC
  21E3'   CA 21EF'              	JZ	PF_NM
  21E6'   D6 40                 	SUI	40H
  21E8'   12                    	STAX	D
  21E9'   FE 11                 	CPI	17
  21EB'   D2 2213'              	JNC	PF_BAD
  21EE'   23                    	INX	H
  21EF'                         PF_NM:
  21EF'   13                    	INX	D
  21F0'   0E 08                 	MVI	C,8
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  21F2'   CD 2217'              	CALL	CPYNAM
  21F5'   FE 2E                 	CPI	'.'
  21F7'   0E 03                 	MVI	C,3
  21F9'   C4 222A'              	CNZ	PADFLD		; no type: blanks
  21FC'   CC 2216'              	CZ	CPYNM0		; '.': the type
  21FF'   3A 0001*              	LDA	TFCB+1
  2202'   FE 20                 	CPI	' '
  2204'   CA 2213'              	JZ	PF_BAD		; no name
  2207'   CD 2268'              	CALL	SKIPB
  220A'   C0                    	RNZ			; more after it
  220B'   21 0000*              	LXI	H,TFCB
  220E'   CD 21C5'              	CALL	NRMDRV
  2211'   AF                    	XRA	A
  2212'   C9                    	RET
  2213'                         PF_BAD:
  2213'   F6 01                 	ORI	1
  2215'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  2216'                         CPYNM0:
  2216'   23                    	INX	H
  2217'                         CPYNAM:
  2217'   CD 2235'              	CALL	GETFNC
  221A'   CA 222A'              	JZ	PADFLD
  221D'   12                    	STAX	D
  221E'   13                    	INX	D
  221F'   0D                    	DCR	C
  2220'   C2 2217'              	JNZ	CPYNAM
  2223'                         CN_SKP:
  2223'   CD 2235'              	CALL	GETFNC
  2226'   C2 2223'              	JNZ	CN_SKP
  2229'   C9                    	RET
  222A'                         PADFLD:
  222A'   F5                    	PUSH	PSW
  222B'                         PD_LP:
  222B'   3E 20                 	MVI	A,' '
  222D'   12                    	STAX	D
  222E'   13                    	INX	D
  222F'   0D                    	DCR	C
  2230'   C2 222B'              	JNZ	PD_LP
  2233'   F1                    	POP	PSW
  2234'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  2235'                         GETFNC:
  2235'   7E                    	MOV	A,M
  2236'   FE 3D                 	CPI	'='
  2238'   C8                    	RZ
  2239'   FE 5F                 	CPI	'_'
  223B'   C8                    	RZ
  223C'   FE 3B                 	CPI	';'
  223E'   C8                    	RZ
  223F'   FE 3C                 	CPI	'<'
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  2241'   C8                    	RZ
  2242'   FE 3E                 	CPI	'>'
  2244'   C8                    	RZ
  2245'   FE 2E                 	CPI	'.'
  2247'   C8                    	RZ
  2248'   FE 3A                 	CPI	':'
  224A'   C8                    	RZ
  224B'   FE 2A                 	CPI	'*'
  224D'   C8                    	RZ
  224E'   FE 3F                 	CPI	'?'
  2250'   C8                    	RZ
  2251'   FE 20                 	CPI	' '
  2253'   DA 2266'              	JC	GF_CTL
  2256'   C8                    	RZ
  2257'   23                    	INX	H
  2258'   FE 61                 	CPI	'a'
  225A'   DA 2264'              	JC	GF_DN
  225D'   FE 7B                 	CPI	'z'+1
  225F'   D2 2264'              	JNC	GF_DN
  2262'   E6 DF                 	ANI	0DFH
  2264'                         GF_DN:
  2264'   B7                    	ORA	A
  2265'   C9                    	RET
  2266'                         GF_CTL:
  2266'   BF                    	CMP	A
  2267'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  2268'                         SKIPB:
  2268'   7E                    	MOV	A,M
  2269'   FE 20                 	CPI	' '
  226B'   C2 2272'              	JNZ	SB_DN
  226E'   23                    	INX	H
  226F'   C3 2268'              	JMP	SKIPB
  2272'                         SB_DN:
  2272'   B7                    	ORA	A
  2273'   C9                    	RET
                                
                                ;ISLOW -- A = the char at HL; NC iff a-z.
  2274'                         ISLOW:
  2274'   7E                    	MOV	A,M
  2275'   FE 61                 	CPI	'a'
  2277'   D8                    	RC
  2278'   FE 7B                 	CPI	'z'+1
  227A'   3F                    	CMC
  227B'   C9                    	RET
                                
                                ;--- ex messages (vim's, without the Enn number) ---
  227C'                         MSGNFN:
  227C'   21 22C9'              	LXI	H,SNFN
  227F'   C3 22B4'              	JMP	EXERR
  2282'                         MSGEXI:
  2282'   21 22E3'              	LXI	H,SEXI
  2285'   C3 2291'              	JMP	EXBNG
  2288'                         MSGRO:
  2288'   21 22EF'              	LXI	H,SRO
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  228B'   C3 2291'              	JMP	EXBNG
  228E'                         MSGNWR:
  228E'   21 22D6'              	LXI	H,SNWR
  2291'                         EXBNG:
  2291'   CD 22B4'              	CALL	EXERR
  2294'   21 22FB'              	LXI	H,SBNG
  2297'   C3 22AF'              	JMP	EXOUT
  229A'                         EX_INV:
  229A'   21 2309'              	LXI	H,SINV
  229D'   C3 22B4'              	JMP	EXERR
  22A0'                         EX_V:				; :ve -- the version, on the bottom row
  22A0'   21 22C4'              	LXI	H,SVER
  22A3'   C3 22B4'              	JMP	EXERR
  22A6'                         EX_TRL:
  22A6'   21 231B'              	LXI	H,STRL
  22A9'                         EXERT:				; the message, then the text at EXCMD
  22A9'   CD 22B4'              	CALL	EXERR
  22AC'   2A 2A5E'              	LHLD	EXCMD
  22AF'                         EXOUT:
  22AF'   CD 0000*              	CALL	OUTSTR
  22B2'   37                    	STC
  22B3'   C9                    	RET
                                ;EXERR -- HL = a message for the bottom row; it stays there (only the cursor
                                ; goes back), CY.
  22B4'                         EXERR:
  22B4'   E5                    	PUSH	H
  22B5'   AF                    	XRA	A		; an error outranks whatever this key meant to
  22B6'   32 2A6C'              	STA	MSGWHT		;   say: ':wq NAME' writes, then refuses to quit
  22B9'   E1                    	POP	H
  22BA'   CD 0000*              	CALL	EXMSG
  22BD'   3E 01                 	MVI	A,R_MOVE
  22BF'   32 2A05'              	STA	RINTENT
  22C2'   37                    	STC
  22C3'   C9                    	RET
                                
  22C4'   56 31 2E 32           SVER:	DB	'V1.2',0
  22C8'   00                    
  22C9'   4E 6F 20 66           SNFN:	DB	'No file name',0
  22CD'   69 6C 65 20           
  22D1'   6E 61 6D 65           
  22D5'   00                    
  22D6'   46 69 6C 65           SNWR:	DB	'File changed',0
  22DA'   20 63 68 61           
  22DE'   6E 67 65 64           
  22E2'   00                    
  22E3'   46 69 6C 65           SEXI:	DB	'File exists',0
  22E7'   20 65 78 69           
  22EB'   73 74 73 00           
  22EF'   27 2D 52 27           SRO:	DB	'''-R'' is set',0
  22F3'   20 69 73 20           
  22F7'   73 65 74 00           
  22FB'   20 28 21 20           SBNG:	DB	' (! to force)',0
  22FF'   74 6F 20 66           
  2303'   6F 72 63 65           
  2307'   29 00                 
  2309'   49 6E 76 61           SINV:	DB	'Invalid file name',0
