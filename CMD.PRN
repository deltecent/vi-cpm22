  06E0'   CD 0000*              	CALL	CMP16
  06E3'   D2 0701'              	JNC	ENL_A
  06E6'   2A 0000*              	LHLD	GAPBEG
  06E9'   44                    	MOV	B,H
  06EA'   4D                    	MOV	C,L
  06EB'   2A 0000*              	LHLD	TXTBEG
  06EE'   19                    	DAD	D
