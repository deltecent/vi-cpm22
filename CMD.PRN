  2DC2'   4F                    	DB	'O'
  2DC3'   1986'                 	DW	VCB_O
  2DC5'   4A                    	DB	'J'
  2DC6'   19A0'                 	DW	VCB_J
  2DC8'   7E                    	DB	'~'
  2DC9'   1A22'                 	DW	VC_TILD
  2DCB'   3A                    	DB	':'
  2DCC'   2086'                 	DW	VC_EX
  2DCE'   2F                    	DB	'/'
  2DCF'   2A89'                 	DW	VC_SRCH
  2DD1'   3F                    	DB	'?'
  2DD2'   2A89'                 	DW	VC_SRCH
  2DD4'   6E                    	DB	'n'
  2DD5'   2ADC'                 	DW	VC_N
  2DD7'   4E                    	DB	'N'
  2DD8'   2AE5'                 	DW	VCB_N
  2DDA'   48                    	DB	'H'
  2DDB'   0E16'                 	DW	VC_HIGH
  2DDD'   4D                    	DB	'M'
  2DDE'   0E2D'                 	DW	VC_MIDL
  2DE0'   4C                    	DB	'L'
  2DE1'   0E48'                 	DW	VC_LOWL
  2DE3'   06                    	DB	06H			; ^F -- page forward
  2DE4'   0E65'                 	DW	VC_PGDN
  2DE6'   02                    	DB	02H			; ^B -- page back
  2DE7'   0EC3'                 	DW	VC_PGUP
  2DE9'   04                    	DB	04H			; ^D -- half page down
  2DEA'   0FA4'                 	DW	VC_HFDN
  2DEC'   15                    	DB	15H			; ^U -- half page up
  2DED'   106B'                 	DW	VC_HFUP
  2DEF'   0C                    	DB	0CH			; ^L -- redraw
  2DF0'   121A'                 	DW	VC_REDR
  2DF2'   2E                    	DB	'.'			; '.' -- repeat the last change
  2DF3'   017D'                 	DW	VC_DOT
  2DF5'   75                    	DB	'u'			; 'u' -- undo (and undo the undo)
  2DF6'   0545'                 	DW	VC_UNDO
  2DF8'   6D                    	DB	'm'		; m{a-c} -- set a mark
  2DF9'   032E'                 	DW	VC_MK
  2DFB'   60                    	DB	60H		; `{a-c} -- back to its exact spot
  2DFC'   0333'                 	DW	VC_BQ
  2DFE'   27                    	DB	27H		; '{a-c} -- back to its line's first non-blank
  2DFF'   0338'                 	DW	VC_AQ
  2E01'   00                    	DB	0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  2E02'   00                    EDMODE: DB	EM_CMD
  2E03'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  2E05'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  2E06'   00                    MODF:	DB	0		; 1 = unsaved changes
  2E07'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  2E08'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  2E09'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  2E0A'   01                    DCHN:	DB	1		; the cells an R_DCH paint deletes (SCRN.MAC reads)
	MACRO-80 3.44	09-Dec-81	PAGE	1-142


  2E0B'   00                    DCHBS:	DB	0		; 1 = they went left of the cursor (insert's BS)
  2E0C'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  2E0D'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  2E0F'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  2E10'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  2E11'   00                    HFAMT:	DB	0		; ^D/^U: rows (vim's 'scroll'); 0 = NEDIT/2
  2E12'   00                    HFN:	DB	0		; ^D/^U: the rows this one goes
  2E13'   0000                  HFTP:	DW	0		; ^D/^U: -> the new top line's entry
  2E15'   00                    HTN:	DB	0		; row table: its entries
  2E16'   00                    HTCUR:	DB	0		; ... the cursor line's
  2E17'   00                    HTTP:	DB	0		; ... the top line's
  2E18'   00                    HTEOF:	DB	0		; ... 1 = its last is the file's last line
  2E19'   00                    HTBOF:	DB	0		; ... 1 = its first is the file's first
  2E1A'   0000                  RWR:	DW	0		; ^F/^B: rows still to go
  2E1C'   00                    RWMV:	DB	0		; ^F/^B: 1 = the table was made again on the way
  2E1D'   00                    OVDIR:	DB	0		; OVLAP: 0 = h2.. are above h1 in the table
  2E1E'   0000                  JKCNT:	DW	0		; j/k: count
  2E20'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  2E22'   0000                  JKMOV:	DW	0		; j: lines moved
  2E24'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  2E26'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  2E27'   00                    JKLST:	DB	0		; j: last byte of the scan
  2E28'   0000                  JKVC:	DW	0		; j/k landing: screen column
  2E2A'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  2E2C'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  2E2D'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  2E2E'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  2E2F'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  2E30'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  2E31'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  2E33'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  2E34'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  2E35'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  2E37'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  2E38'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  2E39'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  2E3A'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
  2E3B'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  2E3C'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  2E3D'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   and its first word is yet to be stepped
  2E3E'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  2E40'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  2E42'   00 00 00              OPSFP:	DB	0,0,0		; operator: the start as a place in the file
  2E45'   00 00 00              OPSLO:	DB	0,0,0		; ... where its line starts
  2E48'   00 00 00              OPSHI:	DB	0,0,0		; ... where the next line does (OPPGD: the span's
	MACRO-80 3.44	09-Dec-81	PAGE	1-143


                                				;   high end, whichever line that turned out to be)
  2E4B'   00 00 00              OPTOGO: DB	0,0,0		; OPPGD: bytes still to take
  2E4E'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  2E50'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  2E52'   0000                  CNTV:	DW	0		; motion repeat counter
  2E54'   0000                  TTI:	DW	0		; TAILTAB scan index
  2E56'   0000                  WKI:	DW	0		; scan index
  2E58'   0000                  WKTERM: DW	0		; line terminator offset
  2E5A'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  2E5C'   00                    WKCLS:	DB	0		; word motion: class of the current run
  2E5D'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  2E5E'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  2E60'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  2E62'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
  2E64'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  2E66'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  2E67'   00                    RLMAX:	DB	0		; RDLINE: capacity
  2E68'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  2E69'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  2E6A'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  2E6B'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  2E6D'   00                    WPROW:	DB	0		; :w -- the cursor's row
  2E6E'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  2E6F'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2E71'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  2E73'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  2E74'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  2E76'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  2E78'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  2E79'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  2E7A'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  2E7B'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  2E7C'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  2E7D'   00                    PLUSF:	DB	0		; command line: '+' was given
  2E7E'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  2E7F'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  2E80'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  2E81'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  2E83'   0000                  YPT:	DW	0		; yy: where the lines came from
  2E85'   0000                  PCNT:	DW	0		; p/P: copies still to put
  2E87'   00 00 00              PPFP:	DB	0,0,0		; p/P: the first line put, a file position
  2E8A'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  2E8C'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  2E8D'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  2E8F'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  2E90'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  2E91'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  2E92'   00                    FNDKND: DB	0		; f/F/t/T: which find ';' repeats (0 = none yet)
  2E93'   00                    FNDCH:	DB	0		; ... and the character it looked for
  2E94'   00                    FNDRUN: DB	0		; the find THIS command is running (',' reverses)
  2E95'   00                    FNDSTP: DB	0		; how far along it starts: 2 for a 't' repeat
  2E96'   0000                  FNDN:	DW	0		; occurrences still to count off
	MACRO-80 3.44	09-Dec-81	PAGE	1-144


  2E98'   0000                  FNDCUR: DW	0		; the cursor it started from
  2E9A'   0000                  FNDLIM: DW	0		; ... and the end of the line it may not pass
  2E9C'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  2E9D'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  2EA0'   00 00 00              MKEDIT: DB	0,0,0		; MKSHFT: where in the file the edit is
  2EA3'   0000                  MKN:	DW	0		; ... how long it is
  2EA5'   00                    MKTYP:	DB	0		; ... and which way: 1 text went in, 2 came out
  2EA6'   00 00 00              MKPOS:	DB	0,0,0		; MKJMP: the file position being jumped to
  2EA9'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  2EAA'   00                    MKHOLD: DB	0		; set across YKGO's delete + put back (a yank
                                				;   that could not copy): MKSHFT must leave the
                                				;   marks alone through it
  2EAB'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  2EAD'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  2EAF'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  2EB1'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  2EB3'   00 00 00              YPFP:	DB	0,0,0		; ... and where in the file they start
                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  2EB6'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  2EB8'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
  2EBA'   0000                  SCNT:	DW	0		; searches still to do (the count)
  2EBC'   00 00 00              SOFF:	DB	0,0,0		; BRKON: where in the FILE the command began
  2EBF'   0000                  SLDLT:	DW	0		; ... and LNDLT: for a search that fails, and
                                				;   any move an ESC stops
  2EC1'   00                    BRKARM: DB	0		; nonzero: CNTTST looks for an ESC
  2EC2'   00                    BRKHIT: DB	0		; nonzero: one was found, and the count spent
  2EC3'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  2EC4'   00                    SRNGF:	DB	0		; ex: a line range was given
  2EC5'   0000                  SRNG1:	DW	0		; ex: its first line
  2EC7'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  2EC9'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  2ECA'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  2ECB'   00                    SANY:	DB	0		; ':s' something in the range has changed
  2ECC'   00                    SLCHG:	DB	0		; ':s' this line changed
  2ECD'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  2ECF'   0000                  SLINES: DW	0		; ':s' / ':N,Mw' lines of the range still to do
  2ED1'   00                    RWPTR:	DB	0		; ':N,Mw' the next free byte of the record at
                                				;   0080H, as that address's low byte
  2ED2'   00                    RWERR:	DB	0		; ':N,Mw' a record would not go: the disk is full
  2ED3'   00                    RDANY:	DB	0		; ':r' something has been read in
  2ED4'   00                    RDBRK:	DB	0		; ':r' the line above wants a line end first
  2ED5'   00 00 00              SOFFS:	DB	0,0,0		; ':s' the cursor's place in the file, for one that
  2ED8'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
	MACRO-80 3.44	09-Dec-81	PAGE	1-145


  2EDA'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  2EDB'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
