  0CA9'   2A 29DE'              	LHLD	WKN
  0CAC'   CD 0000*              	CALL	CMP16		; DE=(i+1) vs HL=n: CY iff (i+1) < n
  0CAF'   D2 0CCC'              	JNC	ES_LND
  0CB2'   2A 29DC'              	LHLD	WKI
  0CB5'   23                    	INX	H
  0CB6'   E5                    	PUSH	H		; i+1
  0CB7'   CD 0000*              	CALL	CHARAT
