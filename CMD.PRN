  2689'   C9                    	RET
  268A'                         GF_CTL:
  268A'   BF                    	CMP	A
  268B'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  268C'                         SKIPB:
  268C'   7E                    	MOV	A,M
  268D'   FE 20                 	CPI	' '
  268F'   C2 2696'              	JNZ	SB_DN
  2692'   23                    	INX	H
  2693'   C3 268C'              	JMP	SKIPB
  2696'                         SB_DN:
  2696'   B7                    	ORA	A
  2697'   C9                    	RET
                                
