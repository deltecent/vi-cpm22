  302F'   C2 3024'              	JNZ	MN_XL
  3032'                         MN_END:
  3032'   3E 22                 	MVI	A,'"'
  3034'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  3037'                         MSGFLG:
  3037'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  3039'   B7                    	ORA	A
  303A'   CA 304A'              	JZ	MF_RO
  303D'   3A 0000*              	LDA	MODF
  3040'   B7                    	ORA	A
  3041'   CA 304A'              	JZ	MF_RO
  3044'   21 29CC'              	LXI	H,SMODM
  3047'   CD 305F'              	CALL	MF_PUT
  304A'                         MF_RO:
  304A'   3A 0000*              	LDA	ROFLAG
  304D'   B7                    	ORA	A
  304E'   CA 3057'              	JZ	MF_NEW
	MACRO-80 3.44	09-Dec-81	PAGE	1-148


  3051'   21 29D7'              	LXI	H,SROM
  3054'   CD 305F'              	CALL	MF_PUT
  3057'                         MF_NEW:
  3057'   3A 0000*              	LDA	MSGNEW
  305A'   B7                    	ORA	A
  305B'   C8                    	RZ
  305C'   21 29E2'              	LXI	H,SNEWM
  305F'                         MF_PUT:
  305F'   78                    	MOV	A,B
  3060'   B7                    	ORA	A
  3061'   C2 306D'              	JNZ	MF_STR
  3064'   06 01                 	MVI	B,1
  3066'   E5                    	PUSH	H
  3067'   3E 20                 	MVI	A,' '
  3069'   CD 0000*              	CALL	OUTCH
  306C'   E1                    	POP	H
  306D'                         MF_STR:
  306D'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  3070'                         EMITW:
  3070'   C5                    	PUSH	B
  3071'   D5                    	PUSH	D
  3072'   06 00                 	MVI	B,0
  3074'   11 2710               	LXI	D,10000
  3077'   CD 3095'              	CALL	EWDIG
  307A'   11 03E8               	LXI	D,1000
  307D'   CD 3095'              	CALL	EWDIG
  3080'   11 0064               	LXI	D,100
  3083'   CD 3095'              	CALL	EWDIG
  3086'   11 000A               	LXI	D,10
  3089'   CD 3095'              	CALL	EWDIG
  308C'   7D                    	MOV	A,L		; the units digit is always printed
  308D'   C6 30                 	ADI	'0'
  308F'   CD 0000*              	CALL	OUTCH
  3092'   D1                    	POP	D
  3093'   C1                    	POP	B
  3094'   C9                    	RET
  3095'                         EWDIG:
  3095'   0E 00                 	MVI	C,0
  3097'                         EW_LP:
  3097'   7D                    	MOV	A,L
  3098'   93                    	SUB	E
  3099'   6F                    	MOV	L,A
  309A'   7C                    	MOV	A,H
  309B'   9A                    	SBB	D
  309C'   67                    	MOV	H,A
  309D'   DA 30A4'              	JC	EW_DN
  30A0'   0C                    	INR	C
  30A1'   C3 3097'              	JMP	EW_LP
  30A4'                         EW_DN:
  30A4'   19                    	DAD	D		; one subtraction too many: give it back
  30A5'   79                    	MOV	A,C
  30A6'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-149


  30A7'   C2 30AD'              	JNZ	EW_PR
  30AA'   78                    	MOV	A,B
  30AB'   B7                    	ORA	A
  30AC'   C8                    	RZ			; a leading zero: write nothing
  30AD'                         EW_PR:
  30AD'   79                    	MOV	A,C
  30AE'   C6 30                 	ADI	'0'
  30B0'   CD 0000*              	CALL	OUTCH
  30B3'   06 01                 	MVI	B,1
  30B5'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  30B6'                         ISEMPT:
  30B6'   2A 0000*              	LHLD	OUTPOS
  30B9'   7C                    	MOV	A,H
  30BA'   B5                    	ORA	L
  30BB'   C0                    	RNZ
  30BC'   CD 0000*              	CALL	LOGLEN
  30BF'   7C                    	MOV	A,H
  30C0'   B5                    	ORA	L
  30C1'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  30C2'                         MSGCTG:
  30C2'   21 0000*              	LXI	H,FNAME
  30C5'   CD 2FCF'              	CALL	MSGNAM
  30C8'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  30CA'   CD 3037'              	CALL	MSGFLG
  30CD'   CD 30B6'              	CALL	ISEMPT
  30D0'   C2 30D9'              	JNZ	MG_POS
  30D3'   21 29F5'              	LXI	H,SNOLIN
  30D6'   C3 0000*              	JMP	OUTSTR
  30D9'                         MG_POS:
  30D9'   21 29E8'              	LXI	H,SLINE
  30DC'   CD 0000*              	CALL	OUTSTR
  30DF'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  30E2'   23                    	INX	H		;   ... so the line it is on
  30E3'   CD 3070'              	CALL	EMITW
  30E6'   21 29EF'              	LXI	H,SCOLM
  30E9'   CD 0000*              	CALL	OUTSTR
  30EC'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  30EF'   23                    	INX	H
  30F0'   E5                    	PUSH	H
  30F1'   CD 3070'              	CALL	EMITW
  30F4'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  30F7'   23                    	INX	H
  30F8'   D1                    	POP	D
  30F9'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  30FC'   C8                    	RZ
  30FD'   E5                    	PUSH	H
  30FE'   3E 2D                 	MVI	A,'-'
  3100'   CD 0000*              	CALL	OUTCH
	MACRO-80 3.44	09-Dec-81	PAGE	1-150


  3103'   E1                    	POP	H
  3104'   C3 3070'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  3107'                         FILMSG:
  3107'   3A 0001*              	LDA	FNAME+1
  310A'   FE 20                 	CPI	' '
  310C'   C8                    	RZ
  310D'   21 0000*              	LXI	H,FNAME
  3110'   CD 2FCF'              	CALL	MSGNAM
  3113'   AF                    	XRA	A		; nothing has been changed yet
  3114'   C3 3037'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  3117'                         WRMSG:
  3117'   21 0000*              	LXI	H,TFCB
  311A'   CD 2FCF'              	CALL	MSGNAM
  311D'   21 2A07'              	LXI	H,SWRIT
  3120'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  3123'                         MSGPST:
  3123'   3A 0000*              	LDA	MSGWHT
  3126'   B7                    	ORA	A
  3127'   C8                    	RZ
  3128'   47                    	MOV	B,A
  3129'   AF                    	XRA	A
  312A'   32 0000*              	STA	MSGWHT
  312D'   78                    	MOV	A,B
  312E'   FE 01                 	CPI	MW_FIL
  3130'   CA 3157'              	JZ	MP_FIL
  3133'   FE 02                 	CPI	MW_WRT
  3135'   CA 315D'              	JZ	MP_WRT
  3138'   FE 04                 	CPI	MW_BIG
  313A'   CA 314E'              	JZ	MP_BIG
  313D'   FE 05                 	CPI	MW_MEM
  313F'   CA 3148'              	JZ	MP_MEM
  3142'   CD 30C2'              	CALL	MSGCTG
  3145'   C3 0000*              	JMP	SCURS
  3148'                         MP_MEM:
  3148'   21 2995'              	LXI	H,SMEM
  314B'   C3 3151'              	JMP	MP_BG
  314E'                         MP_BIG:
  314E'   21 2983'              	LXI	H,SQBIG
  3151'                         MP_BG:
  3151'   CD 0000*              	CALL	EXMSG
  3154'   C3 0000*              	JMP	SCURS
  3157'                         MP_FIL:
  3157'   CD 3107'              	CALL	FILMSG
  315A'   C3 0000*              	JMP	SCURS
  315D'                         MP_WRT:
