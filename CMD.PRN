  2988'   024A'                 	DW	VC_TB
  298A'   3B                    	DB	';'
  298B'   0266'                 	DW	VC_SEMI
  298D'   2C                    	DB	','
  298E'   0270'                 	DW	VC_COMMA
  2990'   79                    	DB	'y'
  2991'   179C'                 	DW	VC_Y
  2993'   59                    	DB	'Y'
  2994'   17A4'                 	DW	VY_YY
  2996'   70                    	DB	'p'
  2997'   19DA'                 	DW	VC_P
  2999'   50                    	DB	'P'
  299A'   19EF'                 	DW	VCB_P
  299C'   69                    	DB	'i'
