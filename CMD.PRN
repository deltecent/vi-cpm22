                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the current row is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; current line changed only -> redraw that one row
  0003                   C      R_DLIN	EQU	3		; one line deleted at the cursor row -> DL + redraw bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted mid-line -> ICH (no tail redraw)
  0005                   C      R_ILIN	EQU	5		; one line opened at the cursor row -> IL + redraw that row and the one above
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw that row + DL the one under it
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: its offset, then PGTOPM when it was set
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      
                         C      ;------------------------------------------------------------
                         C      ; KEY DECODER -- GETKEY return types (B) and action codes (C when B=KT_ACT).
                         C      ; See KEY.MAC.
                         C      ;------------------------------------------------------------
  0000                   C      KT_NONE EQU	0		; no key (unrecognised ESC sequence, discarded)
  0001                   C      KT_ACT	EQU	1		; C = ACT_xxx action code
  0002                   C      KT_CHAR EQU	2		; C = ASCII character (printable or control)
                         C      
  0001                   C      ACT_CURUP EQU	1		; cursor up    (ESC[A / ESC OA)
  0002                   C      ACT_CURDN EQU	2		; cursor down  (ESC[B / ESC OB)
  0003                   C      ACT_CURRT EQU	3		; cursor right (ESC[C / ESC OC)
  0004                   C      ACT_CURLT EQU	4		; cursor left  (ESC[D / ESC OD)
  0005                   C      ACT_LINST EQU	5		; Home / line start (ESC[H / ESC[1~)
  0006                   C      ACT_LINEN EQU	6		; End  / line end   (ESC[F / ESC[4~)
  0007                   C      ACT_PGUP  EQU	7		; page up   (ESC[5~)
  0008                   C      ACT_PGDN  EQU	8		; page down (ESC[6~)
  0009                   C      ACT_INS	  EQU	9		; Insert key (ESC[2~)
  000A                   C      ACT_DEL	  EQU	10		; Delete key (ESC[3~)
  000B                   C      ACT_ESC	  EQU	11		; lone ESC (after timeout)
  000B                   C      ACT_MAX	  EQU	11		; highest defined action code
                         C      
  01F4                   C      ESCTMO	EQU	500		; polls before a lone ESC is confirmed
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	COL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
                                	EXTRN	SCBOT, SCEOF, SCBOF, WFILL	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	DELLN, SETC0			; BUF.MAC -- WM line kill (dd)
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   CD 00D9'              	CALL	DOTPRE
  0003'   CD 0009'              	CALL	CDMODE
  0006'   C3 0130'              	JMP	DOTPOST
  0009'                         CDMODE:
  0009'   3A 2400'              	LDA	EDMODE
  000C'   FE 01                 	CPI	EM_INS
  000E'   CA 0019'              	JZ	CD_INS
  0011'   FE 02                 	CPI	EM_REP
  0013'   CA 001C'              	JZ	CD_REP
  0016'   C3 001F'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  0019'                         CD_INS:
  0019'   C3 17C1'              	JMP	VIINS
  001C'                         CD_REP:
  001C'   C3 1701'              	JMP	VIREP
                                
                                ;============================================================
                                ; VICMD -- command-mode key.  B = KT type, C = char / action.
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  001F'                         VICMD:
  001F'   78                    	MOV	A,B
  0020'   FE 00                 	CPI	KT_NONE
  0022'   C8                    	RZ			; discarded key
  0023'   FE 01                 	CPI	KT_ACT
  0025'   CA 00AB'              	JZ	VIC_ACT
  0028'   3A 2428'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002B'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  002D'   CA 1364'              	JZ	VR_DO
                                	;--- KT_CHAR: maybe a count digit ---
  0030'   79                    	MOV	A,C
  0031'   FE 31                 	CPI	'1'
  0033'   DA 003E'              	JC	VIC_NOTD	; < '1'
  0036'   FE 3A                 	CPI	'9'+1
  0038'   D2 003E'              	JNC	VIC_NOTD	; > '9'
  003B'   C3 004E'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  003E'                         VIC_NOTD:
  003E'   79                    	MOV	A,C
  003F'   FE 30                 	CPI	'0'
  0041'   C2 0076'              	JNZ	VICDSP
  0044'   2A 2401'              	LHLD	CMDCNT
  0047'   7C                    	MOV	A,H
  0048'   B5                    	ORA	L
  0049'   CA 0076'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  004C'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  004E'                         VICDIG:
  004E'   2A 2401'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0051'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0052'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0053'   29                    	DAD	H		; *2
  0054'   DA 006D'              	JC	VIC_SAT
  0057'   29                    	DAD	H		; *4
  0058'   DA 006D'              	JC	VIC_SAT
  005B'   19                    	DAD	D		; *5
  005C'   DA 006D'              	JC	VIC_SAT
  005F'   29                    	DAD	H		; *10
  0060'   DA 006D'              	JC	VIC_SAT
  0063'   79                    	MOV	A,C
  0064'   D6 30                 	SUI	'0'
  0066'   5F                    	MOV	E,A
  0067'   16 00                 	MVI	D,0
  0069'   19                    	DAD	D
  006A'   D2 0070'              	JNC	VIC_CNT
  006D'                         VIC_SAT:
  006D'   21 FFFF               	LXI	H,0FFFFH
  0070'                         VIC_CNT:
  0070'   22 2401'              	SHLD	CMDCNT
  0073'   C3 061F'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  0076'                         VICDSP:
  0076'   3A 2428'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  0079'   32 2429'              	STA	GSAVE
  007C'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  007D'   32 2428'              	STA	GPEND
  0080'   3A 242A'              	LDA	PENDOP
  0083'   32 242B'              	STA	PSAVE
  0086'   AF                    	XRA	A
  0087'   32 242A'              	STA	PENDOP
  008A'   3A 242B'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  008D'   B7                    	ORA	A
  008E'   C2 0EF9'              	JNZ	OPPEND
  0091'   3A 2429'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0094'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  0096'   C2 009F'              	JNZ	VIC_TB
  0099'   79                    	MOV	A,C
  009A'   FE 5A                 	CPI	'Z'
  009C'   C2 00A5'              	JNZ	VIC_SW
  009F'                         VIC_TB:
  009F'   21 232F'              	LXI	H,CMDTAB
  00A2'   C3 00BE'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A5'                         VIC_SW:
  00A5'   CD 061F'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00A8'   C3 05B2'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AB'                         VIC_ACT:
  00AB'   AF                    	XRA	A		; action key clears all pending state
  00AC'   32 2428'              	STA	GPEND
  00AF'   32 2429'              	STA	GSAVE
  00B2'   32 242A'              	STA	PENDOP
  00B5'   32 242B'              	STA	PSAVE
  00B8'   21 23E7'              	LXI	H,ACTTAB
  00BB'   C3 00BE'              	JMP	VSCANQ
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the two TOP-LEVEL key tables, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00BE'                         VSCANQ:
  00BE'   CD 00CA'              	CALL	VSCLK
  00C1'   CA 00A5'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C4'   E9                    	PCHL
  00C5'                         VSCAN:
  00C5'   CD 00CA'              	CALL	VSCLK
  00C8'   C8                    	RZ			; miss
  00C9'   E9                    	PCHL
  00CA'                         VSCLK:
  00CA'   7E                    VSCAN1: MOV	A,M
  00CB'   B7                    	ORA	A
  00CC'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00CD'   23                    	INX	H
  00CE'   B9                    	CMP	C
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00CF'   5E                    	MOV	E,M
  00D0'   23                    	INX	H
  00D1'   56                    	MOV	D,M
  00D2'   23                    	INX	H
  00D3'   C2 00CA'              	JNZ	VSCAN1
  00D6'   EB                    	XCHG			; HL = the handler
  00D7'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00D8'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00D9'                         DOTPRE:
  00D9'   3A 241F'              	LDA	DOTRPL
  00DC'   B7                    	ORA	A
  00DD'   C0                    	RNZ			; the replay's own keys are not recorded
  00DE'   C5                    	PUSH	B
  00DF'   D5                    	PUSH	D
  00E0'   E5                    	PUSH	H
  00E1'   3A 241E'              	LDA	DOTSTA
  00E4'   B7                    	ORA	A
  00E5'   CA 00F8'              	JZ	DOTP1
  00E8'   AF                    	XRA	A		; a new command: the recording starts over
  00E9'   32 241E'              	STA	DOTSTA
  00EC'   32 2420'              	STA	DOTOVF
  00EF'   21 0000*              	LXI	H,DOTSCR
  00F2'   22 2422'              	SHLD	DOTSP
  00F5'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00F8'                         DOTP1:
  00F8'   78                    	MOV	A,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00F9'   FE 00                 	CPI	KT_NONE
  00FB'   CA 0124'              	JZ	DOTPX		; a discarded key is not a keystroke
  00FE'   FE 01                 	CPI	KT_ACT
  0100'   79                    	MOV	A,C
  0101'   CA 0109'              	JZ	DOTP2
  0104'   E6 7F                 	ANI	7FH		; a char stands for itself (CPYGAP masks inserts
  0106'   C3 010B'              	JMP	DOTP3		;   the same way), bit 7 marks an action key
  0109'                         DOTP2:
  0109'   F6 80                 	ORI	80H		; an action key (an arrow) rides in bit 7
  010B'                         DOTP3:
  010B'   32 2421'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  010E'   47                    	MOV	B,A
  010F'   2A 2422'              	LHLD	DOTSP
  0112'   EB                    	XCHG
  0113'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  0116'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  0119'   D2 0128'              	JNC	DOTPOV
  011C'   2A 2422'              	LHLD	DOTSP
  011F'   70                    	MOV	M,B
  0120'   23                    	INX	H
  0121'   22 2422'              	SHLD	DOTSP
  0124'                         DOTPX:
  0124'   E1                    	POP	H
  0125'   D1                    	POP	D
  0126'   C1                    	POP	B
  0127'   C9                    	RET
  0128'                         DOTPOV:
  0128'   3E 01                 	MVI	A,1
  012A'   32 2420'              	STA	DOTOVF		; too long to record: give this recording up
  012D'   C3 0124'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  0130'                         DOTPOST:
  0130'   3A 241F'              	LDA	DOTRPL
  0133'   B7                    	ORA	A
  0134'   C0                    	RNZ
  0135'   3A 2400'              	LDA	EDMODE
  0138'   B7                    	ORA	A
  0139'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  013A'   3A 2428'              	LDA	GPEND
  013D'   B7                    	ORA	A
  013E'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  013F'   3A 242A'              	LDA	PENDOP
  0142'   B7                    	ORA	A
  0143'   C0                    	RNZ			; an operator still waiting for its motion
  0144'   2A 2401'              	LHLD	CMDCNT
  0147'   7C                    	MOV	A,H
  0148'   B5                    	ORA	L
  0149'   CA 0157'              	JZ	DOTQ1
  014C'   3A 2421'              	LDA	DOTLK		; a digit with the count still up: the command
  014F'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  0151'   DA 0157'              	JC	DOTQ1
  0154'   FE 3A                 	CPI	'9'+1
  0156'   D8                    	RC
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0157'                         DOTQ1:
  0157'   3E 01                 	MVI	A,1
  0159'   32 241E'              	STA	DOTSTA		; the next key starts a new recording
  015C'   3A 241D'              	LDA	DOTCHG
  015F'   B7                    	ORA	A
  0160'   C8                    	RZ			; changed nothing: not a repeatable command
  0161'   AF                    	XRA	A
  0162'   32 241D'              	STA	DOTCHG
  0165'   32 2424'              	STA	DOTLEN
  0168'   3A 2420'              	LDA	DOTOVF
  016B'   B7                    	ORA	A
  016C'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  016D'   2A 2422'              	LHLD	DOTSP
  0170'   11 0000*              	LXI	D,DOTSCR
  0173'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  0176'   7D                    	MOV	A,L
  0177'   32 2424'              	STA	DOTLEN
  017A'   B7                    	ORA	A
  017B'   C8                    	RZ
  017C'   4F                    	MOV	C,A
  017D'   06 00                 	MVI	B,0
  017F'   21 0000*              	LXI	H,DOTSCR
  0182'   11 0000*              	LXI	D,DOTBUF
  0185'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  0188'                         MARKMOD:
  0188'   CD 03F5'              	CALL	MKDROP		; any mark this edit leaves pointing wrong
  018B'   3E 01                 	MVI	A,1
  018D'   32 2404'              	STA	MODF
  0190'   32 241D'              	STA	DOTCHG
  0193'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  0194'                         VC_DOT:
  0194'   2A 2401'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0197'   22 2426'              	SHLD	DOTNCT
  019A'   21 0000               	LXI	H,0
  019D'   22 2401'              	SHLD	CMDCNT
  01A0'   3A 2424'              	LDA	DOTLEN
  01A3'   B7                    	ORA	A
  01A4'   CA 01FE'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
  01A7'   AF                    	XRA	A
  01A8'   32 2425'              	STA	DOTIX
  01AB'   2A 2426'              	LHLD	DOTNCT
  01AE'   7C                    	MOV	A,H
  01AF'   B5                    	ORA	L
  01B0'   CA 01D0'              	JZ	DOTGO
  01B3'   22 2401'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  01B6'                         DOTSKP:
  01B6'   CD 048B'              	CALL	DOTGET		; ... so step past the digits it recorded
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01B9'   DA 01D0'              	JC	DOTGO
  01BC'   FE 30                 	CPI	'0'
  01BE'   DA 01D0'              	JC	DOTGO
  01C1'   FE 3A                 	CPI	'9'+1
  01C3'   D2 01D0'              	JNC	DOTGO
  01C6'   3A 2425'              	LDA	DOTIX
  01C9'   3C                    	INR	A
  01CA'   32 2425'              	STA	DOTIX
  01CD'   C3 01B6'              	JMP	DOTSKP
  01D0'                         DOTGO:
  01D0'   3E 01                 	MVI	A,1
  01D2'   32 241F'              	STA	DOTRPL
  01D5'                         DOTLP:
  01D5'   CD 048B'              	CALL	DOTGET
  01D8'   DA 01F4'              	JC	DOTDN
  01DB'   4F                    	MOV	C,A
  01DC'   06 02                 	MVI	B,KT_CHAR
  01DE'   B7                    	ORA	A
  01DF'   F2 01E7'              	JP	DOTLP2
  01E2'   E6 7F                 	ANI	7FH		; bit 7: the key was an action, not a char
  01E4'   4F                    	MOV	C,A
  01E5'   06 01                 	MVI	B,KT_ACT
  01E7'                         DOTLP2:
  01E7'   3A 2425'              	LDA	DOTIX
  01EA'   3C                    	INR	A
  01EB'   32 2425'              	STA	DOTIX
  01EE'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01F1'   C3 01D5'              	JMP	DOTLP
  01F4'                         DOTDN:
  01F4'   AF                    	XRA	A
  01F5'   32 241F'              	STA	DOTRPL
  01F8'   32 241D'              	STA	DOTCHG		; the '.' is not itself the new last change
  01FB'   C3 0640'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01FE'                         DOTBEL:
  01FE'   0E 07                 	MVI	C,BEL
  0200'   CD 0000*              	CALL	BCONOU
  0203'   C3 061F'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a logical offset plus the PGTOPM the window carried when it was
                                ; set.  It is DROPPED, never shifted, the moment it could no longer point at
                                ; the same text: MKDROP clears it when an edit happens at or before it, and a
                                ; jump refuses when the window has paged since.  That is the decided
                                ; behaviour -- a mark that survived an edit above it would point somewhere
                                ; plausible and wrong, which is worse than one that admits it is gone.
                                ;
                                ; DEVIATION from vim, deliberate and in COMMANDS.md: vim shifts a mark to
                                ; follow the text.  A consequence worth knowing is that '.' after a 'd''a'
                                ; refuses, because the delete drops the very mark the replay would need.
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  0206'                         MKVAD:
  0206'   16 00                 	MVI	D,0
  0208'   59                    	MOV	E,C
  0209'   21 2483'              	LXI	H,MKVAL
  020C'   19                    	DAD	D
  020D'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  020E'                         MKCLR:
  020E'   21 2483'              	LXI	H,MKVAL
  0211'   06 03                 	MVI	B,MKMAX
  0213'   AF                    	XRA	A
  0214'                         MKC_LP:
  0214'   77                    	MOV	M,A
  0215'   23                    	INX	H
  0216'   05                    	DCR	B
  0217'   C2 0214'              	JNZ	MKC_LP
  021A'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was not a character.
  021B'                         MKGETK:
  021B'   3A 241F'              	LDA	DOTRPL
  021E'   B7                    	ORA	A
  021F'   CA 0230'              	JZ	MKG_KB
  0222'   CD 048B'              	CALL	DOTGET		; the recording's next key
  0225'   D8                    	RC
  0226'   4F                    	MOV	C,A
  0227'   3A 2425'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  022A'   3C                    	INR	A
  022B'   32 2425'              	STA	DOTIX
  022E'   B7                    	ORA	A		; CY clear
  022F'   C9                    	RET
  0230'                         MKG_KB:
  0230'   CD 0000*              	CALL	GETKEY
  0233'   78                    	MOV	A,B
  0234'   FE 02                 	CPI	KT_CHAR
  0236'   37                    	STC
  0237'   C0                    	RNZ			; an action key (ESC) cancels the command
  0238'   B7                    	ORA	A		; CY clear
  0239'   C9                    	RET
                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
                                ; the motion returns.  Unlike the marks, the character is then handed to
                                ; DOTPRE, so it joins the recording and '.' can repeat "dfa" -- MKGETK's
                                ; keyboard path does not record for itself.
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
                                ;============================================================
  023A'                         VC_FF:				; 'f' -- forward, onto the character
  023A'   3E 66                 	MVI	A,'f'
  023C'   C3 024B'              	JMP	FNDNEW
  023F'                         VC_FB:				; 'F' -- backward, onto it
  023F'   3E 46                 	MVI	A,'F'
  0241'   C3 024B'              	JMP	FNDNEW
  0244'                         VC_TF:				; 't' -- forward, up to it
  0244'   3E 74                 	MVI	A,'t'
  0246'   C3 024B'              	JMP	FNDNEW
  0249'                         VC_TB:				; 'T' -- backward, up to it
  0249'   3E 54                 	MVI	A,'T'
  024B'                         FNDNEW:
  024B'   32 2478'              	STA	FNDKND		; the find ';' and ',' will repeat
  024E'   CD 021B'              	CALL	MKGETK		; the character it looks for
  0251'   DA 0288'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0254'   79                    	MOV	A,C
  0255'   32 2479'              	STA	FNDCH
  0258'   06 02                 	MVI	B,KT_CHAR	; ... and into the '.' recording (see the head)
  025A'   CD 00D9'              	CALL	DOTPRE
  025D'   3A 2478'              	LDA	FNDKND
  0260'   06 01                 	MVI	B,1		; a find starts at the next character along
  0262'   C3 028F'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0265'                         VC_SEMI:
  0265'   3A 2478'              	LDA	FNDKND
  0268'   B7                    	ORA	A
  0269'   CA 0288'              	JZ	FNDNIL		; nothing has been looked for yet
  026C'   C3 0278'              	JMP	FNDREP
  026F'                         VC_COMMA:
  026F'   3A 2478'              	LDA	FNDKND
  0272'   B7                    	ORA	A
  0273'   CA 0288'              	JZ	FNDNIL
  0276'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0278'                         FNDREP:
  0278'   06 01                 	MVI	B,1
  027A'   F5                    	PUSH	PSW
  027B'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  027D'   FE 54                 	CPI	'T'
  027F'   C2 0284'              	JNZ	FNDR_GO
  0282'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  0284'                         FNDR_GO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  0284'   F1                    	POP	PSW
  0285'   C3 028F'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
  0288'                         FNDNIL:
  0288'   AF                    	XRA	A
  0289'   32 242B'              	STA	PSAVE
  028C'   C3 061F'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  028F'                         FNDGO:
  028F'   32 247A'              	STA	FNDRUN
  0292'   78                    	MOV	A,B
  0293'   32 247B'              	STA	FNDSTP
  0296'   CD 059F'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
  0299'   22 247C'              	SHLD	FNDN		; the occurrence wanted
  029C'   CD 0000*              	CALL	CUROFF
  029F'   22 247E'              	SHLD	FNDCUR
  02A2'   3A 247A'              	LDA	FNDRUN
  02A5'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  02A7'   CA 02DB'              	JZ	FNDBWD
  02AA'   2A 247E'              	LHLD	FNDCUR
  02AD'   CD 054A'              	CALL	EOLC		; HL = the line's last content character
  02B0'   22 2480'              	SHLD	FNDLIM
  02B3'   2A 247E'              	LHLD	FNDCUR
  02B6'   3A 247B'              	LDA	FNDSTP
  02B9'   5F                    	MOV	E,A
  02BA'   16 00                 	MVI	D,0
  02BC'   19                    	DAD	D		; HL = where the scan starts
  02BD'                         FNDF_LP:
  02BD'   EB                    	XCHG			; DE = the scan
  02BE'   2A 2480'              	LHLD	FNDLIM
  02C1'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  02C4'   EB                    	XCHG			; HL = the scan
  02C5'   CA 02CB'              	JZ	FNDF_AT		; the last character is still a candidate
  02C8'   D2 032D'              	JNC	FNDMIS		; past it: not on this line
  02CB'                         FNDF_AT:
  02CB'   CD 0334'              	CALL	FNDSEE		; Z iff this is the character
  02CE'   C2 02D7'              	JNZ	FNDF_NX
  02D1'   CD 033F'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02D4'   CA 0313'              	JZ	FNDHIT
  02D7'                         FNDF_NX:
  02D7'   23                    	INX	H
  02D8'   C3 02BD'              	JMP	FNDF_LP
  02DB'                         FNDBWD:
  02DB'   2A 247E'              	LHLD	FNDCUR
  02DE'   CD 050B'              	CALL	BOL		; HL = the line's first character
  02E1'   22 2480'              	SHLD	FNDLIM
  02E4'   2A 247E'              	LHLD	FNDCUR
  02E7'   3A 247B'              	LDA	FNDSTP
  02EA'   2F                    	CMA
  02EB'   5F                    	MOV	E,A
  02EC'   16 FF                 	MVI	D,0FFH
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02EE'   13                    	INX	D		; DE = -step
  02EF'   19                    	DAD	D		; HL = where the scan starts
  02F0'   D2 032D'              	JNC	FNDMIS		; ... off the front of the text altogether
  02F3'                         FNDB_LP:
  02F3'   EB                    	XCHG			; DE = the scan
  02F4'   2A 2480'              	LHLD	FNDLIM
  02F7'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02FA'   EB                    	XCHG			; HL = the scan
  02FB'   DA 032D'              	JC	FNDMIS		; before this line: not on it
  02FE'   CD 0334'              	CALL	FNDSEE
  0301'   C2 030A'              	JNZ	FNDB_NX
  0304'   CD 033F'              	CALL	FNDCNT
  0307'   CA 0313'              	JZ	FNDHIT
  030A'                         FNDB_NX:
  030A'   7C                    	MOV	A,H
  030B'   B5                    	ORA	L
  030C'   CA 032D'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
  030F'   2B                    	DCX	H
  0310'   C3 02F3'              	JMP	FNDB_LP
                                
                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  0313'                         FNDHIT:
  0313'   3A 247A'              	LDA	FNDRUN
  0316'   E6 5F                 	ANI	5FH
  0318'   FE 54                 	CPI	'T'
  031A'   C2 032A'              	JNZ	FNDLND
  031D'   3A 247A'              	LDA	FNDRUN
  0320'   E6 20                 	ANI	20H
  0322'   CA 0329'              	JZ	FNDH_BW
  0325'   2B                    	DCX	H		; forward 't': the character before it
  0326'   C3 032A'              	JMP	FNDLND
  0329'                         FNDH_BW:
  0329'   23                    	INX	H		; backward 'T': the character after it
  032A'                         FNDLND:
  032A'   C3 04A1'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  032D'                         FNDMIS:
  032D'   AF                    	XRA	A
  032E'   32 242B'              	STA	PSAVE
  0331'   C3 01FE'              	JMP	DOTBEL
                                
                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
  0334'                         FNDSEE:
  0334'   E5                    	PUSH	H
  0335'   CD 0000*              	CALL	CHARAT
  0338'   E1                    	POP	H
  0339'   47                    	MOV	B,A
  033A'   3A 2479'              	LDA	FNDCH
  033D'   B8                    	CMP	B
  033E'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


                                ; the scan and stays it.
  033F'                         FNDCNT:
  033F'   E5                    	PUSH	H
  0340'   2A 247C'              	LHLD	FNDN
  0343'   2B                    	DCX	H
  0344'   22 247C'              	SHLD	FNDN
  0347'   7C                    	MOV	A,H
  0348'   B5                    	ORA	L
  0349'   E1                    	POP	H
  034A'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  034B'                         ISFIND:
  034B'   E6 5F                 	ANI	5FH		; fold the case away
  034D'   FE 46                 	CPI	'F'
  034F'   C8                    	RZ
  0350'   FE 54                 	CPI	'T'
  0352'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  0353'                         VC_MK:
  0353'   3E 04                 	MVI	A,PM
  0355'   C3 035F'              	JMP	MKGO
  0358'                         VC_BQ:
  0358'   3E 05                 	MVI	A,PJ
  035A'   C3 035F'              	JMP	MKGO
  035D'                         VC_AQ:
  035D'   3E 06                 	MVI	A,PJL
  035F'                         MKGO:
  035F'   32 2488'              	STA	MKWHAT
  0362'   CD 059F'              	CALL	MOVCNT		; a count means nothing on any of the three
  0365'   CD 021B'              	CALL	MKGETK		; the key that names the mark
  0368'   DA 03D5'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out -- the letter is read here and so
                                				;   was never recorded, which is why a '.'
                                				;   after "d'a" refuses (COMMANDS.md).  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist: 'm' with any other key
                                ;drops the whole thing, as vim's 'Z{other}' does, and a jump to one is a jump
                                ;to a mark that is not set.
  036B'                         MKOP:
  036B'   79                    	MOV	A,C
  036C'   D6 61                 	SUI	'a'
  036E'   FE 03                 	CPI	MKMAX
  0370'   D2 03CD'              	JNC	MKNOLT		; not a mark letter
  0373'   4F                    	MOV	C,A		; C = the mark's index
  0374'   87                    	ADD	A
  0375'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  0376'   5F                    	MOV	E,A
  0377'   16 00                 	MVI	D,0
  0379'   21 0000*              	LXI	H,MKTAB
  037C'   19                    	DAD	D		; HL -> this mark's slot
  037D'   3A 2488'              	LDA	MKWHAT
  0380'   FE 04                 	CPI	PM
  0382'   CA 03DC'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark.  It refuses, with vim's 'Mark not set', when
                                ;the mark was never set or when the window has paged away from under it.
  0385'                         MKJMP:
  0385'   E5                    	PUSH	H
  0386'   CD 0206'              	CALL	MKVAD
  0389'   7E                    	MOV	A,M
  038A'   E1                    	POP	H
  038B'   B7                    	ORA	A
  038C'   CA 03C3'              	JZ	MKNSET		; never set
  038F'   5E                    	MOV	E,M
  0390'   23                    	INX	H
  0391'   56                    	MOV	D,M		; DE = the offset it holds
  0392'   23                    	INX	H
  0393'   7E                    	MOV	A,M
  0394'   23                    	INX	H
  0395'   66                    	MOV	H,M
  0396'   6F                    	MOV	L,A		; HL = the window signature it was set under
  0397'   D5                    	PUSH	D
  0398'   EB                    	XCHG			; DE = that signature
  0399'   2A 0000*              	LHLD	PGTOPM
  039C'   7D                    	MOV	A,L
  039D'   BB                    	CMP	E
  039E'   C2 03BD'              	JNZ	MKSTAL
  03A1'   7C                    	MOV	A,H
  03A2'   BA                    	CMP	D
  03A3'   C2 03BD'              	JNZ	MKSTAL
  03A6'   CD 0DF6'              	CALL	GZONE		; the screen's top line, before the cursor
                                				;   moves: GPLACE measures the landing against
                                				;   it, and one left over from an earlier 'G'
                                				;   had it keep a window the line is not in
  03A9'   3A 2488'              	LDA	MKWHAT		; decided BEFORE the GOTO, so no register of
  03AC'   FE 06                 	CPI	PJL		;   ours has to survive a BUF primitive
  03AE'   CA 03B6'              	JZ	MKJ_GO		; ''': GPKEEP is 0, so GPLACE finds the first
  03B1'   3E 01                 	MVI	A,1		;   non-blank
  03B3'   32 2482'              	STA	GPKEEP		; '`': land on the column it was set at
  03B6'                         MKJ_GO:
  03B6'   E1                    	POP	H		; HL = the offset
  03B7'   CD 0000*              	CALL	GOTO
  03BA'   C3 0E0E'              	JMP	GPLACE		; (which sets LNDLT itself)
  03BD'                         MKSTAL:
  03BD'   E1                    	POP	H		; the window paged: the mark is gone for good
  03BE'   CD 0206'              	CALL	MKVAD
  03C1'   36 00                 	MVI	M,0
                                				; ... and fall into MKNSET
                                
                                ;MKNSET -- a jump to a mark that will not answer: vim's E20 on the bottom row
                                ;(without the number, and without a bell, as every message here), the cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


                                ;and the screen left alone.  The operator is cancelled as MKBAD cancels it.
  03C3'                         MKNSET:
  03C3'   AF                    	XRA	A
  03C4'   32 242B'              	STA	PSAVE
  03C7'   21 1DE0'              	LXI	H,SMKNS
  03CA'   C3 1CF3'              	JMP	EXERR
  03CD'                         MKNOLT:
  03CD'   3A 2488'              	LDA	MKWHAT
  03D0'   FE 04                 	CPI	PM
  03D2'   C2 03C3'              	JNZ	MKNSET		; a jump: that mark is not set
                                				; 'm{other}': fall into MKBAD
                                
                                ;MKBAD -- no mark was named: 'm' with a key that is not a mark letter, ESC in
                                ;place of the letter, or a '.' replay that ran out.  The bell, and an operator
                                ;running the motion is cancelled whole: PSAVE is what OPPEND's tail reads to
                                ;decide whether to open an insert, so clearing it stops a "c`z" opening one
                                ;over a span of nothing.
  03D5'                         MKBAD:
  03D5'   AF                    	XRA	A
  03D6'   32 242B'              	STA	PSAVE
  03D9'   C3 01FE'              	JMP	DOTBEL
                                
                                ;MKSET -- remember where the cursor is, and which window it is in.
  03DC'                         MKSET:
  03DC'   E5                    	PUSH	H
  03DD'   CD 0000*              	CALL	CUROFF		; HL = the cursor's logical offset
  03E0'   EB                    	XCHG
  03E1'   2A 0000*              	LHLD	PGTOPM
  03E4'   E3                    	XTHL			; HL = the slot, (SP) = the signature
  03E5'   73                    	MOV	M,E
  03E6'   23                    	INX	H
  03E7'   72                    	MOV	M,D
  03E8'   23                    	INX	H
  03E9'   D1                    	POP	D
  03EA'   73                    	MOV	M,E
  03EB'   23                    	INX	H
  03EC'   72                    	MOV	M,D
  03ED'   CD 0206'              	CALL	MKVAD
  03F0'   36 01                 	MVI	M,1		; ... and the mark is live
  03F2'   C3 061F'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKDROP -- an edit is happening at the cursor: drop every mark it could have
                                ;left pointing at different text.  A mark BEFORE the edit still names what it
                                ;named; one at or after it does not, because the text moved under it.  Called
                                ;from MARKMOD, so it must come back with every register as it found it.
  03F5'                         MKDROP:
  03F5'   F5                    	PUSH	PSW
  03F6'   3A 2489'              	LDA	MKHOLD		; a yank that could not copy takes its lines out
  03F9'   B7                    	ORA	A		;   and puts them back unchanged (YKGO): the text
  03FA'   C2 042F'              	JNZ	MKD_HL		;   every mark points into is still there
  03FD'   C5                    	PUSH	B
  03FE'   D5                    	PUSH	D
  03FF'   E5                    	PUSH	H
  0400'   CD 0000*              	CALL	CUROFF		; HL = where the edit is (CUROFF clobbers DE)
  0403'   22 2486'              	SHLD	MKEDIT
  0406'   21 2483'              	LXI	H,MKVAL
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  0409'   11 0000*              	LXI	D,MKTAB
  040C'   06 03                 	MVI	B,MKMAX
  040E'                         MKD_LP:
  040E'   7E                    	MOV	A,M
  040F'   B7                    	ORA	A
  0410'   CA 0423'              	JZ	MKD_NX		; that mark is not set: nothing to drop
  0413'   E5                    	PUSH	H
  0414'   2A 2486'              	LHLD	MKEDIT
  0417'   1A                    	LDAX	D		; the mark's offset, low
  0418'   95                    	SUB	L
  0419'   13                    	INX	D
  041A'   1A                    	LDAX	D		; ... and high (neither INX nor LDAX touch CY)
  041B'   1B                    	DCX	D
  041C'   9C                    	SBB	H		; CY iff the mark is BEFORE the edit
  041D'   E1                    	POP	H
  041E'   DA 0423'              	JC	MKD_NX
  0421'   36 00                 	MVI	M,0		; at it or after it: the mark is dropped
  0423'                         MKD_NX:
  0423'   23                    	INX	H
  0424'   13                    	INX	D
  0425'   13                    	INX	D
  0426'   13                    	INX	D
  0427'   13                    	INX	D
  0428'   05                    	DCR	B
  0429'   C2 040E'              	JNZ	MKD_LP
  042C'   E1                    	POP	H
  042D'   D1                    	POP	D
  042E'   C1                    	POP	B
  042F'                         MKD_HL:
  042F'   F1                    	POP	PSW
  0430'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  0431'                         VC_UNDO:
  0431'   21 0000               	LXI	H,0
  0434'   22 2401'              	SHLD	CMDCNT
  0437'   CD 0000*              	CALL	UNDO
  043A'   DA 046E'              	JC	UNDNO
  043D'   2A 0000*              	LHLD	UNDCUR
  0440'   CD 0454'              	CALL	UCLAMP		; vi never sits on a line terminator
  0443'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  0446'   CD 03F5'              	CALL	MKDROP		; the undo moved text back under any mark past it
  0449'   3E 01                 	MVI	A,1
  044B'   32 2404'              	STA	MODF		; undone past a ':w' still differs from the file
  044E'   CD 0792'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  0451'   C3 0640'              	JMP	SETFUL		; whole spans moved: repaint rather than guess
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  0454'                         UCLAMP:
  0454'   E5                    	PUSH	H
  0455'   CD 11AF'              	CALL	CEND		; HL = the line's content end
  0458'   D1                    	POP	D		; DE = the offset wanted
  0459'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  045C'   D2 0461'              	JNC	UCL_BK
  045F'   EB                    	XCHG
  0460'   C9                    	RET
  0461'                         UCL_BK:
  0461'   E5                    	PUSH	H		; the content end
  0462'   EB                    	XCHG			; HL = the offset wanted
  0463'   CD 050B'              	CALL	BOL
  0466'   D1                    	POP	D		; DE = the content end, HL = the line's start
  0467'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  046A'   EB                    	XCHG			; HL = the content end
  046B'   C8                    	RZ
  046C'   2B                    	DCX	H		; ... its last character
  046D'   C9                    	RET
  046E'                         UNDNO:
  046E'   3A 0000*              	LDA	UNDWHY
  0471'   B7                    	ORA	A
  0472'   CA 0483'              	JZ	UNDBEL
  0475'   21 1DAC'              	LXI	H,SUNDW		; the change has paged away: say so
  0478'   FE 01                 	CPI	1
  047A'   CA 1CF3'              	JZ	EXERR
  047D'   21 1DCE'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  0480'   C3 1CF3'              	JMP	EXERR
  0483'                         UNDBEL:
  0483'   0E 07                 	MVI	C,BEL
  0485'   CD 0000*              	CALL	BCONOU
  0488'   C3 061F'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  048B'                         DOTGET:
  048B'   3A 2425'              	LDA	DOTIX
  048E'   5F                    	MOV	E,A
  048F'   3A 2424'              	LDA	DOTLEN
  0492'   BB                    	CMP	E
  0493'   CA 049F'              	JZ	DOTGEF
  0496'   16 00                 	MVI	D,0
  0498'   21 0000*              	LXI	H,DOTBUF
  049B'   19                    	DAD	D
  049C'   7E                    	MOV	A,M
  049D'   B7                    	ORA	A		; CY clear: a key was returned
  049E'   C9                    	RET
  049F'                         DOTGEF:
  049F'   37                    	STC
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  04A0'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
  04A1'                         GOSET:
  04A1'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  04A4'                         SETGL:
  04A4'   CD 0DD0'              	CALL	ZSAVE
  04A7'   21 0000               	LXI	H,0
  04AA'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  04AD'   E5                    	PUSH	H
  04AE'   CD 0DE3'              	CALL	ZREST
  04B1'   E1                    	POP	H
  04B2'   E5                    	PUSH	H
  04B3'   CD 05AB'              	CALL	GBSUB		; HL = bytes to the cursor
  04B6'   44                    	MOV	B,H
  04B7'   4D                    	MOV	C,L
  04B8'   E1                    	POP	H		; HL = the line's start
  04B9'   11 0000               	LXI	D,0		; DE = screen column
  04BC'                         SG_LP:
  04BC'   78                    	MOV	A,B
  04BD'   B1                    	ORA	C
  04BE'   CA 04D3'              	JZ	SG_CUR
  04C1'   7E                    	MOV	A,M
  04C2'   23                    	INX	H
  04C3'   0B                    	DCX	B
  04C4'   E5                    	PUSH	H
  04C5'   6B                    	MOV	L,E
  04C6'   CD 04F8'              	CALL	CWID
  04C9'   E1                    	POP	H
  04CA'   83                    	ADD	E
  04CB'   5F                    	MOV	E,A
  04CC'   D2 04BC'              	JNC	SG_LP
  04CF'   14                    	INR	D
  04D0'   C3 04BC'              	JMP	SG_LP
  04D3'                         SG_CUR:
  04D3'   2A 0000*              	LHLD	TXTEND
  04D6'   D5                    	PUSH	D
  04D7'   EB                    	XCHG
  04D8'   2A 0000*              	LHLD	GAPEND
  04DB'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  04DE'   D1                    	POP	D
  04DF'   CA 04F3'              	JZ	SG_SET
  04E2'   7E                    	MOV	A,M
  04E3'   FE 09                 	CPI	TAB
  04E5'   C2 04F3'              	JNZ	SG_SET
  04E8'   6B                    	MOV	L,E
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04E9'   CD 04F8'              	CALL	CWID
  04EC'   3D                    	DCR	A		; the TAB's last column
  04ED'   83                    	ADD	E
  04EE'   5F                    	MOV	E,A
  04EF'   D2 04F3'              	JNC	SG_SET
  04F2'   14                    	INR	D
  04F3'                         SG_SET:
  04F3'   EB                    	XCHG
  04F4'   22 2409'              	SHLD	GOALCOL
  04F7'   C9                    	RET
                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  04F8'                         CWID:
  04F8'   FE 0D                 	CPI	CR
  04FA'   CA 0509'              	JZ	CW_0
  04FD'   FE 09                 	CPI	TAB
  04FF'   3E 01                 	MVI	A,1
  0501'   C0                    	RNZ
  0502'   7D                    	MOV	A,L
  0503'   E6 07                 	ANI	TABWID-1
  0505'   2F                    	CMA
  0506'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  0508'   C9                    	RET
  0509'                         CW_0:
  0509'   AF                    	XRA	A
  050A'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
  050B'                         BOL:
  050B'                         BOL_LP:
  050B'   7C                    	MOV	A,H
  050C'   B5                    	ORA	L
  050D'   C8                    	RZ			; at 0
  050E'   2B                    	DCX	H		; look at off-1
  050F'   E5                    	PUSH	H
  0510'   CD 0000*              	CALL	CHARAT
  0513'   E1                    	POP	H		; HL = off-1
  0514'   FE 0A                 	CPI	LF
  0516'   CA 051C'              	JZ	BOL_DN
  0519'   C3 050B'              	JMP	BOL_LP
  051C'                         BOL_DN:
  051C'   23                    	INX	H		; line starts just after the LF
  051D'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
  051E'                         EOLNL:
  051E'   E5                    	PUSH	H
  051F'   CD 0000*              	CALL	LOGLEN
  0522'   22 243D'              	SHLD	WKN
  0525'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  0526'                         ENL_LP:
  0526'   EB                    	XCHG			; DE = i
  0527'   2A 243D'              	LHLD	WKN
  052A'   CD 0000*              	CALL	CMP16		; DE=i vs HL=n: CY iff i < n
  052D'   EB                    	XCHG			; HL = i, DE = n
  052E'   D0                    	RNC			; i >= n: no LF on this line
  052F'   E5                    	PUSH	H
  0530'   CD 0000*              	CALL	CHARAT
  0533'   E1                    	POP	H
  0534'   FE 0A                 	CPI	LF
  0536'   C8                    	RZ			; the LF: HL is its offset
  0537'   23                    	INX	H
  0538'   C3 0526'              	JMP	ENL_LP
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  053B'                         NLSTART:
  053B'   CD 051E'              	CALL	EOLNL
  053E'   E5                    	PUSH	H
  053F'   CD 0000*              	CALL	LOGLEN
  0542'   D1                    	POP	D		; DE = eol result
  0543'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  0546'   C8                    	RZ			; no next line: HL = LOGLEN
  0547'   EB                    	XCHG			; HL = eol
  0548'   23                    	INX	H
  0549'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  054A'                         EOLC:
  054A'   E5                    	PUSH	H
  054B'   CD 051E'              	CALL	EOLNL
  054E'   22 243F'              	SHLD	WKTERM
  0551'   E1                    	POP	H
  0552'   CD 050B'              	CALL	BOL
  0555'   22 2441'              	SHLD	WKBOL
  0558'   2A 243F'              	LHLD	WKTERM
  055B'   EB                    	XCHG			; DE = term
  055C'   2A 2441'              	LHLD	WKBOL
  055F'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  0562'   CA 0581'              	JZ	EOLC_MT
  0565'   EB                    	XCHG			; HL = term
  0566'   2B                    	DCX	H		; term-1
  0567'   E5                    	PUSH	H
  0568'   CD 0000*              	CALL	CHARAT
  056B'   E1                    	POP	H		; HL = term-1
  056C'   FE 0D                 	CPI	CR
  056E'   CA 0574'              	JZ	EOLC_CR		; content ends at term-1
  0571'   C3 0575'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  0574'                         EOLC_CR:
  0574'   2B                    	DCX	H		; last = (term-1) - 1
  0575'                         EOLC_LS:
  0575'   EB                    	XCHG			; DE = last
  0576'   2A 2441'              	LHLD	WKBOL
  0579'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  057C'   DA 0581'              	JC	EOLC_MT
  057F'   EB                    	XCHG			; HL = last
  0580'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  0581'                         EOLC_MT:
  0581'   2A 2441'              	LHLD	WKBOL
  0584'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  0585'                         COL:
  0585'   E5                    	PUSH	H
  0586'   CD 050B'              	CALL	BOL
  0589'   D1                    	POP	D		; DE = off
  058A'   EB                    	XCHG			; HL = off, DE = bol
  058B'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  058E'                         ATENDQ:
  058E'   CD 0000*              	CALL	CUROFF
  0591'   E5                    	PUSH	H
  0592'   CD 0000*              	CALL	LOGLEN
  0595'   D1                    	POP	D		; DE = cur
  0596'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0599'                         CURCHR:
  0599'   CD 0000*              	CALL	CUROFF
  059C'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  059F'                         MOVCNT:
  059F'   CD 061F'              	CALL	SETMOV
  05A2'   C3 05B2'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  05A5'                         CNTOFF:
  05A5'   CD 05B2'              	CALL	GETCNT
  05A8'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  05AB'                         GBSUB:
  05AB'   EB                    	XCHG
  05AC'   2A 0000*              	LHLD	GAPBEG
  05AF'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  05B2'                         GETCNT:
  05B2'   2A 2401'              	LHLD	CMDCNT
  05B5'   7C                    	MOV	A,H
  05B6'   B5                    	ORA	L
  05B7'   C2 05BE'              	JNZ	GC_HAVE
  05BA'   21 0001               	LXI	H,1
  05BD'   C9                    	RET
  05BE'                         GC_HAVE:
  05BE'   E5                    	PUSH	H
  05BF'   21 0000               	LXI	H,0
  05C2'   22 2401'              	SHLD	CMDCNT
  05C5'   E1                    	POP	H
  05C6'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for a ^C break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  05C7'                         CNTTST:				; WM 1175
  05C7'   E5                    	PUSH	H
  05C8'   2A 2401'              	LHLD	CMDCNT
  05CB'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  05CE'   B4                    	ORA	H
  05CF'   B5                    	ORA	L
  05D0'   E1                    	POP	H
  05D1'   C3 0000*              	JMP	POLLBRK
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  05D4'                         CLASSF:
  05D4'   47                    	MOV	B,A
  05D5'   FE 20                 	CPI	' '
  05D7'   CA 0617'              	JZ	CLS0
  05DA'   FE 09                 	CPI	TAB
  05DC'   CA 0617'              	JZ	CLS0
  05DF'   FE 0A                 	CPI	LF
  05E1'   CA 0617'              	JZ	CLS0
  05E4'   FE 0D                 	CPI	CR
  05E6'   CA 0617'              	JZ	CLS0
  05E9'   3A 240B'              	LDA	WBIG
  05EC'   B7                    	ORA	A
  05ED'   C2 0619'              	JNZ	CLS1
  05F0'   78                    	MOV	A,B
  05F1'   FE 5F                 	CPI	'_'
  05F3'   CA 0619'              	JZ	CLS1
  05F6'   FE 30                 	CPI	'0'
  05F8'   DA 061C'              	JC	CLS2
  05FB'   FE 3A                 	CPI	'9'+1
  05FD'   DA 0619'              	JC	CLS1
  0600'   FE 41                 	CPI	'A'
  0602'   DA 061C'              	JC	CLS2
  0605'   FE 5B                 	CPI	'Z'+1
  0607'   DA 0619'              	JC	CLS1
  060A'   FE 61                 	CPI	'a'
  060C'   DA 061C'              	JC	CLS2
  060F'   FE 7B                 	CPI	'z'+1
  0611'   DA 0619'              	JC	CLS1
  0614'   C3 061C'              	JMP	CLS2
  0617'   AF                    CLS0:	XRA	A
  0618'   C9                    	RET
  0619'   3E 01                 CLS1:	MVI	A,1
  061B'   C9                    	RET
  061C'   3E 02                 CLS2:	MVI	A,2
  061E'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  061F'                         SETMOV:
  061F'   3E 01                 	MVI	A,R_MOVE
  0621'   32 2405'              	STA	RINTENT
  0624'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  0625'                         SETLIN:
  0625'   3E 02                 	MVI	A,R_LINE
  0627'   32 2405'              	STA	RINTENT
  062A'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  062B'                         SETILN:
  062B'   3E 01                 	MVI	A,1
  062D'   32 2406'              	STA	ILN		; one line, unless a put overwrites it below
  0630'   3E 05                 	MVI	A,R_ILIN
  0632'   32 2405'              	STA	RINTENT
  0635'   AF                    	XRA	A
  0636'   32 2408'              	STA	ILABOV		; the row above the opened ones is untouched
  0639'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  063A'                         SETJON:
  063A'   3E 06                 	MVI	A,R_JOIN
  063C'   32 2405'              	STA	RINTENT
  063F'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  0640'                         SETFUL:
  0640'   3E 00                 	MVI	A,R_FULL
  0642'   32 2405'              	STA	RINTENT
  0645'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB occurs from the cursor to the end of its line, else 0.
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


                                ; Scans forward from the cursor via CHARAT until LF or end of text (no gap move).
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  0646'                         TAILTAB:
  0646'   CD 0000*              	CALL	CUROFF
  0649'   22 2439'              	SHLD	TTI
  064C'                         TT_LP:
  064C'   2A 2439'              	LHLD	TTI
  064F'   EB                    	XCHG			; DE = TTI
  0650'   CD 0000*              	CALL	LOGLEN		; HL = LOGLEN
  0653'   CD 0000*              	CALL	CMP16		; CY iff TTI < LOGLEN
  0656'   D2 0676'              	JNC	TT_NO		; reached end of text -> no tab
  0659'   2A 2439'              	LHLD	TTI
  065C'   CD 0000*              	CALL	CHARAT
  065F'   FE 0A                 	CPI	LF
  0661'   CA 0676'              	JZ	TT_NO		; end of line -> no tab
  0664'   FE 09                 	CPI	TAB
  0666'   CA 0673'              	JZ	TT_YES
  0669'   2A 2439'              	LHLD	TTI
  066C'   23                    	INX	H
  066D'   22 2439'              	SHLD	TTI
  0670'   C3 064C'              	JMP	TT_LP
  0673'                         TT_YES:
  0673'   3E 01                 	MVI	A,1
  0675'   C9                    	RET
  0676'                         TT_NO:
  0676'   AF                    	XRA	A
  0677'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  0678'                         VC_H:
  0678'   CD 059F'              	CALL	MOVCNT		; a cursor motion, and its count
  067B'   22 2437'              	SHLD	CNTV
  067E'                         VCH_LP:
  067E'   2A 2437'              	LHLD	CNTV
  0681'   7C                    	MOV	A,H
  0682'   B5                    	ORA	L
  0683'   C8                    	RZ
  0684'   2B                    	DCX	H
  0685'   22 2437'              	SHLD	CNTV
  0688'   CD 068E'              	CALL	HSTEP
  068B'   C3 067E'              	JMP	VCH_LP
  068E'                         HSTEP:
  068E'   CD 0000*              	CALL	CUROFF		; HL = cur
  0691'   7C                    	MOV	A,H
  0692'   B5                    	ORA	L
  0693'   C8                    	RZ			; at 0
  0694'   E5                    	PUSH	H
  0695'   CD 050B'              	CALL	BOL		; HL = bol
  0698'   D1                    	POP	D		; DE = cur
  0699'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  069C'   C8                    	RZ			; at BOL, cannot go left
  069D'   EB                    	XCHG			; HL = cur
  069E'   2B                    	DCX	H
  069F'   C3 04A1'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06A2'                         VC_L:
  06A2'   CD 059F'              	CALL	MOVCNT		; a cursor motion, and its count
  06A5'   22 2437'              	SHLD	CNTV
  06A8'                         VCL_LP:
  06A8'   2A 2437'              	LHLD	CNTV
  06AB'   7C                    	MOV	A,H
  06AC'   B5                    	ORA	L
  06AD'   C8                    	RZ
  06AE'   2B                    	DCX	H
  06AF'   22 2437'              	SHLD	CNTV
  06B2'   CD 06B8'              	CALL	LSTEP
  06B5'   C3 06A8'              	JMP	VCL_LP
  06B8'                         LSTEP:
  06B8'   CD 0000*              	CALL	CUROFF		; HL = cur
  06BB'   E5                    	PUSH	H
  06BC'   CD 054A'              	CALL	EOLC		; HL = eolc
  06BF'   D1                    	POP	D		; DE = cur
  06C0'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  06C3'   D0                    	RNC			; cur >= eolc, cannot go right
  06C4'   EB                    	XCHG			; HL = cur
  06C5'   23                    	INX	H
  06C6'   C3 04A1'              	JMP	GOSET
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  06C9'                         VC_0:
  06C9'   CD 059F'              	CALL	MOVCNT		; a cursor motion, and its count
  06CC'   CD 06D6'              	CALL	LNSTRT
  06CF'   21 0000               	LXI	H,0
  06D2'   22 2409'              	SHLD	GOALCOL
  06D5'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  06D6'                         LNSTRT:
  06D6'   CD 0DD0'              	CALL	ZSAVE
  06D9'   21 0000               	LXI	H,0
  06DC'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  06DF'   E5                    	PUSH	H
  06E0'   CD 0DE3'              	CALL	ZREST
  06E3'   E1                    	POP	H
  06E4'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  06E7'                         VC_CRT:
  06E7'   CD 059F'              	CALL	MOVCNT		; a cursor motion, and its count
  06EA'   C3 06ED'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  06ED'                         FNBLNK:
  06ED'   CD 06D6'              	CALL	LNSTRT
  06F0'   CD 0000*              	CALL	RGET0
  06F3'   11 0000               	LXI	D,0		; DE = blanks skipped
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  06F6'                         FN_LP:
  06F6'   CD 0000*              	CALL	RDGET
  06F9'   DA 071C'              	JC	FN_GO		; the end of the file
  06FC'   FE 20                 	CPI	' '
  06FE'   CA 0706'              	JZ	FN_WH
  0701'   FE 09                 	CPI	TAB
  0703'   C2 071C'              	JNZ	FN_GO		; a non-blank, or the line's end
  0706'                         FN_WH:
  0706'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  0709'   DA 071C'              	JC	FN_GO
  070C'   FE 0D                 	CPI	CR
  070E'   CA 071C'              	JZ	FN_GO
  0711'   FE 0A                 	CPI	LF
  0713'   CA 071C'              	JZ	FN_GO
  0716'   2B                    	DCX	H		; not yet: read that char again
  0717'   03                    	INX	B
  0718'   13                    	INX	D
  0719'   C3 06F6'              	JMP	FN_LP
  071C'                         FN_GO:
  071C'   D5                    	PUSH	D
  071D'   CD 0000*              	CALL	CUROFF
  0720'   D1                    	POP	D
  0721'   19                    	DAD	D
  0722'   C3 04A1'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  0725'                         VC_EOL:
  0725'   CD 061F'              	CALL	SETMOV
  0728'   21 FFFF               	LXI	H,0FFFFH
  072B'   22 2409'              	SHLD	GOALCOL
  072E'   CD 05B2'              	CALL	GETCNT
  0731'   2B                    	DCX	H		; count-1
  0732'   7C                    	MOV	A,H
  0733'   B5                    	ORA	L
  0734'   CA 0743'              	JZ	VEOL_0
  0737'   E5                    	PUSH	H
  0738'   CD 0758'              	CALL	ONLAST
  073B'   E1                    	POP	H
  073C'   D8                    	RC			; the last line: no move (vim)
  073D'   CD 079B'              	CALL	JCORE
  0740'   C3 08EA'              	JMP	JKLAND
  0743'                         VEOL_0:
  0743'   CD 06D6'              	CALL	LNSTRT
  0746'   C3 08EA'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  0749'                         VC_CR:
  0749'   CD 059F'              	CALL	MOVCNT		; a cursor motion, and its count
  074C'   E5                    	PUSH	H
  074D'   CD 0758'              	CALL	ONLAST
  0750'   E1                    	POP	H
  0751'   D8                    	RC
  0752'   CD 079B'              	CALL	JCORE
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0755'   C3 06ED'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  0758'                         ONLAST:
  0758'   CD 0000*              	CALL	RGET0
  075B'                         OL_LP:
  075B'   CD 0000*              	CALL	RDGET
  075E'   D8                    	RC			; the file ends on this line
  075F'   FE 0A                 	CPI	LF
  0761'   C2 075B'              	JNZ	OL_LP
  0764'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  0767'                         VC_J:
  0767'   CD 061F'              	CALL	SETMOV
  076A'   CD 0785'              	CALL	GLCHK		; the goal column, from the cursor if stale
  076D'   CD 05B2'              	CALL	GETCNT		; HL = count
  0770'   CD 079B'              	CALL	JCORE
  0773'   C3 08EA'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  0776'                         VC_K:
  0776'   CD 061F'              	CALL	SETMOV
  0779'   CD 0785'              	CALL	GLCHK
  077C'   CD 05B2'              	CALL	GETCNT
  077F'   CD 0838'              	CALL	KCORE
  0782'   C3 08EA'              	JMP	JKLAND
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  0785'                         GLCHK:
  0785'   2A 2409'              	LHLD	GOALCOL
  0788'   7C                    	MOV	A,H
  0789'   3C                    	INR	A
  078A'   C0                    	RNZ
  078B'   7D                    	MOV	A,L
  078C'   FE FE                 	CPI	0FEH
  078E'   C0                    	RNZ
  078F'   C3 04A4'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  0792'                         GLSTAL:
  0792'   E5                    	PUSH	H
  0793'   21 FFFE               	LXI	H,0FFFEH
  0796'   22 2409'              	SHLD	GOALCOL
  0799'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  079A'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  079B'                         JCORE:
  079B'   7C                    	MOV	A,H
  079C'   B5                    	ORA	L
  079D'   C8                    	RZ
  079E'   22 240F'              	SHLD	JKCNT
  07A1'   CD 0BB1'              	CALL	CURRW		; limit = rows under the cursor's + NEDIT
  07A4'   47                    	MOV	B,A
  07A5'   3A 0000*              	LDA	NEDIT
  07A8'   3D                    	DCR	A
  07A9'   90                    	SUB	B
  07AA'   5F                    	MOV	E,A
  07AB'   16 00                 	MVI	D,0
  07AD'   3A 0000*              	LDA	NEDIT
  07B0'   6F                    	MOV	L,A
  07B1'   26 00                 	MVI	H,0
  07B3'   19                    	DAD	D
  07B4'   EB                    	XCHG			; DE = limit
  07B5'   2A 240F'              	LHLD	JKCNT
  07B8'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  07BB'   D2 07BF'              	JNC	JC_N
  07BE'   EB                    	XCHG			; HL = limit
  07BF'                         JC_N:
  07BF'   22 2411'              	SHLD	JKN		; N = min(count, limit)
  07C2'   EB                    	XCHG			; DE = LFs to find
  07C3'   CD 0000*              	CALL	RGET0
  07C6'                         JC_SC:
  07C6'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  07C9'   DA 07E8'              	JC	JC_EOF
  07CC'   32 2418'              	STA	JKLST
  07CF'   FE 0A                 	CPI	LF
  07D1'   C2 07C6'              	JNZ	JC_SC
  07D4'   1B                    	DCX	D
  07D5'   7A                    	MOV	A,D
  07D6'   B3                    	ORA	E
  07D7'   C2 07C6'              	JNZ	JC_SC
  07DA'   2A 240F'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  07DD'   22 2413'              	SHLD	JKMOV		;   one if the last LF found ends the file
  07E0'   3E 01                 	MVI	A,1
  07E2'   32 2417'              	STA	JKPHN
  07E5'   C3 0803'              	JMP	JC_MV
  07E8'                         JC_EOF:
  07E8'   2A 2411'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  07EB'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  07EE'   7C                    	MOV	A,H
  07EF'   B5                    	ORA	L
  07F0'   CA 07FC'              	JZ	JC_AV
  07F3'   3A 2418'              	LDA	JKLST
  07F6'   FE 0A                 	CPI	LF
  07F8'   C2 07FC'              	JNZ	JC_AV
  07FB'   2B                    	DCX	H
  07FC'                         JC_AV:
  07FC'   22 2413'              	SHLD	JKMOV
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07FF'   AF                    	XRA	A
  0800'   32 2417'              	STA	JKPHN
  0803'                         JC_MV:
  0803'   2A 240F'              	LHLD	JKCNT
  0806'   AF                    	XRA	A
  0807'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  080A'   CD 08C9'              	CALL	ATEOF
  080D'   D2 0821'              	JNC	JC_DN
  0810'   CD 08CF'              	CALL	LASTLN		; ran past the last line: back onto it
  0813'   3A 2417'              	LDA	JKPHN
  0816'   B7                    	ORA	A
  0817'   CA 0821'              	JZ	JC_DN
  081A'   2A 2413'              	LHLD	JKMOV
  081D'   2B                    	DCX	H
  081E'   22 2413'              	SHLD	JKMOV
  0821'                         JC_DN:
  0821'   2A 2411'              	LHLD	JKN		; LNDLT += min(moved, N)
  0824'   EB                    	XCHG
  0825'   2A 2413'              	LHLD	JKMOV
  0828'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  082B'   D2 082F'              	JNC	JC_AD
  082E'   EB                    	XCHG
  082F'                         JC_AD:
  082F'   EB                    	XCHG			; DE = lines moved
  0830'   2A 0000*              	LHLD	LNDLT
  0833'   19                    	DAD	D
  0834'   22 0000*              	SHLD	LNDLT
  0837'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  0838'                         KCORE:
  0838'   7C                    	MOV	A,H
  0839'   B5                    	ORA	L
  083A'   C8                    	RZ
  083B'   22 240F'              	SHLD	JKCNT
  083E'   CD 0BB1'              	CALL	CURRW		; limit = row + NEDIT
  0841'   5F                    	MOV	E,A
  0842'   16 00                 	MVI	D,0
  0844'   3A 0000*              	LDA	NEDIT
  0847'   6F                    	MOV	L,A
  0848'   26 00                 	MVI	H,0
  084A'   19                    	DAD	D
  084B'   EB                    	XCHG			; DE = limit
  084C'   2A 240F'              	LHLD	JKCNT
  084F'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0852'   D2 0856'              	JNC	KC_N
  0855'   EB                    	XCHG			; HL = limit
  0856'                         KC_N:
  0856'   22 2411'              	SHLD	JKN		; N = min(count, limit)
  0859'   EB                    	XCHG			; DE = LFs to find
  085A'   21 0000               	LXI	H,0
  085D'   22 2415'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  0860'                         KC_ED:
  0860'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0861'   2A 2415'              	LHLD	JKBK
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  0864'   CD 05AB'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0867'   E5                    	PUSH	H
  0868'   EB                    	XCHG
  0869'   2A 0000*              	LHLD	TXTBEG
  086C'   EB                    	XCHG
  086D'   CD 0000*              	CALL	SUBHD
  0870'   44                    	MOV	B,H
  0871'   4D                    	MOV	C,L
  0872'   E1                    	POP	H
  0873'   D1                    	POP	D
  0874'                         KC_SC:
  0874'   78                    	MOV	A,B
  0875'   B1                    	ORA	C
  0876'   CA 088D'              	JZ	KC_TB
  0879'   2B                    	DCX	H
  087A'   0B                    	DCX	B
  087B'   7E                    	MOV	A,M
  087C'   FE 0A                 	CPI	LF
  087E'   C2 0874'              	JNZ	KC_SC
  0881'   1B                    	DCX	D
  0882'   7A                    	MOV	A,D
  0883'   B3                    	ORA	E
  0884'   C2 0874'              	JNZ	KC_SC
  0887'   2A 240F'              	LHLD	JKCNT		; N lines above: the move is count lines
  088A'   C3 08AD'              	JMP	KC_MV
  088D'                         KC_TB:
  088D'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  088E'   CD 05AB'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0891'   22 2415'              	SHLD	JKBK
  0894'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0897'   7C                    	MOV	A,H
  0898'   B5                    	ORA	L
  0899'   CA 08A6'              	JZ	KC_B0
  089C'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  089F'   D1                    	POP	D
  08A0'   DA 08A7'              	JC	KC_BOF
  08A3'   C3 0860'              	JMP	KC_ED
  08A6'                         KC_B0:
  08A6'   D1                    	POP	D
  08A7'                         KC_BOF:
  08A7'   2A 2411'              	LHLD	JKN		; moved = LFs found
  08AA'   CD 0000*              	CALL	SUBHD
  08AD'                         KC_MV:
  08AD'   E5                    	PUSH	H
  08AE'   2A 240F'              	LHLD	JKCNT
  08B1'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  08B4'   D1                    	POP	D		; DE = moved
  08B5'   2A 2411'              	LHLD	JKN
  08B8'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  08BB'   DA 08BF'              	JC	KC_AD
  08BE'   EB                    	XCHG			; DE = N
  08BF'                         KC_AD:
  08BF'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  08C2'   CD 0000*              	CALL	SUBHD
  08C5'   22 0000*              	SHLD	LNDLT
  08C8'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  08C9'                         ATEOF:
  08C9'   CD 0000*              	CALL	RGET0
  08CC'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  08CF'                         LASTLN:
  08CF'   2A 0000*              	LHLD	GAPBEG
  08D2'   EB                    	XCHG
  08D3'   2A 0000*              	LHLD	TXTBEG
  08D6'   CD 0000*              	CALL	CMP16
  08D9'   21 0000               	LXI	H,0
  08DC'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  08DF'   1B                    	DCX	D
  08E0'   1A                    	LDAX	D
  08E1'   FE 0A                 	CPI	LF
  08E3'   C2 0000*              	JNZ	SETBWD
  08E6'   23                    	INX	H
  08E7'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  08EA'                         JKLAND:
  08EA'   21 0000               	LXI	H,0
  08ED'   22 2419'              	SHLD	JKVC		; screen column
  08F0'   2B                    	DCX	H
  08F1'   22 241B'              	SHLD	JKLS		; last content char: none yet
  08F4'   CD 0000*              	CALL	RGET0
  08F7'   11 0000               	LXI	D,0		; DE = chars read
  08FA'                         JL_RD:
  08FA'   CD 0000*              	CALL	RDGET
  08FD'   DA 0937'              	JC	JL_END
  0900'   FE 0A                 	CPI	LF
  0902'   CA 0937'              	JZ	JL_END
  0905'   E5                    	PUSH	H
  0906'   C5                    	PUSH	B
  0907'   2A 2419'              	LHLD	JKVC
  090A'   CD 04F8'              	CALL	CWID
  090D'   B7                    	ORA	A
  090E'   CA 0931'              	JZ	JL_NX		; a CR
  0911'   EB                    	XCHG
  0912'   22 241B'              	SHLD	JKLS		; the last content char so far
  0915'   EB                    	XCHG
  0916'   4F                    	MOV	C,A
  0917'   06 00                 	MVI	B,0
  0919'   09                    	DAD	B		; HL = the column after this char
  091A'   22 2419'              	SHLD	JKVC
  091D'   D5                    	PUSH	D
  091E'   EB                    	XCHG
  091F'   2A 2409'              	LHLD	GOALCOL
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  0922'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0925'   D1                    	POP	D
  0926'   DA 0931'              	JC	JL_NX
  0929'   CA 0931'              	JZ	JL_NX
  092C'   C1                    	POP	B		; this char holds the goal column
  092D'   E1                    	POP	H
  092E'   C3 0942'              	JMP	JL_GO
  0931'                         JL_NX:
  0931'   C1                    	POP	B
  0932'   E1                    	POP	H
  0933'   13                    	INX	D
  0934'   C3 08FA'              	JMP	JL_RD
  0937'                         JL_END:
  0937'   2A 241B'              	LHLD	JKLS		; past the line's end: its last content char
  093A'   7C                    	MOV	A,H
  093B'   A5                    	ANA	L
  093C'   3C                    	INR	A
  093D'   C2 0941'              	JNZ	JL_LS
  0940'   23                    	INX	H		; no content: the line's start
  0941'                         JL_LS:
  0941'   EB                    	XCHG
  0942'                         JL_GO:
  0942'   D5                    	PUSH	D		; DE = step from the line start
  0943'   CD 0000*              	CALL	CUROFF
  0946'   D1                    	POP	D
  0947'   19                    	DAD	D
  0948'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  094B'   AF                    VC_W:	XRA	A
  094C'   32 240B'              	STA	WBIG
  094F'   C3 0957'              	JMP	WDO
  0952'   3E 01                 VCBGW:	MVI	A,1
  0954'   32 240B'              	STA	WBIG
  0957'   CD 061F'              WDO:	CALL	SETMOV
  095A'   AF                    	XRA	A
  095B'   32 240C'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  095E'   CD 05B2'              	CALL	GETCNT
  0961'   22 2437'              	SHLD	CNTV
  0964'   2A 2437'              WDO_LP: LHLD	CNTV
  0967'   7C                    	MOV	A,H
  0968'   B5                    	ORA	L
  0969'   CA 0976'              	JZ	WDO_DN
  096C'   2B                    	DCX	H
  096D'   22 2437'              	SHLD	CNTV
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0970'   CD 09C6'              	CALL	FWD1
  0973'   D2 0964'              	JNC	WDO_LP
  0976'                         WDO_DN:
  0976'   CD 08C9'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0979'   DA 0986'              	JC	WDO_NL
  097C'   FE 0D                 	CPI	CR
  097E'   CA 0986'              	JZ	WDO_NL
  0981'   FE 0A                 	CPI	LF
  0983'   C2 04A4'              	JNZ	SETGL
  0986'                         WDO_NL:
  0986'   CD 0000*              	CALL	PEEKL
  0989'   DA 04A4'              	JC	SETGL
  098C'   FE 0A                 	CPI	LF
  098E'   CA 04A4'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0991'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0993'   32 240C'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0996'   CD 0AC1'              	CALL	DECC		; back onto its last char
  0999'   C3 04A4'              	JMP	SETGL
                                
  099C'   AF                    VC_B:	XRA	A
  099D'   32 240B'              	STA	WBIG
  09A0'   C3 09A8'              	JMP	BDO
  09A3'   3E 01                 VCBGB:	MVI	A,1
  09A5'   32 240B'              	STA	WBIG
  09A8'   CD 061F'              BDO:	CALL	SETMOV
  09AB'   CD 05B2'              	CALL	GETCNT
  09AE'   22 2437'              	SHLD	CNTV
  09B1'   2A 2437'              BDO_LP: LHLD	CNTV
  09B4'   7C                    	MOV	A,H
  09B5'   B5                    	ORA	L
  09B6'   CA 04A4'              	JZ	SETGL
  09B9'   2B                    	DCX	H
  09BA'   22 2437'              	SHLD	CNTV
  09BD'   CD 0A12'              	CALL	BCK1
  09C0'   D2 09B1'              	JNC	BDO_LP
  09C3'   C3 04A4'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char (it is left there).
  09C6'                         FWD1:
  09C6'   CD 0A45'              	CALL	CCLS
  09C9'   32 2443'              	STA	WKCLS		; the starting class
  09CC'   CD 0A7F'              	CALL	INCC
  09CF'   B7                    	ORA	A
  09D0'   CA 09E8'              	JZ	FW_WD
  09D3'   37                    	STC
  09D4'   F8                    	RM			; -1: already at the end
  09D5'   FE 02                 	CPI	2
  09D7'   C2 09E8'              	JNZ	FW_WD		; 1: a next line was reached
  09DA'   CD 08C9'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  09DD'   D4 0A66'              	CNC	NXLN
  09E0'   D2 09E8'              	JNC	FW_WD
  09E3'   CD 0AC1'              	CALL	DECC		; yes: back onto its last char, failed
  09E6'   37                    	STC
  09E7'   C9                    	RET
  09E8'                         FW_WD:
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  09E8'   3A 2443'              	LDA	WKCLS		; go past the rest of this word
  09EB'   B7                    	ORA	A
  09EC'   CA 0A01'              	JZ	FW_WS
  09EF'                         FW_WLP:
  09EF'   CD 0A45'              	CALL	CCLS
  09F2'   21 2443'              	LXI	H,WKCLS
  09F5'   BE                    	CMP	M
  09F6'   C2 0A01'              	JNZ	FW_WS
  09F9'   CD 0A7F'              	CALL	INCC
  09FC'   B7                    	ORA	A
  09FD'   F8                    	RM			; the end of the file (NC)
  09FE'   C3 09EF'              	JMP	FW_WLP
  0A01'                         FW_WS:
  0A01'   CD 0A45'              	CALL	CCLS		; then over blanks to the next word
  0A04'   B7                    	ORA	A
  0A05'   C0                    	RNZ
  0A06'   CD 0A4D'              	CALL	EMPTY
  0A09'   C8                    	RZ			; an empty line is a word
  0A0A'   CD 0A7F'              	CALL	INCC
  0A0D'   B7                    	ORA	A
  0A0E'   F8                    	RM
  0A0F'   C3 0A01'              	JMP	FW_WS
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0A12'                         BCK1:
  0A12'   CD 0AC1'              	CALL	DECC
  0A15'   B7                    	ORA	A
  0A16'   37                    	STC
  0A17'   F8                    	RM
  0A18'                         BK_WS:
  0A18'   CD 0A45'              	CALL	CCLS		; back over blanks
  0A1B'   B7                    	ORA	A
  0A1C'   C2 0A2C'              	JNZ	BK_WD
  0A1F'   CD 0A4D'              	CALL	EMPTY
  0A22'   C8                    	RZ			; an empty line is a word
  0A23'   CD 0AC1'              	CALL	DECC
  0A26'   B7                    	ORA	A
  0A27'   F2 0A18'              	JP	BK_WS
  0A2A'   AF                    	XRA	A		; the start of the file (NC)
  0A2B'   C9                    	RET
  0A2C'                         BK_WD:
  0A2C'   32 2443'              	STA	WKCLS		; back to the start of this word
  0A2F'                         BK_WLP:
  0A2F'   CD 0AC1'              	CALL	DECC
  0A32'   B7                    	ORA	A
  0A33'   FA 0A43'              	JM	BK_OK		; the start of the file
  0A36'   CD 0A45'              	CALL	CCLS
  0A39'   21 2443'              	LXI	H,WKCLS
  0A3C'   BE                    	CMP	M
  0A3D'   CA 0A2F'              	JZ	BK_WLP
  0A40'   CD 0A7F'              	CALL	INCC		; overshot: forward one
  0A43'                         BK_OK:
  0A43'   AF                    	XRA	A
  0A44'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0A45'                         CCLS:
  0A45'   CD 08C9'              	CALL	ATEOF
  0A48'   D2 05D4'              	JNC	CLASSF
  0A4B'   AF                    	XRA	A
  0A4C'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0A4D'                         EMPTY:
  0A4D'   CD 08C9'              	CALL	ATEOF
  0A50'   DA 0A5B'              	JC	EM_ST
  0A53'   FE 0D                 	CPI	CR
  0A55'   CA 0A5B'              	JZ	EM_ST
  0A58'   FE 0A                 	CPI	LF
  0A5A'   C0                    	RNZ
  0A5B'                         EM_ST:
  0A5B'   CD 0000*              	CALL	PEEKL
  0A5E'   DA 0A64'              	JC	EM_Y
  0A61'   FE 0A                 	CPI	LF
  0A63'   C9                    	RET
  0A64'                         EM_Y:
  0A64'   AF                    	XRA	A
  0A65'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0A66'                         NXLN:
  0A66'   FE 0A                 	CPI	LF
  0A68'   CA 0A77'              	JZ	NX_LF
  0A6B'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0A6E'   D8                    	RC
  0A6F'   FE 0A                 	CPI	LF
  0A71'   CA 0A77'              	JZ	NX_LF
  0A74'   2B                    	DCX	H		; a lone CR
  0A75'   AF                    	XRA	A
  0A76'   C9                    	RET
  0A77'                         NX_LF:
  0A77'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0A7A'   D8                    	RC
  0A7B'   2B                    	DCX	H
  0A7C'   3E 01                 	MVI	A,1
  0A7E'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0A7F'                         INCC:
  0A7F'   CD 08C9'              	CALL	ATEOF
  0A82'   DA 0ABD'              	JC	IC_END
  0A85'   FE 0D                 	CPI	CR
  0A87'   CA 0AA8'              	JZ	IC_NL
  0A8A'   FE 0A                 	CPI	LF
  0A8C'   CA 0AA8'              	JZ	IC_NL
  0A8F'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0A92'                         IC_CH:
  0A92'   CD 08C9'              	CALL	ATEOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0A95'   DA 0AA4'              	JC	IC_2
  0A98'   FE 0D                 	CPI	CR
  0A9A'   CA 0AA4'              	JZ	IC_2
  0A9D'   FE 0A                 	CPI	LF
  0A9F'   CA 0AA4'              	JZ	IC_2
  0AA2'   AF                    	XRA	A
  0AA3'   C9                    	RET
  0AA4'                         IC_2:
  0AA4'   3E 02                 	MVI	A,2
  0AA6'   B7                    	ORA	A
  0AA7'   C9                    	RET
  0AA8'                         IC_NL:
  0AA8'   CD 0A66'              	CALL	NXLN
  0AAB'   DA 0ABD'              	JC	IC_END
  0AAE'   F5                    	PUSH	PSW
  0AAF'   CD 0000*              	CALL	PUTCUR
  0AB2'   F1                    	POP	PSW
  0AB3'   B7                    	ORA	A
  0AB4'   CA 0A92'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0AB7'   CD 0AE3'              	CALL	LNINC
  0ABA'   3E 01                 	MVI	A,1
  0ABC'   C9                    	RET
  0ABD'                         IC_END:
  0ABD'   3E FF                 	MVI	A,0FFH
  0ABF'   B7                    	ORA	A
  0AC0'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0AC1'                         DECC:
  0AC1'   CD 0000*              	CALL	PEEKL
  0AC4'   DA 0ABD'              	JC	IC_END
  0AC7'   F5                    	PUSH	PSW
  0AC8'   CD 0000*              	CALL	PUTCUR
  0ACB'   F1                    	POP	PSW
  0ACC'   FE 0A                 	CPI	LF
  0ACE'   3E 00                 	MVI	A,0
  0AD0'   C0                    	RNZ
  0AD1'   CD 0AF1'              	CALL	LNDEC
  0AD4'   CD 0000*              	CALL	PEEKL		; onto its CR
  0AD7'   DA 0ADF'              	JC	DC_1
  0ADA'   FE 0D                 	CPI	CR
  0ADC'   CC 0000*              	CZ	PUTCUR
  0ADF'                         DC_1:
  0ADF'   3E 01                 	MVI	A,1
  0AE1'   B7                    	ORA	A
  0AE2'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0AE3'                         LNINC:
  0AE3'   E5                    	PUSH	H
  0AE4'   2A 0000*              	LHLD	LNDLT
  0AE7'   7C                    	MOV	A,H
  0AE8'   FE 40                 	CPI	40H
  0AEA'   CA 0AFF'              	JZ	LN_X
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0AED'   23                    	INX	H
  0AEE'   C3 0AFC'              	JMP	LN_ST
  0AF1'                         LNDEC:
  0AF1'   E5                    	PUSH	H
  0AF2'   2A 0000*              	LHLD	LNDLT
  0AF5'   7C                    	MOV	A,H
  0AF6'   FE C0                 	CPI	0C0H
  0AF8'   CA 0AFF'              	JZ	LN_X
  0AFB'   2B                    	DCX	H
  0AFC'                         LN_ST:
  0AFC'   22 0000*              	SHLD	LNDLT
  0AFF'                         LN_X:
  0AFF'   E1                    	POP	H
  0B00'   C9                    	RET
                                
  0B01'   AF                    VC_E:	XRA	A
  0B02'   32 240B'              	STA	WBIG
  0B05'   C3 0B0D'              	JMP	EDO
  0B08'   3E 01                 VCBGE:	MVI	A,1
  0B0A'   32 240B'              	STA	WBIG
  0B0D'   CD 061F'              EDO:	CALL	SETMOV
  0B10'   CD 05B2'              	CALL	GETCNT
  0B13'   22 2437'              	SHLD	CNTV
  0B16'   2A 2437'              EDO_LP: LHLD	CNTV
  0B19'   7C                    	MOV	A,H
  0B1A'   B5                    	ORA	L
  0B1B'   C8                    	RZ
  0B1C'   2B                    	DCX	H
  0B1D'   22 2437'              	SHLD	CNTV
  0B20'   CD 0B26'              	CALL	ESTEP
  0B23'   C3 0B16'              	JMP	EDO_LP
                                
                                ;ESTEP -- forward to the end of the next word.
  0B26'                         ESTEP:
  0B26'   CD 0000*              	CALL	CUROFF
  0B29'   22 243B'              	SHLD	WKI
  0B2C'   CD 0000*              	CALL	LOGLEN
  0B2F'   22 243D'              	SHLD	WKN
  0B32'   2A 243B'              	LHLD	WKI
  0B35'   23                    	INX	H
  0B36'   22 243B'              	SHLD	WKI
  0B39'                         ES_WS:
  0B39'   2A 243B'              	LHLD	WKI
  0B3C'   EB                    	XCHG
  0B3D'   2A 243D'              	LHLD	WKN
  0B40'   CD 0000*              	CALL	CMP16
  0B43'   D2 0B91'              	JNC	ES_LND
  0B46'   2A 243B'              	LHLD	WKI
  0B49'   CD 0000*              	CALL	CHARAT
  0B4C'   CD 05D4'              	CALL	CLASSF
  0B4F'   B7                    	ORA	A
  0B50'   C2 0B5D'              	JNZ	ES_WD
  0B53'   2A 243B'              	LHLD	WKI
  0B56'   23                    	INX	H
  0B57'   22 243B'              	SHLD	WKI
  0B5A'   C3 0B39'              	JMP	ES_WS
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0B5D'                         ES_WD:
  0B5D'   2A 243B'              	LHLD	WKI
  0B60'   CD 0000*              	CALL	CHARAT
  0B63'   CD 05D4'              	CALL	CLASSF
  0B66'   32 2443'              	STA	WKCLS
  0B69'                         ES_RUN:
  0B69'   2A 243B'              	LHLD	WKI
  0B6C'   23                    	INX	H
  0B6D'   EB                    	XCHG			; DE = i+1
  0B6E'   2A 243D'              	LHLD	WKN
  0B71'   CD 0000*              	CALL	CMP16		; DE=(i+1) vs HL=n: CY iff (i+1) < n
  0B74'   D2 0B91'              	JNC	ES_LND
  0B77'   2A 243B'              	LHLD	WKI
  0B7A'   23                    	INX	H
  0B7B'   E5                    	PUSH	H		; i+1
  0B7C'   CD 0000*              	CALL	CHARAT
  0B7F'   CD 05D4'              	CALL	CLASSF
  0B82'   E1                    	POP	H		; HL = i+1
  0B83'   47                    	MOV	B,A
  0B84'   3A 2443'              	LDA	WKCLS
  0B87'   B8                    	CMP	B
  0B88'   C2 0B91'              	JNZ	ES_LND
  0B8B'   22 243B'              	SHLD	WKI
  0B8E'   C3 0B69'              	JMP	ES_RUN
  0B91'                         ES_LND:
  0B91'   2A 243D'              	LHLD	WKN
  0B94'   EB                    	XCHG
  0B95'   2A 243B'              	LHLD	WKI
  0B98'   CD 0000*              	CALL	CMP16		; DE=n vs HL=i: CY iff n < i
  0B9B'   DA 0BA7'              	JC	ES_CL
  0B9E'   CA 0BA7'              	JZ	ES_CL
  0BA1'   2A 243B'              	LHLD	WKI
  0BA4'   C3 04A1'              	JMP	GOSET
  0BA7'                         ES_CL:
  0BA7'   2A 243D'              	LHLD	WKN
  0BAA'   7C                    	MOV	A,H
  0BAB'   B5                    	ORA	L
  0BAC'   C8                    	RZ
  0BAD'   2B                    	DCX	H
  0BAE'   C3 04A1'              	JMP	GOSET
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0BB1'                         CURRW:
  0BB1'   2A 0000*              	LHLD	WINROW
  0BB4'   EB                    	XCHG
  0BB5'   2A 0000*              	LHLD	LNDLT
  0BB8'   19                    	DAD	D		; HL = row (signed)
  0BB9'   7C                    	MOV	A,H
  0BBA'   B7                    	ORA	A
  0BBB'   FA 0BCE'              	JM	CRW_0		; above the screen -> top row
  0BBE'   C2 0BC9'              	JNZ	CRW_BT		; far below -> bottom row
  0BC1'   3A 0000*              	LDA	NEDIT
  0BC4'   3D                    	DCR	A		; A = bottom row
  0BC5'   BD                    	CMP	L		; CY iff bottom < row
  0BC6'   D8                    	RC
  0BC7'   7D                    	MOV	A,L
  0BC8'   C9                    	RET
  0BC9'                         CRW_BT:
  0BC9'   3A 0000*              	LDA	NEDIT
  0BCC'   3D                    	DCR	A
  0BCD'   C9                    	RET
  0BCE'                         CRW_0:
  0BCE'   AF                    	XRA	A
  0BCF'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0BD0'                         SETRWT:
  0BD0'   2A 0000*              	LHLD	LNDLT
  0BD3'   EB                    	XCHG
  0BD4'   6F                    	MOV	L,A
  0BD5'   26 00                 	MVI	H,0
  0BD7'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0BDA'   22 0000*              	SHLD	WINROW
  0BDD'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0BDE'                         MVROW:
  0BDE'   47                    	MOV	B,A
  0BDF'   CD 0BB1'              	CALL	CURRW
  0BE2'   90                    	SUB	B		; A = row now - target
  0BE3'   C8                    	RZ
  0BE4'   DA 0BED'              	JC	MR_DN
  0BE7'   6F                    	MOV	L,A
  0BE8'   26 00                 	MVI	H,0
  0BEA'   C3 0838'              	JMP	KCORE
  0BED'                         MR_DN:
  0BED'   2F                    	CMA
  0BEE'   3C                    	INR	A		; A = target - row now
  0BEF'   6F                    	MOV	L,A
  0BF0'   26 00                 	MVI	H,0
  0BF2'   C3 079B'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0BF5'                         VC_HIGH:
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0BF5'   CD 059F'              	CALL	MOVCNT		; a cursor motion, and its count
  0BF8'   2B                    	DCX	H		; row = count - 1
  0BF9'   7C                    	MOV	A,H
  0BFA'   B7                    	ORA	A
  0BFB'   3A 0000*              	LDA	SCBOT
  0BFE'   C2 0C06'              	JNZ	VH_GO		; >= 256 -> the last text row
  0C01'   BD                    	CMP	L		; CY iff SCBOT < row
  0C02'   DA 0C06'              	JC	VH_GO
  0C05'   7D                    	MOV	A,L
  0C06'                         VH_GO:
  0C06'   CD 0BDE'              	CALL	MVROW
  0C09'   C3 06ED'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0C0C'                         VC_MIDL:
  0C0C'   CD 059F'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0C0F'   3A 0000*              	LDA	SCBOT
  0C12'   B7                    	ORA	A		; clear CY for the shift
  0C13'   1F                    	RAR			; A = SCBOT / 2
  0C14'   CD 0BDE'              	CALL	MVROW
  0C17'   C3 06ED'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0C1A'                         VC_LOWL:
  0C1A'   CD 059F'              	CALL	MOVCNT		; a cursor motion, and its count
  0C1D'   2B                    	DCX	H		; count - 1
  0C1E'   3A 0000*              	LDA	SCBOT
  0C21'   5F                    	MOV	E,A
  0C22'   16 00                 	MVI	D,0
  0C24'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0C25'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0C28'   3E 00                 	MVI	A,0
  0C2A'   D2 0C31'              	JNC	VL_GO		; at or past the top -> row 0
  0C2D'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0C30'   7D                    	MOV	A,L
  0C31'                         VL_GO:
  0C31'   CD 0BDE'              	CALL	MVROW
  0C34'   C3 06ED'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0C37'                         VC_PGDN:
  0C37'   CD 059F'              	CALL	MOVCNT		; a cursor motion, and its count
  0C3A'   3A 0000*              	LDA	SCEOF
  0C3D'   B7                    	ORA	A
  0C3E'   CA 0C4C'              	JZ	VPD_N
  0C41'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0C44'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0C45'   C8                    	RZ			; it already is
  0C46'   CD 0BDE'              	CALL	MVROW
  0C49'   C3 0C5D'              	JMP	VPD_TP
  0C4C'                         VPD_N:
  0C4C'   3A 0000*              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0C4F'   D6 02                 	SUI	2
  0C51'   CD 0CA5'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0C54'   E5                    	PUSH	H
  0C55'   AF                    	XRA	A
  0C56'   CD 0BDE'              	CALL	MVROW		; the top line
  0C59'   E1                    	POP	H
  0C5A'   CD 079B'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0C5D'                         VPD_TP:
  0C5D'   AF                    	XRA	A
  0C5E'   CD 0BD0'              	CALL	SETRWT		; to the top row
  0C61'   C3 06ED'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0C64'                         VC_PGUP:
  0C64'   CD 059F'              	CALL	MOVCNT		; a cursor motion, and its count
  0C67'   3A 0000*              	LDA	SCBOF
  0C6A'   B7                    	ORA	A
  0C6B'   C0                    	RNZ
  0C6C'   3A 0000*              	LDA	NEDIT
  0C6F'   47                    	MOV	B,A
  0C70'   3A 0000*              	LDA	SCEOF
  0C73'   B7                    	ORA	A
  0C74'   CA 0C85'              	JZ	VPU_2
  0C77'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0C7A'   FE 02                 	CPI	2
  0C7C'   D2 0C85'              	JNC	VPU_2
  0C7F'   2F                    	CMA
  0C80'   3C                    	INR	A
  0C81'   80                    	ADD	B
  0C82'   C3 0C88'              	JMP	VPU_P
  0C85'                         VPU_2:
  0C85'   78                    	MOV	A,B
  0C86'   D6 02                 	SUI	2
  0C88'                         VPU_P:
  0C88'   CD 0CA5'              	CALL	MULSAT		; HL = count * page
  0C8B'   E5                    	PUSH	H
  0C8C'   AF                    	XRA	A
  0C8D'   CD 0BDE'              	CALL	MVROW		; the top line
  0C90'   E1                    	POP	H
  0C91'   CD 0838'              	CALL	KCORE		; the new top line
  0C94'   AF                    	XRA	A
  0C95'   CD 0BD0'              	CALL	SETRWT		; on the top row
  0C98'   3A 0000*              	LDA	NEDIT
  0C9B'   3D                    	DCR	A
  0C9C'   6F                    	MOV	L,A
  0C9D'   26 00                 	MVI	H,0
  0C9F'   CD 079B'              	CALL	JCORE		; the bottom row's line
  0CA2'   C3 06ED'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0CA5'                         MULSAT:
  0CA5'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0CA6'   21 0000               	LXI	H,0
  0CA9'   B7                    	ORA	A
  0CAA'   C8                    	RZ
  0CAB'                         MS_LP:
  0CAB'   19                    	DAD	D
  0CAC'   DA 0CB4'              	JC	MS_SAT
  0CAF'   3D                    	DCR	A
  0CB0'   C2 0CAB'              	JNZ	MS_LP
  0CB3'   C9                    	RET
  0CB4'                         MS_SAT:
  0CB4'   21 FFFF               	LXI	H,0FFFFH
  0CB7'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0CB8'                         VC_HFDN:
  0CB8'   CD 061F'              	CALL	SETMOV
  0CBB'   CD 0BB1'              	CALL	CURRW
  0CBE'   32 240D'              	STA	HFROW
  0CC1'   CD 0D2F'              	CALL	HFCNT		; HL = lines
  0CC4'   3A 240D'              	LDA	HFROW
  0CC7'   47                    	MOV	B,A
  0CC8'   3A 0000*              	LDA	SCEOF
  0CCB'   B7                    	ORA	A
  0CCC'   CA 0CD4'              	JZ	VHD_GO
  0CCF'   3A 0000*              	LDA	SCBOT		; the last line's row
  0CD2'   B8                    	CMP	B
  0CD3'   C8                    	RZ			; the cursor is on it
  0CD4'                         VHD_GO:
  0CD4'   CD 079B'              	CALL	JCORE
  0CD7'   3A 0000*              	LDA	SCEOF
  0CDA'   B7                    	ORA	A
  0CDB'   C2 06ED'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0CDE'   3A 240D'              	LDA	HFROW
  0CE1'   CD 0BD0'              	CALL	SETRWT
  0CE4'   3E 01                 	MVI	A,1
  0CE6'   32 0000*              	STA	WFILL		; not past the end of the file
  0CE9'   C3 06ED'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0CEC'                         VC_HFUP:
  0CEC'   CD 061F'              	CALL	SETMOV
  0CEF'   CD 0BB1'              	CALL	CURRW
  0CF2'   32 240D'              	STA	HFROW
  0CF5'   CD 0D2F'              	CALL	HFCNT		; HL = lines
  0CF8'   CD 0D0F'              	CALL	ONFST
  0CFB'   C8                    	RZ			; the cursor is on the first line
  0CFC'   CD 0838'              	CALL	KCORE
  0CFF'   3A 0000*              	LDA	SCBOF
  0D02'   B7                    	ORA	A
  0D03'   C2 06ED'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0D06'   3A 240D'              	LDA	HFROW
  0D09'   CD 0BD0'              	CALL	SETRWT
  0D0C'   C3 06ED'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0D0F'                         ONFST:
  0D0F'   E5                    	PUSH	H
  0D10'   2A 0000*              	LHLD	OUTPOS
  0D13'   7C                    	MOV	A,H
  0D14'   B5                    	ORA	L
  0D15'   C2 0D2D'              	JNZ	OF_RET
  0D18'   2A 0000*              	LHLD	TXTBEG
  0D1B'   EB                    	XCHG			; DE = TXTBEG
  0D1C'   2A 0000*              	LHLD	GAPBEG
  0D1F'                         OF_LP:
  0D1F'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0D22'   CA 0D2D'              	JZ	OF_RET
  0D25'   2B                    	DCX	H
  0D26'   7E                    	MOV	A,M
  0D27'   FE 0A                 	CPI	LF
  0D29'   C2 0D1F'              	JNZ	OF_LP
  0D2C'   B7                    	ORA	A		; NZ
  0D2D'                         OF_RET:
  0D2D'   E1                    	POP	H
  0D2E'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0D2F'                         HFCNT:
  0D2F'   2A 2401'              	LHLD	CMDCNT
  0D32'   7C                    	MOV	A,H
  0D33'   B5                    	ORA	L
  0D34'   CA 0D4B'              	JZ	HFC_AM
  0D37'   CD 05B2'              	CALL	GETCNT		; HL = count; clears it
  0D3A'   3A 0000*              	LDA	NEDIT
  0D3D'   5F                    	MOV	E,A
  0D3E'   16 00                 	MVI	D,0
  0D40'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0D43'   D2 0D47'              	JNC	HFC_ST
  0D46'   EB                    	XCHG			; HL = NEDIT
  0D47'                         HFC_ST:
  0D47'   7D                    	MOV	A,L
  0D48'   32 240E'              	STA	HFAMT
  0D4B'                         HFC_AM:
  0D4B'   3A 240E'              	LDA	HFAMT
  0D4E'   B7                    	ORA	A
  0D4F'   C2 0D5C'              	JNZ	HFC_HL
  0D52'   3A 0000*              	LDA	NEDIT
  0D55'   B7                    	ORA	A
  0D56'   1F                    	RAR
  0D57'   B7                    	ORA	A
  0D58'   C2 0D5C'              	JNZ	HFC_HL
  0D5B'   3C                    	INR	A		; at least one line
  0D5C'                         HFC_HL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D5C'   6F                    	MOV	L,A
  0D5D'   26 00                 	MVI	H,0
  0D5F'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0D60'                         VC_REDR:
  0D60'   C3 05B2'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0D63'                         VC_G:
  0D63'   CD 061F'              	CALL	SETMOV
  0D66'   CD 0DF6'              	CALL	GZONE		; the screen's top line, before the move
  0D69'   2A 2401'              	LHLD	CMDCNT
  0D6C'   7C                    	MOV	A,H
  0D6D'   B5                    	ORA	L
  0D6E'   C2 0D7B'              	JNZ	VG_N
  0D71'   AF                    	XRA	A		; forward
  0D72'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0D75'   CD 08CF'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0D78'   C3 0E0E'              	JMP	GPLACE
  0D7B'                         VG_N:
  0D7B'   CD 05B2'              	CALL	GETCNT		; HL = target line (1-based)
  0D7E'                         VG_LN:
  0D7E'   CD 0D84'              	CALL	GOLN
  0D81'   C3 0E0E'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
  0D84'                         GOLN:
  0D84'   2B                    	DCX	H		; lines to move from line 1
  0D85'   E5                    	PUSH	H
  0D86'   3E FF                 	MVI	A,0FFH
  0D88'   CD 0000*              	CALL	MVLMAX		; to BOF
  0D8B'   E1                    	POP	H
  0D8C'   AF                    	XRA	A
  0D8D'   CD 0000*              	CALL	MVLIND		; forward count-1 lines
  0D90'   CD 08C9'              	CALL	ATEOF
  0D93'   DC 08CF'              	CC	LASTLN		; past the last line: onto it
  0D96'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0D97'                         VC_LG:
  0D97'   CD 061F'              	CALL	SETMOV
  0D9A'   3A 2429'              	LDA	GSAVE
  0D9D'   B7                    	ORA	A
  0D9E'   C2 0DA7'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0DA1'   3E 01                 	MVI	A,PG
  0DA3'   32 2428'              	STA	GPEND
  0DA6'   C9                    	RET
  0DA7'                         VLG_GG:
  0DA7'   CD 0DF6'              	CALL	GZONE
  0DAA'   CD 05B2'              	CALL	GETCNT		; HL = target line (no count: 1)
  0DAD'   C3 0D7E'              	JMP	VG_LN
                                
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0DB0'                         FPOS:
  0DB0'   C5                    	PUSH	B
  0DB1'   D5                    	PUSH	D
  0DB2'   EB                    	XCHG
  0DB3'   2A 0000*              	LHLD	TXTBEG
  0DB6'   EB                    	XCHG
  0DB7'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0DBA'   EB                    	XCHG			; DE = that
  0DBB'   2A 0000*              	LHLD	OUTPOS
  0DBE'   7C                    	MOV	A,H
  0DBF'   B7                    	ORA	A		; CY = 0
  0DC0'   1F                    	RAR
  0DC1'   47                    	MOV	B,A
  0DC2'   7D                    	MOV	A,L
  0DC3'   1F                    	RAR
  0DC4'   67                    	MOV	H,A
  0DC5'   3E 00                 	MVI	A,0
  0DC7'   1F                    	RAR
  0DC8'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0DC9'   19                    	DAD	D
  0DCA'   78                    	MOV	A,B
  0DCB'   CE 00                 	ACI	0		; A:HL = the position
  0DCD'   D1                    	POP	D
  0DCE'   C1                    	POP	B
  0DCF'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0DD0'                         ZSAVE:
  0DD0'   2A 2401'              	LHLD	CMDCNT
  0DD3'   22 245B'              	SHLD	ZSVCNT
  0DD6'   2A 0000*              	LHLD	AUXCNT
  0DD9'   22 245D'              	SHLD	ZSVAUX
  0DDC'   3A 0000*              	LDA	DIRFLG
  0DDF'   32 245F'              	STA	ZSVDIR
  0DE2'   C9                    	RET
  0DE3'                         ZREST:
  0DE3'   2A 245B'              	LHLD	ZSVCNT
  0DE6'   22 2401'              	SHLD	CMDCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0DE9'   2A 245D'              	LHLD	ZSVAUX
  0DEC'   22 0000*              	SHLD	AUXCNT
  0DEF'   3A 245F'              	LDA	ZSVDIR
  0DF2'   32 0000*              	STA	DIRFLG
  0DF5'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0DF6'                         GZONE:
  0DF6'   CD 0DD0'              	CALL	ZSAVE
  0DF9'   CD 0BB1'              	CALL	CURRW
  0DFC'   6F                    	MOV	L,A
  0DFD'   26 00                 	MVI	H,0
  0DFF'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0E02'   CD 0DB0'              	CALL	FPOS
  0E05'   22 0000*              	SHLD	ZTOP
  0E08'   32 0002*              	STA	ZTOP+2
  0E0B'   C3 0DE3'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0E0E'                         GPLACE:
  0E0E'   CD 0DD0'              	CALL	ZSAVE
  0E11'   2A 0000*              	LHLD	GAPBEG
  0E14'   CD 0DB0'              	CALL	FPOS
  0E17'   EB                    	XCHG
  0E18'   4F                    	MOV	C,A		; C:DE = the target's position
  0E19'   2A 0000*              	LHLD	ZTOP
  0E1C'   7B                    	MOV	A,E
  0E1D'   95                    	SUB	L
  0E1E'   6F                    	MOV	L,A
  0E1F'   7A                    	MOV	A,D
  0E20'   9C                    	SBB	H
  0E21'   67                    	MOV	H,A
  0E22'   22 2458'              	SHLD	ZDIF
  0E25'   3A 0002*              	LDA	ZTOP+2
  0E28'   47                    	MOV	B,A
  0E29'   79                    	MOV	A,C
  0E2A'   98                    	SBB	B		; A:ZDIF = target - top; CY iff above the top
  0E2B'   DA 0E78'              	JC	GP_UP
  0E2E'   B7                    	ORA	A
  0E2F'   C2 0EB9'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0E32'   3A 0000*              	LDA	NEDIT
  0E35'   5F                    	MOV	E,A
  0E36'   16 00                 	MVI	D,0
  0E38'   B7                    	ORA	A
  0E39'   1F                    	RAR
  0E3A'   6F                    	MOV	L,A
  0E3B'   26 00                 	MVI	H,0
  0E3D'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0E3E'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0E41'   CD 05AB'              	CALL	GBSUB		; HL = bytes from there to the target
  0E44'   EB                    	XCHG
  0E45'   2A 2458'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0E48'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0E4B'   DA 0EB9'              	JC	GP_MID
  0E4E'   CD 05AB'              	CALL	GBSUB		; HL = the top line's start (resident)
  0E51'   01 0000               	LXI	B,0		; BC = lines from the top
  0E54'                         GP_CNT:
  0E54'   7A                    	MOV	A,D
  0E55'   B3                    	ORA	E
  0E56'   CA 0E65'              	JZ	GP_DN
  0E59'   7E                    	MOV	A,M
  0E5A'   23                    	INX	H
  0E5B'   1B                    	DCX	D
  0E5C'   FE 0A                 	CPI	LF
  0E5E'   C2 0E54'              	JNZ	GP_CNT
  0E61'   03                    	INX	B
  0E62'   C3 0E54'              	JMP	GP_CNT
  0E65'                         GP_DN:
  0E65'   3A 0000*              	LDA	NEDIT
  0E68'   3D                    	DCR	A
  0E69'   5F                    	MOV	E,A
  0E6A'   16 00                 	MVI	D,0		; DE = the bottom row
  0E6C'   60                    	MOV	H,B
  0E6D'   69                    	MOV	L,C
  0E6E'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0E71'   DA 0EC3'              	JC	GP_SET		; A = the bottom row
  0E74'   7D                    	MOV	A,L		; on the screen: its row
  0E75'   C3 0EE3'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0E78'                         GP_UP:
  0E78'   3C                    	INR	A
  0E79'   C2 0EB9'              	JNZ	GP_MID		; 64K bytes or more above
  0E7C'   2A 2458'              	LHLD	ZDIF
  0E7F'   EB                    	XCHG
  0E80'   21 0000               	LXI	H,0
  0E83'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0E86'   7C                    	MOV	A,H
  0E87'   B5                    	ORA	L
  0E88'   CA 0EB9'              	JZ	GP_MID		; exactly 64K
  0E8B'   EB                    	XCHG			; DE = bytes to read
  0E8C'   AF                    	XRA	A
  0E8D'   32 245A'              	STA	ZLF
  0E90'   CD 0000*              	CALL	RGET0
  0E93'                         GP_RD:
  0E93'   CD 0000*              	CALL	RDGET		; (keeps DE)
  0E96'   DA 0EB9'              	JC	GP_MID
  0E99'   FE 0A                 	CPI	LF
  0E9B'   C2 0EAF'              	JNZ	GP_RN
  0E9E'   3A 0000*              	LDA	NEDIT
  0EA1'   B7                    	ORA	A
  0EA2'   1F                    	RAR
  0EA3'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  0EA5'   E5                    	PUSH	H
  0EA6'   21 245A'              	LXI	H,ZLF
  0EA9'   34                    	INR	M
  0EAA'   BE                    	CMP	M		; CY iff more lines than that
  0EAB'   E1                    	POP	H
  0EAC'   DA 0EB9'              	JC	GP_MID
  0EAF'                         GP_RN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0EAF'   1B                    	DCX	D
  0EB0'   7A                    	MOV	A,D
  0EB1'   B3                    	ORA	E
  0EB2'   C2 0E93'              	JNZ	GP_RD
  0EB5'   AF                    	XRA	A		; the top row
  0EB6'   C3 0EC3'              	JMP	GP_SET
  0EB9'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  0EB9'   3E 01                 	MVI	A,1
  0EBB'   32 0000*              	STA	WFILL		; not past the end of the file
  0EBE'   3A 0000*              	LDA	NEDIT
  0EC1'   B7                    	ORA	A
  0EC2'   1F                    	RAR			; the middle row
  0EC3'                         GP_SET:
  0EC3'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  0EC4'   26 00                 	MVI	H,0
  0EC6'   22 0000*              	SHLD	WINROW
  0EC9'   21 0000               	LXI	H,0
  0ECC'   22 0000*              	SHLD	LNDLT
  0ECF'   CD 0640'              	CALL	SETFUL		; the window may have paged: full repaint
  0ED2'                         GP_FIN:
  0ED2'   CD 0DE3'              	CALL	ZREST
  0ED5'   3A 2482'              	LDA	GPKEEP
  0ED8'   B7                    	ORA	A
  0ED9'   CA 06ED'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  0EDC'   AF                    	XRA	A
  0EDD'   32 2482'              	STA	GPKEEP
  0EE0'   C3 04A4'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  0EE3'                         GP_ONS:
  0EE3'   6F                    	MOV	L,A
  0EE4'   26 00                 	MVI	H,0		; HL = the row it lands on
  0EE6'   EB                    	XCHG
  0EE7'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  0EEA'   EB                    	XCHG
  0EEB'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  0EEE'   22 0000*              	SHLD	LNDLT
  0EF1'   3E 01                 	MVI	A,R_MOVE
  0EF3'   32 2405'              	STA	RINTENT
  0EF6'   C3 0ED2'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  0EF9'                         OPPEND:
  0EF9'   AF                    	XRA	A
  0EFA'   32 242E'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  0EFD'   3A 242B'              	LDA	PSAVE
  0F00'   FE 63                 	CPI	'c'
  0F02'   C2 0F1F'              	JNZ	OPP_ND
  0F05'   79                    	MOV	A,C
  0F06'   FE 77                 	CPI	'w'
  0F08'   CA 0F10'              	JZ	OPP_W
  0F0B'   FE 57                 	CPI	'W'
  0F0D'   C2 0F1F'              	JNZ	OPP_ND
  0F10'                         OPP_W:
  0F10'   CD 0F99'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  0F13'   DA 0F1F'              	JC	OPP_ND
  0F16'   79                    	MOV	A,C
  0F17'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  0F19'   4F                    	MOV	C,A
  0F1A'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  0F1C'   32 242E'              	STA	CWEOL		;   see the clamp in OPA_F
  0F1F'                         OPP_ND:
  0F1F'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  0F20'   21 242B'              	LXI	H,PSAVE
  0F23'   BE                    	CMP	M
  0F24'   CA 0FBA'              	JZ	OPLINE
  0F27'   79                    	MOV	A,C		; (OPCLS classifies the key)
  0F28'   CD 0FCA'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  0F2B'   DA 0F96'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  0F2E'   32 242D'              	STA	OPCLSV
  0F31'   47                    	MOV	B,A		; B = the class
  0F32'   3A 242B'              	LDA	PSAVE
  0F35'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  0F37'   C2 0F43'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  0F3A'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  0F3B'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  0F3D'   C2 0F65'              	JNZ	OPP_GO
  0F40'   C3 0F4E'              	JMP	OPP_NO
  0F43'                         OPP_NC:
  0F43'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  0F45'   C2 0F65'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  0F48'   78                    	MOV	A,B		;   a charwise register would need a type flag
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0F49'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  0F4B'   CA 0F65'              	JZ	OPP_GO		;   within a line -- neither of which is built
  0F4E'                         OPP_NO:
  0F4E'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  0F4F'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  0F51'   CA 0F5F'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  0F54'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  0F56'   CA 0F5F'              	JZ	OPP_SW		;   so swallow it before dropping the command
  0F59'   CD 034B'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  0F5C'   C2 0F96'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  0F5F'                         OPP_SW:
  0F5F'   CD 021B'              	CALL	MKGETK
  0F62'   C3 0F96'              	JMP	OPABRT
  0F65'                         OPP_GO:
  0F65'   AF                    	XRA	A
  0F66'   32 240C'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  0F69'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  0F6C'   22 242F'              	SHLD	OPSTA
  0F6F'   21 232F'              	LXI	H,CMDTAB
  0F72'   CD 00C5'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  0F75'   3A 242B'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  0F78'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  0F79'   CA 061F'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  0F7C'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  0F7F'   22 2431'              	SHLD	OPEND2
  0F82'   3A 242B'              	LDA	PSAVE
  0F85'   FE 79                 	CPI	'y'
  0F87'   CA 146A'              	JZ	OPYANK		; a yank takes the span without losing it
  0F8A'   CD 1005'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  0F8D'   3A 242B'              	LDA	PSAVE
  0F90'   FE 63                 	CPI	'c'
  0F92'   C0                    	RNZ
  0F93'   C3 1231'              	JMP	SETINS
  0F96'                         OPABRT:
  0F96'   C3 061F'              	JMP	SETMOV		; not a motion -> operator cancelled, nothing drew
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  0F99'                         ONWHIT:
  0F99'   CD 058E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  0F9C'   CA 0FB8'              	JZ	OW_YES
  0F9F'   CD 0599'              	CALL	CURCHR		; A = the char under the cursor
  0FA2'   FE 20                 	CPI	' '
  0FA4'   CA 0FB8'              	JZ	OW_YES
  0FA7'   FE 09                 	CPI	TAB
  0FA9'   CA 0FB8'              	JZ	OW_YES
  0FAC'   FE 0D                 	CPI	CR
  0FAE'   CA 0FB8'              	JZ	OW_YES
  0FB1'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0FB3'   CA 0FB8'              	JZ	OW_YES
  0FB6'   B7                    	ORA	A		; a char to change: CY clear
  0FB7'   C9                    	RET
  0FB8'                         OW_YES:
  0FB8'   37                    	STC
  0FB9'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  0FBA'                         OPLINE:
  0FBA'   3A 242B'              	LDA	PSAVE
  0FBD'   FE 63                 	CPI	'c'
  0FBF'   CA 061F'              	JZ	SETMOV
  0FC2'   FE 79                 	CPI	'y'
  0FC4'   CA 144F'              	JZ	VY_YY
  0FC7'   C3 13D4'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  0FCA'                         OPCLS:
  0FCA'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  0FCC'   CA 0FD9'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  0FCF'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  0FD1'   C2 0FED'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  0FD4'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  0FD6'   C3 0FDB'              	JMP	OPC_FK
  0FD9'                         OPC_SEM:
  0FD9'   06 00                 	MVI	B,0		; ';' runs it as it stands
  0FDB'                         OPC_FK:
  0FDB'   3A 2478'              	LDA	FNDKND
  0FDE'   B7                    	ORA	A
  0FDF'   37                    	STC
  0FE0'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  0FE1'   A8                    	XRA	B		; ... and now the direction ',' asked for
  0FE2'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  0FE4'   CA 0FEB'              	JZ	OPC_EXC
  0FE7'   3E 01                 	MVI	A,1
  0FE9'   B7                    	ORA	A		; CY clear: a motion, class 1
  0FEA'   C9                    	RET
  0FEB'                         OPC_EXC:
  0FEB'   AF                    	XRA	A		; class 0, CY clear
  0FEC'   C9                    	RET
  0FED'                         OPC_TB:
  0FED'   47                    	MOV	B,A
  0FEE'   21 1127'              	LXI	H,OPCTAB
  0FF1'                         OPC_LP:
  0FF1'   7E                    	MOV	A,M
  0FF2'   B7                    	ORA	A
  0FF3'   CA 1003'              	JZ	OPC_MS		; end of table -> not a motion
  0FF6'   B8                    	CMP	B
  0FF7'   CA 0FFF'              	JZ	OPC_HT
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0FFA'   23                    	INX	H
  0FFB'   23                    	INX	H
  0FFC'   C3 0FF1'              	JMP	OPC_LP
  0FFF'                         OPC_HT:
  0FFF'   23                    	INX	H
  1000'   7E                    	MOV	A,M		; class byte
  1001'   B7                    	ORA	A		; clear CY
  1002'   C9                    	RET
  1003'                         OPC_MS:
  1003'   37                    	STC
  1004'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  1005'                         OPAPPL:
  1005'   3A 242D'              	LDA	OPCLSV
  1008'   FE 02                 	CPI	2
  100A'   CA 110B'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  100D'   2A 242F'              	LHLD	OPSTA
  1010'   EB                    	XCHG			; DE = start
  1011'   2A 2431'              	LHLD	OPEND2		; HL = end
  1014'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  1017'   DA 1027'              	JC	OPA_F
  101A'   CA 1027'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  101D'   22 2433'              	SHLD	OPLO
  1020'   EB                    	XCHG
  1021'   22 2435'              	SHLD	OPHI
  1024'   C3 107F'              	JMP	OPA_DO
  1027'                         OPA_F:
  1027'   EB                    	XCHG			; HL = start, DE = end
  1028'   22 2433'              	SHLD	OPLO
  102B'   EB                    	XCHG			; HL = end
  102C'   3A 242D'              	LDA	OPCLSV
  102F'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1031'   CA 107C'              	JZ	OPA_HI		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  1034'   FE 01                 	CPI	1
  1036'   C2 1058'              	JNZ	OPA_EX
  1039'   23                    	INX	H		; inclusive endpoint -> hi = end+1
                                	;--- 'cw' stops at the line's content end, where a plain 'ce' (and 'de')
                                	;    runs on into the next line's word and 'd%' crosses to its mate --
                                	;    all four recorded from vim 9.1.  vim's 'cw' is not simply 'ce': the
                                	;    rewrite keeps 'w's own end-of-line stop, so the clamp hangs off
                                	;    CWEOL (the rewrite) and not off the inclusive class. ---
  103A'   3A 242E'              	LDA	CWEOL
  103D'   B7                    	ORA	A
  103E'   CA 107C'              	JZ	OPA_HI
  1041'   22 2435'              	SHLD	OPHI		; park the motion's own end: CEND clobbers DE
  1044'   2A 2433'              	LHLD	OPLO
  1047'   CD 11AF'              	CALL	CEND		; HL = the start line's content end
  104A'   EB                    	XCHG			; DE = that content end
  104B'   2A 2435'              	LHLD	OPHI		; HL = hi
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  104E'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  1051'   D2 107C'              	JNC	OPA_HI		; hi is inside the line: keep it
  1054'   EB                    	XCHG			; HL = the content end: 'cw' stops there
  1055'   C3 107C'              	JMP	OPA_HI
  1058'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  1058'   22 2435'              	SHLD	OPHI		; the motion's own end, for now
  105B'   2A 2433'              	LHLD	OPLO
  105E'   CD 11AF'              	CALL	CEND		; HL = the start line's content end
  1061'   EB                    	XCHG			; DE = that content end
  1062'   3A 240C'              	LDA	WPULL		; the motion landed on a line's end and was
  1065'   B7                    	ORA	A		;   pulled back onto its last char (the command
  1066'   C2 1072'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  1069'   2A 2435'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  106C'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  106F'   D2 107F'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  1072'                         OPA_CE:				;   deletes the word, not all but its last char
  1072'   2A 2433'              	LHLD	OPLO
  1075'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1078'   CA 10BD'              	JZ	OPA_LN
  107B'   EB                    	XCHG			; HL = the content end
  107C'                         OPA_HI:
  107C'   22 2435'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  107F'                         OPA_DO:
  107F'   CD 10A3'              	CALL	OPDSPN
  1082'   3A 242B'              	LDA	PSAVE
  1085'   FE 63                 	CPI	'c'
  1087'   C8                    	RZ
  1088'   C3 11C0'              	JMP	CLAMPE
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  108B'                         SPNBRK:
  108B'   2A 2433'              	LHLD	OPLO
  108E'   CD 051E'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  1091'   EB                    	XCHG			; DE = it
  1092'   2A 2435'              	LHLD	OPHI
  1095'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  1098'                         OPSPNL:
  1098'   2A 2435'              	LHLD	OPHI
  109B'   EB                    	XCHG
  109C'   2A 2433'              	LHLD	OPLO
  109F'   EB                    	XCHG			; HL = hi, DE = lo
  10A0'   C3 0000*              	JMP	SUBHD
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  10A3'                         OPDSPN:
  10A3'   CD 108B'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  10A6'   F5                    	PUSH	PSW
  10A7'   2A 2433'              	LHLD	OPLO
  10AA'   CD 0000*              	CALL	GOTO
  10AD'   CD 1098'              	CALL	OPSPNL		; HL = hi - lo
  10B0'   CD 0000*              	CALL	DELFWD
  10B3'   CD 0188'              	CALL	MARKMOD
  10B6'   F1                    	POP	PSW
  10B7'   DA 0640'              	JC	SETFUL		; a break went: every row below it moved up
  10BA'   C3 0625'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  10BD'                         OPA_LN:
  10BD'   3A 242B'              	LDA	PSAVE
  10C0'   FE 63                 	CPI	'c'
  10C2'   C2 10CB'              	JNZ	OPA_LD
  10C5'   2A 2433'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  10C8'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  10CB'                         OPA_LD:
  10CB'   2A 2433'              	LHLD	OPLO
  10CE'   22 242F'              	SHLD	OPSTA
  10D1'   22 2431'              	SHLD	OPEND2
  10D4'   C3 110B'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  10D7'                         OPALSP:
  10D7'   2A 242F'              	LHLD	OPSTA
  10DA'   EB                    	XCHG
  10DB'   2A 2431'              	LHLD	OPEND2
  10DE'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  10E1'   DA 10EE'              	JC	OPAL_F
  10E4'   22 2433'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  10E7'   EB                    	XCHG
  10E8'   22 2435'              	SHLD	OPHI		; hi-src = start
  10EB'   C3 10F8'              	JMP	OPAL_R
  10EE'                         OPAL_F:
  10EE'   EB                    	XCHG			; HL = start
  10EF'   22 2433'              	SHLD	OPLO		; lo-src = start
  10F2'   2A 2431'              	LHLD	OPEND2
  10F5'   22 2435'              	SHLD	OPHI		; hi-src = end
  10F8'                         OPAL_R:
  10F8'   2A 2433'              	LHLD	OPLO
  10FB'   CD 050B'              	CALL	BOL
  10FE'   22 2433'              	SHLD	OPLO		; lo = BOL(low line)
  1101'   2A 2435'              	LHLD	OPHI
  1104'   CD 053B'              	CALL	NLSTART
  1107'   22 2435'              	SHLD	OPHI		; hi = start of line past the high line
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  110A'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  110B'                         OPALIN:
  110B'   CD 10D7'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  110E'                         OPDLIN:
  110E'   CD 10A3'              	CALL	OPDSPN
  1111'   CD 058E'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1114'   DA 1124'              	JC	OPDL_NB
  1117'   CD 0000*              	CALL	LOGLEN
  111A'   7C                    	MOV	A,H
  111B'   B5                    	ORA	L
  111C'   C8                    	RZ			; empty buffer
  111D'   2B                    	DCX	H
  111E'   CD 050B'              	CALL	BOL
  1121'   CD 0000*              	CALL	GOTO
  1124'                         OPDL_NB:
  1124'   C3 06ED'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1127'                         OPCTAB:
  1127'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  112B'   62 00 42 00           
  112F'   68 00 6C 00           
  1133'   30 00 5E 00           
  1137'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1139'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  113D'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1141'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1145'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1149'   24 01                 
  114B'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  114F'   47 02 48 02           
  1153'   4D 02 4C 02           
  1157'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1159'   00                    	DB	0
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  115A'                         VCB_C:
  115A'   CD 1166'              	CALL	VCB_CD
  115D'   C3 1231'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  1160'                         VCB_D:
  1160'   CD 1166'              	CALL	VCB_CD
  1163'   C3 11C0'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  1166'                         VCB_CD:
  1166'   CD 05A5'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1169'   22 2433'              	SHLD	OPLO
  116C'   CD 0000*              	CALL	CUROFF
  116F'   CD 11AF'              	CALL	CEND		; to the line's content end, the CR,LF left
  1172'   22 2435'              	SHLD	OPHI
  1175'   C3 10A3'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  1178'                         VC_X:
  1178'   CD 0792'              	CALL	GLSTAL
  117B'   CD 0625'              	CALL	SETLIN
  117E'   CD 05B2'              	CALL	GETCNT
  1181'   22 2437'              	SHLD	CNTV
  1184'   CD 0000*              	CALL	CUROFF
  1187'   22 243B'              	SHLD	WKI		; cur
  118A'   CD 11AF'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  118D'   EB                    	XCHG			; DE = contentend
  118E'   2A 243B'              	LHLD	WKI		; HL = cur
  1191'   EB                    	XCHG			; HL = contentend, DE = cur
  1192'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  1195'   7C                    	MOV	A,H
  1196'   B5                    	ORA	L
  1197'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  1198'   EB                    	XCHG			; DE = available
  1199'   2A 2437'              	LHLD	CNTV		; HL = count
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  119C'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  119F'   DA 11A5'              	JC	VX_USEA
  11A2'   C3 11A6'              	JMP	VX_DEL		; count <= available -> HL = count = del
  11A5'                         VX_USEA:
  11A5'   EB                    	XCHG			; HL = available
  11A6'                         VX_DEL:
  11A6'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  11A9'   CD 0188'              	CALL	MARKMOD
  11AC'   C3 11C0'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  11AF'                         CEND:
  11AF'   CD 051E'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  11B2'   7C                    	MOV	A,H
  11B3'   B5                    	ORA	L
  11B4'   C8                    	RZ			; the start of the text: nothing before it
  11B5'   2B                    	DCX	H
  11B6'   E5                    	PUSH	H
  11B7'   CD 0000*              	CALL	CHARAT
  11BA'   E1                    	POP	H		; HL = term-1
  11BB'   FE 0D                 	CPI	CR
  11BD'   C8                    	RZ			; a CR before the LF -> the content ends there
  11BE'   23                    	INX	H
  11BF'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  11C0'                         CLAMPE:
  11C0'   CD 0000*              	CALL	CUROFF
  11C3'   E5                    	PUSH	H
  11C4'   CD 054A'              	CALL	EOLC
  11C7'   D1                    	POP	D		; DE = cur
  11C8'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  11CB'   D8                    	RC
  11CC'   C8                    	RZ
  11CD'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  11D0'                         VC_I:
  11D0'   CD 05B2'              	CALL	GETCNT
  11D3'   C3 122E'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  11D6'                         VC_A:
  11D6'   CD 05B2'              	CALL	GETCNT
  11D9'   CD 058E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  11DC'   CA 11F3'              	JZ	VA_INS
  11DF'   EB                    	XCHG			; HL = cur
  11E0'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  11E1'   CD 0000*              	CALL	CHARAT
  11E4'   E1                    	POP	H
  11E5'   FE 0A                 	CPI	LF
  11E7'   CA 11F3'              	JZ	VA_INS		; on the line terminator -> append in place
  11EA'   FE 0D                 	CPI	CR
  11EC'   CA 11F3'              	JZ	VA_INS
  11EF'   23                    	INX	H
  11F0'   CD 0000*              	CALL	GOTO
  11F3'                         VA_INS:
  11F3'   C3 122E'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  11F6'                         VCB_A:
  11F6'   CD 05A5'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  11F9'   CD 054A'              	CALL	EOLC		; HL = last content char (the start when empty)
  11FC'   E5                    	PUSH	H
  11FD'   CD 0000*              	CALL	CHARAT
  1200'   E1                    	POP	H
  1201'   FE 0D                 	CPI	CR
  1203'   CA 120C'              	JZ	VBA_IN		; an empty line: insert at its start
  1206'   FE 0A                 	CPI	LF
  1208'   CA 120C'              	JZ	VBA_IN
  120B'   23                    	INX	H		; past the last content char
  120C'                         VBA_IN:
  120C'   CD 0000*              	CALL	GOTO
  120F'   C3 122E'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1212'                         VCB_I:
  1212'   CD 05B2'              	CALL	GETCNT
  1215'   CD 06ED'              	CALL	FNBLNK
  1218'   CD 0000*              	CALL	CUROFF
  121B'   E5                    	PUSH	H
  121C'   CD 0000*              	CALL	CHARAT
  121F'   E1                    	POP	H
  1220'   FE 20                 	CPI	' '
  1222'   CA 122A'              	JZ	VBI_SK
  1225'   FE 09                 	CPI	TAB
  1227'   C2 122E'              	JNZ	SETINM
  122A'                         VBI_SK:
  122A'   23                    	INX	H		; blanks only: past the last of them
  122B'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  122E'                         SETINM:
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  122E'   CD 061F'              	CALL	SETMOV
  1231'                         SETINS:
  1231'   3E 01                 	MVI	A,EM_INS
  1233'   32 2400'              	STA	EDMODE
  1236'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1237'                         ATCEND:
  1237'   CD 058E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  123A'   C8                    	RZ
  123B'   CD 0599'              	CALL	CURCHR		; A = the char under the cursor
  123E'   FE 0D                 	CPI	CR
  1240'   C8                    	RZ
  1241'   FE 0A                 	CPI	LF
  1243'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1244'                         OPNBRK:
  1244'   3E 0D                 	MVI	A,CR
  1246'   CD 0000*              	CALL	PUTGAP
  1249'   3E 0A                 	MVI	A,LF
  124B'   CD 0000*              	CALL	PUTGAP
  124E'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1251'   23                    	INX	H
  1252'   22 0000*              	SHLD	LNDLT
  1255'   C3 0188'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1258'                         ENDBRK:
  1258'   CD 058E'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  125B'   C0                    	RNZ
  125C'   CD 1244'              	CALL	OPNBRK
  125F'   CD 0000*              	CALL	CUROFF
  1262'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1263'   2B                    	DCX	H		;   line, with its own terminator after it
  1264'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1267'                         VC_O:
  1267'   CD 05A5'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  126A'   CD 11AF'              	CALL	CEND
  126D'   CD 0000*              	CALL	GOTO
  1270'   CD 1244'              	CALL	OPNBRK
  1273'   CD 1258'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1276'   CD 062B'              	CALL	SETILN		;   needs a terminator of its own to exist
  1279'   C3 1231'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  127C'                         VCB_O:
  127C'   CD 05A5'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  127F'   CD 050B'              	CALL	BOL
  1282'   CD 0000*              	CALL	GOTO
  1285'   CD 1244'              	CALL	OPNBRK
  1288'   CD 0000*              	CALL	CUROFF
  128B'   2B                    	DCX	H
  128C'   2B                    	DCX	H
  128D'   CD 0000*              	CALL	GOTO
  1290'   CD 062B'              	CALL	SETILN
  1293'   C3 1231'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  1296'                         VCB_J:
  1296'   CD 05A5'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1299'   CD 11AF'              	CALL	CEND		; the join point: this line's content end
  129C'   22 2433'              	SHLD	OPLO
  129F'   CD 0000*              	CALL	CUROFF
  12A2'   CD 053B'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  12A5'   E5                    	PUSH	H
  12A6'   CD 0000*              	CALL	LOGLEN
  12A9'   D1                    	POP	D		; DE = that start
  12AA'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  12AD'   CA 061F'              	JZ	SETMOV
  12B0'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  12B1'                         VJ_WS:
  12B1'   E5                    	PUSH	H
  12B2'   CD 0000*              	CALL	LOGLEN
  12B5'   D1                    	POP	D		; DE = the scan
  12B6'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  12B9'   CA 12D0'              	JZ	VJ_DEL
  12BC'   EB                    	XCHG			; HL = the scan
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  12BD'   E5                    	PUSH	H
  12BE'   CD 0000*              	CALL	CHARAT
  12C1'   E1                    	POP	H
  12C2'   FE 20                 	CPI	' '
  12C4'   CA 12CC'              	JZ	VJ_SKIP
  12C7'   FE 09                 	CPI	TAB
  12C9'   C2 12D0'              	JNZ	VJ_DEL
  12CC'                         VJ_SKIP:
  12CC'   23                    	INX	H
  12CD'   C3 12B1'              	JMP	VJ_WS
  12D0'                         VJ_DEL:
  12D0'   22 2435'              	SHLD	OPHI
  12D3'   CD 10A3'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  12D6'   CD 063A'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  12D9'   CD 058E'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  12DC'   CA 11C0'              	JZ	CLAMPE
  12DF'   CD 0599'              	CALL	CURCHR		; the first char of what was appended
  12E2'   FE 0D                 	CPI	CR
  12E4'   CA 11C0'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  12E7'   FE 0A                 	CPI	LF
  12E9'   CA 11C0'              	JZ	CLAMPE
  12EC'   FE 29                 	CPI	')'
  12EE'   CA 11C0'              	JZ	CLAMPE		; vim puts no space before a ')'
  12F1'   CD 0000*              	CALL	CUROFF
  12F4'   7C                    	MOV	A,H
  12F5'   B5                    	ORA	L
  12F6'   CA 130C'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  12F9'   2B                    	DCX	H
  12FA'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  12FD'   FE 20                 	CPI	' '
  12FF'   CA 11C0'              	JZ	CLAMPE
  1302'   FE 09                 	CPI	TAB
  1304'   CA 11C0'              	JZ	CLAMPE
  1307'   FE 0A                 	CPI	LF
  1309'   CA 11C0'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  130C'                         VJ_SP:
  130C'   3E 20                 	MVI	A,' '
  130E'   CD 0000*              	CALL	PUTGAP
  1311'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1314'   2B                    	DCX	H
  1315'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1318'                         VC_TILD:
  1318'   CD 05B2'              	CALL	GETCNT
  131B'   CD 0625'              	CALL	SETLIN		; only this row changes
  131E'   CD 0792'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1321'   CD 058E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1324'   CA 061F'              	JZ	SETMOV
  1327'   CD 0599'              	CALL	CURCHR		; A = the char under the cursor
  132A'   FE 0D                 	CPI	CR
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  132C'   CA 061F'              	JZ	SETMOV		; the line's end: nothing to toggle
  132F'   FE 0A                 	CPI	LF
  1331'   CA 061F'              	JZ	SETMOV
  1334'   47                    	MOV	B,A
  1335'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1337'   FE 41                 	CPI	'A'
  1339'   DA 1345'              	JC	VT_PUT		; below 'A': no case
  133C'   FE 5B                 	CPI	'Z'+1
  133E'   D2 1345'              	JNC	VT_PUT		; above 'Z': no case
  1341'   78                    	MOV	A,B
  1342'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1344'   47                    	MOV	B,A
  1345'                         VT_PUT:
  1345'   78                    	MOV	A,B
  1346'   32 2444'              	STA	VRCH		; the calls below do not preserve B
  1349'   CD 0188'              	CALL	MARKMOD
  134C'   21 0001               	LXI	H,1
  134F'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1352'   3A 2444'              	LDA	VRCH
  1355'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1358'   C3 11C0'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  135B'                         VC_R:
  135B'   CD 059F'              	CALL	MOVCNT		; a cursor motion, and its count
  135E'   3E 03                 	MVI	A,PR
  1360'   32 2428'              	STA	GPEND
  1363'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1364'                         VR_DO:
  1364'   AF                    	XRA	A
  1365'   32 2428'              	STA	GPEND
  1368'   79                    	MOV	A,C
  1369'   32 2444'              	STA	VRCH		; the calls below do not preserve C
  136C'   CD 0625'              	CALL	SETLIN		; only this row changed
  136F'   CD 0792'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1372'   CD 058E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1375'   CA 061F'              	JZ	SETMOV		; the end of the text: vim does nothing
  1378'   CD 0599'              	CALL	CURCHR		; A = the char under the cursor
  137B'   FE 0D                 	CPI	CR
  137D'   CA 061F'              	JZ	SETMOV		; the line's end: nothing to replace
  1380'   FE 0A                 	CPI	LF
  1382'   CA 061F'              	JZ	SETMOV
  1385'   CD 0188'              	CALL	MARKMOD
  1388'   21 0001               	LXI	H,1
  138B'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  138E'   3A 2444'              	LDA	VRCH
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  1391'   FE 0D                 	CPI	CR
  1393'   CA 13A0'              	JZ	VR_CR
  1396'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1399'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  139C'   2B                    	DCX	H		;   out, which moves every logical offset
  139D'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  13A0'                         VR_CR:
  13A0'   CD 1244'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  13A3'   CD 1258'              	CALL	ENDBRK		;   replaced char may have been the text's last
  13A6'   CD 062B'              	CALL	SETILN		;   row above it lost the char that was replaced,
  13A9'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  13AB'   32 2408'              	STA	ILABOV
  13AE'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  13AF'                         VCB_R:
  13AF'   CD 05B2'              	CALL	GETCNT
  13B2'   CD 061F'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  13B5'   21 0000               	LXI	H,0
  13B8'   22 2445'              	SHLD	RPDEL		; nothing of ours to put back yet
  13BB'   22 2447'              	SHLD	RPAPP
  13BE'   3E 02                 	MVI	A,EM_REP
  13C0'   32 2400'              	STA	EDMODE
  13C3'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  13C4'                         VC_D:
  13C4'   3E 64                 	MVI	A,'d'
  13C6'   32 242A'              	STA	PENDOP
  13C9'   C3 061F'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  13CC'                         VC_C:
  13CC'   3E 63                 	MVI	A,'c'
  13CE'   32 242A'              	STA	PENDOP
  13D1'   C3 061F'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  13D4'                         VD_DD:
  13D4'   CD 0792'              	CALL	GLSTAL
  13D7'   CD 05B2'              	CALL	GETCNT
  13DA'   22 2437'              	SHLD	CNTV
  13DD'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  13DF'   32 242C'              	STA	DDSNG
  13E2'   2B                    	DCX	H
  13E3'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  13E4'   B5                    	ORA	L
  13E5'   C2 13F0'              	JNZ	VDD_LS
  13E8'   3E 01                 	MVI	A,1
  13EA'   32 242C'              	STA	DDSNG
  13ED'   C3 13F6'              	JMP	VDD_GO
  13F0'                         VDD_LS:
  13F0'   CD 0758'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  13F3'   DA 061F'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  13F6'                         VDD_GO:
  13F6'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  13F9'   CD 06D6'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  13FC'   2A 2437'              	LHLD	CNTV
  13FF'   CD 0000*              	CALL	SETC0
  1402'                         VDD_FW:
  1402'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1405'   CD 05C7'              	CALL	CNTTST
  1408'   C2 1402'              	JNZ	VDD_FW
  140B'   CD 0188'              	CALL	MARKMOD
  140E'   CD 08C9'              	CALL	ATEOF
  1411'   D2 142C'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1414'   3E 00                 	MVI	A,0
  1416'   32 242C'              	STA	DDSNG		; deleted to the end: full repaint
  1419'   CD 0D0F'              	CALL	ONFST
  141C'   CA 06ED'              	JZ	FNBLNK		; nothing left before it
  141F'   21 0001               	LXI	H,1		; onto the new last line
  1422'   CD 0000*              	CALL	SETBWD
  1425'   2A 0000*              	LHLD	LNDLT
  1428'   2B                    	DCX	H
  1429'   22 0000*              	SHLD	LNDLT
  142C'                         VDD_UP:
  142C'   CD 06ED'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  142F'   3A 242C'              	LDA	DDSNG
  1432'   B7                    	ORA	A
  1433'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1434'   3E 03                 	MVI	A,R_DLIN
  1436'   32 2405'              	STA	RINTENT
  1439'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and an overflow raises WM's 'QBUF FULL' with
                                ; what has already moved safely in the register.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  143A'                         QEMPTY:
  143A'   2A 0000*              	LHLD	QBEG
  143D'   EB                    	XCHG
  143E'   2A 0000*              	LHLD	QEND
  1441'   7C                    	MOV	A,H
  1442'   BA                    	CMP	D
  1443'   C0                    	RNZ
  1444'   7D                    	MOV	A,L
  1445'   BB                    	CMP	E
  1446'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1447'                         VC_Y:
  1447'   3E 79                 	MVI	A,'y'
  1449'   32 242A'              	STA	PENDOP
  144C'   C3 061F'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  144F'                         VY_YY:
  144F'   CD 0000*              	CALL	CUROFF
  1452'   22 2468'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1455'   CD 050B'              	CALL	BOL
  1458'   22 246A'              	SHLD	YPT		; where the lines come from, to put them back
  145B'   CD 156C'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  145E'   CD 15AF'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1461'   D2 1573'              	JNC	YNDONE
  1464'   21 13D4'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1467'   C3 1493'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  146A'                         OPYANK:
  146A'   CD 10D7'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  146D'   2A 242F'              	LHLD	OPSTA
  1470'   EB                    	XCHG			; DE = start
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  1471'   2A 2431'              	LHLD	OPEND2		; HL = end
  1474'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1477'   D2 147B'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  147A'   EB                    	XCHG			; ... otherwise the start is
  147B'                         OPY_LO:
  147B'   22 2468'              	SHLD	YOFF
  147E'   2A 2433'              	LHLD	OPLO
  1481'   22 246A'              	SHLD	YPT		; where the lines come from, to put them back
  1484'   CD 156C'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1487'   CD 1627'              	CALL	YNSPAN		; copied where they lie, if there is room
  148A'   D2 1573'              	JNC	YNDONE
  148D'   21 1530'              	LXI	H,YSPAN
  1490'   C3 1493'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1493'                         YKGO:
  1493'   22 248A'              	SHLD	YACT
  1496'   2A 246A'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1499'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  149A'   2A 2468'              	LHLD	YOFF		;   survive this -- the put-back below can page
  149D'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  14A0'   22 2490'              	SHLD	YCOL		;   them -- but a distance within the lines does
  14A3'   3A 2404'              	LDA	MODF
  14A6'   32 2465'              	STA	YMODF
  14A9'   3A 241D'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  14AC'   32 2466'              	STA	YDCHG		;   a yank must not become the last change
  14AF'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  14B2'   32 2467'              	STA	YURPL		;   back are not a change to undo either
  14B5'   3E 01                 	MVI	A,1
  14B7'   32 0000*              	STA	UNDRPL
  14BA'   32 2489'              	STA	MKHOLD		; ... nor a change to drop a mark for: MKDROP
  14BD'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  14C0'   22 2473'              	SHLD	YLDLT
  14C3'   CD 0000*              	CALL	LOGLEN
  14C6'   22 248E'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  14C9'   2A 248A'              	LHLD	YACT
  14CC'   CD 152F'              	CALL	YCALL		; the lines out of the file, into the register
  14CF'   CD 0000*              	CALL	LOGLEN
  14D2'   EB                    	XCHG
  14D3'   2A 248E'              	LHLD	YWAS
  14D6'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  14D9'   CA 1507'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  14DC'   2A 246A'              	LHLD	YPT
  14DF'   CD 0000*              	CALL	GOTO
  14E2'   CD 0000*              	CALL	QGET		; and straight back in
                                	;--- Putting them back can PAGE: QGET splices the register through
                                	;    INSBLK, whose MKGAP reaches MKROOM when the arena is tight, and a
                                	;    spill writes the window's top out to disk -- which moves TXTBEG and
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


                                	;    shifts every logical offset under us, YOFF among them.  ('500yy' at
                                	;    line 2500 of a 40 K file spills 48 records and used to land the
                                	;    cursor 573 lines below where it started; a yank moves the cursor
                                	;    nowhere.)  So the cursor is found again from the lines THEMSELVES:
                                	;    QGET leaves it just past them, so they start at the cursor less the
                                	;    register's length, and the cursor was YCOL bytes into them.  Both
                                	;    terms are read AFTER the paging, so neither can be stale. ---
  14E5'   CD 0000*              	CALL	CUROFF		; where QGET left it: just past the lines
  14E8'   22 2492'              	SHLD	YBLK
  14EB'   2A 0000*              	LHLD	QBEG
  14EE'   EB                    	XCHG
  14EF'   2A 0000*              	LHLD	QEND
  14F2'   CD 0000*              	CALL	SUBHD		; HL = the register's length = what went back
  14F5'   EB                    	XCHG
  14F6'   2A 2492'              	LHLD	YBLK
  14F9'   CD 0000*              	CALL	SUBHD		; HL = where those lines start NOW
  14FC'   EB                    	XCHG
  14FD'   2A 2490'              	LHLD	YCOL
  1500'   19                    	DAD	D		; ... and the cursor is YCOL into them
  1501'   CD 0000*              	CALL	GOTO
  1504'   C3 150D'              	JMP	YK_RST
  1507'                         YK_FIN:				; nothing came out, so nothing was put back and
  1507'   2A 2468'              	LHLD	YOFF		;   no offset can have shifted: the cursor is
  150A'   CD 0000*              	CALL	GOTO		;   where it was
  150D'                         YK_RST:
  150D'   2A 2473'              	LHLD	YLDLT
  1510'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1513'   3A 2465'              	LDA	YMODF
  1516'   32 2404'              	STA	MODF
  1519'   3A 2466'              	LDA	YDCHG
  151C'   32 241D'              	STA	DOTCHG
  151F'   3A 2467'              	LDA	YURPL
  1522'   32 0000*              	STA	UNDRPL
  1525'   AF                    	XRA	A
  1526'   32 2489'              	STA	MKHOLD
  1529'   CD 0792'              	CALL	GLSTAL
  152C'   C3 0640'              	JMP	SETFUL		; the cheap paint cannot carry this
  152F'   E9                    YCALL:	PCHL
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1530'                         YSPAN:
  1530'   CD 0792'              	CALL	GLSTAL
  1533'   CD 1098'              	CALL	OPSPNL		; HL = the span's length
  1536'   22 248C'              	SHLD	YTGT
  1539'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  153C'   EB                    	XCHG			; DE = it
  153D'   2A 248C'              	LHLD	YTGT
  1540'   EB                    	XCHG			; HL = the text's, DE = the span's
  1541'   CD 0000*              	CALL	SUBHD
  1544'   22 248C'              	SHLD	YTGT		; what the text is left at when the span is out
  1547'   2A 2433'              	LHLD	OPLO
  154A'   CD 0000*              	CALL	GOTO
  154D'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1550'                         YS_LP:
  1550'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1553'   CD 0000*              	CALL	SETC0
  1556'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1559'   CD 0000*              	CALL	LOGLEN
  155C'   EB                    	XCHG			; DE = what is left
  155D'   2A 248C'              	LHLD	YTGT
  1560'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1563'   DA 1569'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1566'   C2 1550'              	JNZ	YS_LP		;   but never spin here if it ever did
  1569'                         YS_END:
  1569'   C3 0188'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  156C'                         YNPRE:
  156C'   2A 0000*              	LHLD	PGTOPM
  156F'   22 2494'              	SHLD	YNPG
  1572'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


                                ; dropped, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1573'                         YNDONE:
  1573'   2A 2468'              	LHLD	YOFF
  1576'   CD 0000*              	CALL	GOTO
  1579'   2A 0000*              	LHLD	PGTOPM
  157C'   EB                    	XCHG
  157D'   2A 2494'              	LHLD	YNPG
  1580'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1583'   C2 0640'              	JNZ	SETFUL		; it moved under us: repaint after all
  1586'   C3 061F'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1589'                         YNROOM:
  1589'   11 0100               	LXI	D,100H
  158C'   19                    	DAD	D
  158D'   D8                    	RC			; within a chunk of 64K: no arena holds that
  158E'   E5                    	PUSH	H		; the span plus its slack
  158F'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1592'   EB                    	XCHG			; HL = free
  1593'   D1                    	POP	D		; DE = the span plus its slack
  1594'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1597'   DA 159F'              	JC	YNR_OK
  159A'   CA 159F'              	JZ	YNR_OK
  159D'   37                    	STC			; not enough: the delete-and-put-back path
  159E'   C9                    	RET
  159F'                         YNR_OK:
  159F'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  15A0'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  15A1'                         YNGO:
  15A1'   C5                    	PUSH	B
  15A2'   CD 05B2'              	CALL	GETCNT		; spent here: this yank is happening
  15A5'   CD 0792'              	CALL	GLSTAL
  15A8'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  15AB'   C1                    	POP	B
  15AC'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


                                ; left with nothing to decide but where the count clamps.
  15AF'                         YNCOPY:
  15AF'   2A 2401'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  15B2'   7C                    	MOV	A,H		;   the count itself
  15B3'   B5                    	ORA	L
  15B4'   C2 15BA'              	JNZ	YNC_HV
  15B7'   21 0001               	LXI	H,1
  15BA'                         YNC_HV:
  15BA'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  15BB'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  15BC'   B4                    	ORA	H
  15BD'   CA 15C8'              	JZ	YNC_M
  15C0'   E5                    	PUSH	H
  15C1'   CD 0758'              	CALL	ONLAST		; vim: a count over one on the last line does
  15C4'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  15C5'   DA 15DA'              	JC	YNC_RF
  15C8'                         YNC_M:
  15C8'   E5                    	PUSH	H
  15C9'   CD 06D6'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  15CC'   E1                    	POP	H
  15CD'   CD 15E2'              	CALL	YNLINE		; BC = the span, measured where it stands
  15D0'   D8                    	RC			; not measurable here: let the pager answer it
  15D1'   60                    	MOV	H,B
  15D2'   69                    	MOV	L,C
  15D3'   CD 1589'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  15D6'   D8                    	RC			; no: the delete-and-put-back path
  15D7'   C3 15A1'              	JMP	YNGO
  15DA'                         YNC_RF:
  15DA'   CD 05B2'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  15DD'   CD 0792'              	CALL	GLSTAL		;   register alone, and that is the command
  15E0'   B7                    	ORA	A		; NC: done
  15E1'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  15E2'                         YNLINE:
  15E2'   22 2496'              	SHLD	YNCNT		; the lines it still wants
  15E5'   2A 0000*              	LHLD	GAPEND
  15E8'                         YNL_LP:
  15E8'   EB                    	XCHG			; DE = the scan
  15E9'   2A 0000*              	LHLD	TXTEND
  15EC'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  15EF'   EB                    	XCHG			; HL = the scan
  15F0'   D2 1610'              	JNC	YNL_EN		; the resident text ran out
  15F3'   7E                    	MOV	A,M
  15F4'   23                    	INX	H
  15F5'   FE 0A                 	CPI	LF
  15F7'   C2 15E8'              	JNZ	YNL_LP
  15FA'   E5                    	PUSH	H
  15FB'   2A 2496'              	LHLD	YNCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  15FE'   2B                    	DCX	H
  15FF'   22 2496'              	SHLD	YNCNT
  1602'   7C                    	MOV	A,H
  1603'   B5                    	ORA	L
  1604'   E1                    	POP	H
  1605'   C2 15E8'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1608'   EB                    	XCHG			; DE = past the last of them
  1609'   2A 0000*              	LHLD	GAPEND
  160C'   EB                    	XCHG			; HL = past them, DE = GAPEND
  160D'   C3 161E'              	JMP	YNL_BC
  1610'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1610'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1613'   C2 1625'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1616'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1619'   EB                    	XCHG			;   count clamps to it as vim's does
  161A'   2A 0000*              	LHLD	GAPEND
  161D'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  161E'                         YNL_BC:
  161E'   CD 0000*              	CALL	SUBHD		; HL = the span
  1621'   44                    	MOV	B,H
  1622'   4D                    	MOV	C,L
  1623'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1624'   C9                    	RET
  1625'                         YNL_NO:
  1625'   37                    	STC
  1626'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1627'                         YNSPAN:
  1627'   CD 1098'              	CALL	OPSPNL		; HL = the span's length
  162A'   44                    	MOV	B,H
  162B'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  162C'   CD 1589'              	CALL	YNROOM
  162F'   D8                    	RC			; no room: the delete-and-put-back path
  1630'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1631'   2A 2433'              	LHLD	OPLO
  1634'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1637'   C1                    	POP	B
  1638'   C3 15A1'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  163B'                         VC_P:
  163B'   CD 143A'              	CALL	QEMPTY
  163E'   CA 16F6'              	JZ	VP_BEL
  1641'   CD 05B2'              	CALL	GETCNT
  1644'   22 246C'              	SHLD	PCNT
  1647'   CD 0000*              	CALL	CUROFF
  164A'   CD 053B'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  164D'   C3 1662'              	JMP	VP_GO
  1650'                         VCB_P:
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  1650'   CD 143A'              	CALL	QEMPTY
  1653'   CA 16F6'              	JZ	VP_BEL
  1656'   CD 05B2'              	CALL	GETCNT
  1659'   22 246C'              	SHLD	PCNT
  165C'   CD 0000*              	CALL	CUROFF
  165F'   CD 050B'              	CALL	BOL
  1662'                         VP_GO:
  1662'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1665'   CD 0000*              	CALL	CUROFF
  1668'   EB                    	XCHG
  1669'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  166C'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  166F'   DA 1684'              	JC	VP_IN
  1672'   EB                    	XCHG			; HL = the put point = LOGLEN
  1673'   7C                    	MOV	A,H
  1674'   B5                    	ORA	L
  1675'   CA 1681'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1678'   2B                    	DCX	H
  1679'   CD 0000*              	CALL	CHARAT
  167C'   FE 0A                 	CPI	LF
  167E'   CA 1684'              	JZ	VP_IN
  1681'                         VP_BRK:
  1681'   CD 1244'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1684'                         VP_IN:
  1684'   CD 0000*              	CALL	CUROFF
  1687'   22 246E'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  168A'   2A 0000*              	LHLD	QBEG
  168D'   EB                    	XCHG
  168E'   2A 0000*              	LHLD	QEND
  1691'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1694'   EB                    	XCHG
  1695'   22 2470'              	SHLD	PLFS
  1698'   2A 246C'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  169B'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  169C'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  169D'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  169F'   C2 16A3'              	JNZ	VP_PZ
  16A2'   7D                    	MOV	A,L
  16A3'                         VP_PZ:
  16A3'   32 2472'              	STA	PCPY
  16A6'                         VP_LP:
  16A6'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  16A9'   2A 0000*              	LHLD	LNDLT
  16AC'   EB                    	XCHG
  16AD'   2A 2470'              	LHLD	PLFS
  16B0'   19                    	DAD	D
  16B1'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  16B4'   2A 246C'              	LHLD	PCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  16B7'   2B                    	DCX	H
  16B8'   22 246C'              	SHLD	PCNT
  16BB'   7C                    	MOV	A,H
  16BC'   B5                    	ORA	L
  16BD'   C2 16A6'              	JNZ	VP_LP
  16C0'   CD 0188'              	CALL	MARKMOD
  16C3'   2A 246E'              	LHLD	PPT
  16C6'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  16C9'   CD 0792'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  16CC'   3A 2472'              	LDA	PCPY
  16CF'   B7                    	ORA	A
  16D0'   CA 06ED'              	JZ	FNBLNK
  16D3'   2A 2470'              	LHLD	PLFS
  16D6'   7C                    	MOV	A,H
  16D7'   B7                    	ORA	A
  16D8'   C2 06ED'              	JNZ	FNBLNK
  16DB'   3A 2472'              	LDA	PCPY
  16DE'   CD 0CA5'              	CALL	MULSAT		; HL = the lines this put put, saturated
  16E1'   7C                    	MOV	A,H
  16E2'   B7                    	ORA	A
  16E3'   C2 06ED'              	JNZ	FNBLNK
  16E6'   7D                    	MOV	A,L
  16E7'   B7                    	ORA	A
  16E8'   CA 06ED'              	JZ	FNBLNK
  16EB'   F5                    	PUSH	PSW
  16EC'   CD 062B'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  16EF'   F1                    	POP	PSW
  16F0'   32 2406'              	STA	ILN		; ... which the lines put now replace
  16F3'   C3 06ED'              	JMP	FNBLNK
  16F6'                         VP_BEL:
  16F6'   CD 05B2'              	CALL	GETCNT		; the count is spent either way
  16F9'   0E 07                 	MVI	C,BEL
  16FB'   CD 0000*              	CALL	BCONOU
  16FE'   C3 061F'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  1701'                         VIREP:
  1701'   78                    	MOV	A,B
  1702'   FE 01                 	CPI	KT_ACT
  1704'   CA 1831'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  1707'   FE 02                 	CPI	KT_CHAR
  1709'   C0                    	RNZ			; ignore anything else
  170A'   79                    	MOV	A,C
  170B'   FE 0D                 	CPI	CR
  170D'   CA 1771'              	JZ	VP_CR
  1710'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1712'   CA 1771'              	JZ	VP_CR
  1715'   FE 08                 	CPI	BS
  1717'   CA 177D'              	JZ	VP_BS
  171A'   FE 7F                 	CPI	DEL
  171C'   CA 177D'              	JZ	VP_BS
  171F'   32 2444'              	STA	VRCH		; the calls below do not preserve C
  1722'   CD 0625'              	CALL	SETLIN		; this row changed
  1725'   CD 0188'              	CALL	MARKMOD
  1728'   CD 1237'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  172B'   CA 1763'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  172E'   3A 2444'              	LDA	VRCH
  1731'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1734'   2A 2445'              	LHLD	RPDEL
  1737'   7C                    	MOV	A,H
  1738'   B5                    	ORA	L
  1739'   CA 174F'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  173C'   2A 0000*              	LHLD	GAPEND
  173F'   EB                    	XCHG
  1740'   2A 2449'              	LHLD	RPGE
  1743'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1746'   CA 174F'              	JZ	VP_OVW
  1749'   21 0000               	LXI	H,0
  174C'   22 2445'              	SHLD	RPDEL		; the text moved: those originals are gone
  174F'                         VP_OVW:
  174F'   21 0001               	LXI	H,1
  1752'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1755'   2A 0000*              	LHLD	GAPEND
  1758'   22 2449'              	SHLD	RPGE
  175B'   2A 2445'              	LHLD	RPDEL
  175E'   23                    	INX	H
  175F'   22 2445'              	SHLD	RPDEL
  1762'   C9                    	RET
  1763'                         VP_APP:
  1763'   3A 2444'              	LDA	VRCH
  1766'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1769'   2A 2447'              	LHLD	RPAPP
  176C'   23                    	INX	H
  176D'   22 2447'              	SHLD	RPAPP
  1770'   C9                    	RET
  1771'                         VP_CR:
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  1771'   21 0000               	LXI	H,0
  1774'   22 2445'              	SHLD	RPDEL		; a line break ends what BS can put back
  1777'   22 2447'              	SHLD	RPAPP
  177A'   C3 1807'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  177D'                         VP_BS:
  177D'   2A 2447'              	LHLD	RPAPP
  1780'   7C                    	MOV	A,H
  1781'   B5                    	ORA	L
  1782'   CA 178F'              	JZ	VP_BSD
  1785'   2B                    	DCX	H
  1786'   22 2447'              	SHLD	RPAPP		; an appended char: it just goes
  1789'   CD 0625'              	CALL	SETLIN
  178C'   C3 0000*              	JMP	DELPRV
  178F'                         VP_BSD:
  178F'   2A 2445'              	LHLD	RPDEL
  1792'   7C                    	MOV	A,H
  1793'   B5                    	ORA	L
  1794'   CA 17BB'              	JZ	VP_BSM		; nothing of ours left
  1797'   2A 0000*              	LHLD	GAPEND
  179A'   EB                    	XCHG
  179B'   2A 2449'              	LHLD	RPGE
  179E'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  17A1'   C2 17BB'              	JNZ	VP_BSM
  17A4'   2A 2445'              	LHLD	RPDEL
  17A7'   2B                    	DCX	H
  17A8'   22 2445'              	SHLD	RPDEL
  17AB'   CD 0625'              	CALL	SETLIN
  17AE'   CD 0000*              	CALL	DELPRV		; the typed char goes
  17B1'   CD 0000*              	CALL	UNDELF		; the original comes back
  17B4'   2A 0000*              	LHLD	GAPEND
  17B7'   22 2449'              	SHLD	RPGE
  17BA'   C9                    	RET
  17BB'                         VP_BSM:
  17BB'   CD 061F'              	CALL	SETMOV		; nothing changed: back over the text as it is
  17BE'   C3 068E'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  17C1'                         VIINS:
  17C1'   78                    	MOV	A,B
  17C2'   FE 01                 	CPI	KT_ACT
  17C4'   CA 1831'              	JZ	VI_ACT
  17C7'   FE 02                 	CPI	KT_CHAR
  17C9'   C0                    	RNZ			; ignore anything else
  17CA'   79                    	MOV	A,C
  17CB'   FE 0D                 	CPI	CR
  17CD'   CA 1807'              	JZ	VI_CR
  17D0'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  17D2'   CA 1807'              	JZ	VI_CR
  17D5'   FE 08                 	CPI	BS
  17D7'   CA 181F'              	JZ	VI_BS
  17DA'   FE 7F                 	CPI	DEL
  17DC'   CA 181F'              	JZ	VI_BS
  17DF'   79                    	MOV	A,C
  17E0'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  17E3'   CD 0188'              	CALL	MARKMOD
  17E6'   CD 0625'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  17E9'   79                    	MOV	A,C
  17EA'   FE 20                 	CPI	' '
  17EC'   D8                    	RC			; control char -> keep R_LINE
  17ED'   FE 7F                 	CPI	DEL
  17EF'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  17F0'   CD 0646'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  17F3'   B7                    	ORA	A
  17F4'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  17F5'   3E 04                 	MVI	A,R_ICH
  17F7'   32 2405'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  17FA'   CD 1237'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  17FD'   3E 00                 	MVI	A,0
  17FF'   C2 1803'              	JNZ	VI_ICH
  1802'   3C                    	INR	A
  1803'                         VI_ICH:
  1803'   32 2407'              	STA	ICHAPP
  1806'   C9                    	RET
  1807'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1807'   CD 1237'              	CALL	ATCEND
  180A'   3E 00                 	MVI	A,0
  180C'   CA 1810'              	JZ	VI_CRS
  180F'   3C                    	INR	A
  1810'                         VI_CRS:
  1810'   F5                    	PUSH	PSW
  1811'   CD 1244'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1814'   CD 1258'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1817'   CD 062B'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  181A'   F1                    	POP	PSW
  181B'   32 2408'              	STA	ILABOV
  181E'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  181F'                         VI_BS:
  181F'   CD 0000*              	CALL	PEEKL
  1822'   D8                    	RC			; start of the file: nothing to delete
  1823'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1825'   CA 182B'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1828'   CD 0625'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  182B'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  182B'   CD 0188'              	CALL	MARKMOD
  182E'   C3 0000*              	JMP	DELPRV
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1831'                         VI_ACT:
  1831'   79                    	MOV	A,C
  1832'   FE 0B                 	CPI	ACT_ESC
  1834'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  1835'   3E 00                 	MVI	A,EM_CMD
  1837'   32 2400'              	STA	EDMODE
  183A'   CD 061F'              	CALL	SETMOV
  183D'   CD 068E'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1840'   C3 0792'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1843'                         RDLINE:
  1843'   EB                    	XCHG			; HL = buffer
  1844'   22 244B'              	SHLD	RLPTR
  1847'   3E 00                 	MVI	A,0
  1849'   32 244D'              	STA	RLLEN
  184C'   78                    	MOV	A,B
  184D'   32 244E'              	STA	RLMAX
  1850'   79                    	MOV	A,C
  1851'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1854'                         RL_LP:
  1854'   CD 0000*              	CALL	GETKEY
  1857'   78                    	MOV	A,B
  1858'   FE 01                 	CPI	KT_ACT
  185A'   CA 18B0'              	JZ	RL_ACT
  185D'   FE 02                 	CPI	KT_CHAR
  185F'   C2 1854'              	JNZ	RL_LP		; ignore other keys
  1862'   79                    	MOV	A,C
  1863'   FE 0D                 	CPI	CR
  1865'   CA 18C1'              	JZ	RL_DONE
  1868'   FE 08                 	CPI	BS
  186A'   CA 1898'              	JZ	RL_BS
  186D'   FE 7F                 	CPI	DEL
  186F'   CA 1898'              	JZ	RL_BS
  1872'   FE 20                 	CPI	' '
  1874'   DA 1854'              	JC	RL_LP		; control char -> ignore
  1877'   3A 244D'              	LDA	RLLEN
  187A'   47                    	MOV	B,A
  187B'   3A 244E'              	LDA	RLMAX
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  187E'   B8                    	CMP	B
  187F'   CA 1854'              	JZ	RL_LP		; full -> ignore
  1882'   2A 244B'              	LHLD	RLPTR
  1885'   71                    	MOV	M,C
  1886'   23                    	INX	H
  1887'   22 244B'              	SHLD	RLPTR
  188A'   3A 244D'              	LDA	RLLEN
  188D'   3C                    	INR	A
  188E'   32 244D'              	STA	RLLEN
  1891'   79                    	MOV	A,C
  1892'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1895'   C3 1854'              	JMP	RL_LP
  1898'                         RL_BS:				; WM LINEPOP
  1898'   3A 244D'              	LDA	RLLEN
  189B'   B7                    	ORA	A
  189C'   CA 18B6'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  189F'   3D                    	DCR	A
  18A0'   32 244D'              	STA	RLLEN
  18A3'   2A 244B'              	LHLD	RLPTR
  18A6'   2B                    	DCX	H
  18A7'   22 244B'              	SHLD	RLPTR
  18AA'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  18AD'   C3 1854'              	JMP	RL_LP
  18B0'                         RL_ACT:
  18B0'   79                    	MOV	A,C
  18B1'   FE 0B                 	CPI	ACT_ESC
  18B3'   C2 1854'              	JNZ	RL_LP
  18B6'                         RL_CAN:
  18B6'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  18B8'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  18BB'   CD 0625'              	CALL	SETLIN		; redraw one row
  18BE'   3E FF                 	MVI	A,0FFH		; cancelled
  18C0'   C9                    	RET
  18C1'                         RL_DONE:
  18C1'   AF                    	XRA	A
  18C2'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  18C3'                         VC_BZ:
  18C3'   CD 061F'              	CALL	SETMOV
  18C6'   3A 2429'              	LDA	GSAVE
  18C9'   FE 02                 	CPI	PZ
  18CB'   CA 18D6'              	JZ	VZ_ZZ
  18CE'   B7                    	ORA	A
  18CF'   C0                    	RNZ			; 'g' was pending: vim drops both
  18D0'   3E 02                 	MVI	A,PZ
  18D2'   32 2428'              	STA	GPEND
  18D5'   C9                    	RET
  18D6'                         VZ_ZZ:
  18D6'   3E 04                 	MVI	A,EO_X
  18D8'   32 244F'              	STA	EXOP
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  18DB'   3E 01                 	MVI	A,1
  18DD'   32 2462'              	STA	EXBANG		; no '!'
  18E0'   AF                    	XRA	A
  18E1'   32 2450'              	STA	EXARG		; no file name
  18E4'   3A 2404'              	LDA	MODF		; as ':x': a changed text is written first
  18E7'   B7                    	ORA	A
  18E8'   CA 1A0B'              	JZ	EX_Q
  18EB'   C3 19A5'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  18EE'                         VC_EX:
  18EE'   CD 05B2'              	CALL	GETCNT
  18F1'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  18F4'   11 0000*              	LXI	D,EXBUF
  18F7'   06 28                 	MVI	B,EXMAX
  18F9'   0E 3A                 	MVI	C,':'
  18FB'   CD 1843'              	CALL	RDLINE
  18FE'   B7                    	ORA	A
  18FF'   C0                    	RNZ			; cancelled
  1900'   3A 244D'              	LDA	RLLEN
  1903'   5F                    	MOV	E,A
  1904'   16 00                 	MVI	D,0
  1906'   21 0000*              	LXI	H,EXBUF
  1909'   19                    	DAD	D
  190A'   36 00                 	MVI	M,0		; the line ends with a 0
  190C'   21 0000*              	LXI	H,EXBUF
  190F'   CD 1CA7'              	CALL	SKIPB
  1912'   C8                    	RZ			; nothing on it
  1913'   22 2452'              	SHLD	EXCMD
  1916'   CD 1E51'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1919'   CD 1CA7'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  191C'   56                    	MOV	D,M
  191D'   23                    	INX	H
  191E'   1E 00                 	MVI	E,0
  1920'   CD 1CB3'              	CALL	ISLOW
  1923'   DA 192E'              	JC	EX_LK
  1926'   5F                    	MOV	E,A
  1927'   23                    	INX	H
  1928'   CD 1CB3'              	CALL	ISLOW
  192B'   D2 1947'              	JNC	EX_NOT		; a third letter: none of ours
  192E'                         EX_LK:
  192E'   E5                    	PUSH	H
  192F'   21 1E3B'              	LXI	H,EXTAB
  1932'                         EX_TL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  1932'   7E                    	MOV	A,M
  1933'   B7                    	ORA	A
  1934'   CA 1946'              	JZ	EX_NTP		; not in the table
  1937'   23                    	INX	H
  1938'   BA                    	CMP	D
  1939'   7E                    	MOV	A,M
  193A'   23                    	INX	H
  193B'   C2 1942'              	JNZ	EX_TN
  193E'   BB                    	CMP	E
  193F'   CA 194D'              	JZ	EX_TF
  1942'                         EX_TN:
  1942'   23                    	INX	H
  1943'   C3 1932'              	JMP	EX_TL
  1946'                         EX_NTP:
  1946'   E1                    	POP	H
  1947'                         EX_NOT:
  1947'   21 1D6B'              	LXI	H,SNOT
  194A'   C3 1CE8'              	JMP	EXERT
  194D'                         EX_TF:
  194D'   7E                    	MOV	A,M
  194E'   32 244F'              	STA	EXOP
  1951'   E1                    	POP	H
  1952'   FE 06                 	CPI	EO_S
  1954'   CA 1EC0'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1957'   3A 249F'              	LDA	SRNGF
  195A'   B7                    	ORA	A
  195B'   C2 1947'              	JNZ	EX_NOT		; a range on a command that does not take one
                                	;--- '!', then the file name ---
  195E'   7E                    	MOV	A,M
  195F'   D6 21                 	SUI	'!'
  1961'   32 2462'              	STA	EXBANG		; 0 = '!'
  1964'   C2 1968'              	JNZ	EX_NB
  1967'   23                    	INX	H
  1968'                         EX_NB:
  1968'   CD 1CA7'              	CALL	SKIPB
  196B'   32 2450'              	STA	EXARG		; 0 = no file name
  196E'   CA 1987'              	JZ	EX_RUN
  1971'   22 2452'              	SHLD	EXCMD
  1974'   3A 244F'              	LDA	EXOP
  1977'   FE 02                 	CPI	EO_Q
  1979'   CA 1CE5'              	JZ	EX_TRL		; :q takes none
  197C'   FE 07                 	CPI	EO_V
  197E'   CA 1CE5'              	JZ	EX_TRL		; nor :ve
  1981'   CD 1C11'              	CALL	PARSFN
  1984'   C2 1CD9'              	JNZ	EX_INV
  1987'                         EX_RUN:
  1987'   3A 244F'              	LDA	EXOP
  198A'   FE 05                 	CPI	EO_E
  198C'   CA 1A22'              	JZ	EX_E
  198F'   FE 02                 	CPI	EO_Q
  1991'   CA 1A0B'              	JZ	EX_Q
  1994'   FE 07                 	CPI	EO_V
  1996'   CA 1CDF'              	JZ	EX_V
  1999'   FE 04                 	CPI	EO_X
  199B'   C2 19A5'              	JNZ	EX_W
  199E'   3A 2404'              	LDA	MODF		; :x writes only a changed text
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  19A1'   B7                    	ORA	A
  19A2'   CA 1A0B'              	JZ	EX_Q
  19A5'                         EX_W:
  19A5'   CD 1A79'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  19A8'   D8                    	RC			; refused (message shown)
  19A9'   32 2451'              	STA	EXBAK
  19AC'   3A 244F'              	LDA	EXOP
  19AF'   FE 01                 	CPI	EO_W
  19B1'   CA 19C8'              	JZ	EX_WK
  19B4'   3A 2451'              	LDA	EXBAK
  19B7'   B7                    	ORA	A
  19B8'   C2 1A08'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  19BB'   3A 2462'              	LDA	EXBANG
  19BE'   B7                    	ORA	A
  19BF'   CA 1A08'              	JZ	EX_WQ		; so it does with '!'
  19C2'   CD 19C8'              	CALL	EX_WK		; else it may not: keep the text
  19C5'   C3 1A0B'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  19C8'                         EX_WK:
  19C8'   CD 0BB1'              	CALL	CURRW		; the cursor's row and file position
  19CB'   32 2454'              	STA	WPROW
  19CE'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  19D1'   7D                    	MOV	A,L
  19D2'   E6 7F                 	ANI	7FH
  19D4'   32 2455'              	STA	WPBYT
  19D7'   7D                    	MOV	A,L
  19D8'   17                    	RAL
  19D9'   7C                    	MOV	A,H
  19DA'   17                    	RAL
  19DB'   5F                    	MOV	E,A
  19DC'   3E 00                 	MVI	A,0
  19DE'   17                    	RAL
  19DF'   57                    	MOV	D,A		; DE = HL / 128
  19E0'   2A 0000*              	LHLD	OUTPOS
  19E3'   19                    	DAD	D
  19E4'   22 2456'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  19E7'   CD 1AAE'              	CALL	WRITE
  19EA'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  19ED'   2A 2456'              	LHLD	WPREC
  19F0'   EB                    	XCHG
  19F1'   3A 2455'              	LDA	WPBYT
  19F4'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  19F7'   CD 0000*              	CALL	GOTO
  19FA'   21 0000               	LXI	H,0
  19FD'   22 0000*              	SHLD	LNDLT
  1A00'   3A 2454'              	LDA	WPROW
  1A03'   6F                    	MOV	L,A
  1A04'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1A07'   C9                    	RET
  1A08'                         EX_WQ:
  1A08'   CD 1AAE'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1A0B'                         EX_Q:
  1A0B'   3A 2462'              	LDA	EXBANG
  1A0E'   B7                    	ORA	A
  1A0F'   CA 1A19'              	JZ	EX_QT
  1A12'   3A 2404'              	LDA	MODF
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  1A15'   B7                    	ORA	A
  1A16'   C2 1CCD'              	JNZ	MSGNWR		; changed, no '!': stay
  1A19'                         EX_QT:
  1A19'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1A1C'   3E 01                 	MVI	A,1
  1A1E'   32 2403'              	STA	QUITF
  1A21'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1A22'                         EX_E:
  1A22'   3A 2462'              	LDA	EXBANG
  1A25'   B7                    	ORA	A
  1A26'   CA 1A30'              	JZ	EE_GO
  1A29'   3A 2404'              	LDA	MODF
  1A2C'   B7                    	ORA	A
  1A2D'   C2 1CCD'              	JNZ	MSGNWR
  1A30'                         EE_GO:
  1A30'   3A 2450'              	LDA	EXARG
  1A33'   B7                    	ORA	A
  1A34'   C2 1A3B'              	JNZ	EE_ARG
  1A37'   CD 1AEA'              	CALL	OWNTF		; no name: the buffer's own
  1A3A'   D8                    	RC
  1A3B'                         EE_ARG:
  1A3B'   CD 1B00'              	CALL	ISOWN
  1A3E'   21 0001               	LXI	H,1
  1A41'   C2 1A48'              	JNZ	EE_LD		; another file: its first line
  1A44'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1A47'   23                    	INX	H		; HL = the cursor's line
  1A48'                         EE_LD:
  1A48'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1A4A'   32 2460'              	STA	MSGWHT
  1A4D'   E5                    	PUSH	H
  1A4E'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1A51'   21 0000*              	LXI	H,TFCB
  1A54'   11 0000*              	LXI	D,FNAME
  1A57'   CD 1B12'              	CALL	COPY12		; the buffer's name
  1A5A'   CD 1AD7'              	CALL	SRCTF
  1A5D'   CD 0000*              	CALL	REOPEN
  1A60'   CD 020E'              	CALL	MKCLR		; the marks named the buffer that just went
  1A63'   AF                    	XRA	A
  1A64'   32 2404'              	STA	MODF
  1A67'   E1                    	POP	H
  1A68'   2B                    	DCX	H
  1A69'   AF                    	XRA	A
  1A6A'   CD 0000*              	CALL	MVLIND		; down to the line
  1A6D'   CD 08C9'              	CALL	ATEOF
  1A70'   DC 08CF'              	CC	LASTLN		; past the last line: onto it
  1A73'   CD 0DD0'              	CALL	ZSAVE
  1A76'   C3 0EB9'              	JMP	GP_MID
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  1A79'                         WRCHK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A79'   3A 2450'              	LDA	EXARG
  1A7C'   B7                    	ORA	A
  1A7D'   C2 1A87'              	JNZ	WC_ARG
  1A80'   CD 1AEA'              	CALL	OWNTF
  1A83'   D8                    	RC
  1A84'   C3 1A9C'              	JMP	WC_OWN
  1A87'                         WC_ARG:
  1A87'   CD 1B00'              	CALL	ISOWN
  1A8A'   CA 1A9C'              	JZ	WC_OWN
  1A8D'   3A 2462'              	LDA	EXBANG
  1A90'   B7                    	ORA	A
  1A91'   CA 1A9A'              	JZ	WC_OTH
  1A94'   CD 0000*              	CALL	TEXIST
  1A97'   C2 1CC1'              	JNZ	MSGEXI		; File exists (! to force)
  1A9A'                         WC_OTH:
  1A9A'   AF                    	XRA	A		; (NC)
  1A9B'   C9                    	RET
  1A9C'                         WC_OWN:
  1A9C'   3A 2463'              	LDA	ROFLAG		; '-R': this is the file it may not write
  1A9F'   B7                    	ORA	A
  1AA0'   CA 1AAA'              	JZ	WC_OK
  1AA3'   3A 2462'              	LDA	EXBANG
  1AA6'   B7                    	ORA	A
  1AA7'   C2 1CC7'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  1AAA'                         WC_OK:
  1AAA'   3E 01                 	MVI	A,1
  1AAC'   B7                    	ORA	A		; (NC)
  1AAD'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  1AAE'                         WRITE:
  1AAE'   3A 2451'              	LDA	EXBAK
  1AB1'   CD 0000*              	CALL	WRTO
  1AB4'   3A 0001*              	LDA	FNAME+1
  1AB7'   FE 20                 	CPI	' '
  1AB9'   C2 1AC5'              	JNZ	WR_HAS
  1ABC'   21 0000*              	LXI	H,TFCB
  1ABF'   11 0000*              	LXI	D,FNAME
  1AC2'   CD 1B12'              	CALL	COPY12
  1AC5'                         WR_HAS:
  1AC5'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  1AC7'   32 2460'              	STA	MSGWHT
  1ACA'   CD 1B00'              	CALL	ISOWN
  1ACD'   C2 1AD7'              	JNZ	SRCTF
  1AD0'   AF                    	XRA	A
  1AD1'   32 2404'              	STA	MODF
  1AD4'   32 2461'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  1AD7'                         SRCTF:
  1AD7'   21 0000*              	LXI	H,TFCB
  1ADA'   11 005C               	LXI	D,DFTFCB
  1ADD'   CD 1B12'              	CALL	COPY12
  1AE0'   AF                    	XRA	A
  1AE1'   06 04                 	MVI	B,4
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1AE3'                         SRC_Z:
  1AE3'   12                    	STAX	D		; extent, s1, s2, record count: 0
  1AE4'   13                    	INX	D
  1AE5'   05                    	DCR	B
  1AE6'   C2 1AE3'              	JNZ	SRC_Z
  1AE9'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  1AEA'                         OWNTF:
  1AEA'   3A 0001*              	LDA	FNAME+1
  1AED'   FE 20                 	CPI	' '
  1AEF'   CA 1CBB'              	JZ	MSGNFN
  1AF2'   CD 1B1D'              	CALL	TFCLR
  1AF5'   21 0000*              	LXI	H,FNAME
  1AF8'   11 0000*              	LXI	D,TFCB
  1AFB'   CD 1B12'              	CALL	COPY12
  1AFE'   B7                    	ORA	A		; (NC)
  1AFF'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  1B00'                         ISOWN:
  1B00'   21 0000*              	LXI	H,TFCB
  1B03'   11 0000*              	LXI	D,FNAME
  1B06'   06 0C                 	MVI	B,12
  1B08'                         IO_LP:
  1B08'   1A                    	LDAX	D
  1B09'   BE                    	CMP	M
  1B0A'   C0                    	RNZ
  1B0B'   23                    	INX	H
  1B0C'   13                    	INX	D
  1B0D'   05                    	DCR	B
  1B0E'   C2 1B08'              	JNZ	IO_LP
  1B11'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  1B12'                         COPY12:
  1B12'   06 0C                 	MVI	B,12
  1B14'                         CP_LP:
  1B14'   7E                    	MOV	A,M
  1B15'   12                    	STAX	D
  1B16'   23                    	INX	H
  1B17'   13                    	INX	D
  1B18'   05                    	DCR	B
  1B19'   C2 1B14'              	JNZ	CP_LP
  1B1C'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  1B1D'                         TFCLR:
  1B1D'   11 0000*              	LXI	D,TFCB
  1B20'   06 24                 	MVI	B,36
  1B22'   AF                    	XRA	A
  1B23'                         TC_LP:
  1B23'   12                    	STAX	D
  1B24'   13                    	INX	D
  1B25'   05                    	DCR	B
  1B26'   C2 1B23'              	JNZ	TC_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1B29'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  1B2A'                         FOPEN:
  1B2A'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  1B2C'   32 2460'              	STA	MSGWHT
  1B2F'   21 005C               	LXI	H,DFTFCB
  1B32'   CD 1C04'              	CALL	NRMDRV
  1B35'   11 0000*              	LXI	D,FNAME
  1B38'   CD 1B12'              	CALL	COPY12
  1B3B'   CD 0000*              	CALL	OPENZ
  1B3E'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  1B41'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  1B43'   C8                    	RZ
  1B44'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  1B47'   32 2461'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  1B4A'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  1B4B'                         ARGSCN:
  1B4B'   3A 0080               	LDA	CMDTAIL
  1B4E'   47                    	MOV	B,A		; B = what is left of the line
  1B4F'   B7                    	ORA	A
  1B50'   C8                    	RZ
  1B51'   21 0081               	LXI	H,CMDTAIL+1
  1B54'                         AS_TOK:				; at a token, or the blanks before one
  1B54'   7E                    	MOV	A,M
  1B55'   FE 20                 	CPI	' '
  1B57'   C2 1B60'              	JNZ	AS_OPT
  1B5A'   23                    	INX	H
  1B5B'   05                    	DCR	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1B5C'   C2 1B54'              	JNZ	AS_TOK
  1B5F'   C9                    	RET
  1B60'                         AS_OPT:
  1B60'   FE 2B                 	CPI	'+'
  1B62'   CA 1B8C'              	JZ	AS_PLS
  1B65'   FE 2D                 	CPI	'-'
  1B67'   CA 1B7B'              	JZ	AS_SW
  1B6A'   FE 2F                 	CPI	'/'
  1B6C'   CA 1B7B'              	JZ	AS_SW
  1B6F'                         AS_SKP:				; not ours (the file name): on to the next one
  1B6F'   23                    	INX	H
  1B70'   05                    	DCR	B
  1B71'   C8                    	RZ
  1B72'   7E                    	MOV	A,M
  1B73'   FE 20                 	CPI	' '
  1B75'   C2 1B6F'              	JNZ	AS_SKP
  1B78'   C3 1B54'              	JMP	AS_TOK
  1B7B'                         AS_SW:
  1B7B'   23                    	INX	H
  1B7C'   05                    	DCR	B
  1B7D'   C8                    	RZ
  1B7E'   7E                    	MOV	A,M
  1B7F'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  1B81'   FE 52                 	CPI	'R'
  1B83'   C2 1B6F'              	JNZ	AS_SKP
  1B86'   32 2463'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  1B89'   C3 1B6F'              	JMP	AS_SKP
  1B8C'                         AS_PLS:
  1B8C'   3E 01                 	MVI	A,1
  1B8E'   32 2464'              	STA	PLUSF		; '+' gets the line even with no number on it
  1B91'   11 0000*              	LXI	D,PLUSB
  1B94'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  1B96'   23                    	INX	H		;   line space, so it is taken as '+' alone
  1B97'   05                    	DCR	B
  1B98'   CA 1BCF'              	JZ	AS_PE
  1B9B'   7E                    	MOV	A,M
  1B9C'   FE 30                 	CPI	'0'
  1B9E'   C2 1BB6'              	JNZ	AS_PD
  1BA1'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  1BA1'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  1BA2'   05                    	DCR	B
  1BA3'   CA 1BD7'              	JZ	AS_P1
  1BA6'   7E                    	MOV	A,M
  1BA7'   FE 30                 	CPI	'0'
  1BA9'   CA 1BA1'              	JZ	AS_PZ
  1BAC'   FE 31                 	CPI	'1'
  1BAE'   DA 1BD7'              	JC	AS_P1		; zeros and then no digit at all: line 1
  1BB1'   FE 3A                 	CPI	'9'+1
  1BB3'   D2 1BD7'              	JNC	AS_P1
  1BB6'                         AS_PD:				; the digits, as typed
  1BB6'   7E                    	MOV	A,M
  1BB7'   FE 30                 	CPI	'0'
  1BB9'   DA 1BCF'              	JC	AS_PE
  1BBC'   FE 3A                 	CPI	'9'+1
  1BBE'   D2 1BCF'              	JNC	AS_PE
  1BC1'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1BC2'   B7                    	ORA	A
  1BC3'   CA 1BDE'              	JZ	AS_POV
  1BC6'   0D                    	DCR	C
  1BC7'   7E                    	MOV	A,M
  1BC8'   12                    	STAX	D
  1BC9'   13                    	INX	D
  1BCA'   23                    	INX	H
  1BCB'   05                    	DCR	B
  1BCC'   C2 1BB6'              	JNZ	AS_PD
  1BCF'                         AS_PE:
  1BCF'   AF                    	XRA	A
  1BD0'   12                    	STAX	D		; the digits end with a 0
  1BD1'   78                    	MOV	A,B
  1BD2'   B7                    	ORA	A
  1BD3'   C8                    	RZ
  1BD4'   C3 1B54'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  1BD7'                         AS_P1:
  1BD7'   3E 31                 	MVI	A,'1'
  1BD9'   12                    	STAX	D
  1BDA'   13                    	INX	D
  1BDB'   C3 1BCF'              	JMP	AS_PE
  1BDE'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  1BDE'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  1BE1'   C3 1BCF'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  1BE4'                         ARGGO:
  1BE4'   3A 2464'              	LDA	PLUSF
  1BE7'   B7                    	ORA	A
  1BE8'   C8                    	RZ
  1BE9'   21 0000*              	LXI	H,PLUSB
  1BEC'                         AG_LP:
  1BEC'   7E                    	MOV	A,M
  1BED'   B7                    	ORA	A
  1BEE'   CA 1BFD'              	JZ	AG_G
  1BF1'   4F                    	MOV	C,A
  1BF2'   06 02                 	MVI	B,KT_CHAR
  1BF4'   E5                    	PUSH	H
  1BF5'   CD 001F'              	CALL	VICMD
  1BF8'   E1                    	POP	H
  1BF9'   23                    	INX	H
  1BFA'   C3 1BEC'              	JMP	AG_LP
  1BFD'                         AG_G:
  1BFD'   0E 47                 	MVI	C,'G'
  1BFF'   06 02                 	MVI	B,KT_CHAR
  1C01'   C3 001F'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
