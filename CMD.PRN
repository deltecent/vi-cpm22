  0BEF'   22 26F7'              	SHLD	WKN
  0BF2'   2A 26F5'              	LHLD	WKI
  0BF5'   23                    	INX	H
  0BF6'   22 26F5'              	SHLD	WKI
  0BF9'                         ES_WS:
  0BF9'   2A 26F5'              	LHLD	WKI
  0BFC'   EB                    	XCHG
  0BFD'   2A 26F7'              	LHLD	WKN
