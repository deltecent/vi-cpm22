  0F43'   E1                    	POP	H
  0F44'   43                    	MOV	B,E
  0F45'   CD 11DA'              	CALL	RWBAK		; HL -> the line that row is in, C = its rows
  0F48'   DA 0F65'              	JC	VPU_3		;   above it; or the file's first line
  0F4B'   79                    	MOV	A,C
  0F4C'   B7                    	ORA	A
  0F4D'   CA 0F65'              	JZ	VPU_3
  0F50'   3A 2E83'              	LDA	RWMV
  0F53'   B7                    	ORA	A
  0F54'   C2 0F64'              	JNZ	VPU_2
  0F57'   E5                    	PUSH	H
  0F58'   CD 1148'              	CALL	HTIX
  0F5B'   3C                    	INR	A
  0F5C'   21 2E7E'              	LXI	H,HTTP
  0F5F'   BE                    	CMP	M
  0F60'   E1                    	POP	H
  0F61'   CA 0F65'              	JZ	VPU_3		; the first line back: all of it
  0F64'                         VPU_2:
  0F64'   23                    	INX	H
  0F65'                         VPU_3:
  0F65'   CD 114E'              	CALL	HTGO		; the cursor on the new top line ...
  0F68'   3A 0000*              	LDA	NEDIT
  0F6B'   4F                    	MOV	C,A
  0F6C'   06 00                 	MVI	B,0
  0F6E'   CD 112F'              	CALL	HTRB		; ... and the lines under it measured
  0F71'   E5                    	PUSH	H
  0F72'   3A 0000*              	LDA	NEDIT
  0F75'   4F                    	MOV	C,A
  0F76'   CD 1159'              	CALL	HTFQ		; HL -> the first the screen has not room for
  0F79'   2B                    	DCX	H
  0F7A'   D1                    	POP	D		; DE -> the top line's rows
  0F7B'   EB                    	XCHG
  0F7C'   CD 0000*              	CALL	CMP16		; CY iff that is above the top line (it alone
