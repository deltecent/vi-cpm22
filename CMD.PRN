  0918'   2A 290C'              	LHLD	JKCNT
  091B'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  091E'   D2 0922'              	JNC	KC_N
  0921'   EB                    	XCHG			; HL = limit
