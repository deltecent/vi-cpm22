  0CBD'   E1                    	POP	H		; HL = i+1
  0CBE'   47                    	MOV	B,A
  0CBF'   3A 29E4'              	LDA	WKCLS
  0CC2'   B8                    	CMP	B
  0CC3'   C2 0CCC'              	JNZ	ES_LND
  0CC6'   22 29DC'              	SHLD	WKI
  0CC9'   C3 0CA4'              	JMP	ES_RUN
  0CCC'                         ES_LND:
  0CCC'   2A 29DE'              	LHLD	WKN
  0CCF'   EB                    	XCHG
  0CD0'   2A 29DC'              	LHLD	WKI
  0CD3'   CD 0000*              	CALL	CMP16		; DE=n vs HL=i: CY iff n < i
  0CD6'   DA 0CE2'              	JC	ES_CL
  0CD9'   CA 0CE2'              	JZ	ES_CL
  0CDC'   2A 29DC'              	LHLD	WKI
  0CDF'   C3 057A'              	JMP	GOSET
  0CE2'                         ES_CL:
  0CE2'   2A 29DE'              	LHLD	WKN
  0CE5'   7C                    	MOV	A,H
  0CE6'   B5                    	ORA	L
  0CE7'   C8                    	RZ
  0CE8'   2B                    	DCX	H
  0CE9'   C3 057A'              	JMP	GOSET
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0CEC'                         CURRW:
  0CEC'   2A 0000*              	LHLD	WINROW
  0CEF'   EB                    	XCHG
  0CF0'   2A 0000*              	LHLD	LNDLT
  0CF3'   19                    	DAD	D		; HL = row (signed)
  0CF4'   7C                    	MOV	A,H
  0CF5'   B7                    	ORA	A
  0CF6'   FA 0D09'              	JM	CRW_0		; above the screen -> top row
  0CF9'   C2 0D04'              	JNZ	CRW_BT		; far below -> bottom row
  0CFC'   3A 0000*              	LDA	NEDIT
  0CFF'   3D                    	DCR	A		; A = bottom row
  0D00'   BD                    	CMP	L		; CY iff bottom < row
  0D01'   D8                    	RC
  0D02'   7D                    	MOV	A,L
  0D03'   C9                    	RET
  0D04'                         CRW_BT:
  0D04'   3A 0000*              	LDA	NEDIT
  0D07'   3D                    	DCR	A
  0D08'   C9                    	RET
  0D09'                         CRW_0:
  0D09'   AF                    	XRA	A
  0D0A'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0D0B'                         SETRWT:
  0D0B'   2A 0000*              	LHLD	LNDLT
  0D0E'   EB                    	XCHG
  0D0F'   6F                    	MOV	L,A
  0D10'   26 00                 	MVI	H,0
  0D12'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0D15'   22 0000*              	SHLD	WINROW
  0D18'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0D19'                         MVROW:
  0D19'   47                    	MOV	B,A
  0D1A'   CD 0CEC'              	CALL	CURRW
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D1D'   90                    	SUB	B		; A = row now - target
  0D1E'   C8                    	RZ
  0D1F'   DA 0D28'              	JC	MR_DN
  0D22'   6F                    	MOV	L,A
  0D23'   26 00                 	MVI	H,0
  0D25'   C3 0973'              	JMP	KCORE
  0D28'                         MR_DN:
  0D28'   2F                    	CMA
  0D29'   3C                    	INR	A		; A = target - row now
  0D2A'   6F                    	MOV	L,A
  0D2B'   26 00                 	MVI	H,0
  0D2D'   C3 08D6'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0D30'                         VC_HIGH:
  0D30'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D33'   2B                    	DCX	H		; row = count - 1
  0D34'   7C                    	MOV	A,H
  0D35'   B7                    	ORA	A
  0D36'   3A 0000*              	LDA	SCBOT
  0D39'   C2 0D41'              	JNZ	VH_GO		; >= 256 -> the last text row
  0D3C'   BD                    	CMP	L		; CY iff SCBOT < row
  0D3D'   DA 0D41'              	JC	VH_GO
  0D40'   7D                    	MOV	A,L
  0D41'                         VH_GO:
  0D41'   CD 0D19'              	CALL	MVROW
  0D44'   C3 0828'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0D47'                         VC_MIDL:
  0D47'   CD 0678'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0D4A'   3A 0000*              	LDA	SCBOT
  0D4D'   B7                    	ORA	A		; clear CY for the shift
  0D4E'   1F                    	RAR			; A = SCBOT / 2
  0D4F'   CD 0D19'              	CALL	MVROW
  0D52'   C3 0828'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0D55'                         VC_LOWL:
  0D55'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D58'   2B                    	DCX	H		; count - 1
  0D59'   3A 0000*              	LDA	SCBOT
  0D5C'   5F                    	MOV	E,A
  0D5D'   16 00                 	MVI	D,0
  0D5F'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0D60'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0D63'   3E 00                 	MVI	A,0
  0D65'   D2 0D6C'              	JNC	VL_GO		; at or past the top -> row 0
  0D68'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0D6B'   7D                    	MOV	A,L
  0D6C'                         VL_GO:
  0D6C'   CD 0D19'              	CALL	MVROW
  0D6F'   C3 0828'              	JMP	FNBLNK
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0D72'                         VC_PGDN:
  0D72'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D75'   3A 0000*              	LDA	SCEOF
  0D78'   B7                    	ORA	A
  0D79'   CA 0D87'              	JZ	VPD_N
  0D7C'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0D7F'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0D80'   C8                    	RZ			; it already is
  0D81'   CD 0D19'              	CALL	MVROW
  0D84'   C3 0D98'              	JMP	VPD_TP
  0D87'                         VPD_N:
  0D87'   3A 0000*              	LDA	NEDIT
  0D8A'   D6 02                 	SUI	2
  0D8C'   CD 0DE0'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0D8F'   E5                    	PUSH	H
  0D90'   AF                    	XRA	A
  0D91'   CD 0D19'              	CALL	MVROW		; the top line
  0D94'   E1                    	POP	H
  0D95'   CD 08D6'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0D98'                         VPD_TP:
  0D98'   AF                    	XRA	A
  0D99'   CD 0D0B'              	CALL	SETRWT		; to the top row
  0D9C'   C3 0828'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0D9F'                         VC_PGUP:
  0D9F'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0DA2'   3A 0000*              	LDA	SCBOF
  0DA5'   B7                    	ORA	A
  0DA6'   C0                    	RNZ
  0DA7'   3A 0000*              	LDA	NEDIT
  0DAA'   47                    	MOV	B,A
  0DAB'   3A 0000*              	LDA	SCEOF
  0DAE'   B7                    	ORA	A
  0DAF'   CA 0DC0'              	JZ	VPU_2
  0DB2'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0DB5'   FE 02                 	CPI	2
  0DB7'   D2 0DC0'              	JNC	VPU_2
  0DBA'   2F                    	CMA
  0DBB'   3C                    	INR	A
  0DBC'   80                    	ADD	B
  0DBD'   C3 0DC3'              	JMP	VPU_P
  0DC0'                         VPU_2:
  0DC0'   78                    	MOV	A,B
  0DC1'   D6 02                 	SUI	2
  0DC3'                         VPU_P:
  0DC3'   CD 0DE0'              	CALL	MULSAT		; HL = count * page
  0DC6'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0DC7'   AF                    	XRA	A
  0DC8'   CD 0D19'              	CALL	MVROW		; the top line
  0DCB'   E1                    	POP	H
  0DCC'   CD 0973'              	CALL	KCORE		; the new top line
  0DCF'   AF                    	XRA	A
  0DD0'   CD 0D0B'              	CALL	SETRWT		; on the top row
  0DD3'   3A 0000*              	LDA	NEDIT
  0DD6'   3D                    	DCR	A
  0DD7'   6F                    	MOV	L,A
  0DD8'   26 00                 	MVI	H,0
  0DDA'   CD 08D6'              	CALL	JCORE		; the bottom row's line
  0DDD'   C3 0828'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0DE0'                         MULSAT:
  0DE0'   EB                    	XCHG
  0DE1'   21 0000               	LXI	H,0
  0DE4'   B7                    	ORA	A
  0DE5'   C8                    	RZ
  0DE6'                         MS_LP:
  0DE6'   19                    	DAD	D
  0DE7'   DA 0DEF'              	JC	MS_SAT
  0DEA'   3D                    	DCR	A
  0DEB'   C2 0DE6'              	JNZ	MS_LP
  0DEE'   C9                    	RET
  0DEF'                         MS_SAT:
  0DEF'   21 FFFF               	LXI	H,0FFFFH
  0DF2'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0DF3'                         VC_HFDN:
  0DF3'   CD 075A'              	CALL	SETMOV
  0DF6'   CD 0CEC'              	CALL	CURRW
  0DF9'   32 29A2'              	STA	HFROW
  0DFC'   CD 0E6A'              	CALL	HFCNT		; HL = lines
  0DFF'   3A 29A2'              	LDA	HFROW
  0E02'   47                    	MOV	B,A
  0E03'   3A 0000*              	LDA	SCEOF
  0E06'   B7                    	ORA	A
  0E07'   CA 0E0F'              	JZ	VHD_GO
  0E0A'   3A 0000*              	LDA	SCBOT		; the last line's row
  0E0D'   B8                    	CMP	B
  0E0E'   C8                    	RZ			; the cursor is on it
  0E0F'                         VHD_GO:
  0E0F'   CD 08D6'              	CALL	JCORE
  0E12'   3A 0000*              	LDA	SCEOF
  0E15'   B7                    	ORA	A
  0E16'   C2 0828'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0E19'   3A 29A2'              	LDA	HFROW
  0E1C'   CD 0D0B'              	CALL	SETRWT
  0E1F'   3E 01                 	MVI	A,1
  0E21'   32 0000*              	STA	WFILL		; not past the end of the file
  0E24'   C3 0828'              	JMP	FNBLNK
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0E27'                         VC_HFUP:
  0E27'   CD 075A'              	CALL	SETMOV
  0E2A'   CD 0CEC'              	CALL	CURRW
  0E2D'   32 29A2'              	STA	HFROW
  0E30'   CD 0E6A'              	CALL	HFCNT		; HL = lines
  0E33'   CD 0E4A'              	CALL	ONFST
  0E36'   C8                    	RZ			; the cursor is on the first line
  0E37'   CD 0973'              	CALL	KCORE
  0E3A'   3A 0000*              	LDA	SCBOF
  0E3D'   B7                    	ORA	A
  0E3E'   C2 0828'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0E41'   3A 29A2'              	LDA	HFROW
  0E44'   CD 0D0B'              	CALL	SETRWT
  0E47'   C3 0828'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0E4A'                         ONFST:
  0E4A'   E5                    	PUSH	H
  0E4B'   2A 0000*              	LHLD	OUTPOS
  0E4E'   7C                    	MOV	A,H
  0E4F'   B5                    	ORA	L
  0E50'   C2 0E68'              	JNZ	OF_RET
  0E53'   2A 0000*              	LHLD	TXTBEG
  0E56'   EB                    	XCHG			; DE = TXTBEG
  0E57'   2A 0000*              	LHLD	GAPBEG
  0E5A'                         OF_LP:
  0E5A'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0E5D'   CA 0E68'              	JZ	OF_RET
  0E60'   2B                    	DCX	H
  0E61'   7E                    	MOV	A,M
  0E62'   FE 0A                 	CPI	LF
  0E64'   C2 0E5A'              	JNZ	OF_LP
  0E67'   B7                    	ORA	A		; NZ
  0E68'                         OF_RET:
  0E68'   E1                    	POP	H
  0E69'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0E6A'                         HFCNT:
  0E6A'   2A 2996'              	LHLD	CMDCNT
  0E6D'   7C                    	MOV	A,H
  0E6E'   B5                    	ORA	L
  0E6F'   CA 0E86'              	JZ	HFC_AM
  0E72'   CD 068B'              	CALL	GETCNT		; HL = count; clears it
  0E75'   3A 0000*              	LDA	NEDIT
  0E78'   5F                    	MOV	E,A
  0E79'   16 00                 	MVI	D,0
  0E7B'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E7E'   D2 0E82'              	JNC	HFC_ST
  0E81'   EB                    	XCHG			; HL = NEDIT
  0E82'                         HFC_ST:
  0E82'   7D                    	MOV	A,L
  0E83'   32 29A3'              	STA	HFAMT
  0E86'                         HFC_AM:
  0E86'   3A 29A3'              	LDA	HFAMT
  0E89'   B7                    	ORA	A
  0E8A'   C2 0E97'              	JNZ	HFC_HL
  0E8D'   3A 0000*              	LDA	NEDIT
  0E90'   B7                    	ORA	A
  0E91'   1F                    	RAR
  0E92'   B7                    	ORA	A
  0E93'   C2 0E97'              	JNZ	HFC_HL
  0E96'   3C                    	INR	A		; at least one line
  0E97'                         HFC_HL:
  0E97'   6F                    	MOV	L,A
  0E98'   26 00                 	MVI	H,0
  0E9A'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0E9B'                         VC_REDR:
  0E9B'   C3 068B'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0E9E'                         VC_G:
  0E9E'   CD 075A'              	CALL	SETMOV
  0EA1'   CD 0F60'              	CALL	GZONE		; the screen's top line, before the move
  0EA4'   CD 06B4'              	CALL	BRKON		; ... and a ^C may stop it from here on
  0EA7'   2A 2996'              	LHLD	CMDCNT
  0EAA'   7C                    	MOV	A,H
  0EAB'   B5                    	ORA	L
  0EAC'   C2 0EBF'              	JNZ	VG_N
  0EAF'   AF                    	XRA	A		; forward
  0EB0'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0EB3'   CD 06EB'              	CALL	BRKOFF
  0EB6'   DA 0703'              	JC	BRKBAK
  0EB9'   CD 0A0A'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0EBC'   C3 0F78'              	JMP	GPLACE
  0EBF'                         VG_N:
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0EBF'   CD 068B'              	CALL	GETCNT		; HL = target line (1-based)
  0EC2'                         VG_LN:
  0EC2'   CD 0ECE'              	CALL	GOLN
  0EC5'   CD 06EB'              	CALL	BRKOFF
  0EC8'   DA 0703'              	JC	BRKBAK
  0ECB'   C3 0F78'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  0ECE'                         GOLN:
  0ECE'   E5                    	PUSH	H
  0ECF'   CD 0000*              	CALL	CNTLF
  0ED2'   23                    	INX	H		; HL = the cursor's line
  0ED3'   D1                    	POP	D		; DE = the line wanted
  0ED4'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  0ED7'   DA 0EE2'              	JC	GLN_BK
  0EDA'   EB                    	XCHG
  0EDB'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  0EDE'   AF                    	XRA	A
  0EDF'   C3 0EE7'              	JMP	GLN_MV
  0EE2'                         GLN_BK:
  0EE2'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  0EE5'   3E FF                 	MVI	A,0FFH
  0EE7'                         GLN_MV:
  0EE7'   CD 0000*              	CALL	MVLIND
  0EEA'   CD 0A04'              	CALL	ATEOF
  0EED'   DC 0A0A'              	CC	LASTLN		; past the last line: onto it
  0EF0'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0EF1'                         VC_LG:
  0EF1'   CD 075A'              	CALL	SETMOV
  0EF4'   3A 29BE'              	LDA	GSAVE
  0EF7'   B7                    	ORA	A
  0EF8'   C2 0F01'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0EFB'   3E 01                 	MVI	A,PG
  0EFD'   32 29BD'              	STA	GPEND
  0F00'   C9                    	RET
  0F01'                         VLG_GG:
  0F01'   CD 0F60'              	CALL	GZONE
  0F04'   CD 06B4'              	CALL	BRKON
  0F07'   CD 068B'              	CALL	GETCNT		; HL = target line (no count: 1)
  0F0A'   C3 0EC2'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0F0D'                         SUB24:
  0F0D'   4F                    	MOV	C,A
  0F0E'   7D                    	MOV	A,L
  0F0F'   93                    	SUB	E
  0F10'   6F                    	MOV	L,A
  0F11'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0F12'   9A                    	SBB	D
  0F13'   67                    	MOV	H,A
  0F14'   79                    	MOV	A,C
  0F15'   98                    	SBB	B
  0F16'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0F17'                         CURFP:
  0F17'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0F1A'                         FPOS:
  0F1A'   C5                    	PUSH	B
  0F1B'   D5                    	PUSH	D
  0F1C'   EB                    	XCHG
  0F1D'   2A 0000*              	LHLD	TXTBEG
  0F20'   EB                    	XCHG
  0F21'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0F24'   EB                    	XCHG			; DE = that
  0F25'   2A 0000*              	LHLD	OUTPOS
  0F28'   7C                    	MOV	A,H
  0F29'   B7                    	ORA	A		; CY = 0
  0F2A'   1F                    	RAR
  0F2B'   47                    	MOV	B,A
  0F2C'   7D                    	MOV	A,L
  0F2D'   1F                    	RAR
  0F2E'   67                    	MOV	H,A
  0F2F'   3E 00                 	MVI	A,0
  0F31'   1F                    	RAR
  0F32'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0F33'   19                    	DAD	D
  0F34'   78                    	MOV	A,B
  0F35'   CE 00                 	ACI	0		; A:HL = the position
  0F37'   D1                    	POP	D
  0F38'   C1                    	POP	B
  0F39'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0F3A'                         ZSAVE:
  0F3A'   2A 2996'              	LHLD	CMDCNT
  0F3D'   22 29FC'              	SHLD	ZSVCNT
  0F40'   2A 0000*              	LHLD	AUXCNT
  0F43'   22 29FE'              	SHLD	ZSVAUX
  0F46'   3A 0000*              	LDA	DIRFLG
  0F49'   32 2A00'              	STA	ZSVDIR
  0F4C'   C9                    	RET
  0F4D'                         ZREST:
  0F4D'   2A 29FC'              	LHLD	ZSVCNT
  0F50'   22 2996'              	SHLD	CMDCNT
  0F53'   2A 29FE'              	LHLD	ZSVAUX
  0F56'   22 0000*              	SHLD	AUXCNT
  0F59'   3A 2A00'              	LDA	ZSVDIR
  0F5C'   32 0000*              	STA	DIRFLG
  0F5F'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0F60'                         GZONE:
  0F60'   CD 0F3A'              	CALL	ZSAVE
  0F63'   CD 0CEC'              	CALL	CURRW
  0F66'   6F                    	MOV	L,A
  0F67'   26 00                 	MVI	H,0
  0F69'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0F6C'   CD 0F1A'              	CALL	FPOS
  0F6F'   22 0000*              	SHLD	ZTOP
  0F72'   32 0002*              	STA	ZTOP+2
  0F75'   C3 0F4D'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0F78'                         GPLACE:
  0F78'   CD 0F3A'              	CALL	ZSAVE
  0F7B'   CD 0F17'              	CALL	CURFP
  0F7E'   EB                    	XCHG
  0F7F'   2A 0000*              	LHLD	ZTOP
  0F82'   EB                    	XCHG
  0F83'   4F                    	MOV	C,A		; C:HL = the target's position
  0F84'   3A 0002*              	LDA	ZTOP+2
  0F87'   47                    	MOV	B,A		; B:DE = the top's
  0F88'   79                    	MOV	A,C
  0F89'   CD 0F0D'              	CALL	SUB24
  0F8C'   22 29F9'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  0F8F'   DA 0FDC'              	JC	GP_UP
  0F92'   B7                    	ORA	A
  0F93'   C2 101D'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0F96'   3A 0000*              	LDA	NEDIT
  0F99'   5F                    	MOV	E,A
  0F9A'   16 00                 	MVI	D,0
  0F9C'   B7                    	ORA	A
  0F9D'   1F                    	RAR
  0F9E'   6F                    	MOV	L,A
  0F9F'   26 00                 	MVI	H,0
  0FA1'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0FA2'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0FA5'   CD 0684'              	CALL	GBSUB		; HL = bytes from there to the target
  0FA8'   EB                    	XCHG
  0FA9'   2A 29F9'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0FAC'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0FAF'   DA 101D'              	JC	GP_MID
  0FB2'   CD 0684'              	CALL	GBSUB		; HL = the top line's start (resident)
  0FB5'   01 0000               	LXI	B,0		; BC = lines from the top
  0FB8'                         GP_CNT:
  0FB8'   7A                    	MOV	A,D
  0FB9'   B3                    	ORA	E
  0FBA'   CA 0FC9'              	JZ	GP_DN
  0FBD'   7E                    	MOV	A,M
  0FBE'   23                    	INX	H
  0FBF'   1B                    	DCX	D
  0FC0'   FE 0A                 	CPI	LF
  0FC2'   C2 0FB8'              	JNZ	GP_CNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0FC5'   03                    	INX	B
  0FC6'   C3 0FB8'              	JMP	GP_CNT
  0FC9'                         GP_DN:
  0FC9'   3A 0000*              	LDA	NEDIT
  0FCC'   3D                    	DCR	A
  0FCD'   5F                    	MOV	E,A
  0FCE'   16 00                 	MVI	D,0		; DE = the bottom row
  0FD0'   60                    	MOV	H,B
  0FD1'   69                    	MOV	L,C
  0FD2'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0FD5'   DA 1027'              	JC	GP_SET		; A = the bottom row
  0FD8'   7D                    	MOV	A,L		; on the screen: its row
  0FD9'   C3 1047'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0FDC'                         GP_UP:
  0FDC'   3C                    	INR	A
  0FDD'   C2 101D'              	JNZ	GP_MID		; 64K bytes or more above
  0FE0'   2A 29F9'              	LHLD	ZDIF
  0FE3'   EB                    	XCHG
  0FE4'   21 0000               	LXI	H,0
  0FE7'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0FEA'   7C                    	MOV	A,H
  0FEB'   B5                    	ORA	L
  0FEC'   CA 101D'              	JZ	GP_MID		; exactly 64K
  0FEF'   EB                    	XCHG			; DE = bytes to read
  0FF0'   AF                    	XRA	A
  0FF1'   32 29FB'              	STA	ZLF
  0FF4'   CD 0000*              	CALL	RGET0
  0FF7'                         GP_RD:
  0FF7'   CD 0000*              	CALL	RDGET		; (keeps DE)
  0FFA'   DA 101D'              	JC	GP_MID
  0FFD'   FE 0A                 	CPI	LF
  0FFF'   C2 1013'              	JNZ	GP_RN
  1002'   3A 0000*              	LDA	NEDIT
  1005'   B7                    	ORA	A
  1006'   1F                    	RAR
  1007'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  1009'   E5                    	PUSH	H
  100A'   21 29FB'              	LXI	H,ZLF
  100D'   34                    	INR	M
  100E'   BE                    	CMP	M		; CY iff more lines than that
  100F'   E1                    	POP	H
  1010'   DA 101D'              	JC	GP_MID
  1013'                         GP_RN:
  1013'   1B                    	DCX	D
  1014'   7A                    	MOV	A,D
  1015'   B3                    	ORA	E
  1016'   C2 0FF7'              	JNZ	GP_RD
  1019'   AF                    	XRA	A		; the top row
  101A'   C3 1027'              	JMP	GP_SET
  101D'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  101D'   3E 01                 	MVI	A,1
  101F'   32 0000*              	STA	WFILL		; not past the end of the file
  1022'   3A 0000*              	LDA	NEDIT
  1025'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  1026'   1F                    	RAR			; the middle row
  1027'                         GP_SET:
  1027'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  1028'   26 00                 	MVI	H,0
  102A'   22 0000*              	SHLD	WINROW
  102D'   21 0000               	LXI	H,0
  1030'   22 0000*              	SHLD	LNDLT
  1033'   CD 077B'              	CALL	SETFUL		; the window may have paged: full repaint
  1036'                         GP_FIN:
  1036'   CD 0F4D'              	CALL	ZREST
  1039'   3A 2A23'              	LDA	GPKEEP
  103C'   B7                    	ORA	A
  103D'   CA 0828'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  1040'   AF                    	XRA	A
  1041'   32 2A23'              	STA	GPKEEP
  1044'   C3 057D'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  1047'                         GP_ONS:
  1047'   6F                    	MOV	L,A
  1048'   26 00                 	MVI	H,0		; HL = the row it lands on
  104A'   EB                    	XCHG
  104B'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  104E'   EB                    	XCHG
  104F'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  1052'   22 0000*              	SHLD	LNDLT
  1055'   3E 01                 	MVI	A,R_MOVE
  1057'   32 299A'              	STA	RINTENT
  105A'   C3 1036'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  105D'                         OPPEND:
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  105D'   AF                    	XRA	A
  105E'   32 29C3'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  1061'   3A 29C0'              	LDA	PSAVE
  1064'   FE 63                 	CPI	'c'
  1066'   C2 1083'              	JNZ	OPP_ND
  1069'   79                    	MOV	A,C
  106A'   FE 77                 	CPI	'w'
  106C'   CA 1074'              	JZ	OPP_W
  106F'   FE 57                 	CPI	'W'
  1071'   C2 1083'              	JNZ	OPP_ND
  1074'                         OPP_W:
  1074'   CD 1256'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  1077'   DA 1083'              	JC	OPP_ND
  107A'   79                    	MOV	A,C
  107B'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  107D'   4F                    	MOV	C,A
  107E'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  1080'   32 29C3'              	STA	CWEOL		;   see the clamp in OPA_F
  1083'                         OPP_ND:
  1083'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  1084'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  1086'   C2 109A'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  1089'   CD 021C'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  108C'   DA 112A'              	JC	OPABRT
  108F'   79                    	MOV	A,C
  1090'   FE 67                 	CPI	'g'
  1092'   C2 112A'              	JNZ	OPABRT
  1095'   3E 01                 	MVI	A,PG
  1097'   32 29BE'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  109A'                         OPP_NG:
  109A'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  109B'   21 29C0'              	LXI	H,PSAVE
  109E'   BE                    	CMP	M
  109F'   CA 1277'              	JZ	OPLINE
  10A2'   79                    	MOV	A,C		; (OPCLS classifies the key)
  10A3'   CD 128D'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  10A6'   DA 112A'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  10A9'   32 29C2'              	STA	OPCLSV
  10AC'   47                    	MOV	B,A		; B = the class
  10AD'   3A 29C0'              	LDA	PSAVE
  10B0'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  10B2'   C2 10BE'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  10B5'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  10B6'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  10B8'   C2 10E0'              	JNZ	OPP_GO
  10BB'   C3 10C9'              	JMP	OPP_NO
  10BE'                         OPP_NC:
  10BE'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  10C0'   C2 10E0'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  10C3'   78                    	MOV	A,B		;   a charwise register would need a type flag
  10C4'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  10C6'   CA 10E0'              	JZ	OPP_GO		;   within a line -- neither of which is built
  10C9'                         OPP_NO:
  10C9'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  10CA'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  10CC'   CA 10DA'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  10CF'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  10D1'   CA 10DA'              	JZ	OPP_SW		;   so swallow it before dropping the command
  10D4'   CD 034C'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  10D7'   C2 112A'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  10DA'                         OPP_SW:
  10DA'   CD 021C'              	CALL	MKGETK
  10DD'   C3 112A'              	JMP	OPABRT
  10E0'                         OPP_GO:
  10E0'   AF                    	XRA	A
  10E1'   32 29A1'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  10E4'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  10E7'   22 29C4'              	SHLD	OPSTA
  10EA'   C5                    	PUSH	B
  10EB'   21 29C8'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  10EE'   CD 044F'              	CALL	FPSTO		;   only good until the motion pages the window
  10F1'   3A 29C2'              	LDA	OPCLSV
  10F4'   FE 02                 	CPI	2
  10F6'   CC 112D'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  10F9'   C1                    	POP	B
  10FA'   21 28C4'              	LXI	H,CMDTAB
  10FD'   CD 00C9'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1100'   3A 29C0'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1103'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1104'   CA 075A'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  1107'   CD 1159'              	CALL	OPSFIX		; where the start is in the window NOW
  110A'   D2 1175'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  110D'   22 29C4'              	SHLD	OPSTA
  1110'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1113'   22 29C6'              	SHLD	OPEND2
  1116'   3A 29C0'              	LDA	PSAVE
  1119'   FE 79                 	CPI	'y'
  111B'   CA 1744'              	JZ	OPYANK		; a yank takes the span without losing it
  111E'   CD 12C8'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  1121'   3A 29C0'              	LDA	PSAVE
  1124'   FE 63                 	CPI	'c'
  1126'   C0                    	RNZ
  1127'   C3 1500'              	JMP	SETINS
  112A'                         OPABRT:				; not a motion -> the operator is dropped and
  112A'   C3 00A9'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  112D'                         OPENDS:
  112D'   2A 29C4'              	LHLD	OPSTA
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  1130'   CD 05E4'              	CALL	BOL
  1133'   11 29CB'              	LXI	D,OPSLO
  1136'   CD 114B'              	CALL	OPE_ST
  1139'   2A 29C4'              	LHLD	OPSTA
  113C'   CD 0614'              	CALL	NLSTART
  113F'   11 29CE'              	LXI	D,OPSHI
  1142'   CD 114B'              	CALL	OPE_ST
  1145'   2A 29C4'              	LHLD	OPSTA
  1148'   C3 0000*              	JMP	GOTO
  114B'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  114B'   D5                    	PUSH	D
  114C'   CD 0000*              	CALL	GOTO
  114F'   E1                    	POP	H
  1150'   C3 044F'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  1153'                         CURBD:
  1153'   CD 0F17'              	CALL	CURFP
  1156'   EB                    	XCHG
  1157'   47                    	MOV	B,A
  1158'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  1159'                         OPSFIX:
  1159'   21 29C8'              	LXI	H,OPSFP
  115C'   CD 0402'              	CALL	MKLOAD
  115F'   CD 1153'              	CALL	CURBD
  1162'   2A 2A2D'              	LHLD	MKPOS
  1165'   3A 2A2F'              	LDA	MKPOS+2
  1168'   CD 0F0D'              	CALL	SUB24
  116B'   B4                    	ORA	H
  116C'   B5                    	ORA	L
  116D'   C2 040F'              	JNZ	MKWIN
  1170'   CD 0000*              	CALL	CUROFF
  1173'   37                    	STC
  1174'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  1175'                         OPPGD:
  1175'   47                    	MOV	B,A
  1176'   3A 29C2'              	LDA	OPCLSV
  1179'   FE 02                 	CPI	2
  117B'   C2 1237'              	JNZ	OPG_NO
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  117E'   3A 29C0'              	LDA	PSAVE
  1181'   FE 64                 	CPI	'd'
  1183'   C2 1237'              	JNZ	OPG_NO
  1186'   04                    	INR	B
  1187'   CA 1196'              	JZ	OPG_FW
  118A'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  118D'   CD 05E4'              	CALL	BOL		;   and the high end is OPSHI as it stands
  1190'   CD 0000*              	CALL	GOTO
  1193'   C3 11AE'              	JMP	OPG_GO
  1196'                         OPG_FW:
  1196'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  1199'   CD 0614'              	CALL	NLSTART		;   landed on, and the low one is where the
  119C'   11 29CE'              	LXI	D,OPSHI		;   start line began
  119F'   CD 114B'              	CALL	OPE_ST
  11A2'   21 29CB'              	LXI	H,OPSLO
  11A5'   CD 0402'              	CALL	MKLOAD
  11A8'   CD 03CF'              	CALL	MKPAGE
  11AB'   CD 0000*              	CALL	GOTO
  11AE'                         OPG_GO:
  11AE'   CD 1153'              	CALL	CURBD
  11B1'   2A 29CE'              	LHLD	OPSHI
  11B4'   3A 29D0'              	LDA	OPSHI+2
  11B7'   CD 0F0D'              	CALL	SUB24		; A:HL = the bytes to take
  11BA'                         OPG_SV:
  11BA'   22 29D1'              	SHLD	OPTOGO
  11BD'   32 29D3'              	STA	OPTOGO+2
  11C0'                         OPG_NX:
  11C0'   CD 0667'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  11C3'   CD 0000*              	CALL	SUBHD
  11C6'   EB                    	XCHG			; DE = what the window holds past the cursor
  11C7'   2A 29D1'              	LHLD	OPTOGO
  11CA'   3A 29D3'              	LDA	OPTOGO+2
  11CD'   B7                    	ORA	A
  11CE'   C2 1201'              	JNZ	OPG_PG		; 64K or more to go
  11D1'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  11D4'   DA 1201'              	JC	OPG_PG
  11D7'   CA 1201'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  11DA'                         OPG_FN:				; the rest of it is here
  11DA'   E5                    	PUSH	H
  11DB'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  11DE'   CD 0000*              	CALL	CUROFF
  11E1'   22 29D4'              	SHLD	OPLO
  11E4'   D1                    	POP	D
  11E5'   19                    	DAD	D
  11E6'   22 29D6'              	SHLD	OPHI
  11E9'   CD 1370'              	CALL	OPDSPN
  11EC'   CD 0A04'              	CALL	ATEOF
  11EF'   D2 1250'              	JNC	OPMID
  11F2'   CD 0E4A'              	CALL	ONFST		; deleted to the end of the file: onto the new
  11F5'   CA 1250'              	JZ	OPMID		;   last line, if there is one -- and the pager
  11F8'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  11FB'   CD 0000*              	CALL	SETBWD
  11FE'   C3 1250'              	JMP	OPMID
  1201'                         OPG_PG:
  1201'   7A                    	MOV	A,D
  1202'   B3                    	ORA	E
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  1203'   C2 121C'              	JNZ	OPG_DL
  1206'   CD 0A04'              	CALL	ATEOF		; nothing held past the cursor
  1209'   21 0000               	LXI	H,0
  120C'   DA 11DA'              	JC	OPG_FN		; ... and no more to come: the file ran out
  120F'   2B                    	DCX	H
  1210'   CD 0000*              	CALL	SETC0
  1213'   CD 0000*              	CALL	GOLINE
  1216'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  1219'   C3 11C0'              	JMP	OPG_NX
  121C'                         OPG_DL:
  121C'   D5                    	PUSH	D
  121D'   21 FFFF               	LXI	H,0FFFFH
  1220'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1223'   E1                    	POP	H
  1224'   E5                    	PUSH	H
  1225'   CD 0000*              	CALL	DELFWD
  1228'   D1                    	POP	D
  1229'   06 00                 	MVI	B,0
  122B'   2A 29D1'              	LHLD	OPTOGO
  122E'   3A 29D3'              	LDA	OPTOGO+2
  1231'   CD 0F0D'              	CALL	SUB24
  1234'   C3 11BA'              	JMP	OPG_SV
  1237'                         OPG_NO:
  1237'   0E 07                 	MVI	C,BEL
  1239'   CD 0000*              	CALL	BCONOU
  123C'                         OPG_HM:				; the cursor back where the command found it
  123C'   21 29C8'              	LXI	H,OPSFP
  123F'   CD 0402'              	CALL	MKLOAD
  1242'   CD 03CF'              	CALL	MKPAGE
  1245'   CD 0000*              	CALL	GOTO
  1248'   AF                    	XRA	A
  1249'   32 29C0'              	STA	PSAVE
  124C'   3C                    	INR	A
  124D'   32 2A23'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  1250'                         OPMID:
  1250'   CD 0F3A'              	CALL	ZSAVE
  1253'   C3 101D'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  1256'                         ONWHIT:
  1256'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1259'   CA 1275'              	JZ	OW_YES
  125C'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  125F'   FE 20                 	CPI	' '
  1261'   CA 1275'              	JZ	OW_YES
  1264'   FE 09                 	CPI	TAB
  1266'   CA 1275'              	JZ	OW_YES
  1269'   FE 0D                 	CPI	CR
  126B'   CA 1275'              	JZ	OW_YES
  126E'   FE 0A                 	CPI	LF
  1270'   CA 1275'              	JZ	OW_YES
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1273'   B7                    	ORA	A		; a char to change: CY clear
  1274'   C9                    	RET
  1275'                         OW_YES:
  1275'   37                    	STC
  1276'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  1277'                         OPLINE:
  1277'   3A 29C0'              	LDA	PSAVE
  127A'   FE 63                 	CPI	'c'
  127C'   CA 075A'              	JZ	SETMOV
  127F'   FE 79                 	CPI	'y'
  1281'   CA 1723'              	JZ	VY_YY
  1284'   21 29C8'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1287'   CD 044F'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  128A'   C3 169C'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  128D'                         OPCLS:
  128D'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  128F'   CA 129C'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  1292'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  1294'   C2 12B0'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1297'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1299'   C3 129E'              	JMP	OPC_FK
  129C'                         OPC_SEM:
  129C'   06 00                 	MVI	B,0		; ';' runs it as it stands
  129E'                         OPC_FK:
  129E'   3A 2A19'              	LDA	FNDKND
  12A1'   B7                    	ORA	A
  12A2'   37                    	STC
  12A3'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  12A4'   A8                    	XRA	B		; ... and now the direction ',' asked for
  12A5'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  12A7'   CA 12AE'              	JZ	OPC_EXC
  12AA'   3E 01                 	MVI	A,1
  12AC'   B7                    	ORA	A		; CY clear: a motion, class 1
  12AD'   C9                    	RET
  12AE'                         OPC_EXC:
  12AE'   AF                    	XRA	A		; class 0, CY clear
  12AF'   C9                    	RET
  12B0'                         OPC_TB:
  12B0'   47                    	MOV	B,A
  12B1'   21 13F4'              	LXI	H,OPCTAB
  12B4'                         OPC_LP:
  12B4'   7E                    	MOV	A,M
  12B5'   B7                    	ORA	A
  12B6'   CA 12C6'              	JZ	OPC_MS		; end of table -> not a motion
  12B9'   B8                    	CMP	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  12BA'   CA 12C2'              	JZ	OPC_HT
  12BD'   23                    	INX	H
  12BE'   23                    	INX	H
  12BF'   C3 12B4'              	JMP	OPC_LP
  12C2'                         OPC_HT:
  12C2'   23                    	INX	H
  12C3'   7E                    	MOV	A,M		; class byte
  12C4'   B7                    	ORA	A		; clear CY
  12C5'   C9                    	RET
  12C6'                         OPC_MS:
  12C6'   37                    	STC
  12C7'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  12C8'                         OPAPPL:
  12C8'   3A 29C2'              	LDA	OPCLSV
  12CB'   FE 02                 	CPI	2
  12CD'   CA 13D8'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  12D0'   2A 29C4'              	LHLD	OPSTA
  12D3'   EB                    	XCHG			; DE = start
  12D4'   2A 29C6'              	LHLD	OPEND2		; HL = end
  12D7'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  12DA'   DA 12EA'              	JC	OPA_F
  12DD'   CA 12EA'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  12E0'   22 29D4'              	SHLD	OPLO
  12E3'   EB                    	XCHG
  12E4'   22 29D6'              	SHLD	OPHI
  12E7'   C3 134C'              	JMP	OPA_DO
  12EA'                         OPA_F:
  12EA'   EB                    	XCHG			; HL = start, DE = end
  12EB'   22 29D4'              	SHLD	OPLO
  12EE'   EB                    	XCHG			; HL = end
  12EF'   3A 29C2'              	LDA	OPCLSV
  12F2'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  12F4'   CA 1349'              	JZ	OPA_HI		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  12F7'   FE 01                 	CPI	1
  12F9'   C2 1325'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end).
                                	;    'cw' stops at the content end of the line it STARTED on, where a
                                	;    plain 'ce' (and 'de') runs on into the next line's word and 'd%'
                                	;    crosses to its mate -- all four recorded from vim 9.1.  vim's 'cw'
                                	;    is not simply 'ce': the rewrite keeps 'w's own end-of-line stop, so
                                	;    that clamp hangs off CWEOL (the rewrite) and not off the class. ---
  12FC'   23                    	INX	H		; inclusive endpoint -> hi = end+1
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  12FD'   22 29D6'              	SHLD	OPHI		; park it: CEND clobbers DE
  1300'   2B                    	DCX	H		; the line it landed on ...
  1301'   3A 29C3'              	LDA	CWEOL
  1304'   B7                    	ORA	A
  1305'   CA 130B'              	JZ	OPA_LE
  1308'   2A 29D4'              	LHLD	OPLO		; ... or, for 'cw', the one it started on
  130B'                         OPA_LE:
  130B'   CD 147E'              	CALL	CEND		; HL = that line's content end
  130E'   EB                    	XCHG			; DE = it
  130F'   2A 29D6'              	LHLD	OPHI		; HL = hi
  1312'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  1315'   D2 1349'              	JNC	OPA_HI		; hi is inside the line: keep it
  1318'   2A 29D4'              	LHLD	OPLO
  131B'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  131E'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  1321'   EB                    	XCHG			; HL = the content end: the span stops there
  1322'   C3 1349'              	JMP	OPA_HI
  1325'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  1325'   22 29D6'              	SHLD	OPHI		; the motion's own end, for now
  1328'   2A 29D4'              	LHLD	OPLO
  132B'   CD 147E'              	CALL	CEND		; HL = the start line's content end
  132E'   EB                    	XCHG			; DE = that content end
  132F'   3A 29A1'              	LDA	WPULL		; the motion landed on a line's end and was
  1332'   B7                    	ORA	A		;   pulled back onto its last char (the command
  1333'   C2 133F'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  1336'   2A 29D6'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  1339'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  133C'   D2 134C'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  133F'                         OPA_CE:				;   deletes the word, not all but its last char
  133F'   2A 29D4'              	LHLD	OPLO
  1342'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1345'   CA 138A'              	JZ	OPA_LN
  1348'   EB                    	XCHG			; HL = the content end
  1349'                         OPA_HI:
  1349'   22 29D6'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  134C'                         OPA_DO:
  134C'   CD 1370'              	CALL	OPDSPN
  134F'   3A 29C0'              	LDA	PSAVE
  1352'   FE 63                 	CPI	'c'
  1354'   C8                    	RZ
  1355'   C3 148F'              	JMP	CLAMPE
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  1358'                         SPNBRK:
  1358'   2A 29D4'              	LHLD	OPLO
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  135B'   CD 05F7'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  135E'   EB                    	XCHG			; DE = it
  135F'   2A 29D6'              	LHLD	OPHI
  1362'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  1365'                         OPSPNL:
  1365'   2A 29D6'              	LHLD	OPHI
  1368'   EB                    	XCHG
  1369'   2A 29D4'              	LHLD	OPLO
  136C'   EB                    	XCHG			; HL = hi, DE = lo
  136D'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  1370'                         OPDSPN:
  1370'   CD 1358'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  1373'   F5                    	PUSH	PSW
  1374'   2A 29D4'              	LHLD	OPLO
  1377'   CD 0000*              	CALL	GOTO
  137A'   CD 1365'              	CALL	OPSPNL		; HL = hi - lo
  137D'   CD 0000*              	CALL	DELFWD
  1380'   CD 018C'              	CALL	MARKMOD
  1383'   F1                    	POP	PSW
  1384'   DA 077B'              	JC	SETFUL		; a break went: every row below it moved up
  1387'   C3 0760'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  138A'                         OPA_LN:
  138A'   3A 29C0'              	LDA	PSAVE
  138D'   FE 63                 	CPI	'c'
  138F'   C2 1398'              	JNZ	OPA_LD
  1392'   2A 29D4'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  1395'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  1398'                         OPA_LD:
  1398'   2A 29D4'              	LHLD	OPLO
  139B'   22 29C4'              	SHLD	OPSTA
  139E'   22 29C6'              	SHLD	OPEND2
  13A1'   C3 13D8'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  13A4'                         OPALSP:
  13A4'   2A 29C4'              	LHLD	OPSTA
  13A7'   EB                    	XCHG
  13A8'   2A 29C6'              	LHLD	OPEND2
  13AB'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  13AE'   DA 13BB'              	JC	OPAL_F
  13B1'   22 29D4'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  13B4'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  13B5'   22 29D6'              	SHLD	OPHI		; hi-src = start
  13B8'   C3 13C5'              	JMP	OPAL_R
  13BB'                         OPAL_F:
  13BB'   EB                    	XCHG			; HL = start
  13BC'   22 29D4'              	SHLD	OPLO		; lo-src = start
  13BF'   2A 29C6'              	LHLD	OPEND2
  13C2'   22 29D6'              	SHLD	OPHI		; hi-src = end
  13C5'                         OPAL_R:
  13C5'   2A 29D4'              	LHLD	OPLO
  13C8'   CD 05E4'              	CALL	BOL
  13CB'   22 29D4'              	SHLD	OPLO		; lo = BOL(low line)
  13CE'   2A 29D6'              	LHLD	OPHI
  13D1'   CD 0614'              	CALL	NLSTART
  13D4'   22 29D6'              	SHLD	OPHI		; hi = start of line past the high line
  13D7'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  13D8'                         OPALIN:
  13D8'   CD 13A4'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  13DB'                         OPDLIN:
  13DB'   CD 1370'              	CALL	OPDSPN
  13DE'   CD 0667'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  13E1'   DA 13F1'              	JC	OPDL_NB
  13E4'   CD 0000*              	CALL	LOGLEN
  13E7'   7C                    	MOV	A,H
  13E8'   B5                    	ORA	L
  13E9'   C8                    	RZ			; empty buffer
  13EA'   2B                    	DCX	H
  13EB'   CD 05E4'              	CALL	BOL
  13EE'   CD 0000*              	CALL	GOTO
  13F1'                         OPDL_NB:
  13F1'   C3 0828'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  13F4'                         OPCTAB:
  13F4'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  13F8'   62 00 42 00           
  13FC'   68 00 6C 00           
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  1400'   30 00 5E 00           
  1404'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1406'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  140A'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  140E'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1412'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1416'   24 01                 
  1418'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  141C'   47 02 48 02           
  1420'   4D 02 4C 02           
  1424'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  1426'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1428'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1429'                         VCB_C:
  1429'   CD 1435'              	CALL	VCB_CD
  142C'   C3 1500'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  142F'                         VCB_D:
  142F'   CD 1435'              	CALL	VCB_CD
  1432'   C3 148F'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  1435'                         VCB_CD:
  1435'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1438'   22 29D4'              	SHLD	OPLO
  143B'   CD 0000*              	CALL	CUROFF
  143E'   CD 147E'              	CALL	CEND		; to the line's content end, the CR,LF left
  1441'   22 29D6'              	SHLD	OPHI
  1444'   C3 1370'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  1447'                         VC_X:
  1447'   CD 08CD'              	CALL	GLSTAL
  144A'   CD 0760'              	CALL	SETLIN
  144D'   CD 068B'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  1450'   22 29D8'              	SHLD	CNTV
  1453'   CD 0000*              	CALL	CUROFF
  1456'   22 29DC'              	SHLD	WKI		; cur
  1459'   CD 147E'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  145C'   EB                    	XCHG			; DE = contentend
  145D'   2A 29DC'              	LHLD	WKI		; HL = cur
  1460'   EB                    	XCHG			; HL = contentend, DE = cur
  1461'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  1464'   7C                    	MOV	A,H
  1465'   B5                    	ORA	L
  1466'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  1467'   EB                    	XCHG			; DE = available
  1468'   2A 29D8'              	LHLD	CNTV		; HL = count
  146B'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  146E'   DA 1474'              	JC	VX_USEA
  1471'   C3 1475'              	JMP	VX_DEL		; count <= available -> HL = count = del
  1474'                         VX_USEA:
  1474'   EB                    	XCHG			; HL = available
  1475'                         VX_DEL:
  1475'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  1478'   CD 018C'              	CALL	MARKMOD
  147B'   C3 148F'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  147E'                         CEND:
  147E'   CD 05F7'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1481'   7C                    	MOV	A,H
  1482'   B5                    	ORA	L
  1483'   C8                    	RZ			; the start of the text: nothing before it
  1484'   2B                    	DCX	H
  1485'   E5                    	PUSH	H
  1486'   CD 0000*              	CALL	CHARAT
  1489'   E1                    	POP	H		; HL = term-1
  148A'   FE 0D                 	CPI	CR
  148C'   C8                    	RZ			; a CR before the LF -> the content ends there
  148D'   23                    	INX	H
  148E'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  148F'                         CLAMPE:
  148F'   CD 0000*              	CALL	CUROFF
  1492'   E5                    	PUSH	H
  1493'   CD 0623'              	CALL	EOLC
  1496'   D1                    	POP	D		; DE = cur
  1497'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  149A'   D8                    	RC
  149B'   C8                    	RZ
  149C'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


                                
                                ;VC_I -- insert before the cursor.
  149F'                         VC_I:
  149F'   CD 068B'              	CALL	GETCNT
  14A2'   C3 14FD'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  14A5'                         VC_A:
  14A5'   CD 068B'              	CALL	GETCNT
  14A8'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  14AB'   CA 14C2'              	JZ	VA_INS
  14AE'   EB                    	XCHG			; HL = cur
  14AF'   E5                    	PUSH	H
  14B0'   CD 0000*              	CALL	CHARAT
  14B3'   E1                    	POP	H
  14B4'   FE 0A                 	CPI	LF
  14B6'   CA 14C2'              	JZ	VA_INS		; on the line terminator -> append in place
  14B9'   FE 0D                 	CPI	CR
  14BB'   CA 14C2'              	JZ	VA_INS
  14BE'   23                    	INX	H
  14BF'   CD 0000*              	CALL	GOTO
  14C2'                         VA_INS:
  14C2'   C3 14FD'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  14C5'                         VCB_A:
  14C5'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  14C8'   CD 0623'              	CALL	EOLC		; HL = last content char (the start when empty)
  14CB'   E5                    	PUSH	H
  14CC'   CD 0000*              	CALL	CHARAT
  14CF'   E1                    	POP	H
  14D0'   FE 0D                 	CPI	CR
  14D2'   CA 14DB'              	JZ	VBA_IN		; an empty line: insert at its start
  14D5'   FE 0A                 	CPI	LF
  14D7'   CA 14DB'              	JZ	VBA_IN
  14DA'   23                    	INX	H		; past the last content char
  14DB'                         VBA_IN:
  14DB'   CD 0000*              	CALL	GOTO
  14DE'   C3 14FD'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  14E1'                         VCB_I:
  14E1'   CD 068B'              	CALL	GETCNT
  14E4'   CD 0828'              	CALL	FNBLNK
  14E7'   CD 0000*              	CALL	CUROFF
  14EA'   E5                    	PUSH	H
  14EB'   CD 0000*              	CALL	CHARAT
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  14EE'   E1                    	POP	H
  14EF'   FE 20                 	CPI	' '
  14F1'   CA 14F9'              	JZ	VBI_SK
  14F4'   FE 09                 	CPI	TAB
  14F6'   C2 14FD'              	JNZ	SETINM
  14F9'                         VBI_SK:
  14F9'   23                    	INX	H		; blanks only: past the last of them
  14FA'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  14FD'                         SETINM:
  14FD'   CD 075A'              	CALL	SETMOV
  1500'                         SETINS:
  1500'   3E 01                 	MVI	A,EM_INS
  1502'   32 2995'              	STA	EDMODE
  1505'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1506'                         ATCEND:
  1506'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1509'   C8                    	RZ
  150A'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  150D'   FE 0D                 	CPI	CR
  150F'   C8                    	RZ
  1510'   FE 0A                 	CPI	LF
  1512'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1513'                         OPNBRK:
  1513'   CD 1E05'              	CALL	PUTBRK
  1516'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1519'   23                    	INX	H
  151A'   22 0000*              	SHLD	LNDLT
  151D'   C3 018C'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1520'                         ENDBRK:
  1520'   CD 0667'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1523'   C0                    	RNZ
  1524'   CD 1513'              	CALL	OPNBRK
  1527'   CD 0000*              	CALL	CUROFF
  152A'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  152B'   2B                    	DCX	H		;   line, with its own terminator after it
  152C'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  152F'                         VC_O:
  152F'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1532'   CD 147E'              	CALL	CEND
  1535'   CD 0000*              	CALL	GOTO
  1538'   CD 1513'              	CALL	OPNBRK
  153B'   CD 1520'              	CALL	ENDBRK		; a last line with no line end: the opened line
  153E'   CD 0766'              	CALL	SETILN		;   needs a terminator of its own to exist
  1541'   C3 1500'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1544'                         VCB_O:
  1544'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1547'   CD 05E4'              	CALL	BOL
  154A'   CD 0000*              	CALL	GOTO
  154D'   CD 1513'              	CALL	OPNBRK
  1550'   CD 0000*              	CALL	CUROFF
  1553'   2B                    	DCX	H
  1554'   2B                    	DCX	H
  1555'   CD 0000*              	CALL	GOTO
  1558'   CD 0766'              	CALL	SETILN
  155B'   C3 1500'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  155E'                         VCB_J:
  155E'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1561'   CD 147E'              	CALL	CEND		; the join point: this line's content end
  1564'   22 29D4'              	SHLD	OPLO
  1567'   CD 0000*              	CALL	CUROFF
  156A'   CD 0614'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  156D'   E5                    	PUSH	H
  156E'   CD 0000*              	CALL	LOGLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  1571'   D1                    	POP	D		; DE = that start
  1572'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1575'   CA 075A'              	JZ	SETMOV
  1578'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1579'                         VJ_WS:
  1579'   E5                    	PUSH	H
  157A'   CD 0000*              	CALL	LOGLEN
  157D'   D1                    	POP	D		; DE = the scan
  157E'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1581'   CA 1598'              	JZ	VJ_DEL
  1584'   EB                    	XCHG			; HL = the scan
  1585'   E5                    	PUSH	H
  1586'   CD 0000*              	CALL	CHARAT
  1589'   E1                    	POP	H
  158A'   FE 20                 	CPI	' '
  158C'   CA 1594'              	JZ	VJ_SKIP
  158F'   FE 09                 	CPI	TAB
  1591'   C2 1598'              	JNZ	VJ_DEL
  1594'                         VJ_SKIP:
  1594'   23                    	INX	H
  1595'   C3 1579'              	JMP	VJ_WS
  1598'                         VJ_DEL:
  1598'   22 29D6'              	SHLD	OPHI
  159B'   CD 1370'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  159E'   CD 0775'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  15A1'   CD 0667'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  15A4'   CA 148F'              	JZ	CLAMPE
  15A7'   CD 0672'              	CALL	CURCHR		; the first char of what was appended
  15AA'   FE 0D                 	CPI	CR
  15AC'   CA 148F'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  15AF'   FE 0A                 	CPI	LF
  15B1'   CA 148F'              	JZ	CLAMPE
  15B4'   FE 29                 	CPI	')'
  15B6'   CA 148F'              	JZ	CLAMPE		; vim puts no space before a ')'
  15B9'   CD 0000*              	CALL	CUROFF
  15BC'   7C                    	MOV	A,H
  15BD'   B5                    	ORA	L
  15BE'   CA 15D4'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  15C1'   2B                    	DCX	H
  15C2'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  15C5'   FE 20                 	CPI	' '
  15C7'   CA 148F'              	JZ	CLAMPE
  15CA'   FE 09                 	CPI	TAB
  15CC'   CA 148F'              	JZ	CLAMPE
  15CF'   FE 0A                 	CPI	LF
  15D1'   CA 148F'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  15D4'                         VJ_SP:
  15D4'   3E 20                 	MVI	A,' '
  15D6'   CD 0000*              	CALL	PUTGAP
  15D9'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  15DC'   2B                    	DCX	H
  15DD'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  15E0'                         VC_TILD:
  15E0'   CD 068B'              	CALL	GETCNT
  15E3'   CD 0760'              	CALL	SETLIN		; only this row changes
  15E6'   CD 08CD'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  15E9'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  15EC'   CA 075A'              	JZ	SETMOV
  15EF'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  15F2'   FE 0D                 	CPI	CR
  15F4'   CA 075A'              	JZ	SETMOV		; the line's end: nothing to toggle
  15F7'   FE 0A                 	CPI	LF
  15F9'   CA 075A'              	JZ	SETMOV
  15FC'   47                    	MOV	B,A
  15FD'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  15FF'   FE 41                 	CPI	'A'
  1601'   DA 160D'              	JC	VT_PUT		; below 'A': no case
  1604'   FE 5B                 	CPI	'Z'+1
  1606'   D2 160D'              	JNC	VT_PUT		; above 'Z': no case
  1609'   78                    	MOV	A,B
  160A'   EE 20                 	XRI	20H		; a letter: flip the case bit
  160C'   47                    	MOV	B,A
  160D'                         VT_PUT:
  160D'   78                    	MOV	A,B
  160E'   32 29E5'              	STA	VRCH		; the calls below do not preserve B
  1611'   CD 018C'              	CALL	MARKMOD
  1614'   21 0001               	LXI	H,1
  1617'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  161A'   3A 29E5'              	LDA	VRCH
  161D'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1620'   C3 148F'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  1623'                         VC_R:
  1623'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  1626'   3E 03                 	MVI	A,PR
  1628'   32 29BD'              	STA	GPEND
  162B'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  162C'                         VR_DO:
  162C'   AF                    	XRA	A
  162D'   32 29BD'              	STA	GPEND
  1630'   79                    	MOV	A,C
  1631'   32 29E5'              	STA	VRCH		; the calls below do not preserve C
  1634'   CD 0760'              	CALL	SETLIN		; only this row changed
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  1637'   CD 08CD'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  163A'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  163D'   CA 075A'              	JZ	SETMOV		; the end of the text: vim does nothing
  1640'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  1643'   FE 0D                 	CPI	CR
  1645'   CA 075A'              	JZ	SETMOV		; the line's end: nothing to replace
  1648'   FE 0A                 	CPI	LF
  164A'   CA 075A'              	JZ	SETMOV
  164D'   CD 018C'              	CALL	MARKMOD
  1650'   21 0001               	LXI	H,1
  1653'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1656'   3A 29E5'              	LDA	VRCH
  1659'   FE 0D                 	CPI	CR
  165B'   CA 1668'              	JZ	VR_CR
  165E'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1661'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1664'   2B                    	DCX	H		;   out, which moves every logical offset
  1665'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1668'                         VR_CR:
  1668'   CD 1513'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  166B'   CD 1520'              	CALL	ENDBRK		;   replaced char may have been the text's last
  166E'   CD 0766'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1671'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1673'   32 299D'              	STA	ILABOV
  1676'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1677'                         VCB_R:
  1677'   CD 068B'              	CALL	GETCNT
  167A'   CD 075A'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  167D'   21 0000               	LXI	H,0
  1680'   22 29E6'              	SHLD	RPDEL		; nothing of ours to put back yet
  1683'   22 29E8'              	SHLD	RPAPP
  1686'   3E 02                 	MVI	A,EM_REP
  1688'   32 2995'              	STA	EDMODE
  168B'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  168C'                         VC_D:
  168C'   3E 64                 	MVI	A,'d'
  168E'   32 29BF'              	STA	PENDOP
  1691'   C3 075A'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1694'                         VC_C:
  1694'   3E 63                 	MVI	A,'c'
  1696'   32 29BF'              	STA	PENDOP
  1699'   C3 075A'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  169C'                         VD_DD:
  169C'   CD 08CD'              	CALL	GLSTAL
  169F'   CD 068B'              	CALL	GETCNT
  16A2'   22 29D8'              	SHLD	CNTV
  16A5'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  16A7'   32 29C1'              	STA	DDSNG
  16AA'   2B                    	DCX	H
  16AB'   7C                    	MOV	A,H
  16AC'   B5                    	ORA	L
  16AD'   C2 16B8'              	JNZ	VDD_LS
  16B0'   3E 01                 	MVI	A,1
  16B2'   32 29C1'              	STA	DDSNG
  16B5'   C3 16BE'              	JMP	VDD_GO
  16B8'                         VDD_LS:
  16B8'   CD 0893'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  16BB'   DA 075A'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  16BE'                         VDD_GO:
  16BE'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  16C1'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  16C4'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  16C7'   CD 2068'              	CALL	COPY12		;   every mark in the lines has closed up by then
  16CA'   CD 0811'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  16CD'   2A 29D8'              	LHLD	CNTV
  16D0'   CD 0000*              	CALL	SETC0
  16D3'                         VDD_FW:
  16D3'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  16D6'   DA 1824'              	JC	QREFUS		; ... which has no room for them
  16D9'   CD 06A0'              	CALL	CNTTST
  16DC'   C2 16D3'              	JNZ	VDD_FW
  16DF'   CD 018C'              	CALL	MARKMOD
  16E2'   CD 0A04'              	CALL	ATEOF
  16E5'   D2 1700'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  16E8'   3E 00                 	MVI	A,0
  16EA'   32 29C1'              	STA	DDSNG		; deleted to the end: full repaint
  16ED'   CD 0E4A'              	CALL	ONFST
  16F0'   CA 0828'              	JZ	FNBLNK		; nothing left before it
  16F3'   21 0001               	LXI	H,1		; onto the new last line
  16F6'   CD 0000*              	CALL	SETBWD
  16F9'   2A 0000*              	LHLD	LNDLT
  16FC'   2B                    	DCX	H
  16FD'   22 0000*              	SHLD	LNDLT
  1700'                         VDD_UP:
  1700'   CD 0828'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1703'   3A 29C1'              	LDA	DDSNG
  1706'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  1707'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1708'   3E 03                 	MVI	A,R_DLIN
  170A'   32 299A'              	STA	RINTENT
  170D'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  170E'                         QEMPTY:
  170E'   2A 0000*              	LHLD	QBEG
  1711'   EB                    	XCHG
  1712'   2A 0000*              	LHLD	QEND
  1715'   7C                    	MOV	A,H
  1716'   BA                    	CMP	D
  1717'   C0                    	RNZ
  1718'   7D                    	MOV	A,L
  1719'   BB                    	CMP	E
  171A'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  171B'                         VC_Y:
  171B'   3E 79                 	MVI	A,'y'
  171D'   32 29BF'              	STA	PENDOP
  1720'   C3 075A'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1723'                         VY_YY:
  1723'   21 29C8'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1726'   CD 044F'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1729'   CD 0000*              	CALL	CUROFF
  172C'   22 2A09'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  172F'   CD 05E4'              	CALL	BOL
  1732'   22 2A0B'              	SHLD	YPT		; where the lines come from, to put them back
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  1735'   CD 188A'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1738'   CD 18CD'              	CALL	YNCOPY		; copied where they lie, if that can be done
  173B'   D2 1891'              	JNC	YNDONE
  173E'   21 169C'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1741'   C3 176D'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1744'                         OPYANK:
  1744'   CD 13A4'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1747'   2A 29C4'              	LHLD	OPSTA
  174A'   EB                    	XCHG			; DE = start
  174B'   2A 29C6'              	LHLD	OPEND2		; HL = end
  174E'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1751'   D2 1755'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1754'   EB                    	XCHG			; ... otherwise the start is
  1755'                         OPY_LO:
  1755'   22 2A09'              	SHLD	YOFF
  1758'   2A 29D4'              	LHLD	OPLO
  175B'   22 2A0B'              	SHLD	YPT		; where the lines come from, to put them back
  175E'   CD 188A'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1761'   CD 1945'              	CALL	YNSPAN		; copied where they lie, if there is room
  1764'   D2 1891'              	JNC	YNDONE
  1767'   21 184B'              	LXI	H,YSPAN
  176A'   C3 176D'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  176D'                         YKGO:
  176D'   22 2A32'              	SHLD	YACT
  1770'   2A 2A0B'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1773'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1774'   2A 2A09'              	LHLD	YOFF		;   survive this -- the put-back below can page
  1777'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  177A'   22 2A38'              	SHLD	YCOL		;   them -- but a distance within the lines does
  177D'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1780'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1781'   2A 2A0B'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1784'   EB                    	XCHG			;   window as it was, then names other text
  1785'   E1                    	POP	H
  1786'   CD 0000*              	CALL	SUBHD
  1789'   EB                    	XCHG			; DE = how far behind the cursor they start
  178A'   CD 0F17'              	CALL	CURFP
  178D'   06 00                 	MVI	B,0
  178F'   CD 0F0D'              	CALL	SUB24
  1792'   22 2A3A'              	SHLD	YPFP
  1795'   32 2A3C'              	STA	YPFP+2
  1798'   3A 2999'              	LDA	MODF
  179B'   32 2A06'              	STA	YMODF
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  179E'   3A 29B2'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  17A1'   32 2A07'              	STA	YDCHG		;   a yank must not become the last change
  17A4'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  17A7'   32 2A08'              	STA	YURPL		;   back are not a change to undo either
  17AA'   3E 01                 	MVI	A,1
  17AC'   32 0000*              	STA	UNDRPL
  17AF'   32 2A31'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  17B2'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  17B5'   22 2A14'              	SHLD	YLDLT
  17B8'   CD 0000*              	CALL	LOGLEN
  17BB'   22 2A36'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  17BE'   2A 2A32'              	LHLD	YACT
  17C1'   CD 1823'              	CALL	YCALL		; the lines out of the file, into the register
  17C4'   3A 2A01'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  17C7'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  17C9'   CA 1807'              	JZ	YK_RF		;   cursor: only the flags are still owed
  17CC'   CD 0000*              	CALL	LOGLEN
  17CF'   EB                    	XCHG
  17D0'   2A 2A36'              	LHLD	YWAS
  17D3'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  17D6'   CA 17E8'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  17D9'   21 2A3A'              	LXI	H,YPFP		; back to where they came from, by its place in
  17DC'   CD 0402'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  17DF'   CD 03CF'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  17E2'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  17E5'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  17E8'                         YK_FIN:				; (nothing came out: nothing went back, and the
  17E8'   2A 2A3A'              	LHLD	YPFP		;   cursor is still owed its place)
  17EB'   EB                    	XCHG
  17EC'   2A 2A38'              	LHLD	YCOL
  17EF'   19                    	DAD	D
  17F0'   22 2A2D'              	SHLD	MKPOS
  17F3'   3A 2A3C'              	LDA	YPFP+2
  17F6'   CE 00                 	ACI	0
  17F8'   32 2A2F'              	STA	MKPOS+2
  17FB'   CD 03CF'              	CALL	MKPAGE
  17FE'   CD 0000*              	CALL	GOTO
  1801'                         YK_RST:
  1801'   2A 2A14'              	LHLD	YLDLT
  1804'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1807'                         YK_RF:
  1807'   3A 2A06'              	LDA	YMODF
  180A'   32 2999'              	STA	MODF
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  180D'   3A 2A07'              	LDA	YDCHG
  1810'   32 29B2'              	STA	DOTCHG
  1813'   3A 2A08'              	LDA	YURPL
  1816'   32 0000*              	STA	UNDRPL
  1819'   AF                    	XRA	A
  181A'   32 2A31'              	STA	MKHOLD
  181D'   CD 08CD'              	CALL	GLSTAL
  1820'   C3 077B'              	JMP	SETFUL		; the cheap paint cannot carry this
  1823'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1824'                         QREFUS:
  1824'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1827'   CD 170E'              	CALL	QEMPTY
  182A'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  182D'   CD 0000*              	CALL	QKILL
  1830'   3A 2A31'              	LDA	MKHOLD
  1833'   B7                    	ORA	A
  1834'   C2 1843'              	JNZ	QRF_Y
  1837'   21 0000*              	LXI	H,MKSAV
  183A'   11 0000*              	LXI	D,MKTAB
  183D'   CD 2068'              	CALL	COPY12
  1840'   CD 0000*              	CALL	UNDCLR
  1843'                         QRF_Y:
  1843'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1845'   32 2A01'              	STA	MSGWHT
  1848'   C3 123C'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  184B'                         YSPAN:
  184B'   CD 08CD'              	CALL	GLSTAL
  184E'   CD 1365'              	CALL	OPSPNL		; HL = the span's length
  1851'   22 2A34'              	SHLD	YTGT
  1854'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  1857'   EB                    	XCHG			; DE = it
  1858'   2A 2A34'              	LHLD	YTGT
  185B'   EB                    	XCHG			; HL = the text's, DE = the span's
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  185C'   CD 0000*              	CALL	SUBHD
  185F'   22 2A34'              	SHLD	YTGT		; what the text is left at when the span is out
  1862'   2A 29D4'              	LHLD	OPLO
  1865'   CD 0000*              	CALL	GOTO
  1868'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  186B'                         YS_LP:
  186B'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  186E'   CD 0000*              	CALL	SETC0
  1871'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1874'   DA 1824'              	JC	QREFUS		; ... which has no room for it
  1877'   CD 0000*              	CALL	LOGLEN
  187A'   EB                    	XCHG			; DE = what is left
  187B'   2A 2A34'              	LHLD	YTGT
  187E'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1881'   DA 1887'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1884'   C2 186B'              	JNZ	YS_LP		;   but never spin here if it ever did
  1887'                         YS_END:
  1887'   C3 018C'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  188A'                         YNPRE:
  188A'   2A 0000*              	LHLD	PGTOPM
  188D'   22 2A3D'              	SHLD	YNPG
  1890'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


                                ; cut), and PGTOPM is what says whether it did.
  1891'                         YNDONE:
  1891'   2A 2A09'              	LHLD	YOFF
  1894'   CD 0000*              	CALL	GOTO
  1897'   2A 0000*              	LHLD	PGTOPM
  189A'   EB                    	XCHG
  189B'   2A 2A3D'              	LHLD	YNPG
  189E'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  18A1'   C2 077B'              	JNZ	SETFUL		; it moved under us: repaint after all
  18A4'   C3 075A'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  18A7'                         YNROOM:
  18A7'   11 0100               	LXI	D,100H
  18AA'   19                    	DAD	D
  18AB'   D8                    	RC			; within a chunk of 64K: no arena holds that
  18AC'   E5                    	PUSH	H		; the span plus its slack
  18AD'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  18B0'   EB                    	XCHG			; HL = free
  18B1'   D1                    	POP	D		; DE = the span plus its slack
  18B2'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  18B5'   DA 18BD'              	JC	YNR_OK
  18B8'   CA 18BD'              	JZ	YNR_OK
  18BB'   37                    	STC			; not enough: the delete-and-put-back path
  18BC'   C9                    	RET
  18BD'                         YNR_OK:
  18BD'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  18BE'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  18BF'                         YNGO:
  18BF'   C5                    	PUSH	B
  18C0'   CD 068B'              	CALL	GETCNT		; spent here: this yank is happening
  18C3'   CD 08CD'              	CALL	GLSTAL
  18C6'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  18C9'   C1                    	POP	B
  18CA'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  18CD'                         YNCOPY:
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  18CD'   2A 2996'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  18D0'   7C                    	MOV	A,H		;   the count itself
  18D1'   B5                    	ORA	L
  18D2'   C2 18D8'              	JNZ	YNC_HV
  18D5'   21 0001               	LXI	H,1
  18D8'                         YNC_HV:
  18D8'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  18D9'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  18DA'   B4                    	ORA	H
  18DB'   CA 18E6'              	JZ	YNC_M
  18DE'   E5                    	PUSH	H
  18DF'   CD 0893'              	CALL	ONLAST		; vim: a count over one on the last line does
  18E2'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  18E3'   DA 18F8'              	JC	YNC_RF
  18E6'                         YNC_M:
  18E6'   E5                    	PUSH	H
  18E7'   CD 0811'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  18EA'   E1                    	POP	H
  18EB'   CD 1900'              	CALL	YNLINE		; BC = the span, measured where it stands
  18EE'   D8                    	RC			; not measurable here: let the pager answer it
  18EF'   60                    	MOV	H,B
  18F0'   69                    	MOV	L,C
  18F1'   CD 18A7'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  18F4'   D8                    	RC			; no: the delete-and-put-back path
  18F5'   C3 18BF'              	JMP	YNGO
  18F8'                         YNC_RF:
  18F8'   CD 068B'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  18FB'   CD 08CD'              	CALL	GLSTAL		;   register alone, and that is the command
  18FE'   B7                    	ORA	A		; NC: done
  18FF'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1900'                         YNLINE:
  1900'   22 2A3F'              	SHLD	YNCNT		; the lines it still wants
  1903'   2A 0000*              	LHLD	GAPEND
  1906'                         YNL_LP:
  1906'   EB                    	XCHG			; DE = the scan
  1907'   2A 0000*              	LHLD	TXTEND
  190A'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  190D'   EB                    	XCHG			; HL = the scan
  190E'   D2 192E'              	JNC	YNL_EN		; the resident text ran out
  1911'   7E                    	MOV	A,M
  1912'   23                    	INX	H
  1913'   FE 0A                 	CPI	LF
  1915'   C2 1906'              	JNZ	YNL_LP
  1918'   E5                    	PUSH	H
  1919'   2A 2A3F'              	LHLD	YNCNT
  191C'   2B                    	DCX	H
  191D'   22 2A3F'              	SHLD	YNCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  1920'   7C                    	MOV	A,H
  1921'   B5                    	ORA	L
  1922'   E1                    	POP	H
  1923'   C2 1906'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1926'   EB                    	XCHG			; DE = past the last of them
  1927'   2A 0000*              	LHLD	GAPEND
  192A'   EB                    	XCHG			; HL = past them, DE = GAPEND
  192B'   C3 193C'              	JMP	YNL_BC
  192E'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  192E'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1931'   C2 1943'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1934'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1937'   EB                    	XCHG			;   count clamps to it as vim's does
  1938'   2A 0000*              	LHLD	GAPEND
  193B'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  193C'                         YNL_BC:
  193C'   CD 0000*              	CALL	SUBHD		; HL = the span
  193F'   44                    	MOV	B,H
  1940'   4D                    	MOV	C,L
  1941'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1942'   C9                    	RET
  1943'                         YNL_NO:
  1943'   37                    	STC
  1944'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1945'                         YNSPAN:
  1945'   CD 1365'              	CALL	OPSPNL		; HL = the span's length
  1948'   44                    	MOV	B,H
  1949'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  194A'   CD 18A7'              	CALL	YNROOM
  194D'   D8                    	RC			; no room: the delete-and-put-back path
  194E'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  194F'   2A 29D4'              	LHLD	OPLO
  1952'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1955'   C1                    	POP	B
  1956'   C3 18BF'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1959'                         VC_P:
  1959'   CD 170E'              	CALL	QEMPTY
  195C'   CA 1A14'              	JZ	VP_BEL
  195F'   CD 068B'              	CALL	GETCNT
  1962'   22 2A0D'              	SHLD	PCNT
  1965'   CD 0000*              	CALL	CUROFF
  1968'   CD 0614'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  196B'   C3 1980'              	JMP	VP_GO
  196E'                         VCB_P:
  196E'   CD 170E'              	CALL	QEMPTY
  1971'   CA 1A14'              	JZ	VP_BEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  1974'   CD 068B'              	CALL	GETCNT
  1977'   22 2A0D'              	SHLD	PCNT
  197A'   CD 0000*              	CALL	CUROFF
  197D'   CD 05E4'              	CALL	BOL
  1980'                         VP_GO:
  1980'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1983'   CD 0000*              	CALL	CUROFF
  1986'   EB                    	XCHG
  1987'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  198A'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  198D'   DA 19A2'              	JC	VP_IN
  1990'   EB                    	XCHG			; HL = the put point = LOGLEN
  1991'   7C                    	MOV	A,H
  1992'   B5                    	ORA	L
  1993'   CA 199F'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1996'   2B                    	DCX	H
  1997'   CD 0000*              	CALL	CHARAT
  199A'   FE 0A                 	CPI	LF
  199C'   CA 19A2'              	JZ	VP_IN
  199F'                         VP_BRK:
  199F'   CD 1513'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  19A2'                         VP_IN:
  19A2'   CD 0000*              	CALL	CUROFF
  19A5'   22 2A0F'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  19A8'   2A 0000*              	LHLD	QBEG
  19AB'   EB                    	XCHG
  19AC'   2A 0000*              	LHLD	QEND
  19AF'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  19B2'   EB                    	XCHG
  19B3'   22 2A11'              	SHLD	PLFS
  19B6'   2A 2A0D'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  19B9'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  19BA'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  19BB'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  19BD'   C2 19C1'              	JNZ	VP_PZ
  19C0'   7D                    	MOV	A,L
  19C1'                         VP_PZ:
  19C1'   32 2A13'              	STA	PCPY
  19C4'                         VP_LP:
  19C4'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  19C7'   2A 0000*              	LHLD	LNDLT
  19CA'   EB                    	XCHG
  19CB'   2A 2A11'              	LHLD	PLFS
  19CE'   19                    	DAD	D
  19CF'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  19D2'   2A 2A0D'              	LHLD	PCNT
  19D5'   2B                    	DCX	H
  19D6'   22 2A0D'              	SHLD	PCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  19D9'   7C                    	MOV	A,H
  19DA'   B5                    	ORA	L
  19DB'   C2 19C4'              	JNZ	VP_LP
  19DE'   CD 018C'              	CALL	MARKMOD
  19E1'   2A 2A0F'              	LHLD	PPT
  19E4'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  19E7'   CD 08CD'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  19EA'   3A 2A13'              	LDA	PCPY
  19ED'   B7                    	ORA	A
  19EE'   CA 0828'              	JZ	FNBLNK
  19F1'   2A 2A11'              	LHLD	PLFS
  19F4'   7C                    	MOV	A,H
  19F5'   B7                    	ORA	A
  19F6'   C2 0828'              	JNZ	FNBLNK
  19F9'   3A 2A13'              	LDA	PCPY
  19FC'   CD 0DE0'              	CALL	MULSAT		; HL = the lines this put put, saturated
  19FF'   7C                    	MOV	A,H
  1A00'   B7                    	ORA	A
  1A01'   C2 0828'              	JNZ	FNBLNK
  1A04'   7D                    	MOV	A,L
  1A05'   B7                    	ORA	A
  1A06'   CA 0828'              	JZ	FNBLNK
  1A09'   F5                    	PUSH	PSW
  1A0A'   CD 0766'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1A0D'   F1                    	POP	PSW
  1A0E'   32 299B'              	STA	ILN		; ... which the lines put now replace
  1A11'   C3 0828'              	JMP	FNBLNK
  1A14'                         VP_BEL:
  1A14'   CD 068B'              	CALL	GETCNT		; the count is spent either way
  1A17'   0E 07                 	MVI	C,BEL
  1A19'   CD 0000*              	CALL	BCONOU
  1A1C'   C3 075A'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  1A1F'                         VIREP:
  1A1F'   78                    	MOV	A,B
  1A20'   FE 01                 	CPI	KT_ACT
  1A22'   CA 1B4F'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  1A25'   FE 02                 	CPI	KT_CHAR
  1A27'   C0                    	RNZ			; ignore anything else
  1A28'   79                    	MOV	A,C
  1A29'   FE 0D                 	CPI	CR
  1A2B'   CA 1A8F'              	JZ	VP_CR
  1A2E'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1A30'   CA 1A8F'              	JZ	VP_CR
  1A33'   FE 08                 	CPI	BS
  1A35'   CA 1A9B'              	JZ	VP_BS
  1A38'   FE 7F                 	CPI	DEL
  1A3A'   CA 1A9B'              	JZ	VP_BS
  1A3D'   32 29E5'              	STA	VRCH		; the calls below do not preserve C
  1A40'   CD 0760'              	CALL	SETLIN		; this row changed
  1A43'   CD 018C'              	CALL	MARKMOD
  1A46'   CD 1506'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1A49'   CA 1A81'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1A4C'   3A 29E5'              	LDA	VRCH
  1A4F'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1A52'   2A 29E6'              	LHLD	RPDEL
  1A55'   7C                    	MOV	A,H
  1A56'   B5                    	ORA	L
  1A57'   CA 1A6D'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1A5A'   2A 0000*              	LHLD	GAPEND
  1A5D'   EB                    	XCHG
  1A5E'   2A 29EA'              	LHLD	RPGE
  1A61'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1A64'   CA 1A6D'              	JZ	VP_OVW
  1A67'   21 0000               	LXI	H,0
  1A6A'   22 29E6'              	SHLD	RPDEL		; the text moved: those originals are gone
  1A6D'                         VP_OVW:
  1A6D'   21 0001               	LXI	H,1
  1A70'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1A73'   2A 0000*              	LHLD	GAPEND
  1A76'   22 29EA'              	SHLD	RPGE
  1A79'   2A 29E6'              	LHLD	RPDEL
  1A7C'   23                    	INX	H
  1A7D'   22 29E6'              	SHLD	RPDEL
  1A80'   C9                    	RET
  1A81'                         VP_APP:
  1A81'   3A 29E5'              	LDA	VRCH
  1A84'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1A87'   2A 29E8'              	LHLD	RPAPP
  1A8A'   23                    	INX	H
  1A8B'   22 29E8'              	SHLD	RPAPP
  1A8E'   C9                    	RET
  1A8F'                         VP_CR:
  1A8F'   21 0000               	LXI	H,0
  1A92'   22 29E6'              	SHLD	RPDEL		; a line break ends what BS can put back
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1A95'   22 29E8'              	SHLD	RPAPP
  1A98'   C3 1B25'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1A9B'                         VP_BS:
  1A9B'   2A 29E8'              	LHLD	RPAPP
  1A9E'   7C                    	MOV	A,H
  1A9F'   B5                    	ORA	L
  1AA0'   CA 1AAD'              	JZ	VP_BSD
  1AA3'   2B                    	DCX	H
  1AA4'   22 29E8'              	SHLD	RPAPP		; an appended char: it just goes
  1AA7'   CD 0760'              	CALL	SETLIN
  1AAA'   C3 0000*              	JMP	DELPRV
  1AAD'                         VP_BSD:
  1AAD'   2A 29E6'              	LHLD	RPDEL
  1AB0'   7C                    	MOV	A,H
  1AB1'   B5                    	ORA	L
  1AB2'   CA 1AD9'              	JZ	VP_BSM		; nothing of ours left
  1AB5'   2A 0000*              	LHLD	GAPEND
  1AB8'   EB                    	XCHG
  1AB9'   2A 29EA'              	LHLD	RPGE
  1ABC'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1ABF'   C2 1AD9'              	JNZ	VP_BSM
  1AC2'   2A 29E6'              	LHLD	RPDEL
  1AC5'   2B                    	DCX	H
  1AC6'   22 29E6'              	SHLD	RPDEL
  1AC9'   CD 0760'              	CALL	SETLIN
  1ACC'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1ACF'   CD 0000*              	CALL	UNDELF		; the original comes back
  1AD2'   2A 0000*              	LHLD	GAPEND
  1AD5'   22 29EA'              	SHLD	RPGE
  1AD8'   C9                    	RET
  1AD9'                         VP_BSM:
  1AD9'   CD 075A'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1ADC'   C3 07C9'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  1ADF'                         VIINS:
  1ADF'   78                    	MOV	A,B
  1AE0'   FE 01                 	CPI	KT_ACT
  1AE2'   CA 1B4F'              	JZ	VI_ACT
  1AE5'   FE 02                 	CPI	KT_CHAR
  1AE7'   C0                    	RNZ			; ignore anything else
  1AE8'   79                    	MOV	A,C
  1AE9'   FE 0D                 	CPI	CR
  1AEB'   CA 1B25'              	JZ	VI_CR
  1AEE'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1AF0'   CA 1B25'              	JZ	VI_CR
  1AF3'   FE 08                 	CPI	BS
  1AF5'   CA 1B3D'              	JZ	VI_BS
  1AF8'   FE 7F                 	CPI	DEL
  1AFA'   CA 1B3D'              	JZ	VI_BS
  1AFD'   79                    	MOV	A,C
  1AFE'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1B01'   CD 018C'              	CALL	MARKMOD
  1B04'   CD 0760'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1B07'   79                    	MOV	A,C
  1B08'   FE 20                 	CPI	' '
  1B0A'   D8                    	RC			; control char -> keep R_LINE
  1B0B'   FE 7F                 	CPI	DEL
  1B0D'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1B0E'   CD 0781'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1B11'   B7                    	ORA	A
  1B12'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1B13'   3E 04                 	MVI	A,R_ICH
  1B15'   32 299A'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1B18'   CD 1506'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1B1B'   3E 00                 	MVI	A,0
  1B1D'   C2 1B21'              	JNZ	VI_ICH
  1B20'   3C                    	INR	A
  1B21'                         VI_ICH:
  1B21'   32 299C'              	STA	ICHAPP
  1B24'   C9                    	RET
  1B25'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1B25'   CD 1506'              	CALL	ATCEND
  1B28'   3E 00                 	MVI	A,0
  1B2A'   CA 1B2E'              	JZ	VI_CRS
  1B2D'   3C                    	INR	A
  1B2E'                         VI_CRS:
  1B2E'   F5                    	PUSH	PSW
  1B2F'   CD 1513'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1B32'   CD 1520'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1B35'   CD 0766'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1B38'   F1                    	POP	PSW
  1B39'   32 299D'              	STA	ILABOV
  1B3C'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1B3D'                         VI_BS:
  1B3D'   CD 0000*              	CALL	PEEKL
  1B40'   D8                    	RC			; start of the file: nothing to delete
  1B41'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1B43'   CA 1B49'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1B46'   CD 0760'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1B49'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1B49'   CD 018C'              	CALL	MARKMOD
  1B4C'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1B4F'                         VI_ACT:
  1B4F'   79                    	MOV	A,C
  1B50'   FE 0B                 	CPI	ACT_ESC
  1B52'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  1B53'   3E 00                 	MVI	A,EM_CMD
  1B55'   32 2995'              	STA	EDMODE
  1B58'   CD 075A'              	CALL	SETMOV
  1B5B'   CD 07C9'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1B5E'   C3 08CD'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1B61'                         RDLINE:
  1B61'   EB                    	XCHG			; HL = buffer
  1B62'   22 29EC'              	SHLD	RLPTR
  1B65'   3E 00                 	MVI	A,0
  1B67'   32 29EE'              	STA	RLLEN
  1B6A'   78                    	MOV	A,B
  1B6B'   32 29EF'              	STA	RLMAX
  1B6E'   79                    	MOV	A,C
  1B6F'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1B72'                         RL_LP:
  1B72'   CD 0000*              	CALL	GETKEY
  1B75'   78                    	MOV	A,B
  1B76'   FE 01                 	CPI	KT_ACT
  1B78'   CA 1BCE'              	JZ	RL_ACT
  1B7B'   FE 02                 	CPI	KT_CHAR
  1B7D'   C2 1B72'              	JNZ	RL_LP		; ignore other keys
  1B80'   79                    	MOV	A,C
  1B81'   FE 0D                 	CPI	CR
  1B83'   CA 1BDF'              	JZ	RL_DONE
  1B86'   FE 08                 	CPI	BS
  1B88'   CA 1BB6'              	JZ	RL_BS
  1B8B'   FE 7F                 	CPI	DEL
  1B8D'   CA 1BB6'              	JZ	RL_BS
  1B90'   FE 20                 	CPI	' '
  1B92'   DA 1B72'              	JC	RL_LP		; control char -> ignore
  1B95'   3A 29EE'              	LDA	RLLEN
  1B98'   47                    	MOV	B,A
  1B99'   3A 29EF'              	LDA	RLMAX
  1B9C'   B8                    	CMP	B
  1B9D'   CA 1B72'              	JZ	RL_LP		; full -> ignore
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1BA0'   2A 29EC'              	LHLD	RLPTR
  1BA3'   71                    	MOV	M,C
  1BA4'   23                    	INX	H
  1BA5'   22 29EC'              	SHLD	RLPTR
  1BA8'   3A 29EE'              	LDA	RLLEN
  1BAB'   3C                    	INR	A
  1BAC'   32 29EE'              	STA	RLLEN
  1BAF'   79                    	MOV	A,C
  1BB0'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1BB3'   C3 1B72'              	JMP	RL_LP
  1BB6'                         RL_BS:				; WM LINEPOP
  1BB6'   3A 29EE'              	LDA	RLLEN
  1BB9'   B7                    	ORA	A
  1BBA'   CA 1BD4'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1BBD'   3D                    	DCR	A
  1BBE'   32 29EE'              	STA	RLLEN
  1BC1'   2A 29EC'              	LHLD	RLPTR
  1BC4'   2B                    	DCX	H
  1BC5'   22 29EC'              	SHLD	RLPTR
  1BC8'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1BCB'   C3 1B72'              	JMP	RL_LP
  1BCE'                         RL_ACT:
  1BCE'   79                    	MOV	A,C
  1BCF'   FE 0B                 	CPI	ACT_ESC
  1BD1'   C2 1B72'              	JNZ	RL_LP
  1BD4'                         RL_CAN:
  1BD4'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1BD6'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1BD9'   CD 0760'              	CALL	SETLIN		; redraw one row
  1BDC'   3E FF                 	MVI	A,0FFH		; cancelled
  1BDE'   C9                    	RET
  1BDF'                         RL_DONE:
  1BDF'   AF                    	XRA	A
  1BE0'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1BE1'                         VC_BZ:
  1BE1'   CD 075A'              	CALL	SETMOV
  1BE4'   3A 29BE'              	LDA	GSAVE
  1BE7'   FE 02                 	CPI	PZ
  1BE9'   CA 1BF4'              	JZ	VZ_ZZ
  1BEC'   B7                    	ORA	A
  1BED'   C0                    	RNZ			; 'g' was pending: vim drops both
  1BEE'   3E 02                 	MVI	A,PZ
  1BF0'   32 29BD'              	STA	GPEND
  1BF3'   C9                    	RET
  1BF4'                         VZ_ZZ:
  1BF4'   3E 04                 	MVI	A,EO_X
  1BF6'   32 29F0'              	STA	EXOP
  1BF9'   3E 01                 	MVI	A,1
  1BFB'   32 2A03'              	STA	EXBANG		; no '!'
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1BFE'   AF                    	XRA	A
  1BFF'   32 29F1'              	STA	EXARG		; no file name
  1C02'   3A 2999'              	LDA	MODF		; as ':x': a changed text is written first
  1C05'   B7                    	ORA	A
  1C06'   CA 1D47'              	JZ	EX_Q
  1C09'   C3 1CE1'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1C0C'                         VC_EX:
  1C0C'   CD 068B'              	CALL	GETCNT
  1C0F'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1C12'   11 0000*              	LXI	D,EXBUF
  1C15'   06 28                 	MVI	B,EXMAX
  1C17'   0E 3A                 	MVI	C,':'
  1C19'   CD 1B61'              	CALL	RDLINE
  1C1C'   B7                    	ORA	A
  1C1D'   C0                    	RNZ			; cancelled
  1C1E'   3A 29EE'              	LDA	RLLEN
  1C21'   5F                    	MOV	E,A
  1C22'   16 00                 	MVI	D,0
  1C24'   21 0000*              	LXI	H,EXBUF
  1C27'   19                    	DAD	D
  1C28'   36 00                 	MVI	M,0		; the line ends with a 0
  1C2A'   21 0000*              	LXI	H,EXBUF
  1C2D'   CD 21FD'              	CALL	SKIPB
  1C30'   C8                    	RZ			; nothing on it
  1C31'   22 29F3'              	SHLD	EXCMD
  1C34'   CD 23F1'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1C37'   CD 21FD'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1C3A'   56                    	MOV	D,M
  1C3B'   23                    	INX	H
  1C3C'   1E 00                 	MVI	E,0
  1C3E'   CD 2209'              	CALL	ISLOW
  1C41'   DA 1C4C'              	JC	EX_LK
  1C44'   5F                    	MOV	E,A
  1C45'   23                    	INX	H
  1C46'   CD 2209'              	CALL	ISLOW
  1C49'   D2 1C65'              	JNC	EX_NOT		; a third letter: none of ours
  1C4C'                         EX_LK:
  1C4C'   E5                    	PUSH	H
  1C4D'   21 23D8'              	LXI	H,EXTAB
  1C50'                         EX_TL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1C50'   7E                    	MOV	A,M
  1C51'   B7                    	ORA	A
  1C52'   CA 1C64'              	JZ	EX_NTP		; not in the table
  1C55'   23                    	INX	H
  1C56'   BA                    	CMP	D
  1C57'   7E                    	MOV	A,M
  1C58'   23                    	INX	H
  1C59'   C2 1C60'              	JNZ	EX_TN
  1C5C'   BB                    	CMP	E
  1C5D'   CA 1C6B'              	JZ	EX_TF
  1C60'                         EX_TN:
  1C60'   23                    	INX	H
  1C61'   C3 1C50'              	JMP	EX_TL
  1C64'                         EX_NTP:
  1C64'   E1                    	POP	H
  1C65'                         EX_NOT:
  1C65'   21 22C1'              	LXI	H,SNOT
  1C68'   C3 223E'              	JMP	EXERT
  1C6B'                         EX_TF:
  1C6B'   7E                    	MOV	A,M
  1C6C'   32 29F0'              	STA	EXOP
  1C6F'   E1                    	POP	H
  1C70'   FE 06                 	CPI	EO_S
  1C72'   CA 2460'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1C75'   FE 01                 	CPI	EO_W
  1C77'   CA 1C86'              	JZ	EX_RG		; ':N,Mw name' takes a range
  1C7A'   FE 08                 	CPI	EO_R
  1C7C'   CA 1C86'              	JZ	EX_RG		; ... and ':Nr name' a line
  1C7F'   3A 2A4B'              	LDA	SRNGF
  1C82'   B7                    	ORA	A
  1C83'   C2 1C65'              	JNZ	EX_NOT		; a range on a command that does not take one
  1C86'                         EX_RG:
                                	;--- '!', then the file name ---
  1C86'   7E                    	MOV	A,M
  1C87'   D6 21                 	SUI	'!'
  1C89'   32 2A03'              	STA	EXBANG		; 0 = '!'
  1C8C'   C2 1C90'              	JNZ	EX_NB
  1C8F'   23                    	INX	H
  1C90'                         EX_NB:
  1C90'   CD 21FD'              	CALL	SKIPB
  1C93'   32 29F1'              	STA	EXARG		; 0 = no file name
  1C96'   CA 1CAF'              	JZ	EX_RUN
  1C99'   22 29F3'              	SHLD	EXCMD
  1C9C'   3A 29F0'              	LDA	EXOP
  1C9F'   FE 02                 	CPI	EO_Q
  1CA1'   CA 223B'              	JZ	EX_TRL		; :q takes none
  1CA4'   FE 07                 	CPI	EO_V
  1CA6'   CA 223B'              	JZ	EX_TRL		; nor :ve
  1CA9'   CD 2167'              	CALL	PARSFN
  1CAC'   C2 222F'              	JNZ	EX_INV
  1CAF'                         EX_RUN:
  1CAF'   3A 29F0'              	LDA	EXOP
  1CB2'   FE 05                 	CPI	EO_E
  1CB4'   CA 1D5E'              	JZ	EX_E
  1CB7'   FE 02                 	CPI	EO_Q
  1CB9'   CA 1D47'              	JZ	EX_Q
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1CBC'   FE 07                 	CPI	EO_V
  1CBE'   CA 2235'              	JZ	EX_V
  1CC1'   FE 08                 	CPI	EO_R
  1CC3'   CA 1EEF'              	JZ	EX_R
  1CC6'   FE 04                 	CPI	EO_X
  1CC8'   CA 1CDA'              	JZ	EX_XM
  1CCB'   FE 01                 	CPI	EO_W
  1CCD'   C2 1CE1'              	JNZ	EX_W		; :wq
  1CD0'   3A 2A4B'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  1CD3'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  1CD4'   C2 1E0F'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  1CD7'   C3 1CE1'              	JMP	EX_W
  1CDA'                         EX_XM:
  1CDA'   3A 2999'              	LDA	MODF		; :x writes only a changed text
  1CDD'   B7                    	ORA	A
  1CDE'   CA 1D47'              	JZ	EX_Q
  1CE1'                         EX_W:
  1CE1'   CD 1FCF'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1CE4'   D8                    	RC			; refused (message shown)
  1CE5'   32 29F2'              	STA	EXBAK
  1CE8'   3A 29F0'              	LDA	EXOP
  1CEB'   FE 01                 	CPI	EO_W
  1CED'   CA 1D04'              	JZ	EX_WK
  1CF0'   3A 29F2'              	LDA	EXBAK
  1CF3'   B7                    	ORA	A
  1CF4'   C2 1D44'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1CF7'   3A 2A03'              	LDA	EXBANG
  1CFA'   B7                    	ORA	A
  1CFB'   CA 1D44'              	JZ	EX_WQ		; so it does with '!'
  1CFE'   CD 1D04'              	CALL	EX_WK		; else it may not: keep the text
  1D01'   C3 1D47'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1D04'                         EX_WK:
  1D04'   CD 0CEC'              	CALL	CURRW		; the cursor's row and file position
  1D07'   32 29F5'              	STA	WPROW
  1D0A'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1D0D'   7D                    	MOV	A,L
  1D0E'   E6 7F                 	ANI	7FH
  1D10'   32 29F6'              	STA	WPBYT
  1D13'   7D                    	MOV	A,L
  1D14'   17                    	RAL
  1D15'   7C                    	MOV	A,H
  1D16'   17                    	RAL
  1D17'   5F                    	MOV	E,A
  1D18'   3E 00                 	MVI	A,0
  1D1A'   17                    	RAL
  1D1B'   57                    	MOV	D,A		; DE = HL / 128
  1D1C'   2A 0000*              	LHLD	OUTPOS
  1D1F'   19                    	DAD	D
  1D20'   22 29F7'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1D23'   CD 2004'              	CALL	WRITE
  1D26'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1D29'   2A 29F7'              	LHLD	WPREC
  1D2C'   EB                    	XCHG
  1D2D'   3A 29F6'              	LDA	WPBYT
  1D30'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1D33'   CD 0000*              	CALL	GOTO
  1D36'                         EX_WRW:
  1D36'   21 0000               	LXI	H,0
  1D39'   22 0000*              	SHLD	LNDLT
  1D3C'   3A 29F5'              	LDA	WPROW
  1D3F'   6F                    	MOV	L,A
  1D40'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1D43'   C9                    	RET
  1D44'                         EX_WQ:
  1D44'   CD 2004'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1D47'                         EX_Q:
  1D47'   3A 2A03'              	LDA	EXBANG
  1D4A'   B7                    	ORA	A
  1D4B'   CA 1D55'              	JZ	EX_QT
  1D4E'   3A 2999'              	LDA	MODF
  1D51'   B7                    	ORA	A
  1D52'   C2 2223'              	JNZ	MSGNWR		; changed, no '!': stay
  1D55'                         EX_QT:
  1D55'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1D58'   3E 01                 	MVI	A,1
  1D5A'   32 2998'              	STA	QUITF
  1D5D'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1D5E'                         EX_E:
  1D5E'   3A 2A03'              	LDA	EXBANG
  1D61'   B7                    	ORA	A
  1D62'   CA 1D6C'              	JZ	EE_GO
  1D65'   3A 2999'              	LDA	MODF
  1D68'   B7                    	ORA	A
  1D69'   C2 2223'              	JNZ	MSGNWR
  1D6C'                         EE_GO:
  1D6C'   3A 29F1'              	LDA	EXARG
  1D6F'   B7                    	ORA	A
  1D70'   C2 1D77'              	JNZ	EE_ARG
  1D73'   CD 2040'              	CALL	OWNTF		; no name: the buffer's own
  1D76'   D8                    	RC
  1D77'                         EE_ARG:
  1D77'   CD 2056'              	CALL	ISOWN
  1D7A'   21 0001               	LXI	H,1
  1D7D'   C2 1D84'              	JNZ	EE_LD		; another file: its first line
  1D80'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1D83'   23                    	INX	H		; HL = the cursor's line
  1D84'                         EE_LD:
  1D84'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1D86'   32 2A01'              	STA	MSGWHT
  1D89'   E5                    	PUSH	H
  1D8A'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1D8D'   21 0000*              	LXI	H,TFCB
  1D90'   11 0000*              	LXI	D,FNAME
  1D93'   CD 2068'              	CALL	COPY12		; the buffer's name
  1D96'   CD 202D'              	CALL	SRCTF
  1D99'   CD 0000*              	CALL	REOPEN
  1D9C'   CD 020F'              	CALL	MKCLR		; the marks named the buffer that just went
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1D9F'   AF                    	XRA	A
  1DA0'   32 2999'              	STA	MODF
  1DA3'   E1                    	POP	H
  1DA4'   2B                    	DCX	H
  1DA5'   AF                    	XRA	A
  1DA6'   CD 0000*              	CALL	MVLIND		; down to the line
  1DA9'   CD 0A04'              	CALL	ATEOF
  1DAC'   DC 0A0A'              	CC	LASTLN		; past the last line: onto it
  1DAF'   CD 0F3A'              	CALL	ZSAVE
  1DB2'   C3 101D'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  1DB5'                         TFDOS:
  1DB5'   C5                    	PUSH	B
  1DB6'   11 0080               	LXI	D,CMDTAIL
  1DB9'   0E 1A                 	MVI	C,1AH		; set the DMA
  1DBB'   CD 0005               	CALL	BDOS
  1DBE'   C1                    	POP	B
  1DBF'   11 0000*              	LXI	D,TFCB
  1DC2'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  1DC5'                         EXRNG:
  1DC5'   2A 2A4C'              	LHLD	SRNG1
  1DC8'   7C                    	MOV	A,H
  1DC9'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1DCA'   37                    	STC
  1DCB'   C8                    	RZ
  1DCC'   2A 2A4E'              	LHLD	SRNG2
  1DCF'   EB                    	XCHG
  1DD0'   2A 2A4C'              	LHLD	SRNG1
  1DD3'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  1DD6'   D8                    	RC
  1DD7'   EB                    	XCHG			; HL = the last line, DE = the first
  1DD8'   CD 0000*              	CALL	SUBHD
  1DDB'   23                    	INX	H
  1DDC'   22 2A56'              	SHLD	SLINES
  1DDF'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  1DE0'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  1DE1'                         GOLNX:
  1DE1'   E5                    	PUSH	H
  1DE2'   CD 0ECE'              	CALL	GOLN
  1DE5'   CD 0000*              	CALL	CNTLF
  1DE8'   23                    	INX	H		; the line the cursor came to rest on
  1DE9'   D1                    	POP	D
  1DEA'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  1DED'                         EXSAVP:
  1DED'   CD 0CEC'              	CALL	CURRW
  1DF0'   32 29F5'              	STA	WPROW
  1DF3'   21 2A2D'              	LXI	H,MKPOS
  1DF6'   C3 044F'              	JMP	FPSTO
  1DF9'                         EXRSTP:
  1DF9'   CD 0000*              	CALL	CLRCNT
  1DFC'   CD 03CF'              	CALL	MKPAGE		; page until that place is in the window again
  1DFF'   CD 0000*              	CALL	GOTO
  1E02'   C3 1D36'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  1E05'                         PUTBRK:
  1E05'   3E 0D                 	MVI	A,CR
  1E07'   CD 0000*              	CALL	PUTGAP
  1E0A'   3E 0A                 	MVI	A,LF
  1E0C'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  1E0F'                         EX_WR:
  1E0F'   3A 29F1'              	LDA	EXARG
  1E12'   B7                    	ORA	A
  1E13'   CA 2211'              	JZ	MSGNFN		; No file name
  1E16'   CD 2056'              	CALL	ISOWN
  1E19'   CA 1EB9'              	JZ	EXW_OW
  1E1C'   CD 0000*              	CALL	TEXIST
  1E1F'   32 2A59'              	STA	RWERR		; nonzero: a file of that name is there
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1E22'   CA 1E2C'              	JZ	EXW_GO
  1E25'   3A 2A03'              	LDA	EXBANG
  1E28'   B7                    	ORA	A
  1E29'   C2 2217'              	JNZ	MSGEXI		; File exists (! to force)
  1E2C'                         EXW_GO:
  1E2C'   CD 1DC5'              	CALL	EXRNG
  1E2F'   DA 1EB3'              	JC	EXW_BD
  1E32'   CD 1DED'              	CALL	EXSAVP
  1E35'   2A 2A4C'              	LHLD	SRNG1
  1E38'   CD 1DE1'              	CALL	GOLNX
  1E3B'   C2 1EB0'              	JNZ	EXW_NL		; the text has no line N
  1E3E'   3A 2A59'              	LDA	RWERR		; a delete scans the whole directory, there or
  1E41'   B7                    	ORA	A		;   not: only when TEXIST found one
  1E42'   0E 13                 	MVI	C,13H
  1E44'   C4 1DB5'              	CNZ	TFDOS		; delete what is there
  1E47'   0E 16                 	MVI	C,16H
  1E49'   CD 1DB5'              	CALL	TFDOS		; ... and make it
  1E4C'   3C                    	INR	A
  1E4D'   CA 1EA2'              	JZ	EXW_FL		; no directory entry left
  1E50'   3E 80                 	MVI	A,80H
  1E52'   32 2A58'              	STA	RWPTR
  1E55'   AF                    	XRA	A
  1E56'   32 2A59'              	STA	RWERR
  1E59'   2A 2A56'              	LHLD	SLINES
  1E5C'   CD 0000*              	CALL	SETC0		; that many lines, forward
  1E5F'                         EXW_LP:
  1E5F'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  1E62'   E5                    	PUSH	H
  1E63'   EB                    	XCHG
  1E64'   2A 0000*              	LHLD	GAPEND
  1E67'   CD 1EBF'              	CALL	RWOUT		; the text from the cursor to there
  1E6A'   E1                    	POP	H
  1E6B'   3A 2A59'              	LDA	RWERR
  1E6E'   B7                    	ORA	A
  1E6F'   C2 1E8B'              	JNZ	EXW_EN
  1E72'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  1E75'   CD 06A0'              	CALL	CNTTST
  1E78'   C2 1E5F'              	JNZ	EXW_LP
  1E7B'                         EXW_PD:				; the last record is padded out with ^Z
  1E7B'   3A 2A58'              	LDA	RWPTR
  1E7E'   FE 80                 	CPI	80H
  1E80'   CA 1E8B'              	JZ	EXW_EN
  1E83'   3E 1A                 	MVI	A,CPMEOF
  1E85'   CD 1ECB'              	CALL	RWPUT
  1E88'   C3 1E7B'              	JMP	EXW_PD
  1E8B'                         EXW_EN:
  1E8B'   0E 10                 	MVI	C,10H
  1E8D'   CD 1DB5'              	CALL	TFDOS		; close
  1E90'   3A 2A59'              	LDA	RWERR
  1E93'   B7                    	ORA	A
  1E94'   C2 1EA2'              	JNZ	EXW_FL
  1E97'   CD 1DF9'              	CALL	EXRSTP
  1E9A'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  1E9C'   32 2A01'              	STA	MSGWHT
  1E9F'   C3 075A'              	JMP	SETMOV		; nothing on the screen has changed
  1EA2'                         EXW_FL:				; no room: the part written is not left behind
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1EA2'   0E 13                 	MVI	C,13H
  1EA4'   CD 1DB5'              	CALL	TFDOS
  1EA7'   CD 1DF9'              	CALL	EXRSTP
  1EAA'   21 23CE'              	LXI	H,SDFUL
  1EAD'   C3 2249'              	JMP	EXERR
  1EB0'                         EXW_NL:
  1EB0'   CD 1DF9'              	CALL	EXRSTP
  1EB3'                         EXW_BD:
  1EB3'   21 23C0'              	LXI	H,SRNGE
  1EB6'   C3 2249'              	JMP	EXERR
  1EB9'                         EXW_OW:
  1EB9'   21 2278'              	LXI	H,SEXI
  1EBC'   C3 2249'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  1EBF'                         RWOUT:
  1EBF'   CD 0000*              	CALL	CMP16
  1EC2'   C8                    	RZ
  1EC3'   7E                    	MOV	A,M
  1EC4'   23                    	INX	H
  1EC5'   CD 1ECB'              	CALL	RWPUT
  1EC8'   C3 1EBF'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  1ECB'                         RWPUT:
  1ECB'   E5                    	PUSH	H
  1ECC'   F5                    	PUSH	PSW
  1ECD'   3A 2A58'              	LDA	RWPTR
  1ED0'   6F                    	MOV	L,A
  1ED1'   26 00                 	MVI	H,0
  1ED3'   F1                    	POP	PSW
  1ED4'   77                    	MOV	M,A
  1ED5'   2C                    	INR	L		; Z: that was the record's last byte
  1ED6'   7D                    	MOV	A,L
  1ED7'   C2 1EEA'              	JNZ	RWP_ST
  1EDA'   D5                    	PUSH	D
  1EDB'   0E 15                 	MVI	C,15H
  1EDD'   CD 1DB5'              	CALL	TFDOS		; write it
  1EE0'   D1                    	POP	D
  1EE1'   B7                    	ORA	A
  1EE2'   CA 1EE8'              	JZ	RWP_OK
  1EE5'   32 2A59'              	STA	RWERR
  1EE8'                         RWP_OK:
  1EE8'   3E 80                 	MVI	A,80H
  1EEA'                         RWP_ST:
  1EEA'   32 2A58'              	STA	RWPTR
  1EED'   E1                    	POP	H
  1EEE'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  1EEF'                         EX_R:
  1EEF'   3A 29F1'              	LDA	EXARG
  1EF2'   B7                    	ORA	A
  1EF3'   CA 2211'              	JZ	MSGNFN		; No file name
  1EF6'   0E 0F                 	MVI	C,0FH
  1EF8'   CD 1DB5'              	CALL	TFDOS		; open
  1EFB'   3C                    	INR	A
  1EFC'   CA 1FC9'              	JZ	ER_NOF
  1EFF'   CD 0F60'              	CALL	GZONE		; the screen's top line, before anything moves
  1F02'   CD 1DED'              	CALL	EXSAVP
  1F05'   3A 2A4B'              	LDA	SRNGF
  1F08'   B7                    	ORA	A
  1F09'   CA 1F22'              	JZ	ER_NXT		; no line given: below the cursor's
  1F0C'   2A 2A4E'              	LHLD	SRNG2
  1F0F'   7C                    	MOV	A,H
  1F10'   B5                    	ORA	L
  1F11'   C2 1F1C'              	JNZ	ER_LN
  1F14'   23                    	INX	H
  1F15'   CD 0ECE'              	CALL	GOLN		; ':0r': above line 1 ...
  1F18'   AF                    	XRA	A		;   which never wants a line end put in first
  1F19'   C3 1F44'              	JMP	ER_BRK
  1F1C'                         ER_LN:
  1F1C'   CD 1DE1'              	CALL	GOLNX
  1F1F'   C2 1EB0'              	JNZ	EXW_NL		; the text has no line N
  1F22'                         ER_NXT:
  1F22'   21 0001               	LXI	H,1
  1F25'   AF                    	XRA	A
  1F26'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  1F29'   CD 0A04'              	CALL	ATEOF
  1F2C'   3E 00                 	MVI	A,0
  1F2E'   D2 1F44'              	JNC	ER_BRK		; text follows
  1F31'   2A 0000*              	LHLD	GAPBEG
  1F34'   EB                    	XCHG
  1F35'   2A 0000*              	LHLD	TXTBEG
  1F38'   CD 0000*              	CALL	CMP16
  1F3B'   3E 01                 	MVI	A,1
  1F3D'   CA 1F44'              	JZ	ER_BRK		; nothing before the cursor either
  1F40'   1B                    	DCX	D
  1F41'   1A                    	LDAX	D
  1F42'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  1F44'                         ER_BRK:
  1F44'   32 2A5B'              	STA	RDBRK
  1F47'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  1F4A'   AF                    	XRA	A
  1F4B'   32 2A5A'              	STA	RDANY
  1F4E'                         ER_LP:
  1F4E'   0E 14                 	MVI	C,14H
  1F50'   CD 1DB5'              	CALL	TFDOS		; the next record
  1F53'   B7                    	ORA	A
  1F54'   C2 1F87'              	JNZ	ER_END
  1F57'   21 0080               	LXI	H,CMDTAIL
  1F5A'   0E 00                 	MVI	C,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F5C'                         ER_SC:				; C = its bytes, up to a ^Z
  1F5C'   7E                    	MOV	A,M
  1F5D'   FE 1A                 	CPI	CPMEOF
  1F5F'   CA 1F67'              	JZ	ER_GOT
  1F62'   23                    	INX	H
  1F63'   0C                    	INR	C
  1F64'   F2 1F5C'              	JP	ER_SC		; (minus: all 128)
  1F67'                         ER_GOT:
  1F67'   79                    	MOV	A,C
  1F68'   B7                    	ORA	A
  1F69'   CA 1F87'              	JZ	ER_END
  1F6C'   C5                    	PUSH	B
  1F6D'   3A 2A5A'              	LDA	RDANY
  1F70'   B7                    	ORA	A
  1F71'   CC 1FB8'              	CZ	ER_1ST
  1F74'   C1                    	POP	B
  1F75'   06 00                 	MVI	B,0
  1F77'   11 0080               	LXI	D,CMDTAIL
  1F7A'   C5                    	PUSH	B
  1F7B'   CD 0000*              	CALL	INSBLK
  1F7E'   C1                    	POP	B
  1F7F'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  1F82'   79                    	MOV	A,C
  1F83'   17                    	RAL
  1F84'   DA 1F4E'              	JC	ER_LP		; a full record: there may be more
  1F87'                         ER_END:
  1F87'   3A 2A5A'              	LDA	RDANY
  1F8A'   B7                    	ORA	A
  1F8B'   CA 1FA9'              	JZ	ER_PL		; nothing in the file: nothing has changed
  1F8E'   CD 0A04'              	CALL	ATEOF
  1F91'   DA 1F9E'              	JC	ER_MD		; the text now ends as the file read ends
  1F94'   2A 0000*              	LHLD	GAPBEG
  1F97'   2B                    	DCX	H
  1F98'   7E                    	MOV	A,M
  1F99'   FE 0A                 	CPI	LF
  1F9B'   C4 1E05'              	CNZ	PUTBRK		; text follows: what was read ends a line
  1F9E'                         ER_MD:
  1F9E'   3E 01                 	MVI	A,1
  1FA0'   32 2999'              	STA	MODF
  1FA3'   CD 03CF'              	CALL	MKPAGE		; back to the first line read
  1FA6'   CD 0000*              	CALL	GOTO
  1FA9'                         ER_PL:
  1FA9'   CD 0A04'              	CALL	ATEOF
  1FAC'   DC 0A0A'              	CC	LASTLN		; (nothing read, at the end: the last line)
  1FAF'   CD 0000*              	CALL	CLRCNT
  1FB2'   CD 0F78'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  1FB5'   C3 077B'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  1FB8'                         ER_1ST:
  1FB8'   3C                    	INR	A
  1FB9'   32 2A5A'              	STA	RDANY
  1FBC'   3A 2A5B'              	LDA	RDBRK
  1FBF'   B7                    	ORA	A
  1FC0'   C4 1E05'              	CNZ	PUTBRK
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1FC3'   21 2A2D'              	LXI	H,MKPOS
  1FC6'   C3 044F'              	JMP	FPSTO
  1FC9'                         ER_NOF:
  1FC9'   21 23AF'              	LXI	H,SNOPN
  1FCC'   C3 223E'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  1FCF'                         WRCHK:
  1FCF'   3A 29F1'              	LDA	EXARG
  1FD2'   B7                    	ORA	A
  1FD3'   C2 1FDD'              	JNZ	WC_ARG
  1FD6'   CD 2040'              	CALL	OWNTF
  1FD9'   D8                    	RC
  1FDA'   C3 1FF2'              	JMP	WC_OWN
  1FDD'                         WC_ARG:
  1FDD'   CD 2056'              	CALL	ISOWN
  1FE0'   CA 1FF2'              	JZ	WC_OWN
  1FE3'   3A 2A03'              	LDA	EXBANG
  1FE6'   B7                    	ORA	A
  1FE7'   CA 1FF0'              	JZ	WC_OTH
  1FEA'   CD 0000*              	CALL	TEXIST
  1FED'   C2 2217'              	JNZ	MSGEXI		; File exists (! to force)
  1FF0'                         WC_OTH:
  1FF0'   AF                    	XRA	A		; (NC)
  1FF1'   C9                    	RET
  1FF2'                         WC_OWN:
  1FF2'   3A 2A04'              	LDA	ROFLAG		; '-R': this is the file it may not write
  1FF5'   B7                    	ORA	A
  1FF6'   CA 2000'              	JZ	WC_OK
  1FF9'   3A 2A03'              	LDA	EXBANG
  1FFC'   B7                    	ORA	A
  1FFD'   C2 221D'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  2000'                         WC_OK:
  2000'   3E 01                 	MVI	A,1
  2002'   B7                    	ORA	A		; (NC)
  2003'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  2004'                         WRITE:
  2004'   3A 29F2'              	LDA	EXBAK
  2007'   CD 0000*              	CALL	WRTO
  200A'   3A 0001*              	LDA	FNAME+1
  200D'   FE 20                 	CPI	' '
  200F'   C2 201B'              	JNZ	WR_HAS
  2012'   21 0000*              	LXI	H,TFCB
  2015'   11 0000*              	LXI	D,FNAME
  2018'   CD 2068'              	CALL	COPY12
  201B'                         WR_HAS:
  201B'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  201D'   32 2A01'              	STA	MSGWHT
  2020'   CD 2056'              	CALL	ISOWN
  2023'   C2 202D'              	JNZ	SRCTF
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  2026'   AF                    	XRA	A
  2027'   32 2999'              	STA	MODF
  202A'   32 2A02'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  202D'                         SRCTF:
  202D'   21 0000*              	LXI	H,TFCB
  2030'   11 005C               	LXI	D,DFTFCB
  2033'   CD 2068'              	CALL	COPY12
  2036'   AF                    	XRA	A
  2037'   06 04                 	MVI	B,4
  2039'                         SRC_Z:
  2039'   12                    	STAX	D		; extent, s1, s2, record count: 0
  203A'   13                    	INX	D
  203B'   05                    	DCR	B
  203C'   C2 2039'              	JNZ	SRC_Z
  203F'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  2040'                         OWNTF:
  2040'   3A 0001*              	LDA	FNAME+1
  2043'   FE 20                 	CPI	' '
  2045'   CA 2211'              	JZ	MSGNFN
  2048'   CD 2073'              	CALL	TFCLR
  204B'   21 0000*              	LXI	H,FNAME
  204E'   11 0000*              	LXI	D,TFCB
  2051'   CD 2068'              	CALL	COPY12
  2054'   B7                    	ORA	A		; (NC)
  2055'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  2056'                         ISOWN:
  2056'   21 0000*              	LXI	H,TFCB
  2059'   11 0000*              	LXI	D,FNAME
  205C'   06 0C                 	MVI	B,12
  205E'                         IO_LP:
  205E'   1A                    	LDAX	D
  205F'   BE                    	CMP	M
  2060'   C0                    	RNZ
  2061'   23                    	INX	H
  2062'   13                    	INX	D
  2063'   05                    	DCR	B
  2064'   C2 205E'              	JNZ	IO_LP
  2067'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  2068'                         COPY12:
  2068'   06 0C                 	MVI	B,12
  206A'                         CP_LP:
  206A'   7E                    	MOV	A,M
  206B'   12                    	STAX	D
  206C'   23                    	INX	H
  206D'   13                    	INX	D
  206E'   05                    	DCR	B
  206F'   C2 206A'              	JNZ	CP_LP
  2072'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


                                ;TFCLR -- zero TFCB.  Keeps HL.
  2073'                         TFCLR:
  2073'   11 0000*              	LXI	D,TFCB
  2076'   06 24                 	MVI	B,36
  2078'   AF                    	XRA	A
  2079'                         TC_LP:
  2079'   12                    	STAX	D
  207A'   13                    	INX	D
  207B'   05                    	DCR	B
  207C'   C2 2079'              	JNZ	TC_LP
  207F'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  2080'                         FOPEN:
  2080'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  2082'   32 2A01'              	STA	MSGWHT
  2085'   21 005C               	LXI	H,DFTFCB
  2088'   CD 215A'              	CALL	NRMDRV
  208B'   11 0000*              	LXI	D,FNAME
  208E'   CD 2068'              	CALL	COPY12
  2091'   CD 0000*              	CALL	OPENZ
  2094'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  2097'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  2099'   C8                    	RZ
  209A'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  209D'   32 2A02'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  20A0'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  20A1'                         ARGSCN:
  20A1'   3A 0080               	LDA	CMDTAIL
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  20A4'   47                    	MOV	B,A		; B = what is left of the line
  20A5'   B7                    	ORA	A
  20A6'   C8                    	RZ
  20A7'   21 0081               	LXI	H,CMDTAIL+1
  20AA'                         AS_TOK:				; at a token, or the blanks before one
  20AA'   7E                    	MOV	A,M
  20AB'   FE 20                 	CPI	' '
  20AD'   C2 20B6'              	JNZ	AS_OPT
  20B0'   23                    	INX	H
  20B1'   05                    	DCR	B
  20B2'   C2 20AA'              	JNZ	AS_TOK
  20B5'   C9                    	RET
  20B6'                         AS_OPT:
  20B6'   FE 2B                 	CPI	'+'
  20B8'   CA 20E2'              	JZ	AS_PLS
  20BB'   FE 2D                 	CPI	'-'
  20BD'   CA 20D1'              	JZ	AS_SW
  20C0'   FE 2F                 	CPI	'/'
  20C2'   CA 20D1'              	JZ	AS_SW
  20C5'                         AS_SKP:				; not ours (the file name): on to the next one
  20C5'   23                    	INX	H
  20C6'   05                    	DCR	B
  20C7'   C8                    	RZ
  20C8'   7E                    	MOV	A,M
  20C9'   FE 20                 	CPI	' '
  20CB'   C2 20C5'              	JNZ	AS_SKP
  20CE'   C3 20AA'              	JMP	AS_TOK
  20D1'                         AS_SW:
  20D1'   23                    	INX	H
  20D2'   05                    	DCR	B
  20D3'   C8                    	RZ
  20D4'   7E                    	MOV	A,M
  20D5'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  20D7'   FE 52                 	CPI	'R'
  20D9'   C2 20C5'              	JNZ	AS_SKP
  20DC'   32 2A04'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  20DF'   C3 20C5'              	JMP	AS_SKP
  20E2'                         AS_PLS:
  20E2'   3E 01                 	MVI	A,1
  20E4'   32 2A05'              	STA	PLUSF		; '+' gets the line even with no number on it
  20E7'   11 0000*              	LXI	D,PLUSB
  20EA'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  20EC'   23                    	INX	H		;   line space, so it is taken as '+' alone
  20ED'   05                    	DCR	B
  20EE'   CA 2125'              	JZ	AS_PE
  20F1'   7E                    	MOV	A,M
  20F2'   FE 30                 	CPI	'0'
  20F4'   C2 210C'              	JNZ	AS_PD
  20F7'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  20F7'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  20F8'   05                    	DCR	B
  20F9'   CA 212D'              	JZ	AS_P1
  20FC'   7E                    	MOV	A,M
  20FD'   FE 30                 	CPI	'0'
  20FF'   CA 20F7'              	JZ	AS_PZ
  2102'   FE 31                 	CPI	'1'
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  2104'   DA 212D'              	JC	AS_P1		; zeros and then no digit at all: line 1
  2107'   FE 3A                 	CPI	'9'+1
  2109'   D2 212D'              	JNC	AS_P1
  210C'                         AS_PD:				; the digits, as typed
  210C'   7E                    	MOV	A,M
  210D'   FE 30                 	CPI	'0'
  210F'   DA 2125'              	JC	AS_PE
  2112'   FE 3A                 	CPI	'9'+1
  2114'   D2 2125'              	JNC	AS_PE
  2117'   79                    	MOV	A,C
  2118'   B7                    	ORA	A
  2119'   CA 2134'              	JZ	AS_POV
  211C'   0D                    	DCR	C
  211D'   7E                    	MOV	A,M
  211E'   12                    	STAX	D
  211F'   13                    	INX	D
  2120'   23                    	INX	H
  2121'   05                    	DCR	B
  2122'   C2 210C'              	JNZ	AS_PD
  2125'                         AS_PE:
  2125'   AF                    	XRA	A
  2126'   12                    	STAX	D		; the digits end with a 0
  2127'   78                    	MOV	A,B
  2128'   B7                    	ORA	A
  2129'   C8                    	RZ
  212A'   C3 20AA'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  212D'                         AS_P1:
  212D'   3E 31                 	MVI	A,'1'
  212F'   12                    	STAX	D
  2130'   13                    	INX	D
  2131'   C3 2125'              	JMP	AS_PE
  2134'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  2134'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  2137'   C3 2125'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  213A'                         ARGGO:
  213A'   3A 2A05'              	LDA	PLUSF
  213D'   B7                    	ORA	A
  213E'   C8                    	RZ
  213F'   21 0000*              	LXI	H,PLUSB
  2142'                         AG_LP:
  2142'   7E                    	MOV	A,M
  2143'   B7                    	ORA	A
  2144'   CA 2153'              	JZ	AG_G
  2147'   4F                    	MOV	C,A
  2148'   06 02                 	MVI	B,KT_CHAR
  214A'   E5                    	PUSH	H
  214B'   CD 0023'              	CALL	VICMD
  214E'   E1                    	POP	H
  214F'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2150'   C3 2142'              	JMP	AG_LP
  2153'                         AG_G:
  2153'   0E 47                 	MVI	C,'G'
  2155'   06 02                 	MVI	B,KT_CHAR
  2157'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  215A'                         NRMDRV:
  215A'   7E                    	MOV	A,M
  215B'   B7                    	ORA	A
  215C'   C0                    	RNZ
  215D'   E5                    	PUSH	H
  215E'   0E 19                 	MVI	C,BF_CURDSK
  2160'   CD 0005               	CALL	BDOS
  2163'   E1                    	POP	H
  2164'   3C                    	INR	A
  2165'   77                    	MOV	M,A
  2166'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  2167'                         PARSFN:
  2167'   CD 2073'              	CALL	TFCLR
  216A'   11 0000*              	LXI	D,TFCB
  216D'   23                    	INX	H
  216E'   7E                    	MOV	A,M
  216F'   2B                    	DCX	H
  2170'   FE 3A                 	CPI	':'
  2172'   C2 2184'              	JNZ	PF_NM
  2175'   CD 21CA'              	CALL	GETFNC
  2178'   CA 2184'              	JZ	PF_NM
  217B'   D6 40                 	SUI	40H
  217D'   12                    	STAX	D
  217E'   FE 11                 	CPI	17
  2180'   D2 21A8'              	JNC	PF_BAD
  2183'   23                    	INX	H
  2184'                         PF_NM:
  2184'   13                    	INX	D
  2185'   0E 08                 	MVI	C,8
  2187'   CD 21AC'              	CALL	CPYNAM
  218A'   FE 2E                 	CPI	'.'
  218C'   0E 03                 	MVI	C,3
  218E'   C4 21BF'              	CNZ	PADFLD		; no type: blanks
  2191'   CC 21AB'              	CZ	CPYNM0		; '.': the type
  2194'   3A 0001*              	LDA	TFCB+1
  2197'   FE 20                 	CPI	' '
  2199'   CA 21A8'              	JZ	PF_BAD		; no name
  219C'   CD 21FD'              	CALL	SKIPB
  219F'   C0                    	RNZ			; more after it
  21A0'   21 0000*              	LXI	H,TFCB
  21A3'   CD 215A'              	CALL	NRMDRV
  21A6'   AF                    	XRA	A
  21A7'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  21A8'                         PF_BAD:
  21A8'   F6 01                 	ORI	1
  21AA'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  21AB'                         CPYNM0:
  21AB'   23                    	INX	H
  21AC'                         CPYNAM:
  21AC'   CD 21CA'              	CALL	GETFNC
  21AF'   CA 21BF'              	JZ	PADFLD
  21B2'   12                    	STAX	D
  21B3'   13                    	INX	D
  21B4'   0D                    	DCR	C
  21B5'   C2 21AC'              	JNZ	CPYNAM
  21B8'                         CN_SKP:
  21B8'   CD 21CA'              	CALL	GETFNC
  21BB'   C2 21B8'              	JNZ	CN_SKP
  21BE'   C9                    	RET
  21BF'                         PADFLD:
  21BF'   F5                    	PUSH	PSW
  21C0'                         PD_LP:
  21C0'   3E 20                 	MVI	A,' '
  21C2'   12                    	STAX	D
  21C3'   13                    	INX	D
  21C4'   0D                    	DCR	C
  21C5'   C2 21C0'              	JNZ	PD_LP
  21C8'   F1                    	POP	PSW
  21C9'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  21CA'                         GETFNC:
  21CA'   7E                    	MOV	A,M
  21CB'   FE 3D                 	CPI	'='
  21CD'   C8                    	RZ
  21CE'   FE 5F                 	CPI	'_'
  21D0'   C8                    	RZ
  21D1'   FE 3B                 	CPI	';'
  21D3'   C8                    	RZ
  21D4'   FE 3C                 	CPI	'<'
  21D6'   C8                    	RZ
  21D7'   FE 3E                 	CPI	'>'
  21D9'   C8                    	RZ
  21DA'   FE 2E                 	CPI	'.'
  21DC'   C8                    	RZ
  21DD'   FE 3A                 	CPI	':'
  21DF'   C8                    	RZ
  21E0'   FE 2A                 	CPI	'*'
  21E2'   C8                    	RZ
  21E3'   FE 3F                 	CPI	'?'
  21E5'   C8                    	RZ
  21E6'   FE 20                 	CPI	' '
  21E8'   DA 21FB'              	JC	GF_CTL
  21EB'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  21EC'   23                    	INX	H
  21ED'   FE 61                 	CPI	'a'
  21EF'   DA 21F9'              	JC	GF_DN
  21F2'   FE 7B                 	CPI	'z'+1
  21F4'   D2 21F9'              	JNC	GF_DN
  21F7'   E6 DF                 	ANI	0DFH
  21F9'                         GF_DN:
  21F9'   B7                    	ORA	A
  21FA'   C9                    	RET
  21FB'                         GF_CTL:
  21FB'   BF                    	CMP	A
  21FC'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  21FD'                         SKIPB:
  21FD'   7E                    	MOV	A,M
  21FE'   FE 20                 	CPI	' '
  2200'   C2 2207'              	JNZ	SB_DN
  2203'   23                    	INX	H
  2204'   C3 21FD'              	JMP	SKIPB
  2207'                         SB_DN:
  2207'   B7                    	ORA	A
  2208'   C9                    	RET
                                
                                ;ISLOW -- A = the char at HL; NC iff a-z.
  2209'                         ISLOW:
  2209'   7E                    	MOV	A,M
  220A'   FE 61                 	CPI	'a'
  220C'   D8                    	RC
  220D'   FE 7B                 	CPI	'z'+1
  220F'   3F                    	CMC
  2210'   C9                    	RET
                                
                                ;--- ex messages (vim's, without the Enn number) ---
  2211'                         MSGNFN:
  2211'   21 225E'              	LXI	H,SNFN
  2214'   C3 2249'              	JMP	EXERR
  2217'                         MSGEXI:
  2217'   21 2278'              	LXI	H,SEXI
  221A'   C3 2226'              	JMP	EXBNG
  221D'                         MSGRO:
  221D'   21 2284'              	LXI	H,SRO
  2220'   C3 2226'              	JMP	EXBNG
  2223'                         MSGNWR:
