                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the cursor's line is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
                         C      ; PLACE -- what a command asks of the next layout (SCRN.MAC), cleared by it.
  0000                   C      PL_ASK	EQU	0		; the cursor only moved: is its line on the screen
                         C      				;   still, near it, or far off? (vim's rule)
  0001                   C      PL_SET	EQU	1		; the command set the lines above it (WINROW)
  0002                   C      PL_MID	EQU	2		; mid-screen, as the rows fall
                         C      
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; the cursor's line changed only -> redraw it from the cursor's row
  0003                   C      R_DLIN	EQU	3		; the cursor's line deleted -> DL its rows + redraw the bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted, no TAB after it -> ICH
  0005                   C      R_ILIN	EQU	5		; ILN lines opened at the cursor -> IL + their rows (ILABOV: the line above)
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw it + DL the rows saved
  0007                   C      R_DCH	EQU	7		; chars deleted at the cursor, none after it a TAB -> DCH
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	COL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	DCHN				; ... the cells an R_DCH deletes
                                	PUBLIC	DCHBS				; ... 1 = left of the cursor (BS)
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	MKSHFT				; the marks follow an edit (VI.MAC hooks it)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	HTN, HTCUR, HTEOF, HTBOF	; the row table's facts (SCRN.MAC HTBLD)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	KBBRK, KBFLSH			; KEY.MAC -- an ESC waiting / drop type-ahead
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	MKSAV				; ... and a refused 'dd's copy of them
                                	EXTRN	MKUND				; ... and the copy 'u' puts back
                                	EXTRN	UNDST, UNDNEW			; BUF.MAC -- undone or not; no change yet
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
                                	EXTRN	UNDCLR				; ... nothing to undo
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	INSBLK, UNDINS			; BUF.MAC -- a block in at the cursor (':r')
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	SCBOT, SCEOF, SCBOF, PLACE	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	SKIPR, TALLF		; a top line taller than the screen
                                	EXTRN	TXEND, CSUB, HTBLD		; ... its rows of text, the cursor's row
                                						;   in its line, and the row table
                                	EXTRN	HTAB				; RSV.MAC -- the row table itself
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	SETC0				; BUF.MAC -- WM count set, forward
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GOLINE				; BUF.MAC -- WM 2228 (a mark's page loop)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   AF                    	XRA	A		; no command is ever left open to an ESC by the
  0001'   32 2E3B'              	STA	BRKARM		;   one before it (BRKON)
  0004'   CD 00D7'              	CALL	DOTPRE
  0007'   CD 000D'              	CALL	CDMODE
  000A'   C3 011C'              	JMP	DOTPOST
  000D'                         CDMODE:
  000D'   3A 2D7A'              	LDA	EDMODE
  0010'   FE 01                 	CPI	EM_INS
  0012'   CA 001D'              	JZ	CD_INS
  0015'   FE 02                 	CPI	EM_REP
  0017'   CA 0020'              	JZ	CD_REP
  001A'   C3 0023'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  001D'                         CD_INS:
  001D'   C3 1ECB'              	JMP	VIINS
  0020'                         CD_REP:
  0020'   C3 1E00'              	JMP	VIREP
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


                                
                                ;============================================================
                                ; VICMD -- command-mode key.  C = the key.
                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  0023'                         VICMD:
  0023'   79                    	MOV	A,C
  0024'   FE 1B                 	CPI	ESC
  0026'   CA 00AC'              	JZ	VIC_ESC
  0029'   3A 2DAF'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002C'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  002E'   CA 19EA'              	JZ	VR_DO
                                	;--- maybe a count digit ---
  0031'   79                    	MOV	A,C
  0032'   FE 31                 	CPI	'1'
  0034'   DA 003F'              	JC	VIC_NOTD	; < '1'
  0037'   FE 3A                 	CPI	'9'+1
  0039'   D2 003F'              	JNC	VIC_NOTD	; > '9'
  003C'   C3 004F'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  003F'                         VIC_NOTD:
  003F'   79                    	MOV	A,C
  0040'   FE 30                 	CPI	'0'
  0042'   C2 0077'              	JNZ	VICDSP
  0045'   2A 2D7B'              	LHLD	CMDCNT
  0048'   7C                    	MOV	A,H
  0049'   B5                    	ORA	L
  004A'   CA 0077'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  004D'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  004F'                         VICDIG:
  004F'   2A 2D7B'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0052'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0053'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0054'   29                    	DAD	H		; *2
  0055'   DA 006E'              	JC	VIC_SAT
  0058'   29                    	DAD	H		; *4
  0059'   DA 006E'              	JC	VIC_SAT
  005C'   19                    	DAD	D		; *5
  005D'   DA 006E'              	JC	VIC_SAT
  0060'   29                    	DAD	H		; *10
  0061'   DA 006E'              	JC	VIC_SAT
  0064'   79                    	MOV	A,C
  0065'   D6 30                 	SUI	'0'
  0067'   5F                    	MOV	E,A
  0068'   16 00                 	MVI	D,0
  006A'   19                    	DAD	D
  006B'   D2 0071'              	JNC	VIC_CNT
  006E'                         VIC_SAT:
  006E'   21 FFFF               	LXI	H,0FFFFH
  0071'                         VIC_CNT:
  0071'   22 2D7B'              	SHLD	CMDCNT
  0074'   C3 07A0'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  0077'                         VICDSP:
  0077'   3A 2DAF'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  007A'   32 2DB0'              	STA	GSAVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  007D'   AF                    	XRA	A
  007E'   32 2DAF'              	STA	GPEND
  0081'   3A 2DB1'              	LDA	PENDOP
  0084'   32 2DB2'              	STA	PSAVE
  0087'   AF                    	XRA	A
  0088'   32 2DB1'              	STA	PENDOP
  008B'   3A 2DB2'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  008E'   B7                    	ORA	A
  008F'   C2 1369'              	JNZ	OPPEND
  0092'   3A 2DB0'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0095'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  0097'   C2 00A0'              	JNZ	VIC_TB
  009A'   79                    	MOV	A,C
  009B'   FE 5A                 	CPI	'Z'
  009D'   C2 00A6'              	JNZ	VIC_SW
  00A0'                         VIC_TB:
  00A0'   21 2CC2'              	LXI	H,CMDTAB
  00A3'   C3 00BC'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A6'                         VIC_SW:
  00A6'   CD 07A0'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00A9'   C3 06CB'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AC'                         VIC_ESC:
  00AC'   AF                    	XRA	A		; ESC drops whatever was pending, the count too
  00AD'   32 2DAF'              	STA	GPEND
  00B0'   32 2DB0'              	STA	GSAVE
  00B3'   32 2DB1'              	STA	PENDOP
  00B6'   32 2DB2'              	STA	PSAVE
  00B9'   C3 00A6'              	JMP	VIC_SW
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the TOP-LEVEL key table, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00BC'                         VSCANQ:
  00BC'   CD 00C8'              	CALL	VSCLK
  00BF'   CA 00A6'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C2'   E9                    	PCHL
  00C3'                         VSCAN:
  00C3'   CD 00C8'              	CALL	VSCLK
  00C6'   C8                    	RZ			; miss
  00C7'   E9                    	PCHL
  00C8'                         VSCLK:
  00C8'   7E                    VSCAN1: MOV	A,M
  00C9'   B7                    	ORA	A
  00CA'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00CB'   23                    	INX	H
  00CC'   B9                    	CMP	C
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00CD'   5E                    	MOV	E,M
  00CE'   23                    	INX	H
  00CF'   56                    	MOV	D,M
  00D0'   23                    	INX	H
  00D1'   C2 00C8'              	JNZ	VSCAN1
  00D4'   EB                    	XCHG			; HL = the handler
  00D5'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00D6'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00D7'                         DOTPRE:
  00D7'   3A 2DA6'              	LDA	DOTRPL
  00DA'   B7                    	ORA	A
  00DB'   C0                    	RNZ			; the replay's own keys are not recorded
  00DC'   C5                    	PUSH	B
  00DD'   D5                    	PUSH	D
  00DE'   E5                    	PUSH	H
  00DF'   3A 2DA5'              	LDA	DOTSTA
  00E2'   B7                    	ORA	A
  00E3'   CA 00F6'              	JZ	DOTP1
  00E6'   AF                    	XRA	A		; a new command: the recording starts over
  00E7'   32 2DA5'              	STA	DOTSTA
  00EA'   32 2DA7'              	STA	DOTOVF
  00ED'   21 0000*              	LXI	H,DOTSCR
  00F0'   22 2DA9'              	SHLD	DOTSP
  00F3'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00F6'                         DOTP1:
  00F6'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00F7'   32 2DA8'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  00FA'   47                    	MOV	B,A
  00FB'   2A 2DA9'              	LHLD	DOTSP
  00FE'   EB                    	XCHG
  00FF'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  0102'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  0105'   D2 0114'              	JNC	DOTPOV
  0108'   2A 2DA9'              	LHLD	DOTSP
  010B'   70                    	MOV	M,B
  010C'   23                    	INX	H
  010D'   22 2DA9'              	SHLD	DOTSP
  0110'                         DOTPX:
  0110'   E1                    	POP	H
  0111'   D1                    	POP	D
  0112'   C1                    	POP	B
  0113'   C9                    	RET
  0114'                         DOTPOV:
  0114'   3E 01                 	MVI	A,1
  0116'   32 2DA7'              	STA	DOTOVF		; too long to record: give this recording up
  0119'   C3 0110'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  011C'                         DOTPOST:
  011C'   3A 2DA6'              	LDA	DOTRPL
  011F'   B7                    	ORA	A
  0120'   C0                    	RNZ
  0121'   3A 2D7A'              	LDA	EDMODE
  0124'   B7                    	ORA	A
  0125'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  0126'   3A 2DAF'              	LDA	GPEND
  0129'   B7                    	ORA	A
  012A'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  012B'   3A 2DB1'              	LDA	PENDOP
  012E'   B7                    	ORA	A
  012F'   C0                    	RNZ			; an operator still waiting for its motion
  0130'   2A 2D7B'              	LHLD	CMDCNT
  0133'   7C                    	MOV	A,H
  0134'   B5                    	ORA	L
  0135'   CA 0143'              	JZ	DOTQ1
  0138'   3A 2DA8'              	LDA	DOTLK		; a digit with the count still up: the command
  013B'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  013D'   DA 0143'              	JC	DOTQ1
  0140'   FE 3A                 	CPI	'9'+1
  0142'   D8                    	RC
  0143'                         DOTQ1:
  0143'   3E 01                 	MVI	A,1
  0145'   32 2DA5'              	STA	DOTSTA		; the next key starts a new recording
  0148'   3A 2DA4'              	LDA	DOTCHG
  014B'   B7                    	ORA	A
  014C'   C8                    	RZ			; changed nothing: not a repeatable command
  014D'   AF                    	XRA	A
  014E'   32 2DA4'              	STA	DOTCHG
  0151'   32 2DAB'              	STA	DOTLEN
  0154'   3A 2DA7'              	LDA	DOTOVF
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0157'   B7                    	ORA	A
  0158'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  0159'   2A 2DA9'              	LHLD	DOTSP
  015C'   11 0000*              	LXI	D,DOTSCR
  015F'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  0162'   7D                    	MOV	A,L
  0163'   32 2DAB'              	STA	DOTLEN
  0166'   B7                    	ORA	A
  0167'   C8                    	RZ
  0168'   4F                    	MOV	C,A
  0169'   06 00                 	MVI	B,0
  016B'   21 0000*              	LXI	H,DOTSCR
  016E'   11 0000*              	LXI	D,DOTBUF
  0171'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  0174'                         MARKMOD:
  0174'   3E 01                 	MVI	A,1
  0176'   32 2D7E'              	STA	MODF
  0179'   32 2DA4'              	STA	DOTCHG
  017C'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  017D'                         VC_DOT:
  017D'   2A 2D7B'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0180'   22 2DAD'              	SHLD	DOTNCT
  0183'   21 0000               	LXI	H,0
  0186'   22 2D7B'              	SHLD	CMDCNT
  0189'   3A 2DAB'              	LDA	DOTLEN
  018C'   B7                    	ORA	A
  018D'   CA 01DC'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
  0190'   AF                    	XRA	A
  0191'   32 2DAC'              	STA	DOTIX
  0194'   2A 2DAD'              	LHLD	DOTNCT
  0197'   7C                    	MOV	A,H
  0198'   B5                    	ORA	L
  0199'   CA 01B9'              	JZ	DOTGO
  019C'   22 2D7B'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  019F'                         DOTSKP:
  019F'   CD 05A4'              	CALL	DOTGET		; ... so step past the digits it recorded
  01A2'   DA 01B9'              	JC	DOTGO
  01A5'   FE 30                 	CPI	'0'
  01A7'   DA 01B9'              	JC	DOTGO
  01AA'   FE 3A                 	CPI	'9'+1
  01AC'   D2 01B9'              	JNC	DOTGO
  01AF'   3A 2DAC'              	LDA	DOTIX
  01B2'   3C                    	INR	A
  01B3'   32 2DAC'              	STA	DOTIX
  01B6'   C3 019F'              	JMP	DOTSKP
  01B9'                         DOTGO:
  01B9'   3E 01                 	MVI	A,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01BB'   32 2DA6'              	STA	DOTRPL
  01BE'                         DOTLP:
  01BE'   CD 05A4'              	CALL	DOTGET
  01C1'   DA 01D2'              	JC	DOTDN
  01C4'   4F                    	MOV	C,A
  01C5'   3A 2DAC'              	LDA	DOTIX
  01C8'   3C                    	INR	A
  01C9'   32 2DAC'              	STA	DOTIX
  01CC'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01CF'   C3 01BE'              	JMP	DOTLP
  01D2'                         DOTDN:
  01D2'   AF                    	XRA	A
  01D3'   32 2DA6'              	STA	DOTRPL
  01D6'   32 2DA4'              	STA	DOTCHG		; the '.' is not itself the new last change
  01D9'   C3 07DD'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01DC'                         DOTBEL:
  01DC'   0E 07                 	MVI	C,BEL
  01DE'   CD 0000*              	CALL	BCONOU
  01E1'   C3 07A0'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a 3-byte position in the FILE (FPOS: the records paged out ahead
                                ; of the window, plus the offset into it), so it does not care which part of
                                ; the file is resident: a jump pages until the window holds it (MKPAGE).  It
                                ; FOLLOWS its text, as vim's does: every edit passes MKSHFT, which moves the
                                ; marks past it by the bytes that went in or came out.
                                ;
                                ; DEVIATIONS from vim, in COMMANDS.md: a mark whose own text is deleted closes
                                ; up to where the delete was, where vim deletes the mark with its line; and
                                ; within its line a mark stays with its CHARACTER, where vim keeps the column
                                ; number.  'u' puts the marks back where they were when the change it
                                ; undoes began (MKSNAP / MKREST).
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  01E4'                         MKVAD:
  01E4'   16 00                 	MVI	D,0
  01E6'   59                    	MOV	E,C
  01E7'   21 2E17'              	LXI	H,MKVAL
  01EA'   19                    	DAD	D
  01EB'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  01EC'                         MKCLR:
  01EC'   21 2E17'              	LXI	H,MKVAL
  01EF'   06 03                 	MVI	B,MKMAX
  01F1'   AF                    	XRA	A
  01F2'                         MKC_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


  01F2'   77                    	MOV	M,A
  01F3'   23                    	INX	H
  01F4'   05                    	DCR	B
  01F5'   C2 01F2'              	JNZ	MKC_LP
  01F8'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was an ESC.
                                ;A key typed here did not come through the dispatcher, so it is handed to
                                ;DOTPRE to join the recording: that is what lets '.' repeat "dfa", "dgg" and
                                ;"d'a".
  01F9'                         MKGETK:
  01F9'   3A 2DA6'              	LDA	DOTRPL
  01FC'   B7                    	ORA	A
  01FD'   CA 020E'              	JZ	MKG_KB
  0200'   CD 05A4'              	CALL	DOTGET		; the recording's next key
  0203'   D8                    	RC
  0204'   4F                    	MOV	C,A
  0205'   3A 2DAC'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  0208'   3C                    	INR	A
  0209'   32 2DAC'              	STA	DOTIX
  020C'   B7                    	ORA	A		; CY clear
  020D'   C9                    	RET
  020E'                         MKG_KB:
  020E'   CD 0000*              	CALL	GETKEY
  0211'   FE 1B                 	CPI	ESC
  0213'   37                    	STC
  0214'   C8                    	RZ			; ESC cancels the command
  0215'   CD 00D7'              	CALL	DOTPRE		; C kept
  0218'   B7                    	ORA	A		; CY clear
  0219'   C9                    	RET
                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
                                ; the motion returns.  MKGETK puts the character in the '.' recording, so
                                ; '.' can repeat "dfa".
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
                                ;============================================================
  021A'                         VC_FF:				; 'f' -- forward, onto the character
  021A'   3E 66                 	MVI	A,'f'
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  021C'   C3 022B'              	JMP	FNDNEW
  021F'                         VC_FB:				; 'F' -- backward, onto it
  021F'   3E 46                 	MVI	A,'F'
  0221'   C3 022B'              	JMP	FNDNEW
  0224'                         VC_TF:				; 't' -- forward, up to it
  0224'   3E 74                 	MVI	A,'t'
  0226'   C3 022B'              	JMP	FNDNEW
  0229'                         VC_TB:				; 'T' -- backward, up to it
  0229'   3E 54                 	MVI	A,'T'
  022B'                         FNDNEW:
  022B'   32 2E0C'              	STA	FNDKND		; the find ';' and ',' will repeat
  022E'   CD 01F9'              	CALL	MKGETK		; the character it looks for
  0231'   DA 0263'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0234'   79                    	MOV	A,C
  0235'   32 2E0D'              	STA	FNDCH
  0238'   3A 2E0C'              	LDA	FNDKND
  023B'   06 01                 	MVI	B,1		; a find starts at the next character along
  023D'   C3 026A'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0240'                         VC_SEMI:
  0240'   3A 2E0C'              	LDA	FNDKND
  0243'   B7                    	ORA	A
  0244'   CA 0263'              	JZ	FNDNIL		; nothing has been looked for yet
  0247'   C3 0253'              	JMP	FNDREP
  024A'                         VC_COMMA:
  024A'   3A 2E0C'              	LDA	FNDKND
  024D'   B7                    	ORA	A
  024E'   CA 0263'              	JZ	FNDNIL
  0251'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0253'                         FNDREP:
  0253'   06 01                 	MVI	B,1
  0255'   F5                    	PUSH	PSW
  0256'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  0258'   FE 54                 	CPI	'T'
  025A'   C2 025F'              	JNZ	FNDR_GO
  025D'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  025F'                         FNDR_GO:
  025F'   F1                    	POP	PSW
  0260'   C3 026A'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
  0263'                         FNDNIL:
  0263'   AF                    	XRA	A
  0264'   32 2DB2'              	STA	PSAVE
  0267'   C3 07A0'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  026A'                         FNDGO:
  026A'   32 2E0E'              	STA	FNDRUN
  026D'   78                    	MOV	A,B
  026E'   32 2E0F'              	STA	FNDSTP
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  0271'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
  0274'   22 2E10'              	SHLD	FNDN		; the occurrence wanted
  0277'   CD 0000*              	CALL	CUROFF
  027A'   22 2E12'              	SHLD	FNDCUR
  027D'   3A 2E0E'              	LDA	FNDRUN
  0280'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  0282'   CA 02B6'              	JZ	FNDBWD
  0285'   2A 2E12'              	LHLD	FNDCUR
  0288'   CD 0663'              	CALL	EOLC		; HL = the line's last content character
  028B'   22 2E14'              	SHLD	FNDLIM
  028E'   2A 2E12'              	LHLD	FNDCUR
  0291'   3A 2E0F'              	LDA	FNDSTP
  0294'   5F                    	MOV	E,A
  0295'   16 00                 	MVI	D,0
  0297'   19                    	DAD	D		; HL = where the scan starts
  0298'                         FNDF_LP:
  0298'   EB                    	XCHG			; DE = the scan
  0299'   2A 2E14'              	LHLD	FNDLIM
  029C'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  029F'   EB                    	XCHG			; HL = the scan
  02A0'   CA 02A6'              	JZ	FNDF_AT		; the last character is still a candidate
  02A3'   D2 0308'              	JNC	FNDMIS		; past it: not on this line
  02A6'                         FNDF_AT:
  02A6'   CD 030F'              	CALL	FNDSEE		; Z iff this is the character
  02A9'   C2 02B2'              	JNZ	FNDF_NX
  02AC'   CD 031A'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02AF'   CA 02EE'              	JZ	FNDHIT
  02B2'                         FNDF_NX:
  02B2'   23                    	INX	H
  02B3'   C3 0298'              	JMP	FNDF_LP
  02B6'                         FNDBWD:
  02B6'   2A 2E12'              	LHLD	FNDCUR
  02B9'   CD 0624'              	CALL	BOL		; HL = the line's first character
  02BC'   22 2E14'              	SHLD	FNDLIM
  02BF'   2A 2E12'              	LHLD	FNDCUR
  02C2'   3A 2E0F'              	LDA	FNDSTP
  02C5'   2F                    	CMA
  02C6'   5F                    	MOV	E,A
  02C7'   16 FF                 	MVI	D,0FFH
  02C9'   13                    	INX	D		; DE = -step
  02CA'   19                    	DAD	D		; HL = where the scan starts
  02CB'   D2 0308'              	JNC	FNDMIS		; ... off the front of the text altogether
  02CE'                         FNDB_LP:
  02CE'   EB                    	XCHG			; DE = the scan
  02CF'   2A 2E14'              	LHLD	FNDLIM
  02D2'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02D5'   EB                    	XCHG			; HL = the scan
  02D6'   DA 0308'              	JC	FNDMIS		; before this line: not on it
  02D9'   CD 030F'              	CALL	FNDSEE
  02DC'   C2 02E5'              	JNZ	FNDB_NX
  02DF'   CD 031A'              	CALL	FNDCNT
  02E2'   CA 02EE'              	JZ	FNDHIT
  02E5'                         FNDB_NX:
  02E5'   7C                    	MOV	A,H
  02E6'   B5                    	ORA	L
  02E7'   CA 0308'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02EA'   2B                    	DCX	H
  02EB'   C3 02CE'              	JMP	FNDB_LP
                                
                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  02EE'                         FNDHIT:
  02EE'   3A 2E0E'              	LDA	FNDRUN
  02F1'   E6 5F                 	ANI	5FH
  02F3'   FE 54                 	CPI	'T'
  02F5'   C2 0305'              	JNZ	FNDLND
  02F8'   3A 2E0E'              	LDA	FNDRUN
  02FB'   E6 20                 	ANI	20H
  02FD'   CA 0304'              	JZ	FNDH_BW
  0300'   2B                    	DCX	H		; forward 't': the character before it
  0301'   C3 0305'              	JMP	FNDLND
  0304'                         FNDH_BW:
  0304'   23                    	INX	H		; backward 'T': the character after it
  0305'                         FNDLND:
  0305'   C3 05BA'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  0308'                         FNDMIS:
  0308'   AF                    	XRA	A
  0309'   32 2DB2'              	STA	PSAVE
  030C'   C3 01DC'              	JMP	DOTBEL
                                
                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
  030F'                         FNDSEE:
  030F'   E5                    	PUSH	H
  0310'   CD 0000*              	CALL	CHARAT
  0313'   E1                    	POP	H
  0314'   47                    	MOV	B,A
  0315'   3A 2E0D'              	LDA	FNDCH
  0318'   B8                    	CMP	B
  0319'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
                                ; the scan and stays it.
  031A'                         FNDCNT:
  031A'   E5                    	PUSH	H
  031B'   2A 2E10'              	LHLD	FNDN
  031E'   2B                    	DCX	H
  031F'   22 2E10'              	SHLD	FNDN
  0322'   7C                    	MOV	A,H
  0323'   B5                    	ORA	L
  0324'   E1                    	POP	H
  0325'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  0326'                         ISFIND:
  0326'   E6 5F                 	ANI	5FH		; fold the case away
  0328'   FE 46                 	CPI	'F'
  032A'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  032B'   FE 54                 	CPI	'T'
  032D'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  032E'                         VC_MK:
  032E'   3E 04                 	MVI	A,PM
  0330'   C3 033A'              	JMP	MKGO
  0333'                         VC_BQ:
  0333'   3E 05                 	MVI	A,PJ
  0335'   C3 033A'              	JMP	MKGO
  0338'                         VC_AQ:
  0338'   3E 06                 	MVI	A,PJL
  033A'                         MKGO:
  033A'   32 2E23'              	STA	MKWHAT
  033D'   CD 06B8'              	CALL	MOVCNT		; a count means nothing on any of the three
  0340'   CD 01F9'              	CALL	MKGETK		; the key that names the mark
  0343'   DA 0422'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out.  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist: 'm' with any other key
                                ;drops the whole thing, as vim's 'Z{other}' does, and a jump to one is a jump
                                ;to a mark that is not set.
  0346'                         MKOP:
  0346'   79                    	MOV	A,C
  0347'   D6 61                 	SUI	'a'
  0349'   FE 03                 	CPI	MKMAX
  034B'   D2 041A'              	JNC	MKNOLT		; not a mark letter
  034E'   4F                    	MOV	C,A		; C = the mark's index
  034F'   87                    	ADD	A
  0350'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  0351'   5F                    	MOV	E,A
  0352'   16 00                 	MVI	D,0
  0354'   21 0000*              	LXI	H,MKTAB
  0357'   19                    	DAD	D		; HL -> this mark's slot
  0358'   3A 2E23'              	LDA	MKWHAT
  035B'   FE 04                 	CPI	PM
  035D'   CA 0435'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark, paging to it if the window has left it.
                                ;'Mark not set', as vim says it, when it was never set.
                                ;Under an OPERATOR a mark the window does not hold is refused with the bell
                                ;and stays set, all but "d'a": a line delete is the one operator that can take
                                ;a span the window does not hold whole (OPPGD), and going there only to be
                                ;turned away by it would page the file twice for nothing.
  0360'                         MKJMP:
  0360'   E5                    	PUSH	H
  0361'   CD 01E4'              	CALL	MKVAD
  0364'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  0365'   E1                    	POP	H
  0366'   B7                    	ORA	A
  0367'   CA 0410'              	JZ	MKNSET		; never set
  036A'   CD 03DC'              	CALL	MKLOAD		; the file position it holds
  036D'   CD 03E9'              	CALL	MKWIN
  0370'   DA 0387'              	JC	MKJ_GO		; in the window: any command may go there
  0373'   3A 2DB2'              	LDA	PSAVE
  0376'   B7                    	ORA	A
  0377'   CA 0387'              	JZ	MKJ_GO
  037A'   FE 64                 	CPI	'd'		; paged out, and an operator wants the span
  037C'   C2 0422'              	JNZ	MKBAD
  037F'   3A 2E23'              	LDA	MKWHAT
  0382'   FE 06                 	CPI	PJL
  0384'   C2 0422'              	JNZ	MKBAD
  0387'                         MKJ_GO:
  0387'   CD 127A'              	CALL	GZONE		; the screen's top line, before the cursor
                                				;   moves: GPLACE measures the landing against
                                				;   it, and one left over from an earlier 'G'
                                				;   had it keep a window the line is not in
  038A'   CD 06F4'              	CALL	BRKON		; ... and an ESC may stop it from here on
  038D'   CD 03A9'              	CALL	MKPAGE		; HL = the mark's offset in the window
  0390'   CD 0731'              	CALL	BRKOFF		; (A only)
  0393'   DA 0749'              	JC	BRKBAK
  0396'   3A 2E23'              	LDA	MKWHAT
  0399'   FE 06                 	CPI	PJL
  039B'   CA 03A3'              	JZ	MKJ_LN		; ''': GPKEEP is 0, so GPLACE finds the first
  039E'   3E 01                 	MVI	A,1		;   non-blank
  03A0'   32 2E16'              	STA	GPKEEP		; '`': land on the column it was set at
  03A3'                         MKJ_LN:
  03A3'   CD 0000*              	CALL	GOTO
  03A6'   C3 1292'              	JMP	GPLACE		; (which sets LNDLT itself)
                                
                                ;MKPAGE -- page until MKPOS is in the window: HL = its logical offset there.
                                ;The loop is WM's own whole-file line move (MVLMAX: GOLINE to the window's
                                ;edge, SCRLST to page one step), stopped by where the window is instead of by
                                ;the count.  A step cannot carry the window past the mark: the pager evicts
                                ;only behind the cursor, and the cursor is on the edge nearer the mark.
  03A9'                         MKPAGE:
  03A9'   CD 03E9'              	CALL	MKWIN
  03AC'   DA 0000*              	JC	CLRCNT		; there: and the count that paged is spent,
                                				;   not left for the next command to take
  03AF'   32 0000*              	STA	DIRFLG
  03B2'   21 FFFF               	LXI	H,0FFFFH
  03B5'   22 2D7B'              	SHLD	CMDCNT
  03B8'   CD 0000*              	CALL	GOLINE
  03BB'   CD 0000*              	CALL	SCRLST
  03BE'   CD 06E0'              	CALL	CNTTST
  03C1'   C2 03A9'              	JNZ	MKPAGE
  03C4'   CD 03E9'              	CALL	MKWIN		; the file ran out: that was its last step
  03C7'   DA 0000*              	JC	CLRCNT
  03CA'   21 FFFF               	LXI	H,0FFFFH	; the very end of the text, which MKWIN does not
  03CD'   C3 0000*              	JMP	CLRCNT		;   count as in the window: GOTO clamps it
                                
                                ;BACKTO -- back to the 3-byte file position at HL, paging to it: where a
                                ;command that came to nothing started.  The place has to be kept as a file
                                ;position -- a sweep of the whole file leaves the window at the far end of
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


                                ;it, and an offset into the window it started in means nothing there.
  03D0'                         BACKTO:
  03D0'   CD 03DC'              	CALL	MKLOAD
  03D3'   CD 0000*              	CALL	CLRCNT
  03D6'   CD 03A9'              	CALL	MKPAGE
  03D9'   C3 0000*              	JMP	GOTO
                                
                                ;MKLOAD -- MKPOS = the 3-byte file position at HL.
  03DC'                         MKLOAD:
  03DC'   5E                    	MOV	E,M
  03DD'   23                    	INX	H
  03DE'   56                    	MOV	D,M
  03DF'   23                    	INX	H
  03E0'   7E                    	MOV	A,M
  03E1'   EB                    	XCHG
  03E2'   22 2E20'              	SHLD	MKPOS
  03E5'   32 2E22'              	STA	MKPOS+2
  03E8'   C9                    	RET
                                
                                ;MKWIN -- CY and HL = MKPOS as a logical offset if the window holds it; NC and
                                ;A = the way to page for it, as DIRFLG has it (0 forward, FFH back), if not.
  03E9'                         MKWIN:
  03E9'   2A 0000*              	LHLD	TXTBEG
  03EC'   CD 1234'              	CALL	FPOS
  03EF'   EB                    	XCHG
  03F0'   47                    	MOV	B,A		; B:DE = the window's first byte
  03F1'   2A 2E20'              	LHLD	MKPOS
  03F4'   3A 2E22'              	LDA	MKPOS+2
  03F7'   CD 1227'              	CALL	SUB24		; A:HL = the mark, from the window's top
  03FA'   DA 040C'              	JC	MKW_BK		; above it
  03FD'   C2 040A'              	JNZ	MKW_FW		; 64K or more below it
  0400'   E5                    	PUSH	H
  0401'   CD 0000*              	CALL	LOGLEN
  0404'   D1                    	POP	D
  0405'   CD 0000*              	CALL	CMP16		; DE = the offset vs HL = the window's length
  0408'   EB                    	XCHG
  0409'   D8                    	RC			; inside
  040A'                         MKW_FW:
  040A'   AF                    	XRA	A
  040B'   C9                    	RET
  040C'                         MKW_BK:
  040C'   3E FF                 	MVI	A,0FFH
  040E'   B7                    	ORA	A
  040F'   C9                    	RET
                                
                                ;MKNSET -- a jump to a mark that will not answer: vim's E20 on the bottom row
                                ;(without the number, and without a bell, as every message here), the cursor
                                ;and the screen left alone.  The operator is cancelled as MKBAD cancels it.
  0410'                         MKNSET:
  0410'   AF                    	XRA	A
  0411'   32 2DB2'              	STA	PSAVE
  0414'   21 2752'              	LXI	H,SMKNS
  0417'   C3 2637'              	JMP	EXERR
  041A'                         MKNOLT:
  041A'   3A 2E23'              	LDA	MKWHAT
  041D'   FE 04                 	CPI	PM
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  041F'   C2 0410'              	JNZ	MKNSET		; a jump: that mark is not set
                                				; 'm{other}': fall into MKBAD
                                
                                ;MKBAD -- no mark was named: 'm' with a key that is not a mark letter, ESC in
                                ;place of the letter, or a '.' replay that ran out.  The bell, and an operator
                                ;running the motion is cancelled whole: PSAVE is what OPPEND's tail reads to
                                ;decide whether to open an insert, so clearing it stops a "c`z" opening one
                                ;over a span of nothing.
  0422'                         MKBAD:
  0422'   AF                    	XRA	A
  0423'   32 2DB2'              	STA	PSAVE
  0426'   C3 01DC'              	JMP	DOTBEL
                                
                                ;FPSTO -- the cursor's file position into the 3 bytes at HL.  Keeps BC.
  0429'                         FPSTO:
  0429'   E5                    	PUSH	H
  042A'   CD 1231'              	CALL	CURFP		; A:HL = the cursor's file position
  042D'   EB                    	XCHG
  042E'   E1                    	POP	H
  042F'   73                    	MOV	M,E
  0430'   23                    	INX	H
  0431'   72                    	MOV	M,D
  0432'   23                    	INX	H
  0433'   77                    	MOV	M,A
  0434'   C9                    	RET
                                
                                ;MKSET -- remember where in the FILE the cursor is.
  0435'                         MKSET:
  0435'   CD 0429'              	CALL	FPSTO
  0438'   CD 01E4'              	CALL	MKVAD
  043B'   36 01                 	MVI	M,1		; ... and the mark is live
  043D'   C3 07A0'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKSNAP -- keep the marks as they stand, for 'u' (MKREST).  Each copy's spare
                                ;fourth byte takes that mark's live flag.  HL and BC are kept.
  0440'                         MKSNAP:
  0440'   C5                    	PUSH	B
  0441'   E5                    	PUSH	H
  0442'   21 0000*              	LXI	H,MKTAB
  0445'   11 0000*              	LXI	D,MKUND
  0448'   CD 245A'              	CALL	COPY12
  044B'   21 2E17'              	LXI	H,MKVAL
  044E'   11 0003*              	LXI	D,MKUND+MKSIZ-1
  0451'   06 03                 	MVI	B,MKMAX
  0453'                         MSN_LP:
  0453'   7E                    	MOV	A,M
  0454'   12                    	STAX	D
  0455'   23                    	INX	H
  0456'   13                    	INX	D
  0457'   13                    	INX	D
  0458'   13                    	INX	D
  0459'   13                    	INX	D
  045A'   05                    	DCR	B
  045B'   C2 0453'              	JNZ	MSN_LP
  045E'   E1                    	POP	H
  045F'   C1                    	POP	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  0460'   C9                    	RET
                                
                                ;MKREST -- a change has been undone: every mark that was set when it began
                                ;goes back where it was then, whether the change ran over it or 'm' has moved
                                ;it since (vim keeps them with the undo too).  One first set AFTER the change
                                ;is left where the replay's own edits carried it.
  0461'                         MKREST:
  0461'   0E 02                 	MVI	C,MKMAX-1
  0463'                         MRS_LP:
  0463'   79                    	MOV	A,C
  0464'   87                    	ADD	A
  0465'   87                    	ADD	A
  0466'   5F                    	MOV	E,A
  0467'   16 00                 	MVI	D,0
  0469'   21 0003*              	LXI	H,MKUND+MKSIZ-1
  046C'   19                    	DAD	D
  046D'   7E                    	MOV	A,M
  046E'   B7                    	ORA	A
  046F'   CA 048B'              	JZ	MRS_NX		; it was not set then
  0472'   2B                    	DCX	H
  0473'   2B                    	DCX	H
  0474'   2B                    	DCX	H
  0475'   E5                    	PUSH	H
  0476'   21 0000*              	LXI	H,MKTAB
  0479'   19                    	DAD	D
  047A'   EB                    	XCHG			; DE -> the mark
  047B'   E1                    	POP	H		; HL -> its copy
  047C'   06 03                 	MVI	B,MKSIZ-1
  047E'                         MRS_CP:
  047E'   7E                    	MOV	A,M
  047F'   12                    	STAX	D
  0480'   23                    	INX	H
  0481'   13                    	INX	D
  0482'   05                    	DCR	B
  0483'   C2 047E'              	JNZ	MRS_CP
  0486'   CD 01E4'              	CALL	MKVAD
  0489'   36 01                 	MVI	M,1
  048B'                         MRS_NX:
  048B'   0D                    	DCR	C
  048C'   F2 0463'              	JP	MRS_LP
  048F'   C9                    	RET
                                
                                ;MKSHFT -- the text is changing: every mark follows its own text.  BUF.MAC's
                                ;UNDCHG calls this through EDTHK from all six edit primitives -- 'u's replay
                                ;of them included -- with A = 1 for an insert (the text is in) or 2 for a
                                ;delete (it is about to go), HL = the edit's logical offset and BC = its
                                ;length.  A mark before the edit stays; one after it moves by the length; one
                                ;INSIDE a delete closes up to where the delete was.  An insert AT a mark
                                ;leaves the mark in front of the new text, unless that text ends a line -- a
                                ;line opened or put above the mark's is above the mark too.
                                ;The edit is found from the CURSOR's file position less its distance behind
                                ;the cursor, never from the offset alone: a put bigger than the window pages
                                ;its own start out, and that offset has then wrapped.  BC is kept.
  0490'                         MKSHFT:
  0490'   32 2E1F'              	STA	MKTYP
  0493'   3A 2E24'              	LDA	MKHOLD		; a yank that could not copy takes its lines out
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  0496'   B7                    	ORA	A		;   and puts them back unchanged (YKGO): the text
  0497'   C0                    	RNZ			;   every mark points into is still there
  0498'   3A 0000*              	LDA	UNDRPL
  049B'   B7                    	ORA	A
  049C'   C2 04A6'              	JNZ	MKS_GO		; 'u' replaying: not a new change
  049F'   3A 0000*              	LDA	UNDNEW		; the first edit of a new change (UNDCHG calls
  04A2'   B7                    	ORA	A		;   here BEFORE it claims the change): the marks
  04A3'   C4 0440'              	CNZ	MKSNAP		;   as they are now are the ones 'u' puts back
  04A6'                         MKS_GO:
  04A6'   C5                    	PUSH	B
  04A7'   50                    	MOV	D,B
  04A8'   59                    	MOV	E,C
  04A9'   EB                    	XCHG
  04AA'   22 2E1D'              	SHLD	MKN		; the edit's length
  04AD'   D5                    	PUSH	D		; ... and its offset
  04AE'   CD 0000*              	CALL	CUROFF
  04B1'   D1                    	POP	D
  04B2'   CD 0000*              	CALL	SUBHD
  04B5'   EB                    	XCHG			; DE = how far behind the cursor it is
  04B6'   CD 1231'              	CALL	CURFP		; A:HL = the cursor's file position
  04B9'   06 00                 	MVI	B,0
  04BB'   CD 1227'              	CALL	SUB24
  04BE'   22 2E1A'              	SHLD	MKEDIT
  04C1'   32 2E1C'              	STA	MKEDIT+2	; where in the file the edit is
  04C4'   21 2E17'              	LXI	H,MKVAL
  04C7'   11 0000*              	LXI	D,MKTAB
  04CA'   06 03                 	MVI	B,MKMAX
  04CC'                         MKS_LP:
  04CC'   7E                    	MOV	A,M
  04CD'   B7                    	ORA	A
  04CE'   CA 053A'              	JZ	MKS_N0		; that mark is not set
  04D1'   E5                    	PUSH	H
  04D2'   C5                    	PUSH	B
  04D3'   21 2E1A'              	LXI	H,MKEDIT
  04D6'   1A                    	LDAX	D		; the mark's position less the edit's, a byte
  04D7'   96                    	SUB	M		;   at a time (neither INX nor LDAX touch CY)
  04D8'   4F                    	MOV	C,A
  04D9'   13                    	INX	D
  04DA'   23                    	INX	H
  04DB'   1A                    	LDAX	D
  04DC'   9E                    	SBB	M
  04DD'   47                    	MOV	B,A
  04DE'   13                    	INX	D
  04DF'   23                    	INX	H
  04E0'   1A                    	LDAX	D
  04E1'   9E                    	SBB	M		; A:BC = how far past the edit the mark is
  04E2'   DA 0535'              	JC	MKS_PP		; before it: nothing moves
  04E5'   6F                    	MOV	L,A
  04E6'   3A 2E1F'              	LDA	MKTYP
  04E9'   3D                    	DCR	A
  04EA'   CA 050F'              	JZ	MKS_IN
                                	;--- a delete: back by its length, or to it if the mark is inside ---
  04ED'   7D                    	MOV	A,L
  04EE'   2A 2E1D'              	LHLD	MKN
  04F1'   B7                    	ORA	A
  04F2'   C2 04FE'              	JNZ	MKS_DL		; 64K or more past it
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04F5'   79                    	MOV	A,C
  04F6'   95                    	SUB	L
  04F7'   78                    	MOV	A,B
  04F8'   9C                    	SBB	H
  04F9'   D2 04FE'              	JNC	MKS_DL		; past the end of what goes
  04FC'   60                    	MOV	H,B
  04FD'   69                    	MOV	L,C		; inside it: close up to the edit
  04FE'                         MKS_DL:
  04FE'   1B                    	DCX	D
  04FF'   1B                    	DCX	D
  0500'   1A                    	LDAX	D
  0501'   95                    	SUB	L
  0502'   12                    	STAX	D
  0503'   13                    	INX	D
  0504'   1A                    	LDAX	D
  0505'   9C                    	SBB	H
  0506'   12                    	STAX	D
  0507'   13                    	INX	D
  0508'   1A                    	LDAX	D
  0509'   DE 00                 	SBI	0
  050B'   12                    	STAX	D
  050C'   C3 0535'              	JMP	MKS_PP
                                	;--- an insert: on by its length ---
  050F'                         MKS_IN:
  050F'   7D                    	MOV	A,L
  0510'   B0                    	ORA	B
  0511'   B1                    	ORA	C
  0512'   C2 0524'              	JNZ	MKS_AD		; the mark is past it
  0515'   2A 0000*              	LHLD	GAPBEG		; AT the mark: only a line end carries it on
  0518'   2B                    	DCX	H
  0519'   7E                    	MOV	A,M		; the last byte that went in
  051A'   FE 0A                 	CPI	LF
  051C'   CA 0524'              	JZ	MKS_AD
  051F'   FE 0D                 	CPI	CR
  0521'   C2 0535'              	JNZ	MKS_PP
  0524'                         MKS_AD:
  0524'   2A 2E1D'              	LHLD	MKN
  0527'   1B                    	DCX	D
  0528'   1B                    	DCX	D
  0529'   1A                    	LDAX	D
  052A'   85                    	ADD	L
  052B'   12                    	STAX	D
  052C'   13                    	INX	D
  052D'   1A                    	LDAX	D
  052E'   8C                    	ADC	H
  052F'   12                    	STAX	D
  0530'   13                    	INX	D
  0531'   1A                    	LDAX	D
  0532'   CE 00                 	ACI	0
  0534'   12                    	STAX	D
  0535'                         MKS_PP:
  0535'   C1                    	POP	B
  0536'   E1                    	POP	H
  0537'   C3 053C'              	JMP	MKS_NX
  053A'                         MKS_N0:
  053A'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  053B'   13                    	INX	D
  053C'                         MKS_NX:
  053C'   13                    	INX	D
  053D'   13                    	INX	D
  053E'   23                    	INX	H
  053F'   05                    	DCR	B
  0540'   C2 04CC'              	JNZ	MKS_LP
  0543'   C1                    	POP	B
  0544'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  0545'                         VC_UNDO:
  0545'   21 0000               	LXI	H,0
  0548'   22 2D7B'              	SHLD	CMDCNT
  054B'   CD 0000*              	CALL	UNDO
  054E'   DA 0587'              	JC	UNDNO
  0551'   3A 0000*              	LDA	UNDST
  0554'   FE 02                 	CPI	2
  0556'   CC 0461'              	CZ	MKREST		; undone (not redone): the marks go back too
  0559'   2A 0000*              	LHLD	UNDCUR
  055C'   CD 056D'              	CALL	UCLAMP		; vi never sits on a line terminator
  055F'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0562'   3E 01                 	MVI	A,1
  0564'   32 2D7E'              	STA	MODF		; undone past a ':w' still differs from the file
  0567'   CD 094D'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  056A'   C3 07DD'              	JMP	SETFUL		; whole spans moved: repaint rather than guess
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  056D'                         UCLAMP:
  056D'   E5                    	PUSH	H
  056E'   CD 183C'              	CALL	CEND		; HL = the line's content end
  0571'   D1                    	POP	D		; DE = the offset wanted
  0572'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  0575'   D2 057A'              	JNC	UCL_BK
  0578'   EB                    	XCHG
  0579'   C9                    	RET
  057A'                         UCL_BK:
  057A'   E5                    	PUSH	H		; the content end
  057B'   EB                    	XCHG			; HL = the offset wanted
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  057C'   CD 0624'              	CALL	BOL
  057F'   D1                    	POP	D		; DE = the content end, HL = the line's start
  0580'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  0583'   EB                    	XCHG			; HL = the content end
  0584'   C8                    	RZ
  0585'   2B                    	DCX	H		; ... its last character
  0586'   C9                    	RET
  0587'                         UNDNO:
  0587'   3A 0000*              	LDA	UNDWHY
  058A'   B7                    	ORA	A
  058B'   CA 059C'              	JZ	UNDBEL
  058E'   21 270C'              	LXI	H,SUNDW		; the change has paged away: say so
  0591'   FE 01                 	CPI	1
  0593'   CA 2637'              	JZ	EXERR
  0596'   21 272E'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  0599'   C3 2637'              	JMP	EXERR
  059C'                         UNDBEL:
  059C'   0E 07                 	MVI	C,BEL
  059E'   CD 0000*              	CALL	BCONOU
  05A1'   C3 07A0'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  05A4'                         DOTGET:
  05A4'   3A 2DAC'              	LDA	DOTIX
  05A7'   5F                    	MOV	E,A
  05A8'   3A 2DAB'              	LDA	DOTLEN
  05AB'   BB                    	CMP	E
  05AC'   CA 05B8'              	JZ	DOTGEF
  05AF'   16 00                 	MVI	D,0
  05B1'   21 0000*              	LXI	H,DOTBUF
  05B4'   19                    	DAD	D
  05B5'   7E                    	MOV	A,M
  05B6'   B7                    	ORA	A		; CY clear: a key was returned
  05B7'   C9                    	RET
  05B8'                         DOTGEF:
  05B8'   37                    	STC
  05B9'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
  05BA'                         GOSET:
  05BA'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  05BD'                         SETGL:
  05BD'   CD 1254'              	CALL	ZSAVE
  05C0'   21 0000               	LXI	H,0
  05C3'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  05C6'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  05C7'   CD 1267'              	CALL	ZREST
  05CA'   E1                    	POP	H
  05CB'   E5                    	PUSH	H
  05CC'   CD 06C4'              	CALL	GBSUB		; HL = bytes to the cursor
  05CF'   44                    	MOV	B,H
  05D0'   4D                    	MOV	C,L
  05D1'   E1                    	POP	H		; HL = the line's start
  05D2'   11 0000               	LXI	D,0		; DE = screen column
  05D5'                         SG_LP:
  05D5'   78                    	MOV	A,B
  05D6'   B1                    	ORA	C
  05D7'   CA 05EC'              	JZ	SG_CUR
  05DA'   7E                    	MOV	A,M
  05DB'   23                    	INX	H
  05DC'   0B                    	DCX	B
  05DD'   E5                    	PUSH	H
  05DE'   6B                    	MOV	L,E
  05DF'   CD 0611'              	CALL	CWID
  05E2'   E1                    	POP	H
  05E3'   83                    	ADD	E
  05E4'   5F                    	MOV	E,A
  05E5'   D2 05D5'              	JNC	SG_LP
  05E8'   14                    	INR	D
  05E9'   C3 05D5'              	JMP	SG_LP
  05EC'                         SG_CUR:
  05EC'   2A 0000*              	LHLD	TXTEND
  05EF'   D5                    	PUSH	D
  05F0'   EB                    	XCHG
  05F1'   2A 0000*              	LHLD	GAPEND
  05F4'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  05F7'   D1                    	POP	D
  05F8'   CA 060C'              	JZ	SG_SET
  05FB'   7E                    	MOV	A,M
  05FC'   FE 09                 	CPI	TAB
  05FE'   C2 060C'              	JNZ	SG_SET
  0601'   6B                    	MOV	L,E
  0602'   CD 0611'              	CALL	CWID
  0605'   3D                    	DCR	A		; the TAB's last column
  0606'   83                    	ADD	E
  0607'   5F                    	MOV	E,A
  0608'   D2 060C'              	JNC	SG_SET
  060B'   14                    	INR	D
  060C'                         SG_SET:
  060C'   EB                    	XCHG
  060D'   22 2D85'              	SHLD	GOALCOL
  0610'   C9                    	RET
                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  0611'                         CWID:
  0611'   FE 0D                 	CPI	CR
  0613'   CA 0622'              	JZ	CW_0
  0616'   FE 09                 	CPI	TAB
  0618'   3E 01                 	MVI	A,1
  061A'   C0                    	RNZ
  061B'   7D                    	MOV	A,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  061C'   E6 07                 	ANI	TABWID-1
  061E'   2F                    	CMA
  061F'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  0621'   C9                    	RET
  0622'                         CW_0:
  0622'   AF                    	XRA	A
  0623'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
  0624'                         BOL:
  0624'                         BOL_LP:
  0624'   7C                    	MOV	A,H
  0625'   B5                    	ORA	L
  0626'   C8                    	RZ			; at 0
  0627'   2B                    	DCX	H		; look at off-1
  0628'   E5                    	PUSH	H
  0629'   CD 0000*              	CALL	CHARAT
  062C'   E1                    	POP	H		; HL = off-1
  062D'   FE 0A                 	CPI	LF
  062F'   CA 0635'              	JZ	BOL_DN
  0632'   C3 0624'              	JMP	BOL_LP
  0635'                         BOL_DN:
  0635'   23                    	INX	H		; line starts just after the LF
  0636'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
  0637'                         EOLNL:
  0637'   E5                    	PUSH	H
  0638'   CD 0000*              	CALL	LOGLEN
  063B'   22 2DD0'              	SHLD	WKN
  063E'   E1                    	POP	H
  063F'                         ENL_LP:
  063F'   EB                    	XCHG			; DE = i
  0640'   2A 2DD0'              	LHLD	WKN
  0643'   CD 0000*              	CALL	CMP16		; DE=i vs HL=n: CY iff i < n
  0646'   EB                    	XCHG			; HL = i, DE = n
  0647'   D0                    	RNC			; i >= n: no LF on this line
  0648'   E5                    	PUSH	H
  0649'   CD 0000*              	CALL	CHARAT
  064C'   E1                    	POP	H
  064D'   FE 0A                 	CPI	LF
  064F'   C8                    	RZ			; the LF: HL is its offset
  0650'   23                    	INX	H
  0651'   C3 063F'              	JMP	ENL_LP
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  0654'                         NLSTART:
  0654'   CD 0637'              	CALL	EOLNL
  0657'   E5                    	PUSH	H
  0658'   CD 0000*              	CALL	LOGLEN
  065B'   D1                    	POP	D		; DE = eol result
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  065C'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  065F'   C8                    	RZ			; no next line: HL = LOGLEN
  0660'   EB                    	XCHG			; HL = eol
  0661'   23                    	INX	H
  0662'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  0663'                         EOLC:
  0663'   E5                    	PUSH	H
  0664'   CD 0637'              	CALL	EOLNL
  0667'   22 2DD2'              	SHLD	WKTERM
  066A'   E1                    	POP	H
  066B'   CD 0624'              	CALL	BOL
  066E'   22 2DD4'              	SHLD	WKBOL
  0671'   2A 2DD2'              	LHLD	WKTERM
  0674'   EB                    	XCHG			; DE = term
  0675'   2A 2DD4'              	LHLD	WKBOL
  0678'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  067B'   CA 069A'              	JZ	EOLC_MT
  067E'   EB                    	XCHG			; HL = term
  067F'   2B                    	DCX	H		; term-1
  0680'   E5                    	PUSH	H
  0681'   CD 0000*              	CALL	CHARAT
  0684'   E1                    	POP	H		; HL = term-1
  0685'   FE 0D                 	CPI	CR
  0687'   CA 068D'              	JZ	EOLC_CR		; content ends at term-1
  068A'   C3 068E'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  068D'                         EOLC_CR:
  068D'   2B                    	DCX	H		; last = (term-1) - 1
  068E'                         EOLC_LS:
  068E'   EB                    	XCHG			; DE = last
  068F'   2A 2DD4'              	LHLD	WKBOL
  0692'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  0695'   DA 069A'              	JC	EOLC_MT
  0698'   EB                    	XCHG			; HL = last
  0699'   C9                    	RET
  069A'                         EOLC_MT:
  069A'   2A 2DD4'              	LHLD	WKBOL
  069D'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  069E'                         COL:
  069E'   E5                    	PUSH	H
  069F'   CD 0624'              	CALL	BOL
  06A2'   D1                    	POP	D		; DE = off
  06A3'   EB                    	XCHG			; HL = off, DE = bol
  06A4'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  06A7'                         ATENDQ:
  06A7'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06AA'   E5                    	PUSH	H
  06AB'   CD 0000*              	CALL	LOGLEN
  06AE'   D1                    	POP	D		; DE = cur
  06AF'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  06B2'                         CURCHR:
  06B2'   CD 0000*              	CALL	CUROFF
  06B5'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  06B8'                         MOVCNT:
  06B8'   CD 07A0'              	CALL	SETMOV
  06BB'   C3 06CB'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  06BE'                         CNTOFF:
  06BE'   CD 06CB'              	CALL	GETCNT
  06C1'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  06C4'                         GBSUB:
  06C4'   EB                    	XCHG
  06C5'   2A 0000*              	LHLD	GAPBEG
  06C8'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  06CB'                         GETCNT:
  06CB'   2A 2D7B'              	LHLD	CMDCNT
  06CE'   7C                    	MOV	A,H
  06CF'   B5                    	ORA	L
  06D0'   C2 06D7'              	JNZ	GC_HAVE
  06D3'   21 0001               	LXI	H,1
  06D6'   C9                    	RET
  06D7'                         GC_HAVE:
  06D7'   E5                    	PUSH	H
  06D8'   21 0000               	LXI	H,0
  06DB'   22 2D7B'              	SHLD	CMDCNT
  06DE'   E1                    	POP	H
  06DF'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for an ESC break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  06E0'                         CNTTST:				; WM 1175
  06E0'   3A 2E3B'              	LDA	BRKARM
  06E3'   B7                    	ORA	A
  06E4'   C4 070E'              	CNZ	BRKTST		; an ESC spends the count: every loop stops here
  06E7'   E5                    	PUSH	H
  06E8'   2A 2D7B'              	LHLD	CMDCNT
  06EB'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  06EE'   B4                    	ORA	H
  06EF'   B5                    	ORA	L
  06F0'   E1                    	POP	H
  06F1'   C3 0000*              	JMP	POLLBRK
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


                                ; ESC -- abandon a search or a long move.
                                ;
                                ; Every loop that pages asks CNTTST whether to go on, so that is where an ESC is
                                ; looked for: it zeroes the count, and the loop ends the way it ends when the
                                ; count runs out.  Nothing is half done, because the commands that can be
                                ; stopped change nothing -- BRKON arms the test only with no operator pending,
                                ; and only 'G' 'gg' the mark jumps and the searches call it.  A 'dd' count, a
                                ; ':s', a put or a write asks the same CNTTST and is never stopped.
                                ;
                                ; The command then goes back to where it started (BRKBAK), as a search that
                                ; found nothing does: the screen was not repainted, so it is already right.
                                ; Going back pages, and that is not stopped by a second ESC.
                                ;============================================================
                                
                                ;BRKON -- a command that may page a long way is starting: keep the place it
                                ; started from (the cursor's position in the file, and LNDLT for its row), and
                                ; arm the ESC test unless an operator is waiting for this motion.
  06F4'                         BRKON:
  06F4'   21 2E36'              	LXI	H,SOFF
  06F7'   CD 0429'              	CALL	FPSTO
  06FA'   2A 0000*              	LHLD	LNDLT
  06FD'   22 2E39'              	SHLD	SLDLT
  0700'   AF                    	XRA	A
  0701'   32 2E3C'              	STA	BRKHIT
  0704'   3A 2DB2'              	LDA	PSAVE
  0707'   B7                    	ORA	A
  0708'   C0                    	RNZ			; 'dG' changes text: it runs to its end
  0709'   3C                    	INR	A
  070A'   32 2E3B'              	STA	BRKARM
  070D'   C9                    	RET
                                
                                ;BRKTST -- CNTTST's question while armed.  Keeps BC, DE, HL.  The ESC is
                                ; answered on the bottom row at once: the way back pages, and that can take
                                ; as long again as the command had run, with nothing else to show for it.
                                ; BRKBAK's 'Interrupted' replaces it when the cursor is back.
  070E'                         BRKTST:
  070E'   C5                    	PUSH	B
  070F'   D5                    	PUSH	D
  0710'   E5                    	PUSH	H
  0711'   CD 0000*              	CALL	KBBRK
  0714'   CA 072D'              	JZ	BT_NO
  0717'   32 2E3C'              	STA	BRKHIT		; (A = FFH)
  071A'   21 26E1'              	LXI	H,SINTG
  071D'   CD 0000*              	CALL	EXMSG
  0720'   AF                    	XRA	A
  0721'   32 2E3B'              	STA	BRKARM		; the way back is not stopped in its turn
  0724'   32 0000*              	STA	AUXCNT
  0727'   21 0000               	LXI	H,0
  072A'   22 2D7B'              	SHLD	CMDCNT
  072D'                         BT_NO:
  072D'   E1                    	POP	H
  072E'   D1                    	POP	D
  072F'   C1                    	POP	B
  0730'   C9                    	RET
                                
                                ;BRKOFF -- the move is over: disarm.  NOTE: falls into BRKQ.
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0731'                         BRKOFF:
  0731'   AF                    	XRA	A
  0732'   32 2E3B'              	STA	BRKARM
                                ;BRKQ -- CY iff an ESC stopped it.
  0735'                         BRKQ:
  0735'   3A 2E3C'              	LDA	BRKHIT
  0738'   B7                    	ORA	A
  0739'   C8                    	RZ
  073A'   37                    	STC
  073B'   C9                    	RET
                                
                                ;RSTPL -- back to the place BRKON kept, on the row it was on.
  073C'                         RSTPL:
  073C'   21 2E36'              	LXI	H,SOFF
  073F'   CD 03D0'              	CALL	BACKTO
  0742'   2A 2E39'              	LHLD	SLDLT
  0745'   22 0000*              	SHLD	LNDLT
  0748'   C9                    	RET
                                
                                ;BRKBAK -- stopped: back to the start, drop whatever was typed meanwhile (it
                                ; was meant for a result that is not coming), and say so.  CY, as EXERR.
  0749'                         BRKBAK:
  0749'   CD 073C'              	CALL	RSTPL
  074C'   CD 0000*              	CALL	KBFLSH
  074F'   21 26D5'              	LXI	H,SINTR
  0752'   C3 2637'              	JMP	EXERR
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  0755'                         CLASSF:
  0755'   47                    	MOV	B,A
  0756'   FE 20                 	CPI	' '
  0758'   CA 0798'              	JZ	CLS0
  075B'   FE 09                 	CPI	TAB
  075D'   CA 0798'              	JZ	CLS0
  0760'   FE 0A                 	CPI	LF
  0762'   CA 0798'              	JZ	CLS0
  0765'   FE 0D                 	CPI	CR
  0767'   CA 0798'              	JZ	CLS0
  076A'   3A 2D87'              	LDA	WBIG
  076D'   B7                    	ORA	A
  076E'   C2 079A'              	JNZ	CLS1
  0771'   78                    	MOV	A,B
  0772'   FE 5F                 	CPI	'_'
  0774'   CA 079A'              	JZ	CLS1
  0777'   FE 30                 	CPI	'0'
  0779'   DA 079D'              	JC	CLS2
  077C'   FE 3A                 	CPI	'9'+1
  077E'   DA 079A'              	JC	CLS1
  0781'   FE 41                 	CPI	'A'
  0783'   DA 079D'              	JC	CLS2
  0786'   FE 5B                 	CPI	'Z'+1
  0788'   DA 079A'              	JC	CLS1
  078B'   FE 61                 	CPI	'a'
  078D'   DA 079D'              	JC	CLS2
  0790'   FE 7B                 	CPI	'z'+1
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  0792'   DA 079A'              	JC	CLS1
  0795'   C3 079D'              	JMP	CLS2
  0798'   AF                    CLS0:	XRA	A
  0799'   C9                    	RET
  079A'   3E 01                 CLS1:	MVI	A,1
  079C'   C9                    	RET
  079D'   3E 02                 CLS2:	MVI	A,2
  079F'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  07A0'                         SETMOV:
  07A0'   3E 01                 	MVI	A,R_MOVE
  07A2'   32 2D7F'              	STA	RINTENT
  07A5'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  07A6'                         SETLIN:
  07A6'   3E 02                 	MVI	A,R_LINE
  07A8'   32 2D7F'              	STA	RINTENT
  07AB'   C9                    	RET
                                
                                ;SETCEL -- one cell of the cursor's row was written over and nothing else
                                ; changed: the char alone is the paint (R_ICH with no cell opened), provided
                                ; the char that was there (A) and the one that is (VRCH) are each one cell
                                ; wide.  B = ICHAPP's value: 1 the cursor went past the char, 2 it is on it.
  07AC'                         SETCEL:
  07AC'   CD 07C1'              	CALL	PLAINQ
  07AF'   D0                    	RNC
  07B0'   3A 2DD7'              	LDA	VRCH
  07B3'   CD 07C1'              	CALL	PLAINQ
  07B6'   D0                    	RNC
  07B7'   78                    	MOV	A,B
  07B8'   32 2D81'              	STA	ICHAPP
  07BB'   3E 04                 	MVI	A,R_ICH
  07BD'   32 2D7F'              	STA	RINTENT
  07C0'   C9                    	RET
                                
                                ;PLAINQ -- CY iff the char in A takes one cell: printable ASCII.  Keeps all
                                ; but the flags.
  07C1'                         PLAINQ:
  07C1'   FE 20                 	CPI	' '
  07C3'   3F                    	CMC
  07C4'   D0                    	RNC
  07C5'   FE 7F                 	CPI	DEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07C7'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  07C8'                         SETILN:
  07C8'   3E 01                 	MVI	A,1
  07CA'   32 2D80'              	STA	ILN		; one line, unless a put overwrites it below
  07CD'   3E 05                 	MVI	A,R_ILIN
  07CF'   32 2D7F'              	STA	RINTENT
  07D2'   AF                    	XRA	A
  07D3'   32 2D84'              	STA	ILABOV		; the row above the opened ones is untouched
  07D6'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  07D7'                         SETJON:
  07D7'   3E 06                 	MVI	A,R_JOIN
  07D9'   32 2D7F'              	STA	RINTENT
  07DC'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  07DD'                         SETFUL:
  07DD'   3E 00                 	MVI	A,R_FULL
  07DF'   32 2D7F'              	STA	RINTENT
  07E2'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB (or any control char) occurs from the cursor to the
                                ; end of its line, else 0.
                                ; Scans forward from the cursor via CHARAT until LF or end of text (no gap move).
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  07E3'                         TAILTAB:
  07E3'   CD 0000*              	CALL	CUROFF
  07E6'   22 2DCC'              	SHLD	TTI
  07E9'                         TT_LP:
  07E9'   2A 2DCC'              	LHLD	TTI
  07EC'   EB                    	XCHG			; DE = TTI
  07ED'   CD 0000*              	CALL	LOGLEN		; HL = LOGLEN
  07F0'   CD 0000*              	CALL	CMP16		; CY iff TTI < LOGLEN
  07F3'   D2 0818'              	JNC	TT_NO		; reached end of text -> no tab
  07F6'   2A 2DCC'              	LHLD	TTI
  07F9'   CD 0000*              	CALL	CHARAT
  07FC'   FE 0A                 	CPI	LF
  07FE'   CA 0818'              	JZ	TT_NO		; end of line -> no tab
  0801'   FE 0D                 	CPI	CR
  0803'   CA 080B'              	JZ	TT_NX		; (the line end's own)
  0806'   FE 20                 	CPI	' '
  0808'   DA 0815'              	JC	TT_YES
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  080B'                         TT_NX:
  080B'   2A 2DCC'              	LHLD	TTI
  080E'   23                    	INX	H
  080F'   22 2DCC'              	SHLD	TTI
  0812'   C3 07E9'              	JMP	TT_LP
  0815'                         TT_YES:
  0815'   3E 01                 	MVI	A,1
  0817'   C9                    	RET
  0818'                         TT_NO:
  0818'   AF                    	XRA	A
  0819'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  081A'                         VC_H:
  081A'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  081D'   22 2DCA'              	SHLD	CNTV
  0820'                         VCH_LP:
  0820'   2A 2DCA'              	LHLD	CNTV
  0823'   7C                    	MOV	A,H
  0824'   B5                    	ORA	L
  0825'   C8                    	RZ
  0826'   2B                    	DCX	H
  0827'   22 2DCA'              	SHLD	CNTV
  082A'   CD 0830'              	CALL	HSTEP
  082D'   C3 0820'              	JMP	VCH_LP
  0830'                         HSTEP:
  0830'   CD 0000*              	CALL	CUROFF		; HL = cur
  0833'   7C                    	MOV	A,H
  0834'   B5                    	ORA	L
  0835'   C8                    	RZ			; at 0
  0836'   E5                    	PUSH	H
  0837'   CD 0624'              	CALL	BOL		; HL = bol
  083A'   D1                    	POP	D		; DE = cur
  083B'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  083E'   C8                    	RZ			; at BOL, cannot go left
  083F'   EB                    	XCHG			; HL = cur
  0840'   2B                    	DCX	H
  0841'   C3 05BA'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  0844'                         VC_L:
  0844'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0847'   22 2DCA'              	SHLD	CNTV
  084A'                         VCL_LP:
  084A'   2A 2DCA'              	LHLD	CNTV
  084D'   7C                    	MOV	A,H
  084E'   B5                    	ORA	L
  084F'   C8                    	RZ
  0850'   2B                    	DCX	H
  0851'   22 2DCA'              	SHLD	CNTV
  0854'   CD 085A'              	CALL	LSTEP
  0857'   C3 084A'              	JMP	VCL_LP
  085A'                         LSTEP:
  085A'   CD 0000*              	CALL	CUROFF		; HL = cur
  085D'   E5                    	PUSH	H
  085E'   CD 0663'              	CALL	EOLC		; HL = eolc
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  0861'   D1                    	POP	D		; DE = cur
  0862'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  0865'   D2 086D'              	JNC	LS_NO		; cur >= eolc, cannot go right
  0868'   EB                    	XCHG			; HL = cur
  0869'   23                    	INX	H
  086A'   C3 05BA'              	JMP	GOSET
  086D'                         LS_NO:				; on the line's last char.  An operator waiting on
  086D'   CD 0C39'              	CALL	EMPTY		;   this 'l' takes that char too (vim makes the
  0870'   C8                    	RZ			;   motion inclusive when it falls short), which
  0871'   3E 01                 	MVI	A,1		;   is what WPULL tells OPA_EX: 'dl' there is 'x',
  0873'   32 2D88'              	STA	WPULL		;   and 'd3l' two from the end takes both.  An
  0876'   C9                    	RET			;   empty line has no char to take
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  0877'                         VC_0:
  0877'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  087A'   CD 0884'              	CALL	LNSTRT
  087D'   21 0000               	LXI	H,0
  0880'   22 2D85'              	SHLD	GOALCOL
  0883'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  0884'                         LNSTRT:
  0884'   CD 1254'              	CALL	ZSAVE
  0887'   21 0000               	LXI	H,0
  088A'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  088D'   E5                    	PUSH	H
  088E'   CD 1267'              	CALL	ZREST
  0891'   E1                    	POP	H
  0892'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  0895'                         VC_CRT:
  0895'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0898'   C3 089B'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  089B'                         FNBLNK:
  089B'   CD 0884'              	CALL	LNSTRT
  089E'   CD 0000*              	CALL	RGET0
  08A1'   11 0000               	LXI	D,0		; DE = blanks skipped
  08A4'                         FN_LP:
  08A4'   CD 0000*              	CALL	RDGET
  08A7'   DA 08CA'              	JC	FN_GO		; the end of the file
  08AA'   FE 20                 	CPI	' '
  08AC'   CA 08B4'              	JZ	FN_WH
  08AF'   FE 09                 	CPI	TAB
  08B1'   C2 08CA'              	JNZ	FN_GO		; a non-blank, or the line's end
  08B4'                         FN_WH:
  08B4'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  08B7'   DA 08CA'              	JC	FN_GO
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  08BA'   FE 0D                 	CPI	CR
  08BC'   CA 08CA'              	JZ	FN_GO
  08BF'   FE 0A                 	CPI	LF
  08C1'   CA 08CA'              	JZ	FN_GO
  08C4'   2B                    	DCX	H		; not yet: read that char again
  08C5'   03                    	INX	B
  08C6'   13                    	INX	D
  08C7'   C3 08A4'              	JMP	FN_LP
  08CA'                         FN_GO:
  08CA'   D5                    	PUSH	D
  08CB'   CD 0000*              	CALL	CUROFF
  08CE'   D1                    	POP	D
  08CF'   19                    	DAD	D
  08D0'   C3 05BA'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  08D3'                         VC_EOL:
  08D3'   CD 07A0'              	CALL	SETMOV
  08D6'   21 FFFF               	LXI	H,0FFFFH
  08D9'   22 2D85'              	SHLD	GOALCOL
  08DC'   CD 06CB'              	CALL	GETCNT
  08DF'   2B                    	DCX	H		; count-1
  08E0'   7C                    	MOV	A,H
  08E1'   B5                    	ORA	L
  08E2'   CA 08F1'              	JZ	VEOL_0
  08E5'   E5                    	PUSH	H
  08E6'   CD 0906'              	CALL	ONLAST
  08E9'   E1                    	POP	H
  08EA'   D8                    	RC			; the last line: no move (vim)
  08EB'   CD 0956'              	CALL	JCORE
  08EE'   C3 0AA5'              	JMP	JKLAND
  08F1'                         VEOL_0:
  08F1'   CD 0884'              	CALL	LNSTRT
  08F4'   C3 0AA5'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  08F7'                         VC_CR:
  08F7'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  08FA'   E5                    	PUSH	H
  08FB'   CD 0906'              	CALL	ONLAST
  08FE'   E1                    	POP	H
  08FF'   D8                    	RC
  0900'   CD 0956'              	CALL	JCORE
  0903'   C3 089B'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  0906'                         ONLAST:
  0906'   CD 0000*              	CALL	RGET0
  0909'                         OL_LP:
  0909'   CD 0000*              	CALL	RDGET
  090C'   D8                    	RC			; the file ends on this line
  090D'   FE 0A                 	CPI	LF
  090F'   C2 0909'              	JNZ	OL_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0912'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  0915'                         VC_J:
  0915'   CD 07A0'              	CALL	SETMOV
  0918'   CD 0940'              	CALL	GLCHK		; the goal column, from the cursor if stale
  091B'   CD 06CB'              	CALL	GETCNT		; HL = count
  091E'   CD 0956'              	CALL	JCORE
  0921'   CD 0939'              	CALL	JKDRP
  0924'   C3 0AA5'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  0927'                         VC_K:
  0927'   CD 07A0'              	CALL	SETMOV
  092A'   CD 0940'              	CALL	GLCHK
  092D'   CD 06CB'              	CALL	GETCNT
  0930'   CD 09F3'              	CALL	KCORE
  0933'   CD 0939'              	CALL	JKDRP
  0936'   C3 0AA5'              	JMP	JKLAND
                                
                                ;JKDRP -- DE = the lines JCORE / KCORE moved.  None -- 'j' on the last line,
                                ; 'k' on the first -- and the motion has failed: an operator waiting on it is
                                ; dropped, as vim drops it, where a line span that starts and ends on one line
                                ; would take that line ('dj' on the last line deleted it).  A count that runs
                                ; out of lines short has still moved, and its operator stands.  It is asked
                                ; here and not in the cores: 'dH' on the top row moves no lines either, and
                                ; takes its line.
  0939'                         JKDRP:
  0939'   7A                    	MOV	A,D
  093A'   B3                    	ORA	E
  093B'   C0                    	RNZ
  093C'   32 2DB2'              	STA	PSAVE
  093F'   C9                    	RET
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  0940'                         GLCHK:
  0940'   2A 2D85'              	LHLD	GOALCOL
  0943'   7C                    	MOV	A,H
  0944'   3C                    	INR	A
  0945'   C0                    	RNZ
  0946'   7D                    	MOV	A,L
  0947'   FE FE                 	CPI	0FEH
  0949'   C0                    	RNZ
  094A'   C3 05BD'              	JMP	SETGL
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  094D'                         GLSTAL:
  094D'   E5                    	PUSH	H
  094E'   21 FFFE               	LXI	H,0FFFEH
  0951'   22 2D85'              	SHLD	GOALCOL
  0954'   E1                    	POP	H
  0955'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  0956'                         JCORE:
  0956'   7C                    	MOV	A,H
  0957'   B5                    	ORA	L
  0958'   C8                    	RZ
  0959'   22 2D96'              	SHLD	JKCNT
  095C'   CD 0D68'              	CALL	CURRW		; limit = lines under the cursor's + NEDIT + 2:
  095F'   47                    	MOV	B,A		;   enough for LYFAR to know it for far off
  0960'   3A 0000*              	LDA	NEDIT
  0963'   3C                    	INR	A
  0964'   90                    	SUB	B
  0965'   5F                    	MOV	E,A
  0966'   16 00                 	MVI	D,0
  0968'   3A 0000*              	LDA	NEDIT
  096B'   6F                    	MOV	L,A
  096C'   26 00                 	MVI	H,0
  096E'   19                    	DAD	D
  096F'   EB                    	XCHG			; DE = limit
  0970'   2A 2D96'              	LHLD	JKCNT
  0973'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0976'   D2 097A'              	JNC	JC_N
  0979'   EB                    	XCHG			; HL = limit
  097A'                         JC_N:
  097A'   22 2D98'              	SHLD	JKN		; N = min(count, limit)
  097D'   EB                    	XCHG			; DE = LFs to find
  097E'   CD 0000*              	CALL	RGET0
  0981'                         JC_SC:
  0981'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0984'   DA 09A3'              	JC	JC_EOF
  0987'   32 2D9F'              	STA	JKLST
  098A'   FE 0A                 	CPI	LF
  098C'   C2 0981'              	JNZ	JC_SC
  098F'   1B                    	DCX	D
  0990'   7A                    	MOV	A,D
  0991'   B3                    	ORA	E
  0992'   C2 0981'              	JNZ	JC_SC
  0995'   2A 2D96'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  0998'   22 2D9A'              	SHLD	JKMOV		;   one if the last LF found ends the file
  099B'   3E 01                 	MVI	A,1
  099D'   32 2D9E'              	STA	JKPHN
  09A0'   C3 09BE'              	JMP	JC_MV
  09A3'                         JC_EOF:
  09A3'   2A 2D98'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  09A6'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  09A9'   7C                    	MOV	A,H
  09AA'   B5                    	ORA	L
  09AB'   CA 09B7'              	JZ	JC_AV
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  09AE'   3A 2D9F'              	LDA	JKLST
  09B1'   FE 0A                 	CPI	LF
  09B3'   C2 09B7'              	JNZ	JC_AV
  09B6'   2B                    	DCX	H
  09B7'                         JC_AV:
  09B7'   22 2D9A'              	SHLD	JKMOV
  09BA'   AF                    	XRA	A
  09BB'   32 2D9E'              	STA	JKPHN
  09BE'                         JC_MV:
  09BE'   2A 2D96'              	LHLD	JKCNT
  09C1'   AF                    	XRA	A
  09C2'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  09C5'   CD 0A84'              	CALL	ATEOF
  09C8'   D2 09DC'              	JNC	JC_DN
  09CB'   CD 0A8A'              	CALL	LASTLN		; ran past the last line: back onto it
  09CE'   3A 2D9E'              	LDA	JKPHN
  09D1'   B7                    	ORA	A
  09D2'   CA 09DC'              	JZ	JC_DN
  09D5'   2A 2D9A'              	LHLD	JKMOV
  09D8'   2B                    	DCX	H
  09D9'   22 2D9A'              	SHLD	JKMOV
  09DC'                         JC_DN:
  09DC'   2A 2D98'              	LHLD	JKN		; LNDLT += min(moved, N)
  09DF'   EB                    	XCHG
  09E0'   2A 2D9A'              	LHLD	JKMOV
  09E3'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  09E6'   D2 09EA'              	JNC	JC_AD
  09E9'   EB                    	XCHG
  09EA'                         JC_AD:
  09EA'   EB                    	XCHG			; DE = lines moved
  09EB'   2A 0000*              	LHLD	LNDLT
  09EE'   19                    	DAD	D
  09EF'   22 0000*              	SHLD	LNDLT
  09F2'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  09F3'                         KCORE:
  09F3'   7C                    	MOV	A,H
  09F4'   B5                    	ORA	L
  09F5'   C8                    	RZ
  09F6'   22 2D96'              	SHLD	JKCNT
  09F9'   CD 0D68'              	CALL	CURRW		; limit = row + NEDIT
  09FC'   5F                    	MOV	E,A
  09FD'   16 00                 	MVI	D,0
  09FF'   3A 0000*              	LDA	NEDIT
  0A02'   6F                    	MOV	L,A
  0A03'   26 00                 	MVI	H,0
  0A05'   19                    	DAD	D
  0A06'   EB                    	XCHG			; DE = limit
  0A07'   2A 2D96'              	LHLD	JKCNT
  0A0A'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0A0D'   D2 0A11'              	JNC	KC_N
  0A10'   EB                    	XCHG			; HL = limit
  0A11'                         KC_N:
  0A11'   22 2D98'              	SHLD	JKN		; N = min(count, limit)
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0A14'   EB                    	XCHG			; DE = LFs to find
  0A15'   21 0000               	LXI	H,0
  0A18'   22 2D9C'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  0A1B'                         KC_ED:
  0A1B'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0A1C'   2A 2D9C'              	LHLD	JKBK
  0A1F'   CD 06C4'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0A22'   E5                    	PUSH	H
  0A23'   EB                    	XCHG
  0A24'   2A 0000*              	LHLD	TXTBEG
  0A27'   EB                    	XCHG
  0A28'   CD 0000*              	CALL	SUBHD
  0A2B'   44                    	MOV	B,H
  0A2C'   4D                    	MOV	C,L
  0A2D'   E1                    	POP	H
  0A2E'   D1                    	POP	D
  0A2F'                         KC_SC:
  0A2F'   78                    	MOV	A,B
  0A30'   B1                    	ORA	C
  0A31'   CA 0A48'              	JZ	KC_TB
  0A34'   2B                    	DCX	H
  0A35'   0B                    	DCX	B
  0A36'   7E                    	MOV	A,M
  0A37'   FE 0A                 	CPI	LF
  0A39'   C2 0A2F'              	JNZ	KC_SC
  0A3C'   1B                    	DCX	D
  0A3D'   7A                    	MOV	A,D
  0A3E'   B3                    	ORA	E
  0A3F'   C2 0A2F'              	JNZ	KC_SC
  0A42'   2A 2D96'              	LHLD	JKCNT		; N lines above: the move is count lines
  0A45'   C3 0A68'              	JMP	KC_MV
  0A48'                         KC_TB:
  0A48'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0A49'   CD 06C4'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0A4C'   22 2D9C'              	SHLD	JKBK
  0A4F'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0A52'   7C                    	MOV	A,H
  0A53'   B5                    	ORA	L
  0A54'   CA 0A61'              	JZ	KC_B0
  0A57'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  0A5A'   D1                    	POP	D
  0A5B'   DA 0A62'              	JC	KC_BOF
  0A5E'   C3 0A1B'              	JMP	KC_ED
  0A61'                         KC_B0:
  0A61'   D1                    	POP	D
  0A62'                         KC_BOF:
  0A62'   2A 2D98'              	LHLD	JKN		; moved = LFs found
  0A65'   CD 0000*              	CALL	SUBHD
  0A68'                         KC_MV:
  0A68'   E5                    	PUSH	H
  0A69'   2A 2D96'              	LHLD	JKCNT
  0A6C'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0A6F'   D1                    	POP	D		; DE = moved
  0A70'   2A 2D98'              	LHLD	JKN
  0A73'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0A76'   DA 0A7A'              	JC	KC_AD
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0A79'   EB                    	XCHG			; DE = N
  0A7A'                         KC_AD:
  0A7A'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0A7D'   CD 0000*              	CALL	SUBHD
  0A80'   22 0000*              	SHLD	LNDLT
  0A83'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0A84'                         ATEOF:
  0A84'   CD 0000*              	CALL	RGET0
  0A87'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0A8A'                         LASTLN:
  0A8A'   2A 0000*              	LHLD	GAPBEG
  0A8D'   EB                    	XCHG
  0A8E'   2A 0000*              	LHLD	TXTBEG
  0A91'   CD 0000*              	CALL	CMP16
  0A94'   21 0000               	LXI	H,0
  0A97'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0A9A'   1B                    	DCX	D
  0A9B'   1A                    	LDAX	D
  0A9C'   FE 0A                 	CPI	LF
  0A9E'   C2 0000*              	JNZ	SETBWD
  0AA1'   23                    	INX	H
  0AA2'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0AA5'                         JKLAND:
  0AA5'   21 0000               	LXI	H,0
  0AA8'   22 2DA0'              	SHLD	JKVC		; screen column
  0AAB'   2B                    	DCX	H
  0AAC'   22 2DA2'              	SHLD	JKLS		; last content char: none yet
  0AAF'   CD 0000*              	CALL	RGET0
  0AB2'   11 0000               	LXI	D,0		; DE = chars read
  0AB5'                         JL_RD:
  0AB5'   CD 0000*              	CALL	RDGET
  0AB8'   DA 0AF2'              	JC	JL_END
  0ABB'   FE 0A                 	CPI	LF
  0ABD'   CA 0AF2'              	JZ	JL_END
  0AC0'   E5                    	PUSH	H
  0AC1'   C5                    	PUSH	B
  0AC2'   2A 2DA0'              	LHLD	JKVC
  0AC5'   CD 0611'              	CALL	CWID
  0AC8'   B7                    	ORA	A
  0AC9'   CA 0AEC'              	JZ	JL_NX		; a CR
  0ACC'   EB                    	XCHG
  0ACD'   22 2DA2'              	SHLD	JKLS		; the last content char so far
  0AD0'   EB                    	XCHG
  0AD1'   4F                    	MOV	C,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0AD2'   06 00                 	MVI	B,0
  0AD4'   09                    	DAD	B		; HL = the column after this char
  0AD5'   22 2DA0'              	SHLD	JKVC
  0AD8'   D5                    	PUSH	D
  0AD9'   EB                    	XCHG
  0ADA'   2A 2D85'              	LHLD	GOALCOL
  0ADD'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0AE0'   D1                    	POP	D
  0AE1'   DA 0AEC'              	JC	JL_NX
  0AE4'   CA 0AEC'              	JZ	JL_NX
  0AE7'   C1                    	POP	B		; this char holds the goal column
  0AE8'   E1                    	POP	H
  0AE9'   C3 0AFD'              	JMP	JL_GO
  0AEC'                         JL_NX:
  0AEC'   C1                    	POP	B
  0AED'   E1                    	POP	H
  0AEE'   13                    	INX	D
  0AEF'   C3 0AB5'              	JMP	JL_RD
  0AF2'                         JL_END:
  0AF2'   2A 2DA2'              	LHLD	JKLS		; past the line's end: its last content char
  0AF5'   7C                    	MOV	A,H
  0AF6'   A5                    	ANA	L
  0AF7'   3C                    	INR	A
  0AF8'   C2 0AFC'              	JNZ	JL_LS
  0AFB'   23                    	INX	H		; no content: the line's start
  0AFC'                         JL_LS:
  0AFC'   EB                    	XCHG
  0AFD'                         JL_GO:
  0AFD'   D5                    	PUSH	D		; DE = step from the line start
  0AFE'   CD 0000*              	CALL	CUROFF
  0B01'   D1                    	POP	D
  0B02'   19                    	DAD	D
  0B03'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0B06'   AF                    VC_W:	XRA	A
  0B07'   32 2D87'              	STA	WBIG
  0B0A'   C3 0B12'              	JMP	WDO
  0B0D'   3E 01                 VCBGW:	MVI	A,1
  0B0F'   32 2D87'              	STA	WBIG
  0B12'   CD 07A0'              WDO:	CALL	SETMOV
  0B15'   AF                    	XRA	A
  0B16'   32 2D88'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0B19'   CD 06CB'              	CALL	GETCNT
  0B1C'   22 2DCA'              	SHLD	CNTV
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0B1F'   2A 2DCA'              WDO_LP: LHLD	CNTV
  0B22'   7C                    	MOV	A,H
  0B23'   B5                    	ORA	L
  0B24'   CA 0B31'              	JZ	WDO_DN
  0B27'   2B                    	DCX	H
  0B28'   22 2DCA'              	SHLD	CNTV
  0B2B'   CD 0B8E'              	CALL	FWD1
  0B2E'   D2 0B1F'              	JNC	WDO_LP
  0B31'                         WDO_DN:
  0B31'   CD 0A84'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0B34'   DA 0B41'              	JC	WDO_NL
  0B37'   FE 0D                 	CPI	CR
  0B39'   CA 0B41'              	JZ	WDO_NL
  0B3C'   FE 0A                 	CPI	LF
  0B3E'   C2 05BD'              	JNZ	SETGL
  0B41'                         WDO_NL:
  0B41'   CD 0000*              	CALL	PEEKL
  0B44'   DA 05BD'              	JC	SETGL
  0B47'   FE 0A                 	CPI	LF
  0B49'   CA 05BD'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0B4C'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0B4E'   32 2D88'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0B51'   CD 0CAD'              	CALL	DECC		; back onto its last char
  0B54'   C3 05BD'              	JMP	SETGL
                                
  0B57'   AF                    VC_B:	XRA	A
  0B58'   32 2D87'              	STA	WBIG
  0B5B'   C3 0B63'              	JMP	BDO
  0B5E'   3E 01                 VCBGB:	MVI	A,1
  0B60'   32 2D87'              	STA	WBIG
  0B63'   CD 07A0'              BDO:	CALL	SETMOV
  0B66'   CD 06CB'              	CALL	GETCNT
  0B69'   22 2DCA'              	SHLD	CNTV
  0B6C'   CD 0BFE'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0B6F'   D2 0B7F'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0B72'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0B73'   32 2DB2'              	STA	PSAVE		;   first char opened an insert).  A count that
  0B76'   C3 05BD'              	JMP	SETGL		;   runs out at the start has still moved, and
  0B79'                         BDO_LP:				;   its operator stands -- both as vim
  0B79'   CD 0BFE'              	CALL	BCK1
  0B7C'   DA 05BD'              	JC	SETGL
  0B7F'   2A 2DCA'              BDO_NX: LHLD	CNTV
  0B82'   2B                    	DCX	H
  0B83'   22 2DCA'              	SHLD	CNTV
  0B86'   7C                    	MOV	A,H
  0B87'   B5                    	ORA	L
  0B88'   C2 0B79'              	JNZ	BDO_LP
  0B8B'   C3 05BD'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


                                ; words before the last run on freely -- 'd2w' there takes the line break and
                                ; the next line's first word as well.
  0B8E'                         FWD1:
  0B8E'   CD 0C31'              	CALL	CCLS
  0B91'   32 2DD6'              	STA	WKCLS		; the starting class
  0B94'   CD 0C6B'              	CALL	INCC
  0B97'   B7                    	ORA	A
  0B98'   CA 0BB1'              	JZ	FW_WD
  0B9B'   37                    	STC
  0B9C'   F8                    	RM			; -1: already at the end
  0B9D'   CD 0BE9'              	CALL	WLAST
  0BA0'   C8                    	RZ
  0BA1'   FE 02                 	CPI	2
  0BA3'   C2 0BB1'              	JNZ	FW_WD		; 1: a next line was reached
  0BA6'   CD 0A84'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0BA9'   D4 0C52'              	CNC	NXLN
  0BAC'   D2 0BB1'              	JNC	FW_WD
  0BAF'   37                    	STC			; yes: failed
  0BB0'   C9                    	RET
  0BB1'                         FW_WD:
  0BB1'   3A 2DD6'              	LDA	WKCLS		; go past the rest of this word
  0BB4'   B7                    	ORA	A
  0BB5'   CA 0BD1'              	JZ	FW_WS
  0BB8'                         FW_WLP:
  0BB8'   CD 0C31'              	CALL	CCLS
  0BBB'   21 2DD6'              	LXI	H,WKCLS
  0BBE'   BE                    	CMP	M
  0BBF'   C2 0BD1'              	JNZ	FW_WS
  0BC2'   CD 0C6B'              	CALL	INCC
  0BC5'   B7                    	ORA	A
  0BC6'   F8                    	RM			; the end of the file (NC)
  0BC7'   CA 0BB8'              	JZ	FW_WLP
  0BCA'   CD 0BE9'              	CALL	WLAST
  0BCD'   C8                    	RZ
  0BCE'   C3 0BB8'              	JMP	FW_WLP
  0BD1'                         FW_WS:
  0BD1'   CD 0C31'              	CALL	CCLS		; then over blanks to the next word
  0BD4'   B7                    	ORA	A
  0BD5'   C0                    	RNZ
  0BD6'   CD 0C39'              	CALL	EMPTY
  0BD9'   C8                    	RZ			; an empty line is a word
  0BDA'   CD 0C6B'              	CALL	INCC
  0BDD'   B7                    	ORA	A
  0BDE'   F8                    	RM
  0BDF'   CA 0BD1'              	JZ	FW_WS
  0BE2'   CD 0BE9'              	CALL	WLAST
  0BE5'   C8                    	RZ
  0BE6'   C3 0BD1'              	JMP	FW_WS
                                
                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0BE9'                         WLAST:
  0BE9'   47                    	MOV	B,A
  0BEA'   2A 2DCA'              	LHLD	CNTV
  0BED'   7C                    	MOV	A,H
  0BEE'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0BEF'   C2 0BFA'              	JNZ	WL_X		; words still owed
  0BF2'   3A 2DB2'              	LDA	PSAVE
  0BF5'   B7                    	ORA	A
  0BF6'   CA 0BFC'              	JZ	WL_NO		; a plain 'w'
  0BF9'   AF                    	XRA	A
  0BFA'   78                    WL_X:	MOV	A,B
  0BFB'   C9                    	RET
  0BFC'   B0                    WL_NO:	ORA	B
  0BFD'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0BFE'                         BCK1:
  0BFE'   CD 0CAD'              	CALL	DECC
  0C01'   B7                    	ORA	A
  0C02'   37                    	STC
  0C03'   F8                    	RM
  0C04'                         BK_WS:
  0C04'   CD 0C31'              	CALL	CCLS		; back over blanks
  0C07'   B7                    	ORA	A
  0C08'   C2 0C18'              	JNZ	BK_WD
  0C0B'   CD 0C39'              	CALL	EMPTY
  0C0E'   C8                    	RZ			; an empty line is a word
  0C0F'   CD 0CAD'              	CALL	DECC
  0C12'   B7                    	ORA	A
  0C13'   F2 0C04'              	JP	BK_WS
  0C16'   AF                    	XRA	A		; the start of the file (NC)
  0C17'   C9                    	RET
  0C18'                         BK_WD:
  0C18'   32 2DD6'              	STA	WKCLS		; back to the start of this word
  0C1B'                         BK_WLP:
  0C1B'   CD 0CAD'              	CALL	DECC
  0C1E'   B7                    	ORA	A
  0C1F'   FA 0C2F'              	JM	BK_OK		; the start of the file
  0C22'   CD 0C31'              	CALL	CCLS
  0C25'   21 2DD6'              	LXI	H,WKCLS
  0C28'   BE                    	CMP	M
  0C29'   CA 0C1B'              	JZ	BK_WLP
  0C2C'   CD 0C6B'              	CALL	INCC		; overshot: forward one
  0C2F'                         BK_OK:
  0C2F'   AF                    	XRA	A
  0C30'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0C31'                         CCLS:
  0C31'   CD 0A84'              	CALL	ATEOF
  0C34'   D2 0755'              	JNC	CLASSF
  0C37'   AF                    	XRA	A
  0C38'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0C39'                         EMPTY:
  0C39'   CD 0A84'              	CALL	ATEOF
  0C3C'   DA 0C47'              	JC	EM_ST
  0C3F'   FE 0D                 	CPI	CR
  0C41'   CA 0C47'              	JZ	EM_ST
  0C44'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C46'   C0                    	RNZ
  0C47'                         EM_ST:
  0C47'   CD 0000*              	CALL	PEEKL
  0C4A'   DA 0C50'              	JC	EM_Y
  0C4D'   FE 0A                 	CPI	LF
  0C4F'   C9                    	RET
  0C50'                         EM_Y:
  0C50'   AF                    	XRA	A
  0C51'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0C52'                         NXLN:
  0C52'   FE 0A                 	CPI	LF
  0C54'   CA 0C63'              	JZ	NX_LF
  0C57'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0C5A'   D8                    	RC
  0C5B'   FE 0A                 	CPI	LF
  0C5D'   CA 0C63'              	JZ	NX_LF
  0C60'   2B                    	DCX	H		; a lone CR
  0C61'   AF                    	XRA	A
  0C62'   C9                    	RET
  0C63'                         NX_LF:
  0C63'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0C66'   D8                    	RC
  0C67'   2B                    	DCX	H
  0C68'   3E 01                 	MVI	A,1
  0C6A'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0C6B'                         INCC:
  0C6B'   CD 0A84'              	CALL	ATEOF
  0C6E'   DA 0CA9'              	JC	IC_END
  0C71'   FE 0D                 	CPI	CR
  0C73'   CA 0C94'              	JZ	IC_NL
  0C76'   FE 0A                 	CPI	LF
  0C78'   CA 0C94'              	JZ	IC_NL
  0C7B'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0C7E'                         IC_CH:
  0C7E'   CD 0A84'              	CALL	ATEOF
  0C81'   DA 0C90'              	JC	IC_2
  0C84'   FE 0D                 	CPI	CR
  0C86'   CA 0C90'              	JZ	IC_2
  0C89'   FE 0A                 	CPI	LF
  0C8B'   CA 0C90'              	JZ	IC_2
  0C8E'   AF                    	XRA	A
  0C8F'   C9                    	RET
  0C90'                         IC_2:
  0C90'   3E 02                 	MVI	A,2
  0C92'   B7                    	ORA	A
  0C93'   C9                    	RET
  0C94'                         IC_NL:
  0C94'   CD 0C52'              	CALL	NXLN
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0C97'   DA 0CA9'              	JC	IC_END
  0C9A'   F5                    	PUSH	PSW
  0C9B'   CD 0000*              	CALL	PUTCUR
  0C9E'   F1                    	POP	PSW
  0C9F'   B7                    	ORA	A
  0CA0'   CA 0C7E'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0CA3'   CD 0CCF'              	CALL	LNINC
  0CA6'   3E 01                 	MVI	A,1
  0CA8'   C9                    	RET
  0CA9'                         IC_END:
  0CA9'   3E FF                 	MVI	A,0FFH
  0CAB'   B7                    	ORA	A
  0CAC'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0CAD'                         DECC:
  0CAD'   CD 0000*              	CALL	PEEKL
  0CB0'   DA 0CA9'              	JC	IC_END
  0CB3'   F5                    	PUSH	PSW
  0CB4'   CD 0000*              	CALL	PUTCUR
  0CB7'   F1                    	POP	PSW
  0CB8'   FE 0A                 	CPI	LF
  0CBA'   3E 00                 	MVI	A,0
  0CBC'   C0                    	RNZ
  0CBD'   CD 0CDD'              	CALL	LNDEC
  0CC0'   CD 0000*              	CALL	PEEKL		; onto its CR
  0CC3'   DA 0CCB'              	JC	DC_1
  0CC6'   FE 0D                 	CPI	CR
  0CC8'   CC 0000*              	CZ	PUTCUR
  0CCB'                         DC_1:
  0CCB'   3E 01                 	MVI	A,1
  0CCD'   B7                    	ORA	A
  0CCE'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0CCF'                         LNINC:
  0CCF'   E5                    	PUSH	H
  0CD0'   2A 0000*              	LHLD	LNDLT
  0CD3'   7C                    	MOV	A,H
  0CD4'   FE 40                 	CPI	40H
  0CD6'   CA 0CEB'              	JZ	LN_X
  0CD9'   23                    	INX	H
  0CDA'   C3 0CE8'              	JMP	LN_ST
  0CDD'                         LNDEC:
  0CDD'   E5                    	PUSH	H
  0CDE'   2A 0000*              	LHLD	LNDLT
  0CE1'   7C                    	MOV	A,H
  0CE2'   FE C0                 	CPI	0C0H
  0CE4'   CA 0CEB'              	JZ	LN_X
  0CE7'   2B                    	DCX	H
  0CE8'                         LN_ST:
  0CE8'   22 0000*              	SHLD	LNDLT
  0CEB'                         LN_X:
  0CEB'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0CEC'   C9                    	RET
                                
  0CED'   AF                    VC_E:	XRA	A
  0CEE'   32 2D87'              	STA	WBIG
  0CF1'   C3 0CF9'              	JMP	EDO
  0CF4'   3E 01                 VCBGE:	MVI	A,1
  0CF6'   32 2D87'              	STA	WBIG
  0CF9'   CD 07A0'              EDO:	CALL	SETMOV
  0CFC'   CD 06CB'              	CALL	GETCNT
  0CFF'   22 2DCA'              	SHLD	CNTV
  0D02'   2A 2DCA'              EDO_LP: LHLD	CNTV
  0D05'   7C                    	MOV	A,H
  0D06'   B5                    	ORA	L
  0D07'   CA 0B31'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0D0A'   2B                    	DCX	H
  0D0B'   22 2DCA'              	SHLD	CNTV
  0D0E'   CD 0D1C'              	CALL	ESTEP
  0D11'   21 2DB5'              	LXI	H,CWEOL		; only the count's first word stays where it is
  0D14'   36 00                 	MVI	M,0
  0D16'   D2 0D02'              	JNC	EDO_LP
  0D19'   C3 0B31'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0D1C'                         ESTEP:
  0D1C'   CD 0C31'              	CALL	CCLS
  0D1F'   32 2DD6'              	STA	WKCLS		; the starting class
  0D22'   CD 0C6B'              	CALL	INCC
  0D25'   B7                    	ORA	A
  0D26'   FA 0D4C'              	JM	ES_F
  0D29'   CD 0C31'              	CALL	CCLS
  0D2C'   B7                    	ORA	A
  0D2D'   CA 0D37'              	JZ	ES_ST
  0D30'   21 2DD6'              	LXI	H,WKCLS
  0D33'   BE                    	CMP	M
  0D34'   CA 0D4E'              	JZ	ES_SK		; still in the word it started in: on to its end
  0D37'                         ES_ST:
  0D37'   3A 2DB5'              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0D3A'   B7                    	ORA	A		;   that char is the word's end already, and
  0D3B'   C2 0D65'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
  0D3E'                         ES_WS:
  0D3E'   CD 0C31'              	CALL	CCLS		; over blanks, line ends and empty lines
  0D41'   B7                    	ORA	A
  0D42'   C2 0D4E'              	JNZ	ES_SK
  0D45'   CD 0C6B'              	CALL	INCC
  0D48'   B7                    	ORA	A
  0D49'   F2 0D3E'              	JP	ES_WS
  0D4C'                         ES_F:
  0D4C'   37                    	STC
  0D4D'   C9                    	RET
  0D4E'                         ES_SK:
  0D4E'   CD 0C31'              	CALL	CCLS		; past the rest of this word ...
  0D51'   32 2DD6'              	STA	WKCLS
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D54'                         ES_SL:
  0D54'   CD 0C6B'              	CALL	INCC
  0D57'   B7                    	ORA	A
  0D58'   FA 0D4C'              	JM	ES_F
  0D5B'   CD 0C31'              	CALL	CCLS
  0D5E'   21 2DD6'              	LXI	H,WKCLS
  0D61'   BE                    	CMP	M
  0D62'   CA 0D54'              	JZ	ES_SL
  0D65'   C3 0CAD'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's place among the screen's LINES (CURRW) and the
                                ; last layout's facts from SCRN.MAC: SCBOT (the last line shown), SCEOF / SCBOF
                                ; (the file's end / start is on the screen).  H and L count lines.  M and the
                                ; scrolls count screen ROWS, as vim does once lines wrap, and a line's rows
                                ; are not known without measuring it: SCRN.MAC's HTBLD measures the lines
                                ; about the screen into a table (HTAB), and the rest is arithmetic on that.
                                ; A scroll then moves the cursor and names the line the screen is to start
                                ; with (HTLAND -> SETRWT), so the text scrolls around it.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0D68'                         CURRW:
  0D68'   2A 0000*              	LHLD	WINROW
  0D6B'   EB                    	XCHG
  0D6C'   2A 0000*              	LHLD	LNDLT
  0D6F'   19                    	DAD	D		; HL = row (signed)
  0D70'   7C                    	MOV	A,H
  0D71'   B7                    	ORA	A
  0D72'   FA 0D85'              	JM	CRW_0		; above the screen -> top row
  0D75'   C2 0D80'              	JNZ	CRW_BT		; far below -> bottom row
  0D78'   3A 0000*              	LDA	NEDIT
  0D7B'   3D                    	DCR	A		; A = bottom row
  0D7C'   BD                    	CMP	L		; CY iff bottom < row
  0D7D'   D8                    	RC
  0D7E'   7D                    	MOV	A,L
  0D7F'   C9                    	RET
  0D80'                         CRW_BT:
  0D80'   3A 0000*              	LDA	NEDIT
  0D83'   3D                    	DCR	A
  0D84'   C9                    	RET
  0D85'                         CRW_0:
  0D85'   AF                    	XRA	A
  0D86'   C9                    	RET
                                
                                ;SETRWT -- A = lines: the next layout puts that many above the cursor's, and
                                ; does not ask whether the line has gone far (PLACE).
  0D87'                         SETRWT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0D87'   2A 0000*              	LHLD	LNDLT
  0D8A'   EB                    	XCHG
  0D8B'   6F                    	MOV	L,A
  0D8C'   26 00                 	MVI	H,0
  0D8E'   CD 0000*              	CALL	SUBHD		; HL = lines - LNDLT
  0D91'   22 0000*              	SHLD	WINROW
  0D94'   3E 01                 	MVI	A,PL_SET
  0D96'   32 0000*              	STA	PLACE
  0D99'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0D9A'                         MVROW:
  0D9A'   47                    	MOV	B,A
  0D9B'   CD 0D68'              	CALL	CURRW
  0D9E'   90                    	SUB	B		; A = row now - target
  0D9F'                         MR_GO:
  0D9F'   C8                    	RZ
  0DA0'   DA 0DA9'              	JC	MR_DN
  0DA3'   6F                    	MOV	L,A
  0DA4'   26 00                 	MVI	H,0
  0DA6'   C3 09F3'              	JMP	KCORE
  0DA9'                         MR_DN:
  0DA9'   2F                    	CMA
  0DAA'   3C                    	INR	A		; A = target - row now
  0DAB'   6F                    	MOV	L,A
  0DAC'   26 00                 	MVI	H,0
  0DAE'   C3 0956'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0DB1'                         VC_HIGH:
  0DB1'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0DB4'   2B                    	DCX	H		; row = count - 1
  0DB5'   7C                    	MOV	A,H
  0DB6'   B7                    	ORA	A
  0DB7'   3A 0000*              	LDA	SCBOT
  0DBA'   C2 0DC2'              	JNZ	VH_GO		; >= 256 -> the last text row
  0DBD'   BD                    	CMP	L		; CY iff SCBOT < row
  0DBE'   DA 0DC2'              	JC	VH_GO
  0DC1'   7D                    	MOV	A,L
  0DC2'                         VH_GO:
  0DC2'   CD 0D9A'              	CALL	MVROW
  0DC5'   C3 089B'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': the line the middle ROW of the text is on (vim: the first
                                ; whose rows, with those above it, come to half of them); count ignored.
  0DC8'                         VC_MIDL:
  0DC8'   CD 06B8'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0DCB'   CD 105A'              	CALL	HTSCR		; HL -> the top line's rows
  0DCE'   3A 0000*              	LDA	TXEND
  0DD1'   3C                    	INR	A
  0DD2'   B7                    	ORA	A
  0DD3'   1F                    	RAR
  0DD4'   3D                    	DCR	A
  0DD5'   4F                    	MOV	C,A		; C = (rows of text + 1) / 2 - 1
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0DD6'   CD 10A0'              	CALL	HTFQ
  0DD9'   D2 0DDD'              	JNC	VM_GO
  0DDC'   2B                    	DCX	H
  0DDD'                         VM_GO:
  0DDD'   CD 1095'              	CALL	HTGO
  0DE0'   C3 089B'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0DE3'                         VC_LOWL:
  0DE3'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0DE6'   2B                    	DCX	H		; count - 1
  0DE7'   3A 0000*              	LDA	SCBOT
  0DEA'   5F                    	MOV	E,A
  0DEB'   16 00                 	MVI	D,0
  0DED'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0DEE'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0DF1'   3E 00                 	MVI	A,0
  0DF3'   D2 0DFA'              	JNC	VL_GO		; at or past the top -> row 0
  0DF6'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0DF9'   7D                    	MOV	A,L
  0DFA'                         VL_GO:
  0DFA'   CD 0D9A'              	CALL	MVROW
  0DFD'   C3 089B'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the text forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is the
                                ; screen's ROWS less the overlap (OVLAP), and the line that many rows down
                                ; becomes the top line -- from its first row, vim never showing part of one.
                                ; The top line stops at the last line ('~' rows below); no-op when it is
                                ; already there.
  0E00'                         VC_PGDN:
  0E00'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0E03'   22 2D92'              	SHLD	RWR
  0E06'   3A 0000*              	LDA	SCEOF
  0E09'   B7                    	ORA	A
  0E0A'   CA 0E12'              	JZ	VPD_N
  0E0D'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: it becomes the
  0E10'   B7                    	ORA	A		;   top line
  0E11'   C8                    	RZ			; it already is
  0E12'                         VPD_N:
  0E12'   3A 0000*              	LDA	NEDIT
  0E15'   3C                    	INR	A
  0E16'   4F                    	MOV	C,A
  0E17'   3E 02                 	MVI	A,2
  0E19'   CD 1061'              	CALL	HTSET		; HL -> the top line's rows
  0E1C'   E5                    	PUSH	H
  0E1D'   C5                    	PUSH	B
  0E1E'   3A 0000*              	LDA	NEDIT
  0E21'   4F                    	MOV	C,A
  0E22'   CD 10A0'              	CALL	HTFQ		; HL -> the first line the screen has not room for
  0E25'   3A 0000*              	LDA	NEDIT
  0E28'   DA 0E35'              	JC	VPD_R		; there is none: no overlap
  0E2B'   3A 2D8D'              	LDA	HTN
  0E2E'   90                    	SUB	B
  0E2F'   3C                    	INR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E30'   47                    	MOV	B,A		; the lines from it up to the table's first
  0E31'   AF                    	XRA	A
  0E32'   CD 0ECF'              	CALL	OVLAP
  0E35'                         VPD_R:
  0E35'   CD 0F1E'              	CALL	PGROWS		; RWR = the rows to go
  0E38'   C1                    	POP	B
  0E39'   E1                    	POP	H
  0E3A'   CD 10E1'              	CALL	RWFWD		; HL -> the line that row is in, C = which of its
  0E3D'   DA 0E59'              	JC	VPD_TP		; the text ended: its last line
  0E40'   79                    	MOV	A,C
  0E41'   B7                    	ORA	A
  0E42'   CA 0E59'              	JZ	VPD_TP
  0E45'   3A 2D94'              	LDA	RWMV		; part of the way down a line: its start -- unless
  0E48'   B7                    	ORA	A		;   that is the top line still, then the next
  0E49'   C2 0E59'              	JNZ	VPD_TP
  0E4C'   E5                    	PUSH	H
  0E4D'   CD 108F'              	CALL	HTIX
  0E50'   21 2D8F'              	LXI	H,HTTP
  0E53'   BE                    	CMP	M
  0E54'   E1                    	POP	H
  0E55'   C2 0E59'              	JNZ	VPD_TP
  0E58'   23                    	INX	H
  0E59'                         VPD_TP:
  0E59'   54                    	MOV	D,H
  0E5A'   5D                    	MOV	E,L
  0E5B'   C3 0FC8'              	JMP	HTLAND
                                
                                ;VC_PGUP -- '^B': the text back count pages, not above the first line, the
                                ; cursor on the last line that then shows whole, first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is the screen's ROWS less the overlap
                                ; (OVLAP).  Where that ends part of the way up a line, the top line is the one
                                ; under it -- but the line itself, when it is the first one back.  No-op when
                                ; the first line is already at the top.
  0E5E'                         VC_PGUP:
  0E5E'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0E61'   22 2D92'              	SHLD	RWR
  0E64'   3A 0000*              	LDA	SCBOF
  0E67'   B7                    	ORA	A
  0E68'   C0                    	RNZ
  0E69'   CD 0D68'              	CALL	CURRW		; OVLAP reads the top line and the two under it:
  0E6C'   FE 02                 	CPI	2		;   lines the cursor's is not below are read for
  0E6E'   0E 01                 	MVI	C,1
  0E70'   D2 0E77'              	JNC	VPU_1
  0E73'   3A 0000*              	LDA	NEDIT
  0E76'   4F                    	MOV	C,A
  0E77'                         VPU_1:
  0E77'   3A 0000*              	LDA	NEDIT
  0E7A'   CD 1061'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  0E7D'   E5                    	PUSH	H
  0E7E'   D5                    	PUSH	D
  0E7F'   2B                    	DCX	H		; the line above the top one, and on down
  0E80'   04                    	INR	B
  0E81'   3E 01                 	MVI	A,1
  0E83'   CD 0ECF'              	CALL	OVLAP
  0E86'   CD 0F1E'              	CALL	PGROWS		; RWR = the rows to go
  0E89'   D1                    	POP	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0E8A'   E1                    	POP	H
  0E8B'   43                    	MOV	B,E
  0E8C'   CD 1121'              	CALL	RWBAK		; HL -> the line that row is in, C = its rows
  0E8F'   DA 0EAC'              	JC	VPU_3		;   above it; or the file's first line
  0E92'   79                    	MOV	A,C
  0E93'   B7                    	ORA	A
  0E94'   CA 0EAC'              	JZ	VPU_3
  0E97'   3A 2D94'              	LDA	RWMV
  0E9A'   B7                    	ORA	A
  0E9B'   C2 0EAB'              	JNZ	VPU_2
  0E9E'   E5                    	PUSH	H
  0E9F'   CD 108F'              	CALL	HTIX
  0EA2'   3C                    	INR	A
  0EA3'   21 2D8F'              	LXI	H,HTTP
  0EA6'   BE                    	CMP	M
  0EA7'   E1                    	POP	H
  0EA8'   CA 0EAC'              	JZ	VPU_3		; the first line back: all of it
  0EAB'                         VPU_2:
  0EAB'   23                    	INX	H
  0EAC'                         VPU_3:
  0EAC'   CD 1095'              	CALL	HTGO		; the cursor on the new top line ...
  0EAF'   3A 0000*              	LDA	NEDIT
  0EB2'   4F                    	MOV	C,A
  0EB3'   06 00                 	MVI	B,0
  0EB5'   CD 1076'              	CALL	HTRB		; ... and the lines under it measured
  0EB8'   E5                    	PUSH	H
  0EB9'   3A 0000*              	LDA	NEDIT
  0EBC'   4F                    	MOV	C,A
  0EBD'   CD 10A0'              	CALL	HTFQ		; HL -> the first the screen has not room for
  0EC0'   2B                    	DCX	H
  0EC1'   D1                    	POP	D		; DE -> the top line's rows
  0EC2'   EB                    	XCHG
  0EC3'   CD 0000*              	CALL	CMP16		; CY iff that is above the top line (it alone
  0EC6'   D2 0ECB'              	JNC	VPU_4		;   fills the screen)
  0EC9'   54                    	MOV	D,H
  0ECA'   5D                    	MOV	E,L
  0ECB'                         VPU_4:
  0ECB'   EB                    	XCHG
  0ECC'   C3 0FC8'              	JMP	HTLAND
                                
                                ;OVLAP -- A = the rows one page scrolls, as vim's get_scroll_overlap: the
                                ; screen less two lines of overlap -- or less one, or none, where the lines at
                                ; that edge are too tall to be shown twice or the file ends among them.
                                ;   in : HL -> the rows of the line just off the screen at that edge (h1),
                                ;        A = 0 when the next (h2, h3, h4) are above it in the table, 1 when
                                ;        below, B = the entries the table has that way, h1's among them
  0ECF'                         OVLAP:
  0ECF'   32 2D95'              	STA	OVDIR
  0ED2'   3A 0000*              	LDA	NEDIT
  0ED5'   D6 02                 	SUI	2
  0ED7'   4F                    	MOV	C,A		; C = the rows two lines of overlap leave
  0ED8'   56                    	MOV	D,M		; D = h1
  0ED9'   CD 0F10'              	CALL	OV_NX
  0EDC'   DA 0F0C'              	JC	OV_0
  0EDF'   5E                    	MOV	E,M		; E = h2
  0EE0'   7A                    	MOV	A,D
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0EE1'   83                    	ADD	E
  0EE2'   57                    	MOV	D,A		; D = h1 + h2
  0EE3'   79                    	MOV	A,C
  0EE4'   BA                    	CMP	D
  0EE5'   DA 0F0C'              	JC	OV_0
  0EE8'   CD 0F10'              	CALL	OV_NX
  0EEB'   DA 0F0C'              	JC	OV_0
  0EEE'   7B                    	MOV	A,E
  0EEF'   86                    	ADD	M
  0EF0'   5F                    	MOV	E,A		; E = h2 + h3
  0EF1'   79                    	MOV	A,C
  0EF2'   BB                    	CMP	E
  0EF3'   DA 0F0C'              	JC	OV_0
  0EF6'   7A                    	MOV	A,D
  0EF7'   86                    	ADD	M
  0EF8'   57                    	MOV	D,A		; D = h1 + h2 + h3
  0EF9'   CD 0F10'              	CALL	OV_NX
  0EFC'   DA 0F09'              	JC	OV_1
  0EFF'   7B                    	MOV	A,E
  0F00'   86                    	ADD	M		; h2 + h3 + h4
  0F01'   5F                    	MOV	E,A
  0F02'   79                    	MOV	A,C
  0F03'   BB                    	CMP	E
  0F04'   DA 0F09'              	JC	OV_1
  0F07'   BA                    	CMP	D
  0F08'   D0                    	RNC			; two lines of overlap
  0F09'                         OV_1:
  0F09'   79                    	MOV	A,C
  0F0A'   3C                    	INR	A
  0F0B'   C9                    	RET
  0F0C'                         OV_0:
  0F0C'   79                    	MOV	A,C
  0F0D'   C6 02                 	ADI	2
  0F0F'   C9                    	RET
                                ;OV_NX -- HL -> the next line's rows, that way.  CY if the table has no more.
  0F10'                         OV_NX:
  0F10'   05                    	DCR	B
  0F11'   37                    	STC
  0F12'   C8                    	RZ
  0F13'   3A 2D95'              	LDA	OVDIR
  0F16'   B7                    	ORA	A		; (CY off)
  0F17'   CA 0F1C'              	JZ	OV_UP
  0F1A'   23                    	INX	H
  0F1B'   23                    	INX	H
  0F1C'                         OV_UP:
  0F1C'   2B                    	DCX	H
  0F1D'   C9                    	RET
                                
                                ;PGROWS -- A = the rows of a page: RWR = the count (in RWR) of them, and no
                                ; line gone past yet (RWMV).
  0F1E'                         PGROWS:
  0F1E'   2A 2D92'              	LHLD	RWR
  0F21'   CD 0F2C'              	CALL	MULSAT
  0F24'   22 2D92'              	SHLD	RWR
  0F27'   AF                    	XRA	A
  0F28'   32 2D94'              	STA	RWMV
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F2B'   C9                    	RET
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0F2C'                         MULSAT:
  0F2C'   EB                    	XCHG
  0F2D'   21 0000               	LXI	H,0
  0F30'   B7                    	ORA	A
  0F31'   C8                    	RZ
  0F32'                         MS_LP:
  0F32'   19                    	DAD	D
  0F33'   DA 0F3B'              	JC	MS_SAT
  0F36'   3D                    	DCR	A
  0F37'   C2 0F32'              	JNZ	MS_LP
  0F3A'   C9                    	RET
  0F3B'                         MS_SAT:
  0F3B'   21 FFFF               	LXI	H,0FFFFH
  0F3E'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': the text and the cursor down HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text goes
                                ; no farther than brings the last row of the file to the bottom row; the line
                                ; that many rows down becomes the top line -- from its first row, vim never
                                ; showing part of one, and the cursor moves as many rows less (more, where
                                ; the top line alone was taller than that and the text had to go past it).
                                ; On the last line nothing moves, the column included.
  0F3F'                         VC_HFDN:
  0F3F'   CD 07A0'              	CALL	SETMOV
  0F42'   CD 1184'              	CALL	HFCNT		; HFN = the rows
  0F45'   3A 0000*              	LDA	TALLF
  0F48'   B7                    	ORA	A
  0F49'   C2 0FDF'              	JNZ	VHD_TL
  0F4C'   CD 0D68'              	CALL	CURRW
  0F4F'   47                    	MOV	B,A
  0F50'   3A 0000*              	LDA	SCEOF
  0F53'   B7                    	ORA	A
  0F54'   CA 0F5C'              	JZ	VHD_GO
  0F57'   3A 0000*              	LDA	SCBOT		; the last line's place
  0F5A'   B8                    	CMP	B
  0F5B'   C8                    	RZ			; the cursor is on it
  0F5C'                         VHD_GO:
  0F5C'   3A 0000*              	LDA	NEDIT
  0F5F'   21 2D8A'              	LXI	H,HFN
  0F62'   86                    	ADD	M
  0F63'   3C                    	INR	A
  0F64'   4F                    	MOV	C,A
  0F65'   AF                    	XRA	A
  0F66'   CD 1061'              	CALL	HTSET		; HL -> the top line's rows
  0F69'   3A 2D8A'              	LDA	HFN
  0F6C'   57                    	MOV	D,A		; D = the rows the text moves
  0F6D'   5F                    	MOV	E,A		; E = the rows the cursor moves
  0F6E'   3A 2D90'              	LDA	HTEOF
  0F71'   B7                    	ORA	A
  0F72'   CA 0F91'              	JZ	VHD_1
  0F75'   E5                    	PUSH	H
  0F76'   C5                    	PUSH	B
  0F77'   0E FF                 	MVI	C,255
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F79'   CD 10A0'              	CALL	HTFQ		; (runs off: C = 255 - the rows to the file's end)
  0F7C'   3A 0000*              	LDA	NEDIT
  0F7F'   81                    	ADD	C
  0F80'   2F                    	CMA			; A = those rows - NEDIT: the rows off the screen
  0F81'   C1                    	POP	B
  0F82'   E1                    	POP	H
  0F83'   B7                    	ORA	A
  0F84'   FA 0F8F'              	JM	VHD_0		; none
  0F87'   BA                    	CMP	D
  0F88'   D2 0F91'              	JNC	VHD_1
  0F8B'   57                    	MOV	D,A
  0F8C'   C3 0F91'              	JMP	VHD_1
  0F8F'                         VHD_0:
  0F8F'   16 00                 	MVI	D,0
  0F91'                         VHD_1:
  0F91'   7A                    	MOV	A,D
  0F92'   B7                    	ORA	A
  0F93'   CA 0FAE'              	JZ	VHD_C		; the text stays
  0F96'   4A                    	MOV	C,D
  0F97'   CD 10A0'              	CALL	HTFQ		; HL -> the line that row is in, C = which of its
  0F9A'   79                    	MOV	A,C
  0F9B'   B7                    	ORA	A
  0F9C'   CA 0FAE'              	JZ	VHD_C
  0F9F'   BA                    	CMP	D
  0FA0'   C2 0FAB'              	JNZ	VHD_R
  0FA3'   7E                    	MOV	A,M		; the top line still: past all of it
  0FA4'   91                    	SUB	C
  0FA5'   83                    	ADD	E
  0FA6'   5F                    	MOV	E,A
  0FA7'   23                    	INX	H
  0FA8'   C3 0FAE'              	JMP	VHD_C
  0FAB'                         VHD_R:
  0FAB'   7B                    	MOV	A,E		; part of the way down a line: its start
  0FAC'   91                    	SUB	C
  0FAD'   5F                    	MOV	E,A
  0FAE'                         VHD_C:
  0FAE'   22 2D8B'              	SHLD	HFTP
  0FB1'   3A 0000*              	LDA	CSUB		; the cursor: E rows down from the one it is on
  0FB4'   83                    	ADD	E
  0FB5'   4F                    	MOV	C,A
  0FB6'   3A 2D8E'              	LDA	HTCUR
  0FB9'   CD 1082'              	CALL	HTPT
  0FBC'   CD 10A0'              	CALL	HTFQ
  0FBF'   D2 0FC3'              	JNC	HFEND
  0FC2'   2B                    	DCX	H		; the file ends first: its last line
                                ;HFEND -- ^D / ^U: HL -> the rows of the line the cursor goes to.
  0FC3'                         HFEND:
  0FC3'   EB                    	XCHG
  0FC4'   2A 2D8B'              	LHLD	HFTP
  0FC7'   EB                    	XCHG
                                ;HTLAND -- the cursor to the line whose rows HL points at, DE -> those of the
                                ; line the screen is to start with (never one under it); first non-blank.
  0FC8'                         HTLAND:
  0FC8'   E5                    	PUSH	H
  0FC9'   D5                    	PUSH	D
  0FCA'   CD 1095'              	CALL	HTGO
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FCD'   D1                    	POP	D
  0FCE'   E1                    	POP	H
  0FCF'   CD 0000*              	CALL	SUBHD		; HL = the lines between them
  0FD2'   7C                    	MOV	A,H
  0FD3'   B7                    	ORA	A
  0FD4'   7D                    	MOV	A,L
  0FD5'   CA 0FD9'              	JZ	HL_SET
  0FD8'   AF                    	XRA	A
  0FD9'                         HL_SET:
  0FD9'   CD 0D87'              	CALL	SETRWT
  0FDC'   C3 089B'              	JMP	FNBLNK
                                
                                ;--- the top line is taller than the screen, and the cursor in it: vim goes
                                ;    on scrolling until the next line is at the top, the cursor keeping its
                                ;    row of the screen ---
  0FDF'                         VHD_TL:
  0FDF'   3A 0000*              	LDA	SKIPR
  0FE2'   47                    	MOV	B,A
  0FE3'   3A 0000*              	LDA	CSUB
  0FE6'   90                    	SUB	B		; A = that row
  0FE7'   F5                    	PUSH	PSW
  0FE8'   21 0001               	LXI	H,1
  0FEB'   CD 0956'              	CALL	JCORE		; (on the last line: nowhere to go)
  0FEE'   F1                    	POP	PSW
  0FEF'   4F                    	MOV	C,A
  0FF0'   C5                    	PUSH	B
  0FF1'   0C                    	INR	C
  0FF2'   06 00                 	MVI	B,0
  0FF4'   CD 1076'              	CALL	HTRB		; HL -> the rows of the line now the cursor's
  0FF7'   22 2D8B'              	SHLD	HFTP
  0FFA'   D1                    	POP	D
  0FFB'   4B                    	MOV	C,E
  0FFC'   CD 10A0'              	CALL	HTFQ
  0FFF'   D2 0FC3'              	JNC	HFEND
  1002'   2B                    	DCX	H
  1003'   C3 0FC3'              	JMP	HFEND
                                
                                ;VC_HFUP -- '^U': the text and the cursor up HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text
                                ; stops at the first line, the cursor goes on.  Where the rows end part of
                                ; the way up a line, the top line is the one under it and the cursor moves as
                                ; many rows less -- but the line itself, and as many more, when it is the
                                ; first one back.  On the first line nothing moves, the column included.
  1006'                         VC_HFUP:
  1006'   CD 07A0'              	CALL	SETMOV
  1009'   CD 1184'              	CALL	HFCNT		; HFN = the rows
  100C'   CD 1164'              	CALL	ONFST
  100F'   C8                    	RZ			; the cursor is on the first line
  1010'   0E 01                 	MVI	C,1
  1012'   3A 2D8A'              	LDA	HFN
  1015'   CD 1061'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  1018'   43                    	MOV	B,E
  1019'   3A 2D8A'              	LDA	HFN
  101C'   4F                    	MOV	C,A
  101D'   5F                    	MOV	E,A		; E = the rows the cursor moves
  101E'   CD 10B1'              	CALL	HTBQ		; HL -> the line that row is in, C = its rows
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  1021'   DA 103C'              	JC	VHU_C		;   above it; or the file's first line
  1024'   79                    	MOV	A,C
  1025'   B7                    	ORA	A
  1026'   CA 103C'              	JZ	VHU_C
  1029'   3A 2D8F'              	LDA	HTTP
  102C'   3D                    	DCR	A
  102D'   B8                    	CMP	B
  102E'   CA 1039'              	JZ	VHU_F
  1031'   7B                    	MOV	A,E		; part of the way up a line: the one under it
  1032'   96                    	SUB	M
  1033'   81                    	ADD	C
  1034'   5F                    	MOV	E,A
  1035'   23                    	INX	H
  1036'   C3 103C'              	JMP	VHU_C
  1039'                         VHU_F:
  1039'   7B                    	MOV	A,E		; ... the first line back: all of it
  103A'   81                    	ADD	C
  103B'   5F                    	MOV	E,A
  103C'                         VHU_C:
  103C'   22 2D8B'              	SHLD	HFTP
  103F'   4B                    	MOV	C,E
  1040'   3A 2D8E'              	LDA	HTCUR
  1043'   CD 1082'              	CALL	HTPT		; HL -> the cursor line's rows, E = lines above it
  1046'   3A 0000*              	LDA	CSUB
  1049'   57                    	MOV	D,A
  104A'   79                    	MOV	A,C
  104B'   92                    	SUB	D		; the rows to go, less those of its own line above it
  104C'   DA 0FC3'              	JC	HFEND
  104F'   CA 0FC3'              	JZ	HFEND
  1052'   4F                    	MOV	C,A
  1053'   43                    	MOV	B,E
  1054'   CD 10B1'              	CALL	HTBQ		; (off the top: the file's first line)
  1057'   C3 0FC3'              	JMP	HFEND
                                
                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
                                ;HTSCR -- the table as the last layout left it, which is the screen's own:
                                ; HL, B and E as HTSET gives them, and nothing measured.
  105A'                         HTSCR:
  105A'   CD 0D68'              	CALL	CURRW
  105D'   47                    	MOV	B,A
  105E'   C3 106C'              	JMP	HS_TP
  1061'                         HTSET:
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  1061'   47                    	MOV	B,A
  1062'   CD 0D68'              	CALL	CURRW		; (keeps BC)
  1065'   F5                    	PUSH	PSW
  1066'   80                    	ADD	B
  1067'   47                    	MOV	B,A
  1068'   CD 1076'              	CALL	HTRB
  106B'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  106C'                         HS_TP:
  106C'   3A 2D8E'              	LDA	HTCUR
  106F'   90                    	SUB	B
  1070'   32 2D8F'              	STA	HTTP
  1073'   C3 1082'              	JMP	HTPT
  1076'                         HTRB:
  1076'   CD 1254'              	CALL	ZSAVE
  1079'   CD 0000*              	CALL	HTBLD
  107C'   CD 1267'              	CALL	ZREST
  107F'   3A 2D8E'              	LDA	HTCUR
  1082'                         HTPT:
  1082'   5F                    	MOV	E,A
  1083'   16 00                 	MVI	D,0
  1085'   21 0000*              	LXI	H,HTAB
  1088'   19                    	DAD	D
  1089'   3A 2D8D'              	LDA	HTN
  108C'   93                    	SUB	E
  108D'   47                    	MOV	B,A
  108E'   C9                    	RET
                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  108F'                         HTIX:
  108F'   11 0000*              	LXI	D,HTAB
  1092'   7D                    	MOV	A,L
  1093'   93                    	SUB	E
  1094'   C9                    	RET
                                
                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
  1095'                         HTGO:
  1095'   CD 108F'              	CALL	HTIX
  1098'   47                    	MOV	B,A
  1099'   3A 2D8E'              	LDA	HTCUR
  109C'   90                    	SUB	B		; A = the lines up to it
  109D'   C3 0D9F'              	JMP	MR_GO
                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  10A0'                         HTFQ:
  10A0'   78                    	MOV	A,B
  10A1'   B7                    	ORA	A
  10A2'   37                    	STC
  10A3'   C8                    	RZ
  10A4'   79                    	MOV	A,C
  10A5'   96                    	SUB	M
  10A6'   DA 10AF'              	JC	HF_IN
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  10A9'   4F                    	MOV	C,A
  10AA'   23                    	INX	H
  10AB'   05                    	DCR	B
  10AC'   C3 10A0'              	JMP	HTFQ
  10AF'                         HF_IN:
  10AF'   B7                    	ORA	A
  10B0'   C9                    	RET
                                
                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
                                ;        the table starts first (HL -> its first entry, C = the rows short)
  10B1'                         HTBQ:
  10B1'   78                    	MOV	A,B
  10B2'   B7                    	ORA	A
  10B3'   37                    	STC
  10B4'   C8                    	RZ
  10B5'   2B                    	DCX	H
  10B6'   05                    	DCR	B
  10B7'   7E                    	MOV	A,M
  10B8'   91                    	SUB	C
  10B9'   D2 10C2'              	JNC	HQ_IN
  10BC'   2F                    	CMA
  10BD'   3C                    	INR	A
  10BE'   4F                    	MOV	C,A
  10BF'   C3 10B1'              	JMP	HTBQ
  10C2'                         HQ_IN:
  10C2'   4F                    	MOV	C,A
  10C3'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
                                ; Keeps HL, B, DE.
  10C4'                         RWQ:
  10C4'   0E 64                 	MVI	C,100
  10C6'   3A 2D93'              	LDA	RWR+1
  10C9'   B7                    	ORA	A
  10CA'   C0                    	RNZ
  10CB'   3A 2D92'              	LDA	RWR
  10CE'   B9                    	CMP	C
  10CF'   D0                    	RNC
  10D0'   4F                    	MOV	C,A
  10D1'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  10D2'                         RWSUB:
  10D2'   E5                    	PUSH	H
  10D3'   5F                    	MOV	E,A
  10D4'   16 00                 	MVI	D,0
  10D6'   2A 2D92'              	LHLD	RWR
  10D9'   CD 0000*              	CALL	SUBHD
  10DC'   22 2D92'              	SHLD	RWR
  10DF'   E1                    	POP	H
  10E0'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


                                ; whose entry HL points at (B = the entries from it on), however far that is:
                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  10E1'                         RWFWD:
  10E1'   CD 10C4'              	CALL	RWQ
  10E4'   51                    	MOV	D,C
  10E5'   CD 10A0'              	CALL	HTFQ
  10E8'   F5                    	PUSH	PSW
  10E9'   7A                    	MOV	A,D
  10EA'   91                    	SUB	C		; the rows that took it to that line's first
  10EB'   CD 10D2'              	CALL	RWSUB
  10EE'   F1                    	POP	PSW
  10EF'   DA 1103'              	JC	RF_OFF
  10F2'   3A 2D93'              	LDA	RWR+1		; is what is left inside this line?
  10F5'   B7                    	ORA	A
  10F6'   C2 110D'              	JNZ	RF_GO
  10F9'   3A 2D92'              	LDA	RWR
  10FC'   BE                    	CMP	M
  10FD'   D2 110D'              	JNC	RF_GO
  1100'   4F                    	MOV	C,A
  1101'   B7                    	ORA	A
  1102'   C9                    	RET
  1103'                         RF_OFF:
  1103'   3A 2D90'              	LDA	HTEOF
  1106'   B7                    	ORA	A
  1107'   CA 110D'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  110A'   2B                    	DCX	H
  110B'   37                    	STC
  110C'   C9                    	RET
  110D'                         RF_GO:
  110D'   CD 1095'              	CALL	HTGO
  1110'   3E 01                 	MVI	A,1
  1112'   32 2D94'              	STA	RWMV
  1115'   CD 10C4'              	CALL	RWQ
  1118'   0C                    	INR	C
  1119'   06 00                 	MVI	B,0
  111B'   CD 1076'              	CALL	HTRB
  111E'   C3 10E1'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  1121'                         RWBAK:
  1121'   CD 10C4'              	CALL	RWQ
  1124'   51                    	MOV	D,C
  1125'   CD 10B1'              	CALL	HTBQ
  1128'   DA 1145'              	JC	RB_OFF
  112B'   7A                    	MOV	A,D
  112C'   81                    	ADD	C
  112D'   5F                    	MOV	E,A		; E = the rows up to that line's first
  112E'   3A 2D93'              	LDA	RWR+1
  1131'   B7                    	ORA	A
  1132'   C2 1141'              	JNZ	RB_ON
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  1135'   3A 2D92'              	LDA	RWR
  1138'   57                    	MOV	D,A
  1139'   7B                    	MOV	A,E
  113A'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  113B'   DA 1141'              	JC	RB_ON
  113E'   4F                    	MOV	C,A
  113F'   B7                    	ORA	A
  1140'   C9                    	RET
  1141'                         RB_ON:
  1141'   7B                    	MOV	A,E
  1142'   C3 114C'              	JMP	RB_GO
  1145'                         RB_OFF:
  1145'   3A 2D91'              	LDA	HTBOF
  1148'   0F                    	RRC			; CY: that is the file's first line
  1149'   D8                    	RC
  114A'   7A                    	MOV	A,D
  114B'   91                    	SUB	C
  114C'                         RB_GO:
  114C'   CD 10D2'              	CALL	RWSUB
  114F'   CD 1095'              	CALL	HTGO
  1152'   3E 01                 	MVI	A,1
  1154'   32 2D94'              	STA	RWMV
  1157'   CD 10C4'              	CALL	RWQ
  115A'   41                    	MOV	B,C
  115B'   0E 01                 	MVI	C,1
  115D'   CD 1076'              	CALL	HTRB
  1160'   43                    	MOV	B,E
  1161'   C3 1121'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  1164'                         ONFST:
  1164'   E5                    	PUSH	H
  1165'   2A 0000*              	LHLD	OUTPOS
  1168'   7C                    	MOV	A,H
  1169'   B5                    	ORA	L
  116A'   C2 1182'              	JNZ	OF_RET
  116D'   2A 0000*              	LHLD	TXTBEG
  1170'   EB                    	XCHG			; DE = TXTBEG
  1171'   2A 0000*              	LHLD	GAPBEG
  1174'                         OF_LP:
  1174'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  1177'   CA 1182'              	JZ	OF_RET
  117A'   2B                    	DCX	H
  117B'   7E                    	MOV	A,M
  117C'   FE 0A                 	CPI	LF
  117E'   C2 1174'              	JNZ	OF_LP
  1181'   B7                    	ORA	A		; NZ
  1182'                         OF_RET:
  1182'   E1                    	POP	H
  1183'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  1184'                         HFCNT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1184'   2A 2D7B'              	LHLD	CMDCNT
  1187'   7C                    	MOV	A,H
  1188'   B5                    	ORA	L
  1189'   CA 11A0'              	JZ	HFC_AM
  118C'   CD 06CB'              	CALL	GETCNT		; HL = count; clears it
  118F'   3A 0000*              	LDA	NEDIT
  1192'   5F                    	MOV	E,A
  1193'   16 00                 	MVI	D,0
  1195'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  1198'   D2 119C'              	JNC	HFC_ST
  119B'   EB                    	XCHG			; HL = NEDIT
  119C'                         HFC_ST:
  119C'   7D                    	MOV	A,L
  119D'   32 2D89'              	STA	HFAMT
  11A0'                         HFC_AM:
  11A0'   3A 2D89'              	LDA	HFAMT
  11A3'   B7                    	ORA	A
  11A4'   C2 11B1'              	JNZ	HFC_HL
  11A7'   3A 0000*              	LDA	NEDIT
  11AA'   B7                    	ORA	A
  11AB'   1F                    	RAR
  11AC'   B7                    	ORA	A
  11AD'   C2 11B1'              	JNZ	HFC_HL
  11B0'   3C                    	INR	A		; at least one row
  11B1'                         HFC_HL:
  11B1'   32 2D8A'              	STA	HFN
  11B4'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  11B5'                         VC_REDR:
  11B5'   C3 06CB'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (PLACE) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  11B8'                         VC_G:
  11B8'   CD 07A0'              	CALL	SETMOV
  11BB'   CD 127A'              	CALL	GZONE		; the screen's top line, before the move
  11BE'   CD 06F4'              	CALL	BRKON		; ... and an ESC may stop it from here on
  11C1'   2A 2D7B'              	LHLD	CMDCNT
  11C4'   7C                    	MOV	A,H
  11C5'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  11C6'   C2 11D9'              	JNZ	VG_N
  11C9'   AF                    	XRA	A		; forward
  11CA'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  11CD'   CD 0731'              	CALL	BRKOFF
  11D0'   DA 0749'              	JC	BRKBAK
  11D3'   CD 0A8A'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  11D6'   C3 1292'              	JMP	GPLACE
  11D9'                         VG_N:
  11D9'   CD 06CB'              	CALL	GETCNT		; HL = target line (1-based)
  11DC'                         VG_LN:
  11DC'   CD 11E8'              	CALL	GOLN
  11DF'   CD 0731'              	CALL	BRKOFF
  11E2'   DA 0749'              	JC	BRKBAK
  11E5'   C3 1292'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  11E8'                         GOLN:
  11E8'   E5                    	PUSH	H
  11E9'   CD 0000*              	CALL	CNTLF
  11EC'   23                    	INX	H		; HL = the cursor's line
  11ED'   D1                    	POP	D		; DE = the line wanted
  11EE'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  11F1'   DA 11FC'              	JC	GLN_BK
  11F4'   EB                    	XCHG
  11F5'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  11F8'   AF                    	XRA	A
  11F9'   C3 1201'              	JMP	GLN_MV
  11FC'                         GLN_BK:
  11FC'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  11FF'   3E FF                 	MVI	A,0FFH
  1201'                         GLN_MV:
  1201'   CD 0000*              	CALL	MVLIND
  1204'   CD 0A84'              	CALL	ATEOF
  1207'   DC 0A8A'              	CC	LASTLN		; past the last line: onto it
  120A'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  120B'                         VC_LG:
  120B'   CD 07A0'              	CALL	SETMOV
  120E'   3A 2DB0'              	LDA	GSAVE
  1211'   B7                    	ORA	A
  1212'   C2 121B'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  1215'   3E 01                 	MVI	A,PG
  1217'   32 2DAF'              	STA	GPEND
  121A'   C9                    	RET
  121B'                         VLG_GG:
  121B'   CD 127A'              	CALL	GZONE
  121E'   CD 06F4'              	CALL	BRKON
  1221'   CD 06CB'              	CALL	GETCNT		; HL = target line (no count: 1)
  1224'   C3 11DC'              	JMP	VG_LN
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  1227'                         SUB24:
  1227'   4F                    	MOV	C,A
  1228'   7D                    	MOV	A,L
  1229'   93                    	SUB	E
  122A'   6F                    	MOV	L,A
  122B'   7C                    	MOV	A,H
  122C'   9A                    	SBB	D
  122D'   67                    	MOV	H,A
  122E'   79                    	MOV	A,C
  122F'   98                    	SBB	B
  1230'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  1231'                         CURFP:
  1231'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  1234'                         FPOS:
  1234'   C5                    	PUSH	B
  1235'   D5                    	PUSH	D
  1236'   EB                    	XCHG
  1237'   2A 0000*              	LHLD	TXTBEG
  123A'   EB                    	XCHG
  123B'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  123E'   EB                    	XCHG			; DE = that
  123F'   2A 0000*              	LHLD	OUTPOS
  1242'   7C                    	MOV	A,H
  1243'   B7                    	ORA	A		; CY = 0
  1244'   1F                    	RAR
  1245'   47                    	MOV	B,A
  1246'   7D                    	MOV	A,L
  1247'   1F                    	RAR
  1248'   67                    	MOV	H,A
  1249'   3E 00                 	MVI	A,0
  124B'   1F                    	RAR
  124C'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  124D'   19                    	DAD	D
  124E'   78                    	MOV	A,B
  124F'   CE 00                 	ACI	0		; A:HL = the position
  1251'   D1                    	POP	D
  1252'   C1                    	POP	B
  1253'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  1254'                         ZSAVE:
  1254'   2A 2D7B'              	LHLD	CMDCNT
  1257'   22 2DEE'              	SHLD	ZSVCNT
  125A'   2A 0000*              	LHLD	AUXCNT
  125D'   22 2DF0'              	SHLD	ZSVAUX
  1260'   3A 0000*              	LDA	DIRFLG
  1263'   32 2DF2'              	STA	ZSVDIR
  1266'   C9                    	RET
  1267'                         ZREST:
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  1267'   2A 2DEE'              	LHLD	ZSVCNT
  126A'   22 2D7B'              	SHLD	CMDCNT
  126D'   2A 2DF0'              	LHLD	ZSVAUX
  1270'   22 0000*              	SHLD	AUXCNT
  1273'   3A 2DF2'              	LDA	ZSVDIR
  1276'   32 0000*              	STA	DIRFLG
  1279'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  127A'                         GZONE:
  127A'   CD 1254'              	CALL	ZSAVE
  127D'   CD 0D68'              	CALL	CURRW
  1280'   6F                    	MOV	L,A
  1281'   26 00                 	MVI	H,0
  1283'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  1286'   CD 1234'              	CALL	FPOS
  1289'   22 0000*              	SHLD	ZTOP
  128C'   32 0002*              	STA	ZTOP+2
  128F'   C3 1267'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  1292'                         GPLACE:
  1292'   CD 1254'              	CALL	ZSAVE
  1295'   CD 1231'              	CALL	CURFP
  1298'   EB                    	XCHG
  1299'   2A 0000*              	LHLD	ZTOP
  129C'   EB                    	XCHG
  129D'   4F                    	MOV	C,A		; C:HL = the target's position
  129E'   3A 0002*              	LDA	ZTOP+2
  12A1'   47                    	MOV	B,A		; B:DE = the top's
  12A2'   79                    	MOV	A,C
  12A3'   CD 1227'              	CALL	SUB24
  12A6'   22 2DEB'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  12A9'   DA 12E3'              	JC	GP_UP
  12AC'   B7                    	ORA	A
  12AD'   C2 1329'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  12B0'   3A 0000*              	LDA	NEDIT
  12B3'   87                    	ADD	A
  12B4'   3C                    	INR	A
  12B5'   6F                    	MOV	L,A
  12B6'   26 00                 	MVI	H,0
  12B8'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  12BB'   CD 06C4'              	CALL	GBSUB		; HL = bytes from there to the target
  12BE'   EB                    	XCHG
  12BF'   2A 2DEB'              	LHLD	ZDIF		; HL = bytes from the top to the target
  12C2'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  12C5'   DA 1329'              	JC	GP_MID
  12C8'   CD 06C4'              	CALL	GBSUB		; HL = the top line's start (resident)
  12CB'   01 0000               	LXI	B,0		; BC = lines from the top
  12CE'                         GP_CNT:
  12CE'   7A                    	MOV	A,D
  12CF'   B3                    	ORA	E
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12D0'   CA 12DF'              	JZ	GP_DN
  12D3'   7E                    	MOV	A,M
  12D4'   23                    	INX	H
  12D5'   1B                    	DCX	D
  12D6'   FE 0A                 	CPI	LF
  12D8'   C2 12CE'              	JNZ	GP_CNT
  12DB'   03                    	INX	B
  12DC'   C3 12CE'              	JMP	GP_CNT
  12DF'                         GP_DN:
  12DF'   79                    	MOV	A,C		; the lines from the top one to it
  12E0'   C3 1353'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  12E3'                         GP_UP:
  12E3'   3C                    	INR	A
  12E4'   C2 1329'              	JNZ	GP_MID		; 64K bytes or more above
  12E7'   2A 2DEB'              	LHLD	ZDIF
  12EA'   EB                    	XCHG
  12EB'   21 0000               	LXI	H,0
  12EE'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  12F1'   7C                    	MOV	A,H
  12F2'   B5                    	ORA	L
  12F3'   CA 1329'              	JZ	GP_MID		; exactly 64K
  12F6'   EB                    	XCHG			; DE = bytes to read
  12F7'   AF                    	XRA	A
  12F8'   32 2DED'              	STA	ZLF
  12FB'   CD 0000*              	CALL	RGET0
  12FE'                         GP_RD:
  12FE'   CD 0000*              	CALL	RDGET		; (keeps DE)
  1301'   DA 1329'              	JC	GP_MID
  1304'   FE 0A                 	CPI	LF
  1306'   C2 131A'              	JNZ	GP_RN
  1309'   3A 0000*              	LDA	NEDIT
  130C'   B7                    	ORA	A
  130D'   1F                    	RAR
  130E'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  1310'   E5                    	PUSH	H
  1311'   21 2DED'              	LXI	H,ZLF
  1314'   34                    	INR	M
  1315'   BE                    	CMP	M		; CY iff more lines than that
  1316'   E1                    	POP	H
  1317'   DA 1329'              	JC	GP_MID
  131A'                         GP_RN:
  131A'   1B                    	DCX	D
  131B'   7A                    	MOV	A,D
  131C'   B3                    	ORA	E
  131D'   C2 12FE'              	JNZ	GP_RD
  1320'   3E 01                 	MVI	A,PL_SET	; the top row
  1322'   32 0000*              	STA	PLACE
  1325'   AF                    	XRA	A
  1326'   C3 1333'              	JMP	GP_SET
  1329'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  1329'   3E 02                 	MVI	A,PL_MID
  132B'   32 0000*              	STA	PLACE		; mid-screen, as the rows fall
  132E'   3A 0000*              	LDA	NEDIT
  1331'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  1332'   1F                    	RAR			; (no more lines above it than this)
  1333'                         GP_SET:
  1333'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  1334'   26 00                 	MVI	H,0
  1336'   22 0000*              	SHLD	WINROW
  1339'   21 0000               	LXI	H,0
  133C'   22 0000*              	SHLD	LNDLT
  133F'   CD 07DD'              	CALL	SETFUL		; the window may have paged: full repaint
  1342'                         GP_FIN:
  1342'   CD 1267'              	CALL	ZREST
  1345'   3A 2E16'              	LDA	GPKEEP
  1348'   B7                    	ORA	A
  1349'   CA 089B'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  134C'   AF                    	XRA	A
  134D'   32 2E16'              	STA	GPKEEP
  1350'   C3 05BD'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
                                ; adds LNDLT to it and arrives at the same line.
  1353'                         GP_ONS:
  1353'   6F                    	MOV	L,A
  1354'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  1356'   EB                    	XCHG
  1357'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  135A'   EB                    	XCHG
  135B'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  135E'   22 0000*              	SHLD	LNDLT
  1361'   3E 01                 	MVI	A,R_MOVE
  1363'   32 2D7F'              	STA	RINTENT
  1366'   C3 1342'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  1369'                         OPPEND:
  1369'   AF                    	XRA	A
  136A'   32 2DB5'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  136D'   3A 2DB2'              	LDA	PSAVE
  1370'   FE 63                 	CPI	'c'
  1372'   C2 138F'              	JNZ	OPP_ND
  1375'   79                    	MOV	A,C
  1376'   FE 77                 	CPI	'w'
  1378'   CA 1380'              	JZ	OPP_W
  137B'   FE 57                 	CPI	'W'
  137D'   C2 138F'              	JNZ	OPP_ND
  1380'                         OPP_W:
  1380'   CD 1562'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  1383'   DA 138F'              	JC	OPP_ND
  1386'   79                    	MOV	A,C
  1387'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  1389'   4F                    	MOV	C,A
  138A'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  138C'   32 2DB5'              	STA	CWEOL		;   char for the next word's: see ESTEP
  138F'                         OPP_ND:
  138F'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  1390'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  1392'   C2 13A6'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  1395'   CD 01F9'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  1398'   DA 1436'              	JC	OPABRT
  139B'   79                    	MOV	A,C
  139C'   FE 67                 	CPI	'g'
  139E'   C2 1436'              	JNZ	OPABRT
  13A1'   3E 01                 	MVI	A,PG
  13A3'   32 2DB0'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  13A6'                         OPP_NG:
  13A6'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  13A7'   21 2DB2'              	LXI	H,PSAVE
  13AA'   BE                    	CMP	M
  13AB'   CA 1583'              	JZ	OPLINE
  13AE'   79                    	MOV	A,C		; (OPCLS classifies the key)
  13AF'   CD 1599'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  13B2'   DA 1436'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  13B5'   32 2DB4'              	STA	OPCLSV
  13B8'   47                    	MOV	B,A		; B = the class
  13B9'   3A 2DB2'              	LDA	PSAVE
  13BC'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  13BE'   C2 13CA'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  13C1'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  13C2'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  13C4'   C2 13EC'              	JNZ	OPP_GO
  13C7'   C3 13D5'              	JMP	OPP_NO
  13CA'                         OPP_NC:
  13CA'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  13CC'   C2 13EC'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  13CF'   78                    	MOV	A,B		;   a charwise register would need a type flag
  13D0'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  13D2'   CA 13EC'              	JZ	OPP_GO		;   within a line -- neither of which is built
  13D5'                         OPP_NO:
  13D5'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  13D6'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  13D8'   CA 13E6'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  13DB'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  13DD'   CA 13E6'              	JZ	OPP_SW		;   so swallow it before dropping the command
  13E0'   CD 0326'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  13E3'   C2 1436'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  13E6'                         OPP_SW:
  13E6'   CD 01F9'              	CALL	MKGETK
  13E9'   C3 1436'              	JMP	OPABRT
  13EC'                         OPP_GO:
  13EC'   AF                    	XRA	A
  13ED'   32 2D88'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  13F0'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  13F3'   22 2DB6'              	SHLD	OPSTA
  13F6'   C5                    	PUSH	B
  13F7'   21 2DBA'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  13FA'   CD 0429'              	CALL	FPSTO		;   only good until the motion pages the window
  13FD'   3A 2DB4'              	LDA	OPCLSV
  1400'   FE 02                 	CPI	2
  1402'   CC 1439'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  1405'   C1                    	POP	B
  1406'   21 2CC2'              	LXI	H,CMDTAB
  1409'   CD 00C3'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  140C'   3A 2DB2'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  140F'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1410'   CA 07A0'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  1413'   CD 1465'              	CALL	OPSFIX		; where the start is in the window NOW
  1416'   D2 1481'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  1419'   22 2DB6'              	SHLD	OPSTA
  141C'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  141F'   22 2DB8'              	SHLD	OPEND2
  1422'   3A 2DB2'              	LDA	PSAVE
  1425'   FE 79                 	CPI	'y'
  1427'   CA 1B0A'              	JZ	OPYANK		; a yank takes the span without losing it
  142A'   CD 15D4'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  142D'   3A 2DB2'              	LDA	PSAVE
  1430'   FE 63                 	CPI	'c'
  1432'   C0                    	RNZ
  1433'   C3 18BE'              	JMP	SETINS
  1436'                         OPABRT:				; not a motion -> the operator is dropped and
  1436'   C3 00A6'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  1439'                         OPENDS:
  1439'   2A 2DB6'              	LHLD	OPSTA
  143C'   CD 0624'              	CALL	BOL
  143F'   11 2DBD'              	LXI	D,OPSLO
  1442'   CD 1457'              	CALL	OPE_ST
  1445'   2A 2DB6'              	LHLD	OPSTA
  1448'   CD 0654'              	CALL	NLSTART
  144B'   11 2DC0'              	LXI	D,OPSHI
  144E'   CD 1457'              	CALL	OPE_ST
  1451'   2A 2DB6'              	LHLD	OPSTA
  1454'   C3 0000*              	JMP	GOTO
  1457'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  1457'   D5                    	PUSH	D
  1458'   CD 0000*              	CALL	GOTO
  145B'   E1                    	POP	H
  145C'   C3 0429'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  145F'                         CURBD:
  145F'   CD 1231'              	CALL	CURFP
  1462'   EB                    	XCHG
  1463'   47                    	MOV	B,A
  1464'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  1465'                         OPSFIX:
  1465'   21 2DBA'              	LXI	H,OPSFP
  1468'   CD 03DC'              	CALL	MKLOAD
  146B'   CD 145F'              	CALL	CURBD
  146E'   2A 2E20'              	LHLD	MKPOS
  1471'   3A 2E22'              	LDA	MKPOS+2
  1474'   CD 1227'              	CALL	SUB24
  1477'   B4                    	ORA	H
  1478'   B5                    	ORA	L
  1479'   C2 03E9'              	JNZ	MKWIN
  147C'   CD 0000*              	CALL	CUROFF
  147F'   37                    	STC
  1480'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  1481'                         OPPGD:
  1481'   47                    	MOV	B,A
  1482'   3A 2DB4'              	LDA	OPCLSV
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  1485'   FE 02                 	CPI	2
  1487'   C2 1543'              	JNZ	OPG_NO
  148A'   3A 2DB2'              	LDA	PSAVE
  148D'   FE 64                 	CPI	'd'
  148F'   C2 1543'              	JNZ	OPG_NO
  1492'   04                    	INR	B
  1493'   CA 14A2'              	JZ	OPG_FW
  1496'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  1499'   CD 0624'              	CALL	BOL		;   and the high end is OPSHI as it stands
  149C'   CD 0000*              	CALL	GOTO
  149F'   C3 14BA'              	JMP	OPG_GO
  14A2'                         OPG_FW:
  14A2'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  14A5'   CD 0654'              	CALL	NLSTART		;   landed on, and the low one is where the
  14A8'   11 2DC0'              	LXI	D,OPSHI		;   start line began
  14AB'   CD 1457'              	CALL	OPE_ST
  14AE'   21 2DBD'              	LXI	H,OPSLO
  14B1'   CD 03DC'              	CALL	MKLOAD
  14B4'   CD 03A9'              	CALL	MKPAGE
  14B7'   CD 0000*              	CALL	GOTO
  14BA'                         OPG_GO:
  14BA'   CD 145F'              	CALL	CURBD
  14BD'   2A 2DC0'              	LHLD	OPSHI
  14C0'   3A 2DC2'              	LDA	OPSHI+2
  14C3'   CD 1227'              	CALL	SUB24		; A:HL = the bytes to take
  14C6'                         OPG_SV:
  14C6'   22 2DC3'              	SHLD	OPTOGO
  14C9'   32 2DC5'              	STA	OPTOGO+2
  14CC'                         OPG_NX:
  14CC'   CD 06A7'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  14CF'   CD 0000*              	CALL	SUBHD
  14D2'   EB                    	XCHG			; DE = what the window holds past the cursor
  14D3'   2A 2DC3'              	LHLD	OPTOGO
  14D6'   3A 2DC5'              	LDA	OPTOGO+2
  14D9'   B7                    	ORA	A
  14DA'   C2 150D'              	JNZ	OPG_PG		; 64K or more to go
  14DD'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  14E0'   DA 150D'              	JC	OPG_PG
  14E3'   CA 150D'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  14E6'                         OPG_FN:				; the rest of it is here
  14E6'   E5                    	PUSH	H
  14E7'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  14EA'   CD 0000*              	CALL	CUROFF
  14ED'   22 2DC6'              	SHLD	OPLO
  14F0'   D1                    	POP	D
  14F1'   19                    	DAD	D
  14F2'   22 2DC8'              	SHLD	OPHI
  14F5'   CD 1707'              	CALL	OPDSPN
  14F8'   CD 0A84'              	CALL	ATEOF
  14FB'   D2 155C'              	JNC	OPMID
  14FE'   CD 1164'              	CALL	ONFST		; deleted to the end of the file: onto the new
  1501'   CA 155C'              	JZ	OPMID		;   last line, if there is one -- and the pager
  1504'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  1507'   CD 0000*              	CALL	SETBWD
  150A'   C3 155C'              	JMP	OPMID
  150D'                         OPG_PG:
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  150D'   7A                    	MOV	A,D
  150E'   B3                    	ORA	E
  150F'   C2 1528'              	JNZ	OPG_DL
  1512'   CD 0A84'              	CALL	ATEOF		; nothing held past the cursor
  1515'   21 0000               	LXI	H,0
  1518'   DA 14E6'              	JC	OPG_FN		; ... and no more to come: the file ran out
  151B'   2B                    	DCX	H
  151C'   CD 0000*              	CALL	SETC0
  151F'   CD 0000*              	CALL	GOLINE
  1522'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  1525'   C3 14CC'              	JMP	OPG_NX
  1528'                         OPG_DL:
  1528'   D5                    	PUSH	D
  1529'   21 FFFF               	LXI	H,0FFFFH
  152C'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  152F'   E1                    	POP	H
  1530'   E5                    	PUSH	H
  1531'   CD 0000*              	CALL	DELFWD
  1534'   D1                    	POP	D
  1535'   06 00                 	MVI	B,0
  1537'   2A 2DC3'              	LHLD	OPTOGO
  153A'   3A 2DC5'              	LDA	OPTOGO+2
  153D'   CD 1227'              	CALL	SUB24
  1540'   C3 14C6'              	JMP	OPG_SV
  1543'                         OPG_NO:
  1543'   0E 07                 	MVI	C,BEL
  1545'   CD 0000*              	CALL	BCONOU
  1548'                         OPG_HM:				; the cursor back where the command found it
  1548'   21 2DBA'              	LXI	H,OPSFP
  154B'   CD 03DC'              	CALL	MKLOAD
  154E'   CD 03A9'              	CALL	MKPAGE
  1551'   CD 0000*              	CALL	GOTO
  1554'   AF                    	XRA	A
  1555'   32 2DB2'              	STA	PSAVE
  1558'   3C                    	INR	A
  1559'   32 2E16'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  155C'                         OPMID:
  155C'   CD 1254'              	CALL	ZSAVE
  155F'   C3 1329'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  1562'                         ONWHIT:
  1562'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1565'   CA 1581'              	JZ	OW_YES
  1568'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  156B'   FE 20                 	CPI	' '
  156D'   CA 1581'              	JZ	OW_YES
  1570'   FE 09                 	CPI	TAB
  1572'   CA 1581'              	JZ	OW_YES
  1575'   FE 0D                 	CPI	CR
  1577'   CA 1581'              	JZ	OW_YES
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  157A'   FE 0A                 	CPI	LF
  157C'   CA 1581'              	JZ	OW_YES
  157F'   B7                    	ORA	A		; a char to change: CY clear
  1580'   C9                    	RET
  1581'                         OW_YES:
  1581'   37                    	STC
  1582'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  1583'                         OPLINE:
  1583'   3A 2DB2'              	LDA	PSAVE
  1586'   FE 63                 	CPI	'c'
  1588'   CA 07A0'              	JZ	SETMOV
  158B'   FE 79                 	CPI	'y'
  158D'   CA 1AE9'              	JZ	VY_YY
  1590'   21 2DBA'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1593'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1596'   C3 1A5F'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  1599'                         OPCLS:
  1599'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  159B'   CA 15A8'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  159E'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  15A0'   C2 15BC'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  15A3'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  15A5'   C3 15AA'              	JMP	OPC_FK
  15A8'                         OPC_SEM:
  15A8'   06 00                 	MVI	B,0		; ';' runs it as it stands
  15AA'                         OPC_FK:
  15AA'   3A 2E0C'              	LDA	FNDKND
  15AD'   B7                    	ORA	A
  15AE'   37                    	STC
  15AF'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  15B0'   A8                    	XRA	B		; ... and now the direction ',' asked for
  15B1'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  15B3'   CA 15BA'              	JZ	OPC_EXC
  15B6'   3E 01                 	MVI	A,1
  15B8'   B7                    	ORA	A		; CY clear: a motion, class 1
  15B9'   C9                    	RET
  15BA'                         OPC_EXC:
  15BA'   AF                    	XRA	A		; class 0, CY clear
  15BB'   C9                    	RET
  15BC'                         OPC_TB:
  15BC'   47                    	MOV	B,A
  15BD'   21 179C'              	LXI	H,OPCTAB
  15C0'                         OPC_LP:
  15C0'   7E                    	MOV	A,M
  15C1'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  15C2'   CA 15D2'              	JZ	OPC_MS		; end of table -> not a motion
  15C5'   B8                    	CMP	B
  15C6'   CA 15CE'              	JZ	OPC_HT
  15C9'   23                    	INX	H
  15CA'   23                    	INX	H
  15CB'   C3 15C0'              	JMP	OPC_LP
  15CE'                         OPC_HT:
  15CE'   23                    	INX	H
  15CF'   7E                    	MOV	A,M		; class byte
  15D0'   B7                    	ORA	A		; clear CY
  15D1'   C9                    	RET
  15D2'                         OPC_MS:
  15D2'   37                    	STC
  15D3'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  15D4'                         OPAPPL:
  15D4'   3A 2DB4'              	LDA	OPCLSV
  15D7'   FE 02                 	CPI	2
  15D9'   CA 1770'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  15DC'   2A 2DB6'              	LHLD	OPSTA
  15DF'   EB                    	XCHG			; DE = start
  15E0'   2A 2DB8'              	LHLD	OPEND2		; HL = end
  15E3'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  15E6'   DA 15F9'              	JC	OPA_F
  15E9'   CA 15F9'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  15EC'   22 2DC6'              	SHLD	OPLO
  15EF'   EB                    	XCHG
  15F0'   22 2DC8'              	SHLD	OPHI
  15F3'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  15F6'   C3 16B0'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  15F9'                         OPA_F:
  15F9'   EB                    	XCHG			; HL = start, DE = end
  15FA'   22 2DC6'              	SHLD	OPLO
  15FD'   EB                    	XCHG			; HL = end
  15FE'   3A 2DB4'              	LDA	OPCLSV
  1601'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1603'   CA 16AD'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  1606'   FE 01                 	CPI	1
  1608'   C2 162A'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  160B'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  160C'   22 2DC8'              	SHLD	OPHI		; park it: CEND clobbers DE
  160F'   2B                    	DCX	H		; the line it landed on
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  1610'   CD 183C'              	CALL	CEND		; HL = that line's content end
  1613'   EB                    	XCHG			; DE = it
  1614'   2A 2DC8'              	LHLD	OPHI		; HL = hi
  1617'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  161A'   D2 1635'              	JNC	OPA_HI		; hi is inside the line: keep it
  161D'   2A 2DC6'              	LHLD	OPLO
  1620'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1623'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  1626'   EB                    	XCHG			; HL = the content end: the span stops there
  1627'   C3 1635'              	JMP	OPA_HI
  162A'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  162A'   22 2DC8'              	SHLD	OPHI
  162D'   3A 2D88'              	LDA	WPULL
  1630'   B7                    	ORA	A
  1631'   CA 16B0'              	JZ	OPA_C1
  1634'   23                    	INX	H
  1635'                         OPA_HI:
  1635'   22 2DC8'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  1638'                         OPA_DO:
  1638'   CD 16FC'              	CALL	OPSPNL
  163B'   7C                    	MOV	A,H
  163C'   B5                    	ORA	L
  163D'   C2 1646'              	JNZ	OPA_D1
  1640'   2A 2DC6'              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  1643'   C3 0000*              	JMP	GOTO		;   to where the span starts
  1646'                         OPA_D1:
  1646'   3A 2DB2'              	LDA	PSAVE
  1649'   FE 63                 	CPI	'c'
  164B'   CA 1707'              	JZ	OPDSPN
  164E'   CD 16EF'              	CALL	SPNBRK
  1651'   D2 1672'              	JNC	OPA_D2
  1654'   2A 2DC8'              	LHLD	OPHI
  1657'   CD 183C'              	CALL	CEND
  165A'   EB                    	XCHG			; DE = the content end of the line it ends in
  165B'   2A 2DC8'              	LHLD	OPHI
  165E'                         OPA_BL:
  165E'   CD 0000*              	CALL	CMP16
  1661'   CA 1678'              	JZ	OPA_BI		; only blanks after it
  1664'   D5                    	PUSH	D
  1665'   E5                    	PUSH	H
  1666'   CD 0000*              	CALL	CHARAT
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  1669'   E1                    	POP	H
  166A'   D1                    	POP	D
  166B'   23                    	INX	H
  166C'   CD 16A7'              	CALL	BLANKQ
  166F'   CA 165E'              	JZ	OPA_BL
  1672'                         OPA_D2:
  1672'   CD 1707'              	CALL	OPDSPN
  1675'   C3 184D'              	JMP	CLAMPE
  1678'                         OPA_BI:
  1678'   CD 168A'              	CALL	LOIND
  167B'   C2 1672'              	JNZ	OPA_D2
  167E'   2A 2DC8'              	LHLD	OPHI
  1681'   CD 0654'              	CALL	NLSTART
  1684'   22 2DC8'              	SHLD	OPHI
  1687'   C3 16DB'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  168A'                         LOIND:
  168A'   2A 2DC6'              	LHLD	OPLO
  168D'   CD 0624'              	CALL	BOL
  1690'                         LI_LP:
  1690'   E5                    	PUSH	H
  1691'   EB                    	XCHG
  1692'   2A 2DC6'              	LHLD	OPLO
  1695'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  1698'   E1                    	POP	H
  1699'   C8                    	RZ
  169A'   E5                    	PUSH	H
  169B'   CD 0000*              	CALL	CHARAT
  169E'   E1                    	POP	H
  169F'   23                    	INX	H
  16A0'   CD 16A7'              	CALL	BLANKQ
  16A3'   CA 1690'              	JZ	LI_LP
  16A6'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  16A7'                         BLANKQ:
  16A7'   FE 20                 	CPI	' '
  16A9'   C8                    	RZ
  16AA'   FE 09                 	CPI	TAB
  16AC'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  16AD'                         OPA_JP:
  16AD'   22 2DC8'              	SHLD	OPHI
  16B0'                         OPA_C1:
  16B0'   CD 16FC'              	CALL	OPSPNL
  16B3'   7C                    	MOV	A,H
  16B4'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  16B5'   CA 1638'              	JZ	OPA_DO		; nothing spanned
  16B8'   2A 2DC8'              	LHLD	OPHI
  16BB'   CD 0624'              	CALL	BOL
  16BE'   EB                    	XCHG
  16BF'   2A 2DC8'              	LHLD	OPHI
  16C2'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  16C5'   C2 1638'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  16C8'   CD 168A'              	CALL	LOIND
  16CB'   CA 16DB'              	JZ	C1_LW		; only blanks before lo: whole lines
  16CE'                         C1_CH:
  16CE'   2A 2DC8'              	LHLD	OPHI		; back over the line break to the content end
  16D1'   2B                    	DCX	H		;   of the line before
  16D2'   CD 183C'              	CALL	CEND
  16D5'   22 2DC8'              	SHLD	OPHI
  16D8'   C3 1638'              	JMP	OPA_DO
  16DB'                         C1_LW:
  16DB'   2A 2DC6'              	LHLD	OPLO
  16DE'   CD 0624'              	CALL	BOL
  16E1'   22 2DC6'              	SHLD	OPLO
  16E4'   3A 2DB2'              	LDA	PSAVE
  16E7'   FE 63                 	CPI	'c'
  16E9'   CA 16CE'              	JZ	C1_CH
  16EC'   C3 1783'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  16EF'                         SPNBRK:
  16EF'   2A 2DC6'              	LHLD	OPLO
  16F2'   CD 0637'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  16F5'   EB                    	XCHG			; DE = it
  16F6'   2A 2DC8'              	LHLD	OPHI
  16F9'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  16FC'                         OPSPNL:
  16FC'   2A 2DC8'              	LHLD	OPHI
  16FF'   EB                    	XCHG
  1700'   2A 2DC6'              	LHLD	OPLO
  1703'   EB                    	XCHG			; HL = hi, DE = lo
  1704'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  1707'                         OPDSPN:
  1707'   CD 16EF'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  170A'   F5                    	PUSH	PSW
  170B'   2A 2DC6'              	LHLD	OPLO
  170E'   CD 0000*              	CALL	GOTO
  1711'   CD 16FC'              	CALL	OPSPNL		; HL = hi - lo
  1714'   CD 0000*              	CALL	DELFWD
  1717'   CD 0174'              	CALL	MARKMOD
  171A'   F1                    	POP	PSW
  171B'   DA 07DD'              	JC	SETFUL		; a break went: every row below it moved up
  171E'   C3 07A6'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


                                				;   for a word was the whole cost of these
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  1721'                         UNDFNB:
  1721'   CD 0000*              	CALL	CUROFF
  1724'   E5                    	PUSH	H
  1725'   CD 089B'              	CALL	FNBLNK
  1728'   CD 0000*              	CALL	CUROFF
  172B'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  172C'   CD 0000*              	CALL	CMP16
  172F'   D2 0000*              	JNC	UNDHER
  1732'   EB                    	XCHG
  1733'   CD 0000*              	CALL	GOTO
  1736'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  1739'                         OPALSP:
  1739'   2A 2DB6'              	LHLD	OPSTA
  173C'   EB                    	XCHG
  173D'   2A 2DB8'              	LHLD	OPEND2
  1740'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  1743'   DA 1753'              	JC	OPAL_F
  1746'   22 2DC6'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1749'   EB                    	XCHG
  174A'   22 2DC8'              	SHLD	OPHI		; hi-src = start
  174D'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  1750'   C3 175D'              	JMP	OPAL_R
  1753'                         OPAL_F:
  1753'   EB                    	XCHG			; HL = start
  1754'   22 2DC6'              	SHLD	OPLO		; lo-src = start
  1757'   2A 2DB8'              	LHLD	OPEND2
  175A'   22 2DC8'              	SHLD	OPHI		; hi-src = end
  175D'                         OPAL_R:
  175D'   2A 2DC6'              	LHLD	OPLO
  1760'   CD 0624'              	CALL	BOL
  1763'   22 2DC6'              	SHLD	OPLO		; lo = BOL(low line)
  1766'   2A 2DC8'              	LHLD	OPHI
  1769'   CD 0654'              	CALL	NLSTART
  176C'   22 2DC8'              	SHLD	OPHI		; hi = start of line past the high line
  176F'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  1770'                         OPALIN:
  1770'   CD 1739'              	CALL	OPALSP
  1773'   2A 2DC6'              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  1776'   CD 0654'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  1779'   EB                    	XCHG			;   the column)
  177A'   2A 2DC8'              	LHLD	OPHI
  177D'   CD 0000*              	CALL	CMP16
  1780'   CC 1721'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  1783'                         OPDLIN:
  1783'   CD 1707'              	CALL	OPDSPN
  1786'   CD 06A7'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1789'   DA 1799'              	JC	OPDL_NB
  178C'   CD 0000*              	CALL	LOGLEN
  178F'   7C                    	MOV	A,H
  1790'   B5                    	ORA	L
  1791'   C8                    	RZ			; empty buffer
  1792'   2B                    	DCX	H
  1793'   CD 0624'              	CALL	BOL
  1796'   CD 0000*              	CALL	GOTO
  1799'                         OPDL_NB:
  1799'   C3 089B'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  179C'                         OPCTAB:
  179C'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  17A0'   62 00 42 00           
  17A4'   68 00 6C 00           
  17A8'   30 00 5E 00           
  17AC'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  17AE'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  17B2'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  17B6'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  17BA'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  17BE'   24 01                 
  17C0'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  17C4'   47 02 48 02           
  17C8'   4D 02 4C 02           
  17CC'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  17CE'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  17D0'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  17D1'                         VCB_C:
  17D1'   CD 17DD'              	CALL	VCB_CD
  17D4'   C3 18BE'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  17D7'                         VCB_D:
  17D7'   CD 17DD'              	CALL	VCB_CD
  17DA'   C3 184D'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  17DD'                         VCB_CD:
  17DD'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  17E0'   22 2DC6'              	SHLD	OPLO
  17E3'   CD 0000*              	CALL	CUROFF
  17E6'   CD 183C'              	CALL	CEND		; to the line's content end, the CR,LF left
  17E9'   22 2DC8'              	SHLD	OPHI
  17EC'   C3 1707'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  17EF'                         VC_X:
  17EF'   CD 094D'              	CALL	GLSTAL
  17F2'   CD 07A6'              	CALL	SETLIN
  17F5'   CD 06CB'              	CALL	GETCNT
  17F8'   22 2DCA'              	SHLD	CNTV
  17FB'   CD 0000*              	CALL	CUROFF
  17FE'   22 2DCE'              	SHLD	WKI		; cur
  1801'   CD 183C'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  1804'   EB                    	XCHG			; DE = contentend
  1805'   2A 2DCE'              	LHLD	WKI		; HL = cur
  1808'   EB                    	XCHG			; HL = contentend, DE = cur
  1809'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  180C'   7C                    	MOV	A,H
  180D'   B5                    	ORA	L
  180E'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  180F'   EB                    	XCHG			; DE = available
  1810'   2A 2DCA'              	LHLD	CNTV		; HL = count
  1813'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  1816'   DA 181C'              	JC	VX_USEA
  1819'   C3 181D'              	JMP	VX_DEL		; count <= available -> HL = count = del
  181C'                         VX_USEA:
  181C'   EB                    	XCHG			; HL = available
  181D'                         VX_DEL:
                                	;--- plain chars, and plain chars after them: the terminal can close
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


                                	;    the cells up itself (R_DCH).  A TAB there would change width. ---
  181D'   E5                    	PUSH	H
  181E'   CD 07E3'              	CALL	TAILTAB
  1821'   E1                    	POP	H
  1822'   B4                    	ORA	H		; (or more of them than a byte counts)
  1823'   C2 1833'              	JNZ	VX_D1
  1826'   7D                    	MOV	A,L
  1827'   32 2D82'              	STA	DCHN
  182A'   AF                    	XRA	A
  182B'   32 2D83'              	STA	DCHBS
  182E'   3E 07                 	MVI	A,R_DCH
  1830'   32 2D7F'              	STA	RINTENT
  1833'                         VX_D1:
  1833'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  1836'   CD 0174'              	CALL	MARKMOD
  1839'   C3 184D'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  183C'                         CEND:
  183C'   CD 0637'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  183F'   7C                    	MOV	A,H
  1840'   B5                    	ORA	L
  1841'   C8                    	RZ			; the start of the text: nothing before it
  1842'   2B                    	DCX	H
  1843'   E5                    	PUSH	H
  1844'   CD 0000*              	CALL	CHARAT
  1847'   E1                    	POP	H		; HL = term-1
  1848'   FE 0D                 	CPI	CR
  184A'   C8                    	RZ			; a CR before the LF -> the content ends there
  184B'   23                    	INX	H
  184C'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  184D'                         CLAMPE:
  184D'   CD 0000*              	CALL	CUROFF
  1850'   E5                    	PUSH	H
  1851'   CD 0663'              	CALL	EOLC
  1854'   D1                    	POP	D		; DE = cur
  1855'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  1858'   D8                    	RC
  1859'   C8                    	RZ
  185A'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  185D'                         VC_I:
  185D'   CD 06CB'              	CALL	GETCNT
  1860'   C3 18BB'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


                                ; over a CR would put the text between the CR and its LF.
  1863'                         VC_A:
  1863'   CD 06CB'              	CALL	GETCNT
  1866'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1869'   CA 1880'              	JZ	VA_INS
  186C'   EB                    	XCHG			; HL = cur
  186D'   E5                    	PUSH	H
  186E'   CD 0000*              	CALL	CHARAT
  1871'   E1                    	POP	H
  1872'   FE 0A                 	CPI	LF
  1874'   CA 1880'              	JZ	VA_INS		; on the line terminator -> append in place
  1877'   FE 0D                 	CPI	CR
  1879'   CA 1880'              	JZ	VA_INS
  187C'   23                    	INX	H
  187D'   CD 0000*              	CALL	GOTO
  1880'                         VA_INS:
  1880'   C3 18BB'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1883'                         VCB_A:
  1883'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1886'   CD 0663'              	CALL	EOLC		; HL = last content char (the start when empty)
  1889'   E5                    	PUSH	H
  188A'   CD 0000*              	CALL	CHARAT
  188D'   E1                    	POP	H
  188E'   FE 0D                 	CPI	CR
  1890'   CA 1899'              	JZ	VBA_IN		; an empty line: insert at its start
  1893'   FE 0A                 	CPI	LF
  1895'   CA 1899'              	JZ	VBA_IN
  1898'   23                    	INX	H		; past the last content char
  1899'                         VBA_IN:
  1899'   CD 0000*              	CALL	GOTO
  189C'   C3 18BB'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  189F'                         VCB_I:
  189F'   CD 06CB'              	CALL	GETCNT
  18A2'   CD 089B'              	CALL	FNBLNK
  18A5'   CD 0000*              	CALL	CUROFF
  18A8'   E5                    	PUSH	H
  18A9'   CD 0000*              	CALL	CHARAT
  18AC'   E1                    	POP	H
  18AD'   FE 20                 	CPI	' '
  18AF'   CA 18B7'              	JZ	VBI_SK
  18B2'   FE 09                 	CPI	TAB
  18B4'   C2 18BB'              	JNZ	SETINM
  18B7'                         VBI_SK:
  18B7'   23                    	INX	H		; blanks only: past the last of them
  18B8'   CD 0000*              	CALL	GOTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  18BB'                         SETINM:
  18BB'   CD 07A0'              	CALL	SETMOV
  18BE'                         SETINS:
  18BE'   3E 01                 	MVI	A,EM_INS
  18C0'   32 2D7A'              	STA	EDMODE
  18C3'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  18C4'                         ATCEND:
  18C4'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  18C7'   C8                    	RZ
  18C8'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  18CB'   FE 0D                 	CPI	CR
  18CD'   C8                    	RZ
  18CE'   FE 0A                 	CPI	LF
  18D0'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  18D1'                         OPNBRK:
  18D1'   CD 21F7'              	CALL	PUTBRK
  18D4'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  18D7'   23                    	INX	H
  18D8'   22 0000*              	SHLD	LNDLT
  18DB'   C3 0174'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  18DE'                         ENDBRK:
  18DE'   CD 06A7'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  18E1'   C0                    	RNZ
  18E2'   CD 18D1'              	CALL	OPNBRK
  18E5'   CD 0000*              	CALL	CUROFF
  18E8'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  18E9'   2B                    	DCX	H		;   line, with its own terminator after it
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  18EA'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  18ED'                         VC_O:
  18ED'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  18F0'   CD 183C'              	CALL	CEND
  18F3'   CD 0000*              	CALL	GOTO
  18F6'   CD 18D1'              	CALL	OPNBRK
  18F9'   CD 18DE'              	CALL	ENDBRK		; a last line with no line end: the opened line
  18FC'   CD 07C8'              	CALL	SETILN		;   needs a terminator of its own to exist
  18FF'   C3 18BE'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1902'                         VCB_O:
  1902'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1905'   CD 0624'              	CALL	BOL
  1908'   CD 0000*              	CALL	GOTO
  190B'   CD 18D1'              	CALL	OPNBRK
  190E'   CD 0000*              	CALL	CUROFF
  1911'   2B                    	DCX	H
  1912'   2B                    	DCX	H
  1913'   CD 0000*              	CALL	GOTO
  1916'   CD 07C8'              	CALL	SETILN
  1919'   C3 18BE'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  191C'                         VCB_J:
  191C'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  191F'   CD 183C'              	CALL	CEND		; the join point: this line's content end
  1922'   22 2DC6'              	SHLD	OPLO
  1925'   CD 0000*              	CALL	CUROFF
  1928'   CD 0654'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  192B'   E5                    	PUSH	H
  192C'   CD 0000*              	CALL	LOGLEN
  192F'   D1                    	POP	D		; DE = that start
  1930'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1933'   CA 07A0'              	JZ	SETMOV
  1936'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1937'                         VJ_WS:
  1937'   E5                    	PUSH	H
  1938'   CD 0000*              	CALL	LOGLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  193B'   D1                    	POP	D		; DE = the scan
  193C'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  193F'   CA 1956'              	JZ	VJ_DEL
  1942'   EB                    	XCHG			; HL = the scan
  1943'   E5                    	PUSH	H
  1944'   CD 0000*              	CALL	CHARAT
  1947'   E1                    	POP	H
  1948'   FE 20                 	CPI	' '
  194A'   CA 1952'              	JZ	VJ_SKIP
  194D'   FE 09                 	CPI	TAB
  194F'   C2 1956'              	JNZ	VJ_DEL
  1952'                         VJ_SKIP:
  1952'   23                    	INX	H
  1953'   C3 1937'              	JMP	VJ_WS
  1956'                         VJ_DEL:
  1956'   22 2DC8'              	SHLD	OPHI
  1959'   CD 1707'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  195C'   CD 07D7'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  195F'   CD 06A7'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1962'   CA 184D'              	JZ	CLAMPE
  1965'   CD 06B2'              	CALL	CURCHR		; the first char of what was appended
  1968'   FE 0D                 	CPI	CR
  196A'   CA 184D'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  196D'   FE 0A                 	CPI	LF
  196F'   CA 184D'              	JZ	CLAMPE
  1972'   FE 29                 	CPI	')'
  1974'   CA 184D'              	JZ	CLAMPE		; vim puts no space before a ')'
  1977'   CD 0000*              	CALL	CUROFF
  197A'   7C                    	MOV	A,H
  197B'   B5                    	ORA	L
  197C'   CA 1992'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  197F'   2B                    	DCX	H
  1980'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1983'   FE 20                 	CPI	' '
  1985'   CA 184D'              	JZ	CLAMPE
  1988'   FE 09                 	CPI	TAB
  198A'   CA 184D'              	JZ	CLAMPE
  198D'   FE 0A                 	CPI	LF
  198F'   CA 184D'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1992'                         VJ_SP:
  1992'   3E 20                 	MVI	A,' '
  1994'   CD 0000*              	CALL	PUTGAP
  1997'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  199A'   2B                    	DCX	H
  199B'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  199E'                         VC_TILD:
  199E'   CD 06CB'              	CALL	GETCNT
  19A1'   CD 07A6'              	CALL	SETLIN		; only this row changes
  19A4'   CD 094D'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  19A7'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  19AA'   CA 07A0'              	JZ	SETMOV
  19AD'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  19B0'   FE 0D                 	CPI	CR
  19B2'   CA 07A0'              	JZ	SETMOV		; the line's end: nothing to toggle
  19B5'   FE 0A                 	CPI	LF
  19B7'   CA 07A0'              	JZ	SETMOV
  19BA'   47                    	MOV	B,A
  19BB'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  19BD'   FE 41                 	CPI	'A'
  19BF'   DA 19CB'              	JC	VT_PUT		; below 'A': no case
  19C2'   FE 5B                 	CPI	'Z'+1
  19C4'   D2 19CB'              	JNC	VT_PUT		; above 'Z': no case
  19C7'   78                    	MOV	A,B
  19C8'   EE 20                 	XRI	20H		; a letter: flip the case bit
  19CA'   47                    	MOV	B,A
  19CB'                         VT_PUT:
  19CB'   78                    	MOV	A,B
  19CC'   32 2DD7'              	STA	VRCH		; the calls below do not preserve B
  19CF'   CD 0174'              	CALL	MARKMOD
  19D2'   21 0001               	LXI	H,1
  19D5'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  19D8'   3A 2DD7'              	LDA	VRCH
  19DB'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  19DE'   C3 184D'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  19E1'                         VC_R:
  19E1'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  19E4'   3E 03                 	MVI	A,PR
  19E6'   32 2DAF'              	STA	GPEND
  19E9'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  19EA'                         VR_DO:
  19EA'   AF                    	XRA	A
  19EB'   32 2DAF'              	STA	GPEND
  19EE'   79                    	MOV	A,C
  19EF'   32 2DD7'              	STA	VRCH		; the calls below do not preserve C
  19F2'   CD 07A6'              	CALL	SETLIN		; only this row changed
  19F5'   CD 094D'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  19F8'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  19FB'   CA 07A0'              	JZ	SETMOV		; the end of the text: vim does nothing
  19FE'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  1A01'   FE 0D                 	CPI	CR
  1A03'   CA 07A0'              	JZ	SETMOV		; the line's end: nothing to replace
  1A06'   FE 0A                 	CPI	LF
  1A08'   CA 07A0'              	JZ	SETMOV
  1A0B'   06 02                 	MVI	B,2		; a cell for a cell: the char is the paint
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1A0D'   CD 07AC'              	CALL	SETCEL
  1A10'   CD 0174'              	CALL	MARKMOD
  1A13'   21 0001               	LXI	H,1
  1A16'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1A19'   3A 2DD7'              	LDA	VRCH
  1A1C'   FE 0D                 	CPI	CR
  1A1E'   CA 1A2B'              	JZ	VR_CR
  1A21'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1A24'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1A27'   2B                    	DCX	H		;   out, which moves every logical offset
  1A28'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1A2B'                         VR_CR:
  1A2B'   CD 18D1'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1A2E'   CD 18DE'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1A31'   CD 07C8'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1A34'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1A36'   32 2D84'              	STA	ILABOV
  1A39'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1A3A'                         VCB_R:
  1A3A'   CD 06CB'              	CALL	GETCNT
  1A3D'   CD 07A0'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1A40'   21 0000               	LXI	H,0
  1A43'   22 2DD8'              	SHLD	RPDEL		; nothing of ours to put back yet
  1A46'   22 2DDA'              	SHLD	RPAPP
  1A49'   3E 02                 	MVI	A,EM_REP
  1A4B'   32 2D7A'              	STA	EDMODE
  1A4E'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1A4F'                         VC_D:
  1A4F'   3E 64                 	MVI	A,'d'
  1A51'   32 2DB1'              	STA	PENDOP
  1A54'   C3 07A0'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1A57'                         VC_C:
  1A57'   3E 63                 	MVI	A,'c'
  1A59'   32 2DB1'              	STA	PENDOP
  1A5C'   C3 07A0'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1A5F'                         VD_DD:
  1A5F'   CD 094D'              	CALL	GLSTAL
  1A62'   CD 06CB'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1A65'   22 2DCA'              	SHLD	CNTV
  1A68'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1A6A'   32 2DB3'              	STA	DDSNG
  1A6D'   2B                    	DCX	H
  1A6E'   7C                    	MOV	A,H
  1A6F'   B5                    	ORA	L
  1A70'   C2 1A7E'              	JNZ	VDD_LS
  1A73'   3E 01                 	MVI	A,1
  1A75'   32 2DB3'              	STA	DDSNG
  1A78'   CD 1721'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1A7B'   C3 1A84'              	JMP	VDD_GO
  1A7E'                         VDD_LS:
  1A7E'   CD 0906'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1A81'   DA 07A0'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1A84'                         VDD_GO:
  1A84'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1A87'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1A8A'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1A8D'   CD 245A'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1A90'   CD 0884'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1A93'   2A 2DCA'              	LHLD	CNTV
  1A96'   CD 0000*              	CALL	SETC0
  1A99'                         VDD_FW:
  1A99'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1A9C'   DA 1BEA'              	JC	QREFUS		; ... which has no room for them
  1A9F'   CD 06E0'              	CALL	CNTTST
  1AA2'   C2 1A99'              	JNZ	VDD_FW
  1AA5'   CD 0174'              	CALL	MARKMOD
  1AA8'   CD 0A84'              	CALL	ATEOF
  1AAB'   D2 1AC6'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1AAE'   3E 00                 	MVI	A,0
  1AB0'   32 2DB3'              	STA	DDSNG		; deleted to the end: full repaint
  1AB3'   CD 1164'              	CALL	ONFST
  1AB6'   CA 089B'              	JZ	FNBLNK		; nothing left before it
  1AB9'   21 0001               	LXI	H,1		; onto the new last line
  1ABC'   CD 0000*              	CALL	SETBWD
  1ABF'   2A 0000*              	LHLD	LNDLT
  1AC2'   2B                    	DCX	H
  1AC3'   22 0000*              	SHLD	LNDLT
  1AC6'                         VDD_UP:
  1AC6'   CD 089B'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1AC9'   3A 2DB3'              	LDA	DDSNG
  1ACC'   B7                    	ORA	A
  1ACD'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1ACE'   3E 03                 	MVI	A,R_DLIN
  1AD0'   32 2D7F'              	STA	RINTENT
  1AD3'   C9                    	RET
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1AD4'                         QEMPTY:
  1AD4'   2A 0000*              	LHLD	QBEG
  1AD7'   EB                    	XCHG
  1AD8'   2A 0000*              	LHLD	QEND
  1ADB'   7C                    	MOV	A,H
  1ADC'   BA                    	CMP	D
  1ADD'   C0                    	RNZ
  1ADE'   7D                    	MOV	A,L
  1ADF'   BB                    	CMP	E
  1AE0'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1AE1'                         VC_Y:
  1AE1'   3E 79                 	MVI	A,'y'
  1AE3'   32 2DB1'              	STA	PENDOP
  1AE6'   C3 07A0'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1AE9'                         VY_YY:
  1AE9'   21 2DBA'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1AEC'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1AEF'   CD 0000*              	CALL	CUROFF
  1AF2'   22 2DFB'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1AF5'   CD 0624'              	CALL	BOL
  1AF8'   22 2DFD'              	SHLD	YPT		; where the lines come from, to put them back
  1AFB'   CD 1C50'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1AFE'   CD 1C93'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1B01'   D2 1C57'              	JNC	YNDONE
  1B04'   21 1A5F'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1B07'   C3 1B33'              	JMP	YKGO
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1B0A'                         OPYANK:
  1B0A'   CD 1739'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1B0D'   2A 2DB6'              	LHLD	OPSTA
  1B10'   EB                    	XCHG			; DE = start
  1B11'   2A 2DB8'              	LHLD	OPEND2		; HL = end
  1B14'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1B17'   D2 1B1B'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1B1A'   EB                    	XCHG			; ... otherwise the start is
  1B1B'                         OPY_LO:
  1B1B'   22 2DFB'              	SHLD	YOFF
  1B1E'   2A 2DC6'              	LHLD	OPLO
  1B21'   22 2DFD'              	SHLD	YPT		; where the lines come from, to put them back
  1B24'   CD 1C50'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1B27'   CD 1D0B'              	CALL	YNSPAN		; copied where they lie, if there is room
  1B2A'   D2 1C57'              	JNC	YNDONE
  1B2D'   21 1C11'              	LXI	H,YSPAN
  1B30'   C3 1B33'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1B33'                         YKGO:
  1B33'   22 2E25'              	SHLD	YACT
  1B36'   2A 2DFD'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1B39'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1B3A'   2A 2DFB'              	LHLD	YOFF		;   survive this -- the put-back below can page
  1B3D'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1B40'   22 2E2B'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1B43'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1B46'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1B47'   2A 2DFD'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1B4A'   EB                    	XCHG			;   window as it was, then names other text
  1B4B'   E1                    	POP	H
  1B4C'   CD 0000*              	CALL	SUBHD
  1B4F'   EB                    	XCHG			; DE = how far behind the cursor they start
  1B50'   CD 1231'              	CALL	CURFP
  1B53'   06 00                 	MVI	B,0
  1B55'   CD 1227'              	CALL	SUB24
  1B58'   22 2E2D'              	SHLD	YPFP
  1B5B'   32 2E2F'              	STA	YPFP+2
  1B5E'   3A 2D7E'              	LDA	MODF
  1B61'   32 2DF8'              	STA	YMODF
  1B64'   3A 2DA4'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1B67'   32 2DF9'              	STA	YDCHG		;   a yank must not become the last change
  1B6A'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1B6D'   32 2DFA'              	STA	YURPL		;   back are not a change to undo either
  1B70'   3E 01                 	MVI	A,1
  1B72'   32 0000*              	STA	UNDRPL
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1B75'   32 2E24'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1B78'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1B7B'   22 2E07'              	SHLD	YLDLT
  1B7E'   CD 0000*              	CALL	LOGLEN
  1B81'   22 2E29'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1B84'   2A 2E25'              	LHLD	YACT
  1B87'   CD 1BE9'              	CALL	YCALL		; the lines out of the file, into the register
  1B8A'   3A 2DF3'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1B8D'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1B8F'   CA 1BCD'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1B92'   CD 0000*              	CALL	LOGLEN
  1B95'   EB                    	XCHG
  1B96'   2A 2E29'              	LHLD	YWAS
  1B99'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1B9C'   CA 1BAE'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1B9F'   21 2E2D'              	LXI	H,YPFP		; back to where they came from, by its place in
  1BA2'   CD 03DC'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1BA5'   CD 03A9'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1BA8'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1BAB'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1BAE'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1BAE'   2A 2E2D'              	LHLD	YPFP		;   cursor is still owed its place)
  1BB1'   EB                    	XCHG
  1BB2'   2A 2E2B'              	LHLD	YCOL
  1BB5'   19                    	DAD	D
  1BB6'   22 2E20'              	SHLD	MKPOS
  1BB9'   3A 2E2F'              	LDA	YPFP+2
  1BBC'   CE 00                 	ACI	0
  1BBE'   32 2E22'              	STA	MKPOS+2
  1BC1'   CD 03A9'              	CALL	MKPAGE
  1BC4'   CD 0000*              	CALL	GOTO
  1BC7'                         YK_RST:
  1BC7'   2A 2E07'              	LHLD	YLDLT
  1BCA'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1BCD'                         YK_RF:
  1BCD'   3A 2DF8'              	LDA	YMODF
  1BD0'   32 2D7E'              	STA	MODF
  1BD3'   3A 2DF9'              	LDA	YDCHG
  1BD6'   32 2DA4'              	STA	DOTCHG
  1BD9'   3A 2DFA'              	LDA	YURPL
  1BDC'   32 0000*              	STA	UNDRPL
  1BDF'   AF                    	XRA	A
  1BE0'   32 2E24'              	STA	MKHOLD
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1BE3'   CD 094D'              	CALL	GLSTAL
  1BE6'   C3 07DD'              	JMP	SETFUL		; the cheap paint cannot carry this
  1BE9'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1BEA'                         QREFUS:
  1BEA'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1BED'   CD 1AD4'              	CALL	QEMPTY
  1BF0'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1BF3'   CD 0000*              	CALL	QKILL
  1BF6'   3A 2E24'              	LDA	MKHOLD
  1BF9'   B7                    	ORA	A
  1BFA'   C2 1C09'              	JNZ	QRF_Y
  1BFD'   21 0000*              	LXI	H,MKSAV
  1C00'   11 0000*              	LXI	D,MKTAB
  1C03'   CD 245A'              	CALL	COPY12
  1C06'   CD 0000*              	CALL	UNDCLR
  1C09'                         QRF_Y:
  1C09'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1C0B'   32 2DF3'              	STA	MSGWHT
  1C0E'   C3 1548'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1C11'                         YSPAN:
  1C11'   CD 094D'              	CALL	GLSTAL
  1C14'   CD 16FC'              	CALL	OPSPNL		; HL = the span's length
  1C17'   22 2E27'              	SHLD	YTGT
  1C1A'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  1C1D'   EB                    	XCHG			; DE = it
  1C1E'   2A 2E27'              	LHLD	YTGT
  1C21'   EB                    	XCHG			; HL = the text's, DE = the span's
  1C22'   CD 0000*              	CALL	SUBHD
  1C25'   22 2E27'              	SHLD	YTGT		; what the text is left at when the span is out
  1C28'   2A 2DC6'              	LHLD	OPLO
  1C2B'   CD 0000*              	CALL	GOTO
  1C2E'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1C31'                         YS_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1C31'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1C34'   CD 0000*              	CALL	SETC0
  1C37'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1C3A'   DA 1BEA'              	JC	QREFUS		; ... which has no room for it
  1C3D'   CD 0000*              	CALL	LOGLEN
  1C40'   EB                    	XCHG			; DE = what is left
  1C41'   2A 2E27'              	LHLD	YTGT
  1C44'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1C47'   DA 1C4D'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1C4A'   C2 1C31'              	JNZ	YS_LP		;   but never spin here if it ever did
  1C4D'                         YS_END:
  1C4D'   C3 0174'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1C50'                         YNPRE:
  1C50'   2A 0000*              	LHLD	PGTOPM
  1C53'   22 2E30'              	SHLD	YNPG
  1C56'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1C57'                         YNDONE:
  1C57'   2A 2DFB'              	LHLD	YOFF
  1C5A'   CD 0000*              	CALL	GOTO
  1C5D'   2A 0000*              	LHLD	PGTOPM
  1C60'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1C61'   2A 2E30'              	LHLD	YNPG
  1C64'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1C67'   C2 07DD'              	JNZ	SETFUL		; it moved under us: repaint after all
  1C6A'   C3 07A0'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1C6D'                         YNROOM:
  1C6D'   11 0100               	LXI	D,100H
  1C70'   19                    	DAD	D
  1C71'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1C72'   E5                    	PUSH	H		; the span plus its slack
  1C73'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1C76'   EB                    	XCHG			; HL = free
  1C77'   D1                    	POP	D		; DE = the span plus its slack
  1C78'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1C7B'   DA 1C83'              	JC	YNR_OK
  1C7E'   CA 1C83'              	JZ	YNR_OK
  1C81'   37                    	STC			; not enough: the delete-and-put-back path
  1C82'   C9                    	RET
  1C83'                         YNR_OK:
  1C83'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1C84'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1C85'                         YNGO:
  1C85'   C5                    	PUSH	B
  1C86'   CD 06CB'              	CALL	GETCNT		; spent here: this yank is happening
  1C89'   CD 094D'              	CALL	GLSTAL
  1C8C'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1C8F'   C1                    	POP	B
  1C90'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1C93'                         YNCOPY:
  1C93'   2A 2D7B'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1C96'   7C                    	MOV	A,H		;   the count itself
  1C97'   B5                    	ORA	L
  1C98'   C2 1C9E'              	JNZ	YNC_HV
  1C9B'   21 0001               	LXI	H,1
  1C9E'                         YNC_HV:
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1C9E'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1C9F'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1CA0'   B4                    	ORA	H
  1CA1'   CA 1CAC'              	JZ	YNC_M
  1CA4'   E5                    	PUSH	H
  1CA5'   CD 0906'              	CALL	ONLAST		; vim: a count over one on the last line does
  1CA8'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1CA9'   DA 1CBE'              	JC	YNC_RF
  1CAC'                         YNC_M:
  1CAC'   E5                    	PUSH	H
  1CAD'   CD 0884'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1CB0'   E1                    	POP	H
  1CB1'   CD 1CC6'              	CALL	YNLINE		; BC = the span, measured where it stands
  1CB4'   D8                    	RC			; not measurable here: let the pager answer it
  1CB5'   60                    	MOV	H,B
  1CB6'   69                    	MOV	L,C
  1CB7'   CD 1C6D'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1CBA'   D8                    	RC			; no: the delete-and-put-back path
  1CBB'   C3 1C85'              	JMP	YNGO
  1CBE'                         YNC_RF:
  1CBE'   CD 06CB'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1CC1'   CD 094D'              	CALL	GLSTAL		;   register alone, and that is the command
  1CC4'   B7                    	ORA	A		; NC: done
  1CC5'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1CC6'                         YNLINE:
  1CC6'   22 2E32'              	SHLD	YNCNT		; the lines it still wants
  1CC9'   2A 0000*              	LHLD	GAPEND
  1CCC'                         YNL_LP:
  1CCC'   EB                    	XCHG			; DE = the scan
  1CCD'   2A 0000*              	LHLD	TXTEND
  1CD0'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1CD3'   EB                    	XCHG			; HL = the scan
  1CD4'   D2 1CF4'              	JNC	YNL_EN		; the resident text ran out
  1CD7'   7E                    	MOV	A,M
  1CD8'   23                    	INX	H
  1CD9'   FE 0A                 	CPI	LF
  1CDB'   C2 1CCC'              	JNZ	YNL_LP
  1CDE'   E5                    	PUSH	H
  1CDF'   2A 2E32'              	LHLD	YNCNT
  1CE2'   2B                    	DCX	H
  1CE3'   22 2E32'              	SHLD	YNCNT
  1CE6'   7C                    	MOV	A,H
  1CE7'   B5                    	ORA	L
  1CE8'   E1                    	POP	H
  1CE9'   C2 1CCC'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1CEC'   EB                    	XCHG			; DE = past the last of them
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1CED'   2A 0000*              	LHLD	GAPEND
  1CF0'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1CF1'   C3 1D02'              	JMP	YNL_BC
  1CF4'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1CF4'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1CF7'   C2 1D09'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1CFA'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1CFD'   EB                    	XCHG			;   count clamps to it as vim's does
  1CFE'   2A 0000*              	LHLD	GAPEND
  1D01'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1D02'                         YNL_BC:
  1D02'   CD 0000*              	CALL	SUBHD		; HL = the span
  1D05'   44                    	MOV	B,H
  1D06'   4D                    	MOV	C,L
  1D07'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1D08'   C9                    	RET
  1D09'                         YNL_NO:
  1D09'   37                    	STC
  1D0A'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1D0B'                         YNSPAN:
  1D0B'   CD 16FC'              	CALL	OPSPNL		; HL = the span's length
  1D0E'   44                    	MOV	B,H
  1D0F'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1D10'   CD 1C6D'              	CALL	YNROOM
  1D13'   D8                    	RC			; no room: the delete-and-put-back path
  1D14'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1D15'   2A 2DC6'              	LHLD	OPLO
  1D18'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1D1B'   C1                    	POP	B
  1D1C'   C3 1C85'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1D1F'                         VC_P:
  1D1F'   CD 1AD4'              	CALL	QEMPTY
  1D22'   CA 1DF5'              	JZ	VP_BEL
  1D25'   CD 06CB'              	CALL	GETCNT
  1D28'   22 2DFF'              	SHLD	PCNT
  1D2B'   CD 0000*              	CALL	CUROFF
  1D2E'   CD 0654'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1D31'   C3 1D46'              	JMP	VP_GO
  1D34'                         VCB_P:
  1D34'   CD 1AD4'              	CALL	QEMPTY
  1D37'   CA 1DF5'              	JZ	VP_BEL
  1D3A'   CD 06CB'              	CALL	GETCNT
  1D3D'   22 2DFF'              	SHLD	PCNT
  1D40'   CD 0000*              	CALL	CUROFF
  1D43'   CD 0624'              	CALL	BOL
  1D46'                         VP_GO:
  1D46'   CD 0000*              	CALL	GOTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1D49'   CD 0000*              	CALL	CUROFF
  1D4C'   EB                    	XCHG
  1D4D'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1D50'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1D53'   DA 1D68'              	JC	VP_IN
  1D56'   EB                    	XCHG			; HL = the put point = LOGLEN
  1D57'   7C                    	MOV	A,H
  1D58'   B5                    	ORA	L
  1D59'   CA 1D65'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1D5C'   2B                    	DCX	H
  1D5D'   CD 0000*              	CALL	CHARAT
  1D60'   FE 0A                 	CPI	LF
  1D62'   CA 1D68'              	JZ	VP_IN
  1D65'                         VP_BRK:
  1D65'   CD 18D1'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1D68'                         VP_IN:
  1D68'   21 2E01'              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1D6B'   CD 0429'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1D6E'   CD 127A'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1D71'   2A 0000*              	LHLD	QBEG
  1D74'   EB                    	XCHG
  1D75'   2A 0000*              	LHLD	QEND
  1D78'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1D7B'   EB                    	XCHG
  1D7C'   22 2E04'              	SHLD	PLFS
  1D7F'   2A 2DFF'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1D82'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1D83'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1D84'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1D86'   C2 1D8A'              	JNZ	VP_PZ
  1D89'   7D                    	MOV	A,L
  1D8A'                         VP_PZ:
  1D8A'   32 2E06'              	STA	PCPY
  1D8D'                         VP_LP:
  1D8D'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1D90'   2A 0000*              	LHLD	LNDLT
  1D93'   EB                    	XCHG
  1D94'   2A 2E04'              	LHLD	PLFS
  1D97'   19                    	DAD	D
  1D98'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1D9B'   2A 2DFF'              	LHLD	PCNT
  1D9E'   2B                    	DCX	H
  1D9F'   22 2DFF'              	SHLD	PCNT
  1DA2'   7C                    	MOV	A,H
  1DA3'   B5                    	ORA	L
  1DA4'   C2 1D8D'              	JNZ	VP_LP
  1DA7'   CD 0174'              	CALL	MARKMOD
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1DAA'   21 2E01'              	LXI	H,PPFP
  1DAD'   CD 03DC'              	CALL	MKLOAD
  1DB0'   CD 03E9'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1DB3'   D2 1DE6'              	JNC	VP_PGD
  1DB6'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1DB9'   CD 094D'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1DBC'   3A 2E06'              	LDA	PCPY
  1DBF'   B7                    	ORA	A
  1DC0'   CA 089B'              	JZ	FNBLNK
  1DC3'   2A 2E04'              	LHLD	PLFS
  1DC6'   7C                    	MOV	A,H
  1DC7'   B7                    	ORA	A
  1DC8'   C2 089B'              	JNZ	FNBLNK
  1DCB'   3A 2E06'              	LDA	PCPY
  1DCE'   CD 0F2C'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1DD1'   7C                    	MOV	A,H
  1DD2'   B7                    	ORA	A
  1DD3'   C2 089B'              	JNZ	FNBLNK
  1DD6'   7D                    	MOV	A,L
  1DD7'   B7                    	ORA	A
  1DD8'   CA 089B'              	JZ	FNBLNK
  1DDB'   F5                    	PUSH	PSW
  1DDC'   CD 07C8'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1DDF'   F1                    	POP	PSW
  1DE0'   32 2D80'              	STA	ILN		; ... which the lines put now replace
  1DE3'   C3 089B'              	JMP	FNBLNK
  1DE6'                         VP_PGD:				; the put paged its first line out: page back
  1DE6'   CD 03A9'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1DE9'   CD 0000*              	CALL	GOTO
  1DEC'   CD 094D'              	CALL	GLSTAL
  1DEF'   CD 1292'              	CALL	GPLACE
  1DF2'   C3 07DD'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  1DF5'                         VP_BEL:
  1DF5'   CD 06CB'              	CALL	GETCNT		; the count is spent either way
  1DF8'   0E 07                 	MVI	C,BEL
  1DFA'   CD 0000*              	CALL	BCONOU
  1DFD'   C3 07A0'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  1E00'                         VIREP:
  1E00'   79                    	MOV	A,C
  1E01'   FE 1B                 	CPI	ESC
  1E03'   CA 1F52'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  1E06'   FE 0D                 	CPI	CR
  1E08'   CA 1E7B'              	JZ	VP_CR
  1E0B'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1E0D'   CA 1E7B'              	JZ	VP_CR
  1E10'   FE 08                 	CPI	BS
  1E12'   CA 1E87'              	JZ	VP_BS
  1E15'   FE 7F                 	CPI	DEL
  1E17'   CA 1E87'              	JZ	VP_BS
  1E1A'   32 2DD7'              	STA	VRCH		; the calls below do not preserve C
  1E1D'   CD 07A6'              	CALL	SETLIN		; this row changed
  1E20'   CD 0174'              	CALL	MARKMOD
  1E23'   CD 18C4'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1E26'   CA 1E66'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1E29'   CD 06B2'              	CALL	CURCHR
  1E2C'   06 01                 	MVI	B,1
  1E2E'   CD 07AC'              	CALL	SETCEL
  1E31'   3A 2DD7'              	LDA	VRCH
  1E34'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1E37'   2A 2DD8'              	LHLD	RPDEL
  1E3A'   7C                    	MOV	A,H
  1E3B'   B5                    	ORA	L
  1E3C'   CA 1E52'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1E3F'   2A 0000*              	LHLD	GAPEND
  1E42'   EB                    	XCHG
  1E43'   2A 2DDC'              	LHLD	RPGE
  1E46'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1E49'   CA 1E52'              	JZ	VP_OVW
  1E4C'   21 0000               	LXI	H,0
  1E4F'   22 2DD8'              	SHLD	RPDEL		; the text moved: those originals are gone
  1E52'                         VP_OVW:
  1E52'   21 0001               	LXI	H,1
  1E55'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1E58'   2A 0000*              	LHLD	GAPEND
  1E5B'   22 2DDC'              	SHLD	RPGE
  1E5E'   2A 2DD8'              	LHLD	RPDEL
  1E61'   23                    	INX	H
  1E62'   22 2DD8'              	SHLD	RPDEL
  1E65'   C9                    	RET
  1E66'                         VP_APP:
  1E66'   3E 20                 	MVI	A,' '		; (the cell there is blank)
  1E68'   06 01                 	MVI	B,1
  1E6A'   CD 07AC'              	CALL	SETCEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1E6D'   3A 2DD7'              	LDA	VRCH
  1E70'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1E73'   2A 2DDA'              	LHLD	RPAPP
  1E76'   23                    	INX	H
  1E77'   22 2DDA'              	SHLD	RPAPP
  1E7A'   C9                    	RET
  1E7B'                         VP_CR:
  1E7B'   21 0000               	LXI	H,0
  1E7E'   22 2DD8'              	SHLD	RPDEL		; a line break ends what BS can put back
  1E81'   22 2DDA'              	SHLD	RPAPP
  1E84'   C3 1F0D'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1E87'                         VP_BS:
  1E87'   2A 2DDA'              	LHLD	RPAPP
  1E8A'   7C                    	MOV	A,H
  1E8B'   B5                    	ORA	L
  1E8C'   CA 1E99'              	JZ	VP_BSD
  1E8F'   2B                    	DCX	H
  1E90'   22 2DDA'              	SHLD	RPAPP		; an appended char: it just goes
  1E93'   CD 07A6'              	CALL	SETLIN
  1E96'   C3 0000*              	JMP	DELPRV
  1E99'                         VP_BSD:
  1E99'   2A 2DD8'              	LHLD	RPDEL
  1E9C'   7C                    	MOV	A,H
  1E9D'   B5                    	ORA	L
  1E9E'   CA 1EC5'              	JZ	VP_BSM		; nothing of ours left
  1EA1'   2A 0000*              	LHLD	GAPEND
  1EA4'   EB                    	XCHG
  1EA5'   2A 2DDC'              	LHLD	RPGE
  1EA8'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1EAB'   C2 1EC5'              	JNZ	VP_BSM
  1EAE'   2A 2DD8'              	LHLD	RPDEL
  1EB1'   2B                    	DCX	H
  1EB2'   22 2DD8'              	SHLD	RPDEL
  1EB5'   CD 07A6'              	CALL	SETLIN
  1EB8'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1EBB'   CD 0000*              	CALL	UNDELF		; the original comes back
  1EBE'   2A 0000*              	LHLD	GAPEND
  1EC1'   22 2DDC'              	SHLD	RPGE
  1EC4'   C9                    	RET
  1EC5'                         VP_BSM:
  1EC5'   CD 07A0'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1EC8'   C3 0830'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  1ECB'                         VIINS:
  1ECB'   79                    	MOV	A,C
  1ECC'   FE 1B                 	CPI	ESC
  1ECE'   CA 1F52'              	JZ	VI_ESC
  1ED1'   FE 0D                 	CPI	CR
  1ED3'   CA 1F0D'              	JZ	VI_CR
  1ED6'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1ED8'   CA 1F0D'              	JZ	VI_CR
  1EDB'   FE 08                 	CPI	BS
  1EDD'   CA 1F25'              	JZ	VI_BS
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1EE0'   FE 7F                 	CPI	DEL
  1EE2'   CA 1F25'              	JZ	VI_BS
  1EE5'   79                    	MOV	A,C
  1EE6'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1EE9'   CD 0174'              	CALL	MARKMOD
  1EEC'   CD 07A6'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1EEF'   79                    	MOV	A,C
  1EF0'   FE 20                 	CPI	' '
  1EF2'   D8                    	RC			; control char -> keep R_LINE
  1EF3'   FE 7F                 	CPI	DEL
  1EF5'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1EF6'   CD 07E3'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1EF9'   B7                    	ORA	A
  1EFA'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1EFB'   3E 04                 	MVI	A,R_ICH
  1EFD'   32 2D7F'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1F00'   CD 18C4'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1F03'   3E 00                 	MVI	A,0
  1F05'   C2 1F09'              	JNZ	VI_ICH
  1F08'   3C                    	INR	A
  1F09'                         VI_ICH:
  1F09'   32 2D81'              	STA	ICHAPP
  1F0C'   C9                    	RET
  1F0D'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1F0D'   CD 18C4'              	CALL	ATCEND
  1F10'   3E 00                 	MVI	A,0
  1F12'   CA 1F16'              	JZ	VI_CRS
  1F15'   3C                    	INR	A
  1F16'                         VI_CRS:
  1F16'   F5                    	PUSH	PSW
  1F17'   CD 18D1'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1F1A'   CD 18DE'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1F1D'   CD 07C8'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1F20'   F1                    	POP	PSW
  1F21'   32 2D84'              	STA	ILABOV
  1F24'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1F25'                         VI_BS:
  1F25'   CD 0000*              	CALL	PEEKL
  1F28'   D8                    	RC			; start of the file: nothing to delete
  1F29'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1F2B'   CA 1F4C'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1F2E'   47                    	MOV	B,A		;   and the screen repaints in full.  Any other
  1F2F'   CD 07A6'              	CALL	SETLIN		;   char is inside the row -- redraw just that row
  1F32'   78                    	MOV	A,B
  1F33'   CD 07C1'              	CALL	PLAINQ		; ... or, when it is one cell and no TAB follows
  1F36'   D2 1F4C'              	JNC	VI_BSJ		;   to be drawn up short, let the terminal close
  1F39'   CD 07E3'              	CALL	TAILTAB		;   the cell up (R_DCH, from the left of the
  1F3C'   B7                    	ORA	A		;   cursor)
  1F3D'   C2 1F4C'              	JNZ	VI_BSJ
  1F40'   3C                    	INR	A
  1F41'   32 2D82'              	STA	DCHN
  1F44'   32 2D83'              	STA	DCHBS
  1F47'   3E 07                 	MVI	A,R_DCH
  1F49'   32 2D7F'              	STA	RINTENT
  1F4C'                         VI_BSJ:
  1F4C'   CD 0174'              	CALL	MARKMOD
  1F4F'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1F52'                         VI_ESC:
  1F52'   3E 00                 	MVI	A,EM_CMD
  1F54'   32 2D7A'              	STA	EDMODE
  1F57'   CD 07A0'              	CALL	SETMOV
  1F5A'   CD 0830'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1F5D'   C3 094D'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1F60'                         RDLINE:
  1F60'   EB                    	XCHG			; HL = buffer
  1F61'   22 2DDE'              	SHLD	RLPTR
  1F64'   3E 00                 	MVI	A,0
  1F66'   32 2DE0'              	STA	RLLEN
  1F69'   78                    	MOV	A,B
  1F6A'   32 2DE1'              	STA	RLMAX
  1F6D'   79                    	MOV	A,C
  1F6E'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1F71'                         RL_LP:
  1F71'   CD 0000*              	CALL	GETKEY
  1F74'   FE 1B                 	CPI	ESC
  1F76'   CA 1FC6'              	JZ	RL_CAN
  1F79'   FE 0D                 	CPI	CR
  1F7B'   CA 1FD1'              	JZ	RL_DONE
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  1F7E'   FE 08                 	CPI	BS
  1F80'   CA 1FAE'              	JZ	RL_BS
  1F83'   FE 7F                 	CPI	DEL
  1F85'   CA 1FAE'              	JZ	RL_BS
  1F88'   FE 20                 	CPI	' '
  1F8A'   DA 1F71'              	JC	RL_LP		; control char -> ignore
  1F8D'   3A 2DE0'              	LDA	RLLEN
  1F90'   47                    	MOV	B,A
  1F91'   3A 2DE1'              	LDA	RLMAX
  1F94'   B8                    	CMP	B
  1F95'   CA 1F71'              	JZ	RL_LP		; full -> ignore
  1F98'   2A 2DDE'              	LHLD	RLPTR
  1F9B'   71                    	MOV	M,C
  1F9C'   23                    	INX	H
  1F9D'   22 2DDE'              	SHLD	RLPTR
  1FA0'   3A 2DE0'              	LDA	RLLEN
  1FA3'   3C                    	INR	A
  1FA4'   32 2DE0'              	STA	RLLEN
  1FA7'   79                    	MOV	A,C
  1FA8'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1FAB'   C3 1F71'              	JMP	RL_LP
  1FAE'                         RL_BS:				; WM LINEPOP
  1FAE'   3A 2DE0'              	LDA	RLLEN
  1FB1'   B7                    	ORA	A
  1FB2'   CA 1FC6'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1FB5'   3D                    	DCR	A
  1FB6'   32 2DE0'              	STA	RLLEN
  1FB9'   2A 2DDE'              	LHLD	RLPTR
  1FBC'   2B                    	DCX	H
  1FBD'   22 2DDE'              	SHLD	RLPTR
  1FC0'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1FC3'   C3 1F71'              	JMP	RL_LP
  1FC6'                         RL_CAN:
  1FC6'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1FC8'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1FCB'   CD 07A6'              	CALL	SETLIN		; redraw one row
  1FCE'   3E FF                 	MVI	A,0FFH		; cancelled
  1FD0'   C9                    	RET
  1FD1'                         RL_DONE:
  1FD1'   AF                    	XRA	A
  1FD2'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  1FD3'                         VC_BZ:
  1FD3'   CD 07A0'              	CALL	SETMOV
  1FD6'   3A 2DB0'              	LDA	GSAVE
  1FD9'   FE 02                 	CPI	PZ
  1FDB'   CA 1FE6'              	JZ	VZ_ZZ
  1FDE'   B7                    	ORA	A
  1FDF'   C0                    	RNZ			; 'g' was pending: vim drops both
  1FE0'   3E 02                 	MVI	A,PZ
  1FE2'   32 2DAF'              	STA	GPEND
  1FE5'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  1FE6'                         VZ_ZZ:
  1FE6'   3E 04                 	MVI	A,EO_X
  1FE8'   32 2DE2'              	STA	EXOP
  1FEB'   3E 01                 	MVI	A,1
  1FED'   32 2DF5'              	STA	EXBANG		; no '!'
  1FF0'   AF                    	XRA	A
  1FF1'   32 2DE3'              	STA	EXARG		; no file name
  1FF4'   3A 2D7E'              	LDA	MODF		; as ':x': a changed text is written first
  1FF7'   B7                    	ORA	A
  1FF8'   CA 2139'              	JZ	EX_Q
  1FFB'   C3 20D3'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1FFE'                         VC_EX:
  1FFE'   CD 06CB'              	CALL	GETCNT
  2001'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  2004'   11 0000*              	LXI	D,EXBUF
  2007'   06 28                 	MVI	B,EXMAX
  2009'   0E 3A                 	MVI	C,':'
  200B'   CD 1F60'              	CALL	RDLINE
  200E'   B7                    	ORA	A
  200F'   C0                    	RNZ			; cancelled
  2010'   3A 2DE0'              	LDA	RLLEN
  2013'   5F                    	MOV	E,A
  2014'   16 00                 	MVI	D,0
  2016'   21 0000*              	LXI	H,EXBUF
  2019'   19                    	DAD	D
  201A'   36 00                 	MVI	M,0		; the line ends with a 0
  201C'   21 0000*              	LXI	H,EXBUF
  201F'   CD 25EB'              	CALL	SKIPB
  2022'   C8                    	RZ			; nothing on it
  2023'   22 2DE5'              	SHLD	EXCMD
  2026'   CD 27EF'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  2029'   CD 25EB'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  202C'   56                    	MOV	D,M
  202D'   23                    	INX	H
  202E'   1E 00                 	MVI	E,0
  2030'   CD 25F7'              	CALL	ISLOW
  2033'   DA 203E'              	JC	EX_LK
  2036'   5F                    	MOV	E,A
  2037'   23                    	INX	H
  2038'   CD 25F7'              	CALL	ISLOW
