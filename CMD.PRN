  29D8'   0E09'                 	DW	VC_HFDN
  29DA'   15                    	DB	15H			; ^U -- half page up
  29DB'   0E3D'                 	DW	VC_HFUP
  29DD'   0C                    	DB	0CH			; ^L -- redraw
  29DE'   0EB1'                 	DW	VC_REDR
  29E0'   2E                    	DB	'.'			; '.' -- repeat the last change
  29E1'   0195'                 	DW	VC_DOT
  29E3'   75                    	DB	'u'			; 'u' -- undo (and undo the undo)
  29E4'   050D'                 	DW	VC_UNDO
  29E6'   6D                    	DB	'm'		; m{a-c} -- set a mark
  29E7'   0354'                 	DW	VC_MK
  29E9'   60                    	DB	60H		; `{a-c} -- back to its exact spot
  29EA'   0359'                 	DW	VC_BQ
  29EC'   27                    	DB	27H		; '{a-c} -- back to its line's first non-blank
  29ED'   035E'                 	DW	VC_AQ
  29EF'   00                    	DB	0
                                
  29F0'                         ACTTAB:
  29F0'   04                    	DB	ACT_CURLT
  29F1'   07B3'                 	DW	VC_H
