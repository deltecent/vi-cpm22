  284E'   43 61 6E 27           SNOPN:	DB	'Can''t open file ',0
  2852'   74 20 6F 70           
  2856'   65 6E 20 66           
  285A'   69 6C 65 20           
  285E'   00                    
  285F'   49 6E 76 61           SRNGE:	DB	'Invalid range',0
  2863'   6C 69 64 20           
  2867'   72 61 6E 67           
  286B'   65 00                 
  286D'   44 69 73 6B           SDFUL:	DB	'Disk full',0
  2871'   20 66 75 6C           
  2875'   6C 00                 
                                
                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  0008                          EO_R	EQU	8
  2877'                         EXTAB:
  2877'   77 00 01              	DB	'w',0,EO_W
  287A'   71 00 02              	DB	'q',0,EO_Q
  287D'   77 71 03              	DB	'w','q',EO_WQ
  2880'   78 00 04              	DB	'x',0,EO_X
  2883'   65 00 05              	DB	'e',0,EO_E
  2886'   73 00 06              	DB	's',0,EO_S
  2889'   76 65 07              	DB	'v','e',EO_V
  288C'   72 00 08              	DB	'r',0,EO_R
  288F'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
	MACRO-80 3.44	09-Dec-81	PAGE	1-125


                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  2890'                         EXADDR:
  2890'   AF                    	XRA	A
  2891'   32 2EDE'              	STA	SRNGF
  2894'   7E                    	MOV	A,M
  2895'   FE 25                 	CPI	'%'
  2897'   CA 28C0'              	JZ	EXA_AL
	MACRO-80 3.44	09-Dec-81	PAGE	1-126


  289A'   EB                    	XCHG			; DE walks the line, HL takes the number
  289B'   CD 28D5'              	CALL	EXNUM
  289E'   DA 28BE'              	JC	EXA_NO
  28A1'   22 2EDF'              	SHLD	SRNG1
  28A4'   22 2EE1'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  28A7'   1A                    	LDAX	D
  28A8'   FE 2C                 	CPI	','
  28AA'   C2 28B7'              	JNZ	EXA_YS
  28AD'   13                    	INX	D
  28AE'   CD 28D5'              	CALL	EXNUM
  28B1'   DA 28BE'              	JC	EXA_NO		; ',' with no number: not a range at all
  28B4'   22 2EE1'              	SHLD	SRNG2
  28B7'                         EXA_YS:
  28B7'   EB                    	XCHG
  28B8'   3E 01                 	MVI	A,1
  28BA'   32 2EDE'              	STA	SRNGF
  28BD'   C9                    	RET
  28BE'                         EXA_NO:
  28BE'   EB                    	XCHG
  28BF'   C9                    	RET
  28C0'                         EXA_AL:
  28C0'   23                    	INX	H
  28C1'   E5                    	PUSH	H
  28C2'   21 0001               	LXI	H,1
  28C5'   22 2EDF'              	SHLD	SRNG1
  28C8'   21 FFFF               	LXI	H,0FFFFH
  28CB'   22 2EE1'              	SHLD	SRNG2
  28CE'   E1                    	POP	H
  28CF'   3E 01                 	MVI	A,1
  28D1'   32 2EDE'              	STA	SRNGF
  28D4'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  28D5'                         EXNUM:
  28D5'   1A                    	LDAX	D
  28D6'   D6 30                 	SUI	'0'
  28D8'   D8                    	RC
  28D9'   FE 0A                 	CPI	10
  28DB'   3F                    	CMC
  28DC'   D8                    	RC
  28DD'   21 0000               	LXI	H,0
  28E0'                         EXN_LP:
  28E0'   1A                    	LDAX	D
  28E1'   D6 30                 	SUI	'0'
  28E3'   DA 28FD'              	JC	EXN_DN
  28E6'   FE 0A                 	CPI	10
  28E8'   D2 28FD'              	JNC	EXN_DN
  28EB'   13                    	INX	D
  28EC'   C5                    	PUSH	B
  28ED'   4F                    	MOV	C,A
  28EE'   06 00                 	MVI	B,0		; BC = the digit
  28F0'   D5                    	PUSH	D
  28F1'   54                    	MOV	D,H
  28F2'   5D                    	MOV	E,L
  28F3'   29                    	DAD	H		; *2
	MACRO-80 3.44	09-Dec-81	PAGE	1-127


  28F4'   29                    	DAD	H		; *4
  28F5'   19                    	DAD	D		; *5
  28F6'   29                    	DAD	H		; *10
  28F7'   D1                    	POP	D
  28F8'   09                    	DAD	B
  28F9'   C1                    	POP	B
  28FA'   C3 28E0'              	JMP	EXN_LP
  28FD'                         EXN_DN:
  28FD'   B7                    	ORA	A		; CY clear: there was a number
  28FE'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  28FF'                         EX_S:
  28FF'   7E                    	MOV	A,M
  2900'   B7                    	ORA	A
  2901'   CA 2943'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  2904'   32 2EE3'              	STA	SDELIM
  2907'   23                    	INX	H
  2908'   11 0000*              	LXI	D,SRCHST
  290B'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  290E'   4F                    	MOV	C,A
  290F'   CD 2949'              	CALL	SCOPY
  2912'   78                    	MOV	A,B
  2913'   B7                    	ORA	A
  2914'   CA 2943'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  2917'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  291A'   3E 01                 	MVI	A,1
  291C'   32 2EAB'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  291F'   11 2EF5'              	LXI	D,SREPL
  2922'   0E 24                 	MVI	C,SREPMX
  2924'   CD 2949'              	CALL	SCOPY
  2927'   78                    	MOV	A,B
  2928'   32 2EF4'              	STA	SREPLN
  292B'   AF                    	XRA	A
  292C'   32 2EE4'              	STA	SGFLAG
  292F'   7E                    	MOV	A,M
  2930'   FE 67                 	CPI	'g'
  2932'   C2 293B'              	JNZ	EX_SG
  2935'   23                    	INX	H
  2936'   3E 01                 	MVI	A,1
  2938'   32 2EE4'              	STA	SGFLAG
  293B'                         EX_SG:
  293B'   7E                    	MOV	A,M
  293C'   B7                    	ORA	A
  293D'   C2 26CA'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  2940'   C3 2969'              	JMP	SUBGO
  2943'                         SUBNOP:
  2943'   21 2792'              	LXI	H,SNOPAT
  2946'   C3 26D8'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  2949'                         SCOPY:
  2949'   06 00                 	MVI	B,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-128


  294B'                         SCP_LP:
  294B'   78                    	MOV	A,B
  294C'   B9                    	CMP	C
  294D'   D2 2966'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  2950'   7E                    	MOV	A,M
  2951'   B7                    	ORA	A
  2952'   CA 2966'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  2955'   E5                    	PUSH	H
  2956'   21 2EE3'              	LXI	H,SDELIM
  2959'   BE                    	CMP	M
  295A'   E1                    	POP	H
  295B'   CA 2965'              	JZ	SCP_SK
  295E'   12                    	STAX	D
  295F'   13                    	INX	D
  2960'   23                    	INX	H
  2961'   04                    	INR	B
  2962'   C3 294B'              	JMP	SCP_LP
  2965'                         SCP_SK:
  2965'   23                    	INX	H
  2966'                         SCP_DN:
  2966'   AF                    	XRA	A
  2967'   12                    	STAX	D
  2968'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  2969'                         SUBGO:
  2969'   CD 12F8'              	CALL	GZONE
  296C'   2A 0000*              	LHLD	LNDLT
  296F'   22 2EF2'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  2972'   21 2EEF'              	LXI	H,SOFFS		;   finds nothing puts both back, as the
  2975'   CD 0429'              	CALL	FPSTO		;   search's SN_BAD does
  2978'   AF                    	XRA	A
  2979'   32 2EE5'              	STA	SANY
  297C'   21 0000               	LXI	H,0
  297F'   22 2EE7'              	SHLD	SBACK
  2982'   3A 2EDE'              	LDA	SRNGF
  2985'   B7                    	ORA	A
  2986'   CA 2998'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  2989'   CD 2258'              	CALL	EXRNG		; SLINES = the lines in the range
  298C'   DA 2A14'              	JC	SUBBAD
  298F'   2A 2EDF'              	LHLD	SRNG1
  2992'   CD 1266'              	CALL	GOLN
  2995'   C3 299E'              	JMP	SUBLP
  2998'                         SUB_1L:
  2998'   21 0001               	LXI	H,1
  299B'   22 2EE9'              	SHLD	SLINES
  299E'                         SUBLP:
  299E'   CD 2A1A'              	CALL	SUBLIN		; A = 1 when this line changed
  29A1'   B7                    	ORA	A
  29A2'   CA 29B0'              	JZ	SUB_NX
  29A5'   3E 01                 	MVI	A,1
  29A7'   32 2EE5'              	STA	SANY
	MACRO-80 3.44	09-Dec-81	PAGE	1-129


  29AA'   21 0000               	LXI	H,0
  29AD'   22 2EE7'              	SHLD	SBACK		; the cursor is ON the last line changed
  29B0'                         SUB_NX:
  29B0'   2A 2EE9'              	LHLD	SLINES
  29B3'   2B                    	DCX	H
  29B4'   22 2EE9'              	SHLD	SLINES
  29B7'   7C                    	MOV	A,H
  29B8'   B5                    	ORA	L
  29B9'   CA 29D7'              	JZ	SUBDON		; the range is spent
  29BC'   21 0001               	LXI	H,1
  29BF'   AF                    	XRA	A
  29C0'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  29C3'   3A 2EE5'              	LDA	SANY
  29C6'   B7                    	ORA	A
  29C7'   CA 29D1'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  29CA'   2A 2EE7'              	LHLD	SBACK
  29CD'   23                    	INX	H
  29CE'   22 2EE7'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  29D1'                         SUB_AE:
  29D1'   CD 0B02'              	CALL	ATEOF
  29D4'   D2 299E'              	JNC	SUBLP		; ... unless that ran off the end of the file
  29D7'                         SUBDON:
  29D7'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  29DA'   3A 2EE5'              	LDA	SANY
  29DD'   B7                    	ORA	A
  29DE'   CA 29FC'              	JZ	SUBNFD
  29E1'   3E 01                 	MVI	A,1
  29E3'   32 2E1F'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  29E6'   2A 2EE7'              	LHLD	SBACK
  29E9'   7C                    	MOV	A,H
  29EA'   B5                    	ORA	L
  29EB'   CA 29F6'              	JZ	SUB_PL
  29EE'   3E FF                 	MVI	A,0FFH
  29F0'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  29F3'   CD 0000*              	CALL	CLRCNT
  29F6'                         SUB_PL:
  29F6'   CD 1310'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  29F9'   C3 085D'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  29FC'                         SUBNFD:
  29FC'   21 2EEF'              	LXI	H,SOFFS
  29FF'   CD 03D0'              	CALL	BACKTO
  2A02'   2A 2EF2'              	LHLD	SLDLTS
	MACRO-80 3.44	09-Dec-81	PAGE	1-130


  2A05'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  2A08'   21 2762'              	LXI	H,SNOTFD
  2A0B'   CD 26D8'              	CALL	EXERR
  2A0E'   21 0000*              	LXI	H,SRCHST
  2A11'   C3 26D3'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  2A14'                         SUBBAD:
  2A14'   21 2750'              	LXI	H,SNOT
  2A17'   C3 26CD'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  2A1A'                         SUBLIN:
  2A1A'   AF                    	XRA	A
  2A1B'   32 2EE6'              	STA	SLCHG
  2A1E'   CD 2A99'              	CALL	SUBBOL
  2A21'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  2A24'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  2A24'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  2A27'   DA 2A2F'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  2A2A'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  2A2C'   C2 2A24'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  2A2F'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  2A2F'   CD 0000*              	CALL	CUROFF
  2A32'   E5                    	PUSH	H
  2A33'   CD 18D9'              	CALL	CEND
  2A36'   D1                    	POP	D
  2A37'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  2A3A'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  2A3B'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  2A3E'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  2A3F'   B7                    	ORA	A		;   span is a line, not a pair.)
  2A40'   FA 2A92'              	JM	SUBL_D		; what is left is shorter than the pattern
  2A43'   44                    	MOV	B,H
  2A44'   4D                    	MOV	C,L		; BC = the start positions a match can take
  2A45'   11 0000*              	LXI	D,SRCHST
  2A48'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  2A4B'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  2A4E'   DA 2A92'              	JC	SUBL_D
  2A51'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  2A54'   EB                    	XCHG
  2A55'   2A 0000*              	LHLD	GAPEND
  2A58'   EB                    	XCHG
  2A59'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  2A5C'   EB                    	XCHG
  2A5D'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  2A5E'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  2A61'   D1                    	POP	D
  2A62'   19                    	DAD	D		; ... and so the match's logical offset
	MACRO-80 3.44	09-Dec-81	PAGE	1-131


  2A63'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  2A66'   3A 2EE5'              	LDA	SANY
  2A69'   B7                    	ORA	A
  2A6A'   C2 2A77'              	JNZ	SUBL_C
  2A6D'   3A 2EE6'              	LDA	SLCHG
  2A70'   B7                    	ORA	A
  2A71'   C2 2A77'              	JNZ	SUBL_C
  2A74'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  2A77'                         SUBL_C:
  2A77'   3A 0000*              	LDA	SRCHBF
  2A7A'   6F                    	MOV	L,A
  2A7B'   26 00                 	MVI	H,0
  2A7D'   CD 0000*              	CALL	DELFWD		; the match goes
  2A80'   11 2EF4'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  2A83'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  2A86'                         SUBL_I:
  2A86'   3E 01                 	MVI	A,1
  2A88'   32 2EE6'              	STA	SLCHG
  2A8B'   3A 2EE4'              	LDA	SGFLAG
  2A8E'   B7                    	ORA	A
  2A8F'   C2 2A2F'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  2A92'                         SUBL_D:
  2A92'   CD 2A99'              	CALL	SUBBOL
  2A95'   3A 2EE6'              	LDA	SLCHG
  2A98'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  2A99'                         SUBBOL:
  2A99'   CD 0000*              	CALL	CUROFF
  2A9C'   CD 063D'              	CALL	BOL
  2A9F'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  2AA2'                         VC_SRCH:
  2AA2'   CD 0820'              	CALL	SETMOV
  2AA5'   C5                    	PUSH	B
  2AA6'   CD 074B'              	CALL	GETCNT
  2AA9'   22 2ED4'              	SHLD	SCNT
  2AAC'   C1                    	POP	B
  2AAD'   79                    	MOV	A,C
  2AAE'   FE 2F                 	CPI	'/'
  2AB0'   3E 00                 	MVI	A,0
  2AB2'   CA 2AB7'              	JZ	VS_DIR
  2AB5'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  2AB7'                         VS_DIR:
  2AB7'   32 2EA9'              	STA	SDIR
  2ABA'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2ABD'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2AC0'   47                    	MOV	B,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-132


  2AC1'   CD 2001'              	CALL	RDLINE
  2AC4'   B7                    	ORA	A
  2AC5'   C0                    	RNZ			; cancelled: nothing happens at all
  2AC6'   3A 2E80'              	LDA	RLLEN
  2AC9'   B7                    	ORA	A
  2ACA'   CA 2ADF'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  2ACD'   5F                    	MOV	E,A
  2ACE'   16 00                 	MVI	D,0
  2AD0'   21 0000*              	LXI	H,SRCHST
  2AD3'   19                    	DAD	D
  2AD4'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  2AD6'   7B                    	MOV	A,E
  2AD7'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  2ADA'   3E 01                 	MVI	A,1
  2ADC'   32 2EAB'              	STA	SHAVE
  2ADF'                         VS_OLD:
  2ADF'   3A 2EAB'              	LDA	SHAVE
  2AE2'   B7                    	ORA	A
  2AE3'   CA 2AEF'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  2AE6'   3A 2EA9'              	LDA	SDIR
  2AE9'   32 2EAA'              	STA	SDIRE
  2AEC'   C3 2B18'              	JMP	SRCHN
  2AEF'                         VS_NOP:
  2AEF'   21 2792'              	LXI	H,SNOPAT
  2AF2'   C3 26D8'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  2AF5'                         VC_N:
  2AF5'   CD 0820'              	CALL	SETMOV
  2AF8'   3A 2EA9'              	LDA	SDIR
  2AFB'   C3 2B05'              	JMP	VN_GO
  2AFE'                         VCB_N:
  2AFE'   CD 0820'              	CALL	SETMOV
  2B01'   3A 2EA9'              	LDA	SDIR
  2B04'   2F                    	CMA			; the other way: 0 <-> FFH
  2B05'                         VN_GO:
  2B05'   32 2EAA'              	STA	SDIRE
  2B08'   CD 074B'              	CALL	GETCNT
  2B0B'   22 2ED4'              	SHLD	SCNT
  2B0E'   3A 2EAB'              	LDA	SHAVE
  2B11'   B7                    	ORA	A
  2B12'   CA 2AEF'              	JZ	VS_NOP
  2B15'   C3 2B18'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  2B18'                         SRCHN:
  2B18'   CD 12F8'              	CALL	GZONE		; the screen's top line, before the cursor moves
  2B1B'   CD 0774'              	CALL	BRKON		; where it started (the sweep moves the cursor
                                				;   with PUTCUR, which does not maintain LNDLT;
                                				;   GOTO does), and an ESC may stop it
  2B1E'                         SN_LP:
  2B1E'   CD 2B53'              	CALL	SRCHGO
  2B21'   DA 2B3E'              	JC	SN_BAD
	MACRO-80 3.44	09-Dec-81	PAGE	1-133


  2B24'   2A 2ED4'              	LHLD	SCNT
  2B27'   2B                    	DCX	H
  2B28'   22 2ED4'              	SHLD	SCNT
  2B2B'   7C                    	MOV	A,H
  2B2C'   B5                    	ORA	L
  2B2D'   C2 2B1E'              	JNZ	SN_LP
  2B30'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  2B33'   CD 07B1'              	CALL	BRKOFF
  2B36'   3E 01                 	MVI	A,1
  2B38'   32 2EB6'              	STA	GPKEEP		; land on the match, not the first non-blank
  2B3B'   C3 1310'              	JMP	GPLACE		; (which sets LNDLT itself)
  2B3E'                         SN_BAD:
  2B3E'   CD 07B1'              	CALL	BRKOFF
  2B41'   DA 07C9'              	JC	BRKBAK		; stopped, which is not the same as not found
  2B44'   CD 07BC'              	CALL	RSTPL		; nothing moved: the row the cursor was on
  2B47'   21 2762'              	LXI	H,SNOTFD
  2B4A'   CD 26D8'              	CALL	EXERR
  2B4D'   21 0000*              	LXI	H,SRCHST
  2B50'   C3 26D3'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  2B53'                         SRCHGO:
  2B53'   3E 01                 	MVI	A,1
  2B55'   32 2EDD'              	STA	SSKIP		; this pass starts one past the cursor
  2B58'   CD 2B6E'              	CALL	SRCHW
  2B5B'   D0                    	RNC
  2B5C'   CD 07B5'              	CALL	BRKQ
  2B5F'   D8                    	RC			; stopped: no second pass
  2B60'   3A 2EAA'              	LDA	SDIRE
  2B63'   2F                    	CMA
  2B64'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  2B67'   AF                    	XRA	A
  2B68'   32 2EDD'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  2B6B'   C3 2B6E'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  2B6E'                         SRCHW:
  2B6E'   3A 2EAA'              	LDA	SDIRE
  2B71'   32 0000*              	STA	DIRFLG
  2B74'   21 FFFF               	LXI	H,0FFFFH
  2B77'   22 2E1C'              	SHLD	CMDCNT
  2B7A'   AF                    	XRA	A
  2B7B'   32 0000*              	STA	AUXCNT
  2B7E'                         SW_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-134


  2B7E'   CD 07B5'              	CALL	BRKQ		; an ESC spent the count, here or on the way to
  2B81'   D8                    	RC			;   the wrapped pass: SCRLST no longer pages
  2B82'   CD 2B8E'              	CALL	SRCH1
  2B85'   D0                    	RNC
  2B86'   CD 0000*              	CALL	SCRLST
  2B89'   D2 2B7E'              	JNC	SW_LP
  2B8C'   37                    	STC
  2B8D'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  2B8E'                         SRCH1:
  2B8E'   11 0000*              	LXI	D,SRCHST
  2B91'   3A 0000*              	LDA	DIRFLG
  2B94'   B7                    	ORA	A
  2B95'   FA 2BB9'              	JM	SR1_BK
  2B98'   21 0000*              	LXI	H,GAPEND
  2B9B'   CD 0000*              	CALL	FWDCNT
  2B9E'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  2BA1'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  2BA2'   3A 2EDD'              	LDA	SSKIP
  2BA5'   B7                    	ORA	A
  2BA6'   CA 2BAF'              	JZ	SR1_FW
  2BA9'   78                    	MOV	A,B
  2BAA'   B1                    	ORA	C
  2BAB'   37                    	STC
  2BAC'   C8                    	RZ			; no room for a match even before the skip
  2BAD'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2BAE'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2BAF'                         SR1_FW:
  2BAF'   CD 0000*              	CALL	MATCHF
  2BB2'   D8                    	RC
  2BB3'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2BB6'   C3 0000*              	JMP	PUTCUR
  2BB9'                         SR1_BK:
  2BB9'   21 0000*              	LXI	H,TXTBEG
  2BBC'   CD 0000*              	CALL	FWDCNT
  2BBF'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2BC2'   D8                    	RC
  2BC3'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2BC6'   CD 0000*              	CALL	MATCHB
  2BC9'   D8                    	RC
  2BCA'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
	MACRO-80 3.44	09-Dec-81	PAGE	1-135


                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2BCD'                         MSGNAM:
  2BCD'   E5                    	PUSH	H
  2BCE'   3E 22                 	MVI	A,'"'
  2BD0'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  2BD3'   E1                    	POP	H
  2BD4'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  2BD5'   23                    	INX	H
  2BD6'   7E                    	MOV	A,M
  2BD7'   FE 20                 	CPI	' '
  2BD9'   C2 2BE6'              	JNZ	MN_HAS
  2BDC'   21 2800'              	LXI	H,SNONM
  2BDF'   CD 0000*              	CALL	OUTSTR
  2BE2'   E1                    	POP	H
  2BE3'   C3 2C30'              	JMP	MN_END
  2BE6'                         MN_HAS:
  2BE6'   0E 19                 	MVI	C,BF_CURDSK
  2BE8'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  2BEB'   E1                    	POP	H
  2BEC'   E5                    	PUSH	H
  2BED'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  2BEE'   BE                    	CMP	M
  2BEF'   CA 2BFD'              	JZ	MN_NAM
  2BF2'   7E                    	MOV	A,M
  2BF3'   C6 40                 	ADI	'A'-1
  2BF5'   CD 0000*              	CALL	OUTCH
  2BF8'   3E 3A                 	MVI	A,':'
  2BFA'   CD 0000*              	CALL	OUTCH
  2BFD'                         MN_NAM:
  2BFD'   E1                    	POP	H
  2BFE'   E5                    	PUSH	H
  2BFF'   23                    	INX	H
  2C00'   0E 08                 	MVI	C,8
  2C02'                         MN_NM:
  2C02'   7E                    	MOV	A,M
  2C03'   FE 20                 	CPI	' '
  2C05'   CA 2C10'              	JZ	MN_EXT
  2C08'   CD 0000*              	CALL	OUTCH
  2C0B'   23                    	INX	H
  2C0C'   0D                    	DCR	C
  2C0D'   C2 2C02'              	JNZ	MN_NM
  2C10'                         MN_EXT:
  2C10'   E1                    	POP	H
  2C11'   11 0009               	LXI	D,9
	MACRO-80 3.44	09-Dec-81	PAGE	1-136


  2C14'   19                    	DAD	D		; the type field
  2C15'   7E                    	MOV	A,M
  2C16'   FE 20                 	CPI	' '
  2C18'   CA 2C30'              	JZ	MN_END
  2C1B'   3E 2E                 	MVI	A,'.'
  2C1D'   CD 0000*              	CALL	OUTCH
  2C20'   0E 03                 	MVI	C,3
  2C22'                         MN_XL:
  2C22'   7E                    	MOV	A,M
  2C23'   FE 20                 	CPI	' '
  2C25'   CA 2C30'              	JZ	MN_END
  2C28'   CD 0000*              	CALL	OUTCH
  2C2B'   23                    	INX	H
  2C2C'   0D                    	DCR	C
  2C2D'   C2 2C22'              	JNZ	MN_XL
  2C30'                         MN_END:
  2C30'   3E 22                 	MVI	A,'"'
  2C32'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  2C35'                         MSGFLG:
  2C35'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  2C37'   B7                    	ORA	A
  2C38'   CA 2C48'              	JZ	MF_RO
  2C3B'   3A 2E1F'              	LDA	MODF
  2C3E'   B7                    	ORA	A
  2C3F'   CA 2C48'              	JZ	MF_RO
  2C42'   21 280A'              	LXI	H,SMODM
  2C45'   CD 2C5D'              	CALL	MF_PUT
  2C48'                         MF_RO:
  2C48'   3A 2E96'              	LDA	ROFLAG
  2C4B'   B7                    	ORA	A
  2C4C'   CA 2C55'              	JZ	MF_NEW
  2C4F'   21 2815'              	LXI	H,SROM
  2C52'   CD 2C5D'              	CALL	MF_PUT
  2C55'                         MF_NEW:
  2C55'   3A 2E94'              	LDA	MSGNEW
  2C58'   B7                    	ORA	A
  2C59'   C8                    	RZ
  2C5A'   21 2820'              	LXI	H,SNEWM
  2C5D'                         MF_PUT:
  2C5D'   78                    	MOV	A,B
  2C5E'   B7                    	ORA	A
  2C5F'   C2 2C6B'              	JNZ	MF_STR
  2C62'   06 01                 	MVI	B,1
  2C64'   E5                    	PUSH	H
  2C65'   3E 20                 	MVI	A,' '
  2C67'   CD 0000*              	CALL	OUTCH
  2C6A'   E1                    	POP	H
  2C6B'                         MF_STR:
  2C6B'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
	MACRO-80 3.44	09-Dec-81	PAGE	1-137


                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  2C6E'                         EMITW:
  2C6E'   C5                    	PUSH	B
  2C6F'   D5                    	PUSH	D
  2C70'   06 00                 	MVI	B,0
  2C72'   11 2710               	LXI	D,10000
  2C75'   CD 2C93'              	CALL	EWDIG
  2C78'   11 03E8               	LXI	D,1000
  2C7B'   CD 2C93'              	CALL	EWDIG
  2C7E'   11 0064               	LXI	D,100
  2C81'   CD 2C93'              	CALL	EWDIG
  2C84'   11 000A               	LXI	D,10
  2C87'   CD 2C93'              	CALL	EWDIG
  2C8A'   7D                    	MOV	A,L		; the units digit is always printed
  2C8B'   C6 30                 	ADI	'0'
  2C8D'   CD 0000*              	CALL	OUTCH
  2C90'   D1                    	POP	D
  2C91'   C1                    	POP	B
  2C92'   C9                    	RET
  2C93'                         EWDIG:
  2C93'   0E 00                 	MVI	C,0
  2C95'                         EW_LP:
  2C95'   7D                    	MOV	A,L
  2C96'   93                    	SUB	E
  2C97'   6F                    	MOV	L,A
  2C98'   7C                    	MOV	A,H
  2C99'   9A                    	SBB	D
  2C9A'   67                    	MOV	H,A
  2C9B'   DA 2CA2'              	JC	EW_DN
  2C9E'   0C                    	INR	C
  2C9F'   C3 2C95'              	JMP	EW_LP
  2CA2'                         EW_DN:
  2CA2'   19                    	DAD	D		; one subtraction too many: give it back
  2CA3'   79                    	MOV	A,C
  2CA4'   B7                    	ORA	A
  2CA5'   C2 2CAB'              	JNZ	EW_PR
  2CA8'   78                    	MOV	A,B
  2CA9'   B7                    	ORA	A
  2CAA'   C8                    	RZ			; a leading zero: write nothing
  2CAB'                         EW_PR:
  2CAB'   79                    	MOV	A,C
  2CAC'   C6 30                 	ADI	'0'
  2CAE'   CD 0000*              	CALL	OUTCH
  2CB1'   06 01                 	MVI	B,1
  2CB3'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  2CB4'                         ISEMPT:
  2CB4'   2A 0000*              	LHLD	OUTPOS
  2CB7'   7C                    	MOV	A,H
  2CB8'   B5                    	ORA	L
  2CB9'   C0                    	RNZ
  2CBA'   CD 0000*              	CALL	LOGLEN
  2CBD'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-138


  2CBE'   B5                    	ORA	L
  2CBF'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  2CC0'                         MSGCTG:
  2CC0'   21 0000*              	LXI	H,FNAME
  2CC3'   CD 2BCD'              	CALL	MSGNAM
  2CC6'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  2CC8'   CD 2C35'              	CALL	MSGFLG
  2CCB'   CD 2CB4'              	CALL	ISEMPT
  2CCE'   C2 2CD7'              	JNZ	MG_POS
  2CD1'   21 2833'              	LXI	H,SNOLIN
  2CD4'   C3 0000*              	JMP	OUTSTR
  2CD7'                         MG_POS:
  2CD7'   21 2826'              	LXI	H,SLINE
  2CDA'   CD 0000*              	CALL	OUTSTR
  2CDD'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  2CE0'   23                    	INX	H		;   ... so the line it is on
  2CE1'   CD 2C6E'              	CALL	EMITW
  2CE4'   21 282D'              	LXI	H,SCOLM
  2CE7'   CD 0000*              	CALL	OUTSTR
  2CEA'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  2CED'   23                    	INX	H
  2CEE'   E5                    	PUSH	H
  2CEF'   CD 2C6E'              	CALL	EMITW
  2CF2'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  2CF5'   23                    	INX	H
  2CF6'   D1                    	POP	D
  2CF7'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  2CFA'   C8                    	RZ
  2CFB'   E5                    	PUSH	H
  2CFC'   3E 2D                 	MVI	A,'-'
  2CFE'   CD 0000*              	CALL	OUTCH
  2D01'   E1                    	POP	H
  2D02'   C3 2C6E'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  2D05'                         FILMSG:
  2D05'   3A 0001*              	LDA	FNAME+1
  2D08'   FE 20                 	CPI	' '
  2D0A'   C8                    	RZ
  2D0B'   21 0000*              	LXI	H,FNAME
  2D0E'   CD 2BCD'              	CALL	MSGNAM
  2D11'   AF                    	XRA	A		; nothing has been changed yet
  2D12'   C3 2C35'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  2D15'                         WRMSG:
  2D15'   21 0000*              	LXI	H,TFCB
	MACRO-80 3.44	09-Dec-81	PAGE	1-139


  2D18'   CD 2BCD'              	CALL	MSGNAM
  2D1B'   21 2845'              	LXI	H,SWRIT
  2D1E'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  2D21'                         MSGPST:
  2D21'   3A 2E93'              	LDA	MSGWHT
  2D24'   B7                    	ORA	A
  2D25'   C8                    	RZ
  2D26'   47                    	MOV	B,A
  2D27'   AF                    	XRA	A
  2D28'   32 2E93'              	STA	MSGWHT
  2D2B'   78                    	MOV	A,B
  2D2C'   FE 01                 	CPI	MW_FIL
  2D2E'   CA 2D4A'              	JZ	MP_FIL
  2D31'   FE 02                 	CPI	MW_WRT
  2D33'   CA 2D50'              	JZ	MP_WRT
  2D36'   FE 04                 	CPI	MW_BIG
  2D38'   CA 2D41'              	JZ	MP_BIG
  2D3B'   CD 2CC0'              	CALL	MSGCTG
  2D3E'   C3 0000*              	JMP	SCURS
  2D41'                         MP_BIG:
  2D41'   21 27E1'              	LXI	H,SQBIG
  2D44'   CD 0000*              	CALL	EXMSG
  2D47'   C3 0000*              	JMP	SCURS
  2D4A'                         MP_FIL:
  2D4A'   CD 2D05'              	CALL	FILMSG
  2D4D'   C3 0000*              	JMP	SCURS
  2D50'                         MP_WRT:
  2D50'   CD 2D15'              	CALL	WRMSG
  2D53'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  2D56'                         VC_CTLG:
  2D56'   3E 03                 	MVI	A,MW_CTG
  2D58'   32 2E93'              	STA	MSGWHT
  2D5B'   3E 01                 	MVI	A,R_MOVE
  2D5D'   32 2E20'              	STA	RINTENT
  2D60'   C3 074B'              	JMP	GETCNT		; a count typed before it is spent here, not
                                				;   left for the next command
                                
  2D63'                         CMDTAB:
  2D63'   07                    	DB	07H			; ^G -- where am I?
  2D64'   2D56'                 	DW	VC_CTLG
  2D66'   68                    	DB	'h'
  2D67'   0898'                 	DW	VC_H
  2D69'   6C                    	DB	'l'
  2D6A'   08C2'                 	DW	VC_L
  2D6C'   6A                    	DB	'j'
  2D6D'   0993'                 	DW	VC_J
  2D6F'   6B                    	DB	'k'
  2D70'   09A5'                 	DW	VC_K
  2D72'   30                    	DB	'0'
  2D73'   08F5'                 	DW	VC_0
