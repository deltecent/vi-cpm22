  1BF1'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  1BF2'                         EXADDR:
  1BF2'   AF                    	XRA	A
  1BF3'   32 2269'              	STA	SRNGF
  1BF6'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1BF7'   FE 25                 	CPI	'%'
  1BF9'   CA 1C22'              	JZ	EXA_AL
  1BFC'   EB                    	XCHG			; DE walks the line, HL takes the number
  1BFD'   CD 1C37'              	CALL	EXNUM
  1C00'   DA 1C20'              	JC	EXA_NO
  1C03'   22 226A'              	SHLD	SRNG1
  1C06'   22 226C'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  1C09'   1A                    	LDAX	D
  1C0A'   FE 2C                 	CPI	','
  1C0C'   C2 1C19'              	JNZ	EXA_YS
  1C0F'   13                    	INX	D
  1C10'   CD 1C37'              	CALL	EXNUM
  1C13'   DA 1C20'              	JC	EXA_NO		; ',' with no number: not a range at all
  1C16'   22 226C'              	SHLD	SRNG2
  1C19'                         EXA_YS:
  1C19'   EB                    	XCHG
  1C1A'   3E 01                 	MVI	A,1
  1C1C'   32 2269'              	STA	SRNGF
  1C1F'   C9                    	RET
  1C20'                         EXA_NO:
  1C20'   EB                    	XCHG
  1C21'   C9                    	RET
  1C22'                         EXA_AL:
  1C22'   23                    	INX	H
  1C23'   E5                    	PUSH	H
  1C24'   21 0001               	LXI	H,1
  1C27'   22 226A'              	SHLD	SRNG1
  1C2A'   21 FFFF               	LXI	H,0FFFFH
  1C2D'   22 226C'              	SHLD	SRNG2
  1C30'   E1                    	POP	H
  1C31'   3E 01                 	MVI	A,1
  1C33'   32 2269'              	STA	SRNGF
  1C36'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  1C37'                         EXNUM:
  1C37'   1A                    	LDAX	D
  1C38'   D6 30                 	SUI	'0'
  1C3A'   D8                    	RC
  1C3B'   FE 0A                 	CPI	10
  1C3D'   3F                    	CMC
  1C3E'   D8                    	RC
  1C3F'   21 0000               	LXI	H,0
  1C42'                         EXN_LP:
  1C42'   1A                    	LDAX	D
  1C43'   D6 30                 	SUI	'0'
  1C45'   DA 1C5F'              	JC	EXN_DN
  1C48'   FE 0A                 	CPI	10
  1C4A'   D2 1C5F'              	JNC	EXN_DN
  1C4D'   13                    	INX	D
  1C4E'   C5                    	PUSH	B
  1C4F'   4F                    	MOV	C,A
  1C50'   06 00                 	MVI	B,0		; BC = the digit
  1C52'   D5                    	PUSH	D
  1C53'   54                    	MOV	D,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1C54'   5D                    	MOV	E,L
  1C55'   29                    	DAD	H		; *2
  1C56'   29                    	DAD	H		; *4
  1C57'   19                    	DAD	D		; *5
  1C58'   29                    	DAD	H		; *10
  1C59'   D1                    	POP	D
  1C5A'   09                    	DAD	B
  1C5B'   C1                    	POP	B
  1C5C'   C3 1C42'              	JMP	EXN_LP
  1C5F'                         EXN_DN:
  1C5F'   B7                    	ORA	A		; CY clear: there was a number
  1C60'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  1C61'                         EX_S:
  1C61'   7E                    	MOV	A,M
  1C62'   B7                    	ORA	A
  1C63'   CA 1CA5'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  1C66'   32 226E'              	STA	SDELIM
  1C69'   23                    	INX	H
  1C6A'   11 0000*              	LXI	D,SRCHST
  1C6D'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  1C70'   4F                    	MOV	C,A
  1C71'   CD 1CAB'              	CALL	SCOPY
  1C74'   78                    	MOV	A,B
  1C75'   B7                    	ORA	A
  1C76'   CA 1CA5'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  1C79'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  1C7C'   3E 01                 	MVI	A,1
  1C7E'   32 2253'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  1C81'   11 227B'              	LXI	D,SREPL
  1C84'   0E 24                 	MVI	C,SREPMX
  1C86'   CD 1CAB'              	CALL	SCOPY
  1C89'   78                    	MOV	A,B
  1C8A'   32 227A'              	STA	SREPLN
  1C8D'   AF                    	XRA	A
  1C8E'   32 226F'              	STA	SGFLAG
  1C91'   7E                    	MOV	A,M
  1C92'   FE 67                 	CPI	'g'
  1C94'   C2 1C9D'              	JNZ	EX_SG
  1C97'   23                    	INX	H
  1C98'   3E 01                 	MVI	A,1
  1C9A'   32 226F'              	STA	SGFLAG
  1C9D'                         EX_SG:
  1C9D'   7E                    	MOV	A,M
  1C9E'   B7                    	ORA	A
  1C9F'   C2 1A93'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  1CA2'   C3 1CCB'              	JMP	SUBGO
  1CA5'                         SUBNOP:
  1CA5'   21 1B3F'              	LXI	H,SNOPAT
  1CA8'   C3 1AA1'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1CAB'                         SCOPY:
  1CAB'   06 00                 	MVI	B,0
  1CAD'                         SCP_LP:
  1CAD'   78                    	MOV	A,B
  1CAE'   B9                    	CMP	C
  1CAF'   D2 1CC8'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  1CB2'   7E                    	MOV	A,M
  1CB3'   B7                    	ORA	A
  1CB4'   CA 1CC8'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  1CB7'   E5                    	PUSH	H
  1CB8'   21 226E'              	LXI	H,SDELIM
  1CBB'   BE                    	CMP	M
  1CBC'   E1                    	POP	H
  1CBD'   CA 1CC7'              	JZ	SCP_SK
  1CC0'   12                    	STAX	D
  1CC1'   13                    	INX	D
  1CC2'   23                    	INX	H
  1CC3'   04                    	INR	B
  1CC4'   C3 1CAD'              	JMP	SCP_LP
  1CC7'                         SCP_SK:
  1CC7'   23                    	INX	H
  1CC8'                         SCP_DN:
  1CC8'   AF                    	XRA	A
  1CC9'   12                    	STAX	D
  1CCA'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  1CCB'                         SUBGO:
  1CCB'   CD 0CDE'              	CALL	GZONE
  1CCE'   2A 0000*              	LHLD	LNDLT
  1CD1'   22 2278'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  1CD4'   CD 0000*              	CALL	CUROFF		;   finds nothing puts both back, as the
  1CD7'   22 2276'              	SHLD	SOFFS		;   search's SN_BAD does
  1CDA'   AF                    	XRA	A
  1CDB'   32 2270'              	STA	SANY
  1CDE'   21 0000               	LXI	H,0
  1CE1'   22 2272'              	SHLD	SBACK
  1CE4'   3A 2269'              	LDA	SRNGF
  1CE7'   B7                    	ORA	A
  1CE8'   CA 1D11'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  1CEB'   2A 226A'              	LHLD	SRNG1
  1CEE'   7C                    	MOV	A,H
  1CEF'   B5                    	ORA	L
  1CF0'   CA 1D8D'              	JZ	SUBBAD		; ':0s' -- there is no line 0
  1CF3'   2A 226C'              	LHLD	SRNG2
  1CF6'   EB                    	XCHG
  1CF7'   2A 226A'              	LHLD	SRNG1
  1CFA'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  1CFD'   DA 1D8D'              	JC	SUBBAD		; backwards: vim offers to swap, this refuses
  1D00'   EB                    	XCHG			; HL = the last line, DE = the first
  1D01'   CD 0000*              	CALL	SUBHD
  1D04'   23                    	INX	H		; HL = the lines in the range
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1D05'   22 2274'              	SHLD	SLINES
  1D08'   2A 226A'              	LHLD	SRNG1
  1D0B'   CD 0C6C'              	CALL	GOLN
  1D0E'   C3 1D17'              	JMP	SUBLP
  1D11'                         SUB_1L:
  1D11'   21 0001               	LXI	H,1
  1D14'   22 2274'              	SHLD	SLINES
  1D17'                         SUBLP:
  1D17'   CD 1D93'              	CALL	SUBLIN		; A = 1 when this line changed
  1D1A'   B7                    	ORA	A
  1D1B'   CA 1D29'              	JZ	SUB_NX
  1D1E'   3E 01                 	MVI	A,1
  1D20'   32 2270'              	STA	SANY
  1D23'   21 0000               	LXI	H,0
  1D26'   22 2272'              	SHLD	SBACK		; the cursor is ON the last line changed
  1D29'                         SUB_NX:
  1D29'   2A 2274'              	LHLD	SLINES
  1D2C'   2B                    	DCX	H
  1D2D'   22 2274'              	SHLD	SLINES
  1D30'   7C                    	MOV	A,H
  1D31'   B5                    	ORA	L
  1D32'   CA 1D50'              	JZ	SUBDON		; the range is spent
  1D35'   21 0001               	LXI	H,1
  1D38'   AF                    	XRA	A
  1D39'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  1D3C'   3A 2270'              	LDA	SANY
  1D3F'   B7                    	ORA	A
  1D40'   CA 1D4A'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  1D43'   2A 2272'              	LHLD	SBACK
  1D46'   23                    	INX	H
  1D47'   22 2272'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  1D4A'                         SUB_AE:
  1D4A'   CD 07B1'              	CALL	ATEOF
  1D4D'   D2 1D17'              	JNC	SUBLP		; ... unless that ran off the end of the file
  1D50'                         SUBDON:
  1D50'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  1D53'   3A 2270'              	LDA	SANY
  1D56'   B7                    	ORA	A
  1D57'   CA 1D75'              	JZ	SUBNFD
  1D5A'   3E 01                 	MVI	A,1
  1D5C'   32 21D8'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  1D5F'   2A 2272'              	LHLD	SBACK
  1D62'   7C                    	MOV	A,H
  1D63'   B5                    	ORA	L
  1D64'   CA 1D6F'              	JZ	SUB_PL
  1D67'   3E FF                 	MVI	A,0FFH
  1D69'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  1D6C'   CD 0000*              	CALL	CLRCNT
  1D6F'                         SUB_PL:
  1D6F'   CD 0CF6'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  1D72'   C3 0528'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  1D75'                         SUBNFD:
  1D75'   2A 2276'              	LHLD	SOFFS
  1D78'   CD 0000*              	CALL	GOTO
  1D7B'   2A 2278'              	LHLD	SLDLTS
  1D7E'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  1D81'   21 1B2B'              	LXI	H,SNOTFD
  1D84'   CD 1AA1'              	CALL	EXERR
  1D87'   21 0000*              	LXI	H,SRCHST
  1D8A'   C3 1A9C'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  1D8D'                         SUBBAD:
  1D8D'   21 1B19'              	LXI	H,SNOT
  1D90'   C3 1A96'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  1D93'                         SUBLIN:
  1D93'   AF                    	XRA	A
  1D94'   32 2271'              	STA	SLCHG
  1D97'   CD 1E12'              	CALL	SUBBOL
  1D9A'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  1D9D'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  1D9D'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  1DA0'   DA 1DA8'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  1DA3'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  1DA5'   C2 1D9D'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  1DA8'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  1DA8'   CD 0000*              	CALL	CUROFF
  1DAB'   E5                    	PUSH	H
  1DAC'   CD 105F'              	CALL	CEND
  1DAF'   D1                    	POP	D
  1DB0'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  1DB3'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  1DB4'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  1DB7'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  1DB8'   B7                    	ORA	A		;   span is a line, not a pair.)
  1DB9'   FA 1E0B'              	JM	SUBL_D		; what is left is shorter than the pattern
  1DBC'   44                    	MOV	B,H
  1DBD'   4D                    	MOV	C,L		; BC = the start positions a match can take
  1DBE'   11 0000*              	LXI	D,SRCHST
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1DC1'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  1DC4'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  1DC7'   DA 1E0B'              	JC	SUBL_D
  1DCA'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  1DCD'   EB                    	XCHG
  1DCE'   2A 0000*              	LHLD	GAPEND
  1DD1'   EB                    	XCHG
  1DD2'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  1DD5'   EB                    	XCHG
  1DD6'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  1DD7'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  1DDA'   D1                    	POP	D
  1DDB'   19                    	DAD	D		; ... and so the match's logical offset
  1DDC'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  1DDF'   3A 2270'              	LDA	SANY
  1DE2'   B7                    	ORA	A
  1DE3'   C2 1DF0'              	JNZ	SUBL_C
  1DE6'   3A 2271'              	LDA	SLCHG
  1DE9'   B7                    	ORA	A
  1DEA'   C2 1DF0'              	JNZ	SUBL_C
  1DED'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  1DF0'                         SUBL_C:
  1DF0'   3A 0000*              	LDA	SRCHBF
  1DF3'   6F                    	MOV	L,A
  1DF4'   26 00                 	MVI	H,0
  1DF6'   CD 0000*              	CALL	DELFWD		; the match goes
  1DF9'   11 227A'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  1DFC'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  1DFF'                         SUBL_I:
  1DFF'   3E 01                 	MVI	A,1
  1E01'   32 2271'              	STA	SLCHG
  1E04'   3A 226F'              	LDA	SGFLAG
  1E07'   B7                    	ORA	A
  1E08'   C2 1DA8'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  1E0B'                         SUBL_D:
  1E0B'   CD 1E12'              	CALL	SUBBOL
  1E0E'   3A 2271'              	LDA	SLCHG
  1E11'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  1E12'                         SUBBOL:
  1E12'   CD 0000*              	CALL	CUROFF
  1E15'   CD 03EB'              	CALL	BOL
  1E18'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  1E1B'                         VC_SRCH:
  1E1B'   CD 0507'              	CALL	SETMOV
  1E1E'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1E1F'   CD 049A'              	CALL	GETCNT
  1E22'   22 2262'              	SHLD	SCNT
  1E25'   C1                    	POP	B
  1E26'   79                    	MOV	A,C
  1E27'   FE 2F                 	CPI	'/'
  1E29'   3E 00                 	MVI	A,0
  1E2B'   CA 1E30'              	JZ	VS_DIR
  1E2E'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  1E30'                         VS_DIR:
  1E30'   32 2251'              	STA	SDIR
  1E33'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  1E36'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  1E39'   47                    	MOV	B,A
  1E3A'   CD 15F6'              	CALL	RDLINE
  1E3D'   B7                    	ORA	A
  1E3E'   C0                    	RNZ			; cancelled: nothing happens at all
  1E3F'   3A 2229'              	LDA	RLLEN
  1E42'   B7                    	ORA	A
  1E43'   CA 1E58'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  1E46'   5F                    	MOV	E,A
  1E47'   16 00                 	MVI	D,0
  1E49'   21 0000*              	LXI	H,SRCHST
  1E4C'   19                    	DAD	D
  1E4D'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  1E4F'   7B                    	MOV	A,E
  1E50'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  1E53'   3E 01                 	MVI	A,1
  1E55'   32 2253'              	STA	SHAVE
  1E58'                         VS_OLD:
  1E58'   3A 2253'              	LDA	SHAVE
  1E5B'   B7                    	ORA	A
  1E5C'   CA 1E68'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  1E5F'   3A 2251'              	LDA	SDIR
  1E62'   32 2252'              	STA	SDIRE
  1E65'   C3 1E91'              	JMP	SRCHN
  1E68'                         VS_NOP:
  1E68'   21 1B3F'              	LXI	H,SNOPAT
  1E6B'   C3 1AA1'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  1E6E'                         VC_N:
  1E6E'   CD 0507'              	CALL	SETMOV
  1E71'   3A 2251'              	LDA	SDIR
  1E74'   C3 1E7E'              	JMP	VN_GO
  1E77'                         VCB_N:
  1E77'   CD 0507'              	CALL	SETMOV
  1E7A'   3A 2251'              	LDA	SDIR
  1E7D'   2F                    	CMA			; the other way: 0 <-> FFH
  1E7E'                         VN_GO:
  1E7E'   32 2252'              	STA	SDIRE
  1E81'   CD 049A'              	CALL	GETCNT
  1E84'   22 2262'              	SHLD	SCNT
  1E87'   3A 2253'              	LDA	SHAVE
  1E8A'   B7                    	ORA	A
  1E8B'   CA 1E68'              	JZ	VS_NOP
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1E8E'   C3 1E91'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  1E91'                         SRCHN:
  1E91'   CD 0CDE'              	CALL	GZONE		; the screen's top line, before the cursor moves
  1E94'   2A 0000*              	LHLD	LNDLT
  1E97'   22 2266'              	SHLD	SLDLT		; the sweep moves the cursor with PUTCUR, which
                                				;   does not maintain LNDLT (GOTO does)
  1E9A'   CD 0000*              	CALL	CUROFF
  1E9D'   22 2264'              	SHLD	SOFF
  1EA0'                         SN_LP:
  1EA0'   CD 1ED8'              	CALL	SRCHGO
  1EA3'   DA 1EBD'              	JC	SN_BAD
  1EA6'   2A 2262'              	LHLD	SCNT
  1EA9'   2B                    	DCX	H
  1EAA'   22 2262'              	SHLD	SCNT
  1EAD'   7C                    	MOV	A,H
  1EAE'   B5                    	ORA	L
  1EAF'   C2 1EA0'              	JNZ	SN_LP
  1EB2'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  1EB5'   3E 01                 	MVI	A,1
  1EB7'   32 2254'              	STA	GPKEEP		; land on the match, not the first non-blank
  1EBA'   C3 0CF6'              	JMP	GPLACE		; (which sets LNDLT itself)
  1EBD'                         SN_BAD:
  1EBD'   CD 0000*              	CALL	CLRCNT
  1EC0'   2A 2264'              	LHLD	SOFF
  1EC3'   CD 0000*              	CALL	GOTO
  1EC6'   2A 2266'              	LHLD	SLDLT
  1EC9'   22 0000*              	SHLD	LNDLT		; nothing moved: the row the cursor was on
  1ECC'   21 1B2B'              	LXI	H,SNOTFD
  1ECF'   CD 1AA1'              	CALL	EXERR
  1ED2'   21 0000*              	LXI	H,SRCHST
  1ED5'   C3 1A9C'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  1ED8'                         SRCHGO:
  1ED8'   3E 01                 	MVI	A,1
  1EDA'   32 2268'              	STA	SSKIP		; this pass starts one past the cursor
  1EDD'   CD 1EEF'              	CALL	SRCHW
  1EE0'   D0                    	RNC
  1EE1'   3A 2252'              	LDA	SDIRE
  1EE4'   2F                    	CMA
  1EE5'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  1EE8'   AF                    	XRA	A
  1EE9'   32 2268'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  1EEC'   C3 1EEF'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  1EEF'                         SRCHW:
  1EEF'   3A 2252'              	LDA	SDIRE
  1EF2'   32 0000*              	STA	DIRFLG
  1EF5'   21 FFFF               	LXI	H,0FFFFH
  1EF8'   22 21D5'              	SHLD	CMDCNT
  1EFB'   AF                    	XRA	A
  1EFC'   32 0000*              	STA	AUXCNT
  1EFF'                         SW_LP:
  1EFF'   CD 1F0B'              	CALL	SRCH1
  1F02'   D0                    	RNC
  1F03'   CD 0000*              	CALL	SCRLST
  1F06'   D2 1EFF'              	JNC	SW_LP
  1F09'   37                    	STC
  1F0A'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  1F0B'                         SRCH1:
  1F0B'   11 0000*              	LXI	D,SRCHST
  1F0E'   3A 0000*              	LDA	DIRFLG
  1F11'   B7                    	ORA	A
  1F12'   FA 1F36'              	JM	SR1_BK
  1F15'   21 0000*              	LXI	H,GAPEND
  1F18'   CD 0000*              	CALL	FWDCNT
  1F1B'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  1F1E'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  1F1F'   3A 2268'              	LDA	SSKIP
  1F22'   B7                    	ORA	A
  1F23'   CA 1F2C'              	JZ	SR1_FW
  1F26'   78                    	MOV	A,B
  1F27'   B1                    	ORA	C
  1F28'   37                    	STC
  1F29'   C8                    	RZ			; no room for a match even before the skip
  1F2A'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  1F2B'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  1F2C'                         SR1_FW:
  1F2C'   CD 0000*              	CALL	MATCHF
  1F2F'   D8                    	RC
  1F30'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  1F33'   C3 0000*              	JMP	PUTCUR
  1F36'                         SR1_BK:
  1F36'   21 0000*              	LXI	H,TXTBEG
  1F39'   CD 0000*              	CALL	FWDCNT
  1F3C'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  1F3F'   D8                    	RC
  1F40'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1F43'   CD 0000*              	CALL	MATCHB
  1F46'   D8                    	RC
  1F47'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; QSNAP -- snapshot cursor state into TOFFV/TLINEV/TCOLV (test hook).
                                ;============================================================
  1F4A'                         QSNAP:
  1F4A'   CD 0000*              	CALL	CUROFF
  1F4D'   22 2221'              	SHLD	TOFFV
  1F50'   21 0000               	LXI	H,0
  1F53'   22 2223'              	SHLD	TLINEV
  1F56'   21 0000               	LXI	H,0
  1F59'   22 220F'              	SHLD	WKI
  1F5C'                         QS_LP:
  1F5C'   2A 220F'              	LHLD	WKI
  1F5F'   EB                    	XCHG			; DE = i
  1F60'   2A 2221'              	LHLD	TOFFV
  1F63'   CD 0000*              	CALL	CMP16		; DE=i vs HL=cur: CY iff i < cur
  1F66'   D2 1F85'              	JNC	QS_COL
  1F69'   2A 220F'              	LHLD	WKI
  1F6C'   CD 0000*              	CALL	CHARAT
  1F6F'   FE 0A                 	CPI	LF
  1F71'   C2 1F7B'              	JNZ	QS_NX
  1F74'   2A 2223'              	LHLD	TLINEV
  1F77'   23                    	INX	H
  1F78'   22 2223'              	SHLD	TLINEV
  1F7B'                         QS_NX:
  1F7B'   2A 220F'              	LHLD	WKI
  1F7E'   23                    	INX	H
  1F7F'   22 220F'              	SHLD	WKI
  1F82'   C3 1F5C'              	JMP	QS_LP
  1F85'                         QS_COL:
  1F85'   2A 2221'              	LHLD	TOFFV
  1F88'   CD 046D'              	CALL	COL
  1F8B'   22 2225'              	SHLD	TCOLV
  1F8E'   C9                    	RET
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  1F8F'                         MSGNAM:
  1F8F'   E5                    	PUSH	H
  1F90'   3E 22                 	MVI	A,'"'
  1F92'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  1F95'   E1                    	POP	H
  1F96'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  1F97'   23                    	INX	H
  1F98'   7E                    	MOV	A,M
  1F99'   FE 20                 	CPI	' '
  1F9B'   C2 1FA8'              	JNZ	MN_HAS
  1F9E'   21 1B8E'              	LXI	H,SNONM
  1FA1'   CD 0000*              	CALL	OUTSTR
  1FA4'   E1                    	POP	H
  1FA5'   C3 1FF2'              	JMP	MN_END
  1FA8'                         MN_HAS:
  1FA8'   0E 19                 	MVI	C,BF_CURDSK
  1FAA'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  1FAD'   E1                    	POP	H
  1FAE'   E5                    	PUSH	H
  1FAF'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  1FB0'   BE                    	CMP	M
  1FB1'   CA 1FBF'              	JZ	MN_NAM
  1FB4'   7E                    	MOV	A,M
  1FB5'   C6 40                 	ADI	'A'-1
  1FB7'   CD 0000*              	CALL	OUTCH
  1FBA'   3E 3A                 	MVI	A,':'
  1FBC'   CD 0000*              	CALL	OUTCH
  1FBF'                         MN_NAM:
  1FBF'   E1                    	POP	H
  1FC0'   E5                    	PUSH	H
  1FC1'   23                    	INX	H
  1FC2'   0E 08                 	MVI	C,8
  1FC4'                         MN_NM:
  1FC4'   7E                    	MOV	A,M
  1FC5'   FE 20                 	CPI	' '
  1FC7'   CA 1FD2'              	JZ	MN_EXT
  1FCA'   CD 0000*              	CALL	OUTCH
  1FCD'   23                    	INX	H
  1FCE'   0D                    	DCR	C
  1FCF'   C2 1FC4'              	JNZ	MN_NM
  1FD2'                         MN_EXT:
  1FD2'   E1                    	POP	H
  1FD3'   11 0009               	LXI	D,9
  1FD6'   19                    	DAD	D		; the type field
  1FD7'   7E                    	MOV	A,M
  1FD8'   FE 20                 	CPI	' '
  1FDA'   CA 1FF2'              	JZ	MN_END
  1FDD'   3E 2E                 	MVI	A,'.'
  1FDF'   CD 0000*              	CALL	OUTCH
  1FE2'   0E 03                 	MVI	C,3
  1FE4'                         MN_XL:
  1FE4'   7E                    	MOV	A,M
  1FE5'   FE 20                 	CPI	' '
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1FE7'   CA 1FF2'              	JZ	MN_END
  1FEA'   CD 0000*              	CALL	OUTCH
  1FED'   23                    	INX	H
  1FEE'   0D                    	DCR	C
  1FEF'   C2 1FE4'              	JNZ	MN_XL
  1FF2'                         MN_END:
  1FF2'   3E 22                 	MVI	A,'"'
  1FF4'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  1FF7'                         MSGFLG:
  1FF7'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  1FF9'   B7                    	ORA	A
  1FFA'   CA 200A'              	JZ	MF_RO
  1FFD'   3A 21D8'              	LDA	MODF
  2000'   B7                    	ORA	A
  2001'   CA 200A'              	JZ	MF_RO
  2004'   21 1B98'              	LXI	H,SMODM
  2007'   CD 201F'              	CALL	MF_PUT
  200A'                         MF_RO:
  200A'   3A 223F'              	LDA	ROFLAG
  200D'   B7                    	ORA	A
  200E'   CA 2017'              	JZ	MF_NEW
  2011'   21 1BA3'              	LXI	H,SROM
  2014'   CD 201F'              	CALL	MF_PUT
  2017'                         MF_NEW:
  2017'   3A 223D'              	LDA	MSGNEW
  201A'   B7                    	ORA	A
  201B'   C8                    	RZ
  201C'   21 1BAE'              	LXI	H,SNEWM
  201F'                         MF_PUT:
  201F'   78                    	MOV	A,B
  2020'   B7                    	ORA	A
  2021'   C2 202D'              	JNZ	MF_STR
  2024'   06 01                 	MVI	B,1
  2026'   E5                    	PUSH	H
  2027'   3E 20                 	MVI	A,' '
  2029'   CD 0000*              	CALL	OUTCH
  202C'   E1                    	POP	H
  202D'                         MF_STR:
  202D'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  2030'                         EMITW:
  2030'   C5                    	PUSH	B
  2031'   D5                    	PUSH	D
  2032'   06 00                 	MVI	B,0
  2034'   11 2710               	LXI	D,10000
  2037'   CD 2055'              	CALL	EWDIG
  203A'   11 03E8               	LXI	D,1000
  203D'   CD 2055'              	CALL	EWDIG
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  2040'   11 0064               	LXI	D,100
  2043'   CD 2055'              	CALL	EWDIG
  2046'   11 000A               	LXI	D,10
  2049'   CD 2055'              	CALL	EWDIG
  204C'   7D                    	MOV	A,L		; the units digit is always printed
  204D'   C6 30                 	ADI	'0'
  204F'   CD 0000*              	CALL	OUTCH
  2052'   D1                    	POP	D
  2053'   C1                    	POP	B
  2054'   C9                    	RET
  2055'                         EWDIG:
  2055'   0E 00                 	MVI	C,0
  2057'                         EW_LP:
  2057'   7D                    	MOV	A,L
  2058'   93                    	SUB	E
  2059'   6F                    	MOV	L,A
  205A'   7C                    	MOV	A,H
  205B'   9A                    	SBB	D
  205C'   67                    	MOV	H,A
  205D'   DA 2064'              	JC	EW_DN
  2060'   0C                    	INR	C
  2061'   C3 2057'              	JMP	EW_LP
  2064'                         EW_DN:
  2064'   19                    	DAD	D		; one subtraction too many: give it back
  2065'   79                    	MOV	A,C
  2066'   B7                    	ORA	A
  2067'   C2 206D'              	JNZ	EW_PR
  206A'   78                    	MOV	A,B
  206B'   B7                    	ORA	A
  206C'   C8                    	RZ			; a leading zero: write nothing
  206D'                         EW_PR:
  206D'   79                    	MOV	A,C
  206E'   C6 30                 	ADI	'0'
  2070'   CD 0000*              	CALL	OUTCH
  2073'   06 01                 	MVI	B,1
  2075'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  2076'                         ISEMPT:
  2076'   2A 0000*              	LHLD	OUTPOS
  2079'   7C                    	MOV	A,H
  207A'   B5                    	ORA	L
  207B'   C0                    	RNZ
  207C'   CD 0000*              	CALL	LOGLEN
  207F'   7C                    	MOV	A,H
  2080'   B5                    	ORA	L
  2081'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  2082'                         MSGCTG:
  2082'   21 0000*              	LXI	H,FNAME
  2085'   CD 1F8F'              	CALL	MSGNAM
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  2088'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  208A'   CD 1FF7'              	CALL	MSGFLG
  208D'   CD 2076'              	CALL	ISEMPT
  2090'   C2 2099'              	JNZ	MG_POS
  2093'   21 1BC1'              	LXI	H,SNOLIN
  2096'   C3 0000*              	JMP	OUTSTR
  2099'                         MG_POS:
  2099'   21 1BB4'              	LXI	H,SLINE
  209C'   CD 0000*              	CALL	OUTSTR
  209F'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  20A2'   23                    	INX	H		;   ... so the line it is on
  20A3'   CD 2030'              	CALL	EMITW
  20A6'   21 1BBB'              	LXI	H,SCOLM
  20A9'   CD 0000*              	CALL	OUTSTR
  20AC'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  20AF'   23                    	INX	H
  20B0'   E5                    	PUSH	H
  20B1'   CD 2030'              	CALL	EMITW
  20B4'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  20B7'   23                    	INX	H
  20B8'   D1                    	POP	D
  20B9'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  20BC'   C8                    	RZ
  20BD'   E5                    	PUSH	H
  20BE'   3E 2D                 	MVI	A,'-'
  20C0'   CD 0000*              	CALL	OUTCH
  20C3'   E1                    	POP	H
  20C4'   C3 2030'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  20C7'                         FILMSG:
  20C7'   3A 0001*              	LDA	FNAME+1
  20CA'   FE 20                 	CPI	' '
  20CC'   C8                    	RZ
  20CD'   21 0000*              	LXI	H,FNAME
  20D0'   CD 1F8F'              	CALL	MSGNAM
  20D3'   AF                    	XRA	A		; nothing has been changed yet
  20D4'   C3 1FF7'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  20D7'                         WRMSG:
  20D7'   21 0000*              	LXI	H,TFCB
  20DA'   CD 1F8F'              	CALL	MSGNAM
  20DD'   21 1BD3'              	LXI	H,SWRIT
  20E0'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  20E3'                         MSGPST:
  20E3'   3A 223C'              	LDA	MSGWHT
  20E6'   B7                    	ORA	A
  20E7'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  20E8'   47                    	MOV	B,A
  20E9'   AF                    	XRA	A
  20EA'   32 223C'              	STA	MSGWHT
  20ED'   78                    	MOV	A,B
  20EE'   FE 01                 	CPI	MW_FIL
  20F0'   CA 20FE'              	JZ	MP_FIL
  20F3'   FE 02                 	CPI	MW_WRT
  20F5'   CA 2104'              	JZ	MP_WRT
  20F8'   CD 2082'              	CALL	MSGCTG
  20FB'   C3 0000*              	JMP	SCURS
  20FE'                         MP_FIL:
  20FE'   CD 20C7'              	CALL	FILMSG
  2101'   C3 0000*              	JMP	SCURS
  2104'                         MP_WRT:
  2104'   CD 20D7'              	CALL	WRMSG
  2107'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  210A'                         VC_CTLG:
  210A'   3E 03                 	MVI	A,MW_CTG
  210C'   32 223C'              	STA	MSGWHT
  210F'   3E 01                 	MVI	A,R_MOVE
  2111'   32 21D9'              	STA	RINTENT
  2114'   C9                    	RET
                                
  2115'                         CMDTAB:
  2115'   07                    	DB	07H			; ^G -- where am I?
  2116'   210A'                 	DW	VC_CTLG
  2118'   68                    	DB	'h'
  2119'   0560'                 	DW	VC_H
  211B'   6C                    	DB	'l'
  211C'   058A'                 	DW	VC_L
  211E'   6A                    	DB	'j'
  211F'   064F'                 	DW	VC_J
  2121'   6B                    	DB	'k'
  2122'   065E'                 	DW	VC_K
  2124'   30                    	DB	'0'
  2125'   05B1'                 	DW	VC_0
  2127'   5E                    	DB	'^'
  2128'   05CF'                 	DW	VC_CRT
  212A'   24                    	DB	'$'
  212B'   060D'                 	DW	VC_EOL
  212D'   0D                    	DB	CR			; <CR> -- down to the first non-blank
  212E'   0631'                 	DW	VC_CR
  2130'   77                    	DB	'w'
  2131'   0833'                 	DW	VC_W
  2133'   62                    	DB	'b'
  2134'   0884'                 	DW	VC_B
  2136'   65                    	DB	'e'
  2137'   09E9'                 	DW	VC_E
  2139'   57                    	DB	'W'
  213A'   083A'                 	DW	VCBGW
  213C'   42                    	DB	'B'
  213D'   088B'                 	DW	VCBGB
  213F'   45                    	DB	'E'
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  2140'   09F0'                 	DW	VCBGE
  2142'   47                    	DB	'G'
  2143'   0C4B'                 	DW	VC_G
  2145'   67                    	DB	'g'
  2146'   0C7F'                 	DW	VC_LG
  2148'   78                    	DB	'x'
  2149'   1028'                 	DW	VC_X
  214B'   5A                    	DB	'Z'
  214C'   1671'                 	DW	VC_BZ
  214E'   79                    	DB	'y'
  214F'   1305'                 	DW	VC_Y
  2151'   59                    	DB	'Y'
  2152'   130D'                 	DW	VY_YY
  2154'   70                    	DB	'p'
  2155'   13EE'                 	DW	VC_P
  2157'   50                    	DB	'P'
  2158'   1403'                 	DW	VCB_P
  215A'   69                    	DB	'i'
  215B'   1080'                 	DW	VC_I
  215D'   61                    	DB	'a'
  215E'   1086'                 	DW	VC_A
  2160'   41                    	DB	'A'
  2161'   10A6'                 	DW	VCB_A
  2163'   49                    	DB	'I'
  2164'   10C2'                 	DW	VCB_I
  2166'   72                    	DB	'r'
  2167'   120B'                 	DW	VC_R
  2169'   52                    	DB	'R'
  216A'   125F'                 	DW	VCB_R
  216C'   64                    	DB	'd'
  216D'   1274'                 	DW	VC_D
  216F'   44                    	DB	'D'
  2170'   1010'                 	DW	VCB_D
  2172'   43                    	DB	'C'
  2173'   100A'                 	DW	VCB_C
  2175'   63                    	DB	'c'
  2176'   127C'                 	DW	VC_C
  2178'   6F                    	DB	'o'
  2179'   1117'                 	DW	VC_O
  217B'   4F                    	DB	'O'
  217C'   112C'                 	DW	VCB_O
  217E'   4A                    	DB	'J'
  217F'   1146'                 	DW	VCB_J
  2181'   7E                    	DB	'~'
  2182'   11C8'                 	DW	VC_TILD
  2184'   3A                    	DB	':'
  2185'   169C'                 	DW	VC_EX
  2187'   2F                    	DB	'/'
  2188'   1E1B'                 	DW	VC_SRCH
  218A'   3F                    	DB	'?'
  218B'   1E1B'                 	DW	VC_SRCH
  218D'   6E                    	DB	'n'
  218E'   1E6E'                 	DW	VC_N
  2190'   4E                    	DB	'N'
  2191'   1E77'                 	DW	VCB_N
  2193'   48                    	DB	'H'
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  2194'   0ADD'                 	DW	VC_HIGH
  2196'   4D                    	DB	'M'
  2197'   0AF4'                 	DW	VC_MIDL
  2199'   4C                    	DB	'L'
  219A'   0B02'                 	DW	VC_LOWL
  219C'   06                    	DB	06H			; ^F -- page forward
  219D'   0B1F'                 	DW	VC_PGDN
  219F'   02                    	DB	02H			; ^B -- page back
  21A0'   0B4C'                 	DW	VC_PGUP
  21A2'   04                    	DB	04H			; ^D -- half page down
  21A3'   0BA0'                 	DW	VC_HFDN
  21A5'   15                    	DB	15H			; ^U -- half page up
  21A6'   0BD4'                 	DW	VC_HFUP
  21A8'   0C                    	DB	0CH			; ^L -- redraw
  21A9'   0C48'                 	DW	VC_REDR
  21AB'   2E                    	DB	'.'			; '.' -- repeat the last change
  21AC'   01A2'                 	DW	VC_DOT
  21AE'   75                    	DB	'u'			; 'u' -- undo (and undo the undo)
  21AF'   0311'                 	DW	VC_UNDO
  21B1'   6D                    	DB	'm'		; m{a-c} -- set a mark
  21B2'   0248'                 	DW	VC_MK
  21B4'   60                    	DB	60H		; `{a-c} -- back to its exact spot
  21B5'   024D'                 	DW	VC_BQ
  21B7'   27                    	DB	27H		; '{a-c} -- back to its line's first non-blank
  21B8'   0252'                 	DW	VC_AQ
  21BA'   00                    	DB	0
                                
