  1C8D'   5B 72 65 61           SROM:	DB	'[readonly]',0
  1C91'   64 6F 6E 6C           
  1C95'   79 5D 00              
  1C98'   5B 4E 65 77           SNEWM:	DB	'[New]',0
  1C9C'   5D 00                 
  1C9E'   20 6C 69 6E           SLINE:	DB	' line ',0
  1CA2'   65 20 00              
  1CA5'   20 63 6F 6C           SCOLM:	DB	' col ',0
  1CA9'   20 00                 
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1CAB'   20 2D 2D 42           SNOLIN: DB	' --Buffer empty--',0
  1CAF'   75 66 66 65           
  1CB3'   72 20 65 6D           
  1CB7'   70 74 79 2D           
  1CBB'   2D 00                 
  1CBD'   20 77 72 69           SWRIT:	DB	' written',0
  1CC1'   74 74 65 6E           
  1CC5'   00                    
                                
                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  1CC6'                         EXTAB:
  1CC6'   77 00 01              	DB	'w',0,EO_W
  1CC9'   71 00 02              	DB	'q',0,EO_Q
  1CCC'   77 71 03              	DB	'w','q',EO_WQ
  1CCF'   78 00 04              	DB	'x',0,EO_X
  1CD2'   65 00 05              	DB	'e',0,EO_E
  1CD5'   73 00 06              	DB	's',0,EO_S
  1CD8'   76 65 07              	DB	'v','e',EO_V
  1CDB'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  1CDC'                         EXADDR:
  1CDC'   AF                    	XRA	A
  1CDD'   32 230E'              	STA	SRNGF
  1CE0'   7E                    	MOV	A,M
  1CE1'   FE 25                 	CPI	'%'
  1CE3'   CA 1D0C'              	JZ	EXA_AL
  1CE6'   EB                    	XCHG			; DE walks the line, HL takes the number
  1CE7'   CD 1D21'              	CALL	EXNUM
  1CEA'   DA 1D0A'              	JC	EXA_NO
  1CED'   22 230F'              	SHLD	SRNG1
  1CF0'   22 2311'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  1CF3'   1A                    	LDAX	D
  1CF4'   FE 2C                 	CPI	','
  1CF6'   C2 1D03'              	JNZ	EXA_YS
  1CF9'   13                    	INX	D
  1CFA'   CD 1D21'              	CALL	EXNUM
  1CFD'   DA 1D0A'              	JC	EXA_NO		; ',' with no number: not a range at all
  1D00'   22 2311'              	SHLD	SRNG2
  1D03'                         EXA_YS:
  1D03'   EB                    	XCHG
  1D04'   3E 01                 	MVI	A,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1D06'   32 230E'              	STA	SRNGF
  1D09'   C9                    	RET
  1D0A'                         EXA_NO:
  1D0A'   EB                    	XCHG
  1D0B'   C9                    	RET
  1D0C'                         EXA_AL:
  1D0C'   23                    	INX	H
  1D0D'   E5                    	PUSH	H
  1D0E'   21 0001               	LXI	H,1
  1D11'   22 230F'              	SHLD	SRNG1
  1D14'   21 FFFF               	LXI	H,0FFFFH
  1D17'   22 2311'              	SHLD	SRNG2
  1D1A'   E1                    	POP	H
  1D1B'   3E 01                 	MVI	A,1
  1D1D'   32 230E'              	STA	SRNGF
  1D20'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  1D21'                         EXNUM:
  1D21'   1A                    	LDAX	D
  1D22'   D6 30                 	SUI	'0'
  1D24'   D8                    	RC
  1D25'   FE 0A                 	CPI	10
  1D27'   3F                    	CMC
  1D28'   D8                    	RC
  1D29'   21 0000               	LXI	H,0
  1D2C'                         EXN_LP:
  1D2C'   1A                    	LDAX	D
  1D2D'   D6 30                 	SUI	'0'
  1D2F'   DA 1D49'              	JC	EXN_DN
  1D32'   FE 0A                 	CPI	10
  1D34'   D2 1D49'              	JNC	EXN_DN
  1D37'   13                    	INX	D
  1D38'   C5                    	PUSH	B
  1D39'   4F                    	MOV	C,A
  1D3A'   06 00                 	MVI	B,0		; BC = the digit
  1D3C'   D5                    	PUSH	D
  1D3D'   54                    	MOV	D,H
  1D3E'   5D                    	MOV	E,L
  1D3F'   29                    	DAD	H		; *2
  1D40'   29                    	DAD	H		; *4
  1D41'   19                    	DAD	D		; *5
  1D42'   29                    	DAD	H		; *10
  1D43'   D1                    	POP	D
  1D44'   09                    	DAD	B
  1D45'   C1                    	POP	B
  1D46'   C3 1D2C'              	JMP	EXN_LP
  1D49'                         EXN_DN:
  1D49'   B7                    	ORA	A		; CY clear: there was a number
  1D4A'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  1D4B'                         EX_S:
  1D4B'   7E                    	MOV	A,M
  1D4C'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1D4D'   CA 1D8F'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  1D50'   32 2313'              	STA	SDELIM
  1D53'   23                    	INX	H
  1D54'   11 0000*              	LXI	D,SRCHST
  1D57'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  1D5A'   4F                    	MOV	C,A
  1D5B'   CD 1D95'              	CALL	SCOPY
  1D5E'   78                    	MOV	A,B
  1D5F'   B7                    	ORA	A
  1D60'   CA 1D8F'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  1D63'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  1D66'   3E 01                 	MVI	A,1
  1D68'   32 22F0'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  1D6B'   11 2320'              	LXI	D,SREPL
  1D6E'   0E 24                 	MVI	C,SREPMX
  1D70'   CD 1D95'              	CALL	SCOPY
  1D73'   78                    	MOV	A,B
  1D74'   32 231F'              	STA	SREPLN
  1D77'   AF                    	XRA	A
  1D78'   32 2314'              	STA	SGFLAG
  1D7B'   7E                    	MOV	A,M
  1D7C'   FE 67                 	CPI	'g'
  1D7E'   C2 1D87'              	JNZ	EX_SG
  1D81'   23                    	INX	H
  1D82'   3E 01                 	MVI	A,1
  1D84'   32 2314'              	STA	SGFLAG
  1D87'                         EX_SG:
  1D87'   7E                    	MOV	A,M
  1D88'   B7                    	ORA	A
  1D89'   C2 1B7D'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  1D8C'   C3 1DB5'              	JMP	SUBGO
  1D8F'                         SUBNOP:
  1D8F'   21 1C29'              	LXI	H,SNOPAT
  1D92'   C3 1B8B'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  1D95'                         SCOPY:
  1D95'   06 00                 	MVI	B,0
  1D97'                         SCP_LP:
  1D97'   78                    	MOV	A,B
  1D98'   B9                    	CMP	C
  1D99'   D2 1DB2'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  1D9C'   7E                    	MOV	A,M
  1D9D'   B7                    	ORA	A
  1D9E'   CA 1DB2'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  1DA1'   E5                    	PUSH	H
  1DA2'   21 2313'              	LXI	H,SDELIM
  1DA5'   BE                    	CMP	M
  1DA6'   E1                    	POP	H
  1DA7'   CA 1DB1'              	JZ	SCP_SK
  1DAA'   12                    	STAX	D
  1DAB'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1DAC'   23                    	INX	H
  1DAD'   04                    	INR	B
  1DAE'   C3 1D97'              	JMP	SCP_LP
  1DB1'                         SCP_SK:
  1DB1'   23                    	INX	H
  1DB2'                         SCP_DN:
  1DB2'   AF                    	XRA	A
  1DB3'   12                    	STAX	D
  1DB4'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  1DB5'                         SUBGO:
  1DB5'   CD 0CC8'              	CALL	GZONE
  1DB8'   2A 0000*              	LHLD	LNDLT
  1DBB'   22 231D'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  1DBE'   CD 0000*              	CALL	CUROFF		;   finds nothing puts both back, as the
  1DC1'   22 231B'              	SHLD	SOFFS		;   search's SN_BAD does
  1DC4'   AF                    	XRA	A
  1DC5'   32 2315'              	STA	SANY
  1DC8'   21 0000               	LXI	H,0
  1DCB'   22 2317'              	SHLD	SBACK
  1DCE'   3A 230E'              	LDA	SRNGF
  1DD1'   B7                    	ORA	A
  1DD2'   CA 1DFB'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  1DD5'   2A 230F'              	LHLD	SRNG1
  1DD8'   7C                    	MOV	A,H
  1DD9'   B5                    	ORA	L
  1DDA'   CA 1E77'              	JZ	SUBBAD		; ':0s' -- there is no line 0
  1DDD'   2A 2311'              	LHLD	SRNG2
  1DE0'   EB                    	XCHG
  1DE1'   2A 230F'              	LHLD	SRNG1
  1DE4'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  1DE7'   DA 1E77'              	JC	SUBBAD		; backwards: vim offers to swap, this refuses
  1DEA'   EB                    	XCHG			; HL = the last line, DE = the first
  1DEB'   CD 0000*              	CALL	SUBHD
  1DEE'   23                    	INX	H		; HL = the lines in the range
  1DEF'   22 2319'              	SHLD	SLINES
  1DF2'   2A 230F'              	LHLD	SRNG1
  1DF5'   CD 0C56'              	CALL	GOLN
  1DF8'   C3 1E01'              	JMP	SUBLP
  1DFB'                         SUB_1L:
  1DFB'   21 0001               	LXI	H,1
  1DFE'   22 2319'              	SHLD	SLINES
  1E01'                         SUBLP:
  1E01'   CD 1E7D'              	CALL	SUBLIN		; A = 1 when this line changed
  1E04'   B7                    	ORA	A
  1E05'   CA 1E13'              	JZ	SUB_NX
  1E08'   3E 01                 	MVI	A,1
  1E0A'   32 2315'              	STA	SANY
  1E0D'   21 0000               	LXI	H,0
  1E10'   22 2317'              	SHLD	SBACK		; the cursor is ON the last line changed
  1E13'                         SUB_NX:
  1E13'   2A 2319'              	LHLD	SLINES
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1E16'   2B                    	DCX	H
  1E17'   22 2319'              	SHLD	SLINES
  1E1A'   7C                    	MOV	A,H
  1E1B'   B5                    	ORA	L
  1E1C'   CA 1E3A'              	JZ	SUBDON		; the range is spent
  1E1F'   21 0001               	LXI	H,1
  1E22'   AF                    	XRA	A
  1E23'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  1E26'   3A 2315'              	LDA	SANY
  1E29'   B7                    	ORA	A
  1E2A'   CA 1E34'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  1E2D'   2A 2317'              	LHLD	SBACK
  1E30'   23                    	INX	H
  1E31'   22 2317'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  1E34'                         SUB_AE:
  1E34'   CD 079B'              	CALL	ATEOF
  1E37'   D2 1E01'              	JNC	SUBLP		; ... unless that ran off the end of the file
  1E3A'                         SUBDON:
  1E3A'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  1E3D'   3A 2315'              	LDA	SANY
  1E40'   B7                    	ORA	A
  1E41'   CA 1E5F'              	JZ	SUBNFD
  1E44'   3E 01                 	MVI	A,1
  1E46'   32 227D'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  1E49'   2A 2317'              	LHLD	SBACK
  1E4C'   7C                    	MOV	A,H
  1E4D'   B5                    	ORA	L
  1E4E'   CA 1E59'              	JZ	SUB_PL
  1E51'   3E FF                 	MVI	A,0FFH
  1E53'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  1E56'   CD 0000*              	CALL	CLRCNT
  1E59'                         SUB_PL:
  1E59'   CD 0CE0'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  1E5C'   C3 0512'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  1E5F'                         SUBNFD:
  1E5F'   2A 231B'              	LHLD	SOFFS
  1E62'   CD 0000*              	CALL	GOTO
  1E65'   2A 231D'              	LHLD	SLDLTS
  1E68'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  1E6B'   21 1C15'              	LXI	H,SNOTFD
  1E6E'   CD 1B8B'              	CALL	EXERR
  1E71'   21 0000*              	LXI	H,SRCHST
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1E74'   C3 1B86'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  1E77'                         SUBBAD:
  1E77'   21 1C03'              	LXI	H,SNOT
  1E7A'   C3 1B80'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  1E7D'                         SUBLIN:
  1E7D'   AF                    	XRA	A
  1E7E'   32 2316'              	STA	SLCHG
  1E81'   CD 1EFC'              	CALL	SUBBOL
  1E84'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  1E87'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  1E87'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  1E8A'   DA 1E92'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  1E8D'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  1E8F'   C2 1E87'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  1E92'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  1E92'   CD 0000*              	CALL	CUROFF
  1E95'   E5                    	PUSH	H
  1E96'   CD 104C'              	CALL	CEND
  1E99'   D1                    	POP	D
  1E9A'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  1E9D'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  1E9E'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  1EA1'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  1EA2'   B7                    	ORA	A		;   span is a line, not a pair.)
  1EA3'   FA 1EF5'              	JM	SUBL_D		; what is left is shorter than the pattern
  1EA6'   44                    	MOV	B,H
  1EA7'   4D                    	MOV	C,L		; BC = the start positions a match can take
  1EA8'   11 0000*              	LXI	D,SRCHST
  1EAB'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  1EAE'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  1EB1'   DA 1EF5'              	JC	SUBL_D
  1EB4'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  1EB7'   EB                    	XCHG
  1EB8'   2A 0000*              	LHLD	GAPEND
  1EBB'   EB                    	XCHG
  1EBC'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  1EBF'   EB                    	XCHG
  1EC0'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  1EC1'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  1EC4'   D1                    	POP	D
  1EC5'   19                    	DAD	D		; ... and so the match's logical offset
  1EC6'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  1EC9'   3A 2315'              	LDA	SANY
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1ECC'   B7                    	ORA	A
  1ECD'   C2 1EDA'              	JNZ	SUBL_C
  1ED0'   3A 2316'              	LDA	SLCHG
  1ED3'   B7                    	ORA	A
  1ED4'   C2 1EDA'              	JNZ	SUBL_C
  1ED7'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  1EDA'                         SUBL_C:
  1EDA'   3A 0000*              	LDA	SRCHBF
  1EDD'   6F                    	MOV	L,A
  1EDE'   26 00                 	MVI	H,0
  1EE0'   CD 0000*              	CALL	DELFWD		; the match goes
  1EE3'   11 231F'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  1EE6'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  1EE9'                         SUBL_I:
  1EE9'   3E 01                 	MVI	A,1
  1EEB'   32 2316'              	STA	SLCHG
  1EEE'   3A 2314'              	LDA	SGFLAG
  1EF1'   B7                    	ORA	A
  1EF2'   C2 1E92'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  1EF5'                         SUBL_D:
  1EF5'   CD 1EFC'              	CALL	SUBBOL
  1EF8'   3A 2316'              	LDA	SLCHG
  1EFB'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  1EFC'                         SUBBOL:
  1EFC'   CD 0000*              	CALL	CUROFF
  1EFF'   CD 03DD'              	CALL	BOL
  1F02'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  1F05'                         VC_SRCH:
  1F05'   CD 04F1'              	CALL	SETMOV
  1F08'   C5                    	PUSH	B
  1F09'   CD 0484'              	CALL	GETCNT
  1F0C'   22 2307'              	SHLD	SCNT
  1F0F'   C1                    	POP	B
  1F10'   79                    	MOV	A,C
  1F11'   FE 2F                 	CPI	'/'
  1F13'   3E 00                 	MVI	A,0
  1F15'   CA 1F1A'              	JZ	VS_DIR
  1F18'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  1F1A'                         VS_DIR:
  1F1A'   32 22EE'              	STA	SDIR
  1F1D'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  1F20'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  1F23'   47                    	MOV	B,A
  1F24'   CD 16E0'              	CALL	RDLINE
  1F27'   B7                    	ORA	A
  1F28'   C0                    	RNZ			; cancelled: nothing happens at all
  1F29'   3A 22C6'              	LDA	RLLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1F2C'   B7                    	ORA	A
  1F2D'   CA 1F42'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  1F30'   5F                    	MOV	E,A
  1F31'   16 00                 	MVI	D,0
  1F33'   21 0000*              	LXI	H,SRCHST
  1F36'   19                    	DAD	D
  1F37'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  1F39'   7B                    	MOV	A,E
  1F3A'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  1F3D'   3E 01                 	MVI	A,1
  1F3F'   32 22F0'              	STA	SHAVE
  1F42'                         VS_OLD:
  1F42'   3A 22F0'              	LDA	SHAVE
  1F45'   B7                    	ORA	A
  1F46'   CA 1F52'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  1F49'   3A 22EE'              	LDA	SDIR
  1F4C'   32 22EF'              	STA	SDIRE
  1F4F'   C3 1F7B'              	JMP	SRCHN
  1F52'                         VS_NOP:
  1F52'   21 1C29'              	LXI	H,SNOPAT
  1F55'   C3 1B8B'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  1F58'                         VC_N:
  1F58'   CD 04F1'              	CALL	SETMOV
  1F5B'   3A 22EE'              	LDA	SDIR
  1F5E'   C3 1F68'              	JMP	VN_GO
  1F61'                         VCB_N:
  1F61'   CD 04F1'              	CALL	SETMOV
  1F64'   3A 22EE'              	LDA	SDIR
  1F67'   2F                    	CMA			; the other way: 0 <-> FFH
  1F68'                         VN_GO:
  1F68'   32 22EF'              	STA	SDIRE
  1F6B'   CD 0484'              	CALL	GETCNT
  1F6E'   22 2307'              	SHLD	SCNT
  1F71'   3A 22F0'              	LDA	SHAVE
  1F74'   B7                    	ORA	A
  1F75'   CA 1F52'              	JZ	VS_NOP
  1F78'   C3 1F7B'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  1F7B'                         SRCHN:
  1F7B'   CD 0CC8'              	CALL	GZONE		; the screen's top line, before the cursor moves
  1F7E'   2A 0000*              	LHLD	LNDLT
  1F81'   22 230B'              	SHLD	SLDLT		; the sweep moves the cursor with PUTCUR, which
                                				;   does not maintain LNDLT (GOTO does)
  1F84'   CD 0000*              	CALL	CUROFF
  1F87'   22 2309'              	SHLD	SOFF
  1F8A'                         SN_LP:
  1F8A'   CD 1FC2'              	CALL	SRCHGO
  1F8D'   DA 1FA7'              	JC	SN_BAD
  1F90'   2A 2307'              	LHLD	SCNT
  1F93'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F94'   22 2307'              	SHLD	SCNT
  1F97'   7C                    	MOV	A,H
  1F98'   B5                    	ORA	L
  1F99'   C2 1F8A'              	JNZ	SN_LP
  1F9C'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  1F9F'   3E 01                 	MVI	A,1
  1FA1'   32 22F1'              	STA	GPKEEP		; land on the match, not the first non-blank
  1FA4'   C3 0CE0'              	JMP	GPLACE		; (which sets LNDLT itself)
  1FA7'                         SN_BAD:
  1FA7'   CD 0000*              	CALL	CLRCNT
  1FAA'   2A 2309'              	LHLD	SOFF
  1FAD'   CD 0000*              	CALL	GOTO
  1FB0'   2A 230B'              	LHLD	SLDLT
  1FB3'   22 0000*              	SHLD	LNDLT		; nothing moved: the row the cursor was on
  1FB6'   21 1C15'              	LXI	H,SNOTFD
  1FB9'   CD 1B8B'              	CALL	EXERR
  1FBC'   21 0000*              	LXI	H,SRCHST
  1FBF'   C3 1B86'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  1FC2'                         SRCHGO:
  1FC2'   3E 01                 	MVI	A,1
  1FC4'   32 230D'              	STA	SSKIP		; this pass starts one past the cursor
  1FC7'   CD 1FD9'              	CALL	SRCHW
  1FCA'   D0                    	RNC
  1FCB'   3A 22EF'              	LDA	SDIRE
  1FCE'   2F                    	CMA
  1FCF'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  1FD2'   AF                    	XRA	A
  1FD3'   32 230D'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  1FD6'   C3 1FD9'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  1FD9'                         SRCHW:
  1FD9'   3A 22EF'              	LDA	SDIRE
  1FDC'   32 0000*              	STA	DIRFLG
  1FDF'   21 FFFF               	LXI	H,0FFFFH
  1FE2'   22 227A'              	SHLD	CMDCNT
  1FE5'   AF                    	XRA	A
  1FE6'   32 0000*              	STA	AUXCNT
  1FE9'                         SW_LP:
  1FE9'   CD 1FF5'              	CALL	SRCH1
  1FEC'   D0                    	RNC
  1FED'   CD 0000*              	CALL	SCRLST
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1FF0'   D2 1FE9'              	JNC	SW_LP
  1FF3'   37                    	STC
  1FF4'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  1FF5'                         SRCH1:
  1FF5'   11 0000*              	LXI	D,SRCHST
  1FF8'   3A 0000*              	LDA	DIRFLG
  1FFB'   B7                    	ORA	A
  1FFC'   FA 2020'              	JM	SR1_BK
  1FFF'   21 0000*              	LXI	H,GAPEND
  2002'   CD 0000*              	CALL	FWDCNT
  2005'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  2008'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  2009'   3A 230D'              	LDA	SSKIP
  200C'   B7                    	ORA	A
  200D'   CA 2016'              	JZ	SR1_FW
  2010'   78                    	MOV	A,B
  2011'   B1                    	ORA	C
  2012'   37                    	STC
  2013'   C8                    	RZ			; no room for a match even before the skip
  2014'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2015'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2016'                         SR1_FW:
  2016'   CD 0000*              	CALL	MATCHF
  2019'   D8                    	RC
  201A'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  201D'   C3 0000*              	JMP	PUTCUR
  2020'                         SR1_BK:
  2020'   21 0000*              	LXI	H,TXTBEG
  2023'   CD 0000*              	CALL	FWDCNT
  2026'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2029'   D8                    	RC
  202A'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  202D'   CD 0000*              	CALL	MATCHB
  2030'   D8                    	RC
  2031'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2034'                         MSGNAM:
  2034'   E5                    	PUSH	H
  2035'   3E 22                 	MVI	A,'"'
  2037'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  203A'   E1                    	POP	H
  203B'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  203C'   23                    	INX	H
  203D'   7E                    	MOV	A,M
  203E'   FE 20                 	CPI	' '
  2040'   C2 204D'              	JNZ	MN_HAS
  2043'   21 1C78'              	LXI	H,SNONM
  2046'   CD 0000*              	CALL	OUTSTR
  2049'   E1                    	POP	H
  204A'   C3 2097'              	JMP	MN_END
  204D'                         MN_HAS:
  204D'   0E 19                 	MVI	C,BF_CURDSK
  204F'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  2052'   E1                    	POP	H
  2053'   E5                    	PUSH	H
  2054'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  2055'   BE                    	CMP	M
  2056'   CA 2064'              	JZ	MN_NAM
  2059'   7E                    	MOV	A,M
  205A'   C6 40                 	ADI	'A'-1
  205C'   CD 0000*              	CALL	OUTCH
  205F'   3E 3A                 	MVI	A,':'
  2061'   CD 0000*              	CALL	OUTCH
  2064'                         MN_NAM:
  2064'   E1                    	POP	H
  2065'   E5                    	PUSH	H
  2066'   23                    	INX	H
  2067'   0E 08                 	MVI	C,8
  2069'                         MN_NM:
  2069'   7E                    	MOV	A,M
  206A'   FE 20                 	CPI	' '
  206C'   CA 2077'              	JZ	MN_EXT
  206F'   CD 0000*              	CALL	OUTCH
  2072'   23                    	INX	H
  2073'   0D                    	DCR	C
  2074'   C2 2069'              	JNZ	MN_NM
  2077'                         MN_EXT:
  2077'   E1                    	POP	H
  2078'   11 0009               	LXI	D,9
  207B'   19                    	DAD	D		; the type field
  207C'   7E                    	MOV	A,M
  207D'   FE 20                 	CPI	' '
  207F'   CA 2097'              	JZ	MN_END
  2082'   3E 2E                 	MVI	A,'.'
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  2084'   CD 0000*              	CALL	OUTCH
  2087'   0E 03                 	MVI	C,3
  2089'                         MN_XL:
  2089'   7E                    	MOV	A,M
  208A'   FE 20                 	CPI	' '
  208C'   CA 2097'              	JZ	MN_END
  208F'   CD 0000*              	CALL	OUTCH
  2092'   23                    	INX	H
  2093'   0D                    	DCR	C
  2094'   C2 2089'              	JNZ	MN_XL
  2097'                         MN_END:
  2097'   3E 22                 	MVI	A,'"'
  2099'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  209C'                         MSGFLG:
  209C'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  209E'   B7                    	ORA	A
  209F'   CA 20AF'              	JZ	MF_RO
  20A2'   3A 227D'              	LDA	MODF
  20A5'   B7                    	ORA	A
  20A6'   CA 20AF'              	JZ	MF_RO
  20A9'   21 1C82'              	LXI	H,SMODM
  20AC'   CD 20C4'              	CALL	MF_PUT
  20AF'                         MF_RO:
  20AF'   3A 22DC'              	LDA	ROFLAG
  20B2'   B7                    	ORA	A
  20B3'   CA 20BC'              	JZ	MF_NEW
  20B6'   21 1C8D'              	LXI	H,SROM
  20B9'   CD 20C4'              	CALL	MF_PUT
  20BC'                         MF_NEW:
  20BC'   3A 22DA'              	LDA	MSGNEW
  20BF'   B7                    	ORA	A
  20C0'   C8                    	RZ
  20C1'   21 1C98'              	LXI	H,SNEWM
  20C4'                         MF_PUT:
  20C4'   78                    	MOV	A,B
  20C5'   B7                    	ORA	A
  20C6'   C2 20D2'              	JNZ	MF_STR
  20C9'   06 01                 	MVI	B,1
  20CB'   E5                    	PUSH	H
  20CC'   3E 20                 	MVI	A,' '
  20CE'   CD 0000*              	CALL	OUTCH
  20D1'   E1                    	POP	H
  20D2'                         MF_STR:
  20D2'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  20D5'                         EMITW:
  20D5'   C5                    	PUSH	B
  20D6'   D5                    	PUSH	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  20D7'   06 00                 	MVI	B,0
  20D9'   11 2710               	LXI	D,10000
  20DC'   CD 20FA'              	CALL	EWDIG
  20DF'   11 03E8               	LXI	D,1000
  20E2'   CD 20FA'              	CALL	EWDIG
  20E5'   11 0064               	LXI	D,100
  20E8'   CD 20FA'              	CALL	EWDIG
  20EB'   11 000A               	LXI	D,10
  20EE'   CD 20FA'              	CALL	EWDIG
  20F1'   7D                    	MOV	A,L		; the units digit is always printed
  20F2'   C6 30                 	ADI	'0'
  20F4'   CD 0000*              	CALL	OUTCH
  20F7'   D1                    	POP	D
  20F8'   C1                    	POP	B
  20F9'   C9                    	RET
  20FA'                         EWDIG:
  20FA'   0E 00                 	MVI	C,0
  20FC'                         EW_LP:
  20FC'   7D                    	MOV	A,L
  20FD'   93                    	SUB	E
  20FE'   6F                    	MOV	L,A
  20FF'   7C                    	MOV	A,H
  2100'   9A                    	SBB	D
  2101'   67                    	MOV	H,A
  2102'   DA 2109'              	JC	EW_DN
  2105'   0C                    	INR	C
  2106'   C3 20FC'              	JMP	EW_LP
  2109'                         EW_DN:
  2109'   19                    	DAD	D		; one subtraction too many: give it back
  210A'   79                    	MOV	A,C
  210B'   B7                    	ORA	A
  210C'   C2 2112'              	JNZ	EW_PR
  210F'   78                    	MOV	A,B
  2110'   B7                    	ORA	A
  2111'   C8                    	RZ			; a leading zero: write nothing
  2112'                         EW_PR:
  2112'   79                    	MOV	A,C
  2113'   C6 30                 	ADI	'0'
  2115'   CD 0000*              	CALL	OUTCH
  2118'   06 01                 	MVI	B,1
  211A'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  211B'                         ISEMPT:
  211B'   2A 0000*              	LHLD	OUTPOS
  211E'   7C                    	MOV	A,H
  211F'   B5                    	ORA	L
  2120'   C0                    	RNZ
  2121'   CD 0000*              	CALL	LOGLEN
  2124'   7C                    	MOV	A,H
  2125'   B5                    	ORA	L
  2126'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  2127'                         MSGCTG:
  2127'   21 0000*              	LXI	H,FNAME
  212A'   CD 2034'              	CALL	MSGNAM
  212D'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  212F'   CD 209C'              	CALL	MSGFLG
  2132'   CD 211B'              	CALL	ISEMPT
  2135'   C2 213E'              	JNZ	MG_POS
  2138'   21 1CAB'              	LXI	H,SNOLIN
  213B'   C3 0000*              	JMP	OUTSTR
  213E'                         MG_POS:
  213E'   21 1C9E'              	LXI	H,SLINE
  2141'   CD 0000*              	CALL	OUTSTR
  2144'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  2147'   23                    	INX	H		;   ... so the line it is on
  2148'   CD 20D5'              	CALL	EMITW
  214B'   21 1CA5'              	LXI	H,SCOLM
  214E'   CD 0000*              	CALL	OUTSTR
  2151'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  2154'   23                    	INX	H
  2155'   E5                    	PUSH	H
  2156'   CD 20D5'              	CALL	EMITW
  2159'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  215C'   23                    	INX	H
  215D'   D1                    	POP	D
  215E'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  2161'   C8                    	RZ
  2162'   E5                    	PUSH	H
  2163'   3E 2D                 	MVI	A,'-'
  2165'   CD 0000*              	CALL	OUTCH
  2168'   E1                    	POP	H
  2169'   C3 20D5'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  216C'                         FILMSG:
  216C'   3A 0001*              	LDA	FNAME+1
  216F'   FE 20                 	CPI	' '
  2171'   C8                    	RZ
  2172'   21 0000*              	LXI	H,FNAME
  2175'   CD 2034'              	CALL	MSGNAM
  2178'   AF                    	XRA	A		; nothing has been changed yet
  2179'   C3 209C'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  217C'                         WRMSG:
  217C'   21 0000*              	LXI	H,TFCB
  217F'   CD 2034'              	CALL	MSGNAM
  2182'   21 1CBD'              	LXI	H,SWRIT
  2185'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  2188'                         MSGPST:
  2188'   3A 22D9'              	LDA	MSGWHT
  218B'   B7                    	ORA	A
  218C'   C8                    	RZ
  218D'   47                    	MOV	B,A
  218E'   AF                    	XRA	A
  218F'   32 22D9'              	STA	MSGWHT
  2192'   78                    	MOV	A,B
  2193'   FE 01                 	CPI	MW_FIL
  2195'   CA 21A3'              	JZ	MP_FIL
  2198'   FE 02                 	CPI	MW_WRT
  219A'   CA 21A9'              	JZ	MP_WRT
  219D'   CD 2127'              	CALL	MSGCTG
  21A0'   C3 0000*              	JMP	SCURS
  21A3'                         MP_FIL:
  21A3'   CD 216C'              	CALL	FILMSG
  21A6'   C3 0000*              	JMP	SCURS
  21A9'                         MP_WRT:
  21A9'   CD 217C'              	CALL	WRMSG
  21AC'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  21AF'                         VC_CTLG:
  21AF'   3E 03                 	MVI	A,MW_CTG
  21B1'   32 22D9'              	STA	MSGWHT
  21B4'   3E 01                 	MVI	A,R_MOVE
  21B6'   32 227E'              	STA	RINTENT
  21B9'   C9                    	RET
                                
  21BA'                         CMDTAB:
  21BA'   07                    	DB	07H			; ^G -- where am I?
  21BB'   21AF'                 	DW	VC_CTLG
  21BD'   68                    	DB	'h'
  21BE'   054A'                 	DW	VC_H
  21C0'   6C                    	DB	'l'
  21C1'   0574'                 	DW	VC_L
  21C3'   6A                    	DB	'j'
  21C4'   0639'                 	DW	VC_J
  21C6'   6B                    	DB	'k'
  21C7'   0648'                 	DW	VC_K
  21C9'   30                    	DB	'0'
  21CA'   059B'                 	DW	VC_0
  21CC'   5E                    	DB	'^'
  21CD'   05B9'                 	DW	VC_CRT
  21CF'   24                    	DB	'$'
  21D0'   05F7'                 	DW	VC_EOL
  21D2'   0D                    	DB	CR			; <CR> -- down to the first non-blank
  21D3'   061B'                 	DW	VC_CR
  21D5'   77                    	DB	'w'
  21D6'   081D'                 	DW	VC_W
  21D8'   62                    	DB	'b'
  21D9'   086E'                 	DW	VC_B
  21DB'   65                    	DB	'e'
  21DC'   09D3'                 	DW	VC_E
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  21DE'   57                    	DB	'W'
  21DF'   0824'                 	DW	VCBGW
  21E1'   42                    	DB	'B'
  21E2'   0875'                 	DW	VCBGB
  21E4'   45                    	DB	'E'
  21E5'   09DA'                 	DW	VCBGE
  21E7'   47                    	DB	'G'
  21E8'   0C35'                 	DW	VC_G
  21EA'   67                    	DB	'g'
  21EB'   0C69'                 	DW	VC_LG
  21ED'   78                    	DB	'x'
  21EE'   1015'                 	DW	VC_X
  21F0'   5A                    	DB	'Z'
  21F1'   175B'                 	DW	VC_BZ
  21F3'   79                    	DB	'y'
  21F4'   12E4'                 	DW	VC_Y
  21F6'   59                    	DB	'Y'
  21F7'   12EC'                 	DW	VY_YY
  21F9'   70                    	DB	'p'
  21FA'   14D8'                 	DW	VC_P
  21FC'   50                    	DB	'P'
  21FD'   14ED'                 	DW	VCB_P
  21FF'   69                    	DB	'i'
  2200'   106D'                 	DW	VC_I
  2202'   61                    	DB	'a'
  2203'   1073'                 	DW	VC_A
  2205'   41                    	DB	'A'
  2206'   1093'                 	DW	VCB_A
  2208'   49                    	DB	'I'
  2209'   10AF'                 	DW	VCB_I
  220B'   72                    	DB	'r'
  220C'   11F8'                 	DW	VC_R
  220E'   52                    	DB	'R'
  220F'   124C'                 	DW	VCB_R
  2211'   64                    	DB	'd'
  2212'   1261'                 	DW	VC_D
  2214'   44                    	DB	'D'
  2215'   0FFD'                 	DW	VCB_D
  2217'   43                    	DB	'C'
  2218'   0FF7'                 	DW	VCB_C
  221A'   63                    	DB	'c'
  221B'   1269'                 	DW	VC_C
  221D'   6F                    	DB	'o'
  221E'   1104'                 	DW	VC_O
  2220'   4F                    	DB	'O'
  2221'   1119'                 	DW	VCB_O
  2223'   4A                    	DB	'J'
  2224'   1133'                 	DW	VCB_J
  2226'   7E                    	DB	'~'
  2227'   11B5'                 	DW	VC_TILD
  2229'   3A                    	DB	':'
  222A'   1786'                 	DW	VC_EX
  222C'   2F                    	DB	'/'
  222D'   1F05'                 	DW	VC_SRCH
  222F'   3F                    	DB	'?'
  2230'   1F05'                 	DW	VC_SRCH
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2232'   6E                    	DB	'n'
  2233'   1F58'                 	DW	VC_N
  2235'   4E                    	DB	'N'
  2236'   1F61'                 	DW	VCB_N
  2238'   48                    	DB	'H'
  2239'   0AC7'                 	DW	VC_HIGH
  223B'   4D                    	DB	'M'
  223C'   0ADE'                 	DW	VC_MIDL
  223E'   4C                    	DB	'L'
  223F'   0AEC'                 	DW	VC_LOWL
  2241'   06                    	DB	06H			; ^F -- page forward
  2242'   0B09'                 	DW	VC_PGDN
  2244'   02                    	DB	02H			; ^B -- page back
  2245'   0B36'                 	DW	VC_PGUP
  2247'   04                    	DB	04H			; ^D -- half page down
  2248'   0B8A'                 	DW	VC_HFDN
  224A'   15                    	DB	15H			; ^U -- half page up
  224B'   0BBE'                 	DW	VC_HFUP
  224D'   0C                    	DB	0CH			; ^L -- redraw
  224E'   0C32'                 	DW	VC_REDR
  2250'   2E                    	DB	'.'			; '.' -- repeat the last change
  2251'   0194'                 	DW	VC_DOT
  2253'   75                    	DB	'u'			; 'u' -- undo (and undo the undo)
  2254'   0303'                 	DW	VC_UNDO
  2256'   6D                    	DB	'm'		; m{a-c} -- set a mark
  2257'   023A'                 	DW	VC_MK
  2259'   60                    	DB	60H		; `{a-c} -- back to its exact spot
  225A'   023F'                 	DW	VC_BQ
  225C'   27                    	DB	27H		; '{a-c} -- back to its line's first non-blank
  225D'   0244'                 	DW	VC_AQ
  225F'   00                    	DB	0
                                
  2260'                         ACTTAB:
  2260'   04                    	DB	ACT_CURLT
  2261'   054A'                 	DW	VC_H
  2263'   03                    	DB	ACT_CURRT
  2264'   0574'                 	DW	VC_L
  2266'   02                    	DB	ACT_CURDN
  2267'   0639'                 	DW	VC_J
  2269'   01                    	DB	ACT_CURUP
  226A'   0648'                 	DW	VC_K
  226C'   05                    	DB	ACT_LINST
  226D'   059B'                 	DW	VC_0
  226F'   06                    	DB	ACT_LINEN
  2270'   05F7'                 	DW	VC_EOL
  2272'   07                    	DB	ACT_PGUP
  2273'   0B36'                 	DW	VC_PGUP
  2275'   08                    	DB	ACT_PGDN
  2276'   0B09'                 	DW	VC_PGDN
  2278'   00                    	DB	0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  2279'   00                    EDMODE: DB	EM_CMD
  227A'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  227C'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  227D'   00                    MODF:	DB	0		; 1 = unsaved changes
  227E'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  227F'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  2280'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  2281'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  2282'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  2284'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  2285'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  2286'   00                    HFROW:	DB	0		; ^D/^U: the cursor's row before the move
  2287'   00                    HFAMT:	DB	0		; ^D/^U: lines (vim's 'scroll'); 0 = NEDIT/2
  2288'   0000                  JKCNT:	DW	0		; j/k: count
  228A'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  228C'   0000                  JKMOV:	DW	0		; j: lines moved
  228E'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  2290'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  2291'   00                    JKLST:	DB	0		; j: last byte of the scan
  2292'   0000                  JKVC:	DW	0		; j/k landing: screen column
  2294'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  2296'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  2297'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  2298'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  2299'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  229A'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  229B'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  229D'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  229E'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  229F'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  22A1'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  22A2'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  22A3'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  22A4'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
  22A5'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  22A6'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  22A7'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   so it stops at the line's content end
  22A8'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  22AA'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  22AC'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  22AE'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  22B0'   0000                  CNTV:	DW	0		; motion repeat counter
  22B2'   0000                  TTI:	DW	0		; TAILTAB scan index
  22B4'   0000                  WKI:	DW	0		; scan index
  22B6'   0000                  WKN:	DW	0		; cached LOGLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  22B8'   0000                  WKTERM: DW	0		; line terminator offset
  22BA'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  22BC'   00                    WKCLS:	DB	0		; word motion: class of the current run
  22BD'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  22BE'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  22C0'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  22C2'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
  22C4'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  22C6'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  22C7'   00                    RLMAX:	DB	0		; RDLINE: capacity
  22C8'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  22C9'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  22CA'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  22CB'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  22CD'   00                    WPROW:	DB	0		; :w -- the cursor's row
  22CE'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  22CF'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  22D1'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  22D3'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  22D4'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  22D6'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  22D8'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  22D9'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  22DA'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  22DB'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  22DC'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  22DD'   00                    PLUSF:	DB	0		; command line: '+' was given
  22DE'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  22DF'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  22E0'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  22E1'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  22E3'   0000                  YPT:	DW	0		; yy: where the lines came from
  22E5'   0000                  PCNT:	DW	0		; p/P: copies still to put
  22E7'   0000                  PPT:	DW	0		; p/P: the first line put
  22E9'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  22EB'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  22EC'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  22EE'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  22EF'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  22F0'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  22F1'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  22F2'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  22F5'   0000                  MKEDIT: DW	0		; MKDROP: where the edit that may drop them is
  22F7'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  22F8'   00                    MKHOLD: DB	0		; set across a yank's delete + put back: MKDROP
                                				;   must leave the marks alone through it
  22F9'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  22FB'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  22FD'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  22FF'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  2301'   0000                  YBLK:	DW	0		; ... and where they ended when they came back
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  2303'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  2305'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
  2307'   0000                  SCNT:	DW	0		; searches still to do (the count)
  2309'   0000                  SOFF:	DW	0		; where the cursor was when the search began
  230B'   0000                  SLDLT:	DW	0		; ... and LNDLT, for the search that fails
  230D'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  230E'   00                    SRNGF:	DB	0		; ex: a line range was given
  230F'   0000                  SRNG1:	DW	0		; ex: its first line
  2311'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  2313'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  2314'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  2315'   00                    SANY:	DB	0		; ':s' something in the range has changed
  2316'   00                    SLCHG:	DB	0		; ':s' this line changed
  2317'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  2319'   0000                  SLINES: DW	0		; ':s' lines of the range still to do
  231B'   0000                  SOFFS:	DW	0		; ':s' the cursor, for a substitute that
  231D'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  231F'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  2320'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
