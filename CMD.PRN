                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  1EEF'                         EXTAB:
  1EEF'   77 00 01              	DB	'w',0,EO_W
  1EF2'   71 00 02              	DB	'q',0,EO_Q
  1EF5'   77 71 03              	DB	'w','q',EO_WQ
  1EF8'   78 00 04              	DB	'x',0,EO_X
  1EFB'   65 00 05              	DB	'e',0,EO_E
  1EFE'   73 00 06              	DB	's',0,EO_S
  1F01'   76 65 07              	DB	'v','e',EO_V
  1F04'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  1F05'                         EXADDR:
  1F05'   AF                    	XRA	A
  1F06'   32 255A'              	STA	SRNGF
  1F09'   7E                    	MOV	A,M
  1F0A'   FE 25                 	CPI	'%'
  1F0C'   CA 1F35'              	JZ	EXA_AL
  1F0F'   EB                    	XCHG			; DE walks the line, HL takes the number
  1F10'   CD 1F4A'              	CALL	EXNUM
  1F13'   DA 1F33'              	JC	EXA_NO
  1F16'   22 255B'              	SHLD	SRNG1
  1F19'   22 255D'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  1F1C'   1A                    	LDAX	D
  1F1D'   FE 2C                 	CPI	','
  1F1F'   C2 1F2C'              	JNZ	EXA_YS
  1F22'   13                    	INX	D
  1F23'   CD 1F4A'              	CALL	EXNUM
  1F26'   DA 1F33'              	JC	EXA_NO		; ',' with no number: not a range at all
  1F29'   22 255D'              	SHLD	SRNG2
  1F2C'                         EXA_YS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F2C'   EB                    	XCHG
  1F2D'   3E 01                 	MVI	A,1
  1F2F'   32 255A'              	STA	SRNGF
  1F32'   C9                    	RET
  1F33'                         EXA_NO:
  1F33'   EB                    	XCHG
  1F34'   C9                    	RET
  1F35'                         EXA_AL:
  1F35'   23                    	INX	H
  1F36'   E5                    	PUSH	H
  1F37'   21 0001               	LXI	H,1
  1F3A'   22 255B'              	SHLD	SRNG1
  1F3D'   21 FFFF               	LXI	H,0FFFFH
  1F40'   22 255D'              	SHLD	SRNG2
  1F43'   E1                    	POP	H
  1F44'   3E 01                 	MVI	A,1
  1F46'   32 255A'              	STA	SRNGF
  1F49'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  1F4A'                         EXNUM:
  1F4A'   1A                    	LDAX	D
  1F4B'   D6 30                 	SUI	'0'
  1F4D'   D8                    	RC
  1F4E'   FE 0A                 	CPI	10
  1F50'   3F                    	CMC
  1F51'   D8                    	RC
  1F52'   21 0000               	LXI	H,0
  1F55'                         EXN_LP:
  1F55'   1A                    	LDAX	D
  1F56'   D6 30                 	SUI	'0'
  1F58'   DA 1F72'              	JC	EXN_DN
  1F5B'   FE 0A                 	CPI	10
  1F5D'   D2 1F72'              	JNC	EXN_DN
  1F60'   13                    	INX	D
  1F61'   C5                    	PUSH	B
  1F62'   4F                    	MOV	C,A
  1F63'   06 00                 	MVI	B,0		; BC = the digit
  1F65'   D5                    	PUSH	D
  1F66'   54                    	MOV	D,H
  1F67'   5D                    	MOV	E,L
  1F68'   29                    	DAD	H		; *2
  1F69'   29                    	DAD	H		; *4
  1F6A'   19                    	DAD	D		; *5
  1F6B'   29                    	DAD	H		; *10
  1F6C'   D1                    	POP	D
  1F6D'   09                    	DAD	B
  1F6E'   C1                    	POP	B
  1F6F'   C3 1F55'              	JMP	EXN_LP
  1F72'                         EXN_DN:
  1F72'   B7                    	ORA	A		; CY clear: there was a number
  1F73'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  1F74'                         EX_S:
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1F74'   7E                    	MOV	A,M
  1F75'   B7                    	ORA	A
  1F76'   CA 1FB8'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  1F79'   32 255F'              	STA	SDELIM
  1F7C'   23                    	INX	H
  1F7D'   11 0000*              	LXI	D,SRCHST
  1F80'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  1F83'   4F                    	MOV	C,A
  1F84'   CD 1FBE'              	CALL	SCOPY
  1F87'   78                    	MOV	A,B
  1F88'   B7                    	ORA	A
  1F89'   CA 1FB8'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  1F8C'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  1F8F'   3E 01                 	MVI	A,1
  1F91'   32 252B'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  1F94'   11 256C'              	LXI	D,SREPL
  1F97'   0E 24                 	MVI	C,SREPMX
  1F99'   CD 1FBE'              	CALL	SCOPY
  1F9C'   78                    	MOV	A,B
  1F9D'   32 256B'              	STA	SREPLN
  1FA0'   AF                    	XRA	A
  1FA1'   32 2560'              	STA	SGFLAG
  1FA4'   7E                    	MOV	A,M
  1FA5'   FE 67                 	CPI	'g'
  1FA7'   C2 1FB0'              	JNZ	EX_SG
  1FAA'   23                    	INX	H
  1FAB'   3E 01                 	MVI	A,1
  1FAD'   32 2560'              	STA	SGFLAG
  1FB0'                         EX_SG:
  1FB0'   7E                    	MOV	A,M
  1FB1'   B7                    	ORA	A
  1FB2'   C2 1D99'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  1FB5'   C3 1FDE'              	JMP	SUBGO
  1FB8'                         SUBNOP:
  1FB8'   21 1E45'              	LXI	H,SNOPAT
  1FBB'   C3 1DA7'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  1FBE'                         SCOPY:
  1FBE'   06 00                 	MVI	B,0
  1FC0'                         SCP_LP:
  1FC0'   78                    	MOV	A,B
  1FC1'   B9                    	CMP	C
  1FC2'   D2 1FDB'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  1FC5'   7E                    	MOV	A,M
  1FC6'   B7                    	ORA	A
  1FC7'   CA 1FDB'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  1FCA'   E5                    	PUSH	H
  1FCB'   21 255F'              	LXI	H,SDELIM
  1FCE'   BE                    	CMP	M
  1FCF'   E1                    	POP	H
  1FD0'   CA 1FDA'              	JZ	SCP_SK
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1FD3'   12                    	STAX	D
  1FD4'   13                    	INX	D
  1FD5'   23                    	INX	H
  1FD6'   04                    	INR	B
  1FD7'   C3 1FC0'              	JMP	SCP_LP
  1FDA'                         SCP_SK:
  1FDA'   23                    	INX	H
  1FDB'                         SCP_DN:
  1FDB'   AF                    	XRA	A
  1FDC'   12                    	STAX	D
  1FDD'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  1FDE'                         SUBGO:
  1FDE'   CD 0EAA'              	CALL	GZONE
  1FE1'   2A 0000*              	LHLD	LNDLT
  1FE4'   22 2569'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  1FE7'   CD 0000*              	CALL	CUROFF		;   finds nothing puts both back, as the
  1FEA'   22 2567'              	SHLD	SOFFS		;   search's SN_BAD does
  1FED'   AF                    	XRA	A
  1FEE'   32 2561'              	STA	SANY
  1FF1'   21 0000               	LXI	H,0
  1FF4'   22 2563'              	SHLD	SBACK
  1FF7'   3A 255A'              	LDA	SRNGF
  1FFA'   B7                    	ORA	A
  1FFB'   CA 2024'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  1FFE'   2A 255B'              	LHLD	SRNG1
  2001'   7C                    	MOV	A,H
  2002'   B5                    	ORA	L
  2003'   CA 20A0'              	JZ	SUBBAD		; ':0s' -- there is no line 0
  2006'   2A 255D'              	LHLD	SRNG2
  2009'   EB                    	XCHG
  200A'   2A 255B'              	LHLD	SRNG1
  200D'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  2010'   DA 20A0'              	JC	SUBBAD		; backwards: vim offers to swap, this refuses
  2013'   EB                    	XCHG			; HL = the last line, DE = the first
  2014'   CD 0000*              	CALL	SUBHD
  2017'   23                    	INX	H		; HL = the lines in the range
  2018'   22 2565'              	SHLD	SLINES
  201B'   2A 255B'              	LHLD	SRNG1
  201E'   CD 0E38'              	CALL	GOLN
  2021'   C3 202A'              	JMP	SUBLP
  2024'                         SUB_1L:
  2024'   21 0001               	LXI	H,1
  2027'   22 2565'              	SHLD	SLINES
  202A'                         SUBLP:
  202A'   CD 20A6'              	CALL	SUBLIN		; A = 1 when this line changed
  202D'   B7                    	ORA	A
  202E'   CA 203C'              	JZ	SUB_NX
  2031'   3E 01                 	MVI	A,1
  2033'   32 2561'              	STA	SANY
  2036'   21 0000               	LXI	H,0
  2039'   22 2563'              	SHLD	SBACK		; the cursor is ON the last line changed
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  203C'                         SUB_NX:
  203C'   2A 2565'              	LHLD	SLINES
  203F'   2B                    	DCX	H
  2040'   22 2565'              	SHLD	SLINES
  2043'   7C                    	MOV	A,H
  2044'   B5                    	ORA	L
  2045'   CA 2063'              	JZ	SUBDON		; the range is spent
  2048'   21 0001               	LXI	H,1
  204B'   AF                    	XRA	A
  204C'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  204F'   3A 2561'              	LDA	SANY
  2052'   B7                    	ORA	A
  2053'   CA 205D'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  2056'   2A 2563'              	LHLD	SBACK
  2059'   23                    	INX	H
  205A'   22 2563'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  205D'                         SUB_AE:
  205D'   CD 097D'              	CALL	ATEOF
  2060'   D2 202A'              	JNC	SUBLP		; ... unless that ran off the end of the file
  2063'                         SUBDON:
  2063'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  2066'   3A 2561'              	LDA	SANY
  2069'   B7                    	ORA	A
  206A'   CA 2088'              	JZ	SUBNFD
  206D'   3E 01                 	MVI	A,1
  206F'   32 24B8'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  2072'   2A 2563'              	LHLD	SBACK
  2075'   7C                    	MOV	A,H
  2076'   B5                    	ORA	L
  2077'   CA 2082'              	JZ	SUB_PL
  207A'   3E FF                 	MVI	A,0FFH
  207C'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  207F'   CD 0000*              	CALL	CLRCNT
  2082'                         SUB_PL:
  2082'   CD 0EC2'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  2085'   C3 06F4'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  2088'                         SUBNFD:
  2088'   2A 2567'              	LHLD	SOFFS
  208B'   CD 0000*              	CALL	GOTO
  208E'   2A 2569'              	LHLD	SLDLTS
  2091'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  2094'   21 1E31'              	LXI	H,SNOTFD
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  2097'   CD 1DA7'              	CALL	EXERR
  209A'   21 0000*              	LXI	H,SRCHST
  209D'   C3 1DA2'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  20A0'                         SUBBAD:
  20A0'   21 1E1F'              	LXI	H,SNOT
  20A3'   C3 1D9C'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  20A6'                         SUBLIN:
  20A6'   AF                    	XRA	A
  20A7'   32 2562'              	STA	SLCHG
  20AA'   CD 2125'              	CALL	SUBBOL
  20AD'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  20B0'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  20B0'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  20B3'   DA 20BB'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  20B6'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  20B8'   C2 20B0'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  20BB'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  20BB'   CD 0000*              	CALL	CUROFF
  20BE'   E5                    	PUSH	H
  20BF'   CD 1263'              	CALL	CEND
  20C2'   D1                    	POP	D
  20C3'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  20C6'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  20C7'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  20CA'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  20CB'   B7                    	ORA	A		;   span is a line, not a pair.)
  20CC'   FA 211E'              	JM	SUBL_D		; what is left is shorter than the pattern
  20CF'   44                    	MOV	B,H
  20D0'   4D                    	MOV	C,L		; BC = the start positions a match can take
  20D1'   11 0000*              	LXI	D,SRCHST
  20D4'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  20D7'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  20DA'   DA 211E'              	JC	SUBL_D
  20DD'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  20E0'   EB                    	XCHG
  20E1'   2A 0000*              	LHLD	GAPEND
  20E4'   EB                    	XCHG
  20E5'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  20E8'   EB                    	XCHG
  20E9'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  20EA'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  20ED'   D1                    	POP	D
  20EE'   19                    	DAD	D		; ... and so the match's logical offset
  20EF'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


                                	;    lands on the first match, which is where vim leaves it ---
  20F2'   3A 2561'              	LDA	SANY
  20F5'   B7                    	ORA	A
  20F6'   C2 2103'              	JNZ	SUBL_C
  20F9'   3A 2562'              	LDA	SLCHG
  20FC'   B7                    	ORA	A
  20FD'   C2 2103'              	JNZ	SUBL_C
  2100'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  2103'                         SUBL_C:
  2103'   3A 0000*              	LDA	SRCHBF
  2106'   6F                    	MOV	L,A
  2107'   26 00                 	MVI	H,0
  2109'   CD 0000*              	CALL	DELFWD		; the match goes
  210C'   11 256B'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  210F'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  2112'                         SUBL_I:
  2112'   3E 01                 	MVI	A,1
  2114'   32 2562'              	STA	SLCHG
  2117'   3A 2560'              	LDA	SGFLAG
  211A'   B7                    	ORA	A
  211B'   C2 20BB'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  211E'                         SUBL_D:
  211E'   CD 2125'              	CALL	SUBBOL
  2121'   3A 2562'              	LDA	SLCHG
  2124'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  2125'                         SUBBOL:
  2125'   CD 0000*              	CALL	CUROFF
  2128'   CD 05BF'              	CALL	BOL
  212B'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  212E'                         VC_SRCH:
  212E'   CD 06D3'              	CALL	SETMOV
  2131'   C5                    	PUSH	B
  2132'   CD 0666'              	CALL	GETCNT
  2135'   22 2553'              	SHLD	SCNT
  2138'   C1                    	POP	B
  2139'   79                    	MOV	A,C
  213A'   FE 2F                 	CPI	'/'
  213C'   3E 00                 	MVI	A,0
  213E'   CA 2143'              	JZ	VS_DIR
  2141'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  2143'                         VS_DIR:
  2143'   32 2529'              	STA	SDIR
  2146'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2149'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  214C'   47                    	MOV	B,A
  214D'   CD 18F7'              	CALL	RDLINE
  2150'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2151'   C0                    	RNZ			; cancelled: nothing happens at all
  2152'   3A 2501'              	LDA	RLLEN
  2155'   B7                    	ORA	A
  2156'   CA 216B'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  2159'   5F                    	MOV	E,A
  215A'   16 00                 	MVI	D,0
  215C'   21 0000*              	LXI	H,SRCHST
  215F'   19                    	DAD	D
  2160'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  2162'   7B                    	MOV	A,E
  2163'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  2166'   3E 01                 	MVI	A,1
  2168'   32 252B'              	STA	SHAVE
  216B'                         VS_OLD:
  216B'   3A 252B'              	LDA	SHAVE
  216E'   B7                    	ORA	A
  216F'   CA 217B'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  2172'   3A 2529'              	LDA	SDIR
  2175'   32 252A'              	STA	SDIRE
  2178'   C3 21A4'              	JMP	SRCHN
  217B'                         VS_NOP:
  217B'   21 1E45'              	LXI	H,SNOPAT
  217E'   C3 1DA7'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  2181'                         VC_N:
  2181'   CD 06D3'              	CALL	SETMOV
  2184'   3A 2529'              	LDA	SDIR
  2187'   C3 2191'              	JMP	VN_GO
  218A'                         VCB_N:
  218A'   CD 06D3'              	CALL	SETMOV
  218D'   3A 2529'              	LDA	SDIR
  2190'   2F                    	CMA			; the other way: 0 <-> FFH
  2191'                         VN_GO:
  2191'   32 252A'              	STA	SDIRE
  2194'   CD 0666'              	CALL	GETCNT
  2197'   22 2553'              	SHLD	SCNT
  219A'   3A 252B'              	LDA	SHAVE
  219D'   B7                    	ORA	A
  219E'   CA 217B'              	JZ	VS_NOP
  21A1'   C3 21A4'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  21A4'                         SRCHN:
  21A4'   CD 0EAA'              	CALL	GZONE		; the screen's top line, before the cursor moves
  21A7'   2A 0000*              	LHLD	LNDLT
  21AA'   22 2557'              	SHLD	SLDLT		; the sweep moves the cursor with PUTCUR, which
                                				;   does not maintain LNDLT (GOTO does)
  21AD'   CD 0000*              	CALL	CUROFF
  21B0'   22 2555'              	SHLD	SOFF
  21B3'                         SN_LP:
  21B3'   CD 21EB'              	CALL	SRCHGO
  21B6'   DA 21D0'              	JC	SN_BAD
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  21B9'   2A 2553'              	LHLD	SCNT
  21BC'   2B                    	DCX	H
  21BD'   22 2553'              	SHLD	SCNT
  21C0'   7C                    	MOV	A,H
  21C1'   B5                    	ORA	L
  21C2'   C2 21B3'              	JNZ	SN_LP
  21C5'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  21C8'   3E 01                 	MVI	A,1
  21CA'   32 2536'              	STA	GPKEEP		; land on the match, not the first non-blank
  21CD'   C3 0EC2'              	JMP	GPLACE		; (which sets LNDLT itself)
  21D0'                         SN_BAD:
  21D0'   CD 0000*              	CALL	CLRCNT
  21D3'   2A 2555'              	LHLD	SOFF
  21D6'   CD 0000*              	CALL	GOTO
  21D9'   2A 2557'              	LHLD	SLDLT
  21DC'   22 0000*              	SHLD	LNDLT		; nothing moved: the row the cursor was on
  21DF'   21 1E31'              	LXI	H,SNOTFD
  21E2'   CD 1DA7'              	CALL	EXERR
  21E5'   21 0000*              	LXI	H,SRCHST
  21E8'   C3 1DA2'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  21EB'                         SRCHGO:
  21EB'   3E 01                 	MVI	A,1
  21ED'   32 2559'              	STA	SSKIP		; this pass starts one past the cursor
  21F0'   CD 2202'              	CALL	SRCHW
  21F3'   D0                    	RNC
  21F4'   3A 252A'              	LDA	SDIRE
  21F7'   2F                    	CMA
  21F8'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  21FB'   AF                    	XRA	A
  21FC'   32 2559'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  21FF'   C3 2202'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  2202'                         SRCHW:
  2202'   3A 252A'              	LDA	SDIRE
  2205'   32 0000*              	STA	DIRFLG
  2208'   21 FFFF               	LXI	H,0FFFFH
  220B'   22 24B5'              	SHLD	CMDCNT
  220E'   AF                    	XRA	A
  220F'   32 0000*              	STA	AUXCNT
  2212'                         SW_LP:
  2212'   CD 221E'              	CALL	SRCH1
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2215'   D0                    	RNC
  2216'   CD 0000*              	CALL	SCRLST
  2219'   D2 2212'              	JNC	SW_LP
  221C'   37                    	STC
  221D'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  221E'                         SRCH1:
  221E'   11 0000*              	LXI	D,SRCHST
  2221'   3A 0000*              	LDA	DIRFLG
  2224'   B7                    	ORA	A
  2225'   FA 2249'              	JM	SR1_BK
  2228'   21 0000*              	LXI	H,GAPEND
  222B'   CD 0000*              	CALL	FWDCNT
  222E'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  2231'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  2232'   3A 2559'              	LDA	SSKIP
  2235'   B7                    	ORA	A
  2236'   CA 223F'              	JZ	SR1_FW
  2239'   78                    	MOV	A,B
  223A'   B1                    	ORA	C
  223B'   37                    	STC
  223C'   C8                    	RZ			; no room for a match even before the skip
  223D'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  223E'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  223F'                         SR1_FW:
  223F'   CD 0000*              	CALL	MATCHF
  2242'   D8                    	RC
  2243'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2246'   C3 0000*              	JMP	PUTCUR
  2249'                         SR1_BK:
  2249'   21 0000*              	LXI	H,TXTBEG
  224C'   CD 0000*              	CALL	FWDCNT
  224F'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2252'   D8                    	RC
  2253'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2256'   CD 0000*              	CALL	MATCHB
  2259'   D8                    	RC
  225A'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  225D'                         MSGNAM:
  225D'   E5                    	PUSH	H
  225E'   3E 22                 	MVI	A,'"'
  2260'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  2263'   E1                    	POP	H
  2264'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  2265'   23                    	INX	H
  2266'   7E                    	MOV	A,M
  2267'   FE 20                 	CPI	' '
  2269'   C2 2276'              	JNZ	MN_HAS
  226C'   21 1EA1'              	LXI	H,SNONM
  226F'   CD 0000*              	CALL	OUTSTR
  2272'   E1                    	POP	H
  2273'   C3 22C0'              	JMP	MN_END
  2276'                         MN_HAS:
  2276'   0E 19                 	MVI	C,BF_CURDSK
  2278'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  227B'   E1                    	POP	H
  227C'   E5                    	PUSH	H
  227D'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  227E'   BE                    	CMP	M
  227F'   CA 228D'              	JZ	MN_NAM
  2282'   7E                    	MOV	A,M
  2283'   C6 40                 	ADI	'A'-1
  2285'   CD 0000*              	CALL	OUTCH
  2288'   3E 3A                 	MVI	A,':'
  228A'   CD 0000*              	CALL	OUTCH
  228D'                         MN_NAM:
  228D'   E1                    	POP	H
  228E'   E5                    	PUSH	H
  228F'   23                    	INX	H
  2290'   0E 08                 	MVI	C,8
  2292'                         MN_NM:
  2292'   7E                    	MOV	A,M
  2293'   FE 20                 	CPI	' '
  2295'   CA 22A0'              	JZ	MN_EXT
  2298'   CD 0000*              	CALL	OUTCH
  229B'   23                    	INX	H
  229C'   0D                    	DCR	C
  229D'   C2 2292'              	JNZ	MN_NM
  22A0'                         MN_EXT:
  22A0'   E1                    	POP	H
  22A1'   11 0009               	LXI	D,9
  22A4'   19                    	DAD	D		; the type field
  22A5'   7E                    	MOV	A,M
  22A6'   FE 20                 	CPI	' '
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  22A8'   CA 22C0'              	JZ	MN_END
  22AB'   3E 2E                 	MVI	A,'.'
  22AD'   CD 0000*              	CALL	OUTCH
  22B0'   0E 03                 	MVI	C,3
  22B2'                         MN_XL:
  22B2'   7E                    	MOV	A,M
  22B3'   FE 20                 	CPI	' '
  22B5'   CA 22C0'              	JZ	MN_END
  22B8'   CD 0000*              	CALL	OUTCH
  22BB'   23                    	INX	H
  22BC'   0D                    	DCR	C
  22BD'   C2 22B2'              	JNZ	MN_XL
  22C0'                         MN_END:
  22C0'   3E 22                 	MVI	A,'"'
  22C2'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  22C5'                         MSGFLG:
  22C5'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  22C7'   B7                    	ORA	A
  22C8'   CA 22D8'              	JZ	MF_RO
  22CB'   3A 24B8'              	LDA	MODF
  22CE'   B7                    	ORA	A
  22CF'   CA 22D8'              	JZ	MF_RO
  22D2'   21 1EAB'              	LXI	H,SMODM
  22D5'   CD 22ED'              	CALL	MF_PUT
  22D8'                         MF_RO:
  22D8'   3A 2517'              	LDA	ROFLAG
  22DB'   B7                    	ORA	A
  22DC'   CA 22E5'              	JZ	MF_NEW
  22DF'   21 1EB6'              	LXI	H,SROM
  22E2'   CD 22ED'              	CALL	MF_PUT
  22E5'                         MF_NEW:
  22E5'   3A 2515'              	LDA	MSGNEW
  22E8'   B7                    	ORA	A
  22E9'   C8                    	RZ
  22EA'   21 1EC1'              	LXI	H,SNEWM
  22ED'                         MF_PUT:
  22ED'   78                    	MOV	A,B
  22EE'   B7                    	ORA	A
  22EF'   C2 22FB'              	JNZ	MF_STR
  22F2'   06 01                 	MVI	B,1
  22F4'   E5                    	PUSH	H
  22F5'   3E 20                 	MVI	A,' '
  22F7'   CD 0000*              	CALL	OUTCH
  22FA'   E1                    	POP	H
  22FB'                         MF_STR:
  22FB'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  22FE'                         EMITW:
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  22FE'   C5                    	PUSH	B
  22FF'   D5                    	PUSH	D
  2300'   06 00                 	MVI	B,0
  2302'   11 2710               	LXI	D,10000
  2305'   CD 2323'              	CALL	EWDIG
  2308'   11 03E8               	LXI	D,1000
  230B'   CD 2323'              	CALL	EWDIG
  230E'   11 0064               	LXI	D,100
  2311'   CD 2323'              	CALL	EWDIG
  2314'   11 000A               	LXI	D,10
  2317'   CD 2323'              	CALL	EWDIG
  231A'   7D                    	MOV	A,L		; the units digit is always printed
  231B'   C6 30                 	ADI	'0'
  231D'   CD 0000*              	CALL	OUTCH
  2320'   D1                    	POP	D
  2321'   C1                    	POP	B
  2322'   C9                    	RET
  2323'                         EWDIG:
  2323'   0E 00                 	MVI	C,0
  2325'                         EW_LP:
  2325'   7D                    	MOV	A,L
  2326'   93                    	SUB	E
  2327'   6F                    	MOV	L,A
  2328'   7C                    	MOV	A,H
  2329'   9A                    	SBB	D
  232A'   67                    	MOV	H,A
  232B'   DA 2332'              	JC	EW_DN
  232E'   0C                    	INR	C
  232F'   C3 2325'              	JMP	EW_LP
  2332'                         EW_DN:
  2332'   19                    	DAD	D		; one subtraction too many: give it back
  2333'   79                    	MOV	A,C
  2334'   B7                    	ORA	A
  2335'   C2 233B'              	JNZ	EW_PR
  2338'   78                    	MOV	A,B
  2339'   B7                    	ORA	A
  233A'   C8                    	RZ			; a leading zero: write nothing
  233B'                         EW_PR:
  233B'   79                    	MOV	A,C
  233C'   C6 30                 	ADI	'0'
  233E'   CD 0000*              	CALL	OUTCH
  2341'   06 01                 	MVI	B,1
  2343'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  2344'                         ISEMPT:
  2344'   2A 0000*              	LHLD	OUTPOS
  2347'   7C                    	MOV	A,H
  2348'   B5                    	ORA	L
  2349'   C0                    	RNZ
  234A'   CD 0000*              	CALL	LOGLEN
  234D'   7C                    	MOV	A,H
  234E'   B5                    	ORA	L
  234F'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  2350'                         MSGCTG:
  2350'   21 0000*              	LXI	H,FNAME
  2353'   CD 225D'              	CALL	MSGNAM
  2356'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  2358'   CD 22C5'              	CALL	MSGFLG
  235B'   CD 2344'              	CALL	ISEMPT
  235E'   C2 2367'              	JNZ	MG_POS
  2361'   21 1ED4'              	LXI	H,SNOLIN
  2364'   C3 0000*              	JMP	OUTSTR
  2367'                         MG_POS:
  2367'   21 1EC7'              	LXI	H,SLINE
  236A'   CD 0000*              	CALL	OUTSTR
  236D'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  2370'   23                    	INX	H		;   ... so the line it is on
  2371'   CD 22FE'              	CALL	EMITW
  2374'   21 1ECE'              	LXI	H,SCOLM
  2377'   CD 0000*              	CALL	OUTSTR
  237A'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  237D'   23                    	INX	H
  237E'   E5                    	PUSH	H
  237F'   CD 22FE'              	CALL	EMITW
  2382'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  2385'   23                    	INX	H
  2386'   D1                    	POP	D
  2387'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  238A'   C8                    	RZ
  238B'   E5                    	PUSH	H
  238C'   3E 2D                 	MVI	A,'-'
  238E'   CD 0000*              	CALL	OUTCH
  2391'   E1                    	POP	H
  2392'   C3 22FE'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  2395'                         FILMSG:
  2395'   3A 0001*              	LDA	FNAME+1
  2398'   FE 20                 	CPI	' '
  239A'   C8                    	RZ
  239B'   21 0000*              	LXI	H,FNAME
  239E'   CD 225D'              	CALL	MSGNAM
  23A1'   AF                    	XRA	A		; nothing has been changed yet
  23A2'   C3 22C5'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  23A5'                         WRMSG:
  23A5'   21 0000*              	LXI	H,TFCB
  23A8'   CD 225D'              	CALL	MSGNAM
  23AB'   21 1EE6'              	LXI	H,SWRIT
  23AE'   C3 0000*              	JMP	OUTSTR
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  23B1'                         MSGPST:
  23B1'   3A 2514'              	LDA	MSGWHT
  23B4'   B7                    	ORA	A
  23B5'   C8                    	RZ
  23B6'   47                    	MOV	B,A
  23B7'   AF                    	XRA	A
  23B8'   32 2514'              	STA	MSGWHT
  23BB'   78                    	MOV	A,B
  23BC'   FE 01                 	CPI	MW_FIL
  23BE'   CA 23CC'              	JZ	MP_FIL
  23C1'   FE 02                 	CPI	MW_WRT
  23C3'   CA 23D2'              	JZ	MP_WRT
  23C6'   CD 2350'              	CALL	MSGCTG
  23C9'   C3 0000*              	JMP	SCURS
  23CC'                         MP_FIL:
  23CC'   CD 2395'              	CALL	FILMSG
  23CF'   C3 0000*              	JMP	SCURS
  23D2'                         MP_WRT:
  23D2'   CD 23A5'              	CALL	WRMSG
  23D5'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  23D8'                         VC_CTLG:
  23D8'   3E 03                 	MVI	A,MW_CTG
  23DA'   32 2514'              	STA	MSGWHT
  23DD'   3E 01                 	MVI	A,R_MOVE
  23DF'   32 24B9'              	STA	RINTENT
  23E2'   C9                    	RET
                                
  23E3'                         CMDTAB:
  23E3'   07                    	DB	07H			; ^G -- where am I?
  23E4'   23D8'                 	DW	VC_CTLG
  23E6'   68                    	DB	'h'
  23E7'   072C'                 	DW	VC_H
  23E9'   6C                    	DB	'l'
  23EA'   0756'                 	DW	VC_L
  23EC'   6A                    	DB	'j'
  23ED'   081B'                 	DW	VC_J
  23EF'   6B                    	DB	'k'
  23F0'   082A'                 	DW	VC_K
  23F2'   30                    	DB	'0'
  23F3'   077D'                 	DW	VC_0
  23F5'   5E                    	DB	'^'
  23F6'   079B'                 	DW	VC_CRT
  23F8'   24                    	DB	'$'
  23F9'   07D9'                 	DW	VC_EOL
  23FB'   0D                    	DB	CR			; <CR> -- down to the first non-blank
  23FC'   07FD'                 	DW	VC_CR
  23FE'   77                    	DB	'w'
  23FF'   09FF'                 	DW	VC_W
  2401'   62                    	DB	'b'
  2402'   0A50'                 	DW	VC_B
