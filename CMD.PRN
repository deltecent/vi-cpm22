  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  0008                          EO_R	EQU	8
  285E'                         EXTAB:
  285E'   77 00 01              	DB	'w',0,EO_W
  2861'   71 00 02              	DB	'q',0,EO_Q
  2864'   77 71 03              	DB	'w','q',EO_WQ
  2867'   78 00 04              	DB	'x',0,EO_X
  286A'   65 00 05              	DB	'e',0,EO_E
  286D'   73 00 06              	DB	's',0,EO_S
  2870'   76 65 07              	DB	'v','e',EO_V
  2873'   72 00 08              	DB	'r',0,EO_R
  2876'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
	MACRO-80 3.44	09-Dec-81	PAGE	1-125


                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  2877'                         EXADDR:
  2877'   AF                    	XRA	A
  2878'   32 2EC4'              	STA	SRNGF
  287B'   7E                    	MOV	A,M
  287C'   FE 25                 	CPI	'%'
  287E'   CA 28A7'              	JZ	EXA_AL
  2881'   EB                    	XCHG			; DE walks the line, HL takes the number
  2882'   CD 28BC'              	CALL	EXNUM
  2885'   DA 28A5'              	JC	EXA_NO
  2888'   22 2EC5'              	SHLD	SRNG1
  288B'   22 2EC7'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  288E'   1A                    	LDAX	D
  288F'   FE 2C                 	CPI	','
  2891'   C2 289E'              	JNZ	EXA_YS
  2894'   13                    	INX	D
  2895'   CD 28BC'              	CALL	EXNUM
  2898'   DA 28A5'              	JC	EXA_NO		; ',' with no number: not a range at all
  289B'   22 2EC7'              	SHLD	SRNG2
	MACRO-80 3.44	09-Dec-81	PAGE	1-126


  289E'                         EXA_YS:
  289E'   EB                    	XCHG
  289F'   3E 01                 	MVI	A,1
  28A1'   32 2EC4'              	STA	SRNGF
  28A4'   C9                    	RET
  28A5'                         EXA_NO:
  28A5'   EB                    	XCHG
  28A6'   C9                    	RET
  28A7'                         EXA_AL:
  28A7'   23                    	INX	H
  28A8'   E5                    	PUSH	H
  28A9'   21 0001               	LXI	H,1
  28AC'   22 2EC5'              	SHLD	SRNG1
  28AF'   21 FFFF               	LXI	H,0FFFFH
  28B2'   22 2EC7'              	SHLD	SRNG2
  28B5'   E1                    	POP	H
  28B6'   3E 01                 	MVI	A,1
  28B8'   32 2EC4'              	STA	SRNGF
  28BB'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  28BC'                         EXNUM:
  28BC'   1A                    	LDAX	D
  28BD'   D6 30                 	SUI	'0'
  28BF'   D8                    	RC
  28C0'   FE 0A                 	CPI	10
  28C2'   3F                    	CMC
  28C3'   D8                    	RC
  28C4'   21 0000               	LXI	H,0
  28C7'                         EXN_LP:
  28C7'   1A                    	LDAX	D
  28C8'   D6 30                 	SUI	'0'
  28CA'   DA 28E4'              	JC	EXN_DN
  28CD'   FE 0A                 	CPI	10
  28CF'   D2 28E4'              	JNC	EXN_DN
  28D2'   13                    	INX	D
  28D3'   C5                    	PUSH	B
  28D4'   4F                    	MOV	C,A
  28D5'   06 00                 	MVI	B,0		; BC = the digit
  28D7'   D5                    	PUSH	D
  28D8'   54                    	MOV	D,H
  28D9'   5D                    	MOV	E,L
  28DA'   29                    	DAD	H		; *2
  28DB'   29                    	DAD	H		; *4
  28DC'   19                    	DAD	D		; *5
  28DD'   29                    	DAD	H		; *10
  28DE'   D1                    	POP	D
  28DF'   09                    	DAD	B
  28E0'   C1                    	POP	B
  28E1'   C3 28C7'              	JMP	EXN_LP
  28E4'                         EXN_DN:
  28E4'   B7                    	ORA	A		; CY clear: there was a number
  28E5'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
	MACRO-80 3.44	09-Dec-81	PAGE	1-127


  28E6'                         EX_S:
  28E6'   7E                    	MOV	A,M
  28E7'   B7                    	ORA	A
  28E8'   CA 292A'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  28EB'   32 2EC9'              	STA	SDELIM
  28EE'   23                    	INX	H
  28EF'   11 0000*              	LXI	D,SRCHST
  28F2'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  28F5'   4F                    	MOV	C,A
  28F6'   CD 2930'              	CALL	SCOPY
  28F9'   78                    	MOV	A,B
  28FA'   B7                    	ORA	A
  28FB'   CA 292A'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  28FE'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  2901'   3E 01                 	MVI	A,1
  2903'   32 2E91'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  2906'   11 2EDB'              	LXI	D,SREPL
  2909'   0E 24                 	MVI	C,SREPMX
  290B'   CD 2930'              	CALL	SCOPY
  290E'   78                    	MOV	A,B
  290F'   32 2EDA'              	STA	SREPLN
  2912'   AF                    	XRA	A
  2913'   32 2ECA'              	STA	SGFLAG
  2916'   7E                    	MOV	A,M
  2917'   FE 67                 	CPI	'g'
  2919'   C2 2922'              	JNZ	EX_SG
  291C'   23                    	INX	H
  291D'   3E 01                 	MVI	A,1
  291F'   32 2ECA'              	STA	SGFLAG
  2922'                         EX_SG:
  2922'   7E                    	MOV	A,M
  2923'   B7                    	ORA	A
  2924'   C2 26B1'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  2927'   C3 2950'              	JMP	SUBGO
  292A'                         SUBNOP:
  292A'   21 2779'              	LXI	H,SNOPAT
  292D'   C3 26BF'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  2930'                         SCOPY:
  2930'   06 00                 	MVI	B,0
  2932'                         SCP_LP:
  2932'   78                    	MOV	A,B
  2933'   B9                    	CMP	C
  2934'   D2 294D'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  2937'   7E                    	MOV	A,M
  2938'   B7                    	ORA	A
  2939'   CA 294D'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  293C'   E5                    	PUSH	H
  293D'   21 2EC9'              	LXI	H,SDELIM
  2940'   BE                    	CMP	M
  2941'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-128


  2942'   CA 294C'              	JZ	SCP_SK
  2945'   12                    	STAX	D
  2946'   13                    	INX	D
  2947'   23                    	INX	H
  2948'   04                    	INR	B
  2949'   C3 2932'              	JMP	SCP_LP
  294C'                         SCP_SK:
  294C'   23                    	INX	H
  294D'                         SCP_DN:
  294D'   AF                    	XRA	A
  294E'   12                    	STAX	D
  294F'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  2950'                         SUBGO:
  2950'   CD 12DF'              	CALL	GZONE
  2953'   2A 0000*              	LHLD	LNDLT
  2956'   22 2ED8'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  2959'   21 2ED5'              	LXI	H,SOFFS		;   finds nothing puts both back, as the
  295C'   CD 0429'              	CALL	FPSTO		;   search's SN_BAD does
  295F'   AF                    	XRA	A
  2960'   32 2ECB'              	STA	SANY
  2963'   21 0000               	LXI	H,0
  2966'   22 2ECD'              	SHLD	SBACK
  2969'   3A 2EC4'              	LDA	SRNGF
  296C'   B7                    	ORA	A
  296D'   CA 297F'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  2970'   CD 223F'              	CALL	EXRNG		; SLINES = the lines in the range
  2973'   DA 29FB'              	JC	SUBBAD
  2976'   2A 2EC5'              	LHLD	SRNG1
  2979'   CD 124D'              	CALL	GOLN
  297C'   C3 2985'              	JMP	SUBLP
  297F'                         SUB_1L:
  297F'   21 0001               	LXI	H,1
  2982'   22 2ECF'              	SHLD	SLINES
  2985'                         SUBLP:
  2985'   CD 2A01'              	CALL	SUBLIN		; A = 1 when this line changed
  2988'   B7                    	ORA	A
  2989'   CA 2997'              	JZ	SUB_NX
  298C'   3E 01                 	MVI	A,1
  298E'   32 2ECB'              	STA	SANY
  2991'   21 0000               	LXI	H,0
  2994'   22 2ECD'              	SHLD	SBACK		; the cursor is ON the last line changed
  2997'                         SUB_NX:
  2997'   2A 2ECF'              	LHLD	SLINES
  299A'   2B                    	DCX	H
  299B'   22 2ECF'              	SHLD	SLINES
  299E'   7C                    	MOV	A,H
  299F'   B5                    	ORA	L
  29A0'   CA 29BE'              	JZ	SUBDON		; the range is spent
  29A3'   21 0001               	LXI	H,1
  29A6'   AF                    	XRA	A
  29A7'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
	MACRO-80 3.44	09-Dec-81	PAGE	1-129


  29AA'   3A 2ECB'              	LDA	SANY
  29AD'   B7                    	ORA	A
  29AE'   CA 29B8'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  29B1'   2A 2ECD'              	LHLD	SBACK
  29B4'   23                    	INX	H
  29B5'   22 2ECD'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  29B8'                         SUB_AE:
  29B8'   CD 0AE9'              	CALL	ATEOF
  29BB'   D2 2985'              	JNC	SUBLP		; ... unless that ran off the end of the file
  29BE'                         SUBDON:
  29BE'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  29C1'   3A 2ECB'              	LDA	SANY
  29C4'   B7                    	ORA	A
  29C5'   CA 29E3'              	JZ	SUBNFD
  29C8'   3E 01                 	MVI	A,1
  29CA'   32 2E06'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  29CD'   2A 2ECD'              	LHLD	SBACK
  29D0'   7C                    	MOV	A,H
  29D1'   B5                    	ORA	L
  29D2'   CA 29DD'              	JZ	SUB_PL
  29D5'   3E FF                 	MVI	A,0FFH
  29D7'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  29DA'   CD 0000*              	CALL	CLRCNT
  29DD'                         SUB_PL:
  29DD'   CD 12F7'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  29E0'   C3 0844'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  29E3'                         SUBNFD:
  29E3'   21 2ED5'              	LXI	H,SOFFS
  29E6'   CD 03D0'              	CALL	BACKTO
  29E9'   2A 2ED8'              	LHLD	SLDLTS
  29EC'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  29EF'   21 2749'              	LXI	H,SNOTFD
  29F2'   CD 26BF'              	CALL	EXERR
  29F5'   21 0000*              	LXI	H,SRCHST
  29F8'   C3 26BA'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  29FB'                         SUBBAD:
  29FB'   21 2737'              	LXI	H,SNOT
  29FE'   C3 26B4'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
	MACRO-80 3.44	09-Dec-81	PAGE	1-130


                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  2A01'                         SUBLIN:
  2A01'   AF                    	XRA	A
  2A02'   32 2ECC'              	STA	SLCHG
  2A05'   CD 2A80'              	CALL	SUBBOL
  2A08'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  2A0B'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  2A0B'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  2A0E'   DA 2A16'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  2A11'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  2A13'   C2 2A0B'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  2A16'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  2A16'   CD 0000*              	CALL	CUROFF
  2A19'   E5                    	PUSH	H
  2A1A'   CD 18C0'              	CALL	CEND
  2A1D'   D1                    	POP	D
  2A1E'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  2A21'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  2A22'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  2A25'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  2A26'   B7                    	ORA	A		;   span is a line, not a pair.)
  2A27'   FA 2A79'              	JM	SUBL_D		; what is left is shorter than the pattern
  2A2A'   44                    	MOV	B,H
  2A2B'   4D                    	MOV	C,L		; BC = the start positions a match can take
  2A2C'   11 0000*              	LXI	D,SRCHST
  2A2F'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  2A32'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  2A35'   DA 2A79'              	JC	SUBL_D
  2A38'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  2A3B'   EB                    	XCHG
  2A3C'   2A 0000*              	LHLD	GAPEND
  2A3F'   EB                    	XCHG
  2A40'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  2A43'   EB                    	XCHG
  2A44'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  2A45'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  2A48'   D1                    	POP	D
  2A49'   19                    	DAD	D		; ... and so the match's logical offset
  2A4A'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  2A4D'   3A 2ECB'              	LDA	SANY
  2A50'   B7                    	ORA	A
  2A51'   C2 2A5E'              	JNZ	SUBL_C
  2A54'   3A 2ECC'              	LDA	SLCHG
  2A57'   B7                    	ORA	A
  2A58'   C2 2A5E'              	JNZ	SUBL_C
  2A5B'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
	MACRO-80 3.44	09-Dec-81	PAGE	1-131


                                				;   gap ('COPY ERR')
  2A5E'                         SUBL_C:
  2A5E'   3A 0000*              	LDA	SRCHBF
  2A61'   6F                    	MOV	L,A
  2A62'   26 00                 	MVI	H,0
  2A64'   CD 0000*              	CALL	DELFWD		; the match goes
  2A67'   11 2EDA'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  2A6A'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  2A6D'                         SUBL_I:
  2A6D'   3E 01                 	MVI	A,1
  2A6F'   32 2ECC'              	STA	SLCHG
  2A72'   3A 2ECA'              	LDA	SGFLAG
  2A75'   B7                    	ORA	A
  2A76'   C2 2A16'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  2A79'                         SUBL_D:
  2A79'   CD 2A80'              	CALL	SUBBOL
  2A7C'   3A 2ECC'              	LDA	SLCHG
  2A7F'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  2A80'                         SUBBOL:
  2A80'   CD 0000*              	CALL	CUROFF
  2A83'   CD 0624'              	CALL	BOL
  2A86'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  2A89'                         VC_SRCH:
  2A89'   CD 0807'              	CALL	SETMOV
  2A8C'   C5                    	PUSH	B
  2A8D'   CD 0732'              	CALL	GETCNT
  2A90'   22 2EBA'              	SHLD	SCNT
  2A93'   C1                    	POP	B
  2A94'   79                    	MOV	A,C
  2A95'   FE 2F                 	CPI	'/'
  2A97'   3E 00                 	MVI	A,0
  2A99'   CA 2A9E'              	JZ	VS_DIR
  2A9C'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  2A9E'                         VS_DIR:
  2A9E'   32 2E8F'              	STA	SDIR
  2AA1'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2AA4'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2AA7'   47                    	MOV	B,A
  2AA8'   CD 1FE8'              	CALL	RDLINE
  2AAB'   B7                    	ORA	A
  2AAC'   C0                    	RNZ			; cancelled: nothing happens at all
  2AAD'   3A 2E66'              	LDA	RLLEN
  2AB0'   B7                    	ORA	A
  2AB1'   CA 2AC6'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  2AB4'   5F                    	MOV	E,A
  2AB5'   16 00                 	MVI	D,0
  2AB7'   21 0000*              	LXI	H,SRCHST
  2ABA'   19                    	DAD	D
  2ABB'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
	MACRO-80 3.44	09-Dec-81	PAGE	1-132


  2ABD'   7B                    	MOV	A,E
  2ABE'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  2AC1'   3E 01                 	MVI	A,1
  2AC3'   32 2E91'              	STA	SHAVE
  2AC6'                         VS_OLD:
  2AC6'   3A 2E91'              	LDA	SHAVE
  2AC9'   B7                    	ORA	A
  2ACA'   CA 2AD6'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  2ACD'   3A 2E8F'              	LDA	SDIR
  2AD0'   32 2E90'              	STA	SDIRE
  2AD3'   C3 2AFF'              	JMP	SRCHN
  2AD6'                         VS_NOP:
  2AD6'   21 2779'              	LXI	H,SNOPAT
  2AD9'   C3 26BF'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  2ADC'                         VC_N:
  2ADC'   CD 0807'              	CALL	SETMOV
  2ADF'   3A 2E8F'              	LDA	SDIR
  2AE2'   C3 2AEC'              	JMP	VN_GO
  2AE5'                         VCB_N:
  2AE5'   CD 0807'              	CALL	SETMOV
  2AE8'   3A 2E8F'              	LDA	SDIR
  2AEB'   2F                    	CMA			; the other way: 0 <-> FFH
  2AEC'                         VN_GO:
  2AEC'   32 2E90'              	STA	SDIRE
  2AEF'   CD 0732'              	CALL	GETCNT
  2AF2'   22 2EBA'              	SHLD	SCNT
  2AF5'   3A 2E91'              	LDA	SHAVE
  2AF8'   B7                    	ORA	A
  2AF9'   CA 2AD6'              	JZ	VS_NOP
  2AFC'   C3 2AFF'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  2AFF'                         SRCHN:
  2AFF'   CD 12DF'              	CALL	GZONE		; the screen's top line, before the cursor moves
  2B02'   CD 075B'              	CALL	BRKON		; where it started (the sweep moves the cursor
                                				;   with PUTCUR, which does not maintain LNDLT;
                                				;   GOTO does), and an ESC may stop it
  2B05'                         SN_LP:
  2B05'   CD 2B3A'              	CALL	SRCHGO
  2B08'   DA 2B25'              	JC	SN_BAD
  2B0B'   2A 2EBA'              	LHLD	SCNT
  2B0E'   2B                    	DCX	H
  2B0F'   22 2EBA'              	SHLD	SCNT
  2B12'   7C                    	MOV	A,H
  2B13'   B5                    	ORA	L
  2B14'   C2 2B05'              	JNZ	SN_LP
  2B17'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  2B1A'   CD 0798'              	CALL	BRKOFF
  2B1D'   3E 01                 	MVI	A,1
  2B1F'   32 2E9C'              	STA	GPKEEP		; land on the match, not the first non-blank
  2B22'   C3 12F7'              	JMP	GPLACE		; (which sets LNDLT itself)
	MACRO-80 3.44	09-Dec-81	PAGE	1-133


  2B25'                         SN_BAD:
  2B25'   CD 0798'              	CALL	BRKOFF
  2B28'   DA 07B0'              	JC	BRKBAK		; stopped, which is not the same as not found
  2B2B'   CD 07A3'              	CALL	RSTPL		; nothing moved: the row the cursor was on
  2B2E'   21 2749'              	LXI	H,SNOTFD
  2B31'   CD 26BF'              	CALL	EXERR
  2B34'   21 0000*              	LXI	H,SRCHST
  2B37'   C3 26BA'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  2B3A'                         SRCHGO:
  2B3A'   3E 01                 	MVI	A,1
  2B3C'   32 2EC3'              	STA	SSKIP		; this pass starts one past the cursor
  2B3F'   CD 2B55'              	CALL	SRCHW
  2B42'   D0                    	RNC
  2B43'   CD 079C'              	CALL	BRKQ
  2B46'   D8                    	RC			; stopped: no second pass
  2B47'   3A 2E90'              	LDA	SDIRE
  2B4A'   2F                    	CMA
  2B4B'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  2B4E'   AF                    	XRA	A
  2B4F'   32 2EC3'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  2B52'   C3 2B55'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  2B55'                         SRCHW:
  2B55'   3A 2E90'              	LDA	SDIRE
  2B58'   32 0000*              	STA	DIRFLG
  2B5B'   21 FFFF               	LXI	H,0FFFFH
  2B5E'   22 2E03'              	SHLD	CMDCNT
  2B61'   AF                    	XRA	A
  2B62'   32 0000*              	STA	AUXCNT
  2B65'                         SW_LP:
  2B65'   CD 079C'              	CALL	BRKQ		; an ESC spent the count, here or on the way to
  2B68'   D8                    	RC			;   the wrapped pass: SCRLST no longer pages
  2B69'   CD 2B75'              	CALL	SRCH1
  2B6C'   D0                    	RNC
  2B6D'   CD 0000*              	CALL	SCRLST
  2B70'   D2 2B65'              	JNC	SW_LP
  2B73'   37                    	STC
  2B74'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
	MACRO-80 3.44	09-Dec-81	PAGE	1-134


  2B75'                         SRCH1:
  2B75'   11 0000*              	LXI	D,SRCHST
  2B78'   3A 0000*              	LDA	DIRFLG
  2B7B'   B7                    	ORA	A
  2B7C'   FA 2BA0'              	JM	SR1_BK
  2B7F'   21 0000*              	LXI	H,GAPEND
  2B82'   CD 0000*              	CALL	FWDCNT
  2B85'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  2B88'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  2B89'   3A 2EC3'              	LDA	SSKIP
  2B8C'   B7                    	ORA	A
  2B8D'   CA 2B96'              	JZ	SR1_FW
  2B90'   78                    	MOV	A,B
  2B91'   B1                    	ORA	C
  2B92'   37                    	STC
  2B93'   C8                    	RZ			; no room for a match even before the skip
  2B94'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2B95'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2B96'                         SR1_FW:
  2B96'   CD 0000*              	CALL	MATCHF
  2B99'   D8                    	RC
  2B9A'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2B9D'   C3 0000*              	JMP	PUTCUR
  2BA0'                         SR1_BK:
  2BA0'   21 0000*              	LXI	H,TXTBEG
  2BA3'   CD 0000*              	CALL	FWDCNT
  2BA6'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2BA9'   D8                    	RC
  2BAA'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2BAD'   CD 0000*              	CALL	MATCHB
  2BB0'   D8                    	RC
  2BB1'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
	MACRO-80 3.44	09-Dec-81	PAGE	1-135


                                ; it is another one: "B:TEST.TXT".
  2BB4'                         MSGNAM:
  2BB4'   E5                    	PUSH	H
  2BB5'   3E 22                 	MVI	A,'"'
  2BB7'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  2BBA'   E1                    	POP	H
  2BBB'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  2BBC'   23                    	INX	H
  2BBD'   7E                    	MOV	A,M
  2BBE'   FE 20                 	CPI	' '
  2BC0'   C2 2BCD'              	JNZ	MN_HAS
  2BC3'   21 27E7'              	LXI	H,SNONM
  2BC6'   CD 0000*              	CALL	OUTSTR
  2BC9'   E1                    	POP	H
  2BCA'   C3 2C17'              	JMP	MN_END
  2BCD'                         MN_HAS:
  2BCD'   0E 19                 	MVI	C,BF_CURDSK
  2BCF'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  2BD2'   E1                    	POP	H
  2BD3'   E5                    	PUSH	H
  2BD4'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  2BD5'   BE                    	CMP	M
  2BD6'   CA 2BE4'              	JZ	MN_NAM
  2BD9'   7E                    	MOV	A,M
  2BDA'   C6 40                 	ADI	'A'-1
  2BDC'   CD 0000*              	CALL	OUTCH
  2BDF'   3E 3A                 	MVI	A,':'
  2BE1'   CD 0000*              	CALL	OUTCH
  2BE4'                         MN_NAM:
  2BE4'   E1                    	POP	H
  2BE5'   E5                    	PUSH	H
  2BE6'   23                    	INX	H
  2BE7'   0E 08                 	MVI	C,8
  2BE9'                         MN_NM:
  2BE9'   7E                    	MOV	A,M
  2BEA'   FE 20                 	CPI	' '
  2BEC'   CA 2BF7'              	JZ	MN_EXT
  2BEF'   CD 0000*              	CALL	OUTCH
  2BF2'   23                    	INX	H
  2BF3'   0D                    	DCR	C
  2BF4'   C2 2BE9'              	JNZ	MN_NM
  2BF7'                         MN_EXT:
  2BF7'   E1                    	POP	H
  2BF8'   11 0009               	LXI	D,9
  2BFB'   19                    	DAD	D		; the type field
  2BFC'   7E                    	MOV	A,M
  2BFD'   FE 20                 	CPI	' '
  2BFF'   CA 2C17'              	JZ	MN_END
  2C02'   3E 2E                 	MVI	A,'.'
  2C04'   CD 0000*              	CALL	OUTCH
  2C07'   0E 03                 	MVI	C,3
  2C09'                         MN_XL:
  2C09'   7E                    	MOV	A,M
  2C0A'   FE 20                 	CPI	' '
  2C0C'   CA 2C17'              	JZ	MN_END
  2C0F'   CD 0000*              	CALL	OUTCH
	MACRO-80 3.44	09-Dec-81	PAGE	1-136


  2C12'   23                    	INX	H
  2C13'   0D                    	DCR	C
  2C14'   C2 2C09'              	JNZ	MN_XL
  2C17'                         MN_END:
  2C17'   3E 22                 	MVI	A,'"'
  2C19'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  2C1C'                         MSGFLG:
  2C1C'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  2C1E'   B7                    	ORA	A
  2C1F'   CA 2C2F'              	JZ	MF_RO
  2C22'   3A 2E06'              	LDA	MODF
  2C25'   B7                    	ORA	A
  2C26'   CA 2C2F'              	JZ	MF_RO
  2C29'   21 27F1'              	LXI	H,SMODM
  2C2C'   CD 2C44'              	CALL	MF_PUT
  2C2F'                         MF_RO:
  2C2F'   3A 2E7C'              	LDA	ROFLAG
  2C32'   B7                    	ORA	A
  2C33'   CA 2C3C'              	JZ	MF_NEW
  2C36'   21 27FC'              	LXI	H,SROM
  2C39'   CD 2C44'              	CALL	MF_PUT
  2C3C'                         MF_NEW:
  2C3C'   3A 2E7A'              	LDA	MSGNEW
  2C3F'   B7                    	ORA	A
  2C40'   C8                    	RZ
  2C41'   21 2807'              	LXI	H,SNEWM
  2C44'                         MF_PUT:
  2C44'   78                    	MOV	A,B
  2C45'   B7                    	ORA	A
  2C46'   C2 2C52'              	JNZ	MF_STR
  2C49'   06 01                 	MVI	B,1
  2C4B'   E5                    	PUSH	H
  2C4C'   3E 20                 	MVI	A,' '
  2C4E'   CD 0000*              	CALL	OUTCH
  2C51'   E1                    	POP	H
  2C52'                         MF_STR:
  2C52'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  2C55'                         EMITW:
  2C55'   C5                    	PUSH	B
  2C56'   D5                    	PUSH	D
  2C57'   06 00                 	MVI	B,0
  2C59'   11 2710               	LXI	D,10000
  2C5C'   CD 2C7A'              	CALL	EWDIG
  2C5F'   11 03E8               	LXI	D,1000
  2C62'   CD 2C7A'              	CALL	EWDIG
  2C65'   11 0064               	LXI	D,100
  2C68'   CD 2C7A'              	CALL	EWDIG
	MACRO-80 3.44	09-Dec-81	PAGE	1-137


  2C6B'   11 000A               	LXI	D,10
  2C6E'   CD 2C7A'              	CALL	EWDIG
  2C71'   7D                    	MOV	A,L		; the units digit is always printed
  2C72'   C6 30                 	ADI	'0'
  2C74'   CD 0000*              	CALL	OUTCH
  2C77'   D1                    	POP	D
  2C78'   C1                    	POP	B
  2C79'   C9                    	RET
  2C7A'                         EWDIG:
  2C7A'   0E 00                 	MVI	C,0
  2C7C'                         EW_LP:
  2C7C'   7D                    	MOV	A,L
  2C7D'   93                    	SUB	E
  2C7E'   6F                    	MOV	L,A
  2C7F'   7C                    	MOV	A,H
  2C80'   9A                    	SBB	D
  2C81'   67                    	MOV	H,A
  2C82'   DA 2C89'              	JC	EW_DN
  2C85'   0C                    	INR	C
  2C86'   C3 2C7C'              	JMP	EW_LP
  2C89'                         EW_DN:
  2C89'   19                    	DAD	D		; one subtraction too many: give it back
  2C8A'   79                    	MOV	A,C
  2C8B'   B7                    	ORA	A
  2C8C'   C2 2C92'              	JNZ	EW_PR
  2C8F'   78                    	MOV	A,B
  2C90'   B7                    	ORA	A
  2C91'   C8                    	RZ			; a leading zero: write nothing
  2C92'                         EW_PR:
  2C92'   79                    	MOV	A,C
  2C93'   C6 30                 	ADI	'0'
  2C95'   CD 0000*              	CALL	OUTCH
  2C98'   06 01                 	MVI	B,1
  2C9A'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  2C9B'                         ISEMPT:
  2C9B'   2A 0000*              	LHLD	OUTPOS
  2C9E'   7C                    	MOV	A,H
  2C9F'   B5                    	ORA	L
  2CA0'   C0                    	RNZ
  2CA1'   CD 0000*              	CALL	LOGLEN
  2CA4'   7C                    	MOV	A,H
  2CA5'   B5                    	ORA	L
  2CA6'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  2CA7'                         MSGCTG:
  2CA7'   21 0000*              	LXI	H,FNAME
  2CAA'   CD 2BB4'              	CALL	MSGNAM
  2CAD'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  2CAF'   CD 2C1C'              	CALL	MSGFLG
	MACRO-80 3.44	09-Dec-81	PAGE	1-138


  2CB2'   CD 2C9B'              	CALL	ISEMPT
  2CB5'   C2 2CBE'              	JNZ	MG_POS
  2CB8'   21 281A'              	LXI	H,SNOLIN
  2CBB'   C3 0000*              	JMP	OUTSTR
  2CBE'                         MG_POS:
  2CBE'   21 280D'              	LXI	H,SLINE
  2CC1'   CD 0000*              	CALL	OUTSTR
  2CC4'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  2CC7'   23                    	INX	H		;   ... so the line it is on
  2CC8'   CD 2C55'              	CALL	EMITW
  2CCB'   21 2814'              	LXI	H,SCOLM
  2CCE'   CD 0000*              	CALL	OUTSTR
  2CD1'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  2CD4'   23                    	INX	H
  2CD5'   E5                    	PUSH	H
  2CD6'   CD 2C55'              	CALL	EMITW
  2CD9'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  2CDC'   23                    	INX	H
  2CDD'   D1                    	POP	D
  2CDE'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  2CE1'   C8                    	RZ
  2CE2'   E5                    	PUSH	H
  2CE3'   3E 2D                 	MVI	A,'-'
  2CE5'   CD 0000*              	CALL	OUTCH
  2CE8'   E1                    	POP	H
  2CE9'   C3 2C55'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  2CEC'                         FILMSG:
  2CEC'   3A 0001*              	LDA	FNAME+1
  2CEF'   FE 20                 	CPI	' '
  2CF1'   C8                    	RZ
  2CF2'   21 0000*              	LXI	H,FNAME
  2CF5'   CD 2BB4'              	CALL	MSGNAM
  2CF8'   AF                    	XRA	A		; nothing has been changed yet
  2CF9'   C3 2C1C'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  2CFC'                         WRMSG:
  2CFC'   21 0000*              	LXI	H,TFCB
  2CFF'   CD 2BB4'              	CALL	MSGNAM
  2D02'   21 282C'              	LXI	H,SWRIT
  2D05'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  2D08'                         MSGPST:
  2D08'   3A 2E79'              	LDA	MSGWHT
  2D0B'   B7                    	ORA	A
  2D0C'   C8                    	RZ
  2D0D'   47                    	MOV	B,A
  2D0E'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-139


  2D0F'   32 2E79'              	STA	MSGWHT
  2D12'   78                    	MOV	A,B
  2D13'   FE 01                 	CPI	MW_FIL
  2D15'   CA 2D31'              	JZ	MP_FIL
  2D18'   FE 02                 	CPI	MW_WRT
  2D1A'   CA 2D37'              	JZ	MP_WRT
  2D1D'   FE 04                 	CPI	MW_BIG
  2D1F'   CA 2D28'              	JZ	MP_BIG
  2D22'   CD 2CA7'              	CALL	MSGCTG
  2D25'   C3 0000*              	JMP	SCURS
  2D28'                         MP_BIG:
  2D28'   21 27C8'              	LXI	H,SQBIG
  2D2B'   CD 0000*              	CALL	EXMSG
  2D2E'   C3 0000*              	JMP	SCURS
  2D31'                         MP_FIL:
  2D31'   CD 2CEC'              	CALL	FILMSG
  2D34'   C3 0000*              	JMP	SCURS
  2D37'                         MP_WRT:
  2D37'   CD 2CFC'              	CALL	WRMSG
  2D3A'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  2D3D'                         VC_CTLG:
  2D3D'   3E 03                 	MVI	A,MW_CTG
  2D3F'   32 2E79'              	STA	MSGWHT
  2D42'   3E 01                 	MVI	A,R_MOVE
  2D44'   32 2E07'              	STA	RINTENT
  2D47'   C3 0732'              	JMP	GETCNT		; a count typed before it is spent here, not
                                				;   left for the next command
                                
  2D4A'                         CMDTAB:
  2D4A'   07                    	DB	07H			; ^G -- where am I?
  2D4B'   2D3D'                 	DW	VC_CTLG
  2D4D'   68                    	DB	'h'
  2D4E'   087F'                 	DW	VC_H
  2D50'   6C                    	DB	'l'
  2D51'   08A9'                 	DW	VC_L
  2D53'   6A                    	DB	'j'
  2D54'   097A'                 	DW	VC_J
  2D56'   6B                    	DB	'k'
  2D57'   098C'                 	DW	VC_K
  2D59'   30                    	DB	'0'
  2D5A'   08DC'                 	DW	VC_0
  2D5C'   5E                    	DB	'^'
  2D5D'   08FA'                 	DW	VC_CRT
  2D5F'   24                    	DB	'$'
  2D60'   0938'                 	DW	VC_EOL
  2D62'   0D                    	DB	CR			; <CR> -- down to the first non-blank
  2D63'   095C'                 	DW	VC_CR
  2D65'   77                    	DB	'w'
  2D66'   0B6B'                 	DW	VC_W
  2D68'   62                    	DB	'b'
  2D69'   0BBC'                 	DW	VC_B
  2D6B'   65                    	DB	'e'
  2D6C'   0D52'                 	DW	VC_E
