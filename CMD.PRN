  2A18'   1815'                 	DW	VC_Y
  2A1A'   59                    	DB	'Y'
  2A1B'   181D'                 	DW	VY_YY
  2A1D'   70                    	DB	'p'
  2A1E'   1A53'                 	DW	VC_P
