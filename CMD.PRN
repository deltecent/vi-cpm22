  2919'   196E'                 	DW	VCB_P
  291B'   69                    	DB	'i'
  291C'   149F'                 	DW	VC_I
  291E'   61                    	DB	'a'
  291F'   14A5'                 	DW	VC_A
  2921'   41                    	DB	'A'
  2922'   14C5'                 	DW	VCB_A
  2924'   49                    	DB	'I'
  2925'   14E1'                 	DW	VCB_I
  2927'   72                    	DB	'r'
  2928'   1623'                 	DW	VC_R
  292A'   52                    	DB	'R'
  292B'   1677'                 	DW	VCB_R
  292D'   64                    	DB	'd'
  292E'   168C'                 	DW	VC_D
