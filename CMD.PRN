  2CC8'   1D0F'                 	DW	VCB_P
  2CCA'   69                    	DB	'i'
  2CCB'   183D'                 	DW	VC_I
  2CCD'   61                    	DB	'a'
  2CCE'   1843'                 	DW	VC_A
  2CD0'   41                    	DB	'A'
  2CD1'   1863'                 	DW	VCB_A
  2CD3'   49                    	DB	'I'
  2CD4'   187F'                 	DW	VCB_I
  2CD6'   72                    	DB	'r'
  2CD7'   19C1'                 	DW	VC_R
  2CD9'   52                    	DB	'R'
  2CDA'   1A15'                 	DW	VCB_R
  2CDC'   64                    	DB	'd'
  2CDD'   1A2A'                 	DW	VC_D
  2CDF'   44                    	DB	'D'
  2CE0'   17BB'                 	DW	VCB_D
