  091B'   78                    	MOV	A,B
  091C'   B1                    	ORA	C
  091D'   CA 0934'              	JZ	KC_TB
  0920'   2B                    	DCX	H
  0921'   0B                    	DCX	B
  0922'   7E                    	MOV	A,M
  0923'   FE 0A                 	CPI	LF
  0925'   C2 091B'              	JNZ	KC_SC
  0928'   1B                    	DCX	D
  0929'   7A                    	MOV	A,D
  092A'   B3                    	ORA	E
  092B'   C2 091B'              	JNZ	KC_SC
  092E'   2A 24BD'              	LHLD	JKCNT		; N lines above: the move is count lines
  0931'   C3 0954'              	JMP	KC_MV
  0934'                         KC_TB:
  0934'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0935'   CD 0652'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0938'   22 24C3'              	SHLD	JKBK
  093B'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  093E'   7C                    	MOV	A,H
  093F'   B5                    	ORA	L
  0940'   CA 094D'              	JZ	KC_B0
  0943'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  0946'   D1                    	POP	D
  0947'   DA 094E'              	JC	KC_BOF
  094A'   C3 0907'              	JMP	KC_ED
  094D'                         KC_B0:
  094D'   D1                    	POP	D
  094E'                         KC_BOF:
  094E'   2A 24BF'              	LHLD	JKN		; moved = LFs found
  0951'   CD 0000*              	CALL	SUBHD
  0954'                         KC_MV:
  0954'   E5                    	PUSH	H
  0955'   2A 24BD'              	LHLD	JKCNT
  0958'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  095B'   D1                    	POP	D		; DE = moved
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  095C'   2A 24BF'              	LHLD	JKN
  095F'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0962'   DA 0966'              	JC	KC_AD
  0965'   EB                    	XCHG			; DE = N
  0966'                         KC_AD:
  0966'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0969'   CD 0000*              	CALL	SUBHD
  096C'   22 0000*              	SHLD	LNDLT
  096F'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0970'                         ATEOF:
  0970'   CD 0000*              	CALL	RGET0
  0973'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0976'                         LASTLN:
  0976'   2A 0000*              	LHLD	GAPBEG
  0979'   EB                    	XCHG
  097A'   2A 0000*              	LHLD	TXTBEG
  097D'   CD 0000*              	CALL	CMP16
  0980'   21 0000               	LXI	H,0
  0983'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0986'   1B                    	DCX	D
  0987'   1A                    	LDAX	D
  0988'   FE 0A                 	CPI	LF
  098A'   C2 0000*              	JNZ	SETBWD
  098D'   23                    	INX	H
  098E'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0991'                         JKLAND:
  0991'   21 0000               	LXI	H,0
  0994'   22 24C7'              	SHLD	JKVC		; screen column
  0997'   2B                    	DCX	H
  0998'   22 24C9'              	SHLD	JKLS		; last content char: none yet
  099B'   CD 0000*              	CALL	RGET0
  099E'   11 0000               	LXI	D,0		; DE = chars read
  09A1'                         JL_RD:
  09A1'   CD 0000*              	CALL	RDGET
  09A4'   DA 09DE'              	JC	JL_END
  09A7'   FE 0A                 	CPI	LF
  09A9'   CA 09DE'              	JZ	JL_END
  09AC'   E5                    	PUSH	H
  09AD'   C5                    	PUSH	B
  09AE'   2A 24C7'              	LHLD	JKVC
  09B1'   CD 059F'              	CALL	CWID
  09B4'   B7                    	ORA	A
  09B5'   CA 09D8'              	JZ	JL_NX		; a CR
  09B8'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  09B9'   22 24C9'              	SHLD	JKLS		; the last content char so far
  09BC'   EB                    	XCHG
  09BD'   4F                    	MOV	C,A
  09BE'   06 00                 	MVI	B,0
  09C0'   09                    	DAD	B		; HL = the column after this char
  09C1'   22 24C7'              	SHLD	JKVC
  09C4'   D5                    	PUSH	D
  09C5'   EB                    	XCHG
  09C6'   2A 24B7'              	LHLD	GOALCOL
  09C9'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  09CC'   D1                    	POP	D
  09CD'   DA 09D8'              	JC	JL_NX
  09D0'   CA 09D8'              	JZ	JL_NX
  09D3'   C1                    	POP	B		; this char holds the goal column
  09D4'   E1                    	POP	H
  09D5'   C3 09E9'              	JMP	JL_GO
  09D8'                         JL_NX:
  09D8'   C1                    	POP	B
  09D9'   E1                    	POP	H
  09DA'   13                    	INX	D
  09DB'   C3 09A1'              	JMP	JL_RD
  09DE'                         JL_END:
  09DE'   2A 24C9'              	LHLD	JKLS		; past the line's end: its last content char
  09E1'   7C                    	MOV	A,H
  09E2'   A5                    	ANA	L
  09E3'   3C                    	INR	A
  09E4'   C2 09E8'              	JNZ	JL_LS
  09E7'   23                    	INX	H		; no content: the line's start
  09E8'                         JL_LS:
  09E8'   EB                    	XCHG
  09E9'                         JL_GO:
  09E9'   D5                    	PUSH	D		; DE = step from the line start
  09EA'   CD 0000*              	CALL	CUROFF
  09ED'   D1                    	POP	D
  09EE'   19                    	DAD	D
  09EF'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  09F2'   AF                    VC_W:	XRA	A
  09F3'   32 24B9'              	STA	WBIG
  09F6'   C3 09FE'              	JMP	WDO
  09F9'   3E 01                 VCBGW:	MVI	A,1
  09FB'   32 24B9'              	STA	WBIG
  09FE'   CD 06C6'              WDO:	CALL	SETMOV
  0A01'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0A02'   32 24BA'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0A05'   CD 0659'              	CALL	GETCNT
  0A08'   22 24E5'              	SHLD	CNTV
  0A0B'   2A 24E5'              WDO_LP: LHLD	CNTV
  0A0E'   7C                    	MOV	A,H
  0A0F'   B5                    	ORA	L
  0A10'   CA 0A1D'              	JZ	WDO_DN
  0A13'   2B                    	DCX	H
  0A14'   22 24E5'              	SHLD	CNTV
  0A17'   CD 0A6D'              	CALL	FWD1
  0A1A'   D2 0A0B'              	JNC	WDO_LP
  0A1D'                         WDO_DN:
  0A1D'   CD 0970'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0A20'   DA 0A2D'              	JC	WDO_NL
  0A23'   FE 0D                 	CPI	CR
  0A25'   CA 0A2D'              	JZ	WDO_NL
  0A28'   FE 0A                 	CPI	LF
  0A2A'   C2 054B'              	JNZ	SETGL
  0A2D'                         WDO_NL:
  0A2D'   CD 0000*              	CALL	PEEKL
  0A30'   DA 054B'              	JC	SETGL
  0A33'   FE 0A                 	CPI	LF
  0A35'   CA 054B'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0A38'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0A3A'   32 24BA'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0A3D'   CD 0B68'              	CALL	DECC		; back onto its last char
  0A40'   C3 054B'              	JMP	SETGL
                                
  0A43'   AF                    VC_B:	XRA	A
  0A44'   32 24B9'              	STA	WBIG
  0A47'   C3 0A4F'              	JMP	BDO
  0A4A'   3E 01                 VCBGB:	MVI	A,1
  0A4C'   32 24B9'              	STA	WBIG
  0A4F'   CD 06C6'              BDO:	CALL	SETMOV
  0A52'   CD 0659'              	CALL	GETCNT
  0A55'   22 24E5'              	SHLD	CNTV
  0A58'   2A 24E5'              BDO_LP: LHLD	CNTV
  0A5B'   7C                    	MOV	A,H
  0A5C'   B5                    	ORA	L
  0A5D'   CA 054B'              	JZ	SETGL
  0A60'   2B                    	DCX	H
  0A61'   22 24E5'              	SHLD	CNTV
  0A64'   CD 0AB9'              	CALL	BCK1
  0A67'   D2 0A58'              	JNC	BDO_LP
  0A6A'   C3 054B'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char (it is left there).
  0A6D'                         FWD1:
  0A6D'   CD 0AEC'              	CALL	CCLS
  0A70'   32 24F1'              	STA	WKCLS		; the starting class
  0A73'   CD 0B26'              	CALL	INCC
  0A76'   B7                    	ORA	A
  0A77'   CA 0A8F'              	JZ	FW_WD
  0A7A'   37                    	STC
  0A7B'   F8                    	RM			; -1: already at the end
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0A7C'   FE 02                 	CPI	2
  0A7E'   C2 0A8F'              	JNZ	FW_WD		; 1: a next line was reached
  0A81'   CD 0970'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0A84'   D4 0B0D'              	CNC	NXLN
  0A87'   D2 0A8F'              	JNC	FW_WD
  0A8A'   CD 0B68'              	CALL	DECC		; yes: back onto its last char, failed
  0A8D'   37                    	STC
  0A8E'   C9                    	RET
  0A8F'                         FW_WD:
  0A8F'   3A 24F1'              	LDA	WKCLS		; go past the rest of this word
  0A92'   B7                    	ORA	A
  0A93'   CA 0AA8'              	JZ	FW_WS
  0A96'                         FW_WLP:
  0A96'   CD 0AEC'              	CALL	CCLS
  0A99'   21 24F1'              	LXI	H,WKCLS
  0A9C'   BE                    	CMP	M
  0A9D'   C2 0AA8'              	JNZ	FW_WS
  0AA0'   CD 0B26'              	CALL	INCC
  0AA3'   B7                    	ORA	A
  0AA4'   F8                    	RM			; the end of the file (NC)
  0AA5'   C3 0A96'              	JMP	FW_WLP
  0AA8'                         FW_WS:
  0AA8'   CD 0AEC'              	CALL	CCLS		; then over blanks to the next word
  0AAB'   B7                    	ORA	A
  0AAC'   C0                    	RNZ
  0AAD'   CD 0AF4'              	CALL	EMPTY
  0AB0'   C8                    	RZ			; an empty line is a word
  0AB1'   CD 0B26'              	CALL	INCC
  0AB4'   B7                    	ORA	A
  0AB5'   F8                    	RM
  0AB6'   C3 0AA8'              	JMP	FW_WS
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0AB9'                         BCK1:
  0AB9'   CD 0B68'              	CALL	DECC
  0ABC'   B7                    	ORA	A
  0ABD'   37                    	STC
  0ABE'   F8                    	RM
  0ABF'                         BK_WS:
  0ABF'   CD 0AEC'              	CALL	CCLS		; back over blanks
  0AC2'   B7                    	ORA	A
  0AC3'   C2 0AD3'              	JNZ	BK_WD
  0AC6'   CD 0AF4'              	CALL	EMPTY
  0AC9'   C8                    	RZ			; an empty line is a word
  0ACA'   CD 0B68'              	CALL	DECC
  0ACD'   B7                    	ORA	A
  0ACE'   F2 0ABF'              	JP	BK_WS
  0AD1'   AF                    	XRA	A		; the start of the file (NC)
  0AD2'   C9                    	RET
  0AD3'                         BK_WD:
  0AD3'   32 24F1'              	STA	WKCLS		; back to the start of this word
  0AD6'                         BK_WLP:
  0AD6'   CD 0B68'              	CALL	DECC
  0AD9'   B7                    	ORA	A
  0ADA'   FA 0AEA'              	JM	BK_OK		; the start of the file
  0ADD'   CD 0AEC'              	CALL	CCLS
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0AE0'   21 24F1'              	LXI	H,WKCLS
  0AE3'   BE                    	CMP	M
  0AE4'   CA 0AD6'              	JZ	BK_WLP
  0AE7'   CD 0B26'              	CALL	INCC		; overshot: forward one
  0AEA'                         BK_OK:
  0AEA'   AF                    	XRA	A
  0AEB'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0AEC'                         CCLS:
  0AEC'   CD 0970'              	CALL	ATEOF
  0AEF'   D2 067B'              	JNC	CLASSF
  0AF2'   AF                    	XRA	A
  0AF3'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0AF4'                         EMPTY:
  0AF4'   CD 0970'              	CALL	ATEOF
  0AF7'   DA 0B02'              	JC	EM_ST
  0AFA'   FE 0D                 	CPI	CR
  0AFC'   CA 0B02'              	JZ	EM_ST
  0AFF'   FE 0A                 	CPI	LF
  0B01'   C0                    	RNZ
  0B02'                         EM_ST:
  0B02'   CD 0000*              	CALL	PEEKL
  0B05'   DA 0B0B'              	JC	EM_Y
  0B08'   FE 0A                 	CPI	LF
  0B0A'   C9                    	RET
  0B0B'                         EM_Y:
  0B0B'   AF                    	XRA	A
  0B0C'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0B0D'                         NXLN:
  0B0D'   FE 0A                 	CPI	LF
  0B0F'   CA 0B1E'              	JZ	NX_LF
  0B12'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0B15'   D8                    	RC
  0B16'   FE 0A                 	CPI	LF
  0B18'   CA 0B1E'              	JZ	NX_LF
  0B1B'   2B                    	DCX	H		; a lone CR
  0B1C'   AF                    	XRA	A
  0B1D'   C9                    	RET
  0B1E'                         NX_LF:
  0B1E'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0B21'   D8                    	RC
  0B22'   2B                    	DCX	H
  0B23'   3E 01                 	MVI	A,1
  0B25'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0B26'                         INCC:
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0B26'   CD 0970'              	CALL	ATEOF
  0B29'   DA 0B64'              	JC	IC_END
  0B2C'   FE 0D                 	CPI	CR
  0B2E'   CA 0B4F'              	JZ	IC_NL
  0B31'   FE 0A                 	CPI	LF
  0B33'   CA 0B4F'              	JZ	IC_NL
  0B36'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0B39'                         IC_CH:
  0B39'   CD 0970'              	CALL	ATEOF
  0B3C'   DA 0B4B'              	JC	IC_2
  0B3F'   FE 0D                 	CPI	CR
  0B41'   CA 0B4B'              	JZ	IC_2
  0B44'   FE 0A                 	CPI	LF
  0B46'   CA 0B4B'              	JZ	IC_2
  0B49'   AF                    	XRA	A
  0B4A'   C9                    	RET
  0B4B'                         IC_2:
  0B4B'   3E 02                 	MVI	A,2
  0B4D'   B7                    	ORA	A
  0B4E'   C9                    	RET
  0B4F'                         IC_NL:
  0B4F'   CD 0B0D'              	CALL	NXLN
  0B52'   DA 0B64'              	JC	IC_END
  0B55'   F5                    	PUSH	PSW
  0B56'   CD 0000*              	CALL	PUTCUR
  0B59'   F1                    	POP	PSW
  0B5A'   B7                    	ORA	A
  0B5B'   CA 0B39'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0B5E'   CD 0B8A'              	CALL	LNINC
  0B61'   3E 01                 	MVI	A,1
  0B63'   C9                    	RET
  0B64'                         IC_END:
  0B64'   3E FF                 	MVI	A,0FFH
  0B66'   B7                    	ORA	A
  0B67'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0B68'                         DECC:
  0B68'   CD 0000*              	CALL	PEEKL
  0B6B'   DA 0B64'              	JC	IC_END
  0B6E'   F5                    	PUSH	PSW
  0B6F'   CD 0000*              	CALL	PUTCUR
  0B72'   F1                    	POP	PSW
  0B73'   FE 0A                 	CPI	LF
  0B75'   3E 00                 	MVI	A,0
  0B77'   C0                    	RNZ
  0B78'   CD 0B98'              	CALL	LNDEC
  0B7B'   CD 0000*              	CALL	PEEKL		; onto its CR
  0B7E'   DA 0B86'              	JC	DC_1
  0B81'   FE 0D                 	CPI	CR
  0B83'   CC 0000*              	CZ	PUTCUR
  0B86'                         DC_1:
  0B86'   3E 01                 	MVI	A,1
  0B88'   B7                    	ORA	A
  0B89'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0B8A'                         LNINC:
  0B8A'   E5                    	PUSH	H
  0B8B'   2A 0000*              	LHLD	LNDLT
  0B8E'   7C                    	MOV	A,H
  0B8F'   FE 40                 	CPI	40H
  0B91'   CA 0BA6'              	JZ	LN_X
  0B94'   23                    	INX	H
  0B95'   C3 0BA3'              	JMP	LN_ST
  0B98'                         LNDEC:
  0B98'   E5                    	PUSH	H
  0B99'   2A 0000*              	LHLD	LNDLT
  0B9C'   7C                    	MOV	A,H
  0B9D'   FE C0                 	CPI	0C0H
  0B9F'   CA 0BA6'              	JZ	LN_X
  0BA2'   2B                    	DCX	H
  0BA3'                         LN_ST:
  0BA3'   22 0000*              	SHLD	LNDLT
  0BA6'                         LN_X:
  0BA6'   E1                    	POP	H
  0BA7'   C9                    	RET
                                
  0BA8'   AF                    VC_E:	XRA	A
  0BA9'   32 24B9'              	STA	WBIG
  0BAC'   C3 0BB4'              	JMP	EDO
  0BAF'   3E 01                 VCBGE:	MVI	A,1
  0BB1'   32 24B9'              	STA	WBIG
  0BB4'   CD 06C6'              EDO:	CALL	SETMOV
  0BB7'   CD 0659'              	CALL	GETCNT
  0BBA'   22 24E5'              	SHLD	CNTV
  0BBD'   2A 24E5'              EDO_LP: LHLD	CNTV
  0BC0'   7C                    	MOV	A,H
  0BC1'   B5                    	ORA	L
  0BC2'   C8                    	RZ
  0BC3'   2B                    	DCX	H
  0BC4'   22 24E5'              	SHLD	CNTV
  0BC7'   CD 0BCD'              	CALL	ESTEP
  0BCA'   C3 0BBD'              	JMP	EDO_LP
                                
                                ;ESTEP -- forward to the end of the next word.
  0BCD'                         ESTEP:
  0BCD'   CD 0000*              	CALL	CUROFF
  0BD0'   22 24E9'              	SHLD	WKI
  0BD3'   CD 0000*              	CALL	LOGLEN
  0BD6'   22 24EB'              	SHLD	WKN
  0BD9'   2A 24E9'              	LHLD	WKI
  0BDC'   23                    	INX	H
  0BDD'   22 24E9'              	SHLD	WKI
  0BE0'                         ES_WS:
  0BE0'   2A 24E9'              	LHLD	WKI
  0BE3'   EB                    	XCHG
  0BE4'   2A 24EB'              	LHLD	WKN
  0BE7'   CD 0000*              	CALL	CMP16
  0BEA'   D2 0C38'              	JNC	ES_LND
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0BED'   2A 24E9'              	LHLD	WKI
  0BF0'   CD 0000*              	CALL	CHARAT
  0BF3'   CD 067B'              	CALL	CLASSF
  0BF6'   B7                    	ORA	A
  0BF7'   C2 0C04'              	JNZ	ES_WD
  0BFA'   2A 24E9'              	LHLD	WKI
  0BFD'   23                    	INX	H
  0BFE'   22 24E9'              	SHLD	WKI
  0C01'   C3 0BE0'              	JMP	ES_WS
  0C04'                         ES_WD:
  0C04'   2A 24E9'              	LHLD	WKI
  0C07'   CD 0000*              	CALL	CHARAT
  0C0A'   CD 067B'              	CALL	CLASSF
  0C0D'   32 24F1'              	STA	WKCLS
  0C10'                         ES_RUN:
  0C10'   2A 24E9'              	LHLD	WKI
  0C13'   23                    	INX	H
  0C14'   EB                    	XCHG			; DE = i+1
  0C15'   2A 24EB'              	LHLD	WKN
  0C18'   CD 0000*              	CALL	CMP16		; DE=(i+1) vs HL=n: CY iff (i+1) < n
  0C1B'   D2 0C38'              	JNC	ES_LND
  0C1E'   2A 24E9'              	LHLD	WKI
  0C21'   23                    	INX	H
  0C22'   E5                    	PUSH	H		; i+1
  0C23'   CD 0000*              	CALL	CHARAT
  0C26'   CD 067B'              	CALL	CLASSF
  0C29'   E1                    	POP	H		; HL = i+1
  0C2A'   47                    	MOV	B,A
  0C2B'   3A 24F1'              	LDA	WKCLS
  0C2E'   B8                    	CMP	B
  0C2F'   C2 0C38'              	JNZ	ES_LND
  0C32'   22 24E9'              	SHLD	WKI
  0C35'   C3 0C10'              	JMP	ES_RUN
  0C38'                         ES_LND:
  0C38'   2A 24EB'              	LHLD	WKN
  0C3B'   EB                    	XCHG
  0C3C'   2A 24E9'              	LHLD	WKI
  0C3F'   CD 0000*              	CALL	CMP16		; DE=n vs HL=i: CY iff n < i
  0C42'   DA 0C4E'              	JC	ES_CL
  0C45'   CA 0C4E'              	JZ	ES_CL
  0C48'   2A 24E9'              	LHLD	WKI
  0C4B'   C3 0548'              	JMP	GOSET
  0C4E'                         ES_CL:
  0C4E'   2A 24EB'              	LHLD	WKN
  0C51'   7C                    	MOV	A,H
  0C52'   B5                    	ORA	L
  0C53'   C8                    	RZ
  0C54'   2B                    	DCX	H
  0C55'   C3 0548'              	JMP	GOSET
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0C58'                         CURRW:
  0C58'   2A 0000*              	LHLD	WINROW
  0C5B'   EB                    	XCHG
  0C5C'   2A 0000*              	LHLD	LNDLT
  0C5F'   19                    	DAD	D		; HL = row (signed)
  0C60'   7C                    	MOV	A,H
  0C61'   B7                    	ORA	A
  0C62'   FA 0C75'              	JM	CRW_0		; above the screen -> top row
  0C65'   C2 0C70'              	JNZ	CRW_BT		; far below -> bottom row
  0C68'   3A 0000*              	LDA	NEDIT
  0C6B'   3D                    	DCR	A		; A = bottom row
  0C6C'   BD                    	CMP	L		; CY iff bottom < row
  0C6D'   D8                    	RC
  0C6E'   7D                    	MOV	A,L
  0C6F'   C9                    	RET
  0C70'                         CRW_BT:
  0C70'   3A 0000*              	LDA	NEDIT
  0C73'   3D                    	DCR	A
  0C74'   C9                    	RET
  0C75'                         CRW_0:
  0C75'   AF                    	XRA	A
  0C76'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0C77'                         SETRWT:
  0C77'   2A 0000*              	LHLD	LNDLT
  0C7A'   EB                    	XCHG
  0C7B'   6F                    	MOV	L,A
  0C7C'   26 00                 	MVI	H,0
  0C7E'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0C81'   22 0000*              	SHLD	WINROW
  0C84'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0C85'                         MVROW:
  0C85'   47                    	MOV	B,A
  0C86'   CD 0C58'              	CALL	CURRW
  0C89'   90                    	SUB	B		; A = row now - target
  0C8A'   C8                    	RZ
  0C8B'   DA 0C94'              	JC	MR_DN
  0C8E'   6F                    	MOV	L,A
  0C8F'   26 00                 	MVI	H,0
  0C91'   C3 08DF'              	JMP	KCORE
  0C94'                         MR_DN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C94'   2F                    	CMA
  0C95'   3C                    	INR	A		; A = target - row now
  0C96'   6F                    	MOV	L,A
  0C97'   26 00                 	MVI	H,0
  0C99'   C3 0842'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0C9C'                         VC_HIGH:
  0C9C'   CD 0646'              	CALL	MOVCNT		; a cursor motion, and its count
  0C9F'   2B                    	DCX	H		; row = count - 1
  0CA0'   7C                    	MOV	A,H
  0CA1'   B7                    	ORA	A
  0CA2'   3A 0000*              	LDA	SCBOT
  0CA5'   C2 0CAD'              	JNZ	VH_GO		; >= 256 -> the last text row
  0CA8'   BD                    	CMP	L		; CY iff SCBOT < row
  0CA9'   DA 0CAD'              	JC	VH_GO
  0CAC'   7D                    	MOV	A,L
  0CAD'                         VH_GO:
  0CAD'   CD 0C85'              	CALL	MVROW
  0CB0'   C3 0794'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0CB3'                         VC_MIDL:
  0CB3'   CD 0646'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0CB6'   3A 0000*              	LDA	SCBOT
  0CB9'   B7                    	ORA	A		; clear CY for the shift
  0CBA'   1F                    	RAR			; A = SCBOT / 2
  0CBB'   CD 0C85'              	CALL	MVROW
  0CBE'   C3 0794'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0CC1'                         VC_LOWL:
  0CC1'   CD 0646'              	CALL	MOVCNT		; a cursor motion, and its count
  0CC4'   2B                    	DCX	H		; count - 1
  0CC5'   3A 0000*              	LDA	SCBOT
  0CC8'   5F                    	MOV	E,A
  0CC9'   16 00                 	MVI	D,0
  0CCB'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0CCC'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0CCF'   3E 00                 	MVI	A,0
  0CD1'   D2 0CD8'              	JNC	VL_GO		; at or past the top -> row 0
  0CD4'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0CD7'   7D                    	MOV	A,L
  0CD8'                         VL_GO:
  0CD8'   CD 0C85'              	CALL	MVROW
  0CDB'   C3 0794'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0CDE'                         VC_PGDN:
  0CDE'   CD 0646'              	CALL	MOVCNT		; a cursor motion, and its count
  0CE1'   3A 0000*              	LDA	SCEOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0CE4'   B7                    	ORA	A
  0CE5'   CA 0CF3'              	JZ	VPD_N
  0CE8'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0CEB'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0CEC'   C8                    	RZ			; it already is
  0CED'   CD 0C85'              	CALL	MVROW
  0CF0'   C3 0D04'              	JMP	VPD_TP
  0CF3'                         VPD_N:
  0CF3'   3A 0000*              	LDA	NEDIT
  0CF6'   D6 02                 	SUI	2
  0CF8'   CD 0D4C'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0CFB'   E5                    	PUSH	H
  0CFC'   AF                    	XRA	A
  0CFD'   CD 0C85'              	CALL	MVROW		; the top line
  0D00'   E1                    	POP	H
  0D01'   CD 0842'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0D04'                         VPD_TP:
  0D04'   AF                    	XRA	A
  0D05'   CD 0C77'              	CALL	SETRWT		; to the top row
  0D08'   C3 0794'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0D0B'                         VC_PGUP:
  0D0B'   CD 0646'              	CALL	MOVCNT		; a cursor motion, and its count
  0D0E'   3A 0000*              	LDA	SCBOF
  0D11'   B7                    	ORA	A
  0D12'   C0                    	RNZ
  0D13'   3A 0000*              	LDA	NEDIT
  0D16'   47                    	MOV	B,A
  0D17'   3A 0000*              	LDA	SCEOF
  0D1A'   B7                    	ORA	A
  0D1B'   CA 0D2C'              	JZ	VPU_2
  0D1E'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0D21'   FE 02                 	CPI	2
  0D23'   D2 0D2C'              	JNC	VPU_2
  0D26'   2F                    	CMA
  0D27'   3C                    	INR	A
  0D28'   80                    	ADD	B
  0D29'   C3 0D2F'              	JMP	VPU_P
  0D2C'                         VPU_2:
  0D2C'   78                    	MOV	A,B
  0D2D'   D6 02                 	SUI	2
  0D2F'                         VPU_P:
  0D2F'   CD 0D4C'              	CALL	MULSAT		; HL = count * page
  0D32'   E5                    	PUSH	H
  0D33'   AF                    	XRA	A
  0D34'   CD 0C85'              	CALL	MVROW		; the top line
  0D37'   E1                    	POP	H
  0D38'   CD 08DF'              	CALL	KCORE		; the new top line
  0D3B'   AF                    	XRA	A
  0D3C'   CD 0C77'              	CALL	SETRWT		; on the top row
  0D3F'   3A 0000*              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D42'   3D                    	DCR	A
  0D43'   6F                    	MOV	L,A
  0D44'   26 00                 	MVI	H,0
  0D46'   CD 0842'              	CALL	JCORE		; the bottom row's line
  0D49'   C3 0794'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0D4C'                         MULSAT:
  0D4C'   EB                    	XCHG
  0D4D'   21 0000               	LXI	H,0
  0D50'   B7                    	ORA	A
  0D51'   C8                    	RZ
  0D52'                         MS_LP:
  0D52'   19                    	DAD	D
  0D53'   DA 0D5B'              	JC	MS_SAT
  0D56'   3D                    	DCR	A
  0D57'   C2 0D52'              	JNZ	MS_LP
  0D5A'   C9                    	RET
  0D5B'                         MS_SAT:
  0D5B'   21 FFFF               	LXI	H,0FFFFH
  0D5E'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0D5F'                         VC_HFDN:
  0D5F'   CD 06C6'              	CALL	SETMOV
  0D62'   CD 0C58'              	CALL	CURRW
  0D65'   32 24BB'              	STA	HFROW
  0D68'   CD 0DD6'              	CALL	HFCNT		; HL = lines
  0D6B'   3A 24BB'              	LDA	HFROW
  0D6E'   47                    	MOV	B,A
  0D6F'   3A 0000*              	LDA	SCEOF
  0D72'   B7                    	ORA	A
  0D73'   CA 0D7B'              	JZ	VHD_GO
  0D76'   3A 0000*              	LDA	SCBOT		; the last line's row
  0D79'   B8                    	CMP	B
  0D7A'   C8                    	RZ			; the cursor is on it
  0D7B'                         VHD_GO:
  0D7B'   CD 0842'              	CALL	JCORE
  0D7E'   3A 0000*              	LDA	SCEOF
  0D81'   B7                    	ORA	A
  0D82'   C2 0794'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0D85'   3A 24BB'              	LDA	HFROW
  0D88'   CD 0C77'              	CALL	SETRWT
  0D8B'   3E 01                 	MVI	A,1
  0D8D'   32 0000*              	STA	WFILL		; not past the end of the file
  0D90'   C3 0794'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0D93'                         VC_HFUP:
  0D93'   CD 06C6'              	CALL	SETMOV
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D96'   CD 0C58'              	CALL	CURRW
  0D99'   32 24BB'              	STA	HFROW
  0D9C'   CD 0DD6'              	CALL	HFCNT		; HL = lines
  0D9F'   CD 0DB6'              	CALL	ONFST
  0DA2'   C8                    	RZ			; the cursor is on the first line
  0DA3'   CD 08DF'              	CALL	KCORE
  0DA6'   3A 0000*              	LDA	SCBOF
  0DA9'   B7                    	ORA	A
  0DAA'   C2 0794'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0DAD'   3A 24BB'              	LDA	HFROW
  0DB0'   CD 0C77'              	CALL	SETRWT
  0DB3'   C3 0794'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0DB6'                         ONFST:
  0DB6'   E5                    	PUSH	H
  0DB7'   2A 0000*              	LHLD	OUTPOS
  0DBA'   7C                    	MOV	A,H
  0DBB'   B5                    	ORA	L
  0DBC'   C2 0DD4'              	JNZ	OF_RET
  0DBF'   2A 0000*              	LHLD	TXTBEG
  0DC2'   EB                    	XCHG			; DE = TXTBEG
  0DC3'   2A 0000*              	LHLD	GAPBEG
  0DC6'                         OF_LP:
  0DC6'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0DC9'   CA 0DD4'              	JZ	OF_RET
  0DCC'   2B                    	DCX	H
  0DCD'   7E                    	MOV	A,M
  0DCE'   FE 0A                 	CPI	LF
  0DD0'   C2 0DC6'              	JNZ	OF_LP
  0DD3'   B7                    	ORA	A		; NZ
  0DD4'                         OF_RET:
  0DD4'   E1                    	POP	H
  0DD5'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0DD6'                         HFCNT:
  0DD6'   2A 24AF'              	LHLD	CMDCNT
  0DD9'   7C                    	MOV	A,H
  0DDA'   B5                    	ORA	L
  0DDB'   CA 0DF2'              	JZ	HFC_AM
  0DDE'   CD 0659'              	CALL	GETCNT		; HL = count; clears it
  0DE1'   3A 0000*              	LDA	NEDIT
  0DE4'   5F                    	MOV	E,A
  0DE5'   16 00                 	MVI	D,0
  0DE7'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0DEA'   D2 0DEE'              	JNC	HFC_ST
  0DED'   EB                    	XCHG			; HL = NEDIT
  0DEE'                         HFC_ST:
  0DEE'   7D                    	MOV	A,L
  0DEF'   32 24BC'              	STA	HFAMT
  0DF2'                         HFC_AM:
  0DF2'   3A 24BC'              	LDA	HFAMT
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0DF5'   B7                    	ORA	A
  0DF6'   C2 0E03'              	JNZ	HFC_HL
  0DF9'   3A 0000*              	LDA	NEDIT
  0DFC'   B7                    	ORA	A
  0DFD'   1F                    	RAR
  0DFE'   B7                    	ORA	A
  0DFF'   C2 0E03'              	JNZ	HFC_HL
  0E02'   3C                    	INR	A		; at least one line
  0E03'                         HFC_HL:
  0E03'   6F                    	MOV	L,A
  0E04'   26 00                 	MVI	H,0
  0E06'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0E07'                         VC_REDR:
  0E07'   C3 0659'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0E0A'                         VC_G:
  0E0A'   CD 06C6'              	CALL	SETMOV
  0E0D'   CD 0EAA'              	CALL	GZONE		; the screen's top line, before the move
  0E10'   2A 24AF'              	LHLD	CMDCNT
  0E13'   7C                    	MOV	A,H
  0E14'   B5                    	ORA	L
  0E15'   C2 0E22'              	JNZ	VG_N
  0E18'   AF                    	XRA	A		; forward
  0E19'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0E1C'   CD 0976'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0E1F'   C3 0EC2'              	JMP	GPLACE
  0E22'                         VG_N:
  0E22'   CD 0659'              	CALL	GETCNT		; HL = target line (1-based)
  0E25'                         VG_LN:
  0E25'   CD 0E2B'              	CALL	GOLN
  0E28'   C3 0EC2'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
  0E2B'                         GOLN:
  0E2B'   2B                    	DCX	H		; lines to move from line 1
  0E2C'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0E2D'   3E FF                 	MVI	A,0FFH
  0E2F'   CD 0000*              	CALL	MVLMAX		; to BOF
  0E32'   E1                    	POP	H
  0E33'   AF                    	XRA	A
  0E34'   CD 0000*              	CALL	MVLIND		; forward count-1 lines
  0E37'   CD 0970'              	CALL	ATEOF
  0E3A'   DC 0976'              	CC	LASTLN		; past the last line: onto it
  0E3D'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0E3E'                         VC_LG:
  0E3E'   CD 06C6'              	CALL	SETMOV
  0E41'   3A 24D7'              	LDA	GSAVE
  0E44'   B7                    	ORA	A
  0E45'   C2 0E4E'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0E48'   3E 01                 	MVI	A,PG
  0E4A'   32 24D6'              	STA	GPEND
  0E4D'   C9                    	RET
  0E4E'                         VLG_GG:
  0E4E'   CD 0EAA'              	CALL	GZONE
  0E51'   CD 0659'              	CALL	GETCNT		; HL = target line (no count: 1)
  0E54'   C3 0E25'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0E57'                         SUB24:
  0E57'   4F                    	MOV	C,A
  0E58'   7D                    	MOV	A,L
  0E59'   93                    	SUB	E
  0E5A'   6F                    	MOV	L,A
  0E5B'   7C                    	MOV	A,H
  0E5C'   9A                    	SBB	D
  0E5D'   67                    	MOV	H,A
  0E5E'   79                    	MOV	A,C
  0E5F'   98                    	SBB	B
  0E60'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0E61'                         CURFP:
  0E61'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0E64'                         FPOS:
  0E64'   C5                    	PUSH	B
  0E65'   D5                    	PUSH	D
  0E66'   EB                    	XCHG
  0E67'   2A 0000*              	LHLD	TXTBEG
  0E6A'   EB                    	XCHG
  0E6B'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0E6E'   EB                    	XCHG			; DE = that
  0E6F'   2A 0000*              	LHLD	OUTPOS
  0E72'   7C                    	MOV	A,H
  0E73'   B7                    	ORA	A		; CY = 0
  0E74'   1F                    	RAR
  0E75'   47                    	MOV	B,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E76'   7D                    	MOV	A,L
  0E77'   1F                    	RAR
  0E78'   67                    	MOV	H,A
  0E79'   3E 00                 	MVI	A,0
  0E7B'   1F                    	RAR
  0E7C'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0E7D'   19                    	DAD	D
  0E7E'   78                    	MOV	A,B
  0E7F'   CE 00                 	ACI	0		; A:HL = the position
  0E81'   D1                    	POP	D
  0E82'   C1                    	POP	B
  0E83'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0E84'                         ZSAVE:
  0E84'   2A 24AF'              	LHLD	CMDCNT
  0E87'   22 2509'              	SHLD	ZSVCNT
  0E8A'   2A 0000*              	LHLD	AUXCNT
  0E8D'   22 250B'              	SHLD	ZSVAUX
  0E90'   3A 0000*              	LDA	DIRFLG
  0E93'   32 250D'              	STA	ZSVDIR
  0E96'   C9                    	RET
  0E97'                         ZREST:
  0E97'   2A 2509'              	LHLD	ZSVCNT
  0E9A'   22 24AF'              	SHLD	CMDCNT
  0E9D'   2A 250B'              	LHLD	ZSVAUX
  0EA0'   22 0000*              	SHLD	AUXCNT
  0EA3'   3A 250D'              	LDA	ZSVDIR
  0EA6'   32 0000*              	STA	DIRFLG
  0EA9'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0EAA'                         GZONE:
  0EAA'   CD 0E84'              	CALL	ZSAVE
  0EAD'   CD 0C58'              	CALL	CURRW
  0EB0'   6F                    	MOV	L,A
  0EB1'   26 00                 	MVI	H,0
  0EB3'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0EB6'   CD 0E64'              	CALL	FPOS
  0EB9'   22 0000*              	SHLD	ZTOP
  0EBC'   32 0002*              	STA	ZTOP+2
  0EBF'   C3 0E97'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0EC2'                         GPLACE:
  0EC2'   CD 0E84'              	CALL	ZSAVE
  0EC5'   CD 0E61'              	CALL	CURFP
  0EC8'   EB                    	XCHG
  0EC9'   2A 0000*              	LHLD	ZTOP
  0ECC'   EB                    	XCHG
  0ECD'   4F                    	MOV	C,A		; C:HL = the target's position
  0ECE'   3A 0002*              	LDA	ZTOP+2
  0ED1'   47                    	MOV	B,A		; B:DE = the top's
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0ED2'   79                    	MOV	A,C
  0ED3'   CD 0E57'              	CALL	SUB24
  0ED6'   22 2506'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  0ED9'   DA 0F26'              	JC	GP_UP
  0EDC'   B7                    	ORA	A
  0EDD'   C2 0F67'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0EE0'   3A 0000*              	LDA	NEDIT
  0EE3'   5F                    	MOV	E,A
  0EE4'   16 00                 	MVI	D,0
  0EE6'   B7                    	ORA	A
  0EE7'   1F                    	RAR
  0EE8'   6F                    	MOV	L,A
  0EE9'   26 00                 	MVI	H,0
  0EEB'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0EEC'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0EEF'   CD 0652'              	CALL	GBSUB		; HL = bytes from there to the target
  0EF2'   EB                    	XCHG
  0EF3'   2A 2506'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0EF6'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0EF9'   DA 0F67'              	JC	GP_MID
  0EFC'   CD 0652'              	CALL	GBSUB		; HL = the top line's start (resident)
  0EFF'   01 0000               	LXI	B,0		; BC = lines from the top
  0F02'                         GP_CNT:
  0F02'   7A                    	MOV	A,D
  0F03'   B3                    	ORA	E
  0F04'   CA 0F13'              	JZ	GP_DN
  0F07'   7E                    	MOV	A,M
  0F08'   23                    	INX	H
  0F09'   1B                    	DCX	D
  0F0A'   FE 0A                 	CPI	LF
  0F0C'   C2 0F02'              	JNZ	GP_CNT
  0F0F'   03                    	INX	B
  0F10'   C3 0F02'              	JMP	GP_CNT
  0F13'                         GP_DN:
  0F13'   3A 0000*              	LDA	NEDIT
  0F16'   3D                    	DCR	A
  0F17'   5F                    	MOV	E,A
  0F18'   16 00                 	MVI	D,0		; DE = the bottom row
  0F1A'   60                    	MOV	H,B
  0F1B'   69                    	MOV	L,C
  0F1C'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0F1F'   DA 0F71'              	JC	GP_SET		; A = the bottom row
  0F22'   7D                    	MOV	A,L		; on the screen: its row
  0F23'   C3 0F91'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0F26'                         GP_UP:
  0F26'   3C                    	INR	A
  0F27'   C2 0F67'              	JNZ	GP_MID		; 64K bytes or more above
  0F2A'   2A 2506'              	LHLD	ZDIF
  0F2D'   EB                    	XCHG
  0F2E'   21 0000               	LXI	H,0
  0F31'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0F34'   7C                    	MOV	A,H
  0F35'   B5                    	ORA	L
  0F36'   CA 0F67'              	JZ	GP_MID		; exactly 64K
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0F39'   EB                    	XCHG			; DE = bytes to read
  0F3A'   AF                    	XRA	A
  0F3B'   32 2508'              	STA	ZLF
  0F3E'   CD 0000*              	CALL	RGET0
  0F41'                         GP_RD:
  0F41'   CD 0000*              	CALL	RDGET		; (keeps DE)
  0F44'   DA 0F67'              	JC	GP_MID
  0F47'   FE 0A                 	CPI	LF
  0F49'   C2 0F5D'              	JNZ	GP_RN
  0F4C'   3A 0000*              	LDA	NEDIT
  0F4F'   B7                    	ORA	A
  0F50'   1F                    	RAR
  0F51'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  0F53'   E5                    	PUSH	H
  0F54'   21 2508'              	LXI	H,ZLF
  0F57'   34                    	INR	M
  0F58'   BE                    	CMP	M		; CY iff more lines than that
  0F59'   E1                    	POP	H
  0F5A'   DA 0F67'              	JC	GP_MID
  0F5D'                         GP_RN:
  0F5D'   1B                    	DCX	D
  0F5E'   7A                    	MOV	A,D
  0F5F'   B3                    	ORA	E
  0F60'   C2 0F41'              	JNZ	GP_RD
  0F63'   AF                    	XRA	A		; the top row
  0F64'   C3 0F71'              	JMP	GP_SET
  0F67'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  0F67'   3E 01                 	MVI	A,1
  0F69'   32 0000*              	STA	WFILL		; not past the end of the file
  0F6C'   3A 0000*              	LDA	NEDIT
  0F6F'   B7                    	ORA	A
  0F70'   1F                    	RAR			; the middle row
  0F71'                         GP_SET:
  0F71'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  0F72'   26 00                 	MVI	H,0
  0F74'   22 0000*              	SHLD	WINROW
  0F77'   21 0000               	LXI	H,0
  0F7A'   22 0000*              	SHLD	LNDLT
  0F7D'   CD 06E7'              	CALL	SETFUL		; the window may have paged: full repaint
  0F80'                         GP_FIN:
  0F80'   CD 0E97'              	CALL	ZREST
  0F83'   3A 2530'              	LDA	GPKEEP
  0F86'   B7                    	ORA	A
  0F87'   CA 0794'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  0F8A'   AF                    	XRA	A
  0F8B'   32 2530'              	STA	GPKEEP
  0F8E'   C3 054B'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  0F91'                         GP_ONS:
  0F91'   6F                    	MOV	L,A
  0F92'   26 00                 	MVI	H,0		; HL = the row it lands on
  0F94'   EB                    	XCHG
  0F95'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  0F98'   EB                    	XCHG
  0F99'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  0F9C'   22 0000*              	SHLD	LNDLT
  0F9F'   3E 01                 	MVI	A,R_MOVE
  0FA1'   32 24B3'              	STA	RINTENT
  0FA4'   C3 0F80'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  0FA7'                         OPPEND:
  0FA7'   AF                    	XRA	A
  0FA8'   32 24DC'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  0FAB'   3A 24D9'              	LDA	PSAVE
  0FAE'   FE 63                 	CPI	'c'
  0FB0'   C2 0FCD'              	JNZ	OPP_ND
  0FB3'   79                    	MOV	A,C
  0FB4'   FE 77                 	CPI	'w'
  0FB6'   CA 0FBE'              	JZ	OPP_W
  0FB9'   FE 57                 	CPI	'W'
  0FBB'   C2 0FCD'              	JNZ	OPP_ND
  0FBE'                         OPP_W:
  0FBE'   CD 1047'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  0FC1'   DA 0FCD'              	JC	OPP_ND
  0FC4'   79                    	MOV	A,C
  0FC5'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  0FC7'   4F                    	MOV	C,A
  0FC8'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  0FCA'   32 24DC'              	STA	CWEOL		;   see the clamp in OPA_F
  0FCD'                         OPP_ND:
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0FCD'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  0FCE'   21 24D9'              	LXI	H,PSAVE
  0FD1'   BE                    	CMP	M
  0FD2'   CA 1068'              	JZ	OPLINE
  0FD5'   79                    	MOV	A,C		; (OPCLS classifies the key)
  0FD6'   CD 1078'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  0FD9'   DA 1044'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  0FDC'   32 24DB'              	STA	OPCLSV
  0FDF'   47                    	MOV	B,A		; B = the class
  0FE0'   3A 24D9'              	LDA	PSAVE
  0FE3'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  0FE5'   C2 0FF1'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  0FE8'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  0FE9'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  0FEB'   C2 1013'              	JNZ	OPP_GO
  0FEE'   C3 0FFC'              	JMP	OPP_NO
  0FF1'                         OPP_NC:
  0FF1'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  0FF3'   C2 1013'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  0FF6'   78                    	MOV	A,B		;   a charwise register would need a type flag
  0FF7'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  0FF9'   CA 1013'              	JZ	OPP_GO		;   within a line -- neither of which is built
  0FFC'                         OPP_NO:
  0FFC'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  0FFD'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  0FFF'   CA 100D'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  1002'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  1004'   CA 100D'              	JZ	OPP_SW		;   so swallow it before dropping the command
  1007'   CD 0348'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  100A'   C2 1044'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  100D'                         OPP_SW:
  100D'   CD 0218'              	CALL	MKGETK
  1010'   C3 1044'              	JMP	OPABRT
  1013'                         OPP_GO:
  1013'   AF                    	XRA	A
  1014'   32 24BA'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  1017'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  101A'   22 24DD'              	SHLD	OPSTA
  101D'   21 23DD'              	LXI	H,CMDTAB
  1020'   CD 00C5'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1023'   3A 24D9'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1026'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1027'   CA 06C6'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  102A'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  102D'   22 24DF'              	SHLD	OPEND2
  1030'   3A 24D9'              	LDA	PSAVE
  1033'   FE 79                 	CPI	'y'
  1035'   CA 1518'              	JZ	OPYANK		; a yank takes the span without losing it
  1038'   CD 10B3'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  103B'   3A 24D9'              	LDA	PSAVE
  103E'   FE 63                 	CPI	'c'
  1040'   C0                    	RNZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  1041'   C3 12DF'              	JMP	SETINS
  1044'                         OPABRT:
  1044'   C3 06C6'              	JMP	SETMOV		; not a motion -> operator cancelled, nothing drew
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  1047'                         ONWHIT:
  1047'   CD 0635'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  104A'   CA 1066'              	JZ	OW_YES
  104D'   CD 0640'              	CALL	CURCHR		; A = the char under the cursor
  1050'   FE 20                 	CPI	' '
  1052'   CA 1066'              	JZ	OW_YES
  1055'   FE 09                 	CPI	TAB
  1057'   CA 1066'              	JZ	OW_YES
  105A'   FE 0D                 	CPI	CR
  105C'   CA 1066'              	JZ	OW_YES
  105F'   FE 0A                 	CPI	LF
  1061'   CA 1066'              	JZ	OW_YES
  1064'   B7                    	ORA	A		; a char to change: CY clear
  1065'   C9                    	RET
  1066'                         OW_YES:
  1066'   37                    	STC
  1067'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  1068'                         OPLINE:
  1068'   3A 24D9'              	LDA	PSAVE
  106B'   FE 63                 	CPI	'c'
  106D'   CA 06C6'              	JZ	SETMOV
  1070'   FE 79                 	CPI	'y'
  1072'   CA 14FD'              	JZ	VY_YY
  1075'   C3 1482'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  1078'                         OPCLS:
  1078'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  107A'   CA 1087'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  107D'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  107F'   C2 109B'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1082'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1084'   C3 1089'              	JMP	OPC_FK
  1087'                         OPC_SEM:
  1087'   06 00                 	MVI	B,0		; ';' runs it as it stands
  1089'                         OPC_FK:
  1089'   3A 2526'              	LDA	FNDKND
  108C'   B7                    	ORA	A
  108D'   37                    	STC
  108E'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


                                				;   20H, which would read as a find that was never
                                				;   made
  108F'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1090'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1092'   CA 1099'              	JZ	OPC_EXC
  1095'   3E 01                 	MVI	A,1
  1097'   B7                    	ORA	A		; CY clear: a motion, class 1
  1098'   C9                    	RET
  1099'                         OPC_EXC:
  1099'   AF                    	XRA	A		; class 0, CY clear
  109A'   C9                    	RET
  109B'                         OPC_TB:
  109B'   47                    	MOV	B,A
  109C'   21 11D5'              	LXI	H,OPCTAB
  109F'                         OPC_LP:
  109F'   7E                    	MOV	A,M
  10A0'   B7                    	ORA	A
  10A1'   CA 10B1'              	JZ	OPC_MS		; end of table -> not a motion
  10A4'   B8                    	CMP	B
  10A5'   CA 10AD'              	JZ	OPC_HT
  10A8'   23                    	INX	H
  10A9'   23                    	INX	H
  10AA'   C3 109F'              	JMP	OPC_LP
  10AD'                         OPC_HT:
  10AD'   23                    	INX	H
  10AE'   7E                    	MOV	A,M		; class byte
  10AF'   B7                    	ORA	A		; clear CY
  10B0'   C9                    	RET
  10B1'                         OPC_MS:
  10B1'   37                    	STC
  10B2'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  10B3'                         OPAPPL:
  10B3'   3A 24DB'              	LDA	OPCLSV
  10B6'   FE 02                 	CPI	2
  10B8'   CA 11B9'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  10BB'   2A 24DD'              	LHLD	OPSTA
  10BE'   EB                    	XCHG			; DE = start
  10BF'   2A 24DF'              	LHLD	OPEND2		; HL = end
  10C2'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  10C5'   DA 10D5'              	JC	OPA_F
  10C8'   CA 10D5'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  10CB'   22 24E1'              	SHLD	OPLO
  10CE'   EB                    	XCHG
  10CF'   22 24E3'              	SHLD	OPHI
  10D2'   C3 112D'              	JMP	OPA_DO
  10D5'                         OPA_F:
  10D5'   EB                    	XCHG			; HL = start, DE = end
  10D6'   22 24E1'              	SHLD	OPLO
  10D9'   EB                    	XCHG			; HL = end
  10DA'   3A 24DB'              	LDA	OPCLSV
  10DD'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  10DF'   CA 112A'              	JZ	OPA_HI		;   OPA_EX below cuts an exclusive forward span back
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  10E2'   FE 01                 	CPI	1
  10E4'   C2 1106'              	JNZ	OPA_EX
  10E7'   23                    	INX	H		; inclusive endpoint -> hi = end+1
                                	;--- 'cw' stops at the line's content end, where a plain 'ce' (and 'de')
                                	;    runs on into the next line's word and 'd%' crosses to its mate --
                                	;    all four recorded from vim 9.1.  vim's 'cw' is not simply 'ce': the
                                	;    rewrite keeps 'w's own end-of-line stop, so the clamp hangs off
                                	;    CWEOL (the rewrite) and not off the inclusive class. ---
  10E8'   3A 24DC'              	LDA	CWEOL
  10EB'   B7                    	ORA	A
  10EC'   CA 112A'              	JZ	OPA_HI
  10EF'   22 24E3'              	SHLD	OPHI		; park the motion's own end: CEND clobbers DE
  10F2'   2A 24E1'              	LHLD	OPLO
  10F5'   CD 125D'              	CALL	CEND		; HL = the start line's content end
  10F8'   EB                    	XCHG			; DE = that content end
  10F9'   2A 24E3'              	LHLD	OPHI		; HL = hi
  10FC'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  10FF'   D2 112A'              	JNC	OPA_HI		; hi is inside the line: keep it
  1102'   EB                    	XCHG			; HL = the content end: 'cw' stops there
  1103'   C3 112A'              	JMP	OPA_HI
  1106'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  1106'   22 24E3'              	SHLD	OPHI		; the motion's own end, for now
  1109'   2A 24E1'              	LHLD	OPLO
  110C'   CD 125D'              	CALL	CEND		; HL = the start line's content end
  110F'   EB                    	XCHG			; DE = that content end
  1110'   3A 24BA'              	LDA	WPULL		; the motion landed on a line's end and was
  1113'   B7                    	ORA	A		;   pulled back onto its last char (the command
  1114'   C2 1120'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  1117'   2A 24E3'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  111A'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  111D'   D2 112D'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  1120'                         OPA_CE:				;   deletes the word, not all but its last char
  1120'   2A 24E1'              	LHLD	OPLO
  1123'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1126'   CA 116B'              	JZ	OPA_LN
  1129'   EB                    	XCHG			; HL = the content end
  112A'                         OPA_HI:
  112A'   22 24E3'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  112D'                         OPA_DO:
  112D'   CD 1151'              	CALL	OPDSPN
  1130'   3A 24D9'              	LDA	PSAVE
  1133'   FE 63                 	CPI	'c'
  1135'   C8                    	RZ
  1136'   C3 126E'              	JMP	CLAMPE
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  1139'                         SPNBRK:
  1139'   2A 24E1'              	LHLD	OPLO
  113C'   CD 05C5'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  113F'   EB                    	XCHG			; DE = it
  1140'   2A 24E3'              	LHLD	OPHI
  1143'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  1146'                         OPSPNL:
  1146'   2A 24E3'              	LHLD	OPHI
  1149'   EB                    	XCHG
  114A'   2A 24E1'              	LHLD	OPLO
  114D'   EB                    	XCHG			; HL = hi, DE = lo
  114E'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  1151'                         OPDSPN:
  1151'   CD 1139'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  1154'   F5                    	PUSH	PSW
  1155'   2A 24E1'              	LHLD	OPLO
  1158'   CD 0000*              	CALL	GOTO
  115B'   CD 1146'              	CALL	OPSPNL		; HL = hi - lo
  115E'   CD 0000*              	CALL	DELFWD
  1161'   CD 0188'              	CALL	MARKMOD
  1164'   F1                    	POP	PSW
  1165'   DA 06E7'              	JC	SETFUL		; a break went: every row below it moved up
  1168'   C3 06CC'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  116B'                         OPA_LN:
  116B'   3A 24D9'              	LDA	PSAVE
  116E'   FE 63                 	CPI	'c'
  1170'   C2 1179'              	JNZ	OPA_LD
  1173'   2A 24E1'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  1176'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  1179'                         OPA_LD:
  1179'   2A 24E1'              	LHLD	OPLO
  117C'   22 24DD'              	SHLD	OPSTA
  117F'   22 24DF'              	SHLD	OPEND2
  1182'   C3 11B9'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  1185'                         OPALSP:
  1185'   2A 24DD'              	LHLD	OPSTA
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  1188'   EB                    	XCHG
  1189'   2A 24DF'              	LHLD	OPEND2
  118C'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  118F'   DA 119C'              	JC	OPAL_F
  1192'   22 24E1'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1195'   EB                    	XCHG
  1196'   22 24E3'              	SHLD	OPHI		; hi-src = start
  1199'   C3 11A6'              	JMP	OPAL_R
  119C'                         OPAL_F:
  119C'   EB                    	XCHG			; HL = start
  119D'   22 24E1'              	SHLD	OPLO		; lo-src = start
  11A0'   2A 24DF'              	LHLD	OPEND2
  11A3'   22 24E3'              	SHLD	OPHI		; hi-src = end
  11A6'                         OPAL_R:
  11A6'   2A 24E1'              	LHLD	OPLO
  11A9'   CD 05B2'              	CALL	BOL
  11AC'   22 24E1'              	SHLD	OPLO		; lo = BOL(low line)
  11AF'   2A 24E3'              	LHLD	OPHI
  11B2'   CD 05E2'              	CALL	NLSTART
  11B5'   22 24E3'              	SHLD	OPHI		; hi = start of line past the high line
  11B8'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  11B9'                         OPALIN:
  11B9'   CD 1185'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  11BC'                         OPDLIN:
  11BC'   CD 1151'              	CALL	OPDSPN
  11BF'   CD 0635'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  11C2'   DA 11D2'              	JC	OPDL_NB
  11C5'   CD 0000*              	CALL	LOGLEN
  11C8'   7C                    	MOV	A,H
  11C9'   B5                    	ORA	L
  11CA'   C8                    	RZ			; empty buffer
  11CB'   2B                    	DCX	H
  11CC'   CD 05B2'              	CALL	BOL
  11CF'   CD 0000*              	CALL	GOTO
  11D2'                         OPDL_NB:
  11D2'   C3 0794'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  11D5'                         OPCTAB:
  11D5'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  11D9'   62 00 42 00           
  11DD'   68 00 6C 00           
  11E1'   30 00 5E 00           
  11E5'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  11E7'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  11EB'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  11EF'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  11F3'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  11F7'   24 01                 
  11F9'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  11FD'   47 02 48 02           
  1201'   4D 02 4C 02           
  1205'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1207'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1208'                         VCB_C:
  1208'   CD 1214'              	CALL	VCB_CD
  120B'   C3 12DF'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  120E'                         VCB_D:
  120E'   CD 1214'              	CALL	VCB_CD
  1211'   C3 126E'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  1214'                         VCB_CD:
  1214'   CD 064C'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1217'   22 24E1'              	SHLD	OPLO
  121A'   CD 0000*              	CALL	CUROFF
  121D'   CD 125D'              	CALL	CEND		; to the line's content end, the CR,LF left
  1220'   22 24E3'              	SHLD	OPHI
  1223'   C3 1151'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


                                ; the line count is unchanged and only this row is stale -> R_LINE.
  1226'                         VC_X:
  1226'   CD 0839'              	CALL	GLSTAL
  1229'   CD 06CC'              	CALL	SETLIN
  122C'   CD 0659'              	CALL	GETCNT
  122F'   22 24E5'              	SHLD	CNTV
  1232'   CD 0000*              	CALL	CUROFF
  1235'   22 24E9'              	SHLD	WKI		; cur
  1238'   CD 125D'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  123B'   EB                    	XCHG			; DE = contentend
  123C'   2A 24E9'              	LHLD	WKI		; HL = cur
  123F'   EB                    	XCHG			; HL = contentend, DE = cur
  1240'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  1243'   7C                    	MOV	A,H
  1244'   B5                    	ORA	L
  1245'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  1246'   EB                    	XCHG			; DE = available
  1247'   2A 24E5'              	LHLD	CNTV		; HL = count
  124A'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  124D'   DA 1253'              	JC	VX_USEA
  1250'   C3 1254'              	JMP	VX_DEL		; count <= available -> HL = count = del
  1253'                         VX_USEA:
  1253'   EB                    	XCHG			; HL = available
  1254'                         VX_DEL:
  1254'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  1257'   CD 0188'              	CALL	MARKMOD
  125A'   C3 126E'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  125D'                         CEND:
  125D'   CD 05C5'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1260'   7C                    	MOV	A,H
  1261'   B5                    	ORA	L
  1262'   C8                    	RZ			; the start of the text: nothing before it
  1263'   2B                    	DCX	H
  1264'   E5                    	PUSH	H
  1265'   CD 0000*              	CALL	CHARAT
  1268'   E1                    	POP	H		; HL = term-1
  1269'   FE 0D                 	CPI	CR
  126B'   C8                    	RZ			; a CR before the LF -> the content ends there
  126C'   23                    	INX	H
  126D'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  126E'                         CLAMPE:
  126E'   CD 0000*              	CALL	CUROFF
  1271'   E5                    	PUSH	H
  1272'   CD 05F1'              	CALL	EOLC
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  1275'   D1                    	POP	D		; DE = cur
  1276'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  1279'   D8                    	RC
  127A'   C8                    	RZ
  127B'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  127E'                         VC_I:
  127E'   CD 0659'              	CALL	GETCNT
  1281'   C3 12DC'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1284'                         VC_A:
  1284'   CD 0659'              	CALL	GETCNT
  1287'   CD 0635'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  128A'   CA 12A1'              	JZ	VA_INS
  128D'   EB                    	XCHG			; HL = cur
  128E'   E5                    	PUSH	H
  128F'   CD 0000*              	CALL	CHARAT
  1292'   E1                    	POP	H
  1293'   FE 0A                 	CPI	LF
  1295'   CA 12A1'              	JZ	VA_INS		; on the line terminator -> append in place
  1298'   FE 0D                 	CPI	CR
  129A'   CA 12A1'              	JZ	VA_INS
  129D'   23                    	INX	H
  129E'   CD 0000*              	CALL	GOTO
  12A1'                         VA_INS:
  12A1'   C3 12DC'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  12A4'                         VCB_A:
  12A4'   CD 064C'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  12A7'   CD 05F1'              	CALL	EOLC		; HL = last content char (the start when empty)
  12AA'   E5                    	PUSH	H
  12AB'   CD 0000*              	CALL	CHARAT
  12AE'   E1                    	POP	H
  12AF'   FE 0D                 	CPI	CR
  12B1'   CA 12BA'              	JZ	VBA_IN		; an empty line: insert at its start
  12B4'   FE 0A                 	CPI	LF
  12B6'   CA 12BA'              	JZ	VBA_IN
  12B9'   23                    	INX	H		; past the last content char
  12BA'                         VBA_IN:
  12BA'   CD 0000*              	CALL	GOTO
  12BD'   C3 12DC'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  12C0'                         VCB_I:
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  12C0'   CD 0659'              	CALL	GETCNT
  12C3'   CD 0794'              	CALL	FNBLNK
  12C6'   CD 0000*              	CALL	CUROFF
  12C9'   E5                    	PUSH	H
  12CA'   CD 0000*              	CALL	CHARAT
  12CD'   E1                    	POP	H
  12CE'   FE 20                 	CPI	' '
  12D0'   CA 12D8'              	JZ	VBI_SK
  12D3'   FE 09                 	CPI	TAB
  12D5'   C2 12DC'              	JNZ	SETINM
  12D8'                         VBI_SK:
  12D8'   23                    	INX	H		; blanks only: past the last of them
  12D9'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  12DC'                         SETINM:
  12DC'   CD 06C6'              	CALL	SETMOV
  12DF'                         SETINS:
  12DF'   3E 01                 	MVI	A,EM_INS
  12E1'   32 24AE'              	STA	EDMODE
  12E4'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  12E5'                         ATCEND:
  12E5'   CD 0635'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  12E8'   C8                    	RZ
  12E9'   CD 0640'              	CALL	CURCHR		; A = the char under the cursor
  12EC'   FE 0D                 	CPI	CR
  12EE'   C8                    	RZ
  12EF'   FE 0A                 	CPI	LF
  12F1'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  12F2'                         OPNBRK:
  12F2'   3E 0D                 	MVI	A,CR
  12F4'   CD 0000*              	CALL	PUTGAP
  12F7'   3E 0A                 	MVI	A,LF
  12F9'   CD 0000*              	CALL	PUTGAP
  12FC'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  12FF'   23                    	INX	H
  1300'   22 0000*              	SHLD	LNDLT
  1303'   C3 0188'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1306'                         ENDBRK:
  1306'   CD 0635'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1309'   C0                    	RNZ
  130A'   CD 12F2'              	CALL	OPNBRK
  130D'   CD 0000*              	CALL	CUROFF
  1310'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1311'   2B                    	DCX	H		;   line, with its own terminator after it
  1312'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1315'                         VC_O:
  1315'   CD 064C'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1318'   CD 125D'              	CALL	CEND
  131B'   CD 0000*              	CALL	GOTO
  131E'   CD 12F2'              	CALL	OPNBRK
  1321'   CD 1306'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1324'   CD 06D2'              	CALL	SETILN		;   needs a terminator of its own to exist
  1327'   C3 12DF'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  132A'                         VCB_O:
  132A'   CD 064C'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  132D'   CD 05B2'              	CALL	BOL
  1330'   CD 0000*              	CALL	GOTO
  1333'   CD 12F2'              	CALL	OPNBRK
  1336'   CD 0000*              	CALL	CUROFF
  1339'   2B                    	DCX	H
  133A'   2B                    	DCX	H
  133B'   CD 0000*              	CALL	GOTO
  133E'   CD 06D2'              	CALL	SETILN
  1341'   C3 12DF'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  1344'                         VCB_J:
  1344'   CD 064C'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1347'   CD 125D'              	CALL	CEND		; the join point: this line's content end
  134A'   22 24E1'              	SHLD	OPLO
  134D'   CD 0000*              	CALL	CUROFF
  1350'   CD 05E2'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1353'   E5                    	PUSH	H
  1354'   CD 0000*              	CALL	LOGLEN
  1357'   D1                    	POP	D		; DE = that start
  1358'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  135B'   CA 06C6'              	JZ	SETMOV
  135E'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  135F'                         VJ_WS:
  135F'   E5                    	PUSH	H
  1360'   CD 0000*              	CALL	LOGLEN
  1363'   D1                    	POP	D		; DE = the scan
  1364'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1367'   CA 137E'              	JZ	VJ_DEL
  136A'   EB                    	XCHG			; HL = the scan
  136B'   E5                    	PUSH	H
  136C'   CD 0000*              	CALL	CHARAT
  136F'   E1                    	POP	H
  1370'   FE 20                 	CPI	' '
  1372'   CA 137A'              	JZ	VJ_SKIP
  1375'   FE 09                 	CPI	TAB
  1377'   C2 137E'              	JNZ	VJ_DEL
  137A'                         VJ_SKIP:
  137A'   23                    	INX	H
  137B'   C3 135F'              	JMP	VJ_WS
  137E'                         VJ_DEL:
  137E'   22 24E3'              	SHLD	OPHI
  1381'   CD 1151'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1384'   CD 06E1'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1387'   CD 0635'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  138A'   CA 126E'              	JZ	CLAMPE
  138D'   CD 0640'              	CALL	CURCHR		; the first char of what was appended
  1390'   FE 0D                 	CPI	CR
  1392'   CA 126E'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1395'   FE 0A                 	CPI	LF
  1397'   CA 126E'              	JZ	CLAMPE
  139A'   FE 29                 	CPI	')'
  139C'   CA 126E'              	JZ	CLAMPE		; vim puts no space before a ')'
  139F'   CD 0000*              	CALL	CUROFF
  13A2'   7C                    	MOV	A,H
  13A3'   B5                    	ORA	L
  13A4'   CA 13BA'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  13A7'   2B                    	DCX	H
  13A8'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  13AB'   FE 20                 	CPI	' '
  13AD'   CA 126E'              	JZ	CLAMPE
  13B0'   FE 09                 	CPI	TAB
  13B2'   CA 126E'              	JZ	CLAMPE
  13B5'   FE 0A                 	CPI	LF
  13B7'   CA 126E'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  13BA'                         VJ_SP:
  13BA'   3E 20                 	MVI	A,' '
  13BC'   CD 0000*              	CALL	PUTGAP
  13BF'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  13C2'   2B                    	DCX	H
  13C3'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  13C6'                         VC_TILD:
  13C6'   CD 0659'              	CALL	GETCNT
  13C9'   CD 06CC'              	CALL	SETLIN		; only this row changes
  13CC'   CD 0839'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  13CF'   CD 0635'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  13D2'   CA 06C6'              	JZ	SETMOV
  13D5'   CD 0640'              	CALL	CURCHR		; A = the char under the cursor
  13D8'   FE 0D                 	CPI	CR
  13DA'   CA 06C6'              	JZ	SETMOV		; the line's end: nothing to toggle
  13DD'   FE 0A                 	CPI	LF
  13DF'   CA 06C6'              	JZ	SETMOV
  13E2'   47                    	MOV	B,A
  13E3'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  13E5'   FE 41                 	CPI	'A'
  13E7'   DA 13F3'              	JC	VT_PUT		; below 'A': no case
  13EA'   FE 5B                 	CPI	'Z'+1
  13EC'   D2 13F3'              	JNC	VT_PUT		; above 'Z': no case
  13EF'   78                    	MOV	A,B
  13F0'   EE 20                 	XRI	20H		; a letter: flip the case bit
  13F2'   47                    	MOV	B,A
  13F3'                         VT_PUT:
  13F3'   78                    	MOV	A,B
  13F4'   32 24F2'              	STA	VRCH		; the calls below do not preserve B
  13F7'   CD 0188'              	CALL	MARKMOD
  13FA'   21 0001               	LXI	H,1
  13FD'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1400'   3A 24F2'              	LDA	VRCH
  1403'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1406'   C3 126E'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  1409'                         VC_R:
  1409'   CD 0646'              	CALL	MOVCNT		; a cursor motion, and its count
  140C'   3E 03                 	MVI	A,PR
  140E'   32 24D6'              	STA	GPEND
  1411'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1412'                         VR_DO:
  1412'   AF                    	XRA	A
  1413'   32 24D6'              	STA	GPEND
  1416'   79                    	MOV	A,C
  1417'   32 24F2'              	STA	VRCH		; the calls below do not preserve C
  141A'   CD 06CC'              	CALL	SETLIN		; only this row changed
  141D'   CD 0839'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1420'   CD 0635'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1423'   CA 06C6'              	JZ	SETMOV		; the end of the text: vim does nothing
  1426'   CD 0640'              	CALL	CURCHR		; A = the char under the cursor
  1429'   FE 0D                 	CPI	CR
  142B'   CA 06C6'              	JZ	SETMOV		; the line's end: nothing to replace
  142E'   FE 0A                 	CPI	LF
  1430'   CA 06C6'              	JZ	SETMOV
  1433'   CD 0188'              	CALL	MARKMOD
  1436'   21 0001               	LXI	H,1
  1439'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  143C'   3A 24F2'              	LDA	VRCH
  143F'   FE 0D                 	CPI	CR
  1441'   CA 144E'              	JZ	VR_CR
  1444'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1447'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  144A'   2B                    	DCX	H		;   out, which moves every logical offset
  144B'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  144E'                         VR_CR:
  144E'   CD 12F2'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1451'   CD 1306'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1454'   CD 06D2'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1457'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1459'   32 24B6'              	STA	ILABOV
  145C'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  145D'                         VCB_R:
  145D'   CD 0659'              	CALL	GETCNT
  1460'   CD 06C6'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1463'   21 0000               	LXI	H,0
  1466'   22 24F3'              	SHLD	RPDEL		; nothing of ours to put back yet
  1469'   22 24F5'              	SHLD	RPAPP
  146C'   3E 02                 	MVI	A,EM_REP
  146E'   32 24AE'              	STA	EDMODE
  1471'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1472'                         VC_D:
  1472'   3E 64                 	MVI	A,'d'
  1474'   32 24D8'              	STA	PENDOP
  1477'   C3 06C6'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  147A'                         VC_C:
  147A'   3E 63                 	MVI	A,'c'
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  147C'   32 24D8'              	STA	PENDOP
  147F'   C3 06C6'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1482'                         VD_DD:
  1482'   CD 0839'              	CALL	GLSTAL
  1485'   CD 0659'              	CALL	GETCNT
  1488'   22 24E5'              	SHLD	CNTV
  148B'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  148D'   32 24DA'              	STA	DDSNG
  1490'   2B                    	DCX	H
  1491'   7C                    	MOV	A,H
  1492'   B5                    	ORA	L
  1493'   C2 149E'              	JNZ	VDD_LS
  1496'   3E 01                 	MVI	A,1
  1498'   32 24DA'              	STA	DDSNG
  149B'   C3 14A4'              	JMP	VDD_GO
  149E'                         VDD_LS:
  149E'   CD 07FF'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  14A1'   DA 06C6'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  14A4'                         VDD_GO:
  14A4'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  14A7'   CD 077D'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  14AA'   2A 24E5'              	LHLD	CNTV
  14AD'   CD 0000*              	CALL	SETC0
  14B0'                         VDD_FW:
  14B0'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  14B3'   CD 066E'              	CALL	CNTTST
  14B6'   C2 14B0'              	JNZ	VDD_FW
  14B9'   CD 0188'              	CALL	MARKMOD
  14BC'   CD 0970'              	CALL	ATEOF
  14BF'   D2 14DA'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  14C2'   3E 00                 	MVI	A,0
  14C4'   32 24DA'              	STA	DDSNG		; deleted to the end: full repaint
  14C7'   CD 0DB6'              	CALL	ONFST
  14CA'   CA 0794'              	JZ	FNBLNK		; nothing left before it
  14CD'   21 0001               	LXI	H,1		; onto the new last line
  14D0'   CD 0000*              	CALL	SETBWD
  14D3'   2A 0000*              	LHLD	LNDLT
  14D6'   2B                    	DCX	H
  14D7'   22 0000*              	SHLD	LNDLT
  14DA'                         VDD_UP:
  14DA'   CD 0794'              	CALL	FNBLNK
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  14DD'   3A 24DA'              	LDA	DDSNG
  14E0'   B7                    	ORA	A
  14E1'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  14E2'   3E 03                 	MVI	A,R_DLIN
  14E4'   32 24B3'              	STA	RINTENT
  14E7'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and an overflow raises WM's 'QBUF FULL' with
                                ; what has already moved safely in the register.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  14E8'                         QEMPTY:
  14E8'   2A 0000*              	LHLD	QBEG
  14EB'   EB                    	XCHG
  14EC'   2A 0000*              	LHLD	QEND
  14EF'   7C                    	MOV	A,H
  14F0'   BA                    	CMP	D
  14F1'   C0                    	RNZ
  14F2'   7D                    	MOV	A,L
  14F3'   BB                    	CMP	E
  14F4'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  14F5'                         VC_Y:
  14F5'   3E 79                 	MVI	A,'y'
  14F7'   32 24D8'              	STA	PENDOP
  14FA'   C3 06C6'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  14FD'                         VY_YY:
  14FD'   CD 0000*              	CALL	CUROFF
  1500'   22 2516'              	SHLD	YOFF		; the cursor, which a yank leaves alone
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  1503'   CD 05B2'              	CALL	BOL
  1506'   22 2518'              	SHLD	YPT		; where the lines come from, to put them back
  1509'   CD 161A'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  150C'   CD 165D'              	CALL	YNCOPY		; copied where they lie, if that can be done
  150F'   D2 1621'              	JNC	YNDONE
  1512'   21 1482'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1515'   C3 1541'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1518'                         OPYANK:
  1518'   CD 1185'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  151B'   2A 24DD'              	LHLD	OPSTA
  151E'   EB                    	XCHG			; DE = start
  151F'   2A 24DF'              	LHLD	OPEND2		; HL = end
  1522'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1525'   D2 1529'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1528'   EB                    	XCHG			; ... otherwise the start is
  1529'                         OPY_LO:
  1529'   22 2516'              	SHLD	YOFF
  152C'   2A 24E1'              	LHLD	OPLO
  152F'   22 2518'              	SHLD	YPT		; where the lines come from, to put them back
  1532'   CD 161A'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1535'   CD 16D5'              	CALL	YNSPAN		; copied where they lie, if there is room
  1538'   D2 1621'              	JNC	YNDONE
  153B'   21 15DE'              	LXI	H,YSPAN
  153E'   C3 1541'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1541'                         YKGO:
  1541'   22 253F'              	SHLD	YACT
  1544'   2A 2518'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1547'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1548'   2A 2516'              	LHLD	YOFF		;   survive this -- the put-back below can page
  154B'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  154E'   22 2545'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1551'   3A 24B2'              	LDA	MODF
  1554'   32 2513'              	STA	YMODF
  1557'   3A 24CB'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  155A'   32 2514'              	STA	YDCHG		;   a yank must not become the last change
  155D'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1560'   32 2515'              	STA	YURPL		;   back are not a change to undo either
  1563'   3E 01                 	MVI	A,1
  1565'   32 0000*              	STA	UNDRPL
  1568'   32 253E'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  156B'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  156E'   22 2521'              	SHLD	YLDLT
  1571'   CD 0000*              	CALL	LOGLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  1574'   22 2543'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1577'   2A 253F'              	LHLD	YACT
  157A'   CD 15DD'              	CALL	YCALL		; the lines out of the file, into the register
  157D'   CD 0000*              	CALL	LOGLEN
  1580'   EB                    	XCHG
  1581'   2A 2543'              	LHLD	YWAS
  1584'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1587'   CA 15B5'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  158A'   2A 2518'              	LHLD	YPT
  158D'   CD 0000*              	CALL	GOTO
  1590'   CD 0000*              	CALL	QGET		; and straight back in
                                	;--- Putting them back can PAGE: QGET splices the register through
                                	;    INSBLK, whose MKGAP reaches MKROOM when the arena is tight, and a
                                	;    spill writes the window's top out to disk -- which moves TXTBEG and
                                	;    shifts every logical offset under us, YOFF among them.  ('500yy' at
                                	;    line 2500 of a 40 K file spills 48 records and used to land the
                                	;    cursor 573 lines below where it started; a yank moves the cursor
                                	;    nowhere.)  So the cursor is found again from the lines THEMSELVES:
                                	;    QGET leaves it just past them, so they start at the cursor less the
                                	;    register's length, and the cursor was YCOL bytes into them.  Both
                                	;    terms are read AFTER the paging, so neither can be stale. ---
  1593'   CD 0000*              	CALL	CUROFF		; where QGET left it: just past the lines
  1596'   22 2547'              	SHLD	YBLK
  1599'   2A 0000*              	LHLD	QBEG
  159C'   EB                    	XCHG
  159D'   2A 0000*              	LHLD	QEND
  15A0'   CD 0000*              	CALL	SUBHD		; HL = the register's length = what went back
  15A3'   EB                    	XCHG
  15A4'   2A 2547'              	LHLD	YBLK
  15A7'   CD 0000*              	CALL	SUBHD		; HL = where those lines start NOW
  15AA'   EB                    	XCHG
  15AB'   2A 2545'              	LHLD	YCOL
  15AE'   19                    	DAD	D		; ... and the cursor is YCOL into them
  15AF'   CD 0000*              	CALL	GOTO
  15B2'   C3 15BB'              	JMP	YK_RST
  15B5'                         YK_FIN:				; nothing came out, so nothing was put back and
  15B5'   2A 2516'              	LHLD	YOFF		;   no offset can have shifted: the cursor is
  15B8'   CD 0000*              	CALL	GOTO		;   where it was
  15BB'                         YK_RST:
  15BB'   2A 2521'              	LHLD	YLDLT
  15BE'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  15C1'   3A 2513'              	LDA	YMODF
  15C4'   32 24B2'              	STA	MODF
  15C7'   3A 2514'              	LDA	YDCHG
  15CA'   32 24CB'              	STA	DOTCHG
  15CD'   3A 2515'              	LDA	YURPL
  15D0'   32 0000*              	STA	UNDRPL
  15D3'   AF                    	XRA	A
  15D4'   32 253E'              	STA	MKHOLD
  15D7'   CD 0839'              	CALL	GLSTAL
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  15DA'   C3 06E7'              	JMP	SETFUL		; the cheap paint cannot carry this
  15DD'   E9                    YCALL:	PCHL
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  15DE'                         YSPAN:
  15DE'   CD 0839'              	CALL	GLSTAL
  15E1'   CD 1146'              	CALL	OPSPNL		; HL = the span's length
  15E4'   22 2541'              	SHLD	YTGT
  15E7'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  15EA'   EB                    	XCHG			; DE = it
  15EB'   2A 2541'              	LHLD	YTGT
  15EE'   EB                    	XCHG			; HL = the text's, DE = the span's
  15EF'   CD 0000*              	CALL	SUBHD
  15F2'   22 2541'              	SHLD	YTGT		; what the text is left at when the span is out
  15F5'   2A 24E1'              	LHLD	OPLO
  15F8'   CD 0000*              	CALL	GOTO
  15FB'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  15FE'                         YS_LP:
  15FE'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1601'   CD 0000*              	CALL	SETC0
  1604'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1607'   CD 0000*              	CALL	LOGLEN
  160A'   EB                    	XCHG			; DE = what is left
  160B'   2A 2541'              	LHLD	YTGT
  160E'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1611'   DA 1617'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1614'   C2 15FE'              	JNZ	YS_LP		;   but never spin here if it ever did
  1617'                         YS_END:
  1617'   C3 0188'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  161A'                         YNPRE:
  161A'   2A 0000*              	LHLD	PGTOPM
  161D'   22 2549'              	SHLD	YNPG
  1620'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1621'                         YNDONE:
  1621'   2A 2516'              	LHLD	YOFF
  1624'   CD 0000*              	CALL	GOTO
  1627'   2A 0000*              	LHLD	PGTOPM
  162A'   EB                    	XCHG
  162B'   2A 2549'              	LHLD	YNPG
  162E'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1631'   C2 06E7'              	JNZ	SETFUL		; it moved under us: repaint after all
  1634'   C3 06C6'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1637'                         YNROOM:
  1637'   11 0100               	LXI	D,100H
  163A'   19                    	DAD	D
  163B'   D8                    	RC			; within a chunk of 64K: no arena holds that
  163C'   E5                    	PUSH	H		; the span plus its slack
  163D'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1640'   EB                    	XCHG			; HL = free
  1641'   D1                    	POP	D		; DE = the span plus its slack
  1642'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1645'   DA 164D'              	JC	YNR_OK
  1648'   CA 164D'              	JZ	YNR_OK
  164B'   37                    	STC			; not enough: the delete-and-put-back path
  164C'   C9                    	RET
  164D'                         YNR_OK:
  164D'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  164E'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  164F'                         YNGO:
  164F'   C5                    	PUSH	B
  1650'   CD 0659'              	CALL	GETCNT		; spent here: this yank is happening
  1653'   CD 0839'              	CALL	GLSTAL
  1656'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1659'   C1                    	POP	B
  165A'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  165D'                         YNCOPY:
  165D'   2A 24AF'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1660'   7C                    	MOV	A,H		;   the count itself
  1661'   B5                    	ORA	L
  1662'   C2 1668'              	JNZ	YNC_HV
  1665'   21 0001               	LXI	H,1
  1668'                         YNC_HV:
  1668'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1669'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  166A'   B4                    	ORA	H
  166B'   CA 1676'              	JZ	YNC_M
  166E'   E5                    	PUSH	H
  166F'   CD 07FF'              	CALL	ONLAST		; vim: a count over one on the last line does
  1672'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1673'   DA 1688'              	JC	YNC_RF
  1676'                         YNC_M:
  1676'   E5                    	PUSH	H
  1677'   CD 077D'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  167A'   E1                    	POP	H
  167B'   CD 1690'              	CALL	YNLINE		; BC = the span, measured where it stands
  167E'   D8                    	RC			; not measurable here: let the pager answer it
  167F'   60                    	MOV	H,B
  1680'   69                    	MOV	L,C
  1681'   CD 1637'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1684'   D8                    	RC			; no: the delete-and-put-back path
  1685'   C3 164F'              	JMP	YNGO
  1688'                         YNC_RF:
  1688'   CD 0659'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  168B'   CD 0839'              	CALL	GLSTAL		;   register alone, and that is the command
  168E'   B7                    	ORA	A		; NC: done
  168F'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1690'                         YNLINE:
  1690'   22 254B'              	SHLD	YNCNT		; the lines it still wants
  1693'   2A 0000*              	LHLD	GAPEND
  1696'                         YNL_LP:
  1696'   EB                    	XCHG			; DE = the scan
  1697'   2A 0000*              	LHLD	TXTEND
  169A'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  169D'   EB                    	XCHG			; HL = the scan
  169E'   D2 16BE'              	JNC	YNL_EN		; the resident text ran out
  16A1'   7E                    	MOV	A,M
  16A2'   23                    	INX	H
  16A3'   FE 0A                 	CPI	LF
  16A5'   C2 1696'              	JNZ	YNL_LP
  16A8'   E5                    	PUSH	H
  16A9'   2A 254B'              	LHLD	YNCNT
  16AC'   2B                    	DCX	H
  16AD'   22 254B'              	SHLD	YNCNT
  16B0'   7C                    	MOV	A,H
  16B1'   B5                    	ORA	L
  16B2'   E1                    	POP	H
  16B3'   C2 1696'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  16B6'   EB                    	XCHG			; DE = past the last of them
  16B7'   2A 0000*              	LHLD	GAPEND
  16BA'   EB                    	XCHG			; HL = past them, DE = GAPEND
  16BB'   C3 16CC'              	JMP	YNL_BC
  16BE'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  16BE'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  16C1'   C2 16D3'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  16C4'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  16C7'   EB                    	XCHG			;   count clamps to it as vim's does
  16C8'   2A 0000*              	LHLD	GAPEND
  16CB'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  16CC'                         YNL_BC:
  16CC'   CD 0000*              	CALL	SUBHD		; HL = the span
  16CF'   44                    	MOV	B,H
  16D0'   4D                    	MOV	C,L
  16D1'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  16D2'   C9                    	RET
  16D3'                         YNL_NO:
  16D3'   37                    	STC
  16D4'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  16D5'                         YNSPAN:
  16D5'   CD 1146'              	CALL	OPSPNL		; HL = the span's length
  16D8'   44                    	MOV	B,H
  16D9'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  16DA'   CD 1637'              	CALL	YNROOM
  16DD'   D8                    	RC			; no room: the delete-and-put-back path
  16DE'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  16DF'   2A 24E1'              	LHLD	OPLO
  16E2'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  16E5'   C1                    	POP	B
  16E6'   C3 164F'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  16E9'                         VC_P:
  16E9'   CD 14E8'              	CALL	QEMPTY
  16EC'   CA 17A4'              	JZ	VP_BEL
  16EF'   CD 0659'              	CALL	GETCNT
  16F2'   22 251A'              	SHLD	PCNT
  16F5'   CD 0000*              	CALL	CUROFF
  16F8'   CD 05E2'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  16FB'   C3 1710'              	JMP	VP_GO
  16FE'                         VCB_P:
  16FE'   CD 14E8'              	CALL	QEMPTY
  1701'   CA 17A4'              	JZ	VP_BEL
  1704'   CD 0659'              	CALL	GETCNT
  1707'   22 251A'              	SHLD	PCNT
  170A'   CD 0000*              	CALL	CUROFF
  170D'   CD 05B2'              	CALL	BOL
  1710'                         VP_GO:
  1710'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1713'   CD 0000*              	CALL	CUROFF
  1716'   EB                    	XCHG
  1717'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  171A'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  171D'   DA 1732'              	JC	VP_IN
  1720'   EB                    	XCHG			; HL = the put point = LOGLEN
  1721'   7C                    	MOV	A,H
  1722'   B5                    	ORA	L
  1723'   CA 172F'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1726'   2B                    	DCX	H
  1727'   CD 0000*              	CALL	CHARAT
  172A'   FE 0A                 	CPI	LF
  172C'   CA 1732'              	JZ	VP_IN
  172F'                         VP_BRK:
  172F'   CD 12F2'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1732'                         VP_IN:
  1732'   CD 0000*              	CALL	CUROFF
  1735'   22 251C'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1738'   2A 0000*              	LHLD	QBEG
  173B'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  173C'   2A 0000*              	LHLD	QEND
  173F'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1742'   EB                    	XCHG
  1743'   22 251E'              	SHLD	PLFS
  1746'   2A 251A'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1749'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  174A'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  174B'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  174D'   C2 1751'              	JNZ	VP_PZ
  1750'   7D                    	MOV	A,L
  1751'                         VP_PZ:
  1751'   32 2520'              	STA	PCPY
  1754'                         VP_LP:
  1754'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1757'   2A 0000*              	LHLD	LNDLT
  175A'   EB                    	XCHG
  175B'   2A 251E'              	LHLD	PLFS
  175E'   19                    	DAD	D
  175F'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1762'   2A 251A'              	LHLD	PCNT
  1765'   2B                    	DCX	H
  1766'   22 251A'              	SHLD	PCNT
  1769'   7C                    	MOV	A,H
  176A'   B5                    	ORA	L
  176B'   C2 1754'              	JNZ	VP_LP
  176E'   CD 0188'              	CALL	MARKMOD
  1771'   2A 251C'              	LHLD	PPT
  1774'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1777'   CD 0839'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  177A'   3A 2520'              	LDA	PCPY
  177D'   B7                    	ORA	A
  177E'   CA 0794'              	JZ	FNBLNK
  1781'   2A 251E'              	LHLD	PLFS
  1784'   7C                    	MOV	A,H
  1785'   B7                    	ORA	A
  1786'   C2 0794'              	JNZ	FNBLNK
  1789'   3A 2520'              	LDA	PCPY
  178C'   CD 0D4C'              	CALL	MULSAT		; HL = the lines this put put, saturated
  178F'   7C                    	MOV	A,H
  1790'   B7                    	ORA	A
  1791'   C2 0794'              	JNZ	FNBLNK
  1794'   7D                    	MOV	A,L
  1795'   B7                    	ORA	A
  1796'   CA 0794'              	JZ	FNBLNK
  1799'   F5                    	PUSH	PSW
  179A'   CD 06D2'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  179D'   F1                    	POP	PSW
  179E'   32 24B4'              	STA	ILN		; ... which the lines put now replace
  17A1'   C3 0794'              	JMP	FNBLNK
  17A4'                         VP_BEL:
  17A4'   CD 0659'              	CALL	GETCNT		; the count is spent either way
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  17A7'   0E 07                 	MVI	C,BEL
  17A9'   CD 0000*              	CALL	BCONOU
  17AC'   C3 06C6'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  17AF'                         VIREP:
  17AF'   78                    	MOV	A,B
  17B0'   FE 01                 	CPI	KT_ACT
  17B2'   CA 18DF'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  17B5'   FE 02                 	CPI	KT_CHAR
  17B7'   C0                    	RNZ			; ignore anything else
  17B8'   79                    	MOV	A,C
  17B9'   FE 0D                 	CPI	CR
  17BB'   CA 181F'              	JZ	VP_CR
  17BE'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  17C0'   CA 181F'              	JZ	VP_CR
  17C3'   FE 08                 	CPI	BS
  17C5'   CA 182B'              	JZ	VP_BS
  17C8'   FE 7F                 	CPI	DEL
  17CA'   CA 182B'              	JZ	VP_BS
  17CD'   32 24F2'              	STA	VRCH		; the calls below do not preserve C
  17D0'   CD 06CC'              	CALL	SETLIN		; this row changed
  17D3'   CD 0188'              	CALL	MARKMOD
  17D6'   CD 12E5'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  17D9'   CA 1811'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  17DC'   3A 24F2'              	LDA	VRCH
  17DF'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  17E2'   2A 24F3'              	LHLD	RPDEL
  17E5'   7C                    	MOV	A,H
  17E6'   B5                    	ORA	L
  17E7'   CA 17FD'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  17EA'   2A 0000*              	LHLD	GAPEND
  17ED'   EB                    	XCHG
  17EE'   2A 24F7'              	LHLD	RPGE
  17F1'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  17F4'   CA 17FD'              	JZ	VP_OVW
  17F7'   21 0000               	LXI	H,0
  17FA'   22 24F3'              	SHLD	RPDEL		; the text moved: those originals are gone
  17FD'                         VP_OVW:
  17FD'   21 0001               	LXI	H,1
  1800'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1803'   2A 0000*              	LHLD	GAPEND
  1806'   22 24F7'              	SHLD	RPGE
  1809'   2A 24F3'              	LHLD	RPDEL
  180C'   23                    	INX	H
  180D'   22 24F3'              	SHLD	RPDEL
  1810'   C9                    	RET
  1811'                         VP_APP:
  1811'   3A 24F2'              	LDA	VRCH
  1814'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1817'   2A 24F5'              	LHLD	RPAPP
  181A'   23                    	INX	H
  181B'   22 24F5'              	SHLD	RPAPP
  181E'   C9                    	RET
  181F'                         VP_CR:
  181F'   21 0000               	LXI	H,0
  1822'   22 24F3'              	SHLD	RPDEL		; a line break ends what BS can put back
  1825'   22 24F5'              	SHLD	RPAPP
  1828'   C3 18B5'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  182B'                         VP_BS:
  182B'   2A 24F5'              	LHLD	RPAPP
  182E'   7C                    	MOV	A,H
  182F'   B5                    	ORA	L
  1830'   CA 183D'              	JZ	VP_BSD
  1833'   2B                    	DCX	H
  1834'   22 24F5'              	SHLD	RPAPP		; an appended char: it just goes
  1837'   CD 06CC'              	CALL	SETLIN
  183A'   C3 0000*              	JMP	DELPRV
  183D'                         VP_BSD:
  183D'   2A 24F3'              	LHLD	RPDEL
  1840'   7C                    	MOV	A,H
  1841'   B5                    	ORA	L
  1842'   CA 1869'              	JZ	VP_BSM		; nothing of ours left
  1845'   2A 0000*              	LHLD	GAPEND
  1848'   EB                    	XCHG
  1849'   2A 24F7'              	LHLD	RPGE
  184C'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  184F'   C2 1869'              	JNZ	VP_BSM
  1852'   2A 24F3'              	LHLD	RPDEL
  1855'   2B                    	DCX	H
  1856'   22 24F3'              	SHLD	RPDEL
  1859'   CD 06CC'              	CALL	SETLIN
  185C'   CD 0000*              	CALL	DELPRV		; the typed char goes
  185F'   CD 0000*              	CALL	UNDELF		; the original comes back
  1862'   2A 0000*              	LHLD	GAPEND
  1865'   22 24F7'              	SHLD	RPGE
  1868'   C9                    	RET
  1869'                         VP_BSM:
  1869'   CD 06C6'              	CALL	SETMOV		; nothing changed: back over the text as it is
  186C'   C3 0735'              	JMP	HSTEP
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  186F'                         VIINS:
  186F'   78                    	MOV	A,B
  1870'   FE 01                 	CPI	KT_ACT
  1872'   CA 18DF'              	JZ	VI_ACT
  1875'   FE 02                 	CPI	KT_CHAR
  1877'   C0                    	RNZ			; ignore anything else
  1878'   79                    	MOV	A,C
  1879'   FE 0D                 	CPI	CR
  187B'   CA 18B5'              	JZ	VI_CR
  187E'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1880'   CA 18B5'              	JZ	VI_CR
  1883'   FE 08                 	CPI	BS
  1885'   CA 18CD'              	JZ	VI_BS
  1888'   FE 7F                 	CPI	DEL
  188A'   CA 18CD'              	JZ	VI_BS
  188D'   79                    	MOV	A,C
  188E'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1891'   CD 0188'              	CALL	MARKMOD
  1894'   CD 06CC'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1897'   79                    	MOV	A,C
  1898'   FE 20                 	CPI	' '
  189A'   D8                    	RC			; control char -> keep R_LINE
  189B'   FE 7F                 	CPI	DEL
  189D'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  189E'   CD 06ED'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  18A1'   B7                    	ORA	A
  18A2'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  18A3'   3E 04                 	MVI	A,R_ICH
  18A5'   32 24B3'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  18A8'   CD 12E5'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  18AB'   3E 00                 	MVI	A,0
  18AD'   C2 18B1'              	JNZ	VI_ICH
  18B0'   3C                    	INR	A
  18B1'                         VI_ICH:
  18B1'   32 24B5'              	STA	ICHAPP
  18B4'   C9                    	RET
  18B5'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  18B5'   CD 12E5'              	CALL	ATCEND
  18B8'   3E 00                 	MVI	A,0
  18BA'   CA 18BE'              	JZ	VI_CRS
  18BD'   3C                    	INR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  18BE'                         VI_CRS:
  18BE'   F5                    	PUSH	PSW
  18BF'   CD 12F2'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  18C2'   CD 1306'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  18C5'   CD 06D2'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  18C8'   F1                    	POP	PSW
  18C9'   32 24B6'              	STA	ILABOV
  18CC'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  18CD'                         VI_BS:
  18CD'   CD 0000*              	CALL	PEEKL
  18D0'   D8                    	RC			; start of the file: nothing to delete
  18D1'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  18D3'   CA 18D9'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  18D6'   CD 06CC'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  18D9'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  18D9'   CD 0188'              	CALL	MARKMOD
  18DC'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  18DF'                         VI_ACT:
  18DF'   79                    	MOV	A,C
  18E0'   FE 0B                 	CPI	ACT_ESC
  18E2'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  18E3'   3E 00                 	MVI	A,EM_CMD
  18E5'   32 24AE'              	STA	EDMODE
  18E8'   CD 06C6'              	CALL	SETMOV
  18EB'   CD 0735'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  18EE'   C3 0839'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  18F1'                         RDLINE:
  18F1'   EB                    	XCHG			; HL = buffer
  18F2'   22 24F9'              	SHLD	RLPTR
  18F5'   3E 00                 	MVI	A,0
  18F7'   32 24FB'              	STA	RLLEN
  18FA'   78                    	MOV	A,B
  18FB'   32 24FC'              	STA	RLMAX
  18FE'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  18FF'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1902'                         RL_LP:
  1902'   CD 0000*              	CALL	GETKEY
  1905'   78                    	MOV	A,B
  1906'   FE 01                 	CPI	KT_ACT
  1908'   CA 195E'              	JZ	RL_ACT
  190B'   FE 02                 	CPI	KT_CHAR
  190D'   C2 1902'              	JNZ	RL_LP		; ignore other keys
  1910'   79                    	MOV	A,C
  1911'   FE 0D                 	CPI	CR
  1913'   CA 196F'              	JZ	RL_DONE
  1916'   FE 08                 	CPI	BS
  1918'   CA 1946'              	JZ	RL_BS
  191B'   FE 7F                 	CPI	DEL
  191D'   CA 1946'              	JZ	RL_BS
  1920'   FE 20                 	CPI	' '
  1922'   DA 1902'              	JC	RL_LP		; control char -> ignore
  1925'   3A 24FB'              	LDA	RLLEN
  1928'   47                    	MOV	B,A
  1929'   3A 24FC'              	LDA	RLMAX
  192C'   B8                    	CMP	B
  192D'   CA 1902'              	JZ	RL_LP		; full -> ignore
  1930'   2A 24F9'              	LHLD	RLPTR
  1933'   71                    	MOV	M,C
  1934'   23                    	INX	H
  1935'   22 24F9'              	SHLD	RLPTR
  1938'   3A 24FB'              	LDA	RLLEN
  193B'   3C                    	INR	A
  193C'   32 24FB'              	STA	RLLEN
  193F'   79                    	MOV	A,C
  1940'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1943'   C3 1902'              	JMP	RL_LP
  1946'                         RL_BS:				; WM LINEPOP
  1946'   3A 24FB'              	LDA	RLLEN
  1949'   B7                    	ORA	A
  194A'   CA 1964'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  194D'   3D                    	DCR	A
  194E'   32 24FB'              	STA	RLLEN
  1951'   2A 24F9'              	LHLD	RLPTR
  1954'   2B                    	DCX	H
  1955'   22 24F9'              	SHLD	RLPTR
  1958'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  195B'   C3 1902'              	JMP	RL_LP
  195E'                         RL_ACT:
  195E'   79                    	MOV	A,C
  195F'   FE 0B                 	CPI	ACT_ESC
  1961'   C2 1902'              	JNZ	RL_LP
  1964'                         RL_CAN:
  1964'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1966'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1969'   CD 06CC'              	CALL	SETLIN		; redraw one row
  196C'   3E FF                 	MVI	A,0FFH		; cancelled
  196E'   C9                    	RET
  196F'                         RL_DONE:
  196F'   AF                    	XRA	A
  1970'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1971'                         VC_BZ:
  1971'   CD 06C6'              	CALL	SETMOV
  1974'   3A 24D7'              	LDA	GSAVE
  1977'   FE 02                 	CPI	PZ
  1979'   CA 1984'              	JZ	VZ_ZZ
  197C'   B7                    	ORA	A
  197D'   C0                    	RNZ			; 'g' was pending: vim drops both
  197E'   3E 02                 	MVI	A,PZ
  1980'   32 24D6'              	STA	GPEND
  1983'   C9                    	RET
  1984'                         VZ_ZZ:
  1984'   3E 04                 	MVI	A,EO_X
  1986'   32 24FD'              	STA	EXOP
  1989'   3E 01                 	MVI	A,1
  198B'   32 2510'              	STA	EXBANG		; no '!'
  198E'   AF                    	XRA	A
  198F'   32 24FE'              	STA	EXARG		; no file name
  1992'   3A 24B2'              	LDA	MODF		; as ':x': a changed text is written first
  1995'   B7                    	ORA	A
  1996'   CA 1AB9'              	JZ	EX_Q
  1999'   C3 1A53'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  199C'                         VC_EX:
  199C'   CD 0659'              	CALL	GETCNT
  199F'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  19A2'   11 0000*              	LXI	D,EXBUF
  19A5'   06 28                 	MVI	B,EXMAX
  19A7'   0E 3A                 	MVI	C,':'
  19A9'   CD 18F1'              	CALL	RDLINE
  19AC'   B7                    	ORA	A
  19AD'   C0                    	RNZ			; cancelled
  19AE'   3A 24FB'              	LDA	RLLEN
  19B1'   5F                    	MOV	E,A
  19B2'   16 00                 	MVI	D,0
  19B4'   21 0000*              	LXI	H,EXBUF
  19B7'   19                    	DAD	D
  19B8'   36 00                 	MVI	M,0		; the line ends with a 0
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  19BA'   21 0000*              	LXI	H,EXBUF
  19BD'   CD 1D55'              	CALL	SKIPB
  19C0'   C8                    	RZ			; nothing on it
  19C1'   22 2500'              	SHLD	EXCMD
  19C4'   CD 1EFF'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  19C7'   CD 1D55'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  19CA'   56                    	MOV	D,M
  19CB'   23                    	INX	H
  19CC'   1E 00                 	MVI	E,0
  19CE'   CD 1D61'              	CALL	ISLOW
  19D1'   DA 19DC'              	JC	EX_LK
  19D4'   5F                    	MOV	E,A
  19D5'   23                    	INX	H
  19D6'   CD 1D61'              	CALL	ISLOW
  19D9'   D2 19F5'              	JNC	EX_NOT		; a third letter: none of ours
  19DC'                         EX_LK:
  19DC'   E5                    	PUSH	H
  19DD'   21 1EE9'              	LXI	H,EXTAB
  19E0'                         EX_TL:
  19E0'   7E                    	MOV	A,M
  19E1'   B7                    	ORA	A
  19E2'   CA 19F4'              	JZ	EX_NTP		; not in the table
  19E5'   23                    	INX	H
  19E6'   BA                    	CMP	D
  19E7'   7E                    	MOV	A,M
  19E8'   23                    	INX	H
  19E9'   C2 19F0'              	JNZ	EX_TN
  19EC'   BB                    	CMP	E
  19ED'   CA 19FB'              	JZ	EX_TF
  19F0'                         EX_TN:
  19F0'   23                    	INX	H
  19F1'   C3 19E0'              	JMP	EX_TL
  19F4'                         EX_NTP:
  19F4'   E1                    	POP	H
  19F5'                         EX_NOT:
  19F5'   21 1E19'              	LXI	H,SNOT
  19F8'   C3 1D96'              	JMP	EXERT
  19FB'                         EX_TF:
  19FB'   7E                    	MOV	A,M
  19FC'   32 24FD'              	STA	EXOP
  19FF'   E1                    	POP	H
  1A00'   FE 06                 	CPI	EO_S
  1A02'   CA 1F6E'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1A05'   3A 2554'              	LDA	SRNGF
  1A08'   B7                    	ORA	A
  1A09'   C2 19F5'              	JNZ	EX_NOT		; a range on a command that does not take one
                                	;--- '!', then the file name ---
  1A0C'   7E                    	MOV	A,M
  1A0D'   D6 21                 	SUI	'!'
  1A0F'   32 2510'              	STA	EXBANG		; 0 = '!'
  1A12'   C2 1A16'              	JNZ	EX_NB
  1A15'   23                    	INX	H
  1A16'                         EX_NB:
  1A16'   CD 1D55'              	CALL	SKIPB
  1A19'   32 24FE'              	STA	EXARG		; 0 = no file name
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A1C'   CA 1A35'              	JZ	EX_RUN
  1A1F'   22 2500'              	SHLD	EXCMD
  1A22'   3A 24FD'              	LDA	EXOP
  1A25'   FE 02                 	CPI	EO_Q
  1A27'   CA 1D93'              	JZ	EX_TRL		; :q takes none
  1A2A'   FE 07                 	CPI	EO_V
  1A2C'   CA 1D93'              	JZ	EX_TRL		; nor :ve
  1A2F'   CD 1CBF'              	CALL	PARSFN
  1A32'   C2 1D87'              	JNZ	EX_INV
  1A35'                         EX_RUN:
  1A35'   3A 24FD'              	LDA	EXOP
  1A38'   FE 05                 	CPI	EO_E
  1A3A'   CA 1AD0'              	JZ	EX_E
  1A3D'   FE 02                 	CPI	EO_Q
  1A3F'   CA 1AB9'              	JZ	EX_Q
  1A42'   FE 07                 	CPI	EO_V
  1A44'   CA 1D8D'              	JZ	EX_V
  1A47'   FE 04                 	CPI	EO_X
  1A49'   C2 1A53'              	JNZ	EX_W
  1A4C'   3A 24B2'              	LDA	MODF		; :x writes only a changed text
  1A4F'   B7                    	ORA	A
  1A50'   CA 1AB9'              	JZ	EX_Q
  1A53'                         EX_W:
  1A53'   CD 1B27'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1A56'   D8                    	RC			; refused (message shown)
  1A57'   32 24FF'              	STA	EXBAK
  1A5A'   3A 24FD'              	LDA	EXOP
  1A5D'   FE 01                 	CPI	EO_W
  1A5F'   CA 1A76'              	JZ	EX_WK
  1A62'   3A 24FF'              	LDA	EXBAK
  1A65'   B7                    	ORA	A
  1A66'   C2 1AB6'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1A69'   3A 2510'              	LDA	EXBANG
  1A6C'   B7                    	ORA	A
  1A6D'   CA 1AB6'              	JZ	EX_WQ		; so it does with '!'
  1A70'   CD 1A76'              	CALL	EX_WK		; else it may not: keep the text
  1A73'   C3 1AB9'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1A76'                         EX_WK:
  1A76'   CD 0C58'              	CALL	CURRW		; the cursor's row and file position
  1A79'   32 2502'              	STA	WPROW
  1A7C'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1A7F'   7D                    	MOV	A,L
  1A80'   E6 7F                 	ANI	7FH
  1A82'   32 2503'              	STA	WPBYT
  1A85'   7D                    	MOV	A,L
  1A86'   17                    	RAL
  1A87'   7C                    	MOV	A,H
  1A88'   17                    	RAL
  1A89'   5F                    	MOV	E,A
  1A8A'   3E 00                 	MVI	A,0
  1A8C'   17                    	RAL
  1A8D'   57                    	MOV	D,A		; DE = HL / 128
  1A8E'   2A 0000*              	LHLD	OUTPOS
  1A91'   19                    	DAD	D
  1A92'   22 2504'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1A95'   CD 1B5C'              	CALL	WRITE
  1A98'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1A9B'   2A 2504'              	LHLD	WPREC
  1A9E'   EB                    	XCHG
  1A9F'   3A 2503'              	LDA	WPBYT
  1AA2'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1AA5'   CD 0000*              	CALL	GOTO
  1AA8'   21 0000               	LXI	H,0
  1AAB'   22 0000*              	SHLD	LNDLT
  1AAE'   3A 2502'              	LDA	WPROW
  1AB1'   6F                    	MOV	L,A
  1AB2'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1AB5'   C9                    	RET
  1AB6'                         EX_WQ:
  1AB6'   CD 1B5C'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1AB9'                         EX_Q:
  1AB9'   3A 2510'              	LDA	EXBANG
  1ABC'   B7                    	ORA	A
  1ABD'   CA 1AC7'              	JZ	EX_QT
  1AC0'   3A 24B2'              	LDA	MODF
  1AC3'   B7                    	ORA	A
  1AC4'   C2 1D7B'              	JNZ	MSGNWR		; changed, no '!': stay
  1AC7'                         EX_QT:
  1AC7'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1ACA'   3E 01                 	MVI	A,1
  1ACC'   32 24B1'              	STA	QUITF
  1ACF'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1AD0'                         EX_E:
  1AD0'   3A 2510'              	LDA	EXBANG
  1AD3'   B7                    	ORA	A
  1AD4'   CA 1ADE'              	JZ	EE_GO
  1AD7'   3A 24B2'              	LDA	MODF
  1ADA'   B7                    	ORA	A
  1ADB'   C2 1D7B'              	JNZ	MSGNWR
  1ADE'                         EE_GO:
  1ADE'   3A 24FE'              	LDA	EXARG
  1AE1'   B7                    	ORA	A
  1AE2'   C2 1AE9'              	JNZ	EE_ARG
  1AE5'   CD 1B98'              	CALL	OWNTF		; no name: the buffer's own
  1AE8'   D8                    	RC
  1AE9'                         EE_ARG:
  1AE9'   CD 1BAE'              	CALL	ISOWN
  1AEC'   21 0001               	LXI	H,1
  1AEF'   C2 1AF6'              	JNZ	EE_LD		; another file: its first line
  1AF2'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1AF5'   23                    	INX	H		; HL = the cursor's line
  1AF6'                         EE_LD:
  1AF6'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1AF8'   32 250E'              	STA	MSGWHT
  1AFB'   E5                    	PUSH	H
  1AFC'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1AFF'   21 0000*              	LXI	H,TFCB
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1B02'   11 0000*              	LXI	D,FNAME
  1B05'   CD 1BC0'              	CALL	COPY12		; the buffer's name
  1B08'   CD 1B85'              	CALL	SRCTF
  1B0B'   CD 0000*              	CALL	REOPEN
  1B0E'   CD 020B'              	CALL	MKCLR		; the marks named the buffer that just went
  1B11'   AF                    	XRA	A
  1B12'   32 24B2'              	STA	MODF
  1B15'   E1                    	POP	H
  1B16'   2B                    	DCX	H
  1B17'   AF                    	XRA	A
  1B18'   CD 0000*              	CALL	MVLIND		; down to the line
  1B1B'   CD 0970'              	CALL	ATEOF
  1B1E'   DC 0976'              	CC	LASTLN		; past the last line: onto it
  1B21'   CD 0E84'              	CALL	ZSAVE
  1B24'   C3 0F67'              	JMP	GP_MID
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  1B27'                         WRCHK:
  1B27'   3A 24FE'              	LDA	EXARG
  1B2A'   B7                    	ORA	A
  1B2B'   C2 1B35'              	JNZ	WC_ARG
  1B2E'   CD 1B98'              	CALL	OWNTF
  1B31'   D8                    	RC
  1B32'   C3 1B4A'              	JMP	WC_OWN
  1B35'                         WC_ARG:
  1B35'   CD 1BAE'              	CALL	ISOWN
  1B38'   CA 1B4A'              	JZ	WC_OWN
  1B3B'   3A 2510'              	LDA	EXBANG
  1B3E'   B7                    	ORA	A
  1B3F'   CA 1B48'              	JZ	WC_OTH
  1B42'   CD 0000*              	CALL	TEXIST
  1B45'   C2 1D6F'              	JNZ	MSGEXI		; File exists (! to force)
  1B48'                         WC_OTH:
  1B48'   AF                    	XRA	A		; (NC)
  1B49'   C9                    	RET
  1B4A'                         WC_OWN:
  1B4A'   3A 2511'              	LDA	ROFLAG		; '-R': this is the file it may not write
  1B4D'   B7                    	ORA	A
  1B4E'   CA 1B58'              	JZ	WC_OK
  1B51'   3A 2510'              	LDA	EXBANG
  1B54'   B7                    	ORA	A
  1B55'   C2 1D75'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  1B58'                         WC_OK:
  1B58'   3E 01                 	MVI	A,1
  1B5A'   B7                    	ORA	A		; (NC)
  1B5B'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  1B5C'                         WRITE:
  1B5C'   3A 24FF'              	LDA	EXBAK
  1B5F'   CD 0000*              	CALL	WRTO
  1B62'   3A 0001*              	LDA	FNAME+1
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1B65'   FE 20                 	CPI	' '
  1B67'   C2 1B73'              	JNZ	WR_HAS
  1B6A'   21 0000*              	LXI	H,TFCB
  1B6D'   11 0000*              	LXI	D,FNAME
  1B70'   CD 1BC0'              	CALL	COPY12
  1B73'                         WR_HAS:
  1B73'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  1B75'   32 250E'              	STA	MSGWHT
  1B78'   CD 1BAE'              	CALL	ISOWN
  1B7B'   C2 1B85'              	JNZ	SRCTF
  1B7E'   AF                    	XRA	A
  1B7F'   32 24B2'              	STA	MODF
  1B82'   32 250F'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  1B85'                         SRCTF:
  1B85'   21 0000*              	LXI	H,TFCB
  1B88'   11 005C               	LXI	D,DFTFCB
  1B8B'   CD 1BC0'              	CALL	COPY12
  1B8E'   AF                    	XRA	A
  1B8F'   06 04                 	MVI	B,4
  1B91'                         SRC_Z:
  1B91'   12                    	STAX	D		; extent, s1, s2, record count: 0
  1B92'   13                    	INX	D
  1B93'   05                    	DCR	B
  1B94'   C2 1B91'              	JNZ	SRC_Z
  1B97'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  1B98'                         OWNTF:
  1B98'   3A 0001*              	LDA	FNAME+1
  1B9B'   FE 20                 	CPI	' '
  1B9D'   CA 1D69'              	JZ	MSGNFN
  1BA0'   CD 1BCB'              	CALL	TFCLR
  1BA3'   21 0000*              	LXI	H,FNAME
  1BA6'   11 0000*              	LXI	D,TFCB
  1BA9'   CD 1BC0'              	CALL	COPY12
  1BAC'   B7                    	ORA	A		; (NC)
  1BAD'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  1BAE'                         ISOWN:
  1BAE'   21 0000*              	LXI	H,TFCB
  1BB1'   11 0000*              	LXI	D,FNAME
  1BB4'   06 0C                 	MVI	B,12
  1BB6'                         IO_LP:
  1BB6'   1A                    	LDAX	D
  1BB7'   BE                    	CMP	M
  1BB8'   C0                    	RNZ
  1BB9'   23                    	INX	H
  1BBA'   13                    	INX	D
  1BBB'   05                    	DCR	B
  1BBC'   C2 1BB6'              	JNZ	IO_LP
  1BBF'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  1BC0'                         COPY12:
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1BC0'   06 0C                 	MVI	B,12
  1BC2'                         CP_LP:
  1BC2'   7E                    	MOV	A,M
  1BC3'   12                    	STAX	D
  1BC4'   23                    	INX	H
  1BC5'   13                    	INX	D
  1BC6'   05                    	DCR	B
  1BC7'   C2 1BC2'              	JNZ	CP_LP
  1BCA'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  1BCB'                         TFCLR:
  1BCB'   11 0000*              	LXI	D,TFCB
  1BCE'   06 24                 	MVI	B,36
  1BD0'   AF                    	XRA	A
  1BD1'                         TC_LP:
  1BD1'   12                    	STAX	D
  1BD2'   13                    	INX	D
  1BD3'   05                    	DCR	B
  1BD4'   C2 1BD1'              	JNZ	TC_LP
  1BD7'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  1BD8'                         FOPEN:
  1BD8'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  1BDA'   32 250E'              	STA	MSGWHT
  1BDD'   21 005C               	LXI	H,DFTFCB
  1BE0'   CD 1CB2'              	CALL	NRMDRV
  1BE3'   11 0000*              	LXI	D,FNAME
  1BE6'   CD 1BC0'              	CALL	COPY12
  1BE9'   CD 0000*              	CALL	OPENZ
  1BEC'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  1BEF'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  1BF1'   C8                    	RZ
  1BF2'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  1BF5'   32 250F'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  1BF8'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  1BF9'                         ARGSCN:
  1BF9'   3A 0080               	LDA	CMDTAIL
  1BFC'   47                    	MOV	B,A		; B = what is left of the line
  1BFD'   B7                    	ORA	A
  1BFE'   C8                    	RZ
  1BFF'   21 0081               	LXI	H,CMDTAIL+1
  1C02'                         AS_TOK:				; at a token, or the blanks before one
  1C02'   7E                    	MOV	A,M
  1C03'   FE 20                 	CPI	' '
  1C05'   C2 1C0E'              	JNZ	AS_OPT
  1C08'   23                    	INX	H
  1C09'   05                    	DCR	B
  1C0A'   C2 1C02'              	JNZ	AS_TOK
  1C0D'   C9                    	RET
  1C0E'                         AS_OPT:
  1C0E'   FE 2B                 	CPI	'+'
  1C10'   CA 1C3A'              	JZ	AS_PLS
  1C13'   FE 2D                 	CPI	'-'
  1C15'   CA 1C29'              	JZ	AS_SW
  1C18'   FE 2F                 	CPI	'/'
  1C1A'   CA 1C29'              	JZ	AS_SW
  1C1D'                         AS_SKP:				; not ours (the file name): on to the next one
  1C1D'   23                    	INX	H
  1C1E'   05                    	DCR	B
  1C1F'   C8                    	RZ
  1C20'   7E                    	MOV	A,M
  1C21'   FE 20                 	CPI	' '
  1C23'   C2 1C1D'              	JNZ	AS_SKP
  1C26'   C3 1C02'              	JMP	AS_TOK
  1C29'                         AS_SW:
  1C29'   23                    	INX	H
  1C2A'   05                    	DCR	B
  1C2B'   C8                    	RZ
  1C2C'   7E                    	MOV	A,M
  1C2D'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  1C2F'   FE 52                 	CPI	'R'
  1C31'   C2 1C1D'              	JNZ	AS_SKP
  1C34'   32 2511'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  1C37'   C3 1C1D'              	JMP	AS_SKP
  1C3A'                         AS_PLS:
  1C3A'   3E 01                 	MVI	A,1
  1C3C'   32 2512'              	STA	PLUSF		; '+' gets the line even with no number on it
  1C3F'   11 0000*              	LXI	D,PLUSB
  1C42'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  1C44'   23                    	INX	H		;   line space, so it is taken as '+' alone
  1C45'   05                    	DCR	B
  1C46'   CA 1C7D'              	JZ	AS_PE
  1C49'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1C4A'   FE 30                 	CPI	'0'
  1C4C'   C2 1C64'              	JNZ	AS_PD
  1C4F'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  1C4F'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  1C50'   05                    	DCR	B
  1C51'   CA 1C85'              	JZ	AS_P1
  1C54'   7E                    	MOV	A,M
  1C55'   FE 30                 	CPI	'0'
  1C57'   CA 1C4F'              	JZ	AS_PZ
  1C5A'   FE 31                 	CPI	'1'
  1C5C'   DA 1C85'              	JC	AS_P1		; zeros and then no digit at all: line 1
  1C5F'   FE 3A                 	CPI	'9'+1
  1C61'   D2 1C85'              	JNC	AS_P1
  1C64'                         AS_PD:				; the digits, as typed
  1C64'   7E                    	MOV	A,M
  1C65'   FE 30                 	CPI	'0'
  1C67'   DA 1C7D'              	JC	AS_PE
  1C6A'   FE 3A                 	CPI	'9'+1
  1C6C'   D2 1C7D'              	JNC	AS_PE
  1C6F'   79                    	MOV	A,C
  1C70'   B7                    	ORA	A
  1C71'   CA 1C8C'              	JZ	AS_POV
  1C74'   0D                    	DCR	C
  1C75'   7E                    	MOV	A,M
  1C76'   12                    	STAX	D
  1C77'   13                    	INX	D
  1C78'   23                    	INX	H
  1C79'   05                    	DCR	B
  1C7A'   C2 1C64'              	JNZ	AS_PD
  1C7D'                         AS_PE:
  1C7D'   AF                    	XRA	A
  1C7E'   12                    	STAX	D		; the digits end with a 0
  1C7F'   78                    	MOV	A,B
  1C80'   B7                    	ORA	A
  1C81'   C8                    	RZ
  1C82'   C3 1C02'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  1C85'                         AS_P1:
  1C85'   3E 31                 	MVI	A,'1'
  1C87'   12                    	STAX	D
  1C88'   13                    	INX	D
  1C89'   C3 1C7D'              	JMP	AS_PE
  1C8C'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  1C8C'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  1C8F'   C3 1C7D'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  1C92'                         ARGGO:
  1C92'   3A 2512'              	LDA	PLUSF
  1C95'   B7                    	ORA	A
  1C96'   C8                    	RZ
  1C97'   21 0000*              	LXI	H,PLUSB
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1C9A'                         AG_LP:
  1C9A'   7E                    	MOV	A,M
  1C9B'   B7                    	ORA	A
  1C9C'   CA 1CAB'              	JZ	AG_G
  1C9F'   4F                    	MOV	C,A
  1CA0'   06 02                 	MVI	B,KT_CHAR
  1CA2'   E5                    	PUSH	H
  1CA3'   CD 001F'              	CALL	VICMD
  1CA6'   E1                    	POP	H
  1CA7'   23                    	INX	H
  1CA8'   C3 1C9A'              	JMP	AG_LP
  1CAB'                         AG_G:
  1CAB'   0E 47                 	MVI	C,'G'
  1CAD'   06 02                 	MVI	B,KT_CHAR
  1CAF'   C3 001F'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  1CB2'                         NRMDRV:
  1CB2'   7E                    	MOV	A,M
  1CB3'   B7                    	ORA	A
  1CB4'   C0                    	RNZ
  1CB5'   E5                    	PUSH	H
  1CB6'   0E 19                 	MVI	C,BF_CURDSK
  1CB8'   CD 0005               	CALL	BDOS
  1CBB'   E1                    	POP	H
  1CBC'   3C                    	INR	A
  1CBD'   77                    	MOV	M,A
  1CBE'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  1CBF'                         PARSFN:
  1CBF'   CD 1BCB'              	CALL	TFCLR
  1CC2'   11 0000*              	LXI	D,TFCB
  1CC5'   23                    	INX	H
  1CC6'   7E                    	MOV	A,M
  1CC7'   2B                    	DCX	H
  1CC8'   FE 3A                 	CPI	':'
  1CCA'   C2 1CDC'              	JNZ	PF_NM
  1CCD'   CD 1D22'              	CALL	GETFNC
  1CD0'   CA 1CDC'              	JZ	PF_NM
  1CD3'   D6 40                 	SUI	40H
  1CD5'   12                    	STAX	D
  1CD6'   FE 11                 	CPI	17
  1CD8'   D2 1D00'              	JNC	PF_BAD
  1CDB'   23                    	INX	H
  1CDC'                         PF_NM:
  1CDC'   13                    	INX	D
  1CDD'   0E 08                 	MVI	C,8
  1CDF'   CD 1D04'              	CALL	CPYNAM
  1CE2'   FE 2E                 	CPI	'.'
  1CE4'   0E 03                 	MVI	C,3
  1CE6'   C4 1D17'              	CNZ	PADFLD		; no type: blanks
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1CE9'   CC 1D03'              	CZ	CPYNM0		; '.': the type
  1CEC'   3A 0001*              	LDA	TFCB+1
  1CEF'   FE 20                 	CPI	' '
  1CF1'   CA 1D00'              	JZ	PF_BAD		; no name
  1CF4'   CD 1D55'              	CALL	SKIPB
  1CF7'   C0                    	RNZ			; more after it
  1CF8'   21 0000*              	LXI	H,TFCB
  1CFB'   CD 1CB2'              	CALL	NRMDRV
  1CFE'   AF                    	XRA	A
  1CFF'   C9                    	RET
  1D00'                         PF_BAD:
  1D00'   F6 01                 	ORI	1
  1D02'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  1D03'                         CPYNM0:
  1D03'   23                    	INX	H
  1D04'                         CPYNAM:
  1D04'   CD 1D22'              	CALL	GETFNC
  1D07'   CA 1D17'              	JZ	PADFLD
  1D0A'   12                    	STAX	D
  1D0B'   13                    	INX	D
  1D0C'   0D                    	DCR	C
  1D0D'   C2 1D04'              	JNZ	CPYNAM
  1D10'                         CN_SKP:
  1D10'   CD 1D22'              	CALL	GETFNC
  1D13'   C2 1D10'              	JNZ	CN_SKP
  1D16'   C9                    	RET
  1D17'                         PADFLD:
  1D17'   F5                    	PUSH	PSW
  1D18'                         PD_LP:
  1D18'   3E 20                 	MVI	A,' '
  1D1A'   12                    	STAX	D
  1D1B'   13                    	INX	D
  1D1C'   0D                    	DCR	C
  1D1D'   C2 1D18'              	JNZ	PD_LP
  1D20'   F1                    	POP	PSW
  1D21'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  1D22'                         GETFNC:
  1D22'   7E                    	MOV	A,M
  1D23'   FE 3D                 	CPI	'='
  1D25'   C8                    	RZ
  1D26'   FE 5F                 	CPI	'_'
  1D28'   C8                    	RZ
  1D29'   FE 3B                 	CPI	';'
  1D2B'   C8                    	RZ
  1D2C'   FE 3C                 	CPI	'<'
  1D2E'   C8                    	RZ
  1D2F'   FE 3E                 	CPI	'>'
  1D31'   C8                    	RZ
  1D32'   FE 2E                 	CPI	'.'
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1D34'   C8                    	RZ
  1D35'   FE 3A                 	CPI	':'
  1D37'   C8                    	RZ
  1D38'   FE 2A                 	CPI	'*'
  1D3A'   C8                    	RZ
  1D3B'   FE 3F                 	CPI	'?'
  1D3D'   C8                    	RZ
  1D3E'   FE 20                 	CPI	' '
  1D40'   DA 1D53'              	JC	GF_CTL
  1D43'   C8                    	RZ
  1D44'   23                    	INX	H
  1D45'   FE 61                 	CPI	'a'
  1D47'   DA 1D51'              	JC	GF_DN
  1D4A'   FE 7B                 	CPI	'z'+1
  1D4C'   D2 1D51'              	JNC	GF_DN
  1D4F'   E6 DF                 	ANI	0DFH
  1D51'                         GF_DN:
  1D51'   B7                    	ORA	A
  1D52'   C9                    	RET
  1D53'                         GF_CTL:
  1D53'   BF                    	CMP	A
  1D54'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  1D55'                         SKIPB:
  1D55'   7E                    	MOV	A,M
  1D56'   FE 20                 	CPI	' '
  1D58'   C2 1D5F'              	JNZ	SB_DN
  1D5B'   23                    	INX	H
  1D5C'   C3 1D55'              	JMP	SKIPB
  1D5F'                         SB_DN:
  1D5F'   B7                    	ORA	A
  1D60'   C9                    	RET
                                
                                ;ISLOW -- A = the char at HL; NC iff a-z.
  1D61'                         ISLOW:
  1D61'   7E                    	MOV	A,M
  1D62'   FE 61                 	CPI	'a'
  1D64'   D8                    	RC
  1D65'   FE 7B                 	CPI	'z'+1
  1D67'   3F                    	CMC
  1D68'   C9                    	RET
                                
                                ;--- ex messages (vim's, without the Enn number) ---
  1D69'                         MSGNFN:
  1D69'   21 1DB6'              	LXI	H,SNFN
  1D6C'   C3 1DA1'              	JMP	EXERR
  1D6F'                         MSGEXI:
  1D6F'   21 1DD0'              	LXI	H,SEXI
  1D72'   C3 1D7E'              	JMP	EXBNG
  1D75'                         MSGRO:
  1D75'   21 1DDC'              	LXI	H,SRO
  1D78'   C3 1D7E'              	JMP	EXBNG
  1D7B'                         MSGNWR:
  1D7B'   21 1DC3'              	LXI	H,SNWR
  1D7E'                         EXBNG:
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1D7E'   CD 1DA1'              	CALL	EXERR
  1D81'   21 1DE8'              	LXI	H,SBNG
  1D84'   C3 1D9C'              	JMP	EXOUT
  1D87'                         EX_INV:
  1D87'   21 1DF6'              	LXI	H,SINV
  1D8A'   C3 1DA1'              	JMP	EXERR
  1D8D'                         EX_V:				; :ve -- the version, on the bottom row
  1D8D'   21 1DB1'              	LXI	H,SVER
  1D90'   C3 1DA1'              	JMP	EXERR
  1D93'                         EX_TRL:
  1D93'   21 1E08'              	LXI	H,STRL
  1D96'                         EXERT:				; the message, then the text at EXCMD
  1D96'   CD 1DA1'              	CALL	EXERR
  1D99'   2A 2500'              	LHLD	EXCMD
  1D9C'                         EXOUT:
  1D9C'   CD 0000*              	CALL	OUTSTR
  1D9F'   37                    	STC
  1DA0'   C9                    	RET
                                ;EXERR -- HL = a message for the bottom row; it stays there (only the cursor
                                ; goes back), CY.
  1DA1'                         EXERR:
  1DA1'   E5                    	PUSH	H
  1DA2'   AF                    	XRA	A		; an error outranks whatever this key meant to
  1DA3'   32 250E'              	STA	MSGWHT		;   say: ':wq NAME' writes, then refuses to quit
  1DA6'   E1                    	POP	H
  1DA7'   CD 0000*              	CALL	EXMSG
  1DAA'   3E 01                 	MVI	A,R_MOVE
  1DAC'   32 24B3'              	STA	RINTENT
  1DAF'   37                    	STC
  1DB0'   C9                    	RET
                                
