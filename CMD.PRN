  29EE'   72 00 08              	DB	'r',0,EO_R
  29F1'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
	MACRO-80 3.44	09-Dec-81	PAGE	1-129


                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- are cut from BUF.MAC:
                                ; RDLINE drops control characters, so no pattern could ever hold one.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
	MACRO-80 3.44	09-Dec-81	PAGE	1-130


                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  29F2'                         EXADDR:
  29F2'   AF                    	XRA	A
  29F3'   32 0000*              	STA	SRNGF
  29F6'   7E                    	MOV	A,M
  29F7'   FE 25                 	CPI	'%'
  29F9'   CA 2A22'              	JZ	EXA_AL
  29FC'   EB                    	XCHG			; DE walks the line, HL takes the number
  29FD'   CD 2A37'              	CALL	EXNUM
  2A00'   DA 2A20'              	JC	EXA_NO
  2A03'   22 0000*              	SHLD	SRNG1
  2A06'   22 0000*              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  2A09'   1A                    	LDAX	D
  2A0A'   FE 2C                 	CPI	','
  2A0C'   C2 2A19'              	JNZ	EXA_YS
  2A0F'   13                    	INX	D
  2A10'   CD 2A37'              	CALL	EXNUM
  2A13'   DA 2A20'              	JC	EXA_NO		; ',' with no number: not a range at all
  2A16'   22 0000*              	SHLD	SRNG2
  2A19'                         EXA_YS:
  2A19'   EB                    	XCHG
  2A1A'   3E 01                 	MVI	A,1
  2A1C'   32 0000*              	STA	SRNGF
  2A1F'   C9                    	RET
  2A20'                         EXA_NO:
  2A20'   EB                    	XCHG
  2A21'   C9                    	RET
  2A22'                         EXA_AL:
  2A22'   23                    	INX	H
  2A23'   E5                    	PUSH	H
  2A24'   21 0001               	LXI	H,1
  2A27'   22 0000*              	SHLD	SRNG1
  2A2A'   21 FFFF               	LXI	H,0FFFFH
  2A2D'   22 0000*              	SHLD	SRNG2
  2A30'   E1                    	POP	H
  2A31'   3E 01                 	MVI	A,1
  2A33'   32 0000*              	STA	SRNGF
  2A36'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  2A37'                         EXNUM:
  2A37'   1A                    	LDAX	D
  2A38'   D6 30                 	SUI	'0'
  2A3A'   D8                    	RC
  2A3B'   FE 0A                 	CPI	10
  2A3D'   3F                    	CMC
  2A3E'   D8                    	RC
  2A3F'   21 0000               	LXI	H,0
  2A42'                         EXN_LP:
  2A42'   1A                    	LDAX	D
  2A43'   D6 30                 	SUI	'0'
  2A45'   DA 2A5F'              	JC	EXN_DN
  2A48'   FE 0A                 	CPI	10
	MACRO-80 3.44	09-Dec-81	PAGE	1-131


  2A4A'   D2 2A5F'              	JNC	EXN_DN
  2A4D'   13                    	INX	D
  2A4E'   C5                    	PUSH	B
  2A4F'   4F                    	MOV	C,A
  2A50'   06 00                 	MVI	B,0		; BC = the digit
  2A52'   D5                    	PUSH	D
  2A53'   54                    	MOV	D,H
  2A54'   5D                    	MOV	E,L
  2A55'   29                    	DAD	H		; *2
  2A56'   29                    	DAD	H		; *4
  2A57'   19                    	DAD	D		; *5
  2A58'   29                    	DAD	H		; *10
  2A59'   D1                    	POP	D
  2A5A'   09                    	DAD	B
  2A5B'   C1                    	POP	B
  2A5C'   C3 2A42'              	JMP	EXN_LP
  2A5F'                         EXN_DN:
  2A5F'   B7                    	ORA	A		; CY clear: there was a number
  2A60'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  2A61'                         EX_S:
  2A61'   7E                    	MOV	A,M
  2A62'   B7                    	ORA	A
  2A63'   CA 2AA5'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  2A66'   32 0000*              	STA	SDELIM
  2A69'   23                    	INX	H
  2A6A'   11 0000*              	LXI	D,SRCHST
  2A6D'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  2A70'   4F                    	MOV	C,A
  2A71'   CD 2AAB'              	CALL	SCOPY
  2A74'   78                    	MOV	A,B
  2A75'   B7                    	ORA	A
  2A76'   CA 2AA5'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  2A79'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  2A7C'   3E 01                 	MVI	A,1
  2A7E'   32 0000*              	STA	SHAVE		; 'n' repeats it, as after a '/'
  2A81'   11 0000*              	LXI	D,SREPL
  2A84'   0E 24                 	MVI	C,SREPMX
  2A86'   CD 2AAB'              	CALL	SCOPY
  2A89'   78                    	MOV	A,B
  2A8A'   32 0000*              	STA	SREPLN
  2A8D'   AF                    	XRA	A
  2A8E'   32 0000*              	STA	SGFLAG
  2A91'   7E                    	MOV	A,M
  2A92'   FE 67                 	CPI	'g'
  2A94'   C2 2A9D'              	JNZ	EX_SG
  2A97'   23                    	INX	H
  2A98'   3E 01                 	MVI	A,1
  2A9A'   32 0000*              	STA	SGFLAG
  2A9D'                         EX_SG:
  2A9D'   7E                    	MOV	A,M
  2A9E'   B7                    	ORA	A
  2A9F'   C2 280C'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  2AA2'   C3 2ACB'              	JMP	SUBGO
	MACRO-80 3.44	09-Dec-81	PAGE	1-132


  2AA5'                         SUBNOP:
  2AA5'   21 28D4'              	LXI	H,SNOPAT
  2AA8'   C3 281A'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  2AAB'                         SCOPY:
  2AAB'   06 00                 	MVI	B,0
  2AAD'                         SCP_LP:
  2AAD'   78                    	MOV	A,B
  2AAE'   B9                    	CMP	C
  2AAF'   D2 2AC8'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  2AB2'   7E                    	MOV	A,M
  2AB3'   B7                    	ORA	A
  2AB4'   CA 2AC8'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  2AB7'   E5                    	PUSH	H
  2AB8'   21 0000*              	LXI	H,SDELIM
  2ABB'   BE                    	CMP	M
  2ABC'   E1                    	POP	H
  2ABD'   CA 2AC7'              	JZ	SCP_SK
  2AC0'   12                    	STAX	D
  2AC1'   13                    	INX	D
  2AC2'   23                    	INX	H
  2AC3'   04                    	INR	B
  2AC4'   C3 2AAD'              	JMP	SCP_LP
  2AC7'                         SCP_SK:
  2AC7'   23                    	INX	H
  2AC8'                         SCP_DN:
  2AC8'   AF                    	XRA	A
  2AC9'   12                    	STAX	D
  2ACA'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  2ACB'                         SUBGO:
  2ACB'   CD 13D4'              	CALL	GZONE
  2ACE'   2A 0000*              	LHLD	LNDLT
  2AD1'   22 0000*              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  2AD4'   21 0000*              	LXI	H,SOFFS		;   finds nothing puts both back, as the
  2AD7'   CD 042C'              	CALL	FPSTO		;   search's SN_BAD does
  2ADA'   AF                    	XRA	A
  2ADB'   32 0000*              	STA	SANY
  2ADE'   21 0000               	LXI	H,0
  2AE1'   22 0000*              	SHLD	SBACK
  2AE4'   3A 0000*              	LDA	SRNGF
  2AE7'   B7                    	ORA	A
  2AE8'   CA 2AFA'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  2AEB'   CD 239A'              	CALL	EXRNG		; SLINES = the lines in the range
  2AEE'   DA 2B76'              	JC	SUBBAD
  2AF1'   2A 0000*              	LHLD	SRNG1
  2AF4'   CD 1342'              	CALL	GOLN
  2AF7'   C3 2B00'              	JMP	SUBLP
	MACRO-80 3.44	09-Dec-81	PAGE	1-133


  2AFA'                         SUB_1L:
  2AFA'   21 0001               	LXI	H,1
  2AFD'   22 0000*              	SHLD	SLINES
  2B00'                         SUBLP:
  2B00'   CD 2B7C'              	CALL	SUBLIN		; A = 1 when this line changed
  2B03'   B7                    	ORA	A
  2B04'   CA 2B12'              	JZ	SUB_NX
  2B07'   3E 01                 	MVI	A,1
  2B09'   32 0000*              	STA	SANY
  2B0C'   21 0000               	LXI	H,0
  2B0F'   22 0000*              	SHLD	SBACK		; the cursor is ON the last line changed
  2B12'                         SUB_NX:
  2B12'   2A 0000*              	LHLD	SLINES
  2B15'   2B                    	DCX	H
  2B16'   22 0000*              	SHLD	SLINES
  2B19'   7C                    	MOV	A,H
  2B1A'   B5                    	ORA	L
  2B1B'   CA 2B39'              	JZ	SUBDON		; the range is spent
  2B1E'   21 0001               	LXI	H,1
  2B21'   AF                    	XRA	A
  2B22'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  2B25'   3A 0000*              	LDA	SANY
  2B28'   B7                    	ORA	A
  2B29'   CA 2B33'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  2B2C'   2A 0000*              	LHLD	SBACK
  2B2F'   23                    	INX	H
  2B30'   22 0000*              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  2B33'                         SUB_AE:
  2B33'   CD 0BDE'              	CALL	ATEOF
  2B36'   D2 2B00'              	JNC	SUBLP		; ... unless that ran off the end of the file
  2B39'                         SUBDON:
  2B39'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  2B3C'   3A 0000*              	LDA	SANY
  2B3F'   B7                    	ORA	A
  2B40'   CA 2B5E'              	JZ	SUBNFD
  2B43'   3E 01                 	MVI	A,1
  2B45'   32 0000*              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  2B48'   2A 0000*              	LHLD	SBACK
  2B4B'   7C                    	MOV	A,H
  2B4C'   B5                    	ORA	L
  2B4D'   CA 2B58'              	JZ	SUB_PL
  2B50'   3E FF                 	MVI	A,0FFH
  2B52'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  2B55'   CD 0000*              	CALL	CLRCNT
  2B58'                         SUB_PL:
  2B58'   CD 13EC'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  2B5B'   C3 0892'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-134


                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  2B5E'                         SUBNFD:
  2B5E'   21 0000*              	LXI	H,SOFFS
  2B61'   CD 03D3'              	CALL	BACKTO
  2B64'   2A 0000*              	LHLD	SLDLTS
  2B67'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  2B6A'   21 28A4'              	LXI	H,SNOTFD
  2B6D'   CD 281A'              	CALL	EXERR
  2B70'   21 0000*              	LXI	H,SRCHST
  2B73'   C3 2815'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  2B76'                         SUBBAD:
  2B76'   21 2892'              	LXI	H,SNOT
  2B79'   C3 280F'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  2B7C'                         SUBLIN:
  2B7C'   AF                    	XRA	A
  2B7D'   32 0000*              	STA	SLCHG
  2B80'   CD 2BFB'              	CALL	SUBBOL
  2B83'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  2B86'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  2B86'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  2B89'   DA 2B91'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  2B8C'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  2B8E'   C2 2B86'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  2B91'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  2B91'   CD 0000*              	CALL	CUROFF
  2B94'   E5                    	PUSH	H
  2B95'   CD 19CF'              	CALL	CEND
  2B98'   D1                    	POP	D
  2B99'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  2B9C'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  2B9D'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  2BA0'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  2BA1'   B7                    	ORA	A		;   span is a line, not a pair.)
  2BA2'   FA 2BF4'              	JM	SUBL_D		; what is left is shorter than the pattern
  2BA5'   44                    	MOV	B,H
  2BA6'   4D                    	MOV	C,L		; BC = the start positions a match can take
  2BA7'   11 0000*              	LXI	D,SRCHST
  2BAA'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  2BAD'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  2BB0'   DA 2BF4'              	JC	SUBL_D
  2BB3'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
	MACRO-80 3.44	09-Dec-81	PAGE	1-135


  2BB6'   EB                    	XCHG
  2BB7'   2A 0000*              	LHLD	GAPEND
  2BBA'   EB                    	XCHG
  2BBB'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  2BBE'   EB                    	XCHG
  2BBF'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  2BC0'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  2BC3'   D1                    	POP	D
  2BC4'   19                    	DAD	D		; ... and so the match's logical offset
  2BC5'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  2BC8'   3A 0000*              	LDA	SANY
  2BCB'   B7                    	ORA	A
  2BCC'   C2 2BD9'              	JNZ	SUBL_C
  2BCF'   3A 0000*              	LDA	SLCHG
  2BD2'   B7                    	ORA	A
  2BD3'   C2 2BD9'              	JNZ	SUBL_C
  2BD6'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  2BD9'                         SUBL_C:
  2BD9'   3A 0000*              	LDA	SRCHBF
  2BDC'   6F                    	MOV	L,A
  2BDD'   26 00                 	MVI	H,0
  2BDF'   CD 0000*              	CALL	DELFWD		; the match goes
  2BE2'   11 0000*              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  2BE5'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  2BE8'                         SUBL_I:
  2BE8'   3E 01                 	MVI	A,1
  2BEA'   32 0000*              	STA	SLCHG
  2BED'   3A 0000*              	LDA	SGFLAG
  2BF0'   B7                    	ORA	A
  2BF1'   C2 2B91'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  2BF4'                         SUBL_D:
  2BF4'   CD 2BFB'              	CALL	SUBBOL
  2BF7'   3A 0000*              	LDA	SLCHG
  2BFA'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  2BFB'                         SUBBOL:
  2BFB'   CD 0000*              	CALL	CUROFF
  2BFE'   CD 067B'              	CALL	BOL
  2C01'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  2C04'                         VC_SRCH:
  2C04'   CD 0855'              	CALL	SETMOV
  2C07'   C5                    	PUSH	B
  2C08'   CD 0780'              	CALL	GETCNT
  2C0B'   22 0000*              	SHLD	SCNT
  2C0E'   C1                    	POP	B
  2C0F'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-136


  2C10'   FE 2F                 	CPI	'/'
  2C12'   3E 00                 	MVI	A,0
  2C14'   CA 2C19'              	JZ	VS_DIR
  2C17'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  2C19'                         VS_DIR:
  2C19'   32 0000*              	STA	SDIR
  2C1C'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2C1F'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2C22'   47                    	MOV	B,A
  2C23'   CD 213E'              	CALL	RDLINE
  2C26'   B7                    	ORA	A
  2C27'   C0                    	RNZ			; cancelled: nothing happens at all
  2C28'   3A 0000*              	LDA	RLLEN
  2C2B'   B7                    	ORA	A
  2C2C'   CA 2C41'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  2C2F'   5F                    	MOV	E,A
  2C30'   16 00                 	MVI	D,0
  2C32'   21 0000*              	LXI	H,SRCHST
  2C35'   19                    	DAD	D
  2C36'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  2C38'   7B                    	MOV	A,E
  2C39'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  2C3C'   3E 01                 	MVI	A,1
  2C3E'   32 0000*              	STA	SHAVE
  2C41'                         VS_OLD:
  2C41'   3A 0000*              	LDA	SHAVE
  2C44'   B7                    	ORA	A
  2C45'   CA 2C51'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  2C48'   3A 0000*              	LDA	SDIR
  2C4B'   32 0000*              	STA	SDIRE
  2C4E'   C3 2C7A'              	JMP	SRCHN
  2C51'                         VS_NOP:
  2C51'   21 28D4'              	LXI	H,SNOPAT
  2C54'   C3 281A'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  2C57'                         VC_N:
  2C57'   CD 0855'              	CALL	SETMOV
  2C5A'   3A 0000*              	LDA	SDIR
  2C5D'   C3 2C67'              	JMP	VN_GO
  2C60'                         VCB_N:
  2C60'   CD 0855'              	CALL	SETMOV
  2C63'   3A 0000*              	LDA	SDIR
  2C66'   2F                    	CMA			; the other way: 0 <-> FFH
  2C67'                         VN_GO:
  2C67'   32 0000*              	STA	SDIRE
  2C6A'   CD 0780'              	CALL	GETCNT
  2C6D'   22 0000*              	SHLD	SCNT
  2C70'   3A 0000*              	LDA	SHAVE
  2C73'   B7                    	ORA	A
  2C74'   CA 2C51'              	JZ	VS_NOP
  2C77'   C3 2C7A'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
	MACRO-80 3.44	09-Dec-81	PAGE	1-137


                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  2C7A'                         SRCHN:
  2C7A'   CD 13D4'              	CALL	GZONE		; the screen's top line, before the cursor moves
  2C7D'   CD 07A9'              	CALL	BRKON		; where it started (the sweep moves the cursor
                                				;   with PUTCUR, which does not maintain LNDLT;
                                				;   GOTO does), and an ESC may stop it
  2C80'                         SN_LP:
  2C80'   CD 2CB5'              	CALL	SRCHGO
  2C83'   DA 2CA0'              	JC	SN_BAD
  2C86'   2A 0000*              	LHLD	SCNT
  2C89'   2B                    	DCX	H
  2C8A'   22 0000*              	SHLD	SCNT
  2C8D'   7C                    	MOV	A,H
  2C8E'   B5                    	ORA	L
  2C8F'   C2 2C80'              	JNZ	SN_LP
  2C92'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  2C95'   CD 07E6'              	CALL	BRKOFF
  2C98'   3E 01                 	MVI	A,1
  2C9A'   32 0000*              	STA	GPKEEP		; land on the match, not the first non-blank
  2C9D'   C3 13EC'              	JMP	GPLACE		; (which sets LNDLT itself)
  2CA0'                         SN_BAD:
  2CA0'   CD 07E6'              	CALL	BRKOFF
  2CA3'   DA 07FE'              	JC	BRKBAK		; stopped, which is not the same as not found
  2CA6'   CD 07F1'              	CALL	RSTPL		; nothing moved: the row the cursor was on
  2CA9'   21 28A4'              	LXI	H,SNOTFD
  2CAC'   CD 281A'              	CALL	EXERR
  2CAF'   21 0000*              	LXI	H,SRCHST
  2CB2'   C3 2815'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, paging as WM's find pages, then the rest of the
                                ; file READ where it lies (SCAN) and the window moved once, to the match --
                                ; not paged round the whole file a second time (issue #35).  CY = the pattern
                                ; is nowhere in the file, or an ESC stopped it (BRKQ says which); the cursor
                                ; is then at an end of the file, and SRCHN puts it back.
  2CB5'                         SRCHGO:
  2CB5'   21 0000*              	LXI	H,SGPOS
  2CB8'   CD 042C'              	CALL	FPSTO		; where this one starts: the wrapped pass ends
  2CBB'   CD 2F0B'              	CALL	SRCHW		;   there
  2CBE'   D0                    	RNC
  2CBF'   CD 07EA'              	CALL	BRKQ
  2CC2'   D8                    	RC			; stopped: no second pass
  2CC3'   CD 2CD0'              	CALL	SCAN
  2CC6'   D8                    	RC
  2CC7'   21 0000*              	LXI	H,SCHIT
  2CCA'   CD 03D3'              	CALL	BACKTO		; to the match: one move, as a mark jump
  2CCD'   C3 07EA'              	JMP	BRKQ		; CY: stopped on the way there
                                
                                ;SCAN -- the wrapped pass, without moving the window: the records above it,
                                ; the window, then the records below it, through SECBUF in file order (SCNEXT).
                                ; The last bytes of each piece, a pattern less one, are kept just below
                                ; SECBUF, so a match that straddles two pieces is seen whole there.  '/'
                                ; wants the FIRST match in the file and stops reading once a match could only
                                ; start past SGPOS -- the first pass found nothing there.  '?' wants the LAST,
                                ; so it reads to the end, but skips the records that end before SCLIM: the
	MACRO-80 3.44	09-Dec-81	PAGE	1-138


                                ; first pass found nothing that ends before SGPOS.  NC: SCHIT = the match's
                                ; file position.  CY: there is none, or an ESC stopped it.
  2CD0'                         SCAN:
  2CD0'   AF                    	XRA	A
  2CD1'   32 0000*              	STA	SCFND
  2CD4'   32 0000*              	STA	SCCRY
  2CD7'   32 0000*              	STA	SCPH		; the records above the window first
  2CDA'   32 0002*              	STA	SCPOS+2
  2CDD'   21 0000               	LXI	H,0
  2CE0'   22 0000*              	SHLD	SCIX
  2CE3'   22 0000*              	SHLD	SCPOS
  2CE6'   3A 0000*              	LDA	SRCHBF
  2CE9'   5F                    	MOV	E,A
  2CEA'   16 00                 	MVI	D,0		; DE = the pattern's length
  2CEC'   2A 0000*              	LHLD	SGPOS
  2CEF'   3A 0000*              	LDA	SDIRE
  2CF2'   B7                    	ORA	A
  2CF3'   3A 0002*              	LDA	SGPOS+2
  2CF6'   FA 2CFF'              	JM	SC_BK
  2CF9'   19                    	DAD	D		; '/': SGPOS + the length
  2CFA'   CE 00                 	ACI	0
  2CFC'   C3 2D09'              	JMP	SC_LIM
  2CFF'                         SC_BK:
  2CFF'   42                    	MOV	B,D
  2D00'   CD 1381'              	CALL	SUB24		; '?': SGPOS - the length (0 if that is less)
  2D03'   D2 2D09'              	JNC	SC_LIM
  2D06'   AF                    	XRA	A
  2D07'   67                    	MOV	H,A
  2D08'   6F                    	MOV	L,A
  2D09'                         SC_LIM:
  2D09'   22 0000*              	SHLD	SCLIM
  2D0C'   32 0002*              	STA	SCLIM+2
  2D0F'                         SC_LP:
  2D0F'   3A 0000*              	LDA	BRKARM
  2D12'   B7                    	ORA	A
  2D13'   C4 07C3'              	CNZ	BRKTST		; an ESC, as CNTTST looks for one
  2D16'   CD 07EA'              	CALL	BRKQ
  2D19'   D8                    	RC
  2D1A'   3A 0000*              	LDA	SDIRE
  2D1D'   B7                    	ORA	A
  2D1E'   FA 2D3A'              	JM	SC_RD		; '?' reads to the end
  2D21'   3A 0000*              	LDA	SCFND
  2D24'   B7                    	ORA	A
  2D25'   C0                    	RNZ			; '/': the first is all it wants (NC)
  2D26'   2A 0000*              	LHLD	SCLIM
  2D29'   EB                    	XCHG
  2D2A'   3A 0002*              	LDA	SCLIM+2
  2D2D'   47                    	MOV	B,A
  2D2E'   2A 0000*              	LHLD	SCPOS
  2D31'   3A 0002*              	LDA	SCPOS+2
  2D34'   CD 1381'              	CALL	SUB24		; NC: no match can start at SGPOS or before
  2D37'   D2 2D47'              	JNC	SC_END		;   from here on
  2D3A'                         SC_RD:
  2D3A'   CD 2DEA'              	CALL	SCNEXT		; SECBUF = the next piece, A = its length
  2D3D'   DA 2D47'              	JC	SC_END		; the file has run out
  2D40'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-139


  2D41'   C4 2D4D'              	CNZ	SCMAT
  2D44'   C3 2D0F'              	JMP	SC_LP
  2D47'                         SC_END:
  2D47'   3A 0000*              	LDA	SCFND
  2D4A'   D6 01                 	SUI	1		; CY iff there is none
  2D4C'   C9                    	RET
                                
                                ;SCMAT -- look for the pattern in the A bytes in SECBUF and the carry below
                                ; it, then keep the last of them as the carry and move SCPOS past them.
  2D4D'                         SCMAT:
  2D4D'   4F                    	MOV	C,A
  2D4E'   06 00                 	MVI	B,0
  2D50'   C5                    	PUSH	B		; the length of the piece
  2D51'   3A 0000*              	LDA	SRCHBF
  2D54'   67                    	MOV	H,A
  2D55'   3A 0000*              	LDA	SCCRY
  2D58'   81                    	ADD	C		; the carry and the piece
  2D59'   94                    	SUB	H
  2D5A'   DA 2DB1'              	JC	SCM_NO		; shorter than the pattern
  2D5D'   3C                    	INR	A
  2D5E'   4F                    	MOV	C,A		; BC = the places a match may start at
  2D5F'   11 0000*              	LXI	D,SRCHST
  2D62'   3A 0000*              	LDA	SDIRE
  2D65'   B7                    	ORA	A
  2D66'   FA 2D83'              	JM	SCM_BK
  2D69'   3A 0000*              	LDA	SCCRY		; '/': the first, from the carry's first byte
  2D6C'   2F                    	CMA
  2D6D'   6F                    	MOV	L,A
  2D6E'   26 FF                 	MVI	H,0FFH
  2D70'   23                    	INX	H		; HL = - the carry
  2D71'   D5                    	PUSH	D
  2D72'   11 0000*              	LXI	D,SECBUF
  2D75'   19                    	DAD	D
  2D76'   D1                    	POP	D
  2D77'   CD 0000*              	CALL	MATCHF
  2D7A'   DA 2DB1'              	JC	SCM_NO
  2D7D'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match
  2D80'   C3 2D94'              	JMP	SCM_HI
  2D83'                         SCM_BK:
  2D83'   E1                    	POP	H		; '?': the last, back from the piece's end
  2D84'   E5                    	PUSH	H
  2D85'   D5                    	PUSH	D
  2D86'   11 0000*              	LXI	D,SECBUF
  2D89'   19                    	DAD	D
  2D8A'   D1                    	POP	D
  2D8B'   CD 0000*              	CALL	SUBLEN		; the last place one can start
  2D8E'   CD 0000*              	CALL	MATCHB
  2D91'   DA 2DB1'              	JC	SCM_NO
  2D94'                         SCM_HI:
  2D94'   EB                    	XCHG			; DE = the match, in SECBUF or below it
  2D95'   2A 0000*              	LHLD	SCPOS
  2D98'   19                    	DAD	D
  2D99'   3A 0002*              	LDA	SCPOS+2
  2D9C'   CE 00                 	ACI	0
  2D9E'   11 0000*              	LXI	D,SECBUF
  2DA1'   06 00                 	MVI	B,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-140


  2DA3'   CD 1381'              	CALL	SUB24		; its file position
  2DA6'   22 0000*              	SHLD	SCHIT
  2DA9'   32 0002*              	STA	SCHIT+2
  2DAC'   3E 01                 	MVI	A,1
  2DAE'   32 0000*              	STA	SCFND
  2DB1'                         SCM_NO:
  2DB1'   C1                    	POP	B		; BC = the piece's length
  2DB2'   C5                    	PUSH	B
  2DB3'   3A 0000*              	LDA	SCCRY
  2DB6'   81                    	ADD	C
  2DB7'   5F                    	MOV	E,A		; the carry and the piece
  2DB8'   3A 0000*              	LDA	SRCHBF
  2DBB'   3D                    	DCR	A		; ... of which a pattern less one is kept
  2DBC'   BB                    	CMP	E
  2DBD'   DA 2DC1'              	JC	SCM_T
  2DC0'   7B                    	MOV	A,E
  2DC1'                         SCM_T:
  2DC1'   32 0000*              	STA	SCCRY
  2DC4'   5F                    	MOV	E,A
  2DC5'   16 00                 	MVI	D,0		; DE = the new carry
  2DC7'   21 0000*              	LXI	H,SECBUF
  2DCA'   09                    	DAD	B
  2DCB'   CD 0000*              	CALL	SUBHD		; the bytes it keeps
  2DCE'   E5                    	PUSH	H
  2DCF'   21 0000*              	LXI	H,SECBUF
  2DD2'   CD 0000*              	CALL	SUBHD		; where they go
  2DD5'   42                    	MOV	B,D
  2DD6'   4B                    	MOV	C,E
  2DD7'   EB                    	XCHG
  2DD8'   E1                    	POP	H
  2DD9'   CD 0000*              	CALL	MEMCPY		; (down, so a forward copy is safe)
  2DDC'   D1                    	POP	D		; the piece's length
                                ;SCADV -- SCPOS += DE.
  2DDD'                         SCADV:
  2DDD'   2A 0000*              	LHLD	SCPOS
  2DE0'   19                    	DAD	D
  2DE1'   22 0000*              	SHLD	SCPOS
  2DE4'   D0                    	RNC
  2DE5'   21 0002*              	LXI	H,SCPOS+2
  2DE8'   34                    	INR	M
  2DE9'   C9                    	RET
                                
                                ;SCNEXT -- the next piece of the file into SECBUF: A = its length, which is 0
                                ; for a record skipped.  CY: the file has run out.  SCPH is what it is in:
                                ; 0 the records above the window, 1 the window before the gap, 2 after it,
                                ; 3 VIBACKUP.$$$ (top down), 4 the source below, 5 nothing left.
  2DEA'                         SCNEXT:
  2DEA'   3A 0000*              	LDA	SCPH
  2DED'   B7                    	ORA	A
  2DEE'   CA 2E00'              	JZ	SN_AB
  2DF1'   FE 03                 	CPI	3
  2DF3'   DA 2E2E'              	JC	SN_GP
  2DF6'   CA 2EA4'              	JZ	SN_BAK
  2DF9'   FE 04                 	CPI	4
  2DFB'   CA 2EBE'              	JZ	SN_SRC
  2DFE'   37                    	STC
	MACRO-80 3.44	09-Dec-81	PAGE	1-141


  2DFF'   C9                    	RET
  2E00'                         SN_AB:
  2E00'   2A 0000*              	LHLD	OUTPOS
  2E03'   EB                    	XCHG
  2E04'   2A 0000*              	LHLD	SCIX
  2E07'   CD 0000*              	CALL	CMP16
  2E0A'   CA 2E18'              	JZ	SN_W0		; all of them read: the window
  2E0D'   23                    	INX	H
  2E0E'   22 0000*              	SHLD	SCIX
  2E11'   2B                    	DCX	H
  2E12'   AF                    	XRA	A		; above the window
  2E13'   CD 2ED5'              	CALL	SN_REC
  2E16'   B7                    	ORA	A
  2E17'   C9                    	RET
  2E18'                         SN_W0:
  2E18'   2A 0000*              	LHLD	TXTBEG
  2E1B'   EB                    	XCHG
  2E1C'   2A 0000*              	LHLD	GAPBEG
  2E1F'   3E 01                 	MVI	A,1
  2E21'                         SN_PH:				; phase A, from DE up to HL
  2E21'   32 0000*              	STA	SCPH
  2E24'   22 0000*              	SHLD	SCEND
  2E27'   EB                    	XCHG
  2E28'   22 0000*              	SHLD	SCIX
  2E2B'   C3 2DEA'              	JMP	SCNEXT
  2E2E'                         SN_GP:				; the window: up to 128 bytes of it, copied
  2E2E'   2A 0000*              	LHLD	SCIX
  2E31'   EB                    	XCHG
  2E32'   2A 0000*              	LHLD	SCEND
  2E35'   CD 0000*              	CALL	SUBHD		; HL = what is left of this part
  2E38'   7C                    	MOV	A,H
  2E39'   B5                    	ORA	L
  2E3A'   CA 2E5F'              	JZ	SN_GPX
  2E3D'   7C                    	MOV	A,H
  2E3E'   B7                    	ORA	A
  2E3F'   C2 2E48'              	JNZ	SN_128
  2E42'   7D                    	MOV	A,L
  2E43'   FE 81                 	CPI	81H
  2E45'   DA 2E4B'              	JC	SN_GPN
  2E48'                         SN_128:
  2E48'   21 0080               	LXI	H,80H
  2E4B'                         SN_GPN:
  2E4B'   E5                    	PUSH	H
  2E4C'   44                    	MOV	B,H
  2E4D'   4D                    	MOV	C,L
  2E4E'   EB                    	XCHG
  2E4F'   E5                    	PUSH	H
  2E50'   11 0000*              	LXI	D,SECBUF
  2E53'   CD 0000*              	CALL	MEMCPY
  2E56'   E1                    	POP	H
  2E57'   C1                    	POP	B
  2E58'   09                    	DAD	B
  2E59'   22 0000*              	SHLD	SCIX
  2E5C'   79                    	MOV	A,C
  2E5D'   B7                    	ORA	A
  2E5E'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-142


  2E5F'                         SN_GPX:
  2E5F'   3A 0000*              	LDA	SCPH
  2E62'   FE 02                 	CPI	2
  2E64'   CA 2E73'              	JZ	SN_BLW
  2E67'   2A 0000*              	LHLD	GAPEND
  2E6A'   EB                    	XCHG
  2E6B'   2A 0000*              	LHLD	TXTEND
  2E6E'   3E 02                 	MVI	A,2
  2E70'   C3 2E21'              	JMP	SN_PH
  2E73'                         SN_BLW:				; below the window: VIBACKUP.$$$ if it holds
  2E73'   3A 0000*              	LDA	BAKRDY		;   anything, as RDIN reads it first
  2E76'   B7                    	ORA	A
  2E77'   CA 2E8D'              	JZ	SN_S0
  2E7A'   2A 0000*              	LHLD	BAKPOS
  2E7D'   7C                    	MOV	A,H
  2E7E'   B5                    	ORA	L
  2E7F'   CA 2E8D'              	JZ	SN_S0
  2E82'   22 0000*              	SHLD	SCIX
  2E85'   3E 03                 	MVI	A,3
  2E87'   32 0000*              	STA	SCPH
  2E8A'   C3 2DEA'              	JMP	SCNEXT
  2E8D'                         SN_S0:				; then the source, from where it is read to
  2E8D'   3A 005B               	LDA	5BH
  2E90'   B7                    	ORA	A
  2E91'   3E 05                 	MVI	A,5
  2E93'   CA 2E9E'              	JZ	SN_END
  2E96'   2A 007E               	LHLD	7EH
  2E99'   22 0000*              	SHLD	SCIX
  2E9C'   3E 04                 	MVI	A,4
  2E9E'                         SN_END:
  2E9E'   32 0000*              	STA	SCPH
  2EA1'   C3 2DEA'              	JMP	SCNEXT
  2EA4'                         SN_BAK:
  2EA4'   2A 0000*              	LHLD	SCIX
  2EA7'   7C                    	MOV	A,H
  2EA8'   B5                    	ORA	L
  2EA9'   CA 2E8D'              	JZ	SN_S0		; record 0 read
  2EAC'   2B                    	DCX	H
  2EAD'   22 0000*              	SHLD	SCIX
  2EB0'   3E 01                 	MVI	A,1
  2EB2'   CD 2ED5'              	CALL	SN_REC
  2EB5'   D0                    	RNC
  2EB6'   21 0000               	LXI	H,0		; a ^Z: the stack ends there (RDIN's IOEOF)
  2EB9'   22 0000*              	SHLD	SCIX
  2EBC'   B7                    	ORA	A
  2EBD'   C9                    	RET
  2EBE'                         SN_SRC:
  2EBE'   2A 0000*              	LHLD	SCIX
  2EC1'   23                    	INX	H
  2EC2'   22 0000*              	SHLD	SCIX
  2EC5'   2B                    	DCX	H
  2EC6'   3E 02                 	MVI	A,2
  2EC8'   CD 2ED5'              	CALL	SN_REC
  2ECB'   D0                    	RNC
  2ECC'   F5                    	PUSH	PSW		; a ^Z or no record: the end of the file
  2ECD'   3E 05                 	MVI	A,5
	MACRO-80 3.44	09-Dec-81	PAGE	1-143


  2ECF'   32 0000*              	STA	SCPH
  2ED2'   F1                    	POP	PSW
  2ED3'   B7                    	ORA	A
  2ED4'   C9                    	RET
                                
                                ;SN_REC -- SCNREC (record HL, kind A), unless it is a '?' record that ends
                                ; before SCLIM, which is skipped: SCPOS moves past it and the carry goes (a
                                ; record is 128 bytes until the last, and that one is never skipped).
  2ED5'                         SN_REC:
  2ED5'   F5                    	PUSH	PSW
  2ED6'   E5                    	PUSH	H
  2ED7'   3A 0000*              	LDA	SDIRE
  2EDA'   B7                    	ORA	A
  2EDB'   F2 2F06'              	JP	SN_RD		; '/' never skips
  2EDE'   2A 0000*              	LHLD	SCPOS
  2EE1'   11 0080               	LXI	D,80H
  2EE4'   19                    	DAD	D
  2EE5'   EB                    	XCHG
  2EE6'   3A 0002*              	LDA	SCPOS+2
  2EE9'   CE 00                 	ACI	0
  2EEB'   47                    	MOV	B,A		; B:DE = past this record
  2EEC'   2A 0000*              	LHLD	SCLIM
  2EEF'   3A 0002*              	LDA	SCLIM+2
  2EF2'   CD 1381'              	CALL	SUB24		; NC: it ends at SCLIM or before
  2EF5'   DA 2F06'              	JC	SN_RD
  2EF8'   E1                    	POP	H
  2EF9'   F1                    	POP	PSW
  2EFA'   AF                    	XRA	A
  2EFB'   32 0000*              	STA	SCCRY
  2EFE'   11 0080               	LXI	D,80H
  2F01'   CD 2DDD'              	CALL	SCADV
  2F04'   AF                    	XRA	A		; nothing to look at, NC
  2F05'   C9                    	RET
  2F06'                         SN_RD:
  2F06'   E1                    	POP	H
  2F07'   F1                    	POP	PSW
  2F08'   C3 0000*              	JMP	SCNREC
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller reads the rest of the file or restores the cursor outright.
  2F0B'                         SRCHW:
  2F0B'   3A 0000*              	LDA	SDIRE
  2F0E'   32 0000*              	STA	DIRFLG
  2F11'   21 FFFF               	LXI	H,0FFFFH
  2F14'   22 0000*              	SHLD	CMDCNT
  2F17'   AF                    	XRA	A
  2F18'   32 0000*              	STA	AUXCNT
  2F1B'                         SW_LP:
  2F1B'   CD 07EA'              	CALL	BRKQ		; an ESC spent the count, here or on the way to
  2F1E'   D8                    	RC			;   the wrapped pass: SCRLST no longer pages
  2F1F'   CD 2F2B'              	CALL	SRCH1
	MACRO-80 3.44	09-Dec-81	PAGE	1-144


  2F22'   D0                    	RNC
  2F23'   CD 0000*              	CALL	SCRLST
  2F26'   D2 2F1B'              	JNC	SW_LP
  2F29'   37                    	STC
  2F2A'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  2F2B'                         SRCH1:
  2F2B'   11 0000*              	LXI	D,SRCHST
  2F2E'   3A 0000*              	LDA	DIRFLG
  2F31'   B7                    	ORA	A
  2F32'   FA 2F4F'              	JM	SR1_BK
  2F35'   21 0000*              	LXI	H,GAPEND
  2F38'   CD 0000*              	CALL	FWDCNT
  2F3B'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  2F3E'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  2F3F'   78                    	MOV	A,B
  2F40'   B1                    	ORA	C
  2F41'   37                    	STC
  2F42'   C8                    	RZ			; no room for a match even before the skip
  2F43'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2F44'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2F45'   CD 0000*              	CALL	MATCHF
  2F48'   D8                    	RC
  2F49'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2F4C'   C3 0000*              	JMP	PUTCUR
  2F4F'                         SR1_BK:
  2F4F'   21 0000*              	LXI	H,TXTBEG
  2F52'   CD 0000*              	CALL	FWDCNT
  2F55'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2F58'   D8                    	RC
  2F59'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2F5C'   CD 0000*              	CALL	MATCHB
  2F5F'   D8                    	RC
  2F60'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-145


                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2F63'                         MSGNAM:
  2F63'   E5                    	PUSH	H
  2F64'   3E 22                 	MVI	A,'"'
  2F66'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  2F69'   E1                    	POP	H
  2F6A'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  2F6B'   23                    	INX	H
  2F6C'   7E                    	MOV	A,M
  2F6D'   FE 20                 	CPI	' '
  2F6F'   C2 2F7C'              	JNZ	MN_HAS
  2F72'   21 2962'              	LXI	H,SNONM
  2F75'   CD 0000*              	CALL	OUTSTR
  2F78'   E1                    	POP	H
  2F79'   C3 2FC6'              	JMP	MN_END
  2F7C'                         MN_HAS:
  2F7C'   0E 19                 	MVI	C,BF_CURDSK
  2F7E'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  2F81'   E1                    	POP	H
  2F82'   E5                    	PUSH	H
  2F83'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  2F84'   BE                    	CMP	M
  2F85'   CA 2F93'              	JZ	MN_NAM
  2F88'   7E                    	MOV	A,M
  2F89'   C6 40                 	ADI	'A'-1
  2F8B'   CD 0000*              	CALL	OUTCH
  2F8E'   3E 3A                 	MVI	A,':'
  2F90'   CD 0000*              	CALL	OUTCH
  2F93'                         MN_NAM:
  2F93'   E1                    	POP	H
  2F94'   E5                    	PUSH	H
  2F95'   23                    	INX	H
  2F96'   0E 08                 	MVI	C,8
  2F98'                         MN_NM:
  2F98'   7E                    	MOV	A,M
  2F99'   FE 20                 	CPI	' '
  2F9B'   CA 2FA6'              	JZ	MN_EXT
  2F9E'   CD 0000*              	CALL	OUTCH
  2FA1'   23                    	INX	H
  2FA2'   0D                    	DCR	C
  2FA3'   C2 2F98'              	JNZ	MN_NM
  2FA6'                         MN_EXT:
  2FA6'   E1                    	POP	H
  2FA7'   11 0009               	LXI	D,9
  2FAA'   19                    	DAD	D		; the type field
  2FAB'   7E                    	MOV	A,M
  2FAC'   FE 20                 	CPI	' '
  2FAE'   CA 2FC6'              	JZ	MN_END
  2FB1'   3E 2E                 	MVI	A,'.'
  2FB3'   CD 0000*              	CALL	OUTCH
  2FB6'   0E 03                 	MVI	C,3
	MACRO-80 3.44	09-Dec-81	PAGE	1-146


  2FB8'                         MN_XL:
  2FB8'   7E                    	MOV	A,M
  2FB9'   FE 20                 	CPI	' '
  2FBB'   CA 2FC6'              	JZ	MN_END
  2FBE'   CD 0000*              	CALL	OUTCH
  2FC1'   23                    	INX	H
  2FC2'   0D                    	DCR	C
  2FC3'   C2 2FB8'              	JNZ	MN_XL
  2FC6'                         MN_END:
  2FC6'   3E 22                 	MVI	A,'"'
  2FC8'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  2FCB'                         MSGFLG:
  2FCB'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  2FCD'   B7                    	ORA	A
  2FCE'   CA 2FDE'              	JZ	MF_RO
  2FD1'   3A 0000*              	LDA	MODF
  2FD4'   B7                    	ORA	A
  2FD5'   CA 2FDE'              	JZ	MF_RO
  2FD8'   21 296C'              	LXI	H,SMODM
  2FDB'   CD 2FF3'              	CALL	MF_PUT
  2FDE'                         MF_RO:
  2FDE'   3A 0000*              	LDA	ROFLAG
  2FE1'   B7                    	ORA	A
  2FE2'   CA 2FEB'              	JZ	MF_NEW
  2FE5'   21 2977'              	LXI	H,SROM
  2FE8'   CD 2FF3'              	CALL	MF_PUT
  2FEB'                         MF_NEW:
  2FEB'   3A 0000*              	LDA	MSGNEW
  2FEE'   B7                    	ORA	A
  2FEF'   C8                    	RZ
  2FF0'   21 2982'              	LXI	H,SNEWM
  2FF3'                         MF_PUT:
  2FF3'   78                    	MOV	A,B
  2FF4'   B7                    	ORA	A
  2FF5'   C2 3001'              	JNZ	MF_STR
  2FF8'   06 01                 	MVI	B,1
  2FFA'   E5                    	PUSH	H
  2FFB'   3E 20                 	MVI	A,' '
  2FFD'   CD 0000*              	CALL	OUTCH
  3000'   E1                    	POP	H
  3001'                         MF_STR:
  3001'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  3004'                         EMITW:
  3004'   C5                    	PUSH	B
  3005'   D5                    	PUSH	D
  3006'   06 00                 	MVI	B,0
  3008'   11 2710               	LXI	D,10000
	MACRO-80 3.44	09-Dec-81	PAGE	1-147


  300B'   CD 3029'              	CALL	EWDIG
  300E'   11 03E8               	LXI	D,1000
  3011'   CD 3029'              	CALL	EWDIG
  3014'   11 0064               	LXI	D,100
  3017'   CD 3029'              	CALL	EWDIG
  301A'   11 000A               	LXI	D,10
  301D'   CD 3029'              	CALL	EWDIG
  3020'   7D                    	MOV	A,L		; the units digit is always printed
  3021'   C6 30                 	ADI	'0'
  3023'   CD 0000*              	CALL	OUTCH
  3026'   D1                    	POP	D
  3027'   C1                    	POP	B
  3028'   C9                    	RET
  3029'                         EWDIG:
  3029'   0E 00                 	MVI	C,0
  302B'                         EW_LP:
  302B'   7D                    	MOV	A,L
  302C'   93                    	SUB	E
  302D'   6F                    	MOV	L,A
  302E'   7C                    	MOV	A,H
  302F'   9A                    	SBB	D
  3030'   67                    	MOV	H,A
  3031'   DA 3038'              	JC	EW_DN
  3034'   0C                    	INR	C
  3035'   C3 302B'              	JMP	EW_LP
  3038'                         EW_DN:
  3038'   19                    	DAD	D		; one subtraction too many: give it back
  3039'   79                    	MOV	A,C
  303A'   B7                    	ORA	A
  303B'   C2 3041'              	JNZ	EW_PR
  303E'   78                    	MOV	A,B
  303F'   B7                    	ORA	A
  3040'   C8                    	RZ			; a leading zero: write nothing
  3041'                         EW_PR:
  3041'   79                    	MOV	A,C
  3042'   C6 30                 	ADI	'0'
  3044'   CD 0000*              	CALL	OUTCH
  3047'   06 01                 	MVI	B,1
  3049'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  304A'                         ISEMPT:
  304A'   2A 0000*              	LHLD	OUTPOS
  304D'   7C                    	MOV	A,H
  304E'   B5                    	ORA	L
  304F'   C0                    	RNZ
  3050'   CD 0000*              	CALL	LOGLEN
  3053'   7C                    	MOV	A,H
  3054'   B5                    	ORA	L
  3055'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
	MACRO-80 3.44	09-Dec-81	PAGE	1-148


  3056'                         MSGCTG:
  3056'   21 0000*              	LXI	H,FNAME
  3059'   CD 2F63'              	CALL	MSGNAM
  305C'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  305E'   CD 2FCB'              	CALL	MSGFLG
  3061'   CD 304A'              	CALL	ISEMPT
  3064'   C2 306D'              	JNZ	MG_POS
  3067'   21 2995'              	LXI	H,SNOLIN
  306A'   C3 0000*              	JMP	OUTSTR
  306D'                         MG_POS:
  306D'   21 2988'              	LXI	H,SLINE
  3070'   CD 0000*              	CALL	OUTSTR
  3073'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  3076'   23                    	INX	H		;   ... so the line it is on
  3077'   CD 3004'              	CALL	EMITW
  307A'   21 298F'              	LXI	H,SCOLM
  307D'   CD 0000*              	CALL	OUTSTR
  3080'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  3083'   23                    	INX	H
  3084'   E5                    	PUSH	H
  3085'   CD 3004'              	CALL	EMITW
  3088'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  308B'   23                    	INX	H
  308C'   D1                    	POP	D
  308D'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  3090'   C8                    	RZ
  3091'   E5                    	PUSH	H
  3092'   3E 2D                 	MVI	A,'-'
  3094'   CD 0000*              	CALL	OUTCH
  3097'   E1                    	POP	H
  3098'   C3 3004'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  309B'                         FILMSG:
  309B'   3A 0001*              	LDA	FNAME+1
  309E'   FE 20                 	CPI	' '
  30A0'   C8                    	RZ
  30A1'   21 0000*              	LXI	H,FNAME
  30A4'   CD 2F63'              	CALL	MSGNAM
  30A7'   AF                    	XRA	A		; nothing has been changed yet
  30A8'   C3 2FCB'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  30AB'                         WRMSG:
  30AB'   21 0000*              	LXI	H,TFCB
  30AE'   CD 2F63'              	CALL	MSGNAM
  30B1'   21 29A7'              	LXI	H,SWRIT
  30B4'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  30B7'                         MSGPST:
	MACRO-80 3.44	09-Dec-81	PAGE	1-149


  30B7'   3A 0000*              	LDA	MSGWHT
  30BA'   B7                    	ORA	A
  30BB'   C8                    	RZ
  30BC'   47                    	MOV	B,A
  30BD'   AF                    	XRA	A
  30BE'   32 0000*              	STA	MSGWHT
  30C1'   78                    	MOV	A,B
  30C2'   FE 01                 	CPI	MW_FIL
  30C4'   CA 30EB'              	JZ	MP_FIL
  30C7'   FE 02                 	CPI	MW_WRT
  30C9'   CA 30F1'              	JZ	MP_WRT
  30CC'   FE 04                 	CPI	MW_BIG
  30CE'   CA 30E2'              	JZ	MP_BIG
  30D1'   FE 05                 	CPI	MW_MEM
  30D3'   CA 30DC'              	JZ	MP_MEM
  30D6'   CD 3056'              	CALL	MSGCTG
  30D9'   C3 0000*              	JMP	SCURS
  30DC'                         MP_MEM:
  30DC'   21 2935'              	LXI	H,SMEM
  30DF'   C3 30E5'              	JMP	MP_BG
  30E2'                         MP_BIG:
  30E2'   21 2923'              	LXI	H,SQBIG
  30E5'                         MP_BG:
  30E5'   CD 0000*              	CALL	EXMSG
  30E8'   C3 0000*              	JMP	SCURS
  30EB'                         MP_FIL:
  30EB'   CD 309B'              	CALL	FILMSG
  30EE'   C3 0000*              	JMP	SCURS
  30F1'                         MP_WRT:
  30F1'   CD 30AB'              	CALL	WRMSG
  30F4'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  30F7'                         VC_CTLG:
  30F7'   3E 03                 	MVI	A,MW_CTG
  30F9'   32 0000*              	STA	MSGWHT
  30FC'   3E 01                 	MVI	A,R_MOVE
  30FE'   32 0000*              	STA	RINTENT
  3101'   C3 0780'              	JMP	GETCNT		; a count typed before it is spent here, not
                                				;   left for the next command
                                
  3104'                         CMDTAB:
  3104'   07                    	DB	07H			; ^G -- where am I?
  3105'   30F7'                 	DW	VC_CTLG
  3107'   68                    	DB	'h'
  3108'   08CD'                 	DW	VC_H
