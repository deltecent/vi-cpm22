  0B67'   DA 0B79'              	JC	IC_END
  0B6A'   F5                    	PUSH	PSW
  0B6B'   CD 0000*              	CALL	PUTCUR
  0B6E'   F1                    	POP	PSW
  0B6F'   B7                    	ORA	A
  0B70'   CA 0B4E'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0B73'   CD 0B9F'              	CALL	LNINC
  0B76'   3E 01                 	MVI	A,1
  0B78'   C9                    	RET
  0B79'                         IC_END:
