  29F2'   46                    	DB	'F'
  29F3'   021F'                 	DW	VC_FB
  29F5'   74                    	DB	't'
  29F6'   0224'                 	DW	VC_TF
  29F8'   54                    	DB	'T'
  29F9'   0229'                 	DW	VC_TB
  29FB'   3B                    	DB	';'
  29FC'   0240'                 	DW	VC_SEMI
  29FE'   2C                    	DB	','
  29FF'   024A'                 	DW	VC_COMMA
  2A01'   79                    	DB	'y'
  2A02'   180F'                 	DW	VC_Y
  2A04'   59                    	DB	'Y'
  2A05'   1817'                 	DW	VY_YY
  2A07'   70                    	DB	'p'
  2A08'   1A4D'                 	DW	VC_P
  2A0A'   50                    	DB	'P'
  2A0B'   1A62'                 	DW	VCB_P
  2A0D'   69                    	DB	'i'
  2A0E'   1590'                 	DW	VC_I
  2A10'   61                    	DB	'a'
  2A11'   1596'                 	DW	VC_A
  2A13'   41                    	DB	'A'
  2A14'   15B6'                 	DW	VCB_A
  2A16'   49                    	DB	'I'
  2A17'   15D2'                 	DW	VCB_I
  2A19'   72                    	DB	'r'
  2A1A'   1714'                 	DW	VC_R
