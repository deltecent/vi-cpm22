  0F78'   4F                    	MOV	C,A
  0F79'   CD 11F7'              	CALL	HTFQ		; HL -> the first line the screen has not room for
  0F7C'   3A 0000*              	LDA	NEDIT
  0F7F'   DA 0F8C'              	JC	VPD_R		; there is none: no overlap
  0F82'   3A 0000*              	LDA	HTN
  0F85'   90                    	SUB	B
  0F86'   3C                    	INR	A
  0F87'   47                    	MOV	B,A		; the lines from it up to the table's first
  0F88'   AF                    	XRA	A
  0F89'   CD 1026'              	CALL	OVLAP
  0F8C'                         VPD_R:
  0F8C'   CD 1075'              	CALL	PGROWS		; RWR = the rows to go
