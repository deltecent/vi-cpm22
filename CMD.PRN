                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  091C'                         ATEOF:
  091C'   CD 0000*              	CALL	RGET0
  091F'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0922'                         LASTLN:
  0922'   2A 0000*              	LHLD	GAPBEG
  0925'   EB                    	XCHG
  0926'   2A 0000*              	LHLD	TXTBEG
  0929'   CD 0000*              	CALL	CMP16
  092C'   21 0000               	LXI	H,0
  092F'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0932'   1B                    	DCX	D
  0933'   1A                    	LDAX	D
  0934'   FE 0A                 	CPI	LF
  0936'   C2 0000*              	JNZ	SETBWD
  0939'   23                    	INX	H
  093A'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  093D'                         JKLAND:
  093D'   21 0000               	LXI	H,0
  0940'   22 246C'              	SHLD	JKVC		; screen column
  0943'   2B                    	DCX	H
  0944'   22 246E'              	SHLD	JKLS		; last content char: none yet
  0947'   CD 0000*              	CALL	RGET0
  094A'   11 0000               	LXI	D,0		; DE = chars read
  094D'                         JL_RD:
  094D'   CD 0000*              	CALL	RDGET
  0950'   DA 098A'              	JC	JL_END
  0953'   FE 0A                 	CPI	LF
  0955'   CA 098A'              	JZ	JL_END
  0958'   E5                    	PUSH	H
  0959'   C5                    	PUSH	B
  095A'   2A 246C'              	LHLD	JKVC
  095D'   CD 054B'              	CALL	CWID
  0960'   B7                    	ORA	A
  0961'   CA 0984'              	JZ	JL_NX		; a CR
  0964'   EB                    	XCHG
  0965'   22 246E'              	SHLD	JKLS		; the last content char so far
  0968'   EB                    	XCHG
  0969'   4F                    	MOV	C,A
  096A'   06 00                 	MVI	B,0
  096C'   09                    	DAD	B		; HL = the column after this char
  096D'   22 246C'              	SHLD	JKVC
  0970'   D5                    	PUSH	D
  0971'   EB                    	XCHG
  0972'   2A 245C'              	LHLD	GOALCOL
  0975'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0978'   D1                    	POP	D
