  10E9'                         VHD_0:
  10E9'   16 00                 	MVI	D,0
  10EB'                         VHD_1:
  10EB'   7A                    	MOV	A,D
  10EC'   B7                    	ORA	A
  10ED'   CA 1108'              	JZ	VHD_C		; the text stays
  10F0'   4A                    	MOV	C,D
  10F1'   CD 11FA'              	CALL	HTFQ		; HL -> the line that row is in, C = which of its
  10F4'   79                    	MOV	A,C
  10F5'   B7                    	ORA	A
  10F6'   CA 1108'              	JZ	VHD_C
  10F9'   BA                    	CMP	D
  10FA'   C2 1105'              	JNZ	VHD_R
  10FD'   7E                    	MOV	A,M		; the top line still: past all of it
  10FE'   91                    	SUB	C
  10FF'   83                    	ADD	E
  1100'   5F                    	MOV	E,A
  1101'   23                    	INX	H
  1102'   C3 1108'              	JMP	VHD_C
  1105'                         VHD_R:
  1105'   7B                    	MOV	A,E		; part of the way down a line: its start
  1106'   91                    	SUB	C
  1107'   5F                    	MOV	E,A
  1108'                         VHD_C:
  1108'   22 0000*              	SHLD	HFTP
  110B'   3A 0000*              	LDA	CSUB		; the cursor: E rows down from the one it is on
  110E'   83                    	ADD	E
  110F'   4F                    	MOV	C,A
  1110'   3A 0000*              	LDA	HTCUR
  1113'   CD 11DC'              	CALL	HTPT
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  1116'   CD 11FA'              	CALL	HTFQ
  1119'   D2 111D'              	JNC	HFEND
  111C'   2B                    	DCX	H		; the file ends first: its last line
                                ;HFEND -- ^D / ^U: HL -> the rows of the line the cursor goes to.
  111D'                         HFEND:
  111D'   EB                    	XCHG
  111E'   2A 0000*              	LHLD	HFTP
  1121'   EB                    	XCHG
                                ;HTLAND -- the cursor to the line whose rows HL points at, DE -> those of the
                                ; line the screen is to start with (never one under it); first non-blank.
  1122'                         HTLAND:
  1122'   E5                    	PUSH	H
  1123'   D5                    	PUSH	D
  1124'   CD 11EF'              	CALL	HTGO
  1127'   D1                    	POP	D
  1128'   E1                    	POP	H
  1129'   CD 0000*              	CALL	SUBHD		; HL = the lines between them
  112C'   7C                    	MOV	A,H
  112D'   B7                    	ORA	A
  112E'   7D                    	MOV	A,L
  112F'   CA 1133'              	JZ	HL_SET
  1132'   AF                    	XRA	A
  1133'                         HL_SET:
  1133'   CD 0EE1'              	CALL	SETRWT
  1136'   C3 095B'              	JMP	FNBLNK
                                
                                ;--- the top line is taller than the screen, and the cursor in it: vim goes
                                ;    on scrolling until the next line is at the top, the cursor keeping its
                                ;    row of the screen ---
  1139'                         VHD_TL:
  1139'   3A 0000*              	LDA	SKIPR
  113C'   47                    	MOV	B,A
  113D'   3A 0000*              	LDA	CSUB
  1140'   90                    	SUB	B		; A = that row
  1141'   F5                    	PUSH	PSW
  1142'   21 0001               	LXI	H,1
  1145'   CD 0A16'              	CALL	JCORE		; (on the last line: nowhere to go)
  1148'   F1                    	POP	PSW
  1149'   4F                    	MOV	C,A
  114A'   C5                    	PUSH	B
  114B'   0C                    	INR	C
  114C'   06 00                 	MVI	B,0
  114E'   CD 11D0'              	CALL	HTRB		; HL -> the rows of the line now the cursor's
  1151'   22 0000*              	SHLD	HFTP
  1154'   D1                    	POP	D
  1155'   4B                    	MOV	C,E
  1156'   CD 11FA'              	CALL	HTFQ
  1159'   D2 111D'              	JNC	HFEND
  115C'   2B                    	DCX	H
  115D'   C3 111D'              	JMP	HFEND
                                
                                ;VC_HFUP -- '^U': the text and the cursor up HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text
                                ; stops at the first line, the cursor goes on.  Where the rows end part of
                                ; the way up a line, the top line is the one under it and the cursor moves as
                                ; many rows less -- but the line itself, and as many more, when it is the
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


                                ; first one back.  On the first line nothing moves, the column included.
  1160'                         VC_HFUP:
  1160'   CD 0855'              	CALL	SETMOV
  1163'   CD 12DE'              	CALL	HFCNT		; HFN = the rows
  1166'   CD 12BE'              	CALL	ONFST
  1169'   C8                    	RZ			; the cursor is on the first line
  116A'   0E 01                 	MVI	C,1
  116C'   3A 0000*              	LDA	HFN
  116F'   CD 11BB'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  1172'   43                    	MOV	B,E
  1173'   3A 0000*              	LDA	HFN
  1176'   4F                    	MOV	C,A
  1177'   5F                    	MOV	E,A		; E = the rows the cursor moves
  1178'   CD 120B'              	CALL	HTBQ		; HL -> the line that row is in, C = its rows
  117B'   DA 1196'              	JC	VHU_C		;   above it; or the file's first line
  117E'   79                    	MOV	A,C
  117F'   B7                    	ORA	A
  1180'   CA 1196'              	JZ	VHU_C
  1183'   3A 0000*              	LDA	HTTP
  1186'   3D                    	DCR	A
  1187'   B8                    	CMP	B
  1188'   CA 1193'              	JZ	VHU_F
  118B'   7B                    	MOV	A,E		; part of the way up a line: the one under it
  118C'   96                    	SUB	M
  118D'   81                    	ADD	C
  118E'   5F                    	MOV	E,A
  118F'   23                    	INX	H
  1190'   C3 1196'              	JMP	VHU_C
  1193'                         VHU_F:
  1193'   7B                    	MOV	A,E		; ... the first line back: all of it
  1194'   81                    	ADD	C
  1195'   5F                    	MOV	E,A
  1196'                         VHU_C:
  1196'   22 0000*              	SHLD	HFTP
  1199'   4B                    	MOV	C,E
  119A'   3A 0000*              	LDA	HTCUR
  119D'   CD 11DC'              	CALL	HTPT		; HL -> the cursor line's rows, E = lines above it
  11A0'   3A 0000*              	LDA	CSUB
  11A3'   57                    	MOV	D,A
  11A4'   79                    	MOV	A,C
  11A5'   92                    	SUB	D		; the rows to go, less those of its own line above it
  11A6'   DA 111D'              	JC	HFEND
  11A9'   CA 111D'              	JZ	HFEND
  11AC'   4F                    	MOV	C,A
  11AD'   43                    	MOV	B,E
  11AE'   CD 120B'              	CALL	HTBQ		; (off the top: the file's first line)
  11B1'   C3 111D'              	JMP	HFEND
                                
                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
                                ;HTSCR -- the table as the last layout left it, which is the screen's own:
                                ; HL, B and E as HTSET gives them, and nothing measured.
  11B4'                         HTSCR:
  11B4'   CD 0EC2'              	CALL	CURRW
  11B7'   47                    	MOV	B,A
  11B8'   C3 11C6'              	JMP	HS_TP
  11BB'                         HTSET:
  11BB'   47                    	MOV	B,A
  11BC'   CD 0EC2'              	CALL	CURRW		; (keeps BC)
  11BF'   F5                    	PUSH	PSW
  11C0'   80                    	ADD	B
  11C1'   47                    	MOV	B,A
  11C2'   CD 11D0'              	CALL	HTRB
  11C5'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  11C6'                         HS_TP:
  11C6'   3A 0000*              	LDA	HTCUR
  11C9'   90                    	SUB	B
  11CA'   32 0000*              	STA	HTTP
  11CD'   C3 11DC'              	JMP	HTPT
  11D0'                         HTRB:
  11D0'   CD 13AE'              	CALL	ZSAVE
  11D3'   CD 0000*              	CALL	HTBLD
  11D6'   CD 13C1'              	CALL	ZREST
  11D9'   3A 0000*              	LDA	HTCUR
  11DC'                         HTPT:
  11DC'   5F                    	MOV	E,A
  11DD'   16 00                 	MVI	D,0
  11DF'   21 0000*              	LXI	H,HTAB
  11E2'   19                    	DAD	D
  11E3'   3A 0000*              	LDA	HTN
  11E6'   93                    	SUB	E
  11E7'   47                    	MOV	B,A
  11E8'   C9                    	RET
                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  11E9'                         HTIX:
  11E9'   11 0000*              	LXI	D,HTAB
  11EC'   7D                    	MOV	A,L
  11ED'   93                    	SUB	E
  11EE'   C9                    	RET
                                
                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
  11EF'                         HTGO:
  11EF'   CD 11E9'              	CALL	HTIX
  11F2'   47                    	MOV	B,A
  11F3'   3A 0000*              	LDA	HTCUR
  11F6'   90                    	SUB	B		; A = the lines up to it
  11F7'   C3 0EF9'              	JMP	MR_GO
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  11FA'                         HTFQ:
  11FA'   78                    	MOV	A,B
  11FB'   B7                    	ORA	A
  11FC'   37                    	STC
  11FD'   C8                    	RZ
  11FE'   79                    	MOV	A,C
  11FF'   96                    	SUB	M
  1200'   DA 1209'              	JC	HF_IN
  1203'   4F                    	MOV	C,A
  1204'   23                    	INX	H
  1205'   05                    	DCR	B
  1206'   C3 11FA'              	JMP	HTFQ
  1209'                         HF_IN:
  1209'   B7                    	ORA	A
  120A'   C9                    	RET
                                
                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
                                ;        the table starts first (HL -> its first entry, C = the rows short)
  120B'                         HTBQ:
  120B'   78                    	MOV	A,B
  120C'   B7                    	ORA	A
  120D'   37                    	STC
  120E'   C8                    	RZ
  120F'   2B                    	DCX	H
  1210'   05                    	DCR	B
  1211'   7E                    	MOV	A,M
  1212'   91                    	SUB	C
  1213'   D2 121C'              	JNC	HQ_IN
  1216'   2F                    	CMA
  1217'   3C                    	INR	A
  1218'   4F                    	MOV	C,A
  1219'   C3 120B'              	JMP	HTBQ
  121C'                         HQ_IN:
  121C'   4F                    	MOV	C,A
  121D'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
                                ; Keeps HL, B, DE.
  121E'                         RWQ:
  121E'   0E 64                 	MVI	C,100
  1220'   3A 0001*              	LDA	RWR+1
  1223'   B7                    	ORA	A
  1224'   C0                    	RNZ
  1225'   3A 0000*              	LDA	RWR
  1228'   B9                    	CMP	C
  1229'   D0                    	RNC
  122A'   4F                    	MOV	C,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  122B'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  122C'                         RWSUB:
  122C'   E5                    	PUSH	H
  122D'   5F                    	MOV	E,A
  122E'   16 00                 	MVI	D,0
  1230'   2A 0000*              	LHLD	RWR
  1233'   CD 0000*              	CALL	SUBHD
  1236'   22 0000*              	SHLD	RWR
  1239'   E1                    	POP	H
  123A'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
                                ; whose entry HL points at (B = the entries from it on), however far that is:
                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  123B'                         RWFWD:
  123B'   CD 121E'              	CALL	RWQ
  123E'   51                    	MOV	D,C
  123F'   CD 11FA'              	CALL	HTFQ
  1242'   F5                    	PUSH	PSW
  1243'   7A                    	MOV	A,D
  1244'   91                    	SUB	C		; the rows that took it to that line's first
  1245'   CD 122C'              	CALL	RWSUB
  1248'   F1                    	POP	PSW
  1249'   DA 125D'              	JC	RF_OFF
  124C'   3A 0001*              	LDA	RWR+1		; is what is left inside this line?
  124F'   B7                    	ORA	A
  1250'   C2 1267'              	JNZ	RF_GO
  1253'   3A 0000*              	LDA	RWR
  1256'   BE                    	CMP	M
  1257'   D2 1267'              	JNC	RF_GO
  125A'   4F                    	MOV	C,A
  125B'   B7                    	ORA	A
  125C'   C9                    	RET
  125D'                         RF_OFF:
  125D'   3A 0000*              	LDA	HTEOF
  1260'   B7                    	ORA	A
  1261'   CA 1267'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  1264'   2B                    	DCX	H
  1265'   37                    	STC
  1266'   C9                    	RET
  1267'                         RF_GO:
  1267'   CD 11EF'              	CALL	HTGO
  126A'   3E 01                 	MVI	A,1
  126C'   32 0000*              	STA	RWMV
  126F'   CD 121E'              	CALL	RWQ
  1272'   0C                    	INR	C
  1273'   06 00                 	MVI	B,0
  1275'   CD 11D0'              	CALL	HTRB
  1278'   C3 123B'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  127B'                         RWBAK:
  127B'   CD 121E'              	CALL	RWQ
  127E'   51                    	MOV	D,C
  127F'   CD 120B'              	CALL	HTBQ
  1282'   DA 129F'              	JC	RB_OFF
  1285'   7A                    	MOV	A,D
  1286'   81                    	ADD	C
  1287'   5F                    	MOV	E,A		; E = the rows up to that line's first
  1288'   3A 0001*              	LDA	RWR+1
  128B'   B7                    	ORA	A
  128C'   C2 129B'              	JNZ	RB_ON
  128F'   3A 0000*              	LDA	RWR
  1292'   57                    	MOV	D,A
  1293'   7B                    	MOV	A,E
  1294'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  1295'   DA 129B'              	JC	RB_ON
  1298'   4F                    	MOV	C,A
  1299'   B7                    	ORA	A
  129A'   C9                    	RET
  129B'                         RB_ON:
  129B'   7B                    	MOV	A,E
  129C'   C3 12A6'              	JMP	RB_GO
  129F'                         RB_OFF:
  129F'   3A 0000*              	LDA	HTBOF
  12A2'   0F                    	RRC			; CY: that is the file's first line
  12A3'   D8                    	RC
  12A4'   7A                    	MOV	A,D
  12A5'   91                    	SUB	C
  12A6'                         RB_GO:
  12A6'   CD 122C'              	CALL	RWSUB
  12A9'   CD 11EF'              	CALL	HTGO
  12AC'   3E 01                 	MVI	A,1
  12AE'   32 0000*              	STA	RWMV
  12B1'   CD 121E'              	CALL	RWQ
  12B4'   41                    	MOV	B,C
  12B5'   0E 01                 	MVI	C,1
  12B7'   CD 11D0'              	CALL	HTRB
  12BA'   43                    	MOV	B,E
  12BB'   C3 127B'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  12BE'                         ONFST:
  12BE'   E5                    	PUSH	H
  12BF'   2A 0000*              	LHLD	OUTPOS
  12C2'   7C                    	MOV	A,H
  12C3'   B5                    	ORA	L
  12C4'   C2 12DC'              	JNZ	OF_RET
  12C7'   2A 0000*              	LHLD	TXTBEG
  12CA'   EB                    	XCHG			; DE = TXTBEG
  12CB'   2A 0000*              	LHLD	GAPBEG
  12CE'                         OF_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12CE'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  12D1'   CA 12DC'              	JZ	OF_RET
  12D4'   2B                    	DCX	H
  12D5'   7E                    	MOV	A,M
  12D6'   FE 0A                 	CPI	LF
  12D8'   C2 12CE'              	JNZ	OF_LP
  12DB'   B7                    	ORA	A		; NZ
  12DC'                         OF_RET:
  12DC'   E1                    	POP	H
  12DD'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  12DE'                         HFCNT:
  12DE'   2A 0000*              	LHLD	CMDCNT
  12E1'   7C                    	MOV	A,H
  12E2'   B5                    	ORA	L
  12E3'   CA 12FA'              	JZ	HFC_AM
  12E6'   CD 0780'              	CALL	GETCNT		; HL = count; clears it
  12E9'   3A 0000*              	LDA	NEDIT
  12EC'   5F                    	MOV	E,A
  12ED'   16 00                 	MVI	D,0
  12EF'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  12F2'   D2 12F6'              	JNC	HFC_ST
  12F5'   EB                    	XCHG			; HL = NEDIT
  12F6'                         HFC_ST:
  12F6'   7D                    	MOV	A,L
  12F7'   32 0000*              	STA	HFAMT
  12FA'                         HFC_AM:
  12FA'   3A 0000*              	LDA	HFAMT
  12FD'   B7                    	ORA	A
  12FE'   C2 130B'              	JNZ	HFC_HL
  1301'   3A 0000*              	LDA	NEDIT
  1304'   B7                    	ORA	A
  1305'   1F                    	RAR
  1306'   B7                    	ORA	A
  1307'   C2 130B'              	JNZ	HFC_HL
  130A'   3C                    	INR	A		; at least one row
  130B'                         HFC_HL:
  130B'   32 0000*              	STA	HFN
  130E'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  130F'                         VC_REDR:
  130F'   C3 0780'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (PLACE) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  1312'                         VC_G:
  1312'   CD 0855'              	CALL	SETMOV
  1315'   CD 13D4'              	CALL	GZONE		; the screen's top line, before the move
  1318'   CD 07A9'              	CALL	BRKON		; ... and an ESC may stop it from here on
  131B'   2A 0000*              	LHLD	CMDCNT
  131E'   7C                    	MOV	A,H
  131F'   B5                    	ORA	L
  1320'   C2 1333'              	JNZ	VG_N
  1323'   AF                    	XRA	A		; forward
  1324'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  1327'   CD 07E6'              	CALL	BRKOFF
  132A'   DA 07FE'              	JC	BRKBAK
  132D'   CD 0BE4'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  1330'   C3 13EC'              	JMP	GPLACE
  1333'                         VG_N:
  1333'   CD 0780'              	CALL	GETCNT		; HL = target line (1-based)
  1336'                         VG_LN:
  1336'   CD 1342'              	CALL	GOLN
  1339'   CD 07E6'              	CALL	BRKOFF
  133C'   DA 07FE'              	JC	BRKBAK
  133F'   C3 13EC'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  1342'                         GOLN:
  1342'   E5                    	PUSH	H
  1343'   CD 0000*              	CALL	CNTLF
  1346'   23                    	INX	H		; HL = the cursor's line
  1347'   D1                    	POP	D		; DE = the line wanted
  1348'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  134B'   DA 1356'              	JC	GLN_BK
  134E'   EB                    	XCHG
  134F'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  1352'   AF                    	XRA	A
  1353'   C3 135B'              	JMP	GLN_MV
  1356'                         GLN_BK:
  1356'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  1359'   3E FF                 	MVI	A,0FFH
  135B'                         GLN_MV:
  135B'   CD 0000*              	CALL	MVLIND
  135E'   CD 0BDE'              	CALL	ATEOF
  1361'   DC 0BE4'              	CC	LASTLN		; past the last line: onto it
  1364'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  1365'                         VC_LG:
  1365'   CD 0855'              	CALL	SETMOV
  1368'   3A 0000*              	LDA	GSAVE
  136B'   B7                    	ORA	A
  136C'   C2 1375'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  136F'   3E 01                 	MVI	A,PG
  1371'   32 0000*              	STA	GPEND
  1374'   C9                    	RET
  1375'                         VLG_GG:
  1375'   CD 13D4'              	CALL	GZONE
  1378'   CD 07A9'              	CALL	BRKON
  137B'   CD 0780'              	CALL	GETCNT		; HL = target line (no count: 1)
  137E'   C3 1336'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  1381'                         SUB24:
  1381'   4F                    	MOV	C,A
  1382'   7D                    	MOV	A,L
  1383'   93                    	SUB	E
  1384'   6F                    	MOV	L,A
  1385'   7C                    	MOV	A,H
  1386'   9A                    	SBB	D
  1387'   67                    	MOV	H,A
  1388'   79                    	MOV	A,C
  1389'   98                    	SBB	B
  138A'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  138B'                         CURFP:
  138B'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  138E'                         FPOS:
  138E'   C5                    	PUSH	B
  138F'   D5                    	PUSH	D
  1390'   EB                    	XCHG
  1391'   2A 0000*              	LHLD	TXTBEG
  1394'   EB                    	XCHG
  1395'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  1398'   EB                    	XCHG			; DE = that
  1399'   2A 0000*              	LHLD	OUTPOS
  139C'   7C                    	MOV	A,H
  139D'   B7                    	ORA	A		; CY = 0
  139E'   1F                    	RAR
  139F'   47                    	MOV	B,A
  13A0'   7D                    	MOV	A,L
  13A1'   1F                    	RAR
  13A2'   67                    	MOV	H,A
  13A3'   3E 00                 	MVI	A,0
  13A5'   1F                    	RAR
  13A6'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  13A7'   19                    	DAD	D
  13A8'   78                    	MOV	A,B
  13A9'   CE 00                 	ACI	0		; A:HL = the position
  13AB'   D1                    	POP	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  13AC'   C1                    	POP	B
  13AD'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  13AE'                         ZSAVE:
  13AE'   2A 0000*              	LHLD	CMDCNT
  13B1'   22 0000*              	SHLD	ZSVCNT
  13B4'   2A 0000*              	LHLD	AUXCNT
  13B7'   22 0000*              	SHLD	ZSVAUX
  13BA'   3A 0000*              	LDA	DIRFLG
  13BD'   32 0000*              	STA	ZSVDIR
  13C0'   C9                    	RET
  13C1'                         ZREST:
  13C1'   2A 0000*              	LHLD	ZSVCNT
  13C4'   22 0000*              	SHLD	CMDCNT
  13C7'   2A 0000*              	LHLD	ZSVAUX
  13CA'   22 0000*              	SHLD	AUXCNT
  13CD'   3A 0000*              	LDA	ZSVDIR
  13D0'   32 0000*              	STA	DIRFLG
  13D3'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  13D4'                         GZONE:
  13D4'   CD 13AE'              	CALL	ZSAVE
  13D7'   CD 0EC2'              	CALL	CURRW
  13DA'   6F                    	MOV	L,A
  13DB'   26 00                 	MVI	H,0
  13DD'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  13E0'   CD 138E'              	CALL	FPOS
  13E3'   22 0000*              	SHLD	ZTOP
  13E6'   32 0002*              	STA	ZTOP+2
  13E9'   C3 13C1'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  13EC'                         GPLACE:
  13EC'   CD 13AE'              	CALL	ZSAVE
  13EF'   CD 138B'              	CALL	CURFP
  13F2'   EB                    	XCHG
  13F3'   2A 0000*              	LHLD	ZTOP
  13F6'   EB                    	XCHG
  13F7'   4F                    	MOV	C,A		; C:HL = the target's position
  13F8'   3A 0002*              	LDA	ZTOP+2
  13FB'   47                    	MOV	B,A		; B:DE = the top's
  13FC'   79                    	MOV	A,C
  13FD'   CD 1381'              	CALL	SUB24
  1400'   22 0000*              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  1403'   DA 143D'              	JC	GP_UP
  1406'   B7                    	ORA	A
  1407'   C2 1483'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  140A'   3A 0000*              	LDA	NEDIT
  140D'   87                    	ADD	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  140E'   3C                    	INR	A
  140F'   6F                    	MOV	L,A
  1410'   26 00                 	MVI	H,0
  1412'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  1415'   CD 0779'              	CALL	GBSUB		; HL = bytes from there to the target
  1418'   EB                    	XCHG
  1419'   2A 0000*              	LHLD	ZDIF		; HL = bytes from the top to the target
  141C'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  141F'   DA 1483'              	JC	GP_MID
  1422'   CD 0779'              	CALL	GBSUB		; HL = the top line's start (resident)
  1425'   01 0000               	LXI	B,0		; BC = lines from the top
  1428'                         GP_CNT:
  1428'   7A                    	MOV	A,D
  1429'   B3                    	ORA	E
  142A'   CA 1439'              	JZ	GP_DN
  142D'   7E                    	MOV	A,M
  142E'   23                    	INX	H
  142F'   1B                    	DCX	D
  1430'   FE 0A                 	CPI	LF
  1432'   C2 1428'              	JNZ	GP_CNT
  1435'   03                    	INX	B
  1436'   C3 1428'              	JMP	GP_CNT
  1439'                         GP_DN:
  1439'   79                    	MOV	A,C		; the lines from the top one to it
  143A'   C3 14AD'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  143D'                         GP_UP:
  143D'   3C                    	INR	A
  143E'   C2 1483'              	JNZ	GP_MID		; 64K bytes or more above
  1441'   2A 0000*              	LHLD	ZDIF
  1444'   EB                    	XCHG
  1445'   21 0000               	LXI	H,0
  1448'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  144B'   7C                    	MOV	A,H
  144C'   B5                    	ORA	L
  144D'   CA 1483'              	JZ	GP_MID		; exactly 64K
  1450'   EB                    	XCHG			; DE = bytes to read
  1451'   AF                    	XRA	A
  1452'   32 0000*              	STA	ZLF
  1455'   CD 0000*              	CALL	RGET0
  1458'                         GP_RD:
  1458'   CD 0000*              	CALL	RDGET		; (keeps DE)
  145B'   DA 1483'              	JC	GP_MID
  145E'   FE 0A                 	CPI	LF
  1460'   C2 1474'              	JNZ	GP_RN
  1463'   3A 0000*              	LDA	NEDIT
  1466'   B7                    	ORA	A
  1467'   1F                    	RAR
  1468'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  146A'   E5                    	PUSH	H
  146B'   21 0000*              	LXI	H,ZLF
  146E'   34                    	INR	M
  146F'   BE                    	CMP	M		; CY iff more lines than that
  1470'   E1                    	POP	H
  1471'   DA 1483'              	JC	GP_MID
  1474'                         GP_RN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  1474'   1B                    	DCX	D
  1475'   7A                    	MOV	A,D
  1476'   B3                    	ORA	E
  1477'   C2 1458'              	JNZ	GP_RD
  147A'   3E 01                 	MVI	A,PL_SET	; the top row
  147C'   32 0000*              	STA	PLACE
  147F'   AF                    	XRA	A
  1480'   C3 148D'              	JMP	GP_SET
  1483'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  1483'   3E 02                 	MVI	A,PL_MID
  1485'   32 0000*              	STA	PLACE		; mid-screen, as the rows fall
  1488'   3A 0000*              	LDA	NEDIT
  148B'   B7                    	ORA	A
  148C'   1F                    	RAR			; (no more lines above it than this)
  148D'                         GP_SET:
  148D'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  148E'   26 00                 	MVI	H,0
  1490'   22 0000*              	SHLD	WINROW
  1493'   21 0000               	LXI	H,0
  1496'   22 0000*              	SHLD	LNDLT
  1499'   CD 0892'              	CALL	SETFUL		; the window may have paged: full repaint
  149C'                         GP_FIN:
  149C'   CD 13C1'              	CALL	ZREST
  149F'   3A 0000*              	LDA	GPKEEP
  14A2'   B7                    	ORA	A
  14A3'   CA 095B'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  14A6'   AF                    	XRA	A
  14A7'   32 0000*              	STA	GPKEEP
  14AA'   C3 0614'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
                                ; adds LNDLT to it and arrives at the same line.
  14AD'                         GP_ONS:
  14AD'   6F                    	MOV	L,A
  14AE'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  14B0'   EB                    	XCHG
  14B1'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  14B4'   EB                    	XCHG
  14B5'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  14B8'   22 0000*              	SHLD	LNDLT
  14BB'   3E 01                 	MVI	A,R_MOVE
  14BD'   32 0000*              	STA	RINTENT
  14C0'   C3 149C'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  14C3'                         OPPEND:
  14C3'   AF                    	XRA	A
  14C4'   32 0000*              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  14C7'   3A 0000*              	LDA	PSAVE
  14CA'   FE 63                 	CPI	'c'
  14CC'   C2 14E9'              	JNZ	OPP_ND
  14CF'   79                    	MOV	A,C
  14D0'   FE 77                 	CPI	'w'
  14D2'   CA 14DA'              	JZ	OPP_W
  14D5'   FE 57                 	CPI	'W'
  14D7'   C2 14E9'              	JNZ	OPP_ND
  14DA'                         OPP_W:
  14DA'   CD 16C4'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  14DD'   DA 14E9'              	JC	OPP_ND
  14E0'   79                    	MOV	A,C
  14E1'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  14E3'   4F                    	MOV	C,A
  14E4'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  14E6'   32 0000*              	STA	CWEOL		;   char for the next word's: see ESTEP
  14E9'                         OPP_ND:
  14E9'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  14EA'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  14EC'   C2 1500'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  14EF'   CD 01FC'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  14F2'   DA 1598'              	JC	OPABRT
  14F5'   79                    	MOV	A,C
  14F6'   FE 67                 	CPI	'g'
  14F8'   C2 1598'              	JNZ	OPABRT
  14FB'   3E 01                 	MVI	A,PG
  14FD'   32 0000*              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  1500'                         OPP_NG:
  1500'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  1501'   21 0000*              	LXI	H,PSAVE
  1504'   BE                    	CMP	M
  1505'   CA 16E5'              	JZ	OPLINE
  1508'   79                    	MOV	A,C		; (OPCLS classifies the key)
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  1509'   CD 16FB'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  150C'   DA 1598'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  150F'   32 0000*              	STA	OPCLSV
  1512'   47                    	MOV	B,A		; B = the class
  1513'   3A 0000*              	LDA	PSAVE
  1516'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  1518'   C2 1524'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  151B'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  151C'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  151E'   C2 1546'              	JNZ	OPP_GO
  1521'   C3 152F'              	JMP	OPP_NO
  1524'                         OPP_NC:
  1524'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  1526'   C2 1546'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  1529'   78                    	MOV	A,B		;   a charwise register would need a type flag
  152A'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  152C'   CA 1546'              	JZ	OPP_GO		;   within a line -- neither of which is built
  152F'                         OPP_NO:
  152F'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  1530'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  1532'   CA 1540'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  1535'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  1537'   CA 1540'              	JZ	OPP_SW		;   so swallow it before dropping the command
  153A'   CD 0329'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  153D'   C2 1598'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  1540'                         OPP_SW:
  1540'   CD 01FC'              	CALL	MKGETK
  1543'   C3 1598'              	JMP	OPABRT
  1546'                         OPP_GO:
  1546'   AF                    	XRA	A
  1547'   32 0000*              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  154A'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  154D'   22 0000*              	SHLD	OPSTA
  1550'   C5                    	PUSH	B
  1551'   21 0000*              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  1554'   CD 042C'              	CALL	FPSTO		;   only good until the motion pages the window
  1557'   3A 0000*              	LDA	OPCLSV
  155A'   FE 02                 	CPI	2
  155C'   CC 159B'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  155F'   C1                    	POP	B
  1560'   21 3104'              	LXI	H,CMDTAB
  1563'   CD 00C6'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1566'   3A 0000*              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1569'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  156A'   CA 0855'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  156D'   3A 0000*              	LDA	OPCLSV
  1570'   FE 02                 	CPI	2
  1572'   CC 0948'              	CZ	LNEND		; a line motion: the line it landed on whole, or
                                				;   the span ends inside it (#38).  It may page
                                				;   the start out; OPSFIX asks next
  1575'   CD 15C7'              	CALL	OPSFIX		; where the start is in the window NOW
  1578'   D2 15E3'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  157B'   22 0000*              	SHLD	OPSTA
  157E'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1581'   22 0000*              	SHLD	OPEND2
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  1584'   3A 0000*              	LDA	PSAVE
  1587'   FE 79                 	CPI	'y'
  1589'   CA 1C9D'              	JZ	OPYANK		; a yank takes the span without losing it
  158C'   CD 1736'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  158F'   3A 0000*              	LDA	PSAVE
  1592'   FE 63                 	CPI	'c'
  1594'   C0                    	RNZ
  1595'   C3 1A51'              	JMP	SETINS
  1598'                         OPABRT:				; not a motion -> the operator is dropped and
  1598'   C3 00A9'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  159B'                         OPENDS:
  159B'   2A 0000*              	LHLD	OPSTA
  159E'   CD 067B'              	CALL	BOL
  15A1'   11 0000*              	LXI	D,OPSLO
  15A4'   CD 15B9'              	CALL	OPE_ST
  15A7'   2A 0000*              	LHLD	OPSTA
  15AA'   CD 0712'              	CALL	NLSTART
  15AD'   11 0000*              	LXI	D,OPSHI
  15B0'   CD 15B9'              	CALL	OPE_ST
  15B3'   2A 0000*              	LHLD	OPSTA
  15B6'   C3 0000*              	JMP	GOTO
  15B9'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  15B9'   D5                    	PUSH	D
  15BA'   CD 0000*              	CALL	GOTO
  15BD'   E1                    	POP	H
  15BE'   C3 042C'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  15C1'                         CURBD:
  15C1'   CD 138B'              	CALL	CURFP
  15C4'   EB                    	XCHG
  15C5'   47                    	MOV	B,A
  15C6'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  15C7'                         OPSFIX:
  15C7'   21 0000*              	LXI	H,OPSFP
  15CA'   CD 03DF'              	CALL	MKLOAD
  15CD'   CD 15C1'              	CALL	CURBD
  15D0'   2A 0000*              	LHLD	MKPOS
  15D3'   3A 0002*              	LDA	MKPOS+2
  15D6'   CD 1381'              	CALL	SUB24
  15D9'   B4                    	ORA	H
  15DA'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  15DB'   C2 03EC'              	JNZ	MKWIN
  15DE'   CD 0000*              	CALL	CUROFF
  15E1'   37                    	STC
  15E2'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  15E3'                         OPPGD:
  15E3'   47                    	MOV	B,A
  15E4'   3A 0000*              	LDA	OPCLSV
  15E7'   FE 02                 	CPI	2
  15E9'   C2 16A5'              	JNZ	OPG_NO
  15EC'   3A 0000*              	LDA	PSAVE
  15EF'   FE 64                 	CPI	'd'
  15F1'   C2 16A5'              	JNZ	OPG_NO
  15F4'   04                    	INR	B
  15F5'   CA 1604'              	JZ	OPG_FW
  15F8'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  15FB'   CD 067B'              	CALL	BOL		;   and the high end is OPSHI as it stands
  15FE'   CD 0000*              	CALL	GOTO
  1601'   C3 161C'              	JMP	OPG_GO
  1604'                         OPG_FW:
  1604'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  1607'   CD 0712'              	CALL	NLSTART		;   landed on, and the low one is where the
  160A'   11 0000*              	LXI	D,OPSHI		;   start line began
  160D'   CD 15B9'              	CALL	OPE_ST
  1610'   21 0000*              	LXI	H,OPSLO
  1613'   CD 03DF'              	CALL	MKLOAD
  1616'   CD 03AC'              	CALL	MKPAGE
  1619'   CD 0000*              	CALL	GOTO
  161C'                         OPG_GO:
  161C'   CD 15C1'              	CALL	CURBD
  161F'   2A 0000*              	LHLD	OPSHI
  1622'   3A 0002*              	LDA	OPSHI+2
  1625'   CD 1381'              	CALL	SUB24		; A:HL = the bytes to take
  1628'                         OPG_SV:
  1628'   22 0000*              	SHLD	OPTOGO
  162B'   32 0002*              	STA	OPTOGO+2
  162E'                         OPG_NX:
  162E'   CD 075C'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  1631'   CD 0000*              	CALL	SUBHD
  1634'   EB                    	XCHG			; DE = what the window holds past the cursor
  1635'   2A 0000*              	LHLD	OPTOGO
  1638'   3A 0002*              	LDA	OPTOGO+2
  163B'   B7                    	ORA	A
  163C'   C2 166F'              	JNZ	OPG_PG		; 64K or more to go
  163F'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  1642'   DA 166F'              	JC	OPG_PG
  1645'   CA 166F'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  1648'                         OPG_FN:				; the rest of it is here
  1648'   E5                    	PUSH	H
  1649'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  164C'   CD 0000*              	CALL	CUROFF
  164F'   22 0000*              	SHLD	OPLO
  1652'   D1                    	POP	D
  1653'   19                    	DAD	D
  1654'   22 0000*              	SHLD	OPHI
  1657'   CD 1869'              	CALL	OPDSPN
  165A'   CD 0BDE'              	CALL	ATEOF
  165D'   D2 16BE'              	JNC	OPMID
  1660'   CD 12BE'              	CALL	ONFST		; deleted to the end of the file: onto the new
  1663'   CA 16BE'              	JZ	OPMID		;   last line, if there is one -- and the pager
  1666'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  1669'   CD 0000*              	CALL	SETBWD
  166C'   C3 16BE'              	JMP	OPMID
  166F'                         OPG_PG:
  166F'   7A                    	MOV	A,D
  1670'   B3                    	ORA	E
  1671'   C2 168A'              	JNZ	OPG_DL
  1674'   CD 0BDE'              	CALL	ATEOF		; nothing held past the cursor
  1677'   21 0000               	LXI	H,0
  167A'   DA 1648'              	JC	OPG_FN		; ... and no more to come: the file ran out
  167D'   2B                    	DCX	H
  167E'   CD 0000*              	CALL	SETC0
  1681'   CD 0000*              	CALL	GOLINE
  1684'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  1687'   C3 162E'              	JMP	OPG_NX
  168A'                         OPG_DL:
  168A'   D5                    	PUSH	D
  168B'   21 FFFF               	LXI	H,0FFFFH
  168E'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1691'   E1                    	POP	H
  1692'   E5                    	PUSH	H
  1693'   CD 0000*              	CALL	DELFWD
  1696'   D1                    	POP	D
  1697'   06 00                 	MVI	B,0
  1699'   2A 0000*              	LHLD	OPTOGO
  169C'   3A 0002*              	LDA	OPTOGO+2
  169F'   CD 1381'              	CALL	SUB24
  16A2'   C3 1628'              	JMP	OPG_SV
  16A5'                         OPG_NO:
  16A5'   0E 07                 	MVI	C,BEL
  16A7'   CD 0000*              	CALL	BCONOU
  16AA'                         OPG_HM:				; the cursor back where the command found it
  16AA'   21 0000*              	LXI	H,OPSFP
  16AD'   CD 03DF'              	CALL	MKLOAD
  16B0'   CD 03AC'              	CALL	MKPAGE
  16B3'   CD 0000*              	CALL	GOTO
  16B6'   AF                    	XRA	A
  16B7'   32 0000*              	STA	PSAVE
  16BA'   3C                    	INR	A
  16BB'   32 0000*              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  16BE'                         OPMID:
  16BE'   CD 13AE'              	CALL	ZSAVE
  16C1'   C3 1483'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  16C4'                         ONWHIT:
  16C4'   CD 075C'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  16C7'   CA 16E3'              	JZ	OW_YES
  16CA'   CD 0767'              	CALL	CURCHR		; A = the char under the cursor
  16CD'   FE 20                 	CPI	' '
  16CF'   CA 16E3'              	JZ	OW_YES
  16D2'   FE 09                 	CPI	TAB
  16D4'   CA 16E3'              	JZ	OW_YES
  16D7'   FE 0D                 	CPI	CR
  16D9'   CA 16E3'              	JZ	OW_YES
  16DC'   FE 0A                 	CPI	LF
  16DE'   CA 16E3'              	JZ	OW_YES
  16E1'   B7                    	ORA	A		; a char to change: CY clear
  16E2'   C9                    	RET
  16E3'                         OW_YES:
  16E3'   37                    	STC
  16E4'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  16E5'                         OPLINE:
  16E5'   3A 0000*              	LDA	PSAVE
  16E8'   FE 63                 	CPI	'c'
  16EA'   CA 0855'              	JZ	SETMOV
  16ED'   FE 79                 	CPI	'y'
  16EF'   CA 1C7C'              	JZ	VY_YY
  16F2'   21 0000*              	LXI	H,OPSFP		; where the cursor is, for a count the register
  16F5'   CD 042C'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  16F8'   C3 1BF2'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  16FB'                         OPCLS:
  16FB'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  16FD'   CA 170A'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  1700'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  1702'   C2 171E'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1705'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1707'   C3 170C'              	JMP	OPC_FK
  170A'                         OPC_SEM:
  170A'   06 00                 	MVI	B,0		; ';' runs it as it stands
  170C'                         OPC_FK:
  170C'   3A 0000*              	LDA	FNDKND
  170F'   B7                    	ORA	A
  1710'   37                    	STC
  1711'   C8                    	RZ			; nothing looked for yet: not a motion, so the
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1712'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1713'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1715'   CA 171C'              	JZ	OPC_EXC
  1718'   3E 01                 	MVI	A,1
  171A'   B7                    	ORA	A		; CY clear: a motion, class 1
  171B'   C9                    	RET
  171C'                         OPC_EXC:
  171C'   AF                    	XRA	A		; class 0, CY clear
  171D'   C9                    	RET
  171E'                         OPC_TB:
  171E'   47                    	MOV	B,A
  171F'   21 190E'              	LXI	H,OPCTAB
  1722'                         OPC_LP:
  1722'   7E                    	MOV	A,M
  1723'   B7                    	ORA	A
  1724'   CA 1734'              	JZ	OPC_MS		; end of table -> not a motion
  1727'   B8                    	CMP	B
  1728'   CA 1730'              	JZ	OPC_HT
  172B'   23                    	INX	H
  172C'   23                    	INX	H
  172D'   C3 1722'              	JMP	OPC_LP
  1730'                         OPC_HT:
  1730'   23                    	INX	H
  1731'   7E                    	MOV	A,M		; class byte
  1732'   B7                    	ORA	A		; clear CY
  1733'   C9                    	RET
  1734'                         OPC_MS:
  1734'   37                    	STC
  1735'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  1736'                         OPAPPL:
  1736'   3A 0000*              	LDA	OPCLSV
  1739'   FE 02                 	CPI	2
  173B'   CA 18E2'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  173E'   2A 0000*              	LHLD	OPSTA
  1741'   EB                    	XCHG			; DE = start
  1742'   2A 0000*              	LHLD	OPEND2		; HL = end
  1745'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  1748'   DA 175B'              	JC	OPA_F
  174B'   CA 175B'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  174E'   22 0000*              	SHLD	OPLO
  1751'   EB                    	XCHG
  1752'   22 0000*              	SHLD	OPHI
  1755'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  1758'   C3 1812'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  175B'                         OPA_F:
  175B'   EB                    	XCHG			; HL = start, DE = end
  175C'   22 0000*              	SHLD	OPLO
  175F'   EB                    	XCHG			; HL = end
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  1760'   3A 0000*              	LDA	OPCLSV
  1763'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1765'   CA 180F'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  1768'   FE 01                 	CPI	1
  176A'   C2 178C'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  176D'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  176E'   22 0000*              	SHLD	OPHI		; park it: CEND clobbers DE
  1771'   2B                    	DCX	H		; the line it landed on
  1772'   CD 19CF'              	CALL	CEND		; HL = that line's content end
  1775'   EB                    	XCHG			; DE = it
  1776'   2A 0000*              	LHLD	OPHI		; HL = hi
  1779'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  177C'   D2 1797'              	JNC	OPA_HI		; hi is inside the line: keep it
  177F'   2A 0000*              	LHLD	OPLO
  1782'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1785'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  1788'   EB                    	XCHG			; HL = the content end: the span stops there
  1789'   C3 1797'              	JMP	OPA_HI
  178C'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  178C'   22 0000*              	SHLD	OPHI
  178F'   3A 0000*              	LDA	WPULL
  1792'   B7                    	ORA	A
  1793'   CA 1812'              	JZ	OPA_C1
  1796'   23                    	INX	H
  1797'                         OPA_HI:
  1797'   22 0000*              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  179A'                         OPA_DO:
  179A'   CD 185E'              	CALL	OPSPNL
  179D'   7C                    	MOV	A,H
  179E'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  179F'   C2 17A8'              	JNZ	OPA_D1
  17A2'   2A 0000*              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  17A5'   C3 0000*              	JMP	GOTO		;   to where the span starts
  17A8'                         OPA_D1:
  17A8'   3A 0000*              	LDA	PSAVE
  17AB'   FE 63                 	CPI	'c'
  17AD'   CA 1869'              	JZ	OPDSPN
  17B0'   CD 1851'              	CALL	SPNBRK
  17B3'   D2 17D4'              	JNC	OPA_D2
  17B6'   2A 0000*              	LHLD	OPHI
  17B9'   CD 19CF'              	CALL	CEND
  17BC'   EB                    	XCHG			; DE = the content end of the line it ends in
  17BD'   2A 0000*              	LHLD	OPHI
  17C0'                         OPA_BL:
  17C0'   CD 0000*              	CALL	CMP16
  17C3'   CA 17DA'              	JZ	OPA_BI		; only blanks after it
  17C6'   D5                    	PUSH	D
  17C7'   E5                    	PUSH	H
  17C8'   CD 0000*              	CALL	CHARAT
  17CB'   E1                    	POP	H
  17CC'   D1                    	POP	D
  17CD'   23                    	INX	H
  17CE'   CD 1809'              	CALL	BLANKQ
  17D1'   CA 17C0'              	JZ	OPA_BL
  17D4'                         OPA_D2:
  17D4'   CD 1869'              	CALL	OPDSPN
  17D7'   C3 19E0'              	JMP	CLAMPE
  17DA'                         OPA_BI:
  17DA'   CD 17EC'              	CALL	LOIND
  17DD'   C2 17D4'              	JNZ	OPA_D2
  17E0'   2A 0000*              	LHLD	OPHI
  17E3'   CD 0712'              	CALL	NLSTART
  17E6'   22 0000*              	SHLD	OPHI
  17E9'   C3 183D'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  17EC'                         LOIND:
  17EC'   2A 0000*              	LHLD	OPLO
  17EF'   CD 067B'              	CALL	BOL
  17F2'                         LI_LP:
  17F2'   E5                    	PUSH	H
  17F3'   EB                    	XCHG
  17F4'   2A 0000*              	LHLD	OPLO
  17F7'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  17FA'   E1                    	POP	H
  17FB'   C8                    	RZ
  17FC'   E5                    	PUSH	H
  17FD'   CD 0000*              	CALL	CHARAT
  1800'   E1                    	POP	H
  1801'   23                    	INX	H
  1802'   CD 1809'              	CALL	BLANKQ
  1805'   CA 17F2'              	JZ	LI_LP
  1808'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  1809'                         BLANKQ:
  1809'   FE 20                 	CPI	' '
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  180B'   C8                    	RZ
  180C'   FE 09                 	CPI	TAB
  180E'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  180F'                         OPA_JP:
  180F'   22 0000*              	SHLD	OPHI
  1812'                         OPA_C1:
  1812'   CD 185E'              	CALL	OPSPNL
  1815'   7C                    	MOV	A,H
  1816'   B5                    	ORA	L
  1817'   CA 179A'              	JZ	OPA_DO		; nothing spanned
  181A'   2A 0000*              	LHLD	OPHI
  181D'   CD 067B'              	CALL	BOL
  1820'   EB                    	XCHG
  1821'   2A 0000*              	LHLD	OPHI
  1824'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  1827'   C2 179A'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  182A'   CD 17EC'              	CALL	LOIND
  182D'   CA 183D'              	JZ	C1_LW		; only blanks before lo: whole lines
  1830'                         C1_CH:
  1830'   2A 0000*              	LHLD	OPHI		; back over the line break to the content end
  1833'   2B                    	DCX	H		;   of the line before
  1834'   CD 19CF'              	CALL	CEND
  1837'   22 0000*              	SHLD	OPHI
  183A'   C3 179A'              	JMP	OPA_DO
  183D'                         C1_LW:
  183D'   2A 0000*              	LHLD	OPLO
  1840'   CD 067B'              	CALL	BOL
  1843'   22 0000*              	SHLD	OPLO
  1846'   3A 0000*              	LDA	PSAVE
  1849'   FE 63                 	CPI	'c'
  184B'   CA 1830'              	JZ	C1_CH
  184E'   C3 18F5'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  1851'                         SPNBRK:
  1851'   2A 0000*              	LHLD	OPLO
  1854'   CD 06BE'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  1857'   EB                    	XCHG			; DE = it
  1858'   2A 0000*              	LHLD	OPHI
  185B'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  185E'                         OPSPNL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  185E'   2A 0000*              	LHLD	OPHI
  1861'   EB                    	XCHG
  1862'   2A 0000*              	LHLD	OPLO
  1865'   EB                    	XCHG			; HL = hi, DE = lo
  1866'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
                                ; No break in it: 'dw' 'cw' 'D' changed one row, and only that row is stale.
                                ; And from where the cursor was on (OPSTA: 'dw', not 'db'), the terminal may
                                ; close the cells up.
  1869'                         OPDSPN:
  1869'   CD 1851'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  186C'   F5                    	PUSH	PSW
  186D'   2A 0000*              	LHLD	OPSTA
  1870'   EB                    	XCHG
  1871'   2A 0000*              	LHLD	OPLO
  1874'   22 0000*              	SHLD	WKI
  1877'   CD 0000*              	CALL	CMP16
  187A'   F5                    	PUSH	PSW		; Z: the span starts under the screen's cursor
  187B'   CD 0000*              	CALL	GOTO
  187E'   CD 185E'              	CALL	OPSPNL		; HL = hi - lo
  1881'   CD 085B'              	CALL	SETLIN
  1884'   F1                    	POP	PSW
  1885'   CC 199E'              	CZ	DCHQ
  1888'   CD 0000*              	CALL	DELFWD
  188B'   CD 0177'              	CALL	MARKMOD
  188E'   F1                    	POP	PSW
  188F'   D0                    	RNC
  1890'   C3 0892'              	JMP	SETFUL		; a break went: every row below it moved up
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  1893'                         UNDFNB:
  1893'   CD 0000*              	CALL	CUROFF
  1896'   E5                    	PUSH	H
  1897'   CD 095B'              	CALL	FNBLNK
  189A'   CD 0000*              	CALL	CUROFF
  189D'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  189E'   CD 0000*              	CALL	CMP16
  18A1'   D2 0000*              	JNC	UNDHER
  18A4'   EB                    	XCHG
  18A5'   CD 0000*              	CALL	GOTO
  18A8'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  18AB'                         OPALSP:
  18AB'   2A 0000*              	LHLD	OPSTA
  18AE'   EB                    	XCHG
  18AF'   2A 0000*              	LHLD	OPEND2
  18B2'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  18B5'   DA 18C5'              	JC	OPAL_F
  18B8'   22 0000*              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  18BB'   EB                    	XCHG
  18BC'   22 0000*              	SHLD	OPHI		; hi-src = start
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  18BF'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  18C2'   C3 18CF'              	JMP	OPAL_R
  18C5'                         OPAL_F:
  18C5'   EB                    	XCHG			; HL = start
  18C6'   22 0000*              	SHLD	OPLO		; lo-src = start
  18C9'   2A 0000*              	LHLD	OPEND2
  18CC'   22 0000*              	SHLD	OPHI		; hi-src = end
  18CF'                         OPAL_R:
  18CF'   2A 0000*              	LHLD	OPLO
  18D2'   CD 067B'              	CALL	BOL
  18D5'   22 0000*              	SHLD	OPLO		; lo = BOL(low line)
  18D8'   2A 0000*              	LHLD	OPHI
  18DB'   CD 0712'              	CALL	NLSTART
  18DE'   22 0000*              	SHLD	OPHI		; hi = start of line past the high line
  18E1'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  18E2'                         OPALIN:
  18E2'   CD 18AB'              	CALL	OPALSP
  18E5'   2A 0000*              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  18E8'   CD 0712'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  18EB'   EB                    	XCHG			;   the column)
  18EC'   2A 0000*              	LHLD	OPHI
  18EF'   CD 0000*              	CALL	CMP16
  18F2'   CC 1893'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  18F5'                         OPDLIN:
  18F5'   CD 1869'              	CALL	OPDSPN
  18F8'   CD 075C'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  18FB'   DA 190B'              	JC	OPDL_NB
  18FE'   CD 0000*              	CALL	LOGLEN
  1901'   7C                    	MOV	A,H
  1902'   B5                    	ORA	L
  1903'   C8                    	RZ			; empty buffer
  1904'   2B                    	DCX	H
  1905'   CD 067B'              	CALL	BOL
  1908'   CD 0000*              	CALL	GOTO
  190B'                         OPDL_NB:
  190B'   C3 095B'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  190E'                         OPCTAB:
  190E'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1912'   62 00 42 00           
  1916'   68 00 6C 00           
  191A'   30 00 5E 00           
  191E'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1920'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1924'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1928'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  192C'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1930'   24 01                 
  1932'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1936'   47 02 48 02           
  193A'   4D 02 4C 02           
  193E'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  1940'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1942'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1943'                         VCB_C:
  1943'   CD 194F'              	CALL	VCB_CD
  1946'   C3 1A51'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  1949'                         VCB_D:
  1949'   CD 194F'              	CALL	VCB_CD
  194C'   C3 19E0'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  194F'                         VCB_CD:
  194F'   CD 0773'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1952'   22 0000*              	SHLD	OPLO
  1955'   22 0000*              	SHLD	OPSTA
  1958'   CD 0000*              	CALL	CUROFF
  195B'   CD 19CF'              	CALL	CEND		; to the line's content end, the CR,LF left
  195E'   22 0000*              	SHLD	OPHI
  1961'   C3 1869'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  1964'                         VC_X:
  1964'   CD 0A0D'              	CALL	GLSTAL
  1967'   CD 085B'              	CALL	SETLIN
  196A'   CD 0780'              	CALL	GETCNT
  196D'   22 0000*              	SHLD	CNTV
  1970'   CD 0000*              	CALL	CUROFF
  1973'   22 0000*              	SHLD	WKI		; cur
  1976'   CD 19CF'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  1979'   EB                    	XCHG			; DE = contentend
  197A'   2A 0000*              	LHLD	WKI		; HL = cur
  197D'   EB                    	XCHG			; HL = contentend, DE = cur
  197E'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  1981'   7C                    	MOV	A,H
  1982'   B5                    	ORA	L
  1983'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  1984'   EB                    	XCHG			; DE = available
  1985'   2A 0000*              	LHLD	CNTV		; HL = count
  1988'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  198B'   DA 1991'              	JC	VX_USEA
  198E'   C3 1992'              	JMP	VX_DEL		; count <= available -> HL = count = del
  1991'                         VX_USEA:
  1991'   EB                    	XCHG			; HL = available
  1992'                         VX_DEL:
  1992'   CD 199E'              	CALL	DCHQ
  1995'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  1998'   CD 0177'              	CALL	MARKMOD
  199B'   C3 19E0'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;DCHQ -- HL bytes are about to go from under the cursor, none of them a line
                                ; end, and WKI is the cursor's offset.  Plain chars, and plain chars after
                                ; them: the terminal can close the cells up itself (R_DCH).  A TAB there would
                                ; change width.  Keeps HL.
  199E'                         DCHQ:
  199E'   E5                    	PUSH	H
  199F'   CD 0898'              	CALL	TAILTAB
  19A2'   E1                    	POP	H
  19A3'   47                    	MOV	B,A
  19A4'   7C                    	MOV	A,H		; (more of them than a byte counts)
  19A5'   B7                    	ORA	A
  19A6'   C0                    	RNZ
  19A7'   B5                    	ORA	L
  19A8'   C8                    	RZ			; (or none at all)
  19A9'   32 31BD'              	STA	DCHN
  19AC'   78                    	MOV	A,B
  19AD'   87                    	ADD	A
  19AE'   32 0000*              	STA	DCHBS		; 2: a TAB follows, to take the cells up
  19B1'   CA 19C9'              	JZ	DQ_0
  19B4'   7D                    	MOV	A,L		; ... if it is past what goes, and can
  19B5'   FE 08                 	CPI	8
  19B7'   D0                    	RNC
  19B8'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  19B9'   2A 0000*              	LHLD	WKI
  19BC'   EB                    	XCHG
  19BD'   2A 0000*              	LHLD	TTI
  19C0'   CD 0000*              	CALL	SUBHD
  19C3'   EB                    	XCHG			; DE = the chars before it
  19C4'   E1                    	POP	H
  19C5'   CD 0000*              	CALL	CMP16
  19C8'   D8                    	RC
  19C9'                         DQ_0:
  19C9'   3E 07                 	MVI	A,R_DCH
  19CB'   32 0000*              	STA	RINTENT
  19CE'   C9                    	RET
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  19CF'                         CEND:
  19CF'   CD 06BE'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  19D2'   7C                    	MOV	A,H
  19D3'   B5                    	ORA	L
  19D4'   C8                    	RZ			; the start of the text: nothing before it
  19D5'   2B                    	DCX	H
  19D6'   E5                    	PUSH	H
  19D7'   CD 0000*              	CALL	CHARAT
  19DA'   E1                    	POP	H		; HL = term-1
  19DB'   FE 0D                 	CPI	CR
  19DD'   C8                    	RZ			; a CR before the LF -> the content ends there
  19DE'   23                    	INX	H
  19DF'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  19E0'                         CLAMPE:
  19E0'   CD 0000*              	CALL	CUROFF
  19E3'   E5                    	PUSH	H
  19E4'   CD 0721'              	CALL	EOLC
  19E7'   D1                    	POP	D		; DE = cur
  19E8'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  19EB'   D8                    	RC
  19EC'   C8                    	RZ
  19ED'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  19F0'                         VC_I:
  19F0'   CD 0780'              	CALL	GETCNT
  19F3'   C3 1A4E'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  19F6'                         VC_A:
  19F6'   CD 0780'              	CALL	GETCNT
  19F9'   CD 075C'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  19FC'   CA 1A13'              	JZ	VA_INS
  19FF'   EB                    	XCHG			; HL = cur
  1A00'   E5                    	PUSH	H
  1A01'   CD 0000*              	CALL	CHARAT
  1A04'   E1                    	POP	H
  1A05'   FE 0A                 	CPI	LF
  1A07'   CA 1A13'              	JZ	VA_INS		; on the line terminator -> append in place
  1A0A'   FE 0D                 	CPI	CR
  1A0C'   CA 1A13'              	JZ	VA_INS
  1A0F'   23                    	INX	H
  1A10'   CD 0000*              	CALL	GOTO
  1A13'                         VA_INS:
  1A13'   C3 1A4E'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1A16'                         VCB_A:
  1A16'   CD 0773'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A19'   CD 0721'              	CALL	EOLC		; HL = last content char (the start when empty)
  1A1C'   E5                    	PUSH	H
  1A1D'   CD 0000*              	CALL	CHARAT
  1A20'   E1                    	POP	H
  1A21'   FE 0D                 	CPI	CR
  1A23'   CA 1A2C'              	JZ	VBA_IN		; an empty line: insert at its start
  1A26'   FE 0A                 	CPI	LF
  1A28'   CA 1A2C'              	JZ	VBA_IN
  1A2B'   23                    	INX	H		; past the last content char
  1A2C'                         VBA_IN:
  1A2C'   CD 0000*              	CALL	GOTO
  1A2F'   C3 1A4E'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1A32'                         VCB_I:
  1A32'   CD 0780'              	CALL	GETCNT
  1A35'   CD 095B'              	CALL	FNBLNK
  1A38'   CD 0000*              	CALL	CUROFF
  1A3B'   E5                    	PUSH	H
  1A3C'   CD 0000*              	CALL	CHARAT
  1A3F'   E1                    	POP	H
  1A40'   FE 20                 	CPI	' '
  1A42'   CA 1A4A'              	JZ	VBI_SK
  1A45'   FE 09                 	CPI	TAB
  1A47'   C2 1A4E'              	JNZ	SETINM
  1A4A'                         VBI_SK:
  1A4A'   23                    	INX	H		; blanks only: past the last of them
  1A4B'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1A4E'                         SETINM:
  1A4E'   CD 0855'              	CALL	SETMOV
  1A51'                         SETINS:
  1A51'   3E 01                 	MVI	A,EM_INS
  1A53'   32 0000*              	STA	EDMODE
  1A56'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1A57'                         ATCEND:
  1A57'   CD 075C'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1A5A'   C8                    	RZ
  1A5B'   CD 0767'              	CALL	CURCHR		; A = the char under the cursor
  1A5E'   FE 0D                 	CPI	CR
  1A60'   C8                    	RZ
  1A61'   FE 0A                 	CPI	LF
  1A63'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1A64'                         OPNBRK:
  1A64'   CD 23DA'              	CALL	PUTBRK
  1A67'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1A6A'   23                    	INX	H
  1A6B'   22 0000*              	SHLD	LNDLT
  1A6E'   C3 0177'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1A71'                         ENDBRK:
  1A71'   CD 075C'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1A74'   C0                    	RNZ
  1A75'   CD 1A64'              	CALL	OPNBRK
  1A78'   CD 0000*              	CALL	CUROFF
  1A7B'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1A7C'   2B                    	DCX	H		;   line, with its own terminator after it
  1A7D'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1A80'                         VC_O:
  1A80'   CD 0773'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A83'   CD 19CF'              	CALL	CEND
  1A86'   CD 0000*              	CALL	GOTO
  1A89'   CD 1A64'              	CALL	OPNBRK
  1A8C'   CD 1A71'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1A8F'   CD 087D'              	CALL	SETILN		;   needs a terminator of its own to exist
  1A92'   C3 1A51'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1A95'                         VCB_O:
  1A95'   CD 0773'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A98'   CD 067B'              	CALL	BOL
  1A9B'   CD 0000*              	CALL	GOTO
  1A9E'   CD 1A64'              	CALL	OPNBRK
  1AA1'   CD 0000*              	CALL	CUROFF
  1AA4'   2B                    	DCX	H
  1AA5'   2B                    	DCX	H
  1AA6'   CD 0000*              	CALL	GOTO
  1AA9'   CD 087D'              	CALL	SETILN
  1AAC'   C3 1A51'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  1AAF'                         VCB_J:
  1AAF'   CD 0773'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1AB2'   CD 19CF'              	CALL	CEND		; the join point: this line's content end
  1AB5'   22 0000*              	SHLD	OPLO
  1AB8'   CD 0000*              	CALL	CUROFF
  1ABB'   CD 0712'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1ABE'   E5                    	PUSH	H
  1ABF'   CD 0000*              	CALL	LOGLEN
  1AC2'   D1                    	POP	D		; DE = that start
  1AC3'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1AC6'   CA 0855'              	JZ	SETMOV
  1AC9'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1ACA'                         VJ_WS:
  1ACA'   E5                    	PUSH	H
  1ACB'   CD 0000*              	CALL	LOGLEN
  1ACE'   D1                    	POP	D		; DE = the scan
  1ACF'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1AD2'   CA 1AE9'              	JZ	VJ_DEL
  1AD5'   EB                    	XCHG			; HL = the scan
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1AD6'   E5                    	PUSH	H
  1AD7'   CD 0000*              	CALL	CHARAT
  1ADA'   E1                    	POP	H
  1ADB'   FE 20                 	CPI	' '
  1ADD'   CA 1AE5'              	JZ	VJ_SKIP
  1AE0'   FE 09                 	CPI	TAB
  1AE2'   C2 1AE9'              	JNZ	VJ_DEL
  1AE5'                         VJ_SKIP:
  1AE5'   23                    	INX	H
  1AE6'   C3 1ACA'              	JMP	VJ_WS
  1AE9'                         VJ_DEL:
  1AE9'   22 0000*              	SHLD	OPHI
  1AEC'   CD 1869'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1AEF'   CD 088C'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1AF2'   CD 075C'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1AF5'   CA 19E0'              	JZ	CLAMPE
  1AF8'   CD 0767'              	CALL	CURCHR		; the first char of what was appended
  1AFB'   FE 0D                 	CPI	CR
  1AFD'   CA 19E0'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1B00'   FE 0A                 	CPI	LF
  1B02'   CA 19E0'              	JZ	CLAMPE
  1B05'   FE 29                 	CPI	')'
  1B07'   CA 19E0'              	JZ	CLAMPE		; vim puts no space before a ')'
  1B0A'   CD 0000*              	CALL	CUROFF
  1B0D'   7C                    	MOV	A,H
  1B0E'   B5                    	ORA	L
  1B0F'   CA 1B25'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1B12'   2B                    	DCX	H
  1B13'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1B16'   FE 20                 	CPI	' '
  1B18'   CA 19E0'              	JZ	CLAMPE
  1B1B'   FE 09                 	CPI	TAB
  1B1D'   CA 19E0'              	JZ	CLAMPE
  1B20'   FE 0A                 	CPI	LF
  1B22'   CA 19E0'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1B25'                         VJ_SP:
  1B25'   3E 20                 	MVI	A,' '
  1B27'   CD 0000*              	CALL	PUTGAP
  1B2A'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1B2D'   2B                    	DCX	H
  1B2E'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1B31'                         VC_TILD:
  1B31'   CD 0780'              	CALL	GETCNT
  1B34'   CD 085B'              	CALL	SETLIN		; only this row changes
  1B37'   CD 0A0D'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1B3A'   CD 075C'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1B3D'   CA 0855'              	JZ	SETMOV
  1B40'   CD 0767'              	CALL	CURCHR		; A = the char under the cursor
  1B43'   FE 0D                 	CPI	CR
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1B45'   CA 0855'              	JZ	SETMOV		; the line's end: nothing to toggle
  1B48'   FE 0A                 	CPI	LF
  1B4A'   CA 0855'              	JZ	SETMOV
  1B4D'   47                    	MOV	B,A
  1B4E'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1B50'   FE 41                 	CPI	'A'
  1B52'   DA 1B5E'              	JC	VT_PUT		; below 'A': no case
  1B55'   FE 5B                 	CPI	'Z'+1
  1B57'   D2 1B5E'              	JNC	VT_PUT		; above 'Z': no case
  1B5A'   78                    	MOV	A,B
  1B5B'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1B5D'   47                    	MOV	B,A
  1B5E'                         VT_PUT:
  1B5E'   78                    	MOV	A,B
  1B5F'   32 0000*              	STA	VRCH		; the calls below do not preserve B
  1B62'   CD 0177'              	CALL	MARKMOD
  1B65'   21 0001               	LXI	H,1
  1B68'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1B6B'   3A 0000*              	LDA	VRCH
  1B6E'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1B71'   C3 19E0'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  1B74'                         VC_R:
  1B74'   CD 076D'              	CALL	MOVCNT		; a cursor motion, and its count
  1B77'   3E 03                 	MVI	A,PR
  1B79'   32 0000*              	STA	GPEND
  1B7C'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1B7D'                         VR_DO:
  1B7D'   AF                    	XRA	A
  1B7E'   32 0000*              	STA	GPEND
  1B81'   79                    	MOV	A,C
  1B82'   32 0000*              	STA	VRCH		; the calls below do not preserve C
  1B85'   CD 085B'              	CALL	SETLIN		; only this row changed
  1B88'   CD 0A0D'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1B8B'   CD 075C'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1B8E'   CA 0855'              	JZ	SETMOV		; the end of the text: vim does nothing
  1B91'   CD 0767'              	CALL	CURCHR		; A = the char under the cursor
  1B94'   FE 0D                 	CPI	CR
  1B96'   CA 0855'              	JZ	SETMOV		; the line's end: nothing to replace
  1B99'   FE 0A                 	CPI	LF
  1B9B'   CA 0855'              	JZ	SETMOV
  1B9E'   06 02                 	MVI	B,2		; a cell for a cell: the char is the paint
  1BA0'   CD 0861'              	CALL	SETCEL
  1BA3'   CD 0177'              	CALL	MARKMOD
  1BA6'   21 0001               	LXI	H,1
  1BA9'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1BAC'   3A 0000*              	LDA	VRCH
  1BAF'   FE 0D                 	CPI	CR
  1BB1'   CA 1BBE'              	JZ	VR_CR
  1BB4'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1BB7'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1BBA'   2B                    	DCX	H		;   out, which moves every logical offset
  1BBB'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1BBE'                         VR_CR:
  1BBE'   CD 1A64'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1BC1'   CD 1A71'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1BC4'   CD 087D'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1BC7'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1BC9'   32 0000*              	STA	ILABOV
  1BCC'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1BCD'                         VCB_R:
  1BCD'   CD 0780'              	CALL	GETCNT
  1BD0'   CD 0855'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1BD3'   21 0000               	LXI	H,0
  1BD6'   22 0000*              	SHLD	RPDEL		; nothing of ours to put back yet
  1BD9'   22 0000*              	SHLD	RPAPP
  1BDC'   3E 02                 	MVI	A,EM_REP
  1BDE'   32 0000*              	STA	EDMODE
  1BE1'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1BE2'                         VC_D:
  1BE2'   3E 64                 	MVI	A,'d'
  1BE4'   32 0000*              	STA	PENDOP
  1BE7'   C3 0855'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1BEA'                         VC_C:
  1BEA'   3E 63                 	MVI	A,'c'
  1BEC'   32 0000*              	STA	PENDOP
  1BEF'   C3 0855'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1BF2'                         VD_DD:
  1BF2'   CD 0A0D'              	CALL	GLSTAL
  1BF5'   CD 0780'              	CALL	GETCNT
  1BF8'   22 0000*              	SHLD	CNTV
  1BFB'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1BFD'   32 0000*              	STA	DDSNG
  1C00'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1C01'   7C                    	MOV	A,H
  1C02'   B5                    	ORA	L
  1C03'   C2 1C11'              	JNZ	VDD_LS
  1C06'   3E 01                 	MVI	A,1
  1C08'   32 0000*              	STA	DDSNG
  1C0B'   CD 1893'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1C0E'   C3 1C17'              	JMP	VDD_GO
  1C11'                         VDD_LS:
  1C11'   CD 09C6'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1C14'   DA 0855'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1C17'                         VDD_GO:
  1C17'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1C1A'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1C1D'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1C20'   CD 263D'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1C23'   CD 0937'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1C26'   2A 0000*              	LHLD	CNTV
  1C29'   CD 0000*              	CALL	SETC0
  1C2C'                         VDD_FW:
  1C2C'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1C2F'   DA 1D7D'              	JC	QREFUS		; ... which has no room for them
  1C32'   CD 0795'              	CALL	CNTTST
  1C35'   C2 1C2C'              	JNZ	VDD_FW
  1C38'   CD 0177'              	CALL	MARKMOD
  1C3B'   CD 0BDE'              	CALL	ATEOF
  1C3E'   D2 1C59'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1C41'   3E 00                 	MVI	A,0
  1C43'   32 0000*              	STA	DDSNG		; deleted to the end: full repaint
  1C46'   CD 12BE'              	CALL	ONFST
  1C49'   CA 095B'              	JZ	FNBLNK		; nothing left before it
  1C4C'   21 0001               	LXI	H,1		; onto the new last line
  1C4F'   CD 0000*              	CALL	SETBWD
  1C52'   2A 0000*              	LHLD	LNDLT
  1C55'   2B                    	DCX	H
  1C56'   22 0000*              	SHLD	LNDLT
  1C59'                         VDD_UP:
  1C59'   CD 095B'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1C5C'   3A 0000*              	LDA	DDSNG
  1C5F'   B7                    	ORA	A
  1C60'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1C61'   3E 03                 	MVI	A,R_DLIN
  1C63'   32 0000*              	STA	RINTENT
  1C66'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1C67'                         QEMPTY:
  1C67'   2A 0000*              	LHLD	QBEG
  1C6A'   EB                    	XCHG
  1C6B'   2A 0000*              	LHLD	QEND
  1C6E'   7C                    	MOV	A,H
  1C6F'   BA                    	CMP	D
  1C70'   C0                    	RNZ
  1C71'   7D                    	MOV	A,L
  1C72'   BB                    	CMP	E
  1C73'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1C74'                         VC_Y:
  1C74'   3E 79                 	MVI	A,'y'
  1C76'   32 0000*              	STA	PENDOP
  1C79'   C3 0855'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1C7C'                         VY_YY:
  1C7C'   21 0000*              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1C7F'   CD 042C'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1C82'   CD 0000*              	CALL	CUROFF
  1C85'   22 0000*              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1C88'   CD 067B'              	CALL	BOL
  1C8B'   22 0000*              	SHLD	YPT		; where the lines come from, to put them back
  1C8E'   CD 1E2A'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1C91'   CD 1E6D'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1C94'   D2 1E31'              	JNC	YNDONE
  1C97'   21 1BF2'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1C9A'   C3 1CC6'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1C9D'                         OPYANK:
  1C9D'   CD 18AB'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1CA0'   2A 0000*              	LHLD	OPSTA
  1CA3'   EB                    	XCHG			; DE = start
  1CA4'   2A 0000*              	LHLD	OPEND2		; HL = end
  1CA7'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1CAA'   D2 1CAE'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1CAD'   EB                    	XCHG			; ... otherwise the start is
  1CAE'                         OPY_LO:
  1CAE'   22 0000*              	SHLD	YOFF
  1CB1'   2A 0000*              	LHLD	OPLO
  1CB4'   22 0000*              	SHLD	YPT		; where the lines come from, to put them back
  1CB7'   CD 1E2A'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1CBA'   CD 1EE5'              	CALL	YNSPAN		; copied where they lie, if there is room
  1CBD'   D2 1E31'              	JNC	YNDONE
  1CC0'   21 1DF5'              	LXI	H,YSPAN
  1CC3'   C3 1CC6'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1CC6'                         YKGO:
  1CC6'   22 0000*              	SHLD	YACT
  1CC9'   2A 0000*              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1CCC'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1CCD'   2A 0000*              	LHLD	YOFF		;   survive this -- the put-back below can page
  1CD0'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1CD3'   22 0000*              	SHLD	YCOL		;   them -- but a distance within the lines does
  1CD6'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1CD9'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1CDA'   2A 0000*              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1CDD'   EB                    	XCHG			;   window as it was, then names other text
  1CDE'   E1                    	POP	H
  1CDF'   CD 0000*              	CALL	SUBHD
  1CE2'   EB                    	XCHG			; DE = how far behind the cursor they start
  1CE3'   CD 138B'              	CALL	CURFP
  1CE6'   06 00                 	MVI	B,0
  1CE8'   CD 1381'              	CALL	SUB24
  1CEB'   22 0000*              	SHLD	YPFP
  1CEE'   32 0002*              	STA	YPFP+2
  1CF1'   3A 0000*              	LDA	MODF
  1CF4'   32 0000*              	STA	YMODF
  1CF7'   3A 0000*              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1CFA'   32 0000*              	STA	YDCHG		;   a yank must not become the last change
  1CFD'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1D00'   32 0000*              	STA	YURPL		;   back are not a change to undo either
  1D03'   3E 01                 	MVI	A,1
  1D05'   32 0000*              	STA	UNDRPL
  1D08'   32 0000*              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1D0B'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1D0E'   22 0000*              	SHLD	YLDLT
  1D11'   CD 0000*              	CALL	LOGLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1D14'   22 0000*              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1D17'   2A 0000*              	LHLD	YACT
  1D1A'   CD 1D7C'              	CALL	YCALL		; the lines out of the file, into the register
  1D1D'   3A 0000*              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1D20'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1D22'   CA 1D60'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1D25'   CD 0000*              	CALL	LOGLEN
  1D28'   EB                    	XCHG
  1D29'   2A 0000*              	LHLD	YWAS
  1D2C'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1D2F'   CA 1D41'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1D32'   21 0000*              	LXI	H,YPFP		; back to where they came from, by its place in
  1D35'   CD 03DF'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1D38'   CD 03AC'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1D3B'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1D3E'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1D41'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1D41'   2A 0000*              	LHLD	YPFP		;   cursor is still owed its place)
  1D44'   EB                    	XCHG
  1D45'   2A 0000*              	LHLD	YCOL
  1D48'   19                    	DAD	D
  1D49'   22 0000*              	SHLD	MKPOS
  1D4C'   3A 0002*              	LDA	YPFP+2
  1D4F'   CE 00                 	ACI	0
  1D51'   32 0002*              	STA	MKPOS+2
  1D54'   CD 03AC'              	CALL	MKPAGE
  1D57'   CD 0000*              	CALL	GOTO
  1D5A'                         YK_RST:
  1D5A'   2A 0000*              	LHLD	YLDLT
  1D5D'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1D60'                         YK_RF:
  1D60'   3A 0000*              	LDA	YMODF
  1D63'   32 0000*              	STA	MODF
  1D66'   3A 0000*              	LDA	YDCHG
  1D69'   32 0000*              	STA	DOTCHG
  1D6C'   3A 0000*              	LDA	YURPL
  1D6F'   32 0000*              	STA	UNDRPL
  1D72'   AF                    	XRA	A
  1D73'   32 0000*              	STA	MKHOLD
  1D76'   CD 0A0D'              	CALL	GLSTAL
  1D79'   C3 0892'              	JMP	SETFUL		; the cheap paint cannot carry this
  1D7C'   E9                    YCALL:	PCHL
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1D7D'                         QREFUS:
  1D7D'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1D80'   CD 1C67'              	CALL	QEMPTY
  1D83'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1D86'   CD 0000*              	CALL	QKILL
  1D89'   3A 0000*              	LDA	MKHOLD
  1D8C'   B7                    	ORA	A
  1D8D'   C2 1D9C'              	JNZ	QRF_Y
  1D90'   21 0000*              	LXI	H,MKSAV
  1D93'   11 0000*              	LXI	D,MKTAB
  1D96'   CD 263D'              	CALL	COPY12
  1D99'   CD 0000*              	CALL	UNDCLR
  1D9C'                         QRF_Y:
  1D9C'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1D9E'   32 0000*              	STA	MSGWHT
  1DA1'   C3 16AA'              	JMP	OPG_HM
                                
                                ;MEMABT -- the arena has no room for what this key asked of it: WordMaster's
                                ; 'MEM SHORTAGE', 'MEM FULL' or 'QBUF FULL', which BUF.MAC's MEMERR sends here
                                ; once the screen is up (issue #39).  WordMaster abandons the command there and
                                ; goes back to its prompt, and so does this: the key's stack goes, and with it
                                ; whatever the key was part way through.  Each of those errors is raised before
                                ; a byte of text moves, so the text is whole, though not all of the change may
                                ; have been made.  The register is emptied -- it is what holds the room -- or
                                ; the repaint that follows would run into the same wall, and the half-done
                                ; command leaves nothing behind: no count, no pending operator, no '.' to repeat
                                ; it and no 'u' to undo half of it.  The bottom row says so.
                                ;
                                ; Two cases still end the editor, through ERRMSG as all three always did: a
                                ; second shortage before the next key (the repaint, with the register already
                                ; given back -- there is nothing left to give), and one in the middle of a yank
                                ; that took its lines OUT to put them back (YKGO, MKHOLD set): the register IS
                                ; those lines then, and emptying it would cut them from the file.
  1DA4'                         MEMABT:
  1DA4'   3A 0000*              	LDA	ABTFLG
  1DA7'   21 0000*              	LXI	H,MKHOLD
  1DAA'   B6                    	ORA	M
  1DAB'   C2 0000*              	JNZ	ERRMSG		; the message is still on the stack for it
  1DAE'   3C                    	INR	A		; A = 1
  1DAF'   32 0000*              	STA	ABTFLG		; ... until the next key (CMDDIS)
  1DB2'   31 0000*              	LXI	SP,VISTK	; the key's stack: VI.MAC's loop runs at the top
  1DB5'   32 0000*              	STA	MODF		; the text may have changed part way
  1DB8'   32 0000*              	STA	FORCEF		; the frame on the screen may be half drawn
  1DBB'   32 0000*              	STA	DOTOVF		; a half command is no change for '.'
  1DBE'   3A 0000*              	LDA	EDMODE		; in insert or replace mode the recording runs
  1DC1'   B7                    	ORA	A		;   on to the ESC, DOTOVF keeping it from '.';
  1DC2'   C2 1DCC'              	JNZ	MAB_1		;   otherwise the next key starts a new one
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1DC5'   32 0000*              	STA	DOTCHG
  1DC8'   3C                    	INR	A
  1DC9'   32 31C0'              	STA	DOTSTA
  1DCC'                         MAB_1:
  1DCC'   AF                    	XRA	A
  1DCD'   32 0000*              	STA	GPEND
  1DD0'   32 0000*              	STA	PENDOP
  1DD3'   32 0000*              	STA	DOTRPL		; a '.' replay is over
  1DD6'   32 0000*              	STA	UNDRPL		; ... and so is a 'u' one
  1DD9'   32 0000*              	STA	BRKARM
  1DDC'   32 0000*              	STA	BRKHIT
  1DDF'   CD 0000*              	CALL	CLRCNT		; no count
  1DE2'   CD 0000*              	CALL	UNDCLR		; nothing 'u' can trust
  1DE5'   CD 0000*              	CALL	QKILL		; the room back
  1DE8'   3E 05                 	MVI	A,MW_MEM
  1DEA'   32 0000*              	STA	MSGWHT
  1DED'   3E 00                 	MVI	A,R_FULL
  1DEF'   32 0000*              	STA	RINTENT
  1DF2'   C3 0000*              	JMP	MLDRAW		; VI.MAC: the repaint, then the next key
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the REGISTER holds the
                                ; span's length, and asks for ONE line a pass.
                                ;
                                ; The register, not the text: this loop used to stop when the text in RAM was
                                ; the span's length shorter than at the start (issue #32).  But QPUTLN's MKGAP
                                ; can page the window's top out to make room, and every record that goes takes
                                ; 128 bytes off the text that this loop never took.  With the arena nearly
                                ; full the page-outs alone went past that target, and the loop stopped after a
                                ; line, or partway through one (GOLINE stops short when the window pages): the
                                ; register held 49 bytes of a 631-byte 'y''a', and YKGO put back only those.
                                ; The register starts empty (QKILL below) and only this loop fills it, so its
                                ; length is exactly what has been taken, whatever the pager did meanwhile.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1DF5'                         YSPAN:
  1DF5'   CD 0A0D'              	CALL	GLSTAL
  1DF8'   CD 185E'              	CALL	OPSPNL		; HL = the span's length
  1DFB'   22 0000*              	SHLD	YTGT		; what the register holds when the span is out
  1DFE'   2A 0000*              	LHLD	OPLO
  1E01'   CD 0000*              	CALL	GOTO
  1E04'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1E07'                         YS_LP:
  1E07'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1E0A'   CD 0000*              	CALL	SETC0
  1E0D'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1E10'   DA 1D7D'              	JC	QREFUS		; ... which has no room for it
  1E13'   2A 0000*              	LHLD	QBEG
  1E16'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1E17'   2A 0000*              	LHLD	QEND
  1E1A'   CD 0000*              	CALL	SUBHD
  1E1D'   EB                    	XCHG			; DE = what the register holds
  1E1E'   2A 0000*              	LHLD	YTGT
  1E21'   CD 0000*              	CALL	CMP16		; CY iff it is short of the span: another pass
  1E24'   DA 1E07'              	JC	YS_LP		;   (never more than the span over whole lines)
  1E27'   C3 0177'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1E2A'                         YNPRE:
  1E2A'   2A 0000*              	LHLD	PGTOPM
  1E2D'   22 0000*              	SHLD	YNPG
  1E30'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1E31'                         YNDONE:
  1E31'   2A 0000*              	LHLD	YOFF
  1E34'   CD 0000*              	CALL	GOTO
  1E37'   2A 0000*              	LHLD	PGTOPM
  1E3A'   EB                    	XCHG
  1E3B'   2A 0000*              	LHLD	YNPG
  1E3E'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1E41'   C2 0892'              	JNZ	SETFUL		; it moved under us: repaint after all
  1E44'   C3 0855'              	JMP	SETMOV		; nothing on the screen changed
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1E47'                         YNROOM:
  1E47'   11 0100               	LXI	D,100H
  1E4A'   19                    	DAD	D
  1E4B'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1E4C'   E5                    	PUSH	H		; the span plus its slack
  1E4D'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1E50'   EB                    	XCHG			; HL = free
  1E51'   D1                    	POP	D		; DE = the span plus its slack
  1E52'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1E55'   DA 1E5D'              	JC	YNR_OK
  1E58'   CA 1E5D'              	JZ	YNR_OK
  1E5B'   37                    	STC			; not enough: the delete-and-put-back path
  1E5C'   C9                    	RET
  1E5D'                         YNR_OK:
  1E5D'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1E5E'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1E5F'                         YNGO:
  1E5F'   C5                    	PUSH	B
  1E60'   CD 0780'              	CALL	GETCNT		; spent here: this yank is happening
  1E63'   CD 0A0D'              	CALL	GLSTAL
  1E66'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1E69'   C1                    	POP	B
  1E6A'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1E6D'                         YNCOPY:
  1E6D'   2A 0000*              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1E70'   7C                    	MOV	A,H		;   the count itself
  1E71'   B5                    	ORA	L
  1E72'   C2 1E78'              	JNZ	YNC_HV
  1E75'   21 0001               	LXI	H,1
  1E78'                         YNC_HV:
  1E78'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1E79'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1E7A'   B4                    	ORA	H
  1E7B'   CA 1E86'              	JZ	YNC_M
  1E7E'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1E7F'   CD 09C6'              	CALL	ONLAST		; vim: a count over one on the last line does
  1E82'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1E83'   DA 1E98'              	JC	YNC_RF
  1E86'                         YNC_M:
  1E86'   E5                    	PUSH	H
  1E87'   CD 0937'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1E8A'   E1                    	POP	H
  1E8B'   CD 1EA0'              	CALL	YNLINE		; BC = the span, measured where it stands
  1E8E'   D8                    	RC			; not measurable here: let the pager answer it
  1E8F'   60                    	MOV	H,B
  1E90'   69                    	MOV	L,C
  1E91'   CD 1E47'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1E94'   D8                    	RC			; no: the delete-and-put-back path
  1E95'   C3 1E5F'              	JMP	YNGO
  1E98'                         YNC_RF:
  1E98'   CD 0780'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1E9B'   CD 0A0D'              	CALL	GLSTAL		;   register alone, and that is the command
  1E9E'   B7                    	ORA	A		; NC: done
  1E9F'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1EA0'                         YNLINE:
  1EA0'   22 0000*              	SHLD	YNCNT		; the lines it still wants
  1EA3'   2A 0000*              	LHLD	GAPEND
  1EA6'                         YNL_LP:
  1EA6'   EB                    	XCHG			; DE = the scan
  1EA7'   2A 0000*              	LHLD	TXTEND
  1EAA'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1EAD'   EB                    	XCHG			; HL = the scan
  1EAE'   D2 1ECE'              	JNC	YNL_EN		; the resident text ran out
  1EB1'   7E                    	MOV	A,M
  1EB2'   23                    	INX	H
  1EB3'   FE 0A                 	CPI	LF
  1EB5'   C2 1EA6'              	JNZ	YNL_LP
  1EB8'   E5                    	PUSH	H
  1EB9'   2A 0000*              	LHLD	YNCNT
  1EBC'   2B                    	DCX	H
  1EBD'   22 0000*              	SHLD	YNCNT
  1EC0'   7C                    	MOV	A,H
  1EC1'   B5                    	ORA	L
  1EC2'   E1                    	POP	H
  1EC3'   C2 1EA6'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1EC6'   EB                    	XCHG			; DE = past the last of them
  1EC7'   2A 0000*              	LHLD	GAPEND
  1ECA'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1ECB'   C3 1EDC'              	JMP	YNL_BC
  1ECE'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1ECE'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1ED1'   C2 1EE3'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1ED4'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1ED7'   EB                    	XCHG			;   count clamps to it as vim's does
  1ED8'   2A 0000*              	LHLD	GAPEND
  1EDB'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1EDC'                         YNL_BC:
  1EDC'   CD 0000*              	CALL	SUBHD		; HL = the span
  1EDF'   44                    	MOV	B,H
  1EE0'   4D                    	MOV	C,L
  1EE1'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1EE2'   C9                    	RET
  1EE3'                         YNL_NO:
  1EE3'   37                    	STC
  1EE4'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1EE5'                         YNSPAN:
  1EE5'   CD 185E'              	CALL	OPSPNL		; HL = the span's length
  1EE8'   44                    	MOV	B,H
  1EE9'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1EEA'   CD 1E47'              	CALL	YNROOM
  1EED'   D8                    	RC			; no room: the delete-and-put-back path
  1EEE'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1EEF'   2A 0000*              	LHLD	OPLO
  1EF2'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1EF5'   C1                    	POP	B
  1EF6'   C3 1E5F'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1EF9'                         VC_P:
  1EF9'   CD 1C67'              	CALL	QEMPTY
  1EFC'   CA 1FCF'              	JZ	VP_BEL
  1EFF'   CD 0780'              	CALL	GETCNT
  1F02'   22 0000*              	SHLD	PCNT
  1F05'   CD 0000*              	CALL	CUROFF
  1F08'   CD 0712'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1F0B'   C3 1F20'              	JMP	VP_GO
  1F0E'                         VCB_P:
  1F0E'   CD 1C67'              	CALL	QEMPTY
  1F11'   CA 1FCF'              	JZ	VP_BEL
  1F14'   CD 0780'              	CALL	GETCNT
  1F17'   22 0000*              	SHLD	PCNT
  1F1A'   CD 0000*              	CALL	CUROFF
  1F1D'   CD 067B'              	CALL	BOL
  1F20'                         VP_GO:
  1F20'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1F23'   CD 0000*              	CALL	CUROFF
  1F26'   EB                    	XCHG
  1F27'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  1F2A'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1F2D'   DA 1F42'              	JC	VP_IN
  1F30'   EB                    	XCHG			; HL = the put point = LOGLEN
  1F31'   7C                    	MOV	A,H
  1F32'   B5                    	ORA	L
  1F33'   CA 1F3F'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1F36'   2B                    	DCX	H
  1F37'   CD 0000*              	CALL	CHARAT
  1F3A'   FE 0A                 	CPI	LF
  1F3C'   CA 1F42'              	JZ	VP_IN
  1F3F'                         VP_BRK:
  1F3F'   CD 1A64'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1F42'                         VP_IN:
  1F42'   21 0000*              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1F45'   CD 042C'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1F48'   CD 13D4'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1F4B'   2A 0000*              	LHLD	QBEG
  1F4E'   EB                    	XCHG
  1F4F'   2A 0000*              	LHLD	QEND
  1F52'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1F55'   EB                    	XCHG
  1F56'   22 0000*              	SHLD	PLFS
  1F59'   2A 0000*              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1F5C'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1F5D'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1F5E'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1F60'   C2 1F64'              	JNZ	VP_PZ
  1F63'   7D                    	MOV	A,L
  1F64'                         VP_PZ:
  1F64'   32 0000*              	STA	PCPY
  1F67'                         VP_LP:
  1F67'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1F6A'   2A 0000*              	LHLD	LNDLT
  1F6D'   EB                    	XCHG
  1F6E'   2A 0000*              	LHLD	PLFS
  1F71'   19                    	DAD	D
  1F72'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1F75'   2A 0000*              	LHLD	PCNT
  1F78'   2B                    	DCX	H
  1F79'   22 0000*              	SHLD	PCNT
  1F7C'   7C                    	MOV	A,H
  1F7D'   B5                    	ORA	L
  1F7E'   C2 1F67'              	JNZ	VP_LP
  1F81'   CD 0177'              	CALL	MARKMOD
  1F84'   21 0000*              	LXI	H,PPFP
  1F87'   CD 03DF'              	CALL	MKLOAD
  1F8A'   CD 03EC'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1F8D'   D2 1FC0'              	JNC	VP_PGD
  1F90'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


                                				;   arithmetic now has the lines to subtract
  1F93'   CD 0A0D'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1F96'   3A 0000*              	LDA	PCPY
  1F99'   B7                    	ORA	A
  1F9A'   CA 095B'              	JZ	FNBLNK
  1F9D'   2A 0000*              	LHLD	PLFS
  1FA0'   7C                    	MOV	A,H
  1FA1'   B7                    	ORA	A
  1FA2'   C2 095B'              	JNZ	FNBLNK
  1FA5'   3A 0000*              	LDA	PCPY
  1FA8'   CD 1086'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1FAB'   7C                    	MOV	A,H
  1FAC'   B7                    	ORA	A
  1FAD'   C2 095B'              	JNZ	FNBLNK
  1FB0'   7D                    	MOV	A,L
  1FB1'   B7                    	ORA	A
  1FB2'   CA 095B'              	JZ	FNBLNK
  1FB5'   F5                    	PUSH	PSW
  1FB6'   CD 087D'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1FB9'   F1                    	POP	PSW
  1FBA'   32 31BC'              	STA	ILN		; ... which the lines put now replace
  1FBD'   C3 095B'              	JMP	FNBLNK
  1FC0'                         VP_PGD:				; the put paged its first line out: page back
  1FC0'   CD 03AC'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1FC3'   CD 0000*              	CALL	GOTO
  1FC6'   CD 0A0D'              	CALL	GLSTAL
  1FC9'   CD 13EC'              	CALL	GPLACE
  1FCC'   C3 0892'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  1FCF'                         VP_BEL:
  1FCF'   CD 0780'              	CALL	GETCNT		; the count is spent either way
  1FD2'   0E 07                 	MVI	C,BEL
  1FD4'   CD 0000*              	CALL	BCONOU
  1FD7'   C3 0855'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  1FDA'                         VIREP:
  1FDA'   79                    	MOV	A,C
  1FDB'   FE 1B                 	CPI	ESC
  1FDD'   CA 2130'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  1FE0'   FE 0D                 	CPI	CR
  1FE2'   CA 2055'              	JZ	VP_CR
  1FE5'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1FE7'   CA 2055'              	JZ	VP_CR
  1FEA'   FE 08                 	CPI	BS
  1FEC'   CA 2061'              	JZ	VP_BS
  1FEF'   FE 7F                 	CPI	DEL
  1FF1'   CA 2061'              	JZ	VP_BS
  1FF4'   32 0000*              	STA	VRCH		; the calls below do not preserve C
  1FF7'   CD 085B'              	CALL	SETLIN		; this row changed
  1FFA'   CD 0177'              	CALL	MARKMOD
  1FFD'   CD 1A57'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  2000'   CA 2040'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  2003'   CD 0767'              	CALL	CURCHR
  2006'   06 01                 	MVI	B,1
  2008'   CD 0861'              	CALL	SETCEL
  200B'   3A 0000*              	LDA	VRCH
  200E'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  2011'   2A 0000*              	LHLD	RPDEL
  2014'   7C                    	MOV	A,H
  2015'   B5                    	ORA	L
  2016'   CA 202C'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  2019'   2A 0000*              	LHLD	GAPEND
  201C'   EB                    	XCHG
  201D'   2A 0000*              	LHLD	RPGE
  2020'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  2023'   CA 202C'              	JZ	VP_OVW
  2026'   21 0000               	LXI	H,0
  2029'   22 0000*              	SHLD	RPDEL		; the text moved: those originals are gone
  202C'                         VP_OVW:
  202C'   21 0001               	LXI	H,1
  202F'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  2032'   2A 0000*              	LHLD	GAPEND
  2035'   22 0000*              	SHLD	RPGE
  2038'   2A 0000*              	LHLD	RPDEL
  203B'   23                    	INX	H
  203C'   22 0000*              	SHLD	RPDEL
  203F'   C9                    	RET
  2040'                         VP_APP:
  2040'   3E 20                 	MVI	A,' '		; (the cell there is blank)
  2042'   06 01                 	MVI	B,1
  2044'   CD 0861'              	CALL	SETCEL
  2047'   3A 0000*              	LDA	VRCH
  204A'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  204D'   2A 0000*              	LHLD	RPAPP
  2050'   23                    	INX	H
  2051'   22 0000*              	SHLD	RPAPP
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2054'   C9                    	RET
  2055'                         VP_CR:
  2055'   21 0000               	LXI	H,0
  2058'   22 0000*              	SHLD	RPDEL		; a line break ends what BS can put back
  205B'   22 0000*              	SHLD	RPAPP
  205E'   C3 20EC'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  2061'                         VP_BS:
  2061'   2A 0000*              	LHLD	RPAPP
  2064'   7C                    	MOV	A,H
  2065'   B5                    	ORA	L
  2066'   CA 2073'              	JZ	VP_BSD
  2069'   2B                    	DCX	H
  206A'   22 0000*              	SHLD	RPAPP		; an appended char: it just goes
  206D'   CD 085B'              	CALL	SETLIN
  2070'   C3 0000*              	JMP	DELPRV
  2073'                         VP_BSD:
  2073'   2A 0000*              	LHLD	RPDEL
  2076'   7C                    	MOV	A,H
  2077'   B5                    	ORA	L
  2078'   CA 209F'              	JZ	VP_BSM		; nothing of ours left
  207B'   2A 0000*              	LHLD	GAPEND
  207E'   EB                    	XCHG
  207F'   2A 0000*              	LHLD	RPGE
  2082'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  2085'   C2 209F'              	JNZ	VP_BSM
  2088'   2A 0000*              	LHLD	RPDEL
  208B'   2B                    	DCX	H
  208C'   22 0000*              	SHLD	RPDEL
  208F'   CD 085B'              	CALL	SETLIN
  2092'   CD 0000*              	CALL	DELPRV		; the typed char goes
  2095'   CD 0000*              	CALL	UNDELF		; the original comes back
  2098'   2A 0000*              	LHLD	GAPEND
  209B'   22 0000*              	SHLD	RPGE
  209E'   C9                    	RET
  209F'                         VP_BSM:
  209F'   CD 0855'              	CALL	SETMOV		; nothing changed: back over the text as it is
  20A2'   C3 08E3'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  20A5'                         VIINS:
  20A5'   79                    	MOV	A,C
  20A6'   FE 1B                 	CPI	ESC
  20A8'   CA 2130'              	JZ	VI_ESC
  20AB'   FE 0D                 	CPI	CR
  20AD'   CA 20EC'              	JZ	VI_CR
  20B0'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  20B2'   CA 20EC'              	JZ	VI_CR
  20B5'   FE 08                 	CPI	BS
  20B7'   CA 2104'              	JZ	VI_BS
  20BA'   FE 7F                 	CPI	DEL
  20BC'   CA 2104'              	JZ	VI_BS
  20BF'   79                    	MOV	A,C
  20C0'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  20C3'   CD 0177'              	CALL	MARKMOD
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  20C6'   CD 085B'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only for a plain printable char.  With
                                	;    a TAB after the cursor nothing past the TAB moves, so long as the
                                	;    TAB can give the cell up: the chars as far as it are the paint. ---
  20C9'   79                    	MOV	A,C
  20CA'   FE 20                 	CPI	' '
  20CC'   D8                    	RC			; control char -> keep R_LINE
  20CD'   FE 7F                 	CPI	DEL
  20CF'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  20D0'   CD 0898'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  20D3'   47                    	MOV	B,A
  20D4'   3E 04                 	MVI	A,R_ICH
  20D6'   32 0000*              	STA	RINTENT
  20D9'   3E 03                 	MVI	A,3		; a TAB there: it takes the cell up if it can
  20DB'   05                    	DCR	B		;   (SCRN.MAC knows where it stands)
  20DC'   CA 20E8'              	JZ	VI_ICH
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  20DF'   CD 1A57'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  20E2'   3E 00                 	MVI	A,0
  20E4'   C2 20E8'              	JNZ	VI_ICH
  20E7'   3C                    	INR	A
  20E8'                         VI_ICH:
  20E8'   32 0000*              	STA	ICHAPP
  20EB'   C9                    	RET
  20EC'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  20EC'   CD 1A57'              	CALL	ATCEND
  20EF'   3E 00                 	MVI	A,0
  20F1'   CA 20F5'              	JZ	VI_CRS
  20F4'   3C                    	INR	A
  20F5'                         VI_CRS:
  20F5'   F5                    	PUSH	PSW
  20F6'   CD 1A64'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  20F9'   CD 1A71'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  20FC'   CD 087D'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  20FF'   F1                    	POP	PSW
  2100'   32 0000*              	STA	ILABOV
  2103'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  2104'                         VI_BS:
  2104'   CD 0000*              	CALL	PEEKL
  2107'   D8                    	RC			; start of the file: nothing to delete
  2108'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  210A'   CA 212A'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  210D'   47                    	MOV	B,A		;   and the screen repaints in full.  Any other
  210E'   CD 085B'              	CALL	SETLIN		;   char is inside the row -- redraw just that row
  2111'   78                    	MOV	A,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2112'   CD 0876'              	CALL	PLAINQ		; ... or, when it is one cell and no TAB follows
  2115'   D2 212A'              	JNC	VI_BSJ		;   to be drawn up short, let the terminal close
  2118'   CD 0898'              	CALL	TAILTAB		;   the cell up (R_DCH, from the left of the
  211B'   87                    	ADD	A		;   cursor) -- or the TAB that follows take it
  211C'   3C                    	INR	A
  211D'   32 0000*              	STA	DCHBS		; 1, and 2 with it for the TAB
  2120'   3E 01                 	MVI	A,1
  2122'   32 31BD'              	STA	DCHN
  2125'   3E 07                 	MVI	A,R_DCH
  2127'   32 0000*              	STA	RINTENT
  212A'                         VI_BSJ:
  212A'   CD 0177'              	CALL	MARKMOD
  212D'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  2130'                         VI_ESC:
  2130'   3E 00                 	MVI	A,EM_CMD
  2132'   32 0000*              	STA	EDMODE
  2135'   CD 0855'              	CALL	SETMOV
  2138'   CD 08E3'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  213B'   C3 0A0D'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  213E'                         RDLINE:
  213E'   EB                    	XCHG			; HL = buffer
  213F'   22 0000*              	SHLD	RLPTR
  2142'   3E 00                 	MVI	A,0
  2144'   32 0000*              	STA	RLLEN
  2147'   78                    	MOV	A,B
  2148'   32 0000*              	STA	RLMAX
  214B'   79                    	MOV	A,C
  214C'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  214F'                         RL_LP:
  214F'   CD 0000*              	CALL	GETKEY
  2152'   FE 1B                 	CPI	ESC
  2154'   CA 21A4'              	JZ	RL_CAN
  2157'   FE 0D                 	CPI	CR
  2159'   CA 21AF'              	JZ	RL_DONE
  215C'   FE 08                 	CPI	BS
  215E'   CA 218C'              	JZ	RL_BS
  2161'   FE 7F                 	CPI	DEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  2163'   CA 218C'              	JZ	RL_BS
  2166'   FE 20                 	CPI	' '
  2168'   DA 214F'              	JC	RL_LP		; control char -> ignore
  216B'   3A 0000*              	LDA	RLLEN
  216E'   47                    	MOV	B,A
  216F'   3A 0000*              	LDA	RLMAX
  2172'   B8                    	CMP	B
  2173'   CA 214F'              	JZ	RL_LP		; full -> ignore
  2176'   2A 0000*              	LHLD	RLPTR
  2179'   71                    	MOV	M,C
  217A'   23                    	INX	H
  217B'   22 0000*              	SHLD	RLPTR
  217E'   3A 0000*              	LDA	RLLEN
  2181'   3C                    	INR	A
  2182'   32 0000*              	STA	RLLEN
  2185'   79                    	MOV	A,C
  2186'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  2189'   C3 214F'              	JMP	RL_LP
  218C'                         RL_BS:				; WM LINEPOP
  218C'   3A 0000*              	LDA	RLLEN
  218F'   B7                    	ORA	A
  2190'   CA 21A4'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  2193'   3D                    	DCR	A
  2194'   32 0000*              	STA	RLLEN
  2197'   2A 0000*              	LHLD	RLPTR
  219A'   2B                    	DCX	H
  219B'   22 0000*              	SHLD	RLPTR
  219E'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  21A1'   C3 214F'              	JMP	RL_LP
  21A4'                         RL_CAN:
  21A4'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  21A6'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  21A9'   CD 085B'              	CALL	SETLIN		; redraw one row
  21AC'   3E FF                 	MVI	A,0FFH		; cancelled
  21AE'   C9                    	RET
  21AF'                         RL_DONE:
  21AF'   3E 0D                 	MVI	A,CR		; vim: the cursor waits under the prompt while
  21B1'   CD 0000*              	CALL	OUTCH		;   the command runs, not after its last char
  21B4'   AF                    	XRA	A
  21B5'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  21B6'                         VC_BZ:
  21B6'   CD 0855'              	CALL	SETMOV
  21B9'   3A 0000*              	LDA	GSAVE
  21BC'   FE 02                 	CPI	PZ
  21BE'   CA 21C9'              	JZ	VZ_ZZ
  21C1'   B7                    	ORA	A
  21C2'   C0                    	RNZ			; 'g' was pending: vim drops both
  21C3'   3E 02                 	MVI	A,PZ
  21C5'   32 0000*              	STA	GPEND
  21C8'   C9                    	RET
  21C9'                         VZ_ZZ:
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  21C9'   3E 04                 	MVI	A,EO_X
  21CB'   32 0000*              	STA	EXOP
  21CE'   3E 01                 	MVI	A,1
  21D0'   32 0000*              	STA	EXBANG		; no '!'
  21D3'   AF                    	XRA	A
  21D4'   32 0000*              	STA	EXARG		; no file name
  21D7'   3A 0000*              	LDA	MODF		; as ':x': a changed text is written first
  21DA'   B7                    	ORA	A
  21DB'   CA 231C'              	JZ	EX_Q
  21DE'   C3 22B6'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  21E1'                         VC_EX:
  21E1'   CD 0780'              	CALL	GETCNT
  21E4'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  21E7'   11 0000*              	LXI	D,EXBUF
  21EA'   06 28                 	MVI	B,EXMAX
  21EC'   0E 3A                 	MVI	C,':'
  21EE'   CD 213E'              	CALL	RDLINE
  21F1'   B7                    	ORA	A
  21F2'   C0                    	RNZ			; cancelled
  21F3'   3A 0000*              	LDA	RLLEN
  21F6'   5F                    	MOV	E,A
  21F7'   16 00                 	MVI	D,0
  21F9'   21 0000*              	LXI	H,EXBUF
  21FC'   19                    	DAD	D
  21FD'   36 00                 	MVI	M,0		; the line ends with a 0
  21FF'   21 0000*              	LXI	H,EXBUF
  2202'   CD 27CE'              	CALL	SKIPB
  2205'   C8                    	RZ			; nothing on it
  2206'   22 0000*              	SHLD	EXCMD
  2209'   CD 29F2'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  220C'   CD 27CE'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  220F'   56                    	MOV	D,M
  2210'   23                    	INX	H
  2211'   1E 00                 	MVI	E,0
  2213'   CD 27DA'              	CALL	ISLOW
  2216'   DA 2221'              	JC	EX_LK
  2219'   5F                    	MOV	E,A
  221A'   23                    	INX	H
  221B'   CD 27DA'              	CALL	ISLOW
  221E'   D2 223A'              	JNC	EX_NOT		; a third letter: none of ours
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  2221'                         EX_LK:
  2221'   E5                    	PUSH	H
  2222'   21 29D9'              	LXI	H,EXTAB
  2225'                         EX_TL:
  2225'   7E                    	MOV	A,M
  2226'   B7                    	ORA	A
  2227'   CA 2239'              	JZ	EX_NTP		; not in the table
  222A'   23                    	INX	H
  222B'   BA                    	CMP	D
  222C'   7E                    	MOV	A,M
  222D'   23                    	INX	H
  222E'   C2 2235'              	JNZ	EX_TN
  2231'   BB                    	CMP	E
  2232'   CA 2240'              	JZ	EX_TF
  2235'                         EX_TN:
  2235'   23                    	INX	H
  2236'   C3 2225'              	JMP	EX_TL
  2239'                         EX_NTP:
  2239'   E1                    	POP	H
  223A'                         EX_NOT:
  223A'   21 2892'              	LXI	H,SNOT
  223D'   C3 280F'              	JMP	EXERT
  2240'                         EX_TF:
  2240'   7E                    	MOV	A,M
  2241'   32 0000*              	STA	EXOP
  2244'   E1                    	POP	H
  2245'   FE 06                 	CPI	EO_S
  2247'   CA 2A61'              	JZ	EX_S		; ':s' reads the rest of the line itself
  224A'   FE 01                 	CPI	EO_W
  224C'   CA 225B'              	JZ	EX_RG		; ':N,Mw name' takes a range
  224F'   FE 08                 	CPI	EO_R
  2251'   CA 225B'              	JZ	EX_RG		; ... and ':Nr name' a line
  2254'   3A 0000*              	LDA	SRNGF
  2257'   B7                    	ORA	A
  2258'   C2 223A'              	JNZ	EX_NOT		; a range on a command that does not take one
  225B'                         EX_RG:
                                	;--- '!', then the file name ---
  225B'   7E                    	MOV	A,M
  225C'   D6 21                 	SUI	'!'
  225E'   32 0000*              	STA	EXBANG		; 0 = '!'
  2261'   C2 2265'              	JNZ	EX_NB
  2264'   23                    	INX	H
  2265'                         EX_NB:
  2265'   CD 27CE'              	CALL	SKIPB
  2268'   32 0000*              	STA	EXARG		; 0 = no file name
  226B'   CA 2284'              	JZ	EX_RUN
  226E'   22 0000*              	SHLD	EXCMD
  2271'   3A 0000*              	LDA	EXOP
  2274'   FE 02                 	CPI	EO_Q
  2276'   CA 280C'              	JZ	EX_TRL		; :q takes none
  2279'   FE 07                 	CPI	EO_V
  227B'   CA 280C'              	JZ	EX_TRL		; nor :ve
  227E'   CD 2738'              	CALL	PARSFN
  2281'   C2 2800'              	JNZ	EX_INV
  2284'                         EX_RUN:
  2284'   3A 0000*              	LDA	EXOP
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  2287'   FE 05                 	CPI	EO_E
  2289'   CA 2333'              	JZ	EX_E
  228C'   FE 02                 	CPI	EO_Q
  228E'   CA 231C'              	JZ	EX_Q
  2291'   FE 07                 	CPI	EO_V
  2293'   CA 2806'              	JZ	EX_V
  2296'   FE 08                 	CPI	EO_R
  2298'   CA 24C4'              	JZ	EX_R
  229B'   FE 04                 	CPI	EO_X
  229D'   CA 22AF'              	JZ	EX_XM
  22A0'   FE 01                 	CPI	EO_W
  22A2'   C2 22B6'              	JNZ	EX_W		; :wq
  22A5'   3A 0000*              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  22A8'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  22A9'   C2 23E4'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  22AC'   C3 22B6'              	JMP	EX_W
  22AF'                         EX_XM:
  22AF'   3A 0000*              	LDA	MODF		; :x writes only a changed text
  22B2'   B7                    	ORA	A
  22B3'   CA 231C'              	JZ	EX_Q
  22B6'                         EX_W:
  22B6'   CD 25A4'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  22B9'   D8                    	RC			; refused (message shown)
  22BA'   32 0000*              	STA	EXBAK
  22BD'   3A 0000*              	LDA	EXOP
  22C0'   FE 01                 	CPI	EO_W
  22C2'   CA 22D9'              	JZ	EX_WK
  22C5'   3A 0000*              	LDA	EXBAK
  22C8'   B7                    	ORA	A
  22C9'   C2 2319'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  22CC'   3A 0000*              	LDA	EXBANG
  22CF'   B7                    	ORA	A
  22D0'   CA 2319'              	JZ	EX_WQ		; so it does with '!'
  22D3'   CD 22D9'              	CALL	EX_WK		; else it may not: keep the text
  22D6'   C3 231C'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  22D9'                         EX_WK:
  22D9'   CD 0EC2'              	CALL	CURRW		; the cursor's row and file position
  22DC'   32 0000*              	STA	WPROW
  22DF'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  22E2'   7D                    	MOV	A,L
  22E3'   E6 7F                 	ANI	7FH
  22E5'   32 0000*              	STA	WPBYT
  22E8'   7D                    	MOV	A,L
  22E9'   17                    	RAL
  22EA'   7C                    	MOV	A,H
  22EB'   17                    	RAL
  22EC'   5F                    	MOV	E,A
  22ED'   3E 00                 	MVI	A,0
  22EF'   17                    	RAL
  22F0'   57                    	MOV	D,A		; DE = HL / 128
  22F1'   2A 0000*              	LHLD	OUTPOS
  22F4'   19                    	DAD	D
  22F5'   22 0000*              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  22F8'   CD 25D9'              	CALL	WRITE
  22FB'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  22FE'   2A 0000*              	LHLD	WPREC
  2301'   EB                    	XCHG
  2302'   3A 0000*              	LDA	WPBYT
  2305'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  2308'   CD 0000*              	CALL	GOTO
  230B'                         EX_WRW:
  230B'   21 0000               	LXI	H,0
  230E'   22 0000*              	SHLD	LNDLT
  2311'   3A 0000*              	LDA	WPROW
  2314'   6F                    	MOV	L,A
  2315'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  2318'   C9                    	RET
  2319'                         EX_WQ:
  2319'   CD 25D9'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  231C'                         EX_Q:
  231C'   3A 0000*              	LDA	EXBANG
  231F'   B7                    	ORA	A
  2320'   CA 232A'              	JZ	EX_QT
  2323'   3A 0000*              	LDA	MODF
  2326'   B7                    	ORA	A
  2327'   C2 27F4'              	JNZ	MSGNWR		; changed, no '!': stay
  232A'                         EX_QT:
  232A'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  232D'   3E 01                 	MVI	A,1
  232F'   32 0000*              	STA	QUITF
  2332'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  2333'                         EX_E:
  2333'   3A 0000*              	LDA	EXBANG
  2336'   B7                    	ORA	A
  2337'   CA 2341'              	JZ	EE_GO
  233A'   3A 0000*              	LDA	MODF
  233D'   B7                    	ORA	A
  233E'   C2 27F4'              	JNZ	MSGNWR
  2341'                         EE_GO:
  2341'   3A 0000*              	LDA	EXARG
  2344'   B7                    	ORA	A
  2345'   C2 234C'              	JNZ	EE_ARG
  2348'   CD 2615'              	CALL	OWNTF		; no name: the buffer's own
  234B'   D8                    	RC
  234C'                         EE_ARG:
  234C'   CD 262B'              	CALL	ISOWN
  234F'   21 0001               	LXI	H,1
  2352'   C2 2359'              	JNZ	EE_LD		; another file: its first line
  2355'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  2358'   23                    	INX	H		; HL = the cursor's line
  2359'                         EE_LD:
  2359'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  235B'   32 0000*              	STA	MSGWHT
  235E'   E5                    	PUSH	H
  235F'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  2362'   21 0000*              	LXI	H,TFCB
  2365'   11 0000*              	LXI	D,FNAME
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  2368'   CD 263D'              	CALL	COPY12		; the buffer's name
  236B'   CD 2602'              	CALL	SRCTF
  236E'   CD 0000*              	CALL	REOPEN
  2371'   CD 01EF'              	CALL	MKCLR		; the marks named the buffer that just went
  2374'   AF                    	XRA	A
  2375'   32 0000*              	STA	MODF
  2378'   E1                    	POP	H
  2379'   2B                    	DCX	H
  237A'   AF                    	XRA	A
  237B'   CD 0000*              	CALL	MVLIND		; down to the line
  237E'   CD 0BDE'              	CALL	ATEOF
  2381'   DC 0BE4'              	CC	LASTLN		; past the last line: onto it
  2384'   CD 13AE'              	CALL	ZSAVE
  2387'   C3 1483'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  238A'                         TFDOS:
  238A'   C5                    	PUSH	B
  238B'   11 0080               	LXI	D,CMDTAIL
  238E'   0E 1A                 	MVI	C,1AH		; set the DMA
  2390'   CD 0005               	CALL	BDOS
  2393'   C1                    	POP	B
  2394'   11 0000*              	LXI	D,TFCB
  2397'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  239A'                         EXRNG:
  239A'   2A 0000*              	LHLD	SRNG1
  239D'   7C                    	MOV	A,H
  239E'   B5                    	ORA	L
  239F'   37                    	STC
  23A0'   C8                    	RZ
  23A1'   2A 0000*              	LHLD	SRNG2
  23A4'   EB                    	XCHG
  23A5'   2A 0000*              	LHLD	SRNG1
  23A8'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  23AB'   D8                    	RC
  23AC'   EB                    	XCHG			; HL = the last line, DE = the first
  23AD'   CD 0000*              	CALL	SUBHD
  23B0'   23                    	INX	H
  23B1'   22 0000*              	SHLD	SLINES
  23B4'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  23B5'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  23B6'                         GOLNX:
  23B6'   E5                    	PUSH	H
  23B7'   CD 1342'              	CALL	GOLN
  23BA'   CD 0000*              	CALL	CNTLF
  23BD'   23                    	INX	H		; the line the cursor came to rest on
  23BE'   D1                    	POP	D
  23BF'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  23C2'                         EXSAVP:
  23C2'   CD 0EC2'              	CALL	CURRW
  23C5'   32 0000*              	STA	WPROW
  23C8'   21 0000*              	LXI	H,MKPOS
  23CB'   C3 042C'              	JMP	FPSTO
  23CE'                         EXRSTP:
  23CE'   CD 0000*              	CALL	CLRCNT
  23D1'   CD 03AC'              	CALL	MKPAGE		; page until that place is in the window again
  23D4'   CD 0000*              	CALL	GOTO
  23D7'   C3 230B'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  23DA'                         PUTBRK:
  23DA'   3E 0D                 	MVI	A,CR
  23DC'   CD 0000*              	CALL	PUTGAP
  23DF'   3E 0A                 	MVI	A,LF
  23E1'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  23E4'                         EX_WR:
  23E4'   3A 0000*              	LDA	EXARG
  23E7'   B7                    	ORA	A
  23E8'   CA 27E2'              	JZ	MSGNFN		; No file name
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  23EB'   CD 262B'              	CALL	ISOWN
  23EE'   CA 248E'              	JZ	EXW_OW
  23F1'   CD 0000*              	CALL	TEXIST
  23F4'   32 0000*              	STA	RWERR		; nonzero: a file of that name is there
  23F7'   CA 2401'              	JZ	EXW_GO
  23FA'   3A 0000*              	LDA	EXBANG
  23FD'   B7                    	ORA	A
  23FE'   C2 27E8'              	JNZ	MSGEXI		; File exists (! to force)
  2401'                         EXW_GO:
  2401'   CD 239A'              	CALL	EXRNG
  2404'   DA 2488'              	JC	EXW_BD
  2407'   CD 23C2'              	CALL	EXSAVP
  240A'   2A 0000*              	LHLD	SRNG1
  240D'   CD 23B6'              	CALL	GOLNX
  2410'   C2 2485'              	JNZ	EXW_NL		; the text has no line N
  2413'   3A 0000*              	LDA	RWERR		; a delete scans the whole directory, there or
  2416'   B7                    	ORA	A		;   not: only when TEXIST found one
  2417'   0E 13                 	MVI	C,13H
  2419'   C4 238A'              	CNZ	TFDOS		; delete what is there
  241C'   0E 16                 	MVI	C,16H
  241E'   CD 238A'              	CALL	TFDOS		; ... and make it
  2421'   3C                    	INR	A
  2422'   CA 2477'              	JZ	EXW_FL		; no directory entry left
  2425'   3E 80                 	MVI	A,80H
  2427'   32 0000*              	STA	RWPTR
  242A'   AF                    	XRA	A
  242B'   32 0000*              	STA	RWERR
  242E'   2A 0000*              	LHLD	SLINES
  2431'   CD 0000*              	CALL	SETC0		; that many lines, forward
  2434'                         EXW_LP:
  2434'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  2437'   E5                    	PUSH	H
  2438'   EB                    	XCHG
  2439'   2A 0000*              	LHLD	GAPEND
  243C'   CD 2494'              	CALL	RWOUT		; the text from the cursor to there
  243F'   E1                    	POP	H
  2440'   3A 0000*              	LDA	RWERR
  2443'   B7                    	ORA	A
  2444'   C2 2460'              	JNZ	EXW_EN
  2447'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  244A'   CD 0795'              	CALL	CNTTST
  244D'   C2 2434'              	JNZ	EXW_LP
  2450'                         EXW_PD:				; the last record is padded out with ^Z
  2450'   3A 0000*              	LDA	RWPTR
  2453'   FE 80                 	CPI	80H
  2455'   CA 2460'              	JZ	EXW_EN
  2458'   3E 1A                 	MVI	A,CPMEOF
  245A'   CD 24A0'              	CALL	RWPUT
  245D'   C3 2450'              	JMP	EXW_PD
  2460'                         EXW_EN:
  2460'   0E 10                 	MVI	C,10H
  2462'   CD 238A'              	CALL	TFDOS		; close
  2465'   3A 0000*              	LDA	RWERR
  2468'   B7                    	ORA	A
  2469'   C2 2477'              	JNZ	EXW_FL
  246C'   CD 23CE'              	CALL	EXRSTP
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  246F'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  2471'   32 0000*              	STA	MSGWHT
  2474'   C3 0855'              	JMP	SETMOV		; nothing on the screen has changed
  2477'                         EXW_FL:				; no room: the part written is not left behind
  2477'   0E 13                 	MVI	C,13H
  2479'   CD 238A'              	CALL	TFDOS
  247C'   CD 23CE'              	CALL	EXRSTP
  247F'   21 29CF'              	LXI	H,SDFUL
  2482'   C3 281A'              	JMP	EXERR
  2485'                         EXW_NL:
  2485'   CD 23CE'              	CALL	EXRSTP
  2488'                         EXW_BD:
  2488'   21 29C1'              	LXI	H,SRNGE
  248B'   C3 281A'              	JMP	EXERR
  248E'                         EXW_OW:
  248E'   21 2849'              	LXI	H,SEXI
  2491'   C3 281A'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  2494'                         RWOUT:
  2494'   CD 0000*              	CALL	CMP16
  2497'   C8                    	RZ
  2498'   7E                    	MOV	A,M
  2499'   23                    	INX	H
  249A'   CD 24A0'              	CALL	RWPUT
  249D'   C3 2494'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  24A0'                         RWPUT:
  24A0'   E5                    	PUSH	H
  24A1'   F5                    	PUSH	PSW
  24A2'   3A 0000*              	LDA	RWPTR
  24A5'   6F                    	MOV	L,A
  24A6'   26 00                 	MVI	H,0
  24A8'   F1                    	POP	PSW
  24A9'   77                    	MOV	M,A
  24AA'   2C                    	INR	L		; Z: that was the record's last byte
  24AB'   7D                    	MOV	A,L
  24AC'   C2 24BF'              	JNZ	RWP_ST
  24AF'   D5                    	PUSH	D
  24B0'   0E 15                 	MVI	C,15H
  24B2'   CD 238A'              	CALL	TFDOS		; write it
  24B5'   D1                    	POP	D
  24B6'   B7                    	ORA	A
  24B7'   CA 24BD'              	JZ	RWP_OK
  24BA'   32 0000*              	STA	RWERR
  24BD'                         RWP_OK:
  24BD'   3E 80                 	MVI	A,80H
  24BF'                         RWP_ST:
  24BF'   32 0000*              	STA	RWPTR
  24C2'   E1                    	POP	H
  24C3'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  24C4'                         EX_R:
  24C4'   3A 0000*              	LDA	EXARG
  24C7'   B7                    	ORA	A
  24C8'   CA 27E2'              	JZ	MSGNFN		; No file name
  24CB'   0E 0F                 	MVI	C,0FH
  24CD'   CD 238A'              	CALL	TFDOS		; open
  24D0'   3C                    	INR	A
  24D1'   CA 259E'              	JZ	ER_NOF
  24D4'   CD 13D4'              	CALL	GZONE		; the screen's top line, before anything moves
  24D7'   CD 23C2'              	CALL	EXSAVP
  24DA'   3A 0000*              	LDA	SRNGF
  24DD'   B7                    	ORA	A
  24DE'   CA 24F7'              	JZ	ER_NXT		; no line given: below the cursor's
  24E1'   2A 0000*              	LHLD	SRNG2
  24E4'   7C                    	MOV	A,H
  24E5'   B5                    	ORA	L
  24E6'   C2 24F1'              	JNZ	ER_LN
  24E9'   23                    	INX	H
  24EA'   CD 1342'              	CALL	GOLN		; ':0r': above line 1 ...
  24ED'   AF                    	XRA	A		;   which never wants a line end put in first
  24EE'   C3 2519'              	JMP	ER_BRK
  24F1'                         ER_LN:
  24F1'   CD 23B6'              	CALL	GOLNX
  24F4'   C2 2485'              	JNZ	EXW_NL		; the text has no line N
  24F7'                         ER_NXT:
  24F7'   21 0001               	LXI	H,1
  24FA'   AF                    	XRA	A
  24FB'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  24FE'   CD 0BDE'              	CALL	ATEOF
  2501'   3E 00                 	MVI	A,0
  2503'   D2 2519'              	JNC	ER_BRK		; text follows
  2506'   2A 0000*              	LHLD	GAPBEG
  2509'   EB                    	XCHG
  250A'   2A 0000*              	LHLD	TXTBEG
  250D'   CD 0000*              	CALL	CMP16
  2510'   3E 01                 	MVI	A,1
  2512'   CA 2519'              	JZ	ER_BRK		; nothing before the cursor either
  2515'   1B                    	DCX	D
  2516'   1A                    	LDAX	D
  2517'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  2519'                         ER_BRK:
  2519'   32 0000*              	STA	RDBRK
  251C'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  251F'   AF                    	XRA	A
  2520'   32 0000*              	STA	RDANY
  2523'                         ER_LP:
  2523'   0E 14                 	MVI	C,14H
  2525'   CD 238A'              	CALL	TFDOS		; the next record
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  2528'   B7                    	ORA	A
  2529'   C2 255C'              	JNZ	ER_END
  252C'   21 0080               	LXI	H,CMDTAIL
  252F'   0E 00                 	MVI	C,0
  2531'                         ER_SC:				; C = its bytes, up to a ^Z
  2531'   7E                    	MOV	A,M
  2532'   FE 1A                 	CPI	CPMEOF
  2534'   CA 253C'              	JZ	ER_GOT
  2537'   23                    	INX	H
  2538'   0C                    	INR	C
  2539'   F2 2531'              	JP	ER_SC		; (minus: all 128)
  253C'                         ER_GOT:
  253C'   79                    	MOV	A,C
  253D'   B7                    	ORA	A
  253E'   CA 255C'              	JZ	ER_END
  2541'   C5                    	PUSH	B
  2542'   3A 0000*              	LDA	RDANY
  2545'   B7                    	ORA	A
  2546'   CC 258D'              	CZ	ER_1ST
  2549'   C1                    	POP	B
  254A'   06 00                 	MVI	B,0
  254C'   11 0080               	LXI	D,CMDTAIL
  254F'   C5                    	PUSH	B
  2550'   CD 0000*              	CALL	INSBLK
  2553'   C1                    	POP	B
  2554'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  2557'   79                    	MOV	A,C
  2558'   17                    	RAL
  2559'   DA 2523'              	JC	ER_LP		; a full record: there may be more
  255C'                         ER_END:
  255C'   3A 0000*              	LDA	RDANY
  255F'   B7                    	ORA	A
  2560'   CA 257E'              	JZ	ER_PL		; nothing in the file: nothing has changed
  2563'   CD 0BDE'              	CALL	ATEOF
  2566'   DA 2573'              	JC	ER_MD		; the text now ends as the file read ends
  2569'   2A 0000*              	LHLD	GAPBEG
  256C'   2B                    	DCX	H
  256D'   7E                    	MOV	A,M
  256E'   FE 0A                 	CPI	LF
  2570'   C4 23DA'              	CNZ	PUTBRK		; text follows: what was read ends a line
  2573'                         ER_MD:
  2573'   3E 01                 	MVI	A,1
  2575'   32 0000*              	STA	MODF
  2578'   CD 03AC'              	CALL	MKPAGE		; back to the first line read
  257B'   CD 0000*              	CALL	GOTO
  257E'                         ER_PL:
  257E'   CD 0BDE'              	CALL	ATEOF
  2581'   DC 0BE4'              	CC	LASTLN		; (nothing read, at the end: the last line)
  2584'   CD 0000*              	CALL	CLRCNT
  2587'   CD 13EC'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  258A'   C3 0892'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  258D'                         ER_1ST:
  258D'   3C                    	INR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


  258E'   32 0000*              	STA	RDANY
  2591'   3A 0000*              	LDA	RDBRK
  2594'   B7                    	ORA	A
  2595'   C4 23DA'              	CNZ	PUTBRK
  2598'   21 0000*              	LXI	H,MKPOS
  259B'   C3 042C'              	JMP	FPSTO
  259E'                         ER_NOF:
  259E'   21 29B0'              	LXI	H,SNOPN
  25A1'   C3 280F'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  25A4'                         WRCHK:
  25A4'   3A 0000*              	LDA	EXARG
  25A7'   B7                    	ORA	A
  25A8'   C2 25B2'              	JNZ	WC_ARG
  25AB'   CD 2615'              	CALL	OWNTF
  25AE'   D8                    	RC
  25AF'   C3 25C7'              	JMP	WC_OWN
  25B2'                         WC_ARG:
  25B2'   CD 262B'              	CALL	ISOWN
  25B5'   CA 25C7'              	JZ	WC_OWN
  25B8'   3A 0000*              	LDA	EXBANG
  25BB'   B7                    	ORA	A
  25BC'   CA 25C5'              	JZ	WC_OTH
  25BF'   CD 0000*              	CALL	TEXIST
  25C2'   C2 27E8'              	JNZ	MSGEXI		; File exists (! to force)
  25C5'                         WC_OTH:
  25C5'   AF                    	XRA	A		; (NC)
  25C6'   C9                    	RET
  25C7'                         WC_OWN:
  25C7'   3A 0000*              	LDA	ROFLAG		; '-R': this is the file it may not write
  25CA'   B7                    	ORA	A
  25CB'   CA 25D5'              	JZ	WC_OK
  25CE'   3A 0000*              	LDA	EXBANG
  25D1'   B7                    	ORA	A
  25D2'   C2 27EE'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  25D5'                         WC_OK:
  25D5'   3E 01                 	MVI	A,1
  25D7'   B7                    	ORA	A		; (NC)
  25D8'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  25D9'                         WRITE:
  25D9'   3A 0000*              	LDA	EXBAK
  25DC'   CD 0000*              	CALL	WRTO
  25DF'   3A 0001*              	LDA	FNAME+1
  25E2'   FE 20                 	CPI	' '
  25E4'   C2 25F0'              	JNZ	WR_HAS
  25E7'   21 0000*              	LXI	H,TFCB
  25EA'   11 0000*              	LXI	D,FNAME
  25ED'   CD 263D'              	CALL	COPY12
  25F0'                         WR_HAS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  25F0'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  25F2'   32 0000*              	STA	MSGWHT
  25F5'   CD 262B'              	CALL	ISOWN
  25F8'   C2 2602'              	JNZ	SRCTF
  25FB'   AF                    	XRA	A
  25FC'   32 0000*              	STA	MODF
  25FF'   32 0000*              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  2602'                         SRCTF:
  2602'   21 0000*              	LXI	H,TFCB
  2605'   11 005C               	LXI	D,DFTFCB
  2608'   CD 263D'              	CALL	COPY12
  260B'   AF                    	XRA	A
  260C'   06 04                 	MVI	B,4
  260E'                         SRC_Z:
  260E'   12                    	STAX	D		; extent, s1, s2, record count: 0
  260F'   13                    	INX	D
  2610'   05                    	DCR	B
  2611'   C2 260E'              	JNZ	SRC_Z
  2614'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  2615'                         OWNTF:
  2615'   3A 0001*              	LDA	FNAME+1
  2618'   FE 20                 	CPI	' '
  261A'   CA 27E2'              	JZ	MSGNFN
  261D'   CD 2648'              	CALL	TFCLR
  2620'   21 0000*              	LXI	H,FNAME
  2623'   11 0000*              	LXI	D,TFCB
  2626'   CD 263D'              	CALL	COPY12
  2629'   B7                    	ORA	A		; (NC)
  262A'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  262B'                         ISOWN:
  262B'   21 0000*              	LXI	H,TFCB
  262E'   11 0000*              	LXI	D,FNAME
  2631'   06 0C                 	MVI	B,12
  2633'                         IO_LP:
  2633'   1A                    	LDAX	D
  2634'   BE                    	CMP	M
  2635'   C0                    	RNZ
  2636'   23                    	INX	H
  2637'   13                    	INX	D
  2638'   05                    	DCR	B
  2639'   C2 2633'              	JNZ	IO_LP
  263C'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  263D'                         COPY12:
  263D'   06 0C                 	MVI	B,12
  263F'                         CP_LP:
  263F'   7E                    	MOV	A,M
  2640'   12                    	STAX	D
  2641'   23                    	INX	H
  2642'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  2643'   05                    	DCR	B
  2644'   C2 263F'              	JNZ	CP_LP
  2647'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  2648'                         TFCLR:
  2648'   11 0000*              	LXI	D,TFCB
  264B'   06 24                 	MVI	B,36
  264D'   AF                    	XRA	A
  264E'                         TC_LP:
  264E'   12                    	STAX	D
  264F'   13                    	INX	D
  2650'   05                    	DCR	B
  2651'   C2 264E'              	JNZ	TC_LP
  2654'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  2655'                         FOPEN:
  2655'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  2657'   32 0000*              	STA	MSGWHT
  265A'   21 005C               	LXI	H,DFTFCB
  265D'   CD 272B'              	CALL	NRMDRV
  2660'   11 0000*              	LXI	D,FNAME
  2663'   CD 263D'              	CALL	COPY12
  2666'   CD 0000*              	CALL	OPENZ
  2669'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  266C'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  266E'   C8                    	RZ
  266F'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  2672'   32 0000*              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  2675'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


                                ; is the last line, as vim's is.
                                ;============================================================
  2676'                         ARGSCN:
  2676'   3A 0080               	LDA	CMDTAIL
  2679'   47                    	MOV	B,A		; B = what is left of the line
  267A'   B7                    	ORA	A
  267B'   C8                    	RZ
  267C'   21 0081               	LXI	H,CMDTAIL+1
  267F'                         AS_TOK:				; at a token, or the blanks before one
  267F'   7E                    	MOV	A,M
  2680'   FE 20                 	CPI	' '
  2682'   C2 268B'              	JNZ	AS_OPT
  2685'   23                    	INX	H
  2686'   05                    	DCR	B
  2687'   C2 267F'              	JNZ	AS_TOK
  268A'   C9                    	RET
  268B'                         AS_OPT:
  268B'   FE 2B                 	CPI	'+'
  268D'   CA 26B7'              	JZ	AS_PLS
  2690'   FE 2D                 	CPI	'-'
  2692'   CA 26A6'              	JZ	AS_SW
  2695'   FE 2F                 	CPI	'/'
  2697'   CA 26A6'              	JZ	AS_SW
  269A'                         AS_SKP:				; not ours (the file name): on to the next one
  269A'   23                    	INX	H
  269B'   05                    	DCR	B
  269C'   C8                    	RZ
  269D'   7E                    	MOV	A,M
  269E'   FE 20                 	CPI	' '
  26A0'   C2 269A'              	JNZ	AS_SKP
  26A3'   C3 267F'              	JMP	AS_TOK
  26A6'                         AS_SW:
  26A6'   23                    	INX	H
  26A7'   05                    	DCR	B
  26A8'   C8                    	RZ
  26A9'   7E                    	MOV	A,M
  26AA'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  26AC'   FE 52                 	CPI	'R'
  26AE'   C2 269A'              	JNZ	AS_SKP
  26B1'   32 0000*              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  26B4'   C3 269A'              	JMP	AS_SKP
  26B7'                         AS_PLS:
  26B7'   3E 01                 	MVI	A,1
  26B9'   32 0000*              	STA	PLUSF		; '+' gets the line even with no number on it
  26BC'   11 0000*              	LXI	D,PLUSB
  26BF'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  26C1'   23                    	INX	H		;   line space, so it is taken as '+' alone
  26C2'   05                    	DCR	B
  26C3'   CA 26FA'              	JZ	AS_PE
  26C6'   7E                    	MOV	A,M
  26C7'   FE 30                 	CPI	'0'
  26C9'   C2 26E1'              	JNZ	AS_PD
  26CC'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  26CC'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  26CD'   05                    	DCR	B
  26CE'   CA 2702'              	JZ	AS_P1
	MACRO-80 3.44	09-Dec-81	PAGE	1-122


  26D1'   7E                    	MOV	A,M
  26D2'   FE 30                 	CPI	'0'
  26D4'   CA 26CC'              	JZ	AS_PZ
  26D7'   FE 31                 	CPI	'1'
  26D9'   DA 2702'              	JC	AS_P1		; zeros and then no digit at all: line 1
  26DC'   FE 3A                 	CPI	'9'+1
  26DE'   D2 2702'              	JNC	AS_P1
  26E1'                         AS_PD:				; the digits, as typed
  26E1'   7E                    	MOV	A,M
  26E2'   FE 30                 	CPI	'0'
  26E4'   DA 26FA'              	JC	AS_PE
  26E7'   FE 3A                 	CPI	'9'+1
  26E9'   D2 26FA'              	JNC	AS_PE
  26EC'   79                    	MOV	A,C
  26ED'   B7                    	ORA	A
  26EE'   CA 2709'              	JZ	AS_POV
  26F1'   0D                    	DCR	C
  26F2'   7E                    	MOV	A,M
  26F3'   12                    	STAX	D
  26F4'   13                    	INX	D
  26F5'   23                    	INX	H
  26F6'   05                    	DCR	B
  26F7'   C2 26E1'              	JNZ	AS_PD
  26FA'                         AS_PE:
  26FA'   AF                    	XRA	A
  26FB'   12                    	STAX	D		; the digits end with a 0
  26FC'   78                    	MOV	A,B
  26FD'   B7                    	ORA	A
  26FE'   C8                    	RZ
  26FF'   C3 267F'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  2702'                         AS_P1:
  2702'   3E 31                 	MVI	A,'1'
  2704'   12                    	STAX	D
  2705'   13                    	INX	D
  2706'   C3 26FA'              	JMP	AS_PE
  2709'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  2709'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  270C'   C3 26FA'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  270F'                         ARGGO:
  270F'   3A 0000*              	LDA	PLUSF
  2712'   B7                    	ORA	A
  2713'   C8                    	RZ
  2714'   21 0000*              	LXI	H,PLUSB
  2717'                         AG_LP:
  2717'   7E                    	MOV	A,M
  2718'   B7                    	ORA	A
  2719'   CA 2726'              	JZ	AG_G
  271C'   4F                    	MOV	C,A
  271D'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-123


  271E'   CD 0026'              	CALL	VICMD
  2721'   E1                    	POP	H
  2722'   23                    	INX	H
  2723'   C3 2717'              	JMP	AG_LP
  2726'                         AG_G:
  2726'   0E 47                 	MVI	C,'G'
  2728'   C3 0026'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  272B'                         NRMDRV:
  272B'   7E                    	MOV	A,M
  272C'   B7                    	ORA	A
  272D'   C0                    	RNZ
  272E'   E5                    	PUSH	H
  272F'   0E 19                 	MVI	C,BF_CURDSK
  2731'   CD 0005               	CALL	BDOS
  2734'   E1                    	POP	H
  2735'   3C                    	INR	A
  2736'   77                    	MOV	M,A
  2737'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  2738'                         PARSFN:
  2738'   CD 2648'              	CALL	TFCLR
  273B'   11 0000*              	LXI	D,TFCB
  273E'   23                    	INX	H
  273F'   7E                    	MOV	A,M
  2740'   2B                    	DCX	H
  2741'   FE 3A                 	CPI	':'
  2743'   C2 2755'              	JNZ	PF_NM
  2746'   CD 279B'              	CALL	GETFNC
  2749'   CA 2755'              	JZ	PF_NM
  274C'   D6 40                 	SUI	40H
  274E'   12                    	STAX	D
  274F'   FE 11                 	CPI	17
  2751'   D2 2779'              	JNC	PF_BAD
  2754'   23                    	INX	H
  2755'                         PF_NM:
  2755'   13                    	INX	D
  2756'   0E 08                 	MVI	C,8
  2758'   CD 277D'              	CALL	CPYNAM
  275B'   FE 2E                 	CPI	'.'
  275D'   0E 03                 	MVI	C,3
  275F'   C4 2790'              	CNZ	PADFLD		; no type: blanks
  2762'   CC 277C'              	CZ	CPYNM0		; '.': the type
  2765'   3A 0001*              	LDA	TFCB+1
  2768'   FE 20                 	CPI	' '
  276A'   CA 2779'              	JZ	PF_BAD		; no name
  276D'   CD 27CE'              	CALL	SKIPB
  2770'   C0                    	RNZ			; more after it
  2771'   21 0000*              	LXI	H,TFCB
  2774'   CD 272B'              	CALL	NRMDRV
	MACRO-80 3.44	09-Dec-81	PAGE	1-124


  2777'   AF                    	XRA	A
  2778'   C9                    	RET
  2779'                         PF_BAD:
  2779'   F6 01                 	ORI	1
  277B'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  277C'                         CPYNM0:
  277C'   23                    	INX	H
  277D'                         CPYNAM:
  277D'   CD 279B'              	CALL	GETFNC
  2780'   CA 2790'              	JZ	PADFLD
  2783'   12                    	STAX	D
  2784'   13                    	INX	D
  2785'   0D                    	DCR	C
  2786'   C2 277D'              	JNZ	CPYNAM
  2789'                         CN_SKP:
  2789'   CD 279B'              	CALL	GETFNC
  278C'   C2 2789'              	JNZ	CN_SKP
  278F'   C9                    	RET
  2790'                         PADFLD:
  2790'   F5                    	PUSH	PSW
  2791'                         PD_LP:
  2791'   3E 20                 	MVI	A,' '
  2793'   12                    	STAX	D
  2794'   13                    	INX	D
  2795'   0D                    	DCR	C
  2796'   C2 2791'              	JNZ	PD_LP
  2799'   F1                    	POP	PSW
  279A'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  279B'                         GETFNC:
  279B'   7E                    	MOV	A,M
  279C'   FE 3D                 	CPI	'='
  279E'   C8                    	RZ
  279F'   FE 5F                 	CPI	'_'
  27A1'   C8                    	RZ
  27A2'   FE 3B                 	CPI	';'
  27A4'   C8                    	RZ
