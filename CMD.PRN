  241A'   43 61 6E 27           SNOPN:	DB	'Can''t open file ',0
  241E'   74 20 6F 70           
  2422'   65 6E 20 66           
  2426'   69 6C 65 20           
  242A'   00                    
  242B'   49 6E 76 61           SRNGE:	DB	'Invalid range',0
  242F'   6C 69 64 20           
  2433'   72 61 6E 67           
  2437'   65 00                 
  2439'   44 69 73 6B           SDFUL:	DB	'Disk full',0
  243D'   20 66 75 6C           
  2441'   6C 00                 
                                
                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  0008                          EO_R	EQU	8
  2443'                         EXTAB:
  2443'   77 00 01              	DB	'w',0,EO_W
  2446'   71 00 02              	DB	'q',0,EO_Q
  2449'   77 71 03              	DB	'w','q',EO_WQ
  244C'   78 00 04              	DB	'x',0,EO_X
  244F'   65 00 05              	DB	'e',0,EO_E
  2452'   73 00 06              	DB	's',0,EO_S
  2455'   76 65 07              	DB	'v','e',EO_V
  2458'   72 00 08              	DB	'r',0,EO_R
  245B'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  245C'                         EXADDR:
  245C'   AF                    	XRA	A
  245D'   32 2AB6'              	STA	SRNGF
  2460'   7E                    	MOV	A,M
  2461'   FE 25                 	CPI	'%'
  2463'   CA 248C'              	JZ	EXA_AL
  2466'   EB                    	XCHG			; DE walks the line, HL takes the number
  2467'   CD 24A1'              	CALL	EXNUM
  246A'   DA 248A'              	JC	EXA_NO
  246D'   22 2AB7'              	SHLD	SRNG1
  2470'   22 2AB9'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  2473'   1A                    	LDAX	D
  2474'   FE 2C                 	CPI	','
  2476'   C2 2483'              	JNZ	EXA_YS
  2479'   13                    	INX	D
  247A'   CD 24A1'              	CALL	EXNUM
  247D'   DA 248A'              	JC	EXA_NO		; ',' with no number: not a range at all
  2480'   22 2AB9'              	SHLD	SRNG2
  2483'                         EXA_YS:
  2483'   EB                    	XCHG
  2484'   3E 01                 	MVI	A,1
  2486'   32 2AB6'              	STA	SRNGF
  2489'   C9                    	RET
  248A'                         EXA_NO:
  248A'   EB                    	XCHG
  248B'   C9                    	RET
  248C'                         EXA_AL:
  248C'   23                    	INX	H
  248D'   E5                    	PUSH	H
  248E'   21 0001               	LXI	H,1
  2491'   22 2AB7'              	SHLD	SRNG1
  2494'   21 FFFF               	LXI	H,0FFFFH
  2497'   22 2AB9'              	SHLD	SRNG2
  249A'   E1                    	POP	H
  249B'   3E 01                 	MVI	A,1
  249D'   32 2AB6'              	STA	SRNGF
  24A0'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  24A1'                         EXNUM:
  24A1'   1A                    	LDAX	D
  24A2'   D6 30                 	SUI	'0'
  24A4'   D8                    	RC
  24A5'   FE 0A                 	CPI	10
  24A7'   3F                    	CMC
  24A8'   D8                    	RC
  24A9'   21 0000               	LXI	H,0
  24AC'                         EXN_LP:
  24AC'   1A                    	LDAX	D
  24AD'   D6 30                 	SUI	'0'
  24AF'   DA 24C9'              	JC	EXN_DN
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  24B2'   FE 0A                 	CPI	10
  24B4'   D2 24C9'              	JNC	EXN_DN
  24B7'   13                    	INX	D
  24B8'   C5                    	PUSH	B
  24B9'   4F                    	MOV	C,A
  24BA'   06 00                 	MVI	B,0		; BC = the digit
  24BC'   D5                    	PUSH	D
  24BD'   54                    	MOV	D,H
  24BE'   5D                    	MOV	E,L
  24BF'   29                    	DAD	H		; *2
  24C0'   29                    	DAD	H		; *4
  24C1'   19                    	DAD	D		; *5
  24C2'   29                    	DAD	H		; *10
  24C3'   D1                    	POP	D
  24C4'   09                    	DAD	B
  24C5'   C1                    	POP	B
  24C6'   C3 24AC'              	JMP	EXN_LP
  24C9'                         EXN_DN:
  24C9'   B7                    	ORA	A		; CY clear: there was a number
  24CA'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  24CB'                         EX_S:
  24CB'   7E                    	MOV	A,M
  24CC'   B7                    	ORA	A
  24CD'   CA 250F'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  24D0'   32 2ABB'              	STA	SDELIM
  24D3'   23                    	INX	H
  24D4'   11 0000*              	LXI	D,SRCHST
  24D7'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  24DA'   4F                    	MOV	C,A
  24DB'   CD 2515'              	CALL	SCOPY
  24DE'   78                    	MOV	A,B
  24DF'   B7                    	ORA	A
  24E0'   CA 250F'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  24E3'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  24E6'   3E 01                 	MVI	A,1
  24E8'   32 2A83'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  24EB'   11 2ACD'              	LXI	D,SREPL
  24EE'   0E 24                 	MVI	C,SREPMX
  24F0'   CD 2515'              	CALL	SCOPY
  24F3'   78                    	MOV	A,B
  24F4'   32 2ACC'              	STA	SREPLN
  24F7'   AF                    	XRA	A
  24F8'   32 2ABC'              	STA	SGFLAG
  24FB'   7E                    	MOV	A,M
  24FC'   FE 67                 	CPI	'g'
  24FE'   C2 2507'              	JNZ	EX_SG
  2501'   23                    	INX	H
  2502'   3E 01                 	MVI	A,1
  2504'   32 2ABC'              	STA	SGFLAG
  2507'                         EX_SG:
  2507'   7E                    	MOV	A,M
  2508'   B7                    	ORA	A
  2509'   C2 22A6'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  250C'   C3 2535'              	JMP	SUBGO
  250F'                         SUBNOP:
  250F'   21 235E'              	LXI	H,SNOPAT
  2512'   C3 22B4'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  2515'                         SCOPY:
  2515'   06 00                 	MVI	B,0
  2517'                         SCP_LP:
  2517'   78                    	MOV	A,B
  2518'   B9                    	CMP	C
  2519'   D2 2532'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  251C'   7E                    	MOV	A,M
  251D'   B7                    	ORA	A
  251E'   CA 2532'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  2521'   E5                    	PUSH	H
  2522'   21 2ABB'              	LXI	H,SDELIM
  2525'   BE                    	CMP	M
  2526'   E1                    	POP	H
  2527'   CA 2531'              	JZ	SCP_SK
  252A'   12                    	STAX	D
  252B'   13                    	INX	D
  252C'   23                    	INX	H
  252D'   04                    	INR	B
  252E'   C3 2517'              	JMP	SCP_LP
  2531'                         SCP_SK:
  2531'   23                    	INX	H
  2532'                         SCP_DN:
  2532'   AF                    	XRA	A
  2533'   12                    	STAX	D
  2534'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  2535'                         SUBGO:
  2535'   CD 0F6D'              	CALL	GZONE
  2538'   2A 0000*              	LHLD	LNDLT
  253B'   22 2ACA'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  253E'   21 2AC7'              	LXI	H,SOFFS		;   finds nothing puts both back, as the
  2541'   CD 044F'              	CALL	FPSTO		;   search's SN_BAD does
  2544'   AF                    	XRA	A
  2545'   32 2ABD'              	STA	SANY
  2548'   21 0000               	LXI	H,0
  254B'   22 2ABF'              	SHLD	SBACK
  254E'   3A 2AB6'              	LDA	SRNGF
  2551'   B7                    	ORA	A
  2552'   CA 2564'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  2555'   CD 1E30'              	CALL	EXRNG		; SLINES = the lines in the range
  2558'   DA 25E0'              	JC	SUBBAD
  255B'   2A 2AB7'              	LHLD	SRNG1
  255E'   CD 0EDB'              	CALL	GOLN
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  2561'   C3 256A'              	JMP	SUBLP
  2564'                         SUB_1L:
  2564'   21 0001               	LXI	H,1
  2567'   22 2AC1'              	SHLD	SLINES
  256A'                         SUBLP:
  256A'   CD 25E6'              	CALL	SUBLIN		; A = 1 when this line changed
  256D'   B7                    	ORA	A
  256E'   CA 257C'              	JZ	SUB_NX
  2571'   3E 01                 	MVI	A,1
  2573'   32 2ABD'              	STA	SANY
  2576'   21 0000               	LXI	H,0
  2579'   22 2ABF'              	SHLD	SBACK		; the cursor is ON the last line changed
  257C'                         SUB_NX:
  257C'   2A 2AC1'              	LHLD	SLINES
  257F'   2B                    	DCX	H
  2580'   22 2AC1'              	SHLD	SLINES
  2583'   7C                    	MOV	A,H
  2584'   B5                    	ORA	L
  2585'   CA 25A3'              	JZ	SUBDON		; the range is spent
  2588'   21 0001               	LXI	H,1
  258B'   AF                    	XRA	A
  258C'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  258F'   3A 2ABD'              	LDA	SANY
  2592'   B7                    	ORA	A
  2593'   CA 259D'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  2596'   2A 2ABF'              	LHLD	SBACK
  2599'   23                    	INX	H
  259A'   22 2ABF'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  259D'                         SUB_AE:
  259D'   CD 0A11'              	CALL	ATEOF
  25A0'   D2 256A'              	JNC	SUBLP		; ... unless that ran off the end of the file
  25A3'                         SUBDON:
  25A3'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  25A6'   3A 2ABD'              	LDA	SANY
  25A9'   B7                    	ORA	A
  25AA'   CA 25C8'              	JZ	SUBNFD
  25AD'   3E 01                 	MVI	A,1
  25AF'   32 2A04'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  25B2'   2A 2ABF'              	LHLD	SBACK
  25B5'   7C                    	MOV	A,H
  25B6'   B5                    	ORA	L
  25B7'   CA 25C2'              	JZ	SUB_PL
  25BA'   3E FF                 	MVI	A,0FFH
  25BC'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  25BF'   CD 0000*              	CALL	CLRCNT
  25C2'                         SUB_PL:
  25C2'   CD 0F85'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  25C5'   C3 077B'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  25C8'                         SUBNFD:
  25C8'   21 2AC7'              	LXI	H,SOFFS
  25CB'   CD 03F6'              	CALL	BACKTO
  25CE'   2A 2ACA'              	LHLD	SLDLTS
  25D1'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  25D4'   21 233E'              	LXI	H,SNOTFD
  25D7'   CD 22B4'              	CALL	EXERR
  25DA'   21 0000*              	LXI	H,SRCHST
  25DD'   C3 22AF'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  25E0'                         SUBBAD:
  25E0'   21 232C'              	LXI	H,SNOT
  25E3'   C3 22A9'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  25E6'                         SUBLIN:
  25E6'   AF                    	XRA	A
  25E7'   32 2ABE'              	STA	SLCHG
  25EA'   CD 2665'              	CALL	SUBBOL
  25ED'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  25F0'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  25F0'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  25F3'   DA 25FB'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  25F6'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  25F8'   C2 25F0'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  25FB'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  25FB'   CD 0000*              	CALL	CUROFF
  25FE'   E5                    	PUSH	H
  25FF'   CD 14E9'              	CALL	CEND
  2602'   D1                    	POP	D
  2603'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  2606'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  2607'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  260A'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  260B'   B7                    	ORA	A		;   span is a line, not a pair.)
  260C'   FA 265E'              	JM	SUBL_D		; what is left is shorter than the pattern
  260F'   44                    	MOV	B,H
  2610'   4D                    	MOV	C,L		; BC = the start positions a match can take
  2611'   11 0000*              	LXI	D,SRCHST
  2614'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  2617'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  261A'   DA 265E'              	JC	SUBL_D
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  261D'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  2620'   EB                    	XCHG
  2621'   2A 0000*              	LHLD	GAPEND
  2624'   EB                    	XCHG
  2625'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  2628'   EB                    	XCHG
  2629'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  262A'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  262D'   D1                    	POP	D
  262E'   19                    	DAD	D		; ... and so the match's logical offset
  262F'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  2632'   3A 2ABD'              	LDA	SANY
  2635'   B7                    	ORA	A
  2636'   C2 2643'              	JNZ	SUBL_C
  2639'   3A 2ABE'              	LDA	SLCHG
  263C'   B7                    	ORA	A
  263D'   C2 2643'              	JNZ	SUBL_C
  2640'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  2643'                         SUBL_C:
  2643'   3A 0000*              	LDA	SRCHBF
  2646'   6F                    	MOV	L,A
  2647'   26 00                 	MVI	H,0
  2649'   CD 0000*              	CALL	DELFWD		; the match goes
  264C'   11 2ACC'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  264F'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  2652'                         SUBL_I:
  2652'   3E 01                 	MVI	A,1
  2654'   32 2ABE'              	STA	SLCHG
  2657'   3A 2ABC'              	LDA	SGFLAG
  265A'   B7                    	ORA	A
  265B'   C2 25FB'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  265E'                         SUBL_D:
  265E'   CD 2665'              	CALL	SUBBOL
  2661'   3A 2ABE'              	LDA	SLCHG
  2664'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  2665'                         SUBBOL:
  2665'   CD 0000*              	CALL	CUROFF
  2668'   CD 05E4'              	CALL	BOL
  266B'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  266E'                         VC_SRCH:
  266E'   CD 075A'              	CALL	SETMOV
  2671'   C5                    	PUSH	B
  2672'   CD 068B'              	CALL	GETCNT
  2675'   22 2AAC'              	SHLD	SCNT
  2678'   C1                    	POP	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


  2679'   79                    	MOV	A,C
  267A'   FE 2F                 	CPI	'/'
  267C'   3E 00                 	MVI	A,0
  267E'   CA 2683'              	JZ	VS_DIR
  2681'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  2683'                         VS_DIR:
  2683'   32 2A81'              	STA	SDIR
  2686'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2689'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  268C'   47                    	MOV	B,A
  268D'   CD 1BCC'              	CALL	RDLINE
  2690'   B7                    	ORA	A
  2691'   C0                    	RNZ			; cancelled: nothing happens at all
  2692'   3A 2A59'              	LDA	RLLEN
  2695'   B7                    	ORA	A
  2696'   CA 26AB'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  2699'   5F                    	MOV	E,A
  269A'   16 00                 	MVI	D,0
  269C'   21 0000*              	LXI	H,SRCHST
  269F'   19                    	DAD	D
  26A0'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  26A2'   7B                    	MOV	A,E
  26A3'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  26A6'   3E 01                 	MVI	A,1
  26A8'   32 2A83'              	STA	SHAVE
  26AB'                         VS_OLD:
  26AB'   3A 2A83'              	LDA	SHAVE
  26AE'   B7                    	ORA	A
  26AF'   CA 26BB'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  26B2'   3A 2A81'              	LDA	SDIR
  26B5'   32 2A82'              	STA	SDIRE
  26B8'   C3 26E4'              	JMP	SRCHN
  26BB'                         VS_NOP:
  26BB'   21 235E'              	LXI	H,SNOPAT
  26BE'   C3 22B4'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  26C1'                         VC_N:
  26C1'   CD 075A'              	CALL	SETMOV
  26C4'   3A 2A81'              	LDA	SDIR
  26C7'   C3 26D1'              	JMP	VN_GO
  26CA'                         VCB_N:
  26CA'   CD 075A'              	CALL	SETMOV
  26CD'   3A 2A81'              	LDA	SDIR
  26D0'   2F                    	CMA			; the other way: 0 <-> FFH
  26D1'                         VN_GO:
  26D1'   32 2A82'              	STA	SDIRE
  26D4'   CD 068B'              	CALL	GETCNT
  26D7'   22 2AAC'              	SHLD	SCNT
  26DA'   3A 2A83'              	LDA	SHAVE
  26DD'   B7                    	ORA	A
  26DE'   CA 26BB'              	JZ	VS_NOP
  26E1'   C3 26E4'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  26E4'                         SRCHN:
  26E4'   CD 0F6D'              	CALL	GZONE		; the screen's top line, before the cursor moves
  26E7'   CD 06B4'              	CALL	BRKON		; where it started (the sweep moves the cursor
                                				;   with PUTCUR, which does not maintain LNDLT;
                                				;   GOTO does), and a ^C may stop it
  26EA'                         SN_LP:
  26EA'   CD 271F'              	CALL	SRCHGO
  26ED'   DA 270A'              	JC	SN_BAD
  26F0'   2A 2AAC'              	LHLD	SCNT
  26F3'   2B                    	DCX	H
  26F4'   22 2AAC'              	SHLD	SCNT
  26F7'   7C                    	MOV	A,H
  26F8'   B5                    	ORA	L
  26F9'   C2 26EA'              	JNZ	SN_LP
  26FC'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  26FF'   CD 06EB'              	CALL	BRKOFF
  2702'   3E 01                 	MVI	A,1
  2704'   32 2A8E'              	STA	GPKEEP		; land on the match, not the first non-blank
  2707'   C3 0F85'              	JMP	GPLACE		; (which sets LNDLT itself)
  270A'                         SN_BAD:
  270A'   CD 06EB'              	CALL	BRKOFF
  270D'   DA 0703'              	JC	BRKBAK		; stopped, which is not the same as not found
  2710'   CD 06F6'              	CALL	RSTPL		; nothing moved: the row the cursor was on
  2713'   21 233E'              	LXI	H,SNOTFD
  2716'   CD 22B4'              	CALL	EXERR
  2719'   21 0000*              	LXI	H,SRCHST
  271C'   C3 22AF'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  271F'                         SRCHGO:
  271F'   3E 01                 	MVI	A,1
  2721'   32 2AB5'              	STA	SSKIP		; this pass starts one past the cursor
  2724'   CD 273A'              	CALL	SRCHW
  2727'   D0                    	RNC
  2728'   CD 06EF'              	CALL	BRKQ
  272B'   D8                    	RC			; stopped: no second pass
  272C'   3A 2A82'              	LDA	SDIRE
  272F'   2F                    	CMA
  2730'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  2733'   AF                    	XRA	A
  2734'   32 2AB5'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  2737'   C3 273A'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  273A'                         SRCHW:
  273A'   3A 2A82'              	LDA	SDIRE
  273D'   32 0000*              	STA	DIRFLG
  2740'   21 FFFF               	LXI	H,0FFFFH
  2743'   22 2A01'              	SHLD	CMDCNT
  2746'   AF                    	XRA	A
  2747'   32 0000*              	STA	AUXCNT
  274A'                         SW_LP:
  274A'   CD 06EF'              	CALL	BRKQ		; a ^C spent the count, here or on the way to
  274D'   D8                    	RC			;   the wrapped pass: SCRLST no longer pages
  274E'   CD 275A'              	CALL	SRCH1
  2751'   D0                    	RNC
  2752'   CD 0000*              	CALL	SCRLST
  2755'   D2 274A'              	JNC	SW_LP
  2758'   37                    	STC
  2759'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  275A'                         SRCH1:
  275A'   11 0000*              	LXI	D,SRCHST
  275D'   3A 0000*              	LDA	DIRFLG
  2760'   B7                    	ORA	A
  2761'   FA 2785'              	JM	SR1_BK
  2764'   21 0000*              	LXI	H,GAPEND
  2767'   CD 0000*              	CALL	FWDCNT
  276A'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  276D'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  276E'   3A 2AB5'              	LDA	SSKIP
  2771'   B7                    	ORA	A
  2772'   CA 277B'              	JZ	SR1_FW
  2775'   78                    	MOV	A,B
  2776'   B1                    	ORA	C
  2777'   37                    	STC
  2778'   C8                    	RZ			; no room for a match even before the skip
  2779'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  277A'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  277B'                         SR1_FW:
  277B'   CD 0000*              	CALL	MATCHF
  277E'   D8                    	RC
  277F'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2782'   C3 0000*              	JMP	PUTCUR
  2785'                         SR1_BK:
  2785'   21 0000*              	LXI	H,TXTBEG
  2788'   CD 0000*              	CALL	FWDCNT
  278B'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  278E'   D8                    	RC
  278F'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2792'   CD 0000*              	CALL	MATCHB
  2795'   D8                    	RC
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


  2796'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2799'                         MSGNAM:
  2799'   E5                    	PUSH	H
  279A'   3E 22                 	MVI	A,'"'
  279C'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  279F'   E1                    	POP	H
  27A0'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  27A1'   23                    	INX	H
  27A2'   7E                    	MOV	A,M
  27A3'   FE 20                 	CPI	' '
  27A5'   C2 27B2'              	JNZ	MN_HAS
  27A8'   21 23CC'              	LXI	H,SNONM
  27AB'   CD 0000*              	CALL	OUTSTR
  27AE'   E1                    	POP	H
  27AF'   C3 27FC'              	JMP	MN_END
  27B2'                         MN_HAS:
  27B2'   0E 19                 	MVI	C,BF_CURDSK
  27B4'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  27B7'   E1                    	POP	H
  27B8'   E5                    	PUSH	H
  27B9'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  27BA'   BE                    	CMP	M
  27BB'   CA 27C9'              	JZ	MN_NAM
  27BE'   7E                    	MOV	A,M
  27BF'   C6 40                 	ADI	'A'-1
  27C1'   CD 0000*              	CALL	OUTCH
  27C4'   3E 3A                 	MVI	A,':'
  27C6'   CD 0000*              	CALL	OUTCH
  27C9'                         MN_NAM:
  27C9'   E1                    	POP	H
  27CA'   E5                    	PUSH	H
  27CB'   23                    	INX	H
  27CC'   0E 08                 	MVI	C,8
  27CE'                         MN_NM:
	MACRO-80 3.44	09-Dec-81	PAGE	1-122


  27CE'   7E                    	MOV	A,M
  27CF'   FE 20                 	CPI	' '
  27D1'   CA 27DC'              	JZ	MN_EXT
  27D4'   CD 0000*              	CALL	OUTCH
  27D7'   23                    	INX	H
  27D8'   0D                    	DCR	C
  27D9'   C2 27CE'              	JNZ	MN_NM
  27DC'                         MN_EXT:
  27DC'   E1                    	POP	H
  27DD'   11 0009               	LXI	D,9
  27E0'   19                    	DAD	D		; the type field
  27E1'   7E                    	MOV	A,M
  27E2'   FE 20                 	CPI	' '
  27E4'   CA 27FC'              	JZ	MN_END
  27E7'   3E 2E                 	MVI	A,'.'
  27E9'   CD 0000*              	CALL	OUTCH
  27EC'   0E 03                 	MVI	C,3
  27EE'                         MN_XL:
  27EE'   7E                    	MOV	A,M
  27EF'   FE 20                 	CPI	' '
  27F1'   CA 27FC'              	JZ	MN_END
  27F4'   CD 0000*              	CALL	OUTCH
  27F7'   23                    	INX	H
  27F8'   0D                    	DCR	C
  27F9'   C2 27EE'              	JNZ	MN_XL
  27FC'                         MN_END:
  27FC'   3E 22                 	MVI	A,'"'
  27FE'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  2801'                         MSGFLG:
  2801'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  2803'   B7                    	ORA	A
  2804'   CA 2814'              	JZ	MF_RO
  2807'   3A 2A04'              	LDA	MODF
  280A'   B7                    	ORA	A
  280B'   CA 2814'              	JZ	MF_RO
  280E'   21 23D6'              	LXI	H,SMODM
  2811'   CD 2829'              	CALL	MF_PUT
  2814'                         MF_RO:
  2814'   3A 2A6F'              	LDA	ROFLAG
  2817'   B7                    	ORA	A
  2818'   CA 2821'              	JZ	MF_NEW
  281B'   21 23E1'              	LXI	H,SROM
  281E'   CD 2829'              	CALL	MF_PUT
  2821'                         MF_NEW:
  2821'   3A 2A6D'              	LDA	MSGNEW
  2824'   B7                    	ORA	A
  2825'   C8                    	RZ
  2826'   21 23EC'              	LXI	H,SNEWM
  2829'                         MF_PUT:
  2829'   78                    	MOV	A,B
  282A'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-123


  282B'   C2 2837'              	JNZ	MF_STR
  282E'   06 01                 	MVI	B,1
  2830'   E5                    	PUSH	H
  2831'   3E 20                 	MVI	A,' '
  2833'   CD 0000*              	CALL	OUTCH
  2836'   E1                    	POP	H
  2837'                         MF_STR:
  2837'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  283A'                         EMITW:
  283A'   C5                    	PUSH	B
  283B'   D5                    	PUSH	D
  283C'   06 00                 	MVI	B,0
  283E'   11 2710               	LXI	D,10000
  2841'   CD 285F'              	CALL	EWDIG
  2844'   11 03E8               	LXI	D,1000
  2847'   CD 285F'              	CALL	EWDIG
  284A'   11 0064               	LXI	D,100
  284D'   CD 285F'              	CALL	EWDIG
  2850'   11 000A               	LXI	D,10
  2853'   CD 285F'              	CALL	EWDIG
  2856'   7D                    	MOV	A,L		; the units digit is always printed
  2857'   C6 30                 	ADI	'0'
  2859'   CD 0000*              	CALL	OUTCH
  285C'   D1                    	POP	D
  285D'   C1                    	POP	B
  285E'   C9                    	RET
  285F'                         EWDIG:
  285F'   0E 00                 	MVI	C,0
  2861'                         EW_LP:
  2861'   7D                    	MOV	A,L
  2862'   93                    	SUB	E
  2863'   6F                    	MOV	L,A
  2864'   7C                    	MOV	A,H
  2865'   9A                    	SBB	D
  2866'   67                    	MOV	H,A
  2867'   DA 286E'              	JC	EW_DN
  286A'   0C                    	INR	C
  286B'   C3 2861'              	JMP	EW_LP
  286E'                         EW_DN:
  286E'   19                    	DAD	D		; one subtraction too many: give it back
  286F'   79                    	MOV	A,C
  2870'   B7                    	ORA	A
  2871'   C2 2877'              	JNZ	EW_PR
  2874'   78                    	MOV	A,B
  2875'   B7                    	ORA	A
  2876'   C8                    	RZ			; a leading zero: write nothing
  2877'                         EW_PR:
  2877'   79                    	MOV	A,C
  2878'   C6 30                 	ADI	'0'
  287A'   CD 0000*              	CALL	OUTCH
  287D'   06 01                 	MVI	B,1
  287F'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-124


                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  2880'                         ISEMPT:
  2880'   2A 0000*              	LHLD	OUTPOS
  2883'   7C                    	MOV	A,H
  2884'   B5                    	ORA	L
  2885'   C0                    	RNZ
  2886'   CD 0000*              	CALL	LOGLEN
  2889'   7C                    	MOV	A,H
  288A'   B5                    	ORA	L
  288B'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  288C'                         MSGCTG:
  288C'   21 0000*              	LXI	H,FNAME
  288F'   CD 2799'              	CALL	MSGNAM
  2892'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  2894'   CD 2801'              	CALL	MSGFLG
  2897'   CD 2880'              	CALL	ISEMPT
  289A'   C2 28A3'              	JNZ	MG_POS
  289D'   21 23FF'              	LXI	H,SNOLIN
  28A0'   C3 0000*              	JMP	OUTSTR
  28A3'                         MG_POS:
  28A3'   21 23F2'              	LXI	H,SLINE
  28A6'   CD 0000*              	CALL	OUTSTR
  28A9'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  28AC'   23                    	INX	H		;   ... so the line it is on
  28AD'   CD 283A'              	CALL	EMITW
  28B0'   21 23F9'              	LXI	H,SCOLM
  28B3'   CD 0000*              	CALL	OUTSTR
  28B6'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  28B9'   23                    	INX	H
  28BA'   E5                    	PUSH	H
  28BB'   CD 283A'              	CALL	EMITW
  28BE'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  28C1'   23                    	INX	H
  28C2'   D1                    	POP	D
  28C3'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  28C6'   C8                    	RZ
  28C7'   E5                    	PUSH	H
  28C8'   3E 2D                 	MVI	A,'-'
  28CA'   CD 0000*              	CALL	OUTCH
  28CD'   E1                    	POP	H
  28CE'   C3 283A'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  28D1'                         FILMSG:
  28D1'   3A 0001*              	LDA	FNAME+1
  28D4'   FE 20                 	CPI	' '
  28D6'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-125


  28D7'   21 0000*              	LXI	H,FNAME
  28DA'   CD 2799'              	CALL	MSGNAM
  28DD'   AF                    	XRA	A		; nothing has been changed yet
  28DE'   C3 2801'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  28E1'                         WRMSG:
  28E1'   21 0000*              	LXI	H,TFCB
  28E4'   CD 2799'              	CALL	MSGNAM
  28E7'   21 2411'              	LXI	H,SWRIT
  28EA'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  28ED'                         MSGPST:
  28ED'   3A 2A6C'              	LDA	MSGWHT
  28F0'   B7                    	ORA	A
  28F1'   C8                    	RZ
  28F2'   47                    	MOV	B,A
  28F3'   AF                    	XRA	A
  28F4'   32 2A6C'              	STA	MSGWHT
  28F7'   78                    	MOV	A,B
  28F8'   FE 01                 	CPI	MW_FIL
  28FA'   CA 2916'              	JZ	MP_FIL
  28FD'   FE 02                 	CPI	MW_WRT
  28FF'   CA 291C'              	JZ	MP_WRT
  2902'   FE 04                 	CPI	MW_BIG
  2904'   CA 290D'              	JZ	MP_BIG
  2907'   CD 288C'              	CALL	MSGCTG
  290A'   C3 0000*              	JMP	SCURS
  290D'                         MP_BIG:
  290D'   21 23AD'              	LXI	H,SQBIG
  2910'   CD 0000*              	CALL	EXMSG
  2913'   C3 0000*              	JMP	SCURS
  2916'                         MP_FIL:
  2916'   CD 28D1'              	CALL	FILMSG
  2919'   C3 0000*              	JMP	SCURS
  291C'                         MP_WRT:
  291C'   CD 28E1'              	CALL	WRMSG
  291F'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  2922'                         VC_CTLG:
  2922'   3E 03                 	MVI	A,MW_CTG
  2924'   32 2A6C'              	STA	MSGWHT
  2927'   3E 01                 	MVI	A,R_MOVE
  2929'   32 2A05'              	STA	RINTENT
  292C'   C3 068B'              	JMP	GETCNT		; a count typed before it is spent here, not
                                				;   left for the next command
                                
  292F'                         CMDTAB:
  292F'   07                    	DB	07H			; ^G -- where am I?
  2930'   2922'                 	DW	VC_CTLG
