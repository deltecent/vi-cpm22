  19F8'                         EX_W:
  19F8'   CD 1ACC'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  19FB'   D8                    	RC			; refused (message shown)
  19FC'   32 24A4'              	STA	EXBAK
  19FF'   3A 24A2'              	LDA	EXOP
  1A02'   FE 01                 	CPI	EO_W
  1A04'   CA 1A1B'              	JZ	EX_WK
  1A07'   3A 24A4'              	LDA	EXBAK
  1A0A'   B7                    	ORA	A
  1A0B'   C2 1A5B'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1A0E'   3A 24B5'              	LDA	EXBANG
  1A11'   B7                    	ORA	A
  1A12'   CA 1A5B'              	JZ	EX_WQ		; so it does with '!'
  1A15'   CD 1A1B'              	CALL	EX_WK		; else it may not: keep the text
  1A18'   C3 1A5E'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1A1B'                         EX_WK:
  1A1B'   CD 0C04'              	CALL	CURRW		; the cursor's row and file position
  1A1E'   32 24A7'              	STA	WPROW
  1A21'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1A24'   7D                    	MOV	A,L
  1A25'   E6 7F                 	ANI	7FH
  1A27'   32 24A8'              	STA	WPBYT
  1A2A'   7D                    	MOV	A,L
  1A2B'   17                    	RAL
  1A2C'   7C                    	MOV	A,H
  1A2D'   17                    	RAL
  1A2E'   5F                    	MOV	E,A
  1A2F'   3E 00                 	MVI	A,0
  1A31'   17                    	RAL
  1A32'   57                    	MOV	D,A		; DE = HL / 128
  1A33'   2A 0000*              	LHLD	OUTPOS
  1A36'   19                    	DAD	D
  1A37'   22 24A9'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1A3A'   CD 1B01'              	CALL	WRITE
  1A3D'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1A40'   2A 24A9'              	LHLD	WPREC
  1A43'   EB                    	XCHG
  1A44'   3A 24A8'              	LDA	WPBYT
  1A47'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1A4A'   CD 0000*              	CALL	GOTO
  1A4D'   21 0000               	LXI	H,0
  1A50'   22 0000*              	SHLD	LNDLT
  1A53'   3A 24A7'              	LDA	WPROW
  1A56'   6F                    	MOV	L,A
  1A57'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1A5A'   C9                    	RET
  1A5B'                         EX_WQ:
  1A5B'   CD 1B01'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1A5E'                         EX_Q:
  1A5E'   3A 24B5'              	LDA	EXBANG
  1A61'   B7                    	ORA	A
  1A62'   CA 1A6C'              	JZ	EX_QT
  1A65'   3A 2457'              	LDA	MODF
  1A68'   B7                    	ORA	A
  1A69'   C2 1D20'              	JNZ	MSGNWR		; changed, no '!': stay
