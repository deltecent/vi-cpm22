  1035'   57                    	MOV	D,A		; D = h1 + h2
  1036'   79                    	MOV	A,C
  1037'   BA                    	CMP	D
  1038'   DA 105F'              	JC	OV_0
  103B'   CD 1063'              	CALL	OV_NX
  103E'   DA 105F'              	JC	OV_0
  1041'   7B                    	MOV	A,E
  1042'   86                    	ADD	M
  1043'   5F                    	MOV	E,A		; E = h2 + h3
  1044'   79                    	MOV	A,C
  1045'   BB                    	CMP	E
  1046'   DA 105F'              	JC	OV_0
  1049'   7A                    	MOV	A,D
  104A'   86                    	ADD	M
  104B'   57                    	MOV	D,A		; D = h1 + h2 + h3
  104C'   CD 1063'              	CALL	OV_NX
  104F'   DA 105C'              	JC	OV_1
  1052'   7B                    	MOV	A,E
  1053'   86                    	ADD	M		; h2 + h3 + h4
  1054'   5F                    	MOV	E,A
  1055'   79                    	MOV	A,C
  1056'   BB                    	CMP	E
  1057'   DA 105C'              	JC	OV_1
  105A'   BA                    	CMP	D
