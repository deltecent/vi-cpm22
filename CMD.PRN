  2313'   27                    	DB	27H		; '{a-c} -- back to its line's first non-blank
  2314'   0252'                 	DW	VC_AQ
  2316'   00                    	DB	0
                                
  2317'                         ACTTAB:
  2317'   04                    	DB	ACT_CURLT
  2318'   0560'                 	DW	VC_H
  231A'   03                    	DB	ACT_CURRT
  231B'   058A'                 	DW	VC_L
  231D'   02                    	DB	ACT_CURDN
  231E'   064F'                 	DW	VC_J
  2320'   01                    	DB	ACT_CURUP
  2321'   065E'                 	DW	VC_K
  2323'   05                    	DB	ACT_LINST
  2324'   05B1'                 	DW	VC_0
  2326'   06                    	DB	ACT_LINEN
  2327'   060D'                 	DW	VC_EOL
  2329'   07                    	DB	ACT_PGUP
  232A'   0B4C'                 	DW	VC_PGUP
  232C'   08                    	DB	ACT_PGDN
