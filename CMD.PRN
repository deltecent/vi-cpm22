  2464'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  2465'                         EXADDR:
  2465'   AF                    	XRA	A
  2466'   32 2ABF'              	STA	SRNGF
  2469'   7E                    	MOV	A,M
  246A'   FE 25                 	CPI	'%'
  246C'   CA 2495'              	JZ	EXA_AL
  246F'   EB                    	XCHG			; DE walks the line, HL takes the number
  2470'   CD 24AA'              	CALL	EXNUM
  2473'   DA 2493'              	JC	EXA_NO
  2476'   22 2AC0'              	SHLD	SRNG1
  2479'   22 2AC2'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  247C'   1A                    	LDAX	D
  247D'   FE 2C                 	CPI	','
  247F'   C2 248C'              	JNZ	EXA_YS
  2482'   13                    	INX	D
  2483'   CD 24AA'              	CALL	EXNUM
  2486'   DA 2493'              	JC	EXA_NO		; ',' with no number: not a range at all
  2489'   22 2AC2'              	SHLD	SRNG2
  248C'                         EXA_YS:
  248C'   EB                    	XCHG
  248D'   3E 01                 	MVI	A,1
  248F'   32 2ABF'              	STA	SRNGF
  2492'   C9                    	RET
  2493'                         EXA_NO:
  2493'   EB                    	XCHG
  2494'   C9                    	RET
  2495'                         EXA_AL:
  2495'   23                    	INX	H
  2496'   E5                    	PUSH	H
  2497'   21 0001               	LXI	H,1
  249A'   22 2AC0'              	SHLD	SRNG1
  249D'   21 FFFF               	LXI	H,0FFFFH
  24A0'   22 2AC2'              	SHLD	SRNG2
  24A3'   E1                    	POP	H
  24A4'   3E 01                 	MVI	A,1
  24A6'   32 2ABF'              	STA	SRNGF
  24A9'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  24AA'                         EXNUM:
  24AA'   1A                    	LDAX	D
  24AB'   D6 30                 	SUI	'0'
  24AD'   D8                    	RC
  24AE'   FE 0A                 	CPI	10
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  24B0'   3F                    	CMC
  24B1'   D8                    	RC
  24B2'   21 0000               	LXI	H,0
  24B5'                         EXN_LP:
  24B5'   1A                    	LDAX	D
  24B6'   D6 30                 	SUI	'0'
  24B8'   DA 24D2'              	JC	EXN_DN
  24BB'   FE 0A                 	CPI	10
  24BD'   D2 24D2'              	JNC	EXN_DN
  24C0'   13                    	INX	D
  24C1'   C5                    	PUSH	B
  24C2'   4F                    	MOV	C,A
  24C3'   06 00                 	MVI	B,0		; BC = the digit
  24C5'   D5                    	PUSH	D
  24C6'   54                    	MOV	D,H
  24C7'   5D                    	MOV	E,L
  24C8'   29                    	DAD	H		; *2
  24C9'   29                    	DAD	H		; *4
  24CA'   19                    	DAD	D		; *5
  24CB'   29                    	DAD	H		; *10
  24CC'   D1                    	POP	D
  24CD'   09                    	DAD	B
  24CE'   C1                    	POP	B
  24CF'   C3 24B5'              	JMP	EXN_LP
  24D2'                         EXN_DN:
  24D2'   B7                    	ORA	A		; CY clear: there was a number
  24D3'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  24D4'                         EX_S:
  24D4'   7E                    	MOV	A,M
  24D5'   B7                    	ORA	A
  24D6'   CA 2518'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  24D9'   32 2AC4'              	STA	SDELIM
  24DC'   23                    	INX	H
  24DD'   11 0000*              	LXI	D,SRCHST
  24E0'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  24E3'   4F                    	MOV	C,A
  24E4'   CD 251E'              	CALL	SCOPY
  24E7'   78                    	MOV	A,B
  24E8'   B7                    	ORA	A
  24E9'   CA 2518'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  24EC'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  24EF'   3E 01                 	MVI	A,1
  24F1'   32 2A8C'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  24F4'   11 2AD6'              	LXI	D,SREPL
  24F7'   0E 24                 	MVI	C,SREPMX
  24F9'   CD 251E'              	CALL	SCOPY
  24FC'   78                    	MOV	A,B
  24FD'   32 2AD5'              	STA	SREPLN
  2500'   AF                    	XRA	A
  2501'   32 2AC5'              	STA	SGFLAG
  2504'   7E                    	MOV	A,M
  2505'   FE 67                 	CPI	'g'
  2507'   C2 2510'              	JNZ	EX_SG
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  250A'   23                    	INX	H
  250B'   3E 01                 	MVI	A,1
  250D'   32 2AC5'              	STA	SGFLAG
  2510'                         EX_SG:
  2510'   7E                    	MOV	A,M
  2511'   B7                    	ORA	A
  2512'   C2 22AF'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  2515'   C3 253E'              	JMP	SUBGO
  2518'                         SUBNOP:
  2518'   21 2367'              	LXI	H,SNOPAT
  251B'   C3 22BD'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  251E'                         SCOPY:
  251E'   06 00                 	MVI	B,0
  2520'                         SCP_LP:
  2520'   78                    	MOV	A,B
  2521'   B9                    	CMP	C
  2522'   D2 253B'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  2525'   7E                    	MOV	A,M
  2526'   B7                    	ORA	A
  2527'   CA 253B'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  252A'   E5                    	PUSH	H
  252B'   21 2AC4'              	LXI	H,SDELIM
  252E'   BE                    	CMP	M
  252F'   E1                    	POP	H
  2530'   CA 253A'              	JZ	SCP_SK
  2533'   12                    	STAX	D
  2534'   13                    	INX	D
  2535'   23                    	INX	H
  2536'   04                    	INR	B
  2537'   C3 2520'              	JMP	SCP_LP
  253A'                         SCP_SK:
  253A'   23                    	INX	H
  253B'                         SCP_DN:
  253B'   AF                    	XRA	A
  253C'   12                    	STAX	D
  253D'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  253E'                         SUBGO:
  253E'   CD 0F76'              	CALL	GZONE
  2541'   2A 0000*              	LHLD	LNDLT
  2544'   22 2AD3'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  2547'   21 2AD0'              	LXI	H,SOFFS		;   finds nothing puts both back, as the
  254A'   CD 044F'              	CALL	FPSTO		;   search's SN_BAD does
  254D'   AF                    	XRA	A
  254E'   32 2AC6'              	STA	SANY
  2551'   21 0000               	LXI	H,0
  2554'   22 2AC8'              	SHLD	SBACK
  2557'   3A 2ABF'              	LDA	SRNGF
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  255A'   B7                    	ORA	A
  255B'   CA 256D'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  255E'   CD 1E39'              	CALL	EXRNG		; SLINES = the lines in the range
  2561'   DA 25E9'              	JC	SUBBAD
  2564'   2A 2AC0'              	LHLD	SRNG1
  2567'   CD 0EE4'              	CALL	GOLN
  256A'   C3 2573'              	JMP	SUBLP
  256D'                         SUB_1L:
  256D'   21 0001               	LXI	H,1
  2570'   22 2ACA'              	SHLD	SLINES
  2573'                         SUBLP:
  2573'   CD 25EF'              	CALL	SUBLIN		; A = 1 when this line changed
  2576'   B7                    	ORA	A
  2577'   CA 2585'              	JZ	SUB_NX
  257A'   3E 01                 	MVI	A,1
  257C'   32 2AC6'              	STA	SANY
  257F'   21 0000               	LXI	H,0
  2582'   22 2AC8'              	SHLD	SBACK		; the cursor is ON the last line changed
  2585'                         SUB_NX:
  2585'   2A 2ACA'              	LHLD	SLINES
  2588'   2B                    	DCX	H
  2589'   22 2ACA'              	SHLD	SLINES
  258C'   7C                    	MOV	A,H
  258D'   B5                    	ORA	L
  258E'   CA 25AC'              	JZ	SUBDON		; the range is spent
  2591'   21 0001               	LXI	H,1
  2594'   AF                    	XRA	A
  2595'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  2598'   3A 2AC6'              	LDA	SANY
  259B'   B7                    	ORA	A
  259C'   CA 25A6'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  259F'   2A 2AC8'              	LHLD	SBACK
  25A2'   23                    	INX	H
  25A3'   22 2AC8'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  25A6'                         SUB_AE:
  25A6'   CD 0A1D'              	CALL	ATEOF
  25A9'   D2 2573'              	JNC	SUBLP		; ... unless that ran off the end of the file
  25AC'                         SUBDON:
  25AC'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  25AF'   3A 2AC6'              	LDA	SANY
  25B2'   B7                    	ORA	A
  25B3'   CA 25D1'              	JZ	SUBNFD
  25B6'   3E 01                 	MVI	A,1
  25B8'   32 2A0D'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  25BB'   2A 2AC8'              	LHLD	SBACK
  25BE'   7C                    	MOV	A,H
  25BF'   B5                    	ORA	L
  25C0'   CA 25CB'              	JZ	SUB_PL
  25C3'   3E FF                 	MVI	A,0FFH
  25C5'   CD 0000*              	CALL	MVLIND		; back to the last line changed
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  25C8'   CD 0000*              	CALL	CLRCNT
  25CB'                         SUB_PL:
  25CB'   CD 0F8E'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  25CE'   C3 077B'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  25D1'                         SUBNFD:
  25D1'   21 2AD0'              	LXI	H,SOFFS
  25D4'   CD 03F6'              	CALL	BACKTO
  25D7'   2A 2AD3'              	LHLD	SLDLTS
  25DA'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  25DD'   21 2347'              	LXI	H,SNOTFD
  25E0'   CD 22BD'              	CALL	EXERR
  25E3'   21 0000*              	LXI	H,SRCHST
  25E6'   C3 22B8'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  25E9'                         SUBBAD:
  25E9'   21 2335'              	LXI	H,SNOT
  25EC'   C3 22B2'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  25EF'                         SUBLIN:
  25EF'   AF                    	XRA	A
  25F0'   32 2AC7'              	STA	SLCHG
  25F3'   CD 266E'              	CALL	SUBBOL
  25F6'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  25F9'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  25F9'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  25FC'   DA 2604'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  25FF'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  2601'   C2 25F9'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  2604'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  2604'   CD 0000*              	CALL	CUROFF
  2607'   E5                    	PUSH	H
  2608'   CD 14F2'              	CALL	CEND
  260B'   D1                    	POP	D
  260C'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  260F'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  2610'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  2613'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  2614'   B7                    	ORA	A		;   span is a line, not a pair.)
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  2615'   FA 2667'              	JM	SUBL_D		; what is left is shorter than the pattern
  2618'   44                    	MOV	B,H
  2619'   4D                    	MOV	C,L		; BC = the start positions a match can take
  261A'   11 0000*              	LXI	D,SRCHST
  261D'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  2620'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  2623'   DA 2667'              	JC	SUBL_D
  2626'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  2629'   EB                    	XCHG
  262A'   2A 0000*              	LHLD	GAPEND
  262D'   EB                    	XCHG
  262E'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  2631'   EB                    	XCHG
  2632'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  2633'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  2636'   D1                    	POP	D
  2637'   19                    	DAD	D		; ... and so the match's logical offset
  2638'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  263B'   3A 2AC6'              	LDA	SANY
  263E'   B7                    	ORA	A
  263F'   C2 264C'              	JNZ	SUBL_C
  2642'   3A 2AC7'              	LDA	SLCHG
  2645'   B7                    	ORA	A
  2646'   C2 264C'              	JNZ	SUBL_C
  2649'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  264C'                         SUBL_C:
  264C'   3A 0000*              	LDA	SRCHBF
  264F'   6F                    	MOV	L,A
  2650'   26 00                 	MVI	H,0
  2652'   CD 0000*              	CALL	DELFWD		; the match goes
  2655'   11 2AD5'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  2658'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  265B'                         SUBL_I:
  265B'   3E 01                 	MVI	A,1
  265D'   32 2AC7'              	STA	SLCHG
  2660'   3A 2AC5'              	LDA	SGFLAG
  2663'   B7                    	ORA	A
  2664'   C2 2604'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  2667'                         SUBL_D:
  2667'   CD 266E'              	CALL	SUBBOL
  266A'   3A 2AC7'              	LDA	SLCHG
  266D'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  266E'                         SUBBOL:
  266E'   CD 0000*              	CALL	CUROFF
  2671'   CD 05E4'              	CALL	BOL
  2674'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


                                ; is both the prompt character and the direction.
  2677'                         VC_SRCH:
  2677'   CD 075A'              	CALL	SETMOV
  267A'   C5                    	PUSH	B
  267B'   CD 068B'              	CALL	GETCNT
  267E'   22 2AB5'              	SHLD	SCNT
  2681'   C1                    	POP	B
  2682'   79                    	MOV	A,C
  2683'   FE 2F                 	CPI	'/'
  2685'   3E 00                 	MVI	A,0
  2687'   CA 268C'              	JZ	VS_DIR
  268A'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  268C'                         VS_DIR:
  268C'   32 2A8A'              	STA	SDIR
  268F'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2692'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2695'   47                    	MOV	B,A
  2696'   CD 1BD5'              	CALL	RDLINE
  2699'   B7                    	ORA	A
  269A'   C0                    	RNZ			; cancelled: nothing happens at all
  269B'   3A 2A62'              	LDA	RLLEN
  269E'   B7                    	ORA	A
  269F'   CA 26B4'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  26A2'   5F                    	MOV	E,A
  26A3'   16 00                 	MVI	D,0
  26A5'   21 0000*              	LXI	H,SRCHST
  26A8'   19                    	DAD	D
  26A9'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  26AB'   7B                    	MOV	A,E
  26AC'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  26AF'   3E 01                 	MVI	A,1
  26B1'   32 2A8C'              	STA	SHAVE
  26B4'                         VS_OLD:
  26B4'   3A 2A8C'              	LDA	SHAVE
  26B7'   B7                    	ORA	A
  26B8'   CA 26C4'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  26BB'   3A 2A8A'              	LDA	SDIR
  26BE'   32 2A8B'              	STA	SDIRE
  26C1'   C3 26ED'              	JMP	SRCHN
  26C4'                         VS_NOP:
  26C4'   21 2367'              	LXI	H,SNOPAT
  26C7'   C3 22BD'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  26CA'                         VC_N:
  26CA'   CD 075A'              	CALL	SETMOV
  26CD'   3A 2A8A'              	LDA	SDIR
  26D0'   C3 26DA'              	JMP	VN_GO
  26D3'                         VCB_N:
  26D3'   CD 075A'              	CALL	SETMOV
  26D6'   3A 2A8A'              	LDA	SDIR
  26D9'   2F                    	CMA			; the other way: 0 <-> FFH
  26DA'                         VN_GO:
  26DA'   32 2A8B'              	STA	SDIRE
  26DD'   CD 068B'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  26E0'   22 2AB5'              	SHLD	SCNT
  26E3'   3A 2A8C'              	LDA	SHAVE
  26E6'   B7                    	ORA	A
  26E7'   CA 26C4'              	JZ	VS_NOP
  26EA'   C3 26ED'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  26ED'                         SRCHN:
  26ED'   CD 0F76'              	CALL	GZONE		; the screen's top line, before the cursor moves
  26F0'   CD 06B4'              	CALL	BRKON		; where it started (the sweep moves the cursor
                                				;   with PUTCUR, which does not maintain LNDLT;
                                				;   GOTO does), and a ^C may stop it
  26F3'                         SN_LP:
  26F3'   CD 2728'              	CALL	SRCHGO
  26F6'   DA 2713'              	JC	SN_BAD
  26F9'   2A 2AB5'              	LHLD	SCNT
  26FC'   2B                    	DCX	H
  26FD'   22 2AB5'              	SHLD	SCNT
  2700'   7C                    	MOV	A,H
  2701'   B5                    	ORA	L
  2702'   C2 26F3'              	JNZ	SN_LP
  2705'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  2708'   CD 06EB'              	CALL	BRKOFF
  270B'   3E 01                 	MVI	A,1
  270D'   32 2A97'              	STA	GPKEEP		; land on the match, not the first non-blank
  2710'   C3 0F8E'              	JMP	GPLACE		; (which sets LNDLT itself)
  2713'                         SN_BAD:
  2713'   CD 06EB'              	CALL	BRKOFF
  2716'   DA 0703'              	JC	BRKBAK		; stopped, which is not the same as not found
  2719'   CD 06F6'              	CALL	RSTPL		; nothing moved: the row the cursor was on
  271C'   21 2347'              	LXI	H,SNOTFD
  271F'   CD 22BD'              	CALL	EXERR
  2722'   21 0000*              	LXI	H,SRCHST
  2725'   C3 22B8'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  2728'                         SRCHGO:
  2728'   3E 01                 	MVI	A,1
  272A'   32 2ABE'              	STA	SSKIP		; this pass starts one past the cursor
  272D'   CD 2743'              	CALL	SRCHW
  2730'   D0                    	RNC
  2731'   CD 06EF'              	CALL	BRKQ
  2734'   D8                    	RC			; stopped: no second pass
  2735'   3A 2A8B'              	LDA	SDIRE
  2738'   2F                    	CMA
  2739'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  273C'   AF                    	XRA	A
  273D'   32 2ABE'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  2740'   C3 2743'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  2743'                         SRCHW:
  2743'   3A 2A8B'              	LDA	SDIRE
  2746'   32 0000*              	STA	DIRFLG
  2749'   21 FFFF               	LXI	H,0FFFFH
  274C'   22 2A0A'              	SHLD	CMDCNT
  274F'   AF                    	XRA	A
  2750'   32 0000*              	STA	AUXCNT
  2753'                         SW_LP:
  2753'   CD 06EF'              	CALL	BRKQ		; a ^C spent the count, here or on the way to
  2756'   D8                    	RC			;   the wrapped pass: SCRLST no longer pages
  2757'   CD 2763'              	CALL	SRCH1
  275A'   D0                    	RNC
  275B'   CD 0000*              	CALL	SCRLST
  275E'   D2 2753'              	JNC	SW_LP
  2761'   37                    	STC
  2762'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  2763'                         SRCH1:
  2763'   11 0000*              	LXI	D,SRCHST
  2766'   3A 0000*              	LDA	DIRFLG
  2769'   B7                    	ORA	A
  276A'   FA 278E'              	JM	SR1_BK
  276D'   21 0000*              	LXI	H,GAPEND
  2770'   CD 0000*              	CALL	FWDCNT
  2773'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  2776'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  2777'   3A 2ABE'              	LDA	SSKIP
  277A'   B7                    	ORA	A
  277B'   CA 2784'              	JZ	SR1_FW
  277E'   78                    	MOV	A,B
  277F'   B1                    	ORA	C
  2780'   37                    	STC
  2781'   C8                    	RZ			; no room for a match even before the skip
  2782'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2783'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2784'                         SR1_FW:
  2784'   CD 0000*              	CALL	MATCHF
  2787'   D8                    	RC
  2788'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  278B'   C3 0000*              	JMP	PUTCUR
  278E'                         SR1_BK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


  278E'   21 0000*              	LXI	H,TXTBEG
  2791'   CD 0000*              	CALL	FWDCNT
  2794'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2797'   D8                    	RC
  2798'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  279B'   CD 0000*              	CALL	MATCHB
  279E'   D8                    	RC
  279F'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  27A2'                         MSGNAM:
  27A2'   E5                    	PUSH	H
  27A3'   3E 22                 	MVI	A,'"'
  27A5'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  27A8'   E1                    	POP	H
  27A9'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  27AA'   23                    	INX	H
  27AB'   7E                    	MOV	A,M
  27AC'   FE 20                 	CPI	' '
  27AE'   C2 27BB'              	JNZ	MN_HAS
  27B1'   21 23D5'              	LXI	H,SNONM
  27B4'   CD 0000*              	CALL	OUTSTR
  27B7'   E1                    	POP	H
  27B8'   C3 2805'              	JMP	MN_END
  27BB'                         MN_HAS:
  27BB'   0E 19                 	MVI	C,BF_CURDSK
  27BD'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  27C0'   E1                    	POP	H
  27C1'   E5                    	PUSH	H
  27C2'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  27C3'   BE                    	CMP	M
  27C4'   CA 27D2'              	JZ	MN_NAM
  27C7'   7E                    	MOV	A,M
  27C8'   C6 40                 	ADI	'A'-1
  27CA'   CD 0000*              	CALL	OUTCH
  27CD'   3E 3A                 	MVI	A,':'
	MACRO-80 3.44	09-Dec-81	PAGE	1-122


  27CF'   CD 0000*              	CALL	OUTCH
  27D2'                         MN_NAM:
  27D2'   E1                    	POP	H
  27D3'   E5                    	PUSH	H
  27D4'   23                    	INX	H
  27D5'   0E 08                 	MVI	C,8
  27D7'                         MN_NM:
  27D7'   7E                    	MOV	A,M
  27D8'   FE 20                 	CPI	' '
  27DA'   CA 27E5'              	JZ	MN_EXT
  27DD'   CD 0000*              	CALL	OUTCH
  27E0'   23                    	INX	H
  27E1'   0D                    	DCR	C
  27E2'   C2 27D7'              	JNZ	MN_NM
  27E5'                         MN_EXT:
  27E5'   E1                    	POP	H
  27E6'   11 0009               	LXI	D,9
  27E9'   19                    	DAD	D		; the type field
  27EA'   7E                    	MOV	A,M
  27EB'   FE 20                 	CPI	' '
  27ED'   CA 2805'              	JZ	MN_END
  27F0'   3E 2E                 	MVI	A,'.'
  27F2'   CD 0000*              	CALL	OUTCH
  27F5'   0E 03                 	MVI	C,3
  27F7'                         MN_XL:
  27F7'   7E                    	MOV	A,M
  27F8'   FE 20                 	CPI	' '
  27FA'   CA 2805'              	JZ	MN_END
  27FD'   CD 0000*              	CALL	OUTCH
  2800'   23                    	INX	H
  2801'   0D                    	DCR	C
  2802'   C2 27F7'              	JNZ	MN_XL
  2805'                         MN_END:
  2805'   3E 22                 	MVI	A,'"'
  2807'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  280A'                         MSGFLG:
  280A'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  280C'   B7                    	ORA	A
  280D'   CA 281D'              	JZ	MF_RO
  2810'   3A 2A0D'              	LDA	MODF
  2813'   B7                    	ORA	A
  2814'   CA 281D'              	JZ	MF_RO
  2817'   21 23DF'              	LXI	H,SMODM
  281A'   CD 2832'              	CALL	MF_PUT
  281D'                         MF_RO:
  281D'   3A 2A78'              	LDA	ROFLAG
  2820'   B7                    	ORA	A
  2821'   CA 282A'              	JZ	MF_NEW
  2824'   21 23EA'              	LXI	H,SROM
  2827'   CD 2832'              	CALL	MF_PUT
  282A'                         MF_NEW:
	MACRO-80 3.44	09-Dec-81	PAGE	1-123


  282A'   3A 2A76'              	LDA	MSGNEW
  282D'   B7                    	ORA	A
  282E'   C8                    	RZ
  282F'   21 23F5'              	LXI	H,SNEWM
  2832'                         MF_PUT:
  2832'   78                    	MOV	A,B
  2833'   B7                    	ORA	A
  2834'   C2 2840'              	JNZ	MF_STR
  2837'   06 01                 	MVI	B,1
  2839'   E5                    	PUSH	H
  283A'   3E 20                 	MVI	A,' '
  283C'   CD 0000*              	CALL	OUTCH
  283F'   E1                    	POP	H
  2840'                         MF_STR:
  2840'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  2843'                         EMITW:
  2843'   C5                    	PUSH	B
  2844'   D5                    	PUSH	D
  2845'   06 00                 	MVI	B,0
  2847'   11 2710               	LXI	D,10000
  284A'   CD 2868'              	CALL	EWDIG
  284D'   11 03E8               	LXI	D,1000
  2850'   CD 2868'              	CALL	EWDIG
  2853'   11 0064               	LXI	D,100
  2856'   CD 2868'              	CALL	EWDIG
  2859'   11 000A               	LXI	D,10
  285C'   CD 2868'              	CALL	EWDIG
  285F'   7D                    	MOV	A,L		; the units digit is always printed
  2860'   C6 30                 	ADI	'0'
  2862'   CD 0000*              	CALL	OUTCH
  2865'   D1                    	POP	D
  2866'   C1                    	POP	B
  2867'   C9                    	RET
  2868'                         EWDIG:
  2868'   0E 00                 	MVI	C,0
  286A'                         EW_LP:
  286A'   7D                    	MOV	A,L
  286B'   93                    	SUB	E
  286C'   6F                    	MOV	L,A
  286D'   7C                    	MOV	A,H
  286E'   9A                    	SBB	D
  286F'   67                    	MOV	H,A
  2870'   DA 2877'              	JC	EW_DN
  2873'   0C                    	INR	C
  2874'   C3 286A'              	JMP	EW_LP
  2877'                         EW_DN:
  2877'   19                    	DAD	D		; one subtraction too many: give it back
  2878'   79                    	MOV	A,C
  2879'   B7                    	ORA	A
  287A'   C2 2880'              	JNZ	EW_PR
  287D'   78                    	MOV	A,B
  287E'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-124


  287F'   C8                    	RZ			; a leading zero: write nothing
  2880'                         EW_PR:
  2880'   79                    	MOV	A,C
  2881'   C6 30                 	ADI	'0'
  2883'   CD 0000*              	CALL	OUTCH
  2886'   06 01                 	MVI	B,1
  2888'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  2889'                         ISEMPT:
  2889'   2A 0000*              	LHLD	OUTPOS
  288C'   7C                    	MOV	A,H
  288D'   B5                    	ORA	L
  288E'   C0                    	RNZ
  288F'   CD 0000*              	CALL	LOGLEN
  2892'   7C                    	MOV	A,H
  2893'   B5                    	ORA	L
  2894'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  2895'                         MSGCTG:
  2895'   21 0000*              	LXI	H,FNAME
  2898'   CD 27A2'              	CALL	MSGNAM
  289B'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  289D'   CD 280A'              	CALL	MSGFLG
  28A0'   CD 2889'              	CALL	ISEMPT
  28A3'   C2 28AC'              	JNZ	MG_POS
  28A6'   21 2408'              	LXI	H,SNOLIN
  28A9'   C3 0000*              	JMP	OUTSTR
  28AC'                         MG_POS:
  28AC'   21 23FB'              	LXI	H,SLINE
  28AF'   CD 0000*              	CALL	OUTSTR
  28B2'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  28B5'   23                    	INX	H		;   ... so the line it is on
  28B6'   CD 2843'              	CALL	EMITW
  28B9'   21 2402'              	LXI	H,SCOLM
  28BC'   CD 0000*              	CALL	OUTSTR
  28BF'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  28C2'   23                    	INX	H
  28C3'   E5                    	PUSH	H
  28C4'   CD 2843'              	CALL	EMITW
  28C7'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  28CA'   23                    	INX	H
  28CB'   D1                    	POP	D
  28CC'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  28CF'   C8                    	RZ
  28D0'   E5                    	PUSH	H
  28D1'   3E 2D                 	MVI	A,'-'
  28D3'   CD 0000*              	CALL	OUTCH
  28D6'   E1                    	POP	H
  28D7'   C3 2843'              	JMP	EMITW
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-125


                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  28DA'                         FILMSG:
  28DA'   3A 0001*              	LDA	FNAME+1
  28DD'   FE 20                 	CPI	' '
  28DF'   C8                    	RZ
  28E0'   21 0000*              	LXI	H,FNAME
  28E3'   CD 27A2'              	CALL	MSGNAM
  28E6'   AF                    	XRA	A		; nothing has been changed yet
  28E7'   C3 280A'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  28EA'                         WRMSG:
  28EA'   21 0000*              	LXI	H,TFCB
  28ED'   CD 27A2'              	CALL	MSGNAM
  28F0'   21 241A'              	LXI	H,SWRIT
  28F3'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  28F6'                         MSGPST:
  28F6'   3A 2A75'              	LDA	MSGWHT
  28F9'   B7                    	ORA	A
  28FA'   C8                    	RZ
  28FB'   47                    	MOV	B,A
  28FC'   AF                    	XRA	A
  28FD'   32 2A75'              	STA	MSGWHT
  2900'   78                    	MOV	A,B
  2901'   FE 01                 	CPI	MW_FIL
  2903'   CA 291F'              	JZ	MP_FIL
  2906'   FE 02                 	CPI	MW_WRT
  2908'   CA 2925'              	JZ	MP_WRT
  290B'   FE 04                 	CPI	MW_BIG
  290D'   CA 2916'              	JZ	MP_BIG
  2910'   CD 2895'              	CALL	MSGCTG
  2913'   C3 0000*              	JMP	SCURS
  2916'                         MP_BIG:
  2916'   21 23B6'              	LXI	H,SQBIG
  2919'   CD 0000*              	CALL	EXMSG
  291C'   C3 0000*              	JMP	SCURS
  291F'                         MP_FIL:
  291F'   CD 28DA'              	CALL	FILMSG
  2922'   C3 0000*              	JMP	SCURS
  2925'                         MP_WRT:
  2925'   CD 28EA'              	CALL	WRMSG
  2928'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  292B'                         VC_CTLG:
  292B'   3E 03                 	MVI	A,MW_CTG
  292D'   32 2A75'              	STA	MSGWHT
  2930'   3E 01                 	MVI	A,R_MOVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-126


  2932'   32 2A0E'              	STA	RINTENT
  2935'   C3 068B'              	JMP	GETCNT		; a count typed before it is spent here, not
                                				;   left for the next command
                                
  2938'                         CMDTAB:
  2938'   07                    	DB	07H			; ^G -- where am I?
  2939'   292B'                 	DW	VC_CTLG
  293B'   68                    	DB	'h'
  293C'   07B3'                 	DW	VC_H
