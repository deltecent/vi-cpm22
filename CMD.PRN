  105E'   CD 1086'              	CALL	OV_NX
  1061'   DA 1082'              	JC	OV_0
  1064'   7B                    	MOV	A,E
  1065'   86                    	ADD	M
  1066'   5F                    	MOV	E,A		; E = h2 + h3
  1067'   79                    	MOV	A,C
  1068'   BB                    	CMP	E
