  2D81'   205B'                 	DW	VC_BZ
  2D83'   66                    	DB	'f'
  2D84'   021A'                 	DW	VC_FF
  2D86'   46                    	DB	'F'
  2D87'   021F'                 	DW	VC_FB
  2D89'   74                    	DB	't'
  2D8A'   0224'                 	DW	VC_TF
  2D8C'   54                    	DB	'T'
  2D8D'   0229'                 	DW	VC_TB
  2D8F'   3B                    	DB	';'
  2D90'   0240'                 	DW	VC_SEMI
  2D92'   2C                    	DB	','
  2D93'   024A'                 	DW	VC_COMMA
  2D95'   79                    	DB	'y'
  2D96'   1B65'                 	DW	VC_Y
  2D98'   59                    	DB	'Y'
  2D99'   1B6D'                 	DW	VY_YY
  2D9B'   70                    	DB	'p'
  2D9C'   1DA3'                 	DW	VC_P
  2D9E'   50                    	DB	'P'
  2D9F'   1DB8'                 	DW	VCB_P
  2DA1'   69                    	DB	'i'
  2DA2'   18E1'                 	DW	VC_I
  2DA4'   61                    	DB	'a'
  2DA5'   18E7'                 	DW	VC_A
  2DA7'   41                    	DB	'A'
  2DA8'   1907'                 	DW	VCB_A
  2DAA'   49                    	DB	'I'
  2DAB'   1923'                 	DW	VCB_I
  2DAD'   72                    	DB	'r'
  2DAE'   1A65'                 	DW	VC_R
  2DB0'   52                    	DB	'R'
  2DB1'   1ABE'                 	DW	VCB_R
