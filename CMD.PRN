                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
