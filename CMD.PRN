  075F'   FE 0D                 	CPI	CR
  0761'   CA 0767'              	JZ	EOLC_CR		; content ends at term-1
  0764'   C3 0768'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  0767'                         EOLC_CR:
  0767'   2B                    	DCX	H		; last = (term-1) - 1
  0768'                         EOLC_LS:
  0768'   EB                    	XCHG			; DE = last
  0769'   2A 0000*              	LHLD	WKBOL
  076C'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  076F'   DA 0774'              	JC	EOLC_MT
  0772'   EB                    	XCHG			; HL = last
  0773'   C9                    	RET
  0774'                         EOLC_MT:
  0774'   2A 0000*              	LHLD	WKBOL
  0777'   C9                    	RET
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  0778'                         ATENDQ:
  0778'   CD 0000*              	CALL	CUROFF
  077B'   E5                    	PUSH	H
  077C'   CD 0000*              	CALL	LOGLEN
  077F'   D1                    	POP	D		; DE = cur
  0780'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0783'                         CURCHR:
  0783'   CD 0000*              	CALL	CUROFF
  0786'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  0789'                         MOVCNT:
  0789'   CD 0871'              	CALL	SETMOV
  078C'   C3 079C'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  078F'                         CNTOFF:
  078F'   CD 079C'              	CALL	GETCNT
  0792'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  0795'                         GBSUB:
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  0795'   EB                    	XCHG
  0796'   2A 0000*              	LHLD	GAPBEG
  0799'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  079C'                         GETCNT:
  079C'   2A 0000*              	LHLD	CMDCNT
  079F'   7C                    	MOV	A,H
  07A0'   B5                    	ORA	L
  07A1'   C2 07A8'              	JNZ	GC_HAVE
  07A4'   21 0001               	LXI	H,1
  07A7'   C9                    	RET
  07A8'                         GC_HAVE:
  07A8'   E5                    	PUSH	H
  07A9'   21 0000               	LXI	H,0
  07AC'   22 0000*              	SHLD	CMDCNT
  07AF'   E1                    	POP	H
  07B0'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for an ESC break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  07B1'                         CNTTST:				; WM 1175
  07B1'   3A 0000*              	LDA	BRKARM
  07B4'   B7                    	ORA	A
  07B5'   C4 07DF'              	CNZ	BRKTST		; an ESC spends the count: every loop stops here
  07B8'   E5                    	PUSH	H
  07B9'   2A 0000*              	LHLD	CMDCNT
  07BC'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  07BF'   B4                    	ORA	H
  07C0'   B5                    	ORA	L
  07C1'   E1                    	POP	H
  07C2'   C3 0000*              	JMP	POLLBRK
                                
                                ;============================================================
                                ; ESC -- abandon a search or a long move.
                                ;
                                ; Every loop that pages asks CNTTST whether to go on, so that is where an ESC is
                                ; looked for: it zeroes the count, and the loop ends the way it ends when the
                                ; count runs out.  Nothing is half done, because the commands that can be
                                ; stopped change nothing -- BRKON arms the test only with no operator pending,
                                ; and only 'G' 'gg' the mark jumps and the searches call it.  A 'dd' count, a
                                ; ':s', a put or a write asks the same CNTTST and is never stopped.
                                ;
                                ; The command then goes back to where it started (BRKBAK), as a search that
                                ; found nothing does: the screen was not repainted, so it is already right.
                                ; Going back pages, and that is not stopped by a second ESC.
                                ;============================================================
                                
                                ;BRKON -- a command that may page a long way is starting: keep the place it
                                ; started from (the cursor's position in the file, and LNDLT for its row), and
                                ; arm the ESC test unless an operator is waiting for this motion.
  07C5'                         BRKON:
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07C5'   21 0000*              	LXI	H,SOFF
  07C8'   CD 0448'              	CALL	FPSTO
  07CB'   2A 0000*              	LHLD	LNDLT
  07CE'   22 0000*              	SHLD	SLDLT
  07D1'   AF                    	XRA	A
  07D2'   32 0000*              	STA	BRKHIT
  07D5'   3A 0000*              	LDA	PSAVE
  07D8'   B7                    	ORA	A
  07D9'   C0                    	RNZ			; 'dG' changes text: it runs to its end
  07DA'   3C                    	INR	A
  07DB'   32 0000*              	STA	BRKARM
  07DE'   C9                    	RET
                                
                                ;BRKTST -- CNTTST's question while armed.  Keeps BC, DE, HL.  The ESC is
                                ; answered on the bottom row at once: the way back pages, and that can take
                                ; as long again as the command had run, with nothing else to show for it.
                                ; BRKBAK's 'Interrupted' replaces it when the cursor is back.
  07DF'                         BRKTST:
  07DF'   C5                    	PUSH	B
  07E0'   D5                    	PUSH	D
  07E1'   E5                    	PUSH	H
  07E2'   CD 0000*              	CALL	KBBRK
  07E5'   CA 07FE'              	JZ	BT_NO
  07E8'   32 0000*              	STA	BRKHIT		; (A = FFH)
  07EB'   21 28F5'              	LXI	H,SINTG
  07EE'   CD 0000*              	CALL	EXMSG
  07F1'   AF                    	XRA	A
  07F2'   32 0000*              	STA	BRKARM		; the way back is not stopped in its turn
  07F5'   32 0000*              	STA	AUXCNT
  07F8'   21 0000               	LXI	H,0
  07FB'   22 0000*              	SHLD	CMDCNT
  07FE'                         BT_NO:
  07FE'   E1                    	POP	H
  07FF'   D1                    	POP	D
  0800'   C1                    	POP	B
  0801'   C9                    	RET
                                
                                ;BRKOFF -- the move is over: disarm.  NOTE: falls into BRKQ.
  0802'                         BRKOFF:
  0802'   AF                    	XRA	A
  0803'   32 0000*              	STA	BRKARM
                                ;BRKQ -- CY iff an ESC stopped it.
  0806'                         BRKQ:
  0806'   3A 0000*              	LDA	BRKHIT
  0809'   B7                    	ORA	A
  080A'   C8                    	RZ
  080B'   37                    	STC
  080C'   C9                    	RET
                                
                                ;RSTPL -- back to the place BRKON kept, on the row it was on.
  080D'                         RSTPL:
  080D'   21 0000*              	LXI	H,SOFF
  0810'   CD 03EF'              	CALL	BACKTO
  0813'   2A 0000*              	LHLD	SLDLT
  0816'   22 0000*              	SHLD	LNDLT
  0819'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


                                
                                ;BRKBAK -- stopped: back to the start, drop whatever was typed meanwhile (it
                                ; was meant for a result that is not coming), and say so.  CY, as EXERR.
  081A'                         BRKBAK:
  081A'   CD 080D'              	CALL	RSTPL
  081D'   CD 0000*              	CALL	KBFLSH
  0820'   21 28E9'              	LXI	H,SINTR
  0823'   C3 284B'              	JMP	EXERR
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  0826'                         CLASSF:
  0826'   47                    	MOV	B,A
  0827'   FE 20                 	CPI	' '
  0829'   CA 0869'              	JZ	CLS0
  082C'   FE 09                 	CPI	TAB
  082E'   CA 0869'              	JZ	CLS0
  0831'   FE 0A                 	CPI	LF
  0833'   CA 0869'              	JZ	CLS0
  0836'   FE 0D                 	CPI	CR
  0838'   CA 0869'              	JZ	CLS0
  083B'   3A 0000*              	LDA	WBIG
  083E'   B7                    	ORA	A
  083F'   C2 086B'              	JNZ	CLS1
  0842'   78                    	MOV	A,B
  0843'   FE 5F                 	CPI	'_'
  0845'   CA 086B'              	JZ	CLS1
  0848'   FE 30                 	CPI	'0'
  084A'   DA 086E'              	JC	CLS2
  084D'   FE 3A                 	CPI	'9'+1
  084F'   DA 086B'              	JC	CLS1
  0852'   FE 41                 	CPI	'A'
  0854'   DA 086E'              	JC	CLS2
  0857'   FE 5B                 	CPI	'Z'+1
  0859'   DA 086B'              	JC	CLS1
  085C'   FE 61                 	CPI	'a'
  085E'   DA 086E'              	JC	CLS2
  0861'   FE 7B                 	CPI	'z'+1
  0863'   DA 086B'              	JC	CLS1
  0866'   C3 086E'              	JMP	CLS2
  0869'   AF                    CLS0:	XRA	A
  086A'   C9                    	RET
  086B'   3E 01                 CLS1:	MVI	A,1
  086D'   C9                    	RET
  086E'   3E 02                 CLS2:	MVI	A,2
  0870'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  0871'                         SETMOV:
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  0871'   3E 01                 	MVI	A,R_MOVE
  0873'   32 0000*              	STA	RINTENT
  0876'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  0877'                         SETLIN:
  0877'   3E 02                 	MVI	A,R_LINE
  0879'   32 0000*              	STA	RINTENT
  087C'   C9                    	RET
                                
                                ;SETCEL -- one cell of the cursor's row was written over and nothing else
                                ; changed: the char alone is the paint (R_ICH with no cell opened), provided
                                ; the char that was there (A) and the one that is (VRCH) are each one cell
                                ; wide.  B = ICHAPP's value: 1 the cursor went past the char, 2 it is on it.
  087D'                         SETCEL:
  087D'   CD 0892'              	CALL	PLAINQ
  0880'   D0                    	RNC
  0881'   3A 0000*              	LDA	VRCH
  0884'   CD 0892'              	CALL	PLAINQ
  0887'   D0                    	RNC
  0888'   78                    	MOV	A,B
  0889'   32 0000*              	STA	ICHAPP
  088C'   3E 04                 	MVI	A,R_ICH
  088E'   32 0000*              	STA	RINTENT
  0891'   C9                    	RET
                                
                                ;PLAINQ -- CY iff the char in A takes one cell: printable ASCII.  Keeps all
                                ; but the flags.
  0892'                         PLAINQ:
  0892'   FE 20                 	CPI	' '
  0894'   3F                    	CMC
  0895'   D0                    	RNC
  0896'   FE 7F                 	CPI	DEL
  0898'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  0899'                         SETILN:
  0899'   3E 01                 	MVI	A,1
  089B'   32 31ED'              	STA	ILN		; one line, unless a put overwrites it below
  089E'   3E 05                 	MVI	A,R_ILIN
  08A0'   32 0000*              	STA	RINTENT
  08A3'   AF                    	XRA	A
  08A4'   32 0000*              	STA	ILABOV		; the row above the opened ones is untouched
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  08A7'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  08A8'                         SETJON:
  08A8'   3E 06                 	MVI	A,R_JOIN
  08AA'   32 0000*              	STA	RINTENT
  08AD'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  08AE'                         SETFUL:
  08AE'   3E 00                 	MVI	A,R_FULL
  08B0'   32 0000*              	STA	RINTENT
  08B3'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB (or any control char) occurs from the cursor to the
                                ; end of its line, else 0; TTI = its offset when there is one.
                                ; The tail is read where it lies, after the gap.  Keeps BC.
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  08B4'                         TAILTAB:
  08B4'   C5                    	PUSH	B
  08B5'   CD 0000*              	CALL	CUROFF
  08B8'   E5                    	PUSH	H
  08B9'   2A 0000*              	LHLD	TXTEND
  08BC'   44                    	MOV	B,H
  08BD'   4D                    	MOV	C,L
  08BE'   2A 0000*              	LHLD	GAPEND
  08C1'   D1                    	POP	D		; DE = the offset of the byte at HL
  08C2'                         TT_LP:
  08C2'   7D                    	MOV	A,L
  08C3'   91                    	SUB	C
  08C4'   7C                    	MOV	A,H
  08C5'   98                    	SBB	B
  08C6'   D2 08E6'              	JNC	TT_NO		; reached end of text -> no tab
  08C9'   7E                    	MOV	A,M
  08CA'   FE 0A                 	CPI	LF
  08CC'   CA 08E6'              	JZ	TT_NO		; end of line -> no tab
  08CF'   FE 0D                 	CPI	CR
  08D1'   CA 08D9'              	JZ	TT_NX		; (the line end's own)
  08D4'   FE 20                 	CPI	' '
  08D6'   DA 08DE'              	JC	TT_YES
  08D9'                         TT_NX:
  08D9'   23                    	INX	H
  08DA'   13                    	INX	D
  08DB'   C3 08C2'              	JMP	TT_LP
  08DE'                         TT_YES:
  08DE'   EB                    	XCHG
  08DF'   22 0000*              	SHLD	TTI
  08E2'   C1                    	POP	B
  08E3'   3E 01                 	MVI	A,1
  08E5'   C9                    	RET
  08E6'                         TT_NO:
  08E6'   C1                    	POP	B
  08E7'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  08E8'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  08E9'                         VC_H:
  08E9'   CD 0789'              	CALL	MOVCNT		; a cursor motion, and its count
  08EC'   22 0000*              	SHLD	CNTV
  08EF'                         VCH_LP:
  08EF'   2A 0000*              	LHLD	CNTV
  08F2'   7C                    	MOV	A,H
  08F3'   B5                    	ORA	L
  08F4'   C8                    	RZ
  08F5'   2B                    	DCX	H
  08F6'   22 0000*              	SHLD	CNTV
  08F9'   CD 08FF'              	CALL	HSTEP
  08FC'   C3 08EF'              	JMP	VCH_LP
  08FF'                         HSTEP:
  08FF'   CD 0000*              	CALL	CUROFF		; HL = cur
  0902'   7C                    	MOV	A,H
  0903'   B5                    	ORA	L
  0904'   C8                    	RZ			; at 0
  0905'   E5                    	PUSH	H
  0906'   CD 0697'              	CALL	BOL		; HL = bol
  0909'   D1                    	POP	D		; DE = cur
  090A'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  090D'   C8                    	RZ			; at BOL, cannot go left
  090E'   EB                    	XCHG			; HL = cur
  090F'   2B                    	DCX	H
  0910'   C3 062D'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  0913'                         VC_L:
  0913'   CD 0789'              	CALL	MOVCNT		; a cursor motion, and its count
  0916'   22 0000*              	SHLD	CNTV
  0919'                         VCL_LP:
  0919'   2A 0000*              	LHLD	CNTV
  091C'   7C                    	MOV	A,H
  091D'   B5                    	ORA	L
  091E'   C8                    	RZ
  091F'   2B                    	DCX	H
  0920'   22 0000*              	SHLD	CNTV
  0923'   CD 0929'              	CALL	LSTEP
  0926'   C3 0919'              	JMP	VCL_LP
  0929'                         LSTEP:
  0929'   CD 0000*              	CALL	CUROFF		; HL = cur
  092C'   E5                    	PUSH	H
  092D'   CD 073D'              	CALL	EOLC		; HL = eolc
  0930'   D1                    	POP	D		; DE = cur
  0931'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  0934'   D2 093C'              	JNC	LS_NO		; cur >= eolc, cannot go right
  0937'   EB                    	XCHG			; HL = cur
  0938'   23                    	INX	H
  0939'   C3 062D'              	JMP	GOSET
  093C'                         LS_NO:				; on the line's last char.  An operator waiting on
  093C'   CD 0DAF'              	CALL	EMPTY		;   this 'l' takes that char too (vim makes the
  093F'   C8                    	RZ			;   motion inclusive when it falls short), which
  0940'   3E 01                 	MVI	A,1		;   is what WPULL tells OPA_EX: 'dl' there is 'x',
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0942'   32 0000*              	STA	WPULL		;   and 'd3l' two from the end takes both.  An
  0945'   C9                    	RET			;   empty line has no char to take
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  0946'                         VC_0:
  0946'   CD 0789'              	CALL	MOVCNT		; a cursor motion, and its count
  0949'   CD 0953'              	CALL	LNSTRT
  094C'   21 0000               	LXI	H,0
  094F'   22 31EF'              	SHLD	GOALCOL
  0952'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  0953'                         LNSTRT:
  0953'   CD 13DF'              	CALL	ZSAVE
  0956'   21 0000               	LXI	H,0
  0959'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  095C'   E5                    	PUSH	H
  095D'   CD 13F2'              	CALL	ZREST
  0960'   E1                    	POP	H
  0961'   C3 0000*              	JMP	PUTCUR
                                
                                ;LNEND -- the cursor's line whole in the window: read on from the cursor to
                                ; its LF with WM's RGET, which pages in what the window does not hold yet.
                                ; The window ends on a record, not a line, so its last line is cut short, and
                                ; a measure that stops at the window's end (NLSTART at LOGLEN) takes a piece
                                ; of a line for the whole of it (issue #38).  The cursor stays where it is;
                                ; text behind it may page out, so an offset taken before this is stale.
  0964'                         LNEND:
  0964'   CD 0000*              	CALL	RGET0
  0967'                         LNE_LP:
  0967'   CD 0000*              	CALL	RDGET
  096A'   D8                    	RC			; the end of the file
  096B'   FE 0A                 	CPI	LF
  096D'   C2 0967'              	JNZ	LNE_LP
  0970'   C9                    	RET
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  0971'                         VC_CRT:
  0971'   CD 0789'              	CALL	MOVCNT		; a cursor motion, and its count
  0974'   C3 0977'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  0977'                         FNBLNK:
  0977'   CD 0953'              	CALL	LNSTRT
  097A'   CD 0000*              	CALL	RGET0
  097D'   11 0000               	LXI	D,0		; DE = blanks skipped
  0980'                         FN_LP:
  0980'   CD 0000*              	CALL	RDGET
  0983'   DA 09A6'              	JC	FN_GO		; the end of the file
  0986'   FE 20                 	CPI	' '
  0988'   CA 0990'              	JZ	FN_WH
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  098B'   FE 09                 	CPI	TAB
  098D'   C2 09A6'              	JNZ	FN_GO		; a non-blank, or the line's end
  0990'                         FN_WH:
  0990'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  0993'   DA 09A6'              	JC	FN_GO
  0996'   FE 0D                 	CPI	CR
  0998'   CA 09A6'              	JZ	FN_GO
  099B'   FE 0A                 	CPI	LF
  099D'   CA 09A6'              	JZ	FN_GO
  09A0'   2B                    	DCX	H		; not yet: read that char again
  09A1'   03                    	INX	B
  09A2'   13                    	INX	D
  09A3'   C3 0980'              	JMP	FN_LP
  09A6'                         FN_GO:
  09A6'   D5                    	PUSH	D
  09A7'   CD 0000*              	CALL	CUROFF
  09AA'   D1                    	POP	D
  09AB'   19                    	DAD	D
  09AC'   C3 062D'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  09AF'                         VC_EOL:
  09AF'   CD 0871'              	CALL	SETMOV
  09B2'   21 FFFF               	LXI	H,0FFFFH
  09B5'   22 31EF'              	SHLD	GOALCOL
  09B8'   CD 079C'              	CALL	GETCNT
  09BB'   2B                    	DCX	H		; count-1
  09BC'   7C                    	MOV	A,H
  09BD'   B5                    	ORA	L
  09BE'   CA 09CD'              	JZ	VEOL_0
  09C1'   E5                    	PUSH	H
  09C2'   CD 09E2'              	CALL	ONLAST
  09C5'   E1                    	POP	H
  09C6'   D8                    	RC			; the last line: no move (vim)
  09C7'   CD 0A32'              	CALL	JCORE
  09CA'   C3 0C1B'              	JMP	JKLAND
  09CD'                         VEOL_0:
  09CD'   CD 0953'              	CALL	LNSTRT
  09D0'   C3 0C1B'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  09D3'                         VC_CR:
  09D3'   CD 0789'              	CALL	MOVCNT		; a cursor motion, and its count
  09D6'   E5                    	PUSH	H
  09D7'   CD 09E2'              	CALL	ONLAST
  09DA'   E1                    	POP	H
  09DB'   D8                    	RC
  09DC'   CD 0A32'              	CALL	JCORE
  09DF'   C3 0977'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  09E2'                         ONLAST:
  09E2'   CD 0000*              	CALL	RGET0
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  09E5'                         OL_LP:
  09E5'   CD 0000*              	CALL	RDGET
  09E8'   D8                    	RC			; the file ends on this line
  09E9'   FE 0A                 	CPI	LF
  09EB'   C2 09E5'              	JNZ	OL_LP
  09EE'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  09F1'                         VC_J:
  09F1'   CD 0871'              	CALL	SETMOV
  09F4'   CD 0A1C'              	CALL	GLCHK		; the goal column, from the cursor if stale
  09F7'   CD 079C'              	CALL	GETCNT		; HL = count
  09FA'   CD 0A32'              	CALL	JCORE
  09FD'   CD 0A15'              	CALL	JKDRP
  0A00'   C3 0C1B'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  0A03'                         VC_K:
  0A03'   CD 0871'              	CALL	SETMOV
  0A06'   CD 0A1C'              	CALL	GLCHK
  0A09'   CD 079C'              	CALL	GETCNT
  0A0C'   CD 0B12'              	CALL	KCORE
  0A0F'   CD 0A15'              	CALL	JKDRP
  0A12'   C3 0C1B'              	JMP	JKLAND
                                
                                ;JKDRP -- DE = the lines JCORE / KCORE moved.  None -- 'j' on the last line,
                                ; 'k' on the first -- and the motion has failed: an operator waiting on it is
                                ; dropped, as vim drops it, where a line span that starts and ends on one line
                                ; would take that line ('dj' on the last line deleted it).  A count that runs
                                ; out of lines short has still moved, and its operator stands.  It is asked
                                ; here and not in the cores: 'dH' on the top row moves no lines either, and
                                ; takes its line.
  0A15'                         JKDRP:
  0A15'   7A                    	MOV	A,D
  0A16'   B3                    	ORA	E
  0A17'   C0                    	RNZ
  0A18'   32 0000*              	STA	PSAVE
  0A1B'   C9                    	RET
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  0A1C'                         GLCHK:
  0A1C'   2A 31EF'              	LHLD	GOALCOL
  0A1F'   7C                    	MOV	A,H
  0A20'   3C                    	INR	A
  0A21'   C0                    	RNZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0A22'   7D                    	MOV	A,L
  0A23'   FE FE                 	CPI	0FEH
  0A25'   C0                    	RNZ
  0A26'   C3 0630'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  0A29'                         GLSTAL:
  0A29'   E5                    	PUSH	H
  0A2A'   21 FFFE               	LXI	H,0FFFEH
  0A2D'   22 31EF'              	SHLD	GOALCOL
  0A30'   E1                    	POP	H
  0A31'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  0A32'                         JCORE:
  0A32'   7C                    	MOV	A,H
  0A33'   B5                    	ORA	L
  0A34'   C8                    	RZ
  0A35'   22 0000*              	SHLD	JKCNT
  0A38'   CD 0EDE'              	CALL	CURRW		; limit = lines under the cursor's + NEDIT + 2:
  0A3B'   47                    	MOV	B,A		;   enough for LYFAR to know it for far off
  0A3C'   3A 0000*              	LDA	NEDIT
  0A3F'   3C                    	INR	A
  0A40'   90                    	SUB	B
  0A41'   5F                    	MOV	E,A
  0A42'   16 00                 	MVI	D,0
  0A44'   3A 0000*              	LDA	NEDIT
  0A47'   6F                    	MOV	L,A
  0A48'   26 00                 	MVI	H,0
  0A4A'   19                    	DAD	D
  0A4B'   EB                    	XCHG			; DE = limit
  0A4C'   2A 0000*              	LHLD	JKCNT
  0A4F'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0A52'   D2 0AA0'              	JNC	JC_QK
  0A55'   EB                    	XCHG			; HL = limit
  0A56'   22 0000*              	SHLD	JKN		; N = min(count, limit)
  0A59'                         JC_SL:
  0A59'   2A 0000*              	LHLD	JKN
  0A5C'   EB                    	XCHG			; DE = LFs to find
  0A5D'   CD 0000*              	CALL	RGET0
  0A60'                         JC_SC:
  0A60'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0A63'   DA 0A82'              	JC	JC_EOF
  0A66'   32 0000*              	STA	JKLST
  0A69'   FE 0A                 	CPI	LF
  0A6B'   C2 0A60'              	JNZ	JC_SC
  0A6E'   1B                    	DCX	D
  0A6F'   7A                    	MOV	A,D
  0A70'   B3                    	ORA	E
  0A71'   C2 0A60'              	JNZ	JC_SC
  0A74'   2A 0000*              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  0A77'   22 0000*              	SHLD	JKMOV		;   one if the last LF found ends the file
  0A7A'   3E 01                 	MVI	A,1
  0A7C'   32 0000*              	STA	JKPHN
  0A7F'   C3 0ADD'              	JMP	JC_MV
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0A82'                         JC_EOF:
  0A82'   2A 0000*              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  0A85'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  0A88'   7C                    	MOV	A,H
  0A89'   B5                    	ORA	L
  0A8A'   CA 0A96'              	JZ	JC_AV
  0A8D'   3A 0000*              	LDA	JKLST
  0A90'   FE 0A                 	CPI	LF
  0A92'   C2 0A96'              	JNZ	JC_AV
  0A95'   2B                    	DCX	H
  0A96'                         JC_AV:
  0A96'   22 0000*              	SHLD	JKMOV
  0A99'   AF                    	XRA	A
  0A9A'   32 0000*              	STA	JKPHN
  0A9D'   C3 0ADD'              	JMP	JC_MV
                                ;--- the count is no more than the screen can show, and its lines are most
                                ;    times in memory: they are looked for where they lie, once, and the
                                ;    cursor put there in one move.  A line that starts where the window ends
                                ;    may be the file's end: that, and lines not here, go the long way ---
  0AA0'                         JC_QK:
  0AA0'   22 0000*              	SHLD	JKN		; N = the count
  0AA3'   CD 0000*              	CALL	RGET0		; HL = the text after the cursor, BC = its bytes
  0AA6'   3A 0000*              	LDA	JKN
  0AA9'   5F                    	MOV	E,A		; E = LFs to find (the limit is under 256)
  0AAA'   16 0A                 	MVI	D,LF
  0AAC'   04                    	INR	B
  0AAD'   0C                    	INR	C
  0AAE'                         JQ_LP:
  0AAE'   0D                    	DCR	C
  0AAF'   C2 0AB6'              	JNZ	JQ_CH
  0AB2'   05                    	DCR	B
  0AB3'   CA 0A59'              	JZ	JC_SL
  0AB6'                         JQ_CH:
  0AB6'   7E                    	MOV	A,M
  0AB7'   23                    	INX	H
  0AB8'   BA                    	CMP	D
  0AB9'   C2 0AAE'              	JNZ	JQ_LP
  0ABC'   1D                    	DCR	E
  0ABD'   C2 0AAE'              	JNZ	JQ_LP
  0AC0'   EB                    	XCHG			; DE = the line's start
  0AC1'   2A 0000*              	LHLD	TXTEND
  0AC4'   CD 0000*              	CALL	CMP16		; CY iff it is inside the window
  0AC7'   D2 0A59'              	JNC	JC_SL
  0ACA'   EB                    	XCHG
  0ACB'   CD 0000*              	CALL	PUTCUR
  0ACE'   21 0000               	LXI	H,0
  0AD1'   CD 0000*              	CALL	SETC0		; the count spent, forward: as MVLIND leaves it
  0AD4'   2A 0000*              	LHLD	JKCNT
  0AD7'   22 0000*              	SHLD	JKMOV
  0ADA'   C3 0AFB'              	JMP	JC_DN
  0ADD'                         JC_MV:
  0ADD'   2A 0000*              	LHLD	JKCNT
  0AE0'   AF                    	XRA	A
  0AE1'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  0AE4'   CD 0BFA'              	CALL	ATEOF
  0AE7'   D2 0AFB'              	JNC	JC_DN
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0AEA'   CD 0C00'              	CALL	LASTLN		; ran past the last line: back onto it
  0AED'   3A 0000*              	LDA	JKPHN
  0AF0'   B7                    	ORA	A
  0AF1'   CA 0AFB'              	JZ	JC_DN
  0AF4'   2A 0000*              	LHLD	JKMOV
  0AF7'   2B                    	DCX	H
  0AF8'   22 0000*              	SHLD	JKMOV
  0AFB'                         JC_DN:
  0AFB'   2A 0000*              	LHLD	JKN		; LNDLT += min(moved, N)
  0AFE'   EB                    	XCHG
  0AFF'   2A 0000*              	LHLD	JKMOV
  0B02'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  0B05'   D2 0B09'              	JNC	JC_AD
  0B08'   EB                    	XCHG
  0B09'                         JC_AD:
  0B09'   EB                    	XCHG			; DE = lines moved
  0B0A'   2A 0000*              	LHLD	LNDLT
  0B0D'   19                    	DAD	D
  0B0E'   22 0000*              	SHLD	LNDLT
  0B11'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  0B12'                         KCORE:
  0B12'   7C                    	MOV	A,H
  0B13'   B5                    	ORA	L
  0B14'   C8                    	RZ
  0B15'   22 0000*              	SHLD	JKCNT
  0B18'   CD 0EDE'              	CALL	CURRW		; limit = row + NEDIT
  0B1B'   5F                    	MOV	E,A
  0B1C'   16 00                 	MVI	D,0
  0B1E'   3A 0000*              	LDA	NEDIT
  0B21'   6F                    	MOV	L,A
  0B22'   26 00                 	MVI	H,0
  0B24'   19                    	DAD	D
  0B25'   EB                    	XCHG			; DE = limit
  0B26'   2A 0000*              	LHLD	JKCNT
  0B29'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0B2C'   D2 0BA6'              	JNC	KC_QK
  0B2F'   EB                    	XCHG			; HL = limit
  0B30'   22 0000*              	SHLD	JKN		; N = min(count, limit)
  0B33'                         KC_SL:
  0B33'   2A 0000*              	LHLD	JKN
  0B36'   EB                    	XCHG			; DE = LFs to find
  0B37'   21 0000               	LXI	H,0
  0B3A'   22 0000*              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  0B3D'                         KC_ED:
  0B3D'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0B3E'   2A 0000*              	LHLD	JKBK
  0B41'   CD 0795'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0B44'   E5                    	PUSH	H
  0B45'   EB                    	XCHG
  0B46'   2A 0000*              	LHLD	TXTBEG
  0B49'   EB                    	XCHG
  0B4A'   CD 0000*              	CALL	SUBHD
  0B4D'   44                    	MOV	B,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0B4E'   4D                    	MOV	C,L
  0B4F'   E1                    	POP	H
  0B50'   D1                    	POP	D
  0B51'                         KC_SC:
  0B51'   78                    	MOV	A,B
  0B52'   B1                    	ORA	C
  0B53'   CA 0B6A'              	JZ	KC_TB
  0B56'   2B                    	DCX	H
  0B57'   0B                    	DCX	B
  0B58'   7E                    	MOV	A,M
  0B59'   FE 0A                 	CPI	LF
  0B5B'   C2 0B51'              	JNZ	KC_SC
  0B5E'   1B                    	DCX	D
  0B5F'   7A                    	MOV	A,D
  0B60'   B3                    	ORA	E
  0B61'   C2 0B51'              	JNZ	KC_SC
  0B64'   2A 0000*              	LHLD	JKCNT		; N lines above: the move is count lines
  0B67'   C3 0B8A'              	JMP	KC_MV
  0B6A'                         KC_TB:
  0B6A'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0B6B'   CD 0795'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0B6E'   22 0000*              	SHLD	JKBK
  0B71'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0B74'   7C                    	MOV	A,H
  0B75'   B5                    	ORA	L
  0B76'   CA 0B83'              	JZ	KC_B0
  0B79'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  0B7C'   D1                    	POP	D
  0B7D'   DA 0B84'              	JC	KC_BOF
  0B80'   C3 0B3D'              	JMP	KC_ED
  0B83'                         KC_B0:
  0B83'   D1                    	POP	D
  0B84'                         KC_BOF:
  0B84'   2A 0000*              	LHLD	JKN		; moved = LFs found
  0B87'   CD 0000*              	CALL	SUBHD
  0B8A'                         KC_MV:
  0B8A'   E5                    	PUSH	H
  0B8B'   2A 0000*              	LHLD	JKCNT
  0B8E'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0B91'   D1                    	POP	D		; DE = moved
  0B92'   2A 0000*              	LHLD	JKN
  0B95'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0B98'   DA 0B9C'              	JC	KC_AD
  0B9B'   EB                    	XCHG			; DE = N
  0B9C'                         KC_AD:
  0B9C'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0B9F'   CD 0000*              	CALL	SUBHD
  0BA2'   22 0000*              	SHLD	LNDLT
  0BA5'   C9                    	RET
                                ;--- as JC_QK, back: the line starts after the LF one past the count, or
                                ;    where the text does when that is the file's start and the count ends
                                ;    there.  Fewer lines than the count, or text paged out: the long way ---
  0BA6'                         KC_QK:
  0BA6'   22 0000*              	SHLD	JKN		; N = the count
  0BA9'   2A 0000*              	LHLD	TXTBEG
  0BAC'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0BAD'   2A 0000*              	LHLD	GAPBEG
  0BB0'   E5                    	PUSH	H
  0BB1'   CD 0000*              	CALL	SUBHD
  0BB4'   44                    	MOV	B,H
  0BB5'   4D                    	MOV	C,L		; BC = the bytes before the cursor
  0BB6'   E1                    	POP	H
  0BB7'   3A 0000*              	LDA	JKN
  0BBA'   3C                    	INR	A
  0BBB'   5F                    	MOV	E,A		; E = LFs to find
  0BBC'   16 0A                 	MVI	D,LF
  0BBE'   04                    	INR	B
  0BBF'   0C                    	INR	C
  0BC0'                         KQ_LP:
  0BC0'   0D                    	DCR	C
  0BC1'   C2 0BC8'              	JNZ	KQ_CH
  0BC4'   05                    	DCR	B
  0BC5'   CA 0BE8'              	JZ	KQ_TB
  0BC8'                         KQ_CH:
  0BC8'   2B                    	DCX	H
  0BC9'   7E                    	MOV	A,M
  0BCA'   BA                    	CMP	D
  0BCB'   C2 0BC0'              	JNZ	KQ_LP
  0BCE'   1D                    	DCR	E
  0BCF'   C2 0BC0'              	JNZ	KQ_LP
  0BD2'   23                    	INX	H
  0BD3'                         KQ_GO:
  0BD3'   CD 0000*              	CALL	PUTCUR
  0BD6'   21 0000               	LXI	H,0
  0BD9'   CD 0000*              	CALL	SETC0		; the count spent, backward: as SETBWD leaves it
  0BDC'   3E FF                 	MVI	A,0FFH
  0BDE'   32 0000*              	STA	DIRFLG
  0BE1'   2A 0000*              	LHLD	JKCNT
  0BE4'   EB                    	XCHG			; DE = the lines moved
  0BE5'   C3 0B9C'              	JMP	KC_AD
  0BE8'                         KQ_TB:
  0BE8'   1D                    	DCR	E
  0BE9'   C2 0B33'              	JNZ	KC_SL
  0BEC'   2A 0000*              	LHLD	OUTPOS
  0BEF'   7C                    	MOV	A,H
  0BF0'   B5                    	ORA	L
  0BF1'   C2 0B33'              	JNZ	KC_SL
  0BF4'   2A 0000*              	LHLD	TXTBEG
  0BF7'   C3 0BD3'              	JMP	KQ_GO
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0BFA'                         ATEOF:
  0BFA'   CD 0000*              	CALL	RGET0
  0BFD'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0C00'                         LASTLN:
  0C00'   2A 0000*              	LHLD	GAPBEG
  0C03'   EB                    	XCHG
  0C04'   2A 0000*              	LHLD	TXTBEG
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C07'   CD 0000*              	CALL	CMP16
  0C0A'   21 0000               	LXI	H,0
  0C0D'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0C10'   1B                    	DCX	D
  0C11'   1A                    	LDAX	D
  0C12'   FE 0A                 	CPI	LF
  0C14'   C2 0000*              	JNZ	SETBWD
  0C17'   23                    	INX	H
  0C18'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0C1B'                         JKLAND:
  0C1B'   21 0000               	LXI	H,0
  0C1E'   22 0000*              	SHLD	JKVC		; screen column
  0C21'   2B                    	DCX	H
  0C22'   22 0000*              	SHLD	JKLS		; last content char: none yet
  0C25'   CD 0000*              	CALL	RGET0
  0C28'   11 0000               	LXI	D,0		; DE = chars read
  0C2B'                         JL_RD:
  0C2B'   CD 0000*              	CALL	RDGET
  0C2E'   DA 0C68'              	JC	JL_END
  0C31'   FE 0A                 	CPI	LF
  0C33'   CA 0C68'              	JZ	JL_END
  0C36'   E5                    	PUSH	H
  0C37'   C5                    	PUSH	B
  0C38'   2A 0000*              	LHLD	JKVC
  0C3B'   CD 0684'              	CALL	CWID
  0C3E'   B7                    	ORA	A
  0C3F'   CA 0C62'              	JZ	JL_NX		; a CR
  0C42'   EB                    	XCHG
  0C43'   22 0000*              	SHLD	JKLS		; the last content char so far
  0C46'   EB                    	XCHG
  0C47'   4F                    	MOV	C,A
  0C48'   06 00                 	MVI	B,0
  0C4A'   09                    	DAD	B		; HL = the column after this char
  0C4B'   22 0000*              	SHLD	JKVC
  0C4E'   D5                    	PUSH	D
  0C4F'   EB                    	XCHG
  0C50'   2A 31EF'              	LHLD	GOALCOL
  0C53'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0C56'   D1                    	POP	D
  0C57'   DA 0C62'              	JC	JL_NX
  0C5A'   CA 0C62'              	JZ	JL_NX
  0C5D'   C1                    	POP	B		; this char holds the goal column
  0C5E'   E1                    	POP	H
  0C5F'   C3 0C73'              	JMP	JL_GO
  0C62'                         JL_NX:
  0C62'   C1                    	POP	B
  0C63'   E1                    	POP	H
  0C64'   13                    	INX	D
  0C65'   C3 0C2B'              	JMP	JL_RD
  0C68'                         JL_END:
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0C68'   2A 0000*              	LHLD	JKLS		; past the line's end: its last content char
  0C6B'   7C                    	MOV	A,H
  0C6C'   A5                    	ANA	L
  0C6D'   3C                    	INR	A
  0C6E'   C2 0C72'              	JNZ	JL_LS
  0C71'   23                    	INX	H		; no content: the line's start
  0C72'                         JL_LS:
  0C72'   EB                    	XCHG
  0C73'                         JL_GO:
  0C73'   D5                    	PUSH	D		; DE = step from the line start
  0C74'   CD 0000*              	CALL	CUROFF
  0C77'   D1                    	POP	D
  0C78'   19                    	DAD	D
  0C79'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0C7C'   AF                    VC_W:	XRA	A
  0C7D'   32 0000*              	STA	WBIG
  0C80'   C3 0C88'              	JMP	WDO
  0C83'   3E 01                 VCBGW:	MVI	A,1
  0C85'   32 0000*              	STA	WBIG
  0C88'   CD 0871'              WDO:	CALL	SETMOV
  0C8B'   AF                    	XRA	A
  0C8C'   32 0000*              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0C8F'   CD 079C'              	CALL	GETCNT
  0C92'   22 0000*              	SHLD	CNTV
  0C95'   2A 0000*              WDO_LP: LHLD	CNTV
  0C98'   7C                    	MOV	A,H
  0C99'   B5                    	ORA	L
  0C9A'   CA 0CA7'              	JZ	WDO_DN
  0C9D'   2B                    	DCX	H
  0C9E'   22 0000*              	SHLD	CNTV
  0CA1'   CD 0D04'              	CALL	FWD1
  0CA4'   D2 0C95'              	JNC	WDO_LP
  0CA7'                         WDO_DN:
  0CA7'   CD 0BFA'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0CAA'   DA 0CB7'              	JC	WDO_NL
  0CAD'   FE 0D                 	CPI	CR
  0CAF'   CA 0CB7'              	JZ	WDO_NL
  0CB2'   FE 0A                 	CPI	LF
  0CB4'   C2 0630'              	JNZ	SETGL
  0CB7'                         WDO_NL:
  0CB7'   CD 0000*              	CALL	PEEKL
  0CBA'   DA 0630'              	JC	SETGL
  0CBD'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0CBF'   CA 0630'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0CC2'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0CC4'   32 0000*              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0CC7'   CD 0E23'              	CALL	DECC		; back onto its last char
  0CCA'   C3 0630'              	JMP	SETGL
                                
  0CCD'   AF                    VC_B:	XRA	A
  0CCE'   32 0000*              	STA	WBIG
  0CD1'   C3 0CD9'              	JMP	BDO
  0CD4'   3E 01                 VCBGB:	MVI	A,1
  0CD6'   32 0000*              	STA	WBIG
  0CD9'   CD 0871'              BDO:	CALL	SETMOV
  0CDC'   CD 079C'              	CALL	GETCNT
  0CDF'   22 0000*              	SHLD	CNTV
  0CE2'   CD 0D74'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0CE5'   D2 0CF5'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0CE8'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0CE9'   32 0000*              	STA	PSAVE		;   first char opened an insert).  A count that
  0CEC'   C3 0630'              	JMP	SETGL		;   runs out at the start has still moved, and
  0CEF'                         BDO_LP:				;   its operator stands -- both as vim
  0CEF'   CD 0D74'              	CALL	BCK1
  0CF2'   DA 0630'              	JC	SETGL
  0CF5'   2A 0000*              BDO_NX: LHLD	CNTV
  0CF8'   2B                    	DCX	H
  0CF9'   22 0000*              	SHLD	CNTV
  0CFC'   7C                    	MOV	A,H
  0CFD'   B5                    	ORA	L
  0CFE'   C2 0CEF'              	JNZ	BDO_LP
  0D01'   C3 0630'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
                                ; words before the last run on freely -- 'd2w' there takes the line break and
                                ; the next line's first word as well.
  0D04'                         FWD1:
  0D04'   CD 0DA7'              	CALL	CCLS
  0D07'   32 0000*              	STA	WKCLS		; the starting class
  0D0A'   CD 0DE1'              	CALL	INCC
  0D0D'   B7                    	ORA	A
  0D0E'   CA 0D27'              	JZ	FW_WD
  0D11'   37                    	STC
  0D12'   F8                    	RM			; -1: already at the end
  0D13'   CD 0D5F'              	CALL	WLAST
  0D16'   C8                    	RZ
  0D17'   FE 02                 	CPI	2
  0D19'   C2 0D27'              	JNZ	FW_WD		; 1: a next line was reached
  0D1C'   CD 0BFA'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0D1F'   D4 0DC8'              	CNC	NXLN
  0D22'   D2 0D27'              	JNC	FW_WD
  0D25'   37                    	STC			; yes: failed
  0D26'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D27'                         FW_WD:
  0D27'   3A 0000*              	LDA	WKCLS		; go past the rest of this word
  0D2A'   B7                    	ORA	A
  0D2B'   CA 0D47'              	JZ	FW_WS
  0D2E'                         FW_WLP:
  0D2E'   CD 0DA7'              	CALL	CCLS
  0D31'   21 0000*              	LXI	H,WKCLS
  0D34'   BE                    	CMP	M
  0D35'   C2 0D47'              	JNZ	FW_WS
  0D38'   CD 0DE1'              	CALL	INCC
  0D3B'   B7                    	ORA	A
  0D3C'   F8                    	RM			; the end of the file (NC)
  0D3D'   CA 0D2E'              	JZ	FW_WLP
  0D40'   CD 0D5F'              	CALL	WLAST
  0D43'   C8                    	RZ
  0D44'   C3 0D2E'              	JMP	FW_WLP
  0D47'                         FW_WS:
  0D47'   CD 0DA7'              	CALL	CCLS		; then over blanks to the next word
  0D4A'   B7                    	ORA	A
  0D4B'   C0                    	RNZ
  0D4C'   CD 0DAF'              	CALL	EMPTY
  0D4F'   C8                    	RZ			; an empty line is a word
  0D50'   CD 0DE1'              	CALL	INCC
  0D53'   B7                    	ORA	A
  0D54'   F8                    	RM
  0D55'   CA 0D47'              	JZ	FW_WS
  0D58'   CD 0D5F'              	CALL	WLAST
  0D5B'   C8                    	RZ
  0D5C'   C3 0D47'              	JMP	FW_WS
                                
                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0D5F'                         WLAST:
  0D5F'   47                    	MOV	B,A
  0D60'   2A 0000*              	LHLD	CNTV
  0D63'   7C                    	MOV	A,H
  0D64'   B5                    	ORA	L
  0D65'   C2 0D70'              	JNZ	WL_X		; words still owed
  0D68'   3A 0000*              	LDA	PSAVE
  0D6B'   B7                    	ORA	A
  0D6C'   CA 0D72'              	JZ	WL_NO		; a plain 'w'
  0D6F'   AF                    	XRA	A
  0D70'   78                    WL_X:	MOV	A,B
  0D71'   C9                    	RET
  0D72'   B0                    WL_NO:	ORA	B
  0D73'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0D74'                         BCK1:
  0D74'   CD 0E23'              	CALL	DECC
  0D77'   B7                    	ORA	A
  0D78'   37                    	STC
  0D79'   F8                    	RM
  0D7A'                         BK_WS:
  0D7A'   CD 0DA7'              	CALL	CCLS		; back over blanks
  0D7D'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0D7E'   C2 0D8E'              	JNZ	BK_WD
  0D81'   CD 0DAF'              	CALL	EMPTY
  0D84'   C8                    	RZ			; an empty line is a word
  0D85'   CD 0E23'              	CALL	DECC
  0D88'   B7                    	ORA	A
  0D89'   F2 0D7A'              	JP	BK_WS
  0D8C'   AF                    	XRA	A		; the start of the file (NC)
  0D8D'   C9                    	RET
  0D8E'                         BK_WD:
  0D8E'   32 0000*              	STA	WKCLS		; back to the start of this word
  0D91'                         BK_WLP:
  0D91'   CD 0E23'              	CALL	DECC
  0D94'   B7                    	ORA	A
  0D95'   FA 0DA5'              	JM	BK_OK		; the start of the file
  0D98'   CD 0DA7'              	CALL	CCLS
  0D9B'   21 0000*              	LXI	H,WKCLS
  0D9E'   BE                    	CMP	M
  0D9F'   CA 0D91'              	JZ	BK_WLP
  0DA2'   CD 0DE1'              	CALL	INCC		; overshot: forward one
  0DA5'                         BK_OK:
  0DA5'   AF                    	XRA	A
  0DA6'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0DA7'                         CCLS:
  0DA7'   CD 0BFA'              	CALL	ATEOF
  0DAA'   D2 0826'              	JNC	CLASSF
  0DAD'   AF                    	XRA	A
  0DAE'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0DAF'                         EMPTY:
  0DAF'   CD 0BFA'              	CALL	ATEOF
  0DB2'   DA 0DBD'              	JC	EM_ST
  0DB5'   FE 0D                 	CPI	CR
  0DB7'   CA 0DBD'              	JZ	EM_ST
  0DBA'   FE 0A                 	CPI	LF
  0DBC'   C0                    	RNZ
  0DBD'                         EM_ST:
  0DBD'   CD 0000*              	CALL	PEEKL
  0DC0'   DA 0DC6'              	JC	EM_Y
  0DC3'   FE 0A                 	CPI	LF
  0DC5'   C9                    	RET
  0DC6'                         EM_Y:
  0DC6'   AF                    	XRA	A
  0DC7'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0DC8'                         NXLN:
  0DC8'   FE 0A                 	CPI	LF
  0DCA'   CA 0DD9'              	JZ	NX_LF
  0DCD'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0DD0'   D8                    	RC
  0DD1'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0DD3'   CA 0DD9'              	JZ	NX_LF
  0DD6'   2B                    	DCX	H		; a lone CR
  0DD7'   AF                    	XRA	A
  0DD8'   C9                    	RET
  0DD9'                         NX_LF:
  0DD9'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0DDC'   D8                    	RC
  0DDD'   2B                    	DCX	H
  0DDE'   3E 01                 	MVI	A,1
  0DE0'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0DE1'                         INCC:
  0DE1'   CD 0BFA'              	CALL	ATEOF
  0DE4'   DA 0E1F'              	JC	IC_END
  0DE7'   FE 0D                 	CPI	CR
  0DE9'   CA 0E0A'              	JZ	IC_NL
  0DEC'   FE 0A                 	CPI	LF
  0DEE'   CA 0E0A'              	JZ	IC_NL
  0DF1'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0DF4'                         IC_CH:
  0DF4'   CD 0BFA'              	CALL	ATEOF
  0DF7'   DA 0E06'              	JC	IC_2
  0DFA'   FE 0D                 	CPI	CR
  0DFC'   CA 0E06'              	JZ	IC_2
  0DFF'   FE 0A                 	CPI	LF
  0E01'   CA 0E06'              	JZ	IC_2
  0E04'   AF                    	XRA	A
  0E05'   C9                    	RET
  0E06'                         IC_2:
  0E06'   3E 02                 	MVI	A,2
  0E08'   B7                    	ORA	A
  0E09'   C9                    	RET
  0E0A'                         IC_NL:
  0E0A'   CD 0DC8'              	CALL	NXLN
  0E0D'   DA 0E1F'              	JC	IC_END
  0E10'   F5                    	PUSH	PSW
  0E11'   CD 0000*              	CALL	PUTCUR
  0E14'   F1                    	POP	PSW
  0E15'   B7                    	ORA	A
  0E16'   CA 0DF4'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0E19'   CD 0E45'              	CALL	LNINC
  0E1C'   3E 01                 	MVI	A,1
  0E1E'   C9                    	RET
  0E1F'                         IC_END:
  0E1F'   3E FF                 	MVI	A,0FFH
  0E21'   B7                    	ORA	A
  0E22'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0E23'                         DECC:
  0E23'   CD 0000*              	CALL	PEEKL
  0E26'   DA 0E1F'              	JC	IC_END
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E29'   F5                    	PUSH	PSW
  0E2A'   CD 0000*              	CALL	PUTCUR
  0E2D'   F1                    	POP	PSW
  0E2E'   FE 0A                 	CPI	LF
  0E30'   3E 00                 	MVI	A,0
  0E32'   C0                    	RNZ
  0E33'   CD 0E53'              	CALL	LNDEC
  0E36'   CD 0000*              	CALL	PEEKL		; onto its CR
  0E39'   DA 0E41'              	JC	DC_1
  0E3C'   FE 0D                 	CPI	CR
  0E3E'   CC 0000*              	CZ	PUTCUR
  0E41'                         DC_1:
  0E41'   3E 01                 	MVI	A,1
  0E43'   B7                    	ORA	A
  0E44'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0E45'                         LNINC:
  0E45'   E5                    	PUSH	H
  0E46'   2A 0000*              	LHLD	LNDLT
  0E49'   7C                    	MOV	A,H
  0E4A'   FE 40                 	CPI	40H
  0E4C'   CA 0E61'              	JZ	LN_X
  0E4F'   23                    	INX	H
  0E50'   C3 0E5E'              	JMP	LN_ST
  0E53'                         LNDEC:
  0E53'   E5                    	PUSH	H
  0E54'   2A 0000*              	LHLD	LNDLT
  0E57'   7C                    	MOV	A,H
  0E58'   FE C0                 	CPI	0C0H
  0E5A'   CA 0E61'              	JZ	LN_X
  0E5D'   2B                    	DCX	H
  0E5E'                         LN_ST:
  0E5E'   22 0000*              	SHLD	LNDLT
  0E61'                         LN_X:
  0E61'   E1                    	POP	H
  0E62'   C9                    	RET
                                
  0E63'   AF                    VC_E:	XRA	A
  0E64'   32 0000*              	STA	WBIG
  0E67'   C3 0E6F'              	JMP	EDO
  0E6A'   3E 01                 VCBGE:	MVI	A,1
  0E6C'   32 0000*              	STA	WBIG
  0E6F'   CD 0871'              EDO:	CALL	SETMOV
  0E72'   CD 079C'              	CALL	GETCNT
  0E75'   22 0000*              	SHLD	CNTV
  0E78'   2A 0000*              EDO_LP: LHLD	CNTV
  0E7B'   7C                    	MOV	A,H
  0E7C'   B5                    	ORA	L
  0E7D'   CA 0CA7'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0E80'   2B                    	DCX	H
  0E81'   22 0000*              	SHLD	CNTV
  0E84'   CD 0E92'              	CALL	ESTEP
  0E87'   21 0000*              	LXI	H,CWEOL		; only the count's first word stays where it is
  0E8A'   36 00                 	MVI	M,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0E8C'   D2 0E78'              	JNC	EDO_LP
  0E8F'   C3 0CA7'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0E92'                         ESTEP:
  0E92'   CD 0DA7'              	CALL	CCLS
  0E95'   32 0000*              	STA	WKCLS		; the starting class
  0E98'   CD 0DE1'              	CALL	INCC
  0E9B'   B7                    	ORA	A
  0E9C'   FA 0EC2'              	JM	ES_F
  0E9F'   CD 0DA7'              	CALL	CCLS
  0EA2'   B7                    	ORA	A
  0EA3'   CA 0EAD'              	JZ	ES_ST
  0EA6'   21 0000*              	LXI	H,WKCLS
  0EA9'   BE                    	CMP	M
  0EAA'   CA 0EC4'              	JZ	ES_SK		; still in the word it started in: on to its end
  0EAD'                         ES_ST:
  0EAD'   3A 0000*              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0EB0'   B7                    	ORA	A		;   that char is the word's end already, and
  0EB1'   C2 0EDB'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
  0EB4'                         ES_WS:
  0EB4'   CD 0DA7'              	CALL	CCLS		; over blanks, line ends and empty lines
  0EB7'   B7                    	ORA	A
  0EB8'   C2 0EC4'              	JNZ	ES_SK
  0EBB'   CD 0DE1'              	CALL	INCC
  0EBE'   B7                    	ORA	A
  0EBF'   F2 0EB4'              	JP	ES_WS
  0EC2'                         ES_F:
  0EC2'   37                    	STC
  0EC3'   C9                    	RET
  0EC4'                         ES_SK:
  0EC4'   CD 0DA7'              	CALL	CCLS		; past the rest of this word ...
  0EC7'   32 0000*              	STA	WKCLS
  0ECA'                         ES_SL:
  0ECA'   CD 0DE1'              	CALL	INCC
  0ECD'   B7                    	ORA	A
  0ECE'   FA 0EC2'              	JM	ES_F
  0ED1'   CD 0DA7'              	CALL	CCLS
  0ED4'   21 0000*              	LXI	H,WKCLS
  0ED7'   BE                    	CMP	M
  0ED8'   CA 0ECA'              	JZ	ES_SL
  0EDB'   C3 0E23'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's place among the screen's LINES (CURRW) and the
                                ; last layout's facts from SCRN.MAC: SCBOT (the last line shown), SCEOF / SCBOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


                                ; (the file's end / start is on the screen).  H and L count lines.  M and the
                                ; scrolls count screen ROWS, as vim does once lines wrap, and a line's rows
                                ; are not known without measuring it: SCRN.MAC's HTBLD measures the lines
                                ; about the screen into a table (HTAB), and the rest is arithmetic on that.
                                ; A scroll then moves the cursor and names the line the screen is to start
                                ; with (HTLAND -> SETRWT), so the text scrolls around it.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0EDE'                         CURRW:
  0EDE'   2A 0000*              	LHLD	WINROW
  0EE1'   EB                    	XCHG
  0EE2'   2A 0000*              	LHLD	LNDLT
  0EE5'   19                    	DAD	D		; HL = row (signed)
  0EE6'   7C                    	MOV	A,H
  0EE7'   B7                    	ORA	A
  0EE8'   FA 0EFB'              	JM	CRW_0		; above the screen -> top row
  0EEB'   C2 0EF6'              	JNZ	CRW_BT		; far below -> bottom row
  0EEE'   3A 0000*              	LDA	NEDIT
  0EF1'   3D                    	DCR	A		; A = bottom row
  0EF2'   BD                    	CMP	L		; CY iff bottom < row
  0EF3'   D8                    	RC
  0EF4'   7D                    	MOV	A,L
  0EF5'   C9                    	RET
  0EF6'                         CRW_BT:
  0EF6'   3A 0000*              	LDA	NEDIT
  0EF9'   3D                    	DCR	A
  0EFA'   C9                    	RET
  0EFB'                         CRW_0:
  0EFB'   AF                    	XRA	A
  0EFC'   C9                    	RET
                                
                                ;SETRWT -- A = lines: the next layout puts that many above the cursor's, and
                                ; does not ask whether the line has gone far (PLACE).
  0EFD'                         SETRWT:
  0EFD'   2A 0000*              	LHLD	LNDLT
  0F00'   EB                    	XCHG
  0F01'   6F                    	MOV	L,A
  0F02'   26 00                 	MVI	H,0
  0F04'   CD 0000*              	CALL	SUBHD		; HL = lines - LNDLT
  0F07'   22 0000*              	SHLD	WINROW
  0F0A'   3E 01                 	MVI	A,PL_SET
  0F0C'   32 0000*              	STA	PLACE
  0F0F'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0F10'                         MVROW:
  0F10'   47                    	MOV	B,A
  0F11'   CD 0EDE'              	CALL	CURRW
  0F14'   90                    	SUB	B		; A = row now - target
  0F15'                         MR_GO:
  0F15'   C8                    	RZ
  0F16'   DA 0F1F'              	JC	MR_DN
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F19'   6F                    	MOV	L,A
  0F1A'   26 00                 	MVI	H,0
  0F1C'   C3 0B12'              	JMP	KCORE
  0F1F'                         MR_DN:
  0F1F'   2F                    	CMA
  0F20'   3C                    	INR	A		; A = target - row now
  0F21'   6F                    	MOV	L,A
  0F22'   26 00                 	MVI	H,0
  0F24'   C3 0A32'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0F27'                         VC_HIGH:
  0F27'   CD 0789'              	CALL	MOVCNT		; a cursor motion, and its count
  0F2A'   2B                    	DCX	H		; row = count - 1
  0F2B'   7C                    	MOV	A,H
  0F2C'   B7                    	ORA	A
  0F2D'   3A 0000*              	LDA	SCBOT
  0F30'   C2 0F38'              	JNZ	VH_GO		; >= 256 -> the last text row
  0F33'   BD                    	CMP	L		; CY iff SCBOT < row
  0F34'   DA 0F38'              	JC	VH_GO
  0F37'   7D                    	MOV	A,L
  0F38'                         VH_GO:
  0F38'   CD 0F10'              	CALL	MVROW
  0F3B'   C3 0977'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': the line the middle ROW of the text is on (vim: the first
                                ; whose rows, with those above it, come to half of them); count ignored.
  0F3E'                         VC_MIDL:
  0F3E'   CD 0789'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0F41'   CD 11D0'              	CALL	HTSCR		; HL -> the top line's rows
  0F44'   3A 0000*              	LDA	TXEND
  0F47'   3C                    	INR	A
  0F48'   B7                    	ORA	A
  0F49'   1F                    	RAR
  0F4A'   3D                    	DCR	A
  0F4B'   4F                    	MOV	C,A		; C = (rows of text + 1) / 2 - 1
  0F4C'   CD 1216'              	CALL	HTFQ
  0F4F'   D2 0F53'              	JNC	VM_GO
  0F52'   2B                    	DCX	H
  0F53'                         VM_GO:
  0F53'   CD 120B'              	CALL	HTGO
  0F56'   C3 0977'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0F59'                         VC_LOWL:
  0F59'   CD 0789'              	CALL	MOVCNT		; a cursor motion, and its count
  0F5C'   2B                    	DCX	H		; count - 1
  0F5D'   3A 0000*              	LDA	SCBOT
  0F60'   5F                    	MOV	E,A
  0F61'   16 00                 	MVI	D,0
  0F63'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0F64'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0F67'   3E 00                 	MVI	A,0
  0F69'   D2 0F70'              	JNC	VL_GO		; at or past the top -> row 0
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F6C'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0F6F'   7D                    	MOV	A,L
  0F70'                         VL_GO:
  0F70'   CD 0F10'              	CALL	MVROW
  0F73'   C3 0977'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the text forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is the
                                ; screen's ROWS less the overlap (OVLAP), and the line that many rows down
                                ; becomes the top line -- from its first row, vim never showing part of one.
                                ; The top line stops at the last line ('~' rows below); no-op when it is
                                ; already there.
  0F76'                         VC_PGDN:
  0F76'   CD 0789'              	CALL	MOVCNT		; a cursor motion, and its count
  0F79'   22 0000*              	SHLD	RWR
  0F7C'   3A 0000*              	LDA	SCEOF
  0F7F'   B7                    	ORA	A
  0F80'   CA 0F88'              	JZ	VPD_N
  0F83'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: it becomes the
  0F86'   B7                    	ORA	A		;   top line
  0F87'   C8                    	RZ			; it already is
  0F88'                         VPD_N:
  0F88'   3A 0000*              	LDA	NEDIT
  0F8B'   3C                    	INR	A
  0F8C'   4F                    	MOV	C,A
  0F8D'   3E 02                 	MVI	A,2
  0F8F'   CD 11D7'              	CALL	HTSET		; HL -> the top line's rows
  0F92'   E5                    	PUSH	H
  0F93'   C5                    	PUSH	B
  0F94'   3A 0000*              	LDA	NEDIT
  0F97'   4F                    	MOV	C,A
  0F98'   CD 1216'              	CALL	HTFQ		; HL -> the first line the screen has not room for
  0F9B'   3A 0000*              	LDA	NEDIT
  0F9E'   DA 0FAB'              	JC	VPD_R		; there is none: no overlap
  0FA1'   3A 0000*              	LDA	HTN
  0FA4'   90                    	SUB	B
  0FA5'   3C                    	INR	A
  0FA6'   47                    	MOV	B,A		; the lines from it up to the table's first
  0FA7'   AF                    	XRA	A
  0FA8'   CD 1045'              	CALL	OVLAP
  0FAB'                         VPD_R:
  0FAB'   CD 1094'              	CALL	PGROWS		; RWR = the rows to go
  0FAE'   C1                    	POP	B
  0FAF'   E1                    	POP	H
  0FB0'   CD 1257'              	CALL	RWFWD		; HL -> the line that row is in, C = which of its
  0FB3'   DA 0FCF'              	JC	VPD_TP		; the text ended: its last line
  0FB6'   79                    	MOV	A,C
  0FB7'   B7                    	ORA	A
  0FB8'   CA 0FCF'              	JZ	VPD_TP
  0FBB'   3A 0000*              	LDA	RWMV		; part of the way down a line: its start -- unless
  0FBE'   B7                    	ORA	A		;   that is the top line still, then the next
  0FBF'   C2 0FCF'              	JNZ	VPD_TP
  0FC2'   E5                    	PUSH	H
  0FC3'   CD 1205'              	CALL	HTIX
  0FC6'   21 0000*              	LXI	H,HTTP
  0FC9'   BE                    	CMP	M
