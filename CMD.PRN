  2DF6'   4D                    	DB	'M'
  2DF7'   0E46'                 	DW	VC_MIDL
  2DF9'   4C                    	DB	'L'
  2DFA'   0E61'                 	DW	VC_LOWL
  2DFC'   06                    	DB	06H			; ^F -- page forward
  2DFD'   0E7E'                 	DW	VC_PGDN
  2DFF'   02                    	DB	02H			; ^B -- page back
  2E00'   0EDC'                 	DW	VC_PGUP
  2E02'   04                    	DB	04H			; ^D -- half page down
  2E03'   0FBD'                 	DW	VC_HFDN
  2E05'   15                    	DB	15H			; ^U -- half page up
  2E06'   1084'                 	DW	VC_HFUP
  2E08'   0C                    	DB	0CH			; ^L -- redraw
  2E09'   1233'                 	DW	VC_REDR
  2E0B'   2E                    	DB	'.'			; '.' -- repeat the last change
  2E0C'   017D'                 	DW	VC_DOT
  2E0E'   75                    	DB	'u'			; 'u' -- undo (and undo the undo)
  2E0F'   0545'                 	DW	VC_UNDO
  2E11'   6D                    	DB	'm'		; m{a-c} -- set a mark
  2E12'   032E'                 	DW	VC_MK
  2E14'   60                    	DB	60H		; `{a-c} -- back to its exact spot
  2E15'   0333'                 	DW	VC_BQ
  2E17'   27                    	DB	27H		; '{a-c} -- back to its line's first non-blank
  2E18'   0338'                 	DW	VC_AQ
  2E1A'   00                    	DB	0
                                
