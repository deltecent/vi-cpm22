  27E5'   C5                    	PUSH	B
  27E6'   4F                    	MOV	C,A
  27E7'   06 00                 	MVI	B,0		; BC = the digit
  27E9'   D5                    	PUSH	D
  27EA'   54                    	MOV	D,H
  27EB'   5D                    	MOV	E,L
  27EC'   29                    	DAD	H		; *2
  27ED'   29                    	DAD	H		; *4
  27EE'   19                    	DAD	D		; *5
  27EF'   29                    	DAD	H		; *10
  27F0'   D1                    	POP	D
  27F1'   09                    	DAD	B
  27F2'   C1                    	POP	B
  27F3'   C3 27D9'              	JMP	EXN_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-124


  27F6'                         EXN_DN:
  27F6'   B7                    	ORA	A		; CY clear: there was a number
  27F7'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  27F8'                         EX_S:
  27F8'   7E                    	MOV	A,M
  27F9'   B7                    	ORA	A
  27FA'   CA 283C'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  27FD'   32 2DDB'              	STA	SDELIM
  2800'   23                    	INX	H
  2801'   11 0000*              	LXI	D,SRCHST
  2804'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  2807'   4F                    	MOV	C,A
  2808'   CD 2842'              	CALL	SCOPY
  280B'   78                    	MOV	A,B
  280C'   B7                    	ORA	A
  280D'   CA 283C'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  2810'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  2813'   3E 01                 	MVI	A,1
  2815'   32 2DA3'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  2818'   11 2DED'              	LXI	D,SREPL
  281B'   0E 24                 	MVI	C,SREPMX
  281D'   CD 2842'              	CALL	SCOPY
  2820'   78                    	MOV	A,B
  2821'   32 2DEC'              	STA	SREPLN
  2824'   AF                    	XRA	A
  2825'   32 2DDC'              	STA	SGFLAG
  2828'   7E                    	MOV	A,M
  2829'   FE 67                 	CPI	'g'
  282B'   C2 2834'              	JNZ	EX_SG
  282E'   23                    	INX	H
  282F'   3E 01                 	MVI	A,1
  2831'   32 2DDC'              	STA	SGFLAG
  2834'                         EX_SG:
  2834'   7E                    	MOV	A,M
  2835'   B7                    	ORA	A
  2836'   C2 25C3'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  2839'   C3 2862'              	JMP	SUBGO
  283C'                         SUBNOP:
  283C'   21 268B'              	LXI	H,SNOPAT
  283F'   C3 25D1'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  2842'                         SCOPY:
  2842'   06 00                 	MVI	B,0
  2844'                         SCP_LP:
  2844'   78                    	MOV	A,B
  2845'   B9                    	CMP	C
  2846'   D2 285F'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  2849'   7E                    	MOV	A,M
  284A'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-125


  284B'   CA 285F'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  284E'   E5                    	PUSH	H
  284F'   21 2DDB'              	LXI	H,SDELIM
  2852'   BE                    	CMP	M
  2853'   E1                    	POP	H
  2854'   CA 285E'              	JZ	SCP_SK
  2857'   12                    	STAX	D
  2858'   13                    	INX	D
  2859'   23                    	INX	H
  285A'   04                    	INR	B
  285B'   C3 2844'              	JMP	SCP_LP
  285E'                         SCP_SK:
  285E'   23                    	INX	H
  285F'                         SCP_DN:
  285F'   AF                    	XRA	A
  2860'   12                    	STAX	D
  2861'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  2862'                         SUBGO:
  2862'   CD 1259'              	CALL	GZONE
  2865'   2A 0000*              	LHLD	LNDLT
  2868'   22 2DEA'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  286B'   21 2DE7'              	LXI	H,SOFFS		;   finds nothing puts both back, as the
  286E'   CD 0429'              	CALL	FPSTO		;   search's SN_BAD does
  2871'   AF                    	XRA	A
  2872'   32 2DDD'              	STA	SANY
  2875'   21 0000               	LXI	H,0
  2878'   22 2DDF'              	SHLD	SBACK
  287B'   3A 2DD6'              	LDA	SRNGF
  287E'   B7                    	ORA	A
  287F'   CA 2891'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  2882'   CD 2151'              	CALL	EXRNG		; SLINES = the lines in the range
  2885'   DA 290D'              	JC	SUBBAD
  2888'   2A 2DD7'              	LHLD	SRNG1
  288B'   CD 11C7'              	CALL	GOLN
  288E'   C3 2897'              	JMP	SUBLP
  2891'                         SUB_1L:
  2891'   21 0001               	LXI	H,1
  2894'   22 2DE1'              	SHLD	SLINES
  2897'                         SUBLP:
  2897'   CD 2913'              	CALL	SUBLIN		; A = 1 when this line changed
  289A'   B7                    	ORA	A
  289B'   CA 28A9'              	JZ	SUB_NX
  289E'   3E 01                 	MVI	A,1
  28A0'   32 2DDD'              	STA	SANY
  28A3'   21 0000               	LXI	H,0
  28A6'   22 2DDF'              	SHLD	SBACK		; the cursor is ON the last line changed
  28A9'                         SUB_NX:
  28A9'   2A 2DE1'              	LHLD	SLINES
  28AC'   2B                    	DCX	H
  28AD'   22 2DE1'              	SHLD	SLINES
  28B0'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-126


  28B1'   B5                    	ORA	L
  28B2'   CA 28D0'              	JZ	SUBDON		; the range is spent
  28B5'   21 0001               	LXI	H,1
  28B8'   AF                    	XRA	A
  28B9'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  28BC'   3A 2DDD'              	LDA	SANY
  28BF'   B7                    	ORA	A
  28C0'   CA 28CA'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  28C3'   2A 2DDF'              	LHLD	SBACK
  28C6'   23                    	INX	H
  28C7'   22 2DDF'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  28CA'                         SUB_AE:
  28CA'   CD 0A63'              	CALL	ATEOF
  28CD'   D2 2897'              	JNC	SUBLP		; ... unless that ran off the end of the file
  28D0'                         SUBDON:
  28D0'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  28D3'   3A 2DDD'              	LDA	SANY
  28D6'   B7                    	ORA	A
  28D7'   CA 28F5'              	JZ	SUBNFD
  28DA'   3E 01                 	MVI	A,1
  28DC'   32 2D18'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  28DF'   2A 2DDF'              	LHLD	SBACK
  28E2'   7C                    	MOV	A,H
  28E3'   B5                    	ORA	L
  28E4'   CA 28EF'              	JZ	SUB_PL
  28E7'   3E FF                 	MVI	A,0FFH
  28E9'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  28EC'   CD 0000*              	CALL	CLRCNT
  28EF'                         SUB_PL:
  28EF'   CD 1271'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  28F2'   C3 07C1'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  28F5'                         SUBNFD:
  28F5'   21 2DE7'              	LXI	H,SOFFS
  28F8'   CD 03D0'              	CALL	BACKTO
  28FB'   2A 2DEA'              	LHLD	SLDLTS
  28FE'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  2901'   21 265B'              	LXI	H,SNOTFD
  2904'   CD 25D1'              	CALL	EXERR
  2907'   21 0000*              	LXI	H,SRCHST
  290A'   C3 25CC'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  290D'                         SUBBAD:
  290D'   21 2649'              	LXI	H,SNOT
	MACRO-80 3.44	09-Dec-81	PAGE	1-127


  2910'   C3 25C6'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  2913'                         SUBLIN:
  2913'   AF                    	XRA	A
  2914'   32 2DDE'              	STA	SLCHG
  2917'   CD 2992'              	CALL	SUBBOL
  291A'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  291D'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  291D'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  2920'   DA 2928'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  2923'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  2925'   C2 291D'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  2928'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  2928'   CD 0000*              	CALL	CUROFF
  292B'   E5                    	PUSH	H
  292C'   CD 1805'              	CALL	CEND
  292F'   D1                    	POP	D
  2930'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  2933'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  2934'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  2937'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  2938'   B7                    	ORA	A		;   span is a line, not a pair.)
  2939'   FA 298B'              	JM	SUBL_D		; what is left is shorter than the pattern
  293C'   44                    	MOV	B,H
  293D'   4D                    	MOV	C,L		; BC = the start positions a match can take
  293E'   11 0000*              	LXI	D,SRCHST
  2941'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  2944'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  2947'   DA 298B'              	JC	SUBL_D
  294A'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  294D'   EB                    	XCHG
  294E'   2A 0000*              	LHLD	GAPEND
  2951'   EB                    	XCHG
  2952'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  2955'   EB                    	XCHG
  2956'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  2957'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  295A'   D1                    	POP	D
  295B'   19                    	DAD	D		; ... and so the match's logical offset
  295C'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  295F'   3A 2DDD'              	LDA	SANY
  2962'   B7                    	ORA	A
  2963'   C2 2970'              	JNZ	SUBL_C
  2966'   3A 2DDE'              	LDA	SLCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-128


  2969'   B7                    	ORA	A
  296A'   C2 2970'              	JNZ	SUBL_C
  296D'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  2970'                         SUBL_C:
  2970'   3A 0000*              	LDA	SRCHBF
  2973'   6F                    	MOV	L,A
  2974'   26 00                 	MVI	H,0
  2976'   CD 0000*              	CALL	DELFWD		; the match goes
  2979'   11 2DEC'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  297C'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  297F'                         SUBL_I:
  297F'   3E 01                 	MVI	A,1
  2981'   32 2DDE'              	STA	SLCHG
  2984'   3A 2DDC'              	LDA	SGFLAG
  2987'   B7                    	ORA	A
  2988'   C2 2928'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  298B'                         SUBL_D:
  298B'   CD 2992'              	CALL	SUBBOL
  298E'   3A 2DDE'              	LDA	SLCHG
  2991'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  2992'                         SUBBOL:
  2992'   CD 0000*              	CALL	CUROFF
  2995'   CD 0624'              	CALL	BOL
  2998'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  299B'                         VC_SRCH:
  299B'   CD 07A0'              	CALL	SETMOV
  299E'   C5                    	PUSH	B
  299F'   CD 06CB'              	CALL	GETCNT
  29A2'   22 2DCC'              	SHLD	SCNT
  29A5'   C1                    	POP	B
  29A6'   79                    	MOV	A,C
  29A7'   FE 2F                 	CPI	'/'
  29A9'   3E 00                 	MVI	A,0
  29AB'   CA 29B0'              	JZ	VS_DIR
  29AE'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  29B0'                         VS_DIR:
  29B0'   32 2DA1'              	STA	SDIR
  29B3'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  29B6'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  29B9'   47                    	MOV	B,A
  29BA'   CD 1EFA'              	CALL	RDLINE
  29BD'   B7                    	ORA	A
  29BE'   C0                    	RNZ			; cancelled: nothing happens at all
  29BF'   3A 2D78'              	LDA	RLLEN
  29C2'   B7                    	ORA	A
  29C3'   CA 29D8'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
	MACRO-80 3.44	09-Dec-81	PAGE	1-129


  29C6'   5F                    	MOV	E,A
  29C7'   16 00                 	MVI	D,0
  29C9'   21 0000*              	LXI	H,SRCHST
  29CC'   19                    	DAD	D
  29CD'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  29CF'   7B                    	MOV	A,E
  29D0'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  29D3'   3E 01                 	MVI	A,1
  29D5'   32 2DA3'              	STA	SHAVE
  29D8'                         VS_OLD:
  29D8'   3A 2DA3'              	LDA	SHAVE
  29DB'   B7                    	ORA	A
  29DC'   CA 29E8'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  29DF'   3A 2DA1'              	LDA	SDIR
  29E2'   32 2DA2'              	STA	SDIRE
  29E5'   C3 2A11'              	JMP	SRCHN
  29E8'                         VS_NOP:
  29E8'   21 268B'              	LXI	H,SNOPAT
  29EB'   C3 25D1'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  29EE'                         VC_N:
  29EE'   CD 07A0'              	CALL	SETMOV
  29F1'   3A 2DA1'              	LDA	SDIR
  29F4'   C3 29FE'              	JMP	VN_GO
  29F7'                         VCB_N:
  29F7'   CD 07A0'              	CALL	SETMOV
  29FA'   3A 2DA1'              	LDA	SDIR
  29FD'   2F                    	CMA			; the other way: 0 <-> FFH
  29FE'                         VN_GO:
  29FE'   32 2DA2'              	STA	SDIRE
  2A01'   CD 06CB'              	CALL	GETCNT
  2A04'   22 2DCC'              	SHLD	SCNT
  2A07'   3A 2DA3'              	LDA	SHAVE
  2A0A'   B7                    	ORA	A
  2A0B'   CA 29E8'              	JZ	VS_NOP
  2A0E'   C3 2A11'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  2A11'                         SRCHN:
  2A11'   CD 1259'              	CALL	GZONE		; the screen's top line, before the cursor moves
  2A14'   CD 06F4'              	CALL	BRKON		; where it started (the sweep moves the cursor
                                				;   with PUTCUR, which does not maintain LNDLT;
                                				;   GOTO does), and an ESC may stop it
  2A17'                         SN_LP:
  2A17'   CD 2A4C'              	CALL	SRCHGO
  2A1A'   DA 2A37'              	JC	SN_BAD
  2A1D'   2A 2DCC'              	LHLD	SCNT
  2A20'   2B                    	DCX	H
  2A21'   22 2DCC'              	SHLD	SCNT
  2A24'   7C                    	MOV	A,H
  2A25'   B5                    	ORA	L
  2A26'   C2 2A17'              	JNZ	SN_LP
  2A29'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
	MACRO-80 3.44	09-Dec-81	PAGE	1-130


                                				;   backward): WM clears both per command
  2A2C'   CD 0731'              	CALL	BRKOFF
  2A2F'   3E 01                 	MVI	A,1
  2A31'   32 2DAE'              	STA	GPKEEP		; land on the match, not the first non-blank
  2A34'   C3 1271'              	JMP	GPLACE		; (which sets LNDLT itself)
  2A37'                         SN_BAD:
  2A37'   CD 0731'              	CALL	BRKOFF
  2A3A'   DA 0749'              	JC	BRKBAK		; stopped, which is not the same as not found
  2A3D'   CD 073C'              	CALL	RSTPL		; nothing moved: the row the cursor was on
  2A40'   21 265B'              	LXI	H,SNOTFD
  2A43'   CD 25D1'              	CALL	EXERR
  2A46'   21 0000*              	LXI	H,SRCHST
  2A49'   C3 25CC'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  2A4C'                         SRCHGO:
  2A4C'   3E 01                 	MVI	A,1
  2A4E'   32 2DD5'              	STA	SSKIP		; this pass starts one past the cursor
  2A51'   CD 2A67'              	CALL	SRCHW
  2A54'   D0                    	RNC
  2A55'   CD 0735'              	CALL	BRKQ
  2A58'   D8                    	RC			; stopped: no second pass
  2A59'   3A 2DA2'              	LDA	SDIRE
  2A5C'   2F                    	CMA
  2A5D'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  2A60'   AF                    	XRA	A
  2A61'   32 2DD5'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  2A64'   C3 2A67'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  2A67'                         SRCHW:
  2A67'   3A 2DA2'              	LDA	SDIRE
  2A6A'   32 0000*              	STA	DIRFLG
  2A6D'   21 FFFF               	LXI	H,0FFFFH
  2A70'   22 2D15'              	SHLD	CMDCNT
  2A73'   AF                    	XRA	A
  2A74'   32 0000*              	STA	AUXCNT
  2A77'                         SW_LP:
  2A77'   CD 0735'              	CALL	BRKQ		; an ESC spent the count, here or on the way to
  2A7A'   D8                    	RC			;   the wrapped pass: SCRLST no longer pages
  2A7B'   CD 2A87'              	CALL	SRCH1
  2A7E'   D0                    	RNC
  2A7F'   CD 0000*              	CALL	SCRLST
  2A82'   D2 2A77'              	JNC	SW_LP
  2A85'   37                    	STC
	MACRO-80 3.44	09-Dec-81	PAGE	1-131


  2A86'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  2A87'                         SRCH1:
  2A87'   11 0000*              	LXI	D,SRCHST
  2A8A'   3A 0000*              	LDA	DIRFLG
  2A8D'   B7                    	ORA	A
  2A8E'   FA 2AB2'              	JM	SR1_BK
  2A91'   21 0000*              	LXI	H,GAPEND
  2A94'   CD 0000*              	CALL	FWDCNT
  2A97'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  2A9A'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  2A9B'   3A 2DD5'              	LDA	SSKIP
  2A9E'   B7                    	ORA	A
  2A9F'   CA 2AA8'              	JZ	SR1_FW
  2AA2'   78                    	MOV	A,B
  2AA3'   B1                    	ORA	C
  2AA4'   37                    	STC
  2AA5'   C8                    	RZ			; no room for a match even before the skip
  2AA6'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2AA7'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2AA8'                         SR1_FW:
  2AA8'   CD 0000*              	CALL	MATCHF
  2AAB'   D8                    	RC
  2AAC'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2AAF'   C3 0000*              	JMP	PUTCUR
  2AB2'                         SR1_BK:
  2AB2'   21 0000*              	LXI	H,TXTBEG
  2AB5'   CD 0000*              	CALL	FWDCNT
  2AB8'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2ABB'   D8                    	RC
  2ABC'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2ABF'   CD 0000*              	CALL	MATCHB
  2AC2'   D8                    	RC
  2AC3'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-132


                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2AC6'                         MSGNAM:
  2AC6'   E5                    	PUSH	H
  2AC7'   3E 22                 	MVI	A,'"'
  2AC9'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  2ACC'   E1                    	POP	H
  2ACD'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  2ACE'   23                    	INX	H
  2ACF'   7E                    	MOV	A,M
  2AD0'   FE 20                 	CPI	' '
  2AD2'   C2 2ADF'              	JNZ	MN_HAS
  2AD5'   21 26F9'              	LXI	H,SNONM
  2AD8'   CD 0000*              	CALL	OUTSTR
  2ADB'   E1                    	POP	H
  2ADC'   C3 2B29'              	JMP	MN_END
  2ADF'                         MN_HAS:
  2ADF'   0E 19                 	MVI	C,BF_CURDSK
  2AE1'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  2AE4'   E1                    	POP	H
  2AE5'   E5                    	PUSH	H
  2AE6'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  2AE7'   BE                    	CMP	M
  2AE8'   CA 2AF6'              	JZ	MN_NAM
  2AEB'   7E                    	MOV	A,M
  2AEC'   C6 40                 	ADI	'A'-1
  2AEE'   CD 0000*              	CALL	OUTCH
  2AF1'   3E 3A                 	MVI	A,':'
  2AF3'   CD 0000*              	CALL	OUTCH
  2AF6'                         MN_NAM:
  2AF6'   E1                    	POP	H
  2AF7'   E5                    	PUSH	H
  2AF8'   23                    	INX	H
  2AF9'   0E 08                 	MVI	C,8
  2AFB'                         MN_NM:
  2AFB'   7E                    	MOV	A,M
  2AFC'   FE 20                 	CPI	' '
  2AFE'   CA 2B09'              	JZ	MN_EXT
  2B01'   CD 0000*              	CALL	OUTCH
  2B04'   23                    	INX	H
  2B05'   0D                    	DCR	C
  2B06'   C2 2AFB'              	JNZ	MN_NM
  2B09'                         MN_EXT:
  2B09'   E1                    	POP	H
  2B0A'   11 0009               	LXI	D,9
  2B0D'   19                    	DAD	D		; the type field
  2B0E'   7E                    	MOV	A,M
  2B0F'   FE 20                 	CPI	' '
  2B11'   CA 2B29'              	JZ	MN_END
  2B14'   3E 2E                 	MVI	A,'.'
  2B16'   CD 0000*              	CALL	OUTCH
  2B19'   0E 03                 	MVI	C,3
	MACRO-80 3.44	09-Dec-81	PAGE	1-133


  2B1B'                         MN_XL:
  2B1B'   7E                    	MOV	A,M
  2B1C'   FE 20                 	CPI	' '
  2B1E'   CA 2B29'              	JZ	MN_END
  2B21'   CD 0000*              	CALL	OUTCH
  2B24'   23                    	INX	H
  2B25'   0D                    	DCR	C
  2B26'   C2 2B1B'              	JNZ	MN_XL
  2B29'                         MN_END:
  2B29'   3E 22                 	MVI	A,'"'
  2B2B'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  2B2E'                         MSGFLG:
  2B2E'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  2B30'   B7                    	ORA	A
  2B31'   CA 2B41'              	JZ	MF_RO
  2B34'   3A 2D18'              	LDA	MODF
  2B37'   B7                    	ORA	A
  2B38'   CA 2B41'              	JZ	MF_RO
  2B3B'   21 2703'              	LXI	H,SMODM
  2B3E'   CD 2B56'              	CALL	MF_PUT
  2B41'                         MF_RO:
  2B41'   3A 2D8E'              	LDA	ROFLAG
  2B44'   B7                    	ORA	A
  2B45'   CA 2B4E'              	JZ	MF_NEW
  2B48'   21 270E'              	LXI	H,SROM
  2B4B'   CD 2B56'              	CALL	MF_PUT
  2B4E'                         MF_NEW:
  2B4E'   3A 2D8C'              	LDA	MSGNEW
  2B51'   B7                    	ORA	A
  2B52'   C8                    	RZ
  2B53'   21 2719'              	LXI	H,SNEWM
  2B56'                         MF_PUT:
  2B56'   78                    	MOV	A,B
  2B57'   B7                    	ORA	A
  2B58'   C2 2B64'              	JNZ	MF_STR
  2B5B'   06 01                 	MVI	B,1
  2B5D'   E5                    	PUSH	H
  2B5E'   3E 20                 	MVI	A,' '
  2B60'   CD 0000*              	CALL	OUTCH
  2B63'   E1                    	POP	H
  2B64'                         MF_STR:
  2B64'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  2B67'                         EMITW:
  2B67'   C5                    	PUSH	B
  2B68'   D5                    	PUSH	D
  2B69'   06 00                 	MVI	B,0
  2B6B'   11 2710               	LXI	D,10000
	MACRO-80 3.44	09-Dec-81	PAGE	1-134


  2B6E'   CD 2B8C'              	CALL	EWDIG
  2B71'   11 03E8               	LXI	D,1000
  2B74'   CD 2B8C'              	CALL	EWDIG
  2B77'   11 0064               	LXI	D,100
  2B7A'   CD 2B8C'              	CALL	EWDIG
  2B7D'   11 000A               	LXI	D,10
  2B80'   CD 2B8C'              	CALL	EWDIG
  2B83'   7D                    	MOV	A,L		; the units digit is always printed
  2B84'   C6 30                 	ADI	'0'
  2B86'   CD 0000*              	CALL	OUTCH
  2B89'   D1                    	POP	D
  2B8A'   C1                    	POP	B
  2B8B'   C9                    	RET
  2B8C'                         EWDIG:
  2B8C'   0E 00                 	MVI	C,0
  2B8E'                         EW_LP:
  2B8E'   7D                    	MOV	A,L
  2B8F'   93                    	SUB	E
  2B90'   6F                    	MOV	L,A
  2B91'   7C                    	MOV	A,H
  2B92'   9A                    	SBB	D
  2B93'   67                    	MOV	H,A
  2B94'   DA 2B9B'              	JC	EW_DN
  2B97'   0C                    	INR	C
  2B98'   C3 2B8E'              	JMP	EW_LP
  2B9B'                         EW_DN:
  2B9B'   19                    	DAD	D		; one subtraction too many: give it back
  2B9C'   79                    	MOV	A,C
  2B9D'   B7                    	ORA	A
  2B9E'   C2 2BA4'              	JNZ	EW_PR
  2BA1'   78                    	MOV	A,B
  2BA2'   B7                    	ORA	A
  2BA3'   C8                    	RZ			; a leading zero: write nothing
  2BA4'                         EW_PR:
  2BA4'   79                    	MOV	A,C
  2BA5'   C6 30                 	ADI	'0'
  2BA7'   CD 0000*              	CALL	OUTCH
  2BAA'   06 01                 	MVI	B,1
  2BAC'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  2BAD'                         ISEMPT:
  2BAD'   2A 0000*              	LHLD	OUTPOS
  2BB0'   7C                    	MOV	A,H
  2BB1'   B5                    	ORA	L
  2BB2'   C0                    	RNZ
  2BB3'   CD 0000*              	CALL	LOGLEN
  2BB6'   7C                    	MOV	A,H
  2BB7'   B5                    	ORA	L
  2BB8'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
	MACRO-80 3.44	09-Dec-81	PAGE	1-135


  2BB9'                         MSGCTG:
  2BB9'   21 0000*              	LXI	H,FNAME
  2BBC'   CD 2AC6'              	CALL	MSGNAM
  2BBF'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  2BC1'   CD 2B2E'              	CALL	MSGFLG
  2BC4'   CD 2BAD'              	CALL	ISEMPT
  2BC7'   C2 2BD0'              	JNZ	MG_POS
  2BCA'   21 272C'              	LXI	H,SNOLIN
  2BCD'   C3 0000*              	JMP	OUTSTR
  2BD0'                         MG_POS:
  2BD0'   21 271F'              	LXI	H,SLINE
  2BD3'   CD 0000*              	CALL	OUTSTR
  2BD6'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  2BD9'   23                    	INX	H		;   ... so the line it is on
  2BDA'   CD 2B67'              	CALL	EMITW
  2BDD'   21 2726'              	LXI	H,SCOLM
  2BE0'   CD 0000*              	CALL	OUTSTR
  2BE3'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  2BE6'   23                    	INX	H
  2BE7'   E5                    	PUSH	H
  2BE8'   CD 2B67'              	CALL	EMITW
  2BEB'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  2BEE'   23                    	INX	H
  2BEF'   D1                    	POP	D
  2BF0'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  2BF3'   C8                    	RZ
  2BF4'   E5                    	PUSH	H
  2BF5'   3E 2D                 	MVI	A,'-'
  2BF7'   CD 0000*              	CALL	OUTCH
  2BFA'   E1                    	POP	H
  2BFB'   C3 2B67'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  2BFE'                         FILMSG:
  2BFE'   3A 0001*              	LDA	FNAME+1
  2C01'   FE 20                 	CPI	' '
  2C03'   C8                    	RZ
  2C04'   21 0000*              	LXI	H,FNAME
  2C07'   CD 2AC6'              	CALL	MSGNAM
  2C0A'   AF                    	XRA	A		; nothing has been changed yet
  2C0B'   C3 2B2E'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  2C0E'                         WRMSG:
  2C0E'   21 0000*              	LXI	H,TFCB
  2C11'   CD 2AC6'              	CALL	MSGNAM
  2C14'   21 273E'              	LXI	H,SWRIT
  2C17'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  2C1A'                         MSGPST:
	MACRO-80 3.44	09-Dec-81	PAGE	1-136


  2C1A'   3A 2D8B'              	LDA	MSGWHT
  2C1D'   B7                    	ORA	A
  2C1E'   C8                    	RZ
  2C1F'   47                    	MOV	B,A
  2C20'   AF                    	XRA	A
  2C21'   32 2D8B'              	STA	MSGWHT
  2C24'   78                    	MOV	A,B
  2C25'   FE 01                 	CPI	MW_FIL
  2C27'   CA 2C43'              	JZ	MP_FIL
  2C2A'   FE 02                 	CPI	MW_WRT
  2C2C'   CA 2C49'              	JZ	MP_WRT
  2C2F'   FE 04                 	CPI	MW_BIG
  2C31'   CA 2C3A'              	JZ	MP_BIG
  2C34'   CD 2BB9'              	CALL	MSGCTG
  2C37'   C3 0000*              	JMP	SCURS
  2C3A'                         MP_BIG:
  2C3A'   21 26DA'              	LXI	H,SQBIG
  2C3D'   CD 0000*              	CALL	EXMSG
  2C40'   C3 0000*              	JMP	SCURS
  2C43'                         MP_FIL:
  2C43'   CD 2BFE'              	CALL	FILMSG
  2C46'   C3 0000*              	JMP	SCURS
  2C49'                         MP_WRT:
  2C49'   CD 2C0E'              	CALL	WRMSG
  2C4C'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  2C4F'                         VC_CTLG:
  2C4F'   3E 03                 	MVI	A,MW_CTG
  2C51'   32 2D8B'              	STA	MSGWHT
  2C54'   3E 01                 	MVI	A,R_MOVE
  2C56'   32 2D19'              	STA	RINTENT
  2C59'   C3 06CB'              	JMP	GETCNT		; a count typed before it is spent here, not
                                				;   left for the next command
                                
  2C5C'                         CMDTAB:
  2C5C'   07                    	DB	07H			; ^G -- where am I?
  2C5D'   2C4F'                 	DW	VC_CTLG
  2C5F'   68                    	DB	'h'
  2C60'   07F9'                 	DW	VC_H
  2C62'   6C                    	DB	'l'
  2C63'   0823'                 	DW	VC_L
  2C65'   6A                    	DB	'j'
  2C66'   08F4'                 	DW	VC_J
  2C68'   6B                    	DB	'k'
  2C69'   0906'                 	DW	VC_K
  2C6B'   30                    	DB	'0'
  2C6C'   0856'                 	DW	VC_0
  2C6E'   5E                    	DB	'^'
  2C6F'   0874'                 	DW	VC_CRT
  2C71'   24                    	DB	'$'
  2C72'   08B2'                 	DW	VC_EOL
  2C74'   0D                    	DB	CR			; <CR> -- down to the first non-blank
  2C75'   08D6'                 	DW	VC_CR
  2C77'   77                    	DB	'w'
