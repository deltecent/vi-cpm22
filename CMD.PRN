  0BB2'   2A 0000*              	LHLD	LNDLT
  0BB5'   7C                    	MOV	A,H
  0BB6'   FE C0                 	CPI	0C0H
  0BB8'   CA 0BBF'              	JZ	LN_X
  0BBB'   2B                    	DCX	H
  0BBC'                         LN_ST:
  0BBC'   22 0000*              	SHLD	LNDLT
  0BBF'                         LN_X:
  0BBF'   E1                    	POP	H
  0BC0'   C9                    	RET
                                
  0BC1'   AF                    VC_E:	XRA	A
  0BC2'   32 26B9'              	STA	WBIG
  0BC5'   C3 0BCD'              	JMP	EDO
  0BC8'   3E 01                 VCBGE:	MVI	A,1
  0BCA'   32 26B9'              	STA	WBIG
  0BCD'   CD 06DF'              EDO:	CALL	SETMOV
  0BD0'   CD 0672'              	CALL	GETCNT
  0BD3'   22 26F1'              	SHLD	CNTV
  0BD6'   2A 26F1'              EDO_LP: LHLD	CNTV
  0BD9'   7C                    	MOV	A,H
