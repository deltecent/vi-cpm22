  0C9A'   EB                    	XCHG
  0C9B'   2A 2A5F'              	LHLD	WKN
  0C9E'   CD 0000*              	CALL	CMP16
  0CA1'   D2 0CEF'              	JNC	ES_LND
  0CA4'   2A 2A5D'              	LHLD	WKI
  0CA7'   CD 0000*              	CALL	CHARAT
