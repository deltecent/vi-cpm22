  27A3'   2B                    	DCX	H
  27A4'   FE 3A                 	CPI	':'
  27A6'   C2 27B8'              	JNZ	PF_NM
  27A9'   CD 27FE'              	CALL	GETFNC
  27AC'   CA 27B8'              	JZ	PF_NM
  27AF'   D6 40                 	SUI	40H
  27B1'   12                    	STAX	D
  27B2'   FE 11                 	CPI	17
  27B4'   D2 27DC'              	JNC	PF_BAD
  27B7'   23                    	INX	H
  27B8'                         PF_NM:
  27B8'   13                    	INX	D
  27B9'   0E 08                 	MVI	C,8
  27BB'   CD 27E0'              	CALL	CPYNAM
  27BE'   FE 2E                 	CPI	'.'
  27C0'   0E 03                 	MVI	C,3
  27C2'   C4 27F3'              	CNZ	PADFLD		; no type: blanks
  27C5'   CC 27DF'              	CZ	CPYNM0		; '.': the type
  27C8'   3A 0001*              	LDA	TFCB+1
  27CB'   FE 20                 	CPI	' '
  27CD'   CA 27DC'              	JZ	PF_BAD		; no name
  27D0'   CD 2831'              	CALL	SKIPB
  27D3'   C0                    	RNZ			; more after it
  27D4'   21 0000*              	LXI	H,TFCB
  27D7'   CD 278E'              	CALL	NRMDRV
  27DA'   AF                    	XRA	A
  27DB'   C9                    	RET
  27DC'                         PF_BAD:
  27DC'   F6 01                 	ORI	1
  27DE'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
