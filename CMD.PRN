  0B83'   B7                    	ORA	A
  0B84'   FA 0B94'              	JM	BK_OK		; the start of the file
  0B87'   CD 0B96'              	CALL	CCLS
  0B8A'   21 2A58'              	LXI	H,WKCLS
  0B8D'   BE                    	CMP	M
  0B8E'   CA 0B80'              	JZ	BK_WLP
  0B91'   CD 0BD0'              	CALL	INCC		; overshot: forward one
  0B94'                         BK_OK:
