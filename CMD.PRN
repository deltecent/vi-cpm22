                                ;============================================================
                                ; DATA
                                ;============================================================
  2A18'   00                    EDMODE: DB	EM_CMD
  2A19'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  2A1B'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  2A1C'   00                    MODF:	DB	0		; 1 = unsaved changes
  2A1D'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  2A1E'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  2A1F'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  2A20'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  2A21'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  2A23'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  2A24'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  2A25'   00                    HFROW:	DB	0		; ^D/^U: the cursor's row before the move
  2A26'   00                    HFAMT:	DB	0		; ^D/^U: lines (vim's 'scroll'); 0 = NEDIT/2
  2A27'   0000                  JKCNT:	DW	0		; j/k: count
  2A29'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  2A2B'   0000                  JKMOV:	DW	0		; j: lines moved
  2A2D'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  2A2F'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  2A30'   00                    JKLST:	DB	0		; j: last byte of the scan
  2A31'   0000                  JKVC:	DW	0		; j/k landing: screen column
  2A33'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  2A35'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  2A36'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  2A37'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  2A38'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  2A39'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  2A3A'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  2A3C'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  2A3D'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  2A3E'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  2A40'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  2A41'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  2A42'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  2A43'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
	MACRO-80 3.44	09-Dec-81	PAGE	1-130


  2A44'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  2A45'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  2A46'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   and its first word is yet to be stepped
  2A47'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  2A49'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  2A4B'   00 00 00              OPSFP:	DB	0,0,0		; operator: the start as a place in the file
  2A4E'   00 00 00              OPSLO:	DB	0,0,0		; ... where its line starts
  2A51'   00 00 00              OPSHI:	DB	0,0,0		; ... where the next line does (OPPGD: the span's
                                				;   high end, whichever line that turned out to be)
  2A54'   00 00 00              OPTOGO: DB	0,0,0		; OPPGD: bytes still to take
  2A57'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  2A59'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  2A5B'   0000                  CNTV:	DW	0		; motion repeat counter
  2A5D'   0000                  TTI:	DW	0		; TAILTAB scan index
  2A5F'   0000                  WKI:	DW	0		; scan index
  2A61'   0000                  WKN:	DW	0		; cached LOGLEN
  2A63'   0000                  WKTERM: DW	0		; line terminator offset
  2A65'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  2A67'   00                    WKCLS:	DB	0		; word motion: class of the current run
  2A68'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  2A69'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  2A6B'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  2A6D'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
  2A6F'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  2A71'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  2A72'   00                    RLMAX:	DB	0		; RDLINE: capacity
  2A73'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  2A74'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  2A75'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  2A76'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  2A78'   00                    WPROW:	DB	0		; :w -- the cursor's row
  2A79'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  2A7A'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2A7C'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  2A7E'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  2A7F'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  2A81'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  2A83'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  2A84'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  2A85'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  2A86'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  2A87'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  2A88'   00                    PLUSF:	DB	0		; command line: '+' was given
  2A89'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  2A8A'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  2A8B'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  2A8C'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  2A8E'   0000                  YPT:	DW	0		; yy: where the lines came from
  2A90'   0000                  PCNT:	DW	0		; p/P: copies still to put
  2A92'   0000                  PPT:	DW	0		; p/P: the first line put
  2A94'   0000                  PLFS:	DW	0		; p/P: the lines in the register
	MACRO-80 3.44	09-Dec-81	PAGE	1-131


  2A96'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  2A97'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  2A99'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  2A9A'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  2A9B'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  2A9C'   00                    FNDKND: DB	0		; f/F/t/T: which find ';' repeats (0 = none yet)
  2A9D'   00                    FNDCH:	DB	0		; ... and the character it looked for
  2A9E'   00                    FNDRUN: DB	0		; the find THIS command is running (',' reverses)
  2A9F'   00                    FNDSTP: DB	0		; how far along it starts: 2 for a 't' repeat
  2AA0'   0000                  FNDN:	DW	0		; occurrences still to count off
  2AA2'   0000                  FNDCUR: DW	0		; the cursor it started from
  2AA4'   0000                  FNDLIM: DW	0		; ... and the end of the line it may not pass
  2AA6'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  2AA7'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  2AAA'   00 00 00              MKEDIT: DB	0,0,0		; MKSHFT: where in the file the edit is
  2AAD'   0000                  MKN:	DW	0		; ... how long it is
  2AAF'   00                    MKTYP:	DB	0		; ... and which way: 1 text went in, 2 came out
  2AB0'   00 00 00              MKPOS:	DB	0,0,0		; MKJMP: the file position being jumped to
  2AB3'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  2AB4'   00                    MKHOLD: DB	0		; set across YKGO's delete + put back (a yank
                                				;   that could not copy): MKSHFT must leave the
                                				;   marks alone through it
  2AB5'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  2AB7'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  2AB9'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  2ABB'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  2ABD'   00 00 00              YPFP:	DB	0,0,0		; ... and where in the file they start
                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  2AC0'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  2AC2'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
  2AC4'   0000                  SCNT:	DW	0		; searches still to do (the count)
  2AC6'   00 00 00              SOFF:	DB	0,0,0		; BRKON: where in the FILE the command began
  2AC9'   0000                  SLDLT:	DW	0		; ... and LNDLT: for a search that fails, and
                                				;   any move a ^C stops
  2ACB'   00                    BRKARM: DB	0		; nonzero: CNTTST looks for a ^C
  2ACC'   00                    BRKHIT: DB	0		; nonzero: one was found, and the count spent
  2ACD'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  2ACE'   00                    SRNGF:	DB	0		; ex: a line range was given
  2ACF'   0000                  SRNG1:	DW	0		; ex: its first line
  2AD1'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  2AD3'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  2AD4'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
	MACRO-80 3.44	09-Dec-81	PAGE	1-132


  2AD5'   00                    SANY:	DB	0		; ':s' something in the range has changed
  2AD6'   00                    SLCHG:	DB	0		; ':s' this line changed
  2AD7'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  2AD9'   0000                  SLINES: DW	0		; ':s' / ':N,Mw' lines of the range still to do
  2ADB'   00                    RWPTR:	DB	0		; ':N,Mw' the next free byte of the record at
                                				;   0080H, as that address's low byte
  2ADC'   00                    RWERR:	DB	0		; ':N,Mw' a record would not go: the disk is full
  2ADD'   00                    RDANY:	DB	0		; ':r' something has been read in
  2ADE'   00                    RDBRK:	DB	0		; ':r' the line above wants a line end first
  2ADF'   00 00 00              SOFFS:	DB	0,0,0		; ':s' the cursor's place in the file, for one that
  2AE2'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  2AE4'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  2AE5'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
