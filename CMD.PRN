  2806'   20 63 68 61           
  280A'   6E 67 65 20           
  280E'   68 61 73 20           
  2812'   70 61 67 65           
  2816'   64 20 6F 75           
  281A'   74 00                 
  281C'   54 6F 6F 20           SUNDB:	DB	'Too large to undo',0
  2820'   6C 61 72 67           
  2824'   65 20 74 6F           
  2828'   20 75 6E 64           
  282C'   6F 00                 
  282E'   54 6F 6F 20           SQBIG:	DB	'Too large to yank',0
  2832'   6C 61 72 67           
  2836'   65 20 74 6F           
  283A'   20 79 61 6E           
  283E'   6B 00                 
