  2954'   0A9F'                 	DW	VC_W
  2956'   62                    	DB	'b'
  2957'   0AF0'                 	DW	VC_B
  2959'   65                    	DB	'e'
  295A'   0C52'                 	DW	VC_E
  295C'   57                    	DB	'W'
  295D'   0AA6'                 	DW	VCBGW
  295F'   42                    	DB	'B'
