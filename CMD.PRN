  0740'   E1                    	POP	H
  0741'   CD 0693'              	CALL	BOL
  0744'   22 0000*              	SHLD	WKBOL
  0747'   2A 0000*              	LHLD	WKTERM
  074A'   EB                    	XCHG			; DE = term
  074B'   2A 0000*              	LHLD	WKBOL
  074E'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  0751'   CA 0770'              	JZ	EOLC_MT
  0754'   EB                    	XCHG			; HL = term
  0755'   2B                    	DCX	H		; term-1
  0756'   E5                    	PUSH	H
