  0C13'   2A 24E9'              	LHLD	WKN
  0C16'   CD 0000*              	CALL	CMP16		; DE=(i+1) vs HL=n: CY iff (i+1) < n
  0C19'   D2 0C36'              	JNC	ES_LND
  0C1C'   2A 24E7'              	LHLD	WKI
  0C1F'   23                    	INX	H
