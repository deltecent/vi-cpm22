                                ;============================================================
                                ; DATA
                                ;============================================================
  2D7A'   00                    EDMODE: DB	EM_CMD
  2D7B'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  2D7D'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  2D7E'   00                    MODF:	DB	0		; 1 = unsaved changes
  2D7F'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  2D80'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  2D81'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  2D82'   01                    DCHN:	DB	1		; the cells an R_DCH paint deletes (SCRN.MAC reads)
  2D83'   00                    DCHBS:	DB	0		; 1 = they went left of the cursor (insert's BS)
  2D84'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  2D85'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  2D87'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  2D88'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  2D89'   00                    HFAMT:	DB	0		; ^D/^U: rows (vim's 'scroll'); 0 = NEDIT/2
  2D8A'   00                    HFN:	DB	0		; ^D/^U: the rows this one goes
  2D8B'   0000                  HFTP:	DW	0		; ^D/^U: -> the new top line's entry
  2D8D'   00                    HTN:	DB	0		; row table: its entries
  2D8E'   00                    HTCUR:	DB	0		; ... the cursor line's
  2D8F'   00                    HTTP:	DB	0		; ... the top line's
  2D90'   00                    HTEOF:	DB	0		; ... 1 = its last is the file's last line
  2D91'   00                    HTBOF:	DB	0		; ... 1 = its first is the file's first
  2D92'   0000                  RWR:	DW	0		; ^F/^B: rows still to go
  2D94'   00                    RWMV:	DB	0		; ^F/^B: 1 = the table was made again on the way
  2D95'   00                    OVDIR:	DB	0		; OVLAP: 0 = h2.. are above h1 in the table
  2D96'   0000                  JKCNT:	DW	0		; j/k: count
  2D98'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  2D9A'   0000                  JKMOV:	DW	0		; j: lines moved
  2D9C'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  2D9E'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  2D9F'   00                    JKLST:	DB	0		; j: last byte of the scan
  2DA0'   0000                  JKVC:	DW	0		; j/k landing: screen column
  2DA2'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  2DA4'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  2DA5'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  2DA6'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  2DA7'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  2DA8'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  2DA9'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  2DAB'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  2DAC'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  2DAD'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
	MACRO-80 3.44	09-Dec-81	PAGE	1-141


                                
  2DAF'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  2DB0'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  2DB1'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  2DB2'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
  2DB3'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  2DB4'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  2DB5'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   and its first word is yet to be stepped
  2DB6'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  2DB8'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  2DBA'   00 00 00              OPSFP:	DB	0,0,0		; operator: the start as a place in the file
  2DBD'   00 00 00              OPSLO:	DB	0,0,0		; ... where its line starts
  2DC0'   00 00 00              OPSHI:	DB	0,0,0		; ... where the next line does (OPPGD: the span's
                                				;   high end, whichever line that turned out to be)
  2DC3'   00 00 00              OPTOGO: DB	0,0,0		; OPPGD: bytes still to take
  2DC6'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  2DC8'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  2DCA'   0000                  CNTV:	DW	0		; motion repeat counter
  2DCC'   0000                  TTI:	DW	0		; TAILTAB scan index
  2DCE'   0000                  WKI:	DW	0		; scan index
  2DD0'   0000                  WKN:	DW	0		; cached LOGLEN
  2DD2'   0000                  WKTERM: DW	0		; line terminator offset
  2DD4'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  2DD6'   00                    WKCLS:	DB	0		; word motion: class of the current run
  2DD7'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  2DD8'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  2DDA'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  2DDC'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
  2DDE'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  2DE0'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  2DE1'   00                    RLMAX:	DB	0		; RDLINE: capacity
  2DE2'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  2DE3'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  2DE4'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  2DE5'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  2DE7'   00                    WPROW:	DB	0		; :w -- the cursor's row
  2DE8'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  2DE9'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2DEB'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  2DED'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  2DEE'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  2DF0'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  2DF2'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  2DF3'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  2DF4'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  2DF5'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  2DF6'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  2DF7'   00                    PLUSF:	DB	0		; command line: '+' was given
  2DF8'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  2DF9'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  2DFA'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
	MACRO-80 3.44	09-Dec-81	PAGE	1-142


  2DFB'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  2DFD'   0000                  YPT:	DW	0		; yy: where the lines came from
  2DFF'   0000                  PCNT:	DW	0		; p/P: copies still to put
  2E01'   00 00 00              PPFP:	DB	0,0,0		; p/P: the first line put, a file position
  2E04'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  2E06'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  2E07'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  2E09'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  2E0A'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  2E0B'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  2E0C'   00                    FNDKND: DB	0		; f/F/t/T: which find ';' repeats (0 = none yet)
  2E0D'   00                    FNDCH:	DB	0		; ... and the character it looked for
  2E0E'   00                    FNDRUN: DB	0		; the find THIS command is running (',' reverses)
  2E0F'   00                    FNDSTP: DB	0		; how far along it starts: 2 for a 't' repeat
  2E10'   0000                  FNDN:	DW	0		; occurrences still to count off
  2E12'   0000                  FNDCUR: DW	0		; the cursor it started from
  2E14'   0000                  FNDLIM: DW	0		; ... and the end of the line it may not pass
  2E16'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  2E17'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  2E1A'   00 00 00              MKEDIT: DB	0,0,0		; MKSHFT: where in the file the edit is
  2E1D'   0000                  MKN:	DW	0		; ... how long it is
  2E1F'   00                    MKTYP:	DB	0		; ... and which way: 1 text went in, 2 came out
  2E20'   00 00 00              MKPOS:	DB	0,0,0		; MKJMP: the file position being jumped to
  2E23'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  2E24'   00                    MKHOLD: DB	0		; set across YKGO's delete + put back (a yank
                                				;   that could not copy): MKSHFT must leave the
                                				;   marks alone through it
  2E25'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  2E27'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  2E29'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  2E2B'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  2E2D'   00 00 00              YPFP:	DB	0,0,0		; ... and where in the file they start
                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  2E30'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  2E32'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
  2E34'   0000                  SCNT:	DW	0		; searches still to do (the count)
  2E36'   00 00 00              SOFF:	DB	0,0,0		; BRKON: where in the FILE the command began
  2E39'   0000                  SLDLT:	DW	0		; ... and LNDLT: for a search that fails, and
                                				;   any move an ESC stops
  2E3B'   00                    BRKARM: DB	0		; nonzero: CNTTST looks for an ESC
  2E3C'   00                    BRKHIT: DB	0		; nonzero: one was found, and the count spent
  2E3D'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
	MACRO-80 3.44	09-Dec-81	PAGE	1-143


  2E3E'   00                    SRNGF:	DB	0		; ex: a line range was given
  2E3F'   0000                  SRNG1:	DW	0		; ex: its first line
  2E41'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  2E43'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  2E44'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  2E45'   00                    SANY:	DB	0		; ':s' something in the range has changed
  2E46'   00                    SLCHG:	DB	0		; ':s' this line changed
  2E47'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  2E49'   0000                  SLINES: DW	0		; ':s' / ':N,Mw' lines of the range still to do
  2E4B'   00                    RWPTR:	DB	0		; ':N,Mw' the next free byte of the record at
                                				;   0080H, as that address's low byte
  2E4C'   00                    RWERR:	DB	0		; ':N,Mw' a record would not go: the disk is full
  2E4D'   00                    RDANY:	DB	0		; ':r' something has been read in
  2E4E'   00                    RDBRK:	DB	0		; ':r' the line above wants a line end first
  2E4F'   00 00 00              SOFFS:	DB	0,0,0		; ':s' the cursor's place in the file, for one that
  2E52'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  2E54'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  2E55'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
