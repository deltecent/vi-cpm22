  2C90'   17CE'                 	DW	VC_X
  2C92'   5A                    	DB	'Z'
  2C93'   1F6D'                 	DW	VC_BZ
  2C95'   66                    	DB	'f'
  2C96'   021A'                 	DW	VC_FF
  2C98'   46                    	DB	'F'
  2C99'   021F'                 	DW	VC_FB
