  0A1A'   32 2424'              	STA	WKCLS		; back to the start of this word
  0A1D'                         BK_WLP:
  0A1D'   CD 0AAF'              	CALL	DECC
  0A20'   B7                    	ORA	A
  0A21'   FA 0A31'              	JM	BK_OK		; the start of the file
  0A24'   CD 0A33'              	CALL	CCLS
  0A27'   21 2424'              	LXI	H,WKCLS
  0A2A'   BE                    	CMP	M
  0A2B'   CA 0A1D'              	JZ	BK_WLP
  0A2E'   CD 0A6D'              	CALL	INCC		; overshot: forward one
  0A31'                         BK_OK:
  0A31'   AF                    	XRA	A
  0A32'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0A33'                         CCLS:
  0A33'   CD 08B7'              	CALL	ATEOF
  0A36'   D2 05C2'              	JNC	CLASSF
  0A39'   AF                    	XRA	A
  0A3A'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0A3B'                         EMPTY:
  0A3B'   CD 08B7'              	CALL	ATEOF
  0A3E'   DA 0A49'              	JC	EM_ST
  0A41'   FE 0D                 	CPI	CR
  0A43'   CA 0A49'              	JZ	EM_ST
  0A46'   FE 0A                 	CPI	LF
  0A48'   C0                    	RNZ
  0A49'                         EM_ST:
  0A49'   CD 0000*              	CALL	PEEKL
  0A4C'   DA 0A52'              	JC	EM_Y
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0A4F'   FE 0A                 	CPI	LF
  0A51'   C9                    	RET
  0A52'                         EM_Y:
  0A52'   AF                    	XRA	A
  0A53'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0A54'                         NXLN:
  0A54'   FE 0A                 	CPI	LF
  0A56'   CA 0A65'              	JZ	NX_LF
  0A59'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0A5C'   D8                    	RC
  0A5D'   FE 0A                 	CPI	LF
  0A5F'   CA 0A65'              	JZ	NX_LF
  0A62'   2B                    	DCX	H		; a lone CR
  0A63'   AF                    	XRA	A
  0A64'   C9                    	RET
  0A65'                         NX_LF:
