  29C9'   086E'                 	DW	VC_CRT
  29CB'   24                    	DB	'$'
  29CC'   08AC'                 	DW	VC_EOL
  29CE'   0D                    	DB	CR			; <CR> -- down to the first non-blank
  29CF'   08D0'                 	DW	VC_CR
  29D1'   77                    	DB	'w'
  29D2'   0ADF'                 	DW	VC_W
  29D4'   62                    	DB	'b'
  29D5'   0B30'                 	DW	VC_B
  29D7'   65                    	DB	'e'
  29D8'   0CC6'                 	DW	VC_E
