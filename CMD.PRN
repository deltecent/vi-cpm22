  108C'   19                    	DAD	D
  108D'   DA 1095'              	JC	MS_SAT
  1090'   3D                    	DCR	A
  1091'   C2 108C'              	JNZ	MS_LP
  1094'   C9                    	RET
  1095'                         MS_SAT:
  1095'   21 FFFF               	LXI	H,0FFFFH
  1098'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': the text and the cursor down HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text goes
                                ; no farther than brings the last row of the file to the bottom row; the line
                                ; that many rows down becomes the top line -- from its first row, vim never
                                ; showing part of one, and the cursor moves as many rows less (more, where
                                ; the top line alone was taller than that and the text had to go past it).
                                ; On the last line nothing moves, the column included.
  1099'                         VC_HFDN:
  1099'   CD 0855'              	CALL	SETMOV
  109C'   CD 12DE'              	CALL	HFCNT		; HFN = the rows
  109F'   3A 0000*              	LDA	TALLF
  10A2'   B7                    	ORA	A
  10A3'   C2 1139'              	JNZ	VHD_TL
  10A6'   CD 0EC2'              	CALL	CURRW
  10A9'   47                    	MOV	B,A
  10AA'   3A 0000*              	LDA	SCEOF
  10AD'   B7                    	ORA	A
  10AE'   CA 10B6'              	JZ	VHD_GO
  10B1'   3A 0000*              	LDA	SCBOT		; the last line's place
  10B4'   B8                    	CMP	B
  10B5'   C8                    	RZ			; the cursor is on it
  10B6'                         VHD_GO:
  10B6'   3A 0000*              	LDA	NEDIT
  10B9'   21 0000*              	LXI	H,HFN
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  10BC'   86                    	ADD	M
  10BD'   3C                    	INR	A
  10BE'   4F                    	MOV	C,A
  10BF'   AF                    	XRA	A
  10C0'   CD 11BB'              	CALL	HTSET		; HL -> the top line's rows
  10C3'   3A 0000*              	LDA	HFN
  10C6'   57                    	MOV	D,A		; D = the rows the text moves
  10C7'   5F                    	MOV	E,A		; E = the rows the cursor moves
  10C8'   3A 0000*              	LDA	HTEOF
  10CB'   B7                    	ORA	A
  10CC'   CA 10EB'              	JZ	VHD_1
  10CF'   E5                    	PUSH	H
  10D0'   C5                    	PUSH	B
  10D1'   0E FF                 	MVI	C,255
  10D3'   CD 11FA'              	CALL	HTFQ		; (runs off: C = 255 - the rows to the file's end)
  10D6'   3A 0000*              	LDA	NEDIT
  10D9'   81                    	ADD	C
  10DA'   2F                    	CMA			; A = those rows - NEDIT: the rows off the screen
  10DB'   C1                    	POP	B
  10DC'   E1                    	POP	H
