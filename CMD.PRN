  0A72'   2A 29A6'              	LHLD	JKLS		; past the line's end: its last content char
  0A75'   7C                    	MOV	A,H
  0A76'   A5                    	ANA	L
  0A77'   3C                    	INR	A
  0A78'   C2 0A7C'              	JNZ	JL_LS
  0A7B'   23                    	INX	H		; no content: the line's start
  0A7C'                         JL_LS:
  0A7C'   EB                    	XCHG
  0A7D'                         JL_GO:
  0A7D'   D5                    	PUSH	D		; DE = step from the line start
  0A7E'   CD 0000*              	CALL	CUROFF
  0A81'   D1                    	POP	D
  0A82'   19                    	DAD	D
  0A83'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0A86'   AF                    VC_W:	XRA	A
  0A87'   32 2996'              	STA	WBIG
  0A8A'   C3 0A92'              	JMP	WDO
  0A8D'   3E 01                 VCBGW:	MVI	A,1
  0A8F'   32 2996'              	STA	WBIG
  0A92'   CD 075A'              WDO:	CALL	SETMOV
  0A95'   AF                    	XRA	A
  0A96'   32 2997'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0A99'   CD 068B'              	CALL	GETCNT
  0A9C'   22 29CE'              	SHLD	CNTV
  0A9F'   2A 29CE'              WDO_LP: LHLD	CNTV
  0AA2'   7C                    	MOV	A,H
  0AA3'   B5                    	ORA	L
  0AA4'   CA 0AB1'              	JZ	WDO_DN
  0AA7'   2B                    	DCX	H
  0AA8'   22 29CE'              	SHLD	CNTV
  0AAB'   CD 0B01'              	CALL	FWD1
  0AAE'   D2 0A9F'              	JNC	WDO_LP
  0AB1'                         WDO_DN:
  0AB1'   CD 0A04'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0AB4'   DA 0AC1'              	JC	WDO_NL
  0AB7'   FE 0D                 	CPI	CR
  0AB9'   CA 0AC1'              	JZ	WDO_NL
  0ABC'   FE 0A                 	CPI	LF
  0ABE'   C2 057D'              	JNZ	SETGL
  0AC1'                         WDO_NL:
  0AC1'   CD 0000*              	CALL	PEEKL
  0AC4'   DA 057D'              	JC	SETGL
  0AC7'   FE 0A                 	CPI	LF
  0AC9'   CA 057D'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0ACC'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0ACE'   32 2997'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0AD1'   CD 0BFC'              	CALL	DECC		; back onto its last char
  0AD4'   C3 057D'              	JMP	SETGL
                                
  0AD7'   AF                    VC_B:	XRA	A
  0AD8'   32 2996'              	STA	WBIG
  0ADB'   C3 0AE3'              	JMP	BDO
  0ADE'   3E 01                 VCBGB:	MVI	A,1
  0AE0'   32 2996'              	STA	WBIG
  0AE3'   CD 075A'              BDO:	CALL	SETMOV
  0AE6'   CD 068B'              	CALL	GETCNT
  0AE9'   22 29CE'              	SHLD	CNTV
  0AEC'   2A 29CE'              BDO_LP: LHLD	CNTV
  0AEF'   7C                    	MOV	A,H
  0AF0'   B5                    	ORA	L
  0AF1'   CA 057D'              	JZ	SETGL
  0AF4'   2B                    	DCX	H
  0AF5'   22 29CE'              	SHLD	CNTV
  0AF8'   CD 0B4D'              	CALL	BCK1
  0AFB'   D2 0AEC'              	JNC	BDO_LP
  0AFE'   C3 057D'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char (it is left there).
  0B01'                         FWD1:
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0B01'   CD 0B80'              	CALL	CCLS
  0B04'   32 29DA'              	STA	WKCLS		; the starting class
  0B07'   CD 0BBA'              	CALL	INCC
  0B0A'   B7                    	ORA	A
  0B0B'   CA 0B23'              	JZ	FW_WD
  0B0E'   37                    	STC
  0B0F'   F8                    	RM			; -1: already at the end
  0B10'   FE 02                 	CPI	2
  0B12'   C2 0B23'              	JNZ	FW_WD		; 1: a next line was reached
  0B15'   CD 0A04'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0B18'   D4 0BA1'              	CNC	NXLN
  0B1B'   D2 0B23'              	JNC	FW_WD
  0B1E'   CD 0BFC'              	CALL	DECC		; yes: back onto its last char, failed
  0B21'   37                    	STC
  0B22'   C9                    	RET
  0B23'                         FW_WD:
  0B23'   3A 29DA'              	LDA	WKCLS		; go past the rest of this word
  0B26'   B7                    	ORA	A
  0B27'   CA 0B3C'              	JZ	FW_WS
  0B2A'                         FW_WLP:
  0B2A'   CD 0B80'              	CALL	CCLS
  0B2D'   21 29DA'              	LXI	H,WKCLS
  0B30'   BE                    	CMP	M
  0B31'   C2 0B3C'              	JNZ	FW_WS
  0B34'   CD 0BBA'              	CALL	INCC
  0B37'   B7                    	ORA	A
  0B38'   F8                    	RM			; the end of the file (NC)
  0B39'   C3 0B2A'              	JMP	FW_WLP
  0B3C'                         FW_WS:
  0B3C'   CD 0B80'              	CALL	CCLS		; then over blanks to the next word
  0B3F'   B7                    	ORA	A
  0B40'   C0                    	RNZ
  0B41'   CD 0B88'              	CALL	EMPTY
  0B44'   C8                    	RZ			; an empty line is a word
  0B45'   CD 0BBA'              	CALL	INCC
  0B48'   B7                    	ORA	A
  0B49'   F8                    	RM
  0B4A'   C3 0B3C'              	JMP	FW_WS
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0B4D'                         BCK1:
  0B4D'   CD 0BFC'              	CALL	DECC
  0B50'   B7                    	ORA	A
  0B51'   37                    	STC
  0B52'   F8                    	RM
  0B53'                         BK_WS:
  0B53'   CD 0B80'              	CALL	CCLS		; back over blanks
  0B56'   B7                    	ORA	A
  0B57'   C2 0B67'              	JNZ	BK_WD
  0B5A'   CD 0B88'              	CALL	EMPTY
  0B5D'   C8                    	RZ			; an empty line is a word
  0B5E'   CD 0BFC'              	CALL	DECC
  0B61'   B7                    	ORA	A
  0B62'   F2 0B53'              	JP	BK_WS
  0B65'   AF                    	XRA	A		; the start of the file (NC)
  0B66'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0B67'                         BK_WD:
  0B67'   32 29DA'              	STA	WKCLS		; back to the start of this word
  0B6A'                         BK_WLP:
  0B6A'   CD 0BFC'              	CALL	DECC
  0B6D'   B7                    	ORA	A
  0B6E'   FA 0B7E'              	JM	BK_OK		; the start of the file
  0B71'   CD 0B80'              	CALL	CCLS
  0B74'   21 29DA'              	LXI	H,WKCLS
  0B77'   BE                    	CMP	M
  0B78'   CA 0B6A'              	JZ	BK_WLP
  0B7B'   CD 0BBA'              	CALL	INCC		; overshot: forward one
  0B7E'                         BK_OK:
  0B7E'   AF                    	XRA	A
  0B7F'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0B80'                         CCLS:
  0B80'   CD 0A04'              	CALL	ATEOF
  0B83'   D2 070F'              	JNC	CLASSF
  0B86'   AF                    	XRA	A
  0B87'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0B88'                         EMPTY:
  0B88'   CD 0A04'              	CALL	ATEOF
  0B8B'   DA 0B96'              	JC	EM_ST
  0B8E'   FE 0D                 	CPI	CR
  0B90'   CA 0B96'              	JZ	EM_ST
  0B93'   FE 0A                 	CPI	LF
  0B95'   C0                    	RNZ
  0B96'                         EM_ST:
  0B96'   CD 0000*              	CALL	PEEKL
  0B99'   DA 0B9F'              	JC	EM_Y
  0B9C'   FE 0A                 	CPI	LF
  0B9E'   C9                    	RET
  0B9F'                         EM_Y:
  0B9F'   AF                    	XRA	A
  0BA0'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0BA1'                         NXLN:
  0BA1'   FE 0A                 	CPI	LF
  0BA3'   CA 0BB2'              	JZ	NX_LF
  0BA6'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0BA9'   D8                    	RC
  0BAA'   FE 0A                 	CPI	LF
  0BAC'   CA 0BB2'              	JZ	NX_LF
  0BAF'   2B                    	DCX	H		; a lone CR
  0BB0'   AF                    	XRA	A
  0BB1'   C9                    	RET
  0BB2'                         NX_LF:
  0BB2'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0BB5'   D8                    	RC
  0BB6'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0BB7'   3E 01                 	MVI	A,1
  0BB9'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0BBA'                         INCC:
  0BBA'   CD 0A04'              	CALL	ATEOF
  0BBD'   DA 0BF8'              	JC	IC_END
  0BC0'   FE 0D                 	CPI	CR
  0BC2'   CA 0BE3'              	JZ	IC_NL
  0BC5'   FE 0A                 	CPI	LF
  0BC7'   CA 0BE3'              	JZ	IC_NL
  0BCA'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0BCD'                         IC_CH:
  0BCD'   CD 0A04'              	CALL	ATEOF
  0BD0'   DA 0BDF'              	JC	IC_2
  0BD3'   FE 0D                 	CPI	CR
  0BD5'   CA 0BDF'              	JZ	IC_2
  0BD8'   FE 0A                 	CPI	LF
  0BDA'   CA 0BDF'              	JZ	IC_2
  0BDD'   AF                    	XRA	A
  0BDE'   C9                    	RET
  0BDF'                         IC_2:
  0BDF'   3E 02                 	MVI	A,2
  0BE1'   B7                    	ORA	A
  0BE2'   C9                    	RET
  0BE3'                         IC_NL:
  0BE3'   CD 0BA1'              	CALL	NXLN
  0BE6'   DA 0BF8'              	JC	IC_END
  0BE9'   F5                    	PUSH	PSW
  0BEA'   CD 0000*              	CALL	PUTCUR
  0BED'   F1                    	POP	PSW
  0BEE'   B7                    	ORA	A
  0BEF'   CA 0BCD'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0BF2'   CD 0C1E'              	CALL	LNINC
  0BF5'   3E 01                 	MVI	A,1
  0BF7'   C9                    	RET
  0BF8'                         IC_END:
  0BF8'   3E FF                 	MVI	A,0FFH
  0BFA'   B7                    	ORA	A
  0BFB'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0BFC'                         DECC:
  0BFC'   CD 0000*              	CALL	PEEKL
  0BFF'   DA 0BF8'              	JC	IC_END
  0C02'   F5                    	PUSH	PSW
  0C03'   CD 0000*              	CALL	PUTCUR
  0C06'   F1                    	POP	PSW
  0C07'   FE 0A                 	CPI	LF
  0C09'   3E 00                 	MVI	A,0
  0C0B'   C0                    	RNZ
  0C0C'   CD 0C2C'              	CALL	LNDEC
  0C0F'   CD 0000*              	CALL	PEEKL		; onto its CR
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0C12'   DA 0C1A'              	JC	DC_1
  0C15'   FE 0D                 	CPI	CR
  0C17'   CC 0000*              	CZ	PUTCUR
  0C1A'                         DC_1:
  0C1A'   3E 01                 	MVI	A,1
  0C1C'   B7                    	ORA	A
  0C1D'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0C1E'                         LNINC:
  0C1E'   E5                    	PUSH	H
  0C1F'   2A 0000*              	LHLD	LNDLT
  0C22'   7C                    	MOV	A,H
  0C23'   FE 40                 	CPI	40H
  0C25'   CA 0C3A'              	JZ	LN_X
  0C28'   23                    	INX	H
  0C29'   C3 0C37'              	JMP	LN_ST
  0C2C'                         LNDEC:
  0C2C'   E5                    	PUSH	H
  0C2D'   2A 0000*              	LHLD	LNDLT
  0C30'   7C                    	MOV	A,H
  0C31'   FE C0                 	CPI	0C0H
  0C33'   CA 0C3A'              	JZ	LN_X
  0C36'   2B                    	DCX	H
  0C37'                         LN_ST:
  0C37'   22 0000*              	SHLD	LNDLT
  0C3A'                         LN_X:
  0C3A'   E1                    	POP	H
  0C3B'   C9                    	RET
                                
  0C3C'   AF                    VC_E:	XRA	A
  0C3D'   32 2996'              	STA	WBIG
  0C40'   C3 0C48'              	JMP	EDO
  0C43'   3E 01                 VCBGE:	MVI	A,1
  0C45'   32 2996'              	STA	WBIG
  0C48'   CD 075A'              EDO:	CALL	SETMOV
  0C4B'   CD 068B'              	CALL	GETCNT
  0C4E'   22 29CE'              	SHLD	CNTV
  0C51'   2A 29CE'              EDO_LP: LHLD	CNTV
  0C54'   7C                    	MOV	A,H
  0C55'   B5                    	ORA	L
  0C56'   C8                    	RZ
  0C57'   2B                    	DCX	H
  0C58'   22 29CE'              	SHLD	CNTV
  0C5B'   CD 0C61'              	CALL	ESTEP
  0C5E'   C3 0C51'              	JMP	EDO_LP
                                
