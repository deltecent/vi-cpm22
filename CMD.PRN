  1035'   3A 0000*              	LDA	NEDIT
  1038'   81                    	ADD	C
  1039'   2F                    	CMA			; A = those rows - NEDIT: the rows off the screen
  103A'   C1                    	POP	B
  103B'   E1                    	POP	H
  103C'   B7                    	ORA	A
  103D'   FA 1048'              	JM	VHD_0		; none
  1040'   BA                    	CMP	D
