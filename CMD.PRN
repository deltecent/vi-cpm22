  294A'   5E                    	DB	'^'
  294B'   082E'                 	DW	VC_CRT
  294D'   24                    	DB	'$'
  294E'   086C'                 	DW	VC_EOL
  2950'   0D                    	DB	CR			; <CR> -- down to the first non-blank
  2951'   0890'                 	DW	VC_CR
