  28CB'   04                    	DB	04H			; ^D -- half page down
  28CC'   0D84'                 	DW	VC_HFDN
  28CE'   15                    	DB	15H			; ^U -- half page up
  28CF'   0DB8'                 	DW	VC_HFUP
  28D1'   0C                    	DB	0CH			; ^L -- redraw
  28D2'   0E2C'                 	DW	VC_REDR
  28D4'   2E                    	DB	'.'			; '.' -- repeat the last change
  28D5'   0191'                 	DW	VC_DOT
  28D7'   75                    	DB	'u'			; 'u' -- undo (and undo the undo)
  28D8'   0500'                 	DW	VC_UNDO
  28DA'   6D                    	DB	'm'		; m{a-c} -- set a mark
  28DB'   0350'                 	DW	VC_MK
  28DD'   60                    	DB	60H		; `{a-c} -- back to its exact spot
  28DE'   0355'                 	DW	VC_BQ
  28E0'   27                    	DB	27H		; '{a-c} -- back to its line's first non-blank
  28E1'   035A'                 	DW	VC_AQ
  28E3'   00                    	DB	0
                                
