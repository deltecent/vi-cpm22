  109F'   CD 0EBB'              	CALL	CURRW
  10A2'   47                    	MOV	B,A
  10A3'   3A 0000*              	LDA	SCEOF
  10A6'   B7                    	ORA	A
  10A7'   CA 10AF'              	JZ	VHD_GO
  10AA'   3A 0000*              	LDA	SCBOT		; the last line's place
  10AD'   B8                    	CMP	B
  10AE'   C8                    	RZ			; the cursor is on it
  10AF'                         VHD_GO:
  10AF'   3A 0000*              	LDA	NEDIT
  10B2'   21 2F13'              	LXI	H,HFN
  10B5'   86                    	ADD	M
  10B6'   3C                    	INR	A
  10B7'   4F                    	MOV	C,A
  10B8'   AF                    	XRA	A
