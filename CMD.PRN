  1E9D'   77                    	MOV	M,A
  1E9E'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  1E9F'                         PARSFN:
  1E9F'   CD 1DAB'              	CALL	TFCLR
  1EA2'   11 0000*              	LXI	D,TFCB
  1EA5'   23                    	INX	H
  1EA6'   7E                    	MOV	A,M
  1EA7'   2B                    	DCX	H
  1EA8'   FE 3A                 	CPI	':'
  1EAA'   C2 1EBC'              	JNZ	PF_NM
  1EAD'   CD 1F02'              	CALL	GETFNC
  1EB0'   CA 1EBC'              	JZ	PF_NM
  1EB3'   D6 40                 	SUI	40H
  1EB5'   12                    	STAX	D
  1EB6'   FE 11                 	CPI	17
  1EB8'   D2 1EE0'              	JNC	PF_BAD
  1EBB'   23                    	INX	H
  1EBC'                         PF_NM:
  1EBC'   13                    	INX	D
  1EBD'   0E 08                 	MVI	C,8
  1EBF'   CD 1EE4'              	CALL	CPYNAM
  1EC2'   FE 2E                 	CPI	'.'
  1EC4'   0E 03                 	MVI	C,3
  1EC6'   C4 1EF7'              	CNZ	PADFLD		; no type: blanks
  1EC9'   CC 1EE3'              	CZ	CPYNM0		; '.': the type
  1ECC'   3A 0001*              	LDA	TFCB+1
  1ECF'   FE 20                 	CPI	' '
  1ED1'   CA 1EE0'              	JZ	PF_BAD		; no name
  1ED4'   CD 1F35'              	CALL	SKIPB
  1ED7'   C0                    	RNZ			; more after it
  1ED8'   21 0000*              	LXI	H,TFCB
  1EDB'   CD 1E92'              	CALL	NRMDRV
  1EDE'   AF                    	XRA	A
  1EDF'   C9                    	RET
  1EE0'                         PF_BAD:
  1EE0'   F6 01                 	ORI	1
  1EE2'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  1EE3'                         CPYNM0:
  1EE3'   23                    	INX	H
  1EE4'                         CPYNAM:
