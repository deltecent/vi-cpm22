  11B1'   4B                    	MOV	C,E
  11B2'   3A 0000*              	LDA	HTCUR
  11B5'   CD 11F4'              	CALL	HTPT		; HL -> the cursor line's rows, E = lines above it
  11B8'   3A 0000*              	LDA	CSUB
  11BB'   57                    	MOV	D,A
  11BC'   79                    	MOV	A,C
  11BD'   92                    	SUB	D		; the rows to go, less those of its own line above it
  11BE'   DA 1135'              	JC	HFEND
  11C1'   CA 1135'              	JZ	HFEND
  11C4'   4F                    	MOV	C,A
  11C5'   43                    	MOV	B,E
  11C6'   CD 1223'              	CALL	HTBQ		; (off the top: the file's first line)
  11C9'   C3 1135'              	JMP	HFEND
                                
                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
                                ;HTSCR -- the table as the last layout left it, which is the screen's own:
                                ; HL, B and E as HTSET gives them, and nothing measured.
  11CC'                         HTSCR:
  11CC'   CD 0EDA'              	CALL	CURRW
  11CF'   47                    	MOV	B,A
  11D0'   C3 11DE'              	JMP	HS_TP
  11D3'                         HTSET:
  11D3'   47                    	MOV	B,A
  11D4'   CD 0EDA'              	CALL	CURRW		; (keeps BC)
  11D7'   F5                    	PUSH	PSW
  11D8'   80                    	ADD	B
  11D9'   47                    	MOV	B,A
  11DA'   CD 11E8'              	CALL	HTRB
  11DD'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  11DE'                         HS_TP:
  11DE'   3A 0000*              	LDA	HTCUR
  11E1'   90                    	SUB	B
  11E2'   32 0000*              	STA	HTTP
  11E5'   C3 11F4'              	JMP	HTPT
  11E8'                         HTRB:
  11E8'   CD 13DB'              	CALL	ZSAVE
  11EB'   CD 0000*              	CALL	HTBLD
  11EE'   CD 13EE'              	CALL	ZREST
  11F1'   3A 0000*              	LDA	HTCUR
  11F4'                         HTPT:
  11F4'   5F                    	MOV	E,A
  11F5'   16 00                 	MVI	D,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  11F7'   21 0000*              	LXI	H,HTAB
  11FA'   19                    	DAD	D
  11FB'   3A 0000*              	LDA	HTN
  11FE'   93                    	SUB	E
  11FF'   47                    	MOV	B,A
  1200'   C9                    	RET
                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  1201'                         HTIX:
  1201'   11 0000*              	LXI	D,HTAB
  1204'   7D                    	MOV	A,L
  1205'   93                    	SUB	E
  1206'   C9                    	RET
                                
                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
  1207'                         HTGO:
  1207'   CD 1201'              	CALL	HTIX
  120A'   47                    	MOV	B,A
  120B'   3A 0000*              	LDA	HTCUR
  120E'   90                    	SUB	B		; A = the lines up to it
  120F'   C3 0F11'              	JMP	MR_GO
                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  1212'                         HTFQ:
  1212'   78                    	MOV	A,B
  1213'   B7                    	ORA	A
  1214'   37                    	STC
  1215'   C8                    	RZ
  1216'   79                    	MOV	A,C
  1217'   96                    	SUB	M
  1218'   DA 1221'              	JC	HF_IN
  121B'   4F                    	MOV	C,A
  121C'   23                    	INX	H
  121D'   05                    	DCR	B
  121E'   C3 1212'              	JMP	HTFQ
  1221'                         HF_IN:
  1221'   B7                    	ORA	A
  1222'   C9                    	RET
                                
                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
                                ;        the table starts first (HL -> its first entry, C = the rows short)
  1223'                         HTBQ:
  1223'   78                    	MOV	A,B
  1224'   B7                    	ORA	A
  1225'   37                    	STC
  1226'   C8                    	RZ
  1227'   2B                    	DCX	H
  1228'   05                    	DCR	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  1229'   7E                    	MOV	A,M
  122A'   91                    	SUB	C
  122B'   D2 1234'              	JNC	HQ_IN
  122E'   2F                    	CMA
  122F'   3C                    	INR	A
  1230'   4F                    	MOV	C,A
  1231'   C3 1223'              	JMP	HTBQ
  1234'                         HQ_IN:
  1234'   4F                    	MOV	C,A
  1235'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
                                ; Keeps HL, B, DE.
  1236'                         RWQ:
  1236'   0E 64                 	MVI	C,100
  1238'   3A 0001*              	LDA	RWR+1
  123B'   B7                    	ORA	A
  123C'   C0                    	RNZ
  123D'   3A 0000*              	LDA	RWR
  1240'   B9                    	CMP	C
  1241'   D0                    	RNC
  1242'   4F                    	MOV	C,A
  1243'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  1244'                         RWSUB:
  1244'   E5                    	PUSH	H
  1245'   5F                    	MOV	E,A
  1246'   16 00                 	MVI	D,0
  1248'   2A 0000*              	LHLD	RWR
  124B'   CD 0000*              	CALL	SUBHD
  124E'   22 0000*              	SHLD	RWR
  1251'   E1                    	POP	H
  1252'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
                                ; whose entry HL points at (B = the entries from it on), however far that is:
                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  1253'                         RWFWD:
  1253'   CD 1236'              	CALL	RWQ
  1256'   51                    	MOV	D,C
  1257'   CD 1212'              	CALL	HTFQ
  125A'   F5                    	PUSH	PSW
  125B'   7A                    	MOV	A,D
  125C'   91                    	SUB	C		; the rows that took it to that line's first
  125D'   CD 1244'              	CALL	RWSUB
  1260'   F1                    	POP	PSW
  1261'   DA 1275'              	JC	RF_OFF
  1264'   3A 0001*              	LDA	RWR+1		; is what is left inside this line?
  1267'   B7                    	ORA	A
  1268'   C2 127F'              	JNZ	RF_GO
  126B'   3A 0000*              	LDA	RWR
  126E'   BE                    	CMP	M
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  126F'   D2 127F'              	JNC	RF_GO
  1272'   4F                    	MOV	C,A
  1273'   B7                    	ORA	A
  1274'   C9                    	RET
  1275'                         RF_OFF:
  1275'   3A 0000*              	LDA	HTEOF
  1278'   B7                    	ORA	A
  1279'   CA 127F'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  127C'   2B                    	DCX	H
  127D'   37                    	STC
  127E'   C9                    	RET
  127F'                         RF_GO:
  127F'   CD 1207'              	CALL	HTGO
  1282'   3E 01                 	MVI	A,1
  1284'   32 0000*              	STA	RWMV
  1287'   CD 1236'              	CALL	RWQ
  128A'   0C                    	INR	C
  128B'   06 00                 	MVI	B,0
  128D'   CD 11E8'              	CALL	HTRB
  1290'   C3 1253'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  1293'                         RWBAK:
  1293'   CD 1236'              	CALL	RWQ
  1296'   51                    	MOV	D,C
  1297'   CD 1223'              	CALL	HTBQ
  129A'   DA 12B7'              	JC	RB_OFF
  129D'   7A                    	MOV	A,D
  129E'   81                    	ADD	C
  129F'   5F                    	MOV	E,A		; E = the rows up to that line's first
  12A0'   3A 0001*              	LDA	RWR+1
  12A3'   B7                    	ORA	A
  12A4'   C2 12B3'              	JNZ	RB_ON
  12A7'   3A 0000*              	LDA	RWR
  12AA'   57                    	MOV	D,A
  12AB'   7B                    	MOV	A,E
  12AC'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  12AD'   DA 12B3'              	JC	RB_ON
  12B0'   4F                    	MOV	C,A
  12B1'   B7                    	ORA	A
  12B2'   C9                    	RET
  12B3'                         RB_ON:
  12B3'   7B                    	MOV	A,E
  12B4'   C3 12BE'              	JMP	RB_GO
  12B7'                         RB_OFF:
  12B7'   3A 0000*              	LDA	HTBOF
  12BA'   0F                    	RRC			; CY: that is the file's first line
  12BB'   D8                    	RC
  12BC'   7A                    	MOV	A,D
  12BD'   91                    	SUB	C
  12BE'                         RB_GO:
  12BE'   CD 1244'              	CALL	RWSUB
  12C1'   CD 1207'              	CALL	HTGO
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12C4'   3E 01                 	MVI	A,1
  12C6'   32 0000*              	STA	RWMV
  12C9'   CD 1236'              	CALL	RWQ
  12CC'   41                    	MOV	B,C
  12CD'   0E 01                 	MVI	C,1
  12CF'   CD 11E8'              	CALL	HTRB
  12D2'   43                    	MOV	B,E
  12D3'   C3 1293'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  12D6'                         ONFST:
  12D6'   E5                    	PUSH	H
  12D7'   2A 0000*              	LHLD	OUTPOS
  12DA'   7C                    	MOV	A,H
  12DB'   B5                    	ORA	L
  12DC'   C2 12F4'              	JNZ	OF_RET
  12DF'   2A 0000*              	LHLD	TXTBEG
  12E2'   EB                    	XCHG			; DE = TXTBEG
  12E3'   2A 0000*              	LHLD	GAPBEG
  12E6'                         OF_LP:
  12E6'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  12E9'   CA 12F4'              	JZ	OF_RET
  12EC'   2B                    	DCX	H
  12ED'   7E                    	MOV	A,M
  12EE'   FE 0A                 	CPI	LF
  12F0'   C2 12E6'              	JNZ	OF_LP
  12F3'   B7                    	ORA	A		; NZ
  12F4'                         OF_RET:
  12F4'   E1                    	POP	H
  12F5'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  12F6'                         HFCNT:
  12F6'   2A 0000*              	LHLD	CMDCNT
  12F9'   7C                    	MOV	A,H
  12FA'   B5                    	ORA	L
  12FB'   CA 1312'              	JZ	HFC_AM
  12FE'   CD 0798'              	CALL	GETCNT		; HL = count; clears it
  1301'   3A 0000*              	LDA	NEDIT
  1304'   5F                    	MOV	E,A
  1305'   16 00                 	MVI	D,0
  1307'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  130A'   D2 130E'              	JNC	HFC_ST
  130D'   EB                    	XCHG			; HL = NEDIT
  130E'                         HFC_ST:
  130E'   7D                    	MOV	A,L
  130F'   32 0000*              	STA	HFAMT
  1312'                         HFC_AM:
  1312'   3A 0000*              	LDA	HFAMT
  1315'   B7                    	ORA	A
  1316'   C2 1323'              	JNZ	HFC_HL
  1319'   3A 0000*              	LDA	NEDIT
  131C'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  131D'   1F                    	RAR
  131E'   B7                    	ORA	A
  131F'   C2 1323'              	JNZ	HFC_HL
  1322'   3C                    	INR	A		; at least one row
  1323'                         HFC_HL:
  1323'   32 0000*              	STA	HFN
  1326'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  1327'                         VC_REDR:
  1327'   C3 0798'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (PLACE) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  132A'                         VC_G:
  132A'   CD 086D'              	CALL	SETMOV
  132D'   CD 1401'              	CALL	GZONE		; the screen's top line, before the move
  1330'   CD 07C1'              	CALL	BRKON		; ... and an ESC may stop it from here on
  1333'   2A 0000*              	LHLD	CMDCNT
  1336'   7C                    	MOV	A,H
  1337'   B5                    	ORA	L
  1338'   C2 134B'              	JNZ	VG_N
  133B'   AF                    	XRA	A		; forward
  133C'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  133F'   CD 07FE'              	CALL	BRKOFF
  1342'   DA 0816'              	JC	BRKBAK
  1345'   CD 0BFC'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  1348'   C3 1419'              	JMP	GPLACE
  134B'                         VG_N:
  134B'   CD 0798'              	CALL	GETCNT		; HL = target line (1-based)
  134E'                         VG_LN:
  134E'   CD 135A'              	CALL	GOLN
  1351'   CD 07FE'              	CALL	BRKOFF
  1354'   DA 0816'              	JC	BRKBAK
  1357'   C3 1419'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


                                ;A line less than half as far down as the window's top, on a file not changed
                                ;since it was opened or written, is the exception: PGJUMP reads the file
                                ;again from its start and the move counts forward from line 1 (#34 part B).
  135A'                         GOLN:
  135A'   E5                    	PUSH	H
  135B'   CD 0000*              	CALL	CNTLF
  135E'   23                    	INX	H		; HL = the cursor's line
  135F'   D1                    	POP	D		; DE = the line wanted
  1360'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  1363'   DA 136E'              	JC	GLN_BK
  1366'   EB                    	XCHG
  1367'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  136A'   AF                    	XRA	A
  136B'   C3 1388'              	JMP	GLN_MV
  136E'                         GLN_BK:
  136E'   E5                    	PUSH	H
  136F'   D5                    	PUSH	D
  1370'   2A 0000*              	LHLD	TOPLF
  1373'   EB                    	XCHG			; DE = the lines behind the window
  1374'   2B                    	DCX	H		; HL = the lines above the one wanted
  1375'   CD 0000*              	CALL	PGJUMP
  1378'   D1                    	POP	D
  1379'   E1                    	POP	H
  137A'   D2 1383'              	JNC	GLN_UP
  137D'   EB                    	XCHG			; it jumped: the cursor is on line 1
  137E'   2B                    	DCX	H		; HL = the lines down to it
  137F'   AF                    	XRA	A
  1380'   C3 1388'              	JMP	GLN_MV
  1383'                         GLN_UP:
  1383'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  1386'   3E FF                 	MVI	A,0FFH
  1388'                         GLN_MV:
  1388'   CD 0000*              	CALL	MVLIND
  138B'   CD 0BF6'              	CALL	ATEOF
  138E'   DC 0BFC'              	CC	LASTLN		; past the last line: onto it
  1391'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  1392'                         VC_LG:
  1392'   CD 086D'              	CALL	SETMOV
  1395'   3A 0000*              	LDA	GSAVE
  1398'   B7                    	ORA	A
  1399'   C2 13A2'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  139C'   3E 01                 	MVI	A,PG
  139E'   32 0000*              	STA	GPEND
  13A1'   C9                    	RET
  13A2'                         VLG_GG:
  13A2'   CD 1401'              	CALL	GZONE
  13A5'   CD 07C1'              	CALL	BRKON
  13A8'   CD 0798'              	CALL	GETCNT		; HL = target line (no count: 1)
  13AB'   C3 134E'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  13AE'                         SUB24:
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  13AE'   4F                    	MOV	C,A
  13AF'   7D                    	MOV	A,L
  13B0'   93                    	SUB	E
  13B1'   6F                    	MOV	L,A
  13B2'   7C                    	MOV	A,H
  13B3'   9A                    	SBB	D
  13B4'   67                    	MOV	H,A
  13B5'   79                    	MOV	A,C
  13B6'   98                    	SBB	B
  13B7'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  13B8'                         CURFP:
  13B8'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  13BB'                         FPOS:
  13BB'   C5                    	PUSH	B
  13BC'   D5                    	PUSH	D
  13BD'   EB                    	XCHG
  13BE'   2A 0000*              	LHLD	TXTBEG
  13C1'   EB                    	XCHG
  13C2'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  13C5'   EB                    	XCHG			; DE = that
  13C6'   2A 0000*              	LHLD	OUTPOS
  13C9'   7C                    	MOV	A,H
  13CA'   B7                    	ORA	A		; CY = 0
  13CB'   1F                    	RAR
  13CC'   47                    	MOV	B,A
  13CD'   7D                    	MOV	A,L
  13CE'   1F                    	RAR
  13CF'   67                    	MOV	H,A
  13D0'   3E 00                 	MVI	A,0
  13D2'   1F                    	RAR
  13D3'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  13D4'   19                    	DAD	D
  13D5'   78                    	MOV	A,B
  13D6'   CE 00                 	ACI	0		; A:HL = the position
  13D8'   D1                    	POP	D
  13D9'   C1                    	POP	B
  13DA'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  13DB'                         ZSAVE:
  13DB'   2A 0000*              	LHLD	CMDCNT
  13DE'   22 0000*              	SHLD	ZSVCNT
  13E1'   2A 0000*              	LHLD	AUXCNT
  13E4'   22 0000*              	SHLD	ZSVAUX
  13E7'   3A 0000*              	LDA	DIRFLG
  13EA'   32 0000*              	STA	ZSVDIR
  13ED'   C9                    	RET
  13EE'                         ZREST:
  13EE'   2A 0000*              	LHLD	ZSVCNT
  13F1'   22 0000*              	SHLD	CMDCNT
  13F4'   2A 0000*              	LHLD	ZSVAUX
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  13F7'   22 0000*              	SHLD	AUXCNT
  13FA'   3A 0000*              	LDA	ZSVDIR
  13FD'   32 0000*              	STA	DIRFLG
  1400'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  1401'                         GZONE:
  1401'   CD 13DB'              	CALL	ZSAVE
  1404'   CD 0EDA'              	CALL	CURRW
  1407'   6F                    	MOV	L,A
  1408'   26 00                 	MVI	H,0
  140A'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  140D'   CD 13BB'              	CALL	FPOS
  1410'   22 0000*              	SHLD	ZTOP
  1413'   32 0002*              	STA	ZTOP+2
  1416'   C3 13EE'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  1419'                         GPLACE:
  1419'   CD 13DB'              	CALL	ZSAVE
  141C'   CD 13B8'              	CALL	CURFP
  141F'   EB                    	XCHG
  1420'   2A 0000*              	LHLD	ZTOP
  1423'   EB                    	XCHG
  1424'   4F                    	MOV	C,A		; C:HL = the target's position
  1425'   3A 0002*              	LDA	ZTOP+2
  1428'   47                    	MOV	B,A		; B:DE = the top's
  1429'   79                    	MOV	A,C
  142A'   CD 13AE'              	CALL	SUB24
  142D'   22 0000*              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  1430'   DA 146A'              	JC	GP_UP
  1433'   B7                    	ORA	A
  1434'   C2 14B0'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  1437'   3A 0000*              	LDA	NEDIT
  143A'   87                    	ADD	A
  143B'   3C                    	INR	A
  143C'   6F                    	MOV	L,A
  143D'   26 00                 	MVI	H,0
  143F'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  1442'   CD 0791'              	CALL	GBSUB		; HL = bytes from there to the target
  1445'   EB                    	XCHG
  1446'   2A 0000*              	LHLD	ZDIF		; HL = bytes from the top to the target
  1449'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  144C'   DA 14B0'              	JC	GP_MID
  144F'   CD 0791'              	CALL	GBSUB		; HL = the top line's start (resident)
  1452'   01 0000               	LXI	B,0		; BC = lines from the top
  1455'                         GP_CNT:
  1455'   7A                    	MOV	A,D
  1456'   B3                    	ORA	E
  1457'   CA 1466'              	JZ	GP_DN
  145A'   7E                    	MOV	A,M
  145B'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  145C'   1B                    	DCX	D
  145D'   FE 0A                 	CPI	LF
  145F'   C2 1455'              	JNZ	GP_CNT
  1462'   03                    	INX	B
  1463'   C3 1455'              	JMP	GP_CNT
  1466'                         GP_DN:
  1466'   79                    	MOV	A,C		; the lines from the top one to it
  1467'   C3 14DA'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  146A'                         GP_UP:
  146A'   3C                    	INR	A
  146B'   C2 14B0'              	JNZ	GP_MID		; 64K bytes or more above
  146E'   2A 0000*              	LHLD	ZDIF
  1471'   EB                    	XCHG
  1472'   21 0000               	LXI	H,0
  1475'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  1478'   7C                    	MOV	A,H
  1479'   B5                    	ORA	L
  147A'   CA 14B0'              	JZ	GP_MID		; exactly 64K
  147D'   EB                    	XCHG			; DE = bytes to read
  147E'   AF                    	XRA	A
  147F'   32 0000*              	STA	ZLF
  1482'   CD 0000*              	CALL	RGET0
  1485'                         GP_RD:
  1485'   CD 0000*              	CALL	RDGET		; (keeps DE)
  1488'   DA 14B0'              	JC	GP_MID
  148B'   FE 0A                 	CPI	LF
  148D'   C2 14A1'              	JNZ	GP_RN
  1490'   3A 0000*              	LDA	NEDIT
  1493'   B7                    	ORA	A
  1494'   1F                    	RAR
  1495'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  1497'   E5                    	PUSH	H
  1498'   21 0000*              	LXI	H,ZLF
  149B'   34                    	INR	M
  149C'   BE                    	CMP	M		; CY iff more lines than that
  149D'   E1                    	POP	H
  149E'   DA 14B0'              	JC	GP_MID
  14A1'                         GP_RN:
  14A1'   1B                    	DCX	D
  14A2'   7A                    	MOV	A,D
  14A3'   B3                    	ORA	E
  14A4'   C2 1485'              	JNZ	GP_RD
  14A7'   3E 01                 	MVI	A,PL_SET	; the top row
  14A9'   32 0000*              	STA	PLACE
  14AC'   AF                    	XRA	A
  14AD'   C3 14BA'              	JMP	GP_SET
  14B0'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  14B0'   3E 02                 	MVI	A,PL_MID
  14B2'   32 0000*              	STA	PLACE		; mid-screen, as the rows fall
  14B5'   3A 0000*              	LDA	NEDIT
  14B8'   B7                    	ORA	A
  14B9'   1F                    	RAR			; (no more lines above it than this)
  14BA'                         GP_SET:
  14BA'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  14BB'   26 00                 	MVI	H,0
  14BD'   22 0000*              	SHLD	WINROW
  14C0'   21 0000               	LXI	H,0
  14C3'   22 0000*              	SHLD	LNDLT
  14C6'   CD 08AA'              	CALL	SETFUL		; the window may have paged: full repaint
  14C9'                         GP_FIN:
  14C9'   CD 13EE'              	CALL	ZREST
  14CC'   3A 0000*              	LDA	GPKEEP
  14CF'   B7                    	ORA	A
  14D0'   CA 0973'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  14D3'   AF                    	XRA	A
  14D4'   32 0000*              	STA	GPKEEP
  14D7'   C3 062C'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
                                ; adds LNDLT to it and arrives at the same line.
  14DA'                         GP_ONS:
  14DA'   6F                    	MOV	L,A
  14DB'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  14DD'   EB                    	XCHG
  14DE'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  14E1'   EB                    	XCHG
  14E2'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  14E5'   22 0000*              	SHLD	LNDLT
  14E8'   3E 01                 	MVI	A,R_MOVE
  14EA'   32 0000*              	STA	RINTENT
  14ED'   C3 14C9'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ; A jump (` and the searches / ? n N) is charwise exclusive across lines.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  14F0'                         OPPEND:
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  14F0'   AF                    	XRA	A
  14F1'   32 0000*              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  14F4'   3A 0000*              	LDA	PSAVE
  14F7'   FE 63                 	CPI	'c'
  14F9'   C2 1516'              	JNZ	OPP_ND
  14FC'   79                    	MOV	A,C
  14FD'   FE 77                 	CPI	'w'
  14FF'   CA 1507'              	JZ	OPP_W
  1502'   FE 57                 	CPI	'W'
  1504'   C2 1516'              	JNZ	OPP_ND
  1507'                         OPP_W:
  1507'   CD 1719'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  150A'   DA 1516'              	JC	OPP_ND
  150D'   79                    	MOV	A,C
  150E'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  1510'   4F                    	MOV	C,A
  1511'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  1513'   32 0000*              	STA	CWEOL		;   char for the next word's: see ESTEP
  1516'                         OPP_ND:
  1516'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  1517'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  1519'   C2 152D'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  151C'   CD 01FC'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  151F'   DA 15ED'              	JC	OPABRT
  1522'   79                    	MOV	A,C
  1523'   FE 67                 	CPI	'g'
  1525'   C2 15ED'              	JNZ	OPABRT
  1528'   3E 01                 	MVI	A,PG
  152A'   32 0000*              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  152D'                         OPP_NG:
  152D'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  152E'   21 0000*              	LXI	H,PSAVE
  1531'   BE                    	CMP	M
  1532'   CA 173A'              	JZ	OPLINE
  1535'   79                    	MOV	A,C		; (OPCLS classifies the key)
  1536'   CD 1750'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1539'   DA 1573'              	JC	OPP_NM		;   -- and not a mark, so nothing is owed below
  153C'   32 0000*              	STA	OPCLSV
  153F'   47                    	MOV	B,A		; B = the class
  1540'   3A 0000*              	LDA	PSAVE
  1543'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  1545'   C2 1551'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  1548'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  1549'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  154B'   C2 1598'              	JNZ	OPP_GO
  154E'   C3 155C'              	JMP	OPP_NO
  1551'                         OPP_NC:
  1551'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  1553'   C2 1598'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  1556'   78                    	MOV	A,B		;   a charwise register would need a type flag
  1557'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  1559'   CA 1598'              	JZ	OPP_GO		;   within a line -- neither of which is built
  155C'                         OPP_NO:
  155C'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  155D'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  155F'   CA 156D'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  1562'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  1564'   CA 156D'              	JZ	OPP_SW		;   so swallow it before dropping the command
  1567'   CD 0329'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  156A'   C2 1573'              	JNZ	OPP_NM		;   motions only, so the find is dropped here);
                                				;   a search reads a whole line: OPP_NM
  156D'                         OPP_SW:
  156D'   CD 01FC'              	CALL	MKGETK
  1570'   C3 15ED'              	JMP	OPABRT
                                ;OPP_NM -- not a motion, or not one this operator takes.  A search ('/' '?'
                                ; 'n' 'N') is a motion for 'd' and 'c' (OPCTAB class 3), but a charwise one,
                                ; and 'y' takes linewise motions only, so 'y/' and 'yn' arrive here from
                                ; OPP_NO.  That is the one drop that cannot be silent: a '/' or '?' left to the
                                ; next dispatch reads no line, so 'y/QJQK<CR>' would run the pattern as
                                ; commands ('J' joins two lines).  So the line is read the way a search reads
                                ; it, and thrown away, and the bell says nothing was done.
  1573'                         OPP_NM:
  1573'   79                    	MOV	A,C
  1574'   FE 2F                 	CPI	'/'
  1576'   CA 1588'              	JZ	OPP_SL
  1579'   FE 3F                 	CPI	'?'
  157B'   CA 1588'              	JZ	OPP_SL
  157E'   E6 DF                 	ANI	0DFH		; 'n' -> 'N'
  1580'   FE 4E                 	CPI	'N'
  1582'   C2 15ED'              	JNZ	OPABRT		; any other key: dropped, as before
  1585'   C3 1590'              	JMP	OPP_BL
  1588'                         OPP_SL:
  1588'   11 0000*              	LXI	D,EXBUF		; the ':' line's buffer, free between commands;
  158B'   06 28                 	MVI	B,EXMAX		;   C is the key, and so the prompt.  A cancel
  158D'   CD 219E'              	CALL	RDLINE		;   (ESC, or BS on an empty line) rings too
  1590'                         OPP_BL:
  1590'   0E 07                 	MVI	C,BEL
  1592'   CD 0000*              	CALL	BCONOU
  1595'   C3 15ED'              	JMP	OPABRT
  1598'                         OPP_GO:
  1598'   AF                    	XRA	A
  1599'   32 0000*              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  159C'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  159F'   22 0000*              	SHLD	OPSTA
  15A2'   C5                    	PUSH	B
  15A3'   21 0000*              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  15A6'   CD 0444'              	CALL	FPSTO		;   only good until the motion pages the window
  15A9'   3A 0000*              	LDA	OPCLSV
  15AC'   FE 02                 	CPI	2
  15AE'   CC 15F0'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  15B1'   C1                    	POP	B
  15B2'   21 3176'              	LXI	H,CMDTAB
  15B5'   CD 00C6'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  15B8'   3A 0000*              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  15BB'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  15BC'   CA 086D'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  15BF'   3A 0000*              	LDA	OPCLSV
  15C2'   FE 02                 	CPI	2
  15C4'   CC 0960'              	CZ	LNEND		; a line motion: the line it landed on whole, or
                                				;   the span ends inside it (#38).  It may page
                                				;   the start out; OPSFIX asks next
  15C7'   CD 161C'              	CALL	OPSFIX		; where the start is in the window NOW
  15CA'   D2 1638'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  15CD'   22 0000*              	SHLD	OPSTA
  15D0'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  15D3'   22 0000*              	SHLD	OPEND2
  15D6'   3A 0000*              	LDA	PSAVE
  15D9'   FE 79                 	CPI	'y'
  15DB'   CA 1CFD'              	JZ	OPYANK		; a yank takes the span without losing it
  15DE'   CD 0A25'              	CALL	GLSTAL		; 'j' then goes from where the delete leaves the
                                				;   cursor, not from where the motion landed
                                				;   before the text went: 'dw' 'j' from column 0
                                				;   keeps column 0 (vim; #47).  A linewise one
                                				;   lands on the first non-blank, as vim's does
  15E1'   CD 178B'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  15E4'   3A 0000*              	LDA	PSAVE
  15E7'   FE 63                 	CPI	'c'
  15E9'   C0                    	RNZ
  15EA'   C3 1AB1'              	JMP	SETINS
  15ED'                         OPABRT:				; not a motion -> the operator is dropped and
  15ED'   C3 00A9'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  15F0'                         OPENDS:
  15F0'   2A 0000*              	LHLD	OPSTA
  15F3'   CD 0693'              	CALL	BOL
  15F6'   11 0000*              	LXI	D,OPSLO
  15F9'   CD 160E'              	CALL	OPE_ST
  15FC'   2A 0000*              	LHLD	OPSTA
  15FF'   CD 072A'              	CALL	NLSTART
  1602'   11 0000*              	LXI	D,OPSHI
  1605'   CD 160E'              	CALL	OPE_ST
  1608'   2A 0000*              	LHLD	OPSTA
  160B'   C3 0000*              	JMP	GOTO
  160E'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  160E'   D5                    	PUSH	D
  160F'   CD 0000*              	CALL	GOTO
  1612'   E1                    	POP	H
  1613'   C3 0444'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  1616'                         CURBD:
  1616'   CD 13B8'              	CALL	CURFP
  1619'   EB                    	XCHG
  161A'   47                    	MOV	B,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  161B'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  161C'                         OPSFIX:
  161C'   21 0000*              	LXI	H,OPSFP
  161F'   CD 03FB'              	CALL	MKLOAD
  1622'   CD 1616'              	CALL	CURBD
  1625'   2A 0000*              	LHLD	MKPOS
  1628'   3A 0002*              	LDA	MKPOS+2
  162B'   CD 13AE'              	CALL	SUB24
  162E'   B4                    	ORA	H
  162F'   B5                    	ORA	L
  1630'   C2 0408'              	JNZ	MKWIN
  1633'   CD 0000*              	CALL	CUROFF
  1636'   37                    	STC
  1637'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  1638'                         OPPGD:
  1638'   47                    	MOV	B,A
  1639'   3A 0000*              	LDA	OPCLSV
  163C'   FE 02                 	CPI	2
  163E'   C2 16FA'              	JNZ	OPG_NO
  1641'   3A 0000*              	LDA	PSAVE
  1644'   FE 64                 	CPI	'd'
  1646'   C2 16FA'              	JNZ	OPG_NO
  1649'   04                    	INR	B
  164A'   CA 1659'              	JZ	OPG_FW
  164D'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  1650'   CD 0693'              	CALL	BOL		;   and the high end is OPSHI as it stands
  1653'   CD 0000*              	CALL	GOTO
  1656'   C3 1671'              	JMP	OPG_GO
  1659'                         OPG_FW:
  1659'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  165C'   CD 072A'              	CALL	NLSTART		;   landed on, and the low one is where the
  165F'   11 0000*              	LXI	D,OPSHI		;   start line began
  1662'   CD 160E'              	CALL	OPE_ST
  1665'   21 0000*              	LXI	H,OPSLO
  1668'   CD 03FB'              	CALL	MKLOAD
  166B'   CD 03AC'              	CALL	MKPAGE
  166E'   CD 0000*              	CALL	GOTO
  1671'                         OPG_GO:
  1671'   CD 1616'              	CALL	CURBD
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  1674'   2A 0000*              	LHLD	OPSHI
  1677'   3A 0002*              	LDA	OPSHI+2
  167A'   CD 13AE'              	CALL	SUB24		; A:HL = the bytes to take
  167D'                         OPG_SV:
  167D'   22 0000*              	SHLD	OPTOGO
  1680'   32 0002*              	STA	OPTOGO+2
  1683'                         OPG_NX:
  1683'   CD 0774'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  1686'   CD 0000*              	CALL	SUBHD
  1689'   EB                    	XCHG			; DE = what the window holds past the cursor
  168A'   2A 0000*              	LHLD	OPTOGO
  168D'   3A 0002*              	LDA	OPTOGO+2
  1690'   B7                    	ORA	A
  1691'   C2 16C4'              	JNZ	OPG_PG		; 64K or more to go
  1694'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  1697'   DA 16C4'              	JC	OPG_PG
  169A'   CA 16C4'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  169D'                         OPG_FN:				; the rest of it is here
  169D'   E5                    	PUSH	H
  169E'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  16A1'   CD 0000*              	CALL	CUROFF
  16A4'   22 0000*              	SHLD	OPLO
  16A7'   D1                    	POP	D
  16A8'   19                    	DAD	D
  16A9'   22 0000*              	SHLD	OPHI
  16AC'   CD 18BE'              	CALL	OPDSPN
  16AF'   CD 0BF6'              	CALL	ATEOF
  16B2'   D2 1713'              	JNC	OPMID
  16B5'   CD 12D6'              	CALL	ONFST		; deleted to the end of the file: onto the new
  16B8'   CA 1713'              	JZ	OPMID		;   last line, if there is one -- and the pager
  16BB'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  16BE'   CD 0000*              	CALL	SETBWD
  16C1'   C3 1713'              	JMP	OPMID
  16C4'                         OPG_PG:
  16C4'   7A                    	MOV	A,D
  16C5'   B3                    	ORA	E
  16C6'   C2 16DF'              	JNZ	OPG_DL
  16C9'   CD 0BF6'              	CALL	ATEOF		; nothing held past the cursor
  16CC'   21 0000               	LXI	H,0
  16CF'   DA 169D'              	JC	OPG_FN		; ... and no more to come: the file ran out
  16D2'   2B                    	DCX	H
  16D3'   CD 0000*              	CALL	SETC0
  16D6'   CD 0000*              	CALL	GOLINE
  16D9'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  16DC'   C3 1683'              	JMP	OPG_NX
  16DF'                         OPG_DL:
  16DF'   D5                    	PUSH	D
  16E0'   21 FFFF               	LXI	H,0FFFFH
  16E3'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  16E6'   E1                    	POP	H
  16E7'   E5                    	PUSH	H
  16E8'   CD 0000*              	CALL	DELFWD
  16EB'   D1                    	POP	D
  16EC'   06 00                 	MVI	B,0
  16EE'   2A 0000*              	LHLD	OPTOGO
  16F1'   3A 0002*              	LDA	OPTOGO+2
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  16F4'   CD 13AE'              	CALL	SUB24
  16F7'   C3 167D'              	JMP	OPG_SV
  16FA'                         OPG_NO:
  16FA'   0E 07                 	MVI	C,BEL
  16FC'   CD 0000*              	CALL	BCONOU
  16FF'                         OPG_HM:				; the cursor back where the command found it
  16FF'   21 0000*              	LXI	H,OPSFP
  1702'   CD 03FB'              	CALL	MKLOAD
  1705'   CD 03AC'              	CALL	MKPAGE
  1708'   CD 0000*              	CALL	GOTO
  170B'   AF                    	XRA	A
  170C'   32 0000*              	STA	PSAVE
  170F'   3C                    	INR	A
  1710'   32 0000*              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  1713'                         OPMID:
  1713'   CD 13DB'              	CALL	ZSAVE
  1716'   C3 14B0'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  1719'                         ONWHIT:
  1719'   CD 0774'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  171C'   CA 1738'              	JZ	OW_YES
  171F'   CD 077F'              	CALL	CURCHR		; A = the char under the cursor
  1722'   FE 20                 	CPI	' '
  1724'   CA 1738'              	JZ	OW_YES
  1727'   FE 09                 	CPI	TAB
  1729'   CA 1738'              	JZ	OW_YES
  172C'   FE 0D                 	CPI	CR
  172E'   CA 1738'              	JZ	OW_YES
  1731'   FE 0A                 	CPI	LF
  1733'   CA 1738'              	JZ	OW_YES
  1736'   B7                    	ORA	A		; a char to change: CY clear
  1737'   C9                    	RET
  1738'                         OW_YES:
  1738'   37                    	STC
  1739'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  173A'                         OPLINE:
  173A'   3A 0000*              	LDA	PSAVE
  173D'   FE 63                 	CPI	'c'
  173F'   CA 086D'              	JZ	SETMOV
  1742'   FE 79                 	CPI	'y'
  1744'   CA 1CDC'              	JZ	VY_YY
  1747'   21 0000*              	LXI	H,OPSFP		; where the cursor is, for a count the register
  174A'   CD 0444'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  174D'   C3 1C52'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


                                ; is not an operator-usable motion (scan OPCTAB).
  1750'                         OPCLS:
  1750'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  1752'   CA 175F'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  1755'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  1757'   C2 1773'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  175A'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  175C'   C3 1761'              	JMP	OPC_FK
  175F'                         OPC_SEM:
  175F'   06 00                 	MVI	B,0		; ';' runs it as it stands
  1761'                         OPC_FK:
  1761'   3A 0000*              	LDA	FNDKND
  1764'   B7                    	ORA	A
  1765'   37                    	STC
  1766'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1767'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1768'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  176A'   CA 1771'              	JZ	OPC_EXC
  176D'   3E 01                 	MVI	A,1
  176F'   B7                    	ORA	A		; CY clear: a motion, class 1
  1770'   C9                    	RET
  1771'                         OPC_EXC:
  1771'   AF                    	XRA	A		; class 0, CY clear
  1772'   C9                    	RET
  1773'                         OPC_TB:
  1773'   47                    	MOV	B,A
  1774'   21 1963'              	LXI	H,OPCTAB
  1777'                         OPC_LP:
  1777'   7E                    	MOV	A,M
  1778'   B7                    	ORA	A
  1779'   CA 1789'              	JZ	OPC_MS		; end of table -> not a motion
  177C'   B8                    	CMP	B
  177D'   CA 1785'              	JZ	OPC_HT
  1780'   23                    	INX	H
  1781'   23                    	INX	H
  1782'   C3 1777'              	JMP	OPC_LP
  1785'                         OPC_HT:
  1785'   23                    	INX	H
  1786'   7E                    	MOV	A,M		; class byte
  1787'   B7                    	ORA	A		; clear CY
  1788'   C9                    	RET
  1789'                         OPC_MS:
  1789'   37                    	STC
  178A'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  178B'                         OPAPPL:
  178B'   3A 0000*              	LDA	OPCLSV
  178E'   FE 02                 	CPI	2
  1790'   CA 1937'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  1793'   2A 0000*              	LHLD	OPSTA
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  1796'   EB                    	XCHG			; DE = start
  1797'   2A 0000*              	LHLD	OPEND2		; HL = end
  179A'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  179D'   DA 17B0'              	JC	OPA_F
  17A0'   CA 17B0'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  17A3'   22 0000*              	SHLD	OPLO
  17A6'   EB                    	XCHG
  17A7'   22 0000*              	SHLD	OPHI
  17AA'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  17AD'   C3 1867'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  17B0'                         OPA_F:
  17B0'   EB                    	XCHG			; HL = start, DE = end
  17B1'   22 0000*              	SHLD	OPLO
  17B4'   EB                    	XCHG			; HL = end
  17B5'   3A 0000*              	LDA	OPCLSV
  17B8'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  17BA'   CA 1864'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  17BD'   FE 01                 	CPI	1
  17BF'   C2 17E1'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  17C2'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  17C3'   22 0000*              	SHLD	OPHI		; park it: CEND clobbers DE
  17C6'   2B                    	DCX	H		; the line it landed on
  17C7'   CD 1A2F'              	CALL	CEND		; HL = that line's content end
  17CA'   EB                    	XCHG			; DE = it
  17CB'   2A 0000*              	LHLD	OPHI		; HL = hi
  17CE'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  17D1'   D2 17EC'              	JNC	OPA_HI		; hi is inside the line: keep it
  17D4'   2A 0000*              	LHLD	OPLO
  17D7'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  17DA'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  17DD'   EB                    	XCHG			; HL = the content end: the span stops there
  17DE'   C3 17EC'              	JMP	OPA_HI
  17E1'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  17E1'   22 0000*              	SHLD	OPHI
  17E4'   3A 0000*              	LDA	WPULL
  17E7'   B7                    	ORA	A
  17E8'   CA 1867'              	JZ	OPA_C1
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  17EB'   23                    	INX	H
  17EC'                         OPA_HI:
  17EC'   22 0000*              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  17EF'                         OPA_DO:
  17EF'   CD 18B3'              	CALL	OPSPNL
  17F2'   7C                    	MOV	A,H
  17F3'   B5                    	ORA	L
  17F4'   C2 17FD'              	JNZ	OPA_D1
  17F7'   2A 0000*              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  17FA'   C3 0000*              	JMP	GOTO		;   to where the span starts
  17FD'                         OPA_D1:
  17FD'   3A 0000*              	LDA	PSAVE
  1800'   FE 63                 	CPI	'c'
  1802'   CA 18BE'              	JZ	OPDSPN
  1805'   CD 18A6'              	CALL	SPNBRK
  1808'   D2 1829'              	JNC	OPA_D2
  180B'   2A 0000*              	LHLD	OPHI
  180E'   CD 1A2F'              	CALL	CEND
  1811'   EB                    	XCHG			; DE = the content end of the line it ends in
  1812'   2A 0000*              	LHLD	OPHI
  1815'                         OPA_BL:
  1815'   CD 0000*              	CALL	CMP16
  1818'   CA 182F'              	JZ	OPA_BI		; only blanks after it
  181B'   D5                    	PUSH	D
  181C'   E5                    	PUSH	H
  181D'   CD 0000*              	CALL	CHARAT
  1820'   E1                    	POP	H
  1821'   D1                    	POP	D
  1822'   23                    	INX	H
  1823'   CD 185E'              	CALL	BLANKQ
  1826'   CA 1815'              	JZ	OPA_BL
  1829'                         OPA_D2:
  1829'   CD 18BE'              	CALL	OPDSPN
  182C'   C3 1A40'              	JMP	CLAMPE
  182F'                         OPA_BI:
  182F'   CD 1841'              	CALL	LOIND
  1832'   C2 1829'              	JNZ	OPA_D2
  1835'   2A 0000*              	LHLD	OPHI
  1838'   CD 072A'              	CALL	NLSTART
  183B'   22 0000*              	SHLD	OPHI
  183E'   C3 1892'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  1841'                         LOIND:
  1841'   2A 0000*              	LHLD	OPLO
  1844'   CD 0693'              	CALL	BOL
  1847'                         LI_LP:
  1847'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  1848'   EB                    	XCHG
  1849'   2A 0000*              	LHLD	OPLO
  184C'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  184F'   E1                    	POP	H
  1850'   C8                    	RZ
  1851'   E5                    	PUSH	H
  1852'   CD 0000*              	CALL	CHARAT
  1855'   E1                    	POP	H
  1856'   23                    	INX	H
  1857'   CD 185E'              	CALL	BLANKQ
  185A'   CA 1847'              	JZ	LI_LP
  185D'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  185E'                         BLANKQ:
  185E'   FE 20                 	CPI	' '
  1860'   C8                    	RZ
  1861'   FE 09                 	CPI	TAB
  1863'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  1864'                         OPA_JP:
  1864'   22 0000*              	SHLD	OPHI
  1867'                         OPA_C1:
  1867'   CD 18B3'              	CALL	OPSPNL
  186A'   7C                    	MOV	A,H
  186B'   B5                    	ORA	L
  186C'   CA 17EF'              	JZ	OPA_DO		; nothing spanned
  186F'   2A 0000*              	LHLD	OPHI
  1872'   CD 0693'              	CALL	BOL
  1875'   EB                    	XCHG
  1876'   2A 0000*              	LHLD	OPHI
  1879'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  187C'   C2 17EF'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  187F'   CD 1841'              	CALL	LOIND
  1882'   CA 1892'              	JZ	C1_LW		; only blanks before lo: whole lines
  1885'                         C1_CH:
  1885'   2A 0000*              	LHLD	OPHI		; back over the line break to the content end
  1888'   2B                    	DCX	H		;   of the line before
  1889'   CD 1A2F'              	CALL	CEND
  188C'   22 0000*              	SHLD	OPHI
  188F'   C3 17EF'              	JMP	OPA_DO
  1892'                         C1_LW:
  1892'   2A 0000*              	LHLD	OPLO
  1895'   CD 0693'              	CALL	BOL
  1898'   22 0000*              	SHLD	OPLO
  189B'   3A 0000*              	LDA	PSAVE
  189E'   FE 63                 	CPI	'c'
  18A0'   CA 1885'              	JZ	C1_CH
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  18A3'   C3 194A'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  18A6'                         SPNBRK:
  18A6'   2A 0000*              	LHLD	OPLO
  18A9'   CD 06D6'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  18AC'   EB                    	XCHG			; DE = it
  18AD'   2A 0000*              	LHLD	OPHI
  18B0'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  18B3'                         OPSPNL:
  18B3'   2A 0000*              	LHLD	OPHI
  18B6'   EB                    	XCHG
  18B7'   2A 0000*              	LHLD	OPLO
  18BA'   EB                    	XCHG			; HL = hi, DE = lo
  18BB'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
                                ; No break in it: 'dw' 'cw' 'D' changed one row, and only that row is stale.
                                ; And from where the cursor was on (OPSTA: 'dw', not 'db'), the terminal may
                                ; close the cells up.
  18BE'                         OPDSPN:
  18BE'   CD 18A6'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  18C1'   F5                    	PUSH	PSW
  18C2'   2A 0000*              	LHLD	OPSTA
  18C5'   EB                    	XCHG
  18C6'   2A 0000*              	LHLD	OPLO
  18C9'   22 0000*              	SHLD	WKI
  18CC'   CD 0000*              	CALL	CMP16
  18CF'   F5                    	PUSH	PSW		; Z: the span starts under the screen's cursor
  18D0'   CD 0000*              	CALL	GOTO
  18D3'   CD 18B3'              	CALL	OPSPNL		; HL = hi - lo
  18D6'   CD 0873'              	CALL	SETLIN
  18D9'   F1                    	POP	PSW
  18DA'   CC 19FE'              	CZ	DCHQ
  18DD'   CD 0000*              	CALL	DELFWD
  18E0'   CD 0177'              	CALL	MARKMOD
  18E3'   F1                    	POP	PSW
  18E4'   D0                    	RNC
  18E5'   C3 08AA'              	JMP	SETFUL		; a break went: every row below it moved up
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  18E8'                         UNDFNB:
  18E8'   CD 0000*              	CALL	CUROFF
  18EB'   E5                    	PUSH	H
  18EC'   CD 0973'              	CALL	FNBLNK
  18EF'   CD 0000*              	CALL	CUROFF
  18F2'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  18F3'   CD 0000*              	CALL	CMP16
  18F6'   D2 0000*              	JNC	UNDHER
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  18F9'   EB                    	XCHG
  18FA'   CD 0000*              	CALL	GOTO
  18FD'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  1900'                         OPALSP:
  1900'   2A 0000*              	LHLD	OPSTA
  1903'   EB                    	XCHG
  1904'   2A 0000*              	LHLD	OPEND2
  1907'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  190A'   DA 191A'              	JC	OPAL_F
  190D'   22 0000*              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1910'   EB                    	XCHG
  1911'   22 0000*              	SHLD	OPHI		; hi-src = start
  1914'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  1917'   C3 1924'              	JMP	OPAL_R
  191A'                         OPAL_F:
  191A'   EB                    	XCHG			; HL = start
  191B'   22 0000*              	SHLD	OPLO		; lo-src = start
  191E'   2A 0000*              	LHLD	OPEND2
  1921'   22 0000*              	SHLD	OPHI		; hi-src = end
  1924'                         OPAL_R:
  1924'   2A 0000*              	LHLD	OPLO
  1927'   CD 0693'              	CALL	BOL
  192A'   22 0000*              	SHLD	OPLO		; lo = BOL(low line)
  192D'   2A 0000*              	LHLD	OPHI
  1930'   CD 072A'              	CALL	NLSTART
  1933'   22 0000*              	SHLD	OPHI		; hi = start of line past the high line
  1936'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  1937'                         OPALIN:
  1937'   CD 1900'              	CALL	OPALSP
  193A'   2A 0000*              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  193D'   CD 072A'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  1940'   EB                    	XCHG			;   the column)
  1941'   2A 0000*              	LHLD	OPHI
  1944'   CD 0000*              	CALL	CMP16
  1947'   CC 18E8'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  194A'                         OPDLIN:
  194A'   CD 18BE'              	CALL	OPDSPN
  194D'   CD 0774'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1950'   DA 1960'              	JC	OPDL_NB
  1953'   CD 0000*              	CALL	LOGLEN
  1956'   7C                    	MOV	A,H
  1957'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  1958'   C8                    	RZ			; empty buffer
  1959'   2B                    	DCX	H
  195A'   CD 0693'              	CALL	BOL
  195D'   CD 0000*              	CALL	GOTO
  1960'                         OPDL_NB:
  1960'   C3 0973'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; A search is class 3, as in vim (charwise exclusive, and a jump): '/' and '?'
                                ; read their line inside the VSCAN, so 'd/pat<CR>' is measured whole, and a
                                ; span that ends in a line's first column follows OPA_C1's rule (issue #44).
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1963'                         OPCTAB:
  1963'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1967'   62 00 42 00           
  196B'   68 00 6C 00           
  196F'   30 00 5E 00           
  1973'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1975'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1979'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  197D'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1981'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1985'   24 01                 
  1987'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  198B'   47 02 48 02           
  198F'   4D 02 4C 02           
  1993'   2F 03 3F 03           	DB	'/',3, '?',3, 'n',3, 'N',3	; the searches: jumps, as '`' is
  1997'   6E 03 4E 03           
  199B'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  199D'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  199F'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  19A0'                         VCB_C:
  19A0'   CD 19AF'              	CALL	VCB_CD
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  19A3'   C3 1AB1'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  19A6'                         VCB_D:
  19A6'   CD 0A25'              	CALL	GLSTAL		; the goal column as OPP_GO leaves it (#47)
  19A9'   CD 19AF'              	CALL	VCB_CD
  19AC'   C3 1A40'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  19AF'                         VCB_CD:
  19AF'   CD 078B'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  19B2'   22 0000*              	SHLD	OPLO
  19B5'   22 0000*              	SHLD	OPSTA
  19B8'   CD 0000*              	CALL	CUROFF
  19BB'   CD 1A2F'              	CALL	CEND		; to the line's content end, the CR,LF left
  19BE'   22 0000*              	SHLD	OPHI
  19C1'   C3 18BE'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  19C4'                         VC_X:
  19C4'   CD 0A25'              	CALL	GLSTAL
  19C7'   CD 0873'              	CALL	SETLIN
  19CA'   CD 0798'              	CALL	GETCNT
  19CD'   22 0000*              	SHLD	CNTV
  19D0'   CD 0000*              	CALL	CUROFF
  19D3'   22 0000*              	SHLD	WKI		; cur
  19D6'   CD 1A2F'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  19D9'   EB                    	XCHG			; DE = contentend
  19DA'   2A 0000*              	LHLD	WKI		; HL = cur
  19DD'   EB                    	XCHG			; HL = contentend, DE = cur
  19DE'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  19E1'   7C                    	MOV	A,H
  19E2'   B5                    	ORA	L
  19E3'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  19E4'   EB                    	XCHG			; DE = available
  19E5'   2A 0000*              	LHLD	CNTV		; HL = count
  19E8'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  19EB'   DA 19F1'              	JC	VX_USEA
  19EE'   C3 19F2'              	JMP	VX_DEL		; count <= available -> HL = count = del
  19F1'                         VX_USEA:
  19F1'   EB                    	XCHG			; HL = available
  19F2'                         VX_DEL:
  19F2'   CD 19FE'              	CALL	DCHQ
  19F5'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  19F8'   CD 0177'              	CALL	MARKMOD
  19FB'   C3 1A40'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;DCHQ -- HL bytes are about to go from under the cursor, none of them a line
                                ; end, and WKI is the cursor's offset.  Plain chars, and plain chars after
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


                                ; them: the terminal can close the cells up itself (R_DCH).  A TAB there would
                                ; change width.  Keeps HL.
  19FE'                         DCHQ:
  19FE'   E5                    	PUSH	H
  19FF'   CD 08B0'              	CALL	TAILTAB
  1A02'   E1                    	POP	H
  1A03'   47                    	MOV	B,A
  1A04'   7C                    	MOV	A,H		; (more of them than a byte counts)
  1A05'   B7                    	ORA	A
  1A06'   C0                    	RNZ
  1A07'   B5                    	ORA	L
  1A08'   C8                    	RZ			; (or none at all)
  1A09'   32 322F'              	STA	DCHN
  1A0C'   78                    	MOV	A,B
  1A0D'   87                    	ADD	A
  1A0E'   32 0000*              	STA	DCHBS		; 2: a TAB follows, to take the cells up
  1A11'   CA 1A29'              	JZ	DQ_0
  1A14'   7D                    	MOV	A,L		; ... if it is past what goes, and can
  1A15'   FE 08                 	CPI	8
  1A17'   D0                    	RNC
  1A18'   E5                    	PUSH	H
  1A19'   2A 0000*              	LHLD	WKI
  1A1C'   EB                    	XCHG
  1A1D'   2A 0000*              	LHLD	TTI
  1A20'   CD 0000*              	CALL	SUBHD
  1A23'   EB                    	XCHG			; DE = the chars before it
  1A24'   E1                    	POP	H
  1A25'   CD 0000*              	CALL	CMP16
  1A28'   D8                    	RC
  1A29'                         DQ_0:
  1A29'   3E 07                 	MVI	A,R_DCH
  1A2B'   32 0000*              	STA	RINTENT
  1A2E'   C9                    	RET
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  1A2F'                         CEND:
  1A2F'   CD 06D6'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1A32'   7C                    	MOV	A,H
  1A33'   B5                    	ORA	L
  1A34'   C8                    	RZ			; the start of the text: nothing before it
  1A35'   2B                    	DCX	H
  1A36'   E5                    	PUSH	H
  1A37'   CD 0000*              	CALL	CHARAT
  1A3A'   E1                    	POP	H		; HL = term-1
  1A3B'   FE 0D                 	CPI	CR
  1A3D'   C8                    	RZ			; a CR before the LF -> the content ends there
  1A3E'   23                    	INX	H
  1A3F'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1A40'                         CLAMPE:
  1A40'   CD 0000*              	CALL	CUROFF
  1A43'   E5                    	PUSH	H
  1A44'   CD 0739'              	CALL	EOLC
  1A47'   D1                    	POP	D		; DE = cur
  1A48'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  1A4B'   D8                    	RC
  1A4C'   C8                    	RZ
  1A4D'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1A50'                         VC_I:
  1A50'   CD 0798'              	CALL	GETCNT
  1A53'   C3 1AAE'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1A56'                         VC_A:
  1A56'   CD 0798'              	CALL	GETCNT
  1A59'   CD 0774'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1A5C'   CA 1A73'              	JZ	VA_INS
  1A5F'   EB                    	XCHG			; HL = cur
  1A60'   E5                    	PUSH	H
  1A61'   CD 0000*              	CALL	CHARAT
  1A64'   E1                    	POP	H
  1A65'   FE 0A                 	CPI	LF
  1A67'   CA 1A73'              	JZ	VA_INS		; on the line terminator -> append in place
  1A6A'   FE 0D                 	CPI	CR
  1A6C'   CA 1A73'              	JZ	VA_INS
  1A6F'   23                    	INX	H
  1A70'   CD 0000*              	CALL	GOTO
  1A73'                         VA_INS:
  1A73'   C3 1AAE'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1A76'                         VCB_A:
  1A76'   CD 078B'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A79'   CD 0739'              	CALL	EOLC		; HL = last content char (the start when empty)
  1A7C'   E5                    	PUSH	H
  1A7D'   CD 0000*              	CALL	CHARAT
  1A80'   E1                    	POP	H
  1A81'   FE 0D                 	CPI	CR
  1A83'   CA 1A8C'              	JZ	VBA_IN		; an empty line: insert at its start
  1A86'   FE 0A                 	CPI	LF
  1A88'   CA 1A8C'              	JZ	VBA_IN
  1A8B'   23                    	INX	H		; past the last content char
  1A8C'                         VBA_IN:
  1A8C'   CD 0000*              	CALL	GOTO
  1A8F'   C3 1AAE'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1A92'                         VCB_I:
  1A92'   CD 0798'              	CALL	GETCNT
  1A95'   CD 0973'              	CALL	FNBLNK
  1A98'   CD 0000*              	CALL	CUROFF
  1A9B'   E5                    	PUSH	H
  1A9C'   CD 0000*              	CALL	CHARAT
  1A9F'   E1                    	POP	H
  1AA0'   FE 20                 	CPI	' '
  1AA2'   CA 1AAA'              	JZ	VBI_SK
  1AA5'   FE 09                 	CPI	TAB
  1AA7'   C2 1AAE'              	JNZ	SETINM
  1AAA'                         VBI_SK:
  1AAA'   23                    	INX	H		; blanks only: past the last of them
  1AAB'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1AAE'                         SETINM:
  1AAE'   CD 086D'              	CALL	SETMOV
  1AB1'                         SETINS:
  1AB1'   3E 01                 	MVI	A,EM_INS
  1AB3'   32 0000*              	STA	EDMODE
  1AB6'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1AB7'                         ATCEND:
  1AB7'   CD 0774'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1ABA'   C8                    	RZ
  1ABB'   CD 077F'              	CALL	CURCHR		; A = the char under the cursor
  1ABE'   FE 0D                 	CPI	CR
  1AC0'   C8                    	RZ
  1AC1'   FE 0A                 	CPI	LF
  1AC3'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1AC4'                         OPNBRK:
  1AC4'   CD 243D'              	CALL	PUTBRK
  1AC7'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1ACA'   23                    	INX	H
  1ACB'   22 0000*              	SHLD	LNDLT
  1ACE'   C3 0177'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1AD1'                         ENDBRK:
  1AD1'   CD 0774'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1AD4'   C0                    	RNZ
  1AD5'   CD 1AC4'              	CALL	OPNBRK
  1AD8'   CD 0000*              	CALL	CUROFF
  1ADB'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1ADC'   2B                    	DCX	H		;   line, with its own terminator after it
  1ADD'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1AE0'                         VC_O:
  1AE0'   CD 078B'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1AE3'   CD 1A2F'              	CALL	CEND
  1AE6'   CD 0000*              	CALL	GOTO
  1AE9'   CD 1AC4'              	CALL	OPNBRK
  1AEC'   CD 1AD1'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1AEF'   CD 0895'              	CALL	SETILN		;   needs a terminator of its own to exist
  1AF2'   C3 1AB1'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1AF5'                         VCB_O:
  1AF5'   CD 078B'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1AF8'   CD 0693'              	CALL	BOL
  1AFB'   CD 0000*              	CALL	GOTO
  1AFE'   CD 1AC4'              	CALL	OPNBRK
  1B01'   CD 0000*              	CALL	CUROFF
  1B04'   2B                    	DCX	H
  1B05'   2B                    	DCX	H
  1B06'   CD 0000*              	CALL	GOTO
  1B09'   CD 0895'              	CALL	SETILN
  1B0C'   C3 1AB1'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


                                ; vim's '3J' joins three lines.
  1B0F'                         VCB_J:
  1B0F'   CD 078B'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1B12'   CD 1A2F'              	CALL	CEND		; the join point: this line's content end
  1B15'   22 0000*              	SHLD	OPLO
  1B18'   CD 0000*              	CALL	CUROFF
  1B1B'   CD 072A'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1B1E'   E5                    	PUSH	H
  1B1F'   CD 0000*              	CALL	LOGLEN
  1B22'   D1                    	POP	D		; DE = that start
  1B23'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1B26'   CA 086D'              	JZ	SETMOV
  1B29'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1B2A'                         VJ_WS:
  1B2A'   E5                    	PUSH	H
  1B2B'   CD 0000*              	CALL	LOGLEN
  1B2E'   D1                    	POP	D		; DE = the scan
  1B2F'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1B32'   CA 1B49'              	JZ	VJ_DEL
  1B35'   EB                    	XCHG			; HL = the scan
  1B36'   E5                    	PUSH	H
  1B37'   CD 0000*              	CALL	CHARAT
  1B3A'   E1                    	POP	H
  1B3B'   FE 20                 	CPI	' '
  1B3D'   CA 1B45'              	JZ	VJ_SKIP
  1B40'   FE 09                 	CPI	TAB
  1B42'   C2 1B49'              	JNZ	VJ_DEL
  1B45'                         VJ_SKIP:
  1B45'   23                    	INX	H
  1B46'   C3 1B2A'              	JMP	VJ_WS
  1B49'                         VJ_DEL:
  1B49'   22 0000*              	SHLD	OPHI
  1B4C'   CD 18BE'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1B4F'   CD 08A4'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1B52'   CD 0774'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1B55'   CA 1A40'              	JZ	CLAMPE
  1B58'   CD 077F'              	CALL	CURCHR		; the first char of what was appended
  1B5B'   FE 0D                 	CPI	CR
  1B5D'   CA 1A40'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1B60'   FE 0A                 	CPI	LF
  1B62'   CA 1A40'              	JZ	CLAMPE
  1B65'   FE 29                 	CPI	')'
  1B67'   CA 1A40'              	JZ	CLAMPE		; vim puts no space before a ')'
  1B6A'   CD 0000*              	CALL	CUROFF
  1B6D'   7C                    	MOV	A,H
  1B6E'   B5                    	ORA	L
  1B6F'   CA 1B85'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1B72'   2B                    	DCX	H
  1B73'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1B76'   FE 20                 	CPI	' '
  1B78'   CA 1A40'              	JZ	CLAMPE
  1B7B'   FE 09                 	CPI	TAB
  1B7D'   CA 1A40'              	JZ	CLAMPE
  1B80'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1B82'   CA 1A40'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1B85'                         VJ_SP:
  1B85'   3E 20                 	MVI	A,' '
  1B87'   CD 0000*              	CALL	PUTGAP
  1B8A'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1B8D'   2B                    	DCX	H
  1B8E'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1B91'                         VC_TILD:
  1B91'   CD 0798'              	CALL	GETCNT
  1B94'   CD 0873'              	CALL	SETLIN		; only this row changes
  1B97'   CD 0A25'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1B9A'   CD 0774'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1B9D'   CA 086D'              	JZ	SETMOV
  1BA0'   CD 077F'              	CALL	CURCHR		; A = the char under the cursor
  1BA3'   FE 0D                 	CPI	CR
  1BA5'   CA 086D'              	JZ	SETMOV		; the line's end: nothing to toggle
  1BA8'   FE 0A                 	CPI	LF
  1BAA'   CA 086D'              	JZ	SETMOV
  1BAD'   47                    	MOV	B,A
  1BAE'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1BB0'   FE 41                 	CPI	'A'
  1BB2'   DA 1BBE'              	JC	VT_PUT		; below 'A': no case
  1BB5'   FE 5B                 	CPI	'Z'+1
  1BB7'   D2 1BBE'              	JNC	VT_PUT		; above 'Z': no case
  1BBA'   78                    	MOV	A,B
  1BBB'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1BBD'   47                    	MOV	B,A
  1BBE'                         VT_PUT:
  1BBE'   78                    	MOV	A,B
  1BBF'   32 0000*              	STA	VRCH		; the calls below do not preserve B
  1BC2'   CD 0177'              	CALL	MARKMOD
  1BC5'   21 0001               	LXI	H,1
  1BC8'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1BCB'   3A 0000*              	LDA	VRCH
  1BCE'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1BD1'   C3 1A40'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  1BD4'                         VC_R:
  1BD4'   CD 0785'              	CALL	MOVCNT		; a cursor motion, and its count
  1BD7'   3E 03                 	MVI	A,PR
  1BD9'   32 0000*              	STA	GPEND
  1BDC'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1BDD'                         VR_DO:
  1BDD'   AF                    	XRA	A
  1BDE'   32 0000*              	STA	GPEND
  1BE1'   79                    	MOV	A,C
  1BE2'   32 0000*              	STA	VRCH		; the calls below do not preserve C
  1BE5'   CD 0873'              	CALL	SETLIN		; only this row changed
  1BE8'   CD 0A25'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1BEB'   CD 0774'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1BEE'   CA 086D'              	JZ	SETMOV		; the end of the text: vim does nothing
  1BF1'   CD 077F'              	CALL	CURCHR		; A = the char under the cursor
  1BF4'   FE 0D                 	CPI	CR
  1BF6'   CA 086D'              	JZ	SETMOV		; the line's end: nothing to replace
  1BF9'   FE 0A                 	CPI	LF
  1BFB'   CA 086D'              	JZ	SETMOV
  1BFE'   06 02                 	MVI	B,2		; a cell for a cell: the char is the paint
  1C00'   CD 0879'              	CALL	SETCEL
  1C03'   CD 0177'              	CALL	MARKMOD
  1C06'   21 0001               	LXI	H,1
  1C09'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1C0C'   3A 0000*              	LDA	VRCH
  1C0F'   FE 0D                 	CPI	CR
  1C11'   CA 1C1E'              	JZ	VR_CR
  1C14'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1C17'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1C1A'   2B                    	DCX	H		;   out, which moves every logical offset
  1C1B'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1C1E'                         VR_CR:
  1C1E'   CD 1AC4'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1C21'   CD 1AD1'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1C24'   CD 0895'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1C27'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1C29'   32 0000*              	STA	ILABOV
  1C2C'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1C2D'                         VCB_R:
  1C2D'   CD 0798'              	CALL	GETCNT
  1C30'   CD 086D'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1C33'   21 0000               	LXI	H,0
  1C36'   22 0000*              	SHLD	RPDEL		; nothing of ours to put back yet
  1C39'   22 0000*              	SHLD	RPAPP
  1C3C'   3E 02                 	MVI	A,EM_REP
  1C3E'   32 0000*              	STA	EDMODE
  1C41'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1C42'                         VC_D:
  1C42'   3E 64                 	MVI	A,'d'
  1C44'   32 0000*              	STA	PENDOP
  1C47'   C3 086D'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1C4A'                         VC_C:
  1C4A'   3E 63                 	MVI	A,'c'
  1C4C'   32 0000*              	STA	PENDOP
  1C4F'   C3 086D'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1C52'                         VD_DD:
  1C52'   CD 0A25'              	CALL	GLSTAL
  1C55'   CD 0798'              	CALL	GETCNT
  1C58'   22 0000*              	SHLD	CNTV
  1C5B'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1C5D'   32 0000*              	STA	DDSNG
  1C60'   2B                    	DCX	H
  1C61'   7C                    	MOV	A,H
  1C62'   B5                    	ORA	L
  1C63'   C2 1C71'              	JNZ	VDD_LS
  1C66'   3E 01                 	MVI	A,1
  1C68'   32 0000*              	STA	DDSNG
  1C6B'   CD 18E8'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1C6E'   C3 1C77'              	JMP	VDD_GO
  1C71'                         VDD_LS:
  1C71'   CD 09DE'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1C74'   DA 086D'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1C77'                         VDD_GO:
  1C77'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1C7A'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1C7D'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1C80'   CD 26A0'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1C83'   CD 094F'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1C86'   2A 0000*              	LHLD	CNTV
  1C89'   CD 0000*              	CALL	SETC0
  1C8C'                         VDD_FW:
  1C8C'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1C8F'   DA 1DDD'              	JC	QREFUS		; ... which has no room for them
  1C92'   CD 07AD'              	CALL	CNTTST
  1C95'   C2 1C8C'              	JNZ	VDD_FW
  1C98'   CD 0177'              	CALL	MARKMOD
  1C9B'   CD 0BF6'              	CALL	ATEOF
  1C9E'   D2 1CB9'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1CA1'   3E 00                 	MVI	A,0
  1CA3'   32 0000*              	STA	DDSNG		; deleted to the end: full repaint
  1CA6'   CD 12D6'              	CALL	ONFST
  1CA9'   CA 0973'              	JZ	FNBLNK		; nothing left before it
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1CAC'   21 0001               	LXI	H,1		; onto the new last line
  1CAF'   CD 0000*              	CALL	SETBWD
  1CB2'   2A 0000*              	LHLD	LNDLT
  1CB5'   2B                    	DCX	H
  1CB6'   22 0000*              	SHLD	LNDLT
  1CB9'                         VDD_UP:
  1CB9'   CD 0973'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1CBC'   3A 0000*              	LDA	DDSNG
  1CBF'   B7                    	ORA	A
  1CC0'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1CC1'   3E 03                 	MVI	A,R_DLIN
  1CC3'   32 0000*              	STA	RINTENT
  1CC6'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1CC7'                         QEMPTY:
  1CC7'   2A 0000*              	LHLD	QBEG
  1CCA'   EB                    	XCHG
  1CCB'   2A 0000*              	LHLD	QEND
  1CCE'   7C                    	MOV	A,H
  1CCF'   BA                    	CMP	D
  1CD0'   C0                    	RNZ
  1CD1'   7D                    	MOV	A,L
  1CD2'   BB                    	CMP	E
  1CD3'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1CD4'                         VC_Y:
  1CD4'   3E 79                 	MVI	A,'y'
  1CD6'   32 0000*              	STA	PENDOP
  1CD9'   C3 086D'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1CDC'                         VY_YY:
  1CDC'   21 0000*              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1CDF'   CD 0444'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1CE2'   CD 0000*              	CALL	CUROFF
  1CE5'   22 0000*              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1CE8'   CD 0693'              	CALL	BOL
  1CEB'   22 0000*              	SHLD	YPT		; where the lines come from, to put them back
  1CEE'   CD 1E8A'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1CF1'   CD 1ECD'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1CF4'   D2 1E91'              	JNC	YNDONE
  1CF7'   21 1C52'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1CFA'   C3 1D26'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1CFD'                         OPYANK:
  1CFD'   CD 1900'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1D00'   2A 0000*              	LHLD	OPSTA
  1D03'   EB                    	XCHG			; DE = start
  1D04'   2A 0000*              	LHLD	OPEND2		; HL = end
  1D07'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1D0A'   D2 1D0E'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1D0D'   EB                    	XCHG			; ... otherwise the start is
  1D0E'                         OPY_LO:
  1D0E'   22 0000*              	SHLD	YOFF
  1D11'   2A 0000*              	LHLD	OPLO
  1D14'   22 0000*              	SHLD	YPT		; where the lines come from, to put them back
  1D17'   CD 1E8A'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1D1A'   CD 1F45'              	CALL	YNSPAN		; copied where they lie, if there is room
  1D1D'   D2 1E91'              	JNC	YNDONE
  1D20'   21 1E55'              	LXI	H,YSPAN
  1D23'   C3 1D26'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1D26'                         YKGO:
  1D26'   22 0000*              	SHLD	YACT
  1D29'   2A 0000*              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1D2C'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1D2D'   2A 0000*              	LHLD	YOFF		;   survive this -- the put-back below can page
  1D30'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1D33'   22 0000*              	SHLD	YCOL		;   them -- but a distance within the lines does
  1D36'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1D39'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1D3A'   2A 0000*              	LHLD	YPT		;   run past it, and YPT, an offset into the
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1D3D'   EB                    	XCHG			;   window as it was, then names other text
  1D3E'   E1                    	POP	H
  1D3F'   CD 0000*              	CALL	SUBHD
  1D42'   EB                    	XCHG			; DE = how far behind the cursor they start
  1D43'   CD 13B8'              	CALL	CURFP
  1D46'   06 00                 	MVI	B,0
  1D48'   CD 13AE'              	CALL	SUB24
  1D4B'   22 0000*              	SHLD	YPFP
  1D4E'   32 0002*              	STA	YPFP+2
  1D51'   3A 0000*              	LDA	MODF
  1D54'   32 0000*              	STA	YMODF
  1D57'   3A 0000*              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1D5A'   32 0000*              	STA	YDCHG		;   a yank must not become the last change
  1D5D'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1D60'   32 0000*              	STA	YURPL		;   back are not a change to undo either
  1D63'   3E 01                 	MVI	A,1
  1D65'   32 0000*              	STA	UNDRPL
  1D68'   32 0000*              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1D6B'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1D6E'   22 0000*              	SHLD	YLDLT
  1D71'   CD 0000*              	CALL	LOGLEN
  1D74'   22 0000*              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1D77'   2A 0000*              	LHLD	YACT
  1D7A'   CD 1DDC'              	CALL	YCALL		; the lines out of the file, into the register
  1D7D'   3A 0000*              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1D80'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1D82'   CA 1DC0'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1D85'   CD 0000*              	CALL	LOGLEN
  1D88'   EB                    	XCHG
  1D89'   2A 0000*              	LHLD	YWAS
  1D8C'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1D8F'   CA 1DA1'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1D92'   21 0000*              	LXI	H,YPFP		; back to where they came from, by its place in
  1D95'   CD 03FB'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1D98'   CD 03AC'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1D9B'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1D9E'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1DA1'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1DA1'   2A 0000*              	LHLD	YPFP		;   cursor is still owed its place)
  1DA4'   EB                    	XCHG
  1DA5'   2A 0000*              	LHLD	YCOL
  1DA8'   19                    	DAD	D
  1DA9'   22 0000*              	SHLD	MKPOS
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1DAC'   3A 0002*              	LDA	YPFP+2
  1DAF'   CE 00                 	ACI	0
  1DB1'   32 0002*              	STA	MKPOS+2
  1DB4'   CD 03AC'              	CALL	MKPAGE
  1DB7'   CD 0000*              	CALL	GOTO
  1DBA'                         YK_RST:
  1DBA'   2A 0000*              	LHLD	YLDLT
  1DBD'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1DC0'                         YK_RF:
  1DC0'   3A 0000*              	LDA	YMODF
  1DC3'   32 0000*              	STA	MODF
  1DC6'   3A 0000*              	LDA	YDCHG
  1DC9'   32 0000*              	STA	DOTCHG
  1DCC'   3A 0000*              	LDA	YURPL
  1DCF'   32 0000*              	STA	UNDRPL
  1DD2'   AF                    	XRA	A
  1DD3'   32 0000*              	STA	MKHOLD
  1DD6'   CD 0A25'              	CALL	GLSTAL
  1DD9'   C3 08AA'              	JMP	SETFUL		; the cheap paint cannot carry this
  1DDC'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1DDD'                         QREFUS:
  1DDD'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1DE0'   CD 1CC7'              	CALL	QEMPTY
  1DE3'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1DE6'   CD 0000*              	CALL	QKILL
  1DE9'   3A 0000*              	LDA	MKHOLD
  1DEC'   B7                    	ORA	A
  1DED'   C2 1DFC'              	JNZ	QRF_Y
  1DF0'   21 0000*              	LXI	H,MKSAV
  1DF3'   11 0000*              	LXI	D,MKTAB
  1DF6'   CD 26A0'              	CALL	COPY12
  1DF9'   CD 0000*              	CALL	UNDCLR
  1DFC'                         QRF_Y:
  1DFC'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1DFE'   32 0000*              	STA	MSGWHT
  1E01'   C3 16FF'              	JMP	OPG_HM
                                
                                ;MEMABT -- the arena has no room for what this key asked of it: WordMaster's
                                ; 'MEM SHORTAGE', 'MEM FULL' or 'QBUF FULL', which BUF.MAC's MEMERR sends here
                                ; once the screen is up (issue #39).  WordMaster abandons the command there and
                                ; goes back to its prompt, and so does this: the key's stack goes, and with it
                                ; whatever the key was part way through.  Each of those errors is raised before
                                ; a byte of text moves, so the text is whole, though not all of the change may
                                ; have been made.  The register is emptied -- it is what holds the room -- or
                                ; the repaint that follows would run into the same wall, and the half-done
                                ; command leaves nothing behind: no count, no pending operator, no '.' to repeat
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


                                ; it and no 'u' to undo half of it.  The bottom row says so.
                                ;
                                ; Two cases still end the editor, through ERRMSG as all three always did: a
                                ; second shortage before the next key (the repaint, with the register already
                                ; given back -- there is nothing left to give), and one in the middle of a yank
                                ; that took its lines OUT to put them back (YKGO, MKHOLD set): the register IS
                                ; those lines then, and emptying it would cut them from the file.
  1E04'                         MEMABT:
  1E04'   3A 0000*              	LDA	ABTFLG
  1E07'   21 0000*              	LXI	H,MKHOLD
  1E0A'   B6                    	ORA	M
  1E0B'   C2 0000*              	JNZ	ERRMSG		; the message is still on the stack for it
  1E0E'   3C                    	INR	A		; A = 1
  1E0F'   32 0000*              	STA	ABTFLG		; ... until the next key (CMDDIS)
  1E12'   31 0000*              	LXI	SP,VISTK	; the key's stack: VI.MAC's loop runs at the top
  1E15'   32 0000*              	STA	MODF		; the text may have changed part way
  1E18'   32 0000*              	STA	FORCEF		; the frame on the screen may be half drawn
  1E1B'   32 0000*              	STA	DOTOVF		; a half command is no change for '.'
  1E1E'   3A 0000*              	LDA	EDMODE		; in insert or replace mode the recording runs
  1E21'   B7                    	ORA	A		;   on to the ESC, DOTOVF keeping it from '.';
  1E22'   C2 1E2C'              	JNZ	MAB_1		;   otherwise the next key starts a new one
  1E25'   32 0000*              	STA	DOTCHG
  1E28'   3C                    	INR	A
  1E29'   32 3232'              	STA	DOTSTA
  1E2C'                         MAB_1:
  1E2C'   AF                    	XRA	A
  1E2D'   32 0000*              	STA	GPEND
  1E30'   32 0000*              	STA	PENDOP
  1E33'   32 0000*              	STA	DOTRPL		; a '.' replay is over
  1E36'   32 0000*              	STA	UNDRPL		; ... and so is a 'u' one
  1E39'   32 0000*              	STA	BRKARM
  1E3C'   32 0000*              	STA	BRKHIT
  1E3F'   CD 0000*              	CALL	CLRCNT		; no count
  1E42'   CD 0000*              	CALL	UNDCLR		; nothing 'u' can trust
  1E45'   CD 0000*              	CALL	QKILL		; the room back
  1E48'   3E 05                 	MVI	A,MW_MEM
  1E4A'   32 0000*              	STA	MSGWHT
  1E4D'   3E 00                 	MVI	A,R_FULL
  1E4F'   32 0000*              	STA	RINTENT
  1E52'   C3 0000*              	JMP	MLDRAW		; VI.MAC: the repaint, then the next key
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the REGISTER holds the
                                ; span's length, and asks for ONE line a pass.
                                ;
                                ; The register, not the text: this loop used to stop when the text in RAM was
                                ; the span's length shorter than at the start (issue #32).  But QPUTLN's MKGAP
                                ; can page the window's top out to make room, and every record that goes takes
                                ; 128 bytes off the text that this loop never took.  With the arena nearly
                                ; full the page-outs alone went past that target, and the loop stopped after a
                                ; line, or partway through one (GOLINE stops short when the window pages): the
                                ; register held 49 bytes of a 631-byte 'y''a', and YKGO put back only those.
                                ; The register starts empty (QKILL below) and only this loop fills it, so its
                                ; length is exactly what has been taken, whatever the pager did meanwhile.
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1E55'                         YSPAN:
  1E55'   CD 0A25'              	CALL	GLSTAL
  1E58'   CD 18B3'              	CALL	OPSPNL		; HL = the span's length
  1E5B'   22 0000*              	SHLD	YTGT		; what the register holds when the span is out
  1E5E'   2A 0000*              	LHLD	OPLO
  1E61'   CD 0000*              	CALL	GOTO
  1E64'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1E67'                         YS_LP:
  1E67'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1E6A'   CD 0000*              	CALL	SETC0
  1E6D'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1E70'   DA 1DDD'              	JC	QREFUS		; ... which has no room for it
  1E73'   2A 0000*              	LHLD	QBEG
  1E76'   EB                    	XCHG
  1E77'   2A 0000*              	LHLD	QEND
  1E7A'   CD 0000*              	CALL	SUBHD
  1E7D'   EB                    	XCHG			; DE = what the register holds
  1E7E'   2A 0000*              	LHLD	YTGT
  1E81'   CD 0000*              	CALL	CMP16		; CY iff it is short of the span: another pass
  1E84'   DA 1E67'              	JC	YS_LP		;   (never more than the span over whole lines)
  1E87'   C3 0177'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1E8A'                         YNPRE:
  1E8A'   2A 0000*              	LHLD	PGTOPM
  1E8D'   22 0000*              	SHLD	YNPG
  1E90'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1E91'                         YNDONE:
  1E91'   2A 0000*              	LHLD	YOFF
  1E94'   CD 0000*              	CALL	GOTO
  1E97'   2A 0000*              	LHLD	PGTOPM
  1E9A'   EB                    	XCHG
  1E9B'   2A 0000*              	LHLD	YNPG
  1E9E'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1EA1'   C2 08AA'              	JNZ	SETFUL		; it moved under us: repaint after all
  1EA4'   C3 086D'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1EA7'                         YNROOM:
  1EA7'   11 0100               	LXI	D,100H
  1EAA'   19                    	DAD	D
  1EAB'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1EAC'   E5                    	PUSH	H		; the span plus its slack
  1EAD'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1EB0'   EB                    	XCHG			; HL = free
  1EB1'   D1                    	POP	D		; DE = the span plus its slack
  1EB2'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1EB5'   DA 1EBD'              	JC	YNR_OK
  1EB8'   CA 1EBD'              	JZ	YNR_OK
  1EBB'   37                    	STC			; not enough: the delete-and-put-back path
  1EBC'   C9                    	RET
  1EBD'                         YNR_OK:
  1EBD'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1EBE'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1EBF'                         YNGO:
  1EBF'   C5                    	PUSH	B
  1EC0'   CD 0798'              	CALL	GETCNT		; spent here: this yank is happening
  1EC3'   CD 0A25'              	CALL	GLSTAL
  1EC6'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1EC9'   C1                    	POP	B
  1ECA'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1ECD'                         YNCOPY:
  1ECD'   2A 0000*              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1ED0'   7C                    	MOV	A,H		;   the count itself
  1ED1'   B5                    	ORA	L
  1ED2'   C2 1ED8'              	JNZ	YNC_HV
  1ED5'   21 0001               	LXI	H,1
  1ED8'                         YNC_HV:
  1ED8'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1ED9'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1EDA'   B4                    	ORA	H
  1EDB'   CA 1EE6'              	JZ	YNC_M
  1EDE'   E5                    	PUSH	H
  1EDF'   CD 09DE'              	CALL	ONLAST		; vim: a count over one on the last line does
  1EE2'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1EE3'   DA 1EF8'              	JC	YNC_RF
  1EE6'                         YNC_M:
  1EE6'   E5                    	PUSH	H
  1EE7'   CD 094F'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1EEA'   E1                    	POP	H
  1EEB'   CD 1F00'              	CALL	YNLINE		; BC = the span, measured where it stands
  1EEE'   D8                    	RC			; not measurable here: let the pager answer it
  1EEF'   60                    	MOV	H,B
  1EF0'   69                    	MOV	L,C
  1EF1'   CD 1EA7'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1EF4'   D8                    	RC			; no: the delete-and-put-back path
  1EF5'   C3 1EBF'              	JMP	YNGO
  1EF8'                         YNC_RF:
  1EF8'   CD 0798'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1EFB'   CD 0A25'              	CALL	GLSTAL		;   register alone, and that is the command
  1EFE'   B7                    	ORA	A		; NC: done
  1EFF'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1F00'                         YNLINE:
  1F00'   22 0000*              	SHLD	YNCNT		; the lines it still wants
  1F03'   2A 0000*              	LHLD	GAPEND
  1F06'                         YNL_LP:
  1F06'   EB                    	XCHG			; DE = the scan
  1F07'   2A 0000*              	LHLD	TXTEND
  1F0A'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  1F0D'   EB                    	XCHG			; HL = the scan
  1F0E'   D2 1F2E'              	JNC	YNL_EN		; the resident text ran out
  1F11'   7E                    	MOV	A,M
  1F12'   23                    	INX	H
  1F13'   FE 0A                 	CPI	LF
  1F15'   C2 1F06'              	JNZ	YNL_LP
  1F18'   E5                    	PUSH	H
  1F19'   2A 0000*              	LHLD	YNCNT
  1F1C'   2B                    	DCX	H
  1F1D'   22 0000*              	SHLD	YNCNT
  1F20'   7C                    	MOV	A,H
  1F21'   B5                    	ORA	L
  1F22'   E1                    	POP	H
  1F23'   C2 1F06'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1F26'   EB                    	XCHG			; DE = past the last of them
  1F27'   2A 0000*              	LHLD	GAPEND
  1F2A'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1F2B'   C3 1F3C'              	JMP	YNL_BC
  1F2E'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1F2E'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1F31'   C2 1F43'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1F34'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1F37'   EB                    	XCHG			;   count clamps to it as vim's does
  1F38'   2A 0000*              	LHLD	GAPEND
  1F3B'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1F3C'                         YNL_BC:
  1F3C'   CD 0000*              	CALL	SUBHD		; HL = the span
  1F3F'   44                    	MOV	B,H
  1F40'   4D                    	MOV	C,L
  1F41'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1F42'   C9                    	RET
  1F43'                         YNL_NO:
  1F43'   37                    	STC
  1F44'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1F45'                         YNSPAN:
  1F45'   CD 18B3'              	CALL	OPSPNL		; HL = the span's length
  1F48'   44                    	MOV	B,H
  1F49'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1F4A'   CD 1EA7'              	CALL	YNROOM
  1F4D'   D8                    	RC			; no room: the delete-and-put-back path
  1F4E'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1F4F'   2A 0000*              	LHLD	OPLO
  1F52'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1F55'   C1                    	POP	B
  1F56'   C3 1EBF'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1F59'                         VC_P:
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  1F59'   CD 1CC7'              	CALL	QEMPTY
  1F5C'   CA 202F'              	JZ	VP_BEL
  1F5F'   CD 0798'              	CALL	GETCNT
  1F62'   22 0000*              	SHLD	PCNT
  1F65'   CD 0000*              	CALL	CUROFF
  1F68'   CD 072A'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1F6B'   C3 1F80'              	JMP	VP_GO
  1F6E'                         VCB_P:
  1F6E'   CD 1CC7'              	CALL	QEMPTY
  1F71'   CA 202F'              	JZ	VP_BEL
  1F74'   CD 0798'              	CALL	GETCNT
  1F77'   22 0000*              	SHLD	PCNT
  1F7A'   CD 0000*              	CALL	CUROFF
  1F7D'   CD 0693'              	CALL	BOL
  1F80'                         VP_GO:
  1F80'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1F83'   CD 0000*              	CALL	CUROFF
  1F86'   EB                    	XCHG
  1F87'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1F8A'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1F8D'   DA 1FA2'              	JC	VP_IN
  1F90'   EB                    	XCHG			; HL = the put point = LOGLEN
  1F91'   7C                    	MOV	A,H
  1F92'   B5                    	ORA	L
  1F93'   CA 1F9F'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1F96'   2B                    	DCX	H
  1F97'   CD 0000*              	CALL	CHARAT
  1F9A'   FE 0A                 	CPI	LF
  1F9C'   CA 1FA2'              	JZ	VP_IN
  1F9F'                         VP_BRK:
  1F9F'   CD 1AC4'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1FA2'                         VP_IN:
  1FA2'   21 0000*              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1FA5'   CD 0444'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1FA8'   CD 1401'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1FAB'   2A 0000*              	LHLD	QBEG
  1FAE'   EB                    	XCHG
  1FAF'   2A 0000*              	LHLD	QEND
  1FB2'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1FB5'   EB                    	XCHG
  1FB6'   22 0000*              	SHLD	PLFS
  1FB9'   2A 0000*              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1FBC'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1FBD'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1FBE'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1FC0'   C2 1FC4'              	JNZ	VP_PZ
  1FC3'   7D                    	MOV	A,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  1FC4'                         VP_PZ:
  1FC4'   32 0000*              	STA	PCPY
  1FC7'                         VP_LP:
  1FC7'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1FCA'   2A 0000*              	LHLD	LNDLT
  1FCD'   EB                    	XCHG
  1FCE'   2A 0000*              	LHLD	PLFS
  1FD1'   19                    	DAD	D
  1FD2'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1FD5'   2A 0000*              	LHLD	PCNT
  1FD8'   2B                    	DCX	H
  1FD9'   22 0000*              	SHLD	PCNT
  1FDC'   7C                    	MOV	A,H
  1FDD'   B5                    	ORA	L
  1FDE'   C2 1FC7'              	JNZ	VP_LP
  1FE1'   CD 0177'              	CALL	MARKMOD
  1FE4'   21 0000*              	LXI	H,PPFP
  1FE7'   CD 03FB'              	CALL	MKLOAD
  1FEA'   CD 0408'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1FED'   D2 2020'              	JNC	VP_PGD
  1FF0'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1FF3'   CD 0A25'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1FF6'   3A 0000*              	LDA	PCPY
  1FF9'   B7                    	ORA	A
  1FFA'   CA 0973'              	JZ	FNBLNK
  1FFD'   2A 0000*              	LHLD	PLFS
  2000'   7C                    	MOV	A,H
  2001'   B7                    	ORA	A
  2002'   C2 0973'              	JNZ	FNBLNK
  2005'   3A 0000*              	LDA	PCPY
  2008'   CD 109E'              	CALL	MULSAT		; HL = the lines this put put, saturated
  200B'   7C                    	MOV	A,H
  200C'   B7                    	ORA	A
  200D'   C2 0973'              	JNZ	FNBLNK
  2010'   7D                    	MOV	A,L
  2011'   B7                    	ORA	A
  2012'   CA 0973'              	JZ	FNBLNK
  2015'   F5                    	PUSH	PSW
  2016'   CD 0895'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  2019'   F1                    	POP	PSW
  201A'   32 322E'              	STA	ILN		; ... which the lines put now replace
  201D'   C3 0973'              	JMP	FNBLNK
  2020'                         VP_PGD:				; the put paged its first line out: page back
  2020'   CD 03AC'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  2023'   CD 0000*              	CALL	GOTO
  2026'   CD 0A25'              	CALL	GLSTAL
  2029'   CD 1419'              	CALL	GPLACE
  202C'   C3 08AA'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  202F'                         VP_BEL:
  202F'   CD 0798'              	CALL	GETCNT		; the count is spent either way
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2032'   0E 07                 	MVI	C,BEL
  2034'   CD 0000*              	CALL	BCONOU
  2037'   C3 086D'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  203A'                         VIREP:
  203A'   79                    	MOV	A,C
  203B'   FE 1B                 	CPI	ESC
  203D'   CA 2190'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  2040'   FE 0D                 	CPI	CR
  2042'   CA 20B5'              	JZ	VP_CR
  2045'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  2047'   CA 20B5'              	JZ	VP_CR
  204A'   FE 08                 	CPI	BS
  204C'   CA 20C1'              	JZ	VP_BS
  204F'   FE 7F                 	CPI	DEL
  2051'   CA 20C1'              	JZ	VP_BS
  2054'   32 0000*              	STA	VRCH		; the calls below do not preserve C
  2057'   CD 0873'              	CALL	SETLIN		; this row changed
  205A'   CD 0177'              	CALL	MARKMOD
  205D'   CD 1AB7'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  2060'   CA 20A0'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  2063'   CD 077F'              	CALL	CURCHR
  2066'   06 01                 	MVI	B,1
  2068'   CD 0879'              	CALL	SETCEL
  206B'   3A 0000*              	LDA	VRCH
  206E'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  2071'   2A 0000*              	LHLD	RPDEL
  2074'   7C                    	MOV	A,H
  2075'   B5                    	ORA	L
  2076'   CA 208C'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  2079'   2A 0000*              	LHLD	GAPEND
  207C'   EB                    	XCHG
  207D'   2A 0000*              	LHLD	RPGE
  2080'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  2083'   CA 208C'              	JZ	VP_OVW
  2086'   21 0000               	LXI	H,0
  2089'   22 0000*              	SHLD	RPDEL		; the text moved: those originals are gone
  208C'                         VP_OVW:
  208C'   21 0001               	LXI	H,1
  208F'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  2092'   2A 0000*              	LHLD	GAPEND
  2095'   22 0000*              	SHLD	RPGE
  2098'   2A 0000*              	LHLD	RPDEL
  209B'   23                    	INX	H
  209C'   22 0000*              	SHLD	RPDEL
  209F'   C9                    	RET
  20A0'                         VP_APP:
  20A0'   3E 20                 	MVI	A,' '		; (the cell there is blank)
  20A2'   06 01                 	MVI	B,1
  20A4'   CD 0879'              	CALL	SETCEL
  20A7'   3A 0000*              	LDA	VRCH
  20AA'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  20AD'   2A 0000*              	LHLD	RPAPP
  20B0'   23                    	INX	H
  20B1'   22 0000*              	SHLD	RPAPP
  20B4'   C9                    	RET
  20B5'                         VP_CR:
  20B5'   21 0000               	LXI	H,0
  20B8'   22 0000*              	SHLD	RPDEL		; a line break ends what BS can put back
  20BB'   22 0000*              	SHLD	RPAPP
  20BE'   C3 214C'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  20C1'                         VP_BS:
  20C1'   2A 0000*              	LHLD	RPAPP
  20C4'   7C                    	MOV	A,H
  20C5'   B5                    	ORA	L
  20C6'   CA 20D3'              	JZ	VP_BSD
  20C9'   2B                    	DCX	H
  20CA'   22 0000*              	SHLD	RPAPP		; an appended char: it just goes
  20CD'   CD 0873'              	CALL	SETLIN
  20D0'   C3 0000*              	JMP	DELPRV
  20D3'                         VP_BSD:
  20D3'   2A 0000*              	LHLD	RPDEL
  20D6'   7C                    	MOV	A,H
  20D7'   B5                    	ORA	L
  20D8'   CA 20FF'              	JZ	VP_BSM		; nothing of ours left
  20DB'   2A 0000*              	LHLD	GAPEND
  20DE'   EB                    	XCHG
  20DF'   2A 0000*              	LHLD	RPGE
  20E2'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  20E5'   C2 20FF'              	JNZ	VP_BSM
  20E8'   2A 0000*              	LHLD	RPDEL
  20EB'   2B                    	DCX	H
  20EC'   22 0000*              	SHLD	RPDEL
  20EF'   CD 0873'              	CALL	SETLIN
  20F2'   CD 0000*              	CALL	DELPRV		; the typed char goes
  20F5'   CD 0000*              	CALL	UNDELF		; the original comes back
  20F8'   2A 0000*              	LHLD	GAPEND
  20FB'   22 0000*              	SHLD	RPGE
  20FE'   C9                    	RET
  20FF'                         VP_BSM:
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  20FF'   CD 086D'              	CALL	SETMOV		; nothing changed: back over the text as it is
  2102'   C3 08FB'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  2105'                         VIINS:
  2105'   79                    	MOV	A,C
  2106'   FE 1B                 	CPI	ESC
  2108'   CA 2190'              	JZ	VI_ESC
  210B'   FE 0D                 	CPI	CR
  210D'   CA 214C'              	JZ	VI_CR
  2110'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  2112'   CA 214C'              	JZ	VI_CR
  2115'   FE 08                 	CPI	BS
  2117'   CA 2164'              	JZ	VI_BS
  211A'   FE 7F                 	CPI	DEL
  211C'   CA 2164'              	JZ	VI_BS
  211F'   79                    	MOV	A,C
  2120'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  2123'   CD 0177'              	CALL	MARKMOD
  2126'   CD 0873'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only for a plain printable char.  With
                                	;    a TAB after the cursor nothing past the TAB moves, so long as the
                                	;    TAB can give the cell up: the chars as far as it are the paint. ---
  2129'   79                    	MOV	A,C
  212A'   FE 20                 	CPI	' '
  212C'   D8                    	RC			; control char -> keep R_LINE
  212D'   FE 7F                 	CPI	DEL
  212F'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  2130'   CD 08B0'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  2133'   47                    	MOV	B,A
  2134'   3E 04                 	MVI	A,R_ICH
  2136'   32 0000*              	STA	RINTENT
  2139'   3E 03                 	MVI	A,3		; a TAB there: it takes the cell up if it can
  213B'   05                    	DCR	B		;   (SCRN.MAC knows where it stands)
  213C'   CA 2148'              	JZ	VI_ICH
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  213F'   CD 1AB7'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  2142'   3E 00                 	MVI	A,0
  2144'   C2 2148'              	JNZ	VI_ICH
  2147'   3C                    	INR	A
  2148'                         VI_ICH:
  2148'   32 0000*              	STA	ICHAPP
  214B'   C9                    	RET
  214C'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  214C'   CD 1AB7'              	CALL	ATCEND
  214F'   3E 00                 	MVI	A,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  2151'   CA 2155'              	JZ	VI_CRS
  2154'   3C                    	INR	A
  2155'                         VI_CRS:
  2155'   F5                    	PUSH	PSW
  2156'   CD 1AC4'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  2159'   CD 1AD1'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  215C'   CD 0895'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  215F'   F1                    	POP	PSW
  2160'   32 0000*              	STA	ILABOV
  2163'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  2164'                         VI_BS:
  2164'   CD 0000*              	CALL	PEEKL
  2167'   D8                    	RC			; start of the file: nothing to delete
  2168'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  216A'   CA 218A'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  216D'   47                    	MOV	B,A		;   and the screen repaints in full.  Any other
  216E'   CD 0873'              	CALL	SETLIN		;   char is inside the row -- redraw just that row
  2171'   78                    	MOV	A,B
  2172'   CD 088E'              	CALL	PLAINQ		; ... or, when it is one cell and no TAB follows
  2175'   D2 218A'              	JNC	VI_BSJ		;   to be drawn up short, let the terminal close
  2178'   CD 08B0'              	CALL	TAILTAB		;   the cell up (R_DCH, from the left of the
  217B'   87                    	ADD	A		;   cursor) -- or the TAB that follows take it
  217C'   3C                    	INR	A
  217D'   32 0000*              	STA	DCHBS		; 1, and 2 with it for the TAB
  2180'   3E 01                 	MVI	A,1
  2182'   32 322F'              	STA	DCHN
  2185'   3E 07                 	MVI	A,R_DCH
  2187'   32 0000*              	STA	RINTENT
  218A'                         VI_BSJ:
  218A'   CD 0177'              	CALL	MARKMOD
  218D'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  2190'                         VI_ESC:
  2190'   3E 00                 	MVI	A,EM_CMD
  2192'   32 0000*              	STA	EDMODE
  2195'   CD 086D'              	CALL	SETMOV
  2198'   CD 08FB'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  219B'   C3 0A25'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
                                ; The keys come through MKGETK, as a mark's letter does: they join the '.'
                                ; recording, and a '.' replay reads them back from it ('d/pat<CR>' then '.').
  219E'                         RDLINE:
  219E'   EB                    	XCHG			; HL = buffer
  219F'   22 0000*              	SHLD	RLPTR
  21A2'   3E 00                 	MVI	A,0
  21A4'   32 0000*              	STA	RLLEN
  21A7'   78                    	MOV	A,B
  21A8'   32 0000*              	STA	RLMAX
  21AB'   79                    	MOV	A,C
  21AC'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  21AF'                         RL_LP:
  21AF'   CD 01FC'              	CALL	MKGETK		; a '.' replay reads the line it recorded, and a
  21B2'   DA 2203'              	JC	RL_CAN		;   typed one is recorded ('d/pat<CR>'); ESC
  21B5'   79                    	MOV	A,C
  21B6'   FE 0D                 	CPI	CR
  21B8'   CA 2212'              	JZ	RL_DONE
  21BB'   FE 08                 	CPI	BS
  21BD'   CA 21EB'              	JZ	RL_BS
  21C0'   FE 7F                 	CPI	DEL
  21C2'   CA 21EB'              	JZ	RL_BS
  21C5'   FE 20                 	CPI	' '
  21C7'   DA 21AF'              	JC	RL_LP		; control char -> ignore
  21CA'   3A 0000*              	LDA	RLLEN
  21CD'   47                    	MOV	B,A
  21CE'   3A 0000*              	LDA	RLMAX
  21D1'   B8                    	CMP	B
  21D2'   CA 21AF'              	JZ	RL_LP		; full -> ignore
  21D5'   2A 0000*              	LHLD	RLPTR
  21D8'   71                    	MOV	M,C
  21D9'   23                    	INX	H
  21DA'   22 0000*              	SHLD	RLPTR
  21DD'   3A 0000*              	LDA	RLLEN
  21E0'   3C                    	INR	A
  21E1'   32 0000*              	STA	RLLEN
  21E4'   79                    	MOV	A,C
  21E5'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  21E8'   C3 21AF'              	JMP	RL_LP
  21EB'                         RL_BS:				; WM LINEPOP
  21EB'   3A 0000*              	LDA	RLLEN
  21EE'   B7                    	ORA	A
  21EF'   CA 2203'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  21F2'   3D                    	DCR	A
  21F3'   32 0000*              	STA	RLLEN
  21F6'   2A 0000*              	LHLD	RLPTR
  21F9'   2B                    	DCX	H
  21FA'   22 0000*              	SHLD	RLPTR
  21FD'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  2200'   C3 21AF'              	JMP	RL_LP
  2203'                         RL_CAN:
  2203'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  2205'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  2208'   CD 0873'              	CALL	SETLIN		; redraw one row
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  220B'   AF                    	XRA	A
  220C'   32 0000*              	STA	PSAVE		; ... and a 'd/' or 'c?' with it
  220F'   3E FF                 	MVI	A,0FFH		; cancelled
  2211'   C9                    	RET
  2212'                         RL_DONE:
  2212'   3E 0D                 	MVI	A,CR		; vim: the cursor waits under the prompt while
  2214'   CD 0000*              	CALL	OUTCH		;   the command runs, not after its last char
  2217'   AF                    	XRA	A
  2218'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  2219'                         VC_BZ:
  2219'   CD 086D'              	CALL	SETMOV
  221C'   3A 0000*              	LDA	GSAVE
  221F'   FE 02                 	CPI	PZ
  2221'   CA 222C'              	JZ	VZ_ZZ
  2224'   B7                    	ORA	A
  2225'   C0                    	RNZ			; 'g' was pending: vim drops both
  2226'   3E 02                 	MVI	A,PZ
  2228'   32 0000*              	STA	GPEND
  222B'   C9                    	RET
  222C'                         VZ_ZZ:
  222C'   3E 04                 	MVI	A,EO_X
  222E'   32 0000*              	STA	EXOP
  2231'   3E 01                 	MVI	A,1
  2233'   32 0000*              	STA	EXBANG		; no '!'
  2236'   AF                    	XRA	A
  2237'   32 0000*              	STA	EXARG		; no file name
  223A'   3A 0000*              	LDA	MODF		; as ':x': a changed text is written first
  223D'   B7                    	ORA	A
  223E'   CA 237F'              	JZ	EX_Q
  2241'   C3 2319'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  2244'                         VC_EX:
  2244'   CD 0798'              	CALL	GETCNT
  2247'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  224A'   11 0000*              	LXI	D,EXBUF
  224D'   06 28                 	MVI	B,EXMAX
  224F'   0E 3A                 	MVI	C,':'
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  2251'   CD 219E'              	CALL	RDLINE
  2254'   B7                    	ORA	A
  2255'   C0                    	RNZ			; cancelled
  2256'   3A 0000*              	LDA	RLLEN
  2259'   5F                    	MOV	E,A
  225A'   16 00                 	MVI	D,0
  225C'   21 0000*              	LXI	H,EXBUF
  225F'   19                    	DAD	D
  2260'   36 00                 	MVI	M,0		; the line ends with a 0
  2262'   21 0000*              	LXI	H,EXBUF
  2265'   CD 2831'              	CALL	SKIPB
  2268'   C8                    	RZ			; nothing on it
  2269'   22 0000*              	SHLD	EXCMD
  226C'   CD 2A58'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  226F'   CD 2831'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  2272'   56                    	MOV	D,M
  2273'   23                    	INX	H
  2274'   1E 00                 	MVI	E,0
  2276'   CD 283D'              	CALL	ISLOW
  2279'   DA 2284'              	JC	EX_LK
  227C'   5F                    	MOV	E,A
  227D'   23                    	INX	H
  227E'   CD 283D'              	CALL	ISLOW
  2281'   D2 229D'              	JNC	EX_NOT		; a third letter: none of ours
  2284'                         EX_LK:
  2284'   E5                    	PUSH	H
  2285'   21 2A3F'              	LXI	H,EXTAB
  2288'                         EX_TL:
  2288'   7E                    	MOV	A,M
  2289'   B7                    	ORA	A
  228A'   CA 229C'              	JZ	EX_NTP		; not in the table
  228D'   23                    	INX	H
  228E'   BA                    	CMP	D
  228F'   7E                    	MOV	A,M
  2290'   23                    	INX	H
  2291'   C2 2298'              	JNZ	EX_TN
  2294'   BB                    	CMP	E
  2295'   CA 22A3'              	JZ	EX_TF
  2298'                         EX_TN:
  2298'   23                    	INX	H
  2299'   C3 2288'              	JMP	EX_TL
  229C'                         EX_NTP:
  229C'   E1                    	POP	H
  229D'                         EX_NOT:
  229D'   21 28F8'              	LXI	H,SNOT
  22A0'   C3 2872'              	JMP	EXERT
  22A3'                         EX_TF:
  22A3'   7E                    	MOV	A,M
  22A4'   32 0000*              	STA	EXOP
  22A7'   E1                    	POP	H
  22A8'   FE 06                 	CPI	EO_S
  22AA'   CA 2AC7'              	JZ	EX_S		; ':s' reads the rest of the line itself
  22AD'   FE 01                 	CPI	EO_W
  22AF'   CA 22BE'              	JZ	EX_RG		; ':N,Mw name' takes a range
  22B2'   FE 08                 	CPI	EO_R
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  22B4'   CA 22BE'              	JZ	EX_RG		; ... and ':Nr name' a line
  22B7'   3A 0000*              	LDA	SRNGF
  22BA'   B7                    	ORA	A
  22BB'   C2 229D'              	JNZ	EX_NOT		; a range on a command that does not take one
  22BE'                         EX_RG:
                                	;--- '!', then the file name ---
  22BE'   7E                    	MOV	A,M
  22BF'   D6 21                 	SUI	'!'
  22C1'   32 0000*              	STA	EXBANG		; 0 = '!'
  22C4'   C2 22C8'              	JNZ	EX_NB
  22C7'   23                    	INX	H
  22C8'                         EX_NB:
  22C8'   CD 2831'              	CALL	SKIPB
  22CB'   32 0000*              	STA	EXARG		; 0 = no file name
  22CE'   CA 22E7'              	JZ	EX_RUN
  22D1'   22 0000*              	SHLD	EXCMD
  22D4'   3A 0000*              	LDA	EXOP
  22D7'   FE 02                 	CPI	EO_Q
  22D9'   CA 286F'              	JZ	EX_TRL		; :q takes none
  22DC'   FE 07                 	CPI	EO_V
  22DE'   CA 286F'              	JZ	EX_TRL		; nor :ve
  22E1'   CD 279B'              	CALL	PARSFN
  22E4'   C2 2863'              	JNZ	EX_INV
  22E7'                         EX_RUN:
  22E7'   3A 0000*              	LDA	EXOP
  22EA'   FE 05                 	CPI	EO_E
  22EC'   CA 2396'              	JZ	EX_E
  22EF'   FE 02                 	CPI	EO_Q
  22F1'   CA 237F'              	JZ	EX_Q
  22F4'   FE 07                 	CPI	EO_V
  22F6'   CA 2869'              	JZ	EX_V
  22F9'   FE 08                 	CPI	EO_R
  22FB'   CA 2527'              	JZ	EX_R
  22FE'   FE 04                 	CPI	EO_X
  2300'   CA 2312'              	JZ	EX_XM
  2303'   FE 01                 	CPI	EO_W
  2305'   C2 2319'              	JNZ	EX_W		; :wq
  2308'   3A 0000*              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  230B'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  230C'   C2 2447'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  230F'   C3 2319'              	JMP	EX_W
  2312'                         EX_XM:
  2312'   3A 0000*              	LDA	MODF		; :x writes only a changed text
  2315'   B7                    	ORA	A
  2316'   CA 237F'              	JZ	EX_Q
  2319'                         EX_W:
  2319'   CD 2607'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  231C'   D8                    	RC			; refused (message shown)
  231D'   32 0000*              	STA	EXBAK
  2320'   3A 0000*              	LDA	EXOP
  2323'   FE 01                 	CPI	EO_W
  2325'   CA 233C'              	JZ	EX_WK
  2328'   3A 0000*              	LDA	EXBAK
  232B'   B7                    	ORA	A
  232C'   C2 237C'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  232F'   3A 0000*              	LDA	EXBANG
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  2332'   B7                    	ORA	A
  2333'   CA 237C'              	JZ	EX_WQ		; so it does with '!'
  2336'   CD 233C'              	CALL	EX_WK		; else it may not: keep the text
  2339'   C3 237F'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  233C'                         EX_WK:
  233C'   CD 0EDA'              	CALL	CURRW		; the cursor's row and file position
  233F'   32 0000*              	STA	WPROW
  2342'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  2345'   7D                    	MOV	A,L
  2346'   E6 7F                 	ANI	7FH
  2348'   32 0000*              	STA	WPBYT
  234B'   7D                    	MOV	A,L
  234C'   17                    	RAL
  234D'   7C                    	MOV	A,H
  234E'   17                    	RAL
  234F'   5F                    	MOV	E,A
  2350'   3E 00                 	MVI	A,0
  2352'   17                    	RAL
  2353'   57                    	MOV	D,A		; DE = HL / 128
  2354'   2A 0000*              	LHLD	OUTPOS
  2357'   19                    	DAD	D
  2358'   22 0000*              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  235B'   CD 263C'              	CALL	WRITE
  235E'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  2361'   2A 0000*              	LHLD	WPREC
  2364'   EB                    	XCHG
  2365'   3A 0000*              	LDA	WPBYT
  2368'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  236B'   CD 0000*              	CALL	GOTO
  236E'                         EX_WRW:
  236E'   21 0000               	LXI	H,0
  2371'   22 0000*              	SHLD	LNDLT
  2374'   3A 0000*              	LDA	WPROW
  2377'   6F                    	MOV	L,A
  2378'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  237B'   C9                    	RET
  237C'                         EX_WQ:
  237C'   CD 263C'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  237F'                         EX_Q:
  237F'   3A 0000*              	LDA	EXBANG
  2382'   B7                    	ORA	A
  2383'   CA 238D'              	JZ	EX_QT
  2386'   3A 0000*              	LDA	MODF
  2389'   B7                    	ORA	A
  238A'   C2 2857'              	JNZ	MSGNWR		; changed, no '!': stay
  238D'                         EX_QT:
  238D'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  2390'   3E 01                 	MVI	A,1
  2392'   32 0000*              	STA	QUITF
  2395'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  2396'                         EX_E:
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  2396'   3A 0000*              	LDA	EXBANG
  2399'   B7                    	ORA	A
  239A'   CA 23A4'              	JZ	EE_GO
  239D'   3A 0000*              	LDA	MODF
  23A0'   B7                    	ORA	A
  23A1'   C2 2857'              	JNZ	MSGNWR
  23A4'                         EE_GO:
  23A4'   3A 0000*              	LDA	EXARG
  23A7'   B7                    	ORA	A
  23A8'   C2 23AF'              	JNZ	EE_ARG
  23AB'   CD 2678'              	CALL	OWNTF		; no name: the buffer's own
  23AE'   D8                    	RC
  23AF'                         EE_ARG:
  23AF'   CD 268E'              	CALL	ISOWN
  23B2'   21 0001               	LXI	H,1
  23B5'   C2 23BC'              	JNZ	EE_LD		; another file: its first line
  23B8'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  23BB'   23                    	INX	H		; HL = the cursor's line
  23BC'                         EE_LD:
  23BC'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  23BE'   32 0000*              	STA	MSGWHT
  23C1'   E5                    	PUSH	H
  23C2'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  23C5'   21 0000*              	LXI	H,TFCB
  23C8'   11 0000*              	LXI	D,FNAME
  23CB'   CD 26A0'              	CALL	COPY12		; the buffer's name
  23CE'   CD 2665'              	CALL	SRCTF
  23D1'   CD 0000*              	CALL	REOPEN
  23D4'   CD 01EF'              	CALL	MKCLR		; the marks named the buffer that just went
  23D7'   AF                    	XRA	A
  23D8'   32 0000*              	STA	MODF
  23DB'   E1                    	POP	H
  23DC'   2B                    	DCX	H
  23DD'   AF                    	XRA	A
  23DE'   CD 0000*              	CALL	MVLIND		; down to the line
  23E1'   CD 0BF6'              	CALL	ATEOF
  23E4'   DC 0BFC'              	CC	LASTLN		; past the last line: onto it
  23E7'   CD 13DB'              	CALL	ZSAVE
  23EA'   C3 14B0'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  23ED'                         TFDOS:
  23ED'   C5                    	PUSH	B
  23EE'   11 0080               	LXI	D,CMDTAIL
  23F1'   0E 1A                 	MVI	C,1AH		; set the DMA
  23F3'   CD 0005               	CALL	BDOS
  23F6'   C1                    	POP	B
  23F7'   11 0000*              	LXI	D,TFCB
  23FA'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  23FD'                         EXRNG:
  23FD'   2A 0000*              	LHLD	SRNG1
  2400'   7C                    	MOV	A,H
  2401'   B5                    	ORA	L
  2402'   37                    	STC
  2403'   C8                    	RZ
  2404'   2A 0000*              	LHLD	SRNG2
  2407'   EB                    	XCHG
  2408'   2A 0000*              	LHLD	SRNG1
  240B'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  240E'   D8                    	RC
  240F'   EB                    	XCHG			; HL = the last line, DE = the first
  2410'   CD 0000*              	CALL	SUBHD
  2413'   23                    	INX	H
  2414'   22 0000*              	SHLD	SLINES
  2417'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  2418'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  2419'                         GOLNX:
  2419'   E5                    	PUSH	H
  241A'   CD 135A'              	CALL	GOLN
  241D'   CD 0000*              	CALL	CNTLF
  2420'   23                    	INX	H		; the line the cursor came to rest on
  2421'   D1                    	POP	D
  2422'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  2425'                         EXSAVP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  2425'   CD 0EDA'              	CALL	CURRW
  2428'   32 0000*              	STA	WPROW
  242B'   21 0000*              	LXI	H,MKPOS
  242E'   C3 0444'              	JMP	FPSTO
  2431'                         EXRSTP:
  2431'   CD 0000*              	CALL	CLRCNT
  2434'   CD 03AC'              	CALL	MKPAGE		; page until that place is in the window again
  2437'   CD 0000*              	CALL	GOTO
  243A'   C3 236E'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  243D'                         PUTBRK:
  243D'   3E 0D                 	MVI	A,CR
  243F'   CD 0000*              	CALL	PUTGAP
  2442'   3E 0A                 	MVI	A,LF
  2444'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  2447'                         EX_WR:
  2447'   3A 0000*              	LDA	EXARG
  244A'   B7                    	ORA	A
  244B'   CA 2845'              	JZ	MSGNFN		; No file name
  244E'   CD 268E'              	CALL	ISOWN
  2451'   CA 24F1'              	JZ	EXW_OW
  2454'   CD 0000*              	CALL	TEXIST
  2457'   32 0000*              	STA	RWERR		; nonzero: a file of that name is there
  245A'   CA 2464'              	JZ	EXW_GO
  245D'   3A 0000*              	LDA	EXBANG
  2460'   B7                    	ORA	A
  2461'   C2 284B'              	JNZ	MSGEXI		; File exists (! to force)
  2464'                         EXW_GO:
  2464'   CD 23FD'              	CALL	EXRNG
  2467'   DA 24EB'              	JC	EXW_BD
  246A'   CD 2425'              	CALL	EXSAVP
  246D'   2A 0000*              	LHLD	SRNG1
  2470'   CD 2419'              	CALL	GOLNX
  2473'   C2 24E8'              	JNZ	EXW_NL		; the text has no line N
  2476'   3A 0000*              	LDA	RWERR		; a delete scans the whole directory, there or
  2479'   B7                    	ORA	A		;   not: only when TEXIST found one
  247A'   0E 13                 	MVI	C,13H
  247C'   C4 23ED'              	CNZ	TFDOS		; delete what is there
  247F'   0E 16                 	MVI	C,16H
  2481'   CD 23ED'              	CALL	TFDOS		; ... and make it
  2484'   3C                    	INR	A
  2485'   CA 24DA'              	JZ	EXW_FL		; no directory entry left
  2488'   3E 80                 	MVI	A,80H
  248A'   32 0000*              	STA	RWPTR
  248D'   AF                    	XRA	A
  248E'   32 0000*              	STA	RWERR
  2491'   2A 0000*              	LHLD	SLINES
  2494'   CD 0000*              	CALL	SETC0		; that many lines, forward
  2497'                         EXW_LP:
  2497'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  249A'   E5                    	PUSH	H
  249B'   EB                    	XCHG
  249C'   2A 0000*              	LHLD	GAPEND
  249F'   CD 24F7'              	CALL	RWOUT		; the text from the cursor to there
  24A2'   E1                    	POP	H
  24A3'   3A 0000*              	LDA	RWERR
  24A6'   B7                    	ORA	A
  24A7'   C2 24C3'              	JNZ	EXW_EN
  24AA'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  24AD'   CD 07AD'              	CALL	CNTTST
  24B0'   C2 2497'              	JNZ	EXW_LP
  24B3'                         EXW_PD:				; the last record is padded out with ^Z
  24B3'   3A 0000*              	LDA	RWPTR
  24B6'   FE 80                 	CPI	80H
  24B8'   CA 24C3'              	JZ	EXW_EN
  24BB'   3E 1A                 	MVI	A,CPMEOF
  24BD'   CD 2503'              	CALL	RWPUT
  24C0'   C3 24B3'              	JMP	EXW_PD
  24C3'                         EXW_EN:
  24C3'   0E 10                 	MVI	C,10H
  24C5'   CD 23ED'              	CALL	TFDOS		; close
  24C8'   3A 0000*              	LDA	RWERR
  24CB'   B7                    	ORA	A
  24CC'   C2 24DA'              	JNZ	EXW_FL
  24CF'   CD 2431'              	CALL	EXRSTP
  24D2'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  24D4'   32 0000*              	STA	MSGWHT
  24D7'   C3 086D'              	JMP	SETMOV		; nothing on the screen has changed
  24DA'                         EXW_FL:				; no room: the part written is not left behind
  24DA'   0E 13                 	MVI	C,13H
  24DC'   CD 23ED'              	CALL	TFDOS
  24DF'   CD 2431'              	CALL	EXRSTP
  24E2'   21 2A35'              	LXI	H,SDFUL
  24E5'   C3 287D'              	JMP	EXERR
  24E8'                         EXW_NL:
  24E8'   CD 2431'              	CALL	EXRSTP
  24EB'                         EXW_BD:
  24EB'   21 2A27'              	LXI	H,SRNGE
  24EE'   C3 287D'              	JMP	EXERR
  24F1'                         EXW_OW:
  24F1'   21 28AF'              	LXI	H,SEXI
  24F4'   C3 287D'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  24F7'                         RWOUT:
  24F7'   CD 0000*              	CALL	CMP16
  24FA'   C8                    	RZ
  24FB'   7E                    	MOV	A,M
  24FC'   23                    	INX	H
  24FD'   CD 2503'              	CALL	RWPUT
  2500'   C3 24F7'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  2503'                         RWPUT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  2503'   E5                    	PUSH	H
  2504'   F5                    	PUSH	PSW
  2505'   3A 0000*              	LDA	RWPTR
  2508'   6F                    	MOV	L,A
  2509'   26 00                 	MVI	H,0
  250B'   F1                    	POP	PSW
  250C'   77                    	MOV	M,A
  250D'   2C                    	INR	L		; Z: that was the record's last byte
  250E'   7D                    	MOV	A,L
  250F'   C2 2522'              	JNZ	RWP_ST
  2512'   D5                    	PUSH	D
  2513'   0E 15                 	MVI	C,15H
  2515'   CD 23ED'              	CALL	TFDOS		; write it
  2518'   D1                    	POP	D
  2519'   B7                    	ORA	A
  251A'   CA 2520'              	JZ	RWP_OK
  251D'   32 0000*              	STA	RWERR
  2520'                         RWP_OK:
  2520'   3E 80                 	MVI	A,80H
  2522'                         RWP_ST:
  2522'   32 0000*              	STA	RWPTR
  2525'   E1                    	POP	H
  2526'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  2527'                         EX_R:
  2527'   3A 0000*              	LDA	EXARG
  252A'   B7                    	ORA	A
  252B'   CA 2845'              	JZ	MSGNFN		; No file name
  252E'   0E 0F                 	MVI	C,0FH
  2530'   CD 23ED'              	CALL	TFDOS		; open
  2533'   3C                    	INR	A
  2534'   CA 2601'              	JZ	ER_NOF
  2537'   CD 1401'              	CALL	GZONE		; the screen's top line, before anything moves
  253A'   CD 2425'              	CALL	EXSAVP
  253D'   3A 0000*              	LDA	SRNGF
  2540'   B7                    	ORA	A
  2541'   CA 255A'              	JZ	ER_NXT		; no line given: below the cursor's
  2544'   2A 0000*              	LHLD	SRNG2
  2547'   7C                    	MOV	A,H
  2548'   B5                    	ORA	L
  2549'   C2 2554'              	JNZ	ER_LN
  254C'   23                    	INX	H
  254D'   CD 135A'              	CALL	GOLN		; ':0r': above line 1 ...
  2550'   AF                    	XRA	A		;   which never wants a line end put in first
  2551'   C3 257C'              	JMP	ER_BRK
  2554'                         ER_LN:
  2554'   CD 2419'              	CALL	GOLNX
  2557'   C2 24E8'              	JNZ	EXW_NL		; the text has no line N
  255A'                         ER_NXT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


  255A'   21 0001               	LXI	H,1
  255D'   AF                    	XRA	A
  255E'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  2561'   CD 0BF6'              	CALL	ATEOF
  2564'   3E 00                 	MVI	A,0
  2566'   D2 257C'              	JNC	ER_BRK		; text follows
  2569'   2A 0000*              	LHLD	GAPBEG
  256C'   EB                    	XCHG
  256D'   2A 0000*              	LHLD	TXTBEG
  2570'   CD 0000*              	CALL	CMP16
  2573'   3E 01                 	MVI	A,1
  2575'   CA 257C'              	JZ	ER_BRK		; nothing before the cursor either
  2578'   1B                    	DCX	D
  2579'   1A                    	LDAX	D
  257A'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  257C'                         ER_BRK:
  257C'   32 0000*              	STA	RDBRK
  257F'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  2582'   AF                    	XRA	A
  2583'   32 0000*              	STA	RDANY
  2586'                         ER_LP:
  2586'   0E 14                 	MVI	C,14H
  2588'   CD 23ED'              	CALL	TFDOS		; the next record
  258B'   B7                    	ORA	A
  258C'   C2 25BF'              	JNZ	ER_END
  258F'   21 0080               	LXI	H,CMDTAIL
  2592'   0E 00                 	MVI	C,0
  2594'                         ER_SC:				; C = its bytes, up to a ^Z
  2594'   7E                    	MOV	A,M
  2595'   FE 1A                 	CPI	CPMEOF
  2597'   CA 259F'              	JZ	ER_GOT
  259A'   23                    	INX	H
  259B'   0C                    	INR	C
  259C'   F2 2594'              	JP	ER_SC		; (minus: all 128)
  259F'                         ER_GOT:
  259F'   79                    	MOV	A,C
  25A0'   B7                    	ORA	A
  25A1'   CA 25BF'              	JZ	ER_END
  25A4'   C5                    	PUSH	B
  25A5'   3A 0000*              	LDA	RDANY
  25A8'   B7                    	ORA	A
  25A9'   CC 25F0'              	CZ	ER_1ST
  25AC'   C1                    	POP	B
  25AD'   06 00                 	MVI	B,0
  25AF'   11 0080               	LXI	D,CMDTAIL
  25B2'   C5                    	PUSH	B
  25B3'   CD 0000*              	CALL	INSBLK
  25B6'   C1                    	POP	B
  25B7'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  25BA'   79                    	MOV	A,C
  25BB'   17                    	RAL
  25BC'   DA 2586'              	JC	ER_LP		; a full record: there may be more
  25BF'                         ER_END:
  25BF'   3A 0000*              	LDA	RDANY
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  25C2'   B7                    	ORA	A
  25C3'   CA 25E1'              	JZ	ER_PL		; nothing in the file: nothing has changed
  25C6'   CD 0BF6'              	CALL	ATEOF
  25C9'   DA 25D6'              	JC	ER_MD		; the text now ends as the file read ends
  25CC'   2A 0000*              	LHLD	GAPBEG
  25CF'   2B                    	DCX	H
  25D0'   7E                    	MOV	A,M
  25D1'   FE 0A                 	CPI	LF
  25D3'   C4 243D'              	CNZ	PUTBRK		; text follows: what was read ends a line
  25D6'                         ER_MD:
  25D6'   3E 01                 	MVI	A,1
  25D8'   32 0000*              	STA	MODF
  25DB'   CD 03AC'              	CALL	MKPAGE		; back to the first line read
  25DE'   CD 0000*              	CALL	GOTO
  25E1'                         ER_PL:
  25E1'   CD 0BF6'              	CALL	ATEOF
  25E4'   DC 0BFC'              	CC	LASTLN		; (nothing read, at the end: the last line)
  25E7'   CD 0000*              	CALL	CLRCNT
  25EA'   CD 1419'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  25ED'   C3 08AA'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  25F0'                         ER_1ST:
  25F0'   3C                    	INR	A
  25F1'   32 0000*              	STA	RDANY
  25F4'   3A 0000*              	LDA	RDBRK
  25F7'   B7                    	ORA	A
  25F8'   C4 243D'              	CNZ	PUTBRK
  25FB'   21 0000*              	LXI	H,MKPOS
  25FE'   C3 0444'              	JMP	FPSTO
  2601'                         ER_NOF:
  2601'   21 2A16'              	LXI	H,SNOPN
  2604'   C3 2872'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  2607'                         WRCHK:
  2607'   3A 0000*              	LDA	EXARG
  260A'   B7                    	ORA	A
  260B'   C2 2615'              	JNZ	WC_ARG
  260E'   CD 2678'              	CALL	OWNTF
  2611'   D8                    	RC
  2612'   C3 262A'              	JMP	WC_OWN
  2615'                         WC_ARG:
  2615'   CD 268E'              	CALL	ISOWN
  2618'   CA 262A'              	JZ	WC_OWN
  261B'   3A 0000*              	LDA	EXBANG
  261E'   B7                    	ORA	A
  261F'   CA 2628'              	JZ	WC_OTH
  2622'   CD 0000*              	CALL	TEXIST
  2625'   C2 284B'              	JNZ	MSGEXI		; File exists (! to force)
  2628'                         WC_OTH:
  2628'   AF                    	XRA	A		; (NC)
  2629'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  262A'                         WC_OWN:
  262A'   3A 0000*              	LDA	ROFLAG		; '-R': this is the file it may not write
  262D'   B7                    	ORA	A
  262E'   CA 2638'              	JZ	WC_OK
  2631'   3A 0000*              	LDA	EXBANG
  2634'   B7                    	ORA	A
  2635'   C2 2851'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  2638'                         WC_OK:
  2638'   3E 01                 	MVI	A,1
  263A'   B7                    	ORA	A		; (NC)
  263B'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  263C'                         WRITE:
  263C'   3A 0000*              	LDA	EXBAK
  263F'   CD 0000*              	CALL	WRTO
  2642'   3A 0001*              	LDA	FNAME+1
  2645'   FE 20                 	CPI	' '
  2647'   C2 2653'              	JNZ	WR_HAS
  264A'   21 0000*              	LXI	H,TFCB
  264D'   11 0000*              	LXI	D,FNAME
  2650'   CD 26A0'              	CALL	COPY12
  2653'                         WR_HAS:
  2653'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  2655'   32 0000*              	STA	MSGWHT
  2658'   CD 268E'              	CALL	ISOWN
  265B'   C2 2665'              	JNZ	SRCTF
  265E'   AF                    	XRA	A
  265F'   32 0000*              	STA	MODF
  2662'   32 0000*              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  2665'                         SRCTF:
  2665'   21 0000*              	LXI	H,TFCB
  2668'   11 005C               	LXI	D,DFTFCB
  266B'   CD 26A0'              	CALL	COPY12
  266E'   AF                    	XRA	A
  266F'   06 04                 	MVI	B,4
  2671'                         SRC_Z:
  2671'   12                    	STAX	D		; extent, s1, s2, record count: 0
  2672'   13                    	INX	D
  2673'   05                    	DCR	B
  2674'   C2 2671'              	JNZ	SRC_Z
  2677'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  2678'                         OWNTF:
  2678'   3A 0001*              	LDA	FNAME+1
  267B'   FE 20                 	CPI	' '
  267D'   CA 2845'              	JZ	MSGNFN
  2680'   CD 26AB'              	CALL	TFCLR
  2683'   21 0000*              	LXI	H,FNAME
  2686'   11 0000*              	LXI	D,TFCB
  2689'   CD 26A0'              	CALL	COPY12
  268C'   B7                    	ORA	A		; (NC)
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


  268D'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  268E'                         ISOWN:
  268E'   21 0000*              	LXI	H,TFCB
  2691'   11 0000*              	LXI	D,FNAME
  2694'   06 0C                 	MVI	B,12
  2696'                         IO_LP:
  2696'   1A                    	LDAX	D
  2697'   BE                    	CMP	M
  2698'   C0                    	RNZ
  2699'   23                    	INX	H
  269A'   13                    	INX	D
  269B'   05                    	DCR	B
  269C'   C2 2696'              	JNZ	IO_LP
  269F'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  26A0'                         COPY12:
  26A0'   06 0C                 	MVI	B,12
  26A2'                         CP_LP:
  26A2'   7E                    	MOV	A,M
  26A3'   12                    	STAX	D
  26A4'   23                    	INX	H
  26A5'   13                    	INX	D
  26A6'   05                    	DCR	B
  26A7'   C2 26A2'              	JNZ	CP_LP
  26AA'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  26AB'                         TFCLR:
  26AB'   11 0000*              	LXI	D,TFCB
  26AE'   06 24                 	MVI	B,36
  26B0'   AF                    	XRA	A
  26B1'                         TC_LP:
  26B1'   12                    	STAX	D
  26B2'   13                    	INX	D
  26B3'   05                    	DCR	B
  26B4'   C2 26B1'              	JNZ	TC_LP
  26B7'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  26B8'                         FOPEN:
  26B8'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  26BA'   32 0000*              	STA	MSGWHT
  26BD'   21 005C               	LXI	H,DFTFCB
  26C0'   CD 278E'              	CALL	NRMDRV
  26C3'   11 0000*              	LXI	D,FNAME
  26C6'   CD 26A0'              	CALL	COPY12
  26C9'   CD 0000*              	CALL	OPENZ
  26CC'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  26CF'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  26D1'   C8                    	RZ
  26D2'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
	MACRO-80 3.44	09-Dec-81	PAGE	1-122


  26D5'   32 0000*              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  26D8'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  26D9'                         ARGSCN:
  26D9'   3A 0080               	LDA	CMDTAIL
  26DC'   47                    	MOV	B,A		; B = what is left of the line
  26DD'   B7                    	ORA	A
  26DE'   C8                    	RZ
  26DF'   21 0081               	LXI	H,CMDTAIL+1
  26E2'                         AS_TOK:				; at a token, or the blanks before one
  26E2'   7E                    	MOV	A,M
  26E3'   FE 20                 	CPI	' '
  26E5'   C2 26EE'              	JNZ	AS_OPT
  26E8'   23                    	INX	H
  26E9'   05                    	DCR	B
  26EA'   C2 26E2'              	JNZ	AS_TOK
  26ED'   C9                    	RET
  26EE'                         AS_OPT:
  26EE'   FE 2B                 	CPI	'+'
  26F0'   CA 271A'              	JZ	AS_PLS
  26F3'   FE 2D                 	CPI	'-'
  26F5'   CA 2709'              	JZ	AS_SW
  26F8'   FE 2F                 	CPI	'/'
  26FA'   CA 2709'              	JZ	AS_SW
  26FD'                         AS_SKP:				; not ours (the file name): on to the next one
  26FD'   23                    	INX	H
  26FE'   05                    	DCR	B
  26FF'   C8                    	RZ
  2700'   7E                    	MOV	A,M
  2701'   FE 20                 	CPI	' '
  2703'   C2 26FD'              	JNZ	AS_SKP
  2706'   C3 26E2'              	JMP	AS_TOK
	MACRO-80 3.44	09-Dec-81	PAGE	1-123


  2709'                         AS_SW:
  2709'   23                    	INX	H
  270A'   05                    	DCR	B
  270B'   C8                    	RZ
  270C'   7E                    	MOV	A,M
  270D'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  270F'   FE 52                 	CPI	'R'
  2711'   C2 26FD'              	JNZ	AS_SKP
  2714'   32 0000*              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  2717'   C3 26FD'              	JMP	AS_SKP
  271A'                         AS_PLS:
  271A'   3E 01                 	MVI	A,1
  271C'   32 0000*              	STA	PLUSF		; '+' gets the line even with no number on it
  271F'   11 0000*              	LXI	D,PLUSB
  2722'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  2724'   23                    	INX	H		;   line space, so it is taken as '+' alone
  2725'   05                    	DCR	B
  2726'   CA 275D'              	JZ	AS_PE
  2729'   7E                    	MOV	A,M
  272A'   FE 30                 	CPI	'0'
  272C'   C2 2744'              	JNZ	AS_PD
  272F'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  272F'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  2730'   05                    	DCR	B
  2731'   CA 2765'              	JZ	AS_P1
  2734'   7E                    	MOV	A,M
  2735'   FE 30                 	CPI	'0'
  2737'   CA 272F'              	JZ	AS_PZ
  273A'   FE 31                 	CPI	'1'
  273C'   DA 2765'              	JC	AS_P1		; zeros and then no digit at all: line 1
  273F'   FE 3A                 	CPI	'9'+1
  2741'   D2 2765'              	JNC	AS_P1
  2744'                         AS_PD:				; the digits, as typed
  2744'   7E                    	MOV	A,M
  2745'   FE 30                 	CPI	'0'
  2747'   DA 275D'              	JC	AS_PE
  274A'   FE 3A                 	CPI	'9'+1
  274C'   D2 275D'              	JNC	AS_PE
  274F'   79                    	MOV	A,C
  2750'   B7                    	ORA	A
  2751'   CA 276C'              	JZ	AS_POV
  2754'   0D                    	DCR	C
  2755'   7E                    	MOV	A,M
  2756'   12                    	STAX	D
  2757'   13                    	INX	D
  2758'   23                    	INX	H
  2759'   05                    	DCR	B
  275A'   C2 2744'              	JNZ	AS_PD
  275D'                         AS_PE:
  275D'   AF                    	XRA	A
  275E'   12                    	STAX	D		; the digits end with a 0
  275F'   78                    	MOV	A,B
  2760'   B7                    	ORA	A
  2761'   C8                    	RZ
  2762'   C3 26E2'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
	MACRO-80 3.44	09-Dec-81	PAGE	1-124


                                				;   take a '-R' after them for a file name
  2765'                         AS_P1:
  2765'   3E 31                 	MVI	A,'1'
  2767'   12                    	STAX	D
  2768'   13                    	INX	D
  2769'   C3 275D'              	JMP	AS_PE
  276C'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  276C'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  276F'   C3 275D'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  2772'                         ARGGO:
  2772'   3A 0000*              	LDA	PLUSF
  2775'   B7                    	ORA	A
  2776'   C8                    	RZ
  2777'   21 0000*              	LXI	H,PLUSB
  277A'                         AG_LP:
  277A'   7E                    	MOV	A,M
  277B'   B7                    	ORA	A
  277C'   CA 2789'              	JZ	AG_G
  277F'   4F                    	MOV	C,A
  2780'   E5                    	PUSH	H
  2781'   CD 0026'              	CALL	VICMD
  2784'   E1                    	POP	H
  2785'   23                    	INX	H
  2786'   C3 277A'              	JMP	AG_LP
  2789'                         AG_G:
  2789'   0E 47                 	MVI	C,'G'
  278B'   C3 0026'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  278E'                         NRMDRV:
  278E'   7E                    	MOV	A,M
  278F'   B7                    	ORA	A
  2790'   C0                    	RNZ
  2791'   E5                    	PUSH	H
  2792'   0E 19                 	MVI	C,BF_CURDSK
  2794'   CD 0005               	CALL	BDOS
  2797'   E1                    	POP	H
  2798'   3C                    	INR	A
  2799'   77                    	MOV	M,A
  279A'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  279B'                         PARSFN:
  279B'   CD 26AB'              	CALL	TFCLR
  279E'   11 0000*              	LXI	D,TFCB
  27A1'   23                    	INX	H
  27A2'   7E                    	MOV	A,M
