  2FF3'   E1                    	POP	H
  2FF4'   E5                    	PUSH	H
  2FF5'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  2FF6'   BE                    	CMP	M
  2FF7'   CA 3005'              	JZ	MN_NAM
  2FFA'   7E                    	MOV	A,M
  2FFB'   C6 40                 	ADI	'A'-1
  2FFD'   CD 0000*              	CALL	OUTCH
  3000'   3E 3A                 	MVI	A,':'
  3002'   CD 0000*              	CALL	OUTCH
