  0F90'   E1                    	POP	H
  0F91'   CD 1238'              	CALL	RWFWD		; HL -> the line that row is in, C = which of its
  0F94'   DA 0FB0'              	JC	VPD_TP		; the text ended: its last line
  0F97'   79                    	MOV	A,C
  0F98'   B7                    	ORA	A
  0F99'   CA 0FB0'              	JZ	VPD_TP
  0F9C'   3A 0000*              	LDA	RWMV		; part of the way down a line: its start -- unless
  0F9F'   B7                    	ORA	A		;   that is the top line still, then the next
  0FA0'   C2 0FB0'              	JNZ	VPD_TP
  0FA3'   E5                    	PUSH	H
  0FA4'   CD 11E6'              	CALL	HTIX
  0FA7'   21 0000*              	LXI	H,HTTP
  0FAA'   BE                    	CMP	M
  0FAB'   E1                    	POP	H
  0FAC'   C2 0FB0'              	JNZ	VPD_TP
  0FAF'   23                    	INX	H
