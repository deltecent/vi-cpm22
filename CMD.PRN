  2721'   E1                    	POP	H
  2722'   CD 0000*              	CALL	EXMSG
  2725'   3E 01                 	MVI	A,R_MOVE
  2727'   32 2E64'              	STA	RINTENT
  272A'   37                    	STC
  272B'   C9                    	RET
                                
