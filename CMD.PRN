  06B7'   2B                    	DCX	H
  06B8'   7E                    	MOV	A,M
  06B9'   FE 0A                 	CPI	LF
  06BB'   CA 06D7'              	JZ	BOL_X
  06BE'   1B                    	DCX	D
  06BF'   0B                    	DCX	B
