  203B'   D2 2057'              	JNC	EX_NOT		; a third letter: none of ours
  203E'                         EX_LK:
  203E'   E5                    	PUSH	H
  203F'   21 27D6'              	LXI	H,EXTAB
  2042'                         EX_TL:
  2042'   7E                    	MOV	A,M
  2043'   B7                    	ORA	A
  2044'   CA 2056'              	JZ	EX_NTP		; not in the table
  2047'   23                    	INX	H
  2048'   BA                    	CMP	D
  2049'   7E                    	MOV	A,M
  204A'   23                    	INX	H
  204B'   C2 2052'              	JNZ	EX_TN
  204E'   BB                    	CMP	E
  204F'   CA 205D'              	JZ	EX_TF
  2052'                         EX_TN:
  2052'   23                    	INX	H
  2053'   C3 2042'              	JMP	EX_TL
  2056'                         EX_NTP:
  2056'   E1                    	POP	H
  2057'                         EX_NOT:
  2057'   21 26AF'              	LXI	H,SNOT
  205A'   C3 262C'              	JMP	EXERT
  205D'                         EX_TF:
  205D'   7E                    	MOV	A,M
  205E'   32 2DE2'              	STA	EXOP
  2061'   E1                    	POP	H
  2062'   FE 06                 	CPI	EO_S
  2064'   CA 285E'              	JZ	EX_S		; ':s' reads the rest of the line itself
  2067'   FE 01                 	CPI	EO_W
  2069'   CA 2078'              	JZ	EX_RG		; ':N,Mw name' takes a range
  206C'   FE 08                 	CPI	EO_R
  206E'   CA 2078'              	JZ	EX_RG		; ... and ':Nr name' a line
  2071'   3A 2E3E'              	LDA	SRNGF
  2074'   B7                    	ORA	A
  2075'   C2 2057'              	JNZ	EX_NOT		; a range on a command that does not take one
  2078'                         EX_RG:
                                	;--- '!', then the file name ---
  2078'   7E                    	MOV	A,M
  2079'   D6 21                 	SUI	'!'
  207B'   32 2DF5'              	STA	EXBANG		; 0 = '!'
  207E'   C2 2082'              	JNZ	EX_NB
  2081'   23                    	INX	H
  2082'                         EX_NB:
  2082'   CD 25EB'              	CALL	SKIPB
  2085'   32 2DE3'              	STA	EXARG		; 0 = no file name
  2088'   CA 20A1'              	JZ	EX_RUN
  208B'   22 2DE5'              	SHLD	EXCMD
  208E'   3A 2DE2'              	LDA	EXOP
  2091'   FE 02                 	CPI	EO_Q
  2093'   CA 2629'              	JZ	EX_TRL		; :q takes none
  2096'   FE 07                 	CPI	EO_V
  2098'   CA 2629'              	JZ	EX_TRL		; nor :ve
  209B'   CD 2555'              	CALL	PARSFN
  209E'   C2 261D'              	JNZ	EX_INV
  20A1'                         EX_RUN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  20A1'   3A 2DE2'              	LDA	EXOP
  20A4'   FE 05                 	CPI	EO_E
  20A6'   CA 2150'              	JZ	EX_E
  20A9'   FE 02                 	CPI	EO_Q
  20AB'   CA 2139'              	JZ	EX_Q
  20AE'   FE 07                 	CPI	EO_V
  20B0'   CA 2623'              	JZ	EX_V
  20B3'   FE 08                 	CPI	EO_R
  20B5'   CA 22E1'              	JZ	EX_R
  20B8'   FE 04                 	CPI	EO_X
  20BA'   CA 20CC'              	JZ	EX_XM
  20BD'   FE 01                 	CPI	EO_W
  20BF'   C2 20D3'              	JNZ	EX_W		; :wq
  20C2'   3A 2E3E'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  20C5'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  20C6'   C2 2201'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  20C9'   C3 20D3'              	JMP	EX_W
  20CC'                         EX_XM:
  20CC'   3A 2D7E'              	LDA	MODF		; :x writes only a changed text
  20CF'   B7                    	ORA	A
  20D0'   CA 2139'              	JZ	EX_Q
  20D3'                         EX_W:
  20D3'   CD 23C1'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  20D6'   D8                    	RC			; refused (message shown)
  20D7'   32 2DE4'              	STA	EXBAK
  20DA'   3A 2DE2'              	LDA	EXOP
  20DD'   FE 01                 	CPI	EO_W
  20DF'   CA 20F6'              	JZ	EX_WK
  20E2'   3A 2DE4'              	LDA	EXBAK
  20E5'   B7                    	ORA	A
  20E6'   C2 2136'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  20E9'   3A 2DF5'              	LDA	EXBANG
  20EC'   B7                    	ORA	A
  20ED'   CA 2136'              	JZ	EX_WQ		; so it does with '!'
  20F0'   CD 20F6'              	CALL	EX_WK		; else it may not: keep the text
  20F3'   C3 2139'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  20F6'                         EX_WK:
  20F6'   CD 0D68'              	CALL	CURRW		; the cursor's row and file position
  20F9'   32 2DE7'              	STA	WPROW
  20FC'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  20FF'   7D                    	MOV	A,L
  2100'   E6 7F                 	ANI	7FH
  2102'   32 2DE8'              	STA	WPBYT
  2105'   7D                    	MOV	A,L
  2106'   17                    	RAL
  2107'   7C                    	MOV	A,H
  2108'   17                    	RAL
  2109'   5F                    	MOV	E,A
  210A'   3E 00                 	MVI	A,0
  210C'   17                    	RAL
  210D'   57                    	MOV	D,A		; DE = HL / 128
  210E'   2A 0000*              	LHLD	OUTPOS
  2111'   19                    	DAD	D
  2112'   22 2DE9'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  2115'   CD 23F6'              	CALL	WRITE
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  2118'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  211B'   2A 2DE9'              	LHLD	WPREC
  211E'   EB                    	XCHG
  211F'   3A 2DE8'              	LDA	WPBYT
  2122'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  2125'   CD 0000*              	CALL	GOTO
  2128'                         EX_WRW:
  2128'   21 0000               	LXI	H,0
  212B'   22 0000*              	SHLD	LNDLT
  212E'   3A 2DE7'              	LDA	WPROW
  2131'   6F                    	MOV	L,A
  2132'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  2135'   C9                    	RET
  2136'                         EX_WQ:
  2136'   CD 23F6'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  2139'                         EX_Q:
  2139'   3A 2DF5'              	LDA	EXBANG
  213C'   B7                    	ORA	A
  213D'   CA 2147'              	JZ	EX_QT
  2140'   3A 2D7E'              	LDA	MODF
  2143'   B7                    	ORA	A
  2144'   C2 2611'              	JNZ	MSGNWR		; changed, no '!': stay
  2147'                         EX_QT:
  2147'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  214A'   3E 01                 	MVI	A,1
  214C'   32 2D7D'              	STA	QUITF
  214F'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  2150'                         EX_E:
  2150'   3A 2DF5'              	LDA	EXBANG
  2153'   B7                    	ORA	A
  2154'   CA 215E'              	JZ	EE_GO
  2157'   3A 2D7E'              	LDA	MODF
  215A'   B7                    	ORA	A
  215B'   C2 2611'              	JNZ	MSGNWR
  215E'                         EE_GO:
  215E'   3A 2DE3'              	LDA	EXARG
  2161'   B7                    	ORA	A
  2162'   C2 2169'              	JNZ	EE_ARG
  2165'   CD 2432'              	CALL	OWNTF		; no name: the buffer's own
  2168'   D8                    	RC
  2169'                         EE_ARG:
  2169'   CD 2448'              	CALL	ISOWN
  216C'   21 0001               	LXI	H,1
  216F'   C2 2176'              	JNZ	EE_LD		; another file: its first line
  2172'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  2175'   23                    	INX	H		; HL = the cursor's line
  2176'                         EE_LD:
  2176'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  2178'   32 2DF3'              	STA	MSGWHT
  217B'   E5                    	PUSH	H
  217C'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  217F'   21 0000*              	LXI	H,TFCB
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2182'   11 0000*              	LXI	D,FNAME
  2185'   CD 245A'              	CALL	COPY12		; the buffer's name
  2188'   CD 241F'              	CALL	SRCTF
  218B'   CD 0000*              	CALL	REOPEN
  218E'   CD 01EC'              	CALL	MKCLR		; the marks named the buffer that just went
  2191'   AF                    	XRA	A
  2192'   32 2D7E'              	STA	MODF
  2195'   E1                    	POP	H
  2196'   2B                    	DCX	H
  2197'   AF                    	XRA	A
  2198'   CD 0000*              	CALL	MVLIND		; down to the line
  219B'   CD 0A84'              	CALL	ATEOF
  219E'   DC 0A8A'              	CC	LASTLN		; past the last line: onto it
  21A1'   CD 1254'              	CALL	ZSAVE
  21A4'   C3 1329'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  21A7'                         TFDOS:
  21A7'   C5                    	PUSH	B
  21A8'   11 0080               	LXI	D,CMDTAIL
  21AB'   0E 1A                 	MVI	C,1AH		; set the DMA
  21AD'   CD 0005               	CALL	BDOS
  21B0'   C1                    	POP	B
  21B1'   11 0000*              	LXI	D,TFCB
  21B4'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  21B7'                         EXRNG:
  21B7'   2A 2E3F'              	LHLD	SRNG1
  21BA'   7C                    	MOV	A,H
  21BB'   B5                    	ORA	L
  21BC'   37                    	STC
  21BD'   C8                    	RZ
  21BE'   2A 2E41'              	LHLD	SRNG2
  21C1'   EB                    	XCHG
  21C2'   2A 2E3F'              	LHLD	SRNG1
  21C5'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  21C8'   D8                    	RC
  21C9'   EB                    	XCHG			; HL = the last line, DE = the first
  21CA'   CD 0000*              	CALL	SUBHD
  21CD'   23                    	INX	H
  21CE'   22 2E49'              	SHLD	SLINES
  21D1'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  21D2'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  21D3'                         GOLNX:
  21D3'   E5                    	PUSH	H
  21D4'   CD 11E8'              	CALL	GOLN
  21D7'   CD 0000*              	CALL	CNTLF
  21DA'   23                    	INX	H		; the line the cursor came to rest on
  21DB'   D1                    	POP	D
  21DC'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  21DF'                         EXSAVP:
  21DF'   CD 0D68'              	CALL	CURRW
  21E2'   32 2DE7'              	STA	WPROW
  21E5'   21 2E20'              	LXI	H,MKPOS
  21E8'   C3 0429'              	JMP	FPSTO
  21EB'                         EXRSTP:
  21EB'   CD 0000*              	CALL	CLRCNT
  21EE'   CD 03A9'              	CALL	MKPAGE		; page until that place is in the window again
  21F1'   CD 0000*              	CALL	GOTO
  21F4'   C3 2128'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  21F7'                         PUTBRK:
  21F7'   3E 0D                 	MVI	A,CR
  21F9'   CD 0000*              	CALL	PUTGAP
  21FC'   3E 0A                 	MVI	A,LF
  21FE'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  2201'                         EX_WR:
  2201'   3A 2DE3'              	LDA	EXARG
  2204'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  2205'   CA 25FF'              	JZ	MSGNFN		; No file name
  2208'   CD 2448'              	CALL	ISOWN
  220B'   CA 22AB'              	JZ	EXW_OW
  220E'   CD 0000*              	CALL	TEXIST
  2211'   32 2E4C'              	STA	RWERR		; nonzero: a file of that name is there
  2214'   CA 221E'              	JZ	EXW_GO
  2217'   3A 2DF5'              	LDA	EXBANG
  221A'   B7                    	ORA	A
  221B'   C2 2605'              	JNZ	MSGEXI		; File exists (! to force)
  221E'                         EXW_GO:
  221E'   CD 21B7'              	CALL	EXRNG
  2221'   DA 22A5'              	JC	EXW_BD
  2224'   CD 21DF'              	CALL	EXSAVP
  2227'   2A 2E3F'              	LHLD	SRNG1
  222A'   CD 21D3'              	CALL	GOLNX
  222D'   C2 22A2'              	JNZ	EXW_NL		; the text has no line N
  2230'   3A 2E4C'              	LDA	RWERR		; a delete scans the whole directory, there or
  2233'   B7                    	ORA	A		;   not: only when TEXIST found one
  2234'   0E 13                 	MVI	C,13H
  2236'   C4 21A7'              	CNZ	TFDOS		; delete what is there
  2239'   0E 16                 	MVI	C,16H
  223B'   CD 21A7'              	CALL	TFDOS		; ... and make it
  223E'   3C                    	INR	A
  223F'   CA 2294'              	JZ	EXW_FL		; no directory entry left
  2242'   3E 80                 	MVI	A,80H
  2244'   32 2E4B'              	STA	RWPTR
  2247'   AF                    	XRA	A
  2248'   32 2E4C'              	STA	RWERR
  224B'   2A 2E49'              	LHLD	SLINES
  224E'   CD 0000*              	CALL	SETC0		; that many lines, forward
  2251'                         EXW_LP:
  2251'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  2254'   E5                    	PUSH	H
  2255'   EB                    	XCHG
  2256'   2A 0000*              	LHLD	GAPEND
  2259'   CD 22B1'              	CALL	RWOUT		; the text from the cursor to there
  225C'   E1                    	POP	H
  225D'   3A 2E4C'              	LDA	RWERR
  2260'   B7                    	ORA	A
  2261'   C2 227D'              	JNZ	EXW_EN
  2264'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  2267'   CD 06E0'              	CALL	CNTTST
  226A'   C2 2251'              	JNZ	EXW_LP
  226D'                         EXW_PD:				; the last record is padded out with ^Z
  226D'   3A 2E4B'              	LDA	RWPTR
  2270'   FE 80                 	CPI	80H
  2272'   CA 227D'              	JZ	EXW_EN
  2275'   3E 1A                 	MVI	A,CPMEOF
  2277'   CD 22BD'              	CALL	RWPUT
  227A'   C3 226D'              	JMP	EXW_PD
  227D'                         EXW_EN:
  227D'   0E 10                 	MVI	C,10H
  227F'   CD 21A7'              	CALL	TFDOS		; close
  2282'   3A 2E4C'              	LDA	RWERR
  2285'   B7                    	ORA	A
  2286'   C2 2294'              	JNZ	EXW_FL
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  2289'   CD 21EB'              	CALL	EXRSTP
  228C'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  228E'   32 2DF3'              	STA	MSGWHT
  2291'   C3 07A0'              	JMP	SETMOV		; nothing on the screen has changed
  2294'                         EXW_FL:				; no room: the part written is not left behind
  2294'   0E 13                 	MVI	C,13H
  2296'   CD 21A7'              	CALL	TFDOS
  2299'   CD 21EB'              	CALL	EXRSTP
  229C'   21 27CC'              	LXI	H,SDFUL
  229F'   C3 2637'              	JMP	EXERR
  22A2'                         EXW_NL:
  22A2'   CD 21EB'              	CALL	EXRSTP
  22A5'                         EXW_BD:
  22A5'   21 27BE'              	LXI	H,SRNGE
  22A8'   C3 2637'              	JMP	EXERR
  22AB'                         EXW_OW:
  22AB'   21 2666'              	LXI	H,SEXI
  22AE'   C3 2637'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  22B1'                         RWOUT:
  22B1'   CD 0000*              	CALL	CMP16
  22B4'   C8                    	RZ
  22B5'   7E                    	MOV	A,M
  22B6'   23                    	INX	H
  22B7'   CD 22BD'              	CALL	RWPUT
  22BA'   C3 22B1'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  22BD'                         RWPUT:
  22BD'   E5                    	PUSH	H
  22BE'   F5                    	PUSH	PSW
  22BF'   3A 2E4B'              	LDA	RWPTR
  22C2'   6F                    	MOV	L,A
  22C3'   26 00                 	MVI	H,0
  22C5'   F1                    	POP	PSW
  22C6'   77                    	MOV	M,A
  22C7'   2C                    	INR	L		; Z: that was the record's last byte
  22C8'   7D                    	MOV	A,L
  22C9'   C2 22DC'              	JNZ	RWP_ST
  22CC'   D5                    	PUSH	D
  22CD'   0E 15                 	MVI	C,15H
  22CF'   CD 21A7'              	CALL	TFDOS		; write it
  22D2'   D1                    	POP	D
  22D3'   B7                    	ORA	A
  22D4'   CA 22DA'              	JZ	RWP_OK
  22D7'   32 2E4C'              	STA	RWERR
  22DA'                         RWP_OK:
  22DA'   3E 80                 	MVI	A,80H
  22DC'                         RWP_ST:
  22DC'   32 2E4B'              	STA	RWPTR
  22DF'   E1                    	POP	H
  22E0'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  22E1'                         EX_R:
  22E1'   3A 2DE3'              	LDA	EXARG
  22E4'   B7                    	ORA	A
  22E5'   CA 25FF'              	JZ	MSGNFN		; No file name
  22E8'   0E 0F                 	MVI	C,0FH
  22EA'   CD 21A7'              	CALL	TFDOS		; open
  22ED'   3C                    	INR	A
  22EE'   CA 23BB'              	JZ	ER_NOF
  22F1'   CD 127A'              	CALL	GZONE		; the screen's top line, before anything moves
  22F4'   CD 21DF'              	CALL	EXSAVP
  22F7'   3A 2E3E'              	LDA	SRNGF
  22FA'   B7                    	ORA	A
  22FB'   CA 2314'              	JZ	ER_NXT		; no line given: below the cursor's
  22FE'   2A 2E41'              	LHLD	SRNG2
  2301'   7C                    	MOV	A,H
  2302'   B5                    	ORA	L
  2303'   C2 230E'              	JNZ	ER_LN
  2306'   23                    	INX	H
  2307'   CD 11E8'              	CALL	GOLN		; ':0r': above line 1 ...
  230A'   AF                    	XRA	A		;   which never wants a line end put in first
  230B'   C3 2336'              	JMP	ER_BRK
  230E'                         ER_LN:
  230E'   CD 21D3'              	CALL	GOLNX
  2311'   C2 22A2'              	JNZ	EXW_NL		; the text has no line N
  2314'                         ER_NXT:
  2314'   21 0001               	LXI	H,1
  2317'   AF                    	XRA	A
  2318'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  231B'   CD 0A84'              	CALL	ATEOF
  231E'   3E 00                 	MVI	A,0
  2320'   D2 2336'              	JNC	ER_BRK		; text follows
  2323'   2A 0000*              	LHLD	GAPBEG
  2326'   EB                    	XCHG
  2327'   2A 0000*              	LHLD	TXTBEG
  232A'   CD 0000*              	CALL	CMP16
  232D'   3E 01                 	MVI	A,1
  232F'   CA 2336'              	JZ	ER_BRK		; nothing before the cursor either
  2332'   1B                    	DCX	D
  2333'   1A                    	LDAX	D
  2334'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  2336'                         ER_BRK:
  2336'   32 2E4E'              	STA	RDBRK
  2339'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  233C'   AF                    	XRA	A
  233D'   32 2E4D'              	STA	RDANY
  2340'                         ER_LP:
  2340'   0E 14                 	MVI	C,14H
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  2342'   CD 21A7'              	CALL	TFDOS		; the next record
  2345'   B7                    	ORA	A
  2346'   C2 2379'              	JNZ	ER_END
  2349'   21 0080               	LXI	H,CMDTAIL
  234C'   0E 00                 	MVI	C,0
  234E'                         ER_SC:				; C = its bytes, up to a ^Z
  234E'   7E                    	MOV	A,M
  234F'   FE 1A                 	CPI	CPMEOF
  2351'   CA 2359'              	JZ	ER_GOT
  2354'   23                    	INX	H
  2355'   0C                    	INR	C
  2356'   F2 234E'              	JP	ER_SC		; (minus: all 128)
  2359'                         ER_GOT:
  2359'   79                    	MOV	A,C
  235A'   B7                    	ORA	A
  235B'   CA 2379'              	JZ	ER_END
  235E'   C5                    	PUSH	B
  235F'   3A 2E4D'              	LDA	RDANY
  2362'   B7                    	ORA	A
  2363'   CC 23AA'              	CZ	ER_1ST
  2366'   C1                    	POP	B
  2367'   06 00                 	MVI	B,0
  2369'   11 0080               	LXI	D,CMDTAIL
  236C'   C5                    	PUSH	B
  236D'   CD 0000*              	CALL	INSBLK
  2370'   C1                    	POP	B
  2371'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  2374'   79                    	MOV	A,C
  2375'   17                    	RAL
  2376'   DA 2340'              	JC	ER_LP		; a full record: there may be more
  2379'                         ER_END:
  2379'   3A 2E4D'              	LDA	RDANY
  237C'   B7                    	ORA	A
  237D'   CA 239B'              	JZ	ER_PL		; nothing in the file: nothing has changed
  2380'   CD 0A84'              	CALL	ATEOF
  2383'   DA 2390'              	JC	ER_MD		; the text now ends as the file read ends
  2386'   2A 0000*              	LHLD	GAPBEG
  2389'   2B                    	DCX	H
  238A'   7E                    	MOV	A,M
  238B'   FE 0A                 	CPI	LF
  238D'   C4 21F7'              	CNZ	PUTBRK		; text follows: what was read ends a line
  2390'                         ER_MD:
  2390'   3E 01                 	MVI	A,1
  2392'   32 2D7E'              	STA	MODF
  2395'   CD 03A9'              	CALL	MKPAGE		; back to the first line read
  2398'   CD 0000*              	CALL	GOTO
  239B'                         ER_PL:
  239B'   CD 0A84'              	CALL	ATEOF
  239E'   DC 0A8A'              	CC	LASTLN		; (nothing read, at the end: the last line)
  23A1'   CD 0000*              	CALL	CLRCNT
  23A4'   CD 1292'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  23A7'   C3 07DD'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  23AA'                         ER_1ST:
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  23AA'   3C                    	INR	A
  23AB'   32 2E4D'              	STA	RDANY
  23AE'   3A 2E4E'              	LDA	RDBRK
  23B1'   B7                    	ORA	A
  23B2'   C4 21F7'              	CNZ	PUTBRK
  23B5'   21 2E20'              	LXI	H,MKPOS
  23B8'   C3 0429'              	JMP	FPSTO
  23BB'                         ER_NOF:
  23BB'   21 27AD'              	LXI	H,SNOPN
  23BE'   C3 262C'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  23C1'                         WRCHK:
  23C1'   3A 2DE3'              	LDA	EXARG
  23C4'   B7                    	ORA	A
  23C5'   C2 23CF'              	JNZ	WC_ARG
  23C8'   CD 2432'              	CALL	OWNTF
  23CB'   D8                    	RC
  23CC'   C3 23E4'              	JMP	WC_OWN
  23CF'                         WC_ARG:
  23CF'   CD 2448'              	CALL	ISOWN
  23D2'   CA 23E4'              	JZ	WC_OWN
  23D5'   3A 2DF5'              	LDA	EXBANG
  23D8'   B7                    	ORA	A
  23D9'   CA 23E2'              	JZ	WC_OTH
  23DC'   CD 0000*              	CALL	TEXIST
  23DF'   C2 2605'              	JNZ	MSGEXI		; File exists (! to force)
  23E2'                         WC_OTH:
  23E2'   AF                    	XRA	A		; (NC)
  23E3'   C9                    	RET
  23E4'                         WC_OWN:
  23E4'   3A 2DF6'              	LDA	ROFLAG		; '-R': this is the file it may not write
  23E7'   B7                    	ORA	A
  23E8'   CA 23F2'              	JZ	WC_OK
  23EB'   3A 2DF5'              	LDA	EXBANG
  23EE'   B7                    	ORA	A
  23EF'   C2 260B'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  23F2'                         WC_OK:
  23F2'   3E 01                 	MVI	A,1
  23F4'   B7                    	ORA	A		; (NC)
  23F5'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  23F6'                         WRITE:
  23F6'   3A 2DE4'              	LDA	EXBAK
  23F9'   CD 0000*              	CALL	WRTO
  23FC'   3A 0001*              	LDA	FNAME+1
  23FF'   FE 20                 	CPI	' '
  2401'   C2 240D'              	JNZ	WR_HAS
  2404'   21 0000*              	LXI	H,TFCB
  2407'   11 0000*              	LXI	D,FNAME
  240A'   CD 245A'              	CALL	COPY12
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  240D'                         WR_HAS:
  240D'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  240F'   32 2DF3'              	STA	MSGWHT
  2412'   CD 2448'              	CALL	ISOWN
  2415'   C2 241F'              	JNZ	SRCTF
  2418'   AF                    	XRA	A
  2419'   32 2D7E'              	STA	MODF
  241C'   32 2DF4'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  241F'                         SRCTF:
  241F'   21 0000*              	LXI	H,TFCB
  2422'   11 005C               	LXI	D,DFTFCB
  2425'   CD 245A'              	CALL	COPY12
  2428'   AF                    	XRA	A
  2429'   06 04                 	MVI	B,4
  242B'                         SRC_Z:
  242B'   12                    	STAX	D		; extent, s1, s2, record count: 0
  242C'   13                    	INX	D
  242D'   05                    	DCR	B
  242E'   C2 242B'              	JNZ	SRC_Z
  2431'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  2432'                         OWNTF:
  2432'   3A 0001*              	LDA	FNAME+1
  2435'   FE 20                 	CPI	' '
  2437'   CA 25FF'              	JZ	MSGNFN
  243A'   CD 2465'              	CALL	TFCLR
  243D'   21 0000*              	LXI	H,FNAME
  2440'   11 0000*              	LXI	D,TFCB
  2443'   CD 245A'              	CALL	COPY12
  2446'   B7                    	ORA	A		; (NC)
  2447'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  2448'                         ISOWN:
  2448'   21 0000*              	LXI	H,TFCB
  244B'   11 0000*              	LXI	D,FNAME
  244E'   06 0C                 	MVI	B,12
  2450'                         IO_LP:
  2450'   1A                    	LDAX	D
  2451'   BE                    	CMP	M
  2452'   C0                    	RNZ
  2453'   23                    	INX	H
  2454'   13                    	INX	D
  2455'   05                    	DCR	B
  2456'   C2 2450'              	JNZ	IO_LP
  2459'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  245A'                         COPY12:
  245A'   06 0C                 	MVI	B,12
  245C'                         CP_LP:
  245C'   7E                    	MOV	A,M
  245D'   12                    	STAX	D
  245E'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  245F'   13                    	INX	D
  2460'   05                    	DCR	B
  2461'   C2 245C'              	JNZ	CP_LP
  2464'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  2465'                         TFCLR:
  2465'   11 0000*              	LXI	D,TFCB
  2468'   06 24                 	MVI	B,36
  246A'   AF                    	XRA	A
  246B'                         TC_LP:
  246B'   12                    	STAX	D
  246C'   13                    	INX	D
  246D'   05                    	DCR	B
  246E'   C2 246B'              	JNZ	TC_LP
  2471'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  2472'                         FOPEN:
  2472'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  2474'   32 2DF3'              	STA	MSGWHT
  2477'   21 005C               	LXI	H,DFTFCB
  247A'   CD 2548'              	CALL	NRMDRV
  247D'   11 0000*              	LXI	D,FNAME
  2480'   CD 245A'              	CALL	COPY12
  2483'   CD 0000*              	CALL	OPENZ
  2486'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  2489'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  248B'   C8                    	RZ
  248C'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  248F'   32 2DF4'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  2492'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  2493'                         ARGSCN:
  2493'   3A 0080               	LDA	CMDTAIL
  2496'   47                    	MOV	B,A		; B = what is left of the line
  2497'   B7                    	ORA	A
  2498'   C8                    	RZ
  2499'   21 0081               	LXI	H,CMDTAIL+1
  249C'                         AS_TOK:				; at a token, or the blanks before one
  249C'   7E                    	MOV	A,M
  249D'   FE 20                 	CPI	' '
  249F'   C2 24A8'              	JNZ	AS_OPT
  24A2'   23                    	INX	H
  24A3'   05                    	DCR	B
  24A4'   C2 249C'              	JNZ	AS_TOK
  24A7'   C9                    	RET
  24A8'                         AS_OPT:
  24A8'   FE 2B                 	CPI	'+'
  24AA'   CA 24D4'              	JZ	AS_PLS
  24AD'   FE 2D                 	CPI	'-'
  24AF'   CA 24C3'              	JZ	AS_SW
  24B2'   FE 2F                 	CPI	'/'
  24B4'   CA 24C3'              	JZ	AS_SW
  24B7'                         AS_SKP:				; not ours (the file name): on to the next one
  24B7'   23                    	INX	H
  24B8'   05                    	DCR	B
  24B9'   C8                    	RZ
  24BA'   7E                    	MOV	A,M
  24BB'   FE 20                 	CPI	' '
  24BD'   C2 24B7'              	JNZ	AS_SKP
  24C0'   C3 249C'              	JMP	AS_TOK
  24C3'                         AS_SW:
  24C3'   23                    	INX	H
  24C4'   05                    	DCR	B
  24C5'   C8                    	RZ
  24C6'   7E                    	MOV	A,M
  24C7'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  24C9'   FE 52                 	CPI	'R'
  24CB'   C2 24B7'              	JNZ	AS_SKP
  24CE'   32 2DF6'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  24D1'   C3 24B7'              	JMP	AS_SKP
  24D4'                         AS_PLS:
  24D4'   3E 01                 	MVI	A,1
  24D6'   32 2DF7'              	STA	PLUSF		; '+' gets the line even with no number on it
  24D9'   11 0000*              	LXI	D,PLUSB
  24DC'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  24DE'   23                    	INX	H		;   line space, so it is taken as '+' alone
  24DF'   05                    	DCR	B
  24E0'   CA 2517'              	JZ	AS_PE
  24E3'   7E                    	MOV	A,M
  24E4'   FE 30                 	CPI	'0'
  24E6'   C2 24FE'              	JNZ	AS_PD
  24E9'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  24E9'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  24EA'   05                    	DCR	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  24EB'   CA 251F'              	JZ	AS_P1
  24EE'   7E                    	MOV	A,M
  24EF'   FE 30                 	CPI	'0'
  24F1'   CA 24E9'              	JZ	AS_PZ
  24F4'   FE 31                 	CPI	'1'
  24F6'   DA 251F'              	JC	AS_P1		; zeros and then no digit at all: line 1
  24F9'   FE 3A                 	CPI	'9'+1
  24FB'   D2 251F'              	JNC	AS_P1
  24FE'                         AS_PD:				; the digits, as typed
  24FE'   7E                    	MOV	A,M
  24FF'   FE 30                 	CPI	'0'
  2501'   DA 2517'              	JC	AS_PE
  2504'   FE 3A                 	CPI	'9'+1
  2506'   D2 2517'              	JNC	AS_PE
  2509'   79                    	MOV	A,C
  250A'   B7                    	ORA	A
  250B'   CA 2526'              	JZ	AS_POV
  250E'   0D                    	DCR	C
  250F'   7E                    	MOV	A,M
  2510'   12                    	STAX	D
  2511'   13                    	INX	D
  2512'   23                    	INX	H
  2513'   05                    	DCR	B
  2514'   C2 24FE'              	JNZ	AS_PD
  2517'                         AS_PE:
  2517'   AF                    	XRA	A
  2518'   12                    	STAX	D		; the digits end with a 0
  2519'   78                    	MOV	A,B
  251A'   B7                    	ORA	A
  251B'   C8                    	RZ
  251C'   C3 249C'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  251F'                         AS_P1:
  251F'   3E 31                 	MVI	A,'1'
  2521'   12                    	STAX	D
  2522'   13                    	INX	D
  2523'   C3 2517'              	JMP	AS_PE
  2526'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  2526'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  2529'   C3 2517'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  252C'                         ARGGO:
  252C'   3A 2DF7'              	LDA	PLUSF
  252F'   B7                    	ORA	A
  2530'   C8                    	RZ
  2531'   21 0000*              	LXI	H,PLUSB
