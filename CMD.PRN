  1D0D'   46 69 6C 65           SEXI:	DB	'File exists',0
  1D11'   20 65 78 69           
  1D15'   73 74 73 00           
  1D19'   27 2D 52 27           SRO:	DB	'''-R'' is set',0
  1D1D'   20 69 73 20           
  1D21'   73 65 74 00           
