                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the current row is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; current line changed only -> redraw that one row
  0003                   C      R_DLIN	EQU	3		; one line deleted at the cursor row -> DL + redraw bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted mid-line -> ICH (no tail redraw)
  0005                   C      R_ILIN	EQU	5		; one line opened at the cursor row -> IL + redraw that row and the one above
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw that row + DL the one under it
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: its offset, then PGTOPM when it was set
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      
                         C      ;------------------------------------------------------------
                         C      ; KEY DECODER -- GETKEY return types (B) and action codes (C when B=KT_ACT).
                         C      ; See KEY.MAC.
                         C      ;------------------------------------------------------------
  0000                   C      KT_NONE EQU	0		; no key (unrecognised ESC sequence, discarded)
  0001                   C      KT_ACT	EQU	1		; C = ACT_xxx action code
  0002                   C      KT_CHAR EQU	2		; C = ASCII character (printable or control)
                         C      
  0001                   C      ACT_CURUP EQU	1		; cursor up    (ESC[A / ESC OA)
  0002                   C      ACT_CURDN EQU	2		; cursor down  (ESC[B / ESC OB)
  0003                   C      ACT_CURRT EQU	3		; cursor right (ESC[C / ESC OC)
  0004                   C      ACT_CURLT EQU	4		; cursor left  (ESC[D / ESC OD)
  0005                   C      ACT_LINST EQU	5		; Home / line start (ESC[H / ESC[1~)
  0006                   C      ACT_LINEN EQU	6		; End  / line end   (ESC[F / ESC[4~)
  0007                   C      ACT_PGUP  EQU	7		; page up   (ESC[5~)
  0008                   C      ACT_PGDN  EQU	8		; page down (ESC[6~)
  0009                   C      ACT_INS	  EQU	9		; Insert key (ESC[2~)
  000A                   C      ACT_DEL	  EQU	10		; Delete key (ESC[3~)
  000B                   C      ACT_ESC	  EQU	11		; lone ESC (after timeout)
  000B                   C      ACT_MAX	  EQU	11		; highest defined action code
                         C      
  01F4                   C      ESCTMO	EQU	500		; polls before a lone ESC is confirmed
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	COL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
                                	EXTRN	SCBOT, SCEOF, SCBOF, WFILL	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	DELLN, SETC0			; BUF.MAC -- WM line kill (dd)
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   CD 00D9'              	CALL	DOTPRE
  0003'   CD 0009'              	CALL	CDMODE
  0006'   C3 0130'              	JMP	DOTPOST
  0009'                         CDMODE:
  0009'   3A 2279'              	LDA	EDMODE
  000C'   FE 01                 	CPI	EM_INS
  000E'   CA 0019'              	JZ	CD_INS
  0011'   FE 02                 	CPI	EM_REP
  0013'   CA 001C'              	JZ	CD_REP
  0016'   C3 001F'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  0019'                         CD_INS:
  0019'   C3 165E'              	JMP	VIINS
  001C'                         CD_REP:
  001C'   C3 159E'              	JMP	VIREP
                                
                                ;============================================================
                                ; VICMD -- command-mode key.  B = KT type, C = char / action.
                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  001F'                         VICMD:
  001F'   78                    	MOV	A,B
  0020'   FE 00                 	CPI	KT_NONE
  0022'   C8                    	RZ			; discarded key
  0023'   FE 01                 	CPI	KT_ACT
  0025'   CA 00AB'              	JZ	VIC_ACT
  0028'   3A 22A1'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002B'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  002D'   CA 1201'              	JZ	VR_DO
                                	;--- KT_CHAR: maybe a count digit ---
  0030'   79                    	MOV	A,C
  0031'   FE 31                 	CPI	'1'
  0033'   DA 003E'              	JC	VIC_NOTD	; < '1'
  0036'   FE 3A                 	CPI	'9'+1
  0038'   D2 003E'              	JNC	VIC_NOTD	; > '9'
  003B'   C3 004E'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  003E'                         VIC_NOTD:
  003E'   79                    	MOV	A,C
  003F'   FE 30                 	CPI	'0'
  0041'   C2 0076'              	JNZ	VICDSP
  0044'   2A 227A'              	LHLD	CMDCNT
  0047'   7C                    	MOV	A,H
  0048'   B5                    	ORA	L
  0049'   CA 0076'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  004C'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  004E'                         VICDIG:
  004E'   2A 227A'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0051'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0052'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0053'   29                    	DAD	H		; *2
  0054'   DA 006D'              	JC	VIC_SAT
  0057'   29                    	DAD	H		; *4
  0058'   DA 006D'              	JC	VIC_SAT
  005B'   19                    	DAD	D		; *5
  005C'   DA 006D'              	JC	VIC_SAT
  005F'   29                    	DAD	H		; *10
  0060'   DA 006D'              	JC	VIC_SAT
  0063'   79                    	MOV	A,C
  0064'   D6 30                 	SUI	'0'
  0066'   5F                    	MOV	E,A
  0067'   16 00                 	MVI	D,0
  0069'   19                    	DAD	D
  006A'   D2 0070'              	JNC	VIC_CNT
  006D'                         VIC_SAT:
  006D'   21 FFFF               	LXI	H,0FFFFH
  0070'                         VIC_CNT:
  0070'   22 227A'              	SHLD	CMDCNT
  0073'   C3 04F1'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  0076'                         VICDSP:
  0076'   3A 22A1'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  0079'   32 22A2'              	STA	GSAVE
  007C'   AF                    	XRA	A
  007D'   32 22A1'              	STA	GPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  0080'   3A 22A3'              	LDA	PENDOP
  0083'   32 22A4'              	STA	PSAVE
  0086'   AF                    	XRA	A
  0087'   32 22A3'              	STA	PENDOP
  008A'   3A 22A4'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  008D'   B7                    	ORA	A
  008E'   C2 0DCB'              	JNZ	OPPEND
  0091'   3A 22A2'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0094'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  0096'   C2 009F'              	JNZ	VIC_TB
  0099'   79                    	MOV	A,C
  009A'   FE 5A                 	CPI	'Z'
  009C'   C2 00A5'              	JNZ	VIC_SW
  009F'                         VIC_TB:
  009F'   21 21BA'              	LXI	H,CMDTAB
  00A2'   C3 00BE'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A5'                         VIC_SW:
  00A5'   CD 04F1'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00A8'   C3 0484'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AB'                         VIC_ACT:
  00AB'   AF                    	XRA	A		; action key clears all pending state
  00AC'   32 22A1'              	STA	GPEND
  00AF'   32 22A2'              	STA	GSAVE
  00B2'   32 22A3'              	STA	PENDOP
  00B5'   32 22A4'              	STA	PSAVE
  00B8'   21 2260'              	LXI	H,ACTTAB
  00BB'   C3 00BE'              	JMP	VSCANQ
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the two TOP-LEVEL key tables, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00BE'                         VSCANQ:
  00BE'   CD 00CA'              	CALL	VSCLK
  00C1'   CA 00A5'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C4'   E9                    	PCHL
  00C5'                         VSCAN:
  00C5'   CD 00CA'              	CALL	VSCLK
  00C8'   C8                    	RZ			; miss
  00C9'   E9                    	PCHL
  00CA'                         VSCLK:
  00CA'   7E                    VSCAN1: MOV	A,M
  00CB'   B7                    	ORA	A
  00CC'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00CD'   23                    	INX	H
  00CE'   B9                    	CMP	C
  00CF'   5E                    	MOV	E,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00D0'   23                    	INX	H
  00D1'   56                    	MOV	D,M
  00D2'   23                    	INX	H
  00D3'   C2 00CA'              	JNZ	VSCAN1
  00D6'   EB                    	XCHG			; HL = the handler
  00D7'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00D8'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00D9'                         DOTPRE:
  00D9'   3A 2298'              	LDA	DOTRPL
  00DC'   B7                    	ORA	A
  00DD'   C0                    	RNZ			; the replay's own keys are not recorded
  00DE'   C5                    	PUSH	B
  00DF'   D5                    	PUSH	D
  00E0'   E5                    	PUSH	H
  00E1'   3A 2297'              	LDA	DOTSTA
  00E4'   B7                    	ORA	A
  00E5'   CA 00F8'              	JZ	DOTP1
  00E8'   AF                    	XRA	A		; a new command: the recording starts over
  00E9'   32 2297'              	STA	DOTSTA
  00EC'   32 2299'              	STA	DOTOVF
  00EF'   21 0000*              	LXI	H,DOTSCR
  00F2'   22 229B'              	SHLD	DOTSP
  00F5'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00F8'                         DOTP1:
  00F8'   78                    	MOV	A,B
  00F9'   FE 00                 	CPI	KT_NONE
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00FB'   CA 0124'              	JZ	DOTPX		; a discarded key is not a keystroke
  00FE'   FE 01                 	CPI	KT_ACT
  0100'   79                    	MOV	A,C
  0101'   CA 0109'              	JZ	DOTP2
  0104'   E6 7F                 	ANI	7FH		; a char stands for itself (CPYGAP masks inserts
  0106'   C3 010B'              	JMP	DOTP3		;   the same way), bit 7 marks an action key
  0109'                         DOTP2:
  0109'   F6 80                 	ORI	80H		; an action key (an arrow) rides in bit 7
  010B'                         DOTP3:
  010B'   32 229A'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  010E'   47                    	MOV	B,A
  010F'   2A 229B'              	LHLD	DOTSP
  0112'   EB                    	XCHG
  0113'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  0116'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  0119'   D2 0128'              	JNC	DOTPOV
  011C'   2A 229B'              	LHLD	DOTSP
  011F'   70                    	MOV	M,B
  0120'   23                    	INX	H
  0121'   22 229B'              	SHLD	DOTSP
  0124'                         DOTPX:
  0124'   E1                    	POP	H
  0125'   D1                    	POP	D
  0126'   C1                    	POP	B
  0127'   C9                    	RET
  0128'                         DOTPOV:
  0128'   3E 01                 	MVI	A,1
  012A'   32 2299'              	STA	DOTOVF		; too long to record: give this recording up
  012D'   C3 0124'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  0130'                         DOTPOST:
  0130'   3A 2298'              	LDA	DOTRPL
  0133'   B7                    	ORA	A
  0134'   C0                    	RNZ
  0135'   3A 2279'              	LDA	EDMODE
  0138'   B7                    	ORA	A
  0139'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  013A'   3A 22A1'              	LDA	GPEND
  013D'   B7                    	ORA	A
  013E'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  013F'   3A 22A3'              	LDA	PENDOP
  0142'   B7                    	ORA	A
  0143'   C0                    	RNZ			; an operator still waiting for its motion
  0144'   2A 227A'              	LHLD	CMDCNT
  0147'   7C                    	MOV	A,H
  0148'   B5                    	ORA	L
  0149'   CA 0157'              	JZ	DOTQ1
  014C'   3A 229A'              	LDA	DOTLK		; a digit with the count still up: the command
  014F'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  0151'   DA 0157'              	JC	DOTQ1
  0154'   FE 3A                 	CPI	'9'+1
  0156'   D8                    	RC
  0157'                         DOTQ1:
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0157'   3E 01                 	MVI	A,1
  0159'   32 2297'              	STA	DOTSTA		; the next key starts a new recording
  015C'   3A 2296'              	LDA	DOTCHG
  015F'   B7                    	ORA	A
  0160'   C8                    	RZ			; changed nothing: not a repeatable command
  0161'   AF                    	XRA	A
  0162'   32 2296'              	STA	DOTCHG
  0165'   32 229D'              	STA	DOTLEN
  0168'   3A 2299'              	LDA	DOTOVF
  016B'   B7                    	ORA	A
  016C'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  016D'   2A 229B'              	LHLD	DOTSP
  0170'   11 0000*              	LXI	D,DOTSCR
  0173'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  0176'   7D                    	MOV	A,L
  0177'   32 229D'              	STA	DOTLEN
  017A'   B7                    	ORA	A
  017B'   C8                    	RZ
  017C'   4F                    	MOV	C,A
  017D'   06 00                 	MVI	B,0
  017F'   21 0000*              	LXI	H,DOTSCR
  0182'   11 0000*              	LXI	D,DOTBUF
  0185'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  0188'                         MARKMOD:
  0188'   CD 02C7'              	CALL	MKDROP		; any mark this edit leaves pointing wrong
  018B'   3E 01                 	MVI	A,1
  018D'   32 227D'              	STA	MODF
  0190'   32 2296'              	STA	DOTCHG
  0193'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  0194'                         VC_DOT:
  0194'   2A 227A'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0197'   22 229F'              	SHLD	DOTNCT
  019A'   21 0000               	LXI	H,0
  019D'   22 227A'              	SHLD	CMDCNT
  01A0'   3A 229D'              	LDA	DOTLEN
  01A3'   B7                    	ORA	A
  01A4'   CA 01FE'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
  01A7'   AF                    	XRA	A
  01A8'   32 229E'              	STA	DOTIX
  01AB'   2A 229F'              	LHLD	DOTNCT
  01AE'   7C                    	MOV	A,H
  01AF'   B5                    	ORA	L
  01B0'   CA 01D0'              	JZ	DOTGO
  01B3'   22 227A'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  01B6'                         DOTSKP:
  01B6'   CD 035D'              	CALL	DOTGET		; ... so step past the digits it recorded
  01B9'   DA 01D0'              	JC	DOTGO
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01BC'   FE 30                 	CPI	'0'
  01BE'   DA 01D0'              	JC	DOTGO
  01C1'   FE 3A                 	CPI	'9'+1
  01C3'   D2 01D0'              	JNC	DOTGO
  01C6'   3A 229E'              	LDA	DOTIX
  01C9'   3C                    	INR	A
  01CA'   32 229E'              	STA	DOTIX
  01CD'   C3 01B6'              	JMP	DOTSKP
  01D0'                         DOTGO:
  01D0'   3E 01                 	MVI	A,1
  01D2'   32 2298'              	STA	DOTRPL
  01D5'                         DOTLP:
  01D5'   CD 035D'              	CALL	DOTGET
  01D8'   DA 01F4'              	JC	DOTDN
  01DB'   4F                    	MOV	C,A
  01DC'   06 02                 	MVI	B,KT_CHAR
  01DE'   B7                    	ORA	A
  01DF'   F2 01E7'              	JP	DOTLP2
  01E2'   E6 7F                 	ANI	7FH		; bit 7: the key was an action, not a char
  01E4'   4F                    	MOV	C,A
  01E5'   06 01                 	MVI	B,KT_ACT
  01E7'                         DOTLP2:
  01E7'   3A 229E'              	LDA	DOTIX
  01EA'   3C                    	INR	A
  01EB'   32 229E'              	STA	DOTIX
  01EE'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01F1'   C3 01D5'              	JMP	DOTLP
  01F4'                         DOTDN:
  01F4'   AF                    	XRA	A
  01F5'   32 2298'              	STA	DOTRPL
  01F8'   32 2296'              	STA	DOTCHG		; the '.' is not itself the new last change
  01FB'   C3 0512'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01FE'                         DOTBEL:
  01FE'   0E 07                 	MVI	C,BEL
  0200'   CD 0000*              	CALL	BCONOU
  0203'   C3 04F1'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a logical offset plus the PGTOPM the window carried when it was
                                ; set.  It is DROPPED, never shifted, the moment it could no longer point at
                                ; the same text: MKDROP clears it when an edit happens at or before it, and a
                                ; jump refuses when the window has paged since.  That is the decided
                                ; behaviour -- a mark that survived an edit above it would point somewhere
                                ; plausible and wrong, which is worse than one that admits it is gone.
                                ;
                                ; DEVIATION from vim, deliberate and in COMMANDS.md: vim shifts a mark to
                                ; follow the text.  A consequence worth knowing is that '.' after a 'd''a'
                                ; refuses, because the delete drops the very mark the replay would need.
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
                                ; operand, not a command.
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  0206'                         MKVAD:
  0206'   16 00                 	MVI	D,0
  0208'   59                    	MOV	E,C
  0209'   21 22F2'              	LXI	H,MKVAL
  020C'   19                    	DAD	D
  020D'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  020E'                         MKCLR:
  020E'   21 22F2'              	LXI	H,MKVAL
  0211'   06 03                 	MVI	B,MKMAX
  0213'   AF                    	XRA	A
  0214'                         MKC_LP:
  0214'   77                    	MOV	M,A
  0215'   23                    	INX	H
  0216'   05                    	DCR	B
  0217'   C2 0214'              	JNZ	MKC_LP
  021A'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was not a character.
  021B'                         MKGETK:
  021B'   3A 2298'              	LDA	DOTRPL
  021E'   B7                    	ORA	A
  021F'   CA 0230'              	JZ	MKG_KB
  0222'   CD 035D'              	CALL	DOTGET		; the recording's next key
  0225'   D8                    	RC
  0226'   4F                    	MOV	C,A
  0227'   3A 229E'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  022A'   3C                    	INR	A
  022B'   32 229E'              	STA	DOTIX
  022E'   B7                    	ORA	A		; CY clear
  022F'   C9                    	RET
  0230'                         MKG_KB:
  0230'   CD 0000*              	CALL	GETKEY
  0233'   78                    	MOV	A,B
  0234'   FE 02                 	CPI	KT_CHAR
  0236'   37                    	STC
  0237'   C0                    	RNZ			; an action key (ESC) cancels the command
  0238'   B7                    	ORA	A		; CY clear
  0239'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  023A'                         VC_MK:
  023A'   3E 04                 	MVI	A,PM
  023C'   C3 0246'              	JMP	MKGO
  023F'                         VC_BQ:
  023F'   3E 05                 	MVI	A,PJ
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  0241'   C3 0246'              	JMP	MKGO
  0244'                         VC_AQ:
  0244'   3E 06                 	MVI	A,PJL
  0246'                         MKGO:
  0246'   32 22F7'              	STA	MKWHAT
  0249'   CD 0471'              	CALL	MOVCNT		; a count means nothing on any of the three
  024C'   CD 021B'              	CALL	MKGETK		; the key that names the mark
  024F'   DA 02A7'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out -- the letter is read here and so
                                				;   was never recorded, which is why a '.'
                                				;   after "d'a" refuses (COMMANDS.md).  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist; any other key drops the
                                ;whole thing, as vim's 'Z{other}' does.
  0252'                         MKOP:
  0252'   79                    	MOV	A,C
  0253'   D6 61                 	SUI	'a'
  0255'   FE 03                 	CPI	MKMAX
  0257'   D2 02A7'              	JNC	MKBAD		; not a mark letter: nothing happens
  025A'   4F                    	MOV	C,A		; C = the mark's index
  025B'   87                    	ADD	A
  025C'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  025D'   5F                    	MOV	E,A
  025E'   16 00                 	MVI	D,0
  0260'   21 0000*              	LXI	H,MKTAB
  0263'   19                    	DAD	D		; HL -> this mark's slot
  0264'   3A 22F7'              	LDA	MKWHAT
  0267'   FE 04                 	CPI	PM
  0269'   CA 02AE'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark.  It refuses, with the bell, when the mark was
                                ;never set or when the window has paged away from under it.
  026C'                         MKJMP:
  026C'   E5                    	PUSH	H
  026D'   CD 0206'              	CALL	MKVAD
  0270'   7E                    	MOV	A,M
  0271'   E1                    	POP	H
  0272'   B7                    	ORA	A
  0273'   CA 02A7'              	JZ	MKBAD		; never set
  0276'   5E                    	MOV	E,M
  0277'   23                    	INX	H
  0278'   56                    	MOV	D,M		; DE = the offset it holds
  0279'   23                    	INX	H
  027A'   7E                    	MOV	A,M
  027B'   23                    	INX	H
  027C'   66                    	MOV	H,M
  027D'   6F                    	MOV	L,A		; HL = the window signature it was set under
  027E'   D5                    	PUSH	D
  027F'   EB                    	XCHG			; DE = that signature
  0280'   2A 0000*              	LHLD	PGTOPM
  0283'   7D                    	MOV	A,L
  0284'   BB                    	CMP	E
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  0285'   C2 02A1'              	JNZ	MKSTAL
  0288'   7C                    	MOV	A,H
  0289'   BA                    	CMP	D
  028A'   C2 02A1'              	JNZ	MKSTAL
  028D'   3A 22F7'              	LDA	MKWHAT		; decided BEFORE the GOTO, so no register of
  0290'   FE 06                 	CPI	PJL		;   ours has to survive a BUF primitive
  0292'   CA 029A'              	JZ	MKJ_GO		; ''': GPKEEP is 0, so GPLACE finds the first
  0295'   3E 01                 	MVI	A,1		;   non-blank
  0297'   32 22F1'              	STA	GPKEEP		; '`': land on the column it was set at
  029A'                         MKJ_GO:
  029A'   E1                    	POP	H		; HL = the offset
  029B'   CD 0000*              	CALL	GOTO
  029E'   C3 0CE0'              	JMP	GPLACE		; (which sets LNDLT itself)
  02A1'                         MKSTAL:
  02A1'   E1                    	POP	H		; the window paged: the mark is gone for good
  02A2'   CD 0206'              	CALL	MKVAD
  02A5'   36 00                 	MVI	M,0
                                				; ... and fall into MKBAD
                                
                                ;MKBAD -- this mark will not answer.  An operator running the motion is
                                ;cancelled whole: PSAVE is what OPPEND's tail reads to decide whether to open
                                ;an insert, so clearing it stops a "c`z" opening one over a span of nothing.
  02A7'                         MKBAD:
  02A7'   AF                    	XRA	A
  02A8'   32 22A4'              	STA	PSAVE
  02AB'   C3 01FE'              	JMP	DOTBEL
                                
                                ;MKSET -- remember where the cursor is, and which window it is in.
  02AE'                         MKSET:
  02AE'   E5                    	PUSH	H
  02AF'   CD 0000*              	CALL	CUROFF		; HL = the cursor's logical offset
  02B2'   EB                    	XCHG
  02B3'   2A 0000*              	LHLD	PGTOPM
  02B6'   E3                    	XTHL			; HL = the slot, (SP) = the signature
  02B7'   73                    	MOV	M,E
  02B8'   23                    	INX	H
  02B9'   72                    	MOV	M,D
  02BA'   23                    	INX	H
  02BB'   D1                    	POP	D
  02BC'   73                    	MOV	M,E
  02BD'   23                    	INX	H
  02BE'   72                    	MOV	M,D
  02BF'   CD 0206'              	CALL	MKVAD
  02C2'   36 01                 	MVI	M,1		; ... and the mark is live
  02C4'   C3 04F1'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKDROP -- an edit is happening at the cursor: drop every mark it could have
                                ;left pointing at different text.  A mark BEFORE the edit still names what it
                                ;named; one at or after it does not, because the text moved under it.  Called
                                ;from MARKMOD, so it must come back with every register as it found it.
  02C7'                         MKDROP:
  02C7'   F5                    	PUSH	PSW
  02C8'   3A 22F8'              	LDA	MKHOLD		; a yank takes its lines out and puts them back
  02CB'   B7                    	ORA	A		;   unchanged (VY_YY): the text every mark points
  02CC'   C2 0301'              	JNZ	MKD_HL		;   into is still there, so none of them goes
  02CF'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02D0'   D5                    	PUSH	D
  02D1'   E5                    	PUSH	H
  02D2'   CD 0000*              	CALL	CUROFF		; HL = where the edit is (CUROFF clobbers DE)
  02D5'   22 22F5'              	SHLD	MKEDIT
  02D8'   21 22F2'              	LXI	H,MKVAL
  02DB'   11 0000*              	LXI	D,MKTAB
  02DE'   06 03                 	MVI	B,MKMAX
  02E0'                         MKD_LP:
  02E0'   7E                    	MOV	A,M
  02E1'   B7                    	ORA	A
  02E2'   CA 02F5'              	JZ	MKD_NX		; that mark is not set: nothing to drop
  02E5'   E5                    	PUSH	H
  02E6'   2A 22F5'              	LHLD	MKEDIT
  02E9'   1A                    	LDAX	D		; the mark's offset, low
  02EA'   95                    	SUB	L
  02EB'   13                    	INX	D
  02EC'   1A                    	LDAX	D		; ... and high (neither INX nor LDAX touch CY)
  02ED'   1B                    	DCX	D
  02EE'   9C                    	SBB	H		; CY iff the mark is BEFORE the edit
  02EF'   E1                    	POP	H
  02F0'   DA 02F5'              	JC	MKD_NX
  02F3'   36 00                 	MVI	M,0		; at it or after it: the mark is dropped
  02F5'                         MKD_NX:
  02F5'   23                    	INX	H
  02F6'   13                    	INX	D
  02F7'   13                    	INX	D
  02F8'   13                    	INX	D
  02F9'   13                    	INX	D
  02FA'   05                    	DCR	B
  02FB'   C2 02E0'              	JNZ	MKD_LP
  02FE'   E1                    	POP	H
  02FF'   D1                    	POP	D
  0300'   C1                    	POP	B
  0301'                         MKD_HL:
  0301'   F1                    	POP	PSW
  0302'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  0303'                         VC_UNDO:
  0303'   21 0000               	LXI	H,0
  0306'   22 227A'              	SHLD	CMDCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  0309'   CD 0000*              	CALL	UNDO
  030C'   DA 0340'              	JC	UNDNO
  030F'   2A 0000*              	LHLD	UNDCUR
  0312'   CD 0326'              	CALL	UCLAMP		; vi never sits on a line terminator
  0315'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0318'   CD 02C7'              	CALL	MKDROP		; the undo moved text back under any mark past it
  031B'   3E 01                 	MVI	A,1
  031D'   32 227D'              	STA	MODF		; undone past a ':w' still differs from the file
  0320'   CD 0664'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  0323'   C3 0512'              	JMP	SETFUL		; whole spans moved: repaint rather than guess
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  0326'                         UCLAMP:
  0326'   E5                    	PUSH	H
  0327'   CD 104C'              	CALL	CEND		; HL = the line's content end
  032A'   D1                    	POP	D		; DE = the offset wanted
  032B'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  032E'   D2 0333'              	JNC	UCL_BK
  0331'   EB                    	XCHG
  0332'   C9                    	RET
  0333'                         UCL_BK:
  0333'   E5                    	PUSH	H		; the content end
  0334'   EB                    	XCHG			; HL = the offset wanted
  0335'   CD 03DD'              	CALL	BOL
  0338'   D1                    	POP	D		; DE = the content end, HL = the line's start
  0339'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  033C'   EB                    	XCHG			; HL = the content end
  033D'   C8                    	RZ
  033E'   2B                    	DCX	H		; ... its last character
  033F'   C9                    	RET
  0340'                         UNDNO:
  0340'   3A 0000*              	LDA	UNDWHY
  0343'   B7                    	ORA	A
  0344'   CA 0355'              	JZ	UNDBEL
  0347'   21 1C44'              	LXI	H,SUNDW		; the change has paged away: say so
  034A'   FE 01                 	CPI	1
  034C'   CA 1B8B'              	JZ	EXERR
  034F'   21 1C66'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  0352'   C3 1B8B'              	JMP	EXERR
  0355'                         UNDBEL:
  0355'   0E 07                 	MVI	C,BEL
  0357'   CD 0000*              	CALL	BCONOU
  035A'   C3 04F1'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  035D'                         DOTGET:
  035D'   3A 229E'              	LDA	DOTIX
  0360'   5F                    	MOV	E,A
  0361'   3A 229D'              	LDA	DOTLEN
  0364'   BB                    	CMP	E
  0365'   CA 0371'              	JZ	DOTGEF
  0368'   16 00                 	MVI	D,0
  036A'   21 0000*              	LXI	H,DOTBUF
  036D'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  036E'   7E                    	MOV	A,M
  036F'   B7                    	ORA	A		; CY clear: a key was returned
  0370'   C9                    	RET
  0371'                         DOTGEF:
  0371'   37                    	STC
  0372'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
  0373'                         GOSET:
  0373'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  0376'                         SETGL:
  0376'   CD 0CA2'              	CALL	ZSAVE
  0379'   21 0000               	LXI	H,0
  037C'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  037F'   E5                    	PUSH	H
  0380'   CD 0CB5'              	CALL	ZREST
  0383'   E1                    	POP	H
  0384'   E5                    	PUSH	H
  0385'   CD 047D'              	CALL	GBSUB		; HL = bytes to the cursor
  0388'   44                    	MOV	B,H
  0389'   4D                    	MOV	C,L
  038A'   E1                    	POP	H		; HL = the line's start
  038B'   11 0000               	LXI	D,0		; DE = screen column
  038E'                         SG_LP:
  038E'   78                    	MOV	A,B
  038F'   B1                    	ORA	C
  0390'   CA 03A5'              	JZ	SG_CUR
  0393'   7E                    	MOV	A,M
  0394'   23                    	INX	H
  0395'   0B                    	DCX	B
  0396'   E5                    	PUSH	H
  0397'   6B                    	MOV	L,E
  0398'   CD 03CA'              	CALL	CWID
  039B'   E1                    	POP	H
  039C'   83                    	ADD	E
  039D'   5F                    	MOV	E,A
  039E'   D2 038E'              	JNC	SG_LP
  03A1'   14                    	INR	D
  03A2'   C3 038E'              	JMP	SG_LP
  03A5'                         SG_CUR:
  03A5'   2A 0000*              	LHLD	TXTEND
  03A8'   D5                    	PUSH	D
  03A9'   EB                    	XCHG
  03AA'   2A 0000*              	LHLD	GAPEND
  03AD'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  03B0'   D1                    	POP	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  03B1'   CA 03C5'              	JZ	SG_SET
  03B4'   7E                    	MOV	A,M
  03B5'   FE 09                 	CPI	TAB
  03B7'   C2 03C5'              	JNZ	SG_SET
  03BA'   6B                    	MOV	L,E
  03BB'   CD 03CA'              	CALL	CWID
  03BE'   3D                    	DCR	A		; the TAB's last column
  03BF'   83                    	ADD	E
  03C0'   5F                    	MOV	E,A
  03C1'   D2 03C5'              	JNC	SG_SET
  03C4'   14                    	INR	D
  03C5'                         SG_SET:
  03C5'   EB                    	XCHG
  03C6'   22 2282'              	SHLD	GOALCOL
  03C9'   C9                    	RET
                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  03CA'                         CWID:
  03CA'   FE 0D                 	CPI	CR
  03CC'   CA 03DB'              	JZ	CW_0
  03CF'   FE 09                 	CPI	TAB
  03D1'   3E 01                 	MVI	A,1
  03D3'   C0                    	RNZ
  03D4'   7D                    	MOV	A,L
  03D5'   E6 07                 	ANI	TABWID-1
  03D7'   2F                    	CMA
  03D8'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  03DA'   C9                    	RET
  03DB'                         CW_0:
  03DB'   AF                    	XRA	A
  03DC'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
  03DD'                         BOL:
  03DD'                         BOL_LP:
  03DD'   7C                    	MOV	A,H
  03DE'   B5                    	ORA	L
  03DF'   C8                    	RZ			; at 0
  03E0'   2B                    	DCX	H		; look at off-1
  03E1'   E5                    	PUSH	H
  03E2'   CD 0000*              	CALL	CHARAT
  03E5'   E1                    	POP	H		; HL = off-1
  03E6'   FE 0A                 	CPI	LF
  03E8'   CA 03EE'              	JZ	BOL_DN
  03EB'   C3 03DD'              	JMP	BOL_LP
  03EE'                         BOL_DN:
  03EE'   23                    	INX	H		; line starts just after the LF
  03EF'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  03F0'                         EOLNL:
  03F0'   E5                    	PUSH	H
  03F1'   CD 0000*              	CALL	LOGLEN
  03F4'   22 22B6'              	SHLD	WKN
  03F7'   E1                    	POP	H
  03F8'                         ENL_LP:
  03F8'   EB                    	XCHG			; DE = i
  03F9'   2A 22B6'              	LHLD	WKN
  03FC'   CD 0000*              	CALL	CMP16		; DE=i vs HL=n: CY iff i < n
  03FF'   EB                    	XCHG			; HL = i, DE = n
  0400'   D0                    	RNC			; i >= n: no LF on this line
  0401'   E5                    	PUSH	H
  0402'   CD 0000*              	CALL	CHARAT
  0405'   E1                    	POP	H
  0406'   FE 0A                 	CPI	LF
  0408'   C8                    	RZ			; the LF: HL is its offset
  0409'   23                    	INX	H
  040A'   C3 03F8'              	JMP	ENL_LP
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  040D'                         NLSTART:
  040D'   CD 03F0'              	CALL	EOLNL
  0410'   E5                    	PUSH	H
  0411'   CD 0000*              	CALL	LOGLEN
  0414'   D1                    	POP	D		; DE = eol result
  0415'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  0418'   C8                    	RZ			; no next line: HL = LOGLEN
  0419'   EB                    	XCHG			; HL = eol
  041A'   23                    	INX	H
  041B'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  041C'                         EOLC:
  041C'   E5                    	PUSH	H
  041D'   CD 03F0'              	CALL	EOLNL
  0420'   22 22B8'              	SHLD	WKTERM
  0423'   E1                    	POP	H
  0424'   CD 03DD'              	CALL	BOL
  0427'   22 22BA'              	SHLD	WKBOL
  042A'   2A 22B8'              	LHLD	WKTERM
  042D'   EB                    	XCHG			; DE = term
  042E'   2A 22BA'              	LHLD	WKBOL
  0431'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  0434'   CA 0453'              	JZ	EOLC_MT
  0437'   EB                    	XCHG			; HL = term
  0438'   2B                    	DCX	H		; term-1
  0439'   E5                    	PUSH	H
  043A'   CD 0000*              	CALL	CHARAT
  043D'   E1                    	POP	H		; HL = term-1
  043E'   FE 0D                 	CPI	CR
  0440'   CA 0446'              	JZ	EOLC_CR		; content ends at term-1
  0443'   C3 0447'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  0446'                         EOLC_CR:
  0446'   2B                    	DCX	H		; last = (term-1) - 1
  0447'                         EOLC_LS:
  0447'   EB                    	XCHG			; DE = last
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  0448'   2A 22BA'              	LHLD	WKBOL
  044B'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  044E'   DA 0453'              	JC	EOLC_MT
  0451'   EB                    	XCHG			; HL = last
  0452'   C9                    	RET
  0453'                         EOLC_MT:
  0453'   2A 22BA'              	LHLD	WKBOL
  0456'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  0457'                         COL:
  0457'   E5                    	PUSH	H
  0458'   CD 03DD'              	CALL	BOL
  045B'   D1                    	POP	D		; DE = off
  045C'   EB                    	XCHG			; HL = off, DE = bol
  045D'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  0460'                         ATENDQ:
  0460'   CD 0000*              	CALL	CUROFF
  0463'   E5                    	PUSH	H
  0464'   CD 0000*              	CALL	LOGLEN
  0467'   D1                    	POP	D		; DE = cur
  0468'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  046B'                         CURCHR:
  046B'   CD 0000*              	CALL	CUROFF
  046E'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  0471'                         MOVCNT:
  0471'   CD 04F1'              	CALL	SETMOV
  0474'   C3 0484'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  0477'                         CNTOFF:
  0477'   CD 0484'              	CALL	GETCNT
  047A'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  047D'                         GBSUB:
  047D'   EB                    	XCHG
  047E'   2A 0000*              	LHLD	GAPBEG
  0481'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  0484'                         GETCNT:
  0484'   2A 227A'              	LHLD	CMDCNT
  0487'   7C                    	MOV	A,H
  0488'   B5                    	ORA	L
  0489'   C2 0490'              	JNZ	GC_HAVE
  048C'   21 0001               	LXI	H,1
  048F'   C9                    	RET
  0490'                         GC_HAVE:
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  0490'   E5                    	PUSH	H
  0491'   21 0000               	LXI	H,0
  0494'   22 227A'              	SHLD	CMDCNT
  0497'   E1                    	POP	H
  0498'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for a ^C break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  0499'                         CNTTST:				; WM 1175
  0499'   E5                    	PUSH	H
  049A'   2A 227A'              	LHLD	CMDCNT
  049D'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  04A0'   B4                    	ORA	H
  04A1'   B5                    	ORA	L
  04A2'   E1                    	POP	H
  04A3'   C3 0000*              	JMP	POLLBRK
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  04A6'                         CLASSF:
  04A6'   47                    	MOV	B,A
  04A7'   FE 20                 	CPI	' '
  04A9'   CA 04E9'              	JZ	CLS0
  04AC'   FE 09                 	CPI	TAB
  04AE'   CA 04E9'              	JZ	CLS0
  04B1'   FE 0A                 	CPI	LF
  04B3'   CA 04E9'              	JZ	CLS0
  04B6'   FE 0D                 	CPI	CR
  04B8'   CA 04E9'              	JZ	CLS0
  04BB'   3A 2284'              	LDA	WBIG
  04BE'   B7                    	ORA	A
  04BF'   C2 04EB'              	JNZ	CLS1
  04C2'   78                    	MOV	A,B
  04C3'   FE 5F                 	CPI	'_'
  04C5'   CA 04EB'              	JZ	CLS1
  04C8'   FE 30                 	CPI	'0'
  04CA'   DA 04EE'              	JC	CLS2
  04CD'   FE 3A                 	CPI	'9'+1
  04CF'   DA 04EB'              	JC	CLS1
  04D2'   FE 41                 	CPI	'A'
  04D4'   DA 04EE'              	JC	CLS2
  04D7'   FE 5B                 	CPI	'Z'+1
  04D9'   DA 04EB'              	JC	CLS1
  04DC'   FE 61                 	CPI	'a'
  04DE'   DA 04EE'              	JC	CLS2
  04E1'   FE 7B                 	CPI	'z'+1
  04E3'   DA 04EB'              	JC	CLS1
  04E6'   C3 04EE'              	JMP	CLS2
  04E9'   AF                    CLS0:	XRA	A
  04EA'   C9                    	RET
  04EB'   3E 01                 CLS1:	MVI	A,1
  04ED'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04EE'   3E 02                 CLS2:	MVI	A,2
  04F0'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  04F1'                         SETMOV:
  04F1'   3E 01                 	MVI	A,R_MOVE
  04F3'   32 227E'              	STA	RINTENT
  04F6'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  04F7'                         SETLIN:
  04F7'   3E 02                 	MVI	A,R_LINE
  04F9'   32 227E'              	STA	RINTENT
  04FC'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  04FD'                         SETILN:
  04FD'   3E 01                 	MVI	A,1
  04FF'   32 227F'              	STA	ILN		; one line, unless a put overwrites it below
  0502'   3E 05                 	MVI	A,R_ILIN
  0504'   32 227E'              	STA	RINTENT
  0507'   AF                    	XRA	A
  0508'   32 2281'              	STA	ILABOV		; the row above the opened ones is untouched
  050B'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  050C'                         SETJON:
  050C'   3E 06                 	MVI	A,R_JOIN
  050E'   32 227E'              	STA	RINTENT
  0511'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  0512'                         SETFUL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  0512'   3E 00                 	MVI	A,R_FULL
  0514'   32 227E'              	STA	RINTENT
  0517'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB occurs from the cursor to the end of its line, else 0.
                                ; Scans forward from the cursor via CHARAT until LF or end of text (no gap move).
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  0518'                         TAILTAB:
  0518'   CD 0000*              	CALL	CUROFF
  051B'   22 22B2'              	SHLD	TTI
  051E'                         TT_LP:
  051E'   2A 22B2'              	LHLD	TTI
  0521'   EB                    	XCHG			; DE = TTI
  0522'   CD 0000*              	CALL	LOGLEN		; HL = LOGLEN
  0525'   CD 0000*              	CALL	CMP16		; CY iff TTI < LOGLEN
  0528'   D2 0548'              	JNC	TT_NO		; reached end of text -> no tab
  052B'   2A 22B2'              	LHLD	TTI
  052E'   CD 0000*              	CALL	CHARAT
  0531'   FE 0A                 	CPI	LF
  0533'   CA 0548'              	JZ	TT_NO		; end of line -> no tab
  0536'   FE 09                 	CPI	TAB
  0538'   CA 0545'              	JZ	TT_YES
  053B'   2A 22B2'              	LHLD	TTI
  053E'   23                    	INX	H
  053F'   22 22B2'              	SHLD	TTI
  0542'   C3 051E'              	JMP	TT_LP
  0545'                         TT_YES:
  0545'   3E 01                 	MVI	A,1
  0547'   C9                    	RET
  0548'                         TT_NO:
  0548'   AF                    	XRA	A
  0549'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  054A'                         VC_H:
  054A'   CD 0471'              	CALL	MOVCNT		; a cursor motion, and its count
  054D'   22 22B0'              	SHLD	CNTV
  0550'                         VCH_LP:
  0550'   2A 22B0'              	LHLD	CNTV
  0553'   7C                    	MOV	A,H
  0554'   B5                    	ORA	L
  0555'   C8                    	RZ
  0556'   2B                    	DCX	H
  0557'   22 22B0'              	SHLD	CNTV
  055A'   CD 0560'              	CALL	HSTEP
  055D'   C3 0550'              	JMP	VCH_LP
  0560'                         HSTEP:
  0560'   CD 0000*              	CALL	CUROFF		; HL = cur
  0563'   7C                    	MOV	A,H
  0564'   B5                    	ORA	L
  0565'   C8                    	RZ			; at 0
  0566'   E5                    	PUSH	H
  0567'   CD 03DD'              	CALL	BOL		; HL = bol
  056A'   D1                    	POP	D		; DE = cur
  056B'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  056E'   C8                    	RZ			; at BOL, cannot go left
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  056F'   EB                    	XCHG			; HL = cur
  0570'   2B                    	DCX	H
  0571'   C3 0373'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  0574'                         VC_L:
  0574'   CD 0471'              	CALL	MOVCNT		; a cursor motion, and its count
  0577'   22 22B0'              	SHLD	CNTV
  057A'                         VCL_LP:
  057A'   2A 22B0'              	LHLD	CNTV
  057D'   7C                    	MOV	A,H
  057E'   B5                    	ORA	L
  057F'   C8                    	RZ
  0580'   2B                    	DCX	H
  0581'   22 22B0'              	SHLD	CNTV
  0584'   CD 058A'              	CALL	LSTEP
  0587'   C3 057A'              	JMP	VCL_LP
  058A'                         LSTEP:
  058A'   CD 0000*              	CALL	CUROFF		; HL = cur
  058D'   E5                    	PUSH	H
  058E'   CD 041C'              	CALL	EOLC		; HL = eolc
  0591'   D1                    	POP	D		; DE = cur
  0592'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  0595'   D0                    	RNC			; cur >= eolc, cannot go right
  0596'   EB                    	XCHG			; HL = cur
  0597'   23                    	INX	H
  0598'   C3 0373'              	JMP	GOSET
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  059B'                         VC_0:
  059B'   CD 0471'              	CALL	MOVCNT		; a cursor motion, and its count
  059E'   CD 05A8'              	CALL	LNSTRT
  05A1'   21 0000               	LXI	H,0
  05A4'   22 2282'              	SHLD	GOALCOL
  05A7'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  05A8'                         LNSTRT:
  05A8'   CD 0CA2'              	CALL	ZSAVE
  05AB'   21 0000               	LXI	H,0
  05AE'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  05B1'   E5                    	PUSH	H
  05B2'   CD 0CB5'              	CALL	ZREST
  05B5'   E1                    	POP	H
  05B6'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  05B9'                         VC_CRT:
  05B9'   CD 0471'              	CALL	MOVCNT		; a cursor motion, and its count
  05BC'   C3 05BF'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


                                ; scrolls, H/M/L and dd.
  05BF'                         FNBLNK:
  05BF'   CD 05A8'              	CALL	LNSTRT
  05C2'   CD 0000*              	CALL	RGET0
  05C5'   11 0000               	LXI	D,0		; DE = blanks skipped
  05C8'                         FN_LP:
  05C8'   CD 0000*              	CALL	RDGET
  05CB'   DA 05EE'              	JC	FN_GO		; the end of the file
  05CE'   FE 20                 	CPI	' '
  05D0'   CA 05D8'              	JZ	FN_WH
  05D3'   FE 09                 	CPI	TAB
  05D5'   C2 05EE'              	JNZ	FN_GO		; a non-blank, or the line's end
  05D8'                         FN_WH:
  05D8'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  05DB'   DA 05EE'              	JC	FN_GO
  05DE'   FE 0D                 	CPI	CR
  05E0'   CA 05EE'              	JZ	FN_GO
  05E3'   FE 0A                 	CPI	LF
  05E5'   CA 05EE'              	JZ	FN_GO
  05E8'   2B                    	DCX	H		; not yet: read that char again
  05E9'   03                    	INX	B
  05EA'   13                    	INX	D
  05EB'   C3 05C8'              	JMP	FN_LP
  05EE'                         FN_GO:
  05EE'   D5                    	PUSH	D
  05EF'   CD 0000*              	CALL	CUROFF
  05F2'   D1                    	POP	D
  05F3'   19                    	DAD	D
  05F4'   C3 0373'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  05F7'                         VC_EOL:
  05F7'   CD 04F1'              	CALL	SETMOV
  05FA'   21 FFFF               	LXI	H,0FFFFH
  05FD'   22 2282'              	SHLD	GOALCOL
  0600'   CD 0484'              	CALL	GETCNT
  0603'   2B                    	DCX	H		; count-1
  0604'   7C                    	MOV	A,H
  0605'   B5                    	ORA	L
  0606'   CA 0615'              	JZ	VEOL_0
  0609'   E5                    	PUSH	H
  060A'   CD 062A'              	CALL	ONLAST
  060D'   E1                    	POP	H
  060E'   D8                    	RC			; the last line: no move (vim)
  060F'   CD 066D'              	CALL	JCORE
  0612'   C3 07BC'              	JMP	JKLAND
  0615'                         VEOL_0:
  0615'   CD 05A8'              	CALL	LNSTRT
  0618'   C3 07BC'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  061B'                         VC_CR:
  061B'   CD 0471'              	CALL	MOVCNT		; a cursor motion, and its count
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  061E'   E5                    	PUSH	H
  061F'   CD 062A'              	CALL	ONLAST
  0622'   E1                    	POP	H
  0623'   D8                    	RC
  0624'   CD 066D'              	CALL	JCORE
  0627'   C3 05BF'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  062A'                         ONLAST:
  062A'   CD 0000*              	CALL	RGET0
  062D'                         OL_LP:
  062D'   CD 0000*              	CALL	RDGET
  0630'   D8                    	RC			; the file ends on this line
  0631'   FE 0A                 	CPI	LF
  0633'   C2 062D'              	JNZ	OL_LP
  0636'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  0639'                         VC_J:
  0639'   CD 04F1'              	CALL	SETMOV
  063C'   CD 0657'              	CALL	GLCHK		; the goal column, from the cursor if stale
  063F'   CD 0484'              	CALL	GETCNT		; HL = count
  0642'   CD 066D'              	CALL	JCORE
  0645'   C3 07BC'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  0648'                         VC_K:
  0648'   CD 04F1'              	CALL	SETMOV
  064B'   CD 0657'              	CALL	GLCHK
  064E'   CD 0484'              	CALL	GETCNT
  0651'   CD 070A'              	CALL	KCORE
  0654'   C3 07BC'              	JMP	JKLAND
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  0657'                         GLCHK:
  0657'   2A 2282'              	LHLD	GOALCOL
  065A'   7C                    	MOV	A,H
  065B'   3C                    	INR	A
  065C'   C0                    	RNZ
  065D'   7D                    	MOV	A,L
  065E'   FE FE                 	CPI	0FEH
  0660'   C0                    	RNZ
  0661'   C3 0376'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  0664'                         GLSTAL:
  0664'   E5                    	PUSH	H
  0665'   21 FFFE               	LXI	H,0FFFEH
  0668'   22 2282'              	SHLD	GOALCOL
  066B'   E1                    	POP	H
  066C'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  066D'                         JCORE:
  066D'   7C                    	MOV	A,H
  066E'   B5                    	ORA	L
  066F'   C8                    	RZ
  0670'   22 2288'              	SHLD	JKCNT
  0673'   CD 0A83'              	CALL	CURRW		; limit = rows under the cursor's + NEDIT
  0676'   47                    	MOV	B,A
  0677'   3A 0000*              	LDA	NEDIT
  067A'   3D                    	DCR	A
  067B'   90                    	SUB	B
  067C'   5F                    	MOV	E,A
  067D'   16 00                 	MVI	D,0
  067F'   3A 0000*              	LDA	NEDIT
  0682'   6F                    	MOV	L,A
  0683'   26 00                 	MVI	H,0
  0685'   19                    	DAD	D
  0686'   EB                    	XCHG			; DE = limit
  0687'   2A 2288'              	LHLD	JKCNT
  068A'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  068D'   D2 0691'              	JNC	JC_N
  0690'   EB                    	XCHG			; HL = limit
  0691'                         JC_N:
  0691'   22 228A'              	SHLD	JKN		; N = min(count, limit)
  0694'   EB                    	XCHG			; DE = LFs to find
  0695'   CD 0000*              	CALL	RGET0
  0698'                         JC_SC:
  0698'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  069B'   DA 06BA'              	JC	JC_EOF
  069E'   32 2291'              	STA	JKLST
  06A1'   FE 0A                 	CPI	LF
  06A3'   C2 0698'              	JNZ	JC_SC
  06A6'   1B                    	DCX	D
  06A7'   7A                    	MOV	A,D
  06A8'   B3                    	ORA	E
  06A9'   C2 0698'              	JNZ	JC_SC
  06AC'   2A 2288'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  06AF'   22 228C'              	SHLD	JKMOV		;   one if the last LF found ends the file
  06B2'   3E 01                 	MVI	A,1
  06B4'   32 2290'              	STA	JKPHN
  06B7'   C3 06D5'              	JMP	JC_MV
  06BA'                         JC_EOF:
  06BA'   2A 228A'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  06BD'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  06C0'   7C                    	MOV	A,H
  06C1'   B5                    	ORA	L
  06C2'   CA 06CE'              	JZ	JC_AV
  06C5'   3A 2291'              	LDA	JKLST
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06C8'   FE 0A                 	CPI	LF
  06CA'   C2 06CE'              	JNZ	JC_AV
  06CD'   2B                    	DCX	H
  06CE'                         JC_AV:
  06CE'   22 228C'              	SHLD	JKMOV
  06D1'   AF                    	XRA	A
  06D2'   32 2290'              	STA	JKPHN
  06D5'                         JC_MV:
  06D5'   2A 2288'              	LHLD	JKCNT
  06D8'   AF                    	XRA	A
  06D9'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  06DC'   CD 079B'              	CALL	ATEOF
  06DF'   D2 06F3'              	JNC	JC_DN
  06E2'   CD 07A1'              	CALL	LASTLN		; ran past the last line: back onto it
  06E5'   3A 2290'              	LDA	JKPHN
  06E8'   B7                    	ORA	A
  06E9'   CA 06F3'              	JZ	JC_DN
  06EC'   2A 228C'              	LHLD	JKMOV
  06EF'   2B                    	DCX	H
  06F0'   22 228C'              	SHLD	JKMOV
  06F3'                         JC_DN:
  06F3'   2A 228A'              	LHLD	JKN		; LNDLT += min(moved, N)
  06F6'   EB                    	XCHG
  06F7'   2A 228C'              	LHLD	JKMOV
  06FA'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  06FD'   D2 0701'              	JNC	JC_AD
  0700'   EB                    	XCHG
  0701'                         JC_AD:
  0701'   EB                    	XCHG			; DE = lines moved
  0702'   2A 0000*              	LHLD	LNDLT
  0705'   19                    	DAD	D
  0706'   22 0000*              	SHLD	LNDLT
  0709'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  070A'                         KCORE:
  070A'   7C                    	MOV	A,H
  070B'   B5                    	ORA	L
  070C'   C8                    	RZ
  070D'   22 2288'              	SHLD	JKCNT
  0710'   CD 0A83'              	CALL	CURRW		; limit = row + NEDIT
  0713'   5F                    	MOV	E,A
  0714'   16 00                 	MVI	D,0
  0716'   3A 0000*              	LDA	NEDIT
  0719'   6F                    	MOV	L,A
  071A'   26 00                 	MVI	H,0
  071C'   19                    	DAD	D
  071D'   EB                    	XCHG			; DE = limit
  071E'   2A 2288'              	LHLD	JKCNT
  0721'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0724'   D2 0728'              	JNC	KC_N
  0727'   EB                    	XCHG			; HL = limit
  0728'                         KC_N:
  0728'   22 228A'              	SHLD	JKN		; N = min(count, limit)
  072B'   EB                    	XCHG			; DE = LFs to find
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  072C'   21 0000               	LXI	H,0
  072F'   22 228E'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  0732'                         KC_ED:
  0732'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0733'   2A 228E'              	LHLD	JKBK
  0736'   CD 047D'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0739'   E5                    	PUSH	H
  073A'   EB                    	XCHG
  073B'   2A 0000*              	LHLD	TXTBEG
  073E'   EB                    	XCHG
  073F'   CD 0000*              	CALL	SUBHD
  0742'   44                    	MOV	B,H
  0743'   4D                    	MOV	C,L
  0744'   E1                    	POP	H
  0745'   D1                    	POP	D
  0746'                         KC_SC:
  0746'   78                    	MOV	A,B
  0747'   B1                    	ORA	C
  0748'   CA 075F'              	JZ	KC_TB
  074B'   2B                    	DCX	H
  074C'   0B                    	DCX	B
  074D'   7E                    	MOV	A,M
  074E'   FE 0A                 	CPI	LF
  0750'   C2 0746'              	JNZ	KC_SC
  0753'   1B                    	DCX	D
  0754'   7A                    	MOV	A,D
  0755'   B3                    	ORA	E
  0756'   C2 0746'              	JNZ	KC_SC
  0759'   2A 2288'              	LHLD	JKCNT		; N lines above: the move is count lines
  075C'   C3 077F'              	JMP	KC_MV
  075F'                         KC_TB:
  075F'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0760'   CD 047D'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0763'   22 228E'              	SHLD	JKBK
  0766'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0769'   7C                    	MOV	A,H
  076A'   B5                    	ORA	L
  076B'   CA 0778'              	JZ	KC_B0
  076E'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  0771'   D1                    	POP	D
  0772'   DA 0779'              	JC	KC_BOF
  0775'   C3 0732'              	JMP	KC_ED
  0778'                         KC_B0:
  0778'   D1                    	POP	D
  0779'                         KC_BOF:
  0779'   2A 228A'              	LHLD	JKN		; moved = LFs found
  077C'   CD 0000*              	CALL	SUBHD
  077F'                         KC_MV:
  077F'   E5                    	PUSH	H
  0780'   2A 2288'              	LHLD	JKCNT
  0783'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0786'   D1                    	POP	D		; DE = moved
  0787'   2A 228A'              	LHLD	JKN
  078A'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  078D'   DA 0791'              	JC	KC_AD
  0790'   EB                    	XCHG			; DE = N
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0791'                         KC_AD:
  0791'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0794'   CD 0000*              	CALL	SUBHD
  0797'   22 0000*              	SHLD	LNDLT
  079A'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  079B'                         ATEOF:
  079B'   CD 0000*              	CALL	RGET0
  079E'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  07A1'                         LASTLN:
  07A1'   2A 0000*              	LHLD	GAPBEG
  07A4'   EB                    	XCHG
  07A5'   2A 0000*              	LHLD	TXTBEG
  07A8'   CD 0000*              	CALL	CMP16
  07AB'   21 0000               	LXI	H,0
  07AE'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  07B1'   1B                    	DCX	D
  07B2'   1A                    	LDAX	D
  07B3'   FE 0A                 	CPI	LF
  07B5'   C2 0000*              	JNZ	SETBWD
  07B8'   23                    	INX	H
  07B9'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  07BC'                         JKLAND:
  07BC'   21 0000               	LXI	H,0
  07BF'   22 2292'              	SHLD	JKVC		; screen column
  07C2'   2B                    	DCX	H
  07C3'   22 2294'              	SHLD	JKLS		; last content char: none yet
  07C6'   CD 0000*              	CALL	RGET0
  07C9'   11 0000               	LXI	D,0		; DE = chars read
  07CC'                         JL_RD:
  07CC'   CD 0000*              	CALL	RDGET
  07CF'   DA 0809'              	JC	JL_END
  07D2'   FE 0A                 	CPI	LF
  07D4'   CA 0809'              	JZ	JL_END
  07D7'   E5                    	PUSH	H
  07D8'   C5                    	PUSH	B
  07D9'   2A 2292'              	LHLD	JKVC
  07DC'   CD 03CA'              	CALL	CWID
  07DF'   B7                    	ORA	A
  07E0'   CA 0803'              	JZ	JL_NX		; a CR
  07E3'   EB                    	XCHG
  07E4'   22 2294'              	SHLD	JKLS		; the last content char so far
  07E7'   EB                    	XCHG
  07E8'   4F                    	MOV	C,A
  07E9'   06 00                 	MVI	B,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  07EB'   09                    	DAD	B		; HL = the column after this char
  07EC'   22 2292'              	SHLD	JKVC
  07EF'   D5                    	PUSH	D
  07F0'   EB                    	XCHG
  07F1'   2A 2282'              	LHLD	GOALCOL
  07F4'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  07F7'   D1                    	POP	D
  07F8'   DA 0803'              	JC	JL_NX
  07FB'   CA 0803'              	JZ	JL_NX
  07FE'   C1                    	POP	B		; this char holds the goal column
  07FF'   E1                    	POP	H
  0800'   C3 0814'              	JMP	JL_GO
  0803'                         JL_NX:
  0803'   C1                    	POP	B
  0804'   E1                    	POP	H
  0805'   13                    	INX	D
  0806'   C3 07CC'              	JMP	JL_RD
  0809'                         JL_END:
  0809'   2A 2294'              	LHLD	JKLS		; past the line's end: its last content char
  080C'   7C                    	MOV	A,H
  080D'   A5                    	ANA	L
  080E'   3C                    	INR	A
  080F'   C2 0813'              	JNZ	JL_LS
  0812'   23                    	INX	H		; no content: the line's start
  0813'                         JL_LS:
  0813'   EB                    	XCHG
  0814'                         JL_GO:
  0814'   D5                    	PUSH	D		; DE = step from the line start
  0815'   CD 0000*              	CALL	CUROFF
  0818'   D1                    	POP	D
  0819'   19                    	DAD	D
  081A'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  081D'   AF                    VC_W:	XRA	A
  081E'   32 2284'              	STA	WBIG
  0821'   C3 0829'              	JMP	WDO
  0824'   3E 01                 VCBGW:	MVI	A,1
  0826'   32 2284'              	STA	WBIG
  0829'   CD 04F1'              WDO:	CALL	SETMOV
  082C'   AF                    	XRA	A
  082D'   32 2285'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0830'   CD 0484'              	CALL	GETCNT
  0833'   22 22B0'              	SHLD	CNTV
  0836'   2A 22B0'              WDO_LP: LHLD	CNTV
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  0839'   7C                    	MOV	A,H
  083A'   B5                    	ORA	L
  083B'   CA 0848'              	JZ	WDO_DN
  083E'   2B                    	DCX	H
  083F'   22 22B0'              	SHLD	CNTV
  0842'   CD 0898'              	CALL	FWD1
  0845'   D2 0836'              	JNC	WDO_LP
  0848'                         WDO_DN:
  0848'   CD 079B'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  084B'   DA 0858'              	JC	WDO_NL
  084E'   FE 0D                 	CPI	CR
  0850'   CA 0858'              	JZ	WDO_NL
  0853'   FE 0A                 	CPI	LF
  0855'   C2 0376'              	JNZ	SETGL
  0858'                         WDO_NL:
  0858'   CD 0000*              	CALL	PEEKL
  085B'   DA 0376'              	JC	SETGL
  085E'   FE 0A                 	CPI	LF
  0860'   CA 0376'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0863'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0865'   32 2285'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0868'   CD 0993'              	CALL	DECC		; back onto its last char
  086B'   C3 0376'              	JMP	SETGL
                                
  086E'   AF                    VC_B:	XRA	A
  086F'   32 2284'              	STA	WBIG
  0872'   C3 087A'              	JMP	BDO
  0875'   3E 01                 VCBGB:	MVI	A,1
  0877'   32 2284'              	STA	WBIG
  087A'   CD 04F1'              BDO:	CALL	SETMOV
  087D'   CD 0484'              	CALL	GETCNT
  0880'   22 22B0'              	SHLD	CNTV
  0883'   2A 22B0'              BDO_LP: LHLD	CNTV
  0886'   7C                    	MOV	A,H
  0887'   B5                    	ORA	L
  0888'   CA 0376'              	JZ	SETGL
  088B'   2B                    	DCX	H
  088C'   22 22B0'              	SHLD	CNTV
  088F'   CD 08E4'              	CALL	BCK1
  0892'   D2 0883'              	JNC	BDO_LP
  0895'   C3 0376'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char (it is left there).
  0898'                         FWD1:
  0898'   CD 0917'              	CALL	CCLS
  089B'   32 22BC'              	STA	WKCLS		; the starting class
  089E'   CD 0951'              	CALL	INCC
  08A1'   B7                    	ORA	A
  08A2'   CA 08BA'              	JZ	FW_WD
  08A5'   37                    	STC
  08A6'   F8                    	RM			; -1: already at the end
  08A7'   FE 02                 	CPI	2
  08A9'   C2 08BA'              	JNZ	FW_WD		; 1: a next line was reached
  08AC'   CD 079B'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  08AF'   D4 0938'              	CNC	NXLN
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  08B2'   D2 08BA'              	JNC	FW_WD
  08B5'   CD 0993'              	CALL	DECC		; yes: back onto its last char, failed
  08B8'   37                    	STC
  08B9'   C9                    	RET
  08BA'                         FW_WD:
  08BA'   3A 22BC'              	LDA	WKCLS		; go past the rest of this word
  08BD'   B7                    	ORA	A
  08BE'   CA 08D3'              	JZ	FW_WS
  08C1'                         FW_WLP:
  08C1'   CD 0917'              	CALL	CCLS
  08C4'   21 22BC'              	LXI	H,WKCLS
  08C7'   BE                    	CMP	M
  08C8'   C2 08D3'              	JNZ	FW_WS
  08CB'   CD 0951'              	CALL	INCC
  08CE'   B7                    	ORA	A
  08CF'   F8                    	RM			; the end of the file (NC)
  08D0'   C3 08C1'              	JMP	FW_WLP
  08D3'                         FW_WS:
  08D3'   CD 0917'              	CALL	CCLS		; then over blanks to the next word
  08D6'   B7                    	ORA	A
  08D7'   C0                    	RNZ
  08D8'   CD 091F'              	CALL	EMPTY
  08DB'   C8                    	RZ			; an empty line is a word
  08DC'   CD 0951'              	CALL	INCC
  08DF'   B7                    	ORA	A
  08E0'   F8                    	RM
  08E1'   C3 08D3'              	JMP	FW_WS
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  08E4'                         BCK1:
  08E4'   CD 0993'              	CALL	DECC
  08E7'   B7                    	ORA	A
  08E8'   37                    	STC
  08E9'   F8                    	RM
  08EA'                         BK_WS:
  08EA'   CD 0917'              	CALL	CCLS		; back over blanks
  08ED'   B7                    	ORA	A
  08EE'   C2 08FE'              	JNZ	BK_WD
  08F1'   CD 091F'              	CALL	EMPTY
  08F4'   C8                    	RZ			; an empty line is a word
  08F5'   CD 0993'              	CALL	DECC
  08F8'   B7                    	ORA	A
  08F9'   F2 08EA'              	JP	BK_WS
  08FC'   AF                    	XRA	A		; the start of the file (NC)
  08FD'   C9                    	RET
  08FE'                         BK_WD:
  08FE'   32 22BC'              	STA	WKCLS		; back to the start of this word
  0901'                         BK_WLP:
  0901'   CD 0993'              	CALL	DECC
  0904'   B7                    	ORA	A
  0905'   FA 0915'              	JM	BK_OK		; the start of the file
  0908'   CD 0917'              	CALL	CCLS
  090B'   21 22BC'              	LXI	H,WKCLS
  090E'   BE                    	CMP	M
  090F'   CA 0901'              	JZ	BK_WLP
  0912'   CD 0951'              	CALL	INCC		; overshot: forward one
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  0915'                         BK_OK:
  0915'   AF                    	XRA	A
  0916'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0917'                         CCLS:
  0917'   CD 079B'              	CALL	ATEOF
  091A'   D2 04A6'              	JNC	CLASSF
  091D'   AF                    	XRA	A
  091E'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  091F'                         EMPTY:
  091F'   CD 079B'              	CALL	ATEOF
  0922'   DA 092D'              	JC	EM_ST
  0925'   FE 0D                 	CPI	CR
  0927'   CA 092D'              	JZ	EM_ST
  092A'   FE 0A                 	CPI	LF
  092C'   C0                    	RNZ
  092D'                         EM_ST:
  092D'   CD 0000*              	CALL	PEEKL
  0930'   DA 0936'              	JC	EM_Y
  0933'   FE 0A                 	CPI	LF
  0935'   C9                    	RET
  0936'                         EM_Y:
  0936'   AF                    	XRA	A
  0937'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0938'                         NXLN:
  0938'   FE 0A                 	CPI	LF
  093A'   CA 0949'              	JZ	NX_LF
  093D'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0940'   D8                    	RC
  0941'   FE 0A                 	CPI	LF
  0943'   CA 0949'              	JZ	NX_LF
  0946'   2B                    	DCX	H		; a lone CR
  0947'   AF                    	XRA	A
  0948'   C9                    	RET
  0949'                         NX_LF:
  0949'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  094C'   D8                    	RC
  094D'   2B                    	DCX	H
  094E'   3E 01                 	MVI	A,1
  0950'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0951'                         INCC:
  0951'   CD 079B'              	CALL	ATEOF
  0954'   DA 098F'              	JC	IC_END
  0957'   FE 0D                 	CPI	CR
  0959'   CA 097A'              	JZ	IC_NL
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  095C'   FE 0A                 	CPI	LF
  095E'   CA 097A'              	JZ	IC_NL
  0961'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0964'                         IC_CH:
  0964'   CD 079B'              	CALL	ATEOF
  0967'   DA 0976'              	JC	IC_2
  096A'   FE 0D                 	CPI	CR
  096C'   CA 0976'              	JZ	IC_2
  096F'   FE 0A                 	CPI	LF
  0971'   CA 0976'              	JZ	IC_2
  0974'   AF                    	XRA	A
  0975'   C9                    	RET
  0976'                         IC_2:
  0976'   3E 02                 	MVI	A,2
  0978'   B7                    	ORA	A
  0979'   C9                    	RET
  097A'                         IC_NL:
  097A'   CD 0938'              	CALL	NXLN
  097D'   DA 098F'              	JC	IC_END
  0980'   F5                    	PUSH	PSW
  0981'   CD 0000*              	CALL	PUTCUR
  0984'   F1                    	POP	PSW
  0985'   B7                    	ORA	A
  0986'   CA 0964'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0989'   CD 09B5'              	CALL	LNINC
  098C'   3E 01                 	MVI	A,1
  098E'   C9                    	RET
  098F'                         IC_END:
  098F'   3E FF                 	MVI	A,0FFH
  0991'   B7                    	ORA	A
  0992'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0993'                         DECC:
  0993'   CD 0000*              	CALL	PEEKL
  0996'   DA 098F'              	JC	IC_END
  0999'   F5                    	PUSH	PSW
  099A'   CD 0000*              	CALL	PUTCUR
  099D'   F1                    	POP	PSW
  099E'   FE 0A                 	CPI	LF
  09A0'   3E 00                 	MVI	A,0
  09A2'   C0                    	RNZ
  09A3'   CD 09C3'              	CALL	LNDEC
  09A6'   CD 0000*              	CALL	PEEKL		; onto its CR
  09A9'   DA 09B1'              	JC	DC_1
  09AC'   FE 0D                 	CPI	CR
  09AE'   CC 0000*              	CZ	PUTCUR
  09B1'                         DC_1:
  09B1'   3E 01                 	MVI	A,1
  09B3'   B7                    	ORA	A
  09B4'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  09B5'                         LNINC:
