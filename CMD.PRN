  0A11'   22 220F'              	SHLD	WKI
  0A14'   CD 0000*              	CALL	LOGLEN
  0A17'   22 2211'              	SHLD	WKN
  0A1A'   2A 220F'              	LHLD	WKI
  0A1D'   23                    	INX	H
  0A1E'   22 220F'              	SHLD	WKI
  0A21'                         ES_WS:
  0A21'   2A 220F'              	LHLD	WKI
  0A24'   EB                    	XCHG
  0A25'   2A 2211'              	LHLD	WKN
  0A28'   CD 0000*              	CALL	CMP16
  0A2B'   D2 0A79'              	JNC	ES_LND
  0A2E'   2A 220F'              	LHLD	WKI
  0A31'   CD 0000*              	CALL	CHARAT
  0A34'   CD 04BC'              	CALL	CLASSF
  0A37'   B7                    	ORA	A
  0A38'   C2 0A45'              	JNZ	ES_WD
  0A3B'   2A 220F'              	LHLD	WKI
  0A3E'   23                    	INX	H
  0A3F'   22 220F'              	SHLD	WKI
  0A42'   C3 0A21'              	JMP	ES_WS
  0A45'                         ES_WD:
  0A45'   2A 220F'              	LHLD	WKI
  0A48'   CD 0000*              	CALL	CHARAT
  0A4B'   CD 04BC'              	CALL	CLASSF
  0A4E'   32 2219'              	STA	WKCLS
  0A51'                         ES_RUN:
  0A51'   2A 220F'              	LHLD	WKI
  0A54'   23                    	INX	H
  0A55'   EB                    	XCHG			; DE = i+1
  0A56'   2A 2211'              	LHLD	WKN
  0A59'   CD 0000*              	CALL	CMP16		; DE=(i+1) vs HL=n: CY iff (i+1) < n
  0A5C'   D2 0A79'              	JNC	ES_LND
  0A5F'   2A 220F'              	LHLD	WKI
  0A62'   23                    	INX	H
  0A63'   E5                    	PUSH	H		; i+1
  0A64'   CD 0000*              	CALL	CHARAT
  0A67'   CD 04BC'              	CALL	CLASSF
  0A6A'   E1                    	POP	H		; HL = i+1
  0A6B'   47                    	MOV	B,A
  0A6C'   3A 2219'              	LDA	WKCLS
  0A6F'   B8                    	CMP	B
  0A70'   C2 0A79'              	JNZ	ES_LND
  0A73'   22 220F'              	SHLD	WKI
  0A76'   C3 0A51'              	JMP	ES_RUN
  0A79'                         ES_LND:
  0A79'   2A 2211'              	LHLD	WKN
  0A7C'   EB                    	XCHG
  0A7D'   2A 220F'              	LHLD	WKI
  0A80'   CD 0000*              	CALL	CMP16		; DE=n vs HL=i: CY iff n < i
  0A83'   DA 0A8F'              	JC	ES_CL
  0A86'   CA 0A8F'              	JZ	ES_CL
  0A89'   2A 220F'              	LHLD	WKI
  0A8C'   C3 0381'              	JMP	GOSET
  0A8F'                         ES_CL:
  0A8F'   2A 2211'              	LHLD	WKN
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0A92'   7C                    	MOV	A,H
  0A93'   B5                    	ORA	L
  0A94'   C8                    	RZ
  0A95'   2B                    	DCX	H
  0A96'   C3 0381'              	JMP	GOSET
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0A99'                         CURRW:
  0A99'   2A 0000*              	LHLD	WINROW
  0A9C'   EB                    	XCHG
  0A9D'   2A 0000*              	LHLD	LNDLT
  0AA0'   19                    	DAD	D		; HL = row (signed)
  0AA1'   7C                    	MOV	A,H
  0AA2'   B7                    	ORA	A
  0AA3'   FA 0AB6'              	JM	CRW_0		; above the screen -> top row
  0AA6'   C2 0AB1'              	JNZ	CRW_BT		; far below -> bottom row
  0AA9'   3A 0000*              	LDA	NEDIT
  0AAC'   3D                    	DCR	A		; A = bottom row
  0AAD'   BD                    	CMP	L		; CY iff bottom < row
  0AAE'   D8                    	RC
  0AAF'   7D                    	MOV	A,L
  0AB0'   C9                    	RET
  0AB1'                         CRW_BT:
  0AB1'   3A 0000*              	LDA	NEDIT
  0AB4'   3D                    	DCR	A
  0AB5'   C9                    	RET
  0AB6'                         CRW_0:
  0AB6'   AF                    	XRA	A
  0AB7'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0AB8'                         SETRWT:
  0AB8'   2A 0000*              	LHLD	LNDLT
  0ABB'   EB                    	XCHG
  0ABC'   6F                    	MOV	L,A
  0ABD'   26 00                 	MVI	H,0
  0ABF'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0AC2'   22 0000*              	SHLD	WINROW
  0AC5'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0AC6'                         MVROW:
  0AC6'   47                    	MOV	B,A
  0AC7'   CD 0A99'              	CALL	CURRW
  0ACA'   90                    	SUB	B		; A = row now - target
  0ACB'   C8                    	RZ
  0ACC'   DA 0AD5'              	JC	MR_DN
  0ACF'   6F                    	MOV	L,A
  0AD0'   26 00                 	MVI	H,0
  0AD2'   C3 0720'              	JMP	KCORE
  0AD5'                         MR_DN:
  0AD5'   2F                    	CMA
  0AD6'   3C                    	INR	A		; A = target - row now
  0AD7'   6F                    	MOV	L,A
  0AD8'   26 00                 	MVI	H,0
  0ADA'   C3 0683'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0ADD'                         VC_HIGH:
  0ADD'   CD 0487'              	CALL	MOVCNT		; a cursor motion, and its count
  0AE0'   2B                    	DCX	H		; row = count - 1
  0AE1'   7C                    	MOV	A,H
  0AE2'   B7                    	ORA	A
  0AE3'   3A 0000*              	LDA	SCBOT
  0AE6'   C2 0AEE'              	JNZ	VH_GO		; >= 256 -> the last text row
  0AE9'   BD                    	CMP	L		; CY iff SCBOT < row
  0AEA'   DA 0AEE'              	JC	VH_GO
  0AED'   7D                    	MOV	A,L
  0AEE'                         VH_GO:
  0AEE'   CD 0AC6'              	CALL	MVROW
  0AF1'   C3 05D5'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0AF4'                         VC_MIDL:
  0AF4'   CD 0487'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0AF7'   3A 0000*              	LDA	SCBOT
  0AFA'   B7                    	ORA	A		; clear CY for the shift
  0AFB'   1F                    	RAR			; A = SCBOT / 2
  0AFC'   CD 0AC6'              	CALL	MVROW
  0AFF'   C3 05D5'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0B02'                         VC_LOWL:
  0B02'   CD 0487'              	CALL	MOVCNT		; a cursor motion, and its count
  0B05'   2B                    	DCX	H		; count - 1
  0B06'   3A 0000*              	LDA	SCBOT
  0B09'   5F                    	MOV	E,A
  0B0A'   16 00                 	MVI	D,0
  0B0C'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0B0D'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0B10'   3E 00                 	MVI	A,0
  0B12'   D2 0B19'              	JNC	VL_GO		; at or past the top -> row 0
  0B15'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0B18'   7D                    	MOV	A,L
  0B19'                         VL_GO:
  0B19'   CD 0AC6'              	CALL	MVROW
  0B1C'   C3 05D5'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0B1F'                         VC_PGDN:
  0B1F'   CD 0487'              	CALL	MOVCNT		; a cursor motion, and its count
  0B22'   3A 0000*              	LDA	SCEOF
  0B25'   B7                    	ORA	A
  0B26'   CA 0B34'              	JZ	VPD_N
  0B29'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0B2C'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0B2D'   C8                    	RZ			; it already is
  0B2E'   CD 0AC6'              	CALL	MVROW
  0B31'   C3 0B45'              	JMP	VPD_TP
  0B34'                         VPD_N:
  0B34'   3A 0000*              	LDA	NEDIT
  0B37'   D6 02                 	SUI	2
  0B39'   CD 0B8D'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0B3C'   E5                    	PUSH	H
  0B3D'   AF                    	XRA	A
  0B3E'   CD 0AC6'              	CALL	MVROW		; the top line
  0B41'   E1                    	POP	H
  0B42'   CD 0683'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0B45'                         VPD_TP:
  0B45'   AF                    	XRA	A
  0B46'   CD 0AB8'              	CALL	SETRWT		; to the top row
  0B49'   C3 05D5'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0B4C'                         VC_PGUP:
  0B4C'   CD 0487'              	CALL	MOVCNT		; a cursor motion, and its count
  0B4F'   3A 0000*              	LDA	SCBOF
  0B52'   B7                    	ORA	A
  0B53'   C0                    	RNZ
  0B54'   3A 0000*              	LDA	NEDIT
  0B57'   47                    	MOV	B,A
  0B58'   3A 0000*              	LDA	SCEOF
  0B5B'   B7                    	ORA	A
  0B5C'   CA 0B6D'              	JZ	VPU_2
  0B5F'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0B62'   FE 02                 	CPI	2
  0B64'   D2 0B6D'              	JNC	VPU_2
  0B67'   2F                    	CMA
  0B68'   3C                    	INR	A
  0B69'   80                    	ADD	B
  0B6A'   C3 0B70'              	JMP	VPU_P
  0B6D'                         VPU_2:
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0B6D'   78                    	MOV	A,B
  0B6E'   D6 02                 	SUI	2
  0B70'                         VPU_P:
  0B70'   CD 0B8D'              	CALL	MULSAT		; HL = count * page
  0B73'   E5                    	PUSH	H
  0B74'   AF                    	XRA	A
  0B75'   CD 0AC6'              	CALL	MVROW		; the top line
  0B78'   E1                    	POP	H
  0B79'   CD 0720'              	CALL	KCORE		; the new top line
  0B7C'   AF                    	XRA	A
  0B7D'   CD 0AB8'              	CALL	SETRWT		; on the top row
  0B80'   3A 0000*              	LDA	NEDIT
  0B83'   3D                    	DCR	A
  0B84'   6F                    	MOV	L,A
  0B85'   26 00                 	MVI	H,0
  0B87'   CD 0683'              	CALL	JCORE		; the bottom row's line
  0B8A'   C3 05D5'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0B8D'                         MULSAT:
  0B8D'   EB                    	XCHG
  0B8E'   21 0000               	LXI	H,0
  0B91'   B7                    	ORA	A
  0B92'   C8                    	RZ
  0B93'                         MS_LP:
  0B93'   19                    	DAD	D
  0B94'   DA 0B9C'              	JC	MS_SAT
  0B97'   3D                    	DCR	A
  0B98'   C2 0B93'              	JNZ	MS_LP
  0B9B'   C9                    	RET
  0B9C'                         MS_SAT:
  0B9C'   21 FFFF               	LXI	H,0FFFFH
  0B9F'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0BA0'                         VC_HFDN:
  0BA0'   CD 0507'              	CALL	SETMOV
  0BA3'   CD 0A99'              	CALL	CURRW
  0BA6'   32 21E1'              	STA	HFROW
  0BA9'   CD 0C17'              	CALL	HFCNT		; HL = lines
  0BAC'   3A 21E1'              	LDA	HFROW
  0BAF'   47                    	MOV	B,A
  0BB0'   3A 0000*              	LDA	SCEOF
  0BB3'   B7                    	ORA	A
  0BB4'   CA 0BBC'              	JZ	VHD_GO
  0BB7'   3A 0000*              	LDA	SCBOT		; the last line's row
  0BBA'   B8                    	CMP	B
  0BBB'   C8                    	RZ			; the cursor is on it
  0BBC'                         VHD_GO:
  0BBC'   CD 0683'              	CALL	JCORE
  0BBF'   3A 0000*              	LDA	SCEOF
  0BC2'   B7                    	ORA	A
  0BC3'   C2 05D5'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0BC6'   3A 21E1'              	LDA	HFROW
  0BC9'   CD 0AB8'              	CALL	SETRWT
  0BCC'   3E 01                 	MVI	A,1
  0BCE'   32 0000*              	STA	WFILL		; not past the end of the file
  0BD1'   C3 05D5'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0BD4'                         VC_HFUP:
  0BD4'   CD 0507'              	CALL	SETMOV
  0BD7'   CD 0A99'              	CALL	CURRW
  0BDA'   32 21E1'              	STA	HFROW
  0BDD'   CD 0C17'              	CALL	HFCNT		; HL = lines
  0BE0'   CD 0BF7'              	CALL	ONFST
  0BE3'   C8                    	RZ			; the cursor is on the first line
  0BE4'   CD 0720'              	CALL	KCORE
  0BE7'   3A 0000*              	LDA	SCBOF
  0BEA'   B7                    	ORA	A
  0BEB'   C2 05D5'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0BEE'   3A 21E1'              	LDA	HFROW
  0BF1'   CD 0AB8'              	CALL	SETRWT
  0BF4'   C3 05D5'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0BF7'                         ONFST:
  0BF7'   E5                    	PUSH	H
  0BF8'   2A 0000*              	LHLD	OUTPOS
  0BFB'   7C                    	MOV	A,H
  0BFC'   B5                    	ORA	L
  0BFD'   C2 0C15'              	JNZ	OF_RET
  0C00'   2A 0000*              	LHLD	TXTBEG
  0C03'   EB                    	XCHG			; DE = TXTBEG
  0C04'   2A 0000*              	LHLD	GAPBEG
  0C07'                         OF_LP:
  0C07'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0C0A'   CA 0C15'              	JZ	OF_RET
  0C0D'   2B                    	DCX	H
  0C0E'   7E                    	MOV	A,M
  0C0F'   FE 0A                 	CPI	LF
  0C11'   C2 0C07'              	JNZ	OF_LP
  0C14'   B7                    	ORA	A		; NZ
  0C15'                         OF_RET:
  0C15'   E1                    	POP	H
  0C16'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0C17'                         HFCNT:
  0C17'   2A 21D5'              	LHLD	CMDCNT
  0C1A'   7C                    	MOV	A,H
  0C1B'   B5                    	ORA	L
  0C1C'   CA 0C33'              	JZ	HFC_AM
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0C1F'   CD 049A'              	CALL	GETCNT		; HL = count; clears it
  0C22'   3A 0000*              	LDA	NEDIT
  0C25'   5F                    	MOV	E,A
  0C26'   16 00                 	MVI	D,0
  0C28'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0C2B'   D2 0C2F'              	JNC	HFC_ST
  0C2E'   EB                    	XCHG			; HL = NEDIT
  0C2F'                         HFC_ST:
  0C2F'   7D                    	MOV	A,L
  0C30'   32 21E2'              	STA	HFAMT
  0C33'                         HFC_AM:
  0C33'   3A 21E2'              	LDA	HFAMT
  0C36'   B7                    	ORA	A
  0C37'   C2 0C44'              	JNZ	HFC_HL
  0C3A'   3A 0000*              	LDA	NEDIT
  0C3D'   B7                    	ORA	A
  0C3E'   1F                    	RAR
  0C3F'   B7                    	ORA	A
  0C40'   C2 0C44'              	JNZ	HFC_HL
  0C43'   3C                    	INR	A		; at least one line
  0C44'                         HFC_HL:
  0C44'   6F                    	MOV	L,A
  0C45'   26 00                 	MVI	H,0
  0C47'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0C48'                         VC_REDR:
  0C48'   C3 049A'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0C4B'                         VC_G:
  0C4B'   CD 0507'              	CALL	SETMOV
  0C4E'   CD 0CDE'              	CALL	GZONE		; the screen's top line, before the move
  0C51'   2A 21D5'              	LHLD	CMDCNT
  0C54'   7C                    	MOV	A,H
  0C55'   B5                    	ORA	L
  0C56'   C2 0C63'              	JNZ	VG_N
  0C59'   AF                    	XRA	A		; forward
  0C5A'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0C5D'   CD 07B7'              	CALL	LASTLN		; vi G lands on the start of the LAST line
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0C60'   C3 0CF6'              	JMP	GPLACE
  0C63'                         VG_N:
  0C63'   CD 049A'              	CALL	GETCNT		; HL = target line (1-based)
  0C66'                         VG_LN:
  0C66'   CD 0C6C'              	CALL	GOLN
  0C69'   C3 0CF6'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
  0C6C'                         GOLN:
  0C6C'   2B                    	DCX	H		; lines to move from line 1
  0C6D'   E5                    	PUSH	H
  0C6E'   3E FF                 	MVI	A,0FFH
  0C70'   CD 0000*              	CALL	MVLMAX		; to BOF
  0C73'   E1                    	POP	H
  0C74'   AF                    	XRA	A
  0C75'   CD 0000*              	CALL	MVLIND		; forward count-1 lines
  0C78'   CD 07B1'              	CALL	ATEOF
  0C7B'   DC 07B7'              	CC	LASTLN		; past the last line: onto it
  0C7E'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0C7F'                         VC_LG:
  0C7F'   CD 0507'              	CALL	SETMOV
  0C82'   3A 21FD'              	LDA	GSAVE
  0C85'   B7                    	ORA	A
  0C86'   C2 0C8F'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0C89'   3E 01                 	MVI	A,PG
  0C8B'   32 21FC'              	STA	GPEND
  0C8E'   C9                    	RET
  0C8F'                         VLG_GG:
  0C8F'   CD 0CDE'              	CALL	GZONE
  0C92'   CD 049A'              	CALL	GETCNT		; HL = target line (no count: 1)
  0C95'   C3 0C66'              	JMP	VG_LN
                                
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0C98'                         FPOS:
  0C98'   C5                    	PUSH	B
  0C99'   D5                    	PUSH	D
  0C9A'   EB                    	XCHG
  0C9B'   2A 0000*              	LHLD	TXTBEG
  0C9E'   EB                    	XCHG
  0C9F'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0CA2'   EB                    	XCHG			; DE = that
  0CA3'   2A 0000*              	LHLD	OUTPOS
  0CA6'   7C                    	MOV	A,H
  0CA7'   B7                    	ORA	A		; CY = 0
  0CA8'   1F                    	RAR
  0CA9'   47                    	MOV	B,A
  0CAA'   7D                    	MOV	A,L
  0CAB'   1F                    	RAR
  0CAC'   67                    	MOV	H,A
  0CAD'   3E 00                 	MVI	A,0
  0CAF'   1F                    	RAR
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0CB0'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0CB1'   19                    	DAD	D
  0CB2'   78                    	MOV	A,B
  0CB3'   CE 00                 	ACI	0		; A:HL = the position
  0CB5'   D1                    	POP	D
  0CB6'   C1                    	POP	B
  0CB7'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0CB8'                         ZSAVE:
  0CB8'   2A 21D5'              	LHLD	CMDCNT
  0CBB'   22 2237'              	SHLD	ZSVCNT
  0CBE'   2A 0000*              	LHLD	AUXCNT
  0CC1'   22 2239'              	SHLD	ZSVAUX
  0CC4'   3A 0000*              	LDA	DIRFLG
  0CC7'   32 223B'              	STA	ZSVDIR
  0CCA'   C9                    	RET
  0CCB'                         ZREST:
  0CCB'   2A 2237'              	LHLD	ZSVCNT
  0CCE'   22 21D5'              	SHLD	CMDCNT
  0CD1'   2A 2239'              	LHLD	ZSVAUX
  0CD4'   22 0000*              	SHLD	AUXCNT
  0CD7'   3A 223B'              	LDA	ZSVDIR
  0CDA'   32 0000*              	STA	DIRFLG
  0CDD'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0CDE'                         GZONE:
  0CDE'   CD 0CB8'              	CALL	ZSAVE
  0CE1'   CD 0A99'              	CALL	CURRW
  0CE4'   6F                    	MOV	L,A
  0CE5'   26 00                 	MVI	H,0
  0CE7'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0CEA'   CD 0C98'              	CALL	FPOS
  0CED'   22 0000*              	SHLD	ZTOP
  0CF0'   32 0002*              	STA	ZTOP+2
  0CF3'   C3 0CCB'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0CF6'                         GPLACE:
  0CF6'   CD 0CB8'              	CALL	ZSAVE
  0CF9'   2A 0000*              	LHLD	GAPBEG
  0CFC'   CD 0C98'              	CALL	FPOS
  0CFF'   EB                    	XCHG
  0D00'   4F                    	MOV	C,A		; C:DE = the target's position
  0D01'   2A 0000*              	LHLD	ZTOP
  0D04'   7B                    	MOV	A,E
  0D05'   95                    	SUB	L
  0D06'   6F                    	MOV	L,A
  0D07'   7A                    	MOV	A,D
  0D08'   9C                    	SBB	H
  0D09'   67                    	MOV	H,A
  0D0A'   22 2234'              	SHLD	ZDIF
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0D0D'   3A 0002*              	LDA	ZTOP+2
  0D10'   47                    	MOV	B,A
  0D11'   79                    	MOV	A,C
  0D12'   98                    	SBB	B		; A:ZDIF = target - top; CY iff above the top
  0D13'   DA 0D60'              	JC	GP_UP
  0D16'   B7                    	ORA	A
  0D17'   C2 0DA1'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0D1A'   3A 0000*              	LDA	NEDIT
  0D1D'   5F                    	MOV	E,A
  0D1E'   16 00                 	MVI	D,0
  0D20'   B7                    	ORA	A
  0D21'   1F                    	RAR
  0D22'   6F                    	MOV	L,A
  0D23'   26 00                 	MVI	H,0
  0D25'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0D26'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0D29'   CD 0493'              	CALL	GBSUB		; HL = bytes from there to the target
  0D2C'   EB                    	XCHG
  0D2D'   2A 2234'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0D30'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0D33'   DA 0DA1'              	JC	GP_MID
  0D36'   CD 0493'              	CALL	GBSUB		; HL = the top line's start (resident)
  0D39'   01 0000               	LXI	B,0		; BC = lines from the top
  0D3C'                         GP_CNT:
  0D3C'   7A                    	MOV	A,D
  0D3D'   B3                    	ORA	E
  0D3E'   CA 0D4D'              	JZ	GP_DN
  0D41'   7E                    	MOV	A,M
  0D42'   23                    	INX	H
  0D43'   1B                    	DCX	D
  0D44'   FE 0A                 	CPI	LF
  0D46'   C2 0D3C'              	JNZ	GP_CNT
  0D49'   03                    	INX	B
  0D4A'   C3 0D3C'              	JMP	GP_CNT
  0D4D'                         GP_DN:
  0D4D'   3A 0000*              	LDA	NEDIT
  0D50'   3D                    	DCR	A
  0D51'   5F                    	MOV	E,A
  0D52'   16 00                 	MVI	D,0		; DE = the bottom row
  0D54'   60                    	MOV	H,B
  0D55'   69                    	MOV	L,C
  0D56'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0D59'   DA 0DAB'              	JC	GP_SET		; A = the bottom row
  0D5C'   7D                    	MOV	A,L		; on the screen: its row
  0D5D'   C3 0DCB'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0D60'                         GP_UP:
  0D60'   3C                    	INR	A
  0D61'   C2 0DA1'              	JNZ	GP_MID		; 64K bytes or more above
  0D64'   2A 2234'              	LHLD	ZDIF
  0D67'   EB                    	XCHG
  0D68'   21 0000               	LXI	H,0
  0D6B'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0D6E'   7C                    	MOV	A,H
  0D6F'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D70'   CA 0DA1'              	JZ	GP_MID		; exactly 64K
  0D73'   EB                    	XCHG			; DE = bytes to read
  0D74'   AF                    	XRA	A
  0D75'   32 2236'              	STA	ZLF
  0D78'   CD 0000*              	CALL	RGET0
  0D7B'                         GP_RD:
  0D7B'   CD 0000*              	CALL	RDGET		; (keeps DE)
  0D7E'   DA 0DA1'              	JC	GP_MID
  0D81'   FE 0A                 	CPI	LF
  0D83'   C2 0D97'              	JNZ	GP_RN
  0D86'   3A 0000*              	LDA	NEDIT
  0D89'   B7                    	ORA	A
  0D8A'   1F                    	RAR
  0D8B'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  0D8D'   E5                    	PUSH	H
  0D8E'   21 2236'              	LXI	H,ZLF
  0D91'   34                    	INR	M
  0D92'   BE                    	CMP	M		; CY iff more lines than that
  0D93'   E1                    	POP	H
  0D94'   DA 0DA1'              	JC	GP_MID
  0D97'                         GP_RN:
  0D97'   1B                    	DCX	D
  0D98'   7A                    	MOV	A,D
  0D99'   B3                    	ORA	E
  0D9A'   C2 0D7B'              	JNZ	GP_RD
  0D9D'   AF                    	XRA	A		; the top row
  0D9E'   C3 0DAB'              	JMP	GP_SET
  0DA1'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  0DA1'   3E 01                 	MVI	A,1
  0DA3'   32 0000*              	STA	WFILL		; not past the end of the file
  0DA6'   3A 0000*              	LDA	NEDIT
  0DA9'   B7                    	ORA	A
  0DAA'   1F                    	RAR			; the middle row
  0DAB'                         GP_SET:
  0DAB'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  0DAC'   26 00                 	MVI	H,0
  0DAE'   22 0000*              	SHLD	WINROW
  0DB1'   21 0000               	LXI	H,0
  0DB4'   22 0000*              	SHLD	LNDLT
  0DB7'   CD 0528'              	CALL	SETFUL		; the window may have paged: full repaint
  0DBA'                         GP_FIN:
  0DBA'   CD 0CCB'              	CALL	ZREST
  0DBD'   3A 2254'              	LDA	GPKEEP
  0DC0'   B7                    	ORA	A
  0DC1'   CA 05D5'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  0DC4'   AF                    	XRA	A
  0DC5'   32 2254'              	STA	GPKEEP
  0DC8'   C3 0384'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  0DCB'                         GP_ONS:
  0DCB'   6F                    	MOV	L,A
  0DCC'   26 00                 	MVI	H,0		; HL = the row it lands on
  0DCE'   EB                    	XCHG
  0DCF'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  0DD2'   EB                    	XCHG
  0DD3'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  0DD6'   22 0000*              	SHLD	LNDLT
  0DD9'   3E 01                 	MVI	A,R_MOVE
  0DDB'   32 21D9'              	STA	RINTENT
  0DDE'   C3 0DBA'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  0DE1'                         OPPEND:
  0DE1'   AF                    	XRA	A
  0DE2'   32 2202'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  0DE5'   3A 21FF'              	LDA	PSAVE
  0DE8'   FE 63                 	CPI	'c'
  0DEA'   C2 0E07'              	JNZ	OPP_ND
  0DED'   79                    	MOV	A,C
  0DEE'   FE 77                 	CPI	'w'
  0DF0'   CA 0DF8'              	JZ	OPP_W
  0DF3'   FE 57                 	CPI	'W'
  0DF5'   C2 0E07'              	JNZ	OPP_ND
  0DF8'                         OPP_W:
  0DF8'   CD 0E7B'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  0DFB'   DA 0E07'              	JC	OPP_ND
  0DFE'   79                    	MOV	A,C
  0DFF'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  0E01'   4F                    	MOV	C,A
  0E02'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  0E04'   32 2202'              	STA	CWEOL		;   see the clamp in OPA_F
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0E07'                         OPP_ND:
  0E07'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  0E08'   21 21FF'              	LXI	H,PSAVE
  0E0B'   BE                    	CMP	M
  0E0C'   CA 0E9C'              	JZ	OPLINE
  0E0F'   79                    	MOV	A,C		; (OPCLS classifies the key)
  0E10'   CD 0EAC'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  0E13'   DA 0E78'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  0E16'   32 2201'              	STA	OPCLSV
  0E19'   47                    	MOV	B,A		; B = the class
  0E1A'   3A 21FF'              	LDA	PSAVE
  0E1D'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  0E1F'   C2 0E2B'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  0E22'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  0E23'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  0E25'   C2 0E47'              	JNZ	OPP_GO
  0E28'   C3 0E36'              	JMP	OPP_NO
  0E2B'                         OPP_NC:
  0E2B'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  0E2D'   C2 0E47'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  0E30'   78                    	MOV	A,B		;   a charwise register would need a type flag
  0E31'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  0E33'   CA 0E47'              	JZ	OPP_GO		;   within a line -- neither of which is built
  0E36'                         OPP_NO:
  0E36'   79                    	MOV	A,C		; dropped -- but ''' and '`' still owe us their
  0E37'   FE 27                 	CPI	27H		;   mark letter, and an orphan would be dispatched
  0E39'   CA 0E41'              	JZ	OPP_SW		;   as a command ('a' opens an insert and types
  0E3C'   FE 60                 	CPI	60H		;   into the buffer), so swallow it before
  0E3E'   C2 0E78'              	JNZ	OPABRT		;   dropping the command
  0E41'                         OPP_SW:
  0E41'   CD 0229'              	CALL	MKGETK
  0E44'   C3 0E78'              	JMP	OPABRT
  0E47'                         OPP_GO:
  0E47'   AF                    	XRA	A
  0E48'   32 21E0'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  0E4B'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  0E4E'   22 2203'              	SHLD	OPSTA
  0E51'   21 2115'              	LXI	H,CMDTAB
  0E54'   CD 00D3'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  0E57'   3A 21FF'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  0E5A'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  0E5B'   CA 0507'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  0E5E'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  0E61'   22 2205'              	SHLD	OPEND2
  0E64'   3A 21FF'              	LDA	PSAVE
  0E67'   FE 79                 	CPI	'y'
  0E69'   CA 131F'              	JZ	OPYANK		; a yank takes the span without losing it
  0E6C'   CD 0EC4'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  0E6F'   3A 21FF'              	LDA	PSAVE
  0E72'   FE 63                 	CPI	'c'
  0E74'   C0                    	RNZ
  0E75'   C3 10E1'              	JMP	SETINS
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0E78'                         OPABRT:
  0E78'   C3 0507'              	JMP	SETMOV		; not a motion -> operator cancelled, nothing drew
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  0E7B'                         ONWHIT:
  0E7B'   CD 0476'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  0E7E'   CA 0E9A'              	JZ	OW_YES
  0E81'   CD 0481'              	CALL	CURCHR		; A = the char under the cursor
  0E84'   FE 20                 	CPI	' '
  0E86'   CA 0E9A'              	JZ	OW_YES
  0E89'   FE 09                 	CPI	TAB
  0E8B'   CA 0E9A'              	JZ	OW_YES
  0E8E'   FE 0D                 	CPI	CR
  0E90'   CA 0E9A'              	JZ	OW_YES
  0E93'   FE 0A                 	CPI	LF
  0E95'   CA 0E9A'              	JZ	OW_YES
  0E98'   B7                    	ORA	A		; a char to change: CY clear
  0E99'   C9                    	RET
  0E9A'                         OW_YES:
  0E9A'   37                    	STC
  0E9B'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  0E9C'                         OPLINE:
  0E9C'   3A 21FF'              	LDA	PSAVE
  0E9F'   FE 63                 	CPI	'c'
  0EA1'   CA 0507'              	JZ	SETMOV
  0EA4'   FE 79                 	CPI	'y'
  0EA6'   CA 130D'              	JZ	VY_YY
  0EA9'   C3 1284'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  0EAC'                         OPCLS:
  0EAC'   47                    	MOV	B,A
  0EAD'   21 0FE3'              	LXI	H,OPCTAB
  0EB0'                         OPC_LP:
  0EB0'   7E                    	MOV	A,M
  0EB1'   B7                    	ORA	A
  0EB2'   CA 0EC2'              	JZ	OPC_MS		; end of table -> not a motion
  0EB5'   B8                    	CMP	B
  0EB6'   CA 0EBE'              	JZ	OPC_HT
  0EB9'   23                    	INX	H
  0EBA'   23                    	INX	H
  0EBB'   C3 0EB0'              	JMP	OPC_LP
  0EBE'                         OPC_HT:
  0EBE'   23                    	INX	H
  0EBF'   7E                    	MOV	A,M		; class byte
  0EC0'   B7                    	ORA	A		; clear CY
  0EC1'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0EC2'                         OPC_MS:
  0EC2'   37                    	STC
  0EC3'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  0EC4'                         OPAPPL:
  0EC4'   3A 2201'              	LDA	OPCLSV
  0EC7'   FE 02                 	CPI	2
  0EC9'   CA 0FC7'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  0ECC'   2A 2203'              	LHLD	OPSTA
  0ECF'   EB                    	XCHG			; DE = start
  0ED0'   2A 2205'              	LHLD	OPEND2		; HL = end
  0ED3'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  0ED6'   DA 0EE6'              	JC	OPA_F
  0ED9'   CA 0EE6'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  0EDC'   22 2207'              	SHLD	OPLO
  0EDF'   EB                    	XCHG
  0EE0'   22 2209'              	SHLD	OPHI
  0EE3'   C3 0F3E'              	JMP	OPA_DO
  0EE6'                         OPA_F:
  0EE6'   EB                    	XCHG			; HL = start, DE = end
  0EE7'   22 2207'              	SHLD	OPLO
  0EEA'   EB                    	XCHG			; HL = end
  0EEB'   3A 2201'              	LDA	OPCLSV
  0EEE'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  0EF0'   CA 0F3B'              	JZ	OPA_HI		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  0EF3'   FE 01                 	CPI	1
  0EF5'   C2 0F17'              	JNZ	OPA_EX
  0EF8'   23                    	INX	H		; inclusive endpoint -> hi = end+1
                                	;--- 'cw' stops at the line's content end, where a plain 'ce' (and 'de')
                                	;    runs on into the next line's word and 'd%' crosses to its mate --
                                	;    all four recorded from vim 9.1.  vim's 'cw' is not simply 'ce': the
                                	;    rewrite keeps 'w's own end-of-line stop, so the clamp hangs off
                                	;    CWEOL (the rewrite) and not off the inclusive class. ---
  0EF9'   3A 2202'              	LDA	CWEOL
  0EFC'   B7                    	ORA	A
  0EFD'   CA 0F3B'              	JZ	OPA_HI
  0F00'   22 2209'              	SHLD	OPHI		; park the motion's own end: CEND clobbers DE
  0F03'   2A 2207'              	LHLD	OPLO
  0F06'   CD 105F'              	CALL	CEND		; HL = the start line's content end
  0F09'   EB                    	XCHG			; DE = that content end
  0F0A'   2A 2209'              	LHLD	OPHI		; HL = hi
  0F0D'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  0F10'   D2 0F3B'              	JNC	OPA_HI		; hi is inside the line: keep it
  0F13'   EB                    	XCHG			; HL = the content end: 'cw' stops there
  0F14'   C3 0F3B'              	JMP	OPA_HI
  0F17'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  0F17'   22 2209'              	SHLD	OPHI		; the motion's own end, for now
  0F1A'   2A 2207'              	LHLD	OPLO
  0F1D'   CD 105F'              	CALL	CEND		; HL = the start line's content end
  0F20'   EB                    	XCHG			; DE = that content end
  0F21'   3A 21E0'              	LDA	WPULL		; the motion landed on a line's end and was
  0F24'   B7                    	ORA	A		;   pulled back onto its last char (the command
  0F25'   C2 0F31'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  0F28'   2A 2209'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  0F2B'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  0F2E'   D2 0F3E'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  0F31'                         OPA_CE:				;   deletes the word, not all but its last char
  0F31'   2A 2207'              	LHLD	OPLO
  0F34'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  0F37'   CA 0F79'              	JZ	OPA_LN
  0F3A'   EB                    	XCHG			; HL = the content end
  0F3B'                         OPA_HI:
  0F3B'   22 2209'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  0F3E'                         OPA_DO:
  0F3E'   CD 0F57'              	CALL	OPDSPN
  0F41'   3A 21FF'              	LDA	PSAVE
  0F44'   FE 63                 	CPI	'c'
  0F46'   C8                    	RZ
  0F47'   C3 1070'              	JMP	CLAMPE
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  0F4A'                         SPNBRK:
  0F4A'   2A 2207'              	LHLD	OPLO
  0F4D'   CD 03FE'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  0F50'   EB                    	XCHG			; DE = it
  0F51'   2A 2209'              	LHLD	OPHI
  0F54'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  0F57'                         OPDSPN:
  0F57'   CD 0F4A'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  0F5A'   F5                    	PUSH	PSW
  0F5B'   2A 2207'              	LHLD	OPLO
  0F5E'   CD 0000*              	CALL	GOTO
  0F61'   2A 2209'              	LHLD	OPHI
  0F64'   EB                    	XCHG			; DE = hi
  0F65'   2A 2207'              	LHLD	OPLO
  0F68'   EB                    	XCHG			; HL = hi, DE = lo
  0F69'   CD 0000*              	CALL	SUBHD		; HL = hi - lo
  0F6C'   CD 0000*              	CALL	DELFWD
  0F6F'   CD 0196'              	CALL	MARKMOD
  0F72'   F1                    	POP	PSW
  0F73'   DA 0528'              	JC	SETFUL		; a break went: every row below it moved up
  0F76'   C3 050D'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  0F79'                         OPA_LN:
  0F79'   3A 21FF'              	LDA	PSAVE
  0F7C'   FE 63                 	CPI	'c'
  0F7E'   C2 0F87'              	JNZ	OPA_LD
  0F81'   2A 2207'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  0F84'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  0F87'                         OPA_LD:
  0F87'   2A 2207'              	LHLD	OPLO
  0F8A'   22 2203'              	SHLD	OPSTA
  0F8D'   22 2205'              	SHLD	OPEND2
  0F90'   C3 0FC7'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  0F93'                         OPALSP:
  0F93'   2A 2203'              	LHLD	OPSTA
  0F96'   EB                    	XCHG
  0F97'   2A 2205'              	LHLD	OPEND2
  0F9A'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  0F9D'   DA 0FAA'              	JC	OPAL_F
  0FA0'   22 2207'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  0FA3'   EB                    	XCHG
  0FA4'   22 2209'              	SHLD	OPHI		; hi-src = start
  0FA7'   C3 0FB4'              	JMP	OPAL_R
  0FAA'                         OPAL_F:
  0FAA'   EB                    	XCHG			; HL = start
  0FAB'   22 2207'              	SHLD	OPLO		; lo-src = start
  0FAE'   2A 2205'              	LHLD	OPEND2
  0FB1'   22 2209'              	SHLD	OPHI		; hi-src = end
  0FB4'                         OPAL_R:
  0FB4'   2A 2207'              	LHLD	OPLO
  0FB7'   CD 03EB'              	CALL	BOL
  0FBA'   22 2207'              	SHLD	OPLO		; lo = BOL(low line)
  0FBD'   2A 2209'              	LHLD	OPHI
  0FC0'   CD 0420'              	CALL	NLSTART
  0FC3'   22 2209'              	SHLD	OPHI		; hi = start of line past the high line
  0FC6'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  0FC7'                         OPALIN:
  0FC7'   CD 0F93'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


                                ; empty one.
  0FCA'                         OPDLIN:
  0FCA'   CD 0F57'              	CALL	OPDSPN
  0FCD'   CD 0476'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  0FD0'   DA 0FE0'              	JC	OPDL_NB
  0FD3'   CD 0000*              	CALL	LOGLEN
  0FD6'   7C                    	MOV	A,H
  0FD7'   B5                    	ORA	L
  0FD8'   C8                    	RZ			; empty buffer
  0FD9'   2B                    	DCX	H
  0FDA'   CD 03EB'              	CALL	BOL
  0FDD'   CD 0000*              	CALL	GOTO
  0FE0'                         OPDL_NB:
  0FE0'   C3 05D5'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  0FE3'                         OPCTAB:
  0FE3'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  0FE7'   62 00 42 00           
  0FEB'   68 00 6C 00           
  0FEF'   30 00 5E 00           
  0FF3'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  0FF5'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  0FF9'   24 01                 
  0FFB'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  0FFF'   47 02 48 02           
  1003'   4D 02 4C 02           
  1007'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1009'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  100A'                         VCB_C:
  100A'   CD 1016'              	CALL	VCB_CD
  100D'   C3 10E1'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  1010'                         VCB_D:
  1010'   CD 1016'              	CALL	VCB_CD
  1013'   C3 1070'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  1016'                         VCB_CD:
  1016'   CD 048D'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1019'   22 2207'              	SHLD	OPLO
  101C'   CD 0000*              	CALL	CUROFF
  101F'   CD 105F'              	CALL	CEND		; to the line's content end, the CR,LF left
  1022'   22 2209'              	SHLD	OPHI
  1025'   C3 0F57'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  1028'                         VC_X:
  1028'   CD 067A'              	CALL	GLSTAL
  102B'   CD 050D'              	CALL	SETLIN
  102E'   CD 049A'              	CALL	GETCNT
  1031'   22 220B'              	SHLD	CNTV
  1034'   CD 0000*              	CALL	CUROFF
  1037'   22 220F'              	SHLD	WKI		; cur
  103A'   CD 105F'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  103D'   EB                    	XCHG			; DE = contentend
  103E'   2A 220F'              	LHLD	WKI		; HL = cur
  1041'   EB                    	XCHG			; HL = contentend, DE = cur
  1042'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  1045'   7C                    	MOV	A,H
  1046'   B5                    	ORA	L
  1047'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  1048'   EB                    	XCHG			; DE = available
  1049'   2A 220B'              	LHLD	CNTV		; HL = count
  104C'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  104F'   DA 1055'              	JC	VX_USEA
  1052'   C3 1056'              	JMP	VX_DEL		; count <= available -> HL = count = del
  1055'                         VX_USEA:
  1055'   EB                    	XCHG			; HL = available
  1056'                         VX_DEL:
  1056'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  1059'   CD 0196'              	CALL	MARKMOD
  105C'   C3 1070'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  105F'                         CEND:
  105F'   CD 03FE'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  1062'   7C                    	MOV	A,H
  1063'   B5                    	ORA	L
  1064'   C8                    	RZ			; the start of the text: nothing before it
  1065'   2B                    	DCX	H
  1066'   E5                    	PUSH	H
  1067'   CD 0000*              	CALL	CHARAT
  106A'   E1                    	POP	H		; HL = term-1
  106B'   FE 0D                 	CPI	CR
  106D'   C8                    	RZ			; a CR before the LF -> the content ends there
  106E'   23                    	INX	H
  106F'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  1070'                         CLAMPE:
  1070'   CD 0000*              	CALL	CUROFF
  1073'   E5                    	PUSH	H
  1074'   CD 0432'              	CALL	EOLC
  1077'   D1                    	POP	D		; DE = cur
  1078'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  107B'   D8                    	RC
  107C'   C8                    	RZ
  107D'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1080'                         VC_I:
  1080'   CD 049A'              	CALL	GETCNT
  1083'   C3 10DE'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1086'                         VC_A:
  1086'   CD 049A'              	CALL	GETCNT
  1089'   CD 0476'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  108C'   CA 10A3'              	JZ	VA_INS
  108F'   EB                    	XCHG			; HL = cur
  1090'   E5                    	PUSH	H
  1091'   CD 0000*              	CALL	CHARAT
  1094'   E1                    	POP	H
  1095'   FE 0A                 	CPI	LF
  1097'   CA 10A3'              	JZ	VA_INS		; on the line terminator -> append in place
  109A'   FE 0D                 	CPI	CR
  109C'   CA 10A3'              	JZ	VA_INS
  109F'   23                    	INX	H
  10A0'   CD 0000*              	CALL	GOTO
  10A3'                         VA_INS:
  10A3'   C3 10DE'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  10A6'                         VCB_A:
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  10A6'   CD 048D'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  10A9'   CD 0432'              	CALL	EOLC		; HL = last content char (the start when empty)
  10AC'   E5                    	PUSH	H
  10AD'   CD 0000*              	CALL	CHARAT
  10B0'   E1                    	POP	H
  10B1'   FE 0D                 	CPI	CR
  10B3'   CA 10BC'              	JZ	VBA_IN		; an empty line: insert at its start
  10B6'   FE 0A                 	CPI	LF
  10B8'   CA 10BC'              	JZ	VBA_IN
  10BB'   23                    	INX	H		; past the last content char
  10BC'                         VBA_IN:
  10BC'   CD 0000*              	CALL	GOTO
  10BF'   C3 10DE'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  10C2'                         VCB_I:
  10C2'   CD 049A'              	CALL	GETCNT
  10C5'   CD 05D5'              	CALL	FNBLNK
  10C8'   CD 0000*              	CALL	CUROFF
  10CB'   E5                    	PUSH	H
  10CC'   CD 0000*              	CALL	CHARAT
  10CF'   E1                    	POP	H
  10D0'   FE 20                 	CPI	' '
  10D2'   CA 10DA'              	JZ	VBI_SK
  10D5'   FE 09                 	CPI	TAB
  10D7'   C2 10DE'              	JNZ	SETINM
  10DA'                         VBI_SK:
  10DA'   23                    	INX	H		; blanks only: past the last of them
  10DB'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  10DE'                         SETINM:
  10DE'   CD 0507'              	CALL	SETMOV
  10E1'                         SETINS:
  10E1'   3E 01                 	MVI	A,EM_INS
  10E3'   32 21D4'              	STA	EDMODE
  10E6'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  10E7'                         ATCEND:
  10E7'   CD 0476'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  10EA'   C8                    	RZ
  10EB'   CD 0481'              	CALL	CURCHR		; A = the char under the cursor
  10EE'   FE 0D                 	CPI	CR
  10F0'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  10F1'   FE 0A                 	CPI	LF
  10F3'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  10F4'                         OPNBRK:
  10F4'   3E 0D                 	MVI	A,CR
  10F6'   CD 0000*              	CALL	PUTGAP
  10F9'   3E 0A                 	MVI	A,LF
  10FB'   CD 0000*              	CALL	PUTGAP
  10FE'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1101'   23                    	INX	H
  1102'   22 0000*              	SHLD	LNDLT
  1105'   C3 0196'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1108'                         ENDBRK:
  1108'   CD 0476'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  110B'   C0                    	RNZ
  110C'   CD 10F4'              	CALL	OPNBRK
  110F'   CD 0000*              	CALL	CUROFF
  1112'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1113'   2B                    	DCX	H		;   line, with its own terminator after it
  1114'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1117'                         VC_O:
  1117'   CD 048D'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  111A'   CD 105F'              	CALL	CEND
  111D'   CD 0000*              	CALL	GOTO
  1120'   CD 10F4'              	CALL	OPNBRK
  1123'   CD 1108'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1126'   CD 0513'              	CALL	SETILN		;   needs a terminator of its own to exist
  1129'   C3 10E1'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  112C'                         VCB_O:
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  112C'   CD 048D'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  112F'   CD 03EB'              	CALL	BOL
  1132'   CD 0000*              	CALL	GOTO
  1135'   CD 10F4'              	CALL	OPNBRK
  1138'   CD 0000*              	CALL	CUROFF
  113B'   2B                    	DCX	H
  113C'   2B                    	DCX	H
  113D'   CD 0000*              	CALL	GOTO
  1140'   CD 0513'              	CALL	SETILN
  1143'   C3 10E1'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  1146'                         VCB_J:
  1146'   CD 048D'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1149'   CD 105F'              	CALL	CEND		; the join point: this line's content end
  114C'   22 2207'              	SHLD	OPLO
  114F'   CD 0000*              	CALL	CUROFF
  1152'   CD 0420'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1155'   E5                    	PUSH	H
  1156'   CD 0000*              	CALL	LOGLEN
  1159'   D1                    	POP	D		; DE = that start
  115A'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  115D'   CA 0507'              	JZ	SETMOV
  1160'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1161'                         VJ_WS:
  1161'   E5                    	PUSH	H
  1162'   CD 0000*              	CALL	LOGLEN
  1165'   D1                    	POP	D		; DE = the scan
  1166'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1169'   CA 1180'              	JZ	VJ_DEL
  116C'   EB                    	XCHG			; HL = the scan
  116D'   E5                    	PUSH	H
  116E'   CD 0000*              	CALL	CHARAT
  1171'   E1                    	POP	H
  1172'   FE 20                 	CPI	' '
  1174'   CA 117C'              	JZ	VJ_SKIP
  1177'   FE 09                 	CPI	TAB
  1179'   C2 1180'              	JNZ	VJ_DEL
  117C'                         VJ_SKIP:
  117C'   23                    	INX	H
  117D'   C3 1161'              	JMP	VJ_WS
  1180'                         VJ_DEL:
  1180'   22 2209'              	SHLD	OPHI
  1183'   CD 0F57'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1186'   CD 0522'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1189'   CD 0476'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  118C'   CA 1070'              	JZ	CLAMPE
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  118F'   CD 0481'              	CALL	CURCHR		; the first char of what was appended
  1192'   FE 0D                 	CPI	CR
  1194'   CA 1070'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1197'   FE 0A                 	CPI	LF
  1199'   CA 1070'              	JZ	CLAMPE
  119C'   FE 29                 	CPI	')'
  119E'   CA 1070'              	JZ	CLAMPE		; vim puts no space before a ')'
  11A1'   CD 0000*              	CALL	CUROFF
  11A4'   7C                    	MOV	A,H
  11A5'   B5                    	ORA	L
  11A6'   CA 11BC'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  11A9'   2B                    	DCX	H
  11AA'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  11AD'   FE 20                 	CPI	' '
  11AF'   CA 1070'              	JZ	CLAMPE
  11B2'   FE 09                 	CPI	TAB
  11B4'   CA 1070'              	JZ	CLAMPE
  11B7'   FE 0A                 	CPI	LF
  11B9'   CA 1070'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  11BC'                         VJ_SP:
  11BC'   3E 20                 	MVI	A,' '
  11BE'   CD 0000*              	CALL	PUTGAP
  11C1'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  11C4'   2B                    	DCX	H
  11C5'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  11C8'                         VC_TILD:
  11C8'   CD 049A'              	CALL	GETCNT
  11CB'   CD 050D'              	CALL	SETLIN		; only this row changes
  11CE'   CD 067A'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  11D1'   CD 0476'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  11D4'   CA 0507'              	JZ	SETMOV
  11D7'   CD 0481'              	CALL	CURCHR		; A = the char under the cursor
  11DA'   FE 0D                 	CPI	CR
  11DC'   CA 0507'              	JZ	SETMOV		; the line's end: nothing to toggle
  11DF'   FE 0A                 	CPI	LF
  11E1'   CA 0507'              	JZ	SETMOV
  11E4'   47                    	MOV	B,A
  11E5'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  11E7'   FE 41                 	CPI	'A'
  11E9'   DA 11F5'              	JC	VT_PUT		; below 'A': no case
  11EC'   FE 5B                 	CPI	'Z'+1
  11EE'   D2 11F5'              	JNC	VT_PUT		; above 'Z': no case
  11F1'   78                    	MOV	A,B
  11F2'   EE 20                 	XRI	20H		; a letter: flip the case bit
  11F4'   47                    	MOV	B,A
  11F5'                         VT_PUT:
  11F5'   78                    	MOV	A,B
  11F6'   32 221A'              	STA	VRCH		; the calls below do not preserve B
  11F9'   CD 0196'              	CALL	MARKMOD
  11FC'   21 0001               	LXI	H,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  11FF'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1202'   3A 221A'              	LDA	VRCH
  1205'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1208'   C3 1070'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  120B'                         VC_R:
  120B'   CD 0487'              	CALL	MOVCNT		; a cursor motion, and its count
  120E'   3E 03                 	MVI	A,PR
  1210'   32 21FC'              	STA	GPEND
  1213'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1214'                         VR_DO:
  1214'   AF                    	XRA	A
  1215'   32 21FC'              	STA	GPEND
  1218'   79                    	MOV	A,C
  1219'   32 221A'              	STA	VRCH		; the calls below do not preserve C
  121C'   CD 050D'              	CALL	SETLIN		; only this row changed
  121F'   CD 067A'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1222'   CD 0476'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1225'   CA 0507'              	JZ	SETMOV		; the end of the text: vim does nothing
  1228'   CD 0481'              	CALL	CURCHR		; A = the char under the cursor
  122B'   FE 0D                 	CPI	CR
  122D'   CA 0507'              	JZ	SETMOV		; the line's end: nothing to replace
  1230'   FE 0A                 	CPI	LF
  1232'   CA 0507'              	JZ	SETMOV
  1235'   CD 0196'              	CALL	MARKMOD
  1238'   21 0001               	LXI	H,1
  123B'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  123E'   3A 221A'              	LDA	VRCH
  1241'   FE 0D                 	CPI	CR
  1243'   CA 1250'              	JZ	VR_CR
  1246'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1249'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  124C'   2B                    	DCX	H		;   out, which moves every logical offset
  124D'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1250'                         VR_CR:
  1250'   CD 10F4'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1253'   CD 1108'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1256'   CD 0513'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1259'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  125B'   32 21DC'              	STA	ILABOV
  125E'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  125F'                         VCB_R:
  125F'   CD 049A'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1262'   CD 0507'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1265'   21 0000               	LXI	H,0
  1268'   22 221B'              	SHLD	RPDEL		; nothing of ours to put back yet
  126B'   22 221D'              	SHLD	RPAPP
  126E'   3E 02                 	MVI	A,EM_REP
  1270'   32 21D4'              	STA	EDMODE
  1273'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1274'                         VC_D:
  1274'   3E 64                 	MVI	A,'d'
  1276'   32 21FE'              	STA	PENDOP
  1279'   C3 0507'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  127C'                         VC_C:
  127C'   3E 63                 	MVI	A,'c'
  127E'   32 21FE'              	STA	PENDOP
  1281'   C3 0507'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1284'                         VD_DD:
  1284'   CD 067A'              	CALL	GLSTAL
  1287'   CD 049A'              	CALL	GETCNT
  128A'   22 220B'              	SHLD	CNTV
  128D'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  128F'   32 2200'              	STA	DDSNG
  1292'   2B                    	DCX	H
  1293'   7C                    	MOV	A,H
  1294'   B5                    	ORA	L
  1295'   C2 12A0'              	JNZ	VDD_LS
  1298'   3E 01                 	MVI	A,1
  129A'   32 2200'              	STA	DDSNG
  129D'   C3 12B4'              	JMP	VDD_GO
  12A0'                         VDD_LS:
  12A0'   CD 0000*              	CALL	RGET0		; vim: is this the last line?  (pages in)
  12A3'                         VDD_LL:
  12A3'   CD 0000*              	CALL	RDGET
  12A6'   DA 0507'              	JC	SETMOV		; the file ends on this line: nothing to do
  12A9'   FE 0A                 	CPI	LF
  12AB'   C2 12A3'              	JNZ	VDD_LL
  12AE'   CD 0000*              	CALL	RDGET
  12B1'   DA 0507'              	JC	SETMOV		; nothing after its LF: the last line
  12B4'                         VDD_GO:
  12B4'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  12B7'   CD 05BE'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  12BA'   2A 220B'              	LHLD	CNTV
  12BD'   CD 0000*              	CALL	SETC0
  12C0'                         VDD_FW:
  12C0'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  12C3'   CD 04AF'              	CALL	CNTTST
  12C6'   C2 12C0'              	JNZ	VDD_FW
  12C9'   CD 0196'              	CALL	MARKMOD
  12CC'   CD 07B1'              	CALL	ATEOF
  12CF'   D2 12EA'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  12D2'   3E 00                 	MVI	A,0
  12D4'   32 2200'              	STA	DDSNG		; deleted to the end: full repaint
  12D7'   CD 0BF7'              	CALL	ONFST
  12DA'   CA 05D5'              	JZ	FNBLNK		; nothing left before it
  12DD'   21 0001               	LXI	H,1		; onto the new last line
  12E0'   CD 0000*              	CALL	SETBWD
  12E3'   2A 0000*              	LHLD	LNDLT
  12E6'   2B                    	DCX	H
  12E7'   22 0000*              	SHLD	LNDLT
  12EA'                         VDD_UP:
  12EA'   CD 05D5'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  12ED'   3A 2200'              	LDA	DDSNG
  12F0'   B7                    	ORA	A
  12F1'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  12F2'   3E 03                 	MVI	A,R_DLIN
  12F4'   32 21D9'              	STA	RINTENT
  12F7'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and an overflow raises WM's 'QBUF FULL' with
                                ; what has already moved safely in the register.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  12F8'                         QEMPTY:
  12F8'   2A 0000*              	LHLD	QBEG
  12FB'   EB                    	XCHG
  12FC'   2A 0000*              	LHLD	QEND
  12FF'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  1300'   BA                    	CMP	D
  1301'   C0                    	RNZ
  1302'   7D                    	MOV	A,L
  1303'   BB                    	CMP	E
  1304'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1305'                         VC_Y:
  1305'   3E 79                 	MVI	A,'y'
  1307'   32 21FE'              	STA	PENDOP
  130A'   C3 0507'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; WordMaster has no copy-without-delete -- QCOPY's source is always GAPEND, and
                                ; a non-deleting chunked copy has no pointer the gap machinery would keep valid
                                ; across its MKGAP (MOVGAP fixes up the pointer row only, and MKROOM can page
                                ; the source out entirely) -- so the lines are taken out with dd's own engine
                                ; and put straight back with QGET.  The file is therefore briefly short, and
                                ; MODF is put back afterwards: a yank must not mark the file modified.
                                ; The paint is forced full: the delete and re-insert may have paged.
  130D'                         VY_YY:
  130D'   CD 0000*              	CALL	CUROFF
  1310'   22 2244'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1313'   CD 03EB'              	CALL	BOL
  1316'   22 2246'              	SHLD	YPT		; where the lines come from, to put them back
  1319'   21 1284'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  131C'   C3 133C'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  131F'                         OPYANK:
  131F'   CD 0F93'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1322'   2A 2203'              	LHLD	OPSTA
  1325'   EB                    	XCHG			; DE = start
  1326'   2A 2205'              	LHLD	OPEND2		; HL = end
  1329'   CD 0000*              	CALL	CMP16		; CY iff start < end
  132C'   D2 1330'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  132F'   EB                    	XCHG			; ... otherwise the start is
  1330'                         OPY_LO:
  1330'   22 2244'              	SHLD	YOFF
  1333'   2A 2207'              	LHLD	OPLO
  1336'   22 2246'              	SHLD	YPT		; where the lines come from, to put them back
  1339'   21 13AA'              	LXI	H,YSPAN
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  133C'                         YKGO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  133C'   22 225C'              	SHLD	YACT
  133F'   3A 21D8'              	LDA	MODF
  1342'   32 2241'              	STA	YMODF
  1345'   3A 21F1'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1348'   32 2242'              	STA	YDCHG		;   a yank must not become the last change
  134B'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  134E'   32 2243'              	STA	YURPL		;   back are not a change to undo either
  1351'   3E 01                 	MVI	A,1
  1353'   32 0000*              	STA	UNDRPL
  1356'   32 225B'              	STA	MKHOLD		; ... nor a change to drop a mark for: MKDROP
  1359'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  135C'   22 224F'              	SHLD	YLDLT
  135F'   CD 0000*              	CALL	LOGLEN
  1362'   22 2260'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1365'   2A 225C'              	LHLD	YACT
  1368'   CD 13A9'              	CALL	YCALL		; the lines out of the file, into the register
  136B'   CD 0000*              	CALL	LOGLEN
  136E'   EB                    	XCHG
  136F'   2A 2260'              	LHLD	YWAS
  1372'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1375'   CA 1381'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1378'   2A 2246'              	LHLD	YPT
  137B'   CD 0000*              	CALL	GOTO
  137E'   CD 0000*              	CALL	QGET		; and straight back in
  1381'                         YK_FIN:
  1381'   2A 2244'              	LHLD	YOFF
  1384'   CD 0000*              	CALL	GOTO
  1387'   2A 224F'              	LHLD	YLDLT
  138A'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  138D'   3A 2241'              	LDA	YMODF
  1390'   32 21D8'              	STA	MODF
  1393'   3A 2242'              	LDA	YDCHG
  1396'   32 21F1'              	STA	DOTCHG
  1399'   3A 2243'              	LDA	YURPL
  139C'   32 0000*              	STA	UNDRPL
  139F'   AF                    	XRA	A
  13A0'   32 225B'              	STA	MKHOLD
  13A3'   CD 067A'              	CALL	GLSTAL
  13A6'   C3 0528'              	JMP	SETFUL		; the cheap paint cannot carry this
  13A9'   E9                    YCALL:	PCHL
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  13AA'                         YSPAN:
  13AA'   CD 067A'              	CALL	GLSTAL
  13AD'   2A 2209'              	LHLD	OPHI
  13B0'   EB                    	XCHG
  13B1'   2A 2207'              	LHLD	OPLO
  13B4'   EB                    	XCHG			; HL = hi, DE = lo
  13B5'   CD 0000*              	CALL	SUBHD		; HL = the span's length
  13B8'   22 225E'              	SHLD	YTGT
  13BB'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  13BE'   EB                    	XCHG			; DE = it
  13BF'   2A 225E'              	LHLD	YTGT
  13C2'   EB                    	XCHG			; HL = the text's, DE = the span's
  13C3'   CD 0000*              	CALL	SUBHD
  13C6'   22 225E'              	SHLD	YTGT		; what the text is left at when the span is out
  13C9'   2A 2207'              	LHLD	OPLO
  13CC'   CD 0000*              	CALL	GOTO
  13CF'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  13D2'                         YS_LP:
  13D2'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  13D5'   CD 0000*              	CALL	SETC0
  13D8'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  13DB'   CD 0000*              	CALL	LOGLEN
  13DE'   EB                    	XCHG			; DE = what is left
  13DF'   2A 225E'              	LHLD	YTGT
  13E2'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  13E5'   DA 13EB'              	JC	YS_END		; below it -- cannot happen over whole lines,
  13E8'   C2 13D2'              	JNZ	YS_LP		;   but never spin here if it ever did
  13EB'                         YS_END:
  13EB'   C3 0196'              	JMP	MARKMOD
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  13EE'                         VC_P:
  13EE'   CD 12F8'              	CALL	QEMPTY
  13F1'   CA 14A9'              	JZ	VP_BEL
  13F4'   CD 049A'              	CALL	GETCNT
  13F7'   22 2248'              	SHLD	PCNT
  13FA'   CD 0000*              	CALL	CUROFF
  13FD'   CD 0420'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1400'   C3 1415'              	JMP	VP_GO
  1403'                         VCB_P:
  1403'   CD 12F8'              	CALL	QEMPTY
  1406'   CA 14A9'              	JZ	VP_BEL
  1409'   CD 049A'              	CALL	GETCNT
  140C'   22 2248'              	SHLD	PCNT
  140F'   CD 0000*              	CALL	CUROFF
  1412'   CD 03EB'              	CALL	BOL
  1415'                         VP_GO:
  1415'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1418'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  141B'   EB                    	XCHG
  141C'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  141F'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1422'   DA 1437'              	JC	VP_IN
  1425'   EB                    	XCHG			; HL = the put point = LOGLEN
  1426'   7C                    	MOV	A,H
  1427'   B5                    	ORA	L
  1428'   CA 1434'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  142B'   2B                    	DCX	H
  142C'   CD 0000*              	CALL	CHARAT
  142F'   FE 0A                 	CPI	LF
  1431'   CA 1437'              	JZ	VP_IN
  1434'                         VP_BRK:
  1434'   CD 10F4'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1437'                         VP_IN:
  1437'   CD 0000*              	CALL	CUROFF
  143A'   22 224A'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  143D'   2A 0000*              	LHLD	QBEG
  1440'   EB                    	XCHG
  1441'   2A 0000*              	LHLD	QEND
  1444'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1447'   EB                    	XCHG
  1448'   22 224C'              	SHLD	PLFS
  144B'   2A 2248'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  144E'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  144F'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1450'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1452'   C2 1456'              	JNZ	VP_PZ
  1455'   7D                    	MOV	A,L
  1456'                         VP_PZ:
  1456'   32 224E'              	STA	PCPY
  1459'                         VP_LP:
  1459'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  145C'   2A 0000*              	LHLD	LNDLT
  145F'   EB                    	XCHG
  1460'   2A 224C'              	LHLD	PLFS
  1463'   19                    	DAD	D
  1464'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1467'   2A 2248'              	LHLD	PCNT
  146A'   2B                    	DCX	H
  146B'   22 2248'              	SHLD	PCNT
  146E'   7C                    	MOV	A,H
  146F'   B5                    	ORA	L
  1470'   C2 1459'              	JNZ	VP_LP
  1473'   CD 0196'              	CALL	MARKMOD
  1476'   2A 224A'              	LHLD	PPT
  1479'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  147C'   CD 067A'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  147F'   3A 224E'              	LDA	PCPY
  1482'   B7                    	ORA	A
  1483'   CA 05D5'              	JZ	FNBLNK
  1486'   2A 224C'              	LHLD	PLFS
  1489'   7C                    	MOV	A,H
  148A'   B7                    	ORA	A
  148B'   C2 05D5'              	JNZ	FNBLNK
  148E'   3A 224E'              	LDA	PCPY
  1491'   CD 0B8D'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1494'   7C                    	MOV	A,H
  1495'   B7                    	ORA	A
  1496'   C2 05D5'              	JNZ	FNBLNK
  1499'   7D                    	MOV	A,L
  149A'   B7                    	ORA	A
  149B'   CA 05D5'              	JZ	FNBLNK
  149E'   F5                    	PUSH	PSW
  149F'   CD 0513'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  14A2'   F1                    	POP	PSW
  14A3'   32 21DA'              	STA	ILN		; ... which the lines put now replace
  14A6'   C3 05D5'              	JMP	FNBLNK
  14A9'                         VP_BEL:
  14A9'   CD 049A'              	CALL	GETCNT		; the count is spent either way
  14AC'   0E 07                 	MVI	C,BEL
  14AE'   CD 0000*              	CALL	BCONOU
  14B1'   C3 0507'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  14B4'                         VIREP:
  14B4'   78                    	MOV	A,B
  14B5'   FE 01                 	CPI	KT_ACT
  14B7'   CA 15E4'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  14BA'   FE 02                 	CPI	KT_CHAR
  14BC'   C0                    	RNZ			; ignore anything else
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  14BD'   79                    	MOV	A,C
  14BE'   FE 0D                 	CPI	CR
  14C0'   CA 1524'              	JZ	VP_CR
  14C3'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  14C5'   CA 1524'              	JZ	VP_CR
  14C8'   FE 08                 	CPI	BS
  14CA'   CA 1530'              	JZ	VP_BS
  14CD'   FE 7F                 	CPI	DEL
  14CF'   CA 1530'              	JZ	VP_BS
  14D2'   32 221A'              	STA	VRCH		; the calls below do not preserve C
  14D5'   CD 050D'              	CALL	SETLIN		; this row changed
  14D8'   CD 0196'              	CALL	MARKMOD
  14DB'   CD 10E7'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  14DE'   CA 1516'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  14E1'   3A 221A'              	LDA	VRCH
  14E4'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  14E7'   2A 221B'              	LHLD	RPDEL
  14EA'   7C                    	MOV	A,H
  14EB'   B5                    	ORA	L
  14EC'   CA 1502'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  14EF'   2A 0000*              	LHLD	GAPEND
  14F2'   EB                    	XCHG
  14F3'   2A 221F'              	LHLD	RPGE
  14F6'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  14F9'   CA 1502'              	JZ	VP_OVW
  14FC'   21 0000               	LXI	H,0
  14FF'   22 221B'              	SHLD	RPDEL		; the text moved: those originals are gone
  1502'                         VP_OVW:
  1502'   21 0001               	LXI	H,1
  1505'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1508'   2A 0000*              	LHLD	GAPEND
  150B'   22 221F'              	SHLD	RPGE
  150E'   2A 221B'              	LHLD	RPDEL
  1511'   23                    	INX	H
  1512'   22 221B'              	SHLD	RPDEL
  1515'   C9                    	RET
  1516'                         VP_APP:
  1516'   3A 221A'              	LDA	VRCH
  1519'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  151C'   2A 221D'              	LHLD	RPAPP
  151F'   23                    	INX	H
  1520'   22 221D'              	SHLD	RPAPP
  1523'   C9                    	RET
  1524'                         VP_CR:
  1524'   21 0000               	LXI	H,0
  1527'   22 221B'              	SHLD	RPDEL		; a line break ends what BS can put back
  152A'   22 221D'              	SHLD	RPAPP
  152D'   C3 15BA'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1530'                         VP_BS:
  1530'   2A 221D'              	LHLD	RPAPP
  1533'   7C                    	MOV	A,H
  1534'   B5                    	ORA	L
  1535'   CA 1542'              	JZ	VP_BSD
  1538'   2B                    	DCX	H
  1539'   22 221D'              	SHLD	RPAPP		; an appended char: it just goes
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  153C'   CD 050D'              	CALL	SETLIN
  153F'   C3 0000*              	JMP	DELPRV
  1542'                         VP_BSD:
  1542'   2A 221B'              	LHLD	RPDEL
  1545'   7C                    	MOV	A,H
  1546'   B5                    	ORA	L
  1547'   CA 156E'              	JZ	VP_BSM		; nothing of ours left
  154A'   2A 0000*              	LHLD	GAPEND
  154D'   EB                    	XCHG
  154E'   2A 221F'              	LHLD	RPGE
  1551'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1554'   C2 156E'              	JNZ	VP_BSM
  1557'   2A 221B'              	LHLD	RPDEL
  155A'   2B                    	DCX	H
  155B'   22 221B'              	SHLD	RPDEL
  155E'   CD 050D'              	CALL	SETLIN
  1561'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1564'   CD 0000*              	CALL	UNDELF		; the original comes back
  1567'   2A 0000*              	LHLD	GAPEND
  156A'   22 221F'              	SHLD	RPGE
  156D'   C9                    	RET
  156E'                         VP_BSM:
  156E'   CD 0507'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1571'   C3 0576'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  1574'                         VIINS:
  1574'   78                    	MOV	A,B
  1575'   FE 01                 	CPI	KT_ACT
  1577'   CA 15E4'              	JZ	VI_ACT
  157A'   FE 02                 	CPI	KT_CHAR
  157C'   C0                    	RNZ			; ignore anything else
  157D'   79                    	MOV	A,C
  157E'   FE 0D                 	CPI	CR
  1580'   CA 15BA'              	JZ	VI_CR
  1583'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1585'   CA 15BA'              	JZ	VI_CR
  1588'   FE 08                 	CPI	BS
  158A'   CA 15D2'              	JZ	VI_BS
  158D'   FE 7F                 	CPI	DEL
  158F'   CA 15D2'              	JZ	VI_BS
  1592'   79                    	MOV	A,C
  1593'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1596'   CD 0196'              	CALL	MARKMOD
  1599'   CD 050D'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  159C'   79                    	MOV	A,C
  159D'   FE 20                 	CPI	' '
  159F'   D8                    	RC			; control char -> keep R_LINE
  15A0'   FE 7F                 	CPI	DEL
  15A2'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  15A3'   CD 052E'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  15A6'   B7                    	ORA	A
  15A7'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  15A8'   3E 04                 	MVI	A,R_ICH
  15AA'   32 21D9'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  15AD'   CD 10E7'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  15B0'   3E 00                 	MVI	A,0
  15B2'   C2 15B6'              	JNZ	VI_ICH
  15B5'   3C                    	INR	A
  15B6'                         VI_ICH:
  15B6'   32 21DB'              	STA	ICHAPP
  15B9'   C9                    	RET
  15BA'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  15BA'   CD 10E7'              	CALL	ATCEND
  15BD'   3E 00                 	MVI	A,0
  15BF'   CA 15C3'              	JZ	VI_CRS
  15C2'   3C                    	INR	A
  15C3'                         VI_CRS:
  15C3'   F5                    	PUSH	PSW
  15C4'   CD 10F4'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  15C7'   CD 1108'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  15CA'   CD 0513'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  15CD'   F1                    	POP	PSW
  15CE'   32 21DC'              	STA	ILABOV
  15D1'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  15D2'                         VI_BS:
  15D2'   CD 0000*              	CALL	PEEKL
  15D5'   D8                    	RC			; start of the file: nothing to delete
  15D6'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  15D8'   CA 15DE'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  15DB'   CD 050D'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  15DE'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  15DE'   CD 0196'              	CALL	MARKMOD
  15E1'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  15E4'                         VI_ACT:
  15E4'   79                    	MOV	A,C
  15E5'   FE 0B                 	CPI	ACT_ESC
  15E7'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  15E8'   3E 00                 	MVI	A,EM_CMD
  15EA'   32 21D4'              	STA	EDMODE
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  15ED'   CD 0507'              	CALL	SETMOV
  15F0'   CD 0576'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  15F3'   C3 067A'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does; a control char is ignored (WM stores it
                                ; and shows ^X).  WM's ^X ^U ^\ ^R ^E ^C line edits are not kept.
  15F6'                         RDLINE:
  15F6'   EB                    	XCHG			; HL = buffer
  15F7'   22 2227'              	SHLD	RLPTR
  15FA'   3E 00                 	MVI	A,0
  15FC'   32 2229'              	STA	RLLEN
  15FF'   78                    	MOV	A,B
  1600'   32 222A'              	STA	RLMAX
  1603'   79                    	MOV	A,C
  1604'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1607'                         RL_LP:
  1607'   CD 0000*              	CALL	GETKEY
  160A'   78                    	MOV	A,B
  160B'   FE 01                 	CPI	KT_ACT
  160D'   CA 1663'              	JZ	RL_ACT
  1610'   FE 02                 	CPI	KT_CHAR
  1612'   C2 1607'              	JNZ	RL_LP		; ignore other keys
  1615'   79                    	MOV	A,C
  1616'   FE 0D                 	CPI	CR
  1618'   CA 166F'              	JZ	RL_DONE
  161B'   FE 08                 	CPI	BS
  161D'   CA 164B'              	JZ	RL_BS
  1620'   FE 7F                 	CPI	DEL
  1622'   CA 164B'              	JZ	RL_BS
  1625'   FE 20                 	CPI	' '
  1627'   DA 1607'              	JC	RL_LP		; control char -> ignore
  162A'   3A 2229'              	LDA	RLLEN
  162D'   47                    	MOV	B,A
  162E'   3A 222A'              	LDA	RLMAX
  1631'   B8                    	CMP	B
  1632'   CA 1607'              	JZ	RL_LP		; full -> ignore
  1635'   2A 2227'              	LHLD	RLPTR
  1638'   71                    	MOV	M,C
  1639'   23                    	INX	H
  163A'   22 2227'              	SHLD	RLPTR
  163D'   3A 2229'              	LDA	RLLEN
  1640'   3C                    	INR	A
  1641'   32 2229'              	STA	RLLEN
  1644'   79                    	MOV	A,C
  1645'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1648'   C3 1607'              	JMP	RL_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  164B'                         RL_BS:				; WM LINEPOP
  164B'   3A 2229'              	LDA	RLLEN
  164E'   B7                    	ORA	A
  164F'   CA 1669'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1652'   3D                    	DCR	A
  1653'   32 2229'              	STA	RLLEN
  1656'   2A 2227'              	LHLD	RLPTR
  1659'   2B                    	DCX	H
  165A'   22 2227'              	SHLD	RLPTR
  165D'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1660'   C3 1607'              	JMP	RL_LP
  1663'                         RL_ACT:
  1663'   79                    	MOV	A,C
  1664'   FE 0B                 	CPI	ACT_ESC
  1666'   C2 1607'              	JNZ	RL_LP
  1669'                         RL_CAN:
  1669'   CD 050D'              	CALL	SETLIN		; redraw one row; the cancelled line stays, as vim's
  166C'   3E FF                 	MVI	A,0FFH		; cancelled
  166E'   C9                    	RET
  166F'                         RL_DONE:
  166F'   AF                    	XRA	A
  1670'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1671'                         VC_BZ:
  1671'   CD 0507'              	CALL	SETMOV
  1674'   3A 21FD'              	LDA	GSAVE
  1677'   FE 02                 	CPI	PZ
  1679'   CA 1684'              	JZ	VZ_ZZ
  167C'   B7                    	ORA	A
  167D'   C0                    	RNZ			; 'g' was pending: vim drops both
  167E'   3E 02                 	MVI	A,PZ
  1680'   32 21FC'              	STA	GPEND
  1683'   C9                    	RET
  1684'                         VZ_ZZ:
  1684'   3E 04                 	MVI	A,EO_X
  1686'   32 222B'              	STA	EXOP
  1689'   3E 01                 	MVI	A,1
  168B'   32 223E'              	STA	EXBANG		; no '!'
  168E'   AF                    	XRA	A
  168F'   32 222C'              	STA	EXARG		; no file name
  1692'   3A 21D8'              	LDA	MODF		; as ':x': a changed text is written first
  1695'   B7                    	ORA	A
  1696'   CA 17B9'              	JZ	EX_Q
  1699'   C3 1753'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  169C'                         VC_EX:
  169C'   CD 049A'              	CALL	GETCNT
  169F'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  16A2'   11 0000*              	LXI	D,EXBUF
  16A5'   06 28                 	MVI	B,EXMAX
  16A7'   0E 3A                 	MVI	C,':'
  16A9'   CD 15F6'              	CALL	RDLINE
  16AC'   B7                    	ORA	A
  16AD'   C0                    	RNZ			; cancelled
  16AE'   3A 2229'              	LDA	RLLEN
  16B1'   5F                    	MOV	E,A
  16B2'   16 00                 	MVI	D,0
  16B4'   21 0000*              	LXI	H,EXBUF
  16B7'   19                    	DAD	D
  16B8'   36 00                 	MVI	M,0		; the line ends with a 0
  16BA'   21 0000*              	LXI	H,EXBUF
  16BD'   CD 1A55'              	CALL	SKIPB
  16C0'   C8                    	RZ			; nothing on it
  16C1'   22 222E'              	SHLD	EXCMD
  16C4'   CD 1BF2'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  16C7'   CD 1A55'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  16CA'   56                    	MOV	D,M
  16CB'   23                    	INX	H
  16CC'   1E 00                 	MVI	E,0
  16CE'   CD 1A61'              	CALL	ISLOW
  16D1'   DA 16DC'              	JC	EX_LK
  16D4'   5F                    	MOV	E,A
  16D5'   23                    	INX	H
  16D6'   CD 1A61'              	CALL	ISLOW
  16D9'   D2 16F5'              	JNC	EX_NOT		; a third letter: none of ours
  16DC'                         EX_LK:
  16DC'   E5                    	PUSH	H
  16DD'   21 1BDC'              	LXI	H,EXTAB
  16E0'                         EX_TL:
  16E0'   7E                    	MOV	A,M
  16E1'   B7                    	ORA	A
  16E2'   CA 16F4'              	JZ	EX_NTP		; not in the table
  16E5'   23                    	INX	H
  16E6'   BA                    	CMP	D
  16E7'   7E                    	MOV	A,M
  16E8'   23                    	INX	H
  16E9'   C2 16F0'              	JNZ	EX_TN
  16EC'   BB                    	CMP	E
  16ED'   CA 16FB'              	JZ	EX_TF
  16F0'                         EX_TN:
  16F0'   23                    	INX	H
  16F1'   C3 16E0'              	JMP	EX_TL
  16F4'                         EX_NTP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  16F4'   E1                    	POP	H
  16F5'                         EX_NOT:
  16F5'   21 1B19'              	LXI	H,SNOT
  16F8'   C3 1A96'              	JMP	EXERT
  16FB'                         EX_TF:
  16FB'   7E                    	MOV	A,M
  16FC'   32 222B'              	STA	EXOP
  16FF'   E1                    	POP	H
  1700'   FE 06                 	CPI	EO_S
  1702'   CA 1C61'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1705'   3A 2269'              	LDA	SRNGF
  1708'   B7                    	ORA	A
  1709'   C2 16F5'              	JNZ	EX_NOT		; a range on a command that does not take one
                                	;--- '!', then the file name ---
  170C'   7E                    	MOV	A,M
  170D'   D6 21                 	SUI	'!'
  170F'   32 223E'              	STA	EXBANG		; 0 = '!'
  1712'   C2 1716'              	JNZ	EX_NB
  1715'   23                    	INX	H
  1716'                         EX_NB:
  1716'   CD 1A55'              	CALL	SKIPB
  1719'   32 222C'              	STA	EXARG		; 0 = no file name
  171C'   CA 1735'              	JZ	EX_RUN
  171F'   22 222E'              	SHLD	EXCMD
  1722'   3A 222B'              	LDA	EXOP
  1725'   FE 02                 	CPI	EO_Q
  1727'   CA 1A93'              	JZ	EX_TRL		; :q takes none
  172A'   FE 07                 	CPI	EO_V
  172C'   CA 1A93'              	JZ	EX_TRL		; nor :ve
  172F'   CD 19BF'              	CALL	PARSFN
  1732'   C2 1A87'              	JNZ	EX_INV
  1735'                         EX_RUN:
  1735'   3A 222B'              	LDA	EXOP
  1738'   FE 05                 	CPI	EO_E
  173A'   CA 17D0'              	JZ	EX_E
  173D'   FE 02                 	CPI	EO_Q
  173F'   CA 17B9'              	JZ	EX_Q
  1742'   FE 07                 	CPI	EO_V
  1744'   CA 1A8D'              	JZ	EX_V
  1747'   FE 04                 	CPI	EO_X
  1749'   C2 1753'              	JNZ	EX_W
  174C'   3A 21D8'              	LDA	MODF		; :x writes only a changed text
  174F'   B7                    	ORA	A
  1750'   CA 17B9'              	JZ	EX_Q
  1753'                         EX_W:
  1753'   CD 1827'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1756'   D8                    	RC			; refused (message shown)
  1757'   32 222D'              	STA	EXBAK
  175A'   3A 222B'              	LDA	EXOP
  175D'   FE 01                 	CPI	EO_W
  175F'   CA 1776'              	JZ	EX_WK
  1762'   3A 222D'              	LDA	EXBAK
  1765'   B7                    	ORA	A
  1766'   C2 17B6'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1769'   3A 223E'              	LDA	EXBANG
  176C'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  176D'   CA 17B6'              	JZ	EX_WQ		; so it does with '!'
  1770'   CD 1776'              	CALL	EX_WK		; else it may not: keep the text
  1773'   C3 17B9'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1776'                         EX_WK:
  1776'   CD 0A99'              	CALL	CURRW		; the cursor's row and file position
  1779'   32 2230'              	STA	WPROW
  177C'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  177F'   7D                    	MOV	A,L
  1780'   E6 7F                 	ANI	7FH
  1782'   32 2231'              	STA	WPBYT
  1785'   7D                    	MOV	A,L
  1786'   17                    	RAL
  1787'   7C                    	MOV	A,H
  1788'   17                    	RAL
  1789'   5F                    	MOV	E,A
  178A'   3E 00                 	MVI	A,0
  178C'   17                    	RAL
  178D'   57                    	MOV	D,A		; DE = HL / 128
  178E'   2A 0000*              	LHLD	OUTPOS
  1791'   19                    	DAD	D
  1792'   22 2232'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1795'   CD 185C'              	CALL	WRITE
  1798'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  179B'   2A 2232'              	LHLD	WPREC
  179E'   EB                    	XCHG
  179F'   3A 2231'              	LDA	WPBYT
  17A2'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  17A5'   CD 0000*              	CALL	GOTO
  17A8'   21 0000               	LXI	H,0
  17AB'   22 0000*              	SHLD	LNDLT
  17AE'   3A 2230'              	LDA	WPROW
  17B1'   6F                    	MOV	L,A
  17B2'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  17B5'   C9                    	RET
  17B6'                         EX_WQ:
  17B6'   CD 185C'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  17B9'                         EX_Q:
  17B9'   3A 223E'              	LDA	EXBANG
  17BC'   B7                    	ORA	A
  17BD'   CA 17C7'              	JZ	EX_QT
  17C0'   3A 21D8'              	LDA	MODF
  17C3'   B7                    	ORA	A
  17C4'   C2 1A7B'              	JNZ	MSGNWR		; changed, no '!': stay
  17C7'                         EX_QT:
  17C7'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  17CA'   3E 01                 	MVI	A,1
  17CC'   32 21D7'              	STA	QUITF
  17CF'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  17D0'                         EX_E:
  17D0'   3A 223E'              	LDA	EXBANG
  17D3'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  17D4'   CA 17DE'              	JZ	EE_GO
  17D7'   3A 21D8'              	LDA	MODF
  17DA'   B7                    	ORA	A
  17DB'   C2 1A7B'              	JNZ	MSGNWR
  17DE'                         EE_GO:
  17DE'   3A 222C'              	LDA	EXARG
  17E1'   B7                    	ORA	A
  17E2'   C2 17E9'              	JNZ	EE_ARG
  17E5'   CD 1898'              	CALL	OWNTF		; no name: the buffer's own
  17E8'   D8                    	RC
  17E9'                         EE_ARG:
  17E9'   CD 18AE'              	CALL	ISOWN
  17EC'   21 0001               	LXI	H,1
  17EF'   C2 17F6'              	JNZ	EE_LD		; another file: its first line
  17F2'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  17F5'   23                    	INX	H		; HL = the cursor's line
  17F6'                         EE_LD:
  17F6'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  17F8'   32 223C'              	STA	MSGWHT
  17FB'   E5                    	PUSH	H
  17FC'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  17FF'   21 0000*              	LXI	H,TFCB
  1802'   11 0000*              	LXI	D,FNAME
  1805'   CD 18C0'              	CALL	COPY12		; the buffer's name
  1808'   CD 1885'              	CALL	SRCTF
  180B'   CD 0000*              	CALL	REOPEN
  180E'   CD 021C'              	CALL	MKCLR		; the marks named the buffer that just went
  1811'   AF                    	XRA	A
  1812'   32 21D8'              	STA	MODF
  1815'   E1                    	POP	H
  1816'   2B                    	DCX	H
  1817'   AF                    	XRA	A
  1818'   CD 0000*              	CALL	MVLIND		; down to the line
  181B'   CD 07B1'              	CALL	ATEOF
  181E'   DC 07B7'              	CC	LASTLN		; past the last line: onto it
  1821'   CD 0CB8'              	CALL	ZSAVE
  1824'   C3 0DA1'              	JMP	GP_MID
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  1827'                         WRCHK:
  1827'   3A 222C'              	LDA	EXARG
  182A'   B7                    	ORA	A
  182B'   C2 1835'              	JNZ	WC_ARG
  182E'   CD 1898'              	CALL	OWNTF
  1831'   D8                    	RC
  1832'   C3 184A'              	JMP	WC_OWN
  1835'                         WC_ARG:
  1835'   CD 18AE'              	CALL	ISOWN
  1838'   CA 184A'              	JZ	WC_OWN
  183B'   3A 223E'              	LDA	EXBANG
  183E'   B7                    	ORA	A
  183F'   CA 1848'              	JZ	WC_OTH
  1842'   CD 0000*              	CALL	TEXIST
  1845'   C2 1A6F'              	JNZ	MSGEXI		; File exists (! to force)
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  1848'                         WC_OTH:
  1848'   AF                    	XRA	A		; (NC)
  1849'   C9                    	RET
  184A'                         WC_OWN:
  184A'   3A 223F'              	LDA	ROFLAG		; '-R': this is the file it may not write
  184D'   B7                    	ORA	A
  184E'   CA 1858'              	JZ	WC_OK
  1851'   3A 223E'              	LDA	EXBANG
  1854'   B7                    	ORA	A
  1855'   C2 1A75'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  1858'                         WC_OK:
  1858'   3E 01                 	MVI	A,1
  185A'   B7                    	ORA	A		; (NC)
  185B'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  185C'                         WRITE:
  185C'   3A 222D'              	LDA	EXBAK
  185F'   CD 0000*              	CALL	WRTO
  1862'   3A 0001*              	LDA	FNAME+1
  1865'   FE 20                 	CPI	' '
  1867'   C2 1873'              	JNZ	WR_HAS
  186A'   21 0000*              	LXI	H,TFCB
  186D'   11 0000*              	LXI	D,FNAME
  1870'   CD 18C0'              	CALL	COPY12
  1873'                         WR_HAS:
  1873'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  1875'   32 223C'              	STA	MSGWHT
  1878'   CD 18AE'              	CALL	ISOWN
  187B'   C2 1885'              	JNZ	SRCTF
  187E'   AF                    	XRA	A
  187F'   32 21D8'              	STA	MODF
  1882'   32 223D'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  1885'                         SRCTF:
  1885'   21 0000*              	LXI	H,TFCB
  1888'   11 005C               	LXI	D,DFTFCB
  188B'   CD 18C0'              	CALL	COPY12
  188E'   AF                    	XRA	A
  188F'   06 04                 	MVI	B,4
  1891'                         SRC_Z:
  1891'   12                    	STAX	D		; extent, s1, s2, record count: 0
  1892'   13                    	INX	D
  1893'   05                    	DCR	B
  1894'   C2 1891'              	JNZ	SRC_Z
  1897'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  1898'                         OWNTF:
  1898'   3A 0001*              	LDA	FNAME+1
  189B'   FE 20                 	CPI	' '
  189D'   CA 1A69'              	JZ	MSGNFN
  18A0'   CD 18CB'              	CALL	TFCLR
  18A3'   21 0000*              	LXI	H,FNAME
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  18A6'   11 0000*              	LXI	D,TFCB
  18A9'   CD 18C0'              	CALL	COPY12
  18AC'   B7                    	ORA	A		; (NC)
  18AD'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  18AE'                         ISOWN:
  18AE'   21 0000*              	LXI	H,TFCB
  18B1'   11 0000*              	LXI	D,FNAME
  18B4'   06 0C                 	MVI	B,12
  18B6'                         IO_LP:
  18B6'   1A                    	LDAX	D
  18B7'   BE                    	CMP	M
  18B8'   C0                    	RNZ
  18B9'   23                    	INX	H
  18BA'   13                    	INX	D
  18BB'   05                    	DCR	B
  18BC'   C2 18B6'              	JNZ	IO_LP
  18BF'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  18C0'                         COPY12:
  18C0'   06 0C                 	MVI	B,12
  18C2'                         CP_LP:
  18C2'   7E                    	MOV	A,M
  18C3'   12                    	STAX	D
  18C4'   23                    	INX	H
  18C5'   13                    	INX	D
  18C6'   05                    	DCR	B
  18C7'   C2 18C2'              	JNZ	CP_LP
  18CA'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  18CB'                         TFCLR:
  18CB'   11 0000*              	LXI	D,TFCB
  18CE'   06 24                 	MVI	B,36
  18D0'   AF                    	XRA	A
  18D1'                         TC_LP:
  18D1'   12                    	STAX	D
  18D2'   13                    	INX	D
  18D3'   05                    	DCR	B
  18D4'   C2 18D1'              	JNZ	TC_LP
  18D7'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  18D8'                         FOPEN:
  18D8'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  18DA'   32 223C'              	STA	MSGWHT
  18DD'   21 005C               	LXI	H,DFTFCB
  18E0'   CD 19B2'              	CALL	NRMDRV
  18E3'   11 0000*              	LXI	D,FNAME
  18E6'   CD 18C0'              	CALL	COPY12
  18E9'   CD 0000*              	CALL	OPENZ
  18EC'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  18EF'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  18F1'   C8                    	RZ
  18F2'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  18F5'   32 223D'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  18F8'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  18F9'                         ARGSCN:
  18F9'   3A 0080               	LDA	CMDTAIL
  18FC'   47                    	MOV	B,A		; B = what is left of the line
  18FD'   B7                    	ORA	A
  18FE'   C8                    	RZ
  18FF'   21 0081               	LXI	H,CMDTAIL+1
  1902'                         AS_TOK:				; at a token, or the blanks before one
  1902'   7E                    	MOV	A,M
  1903'   FE 20                 	CPI	' '
  1905'   C2 190E'              	JNZ	AS_OPT
  1908'   23                    	INX	H
  1909'   05                    	DCR	B
  190A'   C2 1902'              	JNZ	AS_TOK
  190D'   C9                    	RET
  190E'                         AS_OPT:
  190E'   FE 2B                 	CPI	'+'
  1910'   CA 193A'              	JZ	AS_PLS
  1913'   FE 2D                 	CPI	'-'
  1915'   CA 1929'              	JZ	AS_SW
  1918'   FE 2F                 	CPI	'/'
  191A'   CA 1929'              	JZ	AS_SW
  191D'                         AS_SKP:				; not ours (the file name): on to the next one
  191D'   23                    	INX	H
  191E'   05                    	DCR	B
  191F'   C8                    	RZ
  1920'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  1921'   FE 20                 	CPI	' '
  1923'   C2 191D'              	JNZ	AS_SKP
  1926'   C3 1902'              	JMP	AS_TOK
  1929'                         AS_SW:
  1929'   23                    	INX	H
  192A'   05                    	DCR	B
  192B'   C8                    	RZ
  192C'   7E                    	MOV	A,M
  192D'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  192F'   FE 52                 	CPI	'R'
  1931'   C2 191D'              	JNZ	AS_SKP
  1934'   32 223F'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  1937'   C3 191D'              	JMP	AS_SKP
  193A'                         AS_PLS:
  193A'   3E 01                 	MVI	A,1
  193C'   32 2240'              	STA	PLUSF		; '+' gets the line even with no number on it
  193F'   11 0000*              	LXI	D,PLUSB
  1942'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  1944'   23                    	INX	H		;   line space, so it is taken as '+' alone
  1945'   05                    	DCR	B
  1946'   CA 197D'              	JZ	AS_PE
  1949'   7E                    	MOV	A,M
  194A'   FE 30                 	CPI	'0'
  194C'   C2 1964'              	JNZ	AS_PD
  194F'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  194F'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  1950'   05                    	DCR	B
  1951'   CA 1985'              	JZ	AS_P1
  1954'   7E                    	MOV	A,M
  1955'   FE 30                 	CPI	'0'
  1957'   CA 194F'              	JZ	AS_PZ
  195A'   FE 31                 	CPI	'1'
  195C'   DA 1985'              	JC	AS_P1		; zeros and then no digit at all: line 1
  195F'   FE 3A                 	CPI	'9'+1
  1961'   D2 1985'              	JNC	AS_P1
  1964'                         AS_PD:				; the digits, as typed
  1964'   7E                    	MOV	A,M
  1965'   FE 30                 	CPI	'0'
  1967'   DA 197D'              	JC	AS_PE
  196A'   FE 3A                 	CPI	'9'+1
  196C'   D2 197D'              	JNC	AS_PE
  196F'   79                    	MOV	A,C
  1970'   B7                    	ORA	A
  1971'   CA 198C'              	JZ	AS_POV
  1974'   0D                    	DCR	C
  1975'   7E                    	MOV	A,M
  1976'   12                    	STAX	D
  1977'   13                    	INX	D
  1978'   23                    	INX	H
  1979'   05                    	DCR	B
  197A'   C2 1964'              	JNZ	AS_PD
  197D'                         AS_PE:
  197D'   AF                    	XRA	A
  197E'   12                    	STAX	D		; the digits end with a 0
  197F'   78                    	MOV	A,B
  1980'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  1981'   C8                    	RZ
  1982'   C3 1902'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  1985'                         AS_P1:
  1985'   3E 31                 	MVI	A,'1'
  1987'   12                    	STAX	D
  1988'   13                    	INX	D
  1989'   C3 197D'              	JMP	AS_PE
  198C'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  198C'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  198F'   C3 197D'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  1992'                         ARGGO:
  1992'   3A 2240'              	LDA	PLUSF
  1995'   B7                    	ORA	A
  1996'   C8                    	RZ
  1997'   21 0000*              	LXI	H,PLUSB
  199A'                         AG_LP:
  199A'   7E                    	MOV	A,M
  199B'   B7                    	ORA	A
  199C'   CA 19AB'              	JZ	AG_G
  199F'   4F                    	MOV	C,A
  19A0'   06 02                 	MVI	B,KT_CHAR
  19A2'   E5                    	PUSH	H
  19A3'   CD 002D'              	CALL	VICMD
  19A6'   E1                    	POP	H
  19A7'   23                    	INX	H
  19A8'   C3 199A'              	JMP	AG_LP
  19AB'                         AG_G:
  19AB'   0E 47                 	MVI	C,'G'
  19AD'   06 02                 	MVI	B,KT_CHAR
  19AF'   C3 002D'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  19B2'                         NRMDRV:
  19B2'   7E                    	MOV	A,M
  19B3'   B7                    	ORA	A
  19B4'   C0                    	RNZ
  19B5'   E5                    	PUSH	H
  19B6'   0E 19                 	MVI	C,BF_CURDSK
  19B8'   CD 0005               	CALL	BDOS
  19BB'   E1                    	POP	H
  19BC'   3C                    	INR	A
  19BD'   77                    	MOV	M,A
  19BE'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  19BF'                         PARSFN:
  19BF'   CD 18CB'              	CALL	TFCLR
  19C2'   11 0000*              	LXI	D,TFCB
  19C5'   23                    	INX	H
  19C6'   7E                    	MOV	A,M
  19C7'   2B                    	DCX	H
  19C8'   FE 3A                 	CPI	':'
  19CA'   C2 19DC'              	JNZ	PF_NM
  19CD'   CD 1A22'              	CALL	GETFNC
  19D0'   CA 19DC'              	JZ	PF_NM
  19D3'   D6 40                 	SUI	40H
  19D5'   12                    	STAX	D
  19D6'   FE 11                 	CPI	17
  19D8'   D2 1A00'              	JNC	PF_BAD
  19DB'   23                    	INX	H
  19DC'                         PF_NM:
  19DC'   13                    	INX	D
  19DD'   0E 08                 	MVI	C,8
  19DF'   CD 1A04'              	CALL	CPYNAM
  19E2'   FE 2E                 	CPI	'.'
  19E4'   0E 03                 	MVI	C,3
  19E6'   C4 1A17'              	CNZ	PADFLD		; no type: blanks
  19E9'   CC 1A03'              	CZ	CPYNM0		; '.': the type
  19EC'   3A 0001*              	LDA	TFCB+1
  19EF'   FE 20                 	CPI	' '
  19F1'   CA 1A00'              	JZ	PF_BAD		; no name
  19F4'   CD 1A55'              	CALL	SKIPB
  19F7'   C0                    	RNZ			; more after it
  19F8'   21 0000*              	LXI	H,TFCB
  19FB'   CD 19B2'              	CALL	NRMDRV
  19FE'   AF                    	XRA	A
  19FF'   C9                    	RET
  1A00'                         PF_BAD:
  1A00'   F6 01                 	ORI	1
  1A02'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  1A03'                         CPYNM0:
  1A03'   23                    	INX	H
  1A04'                         CPYNAM:
  1A04'   CD 1A22'              	CALL	GETFNC
  1A07'   CA 1A17'              	JZ	PADFLD
  1A0A'   12                    	STAX	D
  1A0B'   13                    	INX	D
  1A0C'   0D                    	DCR	C
  1A0D'   C2 1A04'              	JNZ	CPYNAM
  1A10'                         CN_SKP:
  1A10'   CD 1A22'              	CALL	GETFNC
  1A13'   C2 1A10'              	JNZ	CN_SKP
  1A16'   C9                    	RET
  1A17'                         PADFLD:
  1A17'   F5                    	PUSH	PSW
  1A18'                         PD_LP:
  1A18'   3E 20                 	MVI	A,' '
  1A1A'   12                    	STAX	D
