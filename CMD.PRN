  0C57'   DA 0C63'              	JC	ES_CL
  0C5A'   CA 0C63'              	JZ	ES_CL
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0C5D'   2A 2665'              	LHLD	WKI
  0C60'   C3 055D'              	JMP	GOSET
  0C63'                         ES_CL:
  0C63'   2A 2667'              	LHLD	WKN
  0C66'   7C                    	MOV	A,H
  0C67'   B5                    	ORA	L
  0C68'   C8                    	RZ
  0C69'   2B                    	DCX	H
  0C6A'   C3 055D'              	JMP	GOSET
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0C6D'                         CURRW:
  0C6D'   2A 0000*              	LHLD	WINROW
  0C70'   EB                    	XCHG
  0C71'   2A 0000*              	LHLD	LNDLT
  0C74'   19                    	DAD	D		; HL = row (signed)
  0C75'   7C                    	MOV	A,H
  0C76'   B7                    	ORA	A
  0C77'   FA 0C8A'              	JM	CRW_0		; above the screen -> top row
  0C7A'   C2 0C85'              	JNZ	CRW_BT		; far below -> bottom row
  0C7D'   3A 0000*              	LDA	NEDIT
  0C80'   3D                    	DCR	A		; A = bottom row
  0C81'   BD                    	CMP	L		; CY iff bottom < row
  0C82'   D8                    	RC
  0C83'   7D                    	MOV	A,L
  0C84'   C9                    	RET
  0C85'                         CRW_BT:
  0C85'   3A 0000*              	LDA	NEDIT
  0C88'   3D                    	DCR	A
  0C89'   C9                    	RET
  0C8A'                         CRW_0:
  0C8A'   AF                    	XRA	A
  0C8B'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0C8C'                         SETRWT:
  0C8C'   2A 0000*              	LHLD	LNDLT
  0C8F'   EB                    	XCHG
  0C90'   6F                    	MOV	L,A
  0C91'   26 00                 	MVI	H,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C93'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0C96'   22 0000*              	SHLD	WINROW
  0C99'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0C9A'                         MVROW:
  0C9A'   47                    	MOV	B,A
  0C9B'   CD 0C6D'              	CALL	CURRW
  0C9E'   90                    	SUB	B		; A = row now - target
  0C9F'   C8                    	RZ
  0CA0'   DA 0CA9'              	JC	MR_DN
  0CA3'   6F                    	MOV	L,A
  0CA4'   26 00                 	MVI	H,0
  0CA6'   C3 08F4'              	JMP	KCORE
  0CA9'                         MR_DN:
  0CA9'   2F                    	CMA
  0CAA'   3C                    	INR	A		; A = target - row now
  0CAB'   6F                    	MOV	L,A
  0CAC'   26 00                 	MVI	H,0
  0CAE'   C3 0857'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0CB1'                         VC_HIGH:
  0CB1'   CD 065B'              	CALL	MOVCNT		; a cursor motion, and its count
  0CB4'   2B                    	DCX	H		; row = count - 1
  0CB5'   7C                    	MOV	A,H
  0CB6'   B7                    	ORA	A
  0CB7'   3A 0000*              	LDA	SCBOT
  0CBA'   C2 0CC2'              	JNZ	VH_GO		; >= 256 -> the last text row
  0CBD'   BD                    	CMP	L		; CY iff SCBOT < row
  0CBE'   DA 0CC2'              	JC	VH_GO
  0CC1'   7D                    	MOV	A,L
  0CC2'                         VH_GO:
  0CC2'   CD 0C9A'              	CALL	MVROW
  0CC5'   C3 07A9'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0CC8'                         VC_MIDL:
  0CC8'   CD 065B'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0CCB'   3A 0000*              	LDA	SCBOT
  0CCE'   B7                    	ORA	A		; clear CY for the shift
  0CCF'   1F                    	RAR			; A = SCBOT / 2
  0CD0'   CD 0C9A'              	CALL	MVROW
  0CD3'   C3 07A9'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0CD6'                         VC_LOWL:
  0CD6'   CD 065B'              	CALL	MOVCNT		; a cursor motion, and its count
  0CD9'   2B                    	DCX	H		; count - 1
  0CDA'   3A 0000*              	LDA	SCBOT
  0CDD'   5F                    	MOV	E,A
  0CDE'   16 00                 	MVI	D,0
  0CE0'   EB                    	XCHG			; HL = SCBOT, DE = count-1
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0CE1'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0CE4'   3E 00                 	MVI	A,0
  0CE6'   D2 0CED'              	JNC	VL_GO		; at or past the top -> row 0
  0CE9'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0CEC'   7D                    	MOV	A,L
  0CED'                         VL_GO:
  0CED'   CD 0C9A'              	CALL	MVROW
  0CF0'   C3 07A9'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0CF3'                         VC_PGDN:
  0CF3'   CD 065B'              	CALL	MOVCNT		; a cursor motion, and its count
  0CF6'   3A 0000*              	LDA	SCEOF
  0CF9'   B7                    	ORA	A
  0CFA'   CA 0D08'              	JZ	VPD_N
  0CFD'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0D00'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0D01'   C8                    	RZ			; it already is
  0D02'   CD 0C9A'              	CALL	MVROW
  0D05'   C3 0D19'              	JMP	VPD_TP
  0D08'                         VPD_N:
  0D08'   3A 0000*              	LDA	NEDIT
  0D0B'   D6 02                 	SUI	2
  0D0D'   CD 0D61'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0D10'   E5                    	PUSH	H
  0D11'   AF                    	XRA	A
  0D12'   CD 0C9A'              	CALL	MVROW		; the top line
  0D15'   E1                    	POP	H
  0D16'   CD 0857'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0D19'                         VPD_TP:
  0D19'   AF                    	XRA	A
  0D1A'   CD 0C8C'              	CALL	SETRWT		; to the top row
  0D1D'   C3 07A9'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0D20'                         VC_PGUP:
  0D20'   CD 065B'              	CALL	MOVCNT		; a cursor motion, and its count
  0D23'   3A 0000*              	LDA	SCBOF
  0D26'   B7                    	ORA	A
  0D27'   C0                    	RNZ
  0D28'   3A 0000*              	LDA	NEDIT
  0D2B'   47                    	MOV	B,A
  0D2C'   3A 0000*              	LDA	SCEOF
  0D2F'   B7                    	ORA	A
  0D30'   CA 0D41'              	JZ	VPU_2
  0D33'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0D36'   FE 02                 	CPI	2
  0D38'   D2 0D41'              	JNC	VPU_2
  0D3B'   2F                    	CMA
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D3C'   3C                    	INR	A
  0D3D'   80                    	ADD	B
  0D3E'   C3 0D44'              	JMP	VPU_P
  0D41'                         VPU_2:
  0D41'   78                    	MOV	A,B
  0D42'   D6 02                 	SUI	2
  0D44'                         VPU_P:
  0D44'   CD 0D61'              	CALL	MULSAT		; HL = count * page
  0D47'   E5                    	PUSH	H
  0D48'   AF                    	XRA	A
  0D49'   CD 0C9A'              	CALL	MVROW		; the top line
  0D4C'   E1                    	POP	H
  0D4D'   CD 08F4'              	CALL	KCORE		; the new top line
  0D50'   AF                    	XRA	A
  0D51'   CD 0C8C'              	CALL	SETRWT		; on the top row
  0D54'   3A 0000*              	LDA	NEDIT
  0D57'   3D                    	DCR	A
  0D58'   6F                    	MOV	L,A
  0D59'   26 00                 	MVI	H,0
  0D5B'   CD 0857'              	CALL	JCORE		; the bottom row's line
  0D5E'   C3 07A9'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0D61'                         MULSAT:
  0D61'   EB                    	XCHG
  0D62'   21 0000               	LXI	H,0
  0D65'   B7                    	ORA	A
  0D66'   C8                    	RZ
  0D67'                         MS_LP:
  0D67'   19                    	DAD	D
  0D68'   DA 0D70'              	JC	MS_SAT
  0D6B'   3D                    	DCR	A
  0D6C'   C2 0D67'              	JNZ	MS_LP
  0D6F'   C9                    	RET
  0D70'                         MS_SAT:
  0D70'   21 FFFF               	LXI	H,0FFFFH
  0D73'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0D74'                         VC_HFDN:
  0D74'   CD 06DB'              	CALL	SETMOV
  0D77'   CD 0C6D'              	CALL	CURRW
  0D7A'   32 262B'              	STA	HFROW
  0D7D'   CD 0DEB'              	CALL	HFCNT		; HL = lines
  0D80'   3A 262B'              	LDA	HFROW
  0D83'   47                    	MOV	B,A
  0D84'   3A 0000*              	LDA	SCEOF
  0D87'   B7                    	ORA	A
  0D88'   CA 0D90'              	JZ	VHD_GO
  0D8B'   3A 0000*              	LDA	SCBOT		; the last line's row
  0D8E'   B8                    	CMP	B
  0D8F'   C8                    	RZ			; the cursor is on it
  0D90'                         VHD_GO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D90'   CD 0857'              	CALL	JCORE
  0D93'   3A 0000*              	LDA	SCEOF
  0D96'   B7                    	ORA	A
  0D97'   C2 07A9'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0D9A'   3A 262B'              	LDA	HFROW
  0D9D'   CD 0C8C'              	CALL	SETRWT
  0DA0'   3E 01                 	MVI	A,1
  0DA2'   32 0000*              	STA	WFILL		; not past the end of the file
  0DA5'   C3 07A9'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0DA8'                         VC_HFUP:
  0DA8'   CD 06DB'              	CALL	SETMOV
  0DAB'   CD 0C6D'              	CALL	CURRW
  0DAE'   32 262B'              	STA	HFROW
  0DB1'   CD 0DEB'              	CALL	HFCNT		; HL = lines
  0DB4'   CD 0DCB'              	CALL	ONFST
  0DB7'   C8                    	RZ			; the cursor is on the first line
  0DB8'   CD 08F4'              	CALL	KCORE
  0DBB'   3A 0000*              	LDA	SCBOF
  0DBE'   B7                    	ORA	A
  0DBF'   C2 07A9'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0DC2'   3A 262B'              	LDA	HFROW
  0DC5'   CD 0C8C'              	CALL	SETRWT
  0DC8'   C3 07A9'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0DCB'                         ONFST:
  0DCB'   E5                    	PUSH	H
  0DCC'   2A 0000*              	LHLD	OUTPOS
  0DCF'   7C                    	MOV	A,H
  0DD0'   B5                    	ORA	L
  0DD1'   C2 0DE9'              	JNZ	OF_RET
  0DD4'   2A 0000*              	LHLD	TXTBEG
  0DD7'   EB                    	XCHG			; DE = TXTBEG
  0DD8'   2A 0000*              	LHLD	GAPBEG
  0DDB'                         OF_LP:
  0DDB'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0DDE'   CA 0DE9'              	JZ	OF_RET
  0DE1'   2B                    	DCX	H
  0DE2'   7E                    	MOV	A,M
  0DE3'   FE 0A                 	CPI	LF
  0DE5'   C2 0DDB'              	JNZ	OF_LP
  0DE8'   B7                    	ORA	A		; NZ
  0DE9'                         OF_RET:
  0DE9'   E1                    	POP	H
  0DEA'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0DEB'                         HFCNT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0DEB'   2A 261F'              	LHLD	CMDCNT
  0DEE'   7C                    	MOV	A,H
  0DEF'   B5                    	ORA	L
  0DF0'   CA 0E07'              	JZ	HFC_AM
  0DF3'   CD 066E'              	CALL	GETCNT		; HL = count; clears it
  0DF6'   3A 0000*              	LDA	NEDIT
  0DF9'   5F                    	MOV	E,A
  0DFA'   16 00                 	MVI	D,0
  0DFC'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0DFF'   D2 0E03'              	JNC	HFC_ST
  0E02'   EB                    	XCHG			; HL = NEDIT
  0E03'                         HFC_ST:
  0E03'   7D                    	MOV	A,L
  0E04'   32 262C'              	STA	HFAMT
  0E07'                         HFC_AM:
  0E07'   3A 262C'              	LDA	HFAMT
  0E0A'   B7                    	ORA	A
  0E0B'   C2 0E18'              	JNZ	HFC_HL
  0E0E'   3A 0000*              	LDA	NEDIT
  0E11'   B7                    	ORA	A
  0E12'   1F                    	RAR
  0E13'   B7                    	ORA	A
  0E14'   C2 0E18'              	JNZ	HFC_HL
  0E17'   3C                    	INR	A		; at least one line
  0E18'                         HFC_HL:
  0E18'   6F                    	MOV	L,A
  0E19'   26 00                 	MVI	H,0
  0E1B'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0E1C'                         VC_REDR:
  0E1C'   C3 066E'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0E1F'                         VC_G:
  0E1F'   CD 06DB'              	CALL	SETMOV
  0E22'   CD 0EBF'              	CALL	GZONE		; the screen's top line, before the move
  0E25'   2A 261F'              	LHLD	CMDCNT
  0E28'   7C                    	MOV	A,H
  0E29'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0E2A'   C2 0E37'              	JNZ	VG_N
  0E2D'   AF                    	XRA	A		; forward
  0E2E'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0E31'   CD 098B'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0E34'   C3 0ED7'              	JMP	GPLACE
  0E37'                         VG_N:
  0E37'   CD 066E'              	CALL	GETCNT		; HL = target line (1-based)
  0E3A'                         VG_LN:
  0E3A'   CD 0E40'              	CALL	GOLN
  0E3D'   C3 0ED7'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
  0E40'                         GOLN:
  0E40'   2B                    	DCX	H		; lines to move from line 1
  0E41'   E5                    	PUSH	H
  0E42'   3E FF                 	MVI	A,0FFH
  0E44'   CD 0000*              	CALL	MVLMAX		; to BOF
  0E47'   E1                    	POP	H
  0E48'   AF                    	XRA	A
  0E49'   CD 0000*              	CALL	MVLIND		; forward count-1 lines
  0E4C'   CD 0985'              	CALL	ATEOF
  0E4F'   DC 098B'              	CC	LASTLN		; past the last line: onto it
  0E52'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0E53'                         VC_LG:
  0E53'   CD 06DB'              	CALL	SETMOV
  0E56'   3A 2647'              	LDA	GSAVE
  0E59'   B7                    	ORA	A
  0E5A'   C2 0E63'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0E5D'   3E 01                 	MVI	A,PG
  0E5F'   32 2646'              	STA	GPEND
  0E62'   C9                    	RET
  0E63'                         VLG_GG:
  0E63'   CD 0EBF'              	CALL	GZONE
  0E66'   CD 066E'              	CALL	GETCNT		; HL = target line (no count: 1)
  0E69'   C3 0E3A'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0E6C'                         SUB24:
  0E6C'   4F                    	MOV	C,A
  0E6D'   7D                    	MOV	A,L
  0E6E'   93                    	SUB	E
  0E6F'   6F                    	MOV	L,A
  0E70'   7C                    	MOV	A,H
  0E71'   9A                    	SBB	D
  0E72'   67                    	MOV	H,A
  0E73'   79                    	MOV	A,C
  0E74'   98                    	SBB	B
  0E75'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0E76'                         CURFP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E76'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0E79'                         FPOS:
  0E79'   C5                    	PUSH	B
  0E7A'   D5                    	PUSH	D
  0E7B'   EB                    	XCHG
  0E7C'   2A 0000*              	LHLD	TXTBEG
  0E7F'   EB                    	XCHG
  0E80'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0E83'   EB                    	XCHG			; DE = that
  0E84'   2A 0000*              	LHLD	OUTPOS
  0E87'   7C                    	MOV	A,H
  0E88'   B7                    	ORA	A		; CY = 0
  0E89'   1F                    	RAR
  0E8A'   47                    	MOV	B,A
  0E8B'   7D                    	MOV	A,L
  0E8C'   1F                    	RAR
  0E8D'   67                    	MOV	H,A
  0E8E'   3E 00                 	MVI	A,0
  0E90'   1F                    	RAR
  0E91'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0E92'   19                    	DAD	D
  0E93'   78                    	MOV	A,B
  0E94'   CE 00                 	ACI	0		; A:HL = the position
  0E96'   D1                    	POP	D
  0E97'   C1                    	POP	B
  0E98'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0E99'                         ZSAVE:
  0E99'   2A 261F'              	LHLD	CMDCNT
  0E9C'   22 2685'              	SHLD	ZSVCNT
  0E9F'   2A 0000*              	LHLD	AUXCNT
  0EA2'   22 2687'              	SHLD	ZSVAUX
  0EA5'   3A 0000*              	LDA	DIRFLG
  0EA8'   32 2689'              	STA	ZSVDIR
  0EAB'   C9                    	RET
  0EAC'                         ZREST:
  0EAC'   2A 2685'              	LHLD	ZSVCNT
  0EAF'   22 261F'              	SHLD	CMDCNT
  0EB2'   2A 2687'              	LHLD	ZSVAUX
  0EB5'   22 0000*              	SHLD	AUXCNT
  0EB8'   3A 2689'              	LDA	ZSVDIR
  0EBB'   32 0000*              	STA	DIRFLG
  0EBE'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0EBF'                         GZONE:
  0EBF'   CD 0E99'              	CALL	ZSAVE
  0EC2'   CD 0C6D'              	CALL	CURRW
  0EC5'   6F                    	MOV	L,A
  0EC6'   26 00                 	MVI	H,0
  0EC8'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0ECB'   CD 0E79'              	CALL	FPOS
  0ECE'   22 0000*              	SHLD	ZTOP
  0ED1'   32 0002*              	STA	ZTOP+2
  0ED4'   C3 0EAC'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0ED7'                         GPLACE:
  0ED7'   CD 0E99'              	CALL	ZSAVE
  0EDA'   CD 0E76'              	CALL	CURFP
  0EDD'   EB                    	XCHG
  0EDE'   2A 0000*              	LHLD	ZTOP
  0EE1'   EB                    	XCHG
  0EE2'   4F                    	MOV	C,A		; C:HL = the target's position
  0EE3'   3A 0002*              	LDA	ZTOP+2
  0EE6'   47                    	MOV	B,A		; B:DE = the top's
  0EE7'   79                    	MOV	A,C
  0EE8'   CD 0E6C'              	CALL	SUB24
  0EEB'   22 2682'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  0EEE'   DA 0F3B'              	JC	GP_UP
  0EF1'   B7                    	ORA	A
  0EF2'   C2 0F7C'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0EF5'   3A 0000*              	LDA	NEDIT
  0EF8'   5F                    	MOV	E,A
  0EF9'   16 00                 	MVI	D,0
  0EFB'   B7                    	ORA	A
  0EFC'   1F                    	RAR
  0EFD'   6F                    	MOV	L,A
  0EFE'   26 00                 	MVI	H,0
  0F00'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0F01'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0F04'   CD 0667'              	CALL	GBSUB		; HL = bytes from there to the target
  0F07'   EB                    	XCHG
  0F08'   2A 2682'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0F0B'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0F0E'   DA 0F7C'              	JC	GP_MID
  0F11'   CD 0667'              	CALL	GBSUB		; HL = the top line's start (resident)
  0F14'   01 0000               	LXI	B,0		; BC = lines from the top
  0F17'                         GP_CNT:
  0F17'   7A                    	MOV	A,D
  0F18'   B3                    	ORA	E
  0F19'   CA 0F28'              	JZ	GP_DN
  0F1C'   7E                    	MOV	A,M
  0F1D'   23                    	INX	H
  0F1E'   1B                    	DCX	D
  0F1F'   FE 0A                 	CPI	LF
  0F21'   C2 0F17'              	JNZ	GP_CNT
  0F24'   03                    	INX	B
  0F25'   C3 0F17'              	JMP	GP_CNT
  0F28'                         GP_DN:
  0F28'   3A 0000*              	LDA	NEDIT
  0F2B'   3D                    	DCR	A
  0F2C'   5F                    	MOV	E,A
  0F2D'   16 00                 	MVI	D,0		; DE = the bottom row
  0F2F'   60                    	MOV	H,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0F30'   69                    	MOV	L,C
  0F31'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0F34'   DA 0F86'              	JC	GP_SET		; A = the bottom row
  0F37'   7D                    	MOV	A,L		; on the screen: its row
  0F38'   C3 0FA6'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0F3B'                         GP_UP:
  0F3B'   3C                    	INR	A
  0F3C'   C2 0F7C'              	JNZ	GP_MID		; 64K bytes or more above
  0F3F'   2A 2682'              	LHLD	ZDIF
  0F42'   EB                    	XCHG
  0F43'   21 0000               	LXI	H,0
  0F46'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0F49'   7C                    	MOV	A,H
  0F4A'   B5                    	ORA	L
  0F4B'   CA 0F7C'              	JZ	GP_MID		; exactly 64K
  0F4E'   EB                    	XCHG			; DE = bytes to read
  0F4F'   AF                    	XRA	A
  0F50'   32 2684'              	STA	ZLF
  0F53'   CD 0000*              	CALL	RGET0
  0F56'                         GP_RD:
  0F56'   CD 0000*              	CALL	RDGET		; (keeps DE)
  0F59'   DA 0F7C'              	JC	GP_MID
  0F5C'   FE 0A                 	CPI	LF
  0F5E'   C2 0F72'              	JNZ	GP_RN
  0F61'   3A 0000*              	LDA	NEDIT
  0F64'   B7                    	ORA	A
  0F65'   1F                    	RAR
  0F66'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  0F68'   E5                    	PUSH	H
  0F69'   21 2684'              	LXI	H,ZLF
  0F6C'   34                    	INR	M
  0F6D'   BE                    	CMP	M		; CY iff more lines than that
  0F6E'   E1                    	POP	H
  0F6F'   DA 0F7C'              	JC	GP_MID
  0F72'                         GP_RN:
  0F72'   1B                    	DCX	D
  0F73'   7A                    	MOV	A,D
  0F74'   B3                    	ORA	E
  0F75'   C2 0F56'              	JNZ	GP_RD
  0F78'   AF                    	XRA	A		; the top row
  0F79'   C3 0F86'              	JMP	GP_SET
  0F7C'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  0F7C'   3E 01                 	MVI	A,1
  0F7E'   32 0000*              	STA	WFILL		; not past the end of the file
  0F81'   3A 0000*              	LDA	NEDIT
  0F84'   B7                    	ORA	A
  0F85'   1F                    	RAR			; the middle row
  0F86'                         GP_SET:
  0F86'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  0F87'   26 00                 	MVI	H,0
  0F89'   22 0000*              	SHLD	WINROW
  0F8C'   21 0000               	LXI	H,0
  0F8F'   22 0000*              	SHLD	LNDLT
  0F92'   CD 06FC'              	CALL	SETFUL		; the window may have paged: full repaint
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F95'                         GP_FIN:
  0F95'   CD 0EAC'              	CALL	ZREST
  0F98'   3A 26AC'              	LDA	GPKEEP
  0F9B'   B7                    	ORA	A
  0F9C'   CA 07A9'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  0F9F'   AF                    	XRA	A
  0FA0'   32 26AC'              	STA	GPKEEP
  0FA3'   C3 0560'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  0FA6'                         GP_ONS:
  0FA6'   6F                    	MOV	L,A
  0FA7'   26 00                 	MVI	H,0		; HL = the row it lands on
  0FA9'   EB                    	XCHG
  0FAA'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  0FAD'   EB                    	XCHG
  0FAE'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  0FB1'   22 0000*              	SHLD	LNDLT
  0FB4'   3E 01                 	MVI	A,R_MOVE
  0FB6'   32 2623'              	STA	RINTENT
  0FB9'   C3 0F95'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  0FBC'                         OPPEND:
  0FBC'   AF                    	XRA	A
  0FBD'   32 264C'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  0FC0'   3A 2649'              	LDA	PSAVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0FC3'   FE 63                 	CPI	'c'
  0FC5'   C2 0FE2'              	JNZ	OPP_ND
  0FC8'   79                    	MOV	A,C
  0FC9'   FE 77                 	CPI	'w'
  0FCB'   CA 0FD3'              	JZ	OPP_W
  0FCE'   FE 57                 	CPI	'W'
  0FD0'   C2 0FE2'              	JNZ	OPP_ND
  0FD3'                         OPP_W:
  0FD3'   CD 11B5'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  0FD6'   DA 0FE2'              	JC	OPP_ND
  0FD9'   79                    	MOV	A,C
  0FDA'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  0FDC'   4F                    	MOV	C,A
  0FDD'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  0FDF'   32 264C'              	STA	CWEOL		;   see the clamp in OPA_F
  0FE2'                         OPP_ND:
  0FE2'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  0FE3'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  0FE5'   C2 0FF9'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  0FE8'   CD 0218'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  0FEB'   DA 1089'              	JC	OPABRT
  0FEE'   79                    	MOV	A,C
  0FEF'   FE 67                 	CPI	'g'
  0FF1'   C2 1089'              	JNZ	OPABRT
  0FF4'   3E 01                 	MVI	A,PG
  0FF6'   32 2647'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  0FF9'                         OPP_NG:
  0FF9'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  0FFA'   21 2649'              	LXI	H,PSAVE
  0FFD'   BE                    	CMP	M
  0FFE'   CA 11D6'              	JZ	OPLINE
  1001'   79                    	MOV	A,C		; (OPCLS classifies the key)
  1002'   CD 11E6'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1005'   DA 1089'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  1008'   32 264B'              	STA	OPCLSV
  100B'   47                    	MOV	B,A		; B = the class
  100C'   3A 2649'              	LDA	PSAVE
  100F'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  1011'   C2 101D'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  1014'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  1015'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  1017'   C2 103F'              	JNZ	OPP_GO
  101A'   C3 1028'              	JMP	OPP_NO
  101D'                         OPP_NC:
  101D'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  101F'   C2 103F'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  1022'   78                    	MOV	A,B		;   a charwise register would need a type flag
  1023'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  1025'   CA 103F'              	JZ	OPP_GO		;   within a line -- neither of which is built
  1028'                         OPP_NO:
  1028'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  1029'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  102B'   CA 1039'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  102E'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  1030'   CA 1039'              	JZ	OPP_SW		;   so swallow it before dropping the command
  1033'   CD 0348'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  1036'   C2 1089'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  1039'                         OPP_SW:
  1039'   CD 0218'              	CALL	MKGETK
  103C'   C3 1089'              	JMP	OPABRT
  103F'                         OPP_GO:
  103F'   AF                    	XRA	A
  1040'   32 262A'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  1043'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  1046'   22 264D'              	SHLD	OPSTA
  1049'   C5                    	PUSH	B
  104A'   21 2651'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  104D'   CD 0432'              	CALL	FPSTO		;   only good until the motion pages the window
  1050'   3A 264B'              	LDA	OPCLSV
  1053'   FE 02                 	CPI	2
  1055'   CC 108C'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  1058'   C1                    	POP	B
  1059'   21 254D'              	LXI	H,CMDTAB
  105C'   CD 00C5'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  105F'   3A 2649'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1062'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1063'   CA 06DB'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  1066'   CD 10B8'              	CALL	OPSFIX		; where the start is in the window NOW
  1069'   D2 10D4'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  106C'   22 264D'              	SHLD	OPSTA
  106F'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1072'   22 264F'              	SHLD	OPEND2
  1075'   3A 2649'              	LDA	PSAVE
  1078'   FE 79                 	CPI	'y'
  107A'   CA 1688'              	JZ	OPYANK		; a yank takes the span without losing it
  107D'   CD 1221'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  1080'   3A 2649'              	LDA	PSAVE
  1083'   FE 63                 	CPI	'c'
  1085'   C0                    	RNZ
  1086'   C3 144F'              	JMP	SETINS
  1089'                         OPABRT:
  1089'   C3 06DB'              	JMP	SETMOV		; not a motion -> operator cancelled, nothing drew
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  108C'                         OPENDS:
  108C'   2A 264D'              	LHLD	OPSTA
  108F'   CD 05C7'              	CALL	BOL
  1092'   11 2654'              	LXI	D,OPSLO
  1095'   CD 10AA'              	CALL	OPE_ST
  1098'   2A 264D'              	LHLD	OPSTA
  109B'   CD 05F7'              	CALL	NLSTART
  109E'   11 2657'              	LXI	D,OPSHI
  10A1'   CD 10AA'              	CALL	OPE_ST
  10A4'   2A 264D'              	LHLD	OPSTA
  10A7'   C3 0000*              	JMP	GOTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  10AA'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  10AA'   D5                    	PUSH	D
  10AB'   CD 0000*              	CALL	GOTO
  10AE'   E1                    	POP	H
  10AF'   C3 0432'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  10B2'                         CURBD:
  10B2'   CD 0E76'              	CALL	CURFP
  10B5'   EB                    	XCHG
  10B6'   47                    	MOV	B,A
  10B7'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  10B8'                         OPSFIX:
  10B8'   21 2651'              	LXI	H,OPSFP
  10BB'   CD 03E5'              	CALL	MKLOAD
  10BE'   CD 10B2'              	CALL	CURBD
  10C1'   2A 26B6'              	LHLD	MKPOS
  10C4'   3A 26B8'              	LDA	MKPOS+2
  10C7'   CD 0E6C'              	CALL	SUB24
  10CA'   B4                    	ORA	H
  10CB'   B5                    	ORA	L
  10CC'   C2 03F2'              	JNZ	MKWIN
  10CF'   CD 0000*              	CALL	CUROFF
  10D2'   37                    	STC
  10D3'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  10D4'                         OPPGD:
  10D4'   47                    	MOV	B,A
  10D5'   3A 264B'              	LDA	OPCLSV
  10D8'   FE 02                 	CPI	2
  10DA'   C2 1196'              	JNZ	OPG_NO
  10DD'   3A 2649'              	LDA	PSAVE
  10E0'   FE 64                 	CPI	'd'
  10E2'   C2 1196'              	JNZ	OPG_NO
  10E5'   04                    	INR	B
  10E6'   CA 10F5'              	JZ	OPG_FW
  10E9'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  10EC'   CD 05C7'              	CALL	BOL		;   and the high end is OPSHI as it stands
  10EF'   CD 0000*              	CALL	GOTO
  10F2'   C3 110D'              	JMP	OPG_GO
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  10F5'                         OPG_FW:
  10F5'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  10F8'   CD 05F7'              	CALL	NLSTART		;   landed on, and the low one is where the
  10FB'   11 2657'              	LXI	D,OPSHI		;   start line began
  10FE'   CD 10AA'              	CALL	OPE_ST
  1101'   21 2654'              	LXI	H,OPSLO
  1104'   CD 03E5'              	CALL	MKLOAD
  1107'   CD 03C2'              	CALL	MKPAGE
  110A'   CD 0000*              	CALL	GOTO
  110D'                         OPG_GO:
  110D'   CD 10B2'              	CALL	CURBD
  1110'   2A 2657'              	LHLD	OPSHI
  1113'   3A 2659'              	LDA	OPSHI+2
  1116'   CD 0E6C'              	CALL	SUB24		; A:HL = the bytes to take
  1119'                         OPG_SV:
  1119'   22 265A'              	SHLD	OPTOGO
  111C'   32 265C'              	STA	OPTOGO+2
  111F'                         OPG_NX:
  111F'   CD 064A'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  1122'   CD 0000*              	CALL	SUBHD
  1125'   EB                    	XCHG			; DE = what the window holds past the cursor
  1126'   2A 265A'              	LHLD	OPTOGO
  1129'   3A 265C'              	LDA	OPTOGO+2
  112C'   B7                    	ORA	A
  112D'   C2 1160'              	JNZ	OPG_PG		; 64K or more to go
  1130'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  1133'   DA 1160'              	JC	OPG_PG
  1136'   CA 1160'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  1139'                         OPG_FN:				; the rest of it is here
  1139'   E5                    	PUSH	H
  113A'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  113D'   CD 0000*              	CALL	CUROFF
  1140'   22 265D'              	SHLD	OPLO
  1143'   D1                    	POP	D
  1144'   19                    	DAD	D
  1145'   22 265F'              	SHLD	OPHI
  1148'   CD 12BF'              	CALL	OPDSPN
  114B'   CD 0985'              	CALL	ATEOF
  114E'   D2 11AF'              	JNC	OPMID
  1151'   CD 0DCB'              	CALL	ONFST		; deleted to the end of the file: onto the new
  1154'   CA 11AF'              	JZ	OPMID		;   last line, if there is one -- and the pager
  1157'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  115A'   CD 0000*              	CALL	SETBWD
  115D'   C3 11AF'              	JMP	OPMID
  1160'                         OPG_PG:
  1160'   7A                    	MOV	A,D
  1161'   B3                    	ORA	E
  1162'   C2 117B'              	JNZ	OPG_DL
  1165'   CD 0985'              	CALL	ATEOF		; nothing held past the cursor
  1168'   21 0000               	LXI	H,0
  116B'   DA 1139'              	JC	OPG_FN		; ... and no more to come: the file ran out
  116E'   2B                    	DCX	H
  116F'   CD 0000*              	CALL	SETC0
  1172'   CD 0000*              	CALL	GOLINE
  1175'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  1178'   C3 111F'              	JMP	OPG_NX
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  117B'                         OPG_DL:
  117B'   D5                    	PUSH	D
  117C'   21 FFFF               	LXI	H,0FFFFH
  117F'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1182'   E1                    	POP	H
  1183'   E5                    	PUSH	H
  1184'   CD 0000*              	CALL	DELFWD
  1187'   D1                    	POP	D
  1188'   06 00                 	MVI	B,0
  118A'   2A 265A'              	LHLD	OPTOGO
  118D'   3A 265C'              	LDA	OPTOGO+2
  1190'   CD 0E6C'              	CALL	SUB24
  1193'   C3 1119'              	JMP	OPG_SV
  1196'                         OPG_NO:
  1196'   21 2651'              	LXI	H,OPSFP
  1199'   CD 03E5'              	CALL	MKLOAD
  119C'   CD 03C2'              	CALL	MKPAGE
  119F'   CD 0000*              	CALL	GOTO
  11A2'   AF                    	XRA	A
  11A3'   32 2649'              	STA	PSAVE
  11A6'   3C                    	INR	A
  11A7'   32 26AC'              	STA	GPKEEP		; the column it had, not the first non-blank
  11AA'   0E 07                 	MVI	C,BEL
  11AC'   CD 0000*              	CALL	BCONOU
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  11AF'                         OPMID:
  11AF'   CD 0E99'              	CALL	ZSAVE
  11B2'   C3 0F7C'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  11B5'                         ONWHIT:
  11B5'   CD 064A'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  11B8'   CA 11D4'              	JZ	OW_YES
  11BB'   CD 0655'              	CALL	CURCHR		; A = the char under the cursor
  11BE'   FE 20                 	CPI	' '
  11C0'   CA 11D4'              	JZ	OW_YES
  11C3'   FE 09                 	CPI	TAB
  11C5'   CA 11D4'              	JZ	OW_YES
  11C8'   FE 0D                 	CPI	CR
  11CA'   CA 11D4'              	JZ	OW_YES
  11CD'   FE 0A                 	CPI	LF
  11CF'   CA 11D4'              	JZ	OW_YES
  11D2'   B7                    	ORA	A		; a char to change: CY clear
  11D3'   C9                    	RET
  11D4'                         OW_YES:
  11D4'   37                    	STC
  11D5'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  11D6'                         OPLINE:
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  11D6'   3A 2649'              	LDA	PSAVE
  11D9'   FE 63                 	CPI	'c'
  11DB'   CA 06DB'              	JZ	SETMOV
  11DE'   FE 79                 	CPI	'y'
  11E0'   CA 166D'              	JZ	VY_YY
  11E3'   C3 15F2'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  11E6'                         OPCLS:
  11E6'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  11E8'   CA 11F5'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  11EB'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  11ED'   C2 1209'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  11F0'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  11F2'   C3 11F7'              	JMP	OPC_FK
  11F5'                         OPC_SEM:
  11F5'   06 00                 	MVI	B,0		; ';' runs it as it stands
  11F7'                         OPC_FK:
  11F7'   3A 26A2'              	LDA	FNDKND
  11FA'   B7                    	ORA	A
  11FB'   37                    	STC
  11FC'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  11FD'   A8                    	XRA	B		; ... and now the direction ',' asked for
  11FE'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1200'   CA 1207'              	JZ	OPC_EXC
  1203'   3E 01                 	MVI	A,1
  1205'   B7                    	ORA	A		; CY clear: a motion, class 1
  1206'   C9                    	RET
  1207'                         OPC_EXC:
  1207'   AF                    	XRA	A		; class 0, CY clear
  1208'   C9                    	RET
  1209'                         OPC_TB:
  1209'   47                    	MOV	B,A
  120A'   21 1343'              	LXI	H,OPCTAB
  120D'                         OPC_LP:
  120D'   7E                    	MOV	A,M
  120E'   B7                    	ORA	A
  120F'   CA 121F'              	JZ	OPC_MS		; end of table -> not a motion
  1212'   B8                    	CMP	B
  1213'   CA 121B'              	JZ	OPC_HT
  1216'   23                    	INX	H
  1217'   23                    	INX	H
  1218'   C3 120D'              	JMP	OPC_LP
  121B'                         OPC_HT:
  121B'   23                    	INX	H
  121C'   7E                    	MOV	A,M		; class byte
  121D'   B7                    	ORA	A		; clear CY
  121E'   C9                    	RET
  121F'                         OPC_MS:
  121F'   37                    	STC
  1220'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  1221'                         OPAPPL:
  1221'   3A 264B'              	LDA	OPCLSV
  1224'   FE 02                 	CPI	2
  1226'   CA 1327'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  1229'   2A 264D'              	LHLD	OPSTA
  122C'   EB                    	XCHG			; DE = start
  122D'   2A 264F'              	LHLD	OPEND2		; HL = end
  1230'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  1233'   DA 1243'              	JC	OPA_F
  1236'   CA 1243'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  1239'   22 265D'              	SHLD	OPLO
  123C'   EB                    	XCHG
  123D'   22 265F'              	SHLD	OPHI
  1240'   C3 129B'              	JMP	OPA_DO
  1243'                         OPA_F:
  1243'   EB                    	XCHG			; HL = start, DE = end
  1244'   22 265D'              	SHLD	OPLO
  1247'   EB                    	XCHG			; HL = end
  1248'   3A 264B'              	LDA	OPCLSV
  124B'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  124D'   CA 1298'              	JZ	OPA_HI		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  1250'   FE 01                 	CPI	1
  1252'   C2 1274'              	JNZ	OPA_EX
  1255'   23                    	INX	H		; inclusive endpoint -> hi = end+1
                                	;--- 'cw' stops at the line's content end, where a plain 'ce' (and 'de')
                                	;    runs on into the next line's word and 'd%' crosses to its mate --
                                	;    all four recorded from vim 9.1.  vim's 'cw' is not simply 'ce': the
                                	;    rewrite keeps 'w's own end-of-line stop, so the clamp hangs off
                                	;    CWEOL (the rewrite) and not off the inclusive class. ---
  1256'   3A 264C'              	LDA	CWEOL
  1259'   B7                    	ORA	A
  125A'   CA 1298'              	JZ	OPA_HI
  125D'   22 265F'              	SHLD	OPHI		; park the motion's own end: CEND clobbers DE
  1260'   2A 265D'              	LHLD	OPLO
  1263'   CD 13CD'              	CALL	CEND		; HL = the start line's content end
  1266'   EB                    	XCHG			; DE = that content end
  1267'   2A 265F'              	LHLD	OPHI		; HL = hi
  126A'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  126D'   D2 1298'              	JNC	OPA_HI		; hi is inside the line: keep it
  1270'   EB                    	XCHG			; HL = the content end: 'cw' stops there
  1271'   C3 1298'              	JMP	OPA_HI
  1274'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  1274'   22 265F'              	SHLD	OPHI		; the motion's own end, for now
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1277'   2A 265D'              	LHLD	OPLO
  127A'   CD 13CD'              	CALL	CEND		; HL = the start line's content end
  127D'   EB                    	XCHG			; DE = that content end
  127E'   3A 262A'              	LDA	WPULL		; the motion landed on a line's end and was
  1281'   B7                    	ORA	A		;   pulled back onto its last char (the command
  1282'   C2 128E'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  1285'   2A 265F'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  1288'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  128B'   D2 129B'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  128E'                         OPA_CE:				;   deletes the word, not all but its last char
  128E'   2A 265D'              	LHLD	OPLO
  1291'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1294'   CA 12D9'              	JZ	OPA_LN
  1297'   EB                    	XCHG			; HL = the content end
  1298'                         OPA_HI:
  1298'   22 265F'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  129B'                         OPA_DO:
  129B'   CD 12BF'              	CALL	OPDSPN
  129E'   3A 2649'              	LDA	PSAVE
  12A1'   FE 63                 	CPI	'c'
  12A3'   C8                    	RZ
  12A4'   C3 13DE'              	JMP	CLAMPE
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  12A7'                         SPNBRK:
  12A7'   2A 265D'              	LHLD	OPLO
  12AA'   CD 05DA'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  12AD'   EB                    	XCHG			; DE = it
  12AE'   2A 265F'              	LHLD	OPHI
  12B1'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  12B4'                         OPSPNL:
  12B4'   2A 265F'              	LHLD	OPHI
  12B7'   EB                    	XCHG
  12B8'   2A 265D'              	LHLD	OPLO
  12BB'   EB                    	XCHG			; HL = hi, DE = lo
  12BC'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  12BF'                         OPDSPN:
  12BF'   CD 12A7'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  12C2'   F5                    	PUSH	PSW
  12C3'   2A 265D'              	LHLD	OPLO
  12C6'   CD 0000*              	CALL	GOTO
  12C9'   CD 12B4'              	CALL	OPSPNL		; HL = hi - lo
  12CC'   CD 0000*              	CALL	DELFWD
  12CF'   CD 0188'              	CALL	MARKMOD
  12D2'   F1                    	POP	PSW
  12D3'   DA 06FC'              	JC	SETFUL		; a break went: every row below it moved up
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  12D6'   C3 06E1'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  12D9'                         OPA_LN:
  12D9'   3A 2649'              	LDA	PSAVE
  12DC'   FE 63                 	CPI	'c'
  12DE'   C2 12E7'              	JNZ	OPA_LD
  12E1'   2A 265D'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  12E4'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  12E7'                         OPA_LD:
  12E7'   2A 265D'              	LHLD	OPLO
  12EA'   22 264D'              	SHLD	OPSTA
  12ED'   22 264F'              	SHLD	OPEND2
  12F0'   C3 1327'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  12F3'                         OPALSP:
  12F3'   2A 264D'              	LHLD	OPSTA
  12F6'   EB                    	XCHG
  12F7'   2A 264F'              	LHLD	OPEND2
  12FA'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  12FD'   DA 130A'              	JC	OPAL_F
  1300'   22 265D'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1303'   EB                    	XCHG
  1304'   22 265F'              	SHLD	OPHI		; hi-src = start
  1307'   C3 1314'              	JMP	OPAL_R
  130A'                         OPAL_F:
  130A'   EB                    	XCHG			; HL = start
  130B'   22 265D'              	SHLD	OPLO		; lo-src = start
  130E'   2A 264F'              	LHLD	OPEND2
  1311'   22 265F'              	SHLD	OPHI		; hi-src = end
  1314'                         OPAL_R:
  1314'   2A 265D'              	LHLD	OPLO
  1317'   CD 05C7'              	CALL	BOL
  131A'   22 265D'              	SHLD	OPLO		; lo = BOL(low line)
  131D'   2A 265F'              	LHLD	OPHI
  1320'   CD 05F7'              	CALL	NLSTART
  1323'   22 265F'              	SHLD	OPHI		; hi = start of line past the high line
  1326'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  1327'                         OPALIN:
  1327'   CD 12F3'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  132A'                         OPDLIN:
  132A'   CD 12BF'              	CALL	OPDSPN
  132D'   CD 064A'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1330'   DA 1340'              	JC	OPDL_NB
  1333'   CD 0000*              	CALL	LOGLEN
  1336'   7C                    	MOV	A,H
  1337'   B5                    	ORA	L
  1338'   C8                    	RZ			; empty buffer
  1339'   2B                    	DCX	H
  133A'   CD 05C7'              	CALL	BOL
  133D'   CD 0000*              	CALL	GOTO
  1340'                         OPDL_NB:
  1340'   C3 07A9'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1343'                         OPCTAB:
  1343'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1347'   62 00 42 00           
  134B'   68 00 6C 00           
  134F'   30 00 5E 00           
  1353'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1355'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1359'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  135D'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1361'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1365'   24 01                 
  1367'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  136B'   47 02 48 02           
  136F'   4D 02 4C 02           
  1373'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  1375'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1377'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1378'                         VCB_C:
  1378'   CD 1384'              	CALL	VCB_CD
  137B'   C3 144F'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  137E'                         VCB_D:
  137E'   CD 1384'              	CALL	VCB_CD
  1381'   C3 13DE'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  1384'                         VCB_CD:
  1384'   CD 0661'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1387'   22 265D'              	SHLD	OPLO
  138A'   CD 0000*              	CALL	CUROFF
  138D'   CD 13CD'              	CALL	CEND		; to the line's content end, the CR,LF left
  1390'   22 265F'              	SHLD	OPHI
  1393'   C3 12BF'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  1396'                         VC_X:
  1396'   CD 084E'              	CALL	GLSTAL
  1399'   CD 06E1'              	CALL	SETLIN
  139C'   CD 066E'              	CALL	GETCNT
  139F'   22 2661'              	SHLD	CNTV
  13A2'   CD 0000*              	CALL	CUROFF
  13A5'   22 2665'              	SHLD	WKI		; cur
  13A8'   CD 13CD'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  13AB'   EB                    	XCHG			; DE = contentend
  13AC'   2A 2665'              	LHLD	WKI		; HL = cur
  13AF'   EB                    	XCHG			; HL = contentend, DE = cur
  13B0'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  13B3'   7C                    	MOV	A,H
  13B4'   B5                    	ORA	L
  13B5'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  13B6'   EB                    	XCHG			; DE = available
  13B7'   2A 2661'              	LHLD	CNTV		; HL = count
  13BA'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  13BD'   DA 13C3'              	JC	VX_USEA
  13C0'   C3 13C4'              	JMP	VX_DEL		; count <= available -> HL = count = del
  13C3'                         VX_USEA:
  13C3'   EB                    	XCHG			; HL = available
  13C4'                         VX_DEL:
  13C4'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  13C7'   CD 0188'              	CALL	MARKMOD
  13CA'   C3 13DE'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  13CD'                         CEND:
  13CD'   CD 05DA'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  13D0'   7C                    	MOV	A,H
  13D1'   B5                    	ORA	L
  13D2'   C8                    	RZ			; the start of the text: nothing before it
  13D3'   2B                    	DCX	H
  13D4'   E5                    	PUSH	H
  13D5'   CD 0000*              	CALL	CHARAT
  13D8'   E1                    	POP	H		; HL = term-1
  13D9'   FE 0D                 	CPI	CR
  13DB'   C8                    	RZ			; a CR before the LF -> the content ends there
  13DC'   23                    	INX	H
  13DD'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  13DE'                         CLAMPE:
  13DE'   CD 0000*              	CALL	CUROFF
  13E1'   E5                    	PUSH	H
  13E2'   CD 0606'              	CALL	EOLC
  13E5'   D1                    	POP	D		; DE = cur
  13E6'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  13E9'   D8                    	RC
  13EA'   C8                    	RZ
  13EB'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  13EE'                         VC_I:
  13EE'   CD 066E'              	CALL	GETCNT
  13F1'   C3 144C'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  13F4'                         VC_A:
  13F4'   CD 066E'              	CALL	GETCNT
  13F7'   CD 064A'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  13FA'   CA 1411'              	JZ	VA_INS
  13FD'   EB                    	XCHG			; HL = cur
  13FE'   E5                    	PUSH	H
  13FF'   CD 0000*              	CALL	CHARAT
  1402'   E1                    	POP	H
  1403'   FE 0A                 	CPI	LF
  1405'   CA 1411'              	JZ	VA_INS		; on the line terminator -> append in place
  1408'   FE 0D                 	CPI	CR
  140A'   CA 1411'              	JZ	VA_INS
  140D'   23                    	INX	H
  140E'   CD 0000*              	CALL	GOTO
  1411'                         VA_INS:
  1411'   C3 144C'              	JMP	SETINM
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1414'                         VCB_A:
  1414'   CD 0661'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1417'   CD 0606'              	CALL	EOLC		; HL = last content char (the start when empty)
  141A'   E5                    	PUSH	H
  141B'   CD 0000*              	CALL	CHARAT
  141E'   E1                    	POP	H
  141F'   FE 0D                 	CPI	CR
  1421'   CA 142A'              	JZ	VBA_IN		; an empty line: insert at its start
  1424'   FE 0A                 	CPI	LF
  1426'   CA 142A'              	JZ	VBA_IN
  1429'   23                    	INX	H		; past the last content char
  142A'                         VBA_IN:
  142A'   CD 0000*              	CALL	GOTO
  142D'   C3 144C'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1430'                         VCB_I:
  1430'   CD 066E'              	CALL	GETCNT
  1433'   CD 07A9'              	CALL	FNBLNK
  1436'   CD 0000*              	CALL	CUROFF
  1439'   E5                    	PUSH	H
  143A'   CD 0000*              	CALL	CHARAT
  143D'   E1                    	POP	H
  143E'   FE 20                 	CPI	' '
  1440'   CA 1448'              	JZ	VBI_SK
  1443'   FE 09                 	CPI	TAB
  1445'   C2 144C'              	JNZ	SETINM
  1448'                         VBI_SK:
  1448'   23                    	INX	H		; blanks only: past the last of them
  1449'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  144C'                         SETINM:
  144C'   CD 06DB'              	CALL	SETMOV
  144F'                         SETINS:
  144F'   3E 01                 	MVI	A,EM_INS
  1451'   32 261E'              	STA	EDMODE
  1454'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1455'                         ATCEND:
  1455'   CD 064A'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1458'   C8                    	RZ
  1459'   CD 0655'              	CALL	CURCHR		; A = the char under the cursor
  145C'   FE 0D                 	CPI	CR
  145E'   C8                    	RZ
  145F'   FE 0A                 	CPI	LF
  1461'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1462'                         OPNBRK:
  1462'   3E 0D                 	MVI	A,CR
  1464'   CD 0000*              	CALL	PUTGAP
  1467'   3E 0A                 	MVI	A,LF
  1469'   CD 0000*              	CALL	PUTGAP
  146C'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  146F'   23                    	INX	H
  1470'   22 0000*              	SHLD	LNDLT
  1473'   C3 0188'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1476'                         ENDBRK:
  1476'   CD 064A'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1479'   C0                    	RNZ
  147A'   CD 1462'              	CALL	OPNBRK
  147D'   CD 0000*              	CALL	CUROFF
  1480'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1481'   2B                    	DCX	H		;   line, with its own terminator after it
  1482'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1485'                         VC_O:
  1485'   CD 0661'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1488'   CD 13CD'              	CALL	CEND
  148B'   CD 0000*              	CALL	GOTO
  148E'   CD 1462'              	CALL	OPNBRK
  1491'   CD 1476'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1494'   CD 06E7'              	CALL	SETILN		;   needs a terminator of its own to exist
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  1497'   C3 144F'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  149A'                         VCB_O:
  149A'   CD 0661'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  149D'   CD 05C7'              	CALL	BOL
  14A0'   CD 0000*              	CALL	GOTO
  14A3'   CD 1462'              	CALL	OPNBRK
  14A6'   CD 0000*              	CALL	CUROFF
  14A9'   2B                    	DCX	H
  14AA'   2B                    	DCX	H
  14AB'   CD 0000*              	CALL	GOTO
  14AE'   CD 06E7'              	CALL	SETILN
  14B1'   C3 144F'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  14B4'                         VCB_J:
  14B4'   CD 0661'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  14B7'   CD 13CD'              	CALL	CEND		; the join point: this line's content end
  14BA'   22 265D'              	SHLD	OPLO
  14BD'   CD 0000*              	CALL	CUROFF
  14C0'   CD 05F7'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  14C3'   E5                    	PUSH	H
  14C4'   CD 0000*              	CALL	LOGLEN
  14C7'   D1                    	POP	D		; DE = that start
  14C8'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  14CB'   CA 06DB'              	JZ	SETMOV
  14CE'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  14CF'                         VJ_WS:
  14CF'   E5                    	PUSH	H
  14D0'   CD 0000*              	CALL	LOGLEN
  14D3'   D1                    	POP	D		; DE = the scan
  14D4'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  14D7'   CA 14EE'              	JZ	VJ_DEL
  14DA'   EB                    	XCHG			; HL = the scan
  14DB'   E5                    	PUSH	H
  14DC'   CD 0000*              	CALL	CHARAT
  14DF'   E1                    	POP	H
  14E0'   FE 20                 	CPI	' '
  14E2'   CA 14EA'              	JZ	VJ_SKIP
  14E5'   FE 09                 	CPI	TAB
  14E7'   C2 14EE'              	JNZ	VJ_DEL
  14EA'                         VJ_SKIP:
  14EA'   23                    	INX	H
  14EB'   C3 14CF'              	JMP	VJ_WS
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  14EE'                         VJ_DEL:
  14EE'   22 265F'              	SHLD	OPHI
  14F1'   CD 12BF'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  14F4'   CD 06F6'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  14F7'   CD 064A'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  14FA'   CA 13DE'              	JZ	CLAMPE
  14FD'   CD 0655'              	CALL	CURCHR		; the first char of what was appended
  1500'   FE 0D                 	CPI	CR
  1502'   CA 13DE'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1505'   FE 0A                 	CPI	LF
  1507'   CA 13DE'              	JZ	CLAMPE
  150A'   FE 29                 	CPI	')'
  150C'   CA 13DE'              	JZ	CLAMPE		; vim puts no space before a ')'
  150F'   CD 0000*              	CALL	CUROFF
  1512'   7C                    	MOV	A,H
  1513'   B5                    	ORA	L
  1514'   CA 152A'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1517'   2B                    	DCX	H
  1518'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  151B'   FE 20                 	CPI	' '
  151D'   CA 13DE'              	JZ	CLAMPE
  1520'   FE 09                 	CPI	TAB
  1522'   CA 13DE'              	JZ	CLAMPE
  1525'   FE 0A                 	CPI	LF
  1527'   CA 13DE'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  152A'                         VJ_SP:
  152A'   3E 20                 	MVI	A,' '
  152C'   CD 0000*              	CALL	PUTGAP
  152F'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1532'   2B                    	DCX	H
  1533'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1536'                         VC_TILD:
  1536'   CD 066E'              	CALL	GETCNT
  1539'   CD 06E1'              	CALL	SETLIN		; only this row changes
  153C'   CD 084E'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  153F'   CD 064A'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1542'   CA 06DB'              	JZ	SETMOV
  1545'   CD 0655'              	CALL	CURCHR		; A = the char under the cursor
  1548'   FE 0D                 	CPI	CR
  154A'   CA 06DB'              	JZ	SETMOV		; the line's end: nothing to toggle
  154D'   FE 0A                 	CPI	LF
  154F'   CA 06DB'              	JZ	SETMOV
  1552'   47                    	MOV	B,A
  1553'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1555'   FE 41                 	CPI	'A'
  1557'   DA 1563'              	JC	VT_PUT		; below 'A': no case
  155A'   FE 5B                 	CPI	'Z'+1
  155C'   D2 1563'              	JNC	VT_PUT		; above 'Z': no case
  155F'   78                    	MOV	A,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  1560'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1562'   47                    	MOV	B,A
  1563'                         VT_PUT:
  1563'   78                    	MOV	A,B
  1564'   32 266E'              	STA	VRCH		; the calls below do not preserve B
  1567'   CD 0188'              	CALL	MARKMOD
  156A'   21 0001               	LXI	H,1
  156D'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1570'   3A 266E'              	LDA	VRCH
  1573'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1576'   C3 13DE'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  1579'                         VC_R:
  1579'   CD 065B'              	CALL	MOVCNT		; a cursor motion, and its count
  157C'   3E 03                 	MVI	A,PR
  157E'   32 2646'              	STA	GPEND
  1581'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1582'                         VR_DO:
  1582'   AF                    	XRA	A
  1583'   32 2646'              	STA	GPEND
  1586'   79                    	MOV	A,C
  1587'   32 266E'              	STA	VRCH		; the calls below do not preserve C
  158A'   CD 06E1'              	CALL	SETLIN		; only this row changed
  158D'   CD 084E'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1590'   CD 064A'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1593'   CA 06DB'              	JZ	SETMOV		; the end of the text: vim does nothing
  1596'   CD 0655'              	CALL	CURCHR		; A = the char under the cursor
  1599'   FE 0D                 	CPI	CR
  159B'   CA 06DB'              	JZ	SETMOV		; the line's end: nothing to replace
  159E'   FE 0A                 	CPI	LF
  15A0'   CA 06DB'              	JZ	SETMOV
  15A3'   CD 0188'              	CALL	MARKMOD
  15A6'   21 0001               	LXI	H,1
  15A9'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  15AC'   3A 266E'              	LDA	VRCH
  15AF'   FE 0D                 	CPI	CR
  15B1'   CA 15BE'              	JZ	VR_CR
  15B4'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  15B7'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  15BA'   2B                    	DCX	H		;   out, which moves every logical offset
  15BB'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  15BE'                         VR_CR:
  15BE'   CD 1462'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  15C1'   CD 1476'              	CALL	ENDBRK		;   replaced char may have been the text's last
  15C4'   CD 06E7'              	CALL	SETILN		;   row above it lost the char that was replaced,
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  15C7'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  15C9'   32 2626'              	STA	ILABOV
  15CC'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  15CD'                         VCB_R:
  15CD'   CD 066E'              	CALL	GETCNT
  15D0'   CD 06DB'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  15D3'   21 0000               	LXI	H,0
  15D6'   22 266F'              	SHLD	RPDEL		; nothing of ours to put back yet
  15D9'   22 2671'              	SHLD	RPAPP
  15DC'   3E 02                 	MVI	A,EM_REP
  15DE'   32 261E'              	STA	EDMODE
  15E1'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  15E2'                         VC_D:
  15E2'   3E 64                 	MVI	A,'d'
  15E4'   32 2648'              	STA	PENDOP
  15E7'   C3 06DB'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  15EA'                         VC_C:
  15EA'   3E 63                 	MVI	A,'c'
  15EC'   32 2648'              	STA	PENDOP
  15EF'   C3 06DB'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  15F2'                         VD_DD:
  15F2'   CD 084E'              	CALL	GLSTAL
  15F5'   CD 066E'              	CALL	GETCNT
  15F8'   22 2661'              	SHLD	CNTV
  15FB'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  15FD'   32 264A'              	STA	DDSNG
  1600'   2B                    	DCX	H
  1601'   7C                    	MOV	A,H
  1602'   B5                    	ORA	L
  1603'   C2 160E'              	JNZ	VDD_LS
  1606'   3E 01                 	MVI	A,1
  1608'   32 264A'              	STA	DDSNG
  160B'   C3 1614'              	JMP	VDD_GO
  160E'                         VDD_LS:
  160E'   CD 0814'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1611'   DA 06DB'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1614'                         VDD_GO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  1614'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1617'   CD 0792'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  161A'   2A 2661'              	LHLD	CNTV
  161D'   CD 0000*              	CALL	SETC0
  1620'                         VDD_FW:
  1620'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1623'   CD 0683'              	CALL	CNTTST
  1626'   C2 1620'              	JNZ	VDD_FW
  1629'   CD 0188'              	CALL	MARKMOD
  162C'   CD 0985'              	CALL	ATEOF
  162F'   D2 164A'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1632'   3E 00                 	MVI	A,0
  1634'   32 264A'              	STA	DDSNG		; deleted to the end: full repaint
  1637'   CD 0DCB'              	CALL	ONFST
  163A'   CA 07A9'              	JZ	FNBLNK		; nothing left before it
  163D'   21 0001               	LXI	H,1		; onto the new last line
  1640'   CD 0000*              	CALL	SETBWD
  1643'   2A 0000*              	LHLD	LNDLT
  1646'   2B                    	DCX	H
  1647'   22 0000*              	SHLD	LNDLT
  164A'                         VDD_UP:
  164A'   CD 07A9'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  164D'   3A 264A'              	LDA	DDSNG
  1650'   B7                    	ORA	A
  1651'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1652'   3E 03                 	MVI	A,R_DLIN
  1654'   32 2623'              	STA	RINTENT
  1657'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and an overflow raises WM's 'QBUF FULL' with
                                ; what has already moved safely in the register.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1658'                         QEMPTY:
  1658'   2A 0000*              	LHLD	QBEG
  165B'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  165C'   2A 0000*              	LHLD	QEND
  165F'   7C                    	MOV	A,H
  1660'   BA                    	CMP	D
  1661'   C0                    	RNZ
  1662'   7D                    	MOV	A,L
  1663'   BB                    	CMP	E
  1664'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1665'                         VC_Y:
  1665'   3E 79                 	MVI	A,'y'
  1667'   32 2648'              	STA	PENDOP
  166A'   C3 06DB'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  166D'                         VY_YY:
  166D'   CD 0000*              	CALL	CUROFF
  1670'   22 2692'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1673'   CD 05C7'              	CALL	BOL
  1676'   22 2694'              	SHLD	YPT		; where the lines come from, to put them back
  1679'   CD 178A'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  167C'   CD 17CD'              	CALL	YNCOPY		; copied where they lie, if that can be done
  167F'   D2 1791'              	JNC	YNDONE
  1682'   21 15F2'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1685'   C3 16B1'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1688'                         OPYANK:
  1688'   CD 12F3'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  168B'   2A 264D'              	LHLD	OPSTA
  168E'   EB                    	XCHG			; DE = start
  168F'   2A 264F'              	LHLD	OPEND2		; HL = end
  1692'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1695'   D2 1699'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1698'   EB                    	XCHG			; ... otherwise the start is
  1699'                         OPY_LO:
  1699'   22 2692'              	SHLD	YOFF
  169C'   2A 265D'              	LHLD	OPLO
  169F'   22 2694'              	SHLD	YPT		; where the lines come from, to put them back
  16A2'   CD 178A'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  16A5'   CD 1845'              	CALL	YNSPAN		; copied where they lie, if there is room
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  16A8'   D2 1791'              	JNC	YNDONE
  16AB'   21 174E'              	LXI	H,YSPAN
  16AE'   C3 16B1'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  16B1'                         YKGO:
  16B1'   22 26BB'              	SHLD	YACT
  16B4'   2A 2694'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  16B7'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  16B8'   2A 2692'              	LHLD	YOFF		;   survive this -- the put-back below can page
  16BB'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  16BE'   22 26C1'              	SHLD	YCOL		;   them -- but a distance within the lines does
  16C1'   3A 2622'              	LDA	MODF
  16C4'   32 268F'              	STA	YMODF
  16C7'   3A 263B'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  16CA'   32 2690'              	STA	YDCHG		;   a yank must not become the last change
  16CD'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  16D0'   32 2691'              	STA	YURPL		;   back are not a change to undo either
  16D3'   3E 01                 	MVI	A,1
  16D5'   32 0000*              	STA	UNDRPL
  16D8'   32 26BA'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  16DB'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  16DE'   22 269D'              	SHLD	YLDLT
  16E1'   CD 0000*              	CALL	LOGLEN
  16E4'   22 26BF'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  16E7'   2A 26BB'              	LHLD	YACT
  16EA'   CD 174D'              	CALL	YCALL		; the lines out of the file, into the register
  16ED'   CD 0000*              	CALL	LOGLEN
  16F0'   EB                    	XCHG
  16F1'   2A 26BF'              	LHLD	YWAS
  16F4'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  16F7'   CA 1725'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  16FA'   2A 2694'              	LHLD	YPT
  16FD'   CD 0000*              	CALL	GOTO
  1700'   CD 0000*              	CALL	QGET		; and straight back in
                                	;--- Putting them back can PAGE: QGET splices the register through
                                	;    INSBLK, whose MKGAP reaches MKROOM when the arena is tight, and a
                                	;    spill writes the window's top out to disk -- which moves TXTBEG and
                                	;    shifts every logical offset under us, YOFF among them.  ('500yy' at
                                	;    line 2500 of a 40 K file spills 48 records and used to land the
                                	;    cursor 573 lines below where it started; a yank moves the cursor
                                	;    nowhere.)  So the cursor is found again from the lines THEMSELVES:
                                	;    QGET leaves it just past them, so they start at the cursor less the
                                	;    register's length, and the cursor was YCOL bytes into them.  Both
                                	;    terms are read AFTER the paging, so neither can be stale. ---
  1703'   CD 0000*              	CALL	CUROFF		; where QGET left it: just past the lines
  1706'   22 26C3'              	SHLD	YBLK
  1709'   2A 0000*              	LHLD	QBEG
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  170C'   EB                    	XCHG
  170D'   2A 0000*              	LHLD	QEND
  1710'   CD 0000*              	CALL	SUBHD		; HL = the register's length = what went back
  1713'   EB                    	XCHG
  1714'   2A 26C3'              	LHLD	YBLK
  1717'   CD 0000*              	CALL	SUBHD		; HL = where those lines start NOW
  171A'   EB                    	XCHG
  171B'   2A 26C1'              	LHLD	YCOL
  171E'   19                    	DAD	D		; ... and the cursor is YCOL into them
  171F'   CD 0000*              	CALL	GOTO
  1722'   C3 172B'              	JMP	YK_RST
  1725'                         YK_FIN:				; nothing came out, so nothing was put back and
  1725'   2A 2692'              	LHLD	YOFF		;   no offset can have shifted: the cursor is
  1728'   CD 0000*              	CALL	GOTO		;   where it was
  172B'                         YK_RST:
  172B'   2A 269D'              	LHLD	YLDLT
  172E'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1731'   3A 268F'              	LDA	YMODF
  1734'   32 2622'              	STA	MODF
  1737'   3A 2690'              	LDA	YDCHG
  173A'   32 263B'              	STA	DOTCHG
  173D'   3A 2691'              	LDA	YURPL
  1740'   32 0000*              	STA	UNDRPL
  1743'   AF                    	XRA	A
  1744'   32 26BA'              	STA	MKHOLD
  1747'   CD 084E'              	CALL	GLSTAL
  174A'   C3 06FC'              	JMP	SETFUL		; the cheap paint cannot carry this
  174D'   E9                    YCALL:	PCHL
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  174E'                         YSPAN:
  174E'   CD 084E'              	CALL	GLSTAL
  1751'   CD 12B4'              	CALL	OPSPNL		; HL = the span's length
  1754'   22 26BD'              	SHLD	YTGT
  1757'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  175A'   EB                    	XCHG			; DE = it
  175B'   2A 26BD'              	LHLD	YTGT
  175E'   EB                    	XCHG			; HL = the text's, DE = the span's
  175F'   CD 0000*              	CALL	SUBHD
  1762'   22 26BD'              	SHLD	YTGT		; what the text is left at when the span is out
  1765'   2A 265D'              	LHLD	OPLO
  1768'   CD 0000*              	CALL	GOTO
  176B'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  176E'                         YS_LP:
  176E'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  1771'   CD 0000*              	CALL	SETC0
  1774'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1777'   CD 0000*              	CALL	LOGLEN
  177A'   EB                    	XCHG			; DE = what is left
  177B'   2A 26BD'              	LHLD	YTGT
  177E'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1781'   DA 1787'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1784'   C2 176E'              	JNZ	YS_LP		;   but never spin here if it ever did
  1787'                         YS_END:
  1787'   C3 0188'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  178A'                         YNPRE:
  178A'   2A 0000*              	LHLD	PGTOPM
  178D'   22 26C5'              	SHLD	YNPG
  1790'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1791'                         YNDONE:
  1791'   2A 2692'              	LHLD	YOFF
  1794'   CD 0000*              	CALL	GOTO
  1797'   2A 0000*              	LHLD	PGTOPM
  179A'   EB                    	XCHG
  179B'   2A 26C5'              	LHLD	YNPG
  179E'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  17A1'   C2 06FC'              	JNZ	SETFUL		; it moved under us: repaint after all
  17A4'   C3 06DB'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  17A7'                         YNROOM:
  17A7'   11 0100               	LXI	D,100H
  17AA'   19                    	DAD	D
  17AB'   D8                    	RC			; within a chunk of 64K: no arena holds that
  17AC'   E5                    	PUSH	H		; the span plus its slack
  17AD'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  17B0'   EB                    	XCHG			; HL = free
  17B1'   D1                    	POP	D		; DE = the span plus its slack
  17B2'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  17B5'   DA 17BD'              	JC	YNR_OK
  17B8'   CA 17BD'              	JZ	YNR_OK
  17BB'   37                    	STC			; not enough: the delete-and-put-back path
  17BC'   C9                    	RET
  17BD'                         YNR_OK:
  17BD'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  17BE'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  17BF'                         YNGO:
  17BF'   C5                    	PUSH	B
  17C0'   CD 066E'              	CALL	GETCNT		; spent here: this yank is happening
  17C3'   CD 084E'              	CALL	GLSTAL
  17C6'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  17C9'   C1                    	POP	B
  17CA'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  17CD'                         YNCOPY:
  17CD'   2A 261F'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  17D0'   7C                    	MOV	A,H		;   the count itself
  17D1'   B5                    	ORA	L
  17D2'   C2 17D8'              	JNZ	YNC_HV
  17D5'   21 0001               	LXI	H,1
  17D8'                         YNC_HV:
  17D8'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  17D9'   3D                    	DCR	A		;   a count over one has to have the NEXT one
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  17DA'   B4                    	ORA	H
  17DB'   CA 17E6'              	JZ	YNC_M
  17DE'   E5                    	PUSH	H
  17DF'   CD 0814'              	CALL	ONLAST		; vim: a count over one on the last line does
  17E2'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  17E3'   DA 17F8'              	JC	YNC_RF
  17E6'                         YNC_M:
  17E6'   E5                    	PUSH	H
  17E7'   CD 0792'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  17EA'   E1                    	POP	H
  17EB'   CD 1800'              	CALL	YNLINE		; BC = the span, measured where it stands
  17EE'   D8                    	RC			; not measurable here: let the pager answer it
  17EF'   60                    	MOV	H,B
  17F0'   69                    	MOV	L,C
  17F1'   CD 17A7'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  17F4'   D8                    	RC			; no: the delete-and-put-back path
  17F5'   C3 17BF'              	JMP	YNGO
  17F8'                         YNC_RF:
  17F8'   CD 066E'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  17FB'   CD 084E'              	CALL	GLSTAL		;   register alone, and that is the command
  17FE'   B7                    	ORA	A		; NC: done
  17FF'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1800'                         YNLINE:
  1800'   22 26C7'              	SHLD	YNCNT		; the lines it still wants
  1803'   2A 0000*              	LHLD	GAPEND
  1806'                         YNL_LP:
  1806'   EB                    	XCHG			; DE = the scan
  1807'   2A 0000*              	LHLD	TXTEND
  180A'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  180D'   EB                    	XCHG			; HL = the scan
  180E'   D2 182E'              	JNC	YNL_EN		; the resident text ran out
  1811'   7E                    	MOV	A,M
  1812'   23                    	INX	H
  1813'   FE 0A                 	CPI	LF
  1815'   C2 1806'              	JNZ	YNL_LP
  1818'   E5                    	PUSH	H
  1819'   2A 26C7'              	LHLD	YNCNT
  181C'   2B                    	DCX	H
  181D'   22 26C7'              	SHLD	YNCNT
  1820'   7C                    	MOV	A,H
  1821'   B5                    	ORA	L
  1822'   E1                    	POP	H
  1823'   C2 1806'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1826'   EB                    	XCHG			; DE = past the last of them
  1827'   2A 0000*              	LHLD	GAPEND
  182A'   EB                    	XCHG			; HL = past them, DE = GAPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  182B'   C3 183C'              	JMP	YNL_BC
  182E'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  182E'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1831'   C2 1843'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1834'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1837'   EB                    	XCHG			;   count clamps to it as vim's does
  1838'   2A 0000*              	LHLD	GAPEND
  183B'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  183C'                         YNL_BC:
  183C'   CD 0000*              	CALL	SUBHD		; HL = the span
  183F'   44                    	MOV	B,H
  1840'   4D                    	MOV	C,L
  1841'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1842'   C9                    	RET
  1843'                         YNL_NO:
  1843'   37                    	STC
  1844'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1845'                         YNSPAN:
  1845'   CD 12B4'              	CALL	OPSPNL		; HL = the span's length
  1848'   44                    	MOV	B,H
  1849'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  184A'   CD 17A7'              	CALL	YNROOM
  184D'   D8                    	RC			; no room: the delete-and-put-back path
  184E'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  184F'   2A 265D'              	LHLD	OPLO
  1852'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1855'   C1                    	POP	B
  1856'   C3 17BF'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1859'                         VC_P:
  1859'   CD 1658'              	CALL	QEMPTY
  185C'   CA 1914'              	JZ	VP_BEL
  185F'   CD 066E'              	CALL	GETCNT
  1862'   22 2696'              	SHLD	PCNT
  1865'   CD 0000*              	CALL	CUROFF
  1868'   CD 05F7'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  186B'   C3 1880'              	JMP	VP_GO
  186E'                         VCB_P:
  186E'   CD 1658'              	CALL	QEMPTY
  1871'   CA 1914'              	JZ	VP_BEL
  1874'   CD 066E'              	CALL	GETCNT
  1877'   22 2696'              	SHLD	PCNT
  187A'   CD 0000*              	CALL	CUROFF
  187D'   CD 05C7'              	CALL	BOL
  1880'                         VP_GO:
  1880'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  1883'   CD 0000*              	CALL	CUROFF
  1886'   EB                    	XCHG
  1887'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  188A'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  188D'   DA 18A2'              	JC	VP_IN
  1890'   EB                    	XCHG			; HL = the put point = LOGLEN
  1891'   7C                    	MOV	A,H
  1892'   B5                    	ORA	L
  1893'   CA 189F'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1896'   2B                    	DCX	H
  1897'   CD 0000*              	CALL	CHARAT
  189A'   FE 0A                 	CPI	LF
  189C'   CA 18A2'              	JZ	VP_IN
  189F'                         VP_BRK:
  189F'   CD 1462'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  18A2'                         VP_IN:
  18A2'   CD 0000*              	CALL	CUROFF
  18A5'   22 2698'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  18A8'   2A 0000*              	LHLD	QBEG
  18AB'   EB                    	XCHG
  18AC'   2A 0000*              	LHLD	QEND
  18AF'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  18B2'   EB                    	XCHG
  18B3'   22 269A'              	SHLD	PLFS
  18B6'   2A 2696'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  18B9'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  18BA'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  18BB'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  18BD'   C2 18C1'              	JNZ	VP_PZ
  18C0'   7D                    	MOV	A,L
  18C1'                         VP_PZ:
  18C1'   32 269C'              	STA	PCPY
  18C4'                         VP_LP:
  18C4'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  18C7'   2A 0000*              	LHLD	LNDLT
  18CA'   EB                    	XCHG
  18CB'   2A 269A'              	LHLD	PLFS
  18CE'   19                    	DAD	D
  18CF'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  18D2'   2A 2696'              	LHLD	PCNT
  18D5'   2B                    	DCX	H
  18D6'   22 2696'              	SHLD	PCNT
  18D9'   7C                    	MOV	A,H
  18DA'   B5                    	ORA	L
  18DB'   C2 18C4'              	JNZ	VP_LP
  18DE'   CD 0188'              	CALL	MARKMOD
  18E1'   2A 2698'              	LHLD	PPT
  18E4'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  18E7'   CD 084E'              	CALL	GLSTAL
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  18EA'   3A 269C'              	LDA	PCPY
  18ED'   B7                    	ORA	A
  18EE'   CA 07A9'              	JZ	FNBLNK
  18F1'   2A 269A'              	LHLD	PLFS
  18F4'   7C                    	MOV	A,H
  18F5'   B7                    	ORA	A
  18F6'   C2 07A9'              	JNZ	FNBLNK
  18F9'   3A 269C'              	LDA	PCPY
  18FC'   CD 0D61'              	CALL	MULSAT		; HL = the lines this put put, saturated
  18FF'   7C                    	MOV	A,H
  1900'   B7                    	ORA	A
  1901'   C2 07A9'              	JNZ	FNBLNK
  1904'   7D                    	MOV	A,L
  1905'   B7                    	ORA	A
  1906'   CA 07A9'              	JZ	FNBLNK
  1909'   F5                    	PUSH	PSW
  190A'   CD 06E7'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  190D'   F1                    	POP	PSW
  190E'   32 2624'              	STA	ILN		; ... which the lines put now replace
  1911'   C3 07A9'              	JMP	FNBLNK
  1914'                         VP_BEL:
  1914'   CD 066E'              	CALL	GETCNT		; the count is spent either way
  1917'   0E 07                 	MVI	C,BEL
  1919'   CD 0000*              	CALL	BCONOU
  191C'   C3 06DB'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  191F'                         VIREP:
  191F'   78                    	MOV	A,B
  1920'   FE 01                 	CPI	KT_ACT
  1922'   CA 1A4F'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  1925'   FE 02                 	CPI	KT_CHAR
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  1927'   C0                    	RNZ			; ignore anything else
  1928'   79                    	MOV	A,C
  1929'   FE 0D                 	CPI	CR
  192B'   CA 198F'              	JZ	VP_CR
  192E'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1930'   CA 198F'              	JZ	VP_CR
  1933'   FE 08                 	CPI	BS
  1935'   CA 199B'              	JZ	VP_BS
  1938'   FE 7F                 	CPI	DEL
  193A'   CA 199B'              	JZ	VP_BS
  193D'   32 266E'              	STA	VRCH		; the calls below do not preserve C
  1940'   CD 06E1'              	CALL	SETLIN		; this row changed
  1943'   CD 0188'              	CALL	MARKMOD
  1946'   CD 1455'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1949'   CA 1981'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  194C'   3A 266E'              	LDA	VRCH
  194F'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1952'   2A 266F'              	LHLD	RPDEL
  1955'   7C                    	MOV	A,H
  1956'   B5                    	ORA	L
  1957'   CA 196D'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  195A'   2A 0000*              	LHLD	GAPEND
  195D'   EB                    	XCHG
  195E'   2A 2673'              	LHLD	RPGE
  1961'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1964'   CA 196D'              	JZ	VP_OVW
  1967'   21 0000               	LXI	H,0
  196A'   22 266F'              	SHLD	RPDEL		; the text moved: those originals are gone
  196D'                         VP_OVW:
  196D'   21 0001               	LXI	H,1
  1970'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1973'   2A 0000*              	LHLD	GAPEND
  1976'   22 2673'              	SHLD	RPGE
  1979'   2A 266F'              	LHLD	RPDEL
  197C'   23                    	INX	H
  197D'   22 266F'              	SHLD	RPDEL
  1980'   C9                    	RET
  1981'                         VP_APP:
  1981'   3A 266E'              	LDA	VRCH
  1984'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1987'   2A 2671'              	LHLD	RPAPP
  198A'   23                    	INX	H
  198B'   22 2671'              	SHLD	RPAPP
  198E'   C9                    	RET
  198F'                         VP_CR:
  198F'   21 0000               	LXI	H,0
  1992'   22 266F'              	SHLD	RPDEL		; a line break ends what BS can put back
  1995'   22 2671'              	SHLD	RPAPP
  1998'   C3 1A25'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  199B'                         VP_BS:
  199B'   2A 2671'              	LHLD	RPAPP
  199E'   7C                    	MOV	A,H
  199F'   B5                    	ORA	L
  19A0'   CA 19AD'              	JZ	VP_BSD
  19A3'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  19A4'   22 2671'              	SHLD	RPAPP		; an appended char: it just goes
  19A7'   CD 06E1'              	CALL	SETLIN
  19AA'   C3 0000*              	JMP	DELPRV
  19AD'                         VP_BSD:
  19AD'   2A 266F'              	LHLD	RPDEL
  19B0'   7C                    	MOV	A,H
  19B1'   B5                    	ORA	L
  19B2'   CA 19D9'              	JZ	VP_BSM		; nothing of ours left
  19B5'   2A 0000*              	LHLD	GAPEND
  19B8'   EB                    	XCHG
  19B9'   2A 2673'              	LHLD	RPGE
  19BC'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  19BF'   C2 19D9'              	JNZ	VP_BSM
  19C2'   2A 266F'              	LHLD	RPDEL
  19C5'   2B                    	DCX	H
  19C6'   22 266F'              	SHLD	RPDEL
  19C9'   CD 06E1'              	CALL	SETLIN
  19CC'   CD 0000*              	CALL	DELPRV		; the typed char goes
  19CF'   CD 0000*              	CALL	UNDELF		; the original comes back
  19D2'   2A 0000*              	LHLD	GAPEND
  19D5'   22 2673'              	SHLD	RPGE
  19D8'   C9                    	RET
  19D9'                         VP_BSM:
  19D9'   CD 06DB'              	CALL	SETMOV		; nothing changed: back over the text as it is
  19DC'   C3 074A'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  19DF'                         VIINS:
  19DF'   78                    	MOV	A,B
  19E0'   FE 01                 	CPI	KT_ACT
  19E2'   CA 1A4F'              	JZ	VI_ACT
  19E5'   FE 02                 	CPI	KT_CHAR
  19E7'   C0                    	RNZ			; ignore anything else
  19E8'   79                    	MOV	A,C
  19E9'   FE 0D                 	CPI	CR
  19EB'   CA 1A25'              	JZ	VI_CR
  19EE'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  19F0'   CA 1A25'              	JZ	VI_CR
  19F3'   FE 08                 	CPI	BS
  19F5'   CA 1A3D'              	JZ	VI_BS
  19F8'   FE 7F                 	CPI	DEL
  19FA'   CA 1A3D'              	JZ	VI_BS
  19FD'   79                    	MOV	A,C
  19FE'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1A01'   CD 0188'              	CALL	MARKMOD
  1A04'   CD 06E1'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1A07'   79                    	MOV	A,C
  1A08'   FE 20                 	CPI	' '
  1A0A'   D8                    	RC			; control char -> keep R_LINE
  1A0B'   FE 7F                 	CPI	DEL
  1A0D'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  1A0E'   CD 0702'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1A11'   B7                    	ORA	A
  1A12'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1A13'   3E 04                 	MVI	A,R_ICH
  1A15'   32 2623'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1A18'   CD 1455'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1A1B'   3E 00                 	MVI	A,0
  1A1D'   C2 1A21'              	JNZ	VI_ICH
  1A20'   3C                    	INR	A
  1A21'                         VI_ICH:
  1A21'   32 2625'              	STA	ICHAPP
  1A24'   C9                    	RET
  1A25'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1A25'   CD 1455'              	CALL	ATCEND
  1A28'   3E 00                 	MVI	A,0
  1A2A'   CA 1A2E'              	JZ	VI_CRS
  1A2D'   3C                    	INR	A
  1A2E'                         VI_CRS:
  1A2E'   F5                    	PUSH	PSW
  1A2F'   CD 1462'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1A32'   CD 1476'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1A35'   CD 06E7'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1A38'   F1                    	POP	PSW
  1A39'   32 2626'              	STA	ILABOV
  1A3C'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1A3D'                         VI_BS:
  1A3D'   CD 0000*              	CALL	PEEKL
  1A40'   D8                    	RC			; start of the file: nothing to delete
  1A41'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1A43'   CA 1A49'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1A46'   CD 06E1'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1A49'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1A49'   CD 0188'              	CALL	MARKMOD
  1A4C'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1A4F'                         VI_ACT:
  1A4F'   79                    	MOV	A,C
  1A50'   FE 0B                 	CPI	ACT_ESC
  1A52'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  1A53'   3E 00                 	MVI	A,EM_CMD
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A55'   32 261E'              	STA	EDMODE
  1A58'   CD 06DB'              	CALL	SETMOV
  1A5B'   CD 074A'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1A5E'   C3 084E'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1A61'                         RDLINE:
  1A61'   EB                    	XCHG			; HL = buffer
  1A62'   22 2675'              	SHLD	RLPTR
  1A65'   3E 00                 	MVI	A,0
  1A67'   32 2677'              	STA	RLLEN
  1A6A'   78                    	MOV	A,B
  1A6B'   32 2678'              	STA	RLMAX
  1A6E'   79                    	MOV	A,C
  1A6F'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1A72'                         RL_LP:
  1A72'   CD 0000*              	CALL	GETKEY
  1A75'   78                    	MOV	A,B
  1A76'   FE 01                 	CPI	KT_ACT
  1A78'   CA 1ACE'              	JZ	RL_ACT
  1A7B'   FE 02                 	CPI	KT_CHAR
  1A7D'   C2 1A72'              	JNZ	RL_LP		; ignore other keys
  1A80'   79                    	MOV	A,C
  1A81'   FE 0D                 	CPI	CR
  1A83'   CA 1ADF'              	JZ	RL_DONE
  1A86'   FE 08                 	CPI	BS
  1A88'   CA 1AB6'              	JZ	RL_BS
  1A8B'   FE 7F                 	CPI	DEL
  1A8D'   CA 1AB6'              	JZ	RL_BS
  1A90'   FE 20                 	CPI	' '
  1A92'   DA 1A72'              	JC	RL_LP		; control char -> ignore
  1A95'   3A 2677'              	LDA	RLLEN
  1A98'   47                    	MOV	B,A
  1A99'   3A 2678'              	LDA	RLMAX
  1A9C'   B8                    	CMP	B
  1A9D'   CA 1A72'              	JZ	RL_LP		; full -> ignore
  1AA0'   2A 2675'              	LHLD	RLPTR
  1AA3'   71                    	MOV	M,C
  1AA4'   23                    	INX	H
  1AA5'   22 2675'              	SHLD	RLPTR
  1AA8'   3A 2677'              	LDA	RLLEN
  1AAB'   3C                    	INR	A
  1AAC'   32 2677'              	STA	RLLEN
  1AAF'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1AB0'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1AB3'   C3 1A72'              	JMP	RL_LP
  1AB6'                         RL_BS:				; WM LINEPOP
  1AB6'   3A 2677'              	LDA	RLLEN
  1AB9'   B7                    	ORA	A
  1ABA'   CA 1AD4'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1ABD'   3D                    	DCR	A
  1ABE'   32 2677'              	STA	RLLEN
  1AC1'   2A 2675'              	LHLD	RLPTR
  1AC4'   2B                    	DCX	H
  1AC5'   22 2675'              	SHLD	RLPTR
  1AC8'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1ACB'   C3 1A72'              	JMP	RL_LP
  1ACE'                         RL_ACT:
  1ACE'   79                    	MOV	A,C
  1ACF'   FE 0B                 	CPI	ACT_ESC
  1AD1'   C2 1A72'              	JNZ	RL_LP
  1AD4'                         RL_CAN:
  1AD4'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1AD6'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1AD9'   CD 06E1'              	CALL	SETLIN		; redraw one row
  1ADC'   3E FF                 	MVI	A,0FFH		; cancelled
  1ADE'   C9                    	RET
  1ADF'                         RL_DONE:
  1ADF'   AF                    	XRA	A
  1AE0'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1AE1'                         VC_BZ:
  1AE1'   CD 06DB'              	CALL	SETMOV
  1AE4'   3A 2647'              	LDA	GSAVE
  1AE7'   FE 02                 	CPI	PZ
  1AE9'   CA 1AF4'              	JZ	VZ_ZZ
  1AEC'   B7                    	ORA	A
  1AED'   C0                    	RNZ			; 'g' was pending: vim drops both
  1AEE'   3E 02                 	MVI	A,PZ
  1AF0'   32 2646'              	STA	GPEND
  1AF3'   C9                    	RET
  1AF4'                         VZ_ZZ:
  1AF4'   3E 04                 	MVI	A,EO_X
  1AF6'   32 2679'              	STA	EXOP
  1AF9'   3E 01                 	MVI	A,1
  1AFB'   32 268C'              	STA	EXBANG		; no '!'
  1AFE'   AF                    	XRA	A
  1AFF'   32 267A'              	STA	EXARG		; no file name
  1B02'   3A 2622'              	LDA	MODF		; as ':x': a changed text is written first
  1B05'   B7                    	ORA	A
  1B06'   CA 1C29'              	JZ	EX_Q
  1B09'   C3 1BC3'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1B0C'                         VC_EX:
  1B0C'   CD 066E'              	CALL	GETCNT
  1B0F'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1B12'   11 0000*              	LXI	D,EXBUF
  1B15'   06 28                 	MVI	B,EXMAX
  1B17'   0E 3A                 	MVI	C,':'
  1B19'   CD 1A61'              	CALL	RDLINE
  1B1C'   B7                    	ORA	A
  1B1D'   C0                    	RNZ			; cancelled
  1B1E'   3A 2677'              	LDA	RLLEN
  1B21'   5F                    	MOV	E,A
  1B22'   16 00                 	MVI	D,0
  1B24'   21 0000*              	LXI	H,EXBUF
  1B27'   19                    	DAD	D
  1B28'   36 00                 	MVI	M,0		; the line ends with a 0
  1B2A'   21 0000*              	LXI	H,EXBUF
  1B2D'   CD 1EC5'              	CALL	SKIPB
  1B30'   C8                    	RZ			; nothing on it
  1B31'   22 267C'              	SHLD	EXCMD
  1B34'   CD 206F'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1B37'   CD 1EC5'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1B3A'   56                    	MOV	D,M
  1B3B'   23                    	INX	H
  1B3C'   1E 00                 	MVI	E,0
  1B3E'   CD 1ED1'              	CALL	ISLOW
  1B41'   DA 1B4C'              	JC	EX_LK
  1B44'   5F                    	MOV	E,A
  1B45'   23                    	INX	H
  1B46'   CD 1ED1'              	CALL	ISLOW
  1B49'   D2 1B65'              	JNC	EX_NOT		; a third letter: none of ours
  1B4C'                         EX_LK:
  1B4C'   E5                    	PUSH	H
  1B4D'   21 2059'              	LXI	H,EXTAB
  1B50'                         EX_TL:
  1B50'   7E                    	MOV	A,M
  1B51'   B7                    	ORA	A
  1B52'   CA 1B64'              	JZ	EX_NTP		; not in the table
  1B55'   23                    	INX	H
  1B56'   BA                    	CMP	D
  1B57'   7E                    	MOV	A,M
  1B58'   23                    	INX	H
  1B59'   C2 1B60'              	JNZ	EX_TN
  1B5C'   BB                    	CMP	E
  1B5D'   CA 1B6B'              	JZ	EX_TF
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1B60'                         EX_TN:
  1B60'   23                    	INX	H
  1B61'   C3 1B50'              	JMP	EX_TL
  1B64'                         EX_NTP:
  1B64'   E1                    	POP	H
  1B65'                         EX_NOT:
  1B65'   21 1F89'              	LXI	H,SNOT
  1B68'   C3 1F06'              	JMP	EXERT
  1B6B'                         EX_TF:
  1B6B'   7E                    	MOV	A,M
  1B6C'   32 2679'              	STA	EXOP
  1B6F'   E1                    	POP	H
  1B70'   FE 06                 	CPI	EO_S
  1B72'   CA 20DE'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1B75'   3A 26D0'              	LDA	SRNGF
  1B78'   B7                    	ORA	A
  1B79'   C2 1B65'              	JNZ	EX_NOT		; a range on a command that does not take one
                                	;--- '!', then the file name ---
  1B7C'   7E                    	MOV	A,M
  1B7D'   D6 21                 	SUI	'!'
  1B7F'   32 268C'              	STA	EXBANG		; 0 = '!'
  1B82'   C2 1B86'              	JNZ	EX_NB
  1B85'   23                    	INX	H
  1B86'                         EX_NB:
  1B86'   CD 1EC5'              	CALL	SKIPB
  1B89'   32 267A'              	STA	EXARG		; 0 = no file name
  1B8C'   CA 1BA5'              	JZ	EX_RUN
  1B8F'   22 267C'              	SHLD	EXCMD
  1B92'   3A 2679'              	LDA	EXOP
  1B95'   FE 02                 	CPI	EO_Q
  1B97'   CA 1F03'              	JZ	EX_TRL		; :q takes none
  1B9A'   FE 07                 	CPI	EO_V
  1B9C'   CA 1F03'              	JZ	EX_TRL		; nor :ve
  1B9F'   CD 1E2F'              	CALL	PARSFN
  1BA2'   C2 1EF7'              	JNZ	EX_INV
  1BA5'                         EX_RUN:
  1BA5'   3A 2679'              	LDA	EXOP
  1BA8'   FE 05                 	CPI	EO_E
  1BAA'   CA 1C40'              	JZ	EX_E
  1BAD'   FE 02                 	CPI	EO_Q
  1BAF'   CA 1C29'              	JZ	EX_Q
  1BB2'   FE 07                 	CPI	EO_V
  1BB4'   CA 1EFD'              	JZ	EX_V
  1BB7'   FE 04                 	CPI	EO_X
  1BB9'   C2 1BC3'              	JNZ	EX_W
  1BBC'   3A 2622'              	LDA	MODF		; :x writes only a changed text
  1BBF'   B7                    	ORA	A
  1BC0'   CA 1C29'              	JZ	EX_Q
  1BC3'                         EX_W:
  1BC3'   CD 1C97'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1BC6'   D8                    	RC			; refused (message shown)
  1BC7'   32 267B'              	STA	EXBAK
  1BCA'   3A 2679'              	LDA	EXOP
  1BCD'   FE 01                 	CPI	EO_W
  1BCF'   CA 1BE6'              	JZ	EX_WK
  1BD2'   3A 267B'              	LDA	EXBAK
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1BD5'   B7                    	ORA	A
  1BD6'   C2 1C26'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1BD9'   3A 268C'              	LDA	EXBANG
  1BDC'   B7                    	ORA	A
  1BDD'   CA 1C26'              	JZ	EX_WQ		; so it does with '!'
  1BE0'   CD 1BE6'              	CALL	EX_WK		; else it may not: keep the text
  1BE3'   C3 1C29'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1BE6'                         EX_WK:
  1BE6'   CD 0C6D'              	CALL	CURRW		; the cursor's row and file position
  1BE9'   32 267E'              	STA	WPROW
  1BEC'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1BEF'   7D                    	MOV	A,L
  1BF0'   E6 7F                 	ANI	7FH
  1BF2'   32 267F'              	STA	WPBYT
  1BF5'   7D                    	MOV	A,L
  1BF6'   17                    	RAL
  1BF7'   7C                    	MOV	A,H
  1BF8'   17                    	RAL
  1BF9'   5F                    	MOV	E,A
  1BFA'   3E 00                 	MVI	A,0
  1BFC'   17                    	RAL
  1BFD'   57                    	MOV	D,A		; DE = HL / 128
  1BFE'   2A 0000*              	LHLD	OUTPOS
  1C01'   19                    	DAD	D
  1C02'   22 2680'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1C05'   CD 1CCC'              	CALL	WRITE
  1C08'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1C0B'   2A 2680'              	LHLD	WPREC
  1C0E'   EB                    	XCHG
  1C0F'   3A 267F'              	LDA	WPBYT
  1C12'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1C15'   CD 0000*              	CALL	GOTO
  1C18'   21 0000               	LXI	H,0
  1C1B'   22 0000*              	SHLD	LNDLT
  1C1E'   3A 267E'              	LDA	WPROW
  1C21'   6F                    	MOV	L,A
  1C22'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1C25'   C9                    	RET
  1C26'                         EX_WQ:
  1C26'   CD 1CCC'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1C29'                         EX_Q:
  1C29'   3A 268C'              	LDA	EXBANG
  1C2C'   B7                    	ORA	A
  1C2D'   CA 1C37'              	JZ	EX_QT
  1C30'   3A 2622'              	LDA	MODF
  1C33'   B7                    	ORA	A
  1C34'   C2 1EEB'              	JNZ	MSGNWR		; changed, no '!': stay
  1C37'                         EX_QT:
  1C37'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1C3A'   3E 01                 	MVI	A,1
  1C3C'   32 2621'              	STA	QUITF
  1C3F'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


                                ; the cursor on the first non-blank, as vim opens a file.
  1C40'                         EX_E:
  1C40'   3A 268C'              	LDA	EXBANG
  1C43'   B7                    	ORA	A
  1C44'   CA 1C4E'              	JZ	EE_GO
  1C47'   3A 2622'              	LDA	MODF
  1C4A'   B7                    	ORA	A
  1C4B'   C2 1EEB'              	JNZ	MSGNWR
  1C4E'                         EE_GO:
  1C4E'   3A 267A'              	LDA	EXARG
  1C51'   B7                    	ORA	A
  1C52'   C2 1C59'              	JNZ	EE_ARG
  1C55'   CD 1D08'              	CALL	OWNTF		; no name: the buffer's own
  1C58'   D8                    	RC
  1C59'                         EE_ARG:
  1C59'   CD 1D1E'              	CALL	ISOWN
  1C5C'   21 0001               	LXI	H,1
  1C5F'   C2 1C66'              	JNZ	EE_LD		; another file: its first line
  1C62'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1C65'   23                    	INX	H		; HL = the cursor's line
  1C66'                         EE_LD:
  1C66'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1C68'   32 268A'              	STA	MSGWHT
  1C6B'   E5                    	PUSH	H
  1C6C'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1C6F'   21 0000*              	LXI	H,TFCB
  1C72'   11 0000*              	LXI	D,FNAME
  1C75'   CD 1D30'              	CALL	COPY12		; the buffer's name
  1C78'   CD 1CF5'              	CALL	SRCTF
  1C7B'   CD 0000*              	CALL	REOPEN
  1C7E'   CD 020B'              	CALL	MKCLR		; the marks named the buffer that just went
  1C81'   AF                    	XRA	A
  1C82'   32 2622'              	STA	MODF
  1C85'   E1                    	POP	H
  1C86'   2B                    	DCX	H
  1C87'   AF                    	XRA	A
  1C88'   CD 0000*              	CALL	MVLIND		; down to the line
  1C8B'   CD 0985'              	CALL	ATEOF
  1C8E'   DC 098B'              	CC	LASTLN		; past the last line: onto it
  1C91'   CD 0E99'              	CALL	ZSAVE
  1C94'   C3 0F7C'              	JMP	GP_MID
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  1C97'                         WRCHK:
  1C97'   3A 267A'              	LDA	EXARG
  1C9A'   B7                    	ORA	A
  1C9B'   C2 1CA5'              	JNZ	WC_ARG
  1C9E'   CD 1D08'              	CALL	OWNTF
  1CA1'   D8                    	RC
  1CA2'   C3 1CBA'              	JMP	WC_OWN
  1CA5'                         WC_ARG:
  1CA5'   CD 1D1E'              	CALL	ISOWN
  1CA8'   CA 1CBA'              	JZ	WC_OWN
  1CAB'   3A 268C'              	LDA	EXBANG
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1CAE'   B7                    	ORA	A
  1CAF'   CA 1CB8'              	JZ	WC_OTH
  1CB2'   CD 0000*              	CALL	TEXIST
  1CB5'   C2 1EDF'              	JNZ	MSGEXI		; File exists (! to force)
  1CB8'                         WC_OTH:
  1CB8'   AF                    	XRA	A		; (NC)
  1CB9'   C9                    	RET
  1CBA'                         WC_OWN:
  1CBA'   3A 268D'              	LDA	ROFLAG		; '-R': this is the file it may not write
  1CBD'   B7                    	ORA	A
  1CBE'   CA 1CC8'              	JZ	WC_OK
  1CC1'   3A 268C'              	LDA	EXBANG
  1CC4'   B7                    	ORA	A
  1CC5'   C2 1EE5'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  1CC8'                         WC_OK:
  1CC8'   3E 01                 	MVI	A,1
  1CCA'   B7                    	ORA	A		; (NC)
  1CCB'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  1CCC'                         WRITE:
  1CCC'   3A 267B'              	LDA	EXBAK
  1CCF'   CD 0000*              	CALL	WRTO
  1CD2'   3A 0001*              	LDA	FNAME+1
  1CD5'   FE 20                 	CPI	' '
  1CD7'   C2 1CE3'              	JNZ	WR_HAS
  1CDA'   21 0000*              	LXI	H,TFCB
  1CDD'   11 0000*              	LXI	D,FNAME
  1CE0'   CD 1D30'              	CALL	COPY12
  1CE3'                         WR_HAS:
  1CE3'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  1CE5'   32 268A'              	STA	MSGWHT
  1CE8'   CD 1D1E'              	CALL	ISOWN
  1CEB'   C2 1CF5'              	JNZ	SRCTF
  1CEE'   AF                    	XRA	A
  1CEF'   32 2622'              	STA	MODF
  1CF2'   32 268B'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  1CF5'                         SRCTF:
  1CF5'   21 0000*              	LXI	H,TFCB
  1CF8'   11 005C               	LXI	D,DFTFCB
  1CFB'   CD 1D30'              	CALL	COPY12
  1CFE'   AF                    	XRA	A
  1CFF'   06 04                 	MVI	B,4
  1D01'                         SRC_Z:
  1D01'   12                    	STAX	D		; extent, s1, s2, record count: 0
  1D02'   13                    	INX	D
  1D03'   05                    	DCR	B
  1D04'   C2 1D01'              	JNZ	SRC_Z
  1D07'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  1D08'                         OWNTF:
  1D08'   3A 0001*              	LDA	FNAME+1
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1D0B'   FE 20                 	CPI	' '
  1D0D'   CA 1ED9'              	JZ	MSGNFN
  1D10'   CD 1D3B'              	CALL	TFCLR
  1D13'   21 0000*              	LXI	H,FNAME
  1D16'   11 0000*              	LXI	D,TFCB
  1D19'   CD 1D30'              	CALL	COPY12
  1D1C'   B7                    	ORA	A		; (NC)
  1D1D'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  1D1E'                         ISOWN:
  1D1E'   21 0000*              	LXI	H,TFCB
  1D21'   11 0000*              	LXI	D,FNAME
  1D24'   06 0C                 	MVI	B,12
  1D26'                         IO_LP:
  1D26'   1A                    	LDAX	D
  1D27'   BE                    	CMP	M
  1D28'   C0                    	RNZ
  1D29'   23                    	INX	H
  1D2A'   13                    	INX	D
  1D2B'   05                    	DCR	B
  1D2C'   C2 1D26'              	JNZ	IO_LP
  1D2F'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  1D30'                         COPY12:
  1D30'   06 0C                 	MVI	B,12
  1D32'                         CP_LP:
  1D32'   7E                    	MOV	A,M
  1D33'   12                    	STAX	D
  1D34'   23                    	INX	H
  1D35'   13                    	INX	D
  1D36'   05                    	DCR	B
  1D37'   C2 1D32'              	JNZ	CP_LP
  1D3A'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  1D3B'                         TFCLR:
  1D3B'   11 0000*              	LXI	D,TFCB
  1D3E'   06 24                 	MVI	B,36
  1D40'   AF                    	XRA	A
  1D41'                         TC_LP:
  1D41'   12                    	STAX	D
  1D42'   13                    	INX	D
  1D43'   05                    	DCR	B
  1D44'   C2 1D41'              	JNZ	TC_LP
  1D47'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  1D48'                         FOPEN:
  1D48'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  1D4A'   32 268A'              	STA	MSGWHT
  1D4D'   21 005C               	LXI	H,DFTFCB
  1D50'   CD 1E22'              	CALL	NRMDRV
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1D53'   11 0000*              	LXI	D,FNAME
  1D56'   CD 1D30'              	CALL	COPY12
  1D59'   CD 0000*              	CALL	OPENZ
  1D5C'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  1D5F'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  1D61'   C8                    	RZ
  1D62'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  1D65'   32 268B'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  1D68'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  1D69'                         ARGSCN:
  1D69'   3A 0080               	LDA	CMDTAIL
  1D6C'   47                    	MOV	B,A		; B = what is left of the line
  1D6D'   B7                    	ORA	A
  1D6E'   C8                    	RZ
  1D6F'   21 0081               	LXI	H,CMDTAIL+1
  1D72'                         AS_TOK:				; at a token, or the blanks before one
  1D72'   7E                    	MOV	A,M
  1D73'   FE 20                 	CPI	' '
  1D75'   C2 1D7E'              	JNZ	AS_OPT
  1D78'   23                    	INX	H
  1D79'   05                    	DCR	B
  1D7A'   C2 1D72'              	JNZ	AS_TOK
  1D7D'   C9                    	RET
  1D7E'                         AS_OPT:
  1D7E'   FE 2B                 	CPI	'+'
  1D80'   CA 1DAA'              	JZ	AS_PLS
  1D83'   FE 2D                 	CPI	'-'
  1D85'   CA 1D99'              	JZ	AS_SW
  1D88'   FE 2F                 	CPI	'/'
  1D8A'   CA 1D99'              	JZ	AS_SW
  1D8D'                         AS_SKP:				; not ours (the file name): on to the next one
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1D8D'   23                    	INX	H
  1D8E'   05                    	DCR	B
  1D8F'   C8                    	RZ
  1D90'   7E                    	MOV	A,M
  1D91'   FE 20                 	CPI	' '
  1D93'   C2 1D8D'              	JNZ	AS_SKP
  1D96'   C3 1D72'              	JMP	AS_TOK
  1D99'                         AS_SW:
  1D99'   23                    	INX	H
  1D9A'   05                    	DCR	B
  1D9B'   C8                    	RZ
  1D9C'   7E                    	MOV	A,M
  1D9D'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  1D9F'   FE 52                 	CPI	'R'
  1DA1'   C2 1D8D'              	JNZ	AS_SKP
  1DA4'   32 268D'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  1DA7'   C3 1D8D'              	JMP	AS_SKP
  1DAA'                         AS_PLS:
  1DAA'   3E 01                 	MVI	A,1
  1DAC'   32 268E'              	STA	PLUSF		; '+' gets the line even with no number on it
  1DAF'   11 0000*              	LXI	D,PLUSB
  1DB2'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  1DB4'   23                    	INX	H		;   line space, so it is taken as '+' alone
  1DB5'   05                    	DCR	B
  1DB6'   CA 1DED'              	JZ	AS_PE
  1DB9'   7E                    	MOV	A,M
  1DBA'   FE 30                 	CPI	'0'
  1DBC'   C2 1DD4'              	JNZ	AS_PD
  1DBF'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  1DBF'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  1DC0'   05                    	DCR	B
  1DC1'   CA 1DF5'              	JZ	AS_P1
  1DC4'   7E                    	MOV	A,M
  1DC5'   FE 30                 	CPI	'0'
  1DC7'   CA 1DBF'              	JZ	AS_PZ
  1DCA'   FE 31                 	CPI	'1'
  1DCC'   DA 1DF5'              	JC	AS_P1		; zeros and then no digit at all: line 1
  1DCF'   FE 3A                 	CPI	'9'+1
  1DD1'   D2 1DF5'              	JNC	AS_P1
  1DD4'                         AS_PD:				; the digits, as typed
  1DD4'   7E                    	MOV	A,M
  1DD5'   FE 30                 	CPI	'0'
  1DD7'   DA 1DED'              	JC	AS_PE
  1DDA'   FE 3A                 	CPI	'9'+1
  1DDC'   D2 1DED'              	JNC	AS_PE
  1DDF'   79                    	MOV	A,C
  1DE0'   B7                    	ORA	A
  1DE1'   CA 1DFC'              	JZ	AS_POV
  1DE4'   0D                    	DCR	C
  1DE5'   7E                    	MOV	A,M
  1DE6'   12                    	STAX	D
  1DE7'   13                    	INX	D
  1DE8'   23                    	INX	H
  1DE9'   05                    	DCR	B
  1DEA'   C2 1DD4'              	JNZ	AS_PD
  1DED'                         AS_PE:
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1DED'   AF                    	XRA	A
  1DEE'   12                    	STAX	D		; the digits end with a 0
  1DEF'   78                    	MOV	A,B
  1DF0'   B7                    	ORA	A
  1DF1'   C8                    	RZ
  1DF2'   C3 1D72'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  1DF5'                         AS_P1:
  1DF5'   3E 31                 	MVI	A,'1'
  1DF7'   12                    	STAX	D
  1DF8'   13                    	INX	D
  1DF9'   C3 1DED'              	JMP	AS_PE
  1DFC'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  1DFC'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  1DFF'   C3 1DED'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  1E02'                         ARGGO:
  1E02'   3A 268E'              	LDA	PLUSF
  1E05'   B7                    	ORA	A
  1E06'   C8                    	RZ
  1E07'   21 0000*              	LXI	H,PLUSB
  1E0A'                         AG_LP:
  1E0A'   7E                    	MOV	A,M
  1E0B'   B7                    	ORA	A
  1E0C'   CA 1E1B'              	JZ	AG_G
  1E0F'   4F                    	MOV	C,A
  1E10'   06 02                 	MVI	B,KT_CHAR
  1E12'   E5                    	PUSH	H
  1E13'   CD 001F'              	CALL	VICMD
  1E16'   E1                    	POP	H
  1E17'   23                    	INX	H
  1E18'   C3 1E0A'              	JMP	AG_LP
  1E1B'                         AG_G:
  1E1B'   0E 47                 	MVI	C,'G'
  1E1D'   06 02                 	MVI	B,KT_CHAR
  1E1F'   C3 001F'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  1E22'                         NRMDRV:
  1E22'   7E                    	MOV	A,M
  1E23'   B7                    	ORA	A
  1E24'   C0                    	RNZ
  1E25'   E5                    	PUSH	H
  1E26'   0E 19                 	MVI	C,BF_CURDSK
  1E28'   CD 0005               	CALL	BDOS
  1E2B'   E1                    	POP	H
  1E2C'   3C                    	INR	A
  1E2D'   77                    	MOV	M,A
  1E2E'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  1E2F'                         PARSFN:
  1E2F'   CD 1D3B'              	CALL	TFCLR
  1E32'   11 0000*              	LXI	D,TFCB
  1E35'   23                    	INX	H
  1E36'   7E                    	MOV	A,M
  1E37'   2B                    	DCX	H
  1E38'   FE 3A                 	CPI	':'
  1E3A'   C2 1E4C'              	JNZ	PF_NM
  1E3D'   CD 1E92'              	CALL	GETFNC
  1E40'   CA 1E4C'              	JZ	PF_NM
  1E43'   D6 40                 	SUI	40H
  1E45'   12                    	STAX	D
  1E46'   FE 11                 	CPI	17
  1E48'   D2 1E70'              	JNC	PF_BAD
  1E4B'   23                    	INX	H
  1E4C'                         PF_NM:
  1E4C'   13                    	INX	D
  1E4D'   0E 08                 	MVI	C,8
  1E4F'   CD 1E74'              	CALL	CPYNAM
  1E52'   FE 2E                 	CPI	'.'
  1E54'   0E 03                 	MVI	C,3
  1E56'   C4 1E87'              	CNZ	PADFLD		; no type: blanks
  1E59'   CC 1E73'              	CZ	CPYNM0		; '.': the type
  1E5C'   3A 0001*              	LDA	TFCB+1
  1E5F'   FE 20                 	CPI	' '
  1E61'   CA 1E70'              	JZ	PF_BAD		; no name
  1E64'   CD 1EC5'              	CALL	SKIPB
  1E67'   C0                    	RNZ			; more after it
  1E68'   21 0000*              	LXI	H,TFCB
  1E6B'   CD 1E22'              	CALL	NRMDRV
  1E6E'   AF                    	XRA	A
  1E6F'   C9                    	RET
  1E70'                         PF_BAD:
  1E70'   F6 01                 	ORI	1
  1E72'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  1E73'                         CPYNM0:
  1E73'   23                    	INX	H
  1E74'                         CPYNAM:
  1E74'   CD 1E92'              	CALL	GETFNC
  1E77'   CA 1E87'              	JZ	PADFLD
  1E7A'   12                    	STAX	D
  1E7B'   13                    	INX	D
  1E7C'   0D                    	DCR	C
  1E7D'   C2 1E74'              	JNZ	CPYNAM
  1E80'                         CN_SKP:
  1E80'   CD 1E92'              	CALL	GETFNC
  1E83'   C2 1E80'              	JNZ	CN_SKP
  1E86'   C9                    	RET
  1E87'                         PADFLD:
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1E87'   F5                    	PUSH	PSW
  1E88'                         PD_LP:
  1E88'   3E 20                 	MVI	A,' '
  1E8A'   12                    	STAX	D
  1E8B'   13                    	INX	D
  1E8C'   0D                    	DCR	C
  1E8D'   C2 1E88'              	JNZ	PD_LP
  1E90'   F1                    	POP	PSW
  1E91'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  1E92'                         GETFNC:
  1E92'   7E                    	MOV	A,M
  1E93'   FE 3D                 	CPI	'='
  1E95'   C8                    	RZ
  1E96'   FE 5F                 	CPI	'_'
  1E98'   C8                    	RZ
  1E99'   FE 3B                 	CPI	';'
  1E9B'   C8                    	RZ
  1E9C'   FE 3C                 	CPI	'<'
  1E9E'   C8                    	RZ
  1E9F'   FE 3E                 	CPI	'>'
  1EA1'   C8                    	RZ
  1EA2'   FE 2E                 	CPI	'.'
  1EA4'   C8                    	RZ
  1EA5'   FE 3A                 	CPI	':'
  1EA7'   C8                    	RZ
  1EA8'   FE 2A                 	CPI	'*'
  1EAA'   C8                    	RZ
  1EAB'   FE 3F                 	CPI	'?'
  1EAD'   C8                    	RZ
  1EAE'   FE 20                 	CPI	' '
  1EB0'   DA 1EC3'              	JC	GF_CTL
  1EB3'   C8                    	RZ
  1EB4'   23                    	INX	H
  1EB5'   FE 61                 	CPI	'a'
  1EB7'   DA 1EC1'              	JC	GF_DN
  1EBA'   FE 7B                 	CPI	'z'+1
  1EBC'   D2 1EC1'              	JNC	GF_DN
  1EBF'   E6 DF                 	ANI	0DFH
