  2A24'   1596'                 	DW	VC_I
  2A26'   61                    	DB	'a'
  2A27'   159C'                 	DW	VC_A
  2A29'   41                    	DB	'A'
  2A2A'   15BC'                 	DW	VCB_A
  2A2C'   49                    	DB	'I'
  2A2D'   15D8'                 	DW	VCB_I
