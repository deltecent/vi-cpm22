  2A57'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- are cut from BUF.MAC:
                                ; RDLINE drops control characters, so no pattern could ever hold one.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
	MACRO-80 3.44	09-Dec-81	PAGE	1-131


                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  2A58'                         EXADDR:
  2A58'   AF                    	XRA	A
  2A59'   32 0000*              	STA	SRNGF
  2A5C'   7E                    	MOV	A,M
  2A5D'   FE 25                 	CPI	'%'
  2A5F'   CA 2A88'              	JZ	EXA_AL
  2A62'   EB                    	XCHG			; DE walks the line, HL takes the number
  2A63'   CD 2A9D'              	CALL	EXNUM
  2A66'   DA 2A86'              	JC	EXA_NO
  2A69'   22 0000*              	SHLD	SRNG1
  2A6C'   22 0000*              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  2A6F'   1A                    	LDAX	D
  2A70'   FE 2C                 	CPI	','
  2A72'   C2 2A7F'              	JNZ	EXA_YS
  2A75'   13                    	INX	D
  2A76'   CD 2A9D'              	CALL	EXNUM
  2A79'   DA 2A86'              	JC	EXA_NO		; ',' with no number: not a range at all
  2A7C'   22 0000*              	SHLD	SRNG2
  2A7F'                         EXA_YS:
  2A7F'   EB                    	XCHG
  2A80'   3E 01                 	MVI	A,1
  2A82'   32 0000*              	STA	SRNGF
  2A85'   C9                    	RET
  2A86'                         EXA_NO:
  2A86'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-132


  2A87'   C9                    	RET
  2A88'                         EXA_AL:
  2A88'   23                    	INX	H
  2A89'   E5                    	PUSH	H
  2A8A'   21 0001               	LXI	H,1
  2A8D'   22 0000*              	SHLD	SRNG1
  2A90'   21 FFFF               	LXI	H,0FFFFH
  2A93'   22 0000*              	SHLD	SRNG2
  2A96'   E1                    	POP	H
  2A97'   3E 01                 	MVI	A,1
  2A99'   32 0000*              	STA	SRNGF
  2A9C'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  2A9D'                         EXNUM:
  2A9D'   1A                    	LDAX	D
  2A9E'   D6 30                 	SUI	'0'
  2AA0'   D8                    	RC
  2AA1'   FE 0A                 	CPI	10
  2AA3'   3F                    	CMC
  2AA4'   D8                    	RC
  2AA5'   21 0000               	LXI	H,0
  2AA8'                         EXN_LP:
  2AA8'   1A                    	LDAX	D
  2AA9'   D6 30                 	SUI	'0'
  2AAB'   DA 2AC5'              	JC	EXN_DN
  2AAE'   FE 0A                 	CPI	10
  2AB0'   D2 2AC5'              	JNC	EXN_DN
  2AB3'   13                    	INX	D
  2AB4'   C5                    	PUSH	B
  2AB5'   4F                    	MOV	C,A
  2AB6'   06 00                 	MVI	B,0		; BC = the digit
  2AB8'   D5                    	PUSH	D
  2AB9'   54                    	MOV	D,H
  2ABA'   5D                    	MOV	E,L
  2ABB'   29                    	DAD	H		; *2
  2ABC'   29                    	DAD	H		; *4
  2ABD'   19                    	DAD	D		; *5
  2ABE'   29                    	DAD	H		; *10
  2ABF'   D1                    	POP	D
  2AC0'   09                    	DAD	B
  2AC1'   C1                    	POP	B
  2AC2'   C3 2AA8'              	JMP	EXN_LP
  2AC5'                         EXN_DN:
  2AC5'   B7                    	ORA	A		; CY clear: there was a number
  2AC6'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  2AC7'                         EX_S:
  2AC7'   7E                    	MOV	A,M
  2AC8'   B7                    	ORA	A
  2AC9'   CA 2B0B'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  2ACC'   32 0000*              	STA	SDELIM
  2ACF'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-133


  2AD0'   11 0000*              	LXI	D,SRCHST
  2AD3'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  2AD6'   4F                    	MOV	C,A
  2AD7'   CD 2B11'              	CALL	SCOPY
  2ADA'   78                    	MOV	A,B
  2ADB'   B7                    	ORA	A
  2ADC'   CA 2B0B'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  2ADF'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  2AE2'   3E 01                 	MVI	A,1
  2AE4'   32 0000*              	STA	SHAVE		; 'n' repeats it, as after a '/'
  2AE7'   11 0000*              	LXI	D,SREPL
  2AEA'   0E 24                 	MVI	C,SREPMX
  2AEC'   CD 2B11'              	CALL	SCOPY
  2AEF'   78                    	MOV	A,B
  2AF0'   32 0000*              	STA	SREPLN
  2AF3'   AF                    	XRA	A
  2AF4'   32 0000*              	STA	SGFLAG
  2AF7'   7E                    	MOV	A,M
  2AF8'   FE 67                 	CPI	'g'
  2AFA'   C2 2B03'              	JNZ	EX_SG
  2AFD'   23                    	INX	H
  2AFE'   3E 01                 	MVI	A,1
  2B00'   32 0000*              	STA	SGFLAG
  2B03'                         EX_SG:
  2B03'   7E                    	MOV	A,M
  2B04'   B7                    	ORA	A
  2B05'   C2 286F'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  2B08'   C3 2B31'              	JMP	SUBGO
  2B0B'                         SUBNOP:
  2B0B'   21 293A'              	LXI	H,SNOPAT
  2B0E'   C3 287D'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  2B11'                         SCOPY:
  2B11'   06 00                 	MVI	B,0
  2B13'                         SCP_LP:
  2B13'   78                    	MOV	A,B
  2B14'   B9                    	CMP	C
  2B15'   D2 2B2E'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  2B18'   7E                    	MOV	A,M
  2B19'   B7                    	ORA	A
  2B1A'   CA 2B2E'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  2B1D'   E5                    	PUSH	H
  2B1E'   21 0000*              	LXI	H,SDELIM
  2B21'   BE                    	CMP	M
  2B22'   E1                    	POP	H
  2B23'   CA 2B2D'              	JZ	SCP_SK
  2B26'   12                    	STAX	D
  2B27'   13                    	INX	D
  2B28'   23                    	INX	H
  2B29'   04                    	INR	B
  2B2A'   C3 2B13'              	JMP	SCP_LP
  2B2D'                         SCP_SK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-134


  2B2D'   23                    	INX	H
  2B2E'                         SCP_DN:
  2B2E'   AF                    	XRA	A
  2B2F'   12                    	STAX	D
  2B30'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  2B31'                         SUBGO:
  2B31'   CD 1401'              	CALL	GZONE
  2B34'   2A 0000*              	LHLD	LNDLT
  2B37'   22 0000*              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  2B3A'   21 0000*              	LXI	H,SOFFS		;   finds nothing puts both back, as the
  2B3D'   CD 0444'              	CALL	FPSTO		;   search's SN_BAD does
  2B40'   AF                    	XRA	A
  2B41'   32 0000*              	STA	SANY
  2B44'   21 0000               	LXI	H,0
  2B47'   22 0000*              	SHLD	SBACK
  2B4A'   3A 0000*              	LDA	SRNGF
  2B4D'   B7                    	ORA	A
  2B4E'   CA 2B60'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  2B51'   CD 23FD'              	CALL	EXRNG		; SLINES = the lines in the range
  2B54'   DA 2BDC'              	JC	SUBBAD
  2B57'   2A 0000*              	LHLD	SRNG1
  2B5A'   CD 135A'              	CALL	GOLN
  2B5D'   C3 2B66'              	JMP	SUBLP
  2B60'                         SUB_1L:
  2B60'   21 0001               	LXI	H,1
  2B63'   22 0000*              	SHLD	SLINES
  2B66'                         SUBLP:
  2B66'   CD 2BE2'              	CALL	SUBLIN		; A = 1 when this line changed
  2B69'   B7                    	ORA	A
  2B6A'   CA 2B78'              	JZ	SUB_NX
  2B6D'   3E 01                 	MVI	A,1
  2B6F'   32 0000*              	STA	SANY
  2B72'   21 0000               	LXI	H,0
  2B75'   22 0000*              	SHLD	SBACK		; the cursor is ON the last line changed
  2B78'                         SUB_NX:
  2B78'   2A 0000*              	LHLD	SLINES
  2B7B'   2B                    	DCX	H
  2B7C'   22 0000*              	SHLD	SLINES
  2B7F'   7C                    	MOV	A,H
  2B80'   B5                    	ORA	L
  2B81'   CA 2B9F'              	JZ	SUBDON		; the range is spent
  2B84'   21 0001               	LXI	H,1
  2B87'   AF                    	XRA	A
  2B88'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  2B8B'   3A 0000*              	LDA	SANY
  2B8E'   B7                    	ORA	A
  2B8F'   CA 2B99'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  2B92'   2A 0000*              	LHLD	SBACK
  2B95'   23                    	INX	H
  2B96'   22 0000*              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
	MACRO-80 3.44	09-Dec-81	PAGE	1-135


                                				;   this one, when it lands past the last line
  2B99'                         SUB_AE:
  2B99'   CD 0BF6'              	CALL	ATEOF
  2B9C'   D2 2B66'              	JNC	SUBLP		; ... unless that ran off the end of the file
  2B9F'                         SUBDON:
  2B9F'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  2BA2'   3A 0000*              	LDA	SANY
  2BA5'   B7                    	ORA	A
  2BA6'   CA 2BC4'              	JZ	SUBNFD
  2BA9'   3E 01                 	MVI	A,1
  2BAB'   32 0000*              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  2BAE'   2A 0000*              	LHLD	SBACK
  2BB1'   7C                    	MOV	A,H
  2BB2'   B5                    	ORA	L
  2BB3'   CA 2BBE'              	JZ	SUB_PL
  2BB6'   3E FF                 	MVI	A,0FFH
  2BB8'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  2BBB'   CD 0000*              	CALL	CLRCNT
  2BBE'                         SUB_PL:
  2BBE'   CD 1419'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  2BC1'   C3 08AA'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  2BC4'                         SUBNFD:
  2BC4'   21 0000*              	LXI	H,SOFFS
  2BC7'   CD 03EF'              	CALL	BACKTO
  2BCA'   2A 0000*              	LHLD	SLDLTS
  2BCD'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  2BD0'   21 290A'              	LXI	H,SNOTFD
  2BD3'   CD 287D'              	CALL	EXERR
  2BD6'   21 0000*              	LXI	H,SRCHST
  2BD9'   C3 2878'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  2BDC'                         SUBBAD:
  2BDC'   21 28F8'              	LXI	H,SNOT
  2BDF'   C3 2872'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  2BE2'                         SUBLIN:
  2BE2'   AF                    	XRA	A
  2BE3'   32 0000*              	STA	SLCHG
  2BE6'   CD 2C61'              	CALL	SUBBOL
	MACRO-80 3.44	09-Dec-81	PAGE	1-136


  2BE9'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  2BEC'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  2BEC'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  2BEF'   DA 2BF7'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  2BF2'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  2BF4'   C2 2BEC'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  2BF7'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  2BF7'   CD 0000*              	CALL	CUROFF
  2BFA'   E5                    	PUSH	H
  2BFB'   CD 1A2F'              	CALL	CEND
  2BFE'   D1                    	POP	D
  2BFF'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  2C02'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  2C03'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  2C06'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  2C07'   B7                    	ORA	A		;   span is a line, not a pair.)
  2C08'   FA 2C5A'              	JM	SUBL_D		; what is left is shorter than the pattern
  2C0B'   44                    	MOV	B,H
  2C0C'   4D                    	MOV	C,L		; BC = the start positions a match can take
  2C0D'   11 0000*              	LXI	D,SRCHST
  2C10'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  2C13'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  2C16'   DA 2C5A'              	JC	SUBL_D
  2C19'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  2C1C'   EB                    	XCHG
  2C1D'   2A 0000*              	LHLD	GAPEND
  2C20'   EB                    	XCHG
  2C21'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  2C24'   EB                    	XCHG
  2C25'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  2C26'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  2C29'   D1                    	POP	D
  2C2A'   19                    	DAD	D		; ... and so the match's logical offset
  2C2B'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  2C2E'   3A 0000*              	LDA	SANY
  2C31'   B7                    	ORA	A
  2C32'   C2 2C3F'              	JNZ	SUBL_C
  2C35'   3A 0000*              	LDA	SLCHG
  2C38'   B7                    	ORA	A
  2C39'   C2 2C3F'              	JNZ	SUBL_C
  2C3C'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  2C3F'                         SUBL_C:
  2C3F'   3A 0000*              	LDA	SRCHBF
  2C42'   6F                    	MOV	L,A
  2C43'   26 00                 	MVI	H,0
  2C45'   CD 0000*              	CALL	DELFWD		; the match goes
  2C48'   11 0000*              	LXI	D,SREPLN	; ... and the replacement takes its place, the
	MACRO-80 3.44	09-Dec-81	PAGE	1-137


  2C4B'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  2C4E'                         SUBL_I:
  2C4E'   3E 01                 	MVI	A,1
  2C50'   32 0000*              	STA	SLCHG
  2C53'   3A 0000*              	LDA	SGFLAG
  2C56'   B7                    	ORA	A
  2C57'   C2 2BF7'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  2C5A'                         SUBL_D:
  2C5A'   CD 2C61'              	CALL	SUBBOL
  2C5D'   3A 0000*              	LDA	SLCHG
  2C60'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  2C61'                         SUBBOL:
  2C61'   CD 0000*              	CALL	CUROFF
  2C64'   CD 0693'              	CALL	BOL
  2C67'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  2C6A'                         VC_SRCH:
  2C6A'   CD 086D'              	CALL	SETMOV
  2C6D'   C5                    	PUSH	B
  2C6E'   CD 0798'              	CALL	GETCNT
  2C71'   22 0000*              	SHLD	SCNT
  2C74'   C1                    	POP	B
  2C75'   79                    	MOV	A,C
  2C76'   FE 2F                 	CPI	'/'
  2C78'   3E 00                 	MVI	A,0
  2C7A'   CA 2C7F'              	JZ	VS_DIR
  2C7D'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  2C7F'                         VS_DIR:
  2C7F'   32 0000*              	STA	SDIR
  2C82'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2C85'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2C88'   47                    	MOV	B,A
  2C89'   CD 219E'              	CALL	RDLINE
  2C8C'   B7                    	ORA	A
  2C8D'   C0                    	RNZ			; cancelled: nothing happens at all
  2C8E'   3A 0000*              	LDA	PSAVE		; under an operator ('d/pat') the terminal's
  2C91'   B7                    	ORA	A		;   cursor goes back on the text: R_DCH deletes
  2C92'   C4 0000*              	CNZ	SCURS		;   wherever that cursor is
  2C95'   3A 0000*              	LDA	RLLEN
  2C98'   B7                    	ORA	A
  2C99'   CA 2CAE'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  2C9C'   5F                    	MOV	E,A
  2C9D'   16 00                 	MVI	D,0
  2C9F'   21 0000*              	LXI	H,SRCHST
  2CA2'   19                    	DAD	D
  2CA3'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  2CA5'   7B                    	MOV	A,E
  2CA6'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  2CA9'   3E 01                 	MVI	A,1
  2CAB'   32 0000*              	STA	SHAVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-138


  2CAE'                         VS_OLD:
  2CAE'   3A 0000*              	LDA	SHAVE
  2CB1'   B7                    	ORA	A
  2CB2'   CA 2CBE'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  2CB5'   3A 0000*              	LDA	SDIR
  2CB8'   32 0000*              	STA	SDIRE
  2CBB'   C3 2CE7'              	JMP	SRCHN
  2CBE'                         VS_NOP:
  2CBE'   21 293A'              	LXI	H,SNOPAT
  2CC1'   C3 287D'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  2CC4'                         VC_N:
  2CC4'   CD 086D'              	CALL	SETMOV
  2CC7'   3A 0000*              	LDA	SDIR
  2CCA'   C3 2CD4'              	JMP	VN_GO
  2CCD'                         VCB_N:
  2CCD'   CD 086D'              	CALL	SETMOV
  2CD0'   3A 0000*              	LDA	SDIR
  2CD3'   2F                    	CMA			; the other way: 0 <-> FFH
  2CD4'                         VN_GO:
  2CD4'   32 0000*              	STA	SDIRE
  2CD7'   CD 0798'              	CALL	GETCNT
  2CDA'   22 0000*              	SHLD	SCNT
  2CDD'   3A 0000*              	LDA	SHAVE
  2CE0'   B7                    	ORA	A
  2CE1'   CA 2CBE'              	JZ	VS_NOP
  2CE4'   C3 2CE7'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  2CE7'                         SRCHN:
  2CE7'   CD 1401'              	CALL	GZONE		; the screen's top line, before the cursor moves
  2CEA'   CD 07C1'              	CALL	BRKON		; where it started (the sweep moves the cursor
                                				;   with PUTCUR, which does not maintain LNDLT;
                                				;   GOTO does), and an ESC may stop it -- under an
  2CED'   3E 01                 	MVI	A,1		;   operator too: unlike 'dG', 'd/' changes nothing
  2CEF'   32 0000*              	STA	BRKARM		;   until the search is over, and a stop drops it
  2CF2'                         SN_LP:
  2CF2'   CD 2D27'              	CALL	SRCHGO
  2CF5'   DA 2D12'              	JC	SN_BAD
  2CF8'   2A 0000*              	LHLD	SCNT
  2CFB'   2B                    	DCX	H
  2CFC'   22 0000*              	SHLD	SCNT
  2CFF'   7C                    	MOV	A,H
  2D00'   B5                    	ORA	L
  2D01'   C2 2CF2'              	JNZ	SN_LP
  2D04'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  2D07'   CD 07FE'              	CALL	BRKOFF
  2D0A'   3E 01                 	MVI	A,1
  2D0C'   32 0000*              	STA	GPKEEP		; land on the match, not the first non-blank
  2D0F'   C3 1419'              	JMP	GPLACE		; (which sets LNDLT itself)
  2D12'                         SN_BAD:
  2D12'   CD 07FE'              	CALL	BRKOFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-139


  2D15'   DA 0816'              	JC	BRKBAK		; stopped, which is not the same as not found
  2D18'   CD 0809'              	CALL	RSTPL		; nothing moved: the row the cursor was on
  2D1B'   21 290A'              	LXI	H,SNOTFD
  2D1E'   CD 287D'              	CALL	EXERR
  2D21'   21 0000*              	LXI	H,SRCHST
  2D24'   C3 2878'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, paging as WM's find pages, then the rest of the
                                ; file READ where it lies (SCAN) and the window moved once, to the match --
                                ; not paged round the whole file a second time (issue #35).  CY = the pattern
                                ; is nowhere in the file, or an ESC stopped it (BRKQ says which); the cursor
                                ; is then at an end of the file, and SRCHN puts it back.
  2D27'                         SRCHGO:
  2D27'   21 0000*              	LXI	H,SGPOS
  2D2A'   CD 0444'              	CALL	FPSTO		; where this one starts: the wrapped pass ends
  2D2D'   CD 2F7D'              	CALL	SRCHW		;   there
  2D30'   D0                    	RNC
  2D31'   CD 0802'              	CALL	BRKQ
  2D34'   D8                    	RC			; stopped: no second pass
  2D35'   CD 2D42'              	CALL	SCAN
  2D38'   D8                    	RC
  2D39'   21 0000*              	LXI	H,SCHIT
  2D3C'   CD 03EF'              	CALL	BACKTO		; to the match: one move, as a mark jump
  2D3F'   C3 0802'              	JMP	BRKQ		; CY: stopped on the way there
                                
                                ;SCAN -- the wrapped pass, without moving the window: the records above it,
                                ; the window, then the records below it, through SECBUF in file order (SCNEXT).
                                ; The last bytes of each piece, a pattern less one, are kept just below
                                ; SECBUF, so a match that straddles two pieces is seen whole there.  '/'
                                ; wants the FIRST match in the file and stops reading once a match could only
                                ; start past SGPOS -- the first pass found nothing there.  '?' wants the LAST,
                                ; so it reads to the end, but skips the records that end before SCLIM: the
                                ; first pass found nothing that ends before SGPOS.  NC: SCHIT = the match's
                                ; file position.  CY: there is none, or an ESC stopped it.
  2D42'                         SCAN:
  2D42'   AF                    	XRA	A
  2D43'   32 0000*              	STA	SCFND
  2D46'   32 0000*              	STA	SCCRY
  2D49'   32 0000*              	STA	SCPH		; the records above the window first
  2D4C'   32 0002*              	STA	SCPOS+2
  2D4F'   21 0000               	LXI	H,0
  2D52'   22 0000*              	SHLD	SCIX
  2D55'   22 0000*              	SHLD	SCPOS
  2D58'   3A 0000*              	LDA	SRCHBF
  2D5B'   5F                    	MOV	E,A
  2D5C'   16 00                 	MVI	D,0		; DE = the pattern's length
  2D5E'   2A 0000*              	LHLD	SGPOS
  2D61'   3A 0000*              	LDA	SDIRE
  2D64'   B7                    	ORA	A
  2D65'   3A 0002*              	LDA	SGPOS+2
  2D68'   FA 2D71'              	JM	SC_BK
  2D6B'   19                    	DAD	D		; '/': SGPOS + the length
  2D6C'   CE 00                 	ACI	0
  2D6E'   C3 2D7B'              	JMP	SC_LIM
  2D71'                         SC_BK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-140


  2D71'   42                    	MOV	B,D
  2D72'   CD 13AE'              	CALL	SUB24		; '?': SGPOS - the length (0 if that is less)
  2D75'   D2 2D7B'              	JNC	SC_LIM
  2D78'   AF                    	XRA	A
  2D79'   67                    	MOV	H,A
  2D7A'   6F                    	MOV	L,A
  2D7B'                         SC_LIM:
  2D7B'   22 0000*              	SHLD	SCLIM
  2D7E'   32 0002*              	STA	SCLIM+2
  2D81'                         SC_LP:
  2D81'   3A 0000*              	LDA	BRKARM
  2D84'   B7                    	ORA	A
  2D85'   C4 07DB'              	CNZ	BRKTST		; an ESC, as CNTTST looks for one
  2D88'   CD 0802'              	CALL	BRKQ
  2D8B'   D8                    	RC
  2D8C'   3A 0000*              	LDA	SDIRE
  2D8F'   B7                    	ORA	A
  2D90'   FA 2DAC'              	JM	SC_RD		; '?' reads to the end
  2D93'   3A 0000*              	LDA	SCFND
  2D96'   B7                    	ORA	A
  2D97'   C0                    	RNZ			; '/': the first is all it wants (NC)
  2D98'   2A 0000*              	LHLD	SCLIM
  2D9B'   EB                    	XCHG
  2D9C'   3A 0002*              	LDA	SCLIM+2
  2D9F'   47                    	MOV	B,A
  2DA0'   2A 0000*              	LHLD	SCPOS
  2DA3'   3A 0002*              	LDA	SCPOS+2
  2DA6'   CD 13AE'              	CALL	SUB24		; NC: no match can start at SGPOS or before
  2DA9'   D2 2DB9'              	JNC	SC_END		;   from here on
  2DAC'                         SC_RD:
  2DAC'   CD 2E5C'              	CALL	SCNEXT		; SECBUF = the next piece, A = its length
  2DAF'   DA 2DB9'              	JC	SC_END		; the file has run out
  2DB2'   B7                    	ORA	A
  2DB3'   C4 2DBF'              	CNZ	SCMAT
  2DB6'   C3 2D81'              	JMP	SC_LP
  2DB9'                         SC_END:
  2DB9'   3A 0000*              	LDA	SCFND
  2DBC'   D6 01                 	SUI	1		; CY iff there is none
  2DBE'   C9                    	RET
                                
                                ;SCMAT -- look for the pattern in the A bytes in SECBUF and the carry below
                                ; it, then keep the last of them as the carry and move SCPOS past them.
  2DBF'                         SCMAT:
  2DBF'   4F                    	MOV	C,A
  2DC0'   06 00                 	MVI	B,0
  2DC2'   C5                    	PUSH	B		; the length of the piece
  2DC3'   3A 0000*              	LDA	SRCHBF
  2DC6'   67                    	MOV	H,A
  2DC7'   3A 0000*              	LDA	SCCRY
  2DCA'   81                    	ADD	C		; the carry and the piece
  2DCB'   94                    	SUB	H
  2DCC'   DA 2E23'              	JC	SCM_NO		; shorter than the pattern
  2DCF'   3C                    	INR	A
  2DD0'   4F                    	MOV	C,A		; BC = the places a match may start at
  2DD1'   11 0000*              	LXI	D,SRCHST
  2DD4'   3A 0000*              	LDA	SDIRE
	MACRO-80 3.44	09-Dec-81	PAGE	1-141


  2DD7'   B7                    	ORA	A
  2DD8'   FA 2DF5'              	JM	SCM_BK
  2DDB'   3A 0000*              	LDA	SCCRY		; '/': the first, from the carry's first byte
  2DDE'   2F                    	CMA
  2DDF'   6F                    	MOV	L,A
  2DE0'   26 FF                 	MVI	H,0FFH
  2DE2'   23                    	INX	H		; HL = - the carry
  2DE3'   D5                    	PUSH	D
  2DE4'   11 0000*              	LXI	D,SECBUF
  2DE7'   19                    	DAD	D
  2DE8'   D1                    	POP	D
  2DE9'   CD 0000*              	CALL	MATCHF
  2DEC'   DA 2E23'              	JC	SCM_NO
  2DEF'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match
  2DF2'   C3 2E06'              	JMP	SCM_HI
  2DF5'                         SCM_BK:
  2DF5'   E1                    	POP	H		; '?': the last, back from the piece's end
  2DF6'   E5                    	PUSH	H
  2DF7'   D5                    	PUSH	D
  2DF8'   11 0000*              	LXI	D,SECBUF
  2DFB'   19                    	DAD	D
  2DFC'   D1                    	POP	D
  2DFD'   CD 0000*              	CALL	SUBLEN		; the last place one can start
  2E00'   CD 0000*              	CALL	MATCHB
  2E03'   DA 2E23'              	JC	SCM_NO
  2E06'                         SCM_HI:
  2E06'   EB                    	XCHG			; DE = the match, in SECBUF or below it
  2E07'   2A 0000*              	LHLD	SCPOS
  2E0A'   19                    	DAD	D
  2E0B'   3A 0002*              	LDA	SCPOS+2
  2E0E'   CE 00                 	ACI	0
  2E10'   11 0000*              	LXI	D,SECBUF
  2E13'   06 00                 	MVI	B,0
  2E15'   CD 13AE'              	CALL	SUB24		; its file position
  2E18'   22 0000*              	SHLD	SCHIT
  2E1B'   32 0002*              	STA	SCHIT+2
  2E1E'   3E 01                 	MVI	A,1
  2E20'   32 0000*              	STA	SCFND
  2E23'                         SCM_NO:
  2E23'   C1                    	POP	B		; BC = the piece's length
  2E24'   C5                    	PUSH	B
  2E25'   3A 0000*              	LDA	SCCRY
  2E28'   81                    	ADD	C
  2E29'   5F                    	MOV	E,A		; the carry and the piece
  2E2A'   3A 0000*              	LDA	SRCHBF
  2E2D'   3D                    	DCR	A		; ... of which a pattern less one is kept
  2E2E'   BB                    	CMP	E
  2E2F'   DA 2E33'              	JC	SCM_T
  2E32'   7B                    	MOV	A,E
  2E33'                         SCM_T:
  2E33'   32 0000*              	STA	SCCRY
  2E36'   5F                    	MOV	E,A
  2E37'   16 00                 	MVI	D,0		; DE = the new carry
  2E39'   21 0000*              	LXI	H,SECBUF
  2E3C'   09                    	DAD	B
  2E3D'   CD 0000*              	CALL	SUBHD		; the bytes it keeps
	MACRO-80 3.44	09-Dec-81	PAGE	1-142


  2E40'   E5                    	PUSH	H
  2E41'   21 0000*              	LXI	H,SECBUF
  2E44'   CD 0000*              	CALL	SUBHD		; where they go
  2E47'   42                    	MOV	B,D
  2E48'   4B                    	MOV	C,E
  2E49'   EB                    	XCHG
  2E4A'   E1                    	POP	H
  2E4B'   CD 0000*              	CALL	MEMCPY		; (down, so a forward copy is safe)
  2E4E'   D1                    	POP	D		; the piece's length
                                ;SCADV -- SCPOS += DE.
  2E4F'                         SCADV:
  2E4F'   2A 0000*              	LHLD	SCPOS
  2E52'   19                    	DAD	D
  2E53'   22 0000*              	SHLD	SCPOS
  2E56'   D0                    	RNC
  2E57'   21 0002*              	LXI	H,SCPOS+2
  2E5A'   34                    	INR	M
  2E5B'   C9                    	RET
                                
                                ;SCNEXT -- the next piece of the file into SECBUF: A = its length, which is 0
                                ; for a record skipped.  CY: the file has run out.  SCPH is what it is in:
                                ; 0 the records above the window, 1 the window before the gap, 2 after it,
                                ; 3 VIBACKUP.$$$ (top down), 4 the source below, 5 nothing left.
  2E5C'                         SCNEXT:
  2E5C'   3A 0000*              	LDA	SCPH
  2E5F'   B7                    	ORA	A
  2E60'   CA 2E72'              	JZ	SN_AB
  2E63'   FE 03                 	CPI	3
  2E65'   DA 2EA0'              	JC	SN_GP
  2E68'   CA 2F16'              	JZ	SN_BAK
  2E6B'   FE 04                 	CPI	4
  2E6D'   CA 2F30'              	JZ	SN_SRC
  2E70'   37                    	STC
  2E71'   C9                    	RET
  2E72'                         SN_AB:
  2E72'   2A 0000*              	LHLD	OUTPOS
  2E75'   EB                    	XCHG
  2E76'   2A 0000*              	LHLD	SCIX
  2E79'   CD 0000*              	CALL	CMP16
  2E7C'   CA 2E8A'              	JZ	SN_W0		; all of them read: the window
  2E7F'   23                    	INX	H
  2E80'   22 0000*              	SHLD	SCIX
  2E83'   2B                    	DCX	H
  2E84'   AF                    	XRA	A		; above the window
  2E85'   CD 2F47'              	CALL	SN_REC
  2E88'   B7                    	ORA	A
  2E89'   C9                    	RET
  2E8A'                         SN_W0:
  2E8A'   2A 0000*              	LHLD	TXTBEG
  2E8D'   EB                    	XCHG
  2E8E'   2A 0000*              	LHLD	GAPBEG
  2E91'   3E 01                 	MVI	A,1
  2E93'                         SN_PH:				; phase A, from DE up to HL
  2E93'   32 0000*              	STA	SCPH
  2E96'   22 0000*              	SHLD	SCEND
  2E99'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-143


  2E9A'   22 0000*              	SHLD	SCIX
  2E9D'   C3 2E5C'              	JMP	SCNEXT
  2EA0'                         SN_GP:				; the window: up to 128 bytes of it, copied
  2EA0'   2A 0000*              	LHLD	SCIX
  2EA3'   EB                    	XCHG
  2EA4'   2A 0000*              	LHLD	SCEND
  2EA7'   CD 0000*              	CALL	SUBHD		; HL = what is left of this part
  2EAA'   7C                    	MOV	A,H
  2EAB'   B5                    	ORA	L
  2EAC'   CA 2ED1'              	JZ	SN_GPX
  2EAF'   7C                    	MOV	A,H
  2EB0'   B7                    	ORA	A
  2EB1'   C2 2EBA'              	JNZ	SN_128
  2EB4'   7D                    	MOV	A,L
  2EB5'   FE 81                 	CPI	81H
  2EB7'   DA 2EBD'              	JC	SN_GPN
  2EBA'                         SN_128:
  2EBA'   21 0080               	LXI	H,80H
  2EBD'                         SN_GPN:
  2EBD'   E5                    	PUSH	H
  2EBE'   44                    	MOV	B,H
  2EBF'   4D                    	MOV	C,L
  2EC0'   EB                    	XCHG
  2EC1'   E5                    	PUSH	H
  2EC2'   11 0000*              	LXI	D,SECBUF
  2EC5'   CD 0000*              	CALL	MEMCPY
  2EC8'   E1                    	POP	H
  2EC9'   C1                    	POP	B
  2ECA'   09                    	DAD	B
  2ECB'   22 0000*              	SHLD	SCIX
  2ECE'   79                    	MOV	A,C
  2ECF'   B7                    	ORA	A
  2ED0'   C9                    	RET
  2ED1'                         SN_GPX:
  2ED1'   3A 0000*              	LDA	SCPH
  2ED4'   FE 02                 	CPI	2
  2ED6'   CA 2EE5'              	JZ	SN_BLW
  2ED9'   2A 0000*              	LHLD	GAPEND
  2EDC'   EB                    	XCHG
  2EDD'   2A 0000*              	LHLD	TXTEND
  2EE0'   3E 02                 	MVI	A,2
  2EE2'   C3 2E93'              	JMP	SN_PH
  2EE5'                         SN_BLW:				; below the window: VIBACKUP.$$$ if it holds
  2EE5'   3A 0000*              	LDA	BAKRDY		;   anything, as RDIN reads it first
  2EE8'   B7                    	ORA	A
  2EE9'   CA 2EFF'              	JZ	SN_S0
  2EEC'   2A 0000*              	LHLD	BAKPOS
  2EEF'   7C                    	MOV	A,H
  2EF0'   B5                    	ORA	L
  2EF1'   CA 2EFF'              	JZ	SN_S0
  2EF4'   22 0000*              	SHLD	SCIX
  2EF7'   3E 03                 	MVI	A,3
  2EF9'   32 0000*              	STA	SCPH
  2EFC'   C3 2E5C'              	JMP	SCNEXT
  2EFF'                         SN_S0:				; then the source, from where it is read to
  2EFF'   3A 005B               	LDA	5BH
	MACRO-80 3.44	09-Dec-81	PAGE	1-144


  2F02'   B7                    	ORA	A
  2F03'   3E 05                 	MVI	A,5
  2F05'   CA 2F10'              	JZ	SN_END
  2F08'   2A 007E               	LHLD	7EH
  2F0B'   22 0000*              	SHLD	SCIX
  2F0E'   3E 04                 	MVI	A,4
  2F10'                         SN_END:
  2F10'   32 0000*              	STA	SCPH
  2F13'   C3 2E5C'              	JMP	SCNEXT
  2F16'                         SN_BAK:
  2F16'   2A 0000*              	LHLD	SCIX
  2F19'   7C                    	MOV	A,H
  2F1A'   B5                    	ORA	L
  2F1B'   CA 2EFF'              	JZ	SN_S0		; record 0 read
  2F1E'   2B                    	DCX	H
  2F1F'   22 0000*              	SHLD	SCIX
  2F22'   3E 01                 	MVI	A,1
  2F24'   CD 2F47'              	CALL	SN_REC
  2F27'   D0                    	RNC
  2F28'   21 0000               	LXI	H,0		; a ^Z: the stack ends there (RDIN's IOEOF)
  2F2B'   22 0000*              	SHLD	SCIX
  2F2E'   B7                    	ORA	A
  2F2F'   C9                    	RET
  2F30'                         SN_SRC:
  2F30'   2A 0000*              	LHLD	SCIX
  2F33'   23                    	INX	H
  2F34'   22 0000*              	SHLD	SCIX
  2F37'   2B                    	DCX	H
  2F38'   3E 02                 	MVI	A,2
  2F3A'   CD 2F47'              	CALL	SN_REC
  2F3D'   D0                    	RNC
  2F3E'   F5                    	PUSH	PSW		; a ^Z or no record: the end of the file
  2F3F'   3E 05                 	MVI	A,5
  2F41'   32 0000*              	STA	SCPH
  2F44'   F1                    	POP	PSW
  2F45'   B7                    	ORA	A
  2F46'   C9                    	RET
                                
                                ;SN_REC -- SCNREC (record HL, kind A), unless it is a '?' record that ends
                                ; before SCLIM, which is skipped: SCPOS moves past it and the carry goes (a
                                ; record is 128 bytes until the last, and that one is never skipped).
  2F47'                         SN_REC:
  2F47'   F5                    	PUSH	PSW
  2F48'   E5                    	PUSH	H
  2F49'   3A 0000*              	LDA	SDIRE
  2F4C'   B7                    	ORA	A
  2F4D'   F2 2F78'              	JP	SN_RD		; '/' never skips
  2F50'   2A 0000*              	LHLD	SCPOS
  2F53'   11 0080               	LXI	D,80H
  2F56'   19                    	DAD	D
  2F57'   EB                    	XCHG
  2F58'   3A 0002*              	LDA	SCPOS+2
  2F5B'   CE 00                 	ACI	0
  2F5D'   47                    	MOV	B,A		; B:DE = past this record
  2F5E'   2A 0000*              	LHLD	SCLIM
  2F61'   3A 0002*              	LDA	SCLIM+2
	MACRO-80 3.44	09-Dec-81	PAGE	1-145


  2F64'   CD 13AE'              	CALL	SUB24		; NC: it ends at SCLIM or before
  2F67'   DA 2F78'              	JC	SN_RD
  2F6A'   E1                    	POP	H
  2F6B'   F1                    	POP	PSW
  2F6C'   AF                    	XRA	A
  2F6D'   32 0000*              	STA	SCCRY
  2F70'   11 0080               	LXI	D,80H
  2F73'   CD 2E4F'              	CALL	SCADV
  2F76'   AF                    	XRA	A		; nothing to look at, NC
  2F77'   C9                    	RET
  2F78'                         SN_RD:
  2F78'   E1                    	POP	H
  2F79'   F1                    	POP	PSW
  2F7A'   C3 0000*              	JMP	SCNREC
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller reads the rest of the file or restores the cursor outright.
  2F7D'                         SRCHW:
  2F7D'   3A 0000*              	LDA	SDIRE
  2F80'   32 0000*              	STA	DIRFLG
  2F83'   21 FFFF               	LXI	H,0FFFFH
  2F86'   22 0000*              	SHLD	CMDCNT
  2F89'   AF                    	XRA	A
  2F8A'   32 0000*              	STA	AUXCNT
  2F8D'                         SW_LP:
  2F8D'   CD 0802'              	CALL	BRKQ		; an ESC spent the count, here or on the way to
  2F90'   D8                    	RC			;   the wrapped pass: SCRLST no longer pages
  2F91'   CD 2F9D'              	CALL	SRCH1
  2F94'   D0                    	RNC
  2F95'   CD 0000*              	CALL	SCRLST
  2F98'   D2 2F8D'              	JNC	SW_LP
  2F9B'   37                    	STC
  2F9C'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  2F9D'                         SRCH1:
  2F9D'   11 0000*              	LXI	D,SRCHST
  2FA0'   3A 0000*              	LDA	DIRFLG
  2FA3'   B7                    	ORA	A
  2FA4'   FA 2FC1'              	JM	SR1_BK
  2FA7'   21 0000*              	LXI	H,GAPEND
  2FAA'   CD 0000*              	CALL	FWDCNT
  2FAD'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  2FB0'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  2FB1'   78                    	MOV	A,B
  2FB2'   B1                    	ORA	C
  2FB3'   37                    	STC
	MACRO-80 3.44	09-Dec-81	PAGE	1-146


  2FB4'   C8                    	RZ			; no room for a match even before the skip
  2FB5'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2FB6'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2FB7'   CD 0000*              	CALL	MATCHF
  2FBA'   D8                    	RC
  2FBB'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2FBE'   C3 0000*              	JMP	PUTCUR
  2FC1'                         SR1_BK:
  2FC1'   21 0000*              	LXI	H,TXTBEG
  2FC4'   CD 0000*              	CALL	FWDCNT
  2FC7'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2FCA'   D8                    	RC
  2FCB'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2FCE'   CD 0000*              	CALL	MATCHB
  2FD1'   D8                    	RC
  2FD2'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2FD5'                         MSGNAM:
  2FD5'   E5                    	PUSH	H
  2FD6'   3E 22                 	MVI	A,'"'
  2FD8'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  2FDB'   E1                    	POP	H
  2FDC'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  2FDD'   23                    	INX	H
  2FDE'   7E                    	MOV	A,M
  2FDF'   FE 20                 	CPI	' '
  2FE1'   C2 2FEE'              	JNZ	MN_HAS
  2FE4'   21 29C8'              	LXI	H,SNONM
  2FE7'   CD 0000*              	CALL	OUTSTR
  2FEA'   E1                    	POP	H
  2FEB'   C3 3038'              	JMP	MN_END
  2FEE'                         MN_HAS:
  2FEE'   0E 19                 	MVI	C,BF_CURDSK
  2FF0'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
