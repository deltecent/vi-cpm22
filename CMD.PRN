                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the current row is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; current line changed only -> redraw that one row
  0003                   C      R_DLIN	EQU	3		; one line deleted at the cursor row -> DL + redraw bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted mid-line -> ICH (no tail redraw)
  0005                   C      R_ILIN	EQU	5		; one line opened at the cursor row -> IL + redraw that row and the one above
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw that row + DL the one under it
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: its offset, then PGTOPM when it was set
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      
                         C      ;------------------------------------------------------------
                         C      ; KEY DECODER -- GETKEY return types (B) and action codes (C when B=KT_ACT).
                         C      ; See KEY.MAC.
                         C      ;------------------------------------------------------------
  0000                   C      KT_NONE EQU	0		; no key (unrecognised ESC sequence, discarded)
  0001                   C      KT_ACT	EQU	1		; C = ACT_xxx action code
  0002                   C      KT_CHAR EQU	2		; C = ASCII character (printable or control)
                         C      
  0001                   C      ACT_CURUP EQU	1		; cursor up    (ESC[A / ESC OA)
  0002                   C      ACT_CURDN EQU	2		; cursor down  (ESC[B / ESC OB)
  0003                   C      ACT_CURRT EQU	3		; cursor right (ESC[C / ESC OC)
  0004                   C      ACT_CURLT EQU	4		; cursor left  (ESC[D / ESC OD)
  0005                   C      ACT_LINST EQU	5		; Home / line start (ESC[H / ESC[1~)
  0006                   C      ACT_LINEN EQU	6		; End  / line end   (ESC[F / ESC[4~)
  0007                   C      ACT_PGUP  EQU	7		; page up   (ESC[5~)
  0008                   C      ACT_PGDN  EQU	8		; page down (ESC[6~)
  0009                   C      ACT_INS	  EQU	9		; Insert key (ESC[2~)
  000A                   C      ACT_DEL	  EQU	10		; Delete key (ESC[3~)
  000B                   C      ACT_ESC	  EQU	11		; lone ESC (after timeout)
  000B                   C      ACT_MAX	  EQU	11		; highest defined action code
                         C      
  01F4                   C      ESCTMO	EQU	500		; polls before a lone ESC is confirmed
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	COL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
                                	EXTRN	SCBOT, SCEOF, SCBOF, WFILL	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	DELLN, SETC0			; BUF.MAC -- WM line kill (dd)
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   CD 00D9'              	CALL	DOTPRE
  0003'   CD 0009'              	CALL	CDMODE
  0006'   C3 0130'              	JMP	DOTPOST
  0009'                         CDMODE:
  0009'   3A 23E1'              	LDA	EDMODE
  000C'   FE 01                 	CPI	EM_INS
  000E'   CA 0019'              	JZ	CD_INS
  0011'   FE 02                 	CPI	EM_REP
  0013'   CA 001C'              	JZ	CD_REP
  0016'   C3 001F'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  0019'                         CD_INS:
  0019'   C3 17AF'              	JMP	VIINS
  001C'                         CD_REP:
  001C'   C3 16EF'              	JMP	VIREP
                                
                                ;============================================================
                                ; VICMD -- command-mode key.  B = KT type, C = char / action.
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  001F'                         VICMD:
  001F'   78                    	MOV	A,B
  0020'   FE 00                 	CPI	KT_NONE
  0022'   C8                    	RZ			; discarded key
  0023'   FE 01                 	CPI	KT_ACT
  0025'   CA 00AB'              	JZ	VIC_ACT
  0028'   3A 2409'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002B'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  002D'   CA 1352'              	JZ	VR_DO
                                	;--- KT_CHAR: maybe a count digit ---
  0030'   79                    	MOV	A,C
  0031'   FE 31                 	CPI	'1'
  0033'   DA 003E'              	JC	VIC_NOTD	; < '1'
  0036'   FE 3A                 	CPI	'9'+1
  0038'   D2 003E'              	JNC	VIC_NOTD	; > '9'
  003B'   C3 004E'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  003E'                         VIC_NOTD:
  003E'   79                    	MOV	A,C
  003F'   FE 30                 	CPI	'0'
  0041'   C2 0076'              	JNZ	VICDSP
  0044'   2A 23E2'              	LHLD	CMDCNT
  0047'   7C                    	MOV	A,H
  0048'   B5                    	ORA	L
  0049'   CA 0076'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  004C'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  004E'                         VICDIG:
  004E'   2A 23E2'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0051'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0052'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0053'   29                    	DAD	H		; *2
  0054'   DA 006D'              	JC	VIC_SAT
  0057'   29                    	DAD	H		; *4
  0058'   DA 006D'              	JC	VIC_SAT
  005B'   19                    	DAD	D		; *5
  005C'   DA 006D'              	JC	VIC_SAT
  005F'   29                    	DAD	H		; *10
  0060'   DA 006D'              	JC	VIC_SAT
  0063'   79                    	MOV	A,C
  0064'   D6 30                 	SUI	'0'
  0066'   5F                    	MOV	E,A
  0067'   16 00                 	MVI	D,0
  0069'   19                    	DAD	D
  006A'   D2 0070'              	JNC	VIC_CNT
  006D'                         VIC_SAT:
  006D'   21 FFFF               	LXI	H,0FFFFH
  0070'                         VIC_CNT:
  0070'   22 23E2'              	SHLD	CMDCNT
  0073'   C3 060D'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  0076'                         VICDSP:
  0076'   3A 2409'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  0079'   32 240A'              	STA	GSAVE
  007C'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  007D'   32 2409'              	STA	GPEND
  0080'   3A 240B'              	LDA	PENDOP
  0083'   32 240C'              	STA	PSAVE
  0086'   AF                    	XRA	A
  0087'   32 240B'              	STA	PENDOP
  008A'   3A 240C'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  008D'   B7                    	ORA	A
  008E'   C2 0EE7'              	JNZ	OPPEND
  0091'   3A 240A'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0094'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  0096'   C2 009F'              	JNZ	VIC_TB
  0099'   79                    	MOV	A,C
  009A'   FE 5A                 	CPI	'Z'
  009C'   C2 00A5'              	JNZ	VIC_SW
  009F'                         VIC_TB:
  009F'   21 2310'              	LXI	H,CMDTAB
  00A2'   C3 00BE'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A5'                         VIC_SW:
  00A5'   CD 060D'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00A8'   C3 05A0'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AB'                         VIC_ACT:
  00AB'   AF                    	XRA	A		; action key clears all pending state
  00AC'   32 2409'              	STA	GPEND
  00AF'   32 240A'              	STA	GSAVE
  00B2'   32 240B'              	STA	PENDOP
  00B5'   32 240C'              	STA	PSAVE
  00B8'   21 23C8'              	LXI	H,ACTTAB
  00BB'   C3 00BE'              	JMP	VSCANQ
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the two TOP-LEVEL key tables, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00BE'                         VSCANQ:
  00BE'   CD 00CA'              	CALL	VSCLK
  00C1'   CA 00A5'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C4'   E9                    	PCHL
  00C5'                         VSCAN:
  00C5'   CD 00CA'              	CALL	VSCLK
  00C8'   C8                    	RZ			; miss
  00C9'   E9                    	PCHL
  00CA'                         VSCLK:
  00CA'   7E                    VSCAN1: MOV	A,M
  00CB'   B7                    	ORA	A
  00CC'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00CD'   23                    	INX	H
  00CE'   B9                    	CMP	C
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00CF'   5E                    	MOV	E,M
  00D0'   23                    	INX	H
  00D1'   56                    	MOV	D,M
  00D2'   23                    	INX	H
  00D3'   C2 00CA'              	JNZ	VSCAN1
  00D6'   EB                    	XCHG			; HL = the handler
  00D7'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00D8'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00D9'                         DOTPRE:
  00D9'   3A 2400'              	LDA	DOTRPL
  00DC'   B7                    	ORA	A
  00DD'   C0                    	RNZ			; the replay's own keys are not recorded
  00DE'   C5                    	PUSH	B
  00DF'   D5                    	PUSH	D
  00E0'   E5                    	PUSH	H
  00E1'   3A 23FF'              	LDA	DOTSTA
  00E4'   B7                    	ORA	A
  00E5'   CA 00F8'              	JZ	DOTP1
  00E8'   AF                    	XRA	A		; a new command: the recording starts over
  00E9'   32 23FF'              	STA	DOTSTA
  00EC'   32 2401'              	STA	DOTOVF
  00EF'   21 0000*              	LXI	H,DOTSCR
  00F2'   22 2403'              	SHLD	DOTSP
  00F5'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00F8'                         DOTP1:
  00F8'   78                    	MOV	A,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00F9'   FE 00                 	CPI	KT_NONE
  00FB'   CA 0124'              	JZ	DOTPX		; a discarded key is not a keystroke
  00FE'   FE 01                 	CPI	KT_ACT
  0100'   79                    	MOV	A,C
  0101'   CA 0109'              	JZ	DOTP2
  0104'   E6 7F                 	ANI	7FH		; a char stands for itself (CPYGAP masks inserts
  0106'   C3 010B'              	JMP	DOTP3		;   the same way), bit 7 marks an action key
  0109'                         DOTP2:
  0109'   F6 80                 	ORI	80H		; an action key (an arrow) rides in bit 7
  010B'                         DOTP3:
  010B'   32 2402'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  010E'   47                    	MOV	B,A
  010F'   2A 2403'              	LHLD	DOTSP
  0112'   EB                    	XCHG
  0113'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  0116'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  0119'   D2 0128'              	JNC	DOTPOV
  011C'   2A 2403'              	LHLD	DOTSP
  011F'   70                    	MOV	M,B
  0120'   23                    	INX	H
  0121'   22 2403'              	SHLD	DOTSP
  0124'                         DOTPX:
  0124'   E1                    	POP	H
  0125'   D1                    	POP	D
  0126'   C1                    	POP	B
  0127'   C9                    	RET
  0128'                         DOTPOV:
  0128'   3E 01                 	MVI	A,1
  012A'   32 2401'              	STA	DOTOVF		; too long to record: give this recording up
  012D'   C3 0124'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  0130'                         DOTPOST:
  0130'   3A 2400'              	LDA	DOTRPL
  0133'   B7                    	ORA	A
  0134'   C0                    	RNZ
  0135'   3A 23E1'              	LDA	EDMODE
  0138'   B7                    	ORA	A
  0139'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  013A'   3A 2409'              	LDA	GPEND
  013D'   B7                    	ORA	A
  013E'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  013F'   3A 240B'              	LDA	PENDOP
  0142'   B7                    	ORA	A
  0143'   C0                    	RNZ			; an operator still waiting for its motion
  0144'   2A 23E2'              	LHLD	CMDCNT
  0147'   7C                    	MOV	A,H
  0148'   B5                    	ORA	L
  0149'   CA 0157'              	JZ	DOTQ1
  014C'   3A 2402'              	LDA	DOTLK		; a digit with the count still up: the command
  014F'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  0151'   DA 0157'              	JC	DOTQ1
  0154'   FE 3A                 	CPI	'9'+1
  0156'   D8                    	RC
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0157'                         DOTQ1:
  0157'   3E 01                 	MVI	A,1
  0159'   32 23FF'              	STA	DOTSTA		; the next key starts a new recording
  015C'   3A 23FE'              	LDA	DOTCHG
  015F'   B7                    	ORA	A
  0160'   C8                    	RZ			; changed nothing: not a repeatable command
  0161'   AF                    	XRA	A
  0162'   32 23FE'              	STA	DOTCHG
  0165'   32 2405'              	STA	DOTLEN
  0168'   3A 2401'              	LDA	DOTOVF
  016B'   B7                    	ORA	A
  016C'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  016D'   2A 2403'              	LHLD	DOTSP
  0170'   11 0000*              	LXI	D,DOTSCR
  0173'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  0176'   7D                    	MOV	A,L
  0177'   32 2405'              	STA	DOTLEN
  017A'   B7                    	ORA	A
  017B'   C8                    	RZ
  017C'   4F                    	MOV	C,A
  017D'   06 00                 	MVI	B,0
  017F'   21 0000*              	LXI	H,DOTSCR
  0182'   11 0000*              	LXI	D,DOTBUF
  0185'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  0188'                         MARKMOD:
  0188'   CD 03E3'              	CALL	MKDROP		; any mark this edit leaves pointing wrong
  018B'   3E 01                 	MVI	A,1
  018D'   32 23E5'              	STA	MODF
  0190'   32 23FE'              	STA	DOTCHG
  0193'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  0194'                         VC_DOT:
  0194'   2A 23E2'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0197'   22 2407'              	SHLD	DOTNCT
  019A'   21 0000               	LXI	H,0
  019D'   22 23E2'              	SHLD	CMDCNT
  01A0'   3A 2405'              	LDA	DOTLEN
  01A3'   B7                    	ORA	A
  01A4'   CA 01FE'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
  01A7'   AF                    	XRA	A
  01A8'   32 2406'              	STA	DOTIX
  01AB'   2A 2407'              	LHLD	DOTNCT
  01AE'   7C                    	MOV	A,H
  01AF'   B5                    	ORA	L
  01B0'   CA 01D0'              	JZ	DOTGO
  01B3'   22 23E2'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  01B6'                         DOTSKP:
  01B6'   CD 0479'              	CALL	DOTGET		; ... so step past the digits it recorded
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01B9'   DA 01D0'              	JC	DOTGO
  01BC'   FE 30                 	CPI	'0'
  01BE'   DA 01D0'              	JC	DOTGO
  01C1'   FE 3A                 	CPI	'9'+1
  01C3'   D2 01D0'              	JNC	DOTGO
  01C6'   3A 2406'              	LDA	DOTIX
  01C9'   3C                    	INR	A
  01CA'   32 2406'              	STA	DOTIX
  01CD'   C3 01B6'              	JMP	DOTSKP
  01D0'                         DOTGO:
  01D0'   3E 01                 	MVI	A,1
  01D2'   32 2400'              	STA	DOTRPL
  01D5'                         DOTLP:
  01D5'   CD 0479'              	CALL	DOTGET
  01D8'   DA 01F4'              	JC	DOTDN
  01DB'   4F                    	MOV	C,A
  01DC'   06 02                 	MVI	B,KT_CHAR
  01DE'   B7                    	ORA	A
  01DF'   F2 01E7'              	JP	DOTLP2
  01E2'   E6 7F                 	ANI	7FH		; bit 7: the key was an action, not a char
  01E4'   4F                    	MOV	C,A
  01E5'   06 01                 	MVI	B,KT_ACT
  01E7'                         DOTLP2:
  01E7'   3A 2406'              	LDA	DOTIX
  01EA'   3C                    	INR	A
  01EB'   32 2406'              	STA	DOTIX
  01EE'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01F1'   C3 01D5'              	JMP	DOTLP
  01F4'                         DOTDN:
  01F4'   AF                    	XRA	A
  01F5'   32 2400'              	STA	DOTRPL
  01F8'   32 23FE'              	STA	DOTCHG		; the '.' is not itself the new last change
  01FB'   C3 062E'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01FE'                         DOTBEL:
  01FE'   0E 07                 	MVI	C,BEL
  0200'   CD 0000*              	CALL	BCONOU
  0203'   C3 060D'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a logical offset plus the PGTOPM the window carried when it was
                                ; set.  It is DROPPED, never shifted, the moment it could no longer point at
                                ; the same text: MKDROP clears it when an edit happens at or before it, and a
                                ; jump refuses when the window has paged since.  That is the decided
                                ; behaviour -- a mark that survived an edit above it would point somewhere
                                ; plausible and wrong, which is worse than one that admits it is gone.
                                ;
                                ; DEVIATION from vim, deliberate and in COMMANDS.md: vim shifts a mark to
                                ; follow the text.  A consequence worth knowing is that '.' after a 'd''a'
                                ; refuses, because the delete drops the very mark the replay would need.
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  0206'                         MKVAD:
  0206'   16 00                 	MVI	D,0
  0208'   59                    	MOV	E,C
  0209'   21 2464'              	LXI	H,MKVAL
  020C'   19                    	DAD	D
  020D'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  020E'                         MKCLR:
  020E'   21 2464'              	LXI	H,MKVAL
  0211'   06 03                 	MVI	B,MKMAX
  0213'   AF                    	XRA	A
  0214'                         MKC_LP:
  0214'   77                    	MOV	M,A
  0215'   23                    	INX	H
  0216'   05                    	DCR	B
  0217'   C2 0214'              	JNZ	MKC_LP
  021A'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was not a character.
  021B'                         MKGETK:
  021B'   3A 2400'              	LDA	DOTRPL
  021E'   B7                    	ORA	A
  021F'   CA 0230'              	JZ	MKG_KB
  0222'   CD 0479'              	CALL	DOTGET		; the recording's next key
  0225'   D8                    	RC
  0226'   4F                    	MOV	C,A
  0227'   3A 2406'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  022A'   3C                    	INR	A
  022B'   32 2406'              	STA	DOTIX
  022E'   B7                    	ORA	A		; CY clear
  022F'   C9                    	RET
  0230'                         MKG_KB:
  0230'   CD 0000*              	CALL	GETKEY
  0233'   78                    	MOV	A,B
  0234'   FE 02                 	CPI	KT_CHAR
  0236'   37                    	STC
  0237'   C0                    	RNZ			; an action key (ESC) cancels the command
  0238'   B7                    	ORA	A		; CY clear
  0239'   C9                    	RET
                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
                                ; the motion returns.  Unlike the marks, the character is then handed to
                                ; DOTPRE, so it joins the recording and '.' can repeat "dfa" -- MKGETK's
                                ; keyboard path does not record for itself.
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
                                ;============================================================
  023A'                         VC_FF:				; 'f' -- forward, onto the character
  023A'   3E 66                 	MVI	A,'f'
  023C'   C3 024B'              	JMP	FNDNEW
  023F'                         VC_FB:				; 'F' -- backward, onto it
  023F'   3E 46                 	MVI	A,'F'
  0241'   C3 024B'              	JMP	FNDNEW
  0244'                         VC_TF:				; 't' -- forward, up to it
  0244'   3E 74                 	MVI	A,'t'
  0246'   C3 024B'              	JMP	FNDNEW
  0249'                         VC_TB:				; 'T' -- backward, up to it
  0249'   3E 54                 	MVI	A,'T'
  024B'                         FNDNEW:
  024B'   32 2459'              	STA	FNDKND		; the find ';' and ',' will repeat
  024E'   CD 021B'              	CALL	MKGETK		; the character it looks for
  0251'   DA 0288'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0254'   79                    	MOV	A,C
  0255'   32 245A'              	STA	FNDCH
  0258'   06 02                 	MVI	B,KT_CHAR	; ... and into the '.' recording (see the head)
  025A'   CD 00D9'              	CALL	DOTPRE
  025D'   3A 2459'              	LDA	FNDKND
  0260'   06 01                 	MVI	B,1		; a find starts at the next character along
  0262'   C3 028F'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0265'                         VC_SEMI:
  0265'   3A 2459'              	LDA	FNDKND
  0268'   B7                    	ORA	A
  0269'   CA 0288'              	JZ	FNDNIL		; nothing has been looked for yet
  026C'   C3 0278'              	JMP	FNDREP
  026F'                         VC_COMMA:
  026F'   3A 2459'              	LDA	FNDKND
  0272'   B7                    	ORA	A
  0273'   CA 0288'              	JZ	FNDNIL
  0276'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0278'                         FNDREP:
  0278'   06 01                 	MVI	B,1
  027A'   F5                    	PUSH	PSW
  027B'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  027D'   FE 54                 	CPI	'T'
  027F'   C2 0284'              	JNZ	FNDR_GO
  0282'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  0284'                         FNDR_GO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  0284'   F1                    	POP	PSW
  0285'   C3 028F'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
  0288'                         FNDNIL:
  0288'   AF                    	XRA	A
  0289'   32 240C'              	STA	PSAVE
  028C'   C3 060D'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  028F'                         FNDGO:
  028F'   32 245B'              	STA	FNDRUN
  0292'   78                    	MOV	A,B
  0293'   32 245C'              	STA	FNDSTP
  0296'   CD 058D'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
  0299'   22 245D'              	SHLD	FNDN		; the occurrence wanted
  029C'   CD 0000*              	CALL	CUROFF
  029F'   22 245F'              	SHLD	FNDCUR
  02A2'   3A 245B'              	LDA	FNDRUN
  02A5'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  02A7'   CA 02DB'              	JZ	FNDBWD
  02AA'   2A 245F'              	LHLD	FNDCUR
  02AD'   CD 0538'              	CALL	EOLC		; HL = the line's last content character
  02B0'   22 2461'              	SHLD	FNDLIM
  02B3'   2A 245F'              	LHLD	FNDCUR
  02B6'   3A 245C'              	LDA	FNDSTP
  02B9'   5F                    	MOV	E,A
  02BA'   16 00                 	MVI	D,0
  02BC'   19                    	DAD	D		; HL = where the scan starts
  02BD'                         FNDF_LP:
  02BD'   EB                    	XCHG			; DE = the scan
  02BE'   2A 2461'              	LHLD	FNDLIM
  02C1'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  02C4'   EB                    	XCHG			; HL = the scan
  02C5'   CA 02CB'              	JZ	FNDF_AT		; the last character is still a candidate
  02C8'   D2 032D'              	JNC	FNDMIS		; past it: not on this line
  02CB'                         FNDF_AT:
  02CB'   CD 0334'              	CALL	FNDSEE		; Z iff this is the character
  02CE'   C2 02D7'              	JNZ	FNDF_NX
  02D1'   CD 033F'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02D4'   CA 0313'              	JZ	FNDHIT
  02D7'                         FNDF_NX:
  02D7'   23                    	INX	H
  02D8'   C3 02BD'              	JMP	FNDF_LP
  02DB'                         FNDBWD:
  02DB'   2A 245F'              	LHLD	FNDCUR
  02DE'   CD 04F9'              	CALL	BOL		; HL = the line's first character
  02E1'   22 2461'              	SHLD	FNDLIM
  02E4'   2A 245F'              	LHLD	FNDCUR
  02E7'   3A 245C'              	LDA	FNDSTP
  02EA'   2F                    	CMA
  02EB'   5F                    	MOV	E,A
  02EC'   16 FF                 	MVI	D,0FFH
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02EE'   13                    	INX	D		; DE = -step
  02EF'   19                    	DAD	D		; HL = where the scan starts
  02F0'   D2 032D'              	JNC	FNDMIS		; ... off the front of the text altogether
  02F3'                         FNDB_LP:
  02F3'   EB                    	XCHG			; DE = the scan
  02F4'   2A 2461'              	LHLD	FNDLIM
  02F7'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02FA'   EB                    	XCHG			; HL = the scan
  02FB'   DA 032D'              	JC	FNDMIS		; before this line: not on it
  02FE'   CD 0334'              	CALL	FNDSEE
  0301'   C2 030A'              	JNZ	FNDB_NX
  0304'   CD 033F'              	CALL	FNDCNT
  0307'   CA 0313'              	JZ	FNDHIT
  030A'                         FNDB_NX:
  030A'   7C                    	MOV	A,H
  030B'   B5                    	ORA	L
  030C'   CA 032D'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
  030F'   2B                    	DCX	H
  0310'   C3 02F3'              	JMP	FNDB_LP
                                
                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  0313'                         FNDHIT:
  0313'   3A 245B'              	LDA	FNDRUN
  0316'   E6 5F                 	ANI	5FH
  0318'   FE 54                 	CPI	'T'
  031A'   C2 032A'              	JNZ	FNDLND
  031D'   3A 245B'              	LDA	FNDRUN
  0320'   E6 20                 	ANI	20H
  0322'   CA 0329'              	JZ	FNDH_BW
  0325'   2B                    	DCX	H		; forward 't': the character before it
  0326'   C3 032A'              	JMP	FNDLND
  0329'                         FNDH_BW:
  0329'   23                    	INX	H		; backward 'T': the character after it
  032A'                         FNDLND:
  032A'   C3 048F'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  032D'                         FNDMIS:
  032D'   AF                    	XRA	A
  032E'   32 240C'              	STA	PSAVE
  0331'   C3 01FE'              	JMP	DOTBEL
                                
                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
  0334'                         FNDSEE:
  0334'   E5                    	PUSH	H
  0335'   CD 0000*              	CALL	CHARAT
  0338'   E1                    	POP	H
  0339'   47                    	MOV	B,A
  033A'   3A 245A'              	LDA	FNDCH
  033D'   B8                    	CMP	B
  033E'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


                                ; the scan and stays it.
  033F'                         FNDCNT:
  033F'   E5                    	PUSH	H
  0340'   2A 245D'              	LHLD	FNDN
  0343'   2B                    	DCX	H
  0344'   22 245D'              	SHLD	FNDN
  0347'   7C                    	MOV	A,H
  0348'   B5                    	ORA	L
  0349'   E1                    	POP	H
  034A'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  034B'                         ISFIND:
  034B'   E6 5F                 	ANI	5FH		; fold the case away
  034D'   FE 46                 	CPI	'F'
  034F'   C8                    	RZ
  0350'   FE 54                 	CPI	'T'
  0352'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  0353'                         VC_MK:
  0353'   3E 04                 	MVI	A,PM
  0355'   C3 035F'              	JMP	MKGO
  0358'                         VC_BQ:
  0358'   3E 05                 	MVI	A,PJ
  035A'   C3 035F'              	JMP	MKGO
  035D'                         VC_AQ:
  035D'   3E 06                 	MVI	A,PJL
  035F'                         MKGO:
  035F'   32 2469'              	STA	MKWHAT
  0362'   CD 058D'              	CALL	MOVCNT		; a count means nothing on any of the three
  0365'   CD 021B'              	CALL	MKGETK		; the key that names the mark
  0368'   DA 03C3'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out -- the letter is read here and so
                                				;   was never recorded, which is why a '.'
                                				;   after "d'a" refuses (COMMANDS.md).  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist; any other key drops the
                                ;whole thing, as vim's 'Z{other}' does.
  036B'                         MKOP:
  036B'   79                    	MOV	A,C
  036C'   D6 61                 	SUI	'a'
  036E'   FE 03                 	CPI	MKMAX
  0370'   D2 03C3'              	JNC	MKBAD		; not a mark letter: nothing happens
  0373'   4F                    	MOV	C,A		; C = the mark's index
  0374'   87                    	ADD	A
  0375'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  0376'   5F                    	MOV	E,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  0377'   16 00                 	MVI	D,0
  0379'   21 0000*              	LXI	H,MKTAB
  037C'   19                    	DAD	D		; HL -> this mark's slot
  037D'   3A 2469'              	LDA	MKWHAT
  0380'   FE 04                 	CPI	PM
  0382'   CA 03CA'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark.  It refuses, with the bell, when the mark was
                                ;never set or when the window has paged away from under it.
  0385'                         MKJMP:
  0385'   E5                    	PUSH	H
  0386'   CD 0206'              	CALL	MKVAD
  0389'   7E                    	MOV	A,M
  038A'   E1                    	POP	H
  038B'   B7                    	ORA	A
  038C'   CA 03C3'              	JZ	MKBAD		; never set
  038F'   5E                    	MOV	E,M
  0390'   23                    	INX	H
  0391'   56                    	MOV	D,M		; DE = the offset it holds
  0392'   23                    	INX	H
  0393'   7E                    	MOV	A,M
  0394'   23                    	INX	H
  0395'   66                    	MOV	H,M
  0396'   6F                    	MOV	L,A		; HL = the window signature it was set under
  0397'   D5                    	PUSH	D
  0398'   EB                    	XCHG			; DE = that signature
  0399'   2A 0000*              	LHLD	PGTOPM
  039C'   7D                    	MOV	A,L
  039D'   BB                    	CMP	E
  039E'   C2 03BD'              	JNZ	MKSTAL
  03A1'   7C                    	MOV	A,H
  03A2'   BA                    	CMP	D
  03A3'   C2 03BD'              	JNZ	MKSTAL
  03A6'   CD 0DE4'              	CALL	GZONE		; the screen's top line, before the cursor
                                				;   moves: GPLACE measures the landing against
                                				;   it, and one left over from an earlier 'G'
                                				;   had it keep a window the line is not in
  03A9'   3A 2469'              	LDA	MKWHAT		; decided BEFORE the GOTO, so no register of
  03AC'   FE 06                 	CPI	PJL		;   ours has to survive a BUF primitive
  03AE'   CA 03B6'              	JZ	MKJ_GO		; ''': GPKEEP is 0, so GPLACE finds the first
  03B1'   3E 01                 	MVI	A,1		;   non-blank
  03B3'   32 2463'              	STA	GPKEEP		; '`': land on the column it was set at
  03B6'                         MKJ_GO:
  03B6'   E1                    	POP	H		; HL = the offset
  03B7'   CD 0000*              	CALL	GOTO
  03BA'   C3 0DFC'              	JMP	GPLACE		; (which sets LNDLT itself)
  03BD'                         MKSTAL:
  03BD'   E1                    	POP	H		; the window paged: the mark is gone for good
  03BE'   CD 0206'              	CALL	MKVAD
  03C1'   36 00                 	MVI	M,0
                                				; ... and fall into MKBAD
                                
                                ;MKBAD -- this mark will not answer.  An operator running the motion is
                                ;cancelled whole: PSAVE is what OPPEND's tail reads to decide whether to open
                                ;an insert, so clearing it stops a "c`z" opening one over a span of nothing.
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  03C3'                         MKBAD:
  03C3'   AF                    	XRA	A
  03C4'   32 240C'              	STA	PSAVE
  03C7'   C3 01FE'              	JMP	DOTBEL
                                
                                ;MKSET -- remember where the cursor is, and which window it is in.
  03CA'                         MKSET:
  03CA'   E5                    	PUSH	H
  03CB'   CD 0000*              	CALL	CUROFF		; HL = the cursor's logical offset
  03CE'   EB                    	XCHG
  03CF'   2A 0000*              	LHLD	PGTOPM
  03D2'   E3                    	XTHL			; HL = the slot, (SP) = the signature
  03D3'   73                    	MOV	M,E
  03D4'   23                    	INX	H
  03D5'   72                    	MOV	M,D
  03D6'   23                    	INX	H
  03D7'   D1                    	POP	D
  03D8'   73                    	MOV	M,E
  03D9'   23                    	INX	H
  03DA'   72                    	MOV	M,D
  03DB'   CD 0206'              	CALL	MKVAD
  03DE'   36 01                 	MVI	M,1		; ... and the mark is live
  03E0'   C3 060D'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKDROP -- an edit is happening at the cursor: drop every mark it could have
                                ;left pointing at different text.  A mark BEFORE the edit still names what it
                                ;named; one at or after it does not, because the text moved under it.  Called
                                ;from MARKMOD, so it must come back with every register as it found it.
  03E3'                         MKDROP:
  03E3'   F5                    	PUSH	PSW
  03E4'   3A 246A'              	LDA	MKHOLD		; a yank takes its lines out and puts them back
  03E7'   B7                    	ORA	A		;   unchanged (VY_YY): the text every mark points
  03E8'   C2 041D'              	JNZ	MKD_HL		;   into is still there, so none of them goes
  03EB'   C5                    	PUSH	B
  03EC'   D5                    	PUSH	D
  03ED'   E5                    	PUSH	H
  03EE'   CD 0000*              	CALL	CUROFF		; HL = where the edit is (CUROFF clobbers DE)
  03F1'   22 2467'              	SHLD	MKEDIT
  03F4'   21 2464'              	LXI	H,MKVAL
  03F7'   11 0000*              	LXI	D,MKTAB
  03FA'   06 03                 	MVI	B,MKMAX
  03FC'                         MKD_LP:
  03FC'   7E                    	MOV	A,M
  03FD'   B7                    	ORA	A
  03FE'   CA 0411'              	JZ	MKD_NX		; that mark is not set: nothing to drop
  0401'   E5                    	PUSH	H
  0402'   2A 2467'              	LHLD	MKEDIT
  0405'   1A                    	LDAX	D		; the mark's offset, low
  0406'   95                    	SUB	L
  0407'   13                    	INX	D
  0408'   1A                    	LDAX	D		; ... and high (neither INX nor LDAX touch CY)
  0409'   1B                    	DCX	D
  040A'   9C                    	SBB	H		; CY iff the mark is BEFORE the edit
  040B'   E1                    	POP	H
  040C'   DA 0411'              	JC	MKD_NX
  040F'   36 00                 	MVI	M,0		; at it or after it: the mark is dropped
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  0411'                         MKD_NX:
  0411'   23                    	INX	H
  0412'   13                    	INX	D
  0413'   13                    	INX	D
  0414'   13                    	INX	D
  0415'   13                    	INX	D
  0416'   05                    	DCR	B
  0417'   C2 03FC'              	JNZ	MKD_LP
  041A'   E1                    	POP	H
  041B'   D1                    	POP	D
  041C'   C1                    	POP	B
  041D'                         MKD_HL:
  041D'   F1                    	POP	PSW
  041E'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  041F'                         VC_UNDO:
  041F'   21 0000               	LXI	H,0
  0422'   22 23E2'              	SHLD	CMDCNT
  0425'   CD 0000*              	CALL	UNDO
  0428'   DA 045C'              	JC	UNDNO
  042B'   2A 0000*              	LHLD	UNDCUR
  042E'   CD 0442'              	CALL	UCLAMP		; vi never sits on a line terminator
  0431'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0434'   CD 03E3'              	CALL	MKDROP		; the undo moved text back under any mark past it
  0437'   3E 01                 	MVI	A,1
  0439'   32 23E5'              	STA	MODF		; undone past a ':w' still differs from the file
  043C'   CD 0780'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  043F'   C3 062E'              	JMP	SETFUL		; whole spans moved: repaint rather than guess
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  0442'                         UCLAMP:
  0442'   E5                    	PUSH	H
  0443'   CD 119D'              	CALL	CEND		; HL = the line's content end
  0446'   D1                    	POP	D		; DE = the offset wanted
  0447'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  044A'   D2 044F'              	JNC	UCL_BK
  044D'   EB                    	XCHG
  044E'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  044F'                         UCL_BK:
  044F'   E5                    	PUSH	H		; the content end
  0450'   EB                    	XCHG			; HL = the offset wanted
  0451'   CD 04F9'              	CALL	BOL
  0454'   D1                    	POP	D		; DE = the content end, HL = the line's start
  0455'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  0458'   EB                    	XCHG			; HL = the content end
  0459'   C8                    	RZ
  045A'   2B                    	DCX	H		; ... its last character
  045B'   C9                    	RET
  045C'                         UNDNO:
  045C'   3A 0000*              	LDA	UNDWHY
  045F'   B7                    	ORA	A
  0460'   CA 0471'              	JZ	UNDBEL
  0463'   21 1D9A'              	LXI	H,SUNDW		; the change has paged away: say so
  0466'   FE 01                 	CPI	1
  0468'   CA 1CE1'              	JZ	EXERR
  046B'   21 1DBC'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  046E'   C3 1CE1'              	JMP	EXERR
  0471'                         UNDBEL:
  0471'   0E 07                 	MVI	C,BEL
  0473'   CD 0000*              	CALL	BCONOU
  0476'   C3 060D'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  0479'                         DOTGET:
  0479'   3A 2406'              	LDA	DOTIX
  047C'   5F                    	MOV	E,A
  047D'   3A 2405'              	LDA	DOTLEN
  0480'   BB                    	CMP	E
  0481'   CA 048D'              	JZ	DOTGEF
  0484'   16 00                 	MVI	D,0
  0486'   21 0000*              	LXI	H,DOTBUF
  0489'   19                    	DAD	D
  048A'   7E                    	MOV	A,M
  048B'   B7                    	ORA	A		; CY clear: a key was returned
  048C'   C9                    	RET
  048D'                         DOTGEF:
  048D'   37                    	STC
  048E'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
  048F'                         GOSET:
  048F'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  0492'                         SETGL:
  0492'   CD 0DBE'              	CALL	ZSAVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  0495'   21 0000               	LXI	H,0
  0498'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  049B'   E5                    	PUSH	H
  049C'   CD 0DD1'              	CALL	ZREST
  049F'   E1                    	POP	H
  04A0'   E5                    	PUSH	H
  04A1'   CD 0599'              	CALL	GBSUB		; HL = bytes to the cursor
  04A4'   44                    	MOV	B,H
  04A5'   4D                    	MOV	C,L
  04A6'   E1                    	POP	H		; HL = the line's start
  04A7'   11 0000               	LXI	D,0		; DE = screen column
  04AA'                         SG_LP:
  04AA'   78                    	MOV	A,B
  04AB'   B1                    	ORA	C
  04AC'   CA 04C1'              	JZ	SG_CUR
  04AF'   7E                    	MOV	A,M
  04B0'   23                    	INX	H
  04B1'   0B                    	DCX	B
  04B2'   E5                    	PUSH	H
  04B3'   6B                    	MOV	L,E
  04B4'   CD 04E6'              	CALL	CWID
  04B7'   E1                    	POP	H
  04B8'   83                    	ADD	E
  04B9'   5F                    	MOV	E,A
  04BA'   D2 04AA'              	JNC	SG_LP
  04BD'   14                    	INR	D
  04BE'   C3 04AA'              	JMP	SG_LP
  04C1'                         SG_CUR:
  04C1'   2A 0000*              	LHLD	TXTEND
  04C4'   D5                    	PUSH	D
  04C5'   EB                    	XCHG
  04C6'   2A 0000*              	LHLD	GAPEND
  04C9'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  04CC'   D1                    	POP	D
  04CD'   CA 04E1'              	JZ	SG_SET
  04D0'   7E                    	MOV	A,M
  04D1'   FE 09                 	CPI	TAB
  04D3'   C2 04E1'              	JNZ	SG_SET
  04D6'   6B                    	MOV	L,E
  04D7'   CD 04E6'              	CALL	CWID
  04DA'   3D                    	DCR	A		; the TAB's last column
  04DB'   83                    	ADD	E
  04DC'   5F                    	MOV	E,A
  04DD'   D2 04E1'              	JNC	SG_SET
  04E0'   14                    	INR	D
  04E1'                         SG_SET:
  04E1'   EB                    	XCHG
  04E2'   22 23EA'              	SHLD	GOALCOL
  04E5'   C9                    	RET
                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  04E6'                         CWID:
  04E6'   FE 0D                 	CPI	CR
  04E8'   CA 04F7'              	JZ	CW_0
  04EB'   FE 09                 	CPI	TAB
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04ED'   3E 01                 	MVI	A,1
  04EF'   C0                    	RNZ
  04F0'   7D                    	MOV	A,L
  04F1'   E6 07                 	ANI	TABWID-1
  04F3'   2F                    	CMA
  04F4'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  04F6'   C9                    	RET
  04F7'                         CW_0:
  04F7'   AF                    	XRA	A
  04F8'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
  04F9'                         BOL:
  04F9'                         BOL_LP:
  04F9'   7C                    	MOV	A,H
  04FA'   B5                    	ORA	L
  04FB'   C8                    	RZ			; at 0
  04FC'   2B                    	DCX	H		; look at off-1
  04FD'   E5                    	PUSH	H
  04FE'   CD 0000*              	CALL	CHARAT
  0501'   E1                    	POP	H		; HL = off-1
  0502'   FE 0A                 	CPI	LF
  0504'   CA 050A'              	JZ	BOL_DN
  0507'   C3 04F9'              	JMP	BOL_LP
  050A'                         BOL_DN:
  050A'   23                    	INX	H		; line starts just after the LF
  050B'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
  050C'                         EOLNL:
  050C'   E5                    	PUSH	H
  050D'   CD 0000*              	CALL	LOGLEN
  0510'   22 241E'              	SHLD	WKN
  0513'   E1                    	POP	H
  0514'                         ENL_LP:
  0514'   EB                    	XCHG			; DE = i
  0515'   2A 241E'              	LHLD	WKN
  0518'   CD 0000*              	CALL	CMP16		; DE=i vs HL=n: CY iff i < n
  051B'   EB                    	XCHG			; HL = i, DE = n
  051C'   D0                    	RNC			; i >= n: no LF on this line
  051D'   E5                    	PUSH	H
  051E'   CD 0000*              	CALL	CHARAT
  0521'   E1                    	POP	H
  0522'   FE 0A                 	CPI	LF
  0524'   C8                    	RZ			; the LF: HL is its offset
  0525'   23                    	INX	H
  0526'   C3 0514'              	JMP	ENL_LP
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  0529'                         NLSTART:
  0529'   CD 050C'              	CALL	EOLNL
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  052C'   E5                    	PUSH	H
  052D'   CD 0000*              	CALL	LOGLEN
  0530'   D1                    	POP	D		; DE = eol result
  0531'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  0534'   C8                    	RZ			; no next line: HL = LOGLEN
  0535'   EB                    	XCHG			; HL = eol
  0536'   23                    	INX	H
  0537'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  0538'                         EOLC:
  0538'   E5                    	PUSH	H
  0539'   CD 050C'              	CALL	EOLNL
  053C'   22 2420'              	SHLD	WKTERM
  053F'   E1                    	POP	H
  0540'   CD 04F9'              	CALL	BOL
  0543'   22 2422'              	SHLD	WKBOL
  0546'   2A 2420'              	LHLD	WKTERM
  0549'   EB                    	XCHG			; DE = term
  054A'   2A 2422'              	LHLD	WKBOL
  054D'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  0550'   CA 056F'              	JZ	EOLC_MT
  0553'   EB                    	XCHG			; HL = term
  0554'   2B                    	DCX	H		; term-1
  0555'   E5                    	PUSH	H
  0556'   CD 0000*              	CALL	CHARAT
  0559'   E1                    	POP	H		; HL = term-1
  055A'   FE 0D                 	CPI	CR
  055C'   CA 0562'              	JZ	EOLC_CR		; content ends at term-1
  055F'   C3 0563'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  0562'                         EOLC_CR:
  0562'   2B                    	DCX	H		; last = (term-1) - 1
  0563'                         EOLC_LS:
  0563'   EB                    	XCHG			; DE = last
  0564'   2A 2422'              	LHLD	WKBOL
  0567'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  056A'   DA 056F'              	JC	EOLC_MT
  056D'   EB                    	XCHG			; HL = last
  056E'   C9                    	RET
  056F'                         EOLC_MT:
  056F'   2A 2422'              	LHLD	WKBOL
  0572'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  0573'                         COL:
  0573'   E5                    	PUSH	H
  0574'   CD 04F9'              	CALL	BOL
  0577'   D1                    	POP	D		; DE = off
  0578'   EB                    	XCHG			; HL = off, DE = bol
  0579'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  057C'                         ATENDQ:
  057C'   CD 0000*              	CALL	CUROFF
  057F'   E5                    	PUSH	H
  0580'   CD 0000*              	CALL	LOGLEN
  0583'   D1                    	POP	D		; DE = cur
  0584'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0587'                         CURCHR:
  0587'   CD 0000*              	CALL	CUROFF
  058A'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  058D'                         MOVCNT:
  058D'   CD 060D'              	CALL	SETMOV
  0590'   C3 05A0'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  0593'                         CNTOFF:
  0593'   CD 05A0'              	CALL	GETCNT
  0596'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  0599'                         GBSUB:
  0599'   EB                    	XCHG
  059A'   2A 0000*              	LHLD	GAPBEG
  059D'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  05A0'                         GETCNT:
  05A0'   2A 23E2'              	LHLD	CMDCNT
  05A3'   7C                    	MOV	A,H
  05A4'   B5                    	ORA	L
  05A5'   C2 05AC'              	JNZ	GC_HAVE
  05A8'   21 0001               	LXI	H,1
  05AB'   C9                    	RET
  05AC'                         GC_HAVE:
  05AC'   E5                    	PUSH	H
  05AD'   21 0000               	LXI	H,0
  05B0'   22 23E2'              	SHLD	CMDCNT
  05B3'   E1                    	POP	H
  05B4'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for a ^C break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  05B5'                         CNTTST:				; WM 1175
  05B5'   E5                    	PUSH	H
  05B6'   2A 23E2'              	LHLD	CMDCNT
  05B9'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  05BC'   B4                    	ORA	H
  05BD'   B5                    	ORA	L
  05BE'   E1                    	POP	H
  05BF'   C3 0000*              	JMP	POLLBRK
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  05C2'                         CLASSF:
  05C2'   47                    	MOV	B,A
  05C3'   FE 20                 	CPI	' '
  05C5'   CA 0605'              	JZ	CLS0
  05C8'   FE 09                 	CPI	TAB
  05CA'   CA 0605'              	JZ	CLS0
  05CD'   FE 0A                 	CPI	LF
  05CF'   CA 0605'              	JZ	CLS0
  05D2'   FE 0D                 	CPI	CR
  05D4'   CA 0605'              	JZ	CLS0
  05D7'   3A 23EC'              	LDA	WBIG
  05DA'   B7                    	ORA	A
  05DB'   C2 0607'              	JNZ	CLS1
  05DE'   78                    	MOV	A,B
  05DF'   FE 5F                 	CPI	'_'
  05E1'   CA 0607'              	JZ	CLS1
  05E4'   FE 30                 	CPI	'0'
  05E6'   DA 060A'              	JC	CLS2
  05E9'   FE 3A                 	CPI	'9'+1
  05EB'   DA 0607'              	JC	CLS1
  05EE'   FE 41                 	CPI	'A'
  05F0'   DA 060A'              	JC	CLS2
  05F3'   FE 5B                 	CPI	'Z'+1
  05F5'   DA 0607'              	JC	CLS1
  05F8'   FE 61                 	CPI	'a'
  05FA'   DA 060A'              	JC	CLS2
  05FD'   FE 7B                 	CPI	'z'+1
  05FF'   DA 0607'              	JC	CLS1
  0602'   C3 060A'              	JMP	CLS2
  0605'   AF                    CLS0:	XRA	A
  0606'   C9                    	RET
  0607'   3E 01                 CLS1:	MVI	A,1
  0609'   C9                    	RET
  060A'   3E 02                 CLS2:	MVI	A,2
  060C'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  060D'                         SETMOV:
  060D'   3E 01                 	MVI	A,R_MOVE
  060F'   32 23E6'              	STA	RINTENT
  0612'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  0613'                         SETLIN:
  0613'   3E 02                 	MVI	A,R_LINE
  0615'   32 23E6'              	STA	RINTENT
  0618'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  0619'                         SETILN:
  0619'   3E 01                 	MVI	A,1
  061B'   32 23E7'              	STA	ILN		; one line, unless a put overwrites it below
  061E'   3E 05                 	MVI	A,R_ILIN
  0620'   32 23E6'              	STA	RINTENT
  0623'   AF                    	XRA	A
  0624'   32 23E9'              	STA	ILABOV		; the row above the opened ones is untouched
  0627'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  0628'                         SETJON:
  0628'   3E 06                 	MVI	A,R_JOIN
  062A'   32 23E6'              	STA	RINTENT
  062D'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  062E'                         SETFUL:
  062E'   3E 00                 	MVI	A,R_FULL
  0630'   32 23E6'              	STA	RINTENT
  0633'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB occurs from the cursor to the end of its line, else 0.
                                ; Scans forward from the cursor via CHARAT until LF or end of text (no gap move).
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  0634'                         TAILTAB:
  0634'   CD 0000*              	CALL	CUROFF
  0637'   22 241A'              	SHLD	TTI
  063A'                         TT_LP:
  063A'   2A 241A'              	LHLD	TTI
  063D'   EB                    	XCHG			; DE = TTI
  063E'   CD 0000*              	CALL	LOGLEN		; HL = LOGLEN
  0641'   CD 0000*              	CALL	CMP16		; CY iff TTI < LOGLEN
  0644'   D2 0664'              	JNC	TT_NO		; reached end of text -> no tab
  0647'   2A 241A'              	LHLD	TTI
  064A'   CD 0000*              	CALL	CHARAT
  064D'   FE 0A                 	CPI	LF
  064F'   CA 0664'              	JZ	TT_NO		; end of line -> no tab
  0652'   FE 09                 	CPI	TAB
  0654'   CA 0661'              	JZ	TT_YES
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  0657'   2A 241A'              	LHLD	TTI
  065A'   23                    	INX	H
  065B'   22 241A'              	SHLD	TTI
  065E'   C3 063A'              	JMP	TT_LP
  0661'                         TT_YES:
  0661'   3E 01                 	MVI	A,1
  0663'   C9                    	RET
  0664'                         TT_NO:
  0664'   AF                    	XRA	A
  0665'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  0666'                         VC_H:
  0666'   CD 058D'              	CALL	MOVCNT		; a cursor motion, and its count
  0669'   22 2418'              	SHLD	CNTV
  066C'                         VCH_LP:
  066C'   2A 2418'              	LHLD	CNTV
  066F'   7C                    	MOV	A,H
  0670'   B5                    	ORA	L
  0671'   C8                    	RZ
  0672'   2B                    	DCX	H
  0673'   22 2418'              	SHLD	CNTV
  0676'   CD 067C'              	CALL	HSTEP
  0679'   C3 066C'              	JMP	VCH_LP
  067C'                         HSTEP:
  067C'   CD 0000*              	CALL	CUROFF		; HL = cur
  067F'   7C                    	MOV	A,H
  0680'   B5                    	ORA	L
  0681'   C8                    	RZ			; at 0
  0682'   E5                    	PUSH	H
  0683'   CD 04F9'              	CALL	BOL		; HL = bol
  0686'   D1                    	POP	D		; DE = cur
  0687'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  068A'   C8                    	RZ			; at BOL, cannot go left
  068B'   EB                    	XCHG			; HL = cur
  068C'   2B                    	DCX	H
  068D'   C3 048F'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  0690'                         VC_L:
  0690'   CD 058D'              	CALL	MOVCNT		; a cursor motion, and its count
  0693'   22 2418'              	SHLD	CNTV
  0696'                         VCL_LP:
  0696'   2A 2418'              	LHLD	CNTV
  0699'   7C                    	MOV	A,H
  069A'   B5                    	ORA	L
  069B'   C8                    	RZ
  069C'   2B                    	DCX	H
  069D'   22 2418'              	SHLD	CNTV
  06A0'   CD 06A6'              	CALL	LSTEP
  06A3'   C3 0696'              	JMP	VCL_LP
  06A6'                         LSTEP:
  06A6'   CD 0000*              	CALL	CUROFF		; HL = cur
  06A9'   E5                    	PUSH	H
  06AA'   CD 0538'              	CALL	EOLC		; HL = eolc
  06AD'   D1                    	POP	D		; DE = cur
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06AE'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  06B1'   D0                    	RNC			; cur >= eolc, cannot go right
  06B2'   EB                    	XCHG			; HL = cur
  06B3'   23                    	INX	H
  06B4'   C3 048F'              	JMP	GOSET
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  06B7'                         VC_0:
  06B7'   CD 058D'              	CALL	MOVCNT		; a cursor motion, and its count
  06BA'   CD 06C4'              	CALL	LNSTRT
  06BD'   21 0000               	LXI	H,0
  06C0'   22 23EA'              	SHLD	GOALCOL
  06C3'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  06C4'                         LNSTRT:
  06C4'   CD 0DBE'              	CALL	ZSAVE
  06C7'   21 0000               	LXI	H,0
  06CA'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  06CD'   E5                    	PUSH	H
  06CE'   CD 0DD1'              	CALL	ZREST
  06D1'   E1                    	POP	H
  06D2'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  06D5'                         VC_CRT:
  06D5'   CD 058D'              	CALL	MOVCNT		; a cursor motion, and its count
  06D8'   C3 06DB'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  06DB'                         FNBLNK:
  06DB'   CD 06C4'              	CALL	LNSTRT
  06DE'   CD 0000*              	CALL	RGET0
  06E1'   11 0000               	LXI	D,0		; DE = blanks skipped
  06E4'                         FN_LP:
  06E4'   CD 0000*              	CALL	RDGET
  06E7'   DA 070A'              	JC	FN_GO		; the end of the file
  06EA'   FE 20                 	CPI	' '
  06EC'   CA 06F4'              	JZ	FN_WH
  06EF'   FE 09                 	CPI	TAB
  06F1'   C2 070A'              	JNZ	FN_GO		; a non-blank, or the line's end
  06F4'                         FN_WH:
  06F4'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  06F7'   DA 070A'              	JC	FN_GO
  06FA'   FE 0D                 	CPI	CR
  06FC'   CA 070A'              	JZ	FN_GO
  06FF'   FE 0A                 	CPI	LF
  0701'   CA 070A'              	JZ	FN_GO
  0704'   2B                    	DCX	H		; not yet: read that char again
  0705'   03                    	INX	B
  0706'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  0707'   C3 06E4'              	JMP	FN_LP
  070A'                         FN_GO:
  070A'   D5                    	PUSH	D
  070B'   CD 0000*              	CALL	CUROFF
  070E'   D1                    	POP	D
  070F'   19                    	DAD	D
  0710'   C3 048F'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  0713'                         VC_EOL:
  0713'   CD 060D'              	CALL	SETMOV
  0716'   21 FFFF               	LXI	H,0FFFFH
  0719'   22 23EA'              	SHLD	GOALCOL
  071C'   CD 05A0'              	CALL	GETCNT
  071F'   2B                    	DCX	H		; count-1
  0720'   7C                    	MOV	A,H
  0721'   B5                    	ORA	L
  0722'   CA 0731'              	JZ	VEOL_0
  0725'   E5                    	PUSH	H
  0726'   CD 0746'              	CALL	ONLAST
  0729'   E1                    	POP	H
  072A'   D8                    	RC			; the last line: no move (vim)
  072B'   CD 0789'              	CALL	JCORE
  072E'   C3 08D8'              	JMP	JKLAND
  0731'                         VEOL_0:
  0731'   CD 06C4'              	CALL	LNSTRT
  0734'   C3 08D8'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  0737'                         VC_CR:
  0737'   CD 058D'              	CALL	MOVCNT		; a cursor motion, and its count
  073A'   E5                    	PUSH	H
  073B'   CD 0746'              	CALL	ONLAST
  073E'   E1                    	POP	H
  073F'   D8                    	RC
  0740'   CD 0789'              	CALL	JCORE
  0743'   C3 06DB'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  0746'                         ONLAST:
  0746'   CD 0000*              	CALL	RGET0
  0749'                         OL_LP:
  0749'   CD 0000*              	CALL	RDGET
  074C'   D8                    	RC			; the file ends on this line
  074D'   FE 0A                 	CPI	LF
  074F'   C2 0749'              	JNZ	OL_LP
  0752'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  0755'                         VC_J:
  0755'   CD 060D'              	CALL	SETMOV
  0758'   CD 0773'              	CALL	GLCHK		; the goal column, from the cursor if stale
  075B'   CD 05A0'              	CALL	GETCNT		; HL = count
  075E'   CD 0789'              	CALL	JCORE
  0761'   C3 08D8'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  0764'                         VC_K:
  0764'   CD 060D'              	CALL	SETMOV
  0767'   CD 0773'              	CALL	GLCHK
  076A'   CD 05A0'              	CALL	GETCNT
  076D'   CD 0826'              	CALL	KCORE
  0770'   C3 08D8'              	JMP	JKLAND
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  0773'                         GLCHK:
  0773'   2A 23EA'              	LHLD	GOALCOL
  0776'   7C                    	MOV	A,H
  0777'   3C                    	INR	A
  0778'   C0                    	RNZ
  0779'   7D                    	MOV	A,L
  077A'   FE FE                 	CPI	0FEH
  077C'   C0                    	RNZ
  077D'   C3 0492'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  0780'                         GLSTAL:
  0780'   E5                    	PUSH	H
  0781'   21 FFFE               	LXI	H,0FFFEH
  0784'   22 23EA'              	SHLD	GOALCOL
  0787'   E1                    	POP	H
  0788'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  0789'                         JCORE:
  0789'   7C                    	MOV	A,H
  078A'   B5                    	ORA	L
  078B'   C8                    	RZ
  078C'   22 23F0'              	SHLD	JKCNT
  078F'   CD 0B9F'              	CALL	CURRW		; limit = rows under the cursor's + NEDIT
  0792'   47                    	MOV	B,A
  0793'   3A 0000*              	LDA	NEDIT
  0796'   3D                    	DCR	A
  0797'   90                    	SUB	B
  0798'   5F                    	MOV	E,A
  0799'   16 00                 	MVI	D,0
  079B'   3A 0000*              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  079E'   6F                    	MOV	L,A
  079F'   26 00                 	MVI	H,0
  07A1'   19                    	DAD	D
  07A2'   EB                    	XCHG			; DE = limit
  07A3'   2A 23F0'              	LHLD	JKCNT
  07A6'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  07A9'   D2 07AD'              	JNC	JC_N
  07AC'   EB                    	XCHG			; HL = limit
  07AD'                         JC_N:
  07AD'   22 23F2'              	SHLD	JKN		; N = min(count, limit)
  07B0'   EB                    	XCHG			; DE = LFs to find
  07B1'   CD 0000*              	CALL	RGET0
  07B4'                         JC_SC:
  07B4'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  07B7'   DA 07D6'              	JC	JC_EOF
  07BA'   32 23F9'              	STA	JKLST
  07BD'   FE 0A                 	CPI	LF
  07BF'   C2 07B4'              	JNZ	JC_SC
  07C2'   1B                    	DCX	D
  07C3'   7A                    	MOV	A,D
  07C4'   B3                    	ORA	E
  07C5'   C2 07B4'              	JNZ	JC_SC
  07C8'   2A 23F0'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  07CB'   22 23F4'              	SHLD	JKMOV		;   one if the last LF found ends the file
  07CE'   3E 01                 	MVI	A,1
  07D0'   32 23F8'              	STA	JKPHN
  07D3'   C3 07F1'              	JMP	JC_MV
  07D6'                         JC_EOF:
  07D6'   2A 23F2'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  07D9'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  07DC'   7C                    	MOV	A,H
  07DD'   B5                    	ORA	L
  07DE'   CA 07EA'              	JZ	JC_AV
  07E1'   3A 23F9'              	LDA	JKLST
  07E4'   FE 0A                 	CPI	LF
  07E6'   C2 07EA'              	JNZ	JC_AV
  07E9'   2B                    	DCX	H
  07EA'                         JC_AV:
  07EA'   22 23F4'              	SHLD	JKMOV
  07ED'   AF                    	XRA	A
  07EE'   32 23F8'              	STA	JKPHN
  07F1'                         JC_MV:
  07F1'   2A 23F0'              	LHLD	JKCNT
  07F4'   AF                    	XRA	A
  07F5'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  07F8'   CD 08B7'              	CALL	ATEOF
  07FB'   D2 080F'              	JNC	JC_DN
  07FE'   CD 08BD'              	CALL	LASTLN		; ran past the last line: back onto it
  0801'   3A 23F8'              	LDA	JKPHN
  0804'   B7                    	ORA	A
  0805'   CA 080F'              	JZ	JC_DN
  0808'   2A 23F4'              	LHLD	JKMOV
  080B'   2B                    	DCX	H
  080C'   22 23F4'              	SHLD	JKMOV
  080F'                         JC_DN:
  080F'   2A 23F2'              	LHLD	JKN		; LNDLT += min(moved, N)
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  0812'   EB                    	XCHG
  0813'   2A 23F4'              	LHLD	JKMOV
