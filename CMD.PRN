  2915'   75 66 66 65           
  2919'   72 20 65 6D           
  291D'   70 74 79 2D           
  2921'   2D 00                 
  2923'   20 77 72 69           SWRIT:	DB	' written',0
  2927'   74 74 65 6E           
  292B'   00                    
  292C'   43 61 6E 27           SNOPN:	DB	'Can''t open file ',0
  2930'   74 20 6F 70           
  2934'   65 6E 20 66           
  2938'   69 6C 65 20           
  293C'   00                    
  293D'   49 6E 76 61           SRNGE:	DB	'Invalid range',0
  2941'   6C 69 64 20           
  2945'   72 61 6E 67           
  2949'   65 00                 
  294B'   44 69 73 6B           SDFUL:	DB	'Disk full',0
  294F'   20 66 75 6C           
  2953'   6C 00                 
                                
                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
	MACRO-80 3.44	09-Dec-81	PAGE	1-127


  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  0008                          EO_R	EQU	8
  2955'                         EXTAB:
  2955'   77 00 01              	DB	'w',0,EO_W
  2958'   71 00 02              	DB	'q',0,EO_Q
  295B'   77 71 03              	DB	'w','q',EO_WQ
  295E'   78 00 04              	DB	'x',0,EO_X
  2961'   65 00 05              	DB	'e',0,EO_E
  2964'   73 00 06              	DB	's',0,EO_S
  2967'   76 65 07              	DB	'v','e',EO_V
  296A'   72 00 08              	DB	'r',0,EO_R
  296D'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- are cut from BUF.MAC:
                                ; RDLINE drops control characters, so no pattern could ever hold one.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
	MACRO-80 3.44	09-Dec-81	PAGE	1-128


                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  296E'                         EXADDR:
  296E'   AF                    	XRA	A
  296F'   32 0000*              	STA	SRNGF
  2972'   7E                    	MOV	A,M
  2973'   FE 25                 	CPI	'%'
  2975'   CA 299E'              	JZ	EXA_AL
  2978'   EB                    	XCHG			; DE walks the line, HL takes the number
  2979'   CD 29B3'              	CALL	EXNUM
  297C'   DA 299C'              	JC	EXA_NO
  297F'   22 0000*              	SHLD	SRNG1
  2982'   22 0000*              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  2985'   1A                    	LDAX	D
  2986'   FE 2C                 	CPI	','
  2988'   C2 2995'              	JNZ	EXA_YS
  298B'   13                    	INX	D
  298C'   CD 29B3'              	CALL	EXNUM
  298F'   DA 299C'              	JC	EXA_NO		; ',' with no number: not a range at all
  2992'   22 0000*              	SHLD	SRNG2
  2995'                         EXA_YS:
  2995'   EB                    	XCHG
  2996'   3E 01                 	MVI	A,1
  2998'   32 0000*              	STA	SRNGF
  299B'   C9                    	RET
  299C'                         EXA_NO:
  299C'   EB                    	XCHG
  299D'   C9                    	RET
  299E'                         EXA_AL:
  299E'   23                    	INX	H
  299F'   E5                    	PUSH	H
  29A0'   21 0001               	LXI	H,1
  29A3'   22 0000*              	SHLD	SRNG1
  29A6'   21 FFFF               	LXI	H,0FFFFH
  29A9'   22 0000*              	SHLD	SRNG2
	MACRO-80 3.44	09-Dec-81	PAGE	1-129


  29AC'   E1                    	POP	H
  29AD'   3E 01                 	MVI	A,1
  29AF'   32 0000*              	STA	SRNGF
  29B2'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  29B3'                         EXNUM:
  29B3'   1A                    	LDAX	D
  29B4'   D6 30                 	SUI	'0'
  29B6'   D8                    	RC
  29B7'   FE 0A                 	CPI	10
  29B9'   3F                    	CMC
  29BA'   D8                    	RC
  29BB'   21 0000               	LXI	H,0
  29BE'                         EXN_LP:
  29BE'   1A                    	LDAX	D
  29BF'   D6 30                 	SUI	'0'
  29C1'   DA 29DB'              	JC	EXN_DN
  29C4'   FE 0A                 	CPI	10
  29C6'   D2 29DB'              	JNC	EXN_DN
  29C9'   13                    	INX	D
  29CA'   C5                    	PUSH	B
  29CB'   4F                    	MOV	C,A
  29CC'   06 00                 	MVI	B,0		; BC = the digit
  29CE'   D5                    	PUSH	D
  29CF'   54                    	MOV	D,H
  29D0'   5D                    	MOV	E,L
  29D1'   29                    	DAD	H		; *2
  29D2'   29                    	DAD	H		; *4
  29D3'   19                    	DAD	D		; *5
  29D4'   29                    	DAD	H		; *10
  29D5'   D1                    	POP	D
  29D6'   09                    	DAD	B
  29D7'   C1                    	POP	B
  29D8'   C3 29BE'              	JMP	EXN_LP
  29DB'                         EXN_DN:
  29DB'   B7                    	ORA	A		; CY clear: there was a number
  29DC'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  29DD'                         EX_S:
  29DD'   7E                    	MOV	A,M
  29DE'   B7                    	ORA	A
  29DF'   CA 2A21'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  29E2'   32 0000*              	STA	SDELIM
  29E5'   23                    	INX	H
  29E6'   11 0000*              	LXI	D,SRCHST
  29E9'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  29EC'   4F                    	MOV	C,A
  29ED'   CD 2A27'              	CALL	SCOPY
  29F0'   78                    	MOV	A,B
  29F1'   B7                    	ORA	A
  29F2'   CA 2A21'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  29F5'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
	MACRO-80 3.44	09-Dec-81	PAGE	1-130


  29F8'   3E 01                 	MVI	A,1
  29FA'   32 0000*              	STA	SHAVE		; 'n' repeats it, as after a '/'
  29FD'   11 0000*              	LXI	D,SREPL
  2A00'   0E 24                 	MVI	C,SREPMX
  2A02'   CD 2A27'              	CALL	SCOPY
  2A05'   78                    	MOV	A,B
  2A06'   32 0000*              	STA	SREPLN
  2A09'   AF                    	XRA	A
  2A0A'   32 0000*              	STA	SGFLAG
  2A0D'   7E                    	MOV	A,M
  2A0E'   FE 67                 	CPI	'g'
  2A10'   C2 2A19'              	JNZ	EX_SG
  2A13'   23                    	INX	H
  2A14'   3E 01                 	MVI	A,1
  2A16'   32 0000*              	STA	SGFLAG
  2A19'                         EX_SG:
  2A19'   7E                    	MOV	A,M
  2A1A'   B7                    	ORA	A
  2A1B'   C2 27A8'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  2A1E'   C3 2A47'              	JMP	SUBGO
  2A21'                         SUBNOP:
  2A21'   21 2870'              	LXI	H,SNOPAT
  2A24'   C3 27B6'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  2A27'                         SCOPY:
  2A27'   06 00                 	MVI	B,0
  2A29'                         SCP_LP:
  2A29'   78                    	MOV	A,B
  2A2A'   B9                    	CMP	C
  2A2B'   D2 2A44'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  2A2E'   7E                    	MOV	A,M
  2A2F'   B7                    	ORA	A
  2A30'   CA 2A44'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  2A33'   E5                    	PUSH	H
  2A34'   21 0000*              	LXI	H,SDELIM
  2A37'   BE                    	CMP	M
  2A38'   E1                    	POP	H
  2A39'   CA 2A43'              	JZ	SCP_SK
  2A3C'   12                    	STAX	D
  2A3D'   13                    	INX	D
  2A3E'   23                    	INX	H
  2A3F'   04                    	INR	B
  2A40'   C3 2A29'              	JMP	SCP_LP
  2A43'                         SCP_SK:
  2A43'   23                    	INX	H
  2A44'                         SCP_DN:
  2A44'   AF                    	XRA	A
  2A45'   12                    	STAX	D
  2A46'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
	MACRO-80 3.44	09-Dec-81	PAGE	1-131


                                ;screen's top line as it was when the command was typed.
  2A47'                         SUBGO:
  2A47'   CD 13C4'              	CALL	GZONE
  2A4A'   2A 0000*              	LHLD	LNDLT
  2A4D'   22 0000*              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  2A50'   21 0000*              	LXI	H,SOFFS		;   finds nothing puts both back, as the
  2A53'   CD 0429'              	CALL	FPSTO		;   search's SN_BAD does
  2A56'   AF                    	XRA	A
  2A57'   32 0000*              	STA	SANY
  2A5A'   21 0000               	LXI	H,0
  2A5D'   22 0000*              	SHLD	SBACK
  2A60'   3A 0000*              	LDA	SRNGF
  2A63'   B7                    	ORA	A
  2A64'   CA 2A76'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  2A67'   CD 2336'              	CALL	EXRNG		; SLINES = the lines in the range
  2A6A'   DA 2AF2'              	JC	SUBBAD
  2A6D'   2A 0000*              	LHLD	SRNG1
  2A70'   CD 1332'              	CALL	GOLN
  2A73'   C3 2A7C'              	JMP	SUBLP
  2A76'                         SUB_1L:
  2A76'   21 0001               	LXI	H,1
  2A79'   22 0000*              	SHLD	SLINES
  2A7C'                         SUBLP:
  2A7C'   CD 2AF8'              	CALL	SUBLIN		; A = 1 when this line changed
  2A7F'   B7                    	ORA	A
  2A80'   CA 2A8E'              	JZ	SUB_NX
  2A83'   3E 01                 	MVI	A,1
  2A85'   32 0000*              	STA	SANY
  2A88'   21 0000               	LXI	H,0
  2A8B'   22 0000*              	SHLD	SBACK		; the cursor is ON the last line changed
  2A8E'                         SUB_NX:
  2A8E'   2A 0000*              	LHLD	SLINES
  2A91'   2B                    	DCX	H
  2A92'   22 0000*              	SHLD	SLINES
  2A95'   7C                    	MOV	A,H
  2A96'   B5                    	ORA	L
  2A97'   CA 2AB5'              	JZ	SUBDON		; the range is spent
  2A9A'   21 0001               	LXI	H,1
  2A9D'   AF                    	XRA	A
  2A9E'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  2AA1'   3A 0000*              	LDA	SANY
  2AA4'   B7                    	ORA	A
  2AA5'   CA 2AAF'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  2AA8'   2A 0000*              	LHLD	SBACK
  2AAB'   23                    	INX	H
  2AAC'   22 0000*              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  2AAF'                         SUB_AE:
  2AAF'   CD 0BCE'              	CALL	ATEOF
  2AB2'   D2 2A7C'              	JNC	SUBLP		; ... unless that ran off the end of the file
  2AB5'                         SUBDON:
  2AB5'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  2AB8'   3A 0000*              	LDA	SANY
  2ABB'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-132


  2ABC'   CA 2ADA'              	JZ	SUBNFD
  2ABF'   3E 01                 	MVI	A,1
  2AC1'   32 0000*              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  2AC4'   2A 0000*              	LHLD	SBACK
  2AC7'   7C                    	MOV	A,H
  2AC8'   B5                    	ORA	L
  2AC9'   CA 2AD4'              	JZ	SUB_PL
  2ACC'   3E FF                 	MVI	A,0FFH
  2ACE'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  2AD1'   CD 0000*              	CALL	CLRCNT
  2AD4'                         SUB_PL:
  2AD4'   CD 13DC'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  2AD7'   C3 088F'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  2ADA'                         SUBNFD:
  2ADA'   21 0000*              	LXI	H,SOFFS
  2ADD'   CD 03D0'              	CALL	BACKTO
  2AE0'   2A 0000*              	LHLD	SLDLTS
  2AE3'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  2AE6'   21 2840'              	LXI	H,SNOTFD
  2AE9'   CD 27B6'              	CALL	EXERR
  2AEC'   21 0000*              	LXI	H,SRCHST
  2AEF'   C3 27B1'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  2AF2'                         SUBBAD:
  2AF2'   21 282E'              	LXI	H,SNOT
  2AF5'   C3 27AB'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  2AF8'                         SUBLIN:
  2AF8'   AF                    	XRA	A
  2AF9'   32 0000*              	STA	SLCHG
  2AFC'   CD 2B77'              	CALL	SUBBOL
  2AFF'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  2B02'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  2B02'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  2B05'   DA 2B0D'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  2B08'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  2B0A'   C2 2B02'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
	MACRO-80 3.44	09-Dec-81	PAGE	1-133


                                				;   every other line reader here does.
  2B0D'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  2B0D'   CD 0000*              	CALL	CUROFF
  2B10'   E5                    	PUSH	H
  2B11'   CD 19B7'              	CALL	CEND
  2B14'   D1                    	POP	D
  2B15'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  2B18'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  2B19'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  2B1C'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  2B1D'   B7                    	ORA	A		;   span is a line, not a pair.)
  2B1E'   FA 2B70'              	JM	SUBL_D		; what is left is shorter than the pattern
  2B21'   44                    	MOV	B,H
  2B22'   4D                    	MOV	C,L		; BC = the start positions a match can take
  2B23'   11 0000*              	LXI	D,SRCHST
  2B26'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  2B29'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  2B2C'   DA 2B70'              	JC	SUBL_D
  2B2F'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  2B32'   EB                    	XCHG
  2B33'   2A 0000*              	LHLD	GAPEND
  2B36'   EB                    	XCHG
  2B37'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  2B3A'   EB                    	XCHG
  2B3B'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  2B3C'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  2B3F'   D1                    	POP	D
  2B40'   19                    	DAD	D		; ... and so the match's logical offset
  2B41'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  2B44'   3A 0000*              	LDA	SANY
  2B47'   B7                    	ORA	A
  2B48'   C2 2B55'              	JNZ	SUBL_C
  2B4B'   3A 0000*              	LDA	SLCHG
  2B4E'   B7                    	ORA	A
  2B4F'   C2 2B55'              	JNZ	SUBL_C
  2B52'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  2B55'                         SUBL_C:
  2B55'   3A 0000*              	LDA	SRCHBF
  2B58'   6F                    	MOV	L,A
  2B59'   26 00                 	MVI	H,0
  2B5B'   CD 0000*              	CALL	DELFWD		; the match goes
  2B5E'   11 0000*              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  2B61'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  2B64'                         SUBL_I:
  2B64'   3E 01                 	MVI	A,1
  2B66'   32 0000*              	STA	SLCHG
  2B69'   3A 0000*              	LDA	SGFLAG
  2B6C'   B7                    	ORA	A
  2B6D'   C2 2B0D'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
	MACRO-80 3.44	09-Dec-81	PAGE	1-134


  2B70'                         SUBL_D:
  2B70'   CD 2B77'              	CALL	SUBBOL
  2B73'   3A 0000*              	LDA	SLCHG
  2B76'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  2B77'                         SUBBOL:
  2B77'   CD 0000*              	CALL	CUROFF
  2B7A'   CD 0678'              	CALL	BOL
  2B7D'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  2B80'                         VC_SRCH:
  2B80'   CD 0852'              	CALL	SETMOV
  2B83'   C5                    	PUSH	B
  2B84'   CD 077D'              	CALL	GETCNT
  2B87'   22 0000*              	SHLD	SCNT
  2B8A'   C1                    	POP	B
  2B8B'   79                    	MOV	A,C
  2B8C'   FE 2F                 	CPI	'/'
  2B8E'   3E 00                 	MVI	A,0
  2B90'   CA 2B95'              	JZ	VS_DIR
  2B93'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  2B95'                         VS_DIR:
  2B95'   32 0000*              	STA	SDIR
  2B98'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2B9B'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2B9E'   47                    	MOV	B,A
  2B9F'   CD 20DF'              	CALL	RDLINE
  2BA2'   B7                    	ORA	A
  2BA3'   C0                    	RNZ			; cancelled: nothing happens at all
  2BA4'   3A 0000*              	LDA	RLLEN
  2BA7'   B7                    	ORA	A
  2BA8'   CA 2BBD'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  2BAB'   5F                    	MOV	E,A
  2BAC'   16 00                 	MVI	D,0
  2BAE'   21 0000*              	LXI	H,SRCHST
  2BB1'   19                    	DAD	D
  2BB2'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  2BB4'   7B                    	MOV	A,E
  2BB5'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  2BB8'   3E 01                 	MVI	A,1
  2BBA'   32 0000*              	STA	SHAVE
  2BBD'                         VS_OLD:
  2BBD'   3A 0000*              	LDA	SHAVE
  2BC0'   B7                    	ORA	A
  2BC1'   CA 2BCD'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  2BC4'   3A 0000*              	LDA	SDIR
  2BC7'   32 0000*              	STA	SDIRE
  2BCA'   C3 2BF6'              	JMP	SRCHN
  2BCD'                         VS_NOP:
  2BCD'   21 2870'              	LXI	H,SNOPAT
  2BD0'   C3 27B6'              	JMP	EXERR
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-135


                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  2BD3'                         VC_N:
  2BD3'   CD 0852'              	CALL	SETMOV
  2BD6'   3A 0000*              	LDA	SDIR
  2BD9'   C3 2BE3'              	JMP	VN_GO
  2BDC'                         VCB_N:
  2BDC'   CD 0852'              	CALL	SETMOV
  2BDF'   3A 0000*              	LDA	SDIR
  2BE2'   2F                    	CMA			; the other way: 0 <-> FFH
  2BE3'                         VN_GO:
  2BE3'   32 0000*              	STA	SDIRE
  2BE6'   CD 077D'              	CALL	GETCNT
  2BE9'   22 0000*              	SHLD	SCNT
  2BEC'   3A 0000*              	LDA	SHAVE
  2BEF'   B7                    	ORA	A
  2BF0'   CA 2BCD'              	JZ	VS_NOP
  2BF3'   C3 2BF6'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  2BF6'                         SRCHN:
  2BF6'   CD 13C4'              	CALL	GZONE		; the screen's top line, before the cursor moves
  2BF9'   CD 07A6'              	CALL	BRKON		; where it started (the sweep moves the cursor
                                				;   with PUTCUR, which does not maintain LNDLT;
                                				;   GOTO does), and an ESC may stop it
  2BFC'                         SN_LP:
  2BFC'   CD 2C31'              	CALL	SRCHGO
  2BFF'   DA 2C1C'              	JC	SN_BAD
  2C02'   2A 0000*              	LHLD	SCNT
  2C05'   2B                    	DCX	H
  2C06'   22 0000*              	SHLD	SCNT
  2C09'   7C                    	MOV	A,H
  2C0A'   B5                    	ORA	L
  2C0B'   C2 2BFC'              	JNZ	SN_LP
  2C0E'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  2C11'   CD 07E3'              	CALL	BRKOFF
  2C14'   3E 01                 	MVI	A,1
  2C16'   32 0000*              	STA	GPKEEP		; land on the match, not the first non-blank
  2C19'   C3 13DC'              	JMP	GPLACE		; (which sets LNDLT itself)
  2C1C'                         SN_BAD:
  2C1C'   CD 07E3'              	CALL	BRKOFF
  2C1F'   DA 07FB'              	JC	BRKBAK		; stopped, which is not the same as not found
  2C22'   CD 07EE'              	CALL	RSTPL		; nothing moved: the row the cursor was on
  2C25'   21 2840'              	LXI	H,SNOTFD
  2C28'   CD 27B6'              	CALL	EXERR
  2C2B'   21 0000*              	LXI	H,SRCHST
  2C2E'   C3 27B1'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  2C31'                         SRCHGO:
  2C31'   3E 01                 	MVI	A,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-136


  2C33'   32 0000*              	STA	SSKIP		; this pass starts one past the cursor
  2C36'   CD 2C4C'              	CALL	SRCHW
  2C39'   D0                    	RNC
  2C3A'   CD 07E7'              	CALL	BRKQ
  2C3D'   D8                    	RC			; stopped: no second pass
  2C3E'   3A 0000*              	LDA	SDIRE
  2C41'   2F                    	CMA
  2C42'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  2C45'   AF                    	XRA	A
  2C46'   32 0000*              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  2C49'   C3 2C4C'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  2C4C'                         SRCHW:
  2C4C'   3A 0000*              	LDA	SDIRE
  2C4F'   32 0000*              	STA	DIRFLG
  2C52'   21 FFFF               	LXI	H,0FFFFH
  2C55'   22 0000*              	SHLD	CMDCNT
  2C58'   AF                    	XRA	A
  2C59'   32 0000*              	STA	AUXCNT
  2C5C'                         SW_LP:
  2C5C'   CD 07E7'              	CALL	BRKQ		; an ESC spent the count, here or on the way to
  2C5F'   D8                    	RC			;   the wrapped pass: SCRLST no longer pages
  2C60'   CD 2C6C'              	CALL	SRCH1
  2C63'   D0                    	RNC
  2C64'   CD 0000*              	CALL	SCRLST
  2C67'   D2 2C5C'              	JNC	SW_LP
  2C6A'   37                    	STC
  2C6B'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  2C6C'                         SRCH1:
  2C6C'   11 0000*              	LXI	D,SRCHST
  2C6F'   3A 0000*              	LDA	DIRFLG
  2C72'   B7                    	ORA	A
  2C73'   FA 2C97'              	JM	SR1_BK
  2C76'   21 0000*              	LXI	H,GAPEND
  2C79'   CD 0000*              	CALL	FWDCNT
  2C7C'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  2C7F'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  2C80'   3A 0000*              	LDA	SSKIP
  2C83'   B7                    	ORA	A
  2C84'   CA 2C8D'              	JZ	SR1_FW
  2C87'   78                    	MOV	A,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-137


  2C88'   B1                    	ORA	C
  2C89'   37                    	STC
  2C8A'   C8                    	RZ			; no room for a match even before the skip
  2C8B'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2C8C'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2C8D'                         SR1_FW:
  2C8D'   CD 0000*              	CALL	MATCHF
  2C90'   D8                    	RC
  2C91'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2C94'   C3 0000*              	JMP	PUTCUR
  2C97'                         SR1_BK:
  2C97'   21 0000*              	LXI	H,TXTBEG
  2C9A'   CD 0000*              	CALL	FWDCNT
  2C9D'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2CA0'   D8                    	RC
  2CA1'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2CA4'   CD 0000*              	CALL	MATCHB
  2CA7'   D8                    	RC
  2CA8'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2CAB'                         MSGNAM:
  2CAB'   E5                    	PUSH	H
  2CAC'   3E 22                 	MVI	A,'"'
  2CAE'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  2CB1'   E1                    	POP	H
  2CB2'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  2CB3'   23                    	INX	H
  2CB4'   7E                    	MOV	A,M
  2CB5'   FE 20                 	CPI	' '
  2CB7'   C2 2CC4'              	JNZ	MN_HAS
  2CBA'   21 28DE'              	LXI	H,SNONM
  2CBD'   CD 0000*              	CALL	OUTSTR
  2CC0'   E1                    	POP	H
  2CC1'   C3 2D0E'              	JMP	MN_END
	MACRO-80 3.44	09-Dec-81	PAGE	1-138


  2CC4'                         MN_HAS:
  2CC4'   0E 19                 	MVI	C,BF_CURDSK
  2CC6'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  2CC9'   E1                    	POP	H
  2CCA'   E5                    	PUSH	H
  2CCB'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  2CCC'   BE                    	CMP	M
  2CCD'   CA 2CDB'              	JZ	MN_NAM
  2CD0'   7E                    	MOV	A,M
  2CD1'   C6 40                 	ADI	'A'-1
  2CD3'   CD 0000*              	CALL	OUTCH
  2CD6'   3E 3A                 	MVI	A,':'
  2CD8'   CD 0000*              	CALL	OUTCH
  2CDB'                         MN_NAM:
  2CDB'   E1                    	POP	H
  2CDC'   E5                    	PUSH	H
  2CDD'   23                    	INX	H
  2CDE'   0E 08                 	MVI	C,8
  2CE0'                         MN_NM:
  2CE0'   7E                    	MOV	A,M
  2CE1'   FE 20                 	CPI	' '
  2CE3'   CA 2CEE'              	JZ	MN_EXT
  2CE6'   CD 0000*              	CALL	OUTCH
  2CE9'   23                    	INX	H
  2CEA'   0D                    	DCR	C
  2CEB'   C2 2CE0'              	JNZ	MN_NM
  2CEE'                         MN_EXT:
  2CEE'   E1                    	POP	H
  2CEF'   11 0009               	LXI	D,9
  2CF2'   19                    	DAD	D		; the type field
  2CF3'   7E                    	MOV	A,M
  2CF4'   FE 20                 	CPI	' '
  2CF6'   CA 2D0E'              	JZ	MN_END
  2CF9'   3E 2E                 	MVI	A,'.'
  2CFB'   CD 0000*              	CALL	OUTCH
  2CFE'   0E 03                 	MVI	C,3
  2D00'                         MN_XL:
  2D00'   7E                    	MOV	A,M
  2D01'   FE 20                 	CPI	' '
  2D03'   CA 2D0E'              	JZ	MN_END
  2D06'   CD 0000*              	CALL	OUTCH
  2D09'   23                    	INX	H
  2D0A'   0D                    	DCR	C
  2D0B'   C2 2D00'              	JNZ	MN_XL
  2D0E'                         MN_END:
  2D0E'   3E 22                 	MVI	A,'"'
  2D10'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  2D13'                         MSGFLG:
  2D13'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  2D15'   B7                    	ORA	A
  2D16'   CA 2D26'              	JZ	MF_RO
	MACRO-80 3.44	09-Dec-81	PAGE	1-139


  2D19'   3A 0000*              	LDA	MODF
  2D1C'   B7                    	ORA	A
  2D1D'   CA 2D26'              	JZ	MF_RO
  2D20'   21 28E8'              	LXI	H,SMODM
  2D23'   CD 2D3B'              	CALL	MF_PUT
  2D26'                         MF_RO:
  2D26'   3A 0000*              	LDA	ROFLAG
  2D29'   B7                    	ORA	A
  2D2A'   CA 2D33'              	JZ	MF_NEW
  2D2D'   21 28F3'              	LXI	H,SROM
  2D30'   CD 2D3B'              	CALL	MF_PUT
  2D33'                         MF_NEW:
  2D33'   3A 0000*              	LDA	MSGNEW
  2D36'   B7                    	ORA	A
  2D37'   C8                    	RZ
  2D38'   21 28FE'              	LXI	H,SNEWM
  2D3B'                         MF_PUT:
  2D3B'   78                    	MOV	A,B
  2D3C'   B7                    	ORA	A
  2D3D'   C2 2D49'              	JNZ	MF_STR
  2D40'   06 01                 	MVI	B,1
  2D42'   E5                    	PUSH	H
  2D43'   3E 20                 	MVI	A,' '
  2D45'   CD 0000*              	CALL	OUTCH
  2D48'   E1                    	POP	H
  2D49'                         MF_STR:
  2D49'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  2D4C'                         EMITW:
  2D4C'   C5                    	PUSH	B
  2D4D'   D5                    	PUSH	D
  2D4E'   06 00                 	MVI	B,0
  2D50'   11 2710               	LXI	D,10000
  2D53'   CD 2D71'              	CALL	EWDIG
  2D56'   11 03E8               	LXI	D,1000
  2D59'   CD 2D71'              	CALL	EWDIG
  2D5C'   11 0064               	LXI	D,100
  2D5F'   CD 2D71'              	CALL	EWDIG
  2D62'   11 000A               	LXI	D,10
  2D65'   CD 2D71'              	CALL	EWDIG
  2D68'   7D                    	MOV	A,L		; the units digit is always printed
  2D69'   C6 30                 	ADI	'0'
  2D6B'   CD 0000*              	CALL	OUTCH
  2D6E'   D1                    	POP	D
  2D6F'   C1                    	POP	B
  2D70'   C9                    	RET
  2D71'                         EWDIG:
  2D71'   0E 00                 	MVI	C,0
  2D73'                         EW_LP:
  2D73'   7D                    	MOV	A,L
  2D74'   93                    	SUB	E
  2D75'   6F                    	MOV	L,A
  2D76'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-140


  2D77'   9A                    	SBB	D
  2D78'   67                    	MOV	H,A
  2D79'   DA 2D80'              	JC	EW_DN
  2D7C'   0C                    	INR	C
  2D7D'   C3 2D73'              	JMP	EW_LP
  2D80'                         EW_DN:
  2D80'   19                    	DAD	D		; one subtraction too many: give it back
  2D81'   79                    	MOV	A,C
  2D82'   B7                    	ORA	A
  2D83'   C2 2D89'              	JNZ	EW_PR
  2D86'   78                    	MOV	A,B
  2D87'   B7                    	ORA	A
  2D88'   C8                    	RZ			; a leading zero: write nothing
  2D89'                         EW_PR:
  2D89'   79                    	MOV	A,C
  2D8A'   C6 30                 	ADI	'0'
  2D8C'   CD 0000*              	CALL	OUTCH
  2D8F'   06 01                 	MVI	B,1
  2D91'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  2D92'                         ISEMPT:
  2D92'   2A 0000*              	LHLD	OUTPOS
  2D95'   7C                    	MOV	A,H
  2D96'   B5                    	ORA	L
  2D97'   C0                    	RNZ
  2D98'   CD 0000*              	CALL	LOGLEN
  2D9B'   7C                    	MOV	A,H
  2D9C'   B5                    	ORA	L
  2D9D'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  2D9E'                         MSGCTG:
  2D9E'   21 0000*              	LXI	H,FNAME
  2DA1'   CD 2CAB'              	CALL	MSGNAM
  2DA4'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  2DA6'   CD 2D13'              	CALL	MSGFLG
  2DA9'   CD 2D92'              	CALL	ISEMPT
  2DAC'   C2 2DB5'              	JNZ	MG_POS
  2DAF'   21 2911'              	LXI	H,SNOLIN
  2DB2'   C3 0000*              	JMP	OUTSTR
  2DB5'                         MG_POS:
  2DB5'   21 2904'              	LXI	H,SLINE
  2DB8'   CD 0000*              	CALL	OUTSTR
  2DBB'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  2DBE'   23                    	INX	H		;   ... so the line it is on
  2DBF'   CD 2D4C'              	CALL	EMITW
  2DC2'   21 290B'              	LXI	H,SCOLM
  2DC5'   CD 0000*              	CALL	OUTSTR
  2DC8'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  2DCB'   23                    	INX	H
  2DCC'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-141


  2DCD'   CD 2D4C'              	CALL	EMITW
  2DD0'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  2DD3'   23                    	INX	H
  2DD4'   D1                    	POP	D
  2DD5'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  2DD8'   C8                    	RZ
  2DD9'   E5                    	PUSH	H
  2DDA'   3E 2D                 	MVI	A,'-'
  2DDC'   CD 0000*              	CALL	OUTCH
  2DDF'   E1                    	POP	H
  2DE0'   C3 2D4C'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  2DE3'                         FILMSG:
  2DE3'   3A 0001*              	LDA	FNAME+1
  2DE6'   FE 20                 	CPI	' '
  2DE8'   C8                    	RZ
  2DE9'   21 0000*              	LXI	H,FNAME
  2DEC'   CD 2CAB'              	CALL	MSGNAM
  2DEF'   AF                    	XRA	A		; nothing has been changed yet
  2DF0'   C3 2D13'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  2DF3'                         WRMSG:
  2DF3'   21 0000*              	LXI	H,TFCB
  2DF6'   CD 2CAB'              	CALL	MSGNAM
  2DF9'   21 2923'              	LXI	H,SWRIT
  2DFC'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  2DFF'                         MSGPST:
  2DFF'   3A 0000*              	LDA	MSGWHT
  2E02'   B7                    	ORA	A
  2E03'   C8                    	RZ
  2E04'   47                    	MOV	B,A
  2E05'   AF                    	XRA	A
  2E06'   32 0000*              	STA	MSGWHT
  2E09'   78                    	MOV	A,B
  2E0A'   FE 01                 	CPI	MW_FIL
  2E0C'   CA 2E28'              	JZ	MP_FIL
  2E0F'   FE 02                 	CPI	MW_WRT
  2E11'   CA 2E2E'              	JZ	MP_WRT
  2E14'   FE 04                 	CPI	MW_BIG
  2E16'   CA 2E1F'              	JZ	MP_BIG
  2E19'   CD 2D9E'              	CALL	MSGCTG
  2E1C'   C3 0000*              	JMP	SCURS
  2E1F'                         MP_BIG:
  2E1F'   21 28BF'              	LXI	H,SQBIG
  2E22'   CD 0000*              	CALL	EXMSG
  2E25'   C3 0000*              	JMP	SCURS
  2E28'                         MP_FIL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-142


  2E28'   CD 2DE3'              	CALL	FILMSG
  2E2B'   C3 0000*              	JMP	SCURS
  2E2E'                         MP_WRT:
  2E2E'   CD 2DF3'              	CALL	WRMSG
  2E31'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  2E34'                         VC_CTLG:
  2E34'   3E 03                 	MVI	A,MW_CTG
  2E36'   32 0000*              	STA	MSGWHT
  2E39'   3E 01                 	MVI	A,R_MOVE
  2E3B'   32 0000*              	STA	RINTENT
  2E3E'   C3 077D'              	JMP	GETCNT		; a count typed before it is spent here, not
                                				;   left for the next command
                                
  2E41'                         CMDTAB:
  2E41'   07                    	DB	07H			; ^G -- where am I?
  2E42'   2E34'                 	DW	VC_CTLG
  2E44'   68                    	DB	'h'
  2E45'   08CA'                 	DW	VC_H
