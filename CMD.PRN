  2CB1'   1CF8'                 	DW	VCB_P
  2CB3'   69                    	DB	'i'
  2CB4'   1826'                 	DW	VC_I
  2CB6'   61                    	DB	'a'
  2CB7'   182C'                 	DW	VC_A
  2CB9'   41                    	DB	'A'
  2CBA'   184C'                 	DW	VCB_A
  2CBC'   49                    	DB	'I'
  2CBD'   1868'                 	DW	VCB_I
  2CBF'   72                    	DB	'r'
  2CC0'   19AA'                 	DW	VC_R
  2CC2'   52                    	DB	'R'
  2CC3'   19FE'                 	DW	VCB_R
  2CC5'   64                    	DB	'd'
  2CC6'   1A13'                 	DW	VC_D
  2CC8'   44                    	DB	'D'
  2CC9'   17B6'                 	DW	VCB_D
  2CCB'   43                    	DB	'C'
