  29FC'   05                    	DB	ACT_LINST
  29FD'   0810'                 	DW	VC_0
  29FF'   06                    	DB	ACT_LINEN
  2A00'   086C'                 	DW	VC_EOL
  2A02'   07                    	DB	ACT_PGUP
  2A03'   0DB5'                 	DW	VC_PGUP
  2A05'   08                    	DB	ACT_PGDN
  2A06'   0D88'                 	DW	VC_PGDN
  2A08'   00                    	DB	0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  2A09'   00                    EDMODE: DB	EM_CMD
  2A0A'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  2A0C'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  2A0D'   00                    MODF:	DB	0		; 1 = unsaved changes
  2A0E'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  2A0F'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  2A10'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  2A11'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  2A12'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  2A14'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  2A15'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  2A16'   00                    HFROW:	DB	0		; ^D/^U: the cursor's row before the move
  2A17'   00                    HFAMT:	DB	0		; ^D/^U: lines (vim's 'scroll'); 0 = NEDIT/2
  2A18'   0000                  JKCNT:	DW	0		; j/k: count
  2A1A'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
	MACRO-80 3.44	09-Dec-81	PAGE	1-129


  2A1C'   0000                  JKMOV:	DW	0		; j: lines moved
  2A1E'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  2A20'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  2A21'   00                    JKLST:	DB	0		; j: last byte of the scan
  2A22'   0000                  JKVC:	DW	0		; j/k landing: screen column
  2A24'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  2A26'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  2A27'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  2A28'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  2A29'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  2A2A'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  2A2B'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  2A2D'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  2A2E'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  2A2F'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  2A31'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  2A32'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  2A33'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  2A34'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
  2A35'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  2A36'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  2A37'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   so it stops at the line's content end
  2A38'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  2A3A'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  2A3C'   00 00 00              OPSFP:	DB	0,0,0		; operator: the start as a place in the file
  2A3F'   00 00 00              OPSLO:	DB	0,0,0		; ... where its line starts
  2A42'   00 00 00              OPSHI:	DB	0,0,0		; ... where the next line does (OPPGD: the span's
                                				;   high end, whichever line that turned out to be)
  2A45'   00 00 00              OPTOGO: DB	0,0,0		; OPPGD: bytes still to take
  2A48'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  2A4A'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  2A4C'   0000                  CNTV:	DW	0		; motion repeat counter
  2A4E'   0000                  TTI:	DW	0		; TAILTAB scan index
  2A50'   0000                  WKI:	DW	0		; scan index
  2A52'   0000                  WKN:	DW	0		; cached LOGLEN
  2A54'   0000                  WKTERM: DW	0		; line terminator offset
  2A56'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  2A58'   00                    WKCLS:	DB	0		; word motion: class of the current run
  2A59'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  2A5A'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  2A5C'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  2A5E'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
  2A60'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
	MACRO-80 3.44	09-Dec-81	PAGE	1-130


  2A62'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  2A63'   00                    RLMAX:	DB	0		; RDLINE: capacity
  2A64'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  2A65'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  2A66'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  2A67'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  2A69'   00                    WPROW:	DB	0		; :w -- the cursor's row
  2A6A'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  2A6B'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2A6D'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  2A6F'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  2A70'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  2A72'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  2A74'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  2A75'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  2A76'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  2A77'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  2A78'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  2A79'   00                    PLUSF:	DB	0		; command line: '+' was given
  2A7A'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  2A7B'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  2A7C'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  2A7D'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  2A7F'   0000                  YPT:	DW	0		; yy: where the lines came from
  2A81'   0000                  PCNT:	DW	0		; p/P: copies still to put
  2A83'   0000                  PPT:	DW	0		; p/P: the first line put
  2A85'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  2A87'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  2A88'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  2A8A'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  2A8B'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  2A8C'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  2A8D'   00                    FNDKND: DB	0		; f/F/t/T: which find ';' repeats (0 = none yet)
  2A8E'   00                    FNDCH:	DB	0		; ... and the character it looked for
  2A8F'   00                    FNDRUN: DB	0		; the find THIS command is running (',' reverses)
  2A90'   00                    FNDSTP: DB	0		; how far along it starts: 2 for a 't' repeat
  2A91'   0000                  FNDN:	DW	0		; occurrences still to count off
  2A93'   0000                  FNDCUR: DW	0		; the cursor it started from
  2A95'   0000                  FNDLIM: DW	0		; ... and the end of the line it may not pass
  2A97'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  2A98'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  2A9B'   00 00 00              MKEDIT: DB	0,0,0		; MKSHFT: where in the file the edit is
  2A9E'   0000                  MKN:	DW	0		; ... how long it is
  2AA0'   00                    MKTYP:	DB	0		; ... and which way: 1 text went in, 2 came out
  2AA1'   00 00 00              MKPOS:	DB	0,0,0		; MKJMP: the file position being jumped to
  2AA4'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  2AA5'   00                    MKHOLD: DB	0		; set across YKGO's delete + put back (a yank
                                				;   that could not copy): MKSHFT must leave the
                                				;   marks alone through it
  2AA6'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  2AA8'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  2AAA'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  2AAC'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
	MACRO-80 3.44	09-Dec-81	PAGE	1-131


  2AAE'   00 00 00              YPFP:	DB	0,0,0		; ... and where in the file they start
                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  2AB1'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  2AB3'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
  2AB5'   0000                  SCNT:	DW	0		; searches still to do (the count)
  2AB7'   00 00 00              SOFF:	DB	0,0,0		; BRKON: where in the FILE the command began
  2ABA'   0000                  SLDLT:	DW	0		; ... and LNDLT: for a search that fails, and
                                				;   any move a ^C stops
  2ABC'   00                    BRKARM: DB	0		; nonzero: CNTTST looks for a ^C
  2ABD'   00                    BRKHIT: DB	0		; nonzero: one was found, and the count spent
  2ABE'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  2ABF'   00                    SRNGF:	DB	0		; ex: a line range was given
  2AC0'   0000                  SRNG1:	DW	0		; ex: its first line
  2AC2'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  2AC4'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  2AC5'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  2AC6'   00                    SANY:	DB	0		; ':s' something in the range has changed
  2AC7'   00                    SLCHG:	DB	0		; ':s' this line changed
  2AC8'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  2ACA'   0000                  SLINES: DW	0		; ':s' / ':N,Mw' lines of the range still to do
  2ACC'   00                    RWPTR:	DB	0		; ':N,Mw' the next free byte of the record at
                                				;   0080H, as that address's low byte
  2ACD'   00                    RWERR:	DB	0		; ':N,Mw' a record would not go: the disk is full
  2ACE'   00                    RDANY:	DB	0		; ':r' something has been read in
  2ACF'   00                    RDBRK:	DB	0		; ':r' the line above wants a line end first
  2AD0'   00 00 00              SOFFS:	DB	0,0,0		; ':s' the cursor's place in the file, for one that
  2AD3'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  2AD5'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  2AD6'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
