  2A1D'   1768'                 	DW	VCB_R
  2A1F'   64                    	DB	'd'
  2A20'   177D'                 	DW	VC_D
  2A22'   44                    	DB	'D'
  2A23'   1520'                 	DW	VCB_D
  2A25'   43                    	DB	'C'
  2A26'   151A'                 	DW	VCB_C
  2A28'   63                    	DB	'c'
  2A29'   1785'                 	DW	VC_C
