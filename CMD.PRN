  0A7E'   C9                    	RET
  0A7F'                         BK_WD:
  0A7F'   32 2496'              	STA	WKCLS		; back to the start of this word
  0A82'                         BK_WLP:
  0A82'   CD 0B14'              	CALL	DECC
  0A85'   B7                    	ORA	A
  0A86'   FA 0A96'              	JM	BK_OK		; the start of the file
  0A89'   CD 0A98'              	CALL	CCLS
  0A8C'   21 2496'              	LXI	H,WKCLS
  0A8F'   BE                    	CMP	M
  0A90'   CA 0A82'              	JZ	BK_WLP
  0A93'   CD 0AD2'              	CALL	INCC		; overshot: forward one
  0A96'                         BK_OK:
  0A96'   AF                    	XRA	A
  0A97'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0A98'                         CCLS:
  0A98'   CD 091C'              	CALL	ATEOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0A9B'   D2 0627'              	JNC	CLASSF
  0A9E'   AF                    	XRA	A
  0A9F'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0AA0'                         EMPTY:
  0AA0'   CD 091C'              	CALL	ATEOF
  0AA3'   DA 0AAE'              	JC	EM_ST
  0AA6'   FE 0D                 	CPI	CR
  0AA8'   CA 0AAE'              	JZ	EM_ST
  0AAB'   FE 0A                 	CPI	LF
  0AAD'   C0                    	RNZ
  0AAE'                         EM_ST:
  0AAE'   CD 0000*              	CALL	PEEKL
  0AB1'   DA 0AB7'              	JC	EM_Y
  0AB4'   FE 0A                 	CPI	LF
  0AB6'   C9                    	RET
  0AB7'                         EM_Y:
  0AB7'   AF                    	XRA	A
  0AB8'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0AB9'                         NXLN:
  0AB9'   FE 0A                 	CPI	LF
  0ABB'   CA 0ACA'              	JZ	NX_LF
  0ABE'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0AC1'   D8                    	RC
  0AC2'   FE 0A                 	CPI	LF
  0AC4'   CA 0ACA'              	JZ	NX_LF
  0AC7'   2B                    	DCX	H		; a lone CR
  0AC8'   AF                    	XRA	A
  0AC9'   C9                    	RET
  0ACA'                         NX_LF:
  0ACA'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0ACD'   D8                    	RC
  0ACE'   2B                    	DCX	H
  0ACF'   3E 01                 	MVI	A,1
  0AD1'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0AD2'                         INCC:
  0AD2'   CD 091C'              	CALL	ATEOF
  0AD5'   DA 0B10'              	JC	IC_END
  0AD8'   FE 0D                 	CPI	CR
  0ADA'   CA 0AFB'              	JZ	IC_NL
  0ADD'   FE 0A                 	CPI	LF
  0ADF'   CA 0AFB'              	JZ	IC_NL
  0AE2'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0AE5'                         IC_CH:
  0AE5'   CD 091C'              	CALL	ATEOF
  0AE8'   DA 0AF7'              	JC	IC_2
  0AEB'   FE 0D                 	CPI	CR
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0AED'   CA 0AF7'              	JZ	IC_2
  0AF0'   FE 0A                 	CPI	LF
  0AF2'   CA 0AF7'              	JZ	IC_2
  0AF5'   AF                    	XRA	A
  0AF6'   C9                    	RET
  0AF7'                         IC_2:
  0AF7'   3E 02                 	MVI	A,2
  0AF9'   B7                    	ORA	A
  0AFA'   C9                    	RET
  0AFB'                         IC_NL:
  0AFB'   CD 0AB9'              	CALL	NXLN
  0AFE'   DA 0B10'              	JC	IC_END
  0B01'   F5                    	PUSH	PSW
  0B02'   CD 0000*              	CALL	PUTCUR
  0B05'   F1                    	POP	PSW
  0B06'   B7                    	ORA	A
  0B07'   CA 0AE5'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0B0A'   CD 0B36'              	CALL	LNINC
  0B0D'   3E 01                 	MVI	A,1
  0B0F'   C9                    	RET
  0B10'                         IC_END:
  0B10'   3E FF                 	MVI	A,0FFH
  0B12'   B7                    	ORA	A
  0B13'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0B14'                         DECC:
  0B14'   CD 0000*              	CALL	PEEKL
  0B17'   DA 0B10'              	JC	IC_END
  0B1A'   F5                    	PUSH	PSW
  0B1B'   CD 0000*              	CALL	PUTCUR
  0B1E'   F1                    	POP	PSW
  0B1F'   FE 0A                 	CPI	LF
  0B21'   3E 00                 	MVI	A,0
  0B23'   C0                    	RNZ
  0B24'   CD 0B44'              	CALL	LNDEC
  0B27'   CD 0000*              	CALL	PEEKL		; onto its CR
  0B2A'   DA 0B32'              	JC	DC_1
  0B2D'   FE 0D                 	CPI	CR
  0B2F'   CC 0000*              	CZ	PUTCUR
  0B32'                         DC_1:
  0B32'   3E 01                 	MVI	A,1
  0B34'   B7                    	ORA	A
  0B35'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0B36'                         LNINC:
  0B36'   E5                    	PUSH	H
  0B37'   2A 0000*              	LHLD	LNDLT
  0B3A'   7C                    	MOV	A,H
  0B3B'   FE 40                 	CPI	40H
  0B3D'   CA 0B52'              	JZ	LN_X
  0B40'   23                    	INX	H
  0B41'   C3 0B4F'              	JMP	LN_ST
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0B44'                         LNDEC:
  0B44'   E5                    	PUSH	H
  0B45'   2A 0000*              	LHLD	LNDLT
  0B48'   7C                    	MOV	A,H
  0B49'   FE C0                 	CPI	0C0H
  0B4B'   CA 0B52'              	JZ	LN_X
  0B4E'   2B                    	DCX	H
  0B4F'                         LN_ST:
  0B4F'   22 0000*              	SHLD	LNDLT
  0B52'                         LN_X:
  0B52'   E1                    	POP	H
  0B53'   C9                    	RET
                                
  0B54'   AF                    VC_E:	XRA	A
  0B55'   32 245E'              	STA	WBIG
  0B58'   C3 0B60'              	JMP	EDO
  0B5B'   3E 01                 VCBGE:	MVI	A,1
  0B5D'   32 245E'              	STA	WBIG
  0B60'   CD 0672'              EDO:	CALL	SETMOV
  0B63'   CD 0605'              	CALL	GETCNT
  0B66'   22 248A'              	SHLD	CNTV
  0B69'   2A 248A'              EDO_LP: LHLD	CNTV
  0B6C'   7C                    	MOV	A,H
  0B6D'   B5                    	ORA	L
  0B6E'   C8                    	RZ
  0B6F'   2B                    	DCX	H
  0B70'   22 248A'              	SHLD	CNTV
  0B73'   CD 0B79'              	CALL	ESTEP
  0B76'   C3 0B69'              	JMP	EDO_LP
                                
                                ;ESTEP -- forward to the end of the next word.
  0B79'                         ESTEP:
  0B79'   CD 0000*              	CALL	CUROFF
  0B7C'   22 248E'              	SHLD	WKI
  0B7F'   CD 0000*              	CALL	LOGLEN
  0B82'   22 2490'              	SHLD	WKN
  0B85'   2A 248E'              	LHLD	WKI
  0B88'   23                    	INX	H
  0B89'   22 248E'              	SHLD	WKI
  0B8C'                         ES_WS:
  0B8C'   2A 248E'              	LHLD	WKI
  0B8F'   EB                    	XCHG
  0B90'   2A 2490'              	LHLD	WKN
  0B93'   CD 0000*              	CALL	CMP16
  0B96'   D2 0BE4'              	JNC	ES_LND
  0B99'   2A 248E'              	LHLD	WKI
  0B9C'   CD 0000*              	CALL	CHARAT
  0B9F'   CD 0627'              	CALL	CLASSF
  0BA2'   B7                    	ORA	A
  0BA3'   C2 0BB0'              	JNZ	ES_WD
  0BA6'   2A 248E'              	LHLD	WKI
  0BA9'   23                    	INX	H
  0BAA'   22 248E'              	SHLD	WKI
  0BAD'   C3 0B8C'              	JMP	ES_WS
  0BB0'                         ES_WD:
  0BB0'   2A 248E'              	LHLD	WKI
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0BB3'   CD 0000*              	CALL	CHARAT
  0BB6'   CD 0627'              	CALL	CLASSF
  0BB9'   32 2496'              	STA	WKCLS
  0BBC'                         ES_RUN:
  0BBC'   2A 248E'              	LHLD	WKI
  0BBF'   23                    	INX	H
  0BC0'   EB                    	XCHG			; DE = i+1
  0BC1'   2A 2490'              	LHLD	WKN
  0BC4'   CD 0000*              	CALL	CMP16		; DE=(i+1) vs HL=n: CY iff (i+1) < n
  0BC7'   D2 0BE4'              	JNC	ES_LND
  0BCA'   2A 248E'              	LHLD	WKI
  0BCD'   23                    	INX	H
  0BCE'   E5                    	PUSH	H		; i+1
  0BCF'   CD 0000*              	CALL	CHARAT
  0BD2'   CD 0627'              	CALL	CLASSF
  0BD5'   E1                    	POP	H		; HL = i+1
  0BD6'   47                    	MOV	B,A
  0BD7'   3A 2496'              	LDA	WKCLS
  0BDA'   B8                    	CMP	B
  0BDB'   C2 0BE4'              	JNZ	ES_LND
  0BDE'   22 248E'              	SHLD	WKI
  0BE1'   C3 0BBC'              	JMP	ES_RUN
  0BE4'                         ES_LND:
  0BE4'   2A 2490'              	LHLD	WKN
  0BE7'   EB                    	XCHG
  0BE8'   2A 248E'              	LHLD	WKI
  0BEB'   CD 0000*              	CALL	CMP16		; DE=n vs HL=i: CY iff n < i
  0BEE'   DA 0BFA'              	JC	ES_CL
  0BF1'   CA 0BFA'              	JZ	ES_CL
  0BF4'   2A 248E'              	LHLD	WKI
  0BF7'   C3 04F4'              	JMP	GOSET
  0BFA'                         ES_CL:
  0BFA'   2A 2490'              	LHLD	WKN
  0BFD'   7C                    	MOV	A,H
  0BFE'   B5                    	ORA	L
  0BFF'   C8                    	RZ
  0C00'   2B                    	DCX	H
  0C01'   C3 04F4'              	JMP	GOSET
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0C04'                         CURRW:
  0C04'   2A 0000*              	LHLD	WINROW
  0C07'   EB                    	XCHG
  0C08'   2A 0000*              	LHLD	LNDLT
  0C0B'   19                    	DAD	D		; HL = row (signed)
  0C0C'   7C                    	MOV	A,H
  0C0D'   B7                    	ORA	A
  0C0E'   FA 0C21'              	JM	CRW_0		; above the screen -> top row
  0C11'   C2 0C1C'              	JNZ	CRW_BT		; far below -> bottom row
  0C14'   3A 0000*              	LDA	NEDIT
  0C17'   3D                    	DCR	A		; A = bottom row
  0C18'   BD                    	CMP	L		; CY iff bottom < row
  0C19'   D8                    	RC
  0C1A'   7D                    	MOV	A,L
  0C1B'   C9                    	RET
  0C1C'                         CRW_BT:
  0C1C'   3A 0000*              	LDA	NEDIT
  0C1F'   3D                    	DCR	A
  0C20'   C9                    	RET
  0C21'                         CRW_0:
  0C21'   AF                    	XRA	A
  0C22'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0C23'                         SETRWT:
  0C23'   2A 0000*              	LHLD	LNDLT
  0C26'   EB                    	XCHG
  0C27'   6F                    	MOV	L,A
  0C28'   26 00                 	MVI	H,0
  0C2A'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0C2D'   22 0000*              	SHLD	WINROW
  0C30'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0C31'                         MVROW:
  0C31'   47                    	MOV	B,A
  0C32'   CD 0C04'              	CALL	CURRW
  0C35'   90                    	SUB	B		; A = row now - target
  0C36'   C8                    	RZ
  0C37'   DA 0C40'              	JC	MR_DN
  0C3A'   6F                    	MOV	L,A
  0C3B'   26 00                 	MVI	H,0
  0C3D'   C3 088B'              	JMP	KCORE
  0C40'                         MR_DN:
  0C40'   2F                    	CMA
  0C41'   3C                    	INR	A		; A = target - row now
  0C42'   6F                    	MOV	L,A
  0C43'   26 00                 	MVI	H,0
  0C45'   C3 07EE'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0C48'                         VC_HIGH:
  0C48'   CD 05F2'              	CALL	MOVCNT		; a cursor motion, and its count
  0C4B'   2B                    	DCX	H		; row = count - 1
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0C4C'   7C                    	MOV	A,H
  0C4D'   B7                    	ORA	A
  0C4E'   3A 0000*              	LDA	SCBOT
  0C51'   C2 0C59'              	JNZ	VH_GO		; >= 256 -> the last text row
  0C54'   BD                    	CMP	L		; CY iff SCBOT < row
  0C55'   DA 0C59'              	JC	VH_GO
  0C58'   7D                    	MOV	A,L
  0C59'                         VH_GO:
  0C59'   CD 0C31'              	CALL	MVROW
  0C5C'   C3 0740'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0C5F'                         VC_MIDL:
  0C5F'   CD 05F2'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0C62'   3A 0000*              	LDA	SCBOT
  0C65'   B7                    	ORA	A		; clear CY for the shift
  0C66'   1F                    	RAR			; A = SCBOT / 2
  0C67'   CD 0C31'              	CALL	MVROW
  0C6A'   C3 0740'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0C6D'                         VC_LOWL:
  0C6D'   CD 05F2'              	CALL	MOVCNT		; a cursor motion, and its count
  0C70'   2B                    	DCX	H		; count - 1
  0C71'   3A 0000*              	LDA	SCBOT
  0C74'   5F                    	MOV	E,A
  0C75'   16 00                 	MVI	D,0
  0C77'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0C78'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0C7B'   3E 00                 	MVI	A,0
  0C7D'   D2 0C84'              	JNC	VL_GO		; at or past the top -> row 0
  0C80'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0C83'   7D                    	MOV	A,L
  0C84'                         VL_GO:
  0C84'   CD 0C31'              	CALL	MVROW
  0C87'   C3 0740'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0C8A'                         VC_PGDN:
  0C8A'   CD 05F2'              	CALL	MOVCNT		; a cursor motion, and its count
  0C8D'   3A 0000*              	LDA	SCEOF
  0C90'   B7                    	ORA	A
  0C91'   CA 0C9F'              	JZ	VPD_N
  0C94'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0C97'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0C98'   C8                    	RZ			; it already is
  0C99'   CD 0C31'              	CALL	MVROW
  0C9C'   C3 0CB0'              	JMP	VPD_TP
  0C9F'                         VPD_N:
  0C9F'   3A 0000*              	LDA	NEDIT
  0CA2'   D6 02                 	SUI	2
  0CA4'   CD 0CF8'              	CALL	MULSAT		; HL = count * (NEDIT-2)
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0CA7'   E5                    	PUSH	H
  0CA8'   AF                    	XRA	A
  0CA9'   CD 0C31'              	CALL	MVROW		; the top line
  0CAC'   E1                    	POP	H
  0CAD'   CD 07EE'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0CB0'                         VPD_TP:
  0CB0'   AF                    	XRA	A
  0CB1'   CD 0C23'              	CALL	SETRWT		; to the top row
  0CB4'   C3 0740'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0CB7'                         VC_PGUP:
  0CB7'   CD 05F2'              	CALL	MOVCNT		; a cursor motion, and its count
  0CBA'   3A 0000*              	LDA	SCBOF
  0CBD'   B7                    	ORA	A
  0CBE'   C0                    	RNZ
  0CBF'   3A 0000*              	LDA	NEDIT
  0CC2'   47                    	MOV	B,A
  0CC3'   3A 0000*              	LDA	SCEOF
  0CC6'   B7                    	ORA	A
  0CC7'   CA 0CD8'              	JZ	VPU_2
  0CCA'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0CCD'   FE 02                 	CPI	2
  0CCF'   D2 0CD8'              	JNC	VPU_2
  0CD2'   2F                    	CMA
  0CD3'   3C                    	INR	A
  0CD4'   80                    	ADD	B
  0CD5'   C3 0CDB'              	JMP	VPU_P
  0CD8'                         VPU_2:
  0CD8'   78                    	MOV	A,B
  0CD9'   D6 02                 	SUI	2
  0CDB'                         VPU_P:
  0CDB'   CD 0CF8'              	CALL	MULSAT		; HL = count * page
  0CDE'   E5                    	PUSH	H
  0CDF'   AF                    	XRA	A
  0CE0'   CD 0C31'              	CALL	MVROW		; the top line
  0CE3'   E1                    	POP	H
  0CE4'   CD 088B'              	CALL	KCORE		; the new top line
  0CE7'   AF                    	XRA	A
  0CE8'   CD 0C23'              	CALL	SETRWT		; on the top row
  0CEB'   3A 0000*              	LDA	NEDIT
  0CEE'   3D                    	DCR	A
  0CEF'   6F                    	MOV	L,A
  0CF0'   26 00                 	MVI	H,0
  0CF2'   CD 07EE'              	CALL	JCORE		; the bottom row's line
  0CF5'   C3 0740'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0CF8'                         MULSAT:
  0CF8'   EB                    	XCHG
  0CF9'   21 0000               	LXI	H,0
  0CFC'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0CFD'   C8                    	RZ
  0CFE'                         MS_LP:
  0CFE'   19                    	DAD	D
  0CFF'   DA 0D07'              	JC	MS_SAT
  0D02'   3D                    	DCR	A
  0D03'   C2 0CFE'              	JNZ	MS_LP
  0D06'   C9                    	RET
  0D07'                         MS_SAT:
  0D07'   21 FFFF               	LXI	H,0FFFFH
  0D0A'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0D0B'                         VC_HFDN:
  0D0B'   CD 0672'              	CALL	SETMOV
  0D0E'   CD 0C04'              	CALL	CURRW
  0D11'   32 2460'              	STA	HFROW
  0D14'   CD 0D82'              	CALL	HFCNT		; HL = lines
  0D17'   3A 2460'              	LDA	HFROW
  0D1A'   47                    	MOV	B,A
  0D1B'   3A 0000*              	LDA	SCEOF
  0D1E'   B7                    	ORA	A
  0D1F'   CA 0D27'              	JZ	VHD_GO
  0D22'   3A 0000*              	LDA	SCBOT		; the last line's row
  0D25'   B8                    	CMP	B
  0D26'   C8                    	RZ			; the cursor is on it
  0D27'                         VHD_GO:
  0D27'   CD 07EE'              	CALL	JCORE
  0D2A'   3A 0000*              	LDA	SCEOF
  0D2D'   B7                    	ORA	A
  0D2E'   C2 0740'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0D31'   3A 2460'              	LDA	HFROW
  0D34'   CD 0C23'              	CALL	SETRWT
  0D37'   3E 01                 	MVI	A,1
  0D39'   32 0000*              	STA	WFILL		; not past the end of the file
  0D3C'   C3 0740'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0D3F'                         VC_HFUP:
  0D3F'   CD 0672'              	CALL	SETMOV
  0D42'   CD 0C04'              	CALL	CURRW
  0D45'   32 2460'              	STA	HFROW
  0D48'   CD 0D82'              	CALL	HFCNT		; HL = lines
  0D4B'   CD 0D62'              	CALL	ONFST
  0D4E'   C8                    	RZ			; the cursor is on the first line
  0D4F'   CD 088B'              	CALL	KCORE
  0D52'   3A 0000*              	LDA	SCBOF
  0D55'   B7                    	ORA	A
  0D56'   C2 0740'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0D59'   3A 2460'              	LDA	HFROW
  0D5C'   CD 0C23'              	CALL	SETRWT
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D5F'   C3 0740'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0D62'                         ONFST:
  0D62'   E5                    	PUSH	H
  0D63'   2A 0000*              	LHLD	OUTPOS
  0D66'   7C                    	MOV	A,H
  0D67'   B5                    	ORA	L
  0D68'   C2 0D80'              	JNZ	OF_RET
  0D6B'   2A 0000*              	LHLD	TXTBEG
  0D6E'   EB                    	XCHG			; DE = TXTBEG
  0D6F'   2A 0000*              	LHLD	GAPBEG
  0D72'                         OF_LP:
  0D72'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0D75'   CA 0D80'              	JZ	OF_RET
  0D78'   2B                    	DCX	H
  0D79'   7E                    	MOV	A,M
  0D7A'   FE 0A                 	CPI	LF
  0D7C'   C2 0D72'              	JNZ	OF_LP
  0D7F'   B7                    	ORA	A		; NZ
  0D80'                         OF_RET:
  0D80'   E1                    	POP	H
  0D81'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0D82'                         HFCNT:
  0D82'   2A 2454'              	LHLD	CMDCNT
  0D85'   7C                    	MOV	A,H
  0D86'   B5                    	ORA	L
  0D87'   CA 0D9E'              	JZ	HFC_AM
  0D8A'   CD 0605'              	CALL	GETCNT		; HL = count; clears it
  0D8D'   3A 0000*              	LDA	NEDIT
  0D90'   5F                    	MOV	E,A
  0D91'   16 00                 	MVI	D,0
  0D93'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0D96'   D2 0D9A'              	JNC	HFC_ST
  0D99'   EB                    	XCHG			; HL = NEDIT
  0D9A'                         HFC_ST:
  0D9A'   7D                    	MOV	A,L
  0D9B'   32 2461'              	STA	HFAMT
  0D9E'                         HFC_AM:
  0D9E'   3A 2461'              	LDA	HFAMT
  0DA1'   B7                    	ORA	A
  0DA2'   C2 0DAF'              	JNZ	HFC_HL
  0DA5'   3A 0000*              	LDA	NEDIT
  0DA8'   B7                    	ORA	A
  0DA9'   1F                    	RAR
  0DAA'   B7                    	ORA	A
  0DAB'   C2 0DAF'              	JNZ	HFC_HL
  0DAE'   3C                    	INR	A		; at least one line
  0DAF'                         HFC_HL:
  0DAF'   6F                    	MOV	L,A
  0DB0'   26 00                 	MVI	H,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0DB2'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0DB3'                         VC_REDR:
  0DB3'   C3 0605'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0DB6'                         VC_G:
  0DB6'   CD 0672'              	CALL	SETMOV
  0DB9'   CD 0E49'              	CALL	GZONE		; the screen's top line, before the move
  0DBC'   2A 2454'              	LHLD	CMDCNT
  0DBF'   7C                    	MOV	A,H
  0DC0'   B5                    	ORA	L
  0DC1'   C2 0DCE'              	JNZ	VG_N
  0DC4'   AF                    	XRA	A		; forward
  0DC5'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0DC8'   CD 0922'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0DCB'   C3 0E61'              	JMP	GPLACE
  0DCE'                         VG_N:
  0DCE'   CD 0605'              	CALL	GETCNT		; HL = target line (1-based)
  0DD1'                         VG_LN:
  0DD1'   CD 0DD7'              	CALL	GOLN
  0DD4'   C3 0E61'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
  0DD7'                         GOLN:
  0DD7'   2B                    	DCX	H		; lines to move from line 1
  0DD8'   E5                    	PUSH	H
  0DD9'   3E FF                 	MVI	A,0FFH
  0DDB'   CD 0000*              	CALL	MVLMAX		; to BOF
  0DDE'   E1                    	POP	H
  0DDF'   AF                    	XRA	A
  0DE0'   CD 0000*              	CALL	MVLIND		; forward count-1 lines
  0DE3'   CD 091C'              	CALL	ATEOF
  0DE6'   DC 0922'              	CC	LASTLN		; past the last line: onto it
  0DE9'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0DEA'                         VC_LG:
  0DEA'   CD 0672'              	CALL	SETMOV
  0DED'   3A 247C'              	LDA	GSAVE
  0DF0'   B7                    	ORA	A
  0DF1'   C2 0DFA'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0DF4'   3E 01                 	MVI	A,PG
  0DF6'   32 247B'              	STA	GPEND
  0DF9'   C9                    	RET
  0DFA'                         VLG_GG:
  0DFA'   CD 0E49'              	CALL	GZONE
  0DFD'   CD 0605'              	CALL	GETCNT		; HL = target line (no count: 1)
  0E00'   C3 0DD1'              	JMP	VG_LN
                                
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0E03'                         FPOS:
  0E03'   C5                    	PUSH	B
  0E04'   D5                    	PUSH	D
  0E05'   EB                    	XCHG
  0E06'   2A 0000*              	LHLD	TXTBEG
  0E09'   EB                    	XCHG
  0E0A'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0E0D'   EB                    	XCHG			; DE = that
  0E0E'   2A 0000*              	LHLD	OUTPOS
  0E11'   7C                    	MOV	A,H
  0E12'   B7                    	ORA	A		; CY = 0
  0E13'   1F                    	RAR
  0E14'   47                    	MOV	B,A
  0E15'   7D                    	MOV	A,L
  0E16'   1F                    	RAR
  0E17'   67                    	MOV	H,A
  0E18'   3E 00                 	MVI	A,0
  0E1A'   1F                    	RAR
  0E1B'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0E1C'   19                    	DAD	D
  0E1D'   78                    	MOV	A,B
  0E1E'   CE 00                 	ACI	0		; A:HL = the position
  0E20'   D1                    	POP	D
  0E21'   C1                    	POP	B
  0E22'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0E23'                         ZSAVE:
  0E23'   2A 2454'              	LHLD	CMDCNT
  0E26'   22 24AE'              	SHLD	ZSVCNT
  0E29'   2A 0000*              	LHLD	AUXCNT
  0E2C'   22 24B0'              	SHLD	ZSVAUX
  0E2F'   3A 0000*              	LDA	DIRFLG
  0E32'   32 24B2'              	STA	ZSVDIR
  0E35'   C9                    	RET
  0E36'                         ZREST:
  0E36'   2A 24AE'              	LHLD	ZSVCNT
  0E39'   22 2454'              	SHLD	CMDCNT
  0E3C'   2A 24B0'              	LHLD	ZSVAUX
  0E3F'   22 0000*              	SHLD	AUXCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0E42'   3A 24B2'              	LDA	ZSVDIR
  0E45'   32 0000*              	STA	DIRFLG
  0E48'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0E49'                         GZONE:
  0E49'   CD 0E23'              	CALL	ZSAVE
  0E4C'   CD 0C04'              	CALL	CURRW
  0E4F'   6F                    	MOV	L,A
  0E50'   26 00                 	MVI	H,0
  0E52'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0E55'   CD 0E03'              	CALL	FPOS
  0E58'   22 0000*              	SHLD	ZTOP
  0E5B'   32 0002*              	STA	ZTOP+2
  0E5E'   C3 0E36'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0E61'                         GPLACE:
  0E61'   CD 0E23'              	CALL	ZSAVE
  0E64'   2A 0000*              	LHLD	GAPBEG
  0E67'   CD 0E03'              	CALL	FPOS
  0E6A'   EB                    	XCHG
  0E6B'   4F                    	MOV	C,A		; C:DE = the target's position
  0E6C'   2A 0000*              	LHLD	ZTOP
  0E6F'   7B                    	MOV	A,E
  0E70'   95                    	SUB	L
  0E71'   6F                    	MOV	L,A
  0E72'   7A                    	MOV	A,D
  0E73'   9C                    	SBB	H
  0E74'   67                    	MOV	H,A
  0E75'   22 24AB'              	SHLD	ZDIF
  0E78'   3A 0002*              	LDA	ZTOP+2
  0E7B'   47                    	MOV	B,A
  0E7C'   79                    	MOV	A,C
  0E7D'   98                    	SBB	B		; A:ZDIF = target - top; CY iff above the top
  0E7E'   DA 0ECB'              	JC	GP_UP
  0E81'   B7                    	ORA	A
  0E82'   C2 0F0C'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0E85'   3A 0000*              	LDA	NEDIT
  0E88'   5F                    	MOV	E,A
  0E89'   16 00                 	MVI	D,0
  0E8B'   B7                    	ORA	A
  0E8C'   1F                    	RAR
  0E8D'   6F                    	MOV	L,A
  0E8E'   26 00                 	MVI	H,0
  0E90'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0E91'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0E94'   CD 05FE'              	CALL	GBSUB		; HL = bytes from there to the target
  0E97'   EB                    	XCHG
  0E98'   2A 24AB'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0E9B'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0E9E'   DA 0F0C'              	JC	GP_MID
  0EA1'   CD 05FE'              	CALL	GBSUB		; HL = the top line's start (resident)
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0EA4'   01 0000               	LXI	B,0		; BC = lines from the top
  0EA7'                         GP_CNT:
  0EA7'   7A                    	MOV	A,D
  0EA8'   B3                    	ORA	E
  0EA9'   CA 0EB8'              	JZ	GP_DN
  0EAC'   7E                    	MOV	A,M
  0EAD'   23                    	INX	H
  0EAE'   1B                    	DCX	D
  0EAF'   FE 0A                 	CPI	LF
  0EB1'   C2 0EA7'              	JNZ	GP_CNT
  0EB4'   03                    	INX	B
  0EB5'   C3 0EA7'              	JMP	GP_CNT
  0EB8'                         GP_DN:
  0EB8'   3A 0000*              	LDA	NEDIT
  0EBB'   3D                    	DCR	A
  0EBC'   5F                    	MOV	E,A
  0EBD'   16 00                 	MVI	D,0		; DE = the bottom row
  0EBF'   60                    	MOV	H,B
  0EC0'   69                    	MOV	L,C
  0EC1'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0EC4'   DA 0F16'              	JC	GP_SET		; A = the bottom row
  0EC7'   7D                    	MOV	A,L		; on the screen: its row
  0EC8'   C3 0F36'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0ECB'                         GP_UP:
  0ECB'   3C                    	INR	A
  0ECC'   C2 0F0C'              	JNZ	GP_MID		; 64K bytes or more above
  0ECF'   2A 24AB'              	LHLD	ZDIF
  0ED2'   EB                    	XCHG
  0ED3'   21 0000               	LXI	H,0
  0ED6'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0ED9'   7C                    	MOV	A,H
  0EDA'   B5                    	ORA	L
  0EDB'   CA 0F0C'              	JZ	GP_MID		; exactly 64K
  0EDE'   EB                    	XCHG			; DE = bytes to read
  0EDF'   AF                    	XRA	A
  0EE0'   32 24AD'              	STA	ZLF
  0EE3'   CD 0000*              	CALL	RGET0
  0EE6'                         GP_RD:
  0EE6'   CD 0000*              	CALL	RDGET		; (keeps DE)
  0EE9'   DA 0F0C'              	JC	GP_MID
  0EEC'   FE 0A                 	CPI	LF
  0EEE'   C2 0F02'              	JNZ	GP_RN
  0EF1'   3A 0000*              	LDA	NEDIT
  0EF4'   B7                    	ORA	A
  0EF5'   1F                    	RAR
  0EF6'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  0EF8'   E5                    	PUSH	H
  0EF9'   21 24AD'              	LXI	H,ZLF
  0EFC'   34                    	INR	M
  0EFD'   BE                    	CMP	M		; CY iff more lines than that
  0EFE'   E1                    	POP	H
  0EFF'   DA 0F0C'              	JC	GP_MID
  0F02'                         GP_RN:
  0F02'   1B                    	DCX	D
  0F03'   7A                    	MOV	A,D
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0F04'   B3                    	ORA	E
  0F05'   C2 0EE6'              	JNZ	GP_RD
  0F08'   AF                    	XRA	A		; the top row
  0F09'   C3 0F16'              	JMP	GP_SET
  0F0C'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  0F0C'   3E 01                 	MVI	A,1
  0F0E'   32 0000*              	STA	WFILL		; not past the end of the file
  0F11'   3A 0000*              	LDA	NEDIT
  0F14'   B7                    	ORA	A
  0F15'   1F                    	RAR			; the middle row
  0F16'                         GP_SET:
  0F16'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  0F17'   26 00                 	MVI	H,0
  0F19'   22 0000*              	SHLD	WINROW
  0F1C'   21 0000               	LXI	H,0
  0F1F'   22 0000*              	SHLD	LNDLT
  0F22'   CD 0693'              	CALL	SETFUL		; the window may have paged: full repaint
  0F25'                         GP_FIN:
  0F25'   CD 0E36'              	CALL	ZREST
  0F28'   3A 24D5'              	LDA	GPKEEP
  0F2B'   B7                    	ORA	A
  0F2C'   CA 0740'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  0F2F'   AF                    	XRA	A
  0F30'   32 24D5'              	STA	GPKEEP
  0F33'   C3 04F7'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  0F36'                         GP_ONS:
  0F36'   6F                    	MOV	L,A
  0F37'   26 00                 	MVI	H,0		; HL = the row it lands on
  0F39'   EB                    	XCHG
  0F3A'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  0F3D'   EB                    	XCHG
  0F3E'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  0F41'   22 0000*              	SHLD	LNDLT
  0F44'   3E 01                 	MVI	A,R_MOVE
  0F46'   32 2458'              	STA	RINTENT
  0F49'   C3 0F25'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  0F4C'                         OPPEND:
  0F4C'   AF                    	XRA	A
  0F4D'   32 2481'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  0F50'   3A 247E'              	LDA	PSAVE
  0F53'   FE 63                 	CPI	'c'
  0F55'   C2 0F72'              	JNZ	OPP_ND
  0F58'   79                    	MOV	A,C
  0F59'   FE 77                 	CPI	'w'
  0F5B'   CA 0F63'              	JZ	OPP_W
  0F5E'   FE 57                 	CPI	'W'
  0F60'   C2 0F72'              	JNZ	OPP_ND
  0F63'                         OPP_W:
  0F63'   CD 0FEC'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  0F66'   DA 0F72'              	JC	OPP_ND
  0F69'   79                    	MOV	A,C
  0F6A'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  0F6C'   4F                    	MOV	C,A
  0F6D'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  0F6F'   32 2481'              	STA	CWEOL		;   see the clamp in OPA_F
  0F72'                         OPP_ND:
  0F72'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  0F73'   21 247E'              	LXI	H,PSAVE
  0F76'   BE                    	CMP	M
  0F77'   CA 100D'              	JZ	OPLINE
  0F7A'   79                    	MOV	A,C		; (OPCLS classifies the key)
  0F7B'   CD 101D'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  0F7E'   DA 0FE9'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  0F81'   32 2480'              	STA	OPCLSV
  0F84'   47                    	MOV	B,A		; B = the class
  0F85'   3A 247E'              	LDA	PSAVE
  0F88'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  0F8A'   C2 0F96'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  0F8D'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  0F8E'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  0F90'   C2 0FB8'              	JNZ	OPP_GO
  0F93'   C3 0FA1'              	JMP	OPP_NO
  0F96'                         OPP_NC:
  0F96'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  0F98'   C2 0FB8'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  0F9B'   78                    	MOV	A,B		;   a charwise register would need a type flag
  0F9C'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  0F9E'   CA 0FB8'              	JZ	OPP_GO		;   within a line -- neither of which is built
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0FA1'                         OPP_NO:
  0FA1'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  0FA2'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  0FA4'   CA 0FB2'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  0FA7'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  0FA9'   CA 0FB2'              	JZ	OPP_SW		;   so swallow it before dropping the command
  0FAC'   CD 034B'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  0FAF'   C2 0FE9'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  0FB2'                         OPP_SW:
  0FB2'   CD 021B'              	CALL	MKGETK
  0FB5'   C3 0FE9'              	JMP	OPABRT
  0FB8'                         OPP_GO:
  0FB8'   AF                    	XRA	A
  0FB9'   32 245F'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  0FBC'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  0FBF'   22 2482'              	SHLD	OPSTA
  0FC2'   21 2382'              	LXI	H,CMDTAB
  0FC5'   CD 00C5'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  0FC8'   3A 247E'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  0FCB'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  0FCC'   CA 0672'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  0FCF'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  0FD2'   22 2484'              	SHLD	OPEND2
  0FD5'   3A 247E'              	LDA	PSAVE
  0FD8'   FE 79                 	CPI	'y'
  0FDA'   CA 14BD'              	JZ	OPYANK		; a yank takes the span without losing it
  0FDD'   CD 1058'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  0FE0'   3A 247E'              	LDA	PSAVE
  0FE3'   FE 63                 	CPI	'c'
  0FE5'   C0                    	RNZ
  0FE6'   C3 1284'              	JMP	SETINS
  0FE9'                         OPABRT:
  0FE9'   C3 0672'              	JMP	SETMOV		; not a motion -> operator cancelled, nothing drew
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  0FEC'                         ONWHIT:
  0FEC'   CD 05E1'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  0FEF'   CA 100B'              	JZ	OW_YES
  0FF2'   CD 05EC'              	CALL	CURCHR		; A = the char under the cursor
  0FF5'   FE 20                 	CPI	' '
  0FF7'   CA 100B'              	JZ	OW_YES
  0FFA'   FE 09                 	CPI	TAB
  0FFC'   CA 100B'              	JZ	OW_YES
  0FFF'   FE 0D                 	CPI	CR
  1001'   CA 100B'              	JZ	OW_YES
  1004'   FE 0A                 	CPI	LF
  1006'   CA 100B'              	JZ	OW_YES
  1009'   B7                    	ORA	A		; a char to change: CY clear
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  100A'   C9                    	RET
  100B'                         OW_YES:
  100B'   37                    	STC
  100C'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  100D'                         OPLINE:
  100D'   3A 247E'              	LDA	PSAVE
  1010'   FE 63                 	CPI	'c'
  1012'   CA 0672'              	JZ	SETMOV
  1015'   FE 79                 	CPI	'y'
  1017'   CA 14A2'              	JZ	VY_YY
  101A'   C3 1427'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  101D'                         OPCLS:
  101D'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  101F'   CA 102C'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  1022'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  1024'   C2 1040'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1027'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1029'   C3 102E'              	JMP	OPC_FK
  102C'                         OPC_SEM:
  102C'   06 00                 	MVI	B,0		; ';' runs it as it stands
  102E'                         OPC_FK:
  102E'   3A 24CB'              	LDA	FNDKND
  1031'   B7                    	ORA	A
  1032'   37                    	STC
  1033'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1034'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1035'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1037'   CA 103E'              	JZ	OPC_EXC
  103A'   3E 01                 	MVI	A,1
  103C'   B7                    	ORA	A		; CY clear: a motion, class 1
  103D'   C9                    	RET
  103E'                         OPC_EXC:
  103E'   AF                    	XRA	A		; class 0, CY clear
  103F'   C9                    	RET
  1040'                         OPC_TB:
  1040'   47                    	MOV	B,A
  1041'   21 117A'              	LXI	H,OPCTAB
  1044'                         OPC_LP:
  1044'   7E                    	MOV	A,M
  1045'   B7                    	ORA	A
  1046'   CA 1056'              	JZ	OPC_MS		; end of table -> not a motion
  1049'   B8                    	CMP	B
  104A'   CA 1052'              	JZ	OPC_HT
  104D'   23                    	INX	H
  104E'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  104F'   C3 1044'              	JMP	OPC_LP
  1052'                         OPC_HT:
  1052'   23                    	INX	H
  1053'   7E                    	MOV	A,M		; class byte
  1054'   B7                    	ORA	A		; clear CY
  1055'   C9                    	RET
  1056'                         OPC_MS:
  1056'   37                    	STC
  1057'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  1058'                         OPAPPL:
  1058'   3A 2480'              	LDA	OPCLSV
  105B'   FE 02                 	CPI	2
  105D'   CA 115E'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  1060'   2A 2482'              	LHLD	OPSTA
  1063'   EB                    	XCHG			; DE = start
  1064'   2A 2484'              	LHLD	OPEND2		; HL = end
  1067'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  106A'   DA 107A'              	JC	OPA_F
  106D'   CA 107A'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  1070'   22 2486'              	SHLD	OPLO
  1073'   EB                    	XCHG
  1074'   22 2488'              	SHLD	OPHI
  1077'   C3 10D2'              	JMP	OPA_DO
  107A'                         OPA_F:
  107A'   EB                    	XCHG			; HL = start, DE = end
  107B'   22 2486'              	SHLD	OPLO
  107E'   EB                    	XCHG			; HL = end
  107F'   3A 2480'              	LDA	OPCLSV
  1082'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1084'   CA 10CF'              	JZ	OPA_HI		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  1087'   FE 01                 	CPI	1
  1089'   C2 10AB'              	JNZ	OPA_EX
  108C'   23                    	INX	H		; inclusive endpoint -> hi = end+1
                                	;--- 'cw' stops at the line's content end, where a plain 'ce' (and 'de')
                                	;    runs on into the next line's word and 'd%' crosses to its mate --
                                	;    all four recorded from vim 9.1.  vim's 'cw' is not simply 'ce': the
                                	;    rewrite keeps 'w's own end-of-line stop, so the clamp hangs off
                                	;    CWEOL (the rewrite) and not off the inclusive class. ---
  108D'   3A 2481'              	LDA	CWEOL
  1090'   B7                    	ORA	A
  1091'   CA 10CF'              	JZ	OPA_HI
  1094'   22 2488'              	SHLD	OPHI		; park the motion's own end: CEND clobbers DE
  1097'   2A 2486'              	LHLD	OPLO
  109A'   CD 1202'              	CALL	CEND		; HL = the start line's content end
  109D'   EB                    	XCHG			; DE = that content end
  109E'   2A 2488'              	LHLD	OPHI		; HL = hi
  10A1'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  10A4'   D2 10CF'              	JNC	OPA_HI		; hi is inside the line: keep it
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  10A7'   EB                    	XCHG			; HL = the content end: 'cw' stops there
  10A8'   C3 10CF'              	JMP	OPA_HI
  10AB'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  10AB'   22 2488'              	SHLD	OPHI		; the motion's own end, for now
  10AE'   2A 2486'              	LHLD	OPLO
  10B1'   CD 1202'              	CALL	CEND		; HL = the start line's content end
  10B4'   EB                    	XCHG			; DE = that content end
  10B5'   3A 245F'              	LDA	WPULL		; the motion landed on a line's end and was
  10B8'   B7                    	ORA	A		;   pulled back onto its last char (the command
  10B9'   C2 10C5'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  10BC'   2A 2488'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  10BF'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  10C2'   D2 10D2'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  10C5'                         OPA_CE:				;   deletes the word, not all but its last char
  10C5'   2A 2486'              	LHLD	OPLO
  10C8'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  10CB'   CA 1110'              	JZ	OPA_LN
  10CE'   EB                    	XCHG			; HL = the content end
  10CF'                         OPA_HI:
  10CF'   22 2488'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  10D2'                         OPA_DO:
  10D2'   CD 10F6'              	CALL	OPDSPN
  10D5'   3A 247E'              	LDA	PSAVE
  10D8'   FE 63                 	CPI	'c'
  10DA'   C8                    	RZ
  10DB'   C3 1213'              	JMP	CLAMPE
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  10DE'                         SPNBRK:
  10DE'   2A 2486'              	LHLD	OPLO
  10E1'   CD 0571'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  10E4'   EB                    	XCHG			; DE = it
  10E5'   2A 2488'              	LHLD	OPHI
  10E8'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  10EB'                         OPSPNL:
  10EB'   2A 2488'              	LHLD	OPHI
  10EE'   EB                    	XCHG
  10EF'   2A 2486'              	LHLD	OPLO
  10F2'   EB                    	XCHG			; HL = hi, DE = lo
  10F3'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  10F6'                         OPDSPN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  10F6'   CD 10DE'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  10F9'   F5                    	PUSH	PSW
  10FA'   2A 2486'              	LHLD	OPLO
  10FD'   CD 0000*              	CALL	GOTO
  1100'   CD 10EB'              	CALL	OPSPNL		; HL = hi - lo
  1103'   CD 0000*              	CALL	DELFWD
  1106'   CD 0188'              	CALL	MARKMOD
  1109'   F1                    	POP	PSW
  110A'   DA 0693'              	JC	SETFUL		; a break went: every row below it moved up
  110D'   C3 0678'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  1110'                         OPA_LN:
  1110'   3A 247E'              	LDA	PSAVE
  1113'   FE 63                 	CPI	'c'
  1115'   C2 111E'              	JNZ	OPA_LD
  1118'   2A 2486'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  111B'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  111E'                         OPA_LD:
  111E'   2A 2486'              	LHLD	OPLO
  1121'   22 2482'              	SHLD	OPSTA
  1124'   22 2484'              	SHLD	OPEND2
  1127'   C3 115E'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  112A'                         OPALSP:
  112A'   2A 2482'              	LHLD	OPSTA
  112D'   EB                    	XCHG
  112E'   2A 2484'              	LHLD	OPEND2
  1131'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  1134'   DA 1141'              	JC	OPAL_F
  1137'   22 2486'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  113A'   EB                    	XCHG
  113B'   22 2488'              	SHLD	OPHI		; hi-src = start
  113E'   C3 114B'              	JMP	OPAL_R
  1141'                         OPAL_F:
  1141'   EB                    	XCHG			; HL = start
  1142'   22 2486'              	SHLD	OPLO		; lo-src = start
  1145'   2A 2484'              	LHLD	OPEND2
  1148'   22 2488'              	SHLD	OPHI		; hi-src = end
  114B'                         OPAL_R:
  114B'   2A 2486'              	LHLD	OPLO
  114E'   CD 055E'              	CALL	BOL
  1151'   22 2486'              	SHLD	OPLO		; lo = BOL(low line)
  1154'   2A 2488'              	LHLD	OPHI
  1157'   CD 058E'              	CALL	NLSTART
  115A'   22 2488'              	SHLD	OPHI		; hi = start of line past the high line
  115D'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  115E'                         OPALIN:
  115E'   CD 112A'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  1161'                         OPDLIN:
  1161'   CD 10F6'              	CALL	OPDSPN
  1164'   CD 05E1'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1167'   DA 1177'              	JC	OPDL_NB
  116A'   CD 0000*              	CALL	LOGLEN
  116D'   7C                    	MOV	A,H
  116E'   B5                    	ORA	L
  116F'   C8                    	RZ			; empty buffer
  1170'   2B                    	DCX	H
  1171'   CD 055E'              	CALL	BOL
  1174'   CD 0000*              	CALL	GOTO
  1177'                         OPDL_NB:
  1177'   C3 0740'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  117A'                         OPCTAB:
  117A'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  117E'   62 00 42 00           
  1182'   68 00 6C 00           
  1186'   30 00 5E 00           
  118A'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  118C'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1190'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1194'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1198'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  119C'   24 01                 
  119E'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  11A2'   47 02 48 02           
  11A6'   4D 02 4C 02           
  11AA'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  11AC'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  11AD'                         VCB_C:
  11AD'   CD 11B9'              	CALL	VCB_CD
  11B0'   C3 1284'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  11B3'                         VCB_D:
  11B3'   CD 11B9'              	CALL	VCB_CD
  11B6'   C3 1213'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  11B9'                         VCB_CD:
  11B9'   CD 05F8'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  11BC'   22 2486'              	SHLD	OPLO
  11BF'   CD 0000*              	CALL	CUROFF
  11C2'   CD 1202'              	CALL	CEND		; to the line's content end, the CR,LF left
  11C5'   22 2488'              	SHLD	OPHI
  11C8'   C3 10F6'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  11CB'                         VC_X:
  11CB'   CD 07E5'              	CALL	GLSTAL
  11CE'   CD 0678'              	CALL	SETLIN
  11D1'   CD 0605'              	CALL	GETCNT
  11D4'   22 248A'              	SHLD	CNTV
  11D7'   CD 0000*              	CALL	CUROFF
  11DA'   22 248E'              	SHLD	WKI		; cur
  11DD'   CD 1202'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  11E0'   EB                    	XCHG			; DE = contentend
  11E1'   2A 248E'              	LHLD	WKI		; HL = cur
  11E4'   EB                    	XCHG			; HL = contentend, DE = cur
  11E5'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  11E8'   7C                    	MOV	A,H
  11E9'   B5                    	ORA	L
  11EA'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  11EB'   EB                    	XCHG			; DE = available
  11EC'   2A 248A'              	LHLD	CNTV		; HL = count
  11EF'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  11F2'   DA 11F8'              	JC	VX_USEA
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  11F5'   C3 11F9'              	JMP	VX_DEL		; count <= available -> HL = count = del
  11F8'                         VX_USEA:
  11F8'   EB                    	XCHG			; HL = available
  11F9'                         VX_DEL:
  11F9'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  11FC'   CD 0188'              	CALL	MARKMOD
  11FF'   C3 1213'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  1202'                         CEND:
  1202'   CD 0571'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1205'   7C                    	MOV	A,H
  1206'   B5                    	ORA	L
  1207'   C8                    	RZ			; the start of the text: nothing before it
  1208'   2B                    	DCX	H
  1209'   E5                    	PUSH	H
  120A'   CD 0000*              	CALL	CHARAT
  120D'   E1                    	POP	H		; HL = term-1
  120E'   FE 0D                 	CPI	CR
  1210'   C8                    	RZ			; a CR before the LF -> the content ends there
  1211'   23                    	INX	H
  1212'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  1213'                         CLAMPE:
  1213'   CD 0000*              	CALL	CUROFF
  1216'   E5                    	PUSH	H
  1217'   CD 059D'              	CALL	EOLC
  121A'   D1                    	POP	D		; DE = cur
  121B'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  121E'   D8                    	RC
  121F'   C8                    	RZ
  1220'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1223'                         VC_I:
  1223'   CD 0605'              	CALL	GETCNT
  1226'   C3 1281'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1229'                         VC_A:
  1229'   CD 0605'              	CALL	GETCNT
  122C'   CD 05E1'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  122F'   CA 1246'              	JZ	VA_INS
  1232'   EB                    	XCHG			; HL = cur
  1233'   E5                    	PUSH	H
  1234'   CD 0000*              	CALL	CHARAT
  1237'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1238'   FE 0A                 	CPI	LF
  123A'   CA 1246'              	JZ	VA_INS		; on the line terminator -> append in place
  123D'   FE 0D                 	CPI	CR
  123F'   CA 1246'              	JZ	VA_INS
  1242'   23                    	INX	H
  1243'   CD 0000*              	CALL	GOTO
  1246'                         VA_INS:
  1246'   C3 1281'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1249'                         VCB_A:
  1249'   CD 05F8'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  124C'   CD 059D'              	CALL	EOLC		; HL = last content char (the start when empty)
  124F'   E5                    	PUSH	H
  1250'   CD 0000*              	CALL	CHARAT
  1253'   E1                    	POP	H
  1254'   FE 0D                 	CPI	CR
  1256'   CA 125F'              	JZ	VBA_IN		; an empty line: insert at its start
  1259'   FE 0A                 	CPI	LF
  125B'   CA 125F'              	JZ	VBA_IN
  125E'   23                    	INX	H		; past the last content char
  125F'                         VBA_IN:
  125F'   CD 0000*              	CALL	GOTO
  1262'   C3 1281'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1265'                         VCB_I:
  1265'   CD 0605'              	CALL	GETCNT
  1268'   CD 0740'              	CALL	FNBLNK
  126B'   CD 0000*              	CALL	CUROFF
  126E'   E5                    	PUSH	H
  126F'   CD 0000*              	CALL	CHARAT
  1272'   E1                    	POP	H
  1273'   FE 20                 	CPI	' '
  1275'   CA 127D'              	JZ	VBI_SK
  1278'   FE 09                 	CPI	TAB
  127A'   C2 1281'              	JNZ	SETINM
  127D'                         VBI_SK:
  127D'   23                    	INX	H		; blanks only: past the last of them
  127E'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1281'                         SETINM:
  1281'   CD 0672'              	CALL	SETMOV
  1284'                         SETINS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  1284'   3E 01                 	MVI	A,EM_INS
  1286'   32 2453'              	STA	EDMODE
  1289'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  128A'                         ATCEND:
  128A'   CD 05E1'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  128D'   C8                    	RZ
  128E'   CD 05EC'              	CALL	CURCHR		; A = the char under the cursor
  1291'   FE 0D                 	CPI	CR
  1293'   C8                    	RZ
  1294'   FE 0A                 	CPI	LF
  1296'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1297'                         OPNBRK:
  1297'   3E 0D                 	MVI	A,CR
  1299'   CD 0000*              	CALL	PUTGAP
  129C'   3E 0A                 	MVI	A,LF
  129E'   CD 0000*              	CALL	PUTGAP
  12A1'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  12A4'   23                    	INX	H
  12A5'   22 0000*              	SHLD	LNDLT
  12A8'   C3 0188'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  12AB'                         ENDBRK:
  12AB'   CD 05E1'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  12AE'   C0                    	RNZ
  12AF'   CD 1297'              	CALL	OPNBRK
  12B2'   CD 0000*              	CALL	CUROFF
  12B5'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  12B6'   2B                    	DCX	H		;   line, with its own terminator after it
  12B7'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  12BA'                         VC_O:
  12BA'   CD 05F8'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  12BD'   CD 1202'              	CALL	CEND
  12C0'   CD 0000*              	CALL	GOTO
  12C3'   CD 1297'              	CALL	OPNBRK
  12C6'   CD 12AB'              	CALL	ENDBRK		; a last line with no line end: the opened line
  12C9'   CD 067E'              	CALL	SETILN		;   needs a terminator of its own to exist
  12CC'   C3 1284'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  12CF'                         VCB_O:
  12CF'   CD 05F8'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  12D2'   CD 055E'              	CALL	BOL
  12D5'   CD 0000*              	CALL	GOTO
  12D8'   CD 1297'              	CALL	OPNBRK
  12DB'   CD 0000*              	CALL	CUROFF
  12DE'   2B                    	DCX	H
  12DF'   2B                    	DCX	H
  12E0'   CD 0000*              	CALL	GOTO
  12E3'   CD 067E'              	CALL	SETILN
  12E6'   C3 1284'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  12E9'                         VCB_J:
  12E9'   CD 05F8'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  12EC'   CD 1202'              	CALL	CEND		; the join point: this line's content end
  12EF'   22 2486'              	SHLD	OPLO
  12F2'   CD 0000*              	CALL	CUROFF
  12F5'   CD 058E'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  12F8'   E5                    	PUSH	H
  12F9'   CD 0000*              	CALL	LOGLEN
  12FC'   D1                    	POP	D		; DE = that start
  12FD'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1300'   CA 0672'              	JZ	SETMOV
  1303'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1304'                         VJ_WS:
  1304'   E5                    	PUSH	H
  1305'   CD 0000*              	CALL	LOGLEN
  1308'   D1                    	POP	D		; DE = the scan
  1309'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  130C'   CA 1323'              	JZ	VJ_DEL
  130F'   EB                    	XCHG			; HL = the scan
  1310'   E5                    	PUSH	H
  1311'   CD 0000*              	CALL	CHARAT
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  1314'   E1                    	POP	H
  1315'   FE 20                 	CPI	' '
  1317'   CA 131F'              	JZ	VJ_SKIP
  131A'   FE 09                 	CPI	TAB
  131C'   C2 1323'              	JNZ	VJ_DEL
  131F'                         VJ_SKIP:
  131F'   23                    	INX	H
  1320'   C3 1304'              	JMP	VJ_WS
  1323'                         VJ_DEL:
  1323'   22 2488'              	SHLD	OPHI
  1326'   CD 10F6'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1329'   CD 068D'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  132C'   CD 05E1'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  132F'   CA 1213'              	JZ	CLAMPE
  1332'   CD 05EC'              	CALL	CURCHR		; the first char of what was appended
  1335'   FE 0D                 	CPI	CR
  1337'   CA 1213'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  133A'   FE 0A                 	CPI	LF
  133C'   CA 1213'              	JZ	CLAMPE
  133F'   FE 29                 	CPI	')'
  1341'   CA 1213'              	JZ	CLAMPE		; vim puts no space before a ')'
  1344'   CD 0000*              	CALL	CUROFF
  1347'   7C                    	MOV	A,H
  1348'   B5                    	ORA	L
  1349'   CA 135F'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  134C'   2B                    	DCX	H
  134D'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1350'   FE 20                 	CPI	' '
  1352'   CA 1213'              	JZ	CLAMPE
  1355'   FE 09                 	CPI	TAB
  1357'   CA 1213'              	JZ	CLAMPE
  135A'   FE 0A                 	CPI	LF
  135C'   CA 1213'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  135F'                         VJ_SP:
  135F'   3E 20                 	MVI	A,' '
  1361'   CD 0000*              	CALL	PUTGAP
  1364'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1367'   2B                    	DCX	H
  1368'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  136B'                         VC_TILD:
  136B'   CD 0605'              	CALL	GETCNT
  136E'   CD 0678'              	CALL	SETLIN		; only this row changes
  1371'   CD 07E5'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1374'   CD 05E1'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1377'   CA 0672'              	JZ	SETMOV
  137A'   CD 05EC'              	CALL	CURCHR		; A = the char under the cursor
  137D'   FE 0D                 	CPI	CR
  137F'   CA 0672'              	JZ	SETMOV		; the line's end: nothing to toggle
  1382'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  1384'   CA 0672'              	JZ	SETMOV
  1387'   47                    	MOV	B,A
  1388'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  138A'   FE 41                 	CPI	'A'
  138C'   DA 1398'              	JC	VT_PUT		; below 'A': no case
  138F'   FE 5B                 	CPI	'Z'+1
  1391'   D2 1398'              	JNC	VT_PUT		; above 'Z': no case
  1394'   78                    	MOV	A,B
  1395'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1397'   47                    	MOV	B,A
  1398'                         VT_PUT:
  1398'   78                    	MOV	A,B
  1399'   32 2497'              	STA	VRCH		; the calls below do not preserve B
  139C'   CD 0188'              	CALL	MARKMOD
  139F'   21 0001               	LXI	H,1
  13A2'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  13A5'   3A 2497'              	LDA	VRCH
  13A8'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  13AB'   C3 1213'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  13AE'                         VC_R:
  13AE'   CD 05F2'              	CALL	MOVCNT		; a cursor motion, and its count
  13B1'   3E 03                 	MVI	A,PR
  13B3'   32 247B'              	STA	GPEND
  13B6'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  13B7'                         VR_DO:
  13B7'   AF                    	XRA	A
  13B8'   32 247B'              	STA	GPEND
  13BB'   79                    	MOV	A,C
  13BC'   32 2497'              	STA	VRCH		; the calls below do not preserve C
  13BF'   CD 0678'              	CALL	SETLIN		; only this row changed
  13C2'   CD 07E5'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  13C5'   CD 05E1'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  13C8'   CA 0672'              	JZ	SETMOV		; the end of the text: vim does nothing
  13CB'   CD 05EC'              	CALL	CURCHR		; A = the char under the cursor
  13CE'   FE 0D                 	CPI	CR
  13D0'   CA 0672'              	JZ	SETMOV		; the line's end: nothing to replace
  13D3'   FE 0A                 	CPI	LF
  13D5'   CA 0672'              	JZ	SETMOV
  13D8'   CD 0188'              	CALL	MARKMOD
  13DB'   21 0001               	LXI	H,1
  13DE'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  13E1'   3A 2497'              	LDA	VRCH
  13E4'   FE 0D                 	CPI	CR
  13E6'   CA 13F3'              	JZ	VR_CR
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  13E9'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  13EC'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  13EF'   2B                    	DCX	H		;   out, which moves every logical offset
  13F0'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  13F3'                         VR_CR:
  13F3'   CD 1297'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  13F6'   CD 12AB'              	CALL	ENDBRK		;   replaced char may have been the text's last
  13F9'   CD 067E'              	CALL	SETILN		;   row above it lost the char that was replaced,
  13FC'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  13FE'   32 245B'              	STA	ILABOV
  1401'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1402'                         VCB_R:
  1402'   CD 0605'              	CALL	GETCNT
  1405'   CD 0672'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1408'   21 0000               	LXI	H,0
  140B'   22 2498'              	SHLD	RPDEL		; nothing of ours to put back yet
  140E'   22 249A'              	SHLD	RPAPP
  1411'   3E 02                 	MVI	A,EM_REP
  1413'   32 2453'              	STA	EDMODE
  1416'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1417'                         VC_D:
  1417'   3E 64                 	MVI	A,'d'
  1419'   32 247D'              	STA	PENDOP
  141C'   C3 0672'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  141F'                         VC_C:
  141F'   3E 63                 	MVI	A,'c'
  1421'   32 247D'              	STA	PENDOP
  1424'   C3 0672'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1427'                         VD_DD:
  1427'   CD 07E5'              	CALL	GLSTAL
  142A'   CD 0605'              	CALL	GETCNT
  142D'   22 248A'              	SHLD	CNTV
  1430'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1432'   32 247F'              	STA	DDSNG
  1435'   2B                    	DCX	H
  1436'   7C                    	MOV	A,H
  1437'   B5                    	ORA	L
  1438'   C2 1443'              	JNZ	VDD_LS
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  143B'   3E 01                 	MVI	A,1
  143D'   32 247F'              	STA	DDSNG
  1440'   C3 1449'              	JMP	VDD_GO
  1443'                         VDD_LS:
  1443'   CD 07AB'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1446'   DA 0672'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1449'                         VDD_GO:
  1449'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  144C'   CD 0729'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  144F'   2A 248A'              	LHLD	CNTV
  1452'   CD 0000*              	CALL	SETC0
  1455'                         VDD_FW:
  1455'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1458'   CD 061A'              	CALL	CNTTST
  145B'   C2 1455'              	JNZ	VDD_FW
  145E'   CD 0188'              	CALL	MARKMOD
  1461'   CD 091C'              	CALL	ATEOF
  1464'   D2 147F'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1467'   3E 00                 	MVI	A,0
  1469'   32 247F'              	STA	DDSNG		; deleted to the end: full repaint
  146C'   CD 0D62'              	CALL	ONFST
  146F'   CA 0740'              	JZ	FNBLNK		; nothing left before it
  1472'   21 0001               	LXI	H,1		; onto the new last line
  1475'   CD 0000*              	CALL	SETBWD
  1478'   2A 0000*              	LHLD	LNDLT
  147B'   2B                    	DCX	H
  147C'   22 0000*              	SHLD	LNDLT
  147F'                         VDD_UP:
  147F'   CD 0740'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1482'   3A 247F'              	LDA	DDSNG
  1485'   B7                    	ORA	A
  1486'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1487'   3E 03                 	MVI	A,R_DLIN
  1489'   32 2458'              	STA	RINTENT
  148C'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and an overflow raises WM's 'QBUF FULL' with
                                ; what has already moved safely in the register.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  148D'                         QEMPTY:
  148D'   2A 0000*              	LHLD	QBEG
  1490'   EB                    	XCHG
  1491'   2A 0000*              	LHLD	QEND
  1494'   7C                    	MOV	A,H
  1495'   BA                    	CMP	D
  1496'   C0                    	RNZ
  1497'   7D                    	MOV	A,L
  1498'   BB                    	CMP	E
  1499'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  149A'                         VC_Y:
  149A'   3E 79                 	MVI	A,'y'
  149C'   32 247D'              	STA	PENDOP
  149F'   C3 0672'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  14A2'                         VY_YY:
  14A2'   CD 0000*              	CALL	CUROFF
  14A5'   22 24BB'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  14A8'   CD 055E'              	CALL	BOL
  14AB'   22 24BD'              	SHLD	YPT		; where the lines come from, to put them back
  14AE'   CD 15BF'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  14B1'   CD 1602'              	CALL	YNCOPY		; copied where they lie, if that can be done
  14B4'   D2 15C6'              	JNC	YNDONE
  14B7'   21 1427'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  14BA'   C3 14E6'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  14BD'                         OPYANK:
  14BD'   CD 112A'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  14C0'   2A 2482'              	LHLD	OPSTA
  14C3'   EB                    	XCHG			; DE = start
  14C4'   2A 2484'              	LHLD	OPEND2		; HL = end
  14C7'   CD 0000*              	CALL	CMP16		; CY iff start < end
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  14CA'   D2 14CE'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  14CD'   EB                    	XCHG			; ... otherwise the start is
  14CE'                         OPY_LO:
  14CE'   22 24BB'              	SHLD	YOFF
  14D1'   2A 2486'              	LHLD	OPLO
  14D4'   22 24BD'              	SHLD	YPT		; where the lines come from, to put them back
  14D7'   CD 15BF'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  14DA'   CD 167A'              	CALL	YNSPAN		; copied where they lie, if there is room
  14DD'   D2 15C6'              	JNC	YNDONE
  14E0'   21 1583'              	LXI	H,YSPAN
  14E3'   C3 14E6'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  14E6'                         YKGO:
  14E6'   22 24E1'              	SHLD	YACT
  14E9'   2A 24BD'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  14EC'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  14ED'   2A 24BB'              	LHLD	YOFF		;   survive this -- the put-back below can page
  14F0'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  14F3'   22 24E7'              	SHLD	YCOL		;   them -- but a distance within the lines does
  14F6'   3A 2457'              	LDA	MODF
  14F9'   32 24B8'              	STA	YMODF
  14FC'   3A 2470'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  14FF'   32 24B9'              	STA	YDCHG		;   a yank must not become the last change
  1502'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1505'   32 24BA'              	STA	YURPL		;   back are not a change to undo either
  1508'   3E 01                 	MVI	A,1
  150A'   32 0000*              	STA	UNDRPL
  150D'   32 24E0'              	STA	MKHOLD		; ... nor a change to drop a mark for: MKDROP
  1510'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1513'   22 24C6'              	SHLD	YLDLT
  1516'   CD 0000*              	CALL	LOGLEN
  1519'   22 24E5'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  151C'   2A 24E1'              	LHLD	YACT
  151F'   CD 1582'              	CALL	YCALL		; the lines out of the file, into the register
  1522'   CD 0000*              	CALL	LOGLEN
  1525'   EB                    	XCHG
  1526'   2A 24E5'              	LHLD	YWAS
  1529'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  152C'   CA 155A'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  152F'   2A 24BD'              	LHLD	YPT
  1532'   CD 0000*              	CALL	GOTO
  1535'   CD 0000*              	CALL	QGET		; and straight back in
                                	;--- Putting them back can PAGE: QGET splices the register through
                                	;    INSBLK, whose MKGAP reaches MKROOM when the arena is tight, and a
                                	;    spill writes the window's top out to disk -- which moves TXTBEG and
                                	;    shifts every logical offset under us, YOFF among them.  ('500yy' at
                                	;    line 2500 of a 40 K file spills 48 records and used to land the
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


                                	;    cursor 573 lines below where it started; a yank moves the cursor
                                	;    nowhere.)  So the cursor is found again from the lines THEMSELVES:
                                	;    QGET leaves it just past them, so they start at the cursor less the
                                	;    register's length, and the cursor was YCOL bytes into them.  Both
                                	;    terms are read AFTER the paging, so neither can be stale. ---
  1538'   CD 0000*              	CALL	CUROFF		; where QGET left it: just past the lines
  153B'   22 24E9'              	SHLD	YBLK
  153E'   2A 0000*              	LHLD	QBEG
  1541'   EB                    	XCHG
  1542'   2A 0000*              	LHLD	QEND
  1545'   CD 0000*              	CALL	SUBHD		; HL = the register's length = what went back
  1548'   EB                    	XCHG
  1549'   2A 24E9'              	LHLD	YBLK
  154C'   CD 0000*              	CALL	SUBHD		; HL = where those lines start NOW
  154F'   EB                    	XCHG
  1550'   2A 24E7'              	LHLD	YCOL
  1553'   19                    	DAD	D		; ... and the cursor is YCOL into them
  1554'   CD 0000*              	CALL	GOTO
  1557'   C3 1560'              	JMP	YK_RST
  155A'                         YK_FIN:				; nothing came out, so nothing was put back and
  155A'   2A 24BB'              	LHLD	YOFF		;   no offset can have shifted: the cursor is
  155D'   CD 0000*              	CALL	GOTO		;   where it was
  1560'                         YK_RST:
  1560'   2A 24C6'              	LHLD	YLDLT
  1563'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1566'   3A 24B8'              	LDA	YMODF
  1569'   32 2457'              	STA	MODF
  156C'   3A 24B9'              	LDA	YDCHG
  156F'   32 2470'              	STA	DOTCHG
  1572'   3A 24BA'              	LDA	YURPL
  1575'   32 0000*              	STA	UNDRPL
  1578'   AF                    	XRA	A
  1579'   32 24E0'              	STA	MKHOLD
  157C'   CD 07E5'              	CALL	GLSTAL
  157F'   C3 0693'              	JMP	SETFUL		; the cheap paint cannot carry this
  1582'   E9                    YCALL:	PCHL
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1583'                         YSPAN:
  1583'   CD 07E5'              	CALL	GLSTAL
  1586'   CD 10EB'              	CALL	OPSPNL		; HL = the span's length
  1589'   22 24E3'              	SHLD	YTGT
  158C'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  158F'   EB                    	XCHG			; DE = it
  1590'   2A 24E3'              	LHLD	YTGT
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  1593'   EB                    	XCHG			; HL = the text's, DE = the span's
  1594'   CD 0000*              	CALL	SUBHD
  1597'   22 24E3'              	SHLD	YTGT		; what the text is left at when the span is out
  159A'   2A 2486'              	LHLD	OPLO
  159D'   CD 0000*              	CALL	GOTO
  15A0'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  15A3'                         YS_LP:
  15A3'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  15A6'   CD 0000*              	CALL	SETC0
  15A9'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  15AC'   CD 0000*              	CALL	LOGLEN
  15AF'   EB                    	XCHG			; DE = what is left
  15B0'   2A 24E3'              	LHLD	YTGT
  15B3'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  15B6'   DA 15BC'              	JC	YS_END		; below it -- cannot happen over whole lines,
  15B9'   C2 15A3'              	JNZ	YS_LP		;   but never spin here if it ever did
  15BC'                         YS_END:
  15BC'   C3 0188'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  15BF'                         YNPRE:
  15BF'   2A 0000*              	LHLD	PGTOPM
  15C2'   22 24EB'              	SHLD	YNPG
  15C5'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; dropped, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


                                ; cut), and PGTOPM is what says whether it did.
  15C6'                         YNDONE:
  15C6'   2A 24BB'              	LHLD	YOFF
  15C9'   CD 0000*              	CALL	GOTO
  15CC'   2A 0000*              	LHLD	PGTOPM
  15CF'   EB                    	XCHG
  15D0'   2A 24EB'              	LHLD	YNPG
  15D3'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  15D6'   C2 0693'              	JNZ	SETFUL		; it moved under us: repaint after all
  15D9'   C3 0672'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  15DC'                         YNROOM:
  15DC'   11 0100               	LXI	D,100H
  15DF'   19                    	DAD	D
  15E0'   D8                    	RC			; within a chunk of 64K: no arena holds that
  15E1'   E5                    	PUSH	H		; the span plus its slack
  15E2'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  15E5'   EB                    	XCHG			; HL = free
  15E6'   D1                    	POP	D		; DE = the span plus its slack
  15E7'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  15EA'   DA 15F2'              	JC	YNR_OK
  15ED'   CA 15F2'              	JZ	YNR_OK
  15F0'   37                    	STC			; not enough: the delete-and-put-back path
  15F1'   C9                    	RET
  15F2'                         YNR_OK:
  15F2'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  15F3'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  15F4'                         YNGO:
  15F4'   C5                    	PUSH	B
  15F5'   CD 0605'              	CALL	GETCNT		; spent here: this yank is happening
  15F8'   CD 07E5'              	CALL	GLSTAL
  15FB'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  15FE'   C1                    	POP	B
  15FF'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1602'                         YNCOPY:
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  1602'   2A 2454'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1605'   7C                    	MOV	A,H		;   the count itself
  1606'   B5                    	ORA	L
  1607'   C2 160D'              	JNZ	YNC_HV
  160A'   21 0001               	LXI	H,1
  160D'                         YNC_HV:
  160D'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  160E'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  160F'   B4                    	ORA	H
  1610'   CA 161B'              	JZ	YNC_M
  1613'   E5                    	PUSH	H
  1614'   CD 07AB'              	CALL	ONLAST		; vim: a count over one on the last line does
  1617'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1618'   DA 162D'              	JC	YNC_RF
  161B'                         YNC_M:
  161B'   E5                    	PUSH	H
  161C'   CD 0729'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  161F'   E1                    	POP	H
  1620'   CD 1635'              	CALL	YNLINE		; BC = the span, measured where it stands
  1623'   D8                    	RC			; not measurable here: let the pager answer it
  1624'   60                    	MOV	H,B
  1625'   69                    	MOV	L,C
  1626'   CD 15DC'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1629'   D8                    	RC			; no: the delete-and-put-back path
  162A'   C3 15F4'              	JMP	YNGO
  162D'                         YNC_RF:
  162D'   CD 0605'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1630'   CD 07E5'              	CALL	GLSTAL		;   register alone, and that is the command
  1633'   B7                    	ORA	A		; NC: done
  1634'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1635'                         YNLINE:
  1635'   22 24ED'              	SHLD	YNCNT		; the lines it still wants
  1638'   2A 0000*              	LHLD	GAPEND
  163B'                         YNL_LP:
  163B'   EB                    	XCHG			; DE = the scan
  163C'   2A 0000*              	LHLD	TXTEND
  163F'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1642'   EB                    	XCHG			; HL = the scan
  1643'   D2 1663'              	JNC	YNL_EN		; the resident text ran out
  1646'   7E                    	MOV	A,M
  1647'   23                    	INX	H
  1648'   FE 0A                 	CPI	LF
  164A'   C2 163B'              	JNZ	YNL_LP
  164D'   E5                    	PUSH	H
  164E'   2A 24ED'              	LHLD	YNCNT
  1651'   2B                    	DCX	H
  1652'   22 24ED'              	SHLD	YNCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  1655'   7C                    	MOV	A,H
  1656'   B5                    	ORA	L
  1657'   E1                    	POP	H
  1658'   C2 163B'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  165B'   EB                    	XCHG			; DE = past the last of them
  165C'   2A 0000*              	LHLD	GAPEND
  165F'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1660'   C3 1671'              	JMP	YNL_BC
  1663'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1663'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1666'   C2 1678'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1669'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  166C'   EB                    	XCHG			;   count clamps to it as vim's does
  166D'   2A 0000*              	LHLD	GAPEND
  1670'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1671'                         YNL_BC:
  1671'   CD 0000*              	CALL	SUBHD		; HL = the span
  1674'   44                    	MOV	B,H
  1675'   4D                    	MOV	C,L
  1676'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1677'   C9                    	RET
  1678'                         YNL_NO:
  1678'   37                    	STC
  1679'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  167A'                         YNSPAN:
  167A'   CD 10EB'              	CALL	OPSPNL		; HL = the span's length
  167D'   44                    	MOV	B,H
  167E'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  167F'   CD 15DC'              	CALL	YNROOM
  1682'   D8                    	RC			; no room: the delete-and-put-back path
  1683'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1684'   2A 2486'              	LHLD	OPLO
  1687'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  168A'   C1                    	POP	B
  168B'   C3 15F4'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  168E'                         VC_P:
  168E'   CD 148D'              	CALL	QEMPTY
  1691'   CA 1749'              	JZ	VP_BEL
  1694'   CD 0605'              	CALL	GETCNT
  1697'   22 24BF'              	SHLD	PCNT
  169A'   CD 0000*              	CALL	CUROFF
  169D'   CD 058E'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  16A0'   C3 16B5'              	JMP	VP_GO
  16A3'                         VCB_P:
  16A3'   CD 148D'              	CALL	QEMPTY
  16A6'   CA 1749'              	JZ	VP_BEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  16A9'   CD 0605'              	CALL	GETCNT
  16AC'   22 24BF'              	SHLD	PCNT
  16AF'   CD 0000*              	CALL	CUROFF
  16B2'   CD 055E'              	CALL	BOL
  16B5'                         VP_GO:
  16B5'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  16B8'   CD 0000*              	CALL	CUROFF
  16BB'   EB                    	XCHG
  16BC'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  16BF'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  16C2'   DA 16D7'              	JC	VP_IN
  16C5'   EB                    	XCHG			; HL = the put point = LOGLEN
  16C6'   7C                    	MOV	A,H
  16C7'   B5                    	ORA	L
  16C8'   CA 16D4'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  16CB'   2B                    	DCX	H
  16CC'   CD 0000*              	CALL	CHARAT
  16CF'   FE 0A                 	CPI	LF
  16D1'   CA 16D7'              	JZ	VP_IN
  16D4'                         VP_BRK:
  16D4'   CD 1297'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  16D7'                         VP_IN:
  16D7'   CD 0000*              	CALL	CUROFF
  16DA'   22 24C1'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  16DD'   2A 0000*              	LHLD	QBEG
  16E0'   EB                    	XCHG
  16E1'   2A 0000*              	LHLD	QEND
  16E4'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  16E7'   EB                    	XCHG
  16E8'   22 24C3'              	SHLD	PLFS
  16EB'   2A 24BF'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  16EE'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  16EF'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  16F0'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  16F2'   C2 16F6'              	JNZ	VP_PZ
  16F5'   7D                    	MOV	A,L
  16F6'                         VP_PZ:
  16F6'   32 24C5'              	STA	PCPY
  16F9'                         VP_LP:
  16F9'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  16FC'   2A 0000*              	LHLD	LNDLT
  16FF'   EB                    	XCHG
  1700'   2A 24C3'              	LHLD	PLFS
  1703'   19                    	DAD	D
  1704'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1707'   2A 24BF'              	LHLD	PCNT
  170A'   2B                    	DCX	H
  170B'   22 24BF'              	SHLD	PCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  170E'   7C                    	MOV	A,H
  170F'   B5                    	ORA	L
  1710'   C2 16F9'              	JNZ	VP_LP
  1713'   CD 0188'              	CALL	MARKMOD
  1716'   2A 24C1'              	LHLD	PPT
  1719'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  171C'   CD 07E5'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  171F'   3A 24C5'              	LDA	PCPY
  1722'   B7                    	ORA	A
  1723'   CA 0740'              	JZ	FNBLNK
  1726'   2A 24C3'              	LHLD	PLFS
  1729'   7C                    	MOV	A,H
  172A'   B7                    	ORA	A
  172B'   C2 0740'              	JNZ	FNBLNK
  172E'   3A 24C5'              	LDA	PCPY
  1731'   CD 0CF8'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1734'   7C                    	MOV	A,H
  1735'   B7                    	ORA	A
  1736'   C2 0740'              	JNZ	FNBLNK
  1739'   7D                    	MOV	A,L
  173A'   B7                    	ORA	A
  173B'   CA 0740'              	JZ	FNBLNK
  173E'   F5                    	PUSH	PSW
  173F'   CD 067E'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1742'   F1                    	POP	PSW
  1743'   32 2459'              	STA	ILN		; ... which the lines put now replace
  1746'   C3 0740'              	JMP	FNBLNK
  1749'                         VP_BEL:
  1749'   CD 0605'              	CALL	GETCNT		; the count is spent either way
  174C'   0E 07                 	MVI	C,BEL
  174E'   CD 0000*              	CALL	BCONOU
  1751'   C3 0672'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  1754'                         VIREP:
  1754'   78                    	MOV	A,B
  1755'   FE 01                 	CPI	KT_ACT
  1757'   CA 1884'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  175A'   FE 02                 	CPI	KT_CHAR
  175C'   C0                    	RNZ			; ignore anything else
  175D'   79                    	MOV	A,C
  175E'   FE 0D                 	CPI	CR
  1760'   CA 17C4'              	JZ	VP_CR
  1763'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1765'   CA 17C4'              	JZ	VP_CR
  1768'   FE 08                 	CPI	BS
  176A'   CA 17D0'              	JZ	VP_BS
  176D'   FE 7F                 	CPI	DEL
  176F'   CA 17D0'              	JZ	VP_BS
  1772'   32 2497'              	STA	VRCH		; the calls below do not preserve C
  1775'   CD 0678'              	CALL	SETLIN		; this row changed
  1778'   CD 0188'              	CALL	MARKMOD
  177B'   CD 128A'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  177E'   CA 17B6'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1781'   3A 2497'              	LDA	VRCH
  1784'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1787'   2A 2498'              	LHLD	RPDEL
  178A'   7C                    	MOV	A,H
  178B'   B5                    	ORA	L
  178C'   CA 17A2'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  178F'   2A 0000*              	LHLD	GAPEND
  1792'   EB                    	XCHG
  1793'   2A 249C'              	LHLD	RPGE
  1796'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1799'   CA 17A2'              	JZ	VP_OVW
  179C'   21 0000               	LXI	H,0
  179F'   22 2498'              	SHLD	RPDEL		; the text moved: those originals are gone
  17A2'                         VP_OVW:
  17A2'   21 0001               	LXI	H,1
  17A5'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  17A8'   2A 0000*              	LHLD	GAPEND
  17AB'   22 249C'              	SHLD	RPGE
  17AE'   2A 2498'              	LHLD	RPDEL
  17B1'   23                    	INX	H
  17B2'   22 2498'              	SHLD	RPDEL
  17B5'   C9                    	RET
  17B6'                         VP_APP:
  17B6'   3A 2497'              	LDA	VRCH
  17B9'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  17BC'   2A 249A'              	LHLD	RPAPP
  17BF'   23                    	INX	H
  17C0'   22 249A'              	SHLD	RPAPP
  17C3'   C9                    	RET
  17C4'                         VP_CR:
  17C4'   21 0000               	LXI	H,0
  17C7'   22 2498'              	SHLD	RPDEL		; a line break ends what BS can put back
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  17CA'   22 249A'              	SHLD	RPAPP
  17CD'   C3 185A'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  17D0'                         VP_BS:
  17D0'   2A 249A'              	LHLD	RPAPP
  17D3'   7C                    	MOV	A,H
  17D4'   B5                    	ORA	L
  17D5'   CA 17E2'              	JZ	VP_BSD
  17D8'   2B                    	DCX	H
  17D9'   22 249A'              	SHLD	RPAPP		; an appended char: it just goes
  17DC'   CD 0678'              	CALL	SETLIN
  17DF'   C3 0000*              	JMP	DELPRV
  17E2'                         VP_BSD:
  17E2'   2A 2498'              	LHLD	RPDEL
  17E5'   7C                    	MOV	A,H
  17E6'   B5                    	ORA	L
  17E7'   CA 180E'              	JZ	VP_BSM		; nothing of ours left
  17EA'   2A 0000*              	LHLD	GAPEND
  17ED'   EB                    	XCHG
  17EE'   2A 249C'              	LHLD	RPGE
  17F1'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  17F4'   C2 180E'              	JNZ	VP_BSM
  17F7'   2A 2498'              	LHLD	RPDEL
  17FA'   2B                    	DCX	H
  17FB'   22 2498'              	SHLD	RPDEL
  17FE'   CD 0678'              	CALL	SETLIN
  1801'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1804'   CD 0000*              	CALL	UNDELF		; the original comes back
  1807'   2A 0000*              	LHLD	GAPEND
  180A'   22 249C'              	SHLD	RPGE
  180D'   C9                    	RET
  180E'                         VP_BSM:
  180E'   CD 0672'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1811'   C3 06E1'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  1814'                         VIINS:
  1814'   78                    	MOV	A,B
  1815'   FE 01                 	CPI	KT_ACT
  1817'   CA 1884'              	JZ	VI_ACT
  181A'   FE 02                 	CPI	KT_CHAR
  181C'   C0                    	RNZ			; ignore anything else
  181D'   79                    	MOV	A,C
  181E'   FE 0D                 	CPI	CR
  1820'   CA 185A'              	JZ	VI_CR
  1823'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1825'   CA 185A'              	JZ	VI_CR
  1828'   FE 08                 	CPI	BS
  182A'   CA 1872'              	JZ	VI_BS
  182D'   FE 7F                 	CPI	DEL
  182F'   CA 1872'              	JZ	VI_BS
  1832'   79                    	MOV	A,C
  1833'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1836'   CD 0188'              	CALL	MARKMOD
  1839'   CD 0678'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  183C'   79                    	MOV	A,C
  183D'   FE 20                 	CPI	' '
  183F'   D8                    	RC			; control char -> keep R_LINE
  1840'   FE 7F                 	CPI	DEL
  1842'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1843'   CD 0699'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1846'   B7                    	ORA	A
  1847'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1848'   3E 04                 	MVI	A,R_ICH
  184A'   32 2458'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  184D'   CD 128A'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1850'   3E 00                 	MVI	A,0
  1852'   C2 1856'              	JNZ	VI_ICH
  1855'   3C                    	INR	A
  1856'                         VI_ICH:
  1856'   32 245A'              	STA	ICHAPP
  1859'   C9                    	RET
  185A'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  185A'   CD 128A'              	CALL	ATCEND
  185D'   3E 00                 	MVI	A,0
  185F'   CA 1863'              	JZ	VI_CRS
  1862'   3C                    	INR	A
  1863'                         VI_CRS:
  1863'   F5                    	PUSH	PSW
  1864'   CD 1297'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1867'   CD 12AB'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  186A'   CD 067E'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  186D'   F1                    	POP	PSW
  186E'   32 245B'              	STA	ILABOV
  1871'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1872'                         VI_BS:
  1872'   CD 0000*              	CALL	PEEKL
  1875'   D8                    	RC			; start of the file: nothing to delete
  1876'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1878'   CA 187E'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  187B'   CD 0678'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  187E'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  187E'   CD 0188'              	CALL	MARKMOD
  1881'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1884'                         VI_ACT:
  1884'   79                    	MOV	A,C
  1885'   FE 0B                 	CPI	ACT_ESC
  1887'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  1888'   3E 00                 	MVI	A,EM_CMD
  188A'   32 2453'              	STA	EDMODE
  188D'   CD 0672'              	CALL	SETMOV
  1890'   CD 06E1'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1893'   C3 07E5'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1896'                         RDLINE:
  1896'   EB                    	XCHG			; HL = buffer
  1897'   22 249E'              	SHLD	RLPTR
  189A'   3E 00                 	MVI	A,0
  189C'   32 24A0'              	STA	RLLEN
  189F'   78                    	MOV	A,B
  18A0'   32 24A1'              	STA	RLMAX
  18A3'   79                    	MOV	A,C
  18A4'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  18A7'                         RL_LP:
  18A7'   CD 0000*              	CALL	GETKEY
  18AA'   78                    	MOV	A,B
  18AB'   FE 01                 	CPI	KT_ACT
  18AD'   CA 1903'              	JZ	RL_ACT
  18B0'   FE 02                 	CPI	KT_CHAR
  18B2'   C2 18A7'              	JNZ	RL_LP		; ignore other keys
  18B5'   79                    	MOV	A,C
  18B6'   FE 0D                 	CPI	CR
  18B8'   CA 1914'              	JZ	RL_DONE
  18BB'   FE 08                 	CPI	BS
  18BD'   CA 18EB'              	JZ	RL_BS
  18C0'   FE 7F                 	CPI	DEL
  18C2'   CA 18EB'              	JZ	RL_BS
  18C5'   FE 20                 	CPI	' '
  18C7'   DA 18A7'              	JC	RL_LP		; control char -> ignore
  18CA'   3A 24A0'              	LDA	RLLEN
  18CD'   47                    	MOV	B,A
  18CE'   3A 24A1'              	LDA	RLMAX
  18D1'   B8                    	CMP	B
  18D2'   CA 18A7'              	JZ	RL_LP		; full -> ignore
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  18D5'   2A 249E'              	LHLD	RLPTR
  18D8'   71                    	MOV	M,C
  18D9'   23                    	INX	H
  18DA'   22 249E'              	SHLD	RLPTR
  18DD'   3A 24A0'              	LDA	RLLEN
  18E0'   3C                    	INR	A
  18E1'   32 24A0'              	STA	RLLEN
  18E4'   79                    	MOV	A,C
  18E5'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  18E8'   C3 18A7'              	JMP	RL_LP
  18EB'                         RL_BS:				; WM LINEPOP
  18EB'   3A 24A0'              	LDA	RLLEN
  18EE'   B7                    	ORA	A
  18EF'   CA 1909'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  18F2'   3D                    	DCR	A
  18F3'   32 24A0'              	STA	RLLEN
  18F6'   2A 249E'              	LHLD	RLPTR
  18F9'   2B                    	DCX	H
  18FA'   22 249E'              	SHLD	RLPTR
  18FD'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1900'   C3 18A7'              	JMP	RL_LP
  1903'                         RL_ACT:
  1903'   79                    	MOV	A,C
  1904'   FE 0B                 	CPI	ACT_ESC
  1906'   C2 18A7'              	JNZ	RL_LP
  1909'                         RL_CAN:
  1909'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  190B'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  190E'   CD 0678'              	CALL	SETLIN		; redraw one row
  1911'   3E FF                 	MVI	A,0FFH		; cancelled
  1913'   C9                    	RET
  1914'                         RL_DONE:
  1914'   AF                    	XRA	A
  1915'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1916'                         VC_BZ:
  1916'   CD 0672'              	CALL	SETMOV
  1919'   3A 247C'              	LDA	GSAVE
  191C'   FE 02                 	CPI	PZ
  191E'   CA 1929'              	JZ	VZ_ZZ
  1921'   B7                    	ORA	A
  1922'   C0                    	RNZ			; 'g' was pending: vim drops both
  1923'   3E 02                 	MVI	A,PZ
  1925'   32 247B'              	STA	GPEND
  1928'   C9                    	RET
  1929'                         VZ_ZZ:
  1929'   3E 04                 	MVI	A,EO_X
  192B'   32 24A2'              	STA	EXOP
  192E'   3E 01                 	MVI	A,1
  1930'   32 24B5'              	STA	EXBANG		; no '!'
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  1933'   AF                    	XRA	A
  1934'   32 24A3'              	STA	EXARG		; no file name
  1937'   3A 2457'              	LDA	MODF		; as ':x': a changed text is written first
  193A'   B7                    	ORA	A
  193B'   CA 1A5E'              	JZ	EX_Q
  193E'   C3 19F8'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1941'                         VC_EX:
  1941'   CD 0605'              	CALL	GETCNT
  1944'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1947'   11 0000*              	LXI	D,EXBUF
  194A'   06 28                 	MVI	B,EXMAX
  194C'   0E 3A                 	MVI	C,':'
  194E'   CD 1896'              	CALL	RDLINE
  1951'   B7                    	ORA	A
  1952'   C0                    	RNZ			; cancelled
  1953'   3A 24A0'              	LDA	RLLEN
  1956'   5F                    	MOV	E,A
  1957'   16 00                 	MVI	D,0
  1959'   21 0000*              	LXI	H,EXBUF
  195C'   19                    	DAD	D
  195D'   36 00                 	MVI	M,0		; the line ends with a 0
  195F'   21 0000*              	LXI	H,EXBUF
  1962'   CD 1CFA'              	CALL	SKIPB
  1965'   C8                    	RZ			; nothing on it
  1966'   22 24A5'              	SHLD	EXCMD
  1969'   CD 1EA4'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  196C'   CD 1CFA'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  196F'   56                    	MOV	D,M
  1970'   23                    	INX	H
  1971'   1E 00                 	MVI	E,0
  1973'   CD 1D06'              	CALL	ISLOW
  1976'   DA 1981'              	JC	EX_LK
  1979'   5F                    	MOV	E,A
  197A'   23                    	INX	H
  197B'   CD 1D06'              	CALL	ISLOW
  197E'   D2 199A'              	JNC	EX_NOT		; a third letter: none of ours
  1981'                         EX_LK:
  1981'   E5                    	PUSH	H
  1982'   21 1E8E'              	LXI	H,EXTAB
  1985'                         EX_TL:
  1985'   7E                    	MOV	A,M
  1986'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  1987'   CA 1999'              	JZ	EX_NTP		; not in the table
  198A'   23                    	INX	H
  198B'   BA                    	CMP	D
  198C'   7E                    	MOV	A,M
  198D'   23                    	INX	H
  198E'   C2 1995'              	JNZ	EX_TN
  1991'   BB                    	CMP	E
  1992'   CA 19A0'              	JZ	EX_TF
  1995'                         EX_TN:
  1995'   23                    	INX	H
  1996'   C3 1985'              	JMP	EX_TL
  1999'                         EX_NTP:
  1999'   E1                    	POP	H
  199A'                         EX_NOT:
  199A'   21 1DBE'              	LXI	H,SNOT
  199D'   C3 1D3B'              	JMP	EXERT
  19A0'                         EX_TF:
  19A0'   7E                    	MOV	A,M
  19A1'   32 24A2'              	STA	EXOP
  19A4'   E1                    	POP	H
  19A5'   FE 06                 	CPI	EO_S
  19A7'   CA 1F13'              	JZ	EX_S		; ':s' reads the rest of the line itself
  19AA'   3A 24F6'              	LDA	SRNGF
  19AD'   B7                    	ORA	A
  19AE'   C2 199A'              	JNZ	EX_NOT		; a range on a command that does not take one
                                	;--- '!', then the file name ---
  19B1'   7E                    	MOV	A,M
  19B2'   D6 21                 	SUI	'!'
  19B4'   32 24B5'              	STA	EXBANG		; 0 = '!'
  19B7'   C2 19BB'              	JNZ	EX_NB
  19BA'   23                    	INX	H
  19BB'                         EX_NB:
  19BB'   CD 1CFA'              	CALL	SKIPB
  19BE'   32 24A3'              	STA	EXARG		; 0 = no file name
  19C1'   CA 19DA'              	JZ	EX_RUN
  19C4'   22 24A5'              	SHLD	EXCMD
  19C7'   3A 24A2'              	LDA	EXOP
  19CA'   FE 02                 	CPI	EO_Q
  19CC'   CA 1D38'              	JZ	EX_TRL		; :q takes none
  19CF'   FE 07                 	CPI	EO_V
  19D1'   CA 1D38'              	JZ	EX_TRL		; nor :ve
  19D4'   CD 1C64'              	CALL	PARSFN
  19D7'   C2 1D2C'              	JNZ	EX_INV
  19DA'                         EX_RUN:
  19DA'   3A 24A2'              	LDA	EXOP
  19DD'   FE 05                 	CPI	EO_E
  19DF'   CA 1A75'              	JZ	EX_E
  19E2'   FE 02                 	CPI	EO_Q
  19E4'   CA 1A5E'              	JZ	EX_Q
  19E7'   FE 07                 	CPI	EO_V
  19E9'   CA 1D32'              	JZ	EX_V
  19EC'   FE 04                 	CPI	EO_X
  19EE'   C2 19F8'              	JNZ	EX_W
  19F1'   3A 2457'              	LDA	MODF		; :x writes only a changed text
  19F4'   B7                    	ORA	A
  19F5'   CA 1A5E'              	JZ	EX_Q
