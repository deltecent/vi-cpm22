                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the cursor's line is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
                         C      ; PLACE -- what a command asks of the next layout (SCRN.MAC), cleared by it.
  0000                   C      PL_ASK	EQU	0		; the cursor only moved: is its line on the screen
                         C      				;   still, near it, or far off? (vim's rule)
  0001                   C      PL_SET	EQU	1		; the command set the lines above it (WINROW)
  0002                   C      PL_MID	EQU	2		; mid-screen, as the rows fall
                         C      
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; the cursor's line changed only -> redraw it from the cursor's row
  0003                   C      R_DLIN	EQU	3		; the cursor's line deleted -> DL its rows + redraw the bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted, no TAB after it -> ICH
  0005                   C      R_ILIN	EQU	5		; ILN lines opened at the cursor -> IL + their rows (ILABOV: the line above)
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw it + DL the rows saved
  0007                   C      R_DCH	EQU	7		; chars deleted at the cursor, none after it a TAB -> DCH
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	COL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	DCHN				; ... the cells an R_DCH deletes
                                	PUBLIC	DCHBS				; ... 1 = left of the cursor (BS)
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	LNALL				; ... 1 = an R_LINE from its first row
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	MKSHFT				; the marks follow an edit (VI.MAC hooks it)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	HTN, HTCUR, HTEOF, HTBOF	; the row table's facts (SCRN.MAC HTBLD)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	KBBRK, KBFLSH			; KEY.MAC -- an ESC waiting / drop type-ahead
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	MKSAV				; ... and a refused 'dd's copy of them
                                	EXTRN	MKUND				; ... and the copy 'u' puts back
                                	EXTRN	UNDST, UNDNEW			; BUF.MAC -- undone or not; no change yet
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
                                	EXTRN	UNDCLR				; ... nothing to undo
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	INSBLK, UNDINS			; BUF.MAC -- a block in at the cursor (':r')
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	UNDML, UNDL0			; ... and whether one line changed
                                	EXTRN	UNDLK, UNDLC, UNDLL0		; ... or whole lines came or went
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
                                	EXTRN	SCBOT, SCEOF, SCBOF, PLACE	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	SKIPR, TALLF		; a top line taller than the screen
                                	EXTRN	TXEND, CSUB, HTBLD		; ... its rows of text, the cursor's row
                                						;   in its line, and the row table
                                	EXTRN	HTAB				; RSV.MAC -- the row table itself
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	SETC0				; BUF.MAC -- WM count set, forward
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GOLINE				; BUF.MAC -- WM 2228 (a mark's page loop)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   AF                    	XRA	A		; no command is ever left open to an ESC by the
  0001'   32 2F1F'              	STA	BRKARM		;   one before it (BRKON)
  0004'   CD 00D7'              	CALL	DOTPRE
  0007'   CD 000D'              	CALL	CDMODE
  000A'   C3 011C'              	JMP	DOTPOST
  000D'                         CDMODE:
  000D'   3A 2E5F'              	LDA	EDMODE
  0010'   FE 01                 	CPI	EM_INS
  0012'   CA 001D'              	JZ	CD_INS
  0015'   FE 02                 	CPI	EM_REP
  0017'   CA 0020'              	JZ	CD_REP
  001A'   C3 0023'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  001D'                         CD_INS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  001D'   C3 1FAC'              	JMP	VIINS
  0020'                         CD_REP:
  0020'   C3 1EE1'              	JMP	VIREP
                                
                                ;============================================================
                                ; VICMD -- command-mode key.  C = the key.
                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  0023'                         VICMD:
  0023'   79                    	MOV	A,C
  0024'   FE 1B                 	CPI	ESC
  0026'   CA 00AC'              	JZ	VIC_ESC
  0029'   3A 2E95'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002C'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  002E'   CA 1ACB'              	JZ	VR_DO
                                	;--- maybe a count digit ---
  0031'   79                    	MOV	A,C
  0032'   FE 31                 	CPI	'1'
  0034'   DA 003F'              	JC	VIC_NOTD	; < '1'
  0037'   FE 3A                 	CPI	'9'+1
  0039'   D2 003F'              	JNC	VIC_NOTD	; > '9'
  003C'   C3 004F'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  003F'                         VIC_NOTD:
  003F'   79                    	MOV	A,C
  0040'   FE 30                 	CPI	'0'
  0042'   C2 0077'              	JNZ	VICDSP
  0045'   2A 2E60'              	LHLD	CMDCNT
  0048'   7C                    	MOV	A,H
  0049'   B5                    	ORA	L
  004A'   CA 0077'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  004D'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  004F'                         VICDIG:
  004F'   2A 2E60'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0052'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0053'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0054'   29                    	DAD	H		; *2
  0055'   DA 006E'              	JC	VIC_SAT
  0058'   29                    	DAD	H		; *4
  0059'   DA 006E'              	JC	VIC_SAT
  005C'   19                    	DAD	D		; *5
  005D'   DA 006E'              	JC	VIC_SAT
  0060'   29                    	DAD	H		; *10
  0061'   DA 006E'              	JC	VIC_SAT
  0064'   79                    	MOV	A,C
  0065'   D6 30                 	SUI	'0'
  0067'   5F                    	MOV	E,A
  0068'   16 00                 	MVI	D,0
  006A'   19                    	DAD	D
  006B'   D2 0071'              	JNC	VIC_CNT
  006E'                         VIC_SAT:
  006E'   21 FFFF               	LXI	H,0FFFFH
  0071'                         VIC_CNT:
  0071'   22 2E60'              	SHLD	CMDCNT
  0074'   C3 0852'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  0077'                         VICDSP:
  0077'   3A 2E95'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  007A'   32 2E96'              	STA	GSAVE
  007D'   AF                    	XRA	A
  007E'   32 2E95'              	STA	GPEND
  0081'   3A 2E97'              	LDA	PENDOP
  0084'   32 2E98'              	STA	PSAVE
  0087'   AF                    	XRA	A
  0088'   32 2E97'              	STA	PENDOP
  008B'   3A 2E98'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  008E'   B7                    	ORA	A
  008F'   C2 1419'              	JNZ	OPPEND
  0092'   3A 2E96'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0095'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  0097'   C2 00A0'              	JNZ	VIC_TB
  009A'   79                    	MOV	A,C
  009B'   FE 5A                 	CPI	'Z'
  009D'   C2 00A6'              	JNZ	VIC_SW
  00A0'                         VIC_TB:
  00A0'   21 2DA7'              	LXI	H,CMDTAB
  00A3'   C3 00BC'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A6'                         VIC_SW:
  00A6'   CD 0852'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00A9'   C3 077D'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AC'                         VIC_ESC:
  00AC'   AF                    	XRA	A		; ESC drops whatever was pending, the count too
  00AD'   32 2E95'              	STA	GPEND
  00B0'   32 2E96'              	STA	GSAVE
  00B3'   32 2E97'              	STA	PENDOP
  00B6'   32 2E98'              	STA	PSAVE
  00B9'   C3 00A6'              	JMP	VIC_SW
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the TOP-LEVEL key table, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00BC'                         VSCANQ:
  00BC'   CD 00C8'              	CALL	VSCLK
  00BF'   CA 00A6'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C2'   E9                    	PCHL
  00C3'                         VSCAN:
  00C3'   CD 00C8'              	CALL	VSCLK
  00C6'   C8                    	RZ			; miss
  00C7'   E9                    	PCHL
  00C8'                         VSCLK:
  00C8'   7E                    VSCAN1: MOV	A,M
  00C9'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00CA'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00CB'   23                    	INX	H
  00CC'   B9                    	CMP	C
  00CD'   5E                    	MOV	E,M
  00CE'   23                    	INX	H
  00CF'   56                    	MOV	D,M
  00D0'   23                    	INX	H
  00D1'   C2 00C8'              	JNZ	VSCAN1
  00D4'   EB                    	XCHG			; HL = the handler
  00D5'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00D6'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00D7'                         DOTPRE:
  00D7'   3A 2E8C'              	LDA	DOTRPL
  00DA'   B7                    	ORA	A
  00DB'   C0                    	RNZ			; the replay's own keys are not recorded
  00DC'   C5                    	PUSH	B
  00DD'   D5                    	PUSH	D
  00DE'   E5                    	PUSH	H
  00DF'   3A 2E8B'              	LDA	DOTSTA
  00E2'   B7                    	ORA	A
  00E3'   CA 00F6'              	JZ	DOTP1
  00E6'   AF                    	XRA	A		; a new command: the recording starts over
  00E7'   32 2E8B'              	STA	DOTSTA
  00EA'   32 2E8D'              	STA	DOTOVF
  00ED'   21 0000*              	LXI	H,DOTSCR
  00F0'   22 2E8F'              	SHLD	DOTSP
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00F3'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00F6'                         DOTP1:
  00F6'   79                    	MOV	A,C
  00F7'   32 2E8E'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  00FA'   47                    	MOV	B,A
  00FB'   2A 2E8F'              	LHLD	DOTSP
  00FE'   EB                    	XCHG
  00FF'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  0102'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  0105'   D2 0114'              	JNC	DOTPOV
  0108'   2A 2E8F'              	LHLD	DOTSP
  010B'   70                    	MOV	M,B
  010C'   23                    	INX	H
  010D'   22 2E8F'              	SHLD	DOTSP
  0110'                         DOTPX:
  0110'   E1                    	POP	H
  0111'   D1                    	POP	D
  0112'   C1                    	POP	B
  0113'   C9                    	RET
  0114'                         DOTPOV:
  0114'   3E 01                 	MVI	A,1
  0116'   32 2E8D'              	STA	DOTOVF		; too long to record: give this recording up
  0119'   C3 0110'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  011C'                         DOTPOST:
  011C'   3A 2E8C'              	LDA	DOTRPL
  011F'   B7                    	ORA	A
  0120'   C0                    	RNZ
  0121'   3A 2E5F'              	LDA	EDMODE
  0124'   B7                    	ORA	A
  0125'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  0126'   3A 2E95'              	LDA	GPEND
  0129'   B7                    	ORA	A
  012A'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  012B'   3A 2E97'              	LDA	PENDOP
  012E'   B7                    	ORA	A
  012F'   C0                    	RNZ			; an operator still waiting for its motion
  0130'   2A 2E60'              	LHLD	CMDCNT
  0133'   7C                    	MOV	A,H
  0134'   B5                    	ORA	L
  0135'   CA 0143'              	JZ	DOTQ1
  0138'   3A 2E8E'              	LDA	DOTLK		; a digit with the count still up: the command
  013B'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  013D'   DA 0143'              	JC	DOTQ1
  0140'   FE 3A                 	CPI	'9'+1
  0142'   D8                    	RC
  0143'                         DOTQ1:
  0143'   3E 01                 	MVI	A,1
  0145'   32 2E8B'              	STA	DOTSTA		; the next key starts a new recording
  0148'   3A 2E8A'              	LDA	DOTCHG
  014B'   B7                    	ORA	A
  014C'   C8                    	RZ			; changed nothing: not a repeatable command
  014D'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  014E'   32 2E8A'              	STA	DOTCHG
  0151'   32 2E91'              	STA	DOTLEN
  0154'   3A 2E8D'              	LDA	DOTOVF
  0157'   B7                    	ORA	A
  0158'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  0159'   2A 2E8F'              	LHLD	DOTSP
  015C'   11 0000*              	LXI	D,DOTSCR
  015F'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  0162'   7D                    	MOV	A,L
  0163'   32 2E91'              	STA	DOTLEN
  0166'   B7                    	ORA	A
  0167'   C8                    	RZ
  0168'   4F                    	MOV	C,A
  0169'   06 00                 	MVI	B,0
  016B'   21 0000*              	LXI	H,DOTSCR
  016E'   11 0000*              	LXI	D,DOTBUF
  0171'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  0174'                         MARKMOD:
  0174'   3E 01                 	MVI	A,1
  0176'   32 2E63'              	STA	MODF
  0179'   32 2E8A'              	STA	DOTCHG
  017C'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  017D'                         VC_DOT:
  017D'   2A 2E60'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0180'   22 2E93'              	SHLD	DOTNCT
  0183'   21 0000               	LXI	H,0
  0186'   22 2E60'              	SHLD	CMDCNT
  0189'   3A 2E91'              	LDA	DOTLEN
  018C'   B7                    	ORA	A
  018D'   CA 01DC'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
  0190'   AF                    	XRA	A
  0191'   32 2E92'              	STA	DOTIX
  0194'   2A 2E93'              	LHLD	DOTNCT
  0197'   7C                    	MOV	A,H
  0198'   B5                    	ORA	L
  0199'   CA 01B9'              	JZ	DOTGO
  019C'   22 2E60'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  019F'                         DOTSKP:
  019F'   CD 05EF'              	CALL	DOTGET		; ... so step past the digits it recorded
  01A2'   DA 01B9'              	JC	DOTGO
  01A5'   FE 30                 	CPI	'0'
  01A7'   DA 01B9'              	JC	DOTGO
  01AA'   FE 3A                 	CPI	'9'+1
  01AC'   D2 01B9'              	JNC	DOTGO
  01AF'   3A 2E92'              	LDA	DOTIX
  01B2'   3C                    	INR	A
  01B3'   32 2E92'              	STA	DOTIX
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01B6'   C3 019F'              	JMP	DOTSKP
  01B9'                         DOTGO:
  01B9'   3E 01                 	MVI	A,1
  01BB'   32 2E8C'              	STA	DOTRPL
  01BE'                         DOTLP:
  01BE'   CD 05EF'              	CALL	DOTGET
  01C1'   DA 01D2'              	JC	DOTDN
  01C4'   4F                    	MOV	C,A
  01C5'   3A 2E92'              	LDA	DOTIX
  01C8'   3C                    	INR	A
  01C9'   32 2E92'              	STA	DOTIX
  01CC'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01CF'   C3 01BE'              	JMP	DOTLP
  01D2'                         DOTDN:
  01D2'   AF                    	XRA	A
  01D3'   32 2E8C'              	STA	DOTRPL
  01D6'   32 2E8A'              	STA	DOTCHG		; the '.' is not itself the new last change
  01D9'   C3 088F'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01DC'                         DOTBEL:
  01DC'   0E 07                 	MVI	C,BEL
  01DE'   CD 0000*              	CALL	BCONOU
  01E1'   C3 0852'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a 3-byte position in the FILE (FPOS: the records paged out ahead
                                ; of the window, plus the offset into it), so it does not care which part of
                                ; the file is resident: a jump pages until the window holds it (MKPAGE).  It
                                ; FOLLOWS its text, as vim's does: every edit passes MKSHFT, which moves the
                                ; marks past it by the bytes that went in or came out.
                                ;
                                ; DEVIATIONS from vim, in COMMANDS.md: a mark whose own text is deleted closes
                                ; up to where the delete was, where vim deletes the mark with its line; and
                                ; within its line a mark stays with its CHARACTER, where vim keeps the column
                                ; number.  'u' puts the marks back where they were when the change it
                                ; undoes began (MKSNAP / MKREST).
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  01E4'                         MKVAD:
  01E4'   16 00                 	MVI	D,0
  01E6'   59                    	MOV	E,C
  01E7'   21 2EFB'              	LXI	H,MKVAL
  01EA'   19                    	DAD	D
  01EB'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  01EC'                         MKCLR:
  01EC'   21 2EFB'              	LXI	H,MKVAL
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


  01EF'   06 03                 	MVI	B,MKMAX
  01F1'   AF                    	XRA	A
  01F2'                         MKC_LP:
  01F2'   77                    	MOV	M,A
  01F3'   23                    	INX	H
  01F4'   05                    	DCR	B
  01F5'   C2 01F2'              	JNZ	MKC_LP
  01F8'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was an ESC.
                                ;A key typed here did not come through the dispatcher, so it is handed to
                                ;DOTPRE to join the recording: that is what lets '.' repeat "dfa", "dgg" and
                                ;"d'a".
  01F9'                         MKGETK:
  01F9'   3A 2E8C'              	LDA	DOTRPL
  01FC'   B7                    	ORA	A
  01FD'   CA 020E'              	JZ	MKG_KB
  0200'   CD 05EF'              	CALL	DOTGET		; the recording's next key
  0203'   D8                    	RC
  0204'   4F                    	MOV	C,A
  0205'   3A 2E92'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  0208'   3C                    	INR	A
  0209'   32 2E92'              	STA	DOTIX
  020C'   B7                    	ORA	A		; CY clear
  020D'   C9                    	RET
  020E'                         MKG_KB:
  020E'   CD 0000*              	CALL	GETKEY
  0211'   FE 1B                 	CPI	ESC
  0213'   37                    	STC
  0214'   C8                    	RZ			; ESC cancels the command
  0215'   CD 00D7'              	CALL	DOTPRE		; C kept
  0218'   B7                    	ORA	A		; CY clear
  0219'   C9                    	RET
                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
                                ; the motion returns.  MKGETK puts the character in the '.' recording, so
                                ; '.' can repeat "dfa".
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


                                ;============================================================
  021A'                         VC_FF:				; 'f' -- forward, onto the character
  021A'   3E 66                 	MVI	A,'f'
  021C'   C3 022B'              	JMP	FNDNEW
  021F'                         VC_FB:				; 'F' -- backward, onto it
  021F'   3E 46                 	MVI	A,'F'
  0221'   C3 022B'              	JMP	FNDNEW
  0224'                         VC_TF:				; 't' -- forward, up to it
  0224'   3E 74                 	MVI	A,'t'
  0226'   C3 022B'              	JMP	FNDNEW
  0229'                         VC_TB:				; 'T' -- backward, up to it
  0229'   3E 54                 	MVI	A,'T'
  022B'                         FNDNEW:
  022B'   32 2EF0'              	STA	FNDKND		; the find ';' and ',' will repeat
  022E'   CD 01F9'              	CALL	MKGETK		; the character it looks for
  0231'   DA 0263'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0234'   79                    	MOV	A,C
  0235'   32 2EF1'              	STA	FNDCH
  0238'   3A 2EF0'              	LDA	FNDKND
  023B'   06 01                 	MVI	B,1		; a find starts at the next character along
  023D'   C3 026A'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0240'                         VC_SEMI:
  0240'   3A 2EF0'              	LDA	FNDKND
  0243'   B7                    	ORA	A
  0244'   CA 0263'              	JZ	FNDNIL		; nothing has been looked for yet
  0247'   C3 0253'              	JMP	FNDREP
  024A'                         VC_COMMA:
  024A'   3A 2EF0'              	LDA	FNDKND
  024D'   B7                    	ORA	A
  024E'   CA 0263'              	JZ	FNDNIL
  0251'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0253'                         FNDREP:
  0253'   06 01                 	MVI	B,1
  0255'   F5                    	PUSH	PSW
  0256'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  0258'   FE 54                 	CPI	'T'
  025A'   C2 025F'              	JNZ	FNDR_GO
  025D'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  025F'                         FNDR_GO:
  025F'   F1                    	POP	PSW
  0260'   C3 026A'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
  0263'                         FNDNIL:
  0263'   AF                    	XRA	A
  0264'   32 2E98'              	STA	PSAVE
  0267'   C3 0852'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  026A'                         FNDGO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  026A'   32 2EF2'              	STA	FNDRUN
  026D'   78                    	MOV	A,B
  026E'   32 2EF3'              	STA	FNDSTP
  0271'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
  0274'   22 2EF4'              	SHLD	FNDN		; the occurrence wanted
  0277'   CD 0000*              	CALL	CUROFF
  027A'   22 2EF6'              	SHLD	FNDCUR
  027D'   3A 2EF2'              	LDA	FNDRUN
  0280'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  0282'   CA 02B6'              	JZ	FNDBWD
  0285'   2A 2EF6'              	LHLD	FNDCUR
  0288'   CD 0715'              	CALL	EOLC		; HL = the line's last content character
  028B'   22 2EF8'              	SHLD	FNDLIM
  028E'   2A 2EF6'              	LHLD	FNDCUR
  0291'   3A 2EF3'              	LDA	FNDSTP
  0294'   5F                    	MOV	E,A
  0295'   16 00                 	MVI	D,0
  0297'   19                    	DAD	D		; HL = where the scan starts
  0298'                         FNDF_LP:
  0298'   EB                    	XCHG			; DE = the scan
  0299'   2A 2EF8'              	LHLD	FNDLIM
  029C'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  029F'   EB                    	XCHG			; HL = the scan
  02A0'   CA 02A6'              	JZ	FNDF_AT		; the last character is still a candidate
  02A3'   D2 0308'              	JNC	FNDMIS		; past it: not on this line
  02A6'                         FNDF_AT:
  02A6'   CD 030F'              	CALL	FNDSEE		; Z iff this is the character
  02A9'   C2 02B2'              	JNZ	FNDF_NX
  02AC'   CD 031A'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02AF'   CA 02EE'              	JZ	FNDHIT
  02B2'                         FNDF_NX:
  02B2'   23                    	INX	H
  02B3'   C3 0298'              	JMP	FNDF_LP
  02B6'                         FNDBWD:
  02B6'   2A 2EF6'              	LHLD	FNDCUR
  02B9'   CD 066F'              	CALL	BOL		; HL = the line's first character
  02BC'   22 2EF8'              	SHLD	FNDLIM
  02BF'   2A 2EF6'              	LHLD	FNDCUR
  02C2'   3A 2EF3'              	LDA	FNDSTP
  02C5'   2F                    	CMA
  02C6'   5F                    	MOV	E,A
  02C7'   16 FF                 	MVI	D,0FFH
  02C9'   13                    	INX	D		; DE = -step
  02CA'   19                    	DAD	D		; HL = where the scan starts
  02CB'   D2 0308'              	JNC	FNDMIS		; ... off the front of the text altogether
  02CE'                         FNDB_LP:
  02CE'   EB                    	XCHG			; DE = the scan
  02CF'   2A 2EF8'              	LHLD	FNDLIM
  02D2'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02D5'   EB                    	XCHG			; HL = the scan
  02D6'   DA 0308'              	JC	FNDMIS		; before this line: not on it
  02D9'   CD 030F'              	CALL	FNDSEE
  02DC'   C2 02E5'              	JNZ	FNDB_NX
  02DF'   CD 031A'              	CALL	FNDCNT
  02E2'   CA 02EE'              	JZ	FNDHIT
  02E5'                         FNDB_NX:
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02E5'   7C                    	MOV	A,H
  02E6'   B5                    	ORA	L
  02E7'   CA 0308'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
  02EA'   2B                    	DCX	H
  02EB'   C3 02CE'              	JMP	FNDB_LP
                                
                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  02EE'                         FNDHIT:
  02EE'   3A 2EF2'              	LDA	FNDRUN
  02F1'   E6 5F                 	ANI	5FH
  02F3'   FE 54                 	CPI	'T'
  02F5'   C2 0305'              	JNZ	FNDLND
  02F8'   3A 2EF2'              	LDA	FNDRUN
  02FB'   E6 20                 	ANI	20H
  02FD'   CA 0304'              	JZ	FNDH_BW
  0300'   2B                    	DCX	H		; forward 't': the character before it
  0301'   C3 0305'              	JMP	FNDLND
  0304'                         FNDH_BW:
  0304'   23                    	INX	H		; backward 'T': the character after it
  0305'                         FNDLND:
  0305'   C3 0605'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  0308'                         FNDMIS:
  0308'   AF                    	XRA	A
  0309'   32 2E98'              	STA	PSAVE
  030C'   C3 01DC'              	JMP	DOTBEL
                                
                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
  030F'                         FNDSEE:
  030F'   E5                    	PUSH	H
  0310'   CD 0000*              	CALL	CHARAT
  0313'   E1                    	POP	H
  0314'   47                    	MOV	B,A
  0315'   3A 2EF1'              	LDA	FNDCH
  0318'   B8                    	CMP	B
  0319'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
                                ; the scan and stays it.
  031A'                         FNDCNT:
  031A'   E5                    	PUSH	H
  031B'   2A 2EF4'              	LHLD	FNDN
  031E'   2B                    	DCX	H
  031F'   22 2EF4'              	SHLD	FNDN
  0322'   7C                    	MOV	A,H
  0323'   B5                    	ORA	L
  0324'   E1                    	POP	H
  0325'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  0326'                         ISFIND:
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  0326'   E6 5F                 	ANI	5FH		; fold the case away
  0328'   FE 46                 	CPI	'F'
  032A'   C8                    	RZ
  032B'   FE 54                 	CPI	'T'
  032D'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  032E'                         VC_MK:
  032E'   3E 04                 	MVI	A,PM
  0330'   C3 033A'              	JMP	MKGO
  0333'                         VC_BQ:
  0333'   3E 05                 	MVI	A,PJ
  0335'   C3 033A'              	JMP	MKGO
  0338'                         VC_AQ:
  0338'   3E 06                 	MVI	A,PJL
  033A'                         MKGO:
  033A'   32 2F07'              	STA	MKWHAT
  033D'   CD 076A'              	CALL	MOVCNT		; a count means nothing on any of the three
  0340'   CD 01F9'              	CALL	MKGETK		; the key that names the mark
  0343'   DA 0422'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out.  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist: 'm' with any other key
                                ;drops the whole thing, as vim's 'Z{other}' does, and a jump to one is a jump
                                ;to a mark that is not set.
  0346'                         MKOP:
  0346'   79                    	MOV	A,C
  0347'   D6 61                 	SUI	'a'
  0349'   FE 03                 	CPI	MKMAX
  034B'   D2 041A'              	JNC	MKNOLT		; not a mark letter
  034E'   4F                    	MOV	C,A		; C = the mark's index
  034F'   87                    	ADD	A
  0350'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  0351'   5F                    	MOV	E,A
  0352'   16 00                 	MVI	D,0
  0354'   21 0000*              	LXI	H,MKTAB
  0357'   19                    	DAD	D		; HL -> this mark's slot
  0358'   3A 2F07'              	LDA	MKWHAT
  035B'   FE 04                 	CPI	PM
  035D'   CA 0435'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark, paging to it if the window has left it.
                                ;'Mark not set', as vim says it, when it was never set.
                                ;Under an OPERATOR a mark the window does not hold is refused with the bell
                                ;and stays set, all but "d'a": a line delete is the one operator that can take
                                ;a span the window does not hold whole (OPPGD), and going there only to be
                                ;turned away by it would page the file twice for nothing.
  0360'                         MKJMP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  0360'   E5                    	PUSH	H
  0361'   CD 01E4'              	CALL	MKVAD
  0364'   7E                    	MOV	A,M
  0365'   E1                    	POP	H
  0366'   B7                    	ORA	A
  0367'   CA 0410'              	JZ	MKNSET		; never set
  036A'   CD 03DC'              	CALL	MKLOAD		; the file position it holds
  036D'   CD 03E9'              	CALL	MKWIN
  0370'   DA 0387'              	JC	MKJ_GO		; in the window: any command may go there
  0373'   3A 2E98'              	LDA	PSAVE
  0376'   B7                    	ORA	A
  0377'   CA 0387'              	JZ	MKJ_GO
  037A'   FE 64                 	CPI	'd'		; paged out, and an operator wants the span
  037C'   C2 0422'              	JNZ	MKBAD
  037F'   3A 2F07'              	LDA	MKWHAT
  0382'   FE 06                 	CPI	PJL
  0384'   C2 0422'              	JNZ	MKBAD
  0387'                         MKJ_GO:
  0387'   CD 132A'              	CALL	GZONE		; the screen's top line, before the cursor
                                				;   moves: GPLACE measures the landing against
                                				;   it, and one left over from an earlier 'G'
                                				;   had it keep a window the line is not in
  038A'   CD 07A6'              	CALL	BRKON		; ... and an ESC may stop it from here on
  038D'   CD 03A9'              	CALL	MKPAGE		; HL = the mark's offset in the window
  0390'   CD 07E3'              	CALL	BRKOFF		; (A only)
  0393'   DA 07FB'              	JC	BRKBAK
  0396'   3A 2F07'              	LDA	MKWHAT
  0399'   FE 06                 	CPI	PJL
  039B'   CA 03A3'              	JZ	MKJ_LN		; ''': GPKEEP is 0, so GPLACE finds the first
  039E'   3E 01                 	MVI	A,1		;   non-blank
  03A0'   32 2EFA'              	STA	GPKEEP		; '`': land on the column it was set at
  03A3'                         MKJ_LN:
  03A3'   CD 0000*              	CALL	GOTO
  03A6'   C3 1342'              	JMP	GPLACE		; (which sets LNDLT itself)
                                
                                ;MKPAGE -- page until MKPOS is in the window: HL = its logical offset there.
                                ;The loop is WM's own whole-file line move (MVLMAX: GOLINE to the window's
                                ;edge, SCRLST to page one step), stopped by where the window is instead of by
                                ;the count.  A step cannot carry the window past the mark: the pager evicts
                                ;only behind the cursor, and the cursor is on the edge nearer the mark.
  03A9'                         MKPAGE:
  03A9'   CD 03E9'              	CALL	MKWIN
  03AC'   DA 0000*              	JC	CLRCNT		; there: and the count that paged is spent,
                                				;   not left for the next command to take
  03AF'   32 0000*              	STA	DIRFLG
  03B2'   21 FFFF               	LXI	H,0FFFFH
  03B5'   22 2E60'              	SHLD	CMDCNT
  03B8'   CD 0000*              	CALL	GOLINE
  03BB'   CD 0000*              	CALL	SCRLST
  03BE'   CD 0792'              	CALL	CNTTST
  03C1'   C2 03A9'              	JNZ	MKPAGE
  03C4'   CD 03E9'              	CALL	MKWIN		; the file ran out: that was its last step
  03C7'   DA 0000*              	JC	CLRCNT
  03CA'   21 FFFF               	LXI	H,0FFFFH	; the very end of the text, which MKWIN does not
  03CD'   C3 0000*              	JMP	CLRCNT		;   count as in the window: GOTO clamps it
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


                                ;BACKTO -- back to the 3-byte file position at HL, paging to it: where a
                                ;command that came to nothing started.  The place has to be kept as a file
                                ;position -- a sweep of the whole file leaves the window at the far end of
                                ;it, and an offset into the window it started in means nothing there.
  03D0'                         BACKTO:
  03D0'   CD 03DC'              	CALL	MKLOAD
  03D3'   CD 0000*              	CALL	CLRCNT
  03D6'   CD 03A9'              	CALL	MKPAGE
  03D9'   C3 0000*              	JMP	GOTO
                                
                                ;MKLOAD -- MKPOS = the 3-byte file position at HL.
  03DC'                         MKLOAD:
  03DC'   5E                    	MOV	E,M
  03DD'   23                    	INX	H
  03DE'   56                    	MOV	D,M
  03DF'   23                    	INX	H
  03E0'   7E                    	MOV	A,M
  03E1'   EB                    	XCHG
  03E2'   22 2F04'              	SHLD	MKPOS
  03E5'   32 2F06'              	STA	MKPOS+2
  03E8'   C9                    	RET
                                
                                ;MKWIN -- CY and HL = MKPOS as a logical offset if the window holds it; NC and
                                ;A = the way to page for it, as DIRFLG has it (0 forward, FFH back), if not.
  03E9'                         MKWIN:
  03E9'   2A 0000*              	LHLD	TXTBEG
  03EC'   CD 12E4'              	CALL	FPOS
  03EF'   EB                    	XCHG
  03F0'   47                    	MOV	B,A		; B:DE = the window's first byte
  03F1'   2A 2F04'              	LHLD	MKPOS
  03F4'   3A 2F06'              	LDA	MKPOS+2
  03F7'   CD 12D7'              	CALL	SUB24		; A:HL = the mark, from the window's top
  03FA'   DA 040C'              	JC	MKW_BK		; above it
  03FD'   C2 040A'              	JNZ	MKW_FW		; 64K or more below it
  0400'   E5                    	PUSH	H
  0401'   CD 0000*              	CALL	LOGLEN
  0404'   D1                    	POP	D
  0405'   CD 0000*              	CALL	CMP16		; DE = the offset vs HL = the window's length
  0408'   EB                    	XCHG
  0409'   D8                    	RC			; inside
  040A'                         MKW_FW:
  040A'   AF                    	XRA	A
  040B'   C9                    	RET
  040C'                         MKW_BK:
  040C'   3E FF                 	MVI	A,0FFH
  040E'   B7                    	ORA	A
  040F'   C9                    	RET
                                
                                ;MKNSET -- a jump to a mark that will not answer: vim's E20 on the bottom row
                                ;(without the number, and without a bell, as every message here), the cursor
                                ;and the screen left alone.  The operator is cancelled as MKBAD cancels it.
  0410'                         MKNSET:
  0410'   AF                    	XRA	A
  0411'   32 2E98'              	STA	PSAVE
  0414'   21 2837'              	LXI	H,SMKNS
  0417'   C3 271C'              	JMP	EXERR
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  041A'                         MKNOLT:
  041A'   3A 2F07'              	LDA	MKWHAT
  041D'   FE 04                 	CPI	PM
  041F'   C2 0410'              	JNZ	MKNSET		; a jump: that mark is not set
                                				; 'm{other}': fall into MKBAD
                                
                                ;MKBAD -- no mark was named: 'm' with a key that is not a mark letter, ESC in
                                ;place of the letter, or a '.' replay that ran out.  The bell, and an operator
                                ;running the motion is cancelled whole: PSAVE is what OPPEND's tail reads to
                                ;decide whether to open an insert, so clearing it stops a "c`z" opening one
                                ;over a span of nothing.
  0422'                         MKBAD:
  0422'   AF                    	XRA	A
  0423'   32 2E98'              	STA	PSAVE
  0426'   C3 01DC'              	JMP	DOTBEL
                                
                                ;FPSTO -- the cursor's file position into the 3 bytes at HL.  Keeps BC.
  0429'                         FPSTO:
  0429'   E5                    	PUSH	H
  042A'   CD 12E1'              	CALL	CURFP		; A:HL = the cursor's file position
  042D'   EB                    	XCHG
  042E'   E1                    	POP	H
  042F'   73                    	MOV	M,E
  0430'   23                    	INX	H
  0431'   72                    	MOV	M,D
  0432'   23                    	INX	H
  0433'   77                    	MOV	M,A
  0434'   C9                    	RET
                                
                                ;MKSET -- remember where in the FILE the cursor is.
  0435'                         MKSET:
  0435'   CD 0429'              	CALL	FPSTO
  0438'   CD 01E4'              	CALL	MKVAD
  043B'   36 01                 	MVI	M,1		; ... and the mark is live
  043D'   C3 0852'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKSNAP -- keep the marks as they stand, for 'u' (MKREST).  Each copy's spare
                                ;fourth byte takes that mark's live flag.  HL and BC are kept.
  0440'                         MKSNAP:
  0440'   C5                    	PUSH	B
  0441'   E5                    	PUSH	H
  0442'   21 0000*              	LXI	H,MKTAB
  0445'   11 0000*              	LXI	D,MKUND
  0448'   CD 253F'              	CALL	COPY12
  044B'   21 2EFB'              	LXI	H,MKVAL
  044E'   11 0003*              	LXI	D,MKUND+MKSIZ-1
  0451'   06 03                 	MVI	B,MKMAX
  0453'                         MSN_LP:
  0453'   7E                    	MOV	A,M
  0454'   12                    	STAX	D
  0455'   23                    	INX	H
  0456'   13                    	INX	D
  0457'   13                    	INX	D
  0458'   13                    	INX	D
  0459'   13                    	INX	D
  045A'   05                    	DCR	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  045B'   C2 0453'              	JNZ	MSN_LP
  045E'   E1                    	POP	H
  045F'   C1                    	POP	B
  0460'   C9                    	RET
                                
                                ;MKREST -- a change has been undone: every mark that was set when it began
                                ;goes back where it was then, whether the change ran over it or 'm' has moved
                                ;it since (vim keeps them with the undo too).  One first set AFTER the change
                                ;is left where the replay's own edits carried it.
  0461'                         MKREST:
  0461'   0E 02                 	MVI	C,MKMAX-1
  0463'                         MRS_LP:
  0463'   79                    	MOV	A,C
  0464'   87                    	ADD	A
  0465'   87                    	ADD	A
  0466'   5F                    	MOV	E,A
  0467'   16 00                 	MVI	D,0
  0469'   21 0003*              	LXI	H,MKUND+MKSIZ-1
  046C'   19                    	DAD	D
  046D'   7E                    	MOV	A,M
  046E'   B7                    	ORA	A
  046F'   CA 048B'              	JZ	MRS_NX		; it was not set then
  0472'   2B                    	DCX	H
  0473'   2B                    	DCX	H
  0474'   2B                    	DCX	H
  0475'   E5                    	PUSH	H
  0476'   21 0000*              	LXI	H,MKTAB
  0479'   19                    	DAD	D
  047A'   EB                    	XCHG			; DE -> the mark
  047B'   E1                    	POP	H		; HL -> its copy
  047C'   06 03                 	MVI	B,MKSIZ-1
  047E'                         MRS_CP:
  047E'   7E                    	MOV	A,M
  047F'   12                    	STAX	D
  0480'   23                    	INX	H
  0481'   13                    	INX	D
  0482'   05                    	DCR	B
  0483'   C2 047E'              	JNZ	MRS_CP
  0486'   CD 01E4'              	CALL	MKVAD
  0489'   36 01                 	MVI	M,1
  048B'                         MRS_NX:
  048B'   0D                    	DCR	C
  048C'   F2 0463'              	JP	MRS_LP
  048F'   C9                    	RET
                                
                                ;MKSHFT -- the text is changing: every mark follows its own text.  BUF.MAC's
                                ;UNDCHG calls this through EDTHK from all six edit primitives -- 'u's replay
                                ;of them included -- with A = 1 for an insert (the text is in) or 2 for a
                                ;delete (it is about to go), HL = the edit's logical offset and BC = its
                                ;length.  A mark before the edit stays; one after it moves by the length; one
                                ;INSIDE a delete closes up to where the delete was.  An insert AT a mark
                                ;leaves the mark in front of the new text, unless that text ends a line -- a
                                ;line opened or put above the mark's is above the mark too.
                                ;The edit is found from the CURSOR's file position less its distance behind
                                ;the cursor, never from the offset alone: a put bigger than the window pages
                                ;its own start out, and that offset has then wrapped.  BC is kept.
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  0490'                         MKSHFT:
  0490'   32 2F03'              	STA	MKTYP
  0493'   3A 2F08'              	LDA	MKHOLD		; a yank that could not copy takes its lines out
  0496'   B7                    	ORA	A		;   and puts them back unchanged (YKGO): the text
  0497'   C0                    	RNZ			;   every mark points into is still there
  0498'   3A 0000*              	LDA	UNDRPL
  049B'   B7                    	ORA	A
  049C'   C2 04A6'              	JNZ	MKS_GO		; 'u' replaying: not a new change
  049F'   3A 0000*              	LDA	UNDNEW		; the first edit of a new change (UNDCHG calls
  04A2'   B7                    	ORA	A		;   here BEFORE it claims the change): the marks
  04A3'   C4 0440'              	CNZ	MKSNAP		;   as they are now are the ones 'u' puts back
  04A6'                         MKS_GO:
  04A6'   C5                    	PUSH	B
  04A7'   50                    	MOV	D,B
  04A8'   59                    	MOV	E,C
  04A9'   EB                    	XCHG
  04AA'   22 2F01'              	SHLD	MKN		; the edit's length
  04AD'   D5                    	PUSH	D		; ... and its offset
  04AE'   CD 0000*              	CALL	CUROFF
  04B1'   D1                    	POP	D
  04B2'   CD 0000*              	CALL	SUBHD
  04B5'   EB                    	XCHG			; DE = how far behind the cursor it is
  04B6'   CD 12E1'              	CALL	CURFP		; A:HL = the cursor's file position
  04B9'   06 00                 	MVI	B,0
  04BB'   CD 12D7'              	CALL	SUB24
  04BE'   22 2EFE'              	SHLD	MKEDIT
  04C1'   32 2F00'              	STA	MKEDIT+2	; where in the file the edit is
  04C4'   21 2EFB'              	LXI	H,MKVAL
  04C7'   11 0000*              	LXI	D,MKTAB
  04CA'   06 03                 	MVI	B,MKMAX
  04CC'                         MKS_LP:
  04CC'   7E                    	MOV	A,M
  04CD'   B7                    	ORA	A
  04CE'   CA 053A'              	JZ	MKS_N0		; that mark is not set
  04D1'   E5                    	PUSH	H
  04D2'   C5                    	PUSH	B
  04D3'   21 2EFE'              	LXI	H,MKEDIT
  04D6'   1A                    	LDAX	D		; the mark's position less the edit's, a byte
  04D7'   96                    	SUB	M		;   at a time (neither INX nor LDAX touch CY)
  04D8'   4F                    	MOV	C,A
  04D9'   13                    	INX	D
  04DA'   23                    	INX	H
  04DB'   1A                    	LDAX	D
  04DC'   9E                    	SBB	M
  04DD'   47                    	MOV	B,A
  04DE'   13                    	INX	D
  04DF'   23                    	INX	H
  04E0'   1A                    	LDAX	D
  04E1'   9E                    	SBB	M		; A:BC = how far past the edit the mark is
  04E2'   DA 0535'              	JC	MKS_PP		; before it: nothing moves
  04E5'   6F                    	MOV	L,A
  04E6'   3A 2F03'              	LDA	MKTYP
  04E9'   3D                    	DCR	A
  04EA'   CA 050F'              	JZ	MKS_IN
                                	;--- a delete: back by its length, or to it if the mark is inside ---
  04ED'   7D                    	MOV	A,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04EE'   2A 2F01'              	LHLD	MKN
  04F1'   B7                    	ORA	A
  04F2'   C2 04FE'              	JNZ	MKS_DL		; 64K or more past it
  04F5'   79                    	MOV	A,C
  04F6'   95                    	SUB	L
  04F7'   78                    	MOV	A,B
  04F8'   9C                    	SBB	H
  04F9'   D2 04FE'              	JNC	MKS_DL		; past the end of what goes
  04FC'   60                    	MOV	H,B
  04FD'   69                    	MOV	L,C		; inside it: close up to the edit
  04FE'                         MKS_DL:
  04FE'   1B                    	DCX	D
  04FF'   1B                    	DCX	D
  0500'   1A                    	LDAX	D
  0501'   95                    	SUB	L
  0502'   12                    	STAX	D
  0503'   13                    	INX	D
  0504'   1A                    	LDAX	D
  0505'   9C                    	SBB	H
  0506'   12                    	STAX	D
  0507'   13                    	INX	D
  0508'   1A                    	LDAX	D
  0509'   DE 00                 	SBI	0
  050B'   12                    	STAX	D
  050C'   C3 0535'              	JMP	MKS_PP
                                	;--- an insert: on by its length ---
  050F'                         MKS_IN:
  050F'   7D                    	MOV	A,L
  0510'   B0                    	ORA	B
  0511'   B1                    	ORA	C
  0512'   C2 0524'              	JNZ	MKS_AD		; the mark is past it
  0515'   2A 0000*              	LHLD	GAPBEG		; AT the mark: only a line end carries it on
  0518'   2B                    	DCX	H
  0519'   7E                    	MOV	A,M		; the last byte that went in
  051A'   FE 0A                 	CPI	LF
  051C'   CA 0524'              	JZ	MKS_AD
  051F'   FE 0D                 	CPI	CR
  0521'   C2 0535'              	JNZ	MKS_PP
  0524'                         MKS_AD:
  0524'   2A 2F01'              	LHLD	MKN
  0527'   1B                    	DCX	D
  0528'   1B                    	DCX	D
  0529'   1A                    	LDAX	D
  052A'   85                    	ADD	L
  052B'   12                    	STAX	D
  052C'   13                    	INX	D
  052D'   1A                    	LDAX	D
  052E'   8C                    	ADC	H
  052F'   12                    	STAX	D
  0530'   13                    	INX	D
  0531'   1A                    	LDAX	D
  0532'   CE 00                 	ACI	0
  0534'   12                    	STAX	D
  0535'                         MKS_PP:
  0535'   C1                    	POP	B
  0536'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  0537'   C3 053C'              	JMP	MKS_NX
  053A'                         MKS_N0:
  053A'   13                    	INX	D
  053B'   13                    	INX	D
  053C'                         MKS_NX:
  053C'   13                    	INX	D
  053D'   13                    	INX	D
  053E'   23                    	INX	H
  053F'   05                    	DCR	B
  0540'   C2 04CC'              	JNZ	MKS_LP
  0543'   C1                    	POP	B
  0544'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  0545'                         VC_UNDO:
  0545'   21 0000               	LXI	H,0
  0548'   22 2E60'              	SHLD	CMDCNT
  054B'   CD 0000*              	CALL	UNDO
  054E'   DA 05D2'              	JC	UNDNO
  0551'   3A 0000*              	LDA	UNDST
  0554'   FE 02                 	CPI	2
  0556'   CC 0461'              	CZ	MKREST		; undone (not redone): the marks go back too
  0559'   2A 0000*              	LHLD	UNDCUR
  055C'   CD 05B8'              	CALL	UCLAMP		; vi never sits on a line terminator
  055F'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0562'   3E 01                 	MVI	A,1
  0564'   32 2E63'              	STA	MODF		; undone past a ':w' still differs from the file
  0567'   CD 09FD'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  056A'   3A 0000*              	LDA	UNDML		; every step on one line, no line end among
  056D'   B7                    	ORA	A		;   them, and the cursor back on that line:
  056E'   C2 0586'              	JNZ	VU_LNS		;   the line is the repaint -- all of it, the
  0571'   2A 0000*              	LHLD	UNDL0		;   cursor need not be where the change began.
  0574'   EB                    	XCHG			;   Anything else, and whole spans moved:
  0575'   2A 0000*              	LHLD	LNDLT		;   repaint rather than guess
  0578'   CD 0000*              	CALL	CMP16
  057B'   C2 088F'              	JNZ	SETFUL
  057E'   3E 01                 	MVI	A,1
  0580'   32 2E69'              	STA	LNALL
  0583'   C3 0858'              	JMP	SETLIN
                                
                                ;VU_LNS -- more than a line changed.  Whole lines put back, the cursor on the
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


                                ; first of them, are rows opened there as a put opens them (R_ILIN; SCDRAW
                                ; wants them at the line the cursor was on or right under it).  One whole
                                ; line taken from under the cursor, a line coming up into its place, is 'dd'
                                ; (R_DLIN).  Anything else is the screen.
  0586'                         VU_LNS:
  0586'   CD 088F'              	CALL	SETFUL
  0589'   2A 0000*              	LHLD	UNDLL0
  058C'   EB                    	XCHG
  058D'   2A 0000*              	LHLD	LNDLT
  0590'   CD 0000*              	CALL	CMP16
  0593'   C0                    	RNZ
  0594'   3A 0000*              	LDA	UNDLC
  0597'   B7                    	ORA	A
  0598'   C8                    	RZ
  0599'   47                    	MOV	B,A
  059A'   3A 0000*              	LDA	UNDLK
  059D'   FE 01                 	CPI	1
  059F'   CA 05B0'              	JZ	VU_IN
  05A2'   FE 02                 	CPI	2
  05A4'   C0                    	RNZ
  05A5'   05                    	DCR	B
  05A6'   C0                    	RNZ
  05A7'   7C                    	MOV	A,H
  05A8'   B5                    	ORA	L
  05A9'   C0                    	RNZ
  05AA'   3E 03                 	MVI	A,R_DLIN
  05AC'   32 2E64'              	STA	RINTENT
  05AF'   C9                    	RET
  05B0'                         VU_IN:
  05B0'   CD 087A'              	CALL	SETILN
  05B3'   78                    	MOV	A,B
  05B4'   32 2E65'              	STA	ILN
  05B7'   C9                    	RET
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  05B8'                         UCLAMP:
  05B8'   E5                    	PUSH	H
  05B9'   CD 191D'              	CALL	CEND		; HL = the line's content end
  05BC'   D1                    	POP	D		; DE = the offset wanted
  05BD'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  05C0'   D2 05C5'              	JNC	UCL_BK
  05C3'   EB                    	XCHG
  05C4'   C9                    	RET
  05C5'                         UCL_BK:
  05C5'   E5                    	PUSH	H		; the content end
  05C6'   EB                    	XCHG			; HL = the offset wanted
  05C7'   CD 066F'              	CALL	BOL
  05CA'   D1                    	POP	D		; DE = the content end, HL = the line's start
  05CB'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  05CE'   EB                    	XCHG			; HL = the content end
  05CF'   C8                    	RZ
  05D0'   2B                    	DCX	H		; ... its last character
  05D1'   C9                    	RET
  05D2'                         UNDNO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  05D2'   3A 0000*              	LDA	UNDWHY
  05D5'   B7                    	ORA	A
  05D6'   CA 05E7'              	JZ	UNDBEL
  05D9'   21 27F1'              	LXI	H,SUNDW		; the change has paged away: say so
  05DC'   FE 01                 	CPI	1
  05DE'   CA 271C'              	JZ	EXERR
  05E1'   21 2813'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  05E4'   C3 271C'              	JMP	EXERR
  05E7'                         UNDBEL:
  05E7'   0E 07                 	MVI	C,BEL
  05E9'   CD 0000*              	CALL	BCONOU
  05EC'   C3 0852'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  05EF'                         DOTGET:
  05EF'   3A 2E92'              	LDA	DOTIX
  05F2'   5F                    	MOV	E,A
  05F3'   3A 2E91'              	LDA	DOTLEN
  05F6'   BB                    	CMP	E
  05F7'   CA 0603'              	JZ	DOTGEF
  05FA'   16 00                 	MVI	D,0
  05FC'   21 0000*              	LXI	H,DOTBUF
  05FF'   19                    	DAD	D
  0600'   7E                    	MOV	A,M
  0601'   B7                    	ORA	A		; CY clear: a key was returned
  0602'   C9                    	RET
  0603'                         DOTGEF:
  0603'   37                    	STC
  0604'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
  0605'                         GOSET:
  0605'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  0608'                         SETGL:
  0608'   CD 1304'              	CALL	ZSAVE
  060B'   21 0000               	LXI	H,0
  060E'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  0611'   E5                    	PUSH	H
  0612'   CD 1317'              	CALL	ZREST
  0615'   E1                    	POP	H
  0616'   E5                    	PUSH	H
  0617'   CD 0776'              	CALL	GBSUB		; HL = bytes to the cursor
  061A'   44                    	MOV	B,H
  061B'   4D                    	MOV	C,L
  061C'   E1                    	POP	H		; HL = the line's start
  061D'   11 0000               	LXI	D,0		; DE = screen column
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  0620'                         SG_LP:
  0620'   78                    	MOV	A,B
  0621'   B1                    	ORA	C
  0622'   CA 0637'              	JZ	SG_CUR
  0625'   7E                    	MOV	A,M
  0626'   23                    	INX	H
  0627'   0B                    	DCX	B
  0628'   E5                    	PUSH	H
  0629'   6B                    	MOV	L,E
  062A'   CD 065C'              	CALL	CWID
  062D'   E1                    	POP	H
  062E'   83                    	ADD	E
  062F'   5F                    	MOV	E,A
  0630'   D2 0620'              	JNC	SG_LP
  0633'   14                    	INR	D
  0634'   C3 0620'              	JMP	SG_LP
  0637'                         SG_CUR:
  0637'   2A 0000*              	LHLD	TXTEND
  063A'   D5                    	PUSH	D
  063B'   EB                    	XCHG
  063C'   2A 0000*              	LHLD	GAPEND
  063F'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  0642'   D1                    	POP	D
  0643'   CA 0657'              	JZ	SG_SET
  0646'   7E                    	MOV	A,M
  0647'   FE 09                 	CPI	TAB
  0649'   C2 0657'              	JNZ	SG_SET
  064C'   6B                    	MOV	L,E
  064D'   CD 065C'              	CALL	CWID
  0650'   3D                    	DCR	A		; the TAB's last column
  0651'   83                    	ADD	E
  0652'   5F                    	MOV	E,A
  0653'   D2 0657'              	JNC	SG_SET
  0656'   14                    	INR	D
  0657'                         SG_SET:
  0657'   EB                    	XCHG
  0658'   22 2E6B'              	SHLD	GOALCOL
  065B'   C9                    	RET
                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  065C'                         CWID:
  065C'   FE 0D                 	CPI	CR
  065E'   CA 066D'              	JZ	CW_0
  0661'   FE 09                 	CPI	TAB
  0663'   3E 01                 	MVI	A,1
  0665'   C0                    	RNZ
  0666'   7D                    	MOV	A,L
  0667'   E6 07                 	ANI	TABWID-1
  0669'   2F                    	CMA
  066A'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  066C'   C9                    	RET
  066D'                         CW_0:
  066D'   AF                    	XRA	A
  066E'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
                                ; The text is read where it lies, either side of the gap; keeps BC.
  066F'                         BOL:
  066F'   C5                    	PUSH	B
  0670'   E5                    	PUSH	H
  0671'   CD 0000*              	CALL	CUROFF
  0674'   D1                    	POP	D		; DE = off, HL = the bytes before the gap
  0675'   CD 0000*              	CALL	CMP16
  0678'   DA 069B'              	JC	BOL_B
  067B'   CA 069B'              	JZ	BOL_B
  067E'   D5                    	PUSH	D
  067F'   EB                    	XCHG
  0680'   CD 0000*              	CALL	SUBHD
  0683'   44                    	MOV	B,H
  0684'   4D                    	MOV	C,L		; BC = how far past the gap it is
  0685'   2A 0000*              	LHLD	GAPEND
  0688'   09                    	DAD	B
  0689'   D1                    	POP	D
  068A'                         BOL_A:
  068A'   78                    	MOV	A,B
  068B'   B1                    	ORA	C
  068C'   CA 069B'              	JZ	BOL_B		; back at the gap: the rest is before it
  068F'   2B                    	DCX	H
  0690'   7E                    	MOV	A,M
  0691'   FE 0A                 	CPI	LF
  0693'   CA 06AF'              	JZ	BOL_X
  0696'   1B                    	DCX	D
  0697'   0B                    	DCX	B
  0698'   C3 068A'              	JMP	BOL_A
  069B'                         BOL_B:
  069B'   2A 0000*              	LHLD	TXTBEG
  069E'   19                    	DAD	D
  069F'                         BOL_C:
  069F'   7A                    	MOV	A,D
  06A0'   B3                    	ORA	E
  06A1'   CA 06AF'              	JZ	BOL_X		; at 0
  06A4'   2B                    	DCX	H
  06A5'   7E                    	MOV	A,M
  06A6'   FE 0A                 	CPI	LF
  06A8'   CA 06AF'              	JZ	BOL_X
  06AB'   1B                    	DCX	D
  06AC'   C3 069F'              	JMP	BOL_C
  06AF'                         BOL_X:
  06AF'   EB                    	XCHG
  06B0'   C1                    	POP	B
  06B1'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
                                ; Read the same way; keeps BC.
  06B2'                         EOLNL:
  06B2'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06B3'   E5                    	PUSH	H
  06B4'   CD 0000*              	CALL	CUROFF
  06B7'   D1                    	POP	D		; DE = off, HL = the bytes before the gap
  06B8'   CD 0000*              	CALL	CMP16
  06BB'   D2 06D9'              	JNC	ENL_A
  06BE'   2A 0000*              	LHLD	GAPBEG
  06C1'   44                    	MOV	B,H
  06C2'   4D                    	MOV	C,L
  06C3'   2A 0000*              	LHLD	TXTBEG
  06C6'   19                    	DAD	D
  06C7'                         ENL_B:
  06C7'   7D                    	MOV	A,L
  06C8'   91                    	SUB	C
  06C9'   7C                    	MOV	A,H
  06CA'   98                    	SBB	B
  06CB'   D2 06E7'              	JNC	ENL_G		; at the gap: on from its far side
  06CE'   7E                    	MOV	A,M
  06CF'   FE 0A                 	CPI	LF
  06D1'   CA 0703'              	JZ	ENL_X
  06D4'   23                    	INX	H
  06D5'   13                    	INX	D
  06D6'   C3 06C7'              	JMP	ENL_B
  06D9'                         ENL_A:
  06D9'   D5                    	PUSH	D
  06DA'   EB                    	XCHG
  06DB'   CD 0000*              	CALL	SUBHD
  06DE'   EB                    	XCHG			; DE = how far past the gap it is
  06DF'   2A 0000*              	LHLD	GAPEND
  06E2'   19                    	DAD	D
  06E3'   D1                    	POP	D
  06E4'   C3 06EA'              	JMP	ENL_S
  06E7'                         ENL_G:
  06E7'   2A 0000*              	LHLD	GAPEND
  06EA'                         ENL_S:
  06EA'   E5                    	PUSH	H
  06EB'   2A 0000*              	LHLD	TXTEND
  06EE'   44                    	MOV	B,H
  06EF'   4D                    	MOV	C,L
  06F0'   E1                    	POP	H
  06F1'                         ENL_C:
  06F1'   7D                    	MOV	A,L
  06F2'   91                    	SUB	C
  06F3'   7C                    	MOV	A,H
  06F4'   98                    	SBB	B
  06F5'   D2 0703'              	JNC	ENL_X		; the end of the text
  06F8'   7E                    	MOV	A,M
  06F9'   FE 0A                 	CPI	LF
  06FB'   CA 0703'              	JZ	ENL_X
  06FE'   23                    	INX	H
  06FF'   13                    	INX	D
  0700'   C3 06F1'              	JMP	ENL_C
  0703'                         ENL_X:
  0703'   EB                    	XCHG
  0704'   C1                    	POP	B
  0705'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  0706'                         NLSTART:
  0706'   CD 06B2'              	CALL	EOLNL
  0709'   E5                    	PUSH	H
  070A'   CD 0000*              	CALL	LOGLEN
  070D'   D1                    	POP	D		; DE = eol result
  070E'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  0711'   C8                    	RZ			; no next line: HL = LOGLEN
  0712'   EB                    	XCHG			; HL = eol
  0713'   23                    	INX	H
  0714'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  0715'                         EOLC:
  0715'   E5                    	PUSH	H
  0716'   CD 06B2'              	CALL	EOLNL
  0719'   22 2EB6'              	SHLD	WKTERM
  071C'   E1                    	POP	H
  071D'   CD 066F'              	CALL	BOL
  0720'   22 2EB8'              	SHLD	WKBOL
  0723'   2A 2EB6'              	LHLD	WKTERM
  0726'   EB                    	XCHG			; DE = term
  0727'   2A 2EB8'              	LHLD	WKBOL
  072A'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  072D'   CA 074C'              	JZ	EOLC_MT
  0730'   EB                    	XCHG			; HL = term
  0731'   2B                    	DCX	H		; term-1
  0732'   E5                    	PUSH	H
  0733'   CD 0000*              	CALL	CHARAT
  0736'   E1                    	POP	H		; HL = term-1
  0737'   FE 0D                 	CPI	CR
  0739'   CA 073F'              	JZ	EOLC_CR		; content ends at term-1
  073C'   C3 0740'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  073F'                         EOLC_CR:
  073F'   2B                    	DCX	H		; last = (term-1) - 1
  0740'                         EOLC_LS:
  0740'   EB                    	XCHG			; DE = last
  0741'   2A 2EB8'              	LHLD	WKBOL
  0744'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  0747'   DA 074C'              	JC	EOLC_MT
  074A'   EB                    	XCHG			; HL = last
  074B'   C9                    	RET
  074C'                         EOLC_MT:
  074C'   2A 2EB8'              	LHLD	WKBOL
  074F'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  0750'                         COL:
  0750'   E5                    	PUSH	H
  0751'   CD 066F'              	CALL	BOL
  0754'   D1                    	POP	D		; DE = off
  0755'   EB                    	XCHG			; HL = off, DE = bol
  0756'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  0759'                         ATENDQ:
  0759'   CD 0000*              	CALL	CUROFF
  075C'   E5                    	PUSH	H
  075D'   CD 0000*              	CALL	LOGLEN
  0760'   D1                    	POP	D		; DE = cur
  0761'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0764'                         CURCHR:
  0764'   CD 0000*              	CALL	CUROFF
  0767'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  076A'                         MOVCNT:
  076A'   CD 0852'              	CALL	SETMOV
  076D'   C3 077D'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  0770'                         CNTOFF:
  0770'   CD 077D'              	CALL	GETCNT
  0773'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  0776'                         GBSUB:
  0776'   EB                    	XCHG
  0777'   2A 0000*              	LHLD	GAPBEG
  077A'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  077D'                         GETCNT:
  077D'   2A 2E60'              	LHLD	CMDCNT
  0780'   7C                    	MOV	A,H
  0781'   B5                    	ORA	L
  0782'   C2 0789'              	JNZ	GC_HAVE
  0785'   21 0001               	LXI	H,1
  0788'   C9                    	RET
  0789'                         GC_HAVE:
  0789'   E5                    	PUSH	H
  078A'   21 0000               	LXI	H,0
  078D'   22 2E60'              	SHLD	CMDCNT
  0790'   E1                    	POP	H
  0791'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for an ESC break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  0792'                         CNTTST:				; WM 1175
  0792'   3A 2F1F'              	LDA	BRKARM
  0795'   B7                    	ORA	A
  0796'   C4 07C0'              	CNZ	BRKTST		; an ESC spends the count: every loop stops here
  0799'   E5                    	PUSH	H
  079A'   2A 2E60'              	LHLD	CMDCNT
  079D'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  07A0'   B4                    	ORA	H
  07A1'   B5                    	ORA	L
  07A2'   E1                    	POP	H
  07A3'   C3 0000*              	JMP	POLLBRK
                                
                                ;============================================================
                                ; ESC -- abandon a search or a long move.
                                ;
                                ; Every loop that pages asks CNTTST whether to go on, so that is where an ESC is
                                ; looked for: it zeroes the count, and the loop ends the way it ends when the
                                ; count runs out.  Nothing is half done, because the commands that can be
                                ; stopped change nothing -- BRKON arms the test only with no operator pending,
                                ; and only 'G' 'gg' the mark jumps and the searches call it.  A 'dd' count, a
                                ; ':s', a put or a write asks the same CNTTST and is never stopped.
                                ;
                                ; The command then goes back to where it started (BRKBAK), as a search that
                                ; found nothing does: the screen was not repainted, so it is already right.
                                ; Going back pages, and that is not stopped by a second ESC.
                                ;============================================================
                                
                                ;BRKON -- a command that may page a long way is starting: keep the place it
                                ; started from (the cursor's position in the file, and LNDLT for its row), and
                                ; arm the ESC test unless an operator is waiting for this motion.
  07A6'                         BRKON:
  07A6'   21 2F1A'              	LXI	H,SOFF
  07A9'   CD 0429'              	CALL	FPSTO
  07AC'   2A 0000*              	LHLD	LNDLT
  07AF'   22 2F1D'              	SHLD	SLDLT
  07B2'   AF                    	XRA	A
  07B3'   32 2F20'              	STA	BRKHIT
  07B6'   3A 2E98'              	LDA	PSAVE
  07B9'   B7                    	ORA	A
  07BA'   C0                    	RNZ			; 'dG' changes text: it runs to its end
  07BB'   3C                    	INR	A
  07BC'   32 2F1F'              	STA	BRKARM
  07BF'   C9                    	RET
                                
                                ;BRKTST -- CNTTST's question while armed.  Keeps BC, DE, HL.  The ESC is
                                ; answered on the bottom row at once: the way back pages, and that can take
                                ; as long again as the command had run, with nothing else to show for it.
                                ; BRKBAK's 'Interrupted' replaces it when the cursor is back.
  07C0'                         BRKTST:
  07C0'   C5                    	PUSH	B
  07C1'   D5                    	PUSH	D
  07C2'   E5                    	PUSH	H
  07C3'   CD 0000*              	CALL	KBBRK
  07C6'   CA 07DF'              	JZ	BT_NO
  07C9'   32 2F20'              	STA	BRKHIT		; (A = FFH)
  07CC'   21 27C6'              	LXI	H,SINTG
  07CF'   CD 0000*              	CALL	EXMSG
  07D2'   AF                    	XRA	A
  07D3'   32 2F1F'              	STA	BRKARM		; the way back is not stopped in its turn
  07D6'   32 0000*              	STA	AUXCNT
  07D9'   21 0000               	LXI	H,0
  07DC'   22 2E60'              	SHLD	CMDCNT
  07DF'                         BT_NO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07DF'   E1                    	POP	H
  07E0'   D1                    	POP	D
  07E1'   C1                    	POP	B
  07E2'   C9                    	RET
                                
                                ;BRKOFF -- the move is over: disarm.  NOTE: falls into BRKQ.
  07E3'                         BRKOFF:
  07E3'   AF                    	XRA	A
  07E4'   32 2F1F'              	STA	BRKARM
                                ;BRKQ -- CY iff an ESC stopped it.
  07E7'                         BRKQ:
  07E7'   3A 2F20'              	LDA	BRKHIT
  07EA'   B7                    	ORA	A
  07EB'   C8                    	RZ
  07EC'   37                    	STC
  07ED'   C9                    	RET
                                
                                ;RSTPL -- back to the place BRKON kept, on the row it was on.
  07EE'                         RSTPL:
  07EE'   21 2F1A'              	LXI	H,SOFF
  07F1'   CD 03D0'              	CALL	BACKTO
  07F4'   2A 2F1D'              	LHLD	SLDLT
  07F7'   22 0000*              	SHLD	LNDLT
  07FA'   C9                    	RET
                                
                                ;BRKBAK -- stopped: back to the start, drop whatever was typed meanwhile (it
                                ; was meant for a result that is not coming), and say so.  CY, as EXERR.
  07FB'                         BRKBAK:
  07FB'   CD 07EE'              	CALL	RSTPL
  07FE'   CD 0000*              	CALL	KBFLSH
  0801'   21 27BA'              	LXI	H,SINTR
  0804'   C3 271C'              	JMP	EXERR
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  0807'                         CLASSF:
  0807'   47                    	MOV	B,A
  0808'   FE 20                 	CPI	' '
  080A'   CA 084A'              	JZ	CLS0
  080D'   FE 09                 	CPI	TAB
  080F'   CA 084A'              	JZ	CLS0
  0812'   FE 0A                 	CPI	LF
  0814'   CA 084A'              	JZ	CLS0
  0817'   FE 0D                 	CPI	CR
  0819'   CA 084A'              	JZ	CLS0
  081C'   3A 2E6D'              	LDA	WBIG
  081F'   B7                    	ORA	A
  0820'   C2 084C'              	JNZ	CLS1
  0823'   78                    	MOV	A,B
  0824'   FE 5F                 	CPI	'_'
  0826'   CA 084C'              	JZ	CLS1
  0829'   FE 30                 	CPI	'0'
  082B'   DA 084F'              	JC	CLS2
  082E'   FE 3A                 	CPI	'9'+1
  0830'   DA 084C'              	JC	CLS1
  0833'   FE 41                 	CPI	'A'
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  0835'   DA 084F'              	JC	CLS2
  0838'   FE 5B                 	CPI	'Z'+1
  083A'   DA 084C'              	JC	CLS1
  083D'   FE 61                 	CPI	'a'
  083F'   DA 084F'              	JC	CLS2
  0842'   FE 7B                 	CPI	'z'+1
  0844'   DA 084C'              	JC	CLS1
  0847'   C3 084F'              	JMP	CLS2
  084A'   AF                    CLS0:	XRA	A
  084B'   C9                    	RET
  084C'   3E 01                 CLS1:	MVI	A,1
  084E'   C9                    	RET
  084F'   3E 02                 CLS2:	MVI	A,2
  0851'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  0852'                         SETMOV:
  0852'   3E 01                 	MVI	A,R_MOVE
  0854'   32 2E64'              	STA	RINTENT
  0857'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  0858'                         SETLIN:
  0858'   3E 02                 	MVI	A,R_LINE
  085A'   32 2E64'              	STA	RINTENT
  085D'   C9                    	RET
                                
                                ;SETCEL -- one cell of the cursor's row was written over and nothing else
                                ; changed: the char alone is the paint (R_ICH with no cell opened), provided
                                ; the char that was there (A) and the one that is (VRCH) are each one cell
                                ; wide.  B = ICHAPP's value: 1 the cursor went past the char, 2 it is on it.
  085E'                         SETCEL:
  085E'   CD 0873'              	CALL	PLAINQ
  0861'   D0                    	RNC
  0862'   3A 2EBB'              	LDA	VRCH
  0865'   CD 0873'              	CALL	PLAINQ
  0868'   D0                    	RNC
  0869'   78                    	MOV	A,B
  086A'   32 2E66'              	STA	ICHAPP
  086D'   3E 04                 	MVI	A,R_ICH
  086F'   32 2E64'              	STA	RINTENT
  0872'   C9                    	RET
                                
                                ;PLAINQ -- CY iff the char in A takes one cell: printable ASCII.  Keeps all
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


                                ; but the flags.
  0873'                         PLAINQ:
  0873'   FE 20                 	CPI	' '
  0875'   3F                    	CMC
  0876'   D0                    	RNC
  0877'   FE 7F                 	CPI	DEL
  0879'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  087A'                         SETILN:
  087A'   3E 01                 	MVI	A,1
  087C'   32 2E65'              	STA	ILN		; one line, unless a put overwrites it below
  087F'   3E 05                 	MVI	A,R_ILIN
  0881'   32 2E64'              	STA	RINTENT
  0884'   AF                    	XRA	A
  0885'   32 2E6A'              	STA	ILABOV		; the row above the opened ones is untouched
  0888'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  0889'                         SETJON:
  0889'   3E 06                 	MVI	A,R_JOIN
  088B'   32 2E64'              	STA	RINTENT
  088E'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  088F'                         SETFUL:
  088F'   3E 00                 	MVI	A,R_FULL
  0891'   32 2E64'              	STA	RINTENT
  0894'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB (or any control char) occurs from the cursor to the
                                ; end of its line, else 0; TTI = its offset when there is one.
                                ; The tail is read where it lies, after the gap.  Keeps BC.
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  0895'                         TAILTAB:
  0895'   C5                    	PUSH	B
  0896'   CD 0000*              	CALL	CUROFF
  0899'   E5                    	PUSH	H
  089A'   2A 0000*              	LHLD	TXTEND
  089D'   44                    	MOV	B,H
  089E'   4D                    	MOV	C,L
  089F'   2A 0000*              	LHLD	GAPEND
  08A2'   D1                    	POP	D		; DE = the offset of the byte at HL
  08A3'                         TT_LP:
  08A3'   7D                    	MOV	A,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  08A4'   91                    	SUB	C
  08A5'   7C                    	MOV	A,H
  08A6'   98                    	SBB	B
  08A7'   D2 08C7'              	JNC	TT_NO		; reached end of text -> no tab
  08AA'   7E                    	MOV	A,M
  08AB'   FE 0A                 	CPI	LF
  08AD'   CA 08C7'              	JZ	TT_NO		; end of line -> no tab
  08B0'   FE 0D                 	CPI	CR
  08B2'   CA 08BA'              	JZ	TT_NX		; (the line end's own)
  08B5'   FE 20                 	CPI	' '
  08B7'   DA 08BF'              	JC	TT_YES
  08BA'                         TT_NX:
  08BA'   23                    	INX	H
  08BB'   13                    	INX	D
  08BC'   C3 08A3'              	JMP	TT_LP
  08BF'                         TT_YES:
  08BF'   EB                    	XCHG
  08C0'   22 2EB2'              	SHLD	TTI
  08C3'   C1                    	POP	B
  08C4'   3E 01                 	MVI	A,1
  08C6'   C9                    	RET
  08C7'                         TT_NO:
  08C7'   C1                    	POP	B
  08C8'   AF                    	XRA	A
  08C9'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  08CA'                         VC_H:
  08CA'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  08CD'   22 2EB0'              	SHLD	CNTV
  08D0'                         VCH_LP:
  08D0'   2A 2EB0'              	LHLD	CNTV
  08D3'   7C                    	MOV	A,H
  08D4'   B5                    	ORA	L
  08D5'   C8                    	RZ
  08D6'   2B                    	DCX	H
  08D7'   22 2EB0'              	SHLD	CNTV
  08DA'   CD 08E0'              	CALL	HSTEP
  08DD'   C3 08D0'              	JMP	VCH_LP
  08E0'                         HSTEP:
  08E0'   CD 0000*              	CALL	CUROFF		; HL = cur
  08E3'   7C                    	MOV	A,H
  08E4'   B5                    	ORA	L
  08E5'   C8                    	RZ			; at 0
  08E6'   E5                    	PUSH	H
  08E7'   CD 066F'              	CALL	BOL		; HL = bol
  08EA'   D1                    	POP	D		; DE = cur
  08EB'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  08EE'   C8                    	RZ			; at BOL, cannot go left
  08EF'   EB                    	XCHG			; HL = cur
  08F0'   2B                    	DCX	H
  08F1'   C3 0605'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  08F4'                         VC_L:
  08F4'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  08F7'   22 2EB0'              	SHLD	CNTV
  08FA'                         VCL_LP:
  08FA'   2A 2EB0'              	LHLD	CNTV
  08FD'   7C                    	MOV	A,H
  08FE'   B5                    	ORA	L
  08FF'   C8                    	RZ
  0900'   2B                    	DCX	H
  0901'   22 2EB0'              	SHLD	CNTV
  0904'   CD 090A'              	CALL	LSTEP
  0907'   C3 08FA'              	JMP	VCL_LP
  090A'                         LSTEP:
  090A'   CD 0000*              	CALL	CUROFF		; HL = cur
  090D'   E5                    	PUSH	H
  090E'   CD 0715'              	CALL	EOLC		; HL = eolc
  0911'   D1                    	POP	D		; DE = cur
  0912'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  0915'   D2 091D'              	JNC	LS_NO		; cur >= eolc, cannot go right
  0918'   EB                    	XCHG			; HL = cur
  0919'   23                    	INX	H
  091A'   C3 0605'              	JMP	GOSET
  091D'                         LS_NO:				; on the line's last char.  An operator waiting on
  091D'   CD 0CE9'              	CALL	EMPTY		;   this 'l' takes that char too (vim makes the
  0920'   C8                    	RZ			;   motion inclusive when it falls short), which
  0921'   3E 01                 	MVI	A,1		;   is what WPULL tells OPA_EX: 'dl' there is 'x',
  0923'   32 2E6E'              	STA	WPULL		;   and 'd3l' two from the end takes both.  An
  0926'   C9                    	RET			;   empty line has no char to take
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  0927'                         VC_0:
  0927'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  092A'   CD 0934'              	CALL	LNSTRT
  092D'   21 0000               	LXI	H,0
  0930'   22 2E6B'              	SHLD	GOALCOL
  0933'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  0934'                         LNSTRT:
  0934'   CD 1304'              	CALL	ZSAVE
  0937'   21 0000               	LXI	H,0
  093A'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  093D'   E5                    	PUSH	H
  093E'   CD 1317'              	CALL	ZREST
  0941'   E1                    	POP	H
  0942'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  0945'                         VC_CRT:
  0945'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  0948'   C3 094B'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  094B'                         FNBLNK:
  094B'   CD 0934'              	CALL	LNSTRT
  094E'   CD 0000*              	CALL	RGET0
  0951'   11 0000               	LXI	D,0		; DE = blanks skipped
  0954'                         FN_LP:
  0954'   CD 0000*              	CALL	RDGET
  0957'   DA 097A'              	JC	FN_GO		; the end of the file
  095A'   FE 20                 	CPI	' '
  095C'   CA 0964'              	JZ	FN_WH
  095F'   FE 09                 	CPI	TAB
  0961'   C2 097A'              	JNZ	FN_GO		; a non-blank, or the line's end
  0964'                         FN_WH:
  0964'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  0967'   DA 097A'              	JC	FN_GO
  096A'   FE 0D                 	CPI	CR
  096C'   CA 097A'              	JZ	FN_GO
  096F'   FE 0A                 	CPI	LF
  0971'   CA 097A'              	JZ	FN_GO
  0974'   2B                    	DCX	H		; not yet: read that char again
  0975'   03                    	INX	B
  0976'   13                    	INX	D
  0977'   C3 0954'              	JMP	FN_LP
  097A'                         FN_GO:
  097A'   D5                    	PUSH	D
  097B'   CD 0000*              	CALL	CUROFF
  097E'   D1                    	POP	D
  097F'   19                    	DAD	D
  0980'   C3 0605'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  0983'                         VC_EOL:
  0983'   CD 0852'              	CALL	SETMOV
  0986'   21 FFFF               	LXI	H,0FFFFH
  0989'   22 2E6B'              	SHLD	GOALCOL
  098C'   CD 077D'              	CALL	GETCNT
  098F'   2B                    	DCX	H		; count-1
  0990'   7C                    	MOV	A,H
  0991'   B5                    	ORA	L
  0992'   CA 09A1'              	JZ	VEOL_0
  0995'   E5                    	PUSH	H
  0996'   CD 09B6'              	CALL	ONLAST
  0999'   E1                    	POP	H
  099A'   D8                    	RC			; the last line: no move (vim)
  099B'   CD 0A06'              	CALL	JCORE
  099E'   C3 0B55'              	JMP	JKLAND
  09A1'                         VEOL_0:
  09A1'   CD 0934'              	CALL	LNSTRT
  09A4'   C3 0B55'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  09A7'                         VC_CR:
  09A7'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  09AA'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  09AB'   CD 09B6'              	CALL	ONLAST
  09AE'   E1                    	POP	H
  09AF'   D8                    	RC
  09B0'   CD 0A06'              	CALL	JCORE
  09B3'   C3 094B'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  09B6'                         ONLAST:
  09B6'   CD 0000*              	CALL	RGET0
  09B9'                         OL_LP:
  09B9'   CD 0000*              	CALL	RDGET
  09BC'   D8                    	RC			; the file ends on this line
  09BD'   FE 0A                 	CPI	LF
  09BF'   C2 09B9'              	JNZ	OL_LP
  09C2'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  09C5'                         VC_J:
  09C5'   CD 0852'              	CALL	SETMOV
  09C8'   CD 09F0'              	CALL	GLCHK		; the goal column, from the cursor if stale
  09CB'   CD 077D'              	CALL	GETCNT		; HL = count
  09CE'   CD 0A06'              	CALL	JCORE
  09D1'   CD 09E9'              	CALL	JKDRP
  09D4'   C3 0B55'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  09D7'                         VC_K:
  09D7'   CD 0852'              	CALL	SETMOV
  09DA'   CD 09F0'              	CALL	GLCHK
  09DD'   CD 077D'              	CALL	GETCNT
  09E0'   CD 0AA3'              	CALL	KCORE
  09E3'   CD 09E9'              	CALL	JKDRP
  09E6'   C3 0B55'              	JMP	JKLAND
                                
                                ;JKDRP -- DE = the lines JCORE / KCORE moved.  None -- 'j' on the last line,
                                ; 'k' on the first -- and the motion has failed: an operator waiting on it is
                                ; dropped, as vim drops it, where a line span that starts and ends on one line
                                ; would take that line ('dj' on the last line deleted it).  A count that runs
                                ; out of lines short has still moved, and its operator stands.  It is asked
                                ; here and not in the cores: 'dH' on the top row moves no lines either, and
                                ; takes its line.
  09E9'                         JKDRP:
  09E9'   7A                    	MOV	A,D
  09EA'   B3                    	ORA	E
  09EB'   C0                    	RNZ
  09EC'   32 2E98'              	STA	PSAVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  09EF'   C9                    	RET
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  09F0'                         GLCHK:
  09F0'   2A 2E6B'              	LHLD	GOALCOL
  09F3'   7C                    	MOV	A,H
  09F4'   3C                    	INR	A
  09F5'   C0                    	RNZ
  09F6'   7D                    	MOV	A,L
  09F7'   FE FE                 	CPI	0FEH
  09F9'   C0                    	RNZ
  09FA'   C3 0608'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  09FD'                         GLSTAL:
  09FD'   E5                    	PUSH	H
  09FE'   21 FFFE               	LXI	H,0FFFEH
  0A01'   22 2E6B'              	SHLD	GOALCOL
  0A04'   E1                    	POP	H
  0A05'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  0A06'                         JCORE:
  0A06'   7C                    	MOV	A,H
  0A07'   B5                    	ORA	L
  0A08'   C8                    	RZ
  0A09'   22 2E7C'              	SHLD	JKCNT
  0A0C'   CD 0E18'              	CALL	CURRW		; limit = lines under the cursor's + NEDIT + 2:
  0A0F'   47                    	MOV	B,A		;   enough for LYFAR to know it for far off
  0A10'   3A 0000*              	LDA	NEDIT
  0A13'   3C                    	INR	A
  0A14'   90                    	SUB	B
  0A15'   5F                    	MOV	E,A
  0A16'   16 00                 	MVI	D,0
  0A18'   3A 0000*              	LDA	NEDIT
  0A1B'   6F                    	MOV	L,A
  0A1C'   26 00                 	MVI	H,0
  0A1E'   19                    	DAD	D
  0A1F'   EB                    	XCHG			; DE = limit
  0A20'   2A 2E7C'              	LHLD	JKCNT
  0A23'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0A26'   D2 0A2A'              	JNC	JC_N
  0A29'   EB                    	XCHG			; HL = limit
  0A2A'                         JC_N:
  0A2A'   22 2E7E'              	SHLD	JKN		; N = min(count, limit)
  0A2D'   EB                    	XCHG			; DE = LFs to find
  0A2E'   CD 0000*              	CALL	RGET0
  0A31'                         JC_SC:
  0A31'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0A34'   DA 0A53'              	JC	JC_EOF
  0A37'   32 2E85'              	STA	JKLST
  0A3A'   FE 0A                 	CPI	LF
  0A3C'   C2 0A31'              	JNZ	JC_SC
  0A3F'   1B                    	DCX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0A40'   7A                    	MOV	A,D
  0A41'   B3                    	ORA	E
  0A42'   C2 0A31'              	JNZ	JC_SC
  0A45'   2A 2E7C'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  0A48'   22 2E80'              	SHLD	JKMOV		;   one if the last LF found ends the file
  0A4B'   3E 01                 	MVI	A,1
  0A4D'   32 2E84'              	STA	JKPHN
  0A50'   C3 0A6E'              	JMP	JC_MV
  0A53'                         JC_EOF:
  0A53'   2A 2E7E'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  0A56'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  0A59'   7C                    	MOV	A,H
  0A5A'   B5                    	ORA	L
  0A5B'   CA 0A67'              	JZ	JC_AV
  0A5E'   3A 2E85'              	LDA	JKLST
  0A61'   FE 0A                 	CPI	LF
  0A63'   C2 0A67'              	JNZ	JC_AV
  0A66'   2B                    	DCX	H
  0A67'                         JC_AV:
  0A67'   22 2E80'              	SHLD	JKMOV
  0A6A'   AF                    	XRA	A
  0A6B'   32 2E84'              	STA	JKPHN
  0A6E'                         JC_MV:
  0A6E'   2A 2E7C'              	LHLD	JKCNT
  0A71'   AF                    	XRA	A
  0A72'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  0A75'   CD 0B34'              	CALL	ATEOF
  0A78'   D2 0A8C'              	JNC	JC_DN
  0A7B'   CD 0B3A'              	CALL	LASTLN		; ran past the last line: back onto it
  0A7E'   3A 2E84'              	LDA	JKPHN
  0A81'   B7                    	ORA	A
  0A82'   CA 0A8C'              	JZ	JC_DN
  0A85'   2A 2E80'              	LHLD	JKMOV
  0A88'   2B                    	DCX	H
  0A89'   22 2E80'              	SHLD	JKMOV
  0A8C'                         JC_DN:
  0A8C'   2A 2E7E'              	LHLD	JKN		; LNDLT += min(moved, N)
  0A8F'   EB                    	XCHG
  0A90'   2A 2E80'              	LHLD	JKMOV
  0A93'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  0A96'   D2 0A9A'              	JNC	JC_AD
  0A99'   EB                    	XCHG
  0A9A'                         JC_AD:
  0A9A'   EB                    	XCHG			; DE = lines moved
  0A9B'   2A 0000*              	LHLD	LNDLT
  0A9E'   19                    	DAD	D
  0A9F'   22 0000*              	SHLD	LNDLT
  0AA2'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  0AA3'                         KCORE:
  0AA3'   7C                    	MOV	A,H
  0AA4'   B5                    	ORA	L
  0AA5'   C8                    	RZ
  0AA6'   22 2E7C'              	SHLD	JKCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0AA9'   CD 0E18'              	CALL	CURRW		; limit = row + NEDIT
  0AAC'   5F                    	MOV	E,A
  0AAD'   16 00                 	MVI	D,0
  0AAF'   3A 0000*              	LDA	NEDIT
  0AB2'   6F                    	MOV	L,A
  0AB3'   26 00                 	MVI	H,0
  0AB5'   19                    	DAD	D
  0AB6'   EB                    	XCHG			; DE = limit
  0AB7'   2A 2E7C'              	LHLD	JKCNT
  0ABA'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0ABD'   D2 0AC1'              	JNC	KC_N
  0AC0'   EB                    	XCHG			; HL = limit
  0AC1'                         KC_N:
  0AC1'   22 2E7E'              	SHLD	JKN		; N = min(count, limit)
  0AC4'   EB                    	XCHG			; DE = LFs to find
  0AC5'   21 0000               	LXI	H,0
  0AC8'   22 2E82'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  0ACB'                         KC_ED:
  0ACB'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0ACC'   2A 2E82'              	LHLD	JKBK
  0ACF'   CD 0776'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0AD2'   E5                    	PUSH	H
  0AD3'   EB                    	XCHG
  0AD4'   2A 0000*              	LHLD	TXTBEG
  0AD7'   EB                    	XCHG
  0AD8'   CD 0000*              	CALL	SUBHD
  0ADB'   44                    	MOV	B,H
  0ADC'   4D                    	MOV	C,L
  0ADD'   E1                    	POP	H
  0ADE'   D1                    	POP	D
  0ADF'                         KC_SC:
  0ADF'   78                    	MOV	A,B
  0AE0'   B1                    	ORA	C
  0AE1'   CA 0AF8'              	JZ	KC_TB
  0AE4'   2B                    	DCX	H
  0AE5'   0B                    	DCX	B
  0AE6'   7E                    	MOV	A,M
  0AE7'   FE 0A                 	CPI	LF
  0AE9'   C2 0ADF'              	JNZ	KC_SC
  0AEC'   1B                    	DCX	D
  0AED'   7A                    	MOV	A,D
  0AEE'   B3                    	ORA	E
  0AEF'   C2 0ADF'              	JNZ	KC_SC
  0AF2'   2A 2E7C'              	LHLD	JKCNT		; N lines above: the move is count lines
  0AF5'   C3 0B18'              	JMP	KC_MV
  0AF8'                         KC_TB:
  0AF8'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0AF9'   CD 0776'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0AFC'   22 2E82'              	SHLD	JKBK
  0AFF'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0B02'   7C                    	MOV	A,H
  0B03'   B5                    	ORA	L
  0B04'   CA 0B11'              	JZ	KC_B0
  0B07'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  0B0A'   D1                    	POP	D
  0B0B'   DA 0B12'              	JC	KC_BOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0B0E'   C3 0ACB'              	JMP	KC_ED
  0B11'                         KC_B0:
  0B11'   D1                    	POP	D
  0B12'                         KC_BOF:
  0B12'   2A 2E7E'              	LHLD	JKN		; moved = LFs found
  0B15'   CD 0000*              	CALL	SUBHD
  0B18'                         KC_MV:
  0B18'   E5                    	PUSH	H
  0B19'   2A 2E7C'              	LHLD	JKCNT
  0B1C'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0B1F'   D1                    	POP	D		; DE = moved
  0B20'   2A 2E7E'              	LHLD	JKN
  0B23'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0B26'   DA 0B2A'              	JC	KC_AD
  0B29'   EB                    	XCHG			; DE = N
  0B2A'                         KC_AD:
  0B2A'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0B2D'   CD 0000*              	CALL	SUBHD
  0B30'   22 0000*              	SHLD	LNDLT
  0B33'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0B34'                         ATEOF:
  0B34'   CD 0000*              	CALL	RGET0
  0B37'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0B3A'                         LASTLN:
  0B3A'   2A 0000*              	LHLD	GAPBEG
  0B3D'   EB                    	XCHG
  0B3E'   2A 0000*              	LHLD	TXTBEG
  0B41'   CD 0000*              	CALL	CMP16
  0B44'   21 0000               	LXI	H,0
  0B47'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0B4A'   1B                    	DCX	D
  0B4B'   1A                    	LDAX	D
  0B4C'   FE 0A                 	CPI	LF
  0B4E'   C2 0000*              	JNZ	SETBWD
  0B51'   23                    	INX	H
  0B52'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0B55'                         JKLAND:
  0B55'   21 0000               	LXI	H,0
  0B58'   22 2E86'              	SHLD	JKVC		; screen column
  0B5B'   2B                    	DCX	H
  0B5C'   22 2E88'              	SHLD	JKLS		; last content char: none yet
  0B5F'   CD 0000*              	CALL	RGET0
  0B62'   11 0000               	LXI	D,0		; DE = chars read
  0B65'                         JL_RD:
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0B65'   CD 0000*              	CALL	RDGET
  0B68'   DA 0BA2'              	JC	JL_END
  0B6B'   FE 0A                 	CPI	LF
  0B6D'   CA 0BA2'              	JZ	JL_END
  0B70'   E5                    	PUSH	H
  0B71'   C5                    	PUSH	B
  0B72'   2A 2E86'              	LHLD	JKVC
  0B75'   CD 065C'              	CALL	CWID
  0B78'   B7                    	ORA	A
  0B79'   CA 0B9C'              	JZ	JL_NX		; a CR
  0B7C'   EB                    	XCHG
  0B7D'   22 2E88'              	SHLD	JKLS		; the last content char so far
  0B80'   EB                    	XCHG
  0B81'   4F                    	MOV	C,A
  0B82'   06 00                 	MVI	B,0
  0B84'   09                    	DAD	B		; HL = the column after this char
  0B85'   22 2E86'              	SHLD	JKVC
  0B88'   D5                    	PUSH	D
  0B89'   EB                    	XCHG
  0B8A'   2A 2E6B'              	LHLD	GOALCOL
  0B8D'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0B90'   D1                    	POP	D
  0B91'   DA 0B9C'              	JC	JL_NX
  0B94'   CA 0B9C'              	JZ	JL_NX
  0B97'   C1                    	POP	B		; this char holds the goal column
  0B98'   E1                    	POP	H
  0B99'   C3 0BAD'              	JMP	JL_GO
  0B9C'                         JL_NX:
  0B9C'   C1                    	POP	B
  0B9D'   E1                    	POP	H
  0B9E'   13                    	INX	D
  0B9F'   C3 0B65'              	JMP	JL_RD
  0BA2'                         JL_END:
  0BA2'   2A 2E88'              	LHLD	JKLS		; past the line's end: its last content char
  0BA5'   7C                    	MOV	A,H
  0BA6'   A5                    	ANA	L
  0BA7'   3C                    	INR	A
  0BA8'   C2 0BAC'              	JNZ	JL_LS
  0BAB'   23                    	INX	H		; no content: the line's start
  0BAC'                         JL_LS:
  0BAC'   EB                    	XCHG
  0BAD'                         JL_GO:
  0BAD'   D5                    	PUSH	D		; DE = step from the line start
  0BAE'   CD 0000*              	CALL	CUROFF
  0BB1'   D1                    	POP	D
  0BB2'   19                    	DAD	D
  0BB3'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0BB6'   AF                    VC_W:	XRA	A
  0BB7'   32 2E6D'              	STA	WBIG
  0BBA'   C3 0BC2'              	JMP	WDO
  0BBD'   3E 01                 VCBGW:	MVI	A,1
  0BBF'   32 2E6D'              	STA	WBIG
  0BC2'   CD 0852'              WDO:	CALL	SETMOV
  0BC5'   AF                    	XRA	A
  0BC6'   32 2E6E'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0BC9'   CD 077D'              	CALL	GETCNT
  0BCC'   22 2EB0'              	SHLD	CNTV
  0BCF'   2A 2EB0'              WDO_LP: LHLD	CNTV
  0BD2'   7C                    	MOV	A,H
  0BD3'   B5                    	ORA	L
  0BD4'   CA 0BE1'              	JZ	WDO_DN
  0BD7'   2B                    	DCX	H
  0BD8'   22 2EB0'              	SHLD	CNTV
  0BDB'   CD 0C3E'              	CALL	FWD1
  0BDE'   D2 0BCF'              	JNC	WDO_LP
  0BE1'                         WDO_DN:
  0BE1'   CD 0B34'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0BE4'   DA 0BF1'              	JC	WDO_NL
  0BE7'   FE 0D                 	CPI	CR
  0BE9'   CA 0BF1'              	JZ	WDO_NL
  0BEC'   FE 0A                 	CPI	LF
  0BEE'   C2 0608'              	JNZ	SETGL
  0BF1'                         WDO_NL:
  0BF1'   CD 0000*              	CALL	PEEKL
  0BF4'   DA 0608'              	JC	SETGL
  0BF7'   FE 0A                 	CPI	LF
  0BF9'   CA 0608'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0BFC'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0BFE'   32 2E6E'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0C01'   CD 0D5D'              	CALL	DECC		; back onto its last char
  0C04'   C3 0608'              	JMP	SETGL
                                
  0C07'   AF                    VC_B:	XRA	A
  0C08'   32 2E6D'              	STA	WBIG
  0C0B'   C3 0C13'              	JMP	BDO
  0C0E'   3E 01                 VCBGB:	MVI	A,1
  0C10'   32 2E6D'              	STA	WBIG
  0C13'   CD 0852'              BDO:	CALL	SETMOV
  0C16'   CD 077D'              	CALL	GETCNT
  0C19'   22 2EB0'              	SHLD	CNTV
  0C1C'   CD 0CAE'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0C1F'   D2 0C2F'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0C22'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0C23'   32 2E98'              	STA	PSAVE		;   first char opened an insert).  A count that
  0C26'   C3 0608'              	JMP	SETGL		;   runs out at the start has still moved, and
  0C29'                         BDO_LP:				;   its operator stands -- both as vim
  0C29'   CD 0CAE'              	CALL	BCK1
  0C2C'   DA 0608'              	JC	SETGL
  0C2F'   2A 2EB0'              BDO_NX: LHLD	CNTV
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C32'   2B                    	DCX	H
  0C33'   22 2EB0'              	SHLD	CNTV
  0C36'   7C                    	MOV	A,H
  0C37'   B5                    	ORA	L
  0C38'   C2 0C29'              	JNZ	BDO_LP
  0C3B'   C3 0608'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
                                ; words before the last run on freely -- 'd2w' there takes the line break and
                                ; the next line's first word as well.
  0C3E'                         FWD1:
  0C3E'   CD 0CE1'              	CALL	CCLS
  0C41'   32 2EBA'              	STA	WKCLS		; the starting class
  0C44'   CD 0D1B'              	CALL	INCC
  0C47'   B7                    	ORA	A
  0C48'   CA 0C61'              	JZ	FW_WD
  0C4B'   37                    	STC
  0C4C'   F8                    	RM			; -1: already at the end
  0C4D'   CD 0C99'              	CALL	WLAST
  0C50'   C8                    	RZ
  0C51'   FE 02                 	CPI	2
  0C53'   C2 0C61'              	JNZ	FW_WD		; 1: a next line was reached
  0C56'   CD 0B34'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0C59'   D4 0D02'              	CNC	NXLN
  0C5C'   D2 0C61'              	JNC	FW_WD
  0C5F'   37                    	STC			; yes: failed
  0C60'   C9                    	RET
  0C61'                         FW_WD:
  0C61'   3A 2EBA'              	LDA	WKCLS		; go past the rest of this word
  0C64'   B7                    	ORA	A
  0C65'   CA 0C81'              	JZ	FW_WS
  0C68'                         FW_WLP:
  0C68'   CD 0CE1'              	CALL	CCLS
  0C6B'   21 2EBA'              	LXI	H,WKCLS
  0C6E'   BE                    	CMP	M
  0C6F'   C2 0C81'              	JNZ	FW_WS
  0C72'   CD 0D1B'              	CALL	INCC
  0C75'   B7                    	ORA	A
  0C76'   F8                    	RM			; the end of the file (NC)
  0C77'   CA 0C68'              	JZ	FW_WLP
  0C7A'   CD 0C99'              	CALL	WLAST
  0C7D'   C8                    	RZ
  0C7E'   C3 0C68'              	JMP	FW_WLP
  0C81'                         FW_WS:
  0C81'   CD 0CE1'              	CALL	CCLS		; then over blanks to the next word
  0C84'   B7                    	ORA	A
  0C85'   C0                    	RNZ
  0C86'   CD 0CE9'              	CALL	EMPTY
  0C89'   C8                    	RZ			; an empty line is a word
  0C8A'   CD 0D1B'              	CALL	INCC
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0C8D'   B7                    	ORA	A
  0C8E'   F8                    	RM
  0C8F'   CA 0C81'              	JZ	FW_WS
  0C92'   CD 0C99'              	CALL	WLAST
  0C95'   C8                    	RZ
  0C96'   C3 0C81'              	JMP	FW_WS
                                
                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0C99'                         WLAST:
  0C99'   47                    	MOV	B,A
  0C9A'   2A 2EB0'              	LHLD	CNTV
  0C9D'   7C                    	MOV	A,H
  0C9E'   B5                    	ORA	L
  0C9F'   C2 0CAA'              	JNZ	WL_X		; words still owed
  0CA2'   3A 2E98'              	LDA	PSAVE
  0CA5'   B7                    	ORA	A
  0CA6'   CA 0CAC'              	JZ	WL_NO		; a plain 'w'
  0CA9'   AF                    	XRA	A
  0CAA'   78                    WL_X:	MOV	A,B
  0CAB'   C9                    	RET
  0CAC'   B0                    WL_NO:	ORA	B
  0CAD'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0CAE'                         BCK1:
  0CAE'   CD 0D5D'              	CALL	DECC
  0CB1'   B7                    	ORA	A
  0CB2'   37                    	STC
  0CB3'   F8                    	RM
  0CB4'                         BK_WS:
  0CB4'   CD 0CE1'              	CALL	CCLS		; back over blanks
  0CB7'   B7                    	ORA	A
  0CB8'   C2 0CC8'              	JNZ	BK_WD
  0CBB'   CD 0CE9'              	CALL	EMPTY
  0CBE'   C8                    	RZ			; an empty line is a word
  0CBF'   CD 0D5D'              	CALL	DECC
  0CC2'   B7                    	ORA	A
  0CC3'   F2 0CB4'              	JP	BK_WS
  0CC6'   AF                    	XRA	A		; the start of the file (NC)
  0CC7'   C9                    	RET
  0CC8'                         BK_WD:
  0CC8'   32 2EBA'              	STA	WKCLS		; back to the start of this word
  0CCB'                         BK_WLP:
  0CCB'   CD 0D5D'              	CALL	DECC
  0CCE'   B7                    	ORA	A
  0CCF'   FA 0CDF'              	JM	BK_OK		; the start of the file
  0CD2'   CD 0CE1'              	CALL	CCLS
  0CD5'   21 2EBA'              	LXI	H,WKCLS
  0CD8'   BE                    	CMP	M
  0CD9'   CA 0CCB'              	JZ	BK_WLP
  0CDC'   CD 0D1B'              	CALL	INCC		; overshot: forward one
  0CDF'                         BK_OK:
  0CDF'   AF                    	XRA	A
  0CE0'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0CE1'                         CCLS:
  0CE1'   CD 0B34'              	CALL	ATEOF
  0CE4'   D2 0807'              	JNC	CLASSF
  0CE7'   AF                    	XRA	A
  0CE8'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0CE9'                         EMPTY:
  0CE9'   CD 0B34'              	CALL	ATEOF
  0CEC'   DA 0CF7'              	JC	EM_ST
  0CEF'   FE 0D                 	CPI	CR
  0CF1'   CA 0CF7'              	JZ	EM_ST
  0CF4'   FE 0A                 	CPI	LF
  0CF6'   C0                    	RNZ
  0CF7'                         EM_ST:
  0CF7'   CD 0000*              	CALL	PEEKL
  0CFA'   DA 0D00'              	JC	EM_Y
  0CFD'   FE 0A                 	CPI	LF
  0CFF'   C9                    	RET
  0D00'                         EM_Y:
  0D00'   AF                    	XRA	A
  0D01'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0D02'                         NXLN:
  0D02'   FE 0A                 	CPI	LF
  0D04'   CA 0D13'              	JZ	NX_LF
  0D07'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0D0A'   D8                    	RC
  0D0B'   FE 0A                 	CPI	LF
  0D0D'   CA 0D13'              	JZ	NX_LF
  0D10'   2B                    	DCX	H		; a lone CR
  0D11'   AF                    	XRA	A
  0D12'   C9                    	RET
  0D13'                         NX_LF:
  0D13'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0D16'   D8                    	RC
  0D17'   2B                    	DCX	H
  0D18'   3E 01                 	MVI	A,1
  0D1A'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0D1B'                         INCC:
  0D1B'   CD 0B34'              	CALL	ATEOF
  0D1E'   DA 0D59'              	JC	IC_END
  0D21'   FE 0D                 	CPI	CR
  0D23'   CA 0D44'              	JZ	IC_NL
  0D26'   FE 0A                 	CPI	LF
  0D28'   CA 0D44'              	JZ	IC_NL
  0D2B'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0D2E'                         IC_CH:
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D2E'   CD 0B34'              	CALL	ATEOF
  0D31'   DA 0D40'              	JC	IC_2
  0D34'   FE 0D                 	CPI	CR
  0D36'   CA 0D40'              	JZ	IC_2
  0D39'   FE 0A                 	CPI	LF
  0D3B'   CA 0D40'              	JZ	IC_2
  0D3E'   AF                    	XRA	A
  0D3F'   C9                    	RET
  0D40'                         IC_2:
  0D40'   3E 02                 	MVI	A,2
  0D42'   B7                    	ORA	A
  0D43'   C9                    	RET
  0D44'                         IC_NL:
  0D44'   CD 0D02'              	CALL	NXLN
  0D47'   DA 0D59'              	JC	IC_END
  0D4A'   F5                    	PUSH	PSW
  0D4B'   CD 0000*              	CALL	PUTCUR
  0D4E'   F1                    	POP	PSW
  0D4F'   B7                    	ORA	A
  0D50'   CA 0D2E'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0D53'   CD 0D7F'              	CALL	LNINC
  0D56'   3E 01                 	MVI	A,1
  0D58'   C9                    	RET
  0D59'                         IC_END:
  0D59'   3E FF                 	MVI	A,0FFH
  0D5B'   B7                    	ORA	A
  0D5C'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0D5D'                         DECC:
  0D5D'   CD 0000*              	CALL	PEEKL
  0D60'   DA 0D59'              	JC	IC_END
  0D63'   F5                    	PUSH	PSW
  0D64'   CD 0000*              	CALL	PUTCUR
  0D67'   F1                    	POP	PSW
  0D68'   FE 0A                 	CPI	LF
  0D6A'   3E 00                 	MVI	A,0
  0D6C'   C0                    	RNZ
  0D6D'   CD 0D8D'              	CALL	LNDEC
  0D70'   CD 0000*              	CALL	PEEKL		; onto its CR
  0D73'   DA 0D7B'              	JC	DC_1
  0D76'   FE 0D                 	CPI	CR
  0D78'   CC 0000*              	CZ	PUTCUR
  0D7B'                         DC_1:
  0D7B'   3E 01                 	MVI	A,1
  0D7D'   B7                    	ORA	A
  0D7E'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0D7F'                         LNINC:
  0D7F'   E5                    	PUSH	H
  0D80'   2A 0000*              	LHLD	LNDLT
  0D83'   7C                    	MOV	A,H
  0D84'   FE 40                 	CPI	40H
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0D86'   CA 0D9B'              	JZ	LN_X
  0D89'   23                    	INX	H
  0D8A'   C3 0D98'              	JMP	LN_ST
  0D8D'                         LNDEC:
  0D8D'   E5                    	PUSH	H
  0D8E'   2A 0000*              	LHLD	LNDLT
  0D91'   7C                    	MOV	A,H
  0D92'   FE C0                 	CPI	0C0H
  0D94'   CA 0D9B'              	JZ	LN_X
  0D97'   2B                    	DCX	H
  0D98'                         LN_ST:
  0D98'   22 0000*              	SHLD	LNDLT
  0D9B'                         LN_X:
  0D9B'   E1                    	POP	H
  0D9C'   C9                    	RET
                                
  0D9D'   AF                    VC_E:	XRA	A
  0D9E'   32 2E6D'              	STA	WBIG
  0DA1'   C3 0DA9'              	JMP	EDO
  0DA4'   3E 01                 VCBGE:	MVI	A,1
  0DA6'   32 2E6D'              	STA	WBIG
  0DA9'   CD 0852'              EDO:	CALL	SETMOV
  0DAC'   CD 077D'              	CALL	GETCNT
  0DAF'   22 2EB0'              	SHLD	CNTV
  0DB2'   2A 2EB0'              EDO_LP: LHLD	CNTV
  0DB5'   7C                    	MOV	A,H
  0DB6'   B5                    	ORA	L
  0DB7'   CA 0BE1'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0DBA'   2B                    	DCX	H
  0DBB'   22 2EB0'              	SHLD	CNTV
  0DBE'   CD 0DCC'              	CALL	ESTEP
  0DC1'   21 2E9B'              	LXI	H,CWEOL		; only the count's first word stays where it is
  0DC4'   36 00                 	MVI	M,0
  0DC6'   D2 0DB2'              	JNC	EDO_LP
  0DC9'   C3 0BE1'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0DCC'                         ESTEP:
  0DCC'   CD 0CE1'              	CALL	CCLS
  0DCF'   32 2EBA'              	STA	WKCLS		; the starting class
  0DD2'   CD 0D1B'              	CALL	INCC
  0DD5'   B7                    	ORA	A
  0DD6'   FA 0DFC'              	JM	ES_F
  0DD9'   CD 0CE1'              	CALL	CCLS
  0DDC'   B7                    	ORA	A
  0DDD'   CA 0DE7'              	JZ	ES_ST
  0DE0'   21 2EBA'              	LXI	H,WKCLS
  0DE3'   BE                    	CMP	M
  0DE4'   CA 0DFE'              	JZ	ES_SK		; still in the word it started in: on to its end
  0DE7'                         ES_ST:
  0DE7'   3A 2E9B'              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0DEA'   B7                    	ORA	A		;   that char is the word's end already, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0DEB'   C2 0E15'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
  0DEE'                         ES_WS:
  0DEE'   CD 0CE1'              	CALL	CCLS		; over blanks, line ends and empty lines
  0DF1'   B7                    	ORA	A
  0DF2'   C2 0DFE'              	JNZ	ES_SK
  0DF5'   CD 0D1B'              	CALL	INCC
  0DF8'   B7                    	ORA	A
  0DF9'   F2 0DEE'              	JP	ES_WS
  0DFC'                         ES_F:
  0DFC'   37                    	STC
  0DFD'   C9                    	RET
  0DFE'                         ES_SK:
  0DFE'   CD 0CE1'              	CALL	CCLS		; past the rest of this word ...
  0E01'   32 2EBA'              	STA	WKCLS
  0E04'                         ES_SL:
  0E04'   CD 0D1B'              	CALL	INCC
  0E07'   B7                    	ORA	A
  0E08'   FA 0DFC'              	JM	ES_F
  0E0B'   CD 0CE1'              	CALL	CCLS
  0E0E'   21 2EBA'              	LXI	H,WKCLS
  0E11'   BE                    	CMP	M
  0E12'   CA 0E04'              	JZ	ES_SL
  0E15'   C3 0D5D'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's place among the screen's LINES (CURRW) and the
                                ; last layout's facts from SCRN.MAC: SCBOT (the last line shown), SCEOF / SCBOF
                                ; (the file's end / start is on the screen).  H and L count lines.  M and the
                                ; scrolls count screen ROWS, as vim does once lines wrap, and a line's rows
                                ; are not known without measuring it: SCRN.MAC's HTBLD measures the lines
                                ; about the screen into a table (HTAB), and the rest is arithmetic on that.
                                ; A scroll then moves the cursor and names the line the screen is to start
                                ; with (HTLAND -> SETRWT), so the text scrolls around it.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0E18'                         CURRW:
  0E18'   2A 0000*              	LHLD	WINROW
  0E1B'   EB                    	XCHG
  0E1C'   2A 0000*              	LHLD	LNDLT
  0E1F'   19                    	DAD	D		; HL = row (signed)
  0E20'   7C                    	MOV	A,H
  0E21'   B7                    	ORA	A
  0E22'   FA 0E35'              	JM	CRW_0		; above the screen -> top row
  0E25'   C2 0E30'              	JNZ	CRW_BT		; far below -> bottom row
  0E28'   3A 0000*              	LDA	NEDIT
  0E2B'   3D                    	DCR	A		; A = bottom row
  0E2C'   BD                    	CMP	L		; CY iff bottom < row
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E2D'   D8                    	RC
  0E2E'   7D                    	MOV	A,L
  0E2F'   C9                    	RET
  0E30'                         CRW_BT:
  0E30'   3A 0000*              	LDA	NEDIT
  0E33'   3D                    	DCR	A
  0E34'   C9                    	RET
  0E35'                         CRW_0:
  0E35'   AF                    	XRA	A
  0E36'   C9                    	RET
                                
                                ;SETRWT -- A = lines: the next layout puts that many above the cursor's, and
                                ; does not ask whether the line has gone far (PLACE).
  0E37'                         SETRWT:
  0E37'   2A 0000*              	LHLD	LNDLT
  0E3A'   EB                    	XCHG
  0E3B'   6F                    	MOV	L,A
  0E3C'   26 00                 	MVI	H,0
  0E3E'   CD 0000*              	CALL	SUBHD		; HL = lines - LNDLT
  0E41'   22 0000*              	SHLD	WINROW
  0E44'   3E 01                 	MVI	A,PL_SET
  0E46'   32 0000*              	STA	PLACE
  0E49'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0E4A'                         MVROW:
  0E4A'   47                    	MOV	B,A
  0E4B'   CD 0E18'              	CALL	CURRW
  0E4E'   90                    	SUB	B		; A = row now - target
  0E4F'                         MR_GO:
  0E4F'   C8                    	RZ
  0E50'   DA 0E59'              	JC	MR_DN
  0E53'   6F                    	MOV	L,A
  0E54'   26 00                 	MVI	H,0
  0E56'   C3 0AA3'              	JMP	KCORE
  0E59'                         MR_DN:
  0E59'   2F                    	CMA
  0E5A'   3C                    	INR	A		; A = target - row now
  0E5B'   6F                    	MOV	L,A
  0E5C'   26 00                 	MVI	H,0
  0E5E'   C3 0A06'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0E61'                         VC_HIGH:
  0E61'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  0E64'   2B                    	DCX	H		; row = count - 1
  0E65'   7C                    	MOV	A,H
  0E66'   B7                    	ORA	A
  0E67'   3A 0000*              	LDA	SCBOT
  0E6A'   C2 0E72'              	JNZ	VH_GO		; >= 256 -> the last text row
  0E6D'   BD                    	CMP	L		; CY iff SCBOT < row
  0E6E'   DA 0E72'              	JC	VH_GO
  0E71'   7D                    	MOV	A,L
  0E72'                         VH_GO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0E72'   CD 0E4A'              	CALL	MVROW
  0E75'   C3 094B'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': the line the middle ROW of the text is on (vim: the first
                                ; whose rows, with those above it, come to half of them); count ignored.
  0E78'                         VC_MIDL:
  0E78'   CD 076A'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0E7B'   CD 110A'              	CALL	HTSCR		; HL -> the top line's rows
  0E7E'   3A 0000*              	LDA	TXEND
  0E81'   3C                    	INR	A
  0E82'   B7                    	ORA	A
  0E83'   1F                    	RAR
  0E84'   3D                    	DCR	A
  0E85'   4F                    	MOV	C,A		; C = (rows of text + 1) / 2 - 1
  0E86'   CD 1150'              	CALL	HTFQ
  0E89'   D2 0E8D'              	JNC	VM_GO
  0E8C'   2B                    	DCX	H
  0E8D'                         VM_GO:
  0E8D'   CD 1145'              	CALL	HTGO
  0E90'   C3 094B'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0E93'                         VC_LOWL:
  0E93'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  0E96'   2B                    	DCX	H		; count - 1
  0E97'   3A 0000*              	LDA	SCBOT
  0E9A'   5F                    	MOV	E,A
  0E9B'   16 00                 	MVI	D,0
  0E9D'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0E9E'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0EA1'   3E 00                 	MVI	A,0
  0EA3'   D2 0EAA'              	JNC	VL_GO		; at or past the top -> row 0
  0EA6'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0EA9'   7D                    	MOV	A,L
  0EAA'                         VL_GO:
  0EAA'   CD 0E4A'              	CALL	MVROW
  0EAD'   C3 094B'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the text forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is the
                                ; screen's ROWS less the overlap (OVLAP), and the line that many rows down
                                ; becomes the top line -- from its first row, vim never showing part of one.
                                ; The top line stops at the last line ('~' rows below); no-op when it is
                                ; already there.
  0EB0'                         VC_PGDN:
  0EB0'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  0EB3'   22 2E78'              	SHLD	RWR
  0EB6'   3A 0000*              	LDA	SCEOF
  0EB9'   B7                    	ORA	A
  0EBA'   CA 0EC2'              	JZ	VPD_N
  0EBD'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: it becomes the
  0EC0'   B7                    	ORA	A		;   top line
  0EC1'   C8                    	RZ			; it already is
  0EC2'                         VPD_N:
  0EC2'   3A 0000*              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0EC5'   3C                    	INR	A
  0EC6'   4F                    	MOV	C,A
  0EC7'   3E 02                 	MVI	A,2
  0EC9'   CD 1111'              	CALL	HTSET		; HL -> the top line's rows
  0ECC'   E5                    	PUSH	H
  0ECD'   C5                    	PUSH	B
  0ECE'   3A 0000*              	LDA	NEDIT
  0ED1'   4F                    	MOV	C,A
  0ED2'   CD 1150'              	CALL	HTFQ		; HL -> the first line the screen has not room for
  0ED5'   3A 0000*              	LDA	NEDIT
  0ED8'   DA 0EE5'              	JC	VPD_R		; there is none: no overlap
  0EDB'   3A 2E73'              	LDA	HTN
  0EDE'   90                    	SUB	B
  0EDF'   3C                    	INR	A
  0EE0'   47                    	MOV	B,A		; the lines from it up to the table's first
  0EE1'   AF                    	XRA	A
  0EE2'   CD 0F7F'              	CALL	OVLAP
  0EE5'                         VPD_R:
  0EE5'   CD 0FCE'              	CALL	PGROWS		; RWR = the rows to go
  0EE8'   C1                    	POP	B
  0EE9'   E1                    	POP	H
  0EEA'   CD 1191'              	CALL	RWFWD		; HL -> the line that row is in, C = which of its
  0EED'   DA 0F09'              	JC	VPD_TP		; the text ended: its last line
  0EF0'   79                    	MOV	A,C
  0EF1'   B7                    	ORA	A
  0EF2'   CA 0F09'              	JZ	VPD_TP
  0EF5'   3A 2E7A'              	LDA	RWMV		; part of the way down a line: its start -- unless
  0EF8'   B7                    	ORA	A		;   that is the top line still, then the next
  0EF9'   C2 0F09'              	JNZ	VPD_TP
  0EFC'   E5                    	PUSH	H
  0EFD'   CD 113F'              	CALL	HTIX
  0F00'   21 2E75'              	LXI	H,HTTP
  0F03'   BE                    	CMP	M
  0F04'   E1                    	POP	H
  0F05'   C2 0F09'              	JNZ	VPD_TP
  0F08'   23                    	INX	H
  0F09'                         VPD_TP:
  0F09'   54                    	MOV	D,H
  0F0A'   5D                    	MOV	E,L
  0F0B'   C3 1078'              	JMP	HTLAND
                                
                                ;VC_PGUP -- '^B': the text back count pages, not above the first line, the
                                ; cursor on the last line that then shows whole, first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is the screen's ROWS less the overlap
                                ; (OVLAP).  Where that ends part of the way up a line, the top line is the one
                                ; under it -- but the line itself, when it is the first one back.  No-op when
                                ; the first line is already at the top.
  0F0E'                         VC_PGUP:
  0F0E'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  0F11'   22 2E78'              	SHLD	RWR
  0F14'   3A 0000*              	LDA	SCBOF
  0F17'   B7                    	ORA	A
  0F18'   C0                    	RNZ
  0F19'   CD 0E18'              	CALL	CURRW		; OVLAP reads the top line and the two under it:
  0F1C'   FE 02                 	CPI	2		;   lines the cursor's is not below are read for
  0F1E'   0E 01                 	MVI	C,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F20'   D2 0F27'              	JNC	VPU_1
  0F23'   3A 0000*              	LDA	NEDIT
  0F26'   4F                    	MOV	C,A
  0F27'                         VPU_1:
  0F27'   3A 0000*              	LDA	NEDIT
  0F2A'   CD 1111'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  0F2D'   E5                    	PUSH	H
  0F2E'   D5                    	PUSH	D
  0F2F'   2B                    	DCX	H		; the line above the top one, and on down
  0F30'   04                    	INR	B
  0F31'   3E 01                 	MVI	A,1
  0F33'   CD 0F7F'              	CALL	OVLAP
  0F36'   CD 0FCE'              	CALL	PGROWS		; RWR = the rows to go
  0F39'   D1                    	POP	D
  0F3A'   E1                    	POP	H
  0F3B'   43                    	MOV	B,E
  0F3C'   CD 11D1'              	CALL	RWBAK		; HL -> the line that row is in, C = its rows
  0F3F'   DA 0F5C'              	JC	VPU_3		;   above it; or the file's first line
  0F42'   79                    	MOV	A,C
  0F43'   B7                    	ORA	A
  0F44'   CA 0F5C'              	JZ	VPU_3
  0F47'   3A 2E7A'              	LDA	RWMV
  0F4A'   B7                    	ORA	A
  0F4B'   C2 0F5B'              	JNZ	VPU_2
  0F4E'   E5                    	PUSH	H
  0F4F'   CD 113F'              	CALL	HTIX
  0F52'   3C                    	INR	A
  0F53'   21 2E75'              	LXI	H,HTTP
  0F56'   BE                    	CMP	M
  0F57'   E1                    	POP	H
  0F58'   CA 0F5C'              	JZ	VPU_3		; the first line back: all of it
  0F5B'                         VPU_2:
  0F5B'   23                    	INX	H
  0F5C'                         VPU_3:
  0F5C'   CD 1145'              	CALL	HTGO		; the cursor on the new top line ...
  0F5F'   3A 0000*              	LDA	NEDIT
  0F62'   4F                    	MOV	C,A
  0F63'   06 00                 	MVI	B,0
  0F65'   CD 1126'              	CALL	HTRB		; ... and the lines under it measured
  0F68'   E5                    	PUSH	H
  0F69'   3A 0000*              	LDA	NEDIT
  0F6C'   4F                    	MOV	C,A
  0F6D'   CD 1150'              	CALL	HTFQ		; HL -> the first the screen has not room for
  0F70'   2B                    	DCX	H
  0F71'   D1                    	POP	D		; DE -> the top line's rows
  0F72'   EB                    	XCHG
  0F73'   CD 0000*              	CALL	CMP16		; CY iff that is above the top line (it alone
  0F76'   D2 0F7B'              	JNC	VPU_4		;   fills the screen)
  0F79'   54                    	MOV	D,H
  0F7A'   5D                    	MOV	E,L
  0F7B'                         VPU_4:
  0F7B'   EB                    	XCHG
  0F7C'   C3 1078'              	JMP	HTLAND
                                
                                ;OVLAP -- A = the rows one page scrolls, as vim's get_scroll_overlap: the
                                ; screen less two lines of overlap -- or less one, or none, where the lines at
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


                                ; that edge are too tall to be shown twice or the file ends among them.
                                ;   in : HL -> the rows of the line just off the screen at that edge (h1),
                                ;        A = 0 when the next (h2, h3, h4) are above it in the table, 1 when
                                ;        below, B = the entries the table has that way, h1's among them
  0F7F'                         OVLAP:
  0F7F'   32 2E7B'              	STA	OVDIR
  0F82'   3A 0000*              	LDA	NEDIT
  0F85'   D6 02                 	SUI	2
  0F87'   4F                    	MOV	C,A		; C = the rows two lines of overlap leave
  0F88'   56                    	MOV	D,M		; D = h1
  0F89'   CD 0FC0'              	CALL	OV_NX
  0F8C'   DA 0FBC'              	JC	OV_0
  0F8F'   5E                    	MOV	E,M		; E = h2
  0F90'   7A                    	MOV	A,D
  0F91'   83                    	ADD	E
  0F92'   57                    	MOV	D,A		; D = h1 + h2
  0F93'   79                    	MOV	A,C
  0F94'   BA                    	CMP	D
  0F95'   DA 0FBC'              	JC	OV_0
  0F98'   CD 0FC0'              	CALL	OV_NX
  0F9B'   DA 0FBC'              	JC	OV_0
  0F9E'   7B                    	MOV	A,E
  0F9F'   86                    	ADD	M
  0FA0'   5F                    	MOV	E,A		; E = h2 + h3
  0FA1'   79                    	MOV	A,C
  0FA2'   BB                    	CMP	E
  0FA3'   DA 0FBC'              	JC	OV_0
  0FA6'   7A                    	MOV	A,D
  0FA7'   86                    	ADD	M
  0FA8'   57                    	MOV	D,A		; D = h1 + h2 + h3
  0FA9'   CD 0FC0'              	CALL	OV_NX
  0FAC'   DA 0FB9'              	JC	OV_1
  0FAF'   7B                    	MOV	A,E
  0FB0'   86                    	ADD	M		; h2 + h3 + h4
  0FB1'   5F                    	MOV	E,A
  0FB2'   79                    	MOV	A,C
  0FB3'   BB                    	CMP	E
  0FB4'   DA 0FB9'              	JC	OV_1
  0FB7'   BA                    	CMP	D
  0FB8'   D0                    	RNC			; two lines of overlap
  0FB9'                         OV_1:
  0FB9'   79                    	MOV	A,C
  0FBA'   3C                    	INR	A
  0FBB'   C9                    	RET
  0FBC'                         OV_0:
  0FBC'   79                    	MOV	A,C
  0FBD'   C6 02                 	ADI	2
  0FBF'   C9                    	RET
                                ;OV_NX -- HL -> the next line's rows, that way.  CY if the table has no more.
  0FC0'                         OV_NX:
  0FC0'   05                    	DCR	B
  0FC1'   37                    	STC
  0FC2'   C8                    	RZ
  0FC3'   3A 2E7B'              	LDA	OVDIR
  0FC6'   B7                    	ORA	A		; (CY off)
  0FC7'   CA 0FCC'              	JZ	OV_UP
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FCA'   23                    	INX	H
  0FCB'   23                    	INX	H
  0FCC'                         OV_UP:
  0FCC'   2B                    	DCX	H
  0FCD'   C9                    	RET
                                
                                ;PGROWS -- A = the rows of a page: RWR = the count (in RWR) of them, and no
                                ; line gone past yet (RWMV).
  0FCE'                         PGROWS:
  0FCE'   2A 2E78'              	LHLD	RWR
  0FD1'   CD 0FDC'              	CALL	MULSAT
  0FD4'   22 2E78'              	SHLD	RWR
  0FD7'   AF                    	XRA	A
  0FD8'   32 2E7A'              	STA	RWMV
  0FDB'   C9                    	RET
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0FDC'                         MULSAT:
  0FDC'   EB                    	XCHG
  0FDD'   21 0000               	LXI	H,0
  0FE0'   B7                    	ORA	A
  0FE1'   C8                    	RZ
  0FE2'                         MS_LP:
  0FE2'   19                    	DAD	D
  0FE3'   DA 0FEB'              	JC	MS_SAT
  0FE6'   3D                    	DCR	A
  0FE7'   C2 0FE2'              	JNZ	MS_LP
  0FEA'   C9                    	RET
  0FEB'                         MS_SAT:
  0FEB'   21 FFFF               	LXI	H,0FFFFH
  0FEE'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': the text and the cursor down HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text goes
                                ; no farther than brings the last row of the file to the bottom row; the line
                                ; that many rows down becomes the top line -- from its first row, vim never
                                ; showing part of one, and the cursor moves as many rows less (more, where
                                ; the top line alone was taller than that and the text had to go past it).
                                ; On the last line nothing moves, the column included.
  0FEF'                         VC_HFDN:
  0FEF'   CD 0852'              	CALL	SETMOV
  0FF2'   CD 1234'              	CALL	HFCNT		; HFN = the rows
  0FF5'   3A 0000*              	LDA	TALLF
  0FF8'   B7                    	ORA	A
  0FF9'   C2 108F'              	JNZ	VHD_TL
  0FFC'   CD 0E18'              	CALL	CURRW
  0FFF'   47                    	MOV	B,A
  1000'   3A 0000*              	LDA	SCEOF
  1003'   B7                    	ORA	A
  1004'   CA 100C'              	JZ	VHD_GO
  1007'   3A 0000*              	LDA	SCBOT		; the last line's place
  100A'   B8                    	CMP	B
  100B'   C8                    	RZ			; the cursor is on it
  100C'                         VHD_GO:
  100C'   3A 0000*              	LDA	NEDIT
  100F'   21 2E70'              	LXI	H,HFN
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  1012'   86                    	ADD	M
  1013'   3C                    	INR	A
  1014'   4F                    	MOV	C,A
  1015'   AF                    	XRA	A
  1016'   CD 1111'              	CALL	HTSET		; HL -> the top line's rows
  1019'   3A 2E70'              	LDA	HFN
  101C'   57                    	MOV	D,A		; D = the rows the text moves
  101D'   5F                    	MOV	E,A		; E = the rows the cursor moves
  101E'   3A 2E76'              	LDA	HTEOF
  1021'   B7                    	ORA	A
  1022'   CA 1041'              	JZ	VHD_1
  1025'   E5                    	PUSH	H
  1026'   C5                    	PUSH	B
  1027'   0E FF                 	MVI	C,255
  1029'   CD 1150'              	CALL	HTFQ		; (runs off: C = 255 - the rows to the file's end)
  102C'   3A 0000*              	LDA	NEDIT
  102F'   81                    	ADD	C
  1030'   2F                    	CMA			; A = those rows - NEDIT: the rows off the screen
  1031'   C1                    	POP	B
  1032'   E1                    	POP	H
  1033'   B7                    	ORA	A
  1034'   FA 103F'              	JM	VHD_0		; none
  1037'   BA                    	CMP	D
  1038'   D2 1041'              	JNC	VHD_1
  103B'   57                    	MOV	D,A
  103C'   C3 1041'              	JMP	VHD_1
  103F'                         VHD_0:
  103F'   16 00                 	MVI	D,0
  1041'                         VHD_1:
  1041'   7A                    	MOV	A,D
  1042'   B7                    	ORA	A
  1043'   CA 105E'              	JZ	VHD_C		; the text stays
  1046'   4A                    	MOV	C,D
  1047'   CD 1150'              	CALL	HTFQ		; HL -> the line that row is in, C = which of its
  104A'   79                    	MOV	A,C
  104B'   B7                    	ORA	A
  104C'   CA 105E'              	JZ	VHD_C
  104F'   BA                    	CMP	D
  1050'   C2 105B'              	JNZ	VHD_R
  1053'   7E                    	MOV	A,M		; the top line still: past all of it
  1054'   91                    	SUB	C
  1055'   83                    	ADD	E
  1056'   5F                    	MOV	E,A
  1057'   23                    	INX	H
  1058'   C3 105E'              	JMP	VHD_C
  105B'                         VHD_R:
  105B'   7B                    	MOV	A,E		; part of the way down a line: its start
  105C'   91                    	SUB	C
  105D'   5F                    	MOV	E,A
  105E'                         VHD_C:
  105E'   22 2E71'              	SHLD	HFTP
  1061'   3A 0000*              	LDA	CSUB		; the cursor: E rows down from the one it is on
  1064'   83                    	ADD	E
  1065'   4F                    	MOV	C,A
  1066'   3A 2E74'              	LDA	HTCUR
  1069'   CD 1132'              	CALL	HTPT
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  106C'   CD 1150'              	CALL	HTFQ
  106F'   D2 1073'              	JNC	HFEND
  1072'   2B                    	DCX	H		; the file ends first: its last line
                                ;HFEND -- ^D / ^U: HL -> the rows of the line the cursor goes to.
  1073'                         HFEND:
  1073'   EB                    	XCHG
  1074'   2A 2E71'              	LHLD	HFTP
  1077'   EB                    	XCHG
                                ;HTLAND -- the cursor to the line whose rows HL points at, DE -> those of the
                                ; line the screen is to start with (never one under it); first non-blank.
  1078'                         HTLAND:
  1078'   E5                    	PUSH	H
  1079'   D5                    	PUSH	D
  107A'   CD 1145'              	CALL	HTGO
  107D'   D1                    	POP	D
  107E'   E1                    	POP	H
  107F'   CD 0000*              	CALL	SUBHD		; HL = the lines between them
  1082'   7C                    	MOV	A,H
  1083'   B7                    	ORA	A
  1084'   7D                    	MOV	A,L
  1085'   CA 1089'              	JZ	HL_SET
  1088'   AF                    	XRA	A
  1089'                         HL_SET:
  1089'   CD 0E37'              	CALL	SETRWT
  108C'   C3 094B'              	JMP	FNBLNK
                                
                                ;--- the top line is taller than the screen, and the cursor in it: vim goes
                                ;    on scrolling until the next line is at the top, the cursor keeping its
                                ;    row of the screen ---
  108F'                         VHD_TL:
  108F'   3A 0000*              	LDA	SKIPR
  1092'   47                    	MOV	B,A
  1093'   3A 0000*              	LDA	CSUB
  1096'   90                    	SUB	B		; A = that row
  1097'   F5                    	PUSH	PSW
  1098'   21 0001               	LXI	H,1
  109B'   CD 0A06'              	CALL	JCORE		; (on the last line: nowhere to go)
  109E'   F1                    	POP	PSW
  109F'   4F                    	MOV	C,A
  10A0'   C5                    	PUSH	B
  10A1'   0C                    	INR	C
  10A2'   06 00                 	MVI	B,0
  10A4'   CD 1126'              	CALL	HTRB		; HL -> the rows of the line now the cursor's
  10A7'   22 2E71'              	SHLD	HFTP
  10AA'   D1                    	POP	D
  10AB'   4B                    	MOV	C,E
  10AC'   CD 1150'              	CALL	HTFQ
  10AF'   D2 1073'              	JNC	HFEND
  10B2'   2B                    	DCX	H
  10B3'   C3 1073'              	JMP	HFEND
                                
                                ;VC_HFUP -- '^U': the text and the cursor up HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text
                                ; stops at the first line, the cursor goes on.  Where the rows end part of
                                ; the way up a line, the top line is the one under it and the cursor moves as
                                ; many rows less -- but the line itself, and as many more, when it is the
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


                                ; first one back.  On the first line nothing moves, the column included.
  10B6'                         VC_HFUP:
  10B6'   CD 0852'              	CALL	SETMOV
  10B9'   CD 1234'              	CALL	HFCNT		; HFN = the rows
  10BC'   CD 1214'              	CALL	ONFST
  10BF'   C8                    	RZ			; the cursor is on the first line
  10C0'   0E 01                 	MVI	C,1
  10C2'   3A 2E70'              	LDA	HFN
  10C5'   CD 1111'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  10C8'   43                    	MOV	B,E
  10C9'   3A 2E70'              	LDA	HFN
  10CC'   4F                    	MOV	C,A
  10CD'   5F                    	MOV	E,A		; E = the rows the cursor moves
  10CE'   CD 1161'              	CALL	HTBQ		; HL -> the line that row is in, C = its rows
  10D1'   DA 10EC'              	JC	VHU_C		;   above it; or the file's first line
  10D4'   79                    	MOV	A,C
  10D5'   B7                    	ORA	A
  10D6'   CA 10EC'              	JZ	VHU_C
  10D9'   3A 2E75'              	LDA	HTTP
  10DC'   3D                    	DCR	A
  10DD'   B8                    	CMP	B
  10DE'   CA 10E9'              	JZ	VHU_F
  10E1'   7B                    	MOV	A,E		; part of the way up a line: the one under it
  10E2'   96                    	SUB	M
  10E3'   81                    	ADD	C
  10E4'   5F                    	MOV	E,A
  10E5'   23                    	INX	H
  10E6'   C3 10EC'              	JMP	VHU_C
  10E9'                         VHU_F:
  10E9'   7B                    	MOV	A,E		; ... the first line back: all of it
  10EA'   81                    	ADD	C
  10EB'   5F                    	MOV	E,A
  10EC'                         VHU_C:
  10EC'   22 2E71'              	SHLD	HFTP
  10EF'   4B                    	MOV	C,E
  10F0'   3A 2E74'              	LDA	HTCUR
  10F3'   CD 1132'              	CALL	HTPT		; HL -> the cursor line's rows, E = lines above it
  10F6'   3A 0000*              	LDA	CSUB
  10F9'   57                    	MOV	D,A
  10FA'   79                    	MOV	A,C
  10FB'   92                    	SUB	D		; the rows to go, less those of its own line above it
  10FC'   DA 1073'              	JC	HFEND
  10FF'   CA 1073'              	JZ	HFEND
  1102'   4F                    	MOV	C,A
  1103'   43                    	MOV	B,E
  1104'   CD 1161'              	CALL	HTBQ		; (off the top: the file's first line)
  1107'   C3 1073'              	JMP	HFEND
                                
                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
                                ;HTSCR -- the table as the last layout left it, which is the screen's own:
                                ; HL, B and E as HTSET gives them, and nothing measured.
  110A'                         HTSCR:
  110A'   CD 0E18'              	CALL	CURRW
  110D'   47                    	MOV	B,A
  110E'   C3 111C'              	JMP	HS_TP
  1111'                         HTSET:
  1111'   47                    	MOV	B,A
  1112'   CD 0E18'              	CALL	CURRW		; (keeps BC)
  1115'   F5                    	PUSH	PSW
  1116'   80                    	ADD	B
  1117'   47                    	MOV	B,A
  1118'   CD 1126'              	CALL	HTRB
  111B'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  111C'                         HS_TP:
  111C'   3A 2E74'              	LDA	HTCUR
  111F'   90                    	SUB	B
  1120'   32 2E75'              	STA	HTTP
  1123'   C3 1132'              	JMP	HTPT
  1126'                         HTRB:
  1126'   CD 1304'              	CALL	ZSAVE
  1129'   CD 0000*              	CALL	HTBLD
  112C'   CD 1317'              	CALL	ZREST
  112F'   3A 2E74'              	LDA	HTCUR
  1132'                         HTPT:
  1132'   5F                    	MOV	E,A
  1133'   16 00                 	MVI	D,0
  1135'   21 0000*              	LXI	H,HTAB
  1138'   19                    	DAD	D
  1139'   3A 2E73'              	LDA	HTN
  113C'   93                    	SUB	E
  113D'   47                    	MOV	B,A
  113E'   C9                    	RET
                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  113F'                         HTIX:
  113F'   11 0000*              	LXI	D,HTAB
  1142'   7D                    	MOV	A,L
  1143'   93                    	SUB	E
  1144'   C9                    	RET
                                
                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
  1145'                         HTGO:
  1145'   CD 113F'              	CALL	HTIX
  1148'   47                    	MOV	B,A
  1149'   3A 2E74'              	LDA	HTCUR
  114C'   90                    	SUB	B		; A = the lines up to it
  114D'   C3 0E4F'              	JMP	MR_GO
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  1150'                         HTFQ:
  1150'   78                    	MOV	A,B
  1151'   B7                    	ORA	A
  1152'   37                    	STC
  1153'   C8                    	RZ
  1154'   79                    	MOV	A,C
  1155'   96                    	SUB	M
  1156'   DA 115F'              	JC	HF_IN
  1159'   4F                    	MOV	C,A
  115A'   23                    	INX	H
  115B'   05                    	DCR	B
  115C'   C3 1150'              	JMP	HTFQ
  115F'                         HF_IN:
  115F'   B7                    	ORA	A
  1160'   C9                    	RET
                                
                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
                                ;        the table starts first (HL -> its first entry, C = the rows short)
  1161'                         HTBQ:
  1161'   78                    	MOV	A,B
  1162'   B7                    	ORA	A
  1163'   37                    	STC
  1164'   C8                    	RZ
  1165'   2B                    	DCX	H
  1166'   05                    	DCR	B
  1167'   7E                    	MOV	A,M
  1168'   91                    	SUB	C
  1169'   D2 1172'              	JNC	HQ_IN
  116C'   2F                    	CMA
  116D'   3C                    	INR	A
  116E'   4F                    	MOV	C,A
  116F'   C3 1161'              	JMP	HTBQ
  1172'                         HQ_IN:
  1172'   4F                    	MOV	C,A
  1173'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
                                ; Keeps HL, B, DE.
  1174'                         RWQ:
  1174'   0E 64                 	MVI	C,100
  1176'   3A 2E79'              	LDA	RWR+1
  1179'   B7                    	ORA	A
  117A'   C0                    	RNZ
  117B'   3A 2E78'              	LDA	RWR
  117E'   B9                    	CMP	C
  117F'   D0                    	RNC
  1180'   4F                    	MOV	C,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1181'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  1182'                         RWSUB:
  1182'   E5                    	PUSH	H
  1183'   5F                    	MOV	E,A
  1184'   16 00                 	MVI	D,0
  1186'   2A 2E78'              	LHLD	RWR
  1189'   CD 0000*              	CALL	SUBHD
  118C'   22 2E78'              	SHLD	RWR
  118F'   E1                    	POP	H
  1190'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
                                ; whose entry HL points at (B = the entries from it on), however far that is:
                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  1191'                         RWFWD:
  1191'   CD 1174'              	CALL	RWQ
  1194'   51                    	MOV	D,C
  1195'   CD 1150'              	CALL	HTFQ
  1198'   F5                    	PUSH	PSW
  1199'   7A                    	MOV	A,D
  119A'   91                    	SUB	C		; the rows that took it to that line's first
  119B'   CD 1182'              	CALL	RWSUB
  119E'   F1                    	POP	PSW
  119F'   DA 11B3'              	JC	RF_OFF
  11A2'   3A 2E79'              	LDA	RWR+1		; is what is left inside this line?
  11A5'   B7                    	ORA	A
  11A6'   C2 11BD'              	JNZ	RF_GO
  11A9'   3A 2E78'              	LDA	RWR
  11AC'   BE                    	CMP	M
  11AD'   D2 11BD'              	JNC	RF_GO
  11B0'   4F                    	MOV	C,A
  11B1'   B7                    	ORA	A
  11B2'   C9                    	RET
  11B3'                         RF_OFF:
  11B3'   3A 2E76'              	LDA	HTEOF
  11B6'   B7                    	ORA	A
  11B7'   CA 11BD'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  11BA'   2B                    	DCX	H
  11BB'   37                    	STC
  11BC'   C9                    	RET
  11BD'                         RF_GO:
  11BD'   CD 1145'              	CALL	HTGO
  11C0'   3E 01                 	MVI	A,1
  11C2'   32 2E7A'              	STA	RWMV
  11C5'   CD 1174'              	CALL	RWQ
  11C8'   0C                    	INR	C
  11C9'   06 00                 	MVI	B,0
  11CB'   CD 1126'              	CALL	HTRB
  11CE'   C3 1191'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  11D1'                         RWBAK:
  11D1'   CD 1174'              	CALL	RWQ
  11D4'   51                    	MOV	D,C
  11D5'   CD 1161'              	CALL	HTBQ
  11D8'   DA 11F5'              	JC	RB_OFF
  11DB'   7A                    	MOV	A,D
  11DC'   81                    	ADD	C
  11DD'   5F                    	MOV	E,A		; E = the rows up to that line's first
  11DE'   3A 2E79'              	LDA	RWR+1
  11E1'   B7                    	ORA	A
  11E2'   C2 11F1'              	JNZ	RB_ON
  11E5'   3A 2E78'              	LDA	RWR
  11E8'   57                    	MOV	D,A
  11E9'   7B                    	MOV	A,E
  11EA'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  11EB'   DA 11F1'              	JC	RB_ON
  11EE'   4F                    	MOV	C,A
  11EF'   B7                    	ORA	A
  11F0'   C9                    	RET
  11F1'                         RB_ON:
  11F1'   7B                    	MOV	A,E
  11F2'   C3 11FC'              	JMP	RB_GO
  11F5'                         RB_OFF:
  11F5'   3A 2E77'              	LDA	HTBOF
  11F8'   0F                    	RRC			; CY: that is the file's first line
  11F9'   D8                    	RC
  11FA'   7A                    	MOV	A,D
  11FB'   91                    	SUB	C
  11FC'                         RB_GO:
  11FC'   CD 1182'              	CALL	RWSUB
  11FF'   CD 1145'              	CALL	HTGO
  1202'   3E 01                 	MVI	A,1
  1204'   32 2E7A'              	STA	RWMV
  1207'   CD 1174'              	CALL	RWQ
  120A'   41                    	MOV	B,C
  120B'   0E 01                 	MVI	C,1
  120D'   CD 1126'              	CALL	HTRB
  1210'   43                    	MOV	B,E
  1211'   C3 11D1'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  1214'                         ONFST:
  1214'   E5                    	PUSH	H
  1215'   2A 0000*              	LHLD	OUTPOS
  1218'   7C                    	MOV	A,H
  1219'   B5                    	ORA	L
  121A'   C2 1232'              	JNZ	OF_RET
  121D'   2A 0000*              	LHLD	TXTBEG
  1220'   EB                    	XCHG			; DE = TXTBEG
  1221'   2A 0000*              	LHLD	GAPBEG
  1224'                         OF_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  1224'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  1227'   CA 1232'              	JZ	OF_RET
  122A'   2B                    	DCX	H
  122B'   7E                    	MOV	A,M
  122C'   FE 0A                 	CPI	LF
  122E'   C2 1224'              	JNZ	OF_LP
  1231'   B7                    	ORA	A		; NZ
  1232'                         OF_RET:
  1232'   E1                    	POP	H
  1233'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  1234'                         HFCNT:
  1234'   2A 2E60'              	LHLD	CMDCNT
  1237'   7C                    	MOV	A,H
  1238'   B5                    	ORA	L
  1239'   CA 1250'              	JZ	HFC_AM
  123C'   CD 077D'              	CALL	GETCNT		; HL = count; clears it
  123F'   3A 0000*              	LDA	NEDIT
  1242'   5F                    	MOV	E,A
  1243'   16 00                 	MVI	D,0
  1245'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  1248'   D2 124C'              	JNC	HFC_ST
  124B'   EB                    	XCHG			; HL = NEDIT
  124C'                         HFC_ST:
  124C'   7D                    	MOV	A,L
  124D'   32 2E6F'              	STA	HFAMT
  1250'                         HFC_AM:
  1250'   3A 2E6F'              	LDA	HFAMT
  1253'   B7                    	ORA	A
  1254'   C2 1261'              	JNZ	HFC_HL
  1257'   3A 0000*              	LDA	NEDIT
  125A'   B7                    	ORA	A
  125B'   1F                    	RAR
  125C'   B7                    	ORA	A
  125D'   C2 1261'              	JNZ	HFC_HL
  1260'   3C                    	INR	A		; at least one row
  1261'                         HFC_HL:
  1261'   32 2E70'              	STA	HFN
  1264'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  1265'                         VC_REDR:
  1265'   C3 077D'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (PLACE) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  1268'                         VC_G:
  1268'   CD 0852'              	CALL	SETMOV
  126B'   CD 132A'              	CALL	GZONE		; the screen's top line, before the move
  126E'   CD 07A6'              	CALL	BRKON		; ... and an ESC may stop it from here on
  1271'   2A 2E60'              	LHLD	CMDCNT
  1274'   7C                    	MOV	A,H
  1275'   B5                    	ORA	L
  1276'   C2 1289'              	JNZ	VG_N
  1279'   AF                    	XRA	A		; forward
  127A'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  127D'   CD 07E3'              	CALL	BRKOFF
  1280'   DA 07FB'              	JC	BRKBAK
  1283'   CD 0B3A'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  1286'   C3 1342'              	JMP	GPLACE
  1289'                         VG_N:
  1289'   CD 077D'              	CALL	GETCNT		; HL = target line (1-based)
  128C'                         VG_LN:
  128C'   CD 1298'              	CALL	GOLN
  128F'   CD 07E3'              	CALL	BRKOFF
  1292'   DA 07FB'              	JC	BRKBAK
  1295'   C3 1342'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  1298'                         GOLN:
  1298'   E5                    	PUSH	H
  1299'   CD 0000*              	CALL	CNTLF
  129C'   23                    	INX	H		; HL = the cursor's line
  129D'   D1                    	POP	D		; DE = the line wanted
  129E'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  12A1'   DA 12AC'              	JC	GLN_BK
  12A4'   EB                    	XCHG
  12A5'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  12A8'   AF                    	XRA	A
  12A9'   C3 12B1'              	JMP	GLN_MV
  12AC'                         GLN_BK:
  12AC'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  12AF'   3E FF                 	MVI	A,0FFH
  12B1'                         GLN_MV:
  12B1'   CD 0000*              	CALL	MVLIND
  12B4'   CD 0B34'              	CALL	ATEOF
  12B7'   DC 0B3A'              	CC	LASTLN		; past the last line: onto it
  12BA'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12BB'                         VC_LG:
  12BB'   CD 0852'              	CALL	SETMOV
  12BE'   3A 2E96'              	LDA	GSAVE
  12C1'   B7                    	ORA	A
  12C2'   C2 12CB'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  12C5'   3E 01                 	MVI	A,PG
  12C7'   32 2E95'              	STA	GPEND
  12CA'   C9                    	RET
  12CB'                         VLG_GG:
  12CB'   CD 132A'              	CALL	GZONE
  12CE'   CD 07A6'              	CALL	BRKON
  12D1'   CD 077D'              	CALL	GETCNT		; HL = target line (no count: 1)
  12D4'   C3 128C'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  12D7'                         SUB24:
  12D7'   4F                    	MOV	C,A
  12D8'   7D                    	MOV	A,L
  12D9'   93                    	SUB	E
  12DA'   6F                    	MOV	L,A
  12DB'   7C                    	MOV	A,H
  12DC'   9A                    	SBB	D
  12DD'   67                    	MOV	H,A
  12DE'   79                    	MOV	A,C
  12DF'   98                    	SBB	B
  12E0'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  12E1'                         CURFP:
  12E1'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  12E4'                         FPOS:
  12E4'   C5                    	PUSH	B
  12E5'   D5                    	PUSH	D
  12E6'   EB                    	XCHG
  12E7'   2A 0000*              	LHLD	TXTBEG
  12EA'   EB                    	XCHG
  12EB'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  12EE'   EB                    	XCHG			; DE = that
  12EF'   2A 0000*              	LHLD	OUTPOS
  12F2'   7C                    	MOV	A,H
  12F3'   B7                    	ORA	A		; CY = 0
  12F4'   1F                    	RAR
  12F5'   47                    	MOV	B,A
  12F6'   7D                    	MOV	A,L
  12F7'   1F                    	RAR
  12F8'   67                    	MOV	H,A
  12F9'   3E 00                 	MVI	A,0
  12FB'   1F                    	RAR
  12FC'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  12FD'   19                    	DAD	D
  12FE'   78                    	MOV	A,B
  12FF'   CE 00                 	ACI	0		; A:HL = the position
  1301'   D1                    	POP	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  1302'   C1                    	POP	B
  1303'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  1304'                         ZSAVE:
  1304'   2A 2E60'              	LHLD	CMDCNT
  1307'   22 2ED2'              	SHLD	ZSVCNT
  130A'   2A 0000*              	LHLD	AUXCNT
  130D'   22 2ED4'              	SHLD	ZSVAUX
  1310'   3A 0000*              	LDA	DIRFLG
  1313'   32 2ED6'              	STA	ZSVDIR
  1316'   C9                    	RET
  1317'                         ZREST:
  1317'   2A 2ED2'              	LHLD	ZSVCNT
  131A'   22 2E60'              	SHLD	CMDCNT
  131D'   2A 2ED4'              	LHLD	ZSVAUX
  1320'   22 0000*              	SHLD	AUXCNT
  1323'   3A 2ED6'              	LDA	ZSVDIR
  1326'   32 0000*              	STA	DIRFLG
  1329'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  132A'                         GZONE:
  132A'   CD 1304'              	CALL	ZSAVE
  132D'   CD 0E18'              	CALL	CURRW
  1330'   6F                    	MOV	L,A
  1331'   26 00                 	MVI	H,0
  1333'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  1336'   CD 12E4'              	CALL	FPOS
  1339'   22 0000*              	SHLD	ZTOP
  133C'   32 0002*              	STA	ZTOP+2
  133F'   C3 1317'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  1342'                         GPLACE:
  1342'   CD 1304'              	CALL	ZSAVE
  1345'   CD 12E1'              	CALL	CURFP
  1348'   EB                    	XCHG
  1349'   2A 0000*              	LHLD	ZTOP
  134C'   EB                    	XCHG
  134D'   4F                    	MOV	C,A		; C:HL = the target's position
  134E'   3A 0002*              	LDA	ZTOP+2
  1351'   47                    	MOV	B,A		; B:DE = the top's
  1352'   79                    	MOV	A,C
  1353'   CD 12D7'              	CALL	SUB24
  1356'   22 2ECF'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  1359'   DA 1393'              	JC	GP_UP
  135C'   B7                    	ORA	A
  135D'   C2 13D9'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  1360'   3A 0000*              	LDA	NEDIT
  1363'   87                    	ADD	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  1364'   3C                    	INR	A
  1365'   6F                    	MOV	L,A
  1366'   26 00                 	MVI	H,0
  1368'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  136B'   CD 0776'              	CALL	GBSUB		; HL = bytes from there to the target
  136E'   EB                    	XCHG
  136F'   2A 2ECF'              	LHLD	ZDIF		; HL = bytes from the top to the target
  1372'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  1375'   DA 13D9'              	JC	GP_MID
  1378'   CD 0776'              	CALL	GBSUB		; HL = the top line's start (resident)
  137B'   01 0000               	LXI	B,0		; BC = lines from the top
  137E'                         GP_CNT:
  137E'   7A                    	MOV	A,D
  137F'   B3                    	ORA	E
  1380'   CA 138F'              	JZ	GP_DN
  1383'   7E                    	MOV	A,M
  1384'   23                    	INX	H
  1385'   1B                    	DCX	D
  1386'   FE 0A                 	CPI	LF
  1388'   C2 137E'              	JNZ	GP_CNT
  138B'   03                    	INX	B
  138C'   C3 137E'              	JMP	GP_CNT
  138F'                         GP_DN:
  138F'   79                    	MOV	A,C		; the lines from the top one to it
  1390'   C3 1403'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  1393'                         GP_UP:
  1393'   3C                    	INR	A
  1394'   C2 13D9'              	JNZ	GP_MID		; 64K bytes or more above
  1397'   2A 2ECF'              	LHLD	ZDIF
  139A'   EB                    	XCHG
  139B'   21 0000               	LXI	H,0
  139E'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  13A1'   7C                    	MOV	A,H
  13A2'   B5                    	ORA	L
  13A3'   CA 13D9'              	JZ	GP_MID		; exactly 64K
  13A6'   EB                    	XCHG			; DE = bytes to read
  13A7'   AF                    	XRA	A
  13A8'   32 2ED1'              	STA	ZLF
  13AB'   CD 0000*              	CALL	RGET0
  13AE'                         GP_RD:
  13AE'   CD 0000*              	CALL	RDGET		; (keeps DE)
  13B1'   DA 13D9'              	JC	GP_MID
  13B4'   FE 0A                 	CPI	LF
  13B6'   C2 13CA'              	JNZ	GP_RN
  13B9'   3A 0000*              	LDA	NEDIT
  13BC'   B7                    	ORA	A
  13BD'   1F                    	RAR
  13BE'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  13C0'   E5                    	PUSH	H
  13C1'   21 2ED1'              	LXI	H,ZLF
  13C4'   34                    	INR	M
  13C5'   BE                    	CMP	M		; CY iff more lines than that
  13C6'   E1                    	POP	H
  13C7'   DA 13D9'              	JC	GP_MID
  13CA'                         GP_RN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  13CA'   1B                    	DCX	D
  13CB'   7A                    	MOV	A,D
  13CC'   B3                    	ORA	E
  13CD'   C2 13AE'              	JNZ	GP_RD
  13D0'   3E 01                 	MVI	A,PL_SET	; the top row
  13D2'   32 0000*              	STA	PLACE
  13D5'   AF                    	XRA	A
  13D6'   C3 13E3'              	JMP	GP_SET
  13D9'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  13D9'   3E 02                 	MVI	A,PL_MID
  13DB'   32 0000*              	STA	PLACE		; mid-screen, as the rows fall
  13DE'   3A 0000*              	LDA	NEDIT
  13E1'   B7                    	ORA	A
  13E2'   1F                    	RAR			; (no more lines above it than this)
  13E3'                         GP_SET:
  13E3'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  13E4'   26 00                 	MVI	H,0
  13E6'   22 0000*              	SHLD	WINROW
  13E9'   21 0000               	LXI	H,0
  13EC'   22 0000*              	SHLD	LNDLT
  13EF'   CD 088F'              	CALL	SETFUL		; the window may have paged: full repaint
  13F2'                         GP_FIN:
  13F2'   CD 1317'              	CALL	ZREST
  13F5'   3A 2EFA'              	LDA	GPKEEP
  13F8'   B7                    	ORA	A
  13F9'   CA 094B'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  13FC'   AF                    	XRA	A
  13FD'   32 2EFA'              	STA	GPKEEP
  1400'   C3 0608'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
                                ; adds LNDLT to it and arrives at the same line.
  1403'                         GP_ONS:
  1403'   6F                    	MOV	L,A
  1404'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  1406'   EB                    	XCHG
  1407'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  140A'   EB                    	XCHG
  140B'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  140E'   22 0000*              	SHLD	LNDLT
  1411'   3E 01                 	MVI	A,R_MOVE
  1413'   32 2E64'              	STA	RINTENT
  1416'   C3 13F2'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  1419'                         OPPEND:
  1419'   AF                    	XRA	A
  141A'   32 2E9B'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  141D'   3A 2E98'              	LDA	PSAVE
  1420'   FE 63                 	CPI	'c'
  1422'   C2 143F'              	JNZ	OPP_ND
  1425'   79                    	MOV	A,C
  1426'   FE 77                 	CPI	'w'
  1428'   CA 1430'              	JZ	OPP_W
  142B'   FE 57                 	CPI	'W'
  142D'   C2 143F'              	JNZ	OPP_ND
  1430'                         OPP_W:
  1430'   CD 1612'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  1433'   DA 143F'              	JC	OPP_ND
  1436'   79                    	MOV	A,C
  1437'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  1439'   4F                    	MOV	C,A
  143A'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  143C'   32 2E9B'              	STA	CWEOL		;   char for the next word's: see ESTEP
  143F'                         OPP_ND:
  143F'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  1440'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  1442'   C2 1456'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  1445'   CD 01F9'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  1448'   DA 14E6'              	JC	OPABRT
  144B'   79                    	MOV	A,C
  144C'   FE 67                 	CPI	'g'
  144E'   C2 14E6'              	JNZ	OPABRT
  1451'   3E 01                 	MVI	A,PG
  1453'   32 2E96'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  1456'                         OPP_NG:
  1456'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  1457'   21 2E98'              	LXI	H,PSAVE
  145A'   BE                    	CMP	M
  145B'   CA 1633'              	JZ	OPLINE
  145E'   79                    	MOV	A,C		; (OPCLS classifies the key)
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  145F'   CD 1649'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1462'   DA 14E6'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  1465'   32 2E9A'              	STA	OPCLSV
  1468'   47                    	MOV	B,A		; B = the class
  1469'   3A 2E98'              	LDA	PSAVE
  146C'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  146E'   C2 147A'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  1471'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  1472'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  1474'   C2 149C'              	JNZ	OPP_GO
  1477'   C3 1485'              	JMP	OPP_NO
  147A'                         OPP_NC:
  147A'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  147C'   C2 149C'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  147F'   78                    	MOV	A,B		;   a charwise register would need a type flag
  1480'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  1482'   CA 149C'              	JZ	OPP_GO		;   within a line -- neither of which is built
  1485'                         OPP_NO:
  1485'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  1486'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  1488'   CA 1496'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  148B'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  148D'   CA 1496'              	JZ	OPP_SW		;   so swallow it before dropping the command
  1490'   CD 0326'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  1493'   C2 14E6'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  1496'                         OPP_SW:
  1496'   CD 01F9'              	CALL	MKGETK
  1499'   C3 14E6'              	JMP	OPABRT
  149C'                         OPP_GO:
  149C'   AF                    	XRA	A
  149D'   32 2E6E'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  14A0'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  14A3'   22 2E9C'              	SHLD	OPSTA
  14A6'   C5                    	PUSH	B
  14A7'   21 2EA0'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  14AA'   CD 0429'              	CALL	FPSTO		;   only good until the motion pages the window
  14AD'   3A 2E9A'              	LDA	OPCLSV
  14B0'   FE 02                 	CPI	2
  14B2'   CC 14E9'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  14B5'   C1                    	POP	B
  14B6'   21 2DA7'              	LXI	H,CMDTAB
  14B9'   CD 00C3'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  14BC'   3A 2E98'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  14BF'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  14C0'   CA 0852'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  14C3'   CD 1515'              	CALL	OPSFIX		; where the start is in the window NOW
  14C6'   D2 1531'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  14C9'   22 2E9C'              	SHLD	OPSTA
  14CC'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  14CF'   22 2E9E'              	SHLD	OPEND2
  14D2'   3A 2E98'              	LDA	PSAVE
  14D5'   FE 79                 	CPI	'y'
  14D7'   CA 1BEB'              	JZ	OPYANK		; a yank takes the span without losing it
  14DA'   CD 1684'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  14DD'   3A 2E98'              	LDA	PSAVE
  14E0'   FE 63                 	CPI	'c'
  14E2'   C0                    	RNZ
  14E3'   C3 199F'              	JMP	SETINS
  14E6'                         OPABRT:				; not a motion -> the operator is dropped and
  14E6'   C3 00A6'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  14E9'                         OPENDS:
  14E9'   2A 2E9C'              	LHLD	OPSTA
  14EC'   CD 066F'              	CALL	BOL
  14EF'   11 2EA3'              	LXI	D,OPSLO
  14F2'   CD 1507'              	CALL	OPE_ST
  14F5'   2A 2E9C'              	LHLD	OPSTA
  14F8'   CD 0706'              	CALL	NLSTART
  14FB'   11 2EA6'              	LXI	D,OPSHI
  14FE'   CD 1507'              	CALL	OPE_ST
  1501'   2A 2E9C'              	LHLD	OPSTA
  1504'   C3 0000*              	JMP	GOTO
  1507'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  1507'   D5                    	PUSH	D
  1508'   CD 0000*              	CALL	GOTO
  150B'   E1                    	POP	H
  150C'   C3 0429'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  150F'                         CURBD:
  150F'   CD 12E1'              	CALL	CURFP
  1512'   EB                    	XCHG
  1513'   47                    	MOV	B,A
  1514'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  1515'                         OPSFIX:
  1515'   21 2EA0'              	LXI	H,OPSFP
  1518'   CD 03DC'              	CALL	MKLOAD
  151B'   CD 150F'              	CALL	CURBD
  151E'   2A 2F04'              	LHLD	MKPOS
  1521'   3A 2F06'              	LDA	MKPOS+2
  1524'   CD 12D7'              	CALL	SUB24
  1527'   B4                    	ORA	H
  1528'   B5                    	ORA	L
  1529'   C2 03E9'              	JNZ	MKWIN
  152C'   CD 0000*              	CALL	CUROFF
  152F'   37                    	STC
  1530'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  1531'                         OPPGD:
  1531'   47                    	MOV	B,A
  1532'   3A 2E9A'              	LDA	OPCLSV
  1535'   FE 02                 	CPI	2
  1537'   C2 15F3'              	JNZ	OPG_NO
  153A'   3A 2E98'              	LDA	PSAVE
  153D'   FE 64                 	CPI	'd'
  153F'   C2 15F3'              	JNZ	OPG_NO
  1542'   04                    	INR	B
  1543'   CA 1552'              	JZ	OPG_FW
  1546'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  1549'   CD 066F'              	CALL	BOL		;   and the high end is OPSHI as it stands
  154C'   CD 0000*              	CALL	GOTO
  154F'   C3 156A'              	JMP	OPG_GO
  1552'                         OPG_FW:
  1552'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  1555'   CD 0706'              	CALL	NLSTART		;   landed on, and the low one is where the
  1558'   11 2EA6'              	LXI	D,OPSHI		;   start line began
  155B'   CD 1507'              	CALL	OPE_ST
  155E'   21 2EA3'              	LXI	H,OPSLO
  1561'   CD 03DC'              	CALL	MKLOAD
  1564'   CD 03A9'              	CALL	MKPAGE
  1567'   CD 0000*              	CALL	GOTO
  156A'                         OPG_GO:
  156A'   CD 150F'              	CALL	CURBD
  156D'   2A 2EA6'              	LHLD	OPSHI
  1570'   3A 2EA8'              	LDA	OPSHI+2
  1573'   CD 12D7'              	CALL	SUB24		; A:HL = the bytes to take
  1576'                         OPG_SV:
  1576'   22 2EA9'              	SHLD	OPTOGO
  1579'   32 2EAB'              	STA	OPTOGO+2
  157C'                         OPG_NX:
  157C'   CD 0759'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  157F'   CD 0000*              	CALL	SUBHD
  1582'   EB                    	XCHG			; DE = what the window holds past the cursor
  1583'   2A 2EA9'              	LHLD	OPTOGO
  1586'   3A 2EAB'              	LDA	OPTOGO+2
  1589'   B7                    	ORA	A
  158A'   C2 15BD'              	JNZ	OPG_PG		; 64K or more to go
  158D'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  1590'   DA 15BD'              	JC	OPG_PG
  1593'   CA 15BD'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  1596'                         OPG_FN:				; the rest of it is here
  1596'   E5                    	PUSH	H
  1597'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  159A'   CD 0000*              	CALL	CUROFF
  159D'   22 2EAC'              	SHLD	OPLO
  15A0'   D1                    	POP	D
  15A1'   19                    	DAD	D
  15A2'   22 2EAE'              	SHLD	OPHI
  15A5'   CD 17B7'              	CALL	OPDSPN
  15A8'   CD 0B34'              	CALL	ATEOF
  15AB'   D2 160C'              	JNC	OPMID
  15AE'   CD 1214'              	CALL	ONFST		; deleted to the end of the file: onto the new
  15B1'   CA 160C'              	JZ	OPMID		;   last line, if there is one -- and the pager
  15B4'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  15B7'   CD 0000*              	CALL	SETBWD
  15BA'   C3 160C'              	JMP	OPMID
  15BD'                         OPG_PG:
  15BD'   7A                    	MOV	A,D
  15BE'   B3                    	ORA	E
  15BF'   C2 15D8'              	JNZ	OPG_DL
  15C2'   CD 0B34'              	CALL	ATEOF		; nothing held past the cursor
  15C5'   21 0000               	LXI	H,0
  15C8'   DA 1596'              	JC	OPG_FN		; ... and no more to come: the file ran out
  15CB'   2B                    	DCX	H
  15CC'   CD 0000*              	CALL	SETC0
  15CF'   CD 0000*              	CALL	GOLINE
  15D2'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  15D5'   C3 157C'              	JMP	OPG_NX
  15D8'                         OPG_DL:
  15D8'   D5                    	PUSH	D
  15D9'   21 FFFF               	LXI	H,0FFFFH
  15DC'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  15DF'   E1                    	POP	H
  15E0'   E5                    	PUSH	H
  15E1'   CD 0000*              	CALL	DELFWD
  15E4'   D1                    	POP	D
  15E5'   06 00                 	MVI	B,0
  15E7'   2A 2EA9'              	LHLD	OPTOGO
  15EA'   3A 2EAB'              	LDA	OPTOGO+2
  15ED'   CD 12D7'              	CALL	SUB24
  15F0'   C3 1576'              	JMP	OPG_SV
  15F3'                         OPG_NO:
  15F3'   0E 07                 	MVI	C,BEL
  15F5'   CD 0000*              	CALL	BCONOU
  15F8'                         OPG_HM:				; the cursor back where the command found it
  15F8'   21 2EA0'              	LXI	H,OPSFP
  15FB'   CD 03DC'              	CALL	MKLOAD
  15FE'   CD 03A9'              	CALL	MKPAGE
  1601'   CD 0000*              	CALL	GOTO
  1604'   AF                    	XRA	A
  1605'   32 2E98'              	STA	PSAVE
  1608'   3C                    	INR	A
  1609'   32 2EFA'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  160C'                         OPMID:
  160C'   CD 1304'              	CALL	ZSAVE
  160F'   C3 13D9'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  1612'                         ONWHIT:
  1612'   CD 0759'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1615'   CA 1631'              	JZ	OW_YES
  1618'   CD 0764'              	CALL	CURCHR		; A = the char under the cursor
  161B'   FE 20                 	CPI	' '
  161D'   CA 1631'              	JZ	OW_YES
  1620'   FE 09                 	CPI	TAB
  1622'   CA 1631'              	JZ	OW_YES
  1625'   FE 0D                 	CPI	CR
  1627'   CA 1631'              	JZ	OW_YES
  162A'   FE 0A                 	CPI	LF
  162C'   CA 1631'              	JZ	OW_YES
  162F'   B7                    	ORA	A		; a char to change: CY clear
  1630'   C9                    	RET
  1631'                         OW_YES:
  1631'   37                    	STC
  1632'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  1633'                         OPLINE:
  1633'   3A 2E98'              	LDA	PSAVE
  1636'   FE 63                 	CPI	'c'
  1638'   CA 0852'              	JZ	SETMOV
  163B'   FE 79                 	CPI	'y'
  163D'   CA 1BCA'              	JZ	VY_YY
  1640'   21 2EA0'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1643'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1646'   C3 1B40'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  1649'                         OPCLS:
  1649'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  164B'   CA 1658'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  164E'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  1650'   C2 166C'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1653'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1655'   C3 165A'              	JMP	OPC_FK
  1658'                         OPC_SEM:
  1658'   06 00                 	MVI	B,0		; ';' runs it as it stands
  165A'                         OPC_FK:
  165A'   3A 2EF0'              	LDA	FNDKND
  165D'   B7                    	ORA	A
  165E'   37                    	STC
  165F'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1660'   A8                    	XRA	B		; ... and now the direction ',' asked for
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  1661'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1663'   CA 166A'              	JZ	OPC_EXC
  1666'   3E 01                 	MVI	A,1
  1668'   B7                    	ORA	A		; CY clear: a motion, class 1
  1669'   C9                    	RET
  166A'                         OPC_EXC:
  166A'   AF                    	XRA	A		; class 0, CY clear
  166B'   C9                    	RET
  166C'                         OPC_TB:
  166C'   47                    	MOV	B,A
  166D'   21 185C'              	LXI	H,OPCTAB
  1670'                         OPC_LP:
  1670'   7E                    	MOV	A,M
  1671'   B7                    	ORA	A
  1672'   CA 1682'              	JZ	OPC_MS		; end of table -> not a motion
  1675'   B8                    	CMP	B
  1676'   CA 167E'              	JZ	OPC_HT
  1679'   23                    	INX	H
  167A'   23                    	INX	H
  167B'   C3 1670'              	JMP	OPC_LP
  167E'                         OPC_HT:
  167E'   23                    	INX	H
  167F'   7E                    	MOV	A,M		; class byte
  1680'   B7                    	ORA	A		; clear CY
  1681'   C9                    	RET
  1682'                         OPC_MS:
  1682'   37                    	STC
  1683'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  1684'                         OPAPPL:
  1684'   3A 2E9A'              	LDA	OPCLSV
  1687'   FE 02                 	CPI	2
  1689'   CA 1830'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  168C'   2A 2E9C'              	LHLD	OPSTA
  168F'   EB                    	XCHG			; DE = start
  1690'   2A 2E9E'              	LHLD	OPEND2		; HL = end
  1693'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  1696'   DA 16A9'              	JC	OPA_F
  1699'   CA 16A9'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  169C'   22 2EAC'              	SHLD	OPLO
  169F'   EB                    	XCHG
  16A0'   22 2EAE'              	SHLD	OPHI
  16A3'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  16A6'   C3 1760'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  16A9'                         OPA_F:
  16A9'   EB                    	XCHG			; HL = start, DE = end
  16AA'   22 2EAC'              	SHLD	OPLO
  16AD'   EB                    	XCHG			; HL = end
  16AE'   3A 2E9A'              	LDA	OPCLSV
  16B1'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  16B3'   CA 175D'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  16B6'   FE 01                 	CPI	1
  16B8'   C2 16DA'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  16BB'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  16BC'   22 2EAE'              	SHLD	OPHI		; park it: CEND clobbers DE
  16BF'   2B                    	DCX	H		; the line it landed on
  16C0'   CD 191D'              	CALL	CEND		; HL = that line's content end
  16C3'   EB                    	XCHG			; DE = it
  16C4'   2A 2EAE'              	LHLD	OPHI		; HL = hi
  16C7'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  16CA'   D2 16E5'              	JNC	OPA_HI		; hi is inside the line: keep it
  16CD'   2A 2EAC'              	LHLD	OPLO
  16D0'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  16D3'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  16D6'   EB                    	XCHG			; HL = the content end: the span stops there
  16D7'   C3 16E5'              	JMP	OPA_HI
  16DA'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  16DA'   22 2EAE'              	SHLD	OPHI
  16DD'   3A 2E6E'              	LDA	WPULL
  16E0'   B7                    	ORA	A
  16E1'   CA 1760'              	JZ	OPA_C1
  16E4'   23                    	INX	H
  16E5'                         OPA_HI:
  16E5'   22 2EAE'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  16E8'                         OPA_DO:
  16E8'   CD 17AC'              	CALL	OPSPNL
  16EB'   7C                    	MOV	A,H
  16EC'   B5                    	ORA	L
  16ED'   C2 16F6'              	JNZ	OPA_D1
  16F0'   2A 2EAC'              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  16F3'   C3 0000*              	JMP	GOTO		;   to where the span starts
  16F6'                         OPA_D1:
  16F6'   3A 2E98'              	LDA	PSAVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  16F9'   FE 63                 	CPI	'c'
  16FB'   CA 17B7'              	JZ	OPDSPN
  16FE'   CD 179F'              	CALL	SPNBRK
  1701'   D2 1722'              	JNC	OPA_D2
  1704'   2A 2EAE'              	LHLD	OPHI
  1707'   CD 191D'              	CALL	CEND
  170A'   EB                    	XCHG			; DE = the content end of the line it ends in
  170B'   2A 2EAE'              	LHLD	OPHI
  170E'                         OPA_BL:
  170E'   CD 0000*              	CALL	CMP16
  1711'   CA 1728'              	JZ	OPA_BI		; only blanks after it
  1714'   D5                    	PUSH	D
  1715'   E5                    	PUSH	H
  1716'   CD 0000*              	CALL	CHARAT
  1719'   E1                    	POP	H
  171A'   D1                    	POP	D
  171B'   23                    	INX	H
  171C'   CD 1757'              	CALL	BLANKQ
  171F'   CA 170E'              	JZ	OPA_BL
  1722'                         OPA_D2:
  1722'   CD 17B7'              	CALL	OPDSPN
  1725'   C3 192E'              	JMP	CLAMPE
  1728'                         OPA_BI:
  1728'   CD 173A'              	CALL	LOIND
  172B'   C2 1722'              	JNZ	OPA_D2
  172E'   2A 2EAE'              	LHLD	OPHI
  1731'   CD 0706'              	CALL	NLSTART
  1734'   22 2EAE'              	SHLD	OPHI
  1737'   C3 178B'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  173A'                         LOIND:
  173A'   2A 2EAC'              	LHLD	OPLO
  173D'   CD 066F'              	CALL	BOL
  1740'                         LI_LP:
  1740'   E5                    	PUSH	H
  1741'   EB                    	XCHG
  1742'   2A 2EAC'              	LHLD	OPLO
  1745'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  1748'   E1                    	POP	H
  1749'   C8                    	RZ
  174A'   E5                    	PUSH	H
  174B'   CD 0000*              	CALL	CHARAT
  174E'   E1                    	POP	H
  174F'   23                    	INX	H
  1750'   CD 1757'              	CALL	BLANKQ
  1753'   CA 1740'              	JZ	LI_LP
  1756'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  1757'                         BLANKQ:
  1757'   FE 20                 	CPI	' '
  1759'   C8                    	RZ
  175A'   FE 09                 	CPI	TAB
  175C'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  175D'                         OPA_JP:
  175D'   22 2EAE'              	SHLD	OPHI
  1760'                         OPA_C1:
  1760'   CD 17AC'              	CALL	OPSPNL
  1763'   7C                    	MOV	A,H
  1764'   B5                    	ORA	L
  1765'   CA 16E8'              	JZ	OPA_DO		; nothing spanned
  1768'   2A 2EAE'              	LHLD	OPHI
  176B'   CD 066F'              	CALL	BOL
  176E'   EB                    	XCHG
  176F'   2A 2EAE'              	LHLD	OPHI
  1772'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  1775'   C2 16E8'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  1778'   CD 173A'              	CALL	LOIND
  177B'   CA 178B'              	JZ	C1_LW		; only blanks before lo: whole lines
  177E'                         C1_CH:
  177E'   2A 2EAE'              	LHLD	OPHI		; back over the line break to the content end
  1781'   2B                    	DCX	H		;   of the line before
  1782'   CD 191D'              	CALL	CEND
  1785'   22 2EAE'              	SHLD	OPHI
  1788'   C3 16E8'              	JMP	OPA_DO
  178B'                         C1_LW:
  178B'   2A 2EAC'              	LHLD	OPLO
  178E'   CD 066F'              	CALL	BOL
  1791'   22 2EAC'              	SHLD	OPLO
  1794'   3A 2E98'              	LDA	PSAVE
  1797'   FE 63                 	CPI	'c'
  1799'   CA 177E'              	JZ	C1_CH
  179C'   C3 1843'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  179F'                         SPNBRK:
  179F'   2A 2EAC'              	LHLD	OPLO
  17A2'   CD 06B2'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  17A5'   EB                    	XCHG			; DE = it
  17A6'   2A 2EAE'              	LHLD	OPHI
  17A9'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  17AC'                         OPSPNL:
  17AC'   2A 2EAE'              	LHLD	OPHI
  17AF'   EB                    	XCHG
  17B0'   2A 2EAC'              	LHLD	OPLO
  17B3'   EB                    	XCHG			; HL = hi, DE = lo
  17B4'   C3 0000*              	JMP	SUBHD
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
                                ; No break in it: 'dw' 'cw' 'D' changed one row, and only that row is stale.
                                ; And from where the cursor was on (OPSTA: 'dw', not 'db'), the terminal may
                                ; close the cells up.
  17B7'                         OPDSPN:
  17B7'   CD 179F'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  17BA'   F5                    	PUSH	PSW
  17BB'   2A 2E9C'              	LHLD	OPSTA
  17BE'   EB                    	XCHG
  17BF'   2A 2EAC'              	LHLD	OPLO
  17C2'   22 2EB4'              	SHLD	WKI
  17C5'   CD 0000*              	CALL	CMP16
  17C8'   F5                    	PUSH	PSW		; Z: the span starts under the screen's cursor
  17C9'   CD 0000*              	CALL	GOTO
  17CC'   CD 17AC'              	CALL	OPSPNL		; HL = hi - lo
  17CF'   CD 0858'              	CALL	SETLIN
  17D2'   F1                    	POP	PSW
  17D3'   CC 18EC'              	CZ	DCHQ
  17D6'   CD 0000*              	CALL	DELFWD
  17D9'   CD 0174'              	CALL	MARKMOD
  17DC'   F1                    	POP	PSW
  17DD'   D0                    	RNC
  17DE'   C3 088F'              	JMP	SETFUL		; a break went: every row below it moved up
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  17E1'                         UNDFNB:
  17E1'   CD 0000*              	CALL	CUROFF
  17E4'   E5                    	PUSH	H
  17E5'   CD 094B'              	CALL	FNBLNK
  17E8'   CD 0000*              	CALL	CUROFF
  17EB'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  17EC'   CD 0000*              	CALL	CMP16
  17EF'   D2 0000*              	JNC	UNDHER
  17F2'   EB                    	XCHG
  17F3'   CD 0000*              	CALL	GOTO
  17F6'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  17F9'                         OPALSP:
  17F9'   2A 2E9C'              	LHLD	OPSTA
  17FC'   EB                    	XCHG
  17FD'   2A 2E9E'              	LHLD	OPEND2
  1800'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  1803'   DA 1813'              	JC	OPAL_F
  1806'   22 2EAC'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1809'   EB                    	XCHG
  180A'   22 2EAE'              	SHLD	OPHI		; hi-src = start
  180D'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  1810'   C3 181D'              	JMP	OPAL_R
  1813'                         OPAL_F:
  1813'   EB                    	XCHG			; HL = start
  1814'   22 2EAC'              	SHLD	OPLO		; lo-src = start
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  1817'   2A 2E9E'              	LHLD	OPEND2
  181A'   22 2EAE'              	SHLD	OPHI		; hi-src = end
  181D'                         OPAL_R:
  181D'   2A 2EAC'              	LHLD	OPLO
  1820'   CD 066F'              	CALL	BOL
  1823'   22 2EAC'              	SHLD	OPLO		; lo = BOL(low line)
  1826'   2A 2EAE'              	LHLD	OPHI
  1829'   CD 0706'              	CALL	NLSTART
  182C'   22 2EAE'              	SHLD	OPHI		; hi = start of line past the high line
  182F'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  1830'                         OPALIN:
  1830'   CD 17F9'              	CALL	OPALSP
  1833'   2A 2EAC'              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  1836'   CD 0706'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  1839'   EB                    	XCHG			;   the column)
  183A'   2A 2EAE'              	LHLD	OPHI
  183D'   CD 0000*              	CALL	CMP16
  1840'   CC 17E1'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  1843'                         OPDLIN:
  1843'   CD 17B7'              	CALL	OPDSPN
  1846'   CD 0759'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1849'   DA 1859'              	JC	OPDL_NB
  184C'   CD 0000*              	CALL	LOGLEN
  184F'   7C                    	MOV	A,H
  1850'   B5                    	ORA	L
  1851'   C8                    	RZ			; empty buffer
  1852'   2B                    	DCX	H
  1853'   CD 066F'              	CALL	BOL
  1856'   CD 0000*              	CALL	GOTO
  1859'                         OPDL_NB:
  1859'   C3 094B'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  185C'                         OPCTAB:
  185C'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1860'   62 00 42 00           
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  1864'   68 00 6C 00           
  1868'   30 00 5E 00           
  186C'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  186E'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1872'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1876'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  187A'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  187E'   24 01                 
  1880'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1884'   47 02 48 02           
  1888'   4D 02 4C 02           
  188C'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  188E'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1890'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1891'                         VCB_C:
  1891'   CD 189D'              	CALL	VCB_CD
  1894'   C3 199F'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  1897'                         VCB_D:
  1897'   CD 189D'              	CALL	VCB_CD
  189A'   C3 192E'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  189D'                         VCB_CD:
  189D'   CD 0770'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  18A0'   22 2EAC'              	SHLD	OPLO
  18A3'   22 2E9C'              	SHLD	OPSTA
  18A6'   CD 0000*              	CALL	CUROFF
  18A9'   CD 191D'              	CALL	CEND		; to the line's content end, the CR,LF left
  18AC'   22 2EAE'              	SHLD	OPHI
  18AF'   C3 17B7'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  18B2'                         VC_X:
  18B2'   CD 09FD'              	CALL	GLSTAL
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  18B5'   CD 0858'              	CALL	SETLIN
  18B8'   CD 077D'              	CALL	GETCNT
  18BB'   22 2EB0'              	SHLD	CNTV
  18BE'   CD 0000*              	CALL	CUROFF
  18C1'   22 2EB4'              	SHLD	WKI		; cur
  18C4'   CD 191D'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  18C7'   EB                    	XCHG			; DE = contentend
  18C8'   2A 2EB4'              	LHLD	WKI		; HL = cur
  18CB'   EB                    	XCHG			; HL = contentend, DE = cur
  18CC'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  18CF'   7C                    	MOV	A,H
  18D0'   B5                    	ORA	L
  18D1'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  18D2'   EB                    	XCHG			; DE = available
  18D3'   2A 2EB0'              	LHLD	CNTV		; HL = count
  18D6'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  18D9'   DA 18DF'              	JC	VX_USEA
  18DC'   C3 18E0'              	JMP	VX_DEL		; count <= available -> HL = count = del
  18DF'                         VX_USEA:
  18DF'   EB                    	XCHG			; HL = available
  18E0'                         VX_DEL:
  18E0'   CD 18EC'              	CALL	DCHQ
  18E3'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  18E6'   CD 0174'              	CALL	MARKMOD
  18E9'   C3 192E'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;DCHQ -- HL bytes are about to go from under the cursor, none of them a line
                                ; end, and WKI is the cursor's offset.  Plain chars, and plain chars after
                                ; them: the terminal can close the cells up itself (R_DCH).  A TAB there would
                                ; change width.  Keeps HL.
  18EC'                         DCHQ:
  18EC'   E5                    	PUSH	H
  18ED'   CD 0895'              	CALL	TAILTAB
  18F0'   E1                    	POP	H
  18F1'   47                    	MOV	B,A
  18F2'   7C                    	MOV	A,H		; (more of them than a byte counts)
  18F3'   B7                    	ORA	A
  18F4'   C0                    	RNZ
  18F5'   B5                    	ORA	L
  18F6'   C8                    	RZ			; (or none at all)
  18F7'   32 2E67'              	STA	DCHN
  18FA'   78                    	MOV	A,B
  18FB'   87                    	ADD	A
  18FC'   32 2E68'              	STA	DCHBS		; 2: a TAB follows, to take the cells up
  18FF'   CA 1917'              	JZ	DQ_0
  1902'   7D                    	MOV	A,L		; ... if it is past what goes, and can
  1903'   FE 08                 	CPI	8
  1905'   D0                    	RNC
  1906'   E5                    	PUSH	H
  1907'   2A 2EB4'              	LHLD	WKI
  190A'   EB                    	XCHG
  190B'   2A 2EB2'              	LHLD	TTI
  190E'   CD 0000*              	CALL	SUBHD
  1911'   EB                    	XCHG			; DE = the chars before it
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  1912'   E1                    	POP	H
  1913'   CD 0000*              	CALL	CMP16
  1916'   D8                    	RC
  1917'                         DQ_0:
  1917'   3E 07                 	MVI	A,R_DCH
  1919'   32 2E64'              	STA	RINTENT
  191C'   C9                    	RET
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  191D'                         CEND:
  191D'   CD 06B2'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1920'   7C                    	MOV	A,H
  1921'   B5                    	ORA	L
  1922'   C8                    	RZ			; the start of the text: nothing before it
  1923'   2B                    	DCX	H
  1924'   E5                    	PUSH	H
  1925'   CD 0000*              	CALL	CHARAT
  1928'   E1                    	POP	H		; HL = term-1
  1929'   FE 0D                 	CPI	CR
  192B'   C8                    	RZ			; a CR before the LF -> the content ends there
  192C'   23                    	INX	H
  192D'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  192E'                         CLAMPE:
  192E'   CD 0000*              	CALL	CUROFF
  1931'   E5                    	PUSH	H
  1932'   CD 0715'              	CALL	EOLC
  1935'   D1                    	POP	D		; DE = cur
  1936'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  1939'   D8                    	RC
  193A'   C8                    	RZ
  193B'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  193E'                         VC_I:
  193E'   CD 077D'              	CALL	GETCNT
  1941'   C3 199C'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1944'                         VC_A:
  1944'   CD 077D'              	CALL	GETCNT
  1947'   CD 0759'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  194A'   CA 1961'              	JZ	VA_INS
  194D'   EB                    	XCHG			; HL = cur
  194E'   E5                    	PUSH	H
  194F'   CD 0000*              	CALL	CHARAT
  1952'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  1953'   FE 0A                 	CPI	LF
  1955'   CA 1961'              	JZ	VA_INS		; on the line terminator -> append in place
  1958'   FE 0D                 	CPI	CR
  195A'   CA 1961'              	JZ	VA_INS
  195D'   23                    	INX	H
  195E'   CD 0000*              	CALL	GOTO
  1961'                         VA_INS:
  1961'   C3 199C'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1964'                         VCB_A:
  1964'   CD 0770'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1967'   CD 0715'              	CALL	EOLC		; HL = last content char (the start when empty)
  196A'   E5                    	PUSH	H
  196B'   CD 0000*              	CALL	CHARAT
  196E'   E1                    	POP	H
  196F'   FE 0D                 	CPI	CR
  1971'   CA 197A'              	JZ	VBA_IN		; an empty line: insert at its start
  1974'   FE 0A                 	CPI	LF
  1976'   CA 197A'              	JZ	VBA_IN
  1979'   23                    	INX	H		; past the last content char
  197A'                         VBA_IN:
  197A'   CD 0000*              	CALL	GOTO
  197D'   C3 199C'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1980'                         VCB_I:
  1980'   CD 077D'              	CALL	GETCNT
  1983'   CD 094B'              	CALL	FNBLNK
  1986'   CD 0000*              	CALL	CUROFF
  1989'   E5                    	PUSH	H
  198A'   CD 0000*              	CALL	CHARAT
  198D'   E1                    	POP	H
  198E'   FE 20                 	CPI	' '
  1990'   CA 1998'              	JZ	VBI_SK
  1993'   FE 09                 	CPI	TAB
  1995'   C2 199C'              	JNZ	SETINM
  1998'                         VBI_SK:
  1998'   23                    	INX	H		; blanks only: past the last of them
  1999'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  199C'                         SETINM:
  199C'   CD 0852'              	CALL	SETMOV
  199F'                         SETINS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  199F'   3E 01                 	MVI	A,EM_INS
  19A1'   32 2E5F'              	STA	EDMODE
  19A4'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  19A5'                         ATCEND:
  19A5'   CD 0759'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  19A8'   C8                    	RZ
  19A9'   CD 0764'              	CALL	CURCHR		; A = the char under the cursor
  19AC'   FE 0D                 	CPI	CR
  19AE'   C8                    	RZ
  19AF'   FE 0A                 	CPI	LF
  19B1'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  19B2'                         OPNBRK:
  19B2'   CD 22DC'              	CALL	PUTBRK
  19B5'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  19B8'   23                    	INX	H
  19B9'   22 0000*              	SHLD	LNDLT
  19BC'   C3 0174'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  19BF'                         ENDBRK:
  19BF'   CD 0759'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  19C2'   C0                    	RNZ
  19C3'   CD 19B2'              	CALL	OPNBRK
  19C6'   CD 0000*              	CALL	CUROFF
  19C9'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  19CA'   2B                    	DCX	H		;   line, with its own terminator after it
  19CB'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  19CE'                         VC_O:
  19CE'   CD 0770'              	CALL	CNTOFF		; the count is spent; HL = the cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  19D1'   CD 191D'              	CALL	CEND
  19D4'   CD 0000*              	CALL	GOTO
  19D7'   CD 19B2'              	CALL	OPNBRK
  19DA'   CD 19BF'              	CALL	ENDBRK		; a last line with no line end: the opened line
  19DD'   CD 087A'              	CALL	SETILN		;   needs a terminator of its own to exist
  19E0'   C3 199F'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  19E3'                         VCB_O:
  19E3'   CD 0770'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  19E6'   CD 066F'              	CALL	BOL
  19E9'   CD 0000*              	CALL	GOTO
  19EC'   CD 19B2'              	CALL	OPNBRK
  19EF'   CD 0000*              	CALL	CUROFF
  19F2'   2B                    	DCX	H
  19F3'   2B                    	DCX	H
  19F4'   CD 0000*              	CALL	GOTO
  19F7'   CD 087A'              	CALL	SETILN
  19FA'   C3 199F'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  19FD'                         VCB_J:
  19FD'   CD 0770'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A00'   CD 191D'              	CALL	CEND		; the join point: this line's content end
  1A03'   22 2EAC'              	SHLD	OPLO
  1A06'   CD 0000*              	CALL	CUROFF
  1A09'   CD 0706'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1A0C'   E5                    	PUSH	H
  1A0D'   CD 0000*              	CALL	LOGLEN
  1A10'   D1                    	POP	D		; DE = that start
  1A11'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1A14'   CA 0852'              	JZ	SETMOV
  1A17'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1A18'                         VJ_WS:
  1A18'   E5                    	PUSH	H
  1A19'   CD 0000*              	CALL	LOGLEN
  1A1C'   D1                    	POP	D		; DE = the scan
  1A1D'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1A20'   CA 1A37'              	JZ	VJ_DEL
  1A23'   EB                    	XCHG			; HL = the scan
  1A24'   E5                    	PUSH	H
  1A25'   CD 0000*              	CALL	CHARAT
  1A28'   E1                    	POP	H
  1A29'   FE 20                 	CPI	' '
  1A2B'   CA 1A33'              	JZ	VJ_SKIP
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1A2E'   FE 09                 	CPI	TAB
  1A30'   C2 1A37'              	JNZ	VJ_DEL
  1A33'                         VJ_SKIP:
  1A33'   23                    	INX	H
  1A34'   C3 1A18'              	JMP	VJ_WS
  1A37'                         VJ_DEL:
  1A37'   22 2EAE'              	SHLD	OPHI
  1A3A'   CD 17B7'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1A3D'   CD 0889'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1A40'   CD 0759'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1A43'   CA 192E'              	JZ	CLAMPE
  1A46'   CD 0764'              	CALL	CURCHR		; the first char of what was appended
  1A49'   FE 0D                 	CPI	CR
  1A4B'   CA 192E'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1A4E'   FE 0A                 	CPI	LF
  1A50'   CA 192E'              	JZ	CLAMPE
  1A53'   FE 29                 	CPI	')'
  1A55'   CA 192E'              	JZ	CLAMPE		; vim puts no space before a ')'
  1A58'   CD 0000*              	CALL	CUROFF
  1A5B'   7C                    	MOV	A,H
  1A5C'   B5                    	ORA	L
  1A5D'   CA 1A73'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1A60'   2B                    	DCX	H
  1A61'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1A64'   FE 20                 	CPI	' '
  1A66'   CA 192E'              	JZ	CLAMPE
  1A69'   FE 09                 	CPI	TAB
  1A6B'   CA 192E'              	JZ	CLAMPE
  1A6E'   FE 0A                 	CPI	LF
  1A70'   CA 192E'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1A73'                         VJ_SP:
  1A73'   3E 20                 	MVI	A,' '
  1A75'   CD 0000*              	CALL	PUTGAP
  1A78'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1A7B'   2B                    	DCX	H
  1A7C'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1A7F'                         VC_TILD:
  1A7F'   CD 077D'              	CALL	GETCNT
  1A82'   CD 0858'              	CALL	SETLIN		; only this row changes
  1A85'   CD 09FD'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1A88'   CD 0759'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1A8B'   CA 0852'              	JZ	SETMOV
  1A8E'   CD 0764'              	CALL	CURCHR		; A = the char under the cursor
  1A91'   FE 0D                 	CPI	CR
  1A93'   CA 0852'              	JZ	SETMOV		; the line's end: nothing to toggle
  1A96'   FE 0A                 	CPI	LF
  1A98'   CA 0852'              	JZ	SETMOV
  1A9B'   47                    	MOV	B,A
  1A9C'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1A9E'   FE 41                 	CPI	'A'
  1AA0'   DA 1AAC'              	JC	VT_PUT		; below 'A': no case
  1AA3'   FE 5B                 	CPI	'Z'+1
  1AA5'   D2 1AAC'              	JNC	VT_PUT		; above 'Z': no case
  1AA8'   78                    	MOV	A,B
  1AA9'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1AAB'   47                    	MOV	B,A
  1AAC'                         VT_PUT:
  1AAC'   78                    	MOV	A,B
  1AAD'   32 2EBB'              	STA	VRCH		; the calls below do not preserve B
  1AB0'   CD 0174'              	CALL	MARKMOD
  1AB3'   21 0001               	LXI	H,1
  1AB6'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1AB9'   3A 2EBB'              	LDA	VRCH
  1ABC'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1ABF'   C3 192E'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  1AC2'                         VC_R:
  1AC2'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  1AC5'   3E 03                 	MVI	A,PR
  1AC7'   32 2E95'              	STA	GPEND
  1ACA'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1ACB'                         VR_DO:
  1ACB'   AF                    	XRA	A
  1ACC'   32 2E95'              	STA	GPEND
  1ACF'   79                    	MOV	A,C
  1AD0'   32 2EBB'              	STA	VRCH		; the calls below do not preserve C
  1AD3'   CD 0858'              	CALL	SETLIN		; only this row changed
  1AD6'   CD 09FD'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1AD9'   CD 0759'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1ADC'   CA 0852'              	JZ	SETMOV		; the end of the text: vim does nothing
  1ADF'   CD 0764'              	CALL	CURCHR		; A = the char under the cursor
  1AE2'   FE 0D                 	CPI	CR
  1AE4'   CA 0852'              	JZ	SETMOV		; the line's end: nothing to replace
  1AE7'   FE 0A                 	CPI	LF
  1AE9'   CA 0852'              	JZ	SETMOV
  1AEC'   06 02                 	MVI	B,2		; a cell for a cell: the char is the paint
  1AEE'   CD 085E'              	CALL	SETCEL
  1AF1'   CD 0174'              	CALL	MARKMOD
  1AF4'   21 0001               	LXI	H,1
  1AF7'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1AFA'   3A 2EBB'              	LDA	VRCH
  1AFD'   FE 0D                 	CPI	CR
  1AFF'   CA 1B0C'              	JZ	VR_CR
  1B02'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1B05'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1B08'   2B                    	DCX	H		;   out, which moves every logical offset
  1B09'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1B0C'                         VR_CR:
  1B0C'   CD 19B2'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1B0F'   CD 19BF'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1B12'   CD 087A'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1B15'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1B17'   32 2E6A'              	STA	ILABOV
  1B1A'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1B1B'                         VCB_R:
  1B1B'   CD 077D'              	CALL	GETCNT
  1B1E'   CD 0852'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1B21'   21 0000               	LXI	H,0
  1B24'   22 2EBC'              	SHLD	RPDEL		; nothing of ours to put back yet
  1B27'   22 2EBE'              	SHLD	RPAPP
  1B2A'   3E 02                 	MVI	A,EM_REP
  1B2C'   32 2E5F'              	STA	EDMODE
  1B2F'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1B30'                         VC_D:
  1B30'   3E 64                 	MVI	A,'d'
  1B32'   32 2E97'              	STA	PENDOP
  1B35'   C3 0852'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1B38'                         VC_C:
  1B38'   3E 63                 	MVI	A,'c'
  1B3A'   32 2E97'              	STA	PENDOP
  1B3D'   C3 0852'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1B40'                         VD_DD:
  1B40'   CD 09FD'              	CALL	GLSTAL
  1B43'   CD 077D'              	CALL	GETCNT
  1B46'   22 2EB0'              	SHLD	CNTV
  1B49'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1B4B'   32 2E99'              	STA	DDSNG
  1B4E'   2B                    	DCX	H
  1B4F'   7C                    	MOV	A,H
  1B50'   B5                    	ORA	L
  1B51'   C2 1B5F'              	JNZ	VDD_LS
  1B54'   3E 01                 	MVI	A,1
  1B56'   32 2E99'              	STA	DDSNG
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1B59'   CD 17E1'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1B5C'   C3 1B65'              	JMP	VDD_GO
  1B5F'                         VDD_LS:
  1B5F'   CD 09B6'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1B62'   DA 0852'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1B65'                         VDD_GO:
  1B65'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1B68'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1B6B'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1B6E'   CD 253F'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1B71'   CD 0934'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1B74'   2A 2EB0'              	LHLD	CNTV
  1B77'   CD 0000*              	CALL	SETC0
  1B7A'                         VDD_FW:
  1B7A'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1B7D'   DA 1CCB'              	JC	QREFUS		; ... which has no room for them
  1B80'   CD 0792'              	CALL	CNTTST
  1B83'   C2 1B7A'              	JNZ	VDD_FW
  1B86'   CD 0174'              	CALL	MARKMOD
  1B89'   CD 0B34'              	CALL	ATEOF
  1B8C'   D2 1BA7'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1B8F'   3E 00                 	MVI	A,0
  1B91'   32 2E99'              	STA	DDSNG		; deleted to the end: full repaint
  1B94'   CD 1214'              	CALL	ONFST
  1B97'   CA 094B'              	JZ	FNBLNK		; nothing left before it
  1B9A'   21 0001               	LXI	H,1		; onto the new last line
  1B9D'   CD 0000*              	CALL	SETBWD
  1BA0'   2A 0000*              	LHLD	LNDLT
  1BA3'   2B                    	DCX	H
  1BA4'   22 0000*              	SHLD	LNDLT
  1BA7'                         VDD_UP:
  1BA7'   CD 094B'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1BAA'   3A 2E99'              	LDA	DDSNG
  1BAD'   B7                    	ORA	A
  1BAE'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1BAF'   3E 03                 	MVI	A,R_DLIN
  1BB1'   32 2E64'              	STA	RINTENT
  1BB4'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1BB5'                         QEMPTY:
  1BB5'   2A 0000*              	LHLD	QBEG
  1BB8'   EB                    	XCHG
  1BB9'   2A 0000*              	LHLD	QEND
  1BBC'   7C                    	MOV	A,H
  1BBD'   BA                    	CMP	D
  1BBE'   C0                    	RNZ
  1BBF'   7D                    	MOV	A,L
  1BC0'   BB                    	CMP	E
  1BC1'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1BC2'                         VC_Y:
  1BC2'   3E 79                 	MVI	A,'y'
  1BC4'   32 2E97'              	STA	PENDOP
  1BC7'   C3 0852'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1BCA'                         VY_YY:
  1BCA'   21 2EA0'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1BCD'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1BD0'   CD 0000*              	CALL	CUROFF
  1BD3'   22 2EDF'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1BD6'   CD 066F'              	CALL	BOL
  1BD9'   22 2EE1'              	SHLD	YPT		; where the lines come from, to put them back
  1BDC'   CD 1D31'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1BDF'   CD 1D74'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1BE2'   D2 1D38'              	JNC	YNDONE
  1BE5'   21 1B40'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1BE8'   C3 1C14'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1BEB'                         OPYANK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1BEB'   CD 17F9'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1BEE'   2A 2E9C'              	LHLD	OPSTA
  1BF1'   EB                    	XCHG			; DE = start
  1BF2'   2A 2E9E'              	LHLD	OPEND2		; HL = end
  1BF5'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1BF8'   D2 1BFC'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1BFB'   EB                    	XCHG			; ... otherwise the start is
  1BFC'                         OPY_LO:
  1BFC'   22 2EDF'              	SHLD	YOFF
  1BFF'   2A 2EAC'              	LHLD	OPLO
  1C02'   22 2EE1'              	SHLD	YPT		; where the lines come from, to put them back
  1C05'   CD 1D31'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1C08'   CD 1DEC'              	CALL	YNSPAN		; copied where they lie, if there is room
  1C0B'   D2 1D38'              	JNC	YNDONE
  1C0E'   21 1CF2'              	LXI	H,YSPAN
  1C11'   C3 1C14'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1C14'                         YKGO:
  1C14'   22 2F09'              	SHLD	YACT
  1C17'   2A 2EE1'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1C1A'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1C1B'   2A 2EDF'              	LHLD	YOFF		;   survive this -- the put-back below can page
  1C1E'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1C21'   22 2F0F'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1C24'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1C27'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1C28'   2A 2EE1'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1C2B'   EB                    	XCHG			;   window as it was, then names other text
  1C2C'   E1                    	POP	H
  1C2D'   CD 0000*              	CALL	SUBHD
  1C30'   EB                    	XCHG			; DE = how far behind the cursor they start
  1C31'   CD 12E1'              	CALL	CURFP
  1C34'   06 00                 	MVI	B,0
  1C36'   CD 12D7'              	CALL	SUB24
  1C39'   22 2F11'              	SHLD	YPFP
  1C3C'   32 2F13'              	STA	YPFP+2
  1C3F'   3A 2E63'              	LDA	MODF
  1C42'   32 2EDC'              	STA	YMODF
  1C45'   3A 2E8A'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1C48'   32 2EDD'              	STA	YDCHG		;   a yank must not become the last change
  1C4B'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1C4E'   32 2EDE'              	STA	YURPL		;   back are not a change to undo either
  1C51'   3E 01                 	MVI	A,1
  1C53'   32 0000*              	STA	UNDRPL
  1C56'   32 2F08'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1C59'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1C5C'   22 2EEB'              	SHLD	YLDLT
  1C5F'   CD 0000*              	CALL	LOGLEN
  1C62'   22 2F0D'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1C65'   2A 2F09'              	LHLD	YACT
  1C68'   CD 1CCA'              	CALL	YCALL		; the lines out of the file, into the register
  1C6B'   3A 2ED7'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1C6E'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1C70'   CA 1CAE'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1C73'   CD 0000*              	CALL	LOGLEN
  1C76'   EB                    	XCHG
  1C77'   2A 2F0D'              	LHLD	YWAS
  1C7A'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1C7D'   CA 1C8F'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1C80'   21 2F11'              	LXI	H,YPFP		; back to where they came from, by its place in
  1C83'   CD 03DC'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1C86'   CD 03A9'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1C89'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1C8C'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1C8F'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1C8F'   2A 2F11'              	LHLD	YPFP		;   cursor is still owed its place)
  1C92'   EB                    	XCHG
  1C93'   2A 2F0F'              	LHLD	YCOL
  1C96'   19                    	DAD	D
  1C97'   22 2F04'              	SHLD	MKPOS
  1C9A'   3A 2F13'              	LDA	YPFP+2
  1C9D'   CE 00                 	ACI	0
  1C9F'   32 2F06'              	STA	MKPOS+2
  1CA2'   CD 03A9'              	CALL	MKPAGE
  1CA5'   CD 0000*              	CALL	GOTO
  1CA8'                         YK_RST:
  1CA8'   2A 2EEB'              	LHLD	YLDLT
  1CAB'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1CAE'                         YK_RF:
  1CAE'   3A 2EDC'              	LDA	YMODF
  1CB1'   32 2E63'              	STA	MODF
  1CB4'   3A 2EDD'              	LDA	YDCHG
  1CB7'   32 2E8A'              	STA	DOTCHG
  1CBA'   3A 2EDE'              	LDA	YURPL
  1CBD'   32 0000*              	STA	UNDRPL
  1CC0'   AF                    	XRA	A
  1CC1'   32 2F08'              	STA	MKHOLD
  1CC4'   CD 09FD'              	CALL	GLSTAL
  1CC7'   C3 088F'              	JMP	SETFUL		; the cheap paint cannot carry this
  1CCA'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1CCB'                         QREFUS:
  1CCB'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1CCE'   CD 1BB5'              	CALL	QEMPTY
  1CD1'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1CD4'   CD 0000*              	CALL	QKILL
  1CD7'   3A 2F08'              	LDA	MKHOLD
  1CDA'   B7                    	ORA	A
  1CDB'   C2 1CEA'              	JNZ	QRF_Y
  1CDE'   21 0000*              	LXI	H,MKSAV
  1CE1'   11 0000*              	LXI	D,MKTAB
  1CE4'   CD 253F'              	CALL	COPY12
  1CE7'   CD 0000*              	CALL	UNDCLR
  1CEA'                         QRF_Y:
  1CEA'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1CEC'   32 2ED7'              	STA	MSGWHT
  1CEF'   C3 15F8'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1CF2'                         YSPAN:
  1CF2'   CD 09FD'              	CALL	GLSTAL
  1CF5'   CD 17AC'              	CALL	OPSPNL		; HL = the span's length
  1CF8'   22 2F0B'              	SHLD	YTGT
  1CFB'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  1CFE'   EB                    	XCHG			; DE = it
  1CFF'   2A 2F0B'              	LHLD	YTGT
  1D02'   EB                    	XCHG			; HL = the text's, DE = the span's
  1D03'   CD 0000*              	CALL	SUBHD
  1D06'   22 2F0B'              	SHLD	YTGT		; what the text is left at when the span is out
  1D09'   2A 2EAC'              	LHLD	OPLO
  1D0C'   CD 0000*              	CALL	GOTO
  1D0F'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1D12'                         YS_LP:
  1D12'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1D15'   CD 0000*              	CALL	SETC0
  1D18'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1D1B'   DA 1CCB'              	JC	QREFUS		; ... which has no room for it
  1D1E'   CD 0000*              	CALL	LOGLEN
  1D21'   EB                    	XCHG			; DE = what is left
  1D22'   2A 2F0B'              	LHLD	YTGT
  1D25'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1D28'   DA 1D2E'              	JC	YS_END		; below it -- cannot happen over whole lines,
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1D2B'   C2 1D12'              	JNZ	YS_LP		;   but never spin here if it ever did
  1D2E'                         YS_END:
  1D2E'   C3 0174'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1D31'                         YNPRE:
  1D31'   2A 0000*              	LHLD	PGTOPM
  1D34'   22 2F14'              	SHLD	YNPG
  1D37'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1D38'                         YNDONE:
  1D38'   2A 2EDF'              	LHLD	YOFF
  1D3B'   CD 0000*              	CALL	GOTO
  1D3E'   2A 0000*              	LHLD	PGTOPM
  1D41'   EB                    	XCHG
  1D42'   2A 2F14'              	LHLD	YNPG
  1D45'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1D48'   C2 088F'              	JNZ	SETFUL		; it moved under us: repaint after all
  1D4B'   C3 0852'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1D4E'                         YNROOM:
  1D4E'   11 0100               	LXI	D,100H
  1D51'   19                    	DAD	D
  1D52'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1D53'   E5                    	PUSH	H		; the span plus its slack
  1D54'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1D57'   EB                    	XCHG			; HL = free
  1D58'   D1                    	POP	D		; DE = the span plus its slack
  1D59'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1D5C'   DA 1D64'              	JC	YNR_OK
  1D5F'   CA 1D64'              	JZ	YNR_OK
  1D62'   37                    	STC			; not enough: the delete-and-put-back path
  1D63'   C9                    	RET
  1D64'                         YNR_OK:
  1D64'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1D65'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1D66'                         YNGO:
  1D66'   C5                    	PUSH	B
  1D67'   CD 077D'              	CALL	GETCNT		; spent here: this yank is happening
  1D6A'   CD 09FD'              	CALL	GLSTAL
  1D6D'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1D70'   C1                    	POP	B
  1D71'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1D74'                         YNCOPY:
  1D74'   2A 2E60'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1D77'   7C                    	MOV	A,H		;   the count itself
  1D78'   B5                    	ORA	L
  1D79'   C2 1D7F'              	JNZ	YNC_HV
  1D7C'   21 0001               	LXI	H,1
  1D7F'                         YNC_HV:
  1D7F'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1D80'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1D81'   B4                    	ORA	H
  1D82'   CA 1D8D'              	JZ	YNC_M
  1D85'   E5                    	PUSH	H
  1D86'   CD 09B6'              	CALL	ONLAST		; vim: a count over one on the last line does
  1D89'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1D8A'   DA 1D9F'              	JC	YNC_RF
  1D8D'                         YNC_M:
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1D8D'   E5                    	PUSH	H
  1D8E'   CD 0934'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1D91'   E1                    	POP	H
  1D92'   CD 1DA7'              	CALL	YNLINE		; BC = the span, measured where it stands
  1D95'   D8                    	RC			; not measurable here: let the pager answer it
  1D96'   60                    	MOV	H,B
  1D97'   69                    	MOV	L,C
  1D98'   CD 1D4E'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1D9B'   D8                    	RC			; no: the delete-and-put-back path
  1D9C'   C3 1D66'              	JMP	YNGO
  1D9F'                         YNC_RF:
  1D9F'   CD 077D'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1DA2'   CD 09FD'              	CALL	GLSTAL		;   register alone, and that is the command
  1DA5'   B7                    	ORA	A		; NC: done
  1DA6'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1DA7'                         YNLINE:
  1DA7'   22 2F16'              	SHLD	YNCNT		; the lines it still wants
  1DAA'   2A 0000*              	LHLD	GAPEND
  1DAD'                         YNL_LP:
  1DAD'   EB                    	XCHG			; DE = the scan
  1DAE'   2A 0000*              	LHLD	TXTEND
  1DB1'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1DB4'   EB                    	XCHG			; HL = the scan
  1DB5'   D2 1DD5'              	JNC	YNL_EN		; the resident text ran out
  1DB8'   7E                    	MOV	A,M
  1DB9'   23                    	INX	H
  1DBA'   FE 0A                 	CPI	LF
  1DBC'   C2 1DAD'              	JNZ	YNL_LP
  1DBF'   E5                    	PUSH	H
  1DC0'   2A 2F16'              	LHLD	YNCNT
  1DC3'   2B                    	DCX	H
  1DC4'   22 2F16'              	SHLD	YNCNT
  1DC7'   7C                    	MOV	A,H
  1DC8'   B5                    	ORA	L
  1DC9'   E1                    	POP	H
  1DCA'   C2 1DAD'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1DCD'   EB                    	XCHG			; DE = past the last of them
  1DCE'   2A 0000*              	LHLD	GAPEND
  1DD1'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1DD2'   C3 1DE3'              	JMP	YNL_BC
  1DD5'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1DD5'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1DD8'   C2 1DEA'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1DDB'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1DDE'   EB                    	XCHG			;   count clamps to it as vim's does
  1DDF'   2A 0000*              	LHLD	GAPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1DE2'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1DE3'                         YNL_BC:
  1DE3'   CD 0000*              	CALL	SUBHD		; HL = the span
  1DE6'   44                    	MOV	B,H
  1DE7'   4D                    	MOV	C,L
  1DE8'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1DE9'   C9                    	RET
  1DEA'                         YNL_NO:
  1DEA'   37                    	STC
  1DEB'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1DEC'                         YNSPAN:
  1DEC'   CD 17AC'              	CALL	OPSPNL		; HL = the span's length
  1DEF'   44                    	MOV	B,H
  1DF0'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1DF1'   CD 1D4E'              	CALL	YNROOM
  1DF4'   D8                    	RC			; no room: the delete-and-put-back path
  1DF5'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1DF6'   2A 2EAC'              	LHLD	OPLO
  1DF9'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1DFC'   C1                    	POP	B
  1DFD'   C3 1D66'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1E00'                         VC_P:
  1E00'   CD 1BB5'              	CALL	QEMPTY
  1E03'   CA 1ED6'              	JZ	VP_BEL
  1E06'   CD 077D'              	CALL	GETCNT
  1E09'   22 2EE3'              	SHLD	PCNT
  1E0C'   CD 0000*              	CALL	CUROFF
  1E0F'   CD 0706'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1E12'   C3 1E27'              	JMP	VP_GO
  1E15'                         VCB_P:
  1E15'   CD 1BB5'              	CALL	QEMPTY
  1E18'   CA 1ED6'              	JZ	VP_BEL
  1E1B'   CD 077D'              	CALL	GETCNT
  1E1E'   22 2EE3'              	SHLD	PCNT
  1E21'   CD 0000*              	CALL	CUROFF
  1E24'   CD 066F'              	CALL	BOL
  1E27'                         VP_GO:
  1E27'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1E2A'   CD 0000*              	CALL	CUROFF
  1E2D'   EB                    	XCHG
  1E2E'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1E31'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1E34'   DA 1E49'              	JC	VP_IN
  1E37'   EB                    	XCHG			; HL = the put point = LOGLEN
  1E38'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1E39'   B5                    	ORA	L
  1E3A'   CA 1E46'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1E3D'   2B                    	DCX	H
  1E3E'   CD 0000*              	CALL	CHARAT
  1E41'   FE 0A                 	CPI	LF
  1E43'   CA 1E49'              	JZ	VP_IN
  1E46'                         VP_BRK:
  1E46'   CD 19B2'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1E49'                         VP_IN:
  1E49'   21 2EE5'              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1E4C'   CD 0429'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1E4F'   CD 132A'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1E52'   2A 0000*              	LHLD	QBEG
  1E55'   EB                    	XCHG
  1E56'   2A 0000*              	LHLD	QEND
  1E59'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1E5C'   EB                    	XCHG
  1E5D'   22 2EE8'              	SHLD	PLFS
  1E60'   2A 2EE3'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1E63'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1E64'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1E65'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1E67'   C2 1E6B'              	JNZ	VP_PZ
  1E6A'   7D                    	MOV	A,L
  1E6B'                         VP_PZ:
  1E6B'   32 2EEA'              	STA	PCPY
  1E6E'                         VP_LP:
  1E6E'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1E71'   2A 0000*              	LHLD	LNDLT
  1E74'   EB                    	XCHG
  1E75'   2A 2EE8'              	LHLD	PLFS
  1E78'   19                    	DAD	D
  1E79'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1E7C'   2A 2EE3'              	LHLD	PCNT
  1E7F'   2B                    	DCX	H
  1E80'   22 2EE3'              	SHLD	PCNT
  1E83'   7C                    	MOV	A,H
  1E84'   B5                    	ORA	L
  1E85'   C2 1E6E'              	JNZ	VP_LP
  1E88'   CD 0174'              	CALL	MARKMOD
  1E8B'   21 2EE5'              	LXI	H,PPFP
  1E8E'   CD 03DC'              	CALL	MKLOAD
  1E91'   CD 03E9'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1E94'   D2 1EC7'              	JNC	VP_PGD
  1E97'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1E9A'   CD 09FD'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1E9D'   3A 2EEA'              	LDA	PCPY
  1EA0'   B7                    	ORA	A
  1EA1'   CA 094B'              	JZ	FNBLNK
  1EA4'   2A 2EE8'              	LHLD	PLFS
  1EA7'   7C                    	MOV	A,H
  1EA8'   B7                    	ORA	A
  1EA9'   C2 094B'              	JNZ	FNBLNK
  1EAC'   3A 2EEA'              	LDA	PCPY
  1EAF'   CD 0FDC'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1EB2'   7C                    	MOV	A,H
  1EB3'   B7                    	ORA	A
  1EB4'   C2 094B'              	JNZ	FNBLNK
  1EB7'   7D                    	MOV	A,L
  1EB8'   B7                    	ORA	A
  1EB9'   CA 094B'              	JZ	FNBLNK
  1EBC'   F5                    	PUSH	PSW
  1EBD'   CD 087A'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1EC0'   F1                    	POP	PSW
  1EC1'   32 2E65'              	STA	ILN		; ... which the lines put now replace
  1EC4'   C3 094B'              	JMP	FNBLNK
  1EC7'                         VP_PGD:				; the put paged its first line out: page back
  1EC7'   CD 03A9'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1ECA'   CD 0000*              	CALL	GOTO
  1ECD'   CD 09FD'              	CALL	GLSTAL
  1ED0'   CD 1342'              	CALL	GPLACE
  1ED3'   C3 088F'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  1ED6'                         VP_BEL:
  1ED6'   CD 077D'              	CALL	GETCNT		; the count is spent either way
  1ED9'   0E 07                 	MVI	C,BEL
  1EDB'   CD 0000*              	CALL	BCONOU
  1EDE'   C3 0852'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1EE1'                         VIREP:
  1EE1'   79                    	MOV	A,C
  1EE2'   FE 1B                 	CPI	ESC
  1EE4'   CA 2037'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  1EE7'   FE 0D                 	CPI	CR
  1EE9'   CA 1F5C'              	JZ	VP_CR
  1EEC'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1EEE'   CA 1F5C'              	JZ	VP_CR
  1EF1'   FE 08                 	CPI	BS
  1EF3'   CA 1F68'              	JZ	VP_BS
  1EF6'   FE 7F                 	CPI	DEL
  1EF8'   CA 1F68'              	JZ	VP_BS
  1EFB'   32 2EBB'              	STA	VRCH		; the calls below do not preserve C
  1EFE'   CD 0858'              	CALL	SETLIN		; this row changed
  1F01'   CD 0174'              	CALL	MARKMOD
  1F04'   CD 19A5'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1F07'   CA 1F47'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1F0A'   CD 0764'              	CALL	CURCHR
  1F0D'   06 01                 	MVI	B,1
  1F0F'   CD 085E'              	CALL	SETCEL
  1F12'   3A 2EBB'              	LDA	VRCH
  1F15'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1F18'   2A 2EBC'              	LHLD	RPDEL
  1F1B'   7C                    	MOV	A,H
  1F1C'   B5                    	ORA	L
  1F1D'   CA 1F33'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1F20'   2A 0000*              	LHLD	GAPEND
  1F23'   EB                    	XCHG
  1F24'   2A 2EC0'              	LHLD	RPGE
  1F27'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1F2A'   CA 1F33'              	JZ	VP_OVW
  1F2D'   21 0000               	LXI	H,0
  1F30'   22 2EBC'              	SHLD	RPDEL		; the text moved: those originals are gone
  1F33'                         VP_OVW:
  1F33'   21 0001               	LXI	H,1
  1F36'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1F39'   2A 0000*              	LHLD	GAPEND
  1F3C'   22 2EC0'              	SHLD	RPGE
  1F3F'   2A 2EBC'              	LHLD	RPDEL
  1F42'   23                    	INX	H
  1F43'   22 2EBC'              	SHLD	RPDEL
  1F46'   C9                    	RET
  1F47'                         VP_APP:
  1F47'   3E 20                 	MVI	A,' '		; (the cell there is blank)
  1F49'   06 01                 	MVI	B,1
  1F4B'   CD 085E'              	CALL	SETCEL
  1F4E'   3A 2EBB'              	LDA	VRCH
  1F51'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1F54'   2A 2EBE'              	LHLD	RPAPP
  1F57'   23                    	INX	H
  1F58'   22 2EBE'              	SHLD	RPAPP
  1F5B'   C9                    	RET
  1F5C'                         VP_CR:
  1F5C'   21 0000               	LXI	H,0
  1F5F'   22 2EBC'              	SHLD	RPDEL		; a line break ends what BS can put back
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  1F62'   22 2EBE'              	SHLD	RPAPP
  1F65'   C3 1FF3'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1F68'                         VP_BS:
  1F68'   2A 2EBE'              	LHLD	RPAPP
  1F6B'   7C                    	MOV	A,H
  1F6C'   B5                    	ORA	L
  1F6D'   CA 1F7A'              	JZ	VP_BSD
  1F70'   2B                    	DCX	H
  1F71'   22 2EBE'              	SHLD	RPAPP		; an appended char: it just goes
  1F74'   CD 0858'              	CALL	SETLIN
  1F77'   C3 0000*              	JMP	DELPRV
  1F7A'                         VP_BSD:
  1F7A'   2A 2EBC'              	LHLD	RPDEL
  1F7D'   7C                    	MOV	A,H
  1F7E'   B5                    	ORA	L
  1F7F'   CA 1FA6'              	JZ	VP_BSM		; nothing of ours left
  1F82'   2A 0000*              	LHLD	GAPEND
  1F85'   EB                    	XCHG
  1F86'   2A 2EC0'              	LHLD	RPGE
  1F89'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1F8C'   C2 1FA6'              	JNZ	VP_BSM
  1F8F'   2A 2EBC'              	LHLD	RPDEL
  1F92'   2B                    	DCX	H
  1F93'   22 2EBC'              	SHLD	RPDEL
  1F96'   CD 0858'              	CALL	SETLIN
  1F99'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1F9C'   CD 0000*              	CALL	UNDELF		; the original comes back
  1F9F'   2A 0000*              	LHLD	GAPEND
  1FA2'   22 2EC0'              	SHLD	RPGE
  1FA5'   C9                    	RET
  1FA6'                         VP_BSM:
  1FA6'   CD 0852'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1FA9'   C3 08E0'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  1FAC'                         VIINS:
  1FAC'   79                    	MOV	A,C
  1FAD'   FE 1B                 	CPI	ESC
  1FAF'   CA 2037'              	JZ	VI_ESC
  1FB2'   FE 0D                 	CPI	CR
  1FB4'   CA 1FF3'              	JZ	VI_CR
  1FB7'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1FB9'   CA 1FF3'              	JZ	VI_CR
  1FBC'   FE 08                 	CPI	BS
  1FBE'   CA 200B'              	JZ	VI_BS
  1FC1'   FE 7F                 	CPI	DEL
  1FC3'   CA 200B'              	JZ	VI_BS
  1FC6'   79                    	MOV	A,C
  1FC7'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1FCA'   CD 0174'              	CALL	MARKMOD
  1FCD'   CD 0858'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only for a plain printable char.  With
                                	;    a TAB after the cursor nothing past the TAB moves, so long as the
                                	;    TAB can give the cell up: the chars as far as it are the paint. ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  1FD0'   79                    	MOV	A,C
  1FD1'   FE 20                 	CPI	' '
  1FD3'   D8                    	RC			; control char -> keep R_LINE
  1FD4'   FE 7F                 	CPI	DEL
  1FD6'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1FD7'   CD 0895'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1FDA'   47                    	MOV	B,A
  1FDB'   3E 04                 	MVI	A,R_ICH
  1FDD'   32 2E64'              	STA	RINTENT
  1FE0'   3E 03                 	MVI	A,3		; a TAB there: it takes the cell up if it can
  1FE2'   05                    	DCR	B		;   (SCRN.MAC knows where it stands)
  1FE3'   CA 1FEF'              	JZ	VI_ICH
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1FE6'   CD 19A5'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1FE9'   3E 00                 	MVI	A,0
  1FEB'   C2 1FEF'              	JNZ	VI_ICH
  1FEE'   3C                    	INR	A
  1FEF'                         VI_ICH:
  1FEF'   32 2E66'              	STA	ICHAPP
  1FF2'   C9                    	RET
  1FF3'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1FF3'   CD 19A5'              	CALL	ATCEND
  1FF6'   3E 00                 	MVI	A,0
  1FF8'   CA 1FFC'              	JZ	VI_CRS
  1FFB'   3C                    	INR	A
  1FFC'                         VI_CRS:
  1FFC'   F5                    	PUSH	PSW
  1FFD'   CD 19B2'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  2000'   CD 19BF'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  2003'   CD 087A'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  2006'   F1                    	POP	PSW
  2007'   32 2E6A'              	STA	ILABOV
  200A'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  200B'                         VI_BS:
  200B'   CD 0000*              	CALL	PEEKL
  200E'   D8                    	RC			; start of the file: nothing to delete
  200F'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  2011'   CA 2031'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  2014'   47                    	MOV	B,A		;   and the screen repaints in full.  Any other
  2015'   CD 0858'              	CALL	SETLIN		;   char is inside the row -- redraw just that row
  2018'   78                    	MOV	A,B
  2019'   CD 0873'              	CALL	PLAINQ		; ... or, when it is one cell and no TAB follows
  201C'   D2 2031'              	JNC	VI_BSJ		;   to be drawn up short, let the terminal close
  201F'   CD 0895'              	CALL	TAILTAB		;   the cell up (R_DCH, from the left of the
  2022'   87                    	ADD	A		;   cursor) -- or the TAB that follows take it
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  2023'   3C                    	INR	A
  2024'   32 2E68'              	STA	DCHBS		; 1, and 2 with it for the TAB
  2027'   3E 01                 	MVI	A,1
  2029'   32 2E67'              	STA	DCHN
  202C'   3E 07                 	MVI	A,R_DCH
  202E'   32 2E64'              	STA	RINTENT
  2031'                         VI_BSJ:
  2031'   CD 0174'              	CALL	MARKMOD
  2034'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  2037'                         VI_ESC:
  2037'   3E 00                 	MVI	A,EM_CMD
  2039'   32 2E5F'              	STA	EDMODE
  203C'   CD 0852'              	CALL	SETMOV
  203F'   CD 08E0'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  2042'   C3 09FD'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  2045'                         RDLINE:
  2045'   EB                    	XCHG			; HL = buffer
  2046'   22 2EC2'              	SHLD	RLPTR
  2049'   3E 00                 	MVI	A,0
  204B'   32 2EC4'              	STA	RLLEN
  204E'   78                    	MOV	A,B
  204F'   32 2EC5'              	STA	RLMAX
  2052'   79                    	MOV	A,C
  2053'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  2056'                         RL_LP:
  2056'   CD 0000*              	CALL	GETKEY
  2059'   FE 1B                 	CPI	ESC
  205B'   CA 20AB'              	JZ	RL_CAN
  205E'   FE 0D                 	CPI	CR
  2060'   CA 20B6'              	JZ	RL_DONE
  2063'   FE 08                 	CPI	BS
  2065'   CA 2093'              	JZ	RL_BS
  2068'   FE 7F                 	CPI	DEL
  206A'   CA 2093'              	JZ	RL_BS
  206D'   FE 20                 	CPI	' '
  206F'   DA 2056'              	JC	RL_LP		; control char -> ignore
  2072'   3A 2EC4'              	LDA	RLLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2075'   47                    	MOV	B,A
  2076'   3A 2EC5'              	LDA	RLMAX
  2079'   B8                    	CMP	B
  207A'   CA 2056'              	JZ	RL_LP		; full -> ignore
  207D'   2A 2EC2'              	LHLD	RLPTR
  2080'   71                    	MOV	M,C
  2081'   23                    	INX	H
  2082'   22 2EC2'              	SHLD	RLPTR
  2085'   3A 2EC4'              	LDA	RLLEN
  2088'   3C                    	INR	A
  2089'   32 2EC4'              	STA	RLLEN
  208C'   79                    	MOV	A,C
  208D'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  2090'   C3 2056'              	JMP	RL_LP
  2093'                         RL_BS:				; WM LINEPOP
  2093'   3A 2EC4'              	LDA	RLLEN
  2096'   B7                    	ORA	A
  2097'   CA 20AB'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  209A'   3D                    	DCR	A
  209B'   32 2EC4'              	STA	RLLEN
  209E'   2A 2EC2'              	LHLD	RLPTR
  20A1'   2B                    	DCX	H
  20A2'   22 2EC2'              	SHLD	RLPTR
  20A5'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  20A8'   C3 2056'              	JMP	RL_LP
  20AB'                         RL_CAN:
  20AB'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  20AD'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  20B0'   CD 0858'              	CALL	SETLIN		; redraw one row
  20B3'   3E FF                 	MVI	A,0FFH		; cancelled
  20B5'   C9                    	RET
  20B6'                         RL_DONE:
  20B6'   AF                    	XRA	A
  20B7'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  20B8'                         VC_BZ:
  20B8'   CD 0852'              	CALL	SETMOV
  20BB'   3A 2E96'              	LDA	GSAVE
  20BE'   FE 02                 	CPI	PZ
  20C0'   CA 20CB'              	JZ	VZ_ZZ
  20C3'   B7                    	ORA	A
  20C4'   C0                    	RNZ			; 'g' was pending: vim drops both
  20C5'   3E 02                 	MVI	A,PZ
  20C7'   32 2E95'              	STA	GPEND
  20CA'   C9                    	RET
  20CB'                         VZ_ZZ:
  20CB'   3E 04                 	MVI	A,EO_X
  20CD'   32 2EC6'              	STA	EXOP
  20D0'   3E 01                 	MVI	A,1
  20D2'   32 2ED9'              	STA	EXBANG		; no '!'
  20D5'   AF                    	XRA	A
  20D6'   32 2EC7'              	STA	EXARG		; no file name
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  20D9'   3A 2E63'              	LDA	MODF		; as ':x': a changed text is written first
  20DC'   B7                    	ORA	A
  20DD'   CA 221E'              	JZ	EX_Q
  20E0'   C3 21B8'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  20E3'                         VC_EX:
  20E3'   CD 077D'              	CALL	GETCNT
  20E6'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  20E9'   11 0000*              	LXI	D,EXBUF
  20EC'   06 28                 	MVI	B,EXMAX
  20EE'   0E 3A                 	MVI	C,':'
  20F0'   CD 2045'              	CALL	RDLINE
  20F3'   B7                    	ORA	A
  20F4'   C0                    	RNZ			; cancelled
  20F5'   3A 2EC4'              	LDA	RLLEN
  20F8'   5F                    	MOV	E,A
  20F9'   16 00                 	MVI	D,0
  20FB'   21 0000*              	LXI	H,EXBUF
  20FE'   19                    	DAD	D
  20FF'   36 00                 	MVI	M,0		; the line ends with a 0
  2101'   21 0000*              	LXI	H,EXBUF
  2104'   CD 26D0'              	CALL	SKIPB
  2107'   C8                    	RZ			; nothing on it
  2108'   22 2EC9'              	SHLD	EXCMD
  210B'   CD 28D4'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  210E'   CD 26D0'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  2111'   56                    	MOV	D,M
  2112'   23                    	INX	H
  2113'   1E 00                 	MVI	E,0
  2115'   CD 26DC'              	CALL	ISLOW
  2118'   DA 2123'              	JC	EX_LK
  211B'   5F                    	MOV	E,A
  211C'   23                    	INX	H
  211D'   CD 26DC'              	CALL	ISLOW
  2120'   D2 213C'              	JNC	EX_NOT		; a third letter: none of ours
  2123'                         EX_LK:
  2123'   E5                    	PUSH	H
  2124'   21 28BB'              	LXI	H,EXTAB
  2127'                         EX_TL:
  2127'   7E                    	MOV	A,M
  2128'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2129'   CA 213B'              	JZ	EX_NTP		; not in the table
  212C'   23                    	INX	H
  212D'   BA                    	CMP	D
  212E'   7E                    	MOV	A,M
  212F'   23                    	INX	H
  2130'   C2 2137'              	JNZ	EX_TN
  2133'   BB                    	CMP	E
  2134'   CA 2142'              	JZ	EX_TF
  2137'                         EX_TN:
  2137'   23                    	INX	H
  2138'   C3 2127'              	JMP	EX_TL
  213B'                         EX_NTP:
  213B'   E1                    	POP	H
  213C'                         EX_NOT:
  213C'   21 2794'              	LXI	H,SNOT
  213F'   C3 2711'              	JMP	EXERT
  2142'                         EX_TF:
  2142'   7E                    	MOV	A,M
  2143'   32 2EC6'              	STA	EXOP
  2146'   E1                    	POP	H
  2147'   FE 06                 	CPI	EO_S
  2149'   CA 2943'              	JZ	EX_S		; ':s' reads the rest of the line itself
  214C'   FE 01                 	CPI	EO_W
  214E'   CA 215D'              	JZ	EX_RG		; ':N,Mw name' takes a range
  2151'   FE 08                 	CPI	EO_R
  2153'   CA 215D'              	JZ	EX_RG		; ... and ':Nr name' a line
  2156'   3A 2F22'              	LDA	SRNGF
  2159'   B7                    	ORA	A
  215A'   C2 213C'              	JNZ	EX_NOT		; a range on a command that does not take one
  215D'                         EX_RG:
                                	;--- '!', then the file name ---
  215D'   7E                    	MOV	A,M
  215E'   D6 21                 	SUI	'!'
  2160'   32 2ED9'              	STA	EXBANG		; 0 = '!'
  2163'   C2 2167'              	JNZ	EX_NB
  2166'   23                    	INX	H
  2167'                         EX_NB:
  2167'   CD 26D0'              	CALL	SKIPB
  216A'   32 2EC7'              	STA	EXARG		; 0 = no file name
  216D'   CA 2186'              	JZ	EX_RUN
  2170'   22 2EC9'              	SHLD	EXCMD
  2173'   3A 2EC6'              	LDA	EXOP
  2176'   FE 02                 	CPI	EO_Q
  2178'   CA 270E'              	JZ	EX_TRL		; :q takes none
  217B'   FE 07                 	CPI	EO_V
  217D'   CA 270E'              	JZ	EX_TRL		; nor :ve
  2180'   CD 263A'              	CALL	PARSFN
  2183'   C2 2702'              	JNZ	EX_INV
  2186'                         EX_RUN:
  2186'   3A 2EC6'              	LDA	EXOP
  2189'   FE 05                 	CPI	EO_E
  218B'   CA 2235'              	JZ	EX_E
  218E'   FE 02                 	CPI	EO_Q
  2190'   CA 221E'              	JZ	EX_Q
  2193'   FE 07                 	CPI	EO_V
  2195'   CA 2708'              	JZ	EX_V
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  2198'   FE 08                 	CPI	EO_R
  219A'   CA 23C6'              	JZ	EX_R
  219D'   FE 04                 	CPI	EO_X
  219F'   CA 21B1'              	JZ	EX_XM
  21A2'   FE 01                 	CPI	EO_W
  21A4'   C2 21B8'              	JNZ	EX_W		; :wq
  21A7'   3A 2F22'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  21AA'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  21AB'   C2 22E6'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  21AE'   C3 21B8'              	JMP	EX_W
  21B1'                         EX_XM:
  21B1'   3A 2E63'              	LDA	MODF		; :x writes only a changed text
  21B4'   B7                    	ORA	A
  21B5'   CA 221E'              	JZ	EX_Q
  21B8'                         EX_W:
  21B8'   CD 24A6'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  21BB'   D8                    	RC			; refused (message shown)
  21BC'   32 2EC8'              	STA	EXBAK
  21BF'   3A 2EC6'              	LDA	EXOP
  21C2'   FE 01                 	CPI	EO_W
  21C4'   CA 21DB'              	JZ	EX_WK
  21C7'   3A 2EC8'              	LDA	EXBAK
  21CA'   B7                    	ORA	A
  21CB'   C2 221B'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  21CE'   3A 2ED9'              	LDA	EXBANG
  21D1'   B7                    	ORA	A
  21D2'   CA 221B'              	JZ	EX_WQ		; so it does with '!'
  21D5'   CD 21DB'              	CALL	EX_WK		; else it may not: keep the text
  21D8'   C3 221E'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  21DB'                         EX_WK:
  21DB'   CD 0E18'              	CALL	CURRW		; the cursor's row and file position
  21DE'   32 2ECB'              	STA	WPROW
  21E1'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  21E4'   7D                    	MOV	A,L
  21E5'   E6 7F                 	ANI	7FH
  21E7'   32 2ECC'              	STA	WPBYT
  21EA'   7D                    	MOV	A,L
  21EB'   17                    	RAL
  21EC'   7C                    	MOV	A,H
  21ED'   17                    	RAL
  21EE'   5F                    	MOV	E,A
  21EF'   3E 00                 	MVI	A,0
  21F1'   17                    	RAL
  21F2'   57                    	MOV	D,A		; DE = HL / 128
  21F3'   2A 0000*              	LHLD	OUTPOS
  21F6'   19                    	DAD	D
  21F7'   22 2ECD'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  21FA'   CD 24DB'              	CALL	WRITE
  21FD'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  2200'   2A 2ECD'              	LHLD	WPREC
  2203'   EB                    	XCHG
  2204'   3A 2ECC'              	LDA	WPBYT
  2207'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  220A'   CD 0000*              	CALL	GOTO
  220D'                         EX_WRW:
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  220D'   21 0000               	LXI	H,0
  2210'   22 0000*              	SHLD	LNDLT
  2213'   3A 2ECB'              	LDA	WPROW
  2216'   6F                    	MOV	L,A
  2217'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  221A'   C9                    	RET
  221B'                         EX_WQ:
  221B'   CD 24DB'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  221E'                         EX_Q:
  221E'   3A 2ED9'              	LDA	EXBANG
  2221'   B7                    	ORA	A
  2222'   CA 222C'              	JZ	EX_QT
  2225'   3A 2E63'              	LDA	MODF
  2228'   B7                    	ORA	A
  2229'   C2 26F6'              	JNZ	MSGNWR		; changed, no '!': stay
  222C'                         EX_QT:
  222C'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  222F'   3E 01                 	MVI	A,1
  2231'   32 2E62'              	STA	QUITF
  2234'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  2235'                         EX_E:
  2235'   3A 2ED9'              	LDA	EXBANG
  2238'   B7                    	ORA	A
  2239'   CA 2243'              	JZ	EE_GO
  223C'   3A 2E63'              	LDA	MODF
  223F'   B7                    	ORA	A
  2240'   C2 26F6'              	JNZ	MSGNWR
  2243'                         EE_GO:
  2243'   3A 2EC7'              	LDA	EXARG
  2246'   B7                    	ORA	A
  2247'   C2 224E'              	JNZ	EE_ARG
  224A'   CD 2517'              	CALL	OWNTF		; no name: the buffer's own
  224D'   D8                    	RC
  224E'                         EE_ARG:
  224E'   CD 252D'              	CALL	ISOWN
  2251'   21 0001               	LXI	H,1
  2254'   C2 225B'              	JNZ	EE_LD		; another file: its first line
  2257'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  225A'   23                    	INX	H		; HL = the cursor's line
  225B'                         EE_LD:
  225B'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  225D'   32 2ED7'              	STA	MSGWHT
  2260'   E5                    	PUSH	H
  2261'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  2264'   21 0000*              	LXI	H,TFCB
  2267'   11 0000*              	LXI	D,FNAME
  226A'   CD 253F'              	CALL	COPY12		; the buffer's name
  226D'   CD 2504'              	CALL	SRCTF
  2270'   CD 0000*              	CALL	REOPEN
  2273'   CD 01EC'              	CALL	MKCLR		; the marks named the buffer that just went
  2276'   AF                    	XRA	A
  2277'   32 2E63'              	STA	MODF
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  227A'   E1                    	POP	H
  227B'   2B                    	DCX	H
  227C'   AF                    	XRA	A
  227D'   CD 0000*              	CALL	MVLIND		; down to the line
  2280'   CD 0B34'              	CALL	ATEOF
  2283'   DC 0B3A'              	CC	LASTLN		; past the last line: onto it
  2286'   CD 1304'              	CALL	ZSAVE
  2289'   C3 13D9'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  228C'                         TFDOS:
  228C'   C5                    	PUSH	B
  228D'   11 0080               	LXI	D,CMDTAIL
  2290'   0E 1A                 	MVI	C,1AH		; set the DMA
  2292'   CD 0005               	CALL	BDOS
  2295'   C1                    	POP	B
  2296'   11 0000*              	LXI	D,TFCB
  2299'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  229C'                         EXRNG:
  229C'   2A 2F23'              	LHLD	SRNG1
  229F'   7C                    	MOV	A,H
  22A0'   B5                    	ORA	L
  22A1'   37                    	STC
  22A2'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  22A3'   2A 2F25'              	LHLD	SRNG2
  22A6'   EB                    	XCHG
  22A7'   2A 2F23'              	LHLD	SRNG1
  22AA'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  22AD'   D8                    	RC
  22AE'   EB                    	XCHG			; HL = the last line, DE = the first
  22AF'   CD 0000*              	CALL	SUBHD
  22B2'   23                    	INX	H
  22B3'   22 2F2D'              	SHLD	SLINES
  22B6'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  22B7'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  22B8'                         GOLNX:
  22B8'   E5                    	PUSH	H
  22B9'   CD 1298'              	CALL	GOLN
  22BC'   CD 0000*              	CALL	CNTLF
  22BF'   23                    	INX	H		; the line the cursor came to rest on
  22C0'   D1                    	POP	D
  22C1'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  22C4'                         EXSAVP:
  22C4'   CD 0E18'              	CALL	CURRW
  22C7'   32 2ECB'              	STA	WPROW
  22CA'   21 2F04'              	LXI	H,MKPOS
  22CD'   C3 0429'              	JMP	FPSTO
  22D0'                         EXRSTP:
  22D0'   CD 0000*              	CALL	CLRCNT
  22D3'   CD 03A9'              	CALL	MKPAGE		; page until that place is in the window again
  22D6'   CD 0000*              	CALL	GOTO
  22D9'   C3 220D'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  22DC'                         PUTBRK:
  22DC'   3E 0D                 	MVI	A,CR
  22DE'   CD 0000*              	CALL	PUTGAP
  22E1'   3E 0A                 	MVI	A,LF
  22E3'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  22E6'                         EX_WR:
  22E6'   3A 2EC7'              	LDA	EXARG
  22E9'   B7                    	ORA	A
  22EA'   CA 26E4'              	JZ	MSGNFN		; No file name
  22ED'   CD 252D'              	CALL	ISOWN
  22F0'   CA 2390'              	JZ	EXW_OW
  22F3'   CD 0000*              	CALL	TEXIST
  22F6'   32 2F30'              	STA	RWERR		; nonzero: a file of that name is there
  22F9'   CA 2303'              	JZ	EXW_GO
  22FC'   3A 2ED9'              	LDA	EXBANG
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  22FF'   B7                    	ORA	A
  2300'   C2 26EA'              	JNZ	MSGEXI		; File exists (! to force)
  2303'                         EXW_GO:
  2303'   CD 229C'              	CALL	EXRNG
  2306'   DA 238A'              	JC	EXW_BD
  2309'   CD 22C4'              	CALL	EXSAVP
  230C'   2A 2F23'              	LHLD	SRNG1
  230F'   CD 22B8'              	CALL	GOLNX
  2312'   C2 2387'              	JNZ	EXW_NL		; the text has no line N
  2315'   3A 2F30'              	LDA	RWERR		; a delete scans the whole directory, there or
  2318'   B7                    	ORA	A		;   not: only when TEXIST found one
  2319'   0E 13                 	MVI	C,13H
  231B'   C4 228C'              	CNZ	TFDOS		; delete what is there
  231E'   0E 16                 	MVI	C,16H
  2320'   CD 228C'              	CALL	TFDOS		; ... and make it
  2323'   3C                    	INR	A
  2324'   CA 2379'              	JZ	EXW_FL		; no directory entry left
  2327'   3E 80                 	MVI	A,80H
  2329'   32 2F2F'              	STA	RWPTR
  232C'   AF                    	XRA	A
  232D'   32 2F30'              	STA	RWERR
  2330'   2A 2F2D'              	LHLD	SLINES
  2333'   CD 0000*              	CALL	SETC0		; that many lines, forward
  2336'                         EXW_LP:
  2336'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  2339'   E5                    	PUSH	H
  233A'   EB                    	XCHG
  233B'   2A 0000*              	LHLD	GAPEND
  233E'   CD 2396'              	CALL	RWOUT		; the text from the cursor to there
  2341'   E1                    	POP	H
  2342'   3A 2F30'              	LDA	RWERR
  2345'   B7                    	ORA	A
  2346'   C2 2362'              	JNZ	EXW_EN
  2349'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  234C'   CD 0792'              	CALL	CNTTST
  234F'   C2 2336'              	JNZ	EXW_LP
  2352'                         EXW_PD:				; the last record is padded out with ^Z
  2352'   3A 2F2F'              	LDA	RWPTR
  2355'   FE 80                 	CPI	80H
  2357'   CA 2362'              	JZ	EXW_EN
  235A'   3E 1A                 	MVI	A,CPMEOF
  235C'   CD 23A2'              	CALL	RWPUT
  235F'   C3 2352'              	JMP	EXW_PD
  2362'                         EXW_EN:
  2362'   0E 10                 	MVI	C,10H
  2364'   CD 228C'              	CALL	TFDOS		; close
  2367'   3A 2F30'              	LDA	RWERR
  236A'   B7                    	ORA	A
  236B'   C2 2379'              	JNZ	EXW_FL
  236E'   CD 22D0'              	CALL	EXRSTP
  2371'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  2373'   32 2ED7'              	STA	MSGWHT
  2376'   C3 0852'              	JMP	SETMOV		; nothing on the screen has changed
  2379'                         EXW_FL:				; no room: the part written is not left behind
  2379'   0E 13                 	MVI	C,13H
  237B'   CD 228C'              	CALL	TFDOS
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  237E'   CD 22D0'              	CALL	EXRSTP
  2381'   21 28B1'              	LXI	H,SDFUL
  2384'   C3 271C'              	JMP	EXERR
  2387'                         EXW_NL:
  2387'   CD 22D0'              	CALL	EXRSTP
  238A'                         EXW_BD:
  238A'   21 28A3'              	LXI	H,SRNGE
  238D'   C3 271C'              	JMP	EXERR
  2390'                         EXW_OW:
  2390'   21 274B'              	LXI	H,SEXI
  2393'   C3 271C'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  2396'                         RWOUT:
  2396'   CD 0000*              	CALL	CMP16
  2399'   C8                    	RZ
  239A'   7E                    	MOV	A,M
  239B'   23                    	INX	H
  239C'   CD 23A2'              	CALL	RWPUT
  239F'   C3 2396'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  23A2'                         RWPUT:
  23A2'   E5                    	PUSH	H
  23A3'   F5                    	PUSH	PSW
  23A4'   3A 2F2F'              	LDA	RWPTR
  23A7'   6F                    	MOV	L,A
  23A8'   26 00                 	MVI	H,0
  23AA'   F1                    	POP	PSW
  23AB'   77                    	MOV	M,A
  23AC'   2C                    	INR	L		; Z: that was the record's last byte
  23AD'   7D                    	MOV	A,L
  23AE'   C2 23C1'              	JNZ	RWP_ST
  23B1'   D5                    	PUSH	D
  23B2'   0E 15                 	MVI	C,15H
  23B4'   CD 228C'              	CALL	TFDOS		; write it
  23B7'   D1                    	POP	D
  23B8'   B7                    	ORA	A
  23B9'   CA 23BF'              	JZ	RWP_OK
  23BC'   32 2F30'              	STA	RWERR
  23BF'                         RWP_OK:
  23BF'   3E 80                 	MVI	A,80H
  23C1'                         RWP_ST:
  23C1'   32 2F2F'              	STA	RWPTR
  23C4'   E1                    	POP	H
  23C5'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  23C6'                         EX_R:
  23C6'   3A 2EC7'              	LDA	EXARG
  23C9'   B7                    	ORA	A
  23CA'   CA 26E4'              	JZ	MSGNFN		; No file name
  23CD'   0E 0F                 	MVI	C,0FH
  23CF'   CD 228C'              	CALL	TFDOS		; open
  23D2'   3C                    	INR	A
  23D3'   CA 24A0'              	JZ	ER_NOF
  23D6'   CD 132A'              	CALL	GZONE		; the screen's top line, before anything moves
  23D9'   CD 22C4'              	CALL	EXSAVP
  23DC'   3A 2F22'              	LDA	SRNGF
  23DF'   B7                    	ORA	A
  23E0'   CA 23F9'              	JZ	ER_NXT		; no line given: below the cursor's
  23E3'   2A 2F25'              	LHLD	SRNG2
  23E6'   7C                    	MOV	A,H
  23E7'   B5                    	ORA	L
  23E8'   C2 23F3'              	JNZ	ER_LN
  23EB'   23                    	INX	H
  23EC'   CD 1298'              	CALL	GOLN		; ':0r': above line 1 ...
  23EF'   AF                    	XRA	A		;   which never wants a line end put in first
  23F0'   C3 241B'              	JMP	ER_BRK
  23F3'                         ER_LN:
  23F3'   CD 22B8'              	CALL	GOLNX
  23F6'   C2 2387'              	JNZ	EXW_NL		; the text has no line N
  23F9'                         ER_NXT:
  23F9'   21 0001               	LXI	H,1
  23FC'   AF                    	XRA	A
  23FD'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  2400'   CD 0B34'              	CALL	ATEOF
  2403'   3E 00                 	MVI	A,0
  2405'   D2 241B'              	JNC	ER_BRK		; text follows
  2408'   2A 0000*              	LHLD	GAPBEG
  240B'   EB                    	XCHG
  240C'   2A 0000*              	LHLD	TXTBEG
  240F'   CD 0000*              	CALL	CMP16
  2412'   3E 01                 	MVI	A,1
  2414'   CA 241B'              	JZ	ER_BRK		; nothing before the cursor either
  2417'   1B                    	DCX	D
  2418'   1A                    	LDAX	D
  2419'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  241B'                         ER_BRK:
  241B'   32 2F32'              	STA	RDBRK
  241E'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  2421'   AF                    	XRA	A
  2422'   32 2F31'              	STA	RDANY
  2425'                         ER_LP:
  2425'   0E 14                 	MVI	C,14H
  2427'   CD 228C'              	CALL	TFDOS		; the next record
  242A'   B7                    	ORA	A
  242B'   C2 245E'              	JNZ	ER_END
  242E'   21 0080               	LXI	H,CMDTAIL
  2431'   0E 00                 	MVI	C,0
  2433'                         ER_SC:				; C = its bytes, up to a ^Z
  2433'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  2434'   FE 1A                 	CPI	CPMEOF
  2436'   CA 243E'              	JZ	ER_GOT
  2439'   23                    	INX	H
  243A'   0C                    	INR	C
  243B'   F2 2433'              	JP	ER_SC		; (minus: all 128)
  243E'                         ER_GOT:
  243E'   79                    	MOV	A,C
  243F'   B7                    	ORA	A
  2440'   CA 245E'              	JZ	ER_END
  2443'   C5                    	PUSH	B
  2444'   3A 2F31'              	LDA	RDANY
  2447'   B7                    	ORA	A
  2448'   CC 248F'              	CZ	ER_1ST
  244B'   C1                    	POP	B
  244C'   06 00                 	MVI	B,0
  244E'   11 0080               	LXI	D,CMDTAIL
  2451'   C5                    	PUSH	B
  2452'   CD 0000*              	CALL	INSBLK
  2455'   C1                    	POP	B
  2456'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  2459'   79                    	MOV	A,C
  245A'   17                    	RAL
  245B'   DA 2425'              	JC	ER_LP		; a full record: there may be more
  245E'                         ER_END:
  245E'   3A 2F31'              	LDA	RDANY
  2461'   B7                    	ORA	A
  2462'   CA 2480'              	JZ	ER_PL		; nothing in the file: nothing has changed
  2465'   CD 0B34'              	CALL	ATEOF
  2468'   DA 2475'              	JC	ER_MD		; the text now ends as the file read ends
  246B'   2A 0000*              	LHLD	GAPBEG
  246E'   2B                    	DCX	H
  246F'   7E                    	MOV	A,M
  2470'   FE 0A                 	CPI	LF
  2472'   C4 22DC'              	CNZ	PUTBRK		; text follows: what was read ends a line
  2475'                         ER_MD:
  2475'   3E 01                 	MVI	A,1
  2477'   32 2E63'              	STA	MODF
  247A'   CD 03A9'              	CALL	MKPAGE		; back to the first line read
  247D'   CD 0000*              	CALL	GOTO
  2480'                         ER_PL:
  2480'   CD 0B34'              	CALL	ATEOF
  2483'   DC 0B3A'              	CC	LASTLN		; (nothing read, at the end: the last line)
  2486'   CD 0000*              	CALL	CLRCNT
  2489'   CD 1342'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  248C'   C3 088F'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  248F'                         ER_1ST:
  248F'   3C                    	INR	A
  2490'   32 2F31'              	STA	RDANY
  2493'   3A 2F32'              	LDA	RDBRK
  2496'   B7                    	ORA	A
  2497'   C4 22DC'              	CNZ	PUTBRK
  249A'   21 2F04'              	LXI	H,MKPOS
  249D'   C3 0429'              	JMP	FPSTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  24A0'                         ER_NOF:
  24A0'   21 2892'              	LXI	H,SNOPN
  24A3'   C3 2711'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  24A6'                         WRCHK:
  24A6'   3A 2EC7'              	LDA	EXARG
  24A9'   B7                    	ORA	A
  24AA'   C2 24B4'              	JNZ	WC_ARG
  24AD'   CD 2517'              	CALL	OWNTF
  24B0'   D8                    	RC
  24B1'   C3 24C9'              	JMP	WC_OWN
  24B4'                         WC_ARG:
  24B4'   CD 252D'              	CALL	ISOWN
  24B7'   CA 24C9'              	JZ	WC_OWN
  24BA'   3A 2ED9'              	LDA	EXBANG
  24BD'   B7                    	ORA	A
  24BE'   CA 24C7'              	JZ	WC_OTH
  24C1'   CD 0000*              	CALL	TEXIST
  24C4'   C2 26EA'              	JNZ	MSGEXI		; File exists (! to force)
  24C7'                         WC_OTH:
  24C7'   AF                    	XRA	A		; (NC)
  24C8'   C9                    	RET
  24C9'                         WC_OWN:
  24C9'   3A 2EDA'              	LDA	ROFLAG		; '-R': this is the file it may not write
  24CC'   B7                    	ORA	A
  24CD'   CA 24D7'              	JZ	WC_OK
  24D0'   3A 2ED9'              	LDA	EXBANG
  24D3'   B7                    	ORA	A
  24D4'   C2 26F0'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  24D7'                         WC_OK:
  24D7'   3E 01                 	MVI	A,1
  24D9'   B7                    	ORA	A		; (NC)
  24DA'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  24DB'                         WRITE:
  24DB'   3A 2EC8'              	LDA	EXBAK
  24DE'   CD 0000*              	CALL	WRTO
  24E1'   3A 0001*              	LDA	FNAME+1
  24E4'   FE 20                 	CPI	' '
  24E6'   C2 24F2'              	JNZ	WR_HAS
  24E9'   21 0000*              	LXI	H,TFCB
  24EC'   11 0000*              	LXI	D,FNAME
  24EF'   CD 253F'              	CALL	COPY12
  24F2'                         WR_HAS:
  24F2'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  24F4'   32 2ED7'              	STA	MSGWHT
  24F7'   CD 252D'              	CALL	ISOWN
  24FA'   C2 2504'              	JNZ	SRCTF
  24FD'   AF                    	XRA	A
  24FE'   32 2E63'              	STA	MODF
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  2501'   32 2ED8'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  2504'                         SRCTF:
  2504'   21 0000*              	LXI	H,TFCB
  2507'   11 005C               	LXI	D,DFTFCB
  250A'   CD 253F'              	CALL	COPY12
  250D'   AF                    	XRA	A
  250E'   06 04                 	MVI	B,4
  2510'                         SRC_Z:
  2510'   12                    	STAX	D		; extent, s1, s2, record count: 0
  2511'   13                    	INX	D
  2512'   05                    	DCR	B
  2513'   C2 2510'              	JNZ	SRC_Z
  2516'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  2517'                         OWNTF:
  2517'   3A 0001*              	LDA	FNAME+1
  251A'   FE 20                 	CPI	' '
  251C'   CA 26E4'              	JZ	MSGNFN
  251F'   CD 254A'              	CALL	TFCLR
  2522'   21 0000*              	LXI	H,FNAME
  2525'   11 0000*              	LXI	D,TFCB
  2528'   CD 253F'              	CALL	COPY12
  252B'   B7                    	ORA	A		; (NC)
  252C'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  252D'                         ISOWN:
  252D'   21 0000*              	LXI	H,TFCB
  2530'   11 0000*              	LXI	D,FNAME
  2533'   06 0C                 	MVI	B,12
  2535'                         IO_LP:
  2535'   1A                    	LDAX	D
  2536'   BE                    	CMP	M
  2537'   C0                    	RNZ
  2538'   23                    	INX	H
  2539'   13                    	INX	D
  253A'   05                    	DCR	B
  253B'   C2 2535'              	JNZ	IO_LP
  253E'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  253F'                         COPY12:
  253F'   06 0C                 	MVI	B,12
  2541'                         CP_LP:
  2541'   7E                    	MOV	A,M
  2542'   12                    	STAX	D
  2543'   23                    	INX	H
  2544'   13                    	INX	D
  2545'   05                    	DCR	B
  2546'   C2 2541'              	JNZ	CP_LP
  2549'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  254A'                         TFCLR:
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  254A'   11 0000*              	LXI	D,TFCB
  254D'   06 24                 	MVI	B,36
  254F'   AF                    	XRA	A
  2550'                         TC_LP:
  2550'   12                    	STAX	D
  2551'   13                    	INX	D
  2552'   05                    	DCR	B
  2553'   C2 2550'              	JNZ	TC_LP
  2556'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  2557'                         FOPEN:
  2557'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  2559'   32 2ED7'              	STA	MSGWHT
  255C'   21 005C               	LXI	H,DFTFCB
  255F'   CD 262D'              	CALL	NRMDRV
  2562'   11 0000*              	LXI	D,FNAME
  2565'   CD 253F'              	CALL	COPY12
  2568'   CD 0000*              	CALL	OPENZ
  256B'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  256E'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  2570'   C8                    	RZ
  2571'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  2574'   32 2ED8'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  2577'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  2578'                         ARGSCN:
  2578'   3A 0080               	LDA	CMDTAIL
  257B'   47                    	MOV	B,A		; B = what is left of the line
  257C'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


  257D'   C8                    	RZ
  257E'   21 0081               	LXI	H,CMDTAIL+1
  2581'                         AS_TOK:				; at a token, or the blanks before one
  2581'   7E                    	MOV	A,M
  2582'   FE 20                 	CPI	' '
  2584'   C2 258D'              	JNZ	AS_OPT
  2587'   23                    	INX	H
  2588'   05                    	DCR	B
  2589'   C2 2581'              	JNZ	AS_TOK
  258C'   C9                    	RET
  258D'                         AS_OPT:
  258D'   FE 2B                 	CPI	'+'
  258F'   CA 25B9'              	JZ	AS_PLS
  2592'   FE 2D                 	CPI	'-'
  2594'   CA 25A8'              	JZ	AS_SW
  2597'   FE 2F                 	CPI	'/'
  2599'   CA 25A8'              	JZ	AS_SW
  259C'                         AS_SKP:				; not ours (the file name): on to the next one
  259C'   23                    	INX	H
  259D'   05                    	DCR	B
  259E'   C8                    	RZ
  259F'   7E                    	MOV	A,M
  25A0'   FE 20                 	CPI	' '
  25A2'   C2 259C'              	JNZ	AS_SKP
  25A5'   C3 2581'              	JMP	AS_TOK
  25A8'                         AS_SW:
  25A8'   23                    	INX	H
  25A9'   05                    	DCR	B
  25AA'   C8                    	RZ
  25AB'   7E                    	MOV	A,M
  25AC'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  25AE'   FE 52                 	CPI	'R'
  25B0'   C2 259C'              	JNZ	AS_SKP
  25B3'   32 2EDA'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  25B6'   C3 259C'              	JMP	AS_SKP
  25B9'                         AS_PLS:
  25B9'   3E 01                 	MVI	A,1
  25BB'   32 2EDB'              	STA	PLUSF		; '+' gets the line even with no number on it
  25BE'   11 0000*              	LXI	D,PLUSB
  25C1'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  25C3'   23                    	INX	H		;   line space, so it is taken as '+' alone
  25C4'   05                    	DCR	B
  25C5'   CA 25FC'              	JZ	AS_PE
  25C8'   7E                    	MOV	A,M
  25C9'   FE 30                 	CPI	'0'
  25CB'   C2 25E3'              	JNZ	AS_PD
  25CE'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  25CE'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  25CF'   05                    	DCR	B
  25D0'   CA 2604'              	JZ	AS_P1
  25D3'   7E                    	MOV	A,M
  25D4'   FE 30                 	CPI	'0'
  25D6'   CA 25CE'              	JZ	AS_PZ
  25D9'   FE 31                 	CPI	'1'
  25DB'   DA 2604'              	JC	AS_P1		; zeros and then no digit at all: line 1
  25DE'   FE 3A                 	CPI	'9'+1
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  25E0'   D2 2604'              	JNC	AS_P1
  25E3'                         AS_PD:				; the digits, as typed
  25E3'   7E                    	MOV	A,M
  25E4'   FE 30                 	CPI	'0'
  25E6'   DA 25FC'              	JC	AS_PE
  25E9'   FE 3A                 	CPI	'9'+1
  25EB'   D2 25FC'              	JNC	AS_PE
  25EE'   79                    	MOV	A,C
  25EF'   B7                    	ORA	A
  25F0'   CA 260B'              	JZ	AS_POV
  25F3'   0D                    	DCR	C
  25F4'   7E                    	MOV	A,M
  25F5'   12                    	STAX	D
  25F6'   13                    	INX	D
  25F7'   23                    	INX	H
  25F8'   05                    	DCR	B
  25F9'   C2 25E3'              	JNZ	AS_PD
  25FC'                         AS_PE:
  25FC'   AF                    	XRA	A
  25FD'   12                    	STAX	D		; the digits end with a 0
  25FE'   78                    	MOV	A,B
  25FF'   B7                    	ORA	A
  2600'   C8                    	RZ
  2601'   C3 2581'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  2604'                         AS_P1:
  2604'   3E 31                 	MVI	A,'1'
  2606'   12                    	STAX	D
  2607'   13                    	INX	D
  2608'   C3 25FC'              	JMP	AS_PE
  260B'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  260B'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  260E'   C3 25FC'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  2611'                         ARGGO:
  2611'   3A 2EDB'              	LDA	PLUSF
  2614'   B7                    	ORA	A
  2615'   C8                    	RZ
  2616'   21 0000*              	LXI	H,PLUSB
  2619'                         AG_LP:
  2619'   7E                    	MOV	A,M
  261A'   B7                    	ORA	A
  261B'   CA 2628'              	JZ	AG_G
  261E'   4F                    	MOV	C,A
  261F'   E5                    	PUSH	H
  2620'   CD 0023'              	CALL	VICMD
  2623'   E1                    	POP	H
  2624'   23                    	INX	H
  2625'   C3 2619'              	JMP	AG_LP
  2628'                         AG_G:
  2628'   0E 47                 	MVI	C,'G'
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  262A'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  262D'                         NRMDRV:
  262D'   7E                    	MOV	A,M
  262E'   B7                    	ORA	A
  262F'   C0                    	RNZ
  2630'   E5                    	PUSH	H
  2631'   0E 19                 	MVI	C,BF_CURDSK
  2633'   CD 0005               	CALL	BDOS
  2636'   E1                    	POP	H
  2637'   3C                    	INR	A
  2638'   77                    	MOV	M,A
  2639'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  263A'                         PARSFN:
  263A'   CD 254A'              	CALL	TFCLR
  263D'   11 0000*              	LXI	D,TFCB
  2640'   23                    	INX	H
  2641'   7E                    	MOV	A,M
  2642'   2B                    	DCX	H
  2643'   FE 3A                 	CPI	':'
  2645'   C2 2657'              	JNZ	PF_NM
  2648'   CD 269D'              	CALL	GETFNC
  264B'   CA 2657'              	JZ	PF_NM
  264E'   D6 40                 	SUI	40H
  2650'   12                    	STAX	D
  2651'   FE 11                 	CPI	17
  2653'   D2 267B'              	JNC	PF_BAD
  2656'   23                    	INX	H
  2657'                         PF_NM:
  2657'   13                    	INX	D
  2658'   0E 08                 	MVI	C,8
  265A'   CD 267F'              	CALL	CPYNAM
  265D'   FE 2E                 	CPI	'.'
  265F'   0E 03                 	MVI	C,3
  2661'   C4 2692'              	CNZ	PADFLD		; no type: blanks
  2664'   CC 267E'              	CZ	CPYNM0		; '.': the type
  2667'   3A 0001*              	LDA	TFCB+1
  266A'   FE 20                 	CPI	' '
  266C'   CA 267B'              	JZ	PF_BAD		; no name
  266F'   CD 26D0'              	CALL	SKIPB
  2672'   C0                    	RNZ			; more after it
  2673'   21 0000*              	LXI	H,TFCB
  2676'   CD 262D'              	CALL	NRMDRV
  2679'   AF                    	XRA	A
  267A'   C9                    	RET
  267B'                         PF_BAD:
  267B'   F6 01                 	ORI	1
  267D'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  267E'                         CPYNM0:
  267E'   23                    	INX	H
  267F'                         CPYNAM:
  267F'   CD 269D'              	CALL	GETFNC
  2682'   CA 2692'              	JZ	PADFLD
  2685'   12                    	STAX	D
  2686'   13                    	INX	D
  2687'   0D                    	DCR	C
  2688'   C2 267F'              	JNZ	CPYNAM
  268B'                         CN_SKP:
  268B'   CD 269D'              	CALL	GETFNC
  268E'   C2 268B'              	JNZ	CN_SKP
  2691'   C9                    	RET
  2692'                         PADFLD:
  2692'   F5                    	PUSH	PSW
  2693'                         PD_LP:
  2693'   3E 20                 	MVI	A,' '
  2695'   12                    	STAX	D
  2696'   13                    	INX	D
  2697'   0D                    	DCR	C
  2698'   C2 2693'              	JNZ	PD_LP
  269B'   F1                    	POP	PSW
  269C'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  269D'                         GETFNC:
  269D'   7E                    	MOV	A,M
  269E'   FE 3D                 	CPI	'='
  26A0'   C8                    	RZ
  26A1'   FE 5F                 	CPI	'_'
  26A3'   C8                    	RZ
  26A4'   FE 3B                 	CPI	';'
  26A6'   C8                    	RZ
  26A7'   FE 3C                 	CPI	'<'
  26A9'   C8                    	RZ
  26AA'   FE 3E                 	CPI	'>'
  26AC'   C8                    	RZ
  26AD'   FE 2E                 	CPI	'.'
  26AF'   C8                    	RZ
  26B0'   FE 3A                 	CPI	':'
  26B2'   C8                    	RZ
  26B3'   FE 2A                 	CPI	'*'
  26B5'   C8                    	RZ
  26B6'   FE 3F                 	CPI	'?'
  26B8'   C8                    	RZ
  26B9'   FE 20                 	CPI	' '
  26BB'   DA 26CE'              	JC	GF_CTL
  26BE'   C8                    	RZ
  26BF'   23                    	INX	H
  26C0'   FE 61                 	CPI	'a'
  26C2'   DA 26CC'              	JC	GF_DN
  26C5'   FE 7B                 	CPI	'z'+1
	MACRO-80 3.44	09-Dec-81	PAGE	1-122


  26C7'   D2 26CC'              	JNC	GF_DN
  26CA'   E6 DF                 	ANI	0DFH
  26CC'                         GF_DN:
  26CC'   B7                    	ORA	A
  26CD'   C9                    	RET
  26CE'                         GF_CTL:
  26CE'   BF                    	CMP	A
  26CF'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  26D0'                         SKIPB:
  26D0'   7E                    	MOV	A,M
  26D1'   FE 20                 	CPI	' '
  26D3'   C2 26DA'              	JNZ	SB_DN
  26D6'   23                    	INX	H
  26D7'   C3 26D0'              	JMP	SKIPB
  26DA'                         SB_DN:
  26DA'   B7                    	ORA	A
  26DB'   C9                    	RET
                                
                                ;ISLOW -- A = the char at HL; NC iff a-z.
  26DC'                         ISLOW:
  26DC'   7E                    	MOV	A,M
  26DD'   FE 61                 	CPI	'a'
  26DF'   D8                    	RC
  26E0'   FE 7B                 	CPI	'z'+1
  26E2'   3F                    	CMC
  26E3'   C9                    	RET
                                
                                ;--- ex messages (vim's, without the Enn number) ---
  26E4'                         MSGNFN:
  26E4'   21 2731'              	LXI	H,SNFN
  26E7'   C3 271C'              	JMP	EXERR
  26EA'                         MSGEXI:
  26EA'   21 274B'              	LXI	H,SEXI
  26ED'   C3 26F9'              	JMP	EXBNG
  26F0'                         MSGRO:
  26F0'   21 2757'              	LXI	H,SRO
  26F3'   C3 26F9'              	JMP	EXBNG
  26F6'                         MSGNWR:
  26F6'   21 273E'              	LXI	H,SNWR
  26F9'                         EXBNG:
  26F9'   CD 271C'              	CALL	EXERR
  26FC'   21 2763'              	LXI	H,SBNG
  26FF'   C3 2717'              	JMP	EXOUT
  2702'                         EX_INV:
  2702'   21 2771'              	LXI	H,SINV
  2705'   C3 271C'              	JMP	EXERR
  2708'                         EX_V:				; :ve -- the version, on the bottom row
  2708'   21 272C'              	LXI	H,SVER
  270B'   C3 271C'              	JMP	EXERR
  270E'                         EX_TRL:
  270E'   21 2783'              	LXI	H,STRL
  2711'                         EXERT:				; the message, then the text at EXCMD
  2711'   CD 271C'              	CALL	EXERR
  2714'   2A 2EC9'              	LHLD	EXCMD
	MACRO-80 3.44	09-Dec-81	PAGE	1-123


  2717'                         EXOUT:
  2717'   CD 0000*              	CALL	OUTSTR
  271A'   37                    	STC
  271B'   C9                    	RET
                                ;EXERR -- HL = a message for the bottom row; it stays there (only the cursor
                                ; goes back), CY.
  271C'                         EXERR:
  271C'   E5                    	PUSH	H
