  2CCC'   17B0'                 	DW	VCB_C
  2CCE'   63                    	DB	'c'
  2CCF'   1A1B'                 	DW	VC_C
  2CD1'   6F                    	DB	'o'
  2CD2'   18B6'                 	DW	VC_O
  2CD4'   4F                    	DB	'O'
  2CD5'   18CB'                 	DW	VCB_O
  2CD7'   4A                    	DB	'J'
  2CD8'   18E5'                 	DW	VCB_J
  2CDA'   7E                    	DB	'~'
  2CDB'   1967'                 	DW	VC_TILD
  2CDD'   3A                    	DB	':'
  2CDE'   1F98'                 	DW	VC_EX
  2CE0'   2F                    	DB	'/'
  2CE1'   299B'                 	DW	VC_SRCH
  2CE3'   3F                    	DB	'?'
  2CE4'   299B'                 	DW	VC_SRCH
  2CE6'   6E                    	DB	'n'
  2CE7'   29EE'                 	DW	VC_N
  2CE9'   4E                    	DB	'N'
  2CEA'   29F7'                 	DW	VCB_N
  2CEC'   48                    	DB	'H'
  2CED'   0D90'                 	DW	VC_HIGH
  2CEF'   4D                    	DB	'M'
  2CF0'   0DA7'                 	DW	VC_MIDL
  2CF2'   4C                    	DB	'L'
  2CF3'   0DC2'                 	DW	VC_LOWL
  2CF5'   06                    	DB	06H			; ^F -- page forward
  2CF6'   0DDF'                 	DW	VC_PGDN
  2CF8'   02                    	DB	02H			; ^B -- page back
  2CF9'   0E3D'                 	DW	VC_PGUP
  2CFB'   04                    	DB	04H			; ^D -- half page down
  2CFC'   0F1E'                 	DW	VC_HFDN
  2CFE'   15                    	DB	15H			; ^U -- half page up
  2CFF'   0FE5'                 	DW	VC_HFUP
  2D01'   0C                    	DB	0CH			; ^L -- redraw
  2D02'   1194'                 	DW	VC_REDR
  2D04'   2E                    	DB	'.'			; '.' -- repeat the last change
  2D05'   017D'                 	DW	VC_DOT
  2D07'   75                    	DB	'u'			; 'u' -- undo (and undo the undo)
  2D08'   0545'                 	DW	VC_UNDO
  2D0A'   6D                    	DB	'm'		; m{a-c} -- set a mark
  2D0B'   032E'                 	DW	VC_MK
  2D0D'   60                    	DB	60H		; `{a-c} -- back to its exact spot
  2D0E'   0333'                 	DW	VC_BQ
  2D10'   27                    	DB	27H		; '{a-c} -- back to its line's first non-blank
  2D11'   0338'                 	DW	VC_AQ
  2D13'   00                    	DB	0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  2D14'   00                    EDMODE: DB	EM_CMD
  2D15'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  2D17'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  2D18'   00                    MODF:	DB	0		; 1 = unsaved changes
	MACRO-80 3.44	09-Dec-81	PAGE	1-139


  2D19'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  2D1A'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  2D1B'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  2D1C'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  2D1D'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  2D1F'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  2D20'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  2D21'   00                    HFAMT:	DB	0		; ^D/^U: rows (vim's 'scroll'); 0 = NEDIT/2
  2D22'   00                    HFN:	DB	0		; ^D/^U: the rows this one goes
  2D23'   0000                  HFTP:	DW	0		; ^D/^U: -> the new top line's entry
  2D25'   00                    HTN:	DB	0		; row table: its entries
  2D26'   00                    HTCUR:	DB	0		; ... the cursor line's
  2D27'   00                    HTTP:	DB	0		; ... the top line's
  2D28'   00                    HTEOF:	DB	0		; ... 1 = its last is the file's last line
  2D29'   00                    HTBOF:	DB	0		; ... 1 = its first is the file's first
  2D2A'   0000                  RWR:	DW	0		; ^F/^B: rows still to go
  2D2C'   00                    RWMV:	DB	0		; ^F/^B: 1 = the table was made again on the way
  2D2D'   00                    OVDIR:	DB	0		; OVLAP: 0 = h2.. are above h1 in the table
  2D2E'   0000                  JKCNT:	DW	0		; j/k: count
  2D30'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  2D32'   0000                  JKMOV:	DW	0		; j: lines moved
  2D34'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  2D36'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  2D37'   00                    JKLST:	DB	0		; j: last byte of the scan
  2D38'   0000                  JKVC:	DW	0		; j/k landing: screen column
  2D3A'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  2D3C'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  2D3D'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  2D3E'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  2D3F'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  2D40'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  2D41'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  2D43'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  2D44'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  2D45'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  2D47'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  2D48'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  2D49'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  2D4A'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
  2D4B'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  2D4C'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  2D4D'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   and its first word is yet to be stepped
  2D4E'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  2D50'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
	MACRO-80 3.44	09-Dec-81	PAGE	1-140


  2D52'   00 00 00              OPSFP:	DB	0,0,0		; operator: the start as a place in the file
  2D55'   00 00 00              OPSLO:	DB	0,0,0		; ... where its line starts
  2D58'   00 00 00              OPSHI:	DB	0,0,0		; ... where the next line does (OPPGD: the span's
                                				;   high end, whichever line that turned out to be)
  2D5B'   00 00 00              OPTOGO: DB	0,0,0		; OPPGD: bytes still to take
  2D5E'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  2D60'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  2D62'   0000                  CNTV:	DW	0		; motion repeat counter
  2D64'   0000                  TTI:	DW	0		; TAILTAB scan index
  2D66'   0000                  WKI:	DW	0		; scan index
  2D68'   0000                  WKN:	DW	0		; cached LOGLEN
  2D6A'   0000                  WKTERM: DW	0		; line terminator offset
  2D6C'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  2D6E'   00                    WKCLS:	DB	0		; word motion: class of the current run
  2D6F'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  2D70'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  2D72'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  2D74'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
  2D76'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  2D78'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  2D79'   00                    RLMAX:	DB	0		; RDLINE: capacity
  2D7A'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  2D7B'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  2D7C'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  2D7D'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  2D7F'   00                    WPROW:	DB	0		; :w -- the cursor's row
  2D80'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  2D81'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2D83'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  2D85'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  2D86'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  2D88'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  2D8A'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  2D8B'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  2D8C'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  2D8D'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  2D8E'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  2D8F'   00                    PLUSF:	DB	0		; command line: '+' was given
  2D90'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  2D91'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  2D92'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  2D93'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  2D95'   0000                  YPT:	DW	0		; yy: where the lines came from
  2D97'   0000                  PCNT:	DW	0		; p/P: copies still to put
  2D99'   00 00 00              PPFP:	DB	0,0,0		; p/P: the first line put, a file position
  2D9C'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  2D9E'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  2D9F'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  2DA1'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  2DA2'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  2DA3'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  2DA4'   00                    FNDKND: DB	0		; f/F/t/T: which find ';' repeats (0 = none yet)
	MACRO-80 3.44	09-Dec-81	PAGE	1-141


  2DA5'   00                    FNDCH:	DB	0		; ... and the character it looked for
  2DA6'   00                    FNDRUN: DB	0		; the find THIS command is running (',' reverses)
  2DA7'   00                    FNDSTP: DB	0		; how far along it starts: 2 for a 't' repeat
  2DA8'   0000                  FNDN:	DW	0		; occurrences still to count off
  2DAA'   0000                  FNDCUR: DW	0		; the cursor it started from
  2DAC'   0000                  FNDLIM: DW	0		; ... and the end of the line it may not pass
  2DAE'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  2DAF'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  2DB2'   00 00 00              MKEDIT: DB	0,0,0		; MKSHFT: where in the file the edit is
  2DB5'   0000                  MKN:	DW	0		; ... how long it is
  2DB7'   00                    MKTYP:	DB	0		; ... and which way: 1 text went in, 2 came out
  2DB8'   00 00 00              MKPOS:	DB	0,0,0		; MKJMP: the file position being jumped to
  2DBB'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  2DBC'   00                    MKHOLD: DB	0		; set across YKGO's delete + put back (a yank
                                				;   that could not copy): MKSHFT must leave the
                                				;   marks alone through it
  2DBD'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  2DBF'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  2DC1'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  2DC3'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  2DC5'   00 00 00              YPFP:	DB	0,0,0		; ... and where in the file they start
                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  2DC8'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  2DCA'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
  2DCC'   0000                  SCNT:	DW	0		; searches still to do (the count)
  2DCE'   00 00 00              SOFF:	DB	0,0,0		; BRKON: where in the FILE the command began
  2DD1'   0000                  SLDLT:	DW	0		; ... and LNDLT: for a search that fails, and
                                				;   any move an ESC stops
  2DD3'   00                    BRKARM: DB	0		; nonzero: CNTTST looks for an ESC
  2DD4'   00                    BRKHIT: DB	0		; nonzero: one was found, and the count spent
  2DD5'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  2DD6'   00                    SRNGF:	DB	0		; ex: a line range was given
  2DD7'   0000                  SRNG1:	DW	0		; ex: its first line
  2DD9'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  2DDB'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  2DDC'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  2DDD'   00                    SANY:	DB	0		; ':s' something in the range has changed
  2DDE'   00                    SLCHG:	DB	0		; ':s' this line changed
  2DDF'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  2DE1'   0000                  SLINES: DW	0		; ':s' / ':N,Mw' lines of the range still to do
  2DE3'   00                    RWPTR:	DB	0		; ':N,Mw' the next free byte of the record at
                                				;   0080H, as that address's low byte
  2DE4'   00                    RWERR:	DB	0		; ':N,Mw' a record would not go: the disk is full
	MACRO-80 3.44	09-Dec-81	PAGE	1-142


  2DE5'   00                    RDANY:	DB	0		; ':r' something has been read in
  2DE6'   00                    RDBRK:	DB	0		; ':r' the line above wants a line end first
  2DE7'   00 00 00              SOFFS:	DB	0,0,0		; ':s' the cursor's place in the file, for one that
  2DEA'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  2DEC'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  2DED'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
