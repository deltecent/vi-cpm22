  2949'   2603'                 	DW	VC_SRCH
  294B'   3F                    	DB	'?'
  294C'   2603'                 	DW	VC_SRCH
  294E'   6E                    	DB	'n'
  294F'   2656'                 	DW	VC_N
  2951'   4E                    	DB	'N'
  2952'   265F'                 	DW	VCB_N
  2954'   48                    	DB	'H'
  2955'   0D30'                 	DW	VC_HIGH
  2957'   4D                    	DB	'M'
  2958'   0D47'                 	DW	VC_MIDL
  295A'   4C                    	DB	'L'
  295B'   0D55'                 	DW	VC_LOWL
  295D'   06                    	DB	06H			; ^F -- page forward
  295E'   0D72'                 	DW	VC_PGDN
  2960'   02                    	DB	02H			; ^B -- page back
  2961'   0D9F'                 	DW	VC_PGUP
  2963'   04                    	DB	04H			; ^D -- half page down
  2964'   0DF3'                 	DW	VC_HFDN
  2966'   15                    	DB	15H			; ^U -- half page up
  2967'   0E27'                 	DW	VC_HFUP
  2969'   0C                    	DB	0CH			; ^L -- redraw
  296A'   0E9B'                 	DW	VC_REDR
  296C'   2E                    	DB	'.'			; '.' -- repeat the last change
  296D'   0195'                 	DW	VC_DOT
  296F'   75                    	DB	'u'			; 'u' -- undo (and undo the undo)
  2970'   050D'                 	DW	VC_UNDO
  2972'   6D                    	DB	'm'		; m{a-c} -- set a mark
  2973'   0354'                 	DW	VC_MK
  2975'   60                    	DB	60H		; `{a-c} -- back to its exact spot
  2976'   0359'                 	DW	VC_BQ
  2978'   27                    	DB	27H		; '{a-c} -- back to its line's first non-blank
  2979'   035E'                 	DW	VC_AQ
  297B'   00                    	DB	0
                                
  297C'                         ACTTAB:
  297C'   04                    	DB	ACT_CURLT
  297D'   07B3'                 	DW	VC_H
  297F'   03                    	DB	ACT_CURRT
