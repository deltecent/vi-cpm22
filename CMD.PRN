                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  0003                   C      CTRLC	EQU	03H		; ^C -- abandons a search or a long move
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the current row is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; current line changed only -> redraw that one row
  0003                   C      R_DLIN	EQU	3		; one line deleted at the cursor row -> DL + redraw bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted mid-line -> ICH (no tail redraw)
  0005                   C      R_ILIN	EQU	5		; one line opened at the cursor row -> IL + redraw that row and the one above
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw that row + DL the one under it
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; KEY DECODER -- GETKEY return types (B) and action codes (C when B=KT_ACT).
                         C      ; See KEY.MAC.
                         C      ;------------------------------------------------------------
  0000                   C      KT_NONE EQU	0		; no key (unrecognised ESC sequence, discarded)
  0001                   C      KT_ACT	EQU	1		; C = ACT_xxx action code
  0002                   C      KT_CHAR EQU	2		; C = ASCII character (printable or control)
                         C      
  0001                   C      ACT_CURUP EQU	1		; cursor up    (ESC[A / ESC OA)
  0002                   C      ACT_CURDN EQU	2		; cursor down  (ESC[B / ESC OB)
  0003                   C      ACT_CURRT EQU	3		; cursor right (ESC[C / ESC OC)
  0004                   C      ACT_CURLT EQU	4		; cursor left  (ESC[D / ESC OD)
  0005                   C      ACT_LINST EQU	5		; Home / line start (ESC[H / ESC[1~)
  0006                   C      ACT_LINEN EQU	6		; End  / line end   (ESC[F / ESC[4~)
  0007                   C      ACT_PGUP  EQU	7		; page up   (ESC[5~)
  0008                   C      ACT_PGDN  EQU	8		; page down (ESC[6~)
  0009                   C      ACT_INS	  EQU	9		; Insert key (ESC[2~)
  000A                   C      ACT_DEL	  EQU	10		; Delete key (ESC[3~)
  000B                   C      ACT_ESC	  EQU	11		; lone ESC (after timeout)
  000B                   C      ACT_MAX	  EQU	11		; highest defined action code
                         C      
  01F4                   C      ESCTMO	EQU	500		; polls before a lone ESC is confirmed
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	COL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	MKSHFT				; the marks follow an edit (VI.MAC hooks it)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	KBBRK, KBFLSH			; KEY.MAC -- a ^C waiting / drop type-ahead
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	MKSAV				; ... and a refused 'dd's copy of them
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	UNDCLR				; ... nothing to undo
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	INSBLK, UNDINS			; BUF.MAC -- a block in at the cursor (':r')
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
                                	EXTRN	SCBOT, SCEOF, SCBOF, WFILL	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	SETC0				; BUF.MAC -- WM count set, forward
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GOLINE				; BUF.MAC -- WM 2228 (a mark's page loop)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   AF                    	XRA	A		; no command is ever left open to a ^C by the
  0001'   32 2A88'              	STA	BRKARM		;   one before it (BRKON)
  0004'   CD 00DD'              	CALL	DOTPRE
  0007'   CD 000D'              	CALL	CDMODE
  000A'   C3 0134'              	JMP	DOTPOST
  000D'                         CDMODE:
  000D'   3A 29D5'              	LDA	EDMODE
  0010'   FE 01                 	CPI	EM_INS
  0012'   CA 001D'              	JZ	CD_INS
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  0015'   FE 02                 	CPI	EM_REP
  0017'   CA 0020'              	JZ	CD_REP
  001A'   C3 0023'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  001D'                         CD_INS:
  001D'   C3 1B1F'              	JMP	VIINS
  0020'                         CD_REP:
  0020'   C3 1A5F'              	JMP	VIREP
                                
                                ;============================================================
                                ; VICMD -- command-mode key.  B = KT type, C = char / action.
                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  0023'                         VICMD:
  0023'   78                    	MOV	A,B
  0024'   FE 00                 	CPI	KT_NONE
  0026'   C8                    	RZ			; discarded key
  0027'   FE 01                 	CPI	KT_ACT
  0029'   CA 00AF'              	JZ	VIC_ACT
  002C'   3A 29FD'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002F'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  0031'   CA 166C'              	JZ	VR_DO
                                	;--- KT_CHAR: maybe a count digit ---
  0034'   79                    	MOV	A,C
  0035'   FE 31                 	CPI	'1'
  0037'   DA 0042'              	JC	VIC_NOTD	; < '1'
  003A'   FE 3A                 	CPI	'9'+1
  003C'   D2 0042'              	JNC	VIC_NOTD	; > '9'
  003F'   C3 0052'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  0042'                         VIC_NOTD:
  0042'   79                    	MOV	A,C
  0043'   FE 30                 	CPI	'0'
  0045'   C2 007A'              	JNZ	VICDSP
  0048'   2A 29D6'              	LHLD	CMDCNT
  004B'   7C                    	MOV	A,H
  004C'   B5                    	ORA	L
  004D'   CA 007A'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  0050'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  0052'                         VICDIG:
  0052'   2A 29D6'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0055'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0056'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0057'   29                    	DAD	H		; *2
  0058'   DA 0071'              	JC	VIC_SAT
  005B'   29                    	DAD	H		; *4
  005C'   DA 0071'              	JC	VIC_SAT
  005F'   19                    	DAD	D		; *5
  0060'   DA 0071'              	JC	VIC_SAT
  0063'   29                    	DAD	H		; *10
  0064'   DA 0071'              	JC	VIC_SAT
  0067'   79                    	MOV	A,C
  0068'   D6 30                 	SUI	'0'
  006A'   5F                    	MOV	E,A
  006B'   16 00                 	MVI	D,0
  006D'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  006E'   D2 0074'              	JNC	VIC_CNT
  0071'                         VIC_SAT:
  0071'   21 FFFF               	LXI	H,0FFFFH
  0074'                         VIC_CNT:
  0074'   22 29D6'              	SHLD	CMDCNT
  0077'   C3 075A'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  007A'                         VICDSP:
  007A'   3A 29FD'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  007D'   32 29FE'              	STA	GSAVE
  0080'   AF                    	XRA	A
  0081'   32 29FD'              	STA	GPEND
  0084'   3A 29FF'              	LDA	PENDOP
  0087'   32 2A00'              	STA	PSAVE
  008A'   AF                    	XRA	A
  008B'   32 29FF'              	STA	PENDOP
  008E'   3A 2A00'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  0091'   B7                    	ORA	A
  0092'   C2 103F'              	JNZ	OPPEND
  0095'   3A 29FE'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0098'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  009A'   C2 00A3'              	JNZ	VIC_TB
  009D'   79                    	MOV	A,C
  009E'   FE 5A                 	CPI	'Z'
  00A0'   C2 00A9'              	JNZ	VIC_SW
  00A3'                         VIC_TB:
  00A3'   21 2904'              	LXI	H,CMDTAB
  00A6'   C3 00C2'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A9'                         VIC_SW:
  00A9'   CD 075A'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00AC'   C3 068B'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AF'                         VIC_ACT:
  00AF'   AF                    	XRA	A		; action key clears all pending state
  00B0'   32 29FD'              	STA	GPEND
  00B3'   32 29FE'              	STA	GSAVE
  00B6'   32 29FF'              	STA	PENDOP
  00B9'   32 2A00'              	STA	PSAVE
  00BC'   21 29BC'              	LXI	H,ACTTAB
  00BF'   C3 00C2'              	JMP	VSCANQ
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the two TOP-LEVEL key tables, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00C2'                         VSCANQ:
  00C2'   CD 00CE'              	CALL	VSCLK
  00C5'   CA 00A9'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C8'   E9                    	PCHL
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00C9'                         VSCAN:
  00C9'   CD 00CE'              	CALL	VSCLK
  00CC'   C8                    	RZ			; miss
  00CD'   E9                    	PCHL
  00CE'                         VSCLK:
  00CE'   7E                    VSCAN1: MOV	A,M
  00CF'   B7                    	ORA	A
  00D0'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00D1'   23                    	INX	H
  00D2'   B9                    	CMP	C
  00D3'   5E                    	MOV	E,M
  00D4'   23                    	INX	H
  00D5'   56                    	MOV	D,M
  00D6'   23                    	INX	H
  00D7'   C2 00CE'              	JNZ	VSCAN1
  00DA'   EB                    	XCHG			; HL = the handler
  00DB'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00DC'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00DD'                         DOTPRE:
  00DD'   3A 29F4'              	LDA	DOTRPL
  00E0'   B7                    	ORA	A
  00E1'   C0                    	RNZ			; the replay's own keys are not recorded
  00E2'   C5                    	PUSH	B
  00E3'   D5                    	PUSH	D
  00E4'   E5                    	PUSH	H
  00E5'   3A 29F3'              	LDA	DOTSTA
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00E8'   B7                    	ORA	A
  00E9'   CA 00FC'              	JZ	DOTP1
  00EC'   AF                    	XRA	A		; a new command: the recording starts over
  00ED'   32 29F3'              	STA	DOTSTA
  00F0'   32 29F5'              	STA	DOTOVF
  00F3'   21 0000*              	LXI	H,DOTSCR
  00F6'   22 29F7'              	SHLD	DOTSP
  00F9'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00FC'                         DOTP1:
  00FC'   78                    	MOV	A,B
  00FD'   FE 00                 	CPI	KT_NONE
  00FF'   CA 0128'              	JZ	DOTPX		; a discarded key is not a keystroke
  0102'   FE 01                 	CPI	KT_ACT
  0104'   79                    	MOV	A,C
  0105'   CA 010D'              	JZ	DOTP2
  0108'   E6 7F                 	ANI	7FH		; a char stands for itself (CPYGAP masks inserts
  010A'   C3 010F'              	JMP	DOTP3		;   the same way), bit 7 marks an action key
  010D'                         DOTP2:
  010D'   F6 80                 	ORI	80H		; an action key (an arrow) rides in bit 7
  010F'                         DOTP3:
  010F'   32 29F6'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  0112'   47                    	MOV	B,A
  0113'   2A 29F7'              	LHLD	DOTSP
  0116'   EB                    	XCHG
  0117'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  011A'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  011D'   D2 012C'              	JNC	DOTPOV
  0120'   2A 29F7'              	LHLD	DOTSP
  0123'   70                    	MOV	M,B
  0124'   23                    	INX	H
  0125'   22 29F7'              	SHLD	DOTSP
  0128'                         DOTPX:
  0128'   E1                    	POP	H
  0129'   D1                    	POP	D
  012A'   C1                    	POP	B
  012B'   C9                    	RET
  012C'                         DOTPOV:
  012C'   3E 01                 	MVI	A,1
  012E'   32 29F5'              	STA	DOTOVF		; too long to record: give this recording up
  0131'   C3 0128'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  0134'                         DOTPOST:
  0134'   3A 29F4'              	LDA	DOTRPL
  0137'   B7                    	ORA	A
  0138'   C0                    	RNZ
  0139'   3A 29D5'              	LDA	EDMODE
  013C'   B7                    	ORA	A
  013D'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  013E'   3A 29FD'              	LDA	GPEND
  0141'   B7                    	ORA	A
  0142'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  0143'   3A 29FF'              	LDA	PENDOP
  0146'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0147'   C0                    	RNZ			; an operator still waiting for its motion
  0148'   2A 29D6'              	LHLD	CMDCNT
  014B'   7C                    	MOV	A,H
  014C'   B5                    	ORA	L
  014D'   CA 015B'              	JZ	DOTQ1
  0150'   3A 29F6'              	LDA	DOTLK		; a digit with the count still up: the command
  0153'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  0155'   DA 015B'              	JC	DOTQ1
  0158'   FE 3A                 	CPI	'9'+1
  015A'   D8                    	RC
  015B'                         DOTQ1:
  015B'   3E 01                 	MVI	A,1
  015D'   32 29F3'              	STA	DOTSTA		; the next key starts a new recording
  0160'   3A 29F2'              	LDA	DOTCHG
  0163'   B7                    	ORA	A
  0164'   C8                    	RZ			; changed nothing: not a repeatable command
  0165'   AF                    	XRA	A
  0166'   32 29F2'              	STA	DOTCHG
  0169'   32 29F9'              	STA	DOTLEN
  016C'   3A 29F5'              	LDA	DOTOVF
  016F'   B7                    	ORA	A
  0170'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  0171'   2A 29F7'              	LHLD	DOTSP
  0174'   11 0000*              	LXI	D,DOTSCR
  0177'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  017A'   7D                    	MOV	A,L
  017B'   32 29F9'              	STA	DOTLEN
  017E'   B7                    	ORA	A
  017F'   C8                    	RZ
  0180'   4F                    	MOV	C,A
  0181'   06 00                 	MVI	B,0
  0183'   21 0000*              	LXI	H,DOTSCR
  0186'   11 0000*              	LXI	D,DOTBUF
  0189'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  018C'                         MARKMOD:
  018C'   3E 01                 	MVI	A,1
  018E'   32 29D9'              	STA	MODF
  0191'   32 29F2'              	STA	DOTCHG
  0194'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  0195'                         VC_DOT:
  0195'   2A 29D6'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0198'   22 29FB'              	SHLD	DOTNCT
  019B'   21 0000               	LXI	H,0
  019E'   22 29D6'              	SHLD	CMDCNT
  01A1'   3A 29F9'              	LDA	DOTLEN
  01A4'   B7                    	ORA	A
  01A5'   CA 01FF'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01A8'   AF                    	XRA	A
  01A9'   32 29FA'              	STA	DOTIX
  01AC'   2A 29FB'              	LHLD	DOTNCT
  01AF'   7C                    	MOV	A,H
  01B0'   B5                    	ORA	L
  01B1'   CA 01D1'              	JZ	DOTGO
  01B4'   22 29D6'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  01B7'                         DOTSKP:
  01B7'   CD 0564'              	CALL	DOTGET		; ... so step past the digits it recorded
  01BA'   DA 01D1'              	JC	DOTGO
  01BD'   FE 30                 	CPI	'0'
  01BF'   DA 01D1'              	JC	DOTGO
  01C2'   FE 3A                 	CPI	'9'+1
  01C4'   D2 01D1'              	JNC	DOTGO
  01C7'   3A 29FA'              	LDA	DOTIX
  01CA'   3C                    	INR	A
  01CB'   32 29FA'              	STA	DOTIX
  01CE'   C3 01B7'              	JMP	DOTSKP
  01D1'                         DOTGO:
  01D1'   3E 01                 	MVI	A,1
  01D3'   32 29F4'              	STA	DOTRPL
  01D6'                         DOTLP:
  01D6'   CD 0564'              	CALL	DOTGET
  01D9'   DA 01F5'              	JC	DOTDN
  01DC'   4F                    	MOV	C,A
  01DD'   06 02                 	MVI	B,KT_CHAR
  01DF'   B7                    	ORA	A
  01E0'   F2 01E8'              	JP	DOTLP2
  01E3'   E6 7F                 	ANI	7FH		; bit 7: the key was an action, not a char
  01E5'   4F                    	MOV	C,A
  01E6'   06 01                 	MVI	B,KT_ACT
  01E8'                         DOTLP2:
  01E8'   3A 29FA'              	LDA	DOTIX
  01EB'   3C                    	INR	A
  01EC'   32 29FA'              	STA	DOTIX
  01EF'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01F2'   C3 01D6'              	JMP	DOTLP
  01F5'                         DOTDN:
  01F5'   AF                    	XRA	A
  01F6'   32 29F4'              	STA	DOTRPL
  01F9'   32 29F2'              	STA	DOTCHG		; the '.' is not itself the new last change
  01FC'   C3 077B'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01FF'                         DOTBEL:
  01FF'   0E 07                 	MVI	C,BEL
  0201'   CD 0000*              	CALL	BCONOU
  0204'   C3 075A'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a 3-byte position in the FILE (FPOS: the records paged out ahead
                                ; of the window, plus the offset into it), so it does not care which part of
                                ; the file is resident: a jump pages until the window holds it (MKPAGE).  It
                                ; FOLLOWS its text, as vim's does: every edit passes MKSHFT, which moves the
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


                                ; marks past it by the bytes that went in or came out.
                                ;
                                ; DEVIATIONS from vim, in COMMANDS.md: a mark whose own text is deleted closes
                                ; up to where the delete was, where vim deletes the mark with its line; and
                                ; within its line a mark stays with its CHARACTER, where vim keeps the column
                                ; number.  '.' after a 'd''a' still refuses: the mark letter is read inside
                                ; the command and never recorded.
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  0207'                         MKVAD:
  0207'   16 00                 	MVI	D,0
  0209'   59                    	MOV	E,C
  020A'   21 2A64'              	LXI	H,MKVAL
  020D'   19                    	DAD	D
  020E'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  020F'                         MKCLR:
  020F'   21 2A64'              	LXI	H,MKVAL
  0212'   06 03                 	MVI	B,MKMAX
  0214'   AF                    	XRA	A
  0215'                         MKC_LP:
  0215'   77                    	MOV	M,A
  0216'   23                    	INX	H
  0217'   05                    	DCR	B
  0218'   C2 0215'              	JNZ	MKC_LP
  021B'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was not a character.
  021C'                         MKGETK:
  021C'   3A 29F4'              	LDA	DOTRPL
  021F'   B7                    	ORA	A
  0220'   CA 0231'              	JZ	MKG_KB
  0223'   CD 0564'              	CALL	DOTGET		; the recording's next key
  0226'   D8                    	RC
  0227'   4F                    	MOV	C,A
  0228'   3A 29FA'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  022B'   3C                    	INR	A
  022C'   32 29FA'              	STA	DOTIX
  022F'   B7                    	ORA	A		; CY clear
  0230'   C9                    	RET
  0231'                         MKG_KB:
  0231'   CD 0000*              	CALL	GETKEY
  0234'   78                    	MOV	A,B
  0235'   FE 02                 	CPI	KT_CHAR
  0237'   37                    	STC
  0238'   C0                    	RNZ			; an action key (ESC) cancels the command
  0239'   B7                    	ORA	A		; CY clear
  023A'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
                                ; the motion returns.  Unlike the marks, the character is then handed to
                                ; DOTPRE, so it joins the recording and '.' can repeat "dfa" -- MKGETK's
                                ; keyboard path does not record for itself.
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
                                ;============================================================
  023B'                         VC_FF:				; 'f' -- forward, onto the character
  023B'   3E 66                 	MVI	A,'f'
  023D'   C3 024C'              	JMP	FNDNEW
  0240'                         VC_FB:				; 'F' -- backward, onto it
  0240'   3E 46                 	MVI	A,'F'
  0242'   C3 024C'              	JMP	FNDNEW
  0245'                         VC_TF:				; 't' -- forward, up to it
  0245'   3E 74                 	MVI	A,'t'
  0247'   C3 024C'              	JMP	FNDNEW
  024A'                         VC_TB:				; 'T' -- backward, up to it
  024A'   3E 54                 	MVI	A,'T'
  024C'                         FNDNEW:
  024C'   32 2A59'              	STA	FNDKND		; the find ';' and ',' will repeat
  024F'   CD 021C'              	CALL	MKGETK		; the character it looks for
  0252'   DA 0289'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0255'   79                    	MOV	A,C
  0256'   32 2A5A'              	STA	FNDCH
  0259'   06 02                 	MVI	B,KT_CHAR	; ... and into the '.' recording (see the head)
  025B'   CD 00DD'              	CALL	DOTPRE
  025E'   3A 2A59'              	LDA	FNDKND
  0261'   06 01                 	MVI	B,1		; a find starts at the next character along
  0263'   C3 0290'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0266'                         VC_SEMI:
  0266'   3A 2A59'              	LDA	FNDKND
  0269'   B7                    	ORA	A
  026A'   CA 0289'              	JZ	FNDNIL		; nothing has been looked for yet
  026D'   C3 0279'              	JMP	FNDREP
  0270'                         VC_COMMA:
  0270'   3A 2A59'              	LDA	FNDKND
  0273'   B7                    	ORA	A
  0274'   CA 0289'              	JZ	FNDNIL
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  0277'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0279'                         FNDREP:
  0279'   06 01                 	MVI	B,1
  027B'   F5                    	PUSH	PSW
  027C'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  027E'   FE 54                 	CPI	'T'
  0280'   C2 0285'              	JNZ	FNDR_GO
  0283'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  0285'                         FNDR_GO:
  0285'   F1                    	POP	PSW
  0286'   C3 0290'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
  0289'                         FNDNIL:
  0289'   AF                    	XRA	A
  028A'   32 2A00'              	STA	PSAVE
  028D'   C3 075A'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  0290'                         FNDGO:
  0290'   32 2A5B'              	STA	FNDRUN
  0293'   78                    	MOV	A,B
  0294'   32 2A5C'              	STA	FNDSTP
  0297'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
  029A'   22 2A5D'              	SHLD	FNDN		; the occurrence wanted
  029D'   CD 0000*              	CALL	CUROFF
  02A0'   22 2A5F'              	SHLD	FNDCUR
  02A3'   3A 2A5B'              	LDA	FNDRUN
  02A6'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  02A8'   CA 02DC'              	JZ	FNDBWD
  02AB'   2A 2A5F'              	LHLD	FNDCUR
  02AE'   CD 0623'              	CALL	EOLC		; HL = the line's last content character
  02B1'   22 2A61'              	SHLD	FNDLIM
  02B4'   2A 2A5F'              	LHLD	FNDCUR
  02B7'   3A 2A5C'              	LDA	FNDSTP
  02BA'   5F                    	MOV	E,A
  02BB'   16 00                 	MVI	D,0
  02BD'   19                    	DAD	D		; HL = where the scan starts
  02BE'                         FNDF_LP:
  02BE'   EB                    	XCHG			; DE = the scan
  02BF'   2A 2A61'              	LHLD	FNDLIM
  02C2'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  02C5'   EB                    	XCHG			; HL = the scan
  02C6'   CA 02CC'              	JZ	FNDF_AT		; the last character is still a candidate
  02C9'   D2 032E'              	JNC	FNDMIS		; past it: not on this line
  02CC'                         FNDF_AT:
  02CC'   CD 0335'              	CALL	FNDSEE		; Z iff this is the character
  02CF'   C2 02D8'              	JNZ	FNDF_NX
  02D2'   CD 0340'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02D5'   CA 0314'              	JZ	FNDHIT
  02D8'                         FNDF_NX:
  02D8'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02D9'   C3 02BE'              	JMP	FNDF_LP
  02DC'                         FNDBWD:
  02DC'   2A 2A5F'              	LHLD	FNDCUR
  02DF'   CD 05E4'              	CALL	BOL		; HL = the line's first character
  02E2'   22 2A61'              	SHLD	FNDLIM
  02E5'   2A 2A5F'              	LHLD	FNDCUR
  02E8'   3A 2A5C'              	LDA	FNDSTP
  02EB'   2F                    	CMA
  02EC'   5F                    	MOV	E,A
  02ED'   16 FF                 	MVI	D,0FFH
  02EF'   13                    	INX	D		; DE = -step
  02F0'   19                    	DAD	D		; HL = where the scan starts
  02F1'   D2 032E'              	JNC	FNDMIS		; ... off the front of the text altogether
  02F4'                         FNDB_LP:
  02F4'   EB                    	XCHG			; DE = the scan
  02F5'   2A 2A61'              	LHLD	FNDLIM
  02F8'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02FB'   EB                    	XCHG			; HL = the scan
  02FC'   DA 032E'              	JC	FNDMIS		; before this line: not on it
  02FF'   CD 0335'              	CALL	FNDSEE
  0302'   C2 030B'              	JNZ	FNDB_NX
  0305'   CD 0340'              	CALL	FNDCNT
  0308'   CA 0314'              	JZ	FNDHIT
  030B'                         FNDB_NX:
  030B'   7C                    	MOV	A,H
  030C'   B5                    	ORA	L
  030D'   CA 032E'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
  0310'   2B                    	DCX	H
  0311'   C3 02F4'              	JMP	FNDB_LP
                                
                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  0314'                         FNDHIT:
  0314'   3A 2A5B'              	LDA	FNDRUN
  0317'   E6 5F                 	ANI	5FH
  0319'   FE 54                 	CPI	'T'
  031B'   C2 032B'              	JNZ	FNDLND
  031E'   3A 2A5B'              	LDA	FNDRUN
  0321'   E6 20                 	ANI	20H
  0323'   CA 032A'              	JZ	FNDH_BW
  0326'   2B                    	DCX	H		; forward 't': the character before it
  0327'   C3 032B'              	JMP	FNDLND
  032A'                         FNDH_BW:
  032A'   23                    	INX	H		; backward 'T': the character after it
  032B'                         FNDLND:
  032B'   C3 057A'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  032E'                         FNDMIS:
  032E'   AF                    	XRA	A
  032F'   32 2A00'              	STA	PSAVE
  0332'   C3 01FF'              	JMP	DOTBEL
                                
                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  0335'                         FNDSEE:
  0335'   E5                    	PUSH	H
  0336'   CD 0000*              	CALL	CHARAT
  0339'   E1                    	POP	H
  033A'   47                    	MOV	B,A
  033B'   3A 2A5A'              	LDA	FNDCH
  033E'   B8                    	CMP	B
  033F'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
                                ; the scan and stays it.
  0340'                         FNDCNT:
  0340'   E5                    	PUSH	H
  0341'   2A 2A5D'              	LHLD	FNDN
  0344'   2B                    	DCX	H
  0345'   22 2A5D'              	SHLD	FNDN
  0348'   7C                    	MOV	A,H
  0349'   B5                    	ORA	L
  034A'   E1                    	POP	H
  034B'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  034C'                         ISFIND:
  034C'   E6 5F                 	ANI	5FH		; fold the case away
  034E'   FE 46                 	CPI	'F'
  0350'   C8                    	RZ
  0351'   FE 54                 	CPI	'T'
  0353'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  0354'                         VC_MK:
  0354'   3E 04                 	MVI	A,PM
  0356'   C3 0360'              	JMP	MKGO
  0359'                         VC_BQ:
  0359'   3E 05                 	MVI	A,PJ
  035B'   C3 0360'              	JMP	MKGO
  035E'                         VC_AQ:
  035E'   3E 06                 	MVI	A,PJL
  0360'                         MKGO:
  0360'   32 2A70'              	STA	MKWHAT
  0363'   CD 0678'              	CALL	MOVCNT		; a count means nothing on any of the three
  0366'   CD 021C'              	CALL	MKGETK		; the key that names the mark
  0369'   DA 0448'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out -- the letter is read here and so
                                				;   was never recorded, which is why a '.'
                                				;   after "d'a" refuses (COMMANDS.md).  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist: 'm' with any other key
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


                                ;drops the whole thing, as vim's 'Z{other}' does, and a jump to one is a jump
                                ;to a mark that is not set.
  036C'                         MKOP:
  036C'   79                    	MOV	A,C
  036D'   D6 61                 	SUI	'a'
  036F'   FE 03                 	CPI	MKMAX
  0371'   D2 0440'              	JNC	MKNOLT		; not a mark letter
  0374'   4F                    	MOV	C,A		; C = the mark's index
  0375'   87                    	ADD	A
  0376'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  0377'   5F                    	MOV	E,A
  0378'   16 00                 	MVI	D,0
  037A'   21 0000*              	LXI	H,MKTAB
  037D'   19                    	DAD	D		; HL -> this mark's slot
  037E'   3A 2A70'              	LDA	MKWHAT
  0381'   FE 04                 	CPI	PM
  0383'   CA 045B'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark, paging to it if the window has left it.
                                ;'Mark not set', as vim says it, when it was never set.
                                ;Under an OPERATOR a mark the window does not hold is refused with the bell
                                ;and stays set, all but "d'a": a line delete is the one operator that can take
                                ;a span the window does not hold whole (OPPGD), and going there only to be
                                ;turned away by it would page the file twice for nothing.
  0386'                         MKJMP:
  0386'   E5                    	PUSH	H
  0387'   CD 0207'              	CALL	MKVAD
  038A'   7E                    	MOV	A,M
  038B'   E1                    	POP	H
  038C'   B7                    	ORA	A
  038D'   CA 0436'              	JZ	MKNSET		; never set
  0390'   CD 0402'              	CALL	MKLOAD		; the file position it holds
  0393'   CD 040F'              	CALL	MKWIN
  0396'   DA 03AD'              	JC	MKJ_GO		; in the window: any command may go there
  0399'   3A 2A00'              	LDA	PSAVE
  039C'   B7                    	ORA	A
  039D'   CA 03AD'              	JZ	MKJ_GO
  03A0'   FE 64                 	CPI	'd'		; paged out, and an operator wants the span
  03A2'   C2 0448'              	JNZ	MKBAD
  03A5'   3A 2A70'              	LDA	MKWHAT
  03A8'   FE 06                 	CPI	PJL
  03AA'   C2 0448'              	JNZ	MKBAD
  03AD'                         MKJ_GO:
  03AD'   CD 0F42'              	CALL	GZONE		; the screen's top line, before the cursor
                                				;   moves: GPLACE measures the landing against
                                				;   it, and one left over from an earlier 'G'
                                				;   had it keep a window the line is not in
  03B0'   CD 06B4'              	CALL	BRKON		; ... and a ^C may stop it from here on
  03B3'   CD 03CF'              	CALL	MKPAGE		; HL = the mark's offset in the window
  03B6'   CD 06EB'              	CALL	BRKOFF		; (A only)
  03B9'   DA 0703'              	JC	BRKBAK
  03BC'   3A 2A70'              	LDA	MKWHAT
  03BF'   FE 06                 	CPI	PJL
  03C1'   CA 03C9'              	JZ	MKJ_LN		; ''': GPKEEP is 0, so GPLACE finds the first
  03C4'   3E 01                 	MVI	A,1		;   non-blank
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  03C6'   32 2A63'              	STA	GPKEEP		; '`': land on the column it was set at
  03C9'                         MKJ_LN:
  03C9'   CD 0000*              	CALL	GOTO
  03CC'   C3 0F5A'              	JMP	GPLACE		; (which sets LNDLT itself)
                                
                                ;MKPAGE -- page until MKPOS is in the window: HL = its logical offset there.
                                ;The loop is WM's own whole-file line move (MVLMAX: GOLINE to the window's
                                ;edge, SCRLST to page one step), stopped by where the window is instead of by
                                ;the count.  A step cannot carry the window past the mark: the pager evicts
                                ;only behind the cursor, and the cursor is on the edge nearer the mark.
  03CF'                         MKPAGE:
  03CF'   CD 040F'              	CALL	MKWIN
  03D2'   DA 0000*              	JC	CLRCNT		; there: and the count that paged is spent,
                                				;   not left for the next command to take
  03D5'   32 0000*              	STA	DIRFLG
  03D8'   21 FFFF               	LXI	H,0FFFFH
  03DB'   22 29D6'              	SHLD	CMDCNT
  03DE'   CD 0000*              	CALL	GOLINE
  03E1'   CD 0000*              	CALL	SCRLST
  03E4'   CD 06A0'              	CALL	CNTTST
  03E7'   C2 03CF'              	JNZ	MKPAGE
  03EA'   CD 040F'              	CALL	MKWIN		; the file ran out: that was its last step
  03ED'   DA 0000*              	JC	CLRCNT
  03F0'   21 FFFF               	LXI	H,0FFFFH	; the very end of the text, which MKWIN does not
  03F3'   C3 0000*              	JMP	CLRCNT		;   count as in the window: GOTO clamps it
                                
                                ;BACKTO -- back to the 3-byte file position at HL, paging to it: where a
                                ;command that came to nothing started.  The place has to be kept as a file
                                ;position -- a sweep of the whole file leaves the window at the far end of
                                ;it, and an offset into the window it started in means nothing there.
  03F6'                         BACKTO:
  03F6'   CD 0402'              	CALL	MKLOAD
  03F9'   CD 0000*              	CALL	CLRCNT
  03FC'   CD 03CF'              	CALL	MKPAGE
  03FF'   C3 0000*              	JMP	GOTO
                                
                                ;MKLOAD -- MKPOS = the 3-byte file position at HL.
  0402'                         MKLOAD:
  0402'   5E                    	MOV	E,M
  0403'   23                    	INX	H
  0404'   56                    	MOV	D,M
  0405'   23                    	INX	H
  0406'   7E                    	MOV	A,M
  0407'   EB                    	XCHG
  0408'   22 2A6D'              	SHLD	MKPOS
  040B'   32 2A6F'              	STA	MKPOS+2
  040E'   C9                    	RET
                                
                                ;MKWIN -- CY and HL = MKPOS as a logical offset if the window holds it; NC and
                                ;A = the way to page for it, as DIRFLG has it (0 forward, FFH back), if not.
  040F'                         MKWIN:
  040F'   2A 0000*              	LHLD	TXTBEG
  0412'   CD 0EFC'              	CALL	FPOS
  0415'   EB                    	XCHG
  0416'   47                    	MOV	B,A		; B:DE = the window's first byte
  0417'   2A 2A6D'              	LHLD	MKPOS
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  041A'   3A 2A6F'              	LDA	MKPOS+2
  041D'   CD 0EEF'              	CALL	SUB24		; A:HL = the mark, from the window's top
  0420'   DA 0432'              	JC	MKW_BK		; above it
  0423'   C2 0430'              	JNZ	MKW_FW		; 64K or more below it
  0426'   E5                    	PUSH	H
  0427'   CD 0000*              	CALL	LOGLEN
  042A'   D1                    	POP	D
  042B'   CD 0000*              	CALL	CMP16		; DE = the offset vs HL = the window's length
  042E'   EB                    	XCHG
  042F'   D8                    	RC			; inside
  0430'                         MKW_FW:
  0430'   AF                    	XRA	A
  0431'   C9                    	RET
  0432'                         MKW_BK:
  0432'   3E FF                 	MVI	A,0FFH
  0434'   B7                    	ORA	A
  0435'   C9                    	RET
                                
                                ;MKNSET -- a jump to a mark that will not answer: vim's E20 on the bottom row
                                ;(without the number, and without a bell, as every message here), the cursor
                                ;and the screen left alone.  The operator is cancelled as MKBAD cancels it.
  0436'                         MKNSET:
  0436'   AF                    	XRA	A
  0437'   32 2A00'              	STA	PSAVE
  043A'   21 2394'              	LXI	H,SMKNS
  043D'   C3 2289'              	JMP	EXERR
  0440'                         MKNOLT:
  0440'   3A 2A70'              	LDA	MKWHAT
  0443'   FE 04                 	CPI	PM
  0445'   C2 0436'              	JNZ	MKNSET		; a jump: that mark is not set
                                				; 'm{other}': fall into MKBAD
                                
                                ;MKBAD -- no mark was named: 'm' with a key that is not a mark letter, ESC in
                                ;place of the letter, or a '.' replay that ran out.  The bell, and an operator
                                ;running the motion is cancelled whole: PSAVE is what OPPEND's tail reads to
                                ;decide whether to open an insert, so clearing it stops a "c`z" opening one
                                ;over a span of nothing.
  0448'                         MKBAD:
  0448'   AF                    	XRA	A
  0449'   32 2A00'              	STA	PSAVE
  044C'   C3 01FF'              	JMP	DOTBEL
                                
                                ;FPSTO -- the cursor's file position into the 3 bytes at HL.  Keeps BC.
  044F'                         FPSTO:
  044F'   E5                    	PUSH	H
  0450'   CD 0EF9'              	CALL	CURFP		; A:HL = the cursor's file position
  0453'   EB                    	XCHG
  0454'   E1                    	POP	H
  0455'   73                    	MOV	M,E
  0456'   23                    	INX	H
  0457'   72                    	MOV	M,D
  0458'   23                    	INX	H
  0459'   77                    	MOV	M,A
  045A'   C9                    	RET
                                
                                ;MKSET -- remember where in the FILE the cursor is.
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  045B'                         MKSET:
  045B'   CD 044F'              	CALL	FPSTO
  045E'   CD 0207'              	CALL	MKVAD
  0461'   36 01                 	MVI	M,1		; ... and the mark is live
  0463'   C3 075A'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKSHFT -- the text is changing: every mark follows its own text.  BUF.MAC's
                                ;UNDCHG calls this through EDTHK from all six edit primitives -- 'u's replay
                                ;of them included -- with A = 1 for an insert (the text is in) or 2 for a
                                ;delete (it is about to go), HL = the edit's logical offset and BC = its
                                ;length.  A mark before the edit stays; one after it moves by the length; one
                                ;INSIDE a delete closes up to where the delete was.  An insert AT a mark
                                ;leaves the mark in front of the new text, unless that text ends a line -- a
                                ;line opened or put above the mark's is above the mark too.
                                ;The edit is found from the CURSOR's file position less its distance behind
                                ;the cursor, never from the offset alone: a put bigger than the window pages
                                ;its own start out, and that offset has then wrapped.  BC is kept.
  0466'                         MKSHFT:
  0466'   32 2A6C'              	STA	MKTYP
  0469'   3A 2A71'              	LDA	MKHOLD		; a yank that could not copy takes its lines out
  046C'   B7                    	ORA	A		;   and puts them back unchanged (YKGO): the text
  046D'   C0                    	RNZ			;   every mark points into is still there
  046E'   C5                    	PUSH	B
  046F'   50                    	MOV	D,B
  0470'   59                    	MOV	E,C
  0471'   EB                    	XCHG
  0472'   22 2A6A'              	SHLD	MKN		; the edit's length
  0475'   D5                    	PUSH	D		; ... and its offset
  0476'   CD 0000*              	CALL	CUROFF
  0479'   D1                    	POP	D
  047A'   CD 0000*              	CALL	SUBHD
  047D'   EB                    	XCHG			; DE = how far behind the cursor it is
  047E'   CD 0EF9'              	CALL	CURFP		; A:HL = the cursor's file position
  0481'   06 00                 	MVI	B,0
  0483'   CD 0EEF'              	CALL	SUB24
  0486'   22 2A67'              	SHLD	MKEDIT
  0489'   32 2A69'              	STA	MKEDIT+2	; where in the file the edit is
  048C'   21 2A64'              	LXI	H,MKVAL
  048F'   11 0000*              	LXI	D,MKTAB
  0492'   06 03                 	MVI	B,MKMAX
  0494'                         MKS_LP:
  0494'   7E                    	MOV	A,M
  0495'   B7                    	ORA	A
  0496'   CA 0502'              	JZ	MKS_N0		; that mark is not set
  0499'   E5                    	PUSH	H
  049A'   C5                    	PUSH	B
  049B'   21 2A67'              	LXI	H,MKEDIT
  049E'   1A                    	LDAX	D		; the mark's position less the edit's, a byte
  049F'   96                    	SUB	M		;   at a time (neither INX nor LDAX touch CY)
  04A0'   4F                    	MOV	C,A
  04A1'   13                    	INX	D
  04A2'   23                    	INX	H
  04A3'   1A                    	LDAX	D
  04A4'   9E                    	SBB	M
  04A5'   47                    	MOV	B,A
  04A6'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  04A7'   23                    	INX	H
  04A8'   1A                    	LDAX	D
  04A9'   9E                    	SBB	M		; A:BC = how far past the edit the mark is
  04AA'   DA 04FD'              	JC	MKS_PP		; before it: nothing moves
  04AD'   6F                    	MOV	L,A
  04AE'   3A 2A6C'              	LDA	MKTYP
  04B1'   3D                    	DCR	A
  04B2'   CA 04D7'              	JZ	MKS_IN
                                	;--- a delete: back by its length, or to it if the mark is inside ---
  04B5'   7D                    	MOV	A,L
  04B6'   2A 2A6A'              	LHLD	MKN
  04B9'   B7                    	ORA	A
  04BA'   C2 04C6'              	JNZ	MKS_DL		; 64K or more past it
  04BD'   79                    	MOV	A,C
  04BE'   95                    	SUB	L
  04BF'   78                    	MOV	A,B
  04C0'   9C                    	SBB	H
  04C1'   D2 04C6'              	JNC	MKS_DL		; past the end of what goes
  04C4'   60                    	MOV	H,B
  04C5'   69                    	MOV	L,C		; inside it: close up to the edit
  04C6'                         MKS_DL:
  04C6'   1B                    	DCX	D
  04C7'   1B                    	DCX	D
  04C8'   1A                    	LDAX	D
  04C9'   95                    	SUB	L
  04CA'   12                    	STAX	D
  04CB'   13                    	INX	D
  04CC'   1A                    	LDAX	D
  04CD'   9C                    	SBB	H
  04CE'   12                    	STAX	D
  04CF'   13                    	INX	D
  04D0'   1A                    	LDAX	D
  04D1'   DE 00                 	SBI	0
  04D3'   12                    	STAX	D
  04D4'   C3 04FD'              	JMP	MKS_PP
                                	;--- an insert: on by its length ---
  04D7'                         MKS_IN:
  04D7'   7D                    	MOV	A,L
  04D8'   B0                    	ORA	B
  04D9'   B1                    	ORA	C
  04DA'   C2 04EC'              	JNZ	MKS_AD		; the mark is past it
  04DD'   2A 0000*              	LHLD	GAPBEG		; AT the mark: only a line end carries it on
  04E0'   2B                    	DCX	H
  04E1'   7E                    	MOV	A,M		; the last byte that went in
  04E2'   FE 0A                 	CPI	LF
  04E4'   CA 04EC'              	JZ	MKS_AD
  04E7'   FE 0D                 	CPI	CR
  04E9'   C2 04FD'              	JNZ	MKS_PP
  04EC'                         MKS_AD:
  04EC'   2A 2A6A'              	LHLD	MKN
  04EF'   1B                    	DCX	D
  04F0'   1B                    	DCX	D
  04F1'   1A                    	LDAX	D
  04F2'   85                    	ADD	L
  04F3'   12                    	STAX	D
  04F4'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04F5'   1A                    	LDAX	D
  04F6'   8C                    	ADC	H
  04F7'   12                    	STAX	D
  04F8'   13                    	INX	D
  04F9'   1A                    	LDAX	D
  04FA'   CE 00                 	ACI	0
  04FC'   12                    	STAX	D
  04FD'                         MKS_PP:
  04FD'   C1                    	POP	B
  04FE'   E1                    	POP	H
  04FF'   C3 0504'              	JMP	MKS_NX
  0502'                         MKS_N0:
  0502'   13                    	INX	D
  0503'   13                    	INX	D
  0504'                         MKS_NX:
  0504'   13                    	INX	D
  0505'   13                    	INX	D
  0506'   23                    	INX	H
  0507'   05                    	DCR	B
  0508'   C2 0494'              	JNZ	MKS_LP
  050B'   C1                    	POP	B
  050C'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  050D'                         VC_UNDO:
  050D'   21 0000               	LXI	H,0
  0510'   22 29D6'              	SHLD	CMDCNT
  0513'   CD 0000*              	CALL	UNDO
  0516'   DA 0547'              	JC	UNDNO
  0519'   2A 0000*              	LHLD	UNDCUR
  051C'   CD 052D'              	CALL	UCLAMP		; vi never sits on a line terminator
  051F'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0522'   3E 01                 	MVI	A,1
  0524'   32 29D9'              	STA	MODF		; undone past a ':w' still differs from the file
  0527'   CD 08E6'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  052A'   C3 077B'              	JMP	SETFUL		; whole spans moved: repaint rather than guess
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  052D'                         UCLAMP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  052D'   E5                    	PUSH	H
  052E'   CD 14BE'              	CALL	CEND		; HL = the line's content end
  0531'   D1                    	POP	D		; DE = the offset wanted
  0532'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  0535'   D2 053A'              	JNC	UCL_BK
  0538'   EB                    	XCHG
  0539'   C9                    	RET
  053A'                         UCL_BK:
  053A'   E5                    	PUSH	H		; the content end
  053B'   EB                    	XCHG			; HL = the offset wanted
  053C'   CD 05E4'              	CALL	BOL
  053F'   D1                    	POP	D		; DE = the content end, HL = the line's start
  0540'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  0543'   EB                    	XCHG			; HL = the content end
  0544'   C8                    	RZ
  0545'   2B                    	DCX	H		; ... its last character
  0546'   C9                    	RET
  0547'                         UNDNO:
  0547'   3A 0000*              	LDA	UNDWHY
  054A'   B7                    	ORA	A
  054B'   CA 055C'              	JZ	UNDBEL
  054E'   21 234E'              	LXI	H,SUNDW		; the change has paged away: say so
  0551'   FE 01                 	CPI	1
  0553'   CA 2289'              	JZ	EXERR
  0556'   21 2370'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  0559'   C3 2289'              	JMP	EXERR
  055C'                         UNDBEL:
  055C'   0E 07                 	MVI	C,BEL
  055E'   CD 0000*              	CALL	BCONOU
  0561'   C3 075A'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  0564'                         DOTGET:
  0564'   3A 29FA'              	LDA	DOTIX
  0567'   5F                    	MOV	E,A
  0568'   3A 29F9'              	LDA	DOTLEN
  056B'   BB                    	CMP	E
  056C'   CA 0578'              	JZ	DOTGEF
  056F'   16 00                 	MVI	D,0
  0571'   21 0000*              	LXI	H,DOTBUF
  0574'   19                    	DAD	D
  0575'   7E                    	MOV	A,M
  0576'   B7                    	ORA	A		; CY clear: a key was returned
  0577'   C9                    	RET
  0578'                         DOTGEF:
  0578'   37                    	STC
  0579'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  057A'                         GOSET:
  057A'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  057D'                         SETGL:
  057D'   CD 0F1C'              	CALL	ZSAVE
  0580'   21 0000               	LXI	H,0
  0583'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  0586'   E5                    	PUSH	H
  0587'   CD 0F2F'              	CALL	ZREST
  058A'   E1                    	POP	H
  058B'   E5                    	PUSH	H
  058C'   CD 0684'              	CALL	GBSUB		; HL = bytes to the cursor
  058F'   44                    	MOV	B,H
  0590'   4D                    	MOV	C,L
  0591'   E1                    	POP	H		; HL = the line's start
  0592'   11 0000               	LXI	D,0		; DE = screen column
  0595'                         SG_LP:
  0595'   78                    	MOV	A,B
  0596'   B1                    	ORA	C
  0597'   CA 05AC'              	JZ	SG_CUR
  059A'   7E                    	MOV	A,M
  059B'   23                    	INX	H
  059C'   0B                    	DCX	B
  059D'   E5                    	PUSH	H
  059E'   6B                    	MOV	L,E
  059F'   CD 05D1'              	CALL	CWID
  05A2'   E1                    	POP	H
  05A3'   83                    	ADD	E
  05A4'   5F                    	MOV	E,A
  05A5'   D2 0595'              	JNC	SG_LP
  05A8'   14                    	INR	D
  05A9'   C3 0595'              	JMP	SG_LP
  05AC'                         SG_CUR:
  05AC'   2A 0000*              	LHLD	TXTEND
  05AF'   D5                    	PUSH	D
  05B0'   EB                    	XCHG
  05B1'   2A 0000*              	LHLD	GAPEND
  05B4'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  05B7'   D1                    	POP	D
  05B8'   CA 05CC'              	JZ	SG_SET
  05BB'   7E                    	MOV	A,M
  05BC'   FE 09                 	CPI	TAB
  05BE'   C2 05CC'              	JNZ	SG_SET
  05C1'   6B                    	MOV	L,E
  05C2'   CD 05D1'              	CALL	CWID
  05C5'   3D                    	DCR	A		; the TAB's last column
  05C6'   83                    	ADD	E
  05C7'   5F                    	MOV	E,A
  05C8'   D2 05CC'              	JNC	SG_SET
  05CB'   14                    	INR	D
  05CC'                         SG_SET:
  05CC'   EB                    	XCHG
  05CD'   22 29DE'              	SHLD	GOALCOL
  05D0'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  05D1'                         CWID:
  05D1'   FE 0D                 	CPI	CR
  05D3'   CA 05E2'              	JZ	CW_0
  05D6'   FE 09                 	CPI	TAB
  05D8'   3E 01                 	MVI	A,1
  05DA'   C0                    	RNZ
  05DB'   7D                    	MOV	A,L
  05DC'   E6 07                 	ANI	TABWID-1
  05DE'   2F                    	CMA
  05DF'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  05E1'   C9                    	RET
  05E2'                         CW_0:
  05E2'   AF                    	XRA	A
  05E3'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
  05E4'                         BOL:
  05E4'                         BOL_LP:
  05E4'   7C                    	MOV	A,H
  05E5'   B5                    	ORA	L
  05E6'   C8                    	RZ			; at 0
  05E7'   2B                    	DCX	H		; look at off-1
  05E8'   E5                    	PUSH	H
  05E9'   CD 0000*              	CALL	CHARAT
  05EC'   E1                    	POP	H		; HL = off-1
  05ED'   FE 0A                 	CPI	LF
  05EF'   CA 05F5'              	JZ	BOL_DN
  05F2'   C3 05E4'              	JMP	BOL_LP
  05F5'                         BOL_DN:
  05F5'   23                    	INX	H		; line starts just after the LF
  05F6'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
  05F7'                         EOLNL:
  05F7'   E5                    	PUSH	H
  05F8'   CD 0000*              	CALL	LOGLEN
  05FB'   22 2A1E'              	SHLD	WKN
  05FE'   E1                    	POP	H
  05FF'                         ENL_LP:
  05FF'   EB                    	XCHG			; DE = i
  0600'   2A 2A1E'              	LHLD	WKN
  0603'   CD 0000*              	CALL	CMP16		; DE=i vs HL=n: CY iff i < n
  0606'   EB                    	XCHG			; HL = i, DE = n
  0607'   D0                    	RNC			; i >= n: no LF on this line
  0608'   E5                    	PUSH	H
  0609'   CD 0000*              	CALL	CHARAT
  060C'   E1                    	POP	H
  060D'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  060F'   C8                    	RZ			; the LF: HL is its offset
  0610'   23                    	INX	H
  0611'   C3 05FF'              	JMP	ENL_LP
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  0614'                         NLSTART:
  0614'   CD 05F7'              	CALL	EOLNL
  0617'   E5                    	PUSH	H
  0618'   CD 0000*              	CALL	LOGLEN
  061B'   D1                    	POP	D		; DE = eol result
  061C'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  061F'   C8                    	RZ			; no next line: HL = LOGLEN
  0620'   EB                    	XCHG			; HL = eol
  0621'   23                    	INX	H
  0622'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  0623'                         EOLC:
  0623'   E5                    	PUSH	H
  0624'   CD 05F7'              	CALL	EOLNL
  0627'   22 2A20'              	SHLD	WKTERM
  062A'   E1                    	POP	H
  062B'   CD 05E4'              	CALL	BOL
  062E'   22 2A22'              	SHLD	WKBOL
  0631'   2A 2A20'              	LHLD	WKTERM
  0634'   EB                    	XCHG			; DE = term
  0635'   2A 2A22'              	LHLD	WKBOL
  0638'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  063B'   CA 065A'              	JZ	EOLC_MT
  063E'   EB                    	XCHG			; HL = term
  063F'   2B                    	DCX	H		; term-1
  0640'   E5                    	PUSH	H
  0641'   CD 0000*              	CALL	CHARAT
  0644'   E1                    	POP	H		; HL = term-1
  0645'   FE 0D                 	CPI	CR
  0647'   CA 064D'              	JZ	EOLC_CR		; content ends at term-1
  064A'   C3 064E'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  064D'                         EOLC_CR:
  064D'   2B                    	DCX	H		; last = (term-1) - 1
  064E'                         EOLC_LS:
  064E'   EB                    	XCHG			; DE = last
  064F'   2A 2A22'              	LHLD	WKBOL
  0652'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  0655'   DA 065A'              	JC	EOLC_MT
  0658'   EB                    	XCHG			; HL = last
  0659'   C9                    	RET
  065A'                         EOLC_MT:
  065A'   2A 2A22'              	LHLD	WKBOL
  065D'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  065E'                         COL:
  065E'   E5                    	PUSH	H
  065F'   CD 05E4'              	CALL	BOL
  0662'   D1                    	POP	D		; DE = off
  0663'   EB                    	XCHG			; HL = off, DE = bol
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  0664'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  0667'                         ATENDQ:
  0667'   CD 0000*              	CALL	CUROFF
  066A'   E5                    	PUSH	H
  066B'   CD 0000*              	CALL	LOGLEN
  066E'   D1                    	POP	D		; DE = cur
  066F'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0672'                         CURCHR:
  0672'   CD 0000*              	CALL	CUROFF
  0675'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  0678'                         MOVCNT:
  0678'   CD 075A'              	CALL	SETMOV
  067B'   C3 068B'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  067E'                         CNTOFF:
  067E'   CD 068B'              	CALL	GETCNT
  0681'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  0684'                         GBSUB:
  0684'   EB                    	XCHG
  0685'   2A 0000*              	LHLD	GAPBEG
  0688'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  068B'                         GETCNT:
  068B'   2A 29D6'              	LHLD	CMDCNT
  068E'   7C                    	MOV	A,H
  068F'   B5                    	ORA	L
  0690'   C2 0697'              	JNZ	GC_HAVE
  0693'   21 0001               	LXI	H,1
  0696'   C9                    	RET
  0697'                         GC_HAVE:
  0697'   E5                    	PUSH	H
  0698'   21 0000               	LXI	H,0
  069B'   22 29D6'              	SHLD	CMDCNT
  069E'   E1                    	POP	H
  069F'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for a ^C break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  06A0'                         CNTTST:				; WM 1175
  06A0'   3A 2A88'              	LDA	BRKARM
  06A3'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06A4'   C4 06CE'              	CNZ	BRKTST		; a ^C spends the count: every loop stops here
  06A7'   E5                    	PUSH	H
  06A8'   2A 29D6'              	LHLD	CMDCNT
  06AB'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  06AE'   B4                    	ORA	H
  06AF'   B5                    	ORA	L
  06B0'   E1                    	POP	H
  06B1'   C3 0000*              	JMP	POLLBRK
                                
                                ;============================================================
                                ; ^C -- abandon a search or a long move.
                                ;
                                ; Every loop that pages asks CNTTST whether to go on, so that is where a ^C is
                                ; looked for: it zeroes the count, and the loop ends the way it ends when the
                                ; count runs out.  Nothing is half done, because the commands that can be
                                ; stopped change nothing -- BRKON arms the test only with no operator pending,
                                ; and only 'G' 'gg' the mark jumps and the searches call it.  A 'dd' count, a
                                ; ':s', a put or a write asks the same CNTTST and is never stopped.
                                ;
                                ; The command then goes back to where it started (BRKBAK), as a search that
                                ; found nothing does: the screen was not repainted, so it is already right.
                                ; Going back pages, and that is not stopped by a second ^C.
                                ;============================================================
                                
                                ;BRKON -- a command that may page a long way is starting: keep the place it
                                ; started from (the cursor's position in the file, and LNDLT for its row), and
                                ; arm the ^C test unless an operator is waiting for this motion.
  06B4'                         BRKON:
  06B4'   21 2A83'              	LXI	H,SOFF
  06B7'   CD 044F'              	CALL	FPSTO
  06BA'   2A 0000*              	LHLD	LNDLT
  06BD'   22 2A86'              	SHLD	SLDLT
  06C0'   AF                    	XRA	A
  06C1'   32 2A89'              	STA	BRKHIT
  06C4'   3A 2A00'              	LDA	PSAVE
  06C7'   B7                    	ORA	A
  06C8'   C0                    	RNZ			; 'dG' changes text: it runs to its end
  06C9'   3C                    	INR	A
  06CA'   32 2A88'              	STA	BRKARM
  06CD'   C9                    	RET
                                
                                ;BRKTST -- CNTTST's question while armed.  Keeps BC, DE, HL.
  06CE'                         BRKTST:
  06CE'   C5                    	PUSH	B
  06CF'   D5                    	PUSH	D
  06D0'   E5                    	PUSH	H
  06D1'   CD 0000*              	CALL	KBBRK
  06D4'   CA 06E7'              	JZ	BT_NO
  06D7'   32 2A89'              	STA	BRKHIT		; (A = FFH)
  06DA'   AF                    	XRA	A
  06DB'   32 2A88'              	STA	BRKARM		; the way back is not stopped in its turn
  06DE'   32 0000*              	STA	AUXCNT
  06E1'   21 0000               	LXI	H,0
  06E4'   22 29D6'              	SHLD	CMDCNT
  06E7'                         BT_NO:
  06E7'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  06E8'   D1                    	POP	D
  06E9'   C1                    	POP	B
  06EA'   C9                    	RET
                                
                                ;BRKOFF -- the move is over: disarm.  NOTE: falls into BRKQ.
  06EB'                         BRKOFF:
  06EB'   AF                    	XRA	A
  06EC'   32 2A88'              	STA	BRKARM
                                ;BRKQ -- CY iff a ^C stopped it.
  06EF'                         BRKQ:
  06EF'   3A 2A89'              	LDA	BRKHIT
  06F2'   B7                    	ORA	A
  06F3'   C8                    	RZ
  06F4'   37                    	STC
  06F5'   C9                    	RET
                                
                                ;RSTPL -- back to the place BRKON kept, on the row it was on.
  06F6'                         RSTPL:
  06F6'   21 2A83'              	LXI	H,SOFF
  06F9'   CD 03F6'              	CALL	BACKTO
  06FC'   2A 2A86'              	LHLD	SLDLT
  06FF'   22 0000*              	SHLD	LNDLT
  0702'   C9                    	RET
                                
                                ;BRKBAK -- stopped: back to the start, drop whatever was typed meanwhile (it
                                ; was meant for a result that is not coming), and say so.  CY, as EXERR.
  0703'                         BRKBAK:
  0703'   CD 06F6'              	CALL	RSTPL
  0706'   CD 0000*              	CALL	KBFLSH
  0709'   21 2327'              	LXI	H,SINTR
  070C'   C3 2289'              	JMP	EXERR
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  070F'                         CLASSF:
  070F'   47                    	MOV	B,A
  0710'   FE 20                 	CPI	' '
  0712'   CA 0752'              	JZ	CLS0
  0715'   FE 09                 	CPI	TAB
  0717'   CA 0752'              	JZ	CLS0
  071A'   FE 0A                 	CPI	LF
  071C'   CA 0752'              	JZ	CLS0
  071F'   FE 0D                 	CPI	CR
  0721'   CA 0752'              	JZ	CLS0
  0724'   3A 29E0'              	LDA	WBIG
  0727'   B7                    	ORA	A
  0728'   C2 0754'              	JNZ	CLS1
  072B'   78                    	MOV	A,B
  072C'   FE 5F                 	CPI	'_'
  072E'   CA 0754'              	JZ	CLS1
  0731'   FE 30                 	CPI	'0'
  0733'   DA 0757'              	JC	CLS2
  0736'   FE 3A                 	CPI	'9'+1
  0738'   DA 0754'              	JC	CLS1
  073B'   FE 41                 	CPI	'A'
  073D'   DA 0757'              	JC	CLS2
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0740'   FE 5B                 	CPI	'Z'+1
  0742'   DA 0754'              	JC	CLS1
  0745'   FE 61                 	CPI	'a'
  0747'   DA 0757'              	JC	CLS2
  074A'   FE 7B                 	CPI	'z'+1
  074C'   DA 0754'              	JC	CLS1
  074F'   C3 0757'              	JMP	CLS2
  0752'   AF                    CLS0:	XRA	A
  0753'   C9                    	RET
  0754'   3E 01                 CLS1:	MVI	A,1
  0756'   C9                    	RET
  0757'   3E 02                 CLS2:	MVI	A,2
  0759'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  075A'                         SETMOV:
  075A'   3E 01                 	MVI	A,R_MOVE
  075C'   32 29DA'              	STA	RINTENT
  075F'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  0760'                         SETLIN:
  0760'   3E 02                 	MVI	A,R_LINE
  0762'   32 29DA'              	STA	RINTENT
  0765'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  0766'                         SETILN:
  0766'   3E 01                 	MVI	A,1
  0768'   32 29DB'              	STA	ILN		; one line, unless a put overwrites it below
  076B'   3E 05                 	MVI	A,R_ILIN
  076D'   32 29DA'              	STA	RINTENT
  0770'   AF                    	XRA	A
  0771'   32 29DD'              	STA	ILABOV		; the row above the opened ones is untouched
  0774'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  0775'                         SETJON:
  0775'   3E 06                 	MVI	A,R_JOIN
  0777'   32 29DA'              	STA	RINTENT
  077A'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  077B'                         SETFUL:
  077B'   3E 00                 	MVI	A,R_FULL
  077D'   32 29DA'              	STA	RINTENT
  0780'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB occurs from the cursor to the end of its line, else 0.
                                ; Scans forward from the cursor via CHARAT until LF or end of text (no gap move).
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  0781'                         TAILTAB:
  0781'   CD 0000*              	CALL	CUROFF
  0784'   22 2A1A'              	SHLD	TTI
  0787'                         TT_LP:
  0787'   2A 2A1A'              	LHLD	TTI
  078A'   EB                    	XCHG			; DE = TTI
  078B'   CD 0000*              	CALL	LOGLEN		; HL = LOGLEN
  078E'   CD 0000*              	CALL	CMP16		; CY iff TTI < LOGLEN
  0791'   D2 07B1'              	JNC	TT_NO		; reached end of text -> no tab
  0794'   2A 2A1A'              	LHLD	TTI
  0797'   CD 0000*              	CALL	CHARAT
  079A'   FE 0A                 	CPI	LF
  079C'   CA 07B1'              	JZ	TT_NO		; end of line -> no tab
  079F'   FE 09                 	CPI	TAB
  07A1'   CA 07AE'              	JZ	TT_YES
  07A4'   2A 2A1A'              	LHLD	TTI
  07A7'   23                    	INX	H
  07A8'   22 2A1A'              	SHLD	TTI
  07AB'   C3 0787'              	JMP	TT_LP
  07AE'                         TT_YES:
  07AE'   3E 01                 	MVI	A,1
  07B0'   C9                    	RET
  07B1'                         TT_NO:
  07B1'   AF                    	XRA	A
  07B2'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  07B3'                         VC_H:
  07B3'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  07B6'   22 2A18'              	SHLD	CNTV
  07B9'                         VCH_LP:
  07B9'   2A 2A18'              	LHLD	CNTV
  07BC'   7C                    	MOV	A,H
  07BD'   B5                    	ORA	L
  07BE'   C8                    	RZ
  07BF'   2B                    	DCX	H
  07C0'   22 2A18'              	SHLD	CNTV
  07C3'   CD 07C9'              	CALL	HSTEP
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07C6'   C3 07B9'              	JMP	VCH_LP
  07C9'                         HSTEP:
  07C9'   CD 0000*              	CALL	CUROFF		; HL = cur
  07CC'   7C                    	MOV	A,H
  07CD'   B5                    	ORA	L
  07CE'   C8                    	RZ			; at 0
  07CF'   E5                    	PUSH	H
  07D0'   CD 05E4'              	CALL	BOL		; HL = bol
  07D3'   D1                    	POP	D		; DE = cur
  07D4'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  07D7'   C8                    	RZ			; at BOL, cannot go left
  07D8'   EB                    	XCHG			; HL = cur
  07D9'   2B                    	DCX	H
  07DA'   C3 057A'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  07DD'                         VC_L:
  07DD'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  07E0'   22 2A18'              	SHLD	CNTV
  07E3'                         VCL_LP:
  07E3'   2A 2A18'              	LHLD	CNTV
  07E6'   7C                    	MOV	A,H
  07E7'   B5                    	ORA	L
  07E8'   C8                    	RZ
  07E9'   2B                    	DCX	H
  07EA'   22 2A18'              	SHLD	CNTV
  07ED'   CD 07F3'              	CALL	LSTEP
  07F0'   C3 07E3'              	JMP	VCL_LP
  07F3'                         LSTEP:
  07F3'   CD 0000*              	CALL	CUROFF		; HL = cur
  07F6'   E5                    	PUSH	H
  07F7'   CD 0623'              	CALL	EOLC		; HL = eolc
  07FA'   D1                    	POP	D		; DE = cur
  07FB'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  07FE'   D2 0806'              	JNC	LS_NO		; cur >= eolc, cannot go right
  0801'   EB                    	XCHG			; HL = cur
  0802'   23                    	INX	H
  0803'   C3 057A'              	JMP	GOSET
  0806'                         LS_NO:				; on the line's last char.  An operator waiting on
  0806'   CD 0BAB'              	CALL	EMPTY		;   this 'l' takes that char too (vim makes the
  0809'   C8                    	RZ			;   motion inclusive when it falls short), which
  080A'   3E 01                 	MVI	A,1		;   is what WPULL tells OPA_EX: 'dl' there is 'x',
  080C'   32 29E1'              	STA	WPULL		;   and 'd3l' two from the end takes both.  An
  080F'   C9                    	RET			;   empty line has no char to take
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  0810'                         VC_0:
  0810'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0813'   CD 081D'              	CALL	LNSTRT
  0816'   21 0000               	LXI	H,0
  0819'   22 29DE'              	SHLD	GOALCOL
  081C'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  081D'                         LNSTRT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  081D'   CD 0F1C'              	CALL	ZSAVE
  0820'   21 0000               	LXI	H,0
  0823'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  0826'   E5                    	PUSH	H
  0827'   CD 0F2F'              	CALL	ZREST
  082A'   E1                    	POP	H
  082B'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  082E'                         VC_CRT:
  082E'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0831'   C3 0834'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  0834'                         FNBLNK:
  0834'   CD 081D'              	CALL	LNSTRT
  0837'   CD 0000*              	CALL	RGET0
  083A'   11 0000               	LXI	D,0		; DE = blanks skipped
  083D'                         FN_LP:
  083D'   CD 0000*              	CALL	RDGET
  0840'   DA 0863'              	JC	FN_GO		; the end of the file
  0843'   FE 20                 	CPI	' '
  0845'   CA 084D'              	JZ	FN_WH
  0848'   FE 09                 	CPI	TAB
  084A'   C2 0863'              	JNZ	FN_GO		; a non-blank, or the line's end
  084D'                         FN_WH:
  084D'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  0850'   DA 0863'              	JC	FN_GO
  0853'   FE 0D                 	CPI	CR
  0855'   CA 0863'              	JZ	FN_GO
  0858'   FE 0A                 	CPI	LF
  085A'   CA 0863'              	JZ	FN_GO
  085D'   2B                    	DCX	H		; not yet: read that char again
  085E'   03                    	INX	B
  085F'   13                    	INX	D
  0860'   C3 083D'              	JMP	FN_LP
  0863'                         FN_GO:
  0863'   D5                    	PUSH	D
  0864'   CD 0000*              	CALL	CUROFF
  0867'   D1                    	POP	D
  0868'   19                    	DAD	D
  0869'   C3 057A'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  086C'                         VC_EOL:
  086C'   CD 075A'              	CALL	SETMOV
  086F'   21 FFFF               	LXI	H,0FFFFH
  0872'   22 29DE'              	SHLD	GOALCOL
  0875'   CD 068B'              	CALL	GETCNT
  0878'   2B                    	DCX	H		; count-1
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  0879'   7C                    	MOV	A,H
  087A'   B5                    	ORA	L
  087B'   CA 088A'              	JZ	VEOL_0
  087E'   E5                    	PUSH	H
  087F'   CD 089F'              	CALL	ONLAST
  0882'   E1                    	POP	H
  0883'   D8                    	RC			; the last line: no move (vim)
  0884'   CD 08EF'              	CALL	JCORE
  0887'   C3 0A3E'              	JMP	JKLAND
  088A'                         VEOL_0:
  088A'   CD 081D'              	CALL	LNSTRT
  088D'   C3 0A3E'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  0890'                         VC_CR:
  0890'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0893'   E5                    	PUSH	H
  0894'   CD 089F'              	CALL	ONLAST
  0897'   E1                    	POP	H
  0898'   D8                    	RC
  0899'   CD 08EF'              	CALL	JCORE
  089C'   C3 0834'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  089F'                         ONLAST:
  089F'   CD 0000*              	CALL	RGET0
  08A2'                         OL_LP:
  08A2'   CD 0000*              	CALL	RDGET
  08A5'   D8                    	RC			; the file ends on this line
  08A6'   FE 0A                 	CPI	LF
  08A8'   C2 08A2'              	JNZ	OL_LP
  08AB'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  08AE'                         VC_J:
  08AE'   CD 075A'              	CALL	SETMOV
  08B1'   CD 08D9'              	CALL	GLCHK		; the goal column, from the cursor if stale
  08B4'   CD 068B'              	CALL	GETCNT		; HL = count
  08B7'   CD 08EF'              	CALL	JCORE
  08BA'   CD 08D2'              	CALL	JKDRP
  08BD'   C3 0A3E'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  08C0'                         VC_K:
  08C0'   CD 075A'              	CALL	SETMOV
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  08C3'   CD 08D9'              	CALL	GLCHK
  08C6'   CD 068B'              	CALL	GETCNT
  08C9'   CD 098C'              	CALL	KCORE
  08CC'   CD 08D2'              	CALL	JKDRP
  08CF'   C3 0A3E'              	JMP	JKLAND
                                
                                ;JKDRP -- DE = the lines JCORE / KCORE moved.  None -- 'j' on the last line,
                                ; 'k' on the first -- and the motion has failed: an operator waiting on it is
                                ; dropped, as vim drops it, where a line span that starts and ends on one line
                                ; would take that line ('dj' on the last line deleted it).  A count that runs
                                ; out of lines short has still moved, and its operator stands.  It is asked
                                ; here and not in the cores: 'dH' on the top row moves no lines either, and
                                ; takes its line.
  08D2'                         JKDRP:
  08D2'   7A                    	MOV	A,D
  08D3'   B3                    	ORA	E
  08D4'   C0                    	RNZ
  08D5'   32 2A00'              	STA	PSAVE
  08D8'   C9                    	RET
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  08D9'                         GLCHK:
  08D9'   2A 29DE'              	LHLD	GOALCOL
  08DC'   7C                    	MOV	A,H
  08DD'   3C                    	INR	A
  08DE'   C0                    	RNZ
  08DF'   7D                    	MOV	A,L
  08E0'   FE FE                 	CPI	0FEH
  08E2'   C0                    	RNZ
  08E3'   C3 057D'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  08E6'                         GLSTAL:
  08E6'   E5                    	PUSH	H
  08E7'   21 FFFE               	LXI	H,0FFFEH
  08EA'   22 29DE'              	SHLD	GOALCOL
  08ED'   E1                    	POP	H
  08EE'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  08EF'                         JCORE:
  08EF'   7C                    	MOV	A,H
  08F0'   B5                    	ORA	L
  08F1'   C8                    	RZ
  08F2'   22 29E4'              	SHLD	JKCNT
  08F5'   CD 0CCE'              	CALL	CURRW		; limit = rows under the cursor's + NEDIT
  08F8'   47                    	MOV	B,A
  08F9'   3A 0000*              	LDA	NEDIT
  08FC'   3D                    	DCR	A
  08FD'   90                    	SUB	B
  08FE'   5F                    	MOV	E,A
  08FF'   16 00                 	MVI	D,0
  0901'   3A 0000*              	LDA	NEDIT
  0904'   6F                    	MOV	L,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0905'   26 00                 	MVI	H,0
  0907'   19                    	DAD	D
  0908'   EB                    	XCHG			; DE = limit
  0909'   2A 29E4'              	LHLD	JKCNT
  090C'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  090F'   D2 0913'              	JNC	JC_N
  0912'   EB                    	XCHG			; HL = limit
  0913'                         JC_N:
  0913'   22 29E6'              	SHLD	JKN		; N = min(count, limit)
  0916'   EB                    	XCHG			; DE = LFs to find
  0917'   CD 0000*              	CALL	RGET0
  091A'                         JC_SC:
  091A'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  091D'   DA 093C'              	JC	JC_EOF
  0920'   32 29ED'              	STA	JKLST
  0923'   FE 0A                 	CPI	LF
  0925'   C2 091A'              	JNZ	JC_SC
  0928'   1B                    	DCX	D
  0929'   7A                    	MOV	A,D
  092A'   B3                    	ORA	E
  092B'   C2 091A'              	JNZ	JC_SC
  092E'   2A 29E4'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  0931'   22 29E8'              	SHLD	JKMOV		;   one if the last LF found ends the file
  0934'   3E 01                 	MVI	A,1
  0936'   32 29EC'              	STA	JKPHN
  0939'   C3 0957'              	JMP	JC_MV
  093C'                         JC_EOF:
  093C'   2A 29E6'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  093F'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  0942'   7C                    	MOV	A,H
  0943'   B5                    	ORA	L
  0944'   CA 0950'              	JZ	JC_AV
  0947'   3A 29ED'              	LDA	JKLST
  094A'   FE 0A                 	CPI	LF
  094C'   C2 0950'              	JNZ	JC_AV
  094F'   2B                    	DCX	H
  0950'                         JC_AV:
  0950'   22 29E8'              	SHLD	JKMOV
  0953'   AF                    	XRA	A
  0954'   32 29EC'              	STA	JKPHN
  0957'                         JC_MV:
  0957'   2A 29E4'              	LHLD	JKCNT
  095A'   AF                    	XRA	A
  095B'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  095E'   CD 0A1D'              	CALL	ATEOF
  0961'   D2 0975'              	JNC	JC_DN
  0964'   CD 0A23'              	CALL	LASTLN		; ran past the last line: back onto it
  0967'   3A 29EC'              	LDA	JKPHN
  096A'   B7                    	ORA	A
  096B'   CA 0975'              	JZ	JC_DN
  096E'   2A 29E8'              	LHLD	JKMOV
  0971'   2B                    	DCX	H
  0972'   22 29E8'              	SHLD	JKMOV
  0975'                         JC_DN:
  0975'   2A 29E6'              	LHLD	JKN		; LNDLT += min(moved, N)
  0978'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0979'   2A 29E8'              	LHLD	JKMOV
  097C'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  097F'   D2 0983'              	JNC	JC_AD
  0982'   EB                    	XCHG
  0983'                         JC_AD:
  0983'   EB                    	XCHG			; DE = lines moved
  0984'   2A 0000*              	LHLD	LNDLT
  0987'   19                    	DAD	D
  0988'   22 0000*              	SHLD	LNDLT
  098B'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  098C'                         KCORE:
  098C'   7C                    	MOV	A,H
  098D'   B5                    	ORA	L
  098E'   C8                    	RZ
  098F'   22 29E4'              	SHLD	JKCNT
  0992'   CD 0CCE'              	CALL	CURRW		; limit = row + NEDIT
  0995'   5F                    	MOV	E,A
  0996'   16 00                 	MVI	D,0
  0998'   3A 0000*              	LDA	NEDIT
  099B'   6F                    	MOV	L,A
  099C'   26 00                 	MVI	H,0
  099E'   19                    	DAD	D
  099F'   EB                    	XCHG			; DE = limit
  09A0'   2A 29E4'              	LHLD	JKCNT
  09A3'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  09A6'   D2 09AA'              	JNC	KC_N
  09A9'   EB                    	XCHG			; HL = limit
  09AA'                         KC_N:
  09AA'   22 29E6'              	SHLD	JKN		; N = min(count, limit)
  09AD'   EB                    	XCHG			; DE = LFs to find
  09AE'   21 0000               	LXI	H,0
  09B1'   22 29EA'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  09B4'                         KC_ED:
  09B4'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  09B5'   2A 29EA'              	LHLD	JKBK
  09B8'   CD 0684'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  09BB'   E5                    	PUSH	H
  09BC'   EB                    	XCHG
  09BD'   2A 0000*              	LHLD	TXTBEG
  09C0'   EB                    	XCHG
  09C1'   CD 0000*              	CALL	SUBHD
  09C4'   44                    	MOV	B,H
  09C5'   4D                    	MOV	C,L
  09C6'   E1                    	POP	H
  09C7'   D1                    	POP	D
  09C8'                         KC_SC:
  09C8'   78                    	MOV	A,B
  09C9'   B1                    	ORA	C
  09CA'   CA 09E1'              	JZ	KC_TB
  09CD'   2B                    	DCX	H
  09CE'   0B                    	DCX	B
  09CF'   7E                    	MOV	A,M
  09D0'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  09D2'   C2 09C8'              	JNZ	KC_SC
  09D5'   1B                    	DCX	D
  09D6'   7A                    	MOV	A,D
  09D7'   B3                    	ORA	E
  09D8'   C2 09C8'              	JNZ	KC_SC
  09DB'   2A 29E4'              	LHLD	JKCNT		; N lines above: the move is count lines
  09DE'   C3 0A01'              	JMP	KC_MV
  09E1'                         KC_TB:
  09E1'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  09E2'   CD 0684'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  09E5'   22 29EA'              	SHLD	JKBK
  09E8'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  09EB'   7C                    	MOV	A,H
  09EC'   B5                    	ORA	L
  09ED'   CA 09FA'              	JZ	KC_B0
  09F0'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  09F3'   D1                    	POP	D
  09F4'   DA 09FB'              	JC	KC_BOF
  09F7'   C3 09B4'              	JMP	KC_ED
  09FA'                         KC_B0:
  09FA'   D1                    	POP	D
  09FB'                         KC_BOF:
  09FB'   2A 29E6'              	LHLD	JKN		; moved = LFs found
  09FE'   CD 0000*              	CALL	SUBHD
  0A01'                         KC_MV:
  0A01'   E5                    	PUSH	H
  0A02'   2A 29E4'              	LHLD	JKCNT
  0A05'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0A08'   D1                    	POP	D		; DE = moved
  0A09'   2A 29E6'              	LHLD	JKN
  0A0C'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0A0F'   DA 0A13'              	JC	KC_AD
  0A12'   EB                    	XCHG			; DE = N
  0A13'                         KC_AD:
  0A13'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0A16'   CD 0000*              	CALL	SUBHD
  0A19'   22 0000*              	SHLD	LNDLT
  0A1C'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0A1D'                         ATEOF:
  0A1D'   CD 0000*              	CALL	RGET0
  0A20'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0A23'                         LASTLN:
  0A23'   2A 0000*              	LHLD	GAPBEG
  0A26'   EB                    	XCHG
  0A27'   2A 0000*              	LHLD	TXTBEG
  0A2A'   CD 0000*              	CALL	CMP16
  0A2D'   21 0000               	LXI	H,0
  0A30'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0A33'   1B                    	DCX	D
  0A34'   1A                    	LDAX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0A35'   FE 0A                 	CPI	LF
  0A37'   C2 0000*              	JNZ	SETBWD
  0A3A'   23                    	INX	H
  0A3B'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0A3E'                         JKLAND:
  0A3E'   21 0000               	LXI	H,0
  0A41'   22 29EE'              	SHLD	JKVC		; screen column
  0A44'   2B                    	DCX	H
  0A45'   22 29F0'              	SHLD	JKLS		; last content char: none yet
  0A48'   CD 0000*              	CALL	RGET0
  0A4B'   11 0000               	LXI	D,0		; DE = chars read
  0A4E'                         JL_RD:
  0A4E'   CD 0000*              	CALL	RDGET
  0A51'   DA 0A8B'              	JC	JL_END
  0A54'   FE 0A                 	CPI	LF
  0A56'   CA 0A8B'              	JZ	JL_END
  0A59'   E5                    	PUSH	H
  0A5A'   C5                    	PUSH	B
  0A5B'   2A 29EE'              	LHLD	JKVC
  0A5E'   CD 05D1'              	CALL	CWID
  0A61'   B7                    	ORA	A
  0A62'   CA 0A85'              	JZ	JL_NX		; a CR
  0A65'   EB                    	XCHG
  0A66'   22 29F0'              	SHLD	JKLS		; the last content char so far
  0A69'   EB                    	XCHG
  0A6A'   4F                    	MOV	C,A
  0A6B'   06 00                 	MVI	B,0
  0A6D'   09                    	DAD	B		; HL = the column after this char
  0A6E'   22 29EE'              	SHLD	JKVC
  0A71'   D5                    	PUSH	D
  0A72'   EB                    	XCHG
  0A73'   2A 29DE'              	LHLD	GOALCOL
  0A76'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0A79'   D1                    	POP	D
  0A7A'   DA 0A85'              	JC	JL_NX
  0A7D'   CA 0A85'              	JZ	JL_NX
  0A80'   C1                    	POP	B		; this char holds the goal column
  0A81'   E1                    	POP	H
  0A82'   C3 0A96'              	JMP	JL_GO
  0A85'                         JL_NX:
  0A85'   C1                    	POP	B
  0A86'   E1                    	POP	H
  0A87'   13                    	INX	D
  0A88'   C3 0A4E'              	JMP	JL_RD
  0A8B'                         JL_END:
  0A8B'   2A 29F0'              	LHLD	JKLS		; past the line's end: its last content char
  0A8E'   7C                    	MOV	A,H
  0A8F'   A5                    	ANA	L
  0A90'   3C                    	INR	A
  0A91'   C2 0A95'              	JNZ	JL_LS
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0A94'   23                    	INX	H		; no content: the line's start
  0A95'                         JL_LS:
  0A95'   EB                    	XCHG
  0A96'                         JL_GO:
  0A96'   D5                    	PUSH	D		; DE = step from the line start
  0A97'   CD 0000*              	CALL	CUROFF
  0A9A'   D1                    	POP	D
  0A9B'   19                    	DAD	D
  0A9C'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0A9F'   AF                    VC_W:	XRA	A
  0AA0'   32 29E0'              	STA	WBIG
  0AA3'   C3 0AAB'              	JMP	WDO
  0AA6'   3E 01                 VCBGW:	MVI	A,1
  0AA8'   32 29E0'              	STA	WBIG
  0AAB'   CD 075A'              WDO:	CALL	SETMOV
  0AAE'   AF                    	XRA	A
  0AAF'   32 29E1'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0AB2'   CD 068B'              	CALL	GETCNT
  0AB5'   22 2A18'              	SHLD	CNTV
  0AB8'   2A 2A18'              WDO_LP: LHLD	CNTV
  0ABB'   7C                    	MOV	A,H
  0ABC'   B5                    	ORA	L
  0ABD'   CA 0ACA'              	JZ	WDO_DN
  0AC0'   2B                    	DCX	H
  0AC1'   22 2A18'              	SHLD	CNTV
  0AC4'   CD 0B27'              	CALL	FWD1
  0AC7'   D2 0AB8'              	JNC	WDO_LP
  0ACA'                         WDO_DN:
  0ACA'   CD 0A1D'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0ACD'   DA 0ADA'              	JC	WDO_NL
  0AD0'   FE 0D                 	CPI	CR
  0AD2'   CA 0ADA'              	JZ	WDO_NL
  0AD5'   FE 0A                 	CPI	LF
  0AD7'   C2 057D'              	JNZ	SETGL
  0ADA'                         WDO_NL:
  0ADA'   CD 0000*              	CALL	PEEKL
  0ADD'   DA 057D'              	JC	SETGL
  0AE0'   FE 0A                 	CPI	LF
  0AE2'   CA 057D'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0AE5'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0AE7'   32 29E1'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0AEA'   CD 0C1F'              	CALL	DECC		; back onto its last char
  0AED'   C3 057D'              	JMP	SETGL
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


                                
  0AF0'   AF                    VC_B:	XRA	A
  0AF1'   32 29E0'              	STA	WBIG
  0AF4'   C3 0AFC'              	JMP	BDO
  0AF7'   3E 01                 VCBGB:	MVI	A,1
  0AF9'   32 29E0'              	STA	WBIG
  0AFC'   CD 075A'              BDO:	CALL	SETMOV
  0AFF'   CD 068B'              	CALL	GETCNT
  0B02'   22 2A18'              	SHLD	CNTV
  0B05'   CD 0B70'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0B08'   D2 0B18'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0B0B'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0B0C'   32 2A00'              	STA	PSAVE		;   first char opened an insert).  A count that
  0B0F'   C3 057D'              	JMP	SETGL		;   runs out at the start has still moved, and
  0B12'                         BDO_LP:				;   its operator stands -- both as vim
  0B12'   CD 0B70'              	CALL	BCK1
  0B15'   DA 057D'              	JC	SETGL
  0B18'   2A 2A18'              BDO_NX: LHLD	CNTV
  0B1B'   2B                    	DCX	H
  0B1C'   22 2A18'              	SHLD	CNTV
  0B1F'   7C                    	MOV	A,H
  0B20'   B5                    	ORA	L
  0B21'   C2 0B12'              	JNZ	BDO_LP
  0B24'   C3 057D'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
  0B27'                         FWD1:
  0B27'   CD 0BA3'              	CALL	CCLS
  0B2A'   32 2A24'              	STA	WKCLS		; the starting class
  0B2D'   CD 0BDD'              	CALL	INCC
  0B30'   B7                    	ORA	A
  0B31'   CA 0B46'              	JZ	FW_WD
  0B34'   37                    	STC
  0B35'   F8                    	RM			; -1: already at the end
  0B36'   FE 02                 	CPI	2
  0B38'   C2 0B46'              	JNZ	FW_WD		; 1: a next line was reached
  0B3B'   CD 0A1D'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0B3E'   D4 0BC4'              	CNC	NXLN
  0B41'   D2 0B46'              	JNC	FW_WD
  0B44'   37                    	STC			; yes: failed
  0B45'   C9                    	RET
  0B46'                         FW_WD:
  0B46'   3A 2A24'              	LDA	WKCLS		; go past the rest of this word
  0B49'   B7                    	ORA	A
  0B4A'   CA 0B5F'              	JZ	FW_WS
  0B4D'                         FW_WLP:
  0B4D'   CD 0BA3'              	CALL	CCLS
  0B50'   21 2A24'              	LXI	H,WKCLS
  0B53'   BE                    	CMP	M
  0B54'   C2 0B5F'              	JNZ	FW_WS
  0B57'   CD 0BDD'              	CALL	INCC
  0B5A'   B7                    	ORA	A
  0B5B'   F8                    	RM			; the end of the file (NC)
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0B5C'   C3 0B4D'              	JMP	FW_WLP
  0B5F'                         FW_WS:
  0B5F'   CD 0BA3'              	CALL	CCLS		; then over blanks to the next word
  0B62'   B7                    	ORA	A
  0B63'   C0                    	RNZ
  0B64'   CD 0BAB'              	CALL	EMPTY
  0B67'   C8                    	RZ			; an empty line is a word
  0B68'   CD 0BDD'              	CALL	INCC
  0B6B'   B7                    	ORA	A
  0B6C'   F8                    	RM
  0B6D'   C3 0B5F'              	JMP	FW_WS
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0B70'                         BCK1:
  0B70'   CD 0C1F'              	CALL	DECC
  0B73'   B7                    	ORA	A
  0B74'   37                    	STC
  0B75'   F8                    	RM
  0B76'                         BK_WS:
  0B76'   CD 0BA3'              	CALL	CCLS		; back over blanks
  0B79'   B7                    	ORA	A
  0B7A'   C2 0B8A'              	JNZ	BK_WD
  0B7D'   CD 0BAB'              	CALL	EMPTY
  0B80'   C8                    	RZ			; an empty line is a word
  0B81'   CD 0C1F'              	CALL	DECC
  0B84'   B7                    	ORA	A
  0B85'   F2 0B76'              	JP	BK_WS
  0B88'   AF                    	XRA	A		; the start of the file (NC)
  0B89'   C9                    	RET
  0B8A'                         BK_WD:
  0B8A'   32 2A24'              	STA	WKCLS		; back to the start of this word
  0B8D'                         BK_WLP:
  0B8D'   CD 0C1F'              	CALL	DECC
  0B90'   B7                    	ORA	A
  0B91'   FA 0BA1'              	JM	BK_OK		; the start of the file
  0B94'   CD 0BA3'              	CALL	CCLS
  0B97'   21 2A24'              	LXI	H,WKCLS
  0B9A'   BE                    	CMP	M
  0B9B'   CA 0B8D'              	JZ	BK_WLP
  0B9E'   CD 0BDD'              	CALL	INCC		; overshot: forward one
  0BA1'                         BK_OK:
  0BA1'   AF                    	XRA	A
  0BA2'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0BA3'                         CCLS:
  0BA3'   CD 0A1D'              	CALL	ATEOF
  0BA6'   D2 070F'              	JNC	CLASSF
  0BA9'   AF                    	XRA	A
  0BAA'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0BAB'                         EMPTY:
  0BAB'   CD 0A1D'              	CALL	ATEOF
  0BAE'   DA 0BB9'              	JC	EM_ST
  0BB1'   FE 0D                 	CPI	CR
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0BB3'   CA 0BB9'              	JZ	EM_ST
  0BB6'   FE 0A                 	CPI	LF
  0BB8'   C0                    	RNZ
  0BB9'                         EM_ST:
  0BB9'   CD 0000*              	CALL	PEEKL
  0BBC'   DA 0BC2'              	JC	EM_Y
  0BBF'   FE 0A                 	CPI	LF
  0BC1'   C9                    	RET
  0BC2'                         EM_Y:
  0BC2'   AF                    	XRA	A
  0BC3'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0BC4'                         NXLN:
  0BC4'   FE 0A                 	CPI	LF
  0BC6'   CA 0BD5'              	JZ	NX_LF
  0BC9'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0BCC'   D8                    	RC
  0BCD'   FE 0A                 	CPI	LF
  0BCF'   CA 0BD5'              	JZ	NX_LF
  0BD2'   2B                    	DCX	H		; a lone CR
  0BD3'   AF                    	XRA	A
  0BD4'   C9                    	RET
  0BD5'                         NX_LF:
  0BD5'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0BD8'   D8                    	RC
  0BD9'   2B                    	DCX	H
  0BDA'   3E 01                 	MVI	A,1
  0BDC'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0BDD'                         INCC:
  0BDD'   CD 0A1D'              	CALL	ATEOF
  0BE0'   DA 0C1B'              	JC	IC_END
  0BE3'   FE 0D                 	CPI	CR
  0BE5'   CA 0C06'              	JZ	IC_NL
  0BE8'   FE 0A                 	CPI	LF
  0BEA'   CA 0C06'              	JZ	IC_NL
  0BED'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0BF0'                         IC_CH:
  0BF0'   CD 0A1D'              	CALL	ATEOF
  0BF3'   DA 0C02'              	JC	IC_2
  0BF6'   FE 0D                 	CPI	CR
  0BF8'   CA 0C02'              	JZ	IC_2
  0BFB'   FE 0A                 	CPI	LF
  0BFD'   CA 0C02'              	JZ	IC_2
  0C00'   AF                    	XRA	A
  0C01'   C9                    	RET
  0C02'                         IC_2:
  0C02'   3E 02                 	MVI	A,2
  0C04'   B7                    	ORA	A
  0C05'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0C06'                         IC_NL:
  0C06'   CD 0BC4'              	CALL	NXLN
  0C09'   DA 0C1B'              	JC	IC_END
  0C0C'   F5                    	PUSH	PSW
  0C0D'   CD 0000*              	CALL	PUTCUR
  0C10'   F1                    	POP	PSW
  0C11'   B7                    	ORA	A
  0C12'   CA 0BF0'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0C15'   CD 0C41'              	CALL	LNINC
  0C18'   3E 01                 	MVI	A,1
  0C1A'   C9                    	RET
  0C1B'                         IC_END:
  0C1B'   3E FF                 	MVI	A,0FFH
  0C1D'   B7                    	ORA	A
  0C1E'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0C1F'                         DECC:
  0C1F'   CD 0000*              	CALL	PEEKL
  0C22'   DA 0C1B'              	JC	IC_END
  0C25'   F5                    	PUSH	PSW
  0C26'   CD 0000*              	CALL	PUTCUR
  0C29'   F1                    	POP	PSW
  0C2A'   FE 0A                 	CPI	LF
  0C2C'   3E 00                 	MVI	A,0
  0C2E'   C0                    	RNZ
  0C2F'   CD 0C4F'              	CALL	LNDEC
  0C32'   CD 0000*              	CALL	PEEKL		; onto its CR
  0C35'   DA 0C3D'              	JC	DC_1
  0C38'   FE 0D                 	CPI	CR
  0C3A'   CC 0000*              	CZ	PUTCUR
  0C3D'                         DC_1:
  0C3D'   3E 01                 	MVI	A,1
  0C3F'   B7                    	ORA	A
  0C40'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0C41'                         LNINC:
  0C41'   E5                    	PUSH	H
  0C42'   2A 0000*              	LHLD	LNDLT
  0C45'   7C                    	MOV	A,H
  0C46'   FE 40                 	CPI	40H
  0C48'   CA 0C5D'              	JZ	LN_X
  0C4B'   23                    	INX	H
  0C4C'   C3 0C5A'              	JMP	LN_ST
  0C4F'                         LNDEC:
  0C4F'   E5                    	PUSH	H
  0C50'   2A 0000*              	LHLD	LNDLT
  0C53'   7C                    	MOV	A,H
  0C54'   FE C0                 	CPI	0C0H
  0C56'   CA 0C5D'              	JZ	LN_X
  0C59'   2B                    	DCX	H
  0C5A'                         LN_ST:
  0C5A'   22 0000*              	SHLD	LNDLT
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C5D'                         LN_X:
  0C5D'   E1                    	POP	H
  0C5E'   C9                    	RET
                                
  0C5F'   AF                    VC_E:	XRA	A
  0C60'   32 29E0'              	STA	WBIG
  0C63'   C3 0C6B'              	JMP	EDO
  0C66'   3E 01                 VCBGE:	MVI	A,1
  0C68'   32 29E0'              	STA	WBIG
  0C6B'   CD 075A'              EDO:	CALL	SETMOV
  0C6E'   CD 068B'              	CALL	GETCNT
  0C71'   22 2A18'              	SHLD	CNTV
  0C74'   2A 2A18'              EDO_LP: LHLD	CNTV
  0C77'   7C                    	MOV	A,H
  0C78'   B5                    	ORA	L
  0C79'   CA 0ACA'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0C7C'   2B                    	DCX	H
  0C7D'   22 2A18'              	SHLD	CNTV
  0C80'   CD 0C89'              	CALL	ESTEP
  0C83'   D2 0C74'              	JNC	EDO_LP
  0C86'   C3 0ACA'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0C89'                         ESTEP:
  0C89'   CD 0BA3'              	CALL	CCLS
  0C8C'   32 2A24'              	STA	WKCLS		; the starting class
  0C8F'   CD 0BDD'              	CALL	INCC
  0C92'   B7                    	ORA	A
  0C93'   FA 0CB2'              	JM	ES_F
  0C96'   CD 0BA3'              	CALL	CCLS
  0C99'   B7                    	ORA	A
  0C9A'   CA 0CA4'              	JZ	ES_WS
  0C9D'   21 2A24'              	LXI	H,WKCLS
  0CA0'   BE                    	CMP	M
  0CA1'   CA 0CB4'              	JZ	ES_SK		; still in the word it started in: on to its end
  0CA4'                         ES_WS:
  0CA4'   CD 0BA3'              	CALL	CCLS		; over blanks, line ends and empty lines
  0CA7'   B7                    	ORA	A
  0CA8'   C2 0CB4'              	JNZ	ES_SK
  0CAB'   CD 0BDD'              	CALL	INCC
  0CAE'   B7                    	ORA	A
  0CAF'   F2 0CA4'              	JP	ES_WS
  0CB2'                         ES_F:
  0CB2'   37                    	STC
  0CB3'   C9                    	RET
  0CB4'                         ES_SK:
  0CB4'   CD 0BA3'              	CALL	CCLS		; past the rest of this word ...
  0CB7'   32 2A24'              	STA	WKCLS
  0CBA'                         ES_SL:
  0CBA'   CD 0BDD'              	CALL	INCC
  0CBD'   B7                    	ORA	A
  0CBE'   FA 0CB2'              	JM	ES_F
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0CC1'   CD 0BA3'              	CALL	CCLS
  0CC4'   21 2A24'              	LXI	H,WKCLS
  0CC7'   BE                    	CMP	M
  0CC8'   CA 0CBA'              	JZ	ES_SL
  0CCB'   C3 0C1F'              	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0CCE'                         CURRW:
  0CCE'   2A 0000*              	LHLD	WINROW
  0CD1'   EB                    	XCHG
  0CD2'   2A 0000*              	LHLD	LNDLT
  0CD5'   19                    	DAD	D		; HL = row (signed)
  0CD6'   7C                    	MOV	A,H
  0CD7'   B7                    	ORA	A
  0CD8'   FA 0CEB'              	JM	CRW_0		; above the screen -> top row
  0CDB'   C2 0CE6'              	JNZ	CRW_BT		; far below -> bottom row
  0CDE'   3A 0000*              	LDA	NEDIT
  0CE1'   3D                    	DCR	A		; A = bottom row
  0CE2'   BD                    	CMP	L		; CY iff bottom < row
  0CE3'   D8                    	RC
  0CE4'   7D                    	MOV	A,L
  0CE5'   C9                    	RET
  0CE6'                         CRW_BT:
  0CE6'   3A 0000*              	LDA	NEDIT
  0CE9'   3D                    	DCR	A
  0CEA'   C9                    	RET
  0CEB'                         CRW_0:
  0CEB'   AF                    	XRA	A
  0CEC'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0CED'                         SETRWT:
  0CED'   2A 0000*              	LHLD	LNDLT
  0CF0'   EB                    	XCHG
  0CF1'   6F                    	MOV	L,A
  0CF2'   26 00                 	MVI	H,0
  0CF4'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0CF7'   22 0000*              	SHLD	WINROW
  0CFA'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0CFB'                         MVROW:
  0CFB'   47                    	MOV	B,A
  0CFC'   CD 0CCE'              	CALL	CURRW
  0CFF'   90                    	SUB	B		; A = row now - target
  0D00'   C8                    	RZ
  0D01'   DA 0D0A'              	JC	MR_DN
  0D04'   6F                    	MOV	L,A
  0D05'   26 00                 	MVI	H,0
  0D07'   C3 098C'              	JMP	KCORE
  0D0A'                         MR_DN:
  0D0A'   2F                    	CMA
  0D0B'   3C                    	INR	A		; A = target - row now
  0D0C'   6F                    	MOV	L,A
  0D0D'   26 00                 	MVI	H,0
  0D0F'   C3 08EF'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0D12'                         VC_HIGH:
  0D12'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D15'   2B                    	DCX	H		; row = count - 1
  0D16'   7C                    	MOV	A,H
  0D17'   B7                    	ORA	A
  0D18'   3A 0000*              	LDA	SCBOT
  0D1B'   C2 0D23'              	JNZ	VH_GO		; >= 256 -> the last text row
  0D1E'   BD                    	CMP	L		; CY iff SCBOT < row
  0D1F'   DA 0D23'              	JC	VH_GO
  0D22'   7D                    	MOV	A,L
  0D23'                         VH_GO:
  0D23'   CD 0CFB'              	CALL	MVROW
  0D26'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0D29'                         VC_MIDL:
  0D29'   CD 0678'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0D2C'   3A 0000*              	LDA	SCBOT
  0D2F'   B7                    	ORA	A		; clear CY for the shift
  0D30'   1F                    	RAR			; A = SCBOT / 2
  0D31'   CD 0CFB'              	CALL	MVROW
  0D34'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0D37'                         VC_LOWL:
  0D37'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D3A'   2B                    	DCX	H		; count - 1
  0D3B'   3A 0000*              	LDA	SCBOT
  0D3E'   5F                    	MOV	E,A
  0D3F'   16 00                 	MVI	D,0
  0D41'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0D42'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0D45'   3E 00                 	MVI	A,0
  0D47'   D2 0D4E'              	JNC	VL_GO		; at or past the top -> row 0
  0D4A'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D4D'   7D                    	MOV	A,L
  0D4E'                         VL_GO:
  0D4E'   CD 0CFB'              	CALL	MVROW
  0D51'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0D54'                         VC_PGDN:
  0D54'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D57'   3A 0000*              	LDA	SCEOF
  0D5A'   B7                    	ORA	A
  0D5B'   CA 0D69'              	JZ	VPD_N
  0D5E'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0D61'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0D62'   C8                    	RZ			; it already is
  0D63'   CD 0CFB'              	CALL	MVROW
  0D66'   C3 0D7A'              	JMP	VPD_TP
  0D69'                         VPD_N:
  0D69'   3A 0000*              	LDA	NEDIT
  0D6C'   D6 02                 	SUI	2
  0D6E'   CD 0DC2'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0D71'   E5                    	PUSH	H
  0D72'   AF                    	XRA	A
  0D73'   CD 0CFB'              	CALL	MVROW		; the top line
  0D76'   E1                    	POP	H
  0D77'   CD 08EF'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0D7A'                         VPD_TP:
  0D7A'   AF                    	XRA	A
  0D7B'   CD 0CED'              	CALL	SETRWT		; to the top row
  0D7E'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0D81'                         VC_PGUP:
  0D81'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D84'   3A 0000*              	LDA	SCBOF
  0D87'   B7                    	ORA	A
  0D88'   C0                    	RNZ
  0D89'   3A 0000*              	LDA	NEDIT
  0D8C'   47                    	MOV	B,A
  0D8D'   3A 0000*              	LDA	SCEOF
  0D90'   B7                    	ORA	A
  0D91'   CA 0DA2'              	JZ	VPU_2
  0D94'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0D97'   FE 02                 	CPI	2
  0D99'   D2 0DA2'              	JNC	VPU_2
  0D9C'   2F                    	CMA
  0D9D'   3C                    	INR	A
  0D9E'   80                    	ADD	B
  0D9F'   C3 0DA5'              	JMP	VPU_P
  0DA2'                         VPU_2:
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0DA2'   78                    	MOV	A,B
  0DA3'   D6 02                 	SUI	2
  0DA5'                         VPU_P:
  0DA5'   CD 0DC2'              	CALL	MULSAT		; HL = count * page
  0DA8'   E5                    	PUSH	H
  0DA9'   AF                    	XRA	A
  0DAA'   CD 0CFB'              	CALL	MVROW		; the top line
  0DAD'   E1                    	POP	H
  0DAE'   CD 098C'              	CALL	KCORE		; the new top line
  0DB1'   AF                    	XRA	A
  0DB2'   CD 0CED'              	CALL	SETRWT		; on the top row
  0DB5'   3A 0000*              	LDA	NEDIT
  0DB8'   3D                    	DCR	A
  0DB9'   6F                    	MOV	L,A
  0DBA'   26 00                 	MVI	H,0
  0DBC'   CD 08EF'              	CALL	JCORE		; the bottom row's line
  0DBF'   C3 0834'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0DC2'                         MULSAT:
  0DC2'   EB                    	XCHG
  0DC3'   21 0000               	LXI	H,0
  0DC6'   B7                    	ORA	A
  0DC7'   C8                    	RZ
  0DC8'                         MS_LP:
  0DC8'   19                    	DAD	D
  0DC9'   DA 0DD1'              	JC	MS_SAT
  0DCC'   3D                    	DCR	A
  0DCD'   C2 0DC8'              	JNZ	MS_LP
  0DD0'   C9                    	RET
  0DD1'                         MS_SAT:
  0DD1'   21 FFFF               	LXI	H,0FFFFH
  0DD4'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0DD5'                         VC_HFDN:
  0DD5'   CD 075A'              	CALL	SETMOV
  0DD8'   CD 0CCE'              	CALL	CURRW
  0DDB'   32 29E2'              	STA	HFROW
  0DDE'   CD 0E4C'              	CALL	HFCNT		; HL = lines
  0DE1'   3A 29E2'              	LDA	HFROW
  0DE4'   47                    	MOV	B,A
  0DE5'   3A 0000*              	LDA	SCEOF
  0DE8'   B7                    	ORA	A
  0DE9'   CA 0DF1'              	JZ	VHD_GO
  0DEC'   3A 0000*              	LDA	SCBOT		; the last line's row
  0DEF'   B8                    	CMP	B
  0DF0'   C8                    	RZ			; the cursor is on it
  0DF1'                         VHD_GO:
  0DF1'   CD 08EF'              	CALL	JCORE
  0DF4'   3A 0000*              	LDA	SCEOF
  0DF7'   B7                    	ORA	A
  0DF8'   C2 0834'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0DFB'   3A 29E2'              	LDA	HFROW
  0DFE'   CD 0CED'              	CALL	SETRWT
  0E01'   3E 01                 	MVI	A,1
  0E03'   32 0000*              	STA	WFILL		; not past the end of the file
  0E06'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0E09'                         VC_HFUP:
  0E09'   CD 075A'              	CALL	SETMOV
  0E0C'   CD 0CCE'              	CALL	CURRW
  0E0F'   32 29E2'              	STA	HFROW
  0E12'   CD 0E4C'              	CALL	HFCNT		; HL = lines
  0E15'   CD 0E2C'              	CALL	ONFST
  0E18'   C8                    	RZ			; the cursor is on the first line
  0E19'   CD 098C'              	CALL	KCORE
  0E1C'   3A 0000*              	LDA	SCBOF
  0E1F'   B7                    	ORA	A
  0E20'   C2 0834'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0E23'   3A 29E2'              	LDA	HFROW
  0E26'   CD 0CED'              	CALL	SETRWT
  0E29'   C3 0834'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0E2C'                         ONFST:
  0E2C'   E5                    	PUSH	H
  0E2D'   2A 0000*              	LHLD	OUTPOS
  0E30'   7C                    	MOV	A,H
  0E31'   B5                    	ORA	L
  0E32'   C2 0E4A'              	JNZ	OF_RET
  0E35'   2A 0000*              	LHLD	TXTBEG
  0E38'   EB                    	XCHG			; DE = TXTBEG
  0E39'   2A 0000*              	LHLD	GAPBEG
  0E3C'                         OF_LP:
  0E3C'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0E3F'   CA 0E4A'              	JZ	OF_RET
  0E42'   2B                    	DCX	H
  0E43'   7E                    	MOV	A,M
  0E44'   FE 0A                 	CPI	LF
  0E46'   C2 0E3C'              	JNZ	OF_LP
  0E49'   B7                    	ORA	A		; NZ
  0E4A'                         OF_RET:
  0E4A'   E1                    	POP	H
  0E4B'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0E4C'                         HFCNT:
  0E4C'   2A 29D6'              	LHLD	CMDCNT
  0E4F'   7C                    	MOV	A,H
  0E50'   B5                    	ORA	L
  0E51'   CA 0E68'              	JZ	HFC_AM
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E54'   CD 068B'              	CALL	GETCNT		; HL = count; clears it
  0E57'   3A 0000*              	LDA	NEDIT
  0E5A'   5F                    	MOV	E,A
  0E5B'   16 00                 	MVI	D,0
  0E5D'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0E60'   D2 0E64'              	JNC	HFC_ST
  0E63'   EB                    	XCHG			; HL = NEDIT
  0E64'                         HFC_ST:
  0E64'   7D                    	MOV	A,L
  0E65'   32 29E3'              	STA	HFAMT
  0E68'                         HFC_AM:
  0E68'   3A 29E3'              	LDA	HFAMT
  0E6B'   B7                    	ORA	A
  0E6C'   C2 0E79'              	JNZ	HFC_HL
  0E6F'   3A 0000*              	LDA	NEDIT
  0E72'   B7                    	ORA	A
  0E73'   1F                    	RAR
  0E74'   B7                    	ORA	A
  0E75'   C2 0E79'              	JNZ	HFC_HL
  0E78'   3C                    	INR	A		; at least one line
  0E79'                         HFC_HL:
  0E79'   6F                    	MOV	L,A
  0E7A'   26 00                 	MVI	H,0
  0E7C'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0E7D'                         VC_REDR:
  0E7D'   C3 068B'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0E80'                         VC_G:
  0E80'   CD 075A'              	CALL	SETMOV
  0E83'   CD 0F42'              	CALL	GZONE		; the screen's top line, before the move
  0E86'   CD 06B4'              	CALL	BRKON		; ... and a ^C may stop it from here on
  0E89'   2A 29D6'              	LHLD	CMDCNT
  0E8C'   7C                    	MOV	A,H
  0E8D'   B5                    	ORA	L
  0E8E'   C2 0EA1'              	JNZ	VG_N
  0E91'   AF                    	XRA	A		; forward
  0E92'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0E95'   CD 06EB'              	CALL	BRKOFF
  0E98'   DA 0703'              	JC	BRKBAK
  0E9B'   CD 0A23'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0E9E'   C3 0F5A'              	JMP	GPLACE
  0EA1'                         VG_N:
  0EA1'   CD 068B'              	CALL	GETCNT		; HL = target line (1-based)
  0EA4'                         VG_LN:
  0EA4'   CD 0EB0'              	CALL	GOLN
  0EA7'   CD 06EB'              	CALL	BRKOFF
  0EAA'   DA 0703'              	JC	BRKBAK
  0EAD'   C3 0F5A'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  0EB0'                         GOLN:
  0EB0'   E5                    	PUSH	H
  0EB1'   CD 0000*              	CALL	CNTLF
  0EB4'   23                    	INX	H		; HL = the cursor's line
  0EB5'   D1                    	POP	D		; DE = the line wanted
  0EB6'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  0EB9'   DA 0EC4'              	JC	GLN_BK
  0EBC'   EB                    	XCHG
  0EBD'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  0EC0'   AF                    	XRA	A
  0EC1'   C3 0EC9'              	JMP	GLN_MV
  0EC4'                         GLN_BK:
  0EC4'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  0EC7'   3E FF                 	MVI	A,0FFH
  0EC9'                         GLN_MV:
  0EC9'   CD 0000*              	CALL	MVLIND
  0ECC'   CD 0A1D'              	CALL	ATEOF
  0ECF'   DC 0A23'              	CC	LASTLN		; past the last line: onto it
  0ED2'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0ED3'                         VC_LG:
  0ED3'   CD 075A'              	CALL	SETMOV
  0ED6'   3A 29FE'              	LDA	GSAVE
  0ED9'   B7                    	ORA	A
  0EDA'   C2 0EE3'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0EDD'   3E 01                 	MVI	A,PG
  0EDF'   32 29FD'              	STA	GPEND
  0EE2'   C9                    	RET
  0EE3'                         VLG_GG:
  0EE3'   CD 0F42'              	CALL	GZONE
  0EE6'   CD 06B4'              	CALL	BRKON
  0EE9'   CD 068B'              	CALL	GETCNT		; HL = target line (no count: 1)
  0EEC'   C3 0EA4'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0EEF'                         SUB24:
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0EEF'   4F                    	MOV	C,A
  0EF0'   7D                    	MOV	A,L
  0EF1'   93                    	SUB	E
  0EF2'   6F                    	MOV	L,A
  0EF3'   7C                    	MOV	A,H
  0EF4'   9A                    	SBB	D
  0EF5'   67                    	MOV	H,A
  0EF6'   79                    	MOV	A,C
  0EF7'   98                    	SBB	B
  0EF8'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0EF9'                         CURFP:
  0EF9'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0EFC'                         FPOS:
  0EFC'   C5                    	PUSH	B
  0EFD'   D5                    	PUSH	D
  0EFE'   EB                    	XCHG
  0EFF'   2A 0000*              	LHLD	TXTBEG
  0F02'   EB                    	XCHG
  0F03'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0F06'   EB                    	XCHG			; DE = that
  0F07'   2A 0000*              	LHLD	OUTPOS
  0F0A'   7C                    	MOV	A,H
  0F0B'   B7                    	ORA	A		; CY = 0
  0F0C'   1F                    	RAR
  0F0D'   47                    	MOV	B,A
  0F0E'   7D                    	MOV	A,L
  0F0F'   1F                    	RAR
  0F10'   67                    	MOV	H,A
  0F11'   3E 00                 	MVI	A,0
  0F13'   1F                    	RAR
  0F14'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0F15'   19                    	DAD	D
  0F16'   78                    	MOV	A,B
  0F17'   CE 00                 	ACI	0		; A:HL = the position
  0F19'   D1                    	POP	D
  0F1A'   C1                    	POP	B
  0F1B'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0F1C'                         ZSAVE:
  0F1C'   2A 29D6'              	LHLD	CMDCNT
  0F1F'   22 2A3C'              	SHLD	ZSVCNT
  0F22'   2A 0000*              	LHLD	AUXCNT
  0F25'   22 2A3E'              	SHLD	ZSVAUX
  0F28'   3A 0000*              	LDA	DIRFLG
  0F2B'   32 2A40'              	STA	ZSVDIR
  0F2E'   C9                    	RET
  0F2F'                         ZREST:
  0F2F'   2A 2A3C'              	LHLD	ZSVCNT
  0F32'   22 29D6'              	SHLD	CMDCNT
  0F35'   2A 2A3E'              	LHLD	ZSVAUX
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F38'   22 0000*              	SHLD	AUXCNT
  0F3B'   3A 2A40'              	LDA	ZSVDIR
  0F3E'   32 0000*              	STA	DIRFLG
  0F41'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0F42'                         GZONE:
  0F42'   CD 0F1C'              	CALL	ZSAVE
  0F45'   CD 0CCE'              	CALL	CURRW
  0F48'   6F                    	MOV	L,A
  0F49'   26 00                 	MVI	H,0
  0F4B'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0F4E'   CD 0EFC'              	CALL	FPOS
  0F51'   22 0000*              	SHLD	ZTOP
  0F54'   32 0002*              	STA	ZTOP+2
  0F57'   C3 0F2F'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0F5A'                         GPLACE:
  0F5A'   CD 0F1C'              	CALL	ZSAVE
  0F5D'   CD 0EF9'              	CALL	CURFP
  0F60'   EB                    	XCHG
  0F61'   2A 0000*              	LHLD	ZTOP
  0F64'   EB                    	XCHG
  0F65'   4F                    	MOV	C,A		; C:HL = the target's position
  0F66'   3A 0002*              	LDA	ZTOP+2
  0F69'   47                    	MOV	B,A		; B:DE = the top's
  0F6A'   79                    	MOV	A,C
  0F6B'   CD 0EEF'              	CALL	SUB24
  0F6E'   22 2A39'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  0F71'   DA 0FBE'              	JC	GP_UP
  0F74'   B7                    	ORA	A
  0F75'   C2 0FFF'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0F78'   3A 0000*              	LDA	NEDIT
  0F7B'   5F                    	MOV	E,A
  0F7C'   16 00                 	MVI	D,0
  0F7E'   B7                    	ORA	A
  0F7F'   1F                    	RAR
  0F80'   6F                    	MOV	L,A
  0F81'   26 00                 	MVI	H,0
  0F83'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0F84'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0F87'   CD 0684'              	CALL	GBSUB		; HL = bytes from there to the target
  0F8A'   EB                    	XCHG
  0F8B'   2A 2A39'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0F8E'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0F91'   DA 0FFF'              	JC	GP_MID
  0F94'   CD 0684'              	CALL	GBSUB		; HL = the top line's start (resident)
  0F97'   01 0000               	LXI	B,0		; BC = lines from the top
  0F9A'                         GP_CNT:
  0F9A'   7A                    	MOV	A,D
  0F9B'   B3                    	ORA	E
  0F9C'   CA 0FAB'              	JZ	GP_DN
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F9F'   7E                    	MOV	A,M
  0FA0'   23                    	INX	H
  0FA1'   1B                    	DCX	D
  0FA2'   FE 0A                 	CPI	LF
  0FA4'   C2 0F9A'              	JNZ	GP_CNT
  0FA7'   03                    	INX	B
  0FA8'   C3 0F9A'              	JMP	GP_CNT
  0FAB'                         GP_DN:
  0FAB'   3A 0000*              	LDA	NEDIT
  0FAE'   3D                    	DCR	A
  0FAF'   5F                    	MOV	E,A
  0FB0'   16 00                 	MVI	D,0		; DE = the bottom row
  0FB2'   60                    	MOV	H,B
  0FB3'   69                    	MOV	L,C
  0FB4'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0FB7'   DA 1009'              	JC	GP_SET		; A = the bottom row
  0FBA'   7D                    	MOV	A,L		; on the screen: its row
  0FBB'   C3 1029'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0FBE'                         GP_UP:
  0FBE'   3C                    	INR	A
  0FBF'   C2 0FFF'              	JNZ	GP_MID		; 64K bytes or more above
  0FC2'   2A 2A39'              	LHLD	ZDIF
  0FC5'   EB                    	XCHG
  0FC6'   21 0000               	LXI	H,0
  0FC9'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0FCC'   7C                    	MOV	A,H
  0FCD'   B5                    	ORA	L
  0FCE'   CA 0FFF'              	JZ	GP_MID		; exactly 64K
  0FD1'   EB                    	XCHG			; DE = bytes to read
  0FD2'   AF                    	XRA	A
  0FD3'   32 2A3B'              	STA	ZLF
  0FD6'   CD 0000*              	CALL	RGET0
  0FD9'                         GP_RD:
  0FD9'   CD 0000*              	CALL	RDGET		; (keeps DE)
  0FDC'   DA 0FFF'              	JC	GP_MID
  0FDF'   FE 0A                 	CPI	LF
  0FE1'   C2 0FF5'              	JNZ	GP_RN
  0FE4'   3A 0000*              	LDA	NEDIT
  0FE7'   B7                    	ORA	A
  0FE8'   1F                    	RAR
  0FE9'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  0FEB'   E5                    	PUSH	H
  0FEC'   21 2A3B'              	LXI	H,ZLF
  0FEF'   34                    	INR	M
  0FF0'   BE                    	CMP	M		; CY iff more lines than that
  0FF1'   E1                    	POP	H
  0FF2'   DA 0FFF'              	JC	GP_MID
  0FF5'                         GP_RN:
  0FF5'   1B                    	DCX	D
  0FF6'   7A                    	MOV	A,D
  0FF7'   B3                    	ORA	E
  0FF8'   C2 0FD9'              	JNZ	GP_RD
  0FFB'   AF                    	XRA	A		; the top row
  0FFC'   C3 1009'              	JMP	GP_SET
  0FFF'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


                                				;   adjacent, the A it computes is the row
  0FFF'   3E 01                 	MVI	A,1
  1001'   32 0000*              	STA	WFILL		; not past the end of the file
  1004'   3A 0000*              	LDA	NEDIT
  1007'   B7                    	ORA	A
  1008'   1F                    	RAR			; the middle row
  1009'                         GP_SET:
  1009'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  100A'   26 00                 	MVI	H,0
  100C'   22 0000*              	SHLD	WINROW
  100F'   21 0000               	LXI	H,0
  1012'   22 0000*              	SHLD	LNDLT
  1015'   CD 077B'              	CALL	SETFUL		; the window may have paged: full repaint
  1018'                         GP_FIN:
  1018'   CD 0F2F'              	CALL	ZREST
  101B'   3A 2A63'              	LDA	GPKEEP
  101E'   B7                    	ORA	A
  101F'   CA 0834'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  1022'   AF                    	XRA	A
  1023'   32 2A63'              	STA	GPKEEP
  1026'   C3 057D'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  1029'                         GP_ONS:
  1029'   6F                    	MOV	L,A
  102A'   26 00                 	MVI	H,0		; HL = the row it lands on
  102C'   EB                    	XCHG
  102D'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  1030'   EB                    	XCHG
  1031'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  1034'   22 0000*              	SHLD	LNDLT
  1037'   3E 01                 	MVI	A,R_MOVE
  1039'   32 29DA'              	STA	RINTENT
  103C'   C3 1018'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  103F'                         OPPEND:
  103F'   AF                    	XRA	A
  1040'   32 2A03'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  1043'   3A 2A00'              	LDA	PSAVE
  1046'   FE 63                 	CPI	'c'
  1048'   C2 1065'              	JNZ	OPP_ND
  104B'   79                    	MOV	A,C
  104C'   FE 77                 	CPI	'w'
  104E'   CA 1056'              	JZ	OPP_W
  1051'   FE 57                 	CPI	'W'
  1053'   C2 1065'              	JNZ	OPP_ND
  1056'                         OPP_W:
  1056'   CD 1238'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  1059'   DA 1065'              	JC	OPP_ND
  105C'   79                    	MOV	A,C
  105D'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  105F'   4F                    	MOV	C,A
  1060'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  1062'   32 2A03'              	STA	CWEOL		;   see the clamp in OPA_F
  1065'                         OPP_ND:
  1065'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  1066'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  1068'   C2 107C'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  106B'   CD 021C'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  106E'   DA 110C'              	JC	OPABRT
  1071'   79                    	MOV	A,C
  1072'   FE 67                 	CPI	'g'
  1074'   C2 110C'              	JNZ	OPABRT
  1077'   3E 01                 	MVI	A,PG
  1079'   32 29FE'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  107C'                         OPP_NG:
  107C'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  107D'   21 2A00'              	LXI	H,PSAVE
  1080'   BE                    	CMP	M
  1081'   CA 1259'              	JZ	OPLINE
  1084'   79                    	MOV	A,C		; (OPCLS classifies the key)
  1085'   CD 126F'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1088'   DA 110C'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  108B'   32 2A02'              	STA	OPCLSV
  108E'   47                    	MOV	B,A		; B = the class
  108F'   3A 2A00'              	LDA	PSAVE
  1092'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  1094'   C2 10A0'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  1097'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  1098'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  109A'   C2 10C2'              	JNZ	OPP_GO
  109D'   C3 10AB'              	JMP	OPP_NO
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  10A0'                         OPP_NC:
  10A0'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  10A2'   C2 10C2'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  10A5'   78                    	MOV	A,B		;   a charwise register would need a type flag
  10A6'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  10A8'   CA 10C2'              	JZ	OPP_GO		;   within a line -- neither of which is built
  10AB'                         OPP_NO:
  10AB'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  10AC'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  10AE'   CA 10BC'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  10B1'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  10B3'   CA 10BC'              	JZ	OPP_SW		;   so swallow it before dropping the command
  10B6'   CD 034C'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  10B9'   C2 110C'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  10BC'                         OPP_SW:
  10BC'   CD 021C'              	CALL	MKGETK
  10BF'   C3 110C'              	JMP	OPABRT
  10C2'                         OPP_GO:
  10C2'   AF                    	XRA	A
  10C3'   32 29E1'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  10C6'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  10C9'   22 2A04'              	SHLD	OPSTA
  10CC'   C5                    	PUSH	B
  10CD'   21 2A08'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  10D0'   CD 044F'              	CALL	FPSTO		;   only good until the motion pages the window
  10D3'   3A 2A02'              	LDA	OPCLSV
  10D6'   FE 02                 	CPI	2
  10D8'   CC 110F'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  10DB'   C1                    	POP	B
  10DC'   21 2904'              	LXI	H,CMDTAB
  10DF'   CD 00C9'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  10E2'   3A 2A00'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  10E5'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  10E6'   CA 075A'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  10E9'   CD 113B'              	CALL	OPSFIX		; where the start is in the window NOW
  10EC'   D2 1157'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  10EF'   22 2A04'              	SHLD	OPSTA
  10F2'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  10F5'   22 2A06'              	SHLD	OPEND2
  10F8'   3A 2A00'              	LDA	PSAVE
  10FB'   FE 79                 	CPI	'y'
  10FD'   CA 1784'              	JZ	OPYANK		; a yank takes the span without losing it
  1100'   CD 12AA'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  1103'   3A 2A00'              	LDA	PSAVE
  1106'   FE 63                 	CPI	'c'
  1108'   C0                    	RNZ
  1109'   C3 1540'              	JMP	SETINS
  110C'                         OPABRT:				; not a motion -> the operator is dropped and
  110C'   C3 00A9'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  110F'                         OPENDS:
  110F'   2A 2A04'              	LHLD	OPSTA
  1112'   CD 05E4'              	CALL	BOL
  1115'   11 2A0B'              	LXI	D,OPSLO
  1118'   CD 112D'              	CALL	OPE_ST
  111B'   2A 2A04'              	LHLD	OPSTA
  111E'   CD 0614'              	CALL	NLSTART
  1121'   11 2A0E'              	LXI	D,OPSHI
  1124'   CD 112D'              	CALL	OPE_ST
  1127'   2A 2A04'              	LHLD	OPSTA
  112A'   C3 0000*              	JMP	GOTO
  112D'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  112D'   D5                    	PUSH	D
  112E'   CD 0000*              	CALL	GOTO
  1131'   E1                    	POP	H
  1132'   C3 044F'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  1135'                         CURBD:
  1135'   CD 0EF9'              	CALL	CURFP
  1138'   EB                    	XCHG
  1139'   47                    	MOV	B,A
  113A'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  113B'                         OPSFIX:
  113B'   21 2A08'              	LXI	H,OPSFP
  113E'   CD 0402'              	CALL	MKLOAD
  1141'   CD 1135'              	CALL	CURBD
  1144'   2A 2A6D'              	LHLD	MKPOS
  1147'   3A 2A6F'              	LDA	MKPOS+2
  114A'   CD 0EEF'              	CALL	SUB24
  114D'   B4                    	ORA	H
  114E'   B5                    	ORA	L
  114F'   C2 040F'              	JNZ	MKWIN
  1152'   CD 0000*              	CALL	CUROFF
  1155'   37                    	STC
  1156'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  1157'                         OPPGD:
  1157'   47                    	MOV	B,A
  1158'   3A 2A02'              	LDA	OPCLSV
  115B'   FE 02                 	CPI	2
  115D'   C2 1219'              	JNZ	OPG_NO
  1160'   3A 2A00'              	LDA	PSAVE
  1163'   FE 64                 	CPI	'd'
  1165'   C2 1219'              	JNZ	OPG_NO
  1168'   04                    	INR	B
  1169'   CA 1178'              	JZ	OPG_FW
  116C'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  116F'   CD 05E4'              	CALL	BOL		;   and the high end is OPSHI as it stands
  1172'   CD 0000*              	CALL	GOTO
  1175'   C3 1190'              	JMP	OPG_GO
  1178'                         OPG_FW:
  1178'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  117B'   CD 0614'              	CALL	NLSTART		;   landed on, and the low one is where the
  117E'   11 2A0E'              	LXI	D,OPSHI		;   start line began
  1181'   CD 112D'              	CALL	OPE_ST
  1184'   21 2A0B'              	LXI	H,OPSLO
  1187'   CD 0402'              	CALL	MKLOAD
  118A'   CD 03CF'              	CALL	MKPAGE
  118D'   CD 0000*              	CALL	GOTO
  1190'                         OPG_GO:
  1190'   CD 1135'              	CALL	CURBD
  1193'   2A 2A0E'              	LHLD	OPSHI
  1196'   3A 2A10'              	LDA	OPSHI+2
  1199'   CD 0EEF'              	CALL	SUB24		; A:HL = the bytes to take
  119C'                         OPG_SV:
  119C'   22 2A11'              	SHLD	OPTOGO
  119F'   32 2A13'              	STA	OPTOGO+2
  11A2'                         OPG_NX:
  11A2'   CD 0667'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  11A5'   CD 0000*              	CALL	SUBHD
  11A8'   EB                    	XCHG			; DE = what the window holds past the cursor
  11A9'   2A 2A11'              	LHLD	OPTOGO
  11AC'   3A 2A13'              	LDA	OPTOGO+2
  11AF'   B7                    	ORA	A
  11B0'   C2 11E3'              	JNZ	OPG_PG		; 64K or more to go
  11B3'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  11B6'   DA 11E3'              	JC	OPG_PG
  11B9'   CA 11E3'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  11BC'                         OPG_FN:				; the rest of it is here
  11BC'   E5                    	PUSH	H
  11BD'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  11C0'   CD 0000*              	CALL	CUROFF
  11C3'   22 2A14'              	SHLD	OPLO
  11C6'   D1                    	POP	D
  11C7'   19                    	DAD	D
  11C8'   22 2A16'              	SHLD	OPHI
  11CB'   CD 13B0'              	CALL	OPDSPN
  11CE'   CD 0A1D'              	CALL	ATEOF
  11D1'   D2 1232'              	JNC	OPMID
  11D4'   CD 0E2C'              	CALL	ONFST		; deleted to the end of the file: onto the new
  11D7'   CA 1232'              	JZ	OPMID		;   last line, if there is one -- and the pager
  11DA'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  11DD'   CD 0000*              	CALL	SETBWD
  11E0'   C3 1232'              	JMP	OPMID
  11E3'                         OPG_PG:
  11E3'   7A                    	MOV	A,D
  11E4'   B3                    	ORA	E
  11E5'   C2 11FE'              	JNZ	OPG_DL
  11E8'   CD 0A1D'              	CALL	ATEOF		; nothing held past the cursor
  11EB'   21 0000               	LXI	H,0
  11EE'   DA 11BC'              	JC	OPG_FN		; ... and no more to come: the file ran out
  11F1'   2B                    	DCX	H
  11F2'   CD 0000*              	CALL	SETC0
  11F5'   CD 0000*              	CALL	GOLINE
  11F8'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  11FB'   C3 11A2'              	JMP	OPG_NX
  11FE'                         OPG_DL:
  11FE'   D5                    	PUSH	D
  11FF'   21 FFFF               	LXI	H,0FFFFH
  1202'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1205'   E1                    	POP	H
  1206'   E5                    	PUSH	H
  1207'   CD 0000*              	CALL	DELFWD
  120A'   D1                    	POP	D
  120B'   06 00                 	MVI	B,0
  120D'   2A 2A11'              	LHLD	OPTOGO
  1210'   3A 2A13'              	LDA	OPTOGO+2
  1213'   CD 0EEF'              	CALL	SUB24
  1216'   C3 119C'              	JMP	OPG_SV
  1219'                         OPG_NO:
  1219'   0E 07                 	MVI	C,BEL
  121B'   CD 0000*              	CALL	BCONOU
  121E'                         OPG_HM:				; the cursor back where the command found it
  121E'   21 2A08'              	LXI	H,OPSFP
  1221'   CD 0402'              	CALL	MKLOAD
  1224'   CD 03CF'              	CALL	MKPAGE
  1227'   CD 0000*              	CALL	GOTO
  122A'   AF                    	XRA	A
  122B'   32 2A00'              	STA	PSAVE
  122E'   3C                    	INR	A
  122F'   32 2A63'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  1232'                         OPMID:
  1232'   CD 0F1C'              	CALL	ZSAVE
  1235'   C3 0FFF'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  1238'                         ONWHIT:
  1238'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  123B'   CA 1257'              	JZ	OW_YES
  123E'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  1241'   FE 20                 	CPI	' '
  1243'   CA 1257'              	JZ	OW_YES
  1246'   FE 09                 	CPI	TAB
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1248'   CA 1257'              	JZ	OW_YES
  124B'   FE 0D                 	CPI	CR
  124D'   CA 1257'              	JZ	OW_YES
  1250'   FE 0A                 	CPI	LF
  1252'   CA 1257'              	JZ	OW_YES
  1255'   B7                    	ORA	A		; a char to change: CY clear
  1256'   C9                    	RET
  1257'                         OW_YES:
  1257'   37                    	STC
  1258'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  1259'                         OPLINE:
  1259'   3A 2A00'              	LDA	PSAVE
  125C'   FE 63                 	CPI	'c'
  125E'   CA 075A'              	JZ	SETMOV
  1261'   FE 79                 	CPI	'y'
  1263'   CA 1763'              	JZ	VY_YY
  1266'   21 2A08'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1269'   CD 044F'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  126C'   C3 16DC'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  126F'                         OPCLS:
  126F'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  1271'   CA 127E'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  1274'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  1276'   C2 1292'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1279'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  127B'   C3 1280'              	JMP	OPC_FK
  127E'                         OPC_SEM:
  127E'   06 00                 	MVI	B,0		; ';' runs it as it stands
  1280'                         OPC_FK:
  1280'   3A 2A59'              	LDA	FNDKND
  1283'   B7                    	ORA	A
  1284'   37                    	STC
  1285'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1286'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1287'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1289'   CA 1290'              	JZ	OPC_EXC
  128C'   3E 01                 	MVI	A,1
  128E'   B7                    	ORA	A		; CY clear: a motion, class 1
  128F'   C9                    	RET
  1290'                         OPC_EXC:
  1290'   AF                    	XRA	A		; class 0, CY clear
  1291'   C9                    	RET
  1292'                         OPC_TB:
  1292'   47                    	MOV	B,A
  1293'   21 1434'              	LXI	H,OPCTAB
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  1296'                         OPC_LP:
  1296'   7E                    	MOV	A,M
  1297'   B7                    	ORA	A
  1298'   CA 12A8'              	JZ	OPC_MS		; end of table -> not a motion
  129B'   B8                    	CMP	B
  129C'   CA 12A4'              	JZ	OPC_HT
  129F'   23                    	INX	H
  12A0'   23                    	INX	H
  12A1'   C3 1296'              	JMP	OPC_LP
  12A4'                         OPC_HT:
  12A4'   23                    	INX	H
  12A5'   7E                    	MOV	A,M		; class byte
  12A6'   B7                    	ORA	A		; clear CY
  12A7'   C9                    	RET
  12A8'                         OPC_MS:
  12A8'   37                    	STC
  12A9'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  12AA'                         OPAPPL:
  12AA'   3A 2A02'              	LDA	OPCLSV
  12AD'   FE 02                 	CPI	2
  12AF'   CA 1418'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  12B2'   2A 2A04'              	LHLD	OPSTA
  12B5'   EB                    	XCHG			; DE = start
  12B6'   2A 2A06'              	LHLD	OPEND2		; HL = end
  12B9'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  12BC'   DA 12CC'              	JC	OPA_F
  12BF'   CA 12CC'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  12C2'   22 2A14'              	SHLD	OPLO
  12C5'   EB                    	XCHG
  12C6'   22 2A16'              	SHLD	OPHI
  12C9'   C3 133D'              	JMP	OPA_C1
  12CC'                         OPA_F:
  12CC'   EB                    	XCHG			; HL = start, DE = end
  12CD'   22 2A14'              	SHLD	OPLO
  12D0'   EB                    	XCHG			; HL = end
  12D1'   3A 2A02'              	LDA	OPCLSV
  12D4'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  12D6'   CA 133A'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  12D9'   FE 01                 	CPI	1
  12DB'   C2 1307'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end).
                                	;    'cw' stops at the content end of the line it STARTED on, where a
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


                                	;    plain 'ce' (and 'de') runs on into the next line's word and 'd%'
                                	;    crosses to its mate -- all four recorded from vim 9.1.  vim's 'cw'
                                	;    is not simply 'ce': the rewrite keeps 'w's own end-of-line stop, so
                                	;    that clamp hangs off CWEOL (the rewrite) and not off the class. ---
  12DE'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  12DF'   22 2A16'              	SHLD	OPHI		; park it: CEND clobbers DE
  12E2'   2B                    	DCX	H		; the line it landed on ...
  12E3'   3A 2A03'              	LDA	CWEOL
  12E6'   B7                    	ORA	A
  12E7'   CA 12ED'              	JZ	OPA_LE
  12EA'   2A 2A14'              	LHLD	OPLO		; ... or, for 'cw', the one it started on
  12ED'                         OPA_LE:
  12ED'   CD 14BE'              	CALL	CEND		; HL = that line's content end
  12F0'   EB                    	XCHG			; DE = it
  12F1'   2A 2A16'              	LHLD	OPHI		; HL = hi
  12F4'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  12F7'   D2 132B'              	JNC	OPA_HI		; hi is inside the line: keep it
  12FA'   2A 2A14'              	LHLD	OPLO
  12FD'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1300'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  1303'   EB                    	XCHG			; HL = the content end: the span stops there
  1304'   C3 132B'              	JMP	OPA_HI
  1307'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  1307'   22 2A16'              	SHLD	OPHI		; the motion's own end, for now
  130A'   2A 2A14'              	LHLD	OPLO
  130D'   CD 14BE'              	CALL	CEND		; HL = the start line's content end
  1310'   EB                    	XCHG			; DE = that content end
  1311'   3A 29E1'              	LDA	WPULL		; the motion landed on a line's end and was
  1314'   B7                    	ORA	A		;   pulled back onto its last char (the command
  1315'   C2 1321'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  1318'   2A 2A16'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  131B'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  131E'   D2 132E'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  1321'                         OPA_CE:				;   deletes the word, not all but its last char
  1321'   2A 2A14'              	LHLD	OPLO
  1324'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1327'   CA 13CA'              	JZ	OPA_LN
  132A'   EB                    	XCHG			; HL = the content end
  132B'                         OPA_HI:
  132B'   22 2A16'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  132E'                         OPA_DO:
  132E'   CD 13B0'              	CALL	OPDSPN
  1331'   3A 2A00'              	LDA	PSAVE
  1334'   FE 63                 	CPI	'c'
  1336'   C8                    	RZ
  1337'   C3 14CF'              	JMP	CLAMPE
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  133A'                         OPA_JP:
  133A'   22 2A16'              	SHLD	OPHI
  133D'                         OPA_C1:
  133D'   CD 13A5'              	CALL	OPSPNL
  1340'   7C                    	MOV	A,H
  1341'   B5                    	ORA	L
  1342'   CA 132E'              	JZ	OPA_DO		; nothing spanned
  1345'   2A 2A16'              	LHLD	OPHI
  1348'   CD 05E4'              	CALL	BOL
  134B'   EB                    	XCHG
  134C'   2A 2A16'              	LHLD	OPHI
  134F'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  1352'   C2 132E'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  1355'   2A 2A14'              	LHLD	OPLO
  1358'   CD 05E4'              	CALL	BOL
  135B'                         C1_LP:
  135B'   E5                    	PUSH	H
  135C'   EB                    	XCHG
  135D'   2A 2A14'              	LHLD	OPLO
  1360'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  1363'   E1                    	POP	H
  1364'   CA 1384'              	JZ	C1_LW		; only blanks before lo: whole lines
  1367'   E5                    	PUSH	H
  1368'   CD 0000*              	CALL	CHARAT
  136B'   E1                    	POP	H
  136C'   23                    	INX	H
  136D'   FE 20                 	CPI	' '
  136F'   CA 135B'              	JZ	C1_LP
  1372'   FE 09                 	CPI	TAB
  1374'   CA 135B'              	JZ	C1_LP
  1377'                         C1_CH:
  1377'   2A 2A16'              	LHLD	OPHI		; back over the line break to the content end
  137A'   2B                    	DCX	H		;   of the line before
  137B'   CD 14BE'              	CALL	CEND
  137E'   22 2A16'              	SHLD	OPHI
  1381'   C3 132E'              	JMP	OPA_DO
  1384'                         C1_LW:
  1384'   2A 2A14'              	LHLD	OPLO
  1387'   CD 05E4'              	CALL	BOL
  138A'   22 2A14'              	SHLD	OPLO
  138D'   3A 2A00'              	LDA	PSAVE
  1390'   FE 63                 	CPI	'c'
  1392'   CA 1377'              	JZ	C1_CH
  1395'   C3 141B'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


                                ; offset) stops short of it, and takes none.
  1398'                         SPNBRK:
  1398'   2A 2A14'              	LHLD	OPLO
  139B'   CD 05F7'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  139E'   EB                    	XCHG			; DE = it
  139F'   2A 2A16'              	LHLD	OPHI
  13A2'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  13A5'                         OPSPNL:
  13A5'   2A 2A16'              	LHLD	OPHI
  13A8'   EB                    	XCHG
  13A9'   2A 2A14'              	LHLD	OPLO
  13AC'   EB                    	XCHG			; HL = hi, DE = lo
  13AD'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  13B0'                         OPDSPN:
  13B0'   CD 1398'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  13B3'   F5                    	PUSH	PSW
  13B4'   2A 2A14'              	LHLD	OPLO
  13B7'   CD 0000*              	CALL	GOTO
  13BA'   CD 13A5'              	CALL	OPSPNL		; HL = hi - lo
  13BD'   CD 0000*              	CALL	DELFWD
  13C0'   CD 018C'              	CALL	MARKMOD
  13C3'   F1                    	POP	PSW
  13C4'   DA 077B'              	JC	SETFUL		; a break went: every row below it moved up
  13C7'   C3 0760'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  13CA'                         OPA_LN:
  13CA'   3A 2A00'              	LDA	PSAVE
  13CD'   FE 63                 	CPI	'c'
  13CF'   C2 13D8'              	JNZ	OPA_LD
  13D2'   2A 2A14'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  13D5'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  13D8'                         OPA_LD:
  13D8'   2A 2A14'              	LHLD	OPLO
  13DB'   22 2A04'              	SHLD	OPSTA
  13DE'   22 2A06'              	SHLD	OPEND2
  13E1'   C3 1418'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  13E4'                         OPALSP:
  13E4'   2A 2A04'              	LHLD	OPSTA
  13E7'   EB                    	XCHG
  13E8'   2A 2A06'              	LHLD	OPEND2
  13EB'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  13EE'   DA 13FB'              	JC	OPAL_F
  13F1'   22 2A14'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  13F4'   EB                    	XCHG
  13F5'   22 2A16'              	SHLD	OPHI		; hi-src = start
  13F8'   C3 1405'              	JMP	OPAL_R
  13FB'                         OPAL_F:
  13FB'   EB                    	XCHG			; HL = start
  13FC'   22 2A14'              	SHLD	OPLO		; lo-src = start
  13FF'   2A 2A06'              	LHLD	OPEND2
  1402'   22 2A16'              	SHLD	OPHI		; hi-src = end
  1405'                         OPAL_R:
  1405'   2A 2A14'              	LHLD	OPLO
  1408'   CD 05E4'              	CALL	BOL
  140B'   22 2A14'              	SHLD	OPLO		; lo = BOL(low line)
  140E'   2A 2A16'              	LHLD	OPHI
  1411'   CD 0614'              	CALL	NLSTART
  1414'   22 2A16'              	SHLD	OPHI		; hi = start of line past the high line
  1417'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  1418'                         OPALIN:
  1418'   CD 13E4'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  141B'                         OPDLIN:
  141B'   CD 13B0'              	CALL	OPDSPN
  141E'   CD 0667'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1421'   DA 1431'              	JC	OPDL_NB
  1424'   CD 0000*              	CALL	LOGLEN
  1427'   7C                    	MOV	A,H
  1428'   B5                    	ORA	L
  1429'   C8                    	RZ			; empty buffer
  142A'   2B                    	DCX	H
  142B'   CD 05E4'              	CALL	BOL
  142E'   CD 0000*              	CALL	GOTO
  1431'                         OPDL_NB:
  1431'   C3 0834'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1434'                         OPCTAB:
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  1434'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1438'   62 00 42 00           
  143C'   68 00 6C 00           
  1440'   30 00 5E 00           
  1444'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1446'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  144A'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  144E'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1452'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1456'   24 01                 
  1458'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  145C'   47 02 48 02           
  1460'   4D 02 4C 02           
  1464'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  1466'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1468'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1469'                         VCB_C:
  1469'   CD 1475'              	CALL	VCB_CD
  146C'   C3 1540'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  146F'                         VCB_D:
  146F'   CD 1475'              	CALL	VCB_CD
  1472'   C3 14CF'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  1475'                         VCB_CD:
  1475'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1478'   22 2A14'              	SHLD	OPLO
  147B'   CD 0000*              	CALL	CUROFF
  147E'   CD 14BE'              	CALL	CEND		; to the line's content end, the CR,LF left
  1481'   22 2A16'              	SHLD	OPHI
  1484'   C3 13B0'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  1487'                         VC_X:
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  1487'   CD 08E6'              	CALL	GLSTAL
  148A'   CD 0760'              	CALL	SETLIN
  148D'   CD 068B'              	CALL	GETCNT
  1490'   22 2A18'              	SHLD	CNTV
  1493'   CD 0000*              	CALL	CUROFF
  1496'   22 2A1C'              	SHLD	WKI		; cur
  1499'   CD 14BE'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  149C'   EB                    	XCHG			; DE = contentend
  149D'   2A 2A1C'              	LHLD	WKI		; HL = cur
  14A0'   EB                    	XCHG			; HL = contentend, DE = cur
  14A1'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  14A4'   7C                    	MOV	A,H
  14A5'   B5                    	ORA	L
  14A6'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  14A7'   EB                    	XCHG			; DE = available
  14A8'   2A 2A18'              	LHLD	CNTV		; HL = count
  14AB'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  14AE'   DA 14B4'              	JC	VX_USEA
  14B1'   C3 14B5'              	JMP	VX_DEL		; count <= available -> HL = count = del
  14B4'                         VX_USEA:
  14B4'   EB                    	XCHG			; HL = available
  14B5'                         VX_DEL:
  14B5'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  14B8'   CD 018C'              	CALL	MARKMOD
  14BB'   C3 14CF'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  14BE'                         CEND:
  14BE'   CD 05F7'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  14C1'   7C                    	MOV	A,H
  14C2'   B5                    	ORA	L
  14C3'   C8                    	RZ			; the start of the text: nothing before it
  14C4'   2B                    	DCX	H
  14C5'   E5                    	PUSH	H
  14C6'   CD 0000*              	CALL	CHARAT
  14C9'   E1                    	POP	H		; HL = term-1
  14CA'   FE 0D                 	CPI	CR
  14CC'   C8                    	RZ			; a CR before the LF -> the content ends there
  14CD'   23                    	INX	H
  14CE'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  14CF'                         CLAMPE:
  14CF'   CD 0000*              	CALL	CUROFF
  14D2'   E5                    	PUSH	H
  14D3'   CD 0623'              	CALL	EOLC
  14D6'   D1                    	POP	D		; DE = cur
  14D7'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  14DA'   D8                    	RC
  14DB'   C8                    	RZ
  14DC'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  14DF'                         VC_I:
  14DF'   CD 068B'              	CALL	GETCNT
  14E2'   C3 153D'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  14E5'                         VC_A:
  14E5'   CD 068B'              	CALL	GETCNT
  14E8'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  14EB'   CA 1502'              	JZ	VA_INS
  14EE'   EB                    	XCHG			; HL = cur
  14EF'   E5                    	PUSH	H
  14F0'   CD 0000*              	CALL	CHARAT
  14F3'   E1                    	POP	H
  14F4'   FE 0A                 	CPI	LF
  14F6'   CA 1502'              	JZ	VA_INS		; on the line terminator -> append in place
  14F9'   FE 0D                 	CPI	CR
  14FB'   CA 1502'              	JZ	VA_INS
  14FE'   23                    	INX	H
  14FF'   CD 0000*              	CALL	GOTO
  1502'                         VA_INS:
  1502'   C3 153D'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1505'                         VCB_A:
  1505'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1508'   CD 0623'              	CALL	EOLC		; HL = last content char (the start when empty)
  150B'   E5                    	PUSH	H
  150C'   CD 0000*              	CALL	CHARAT
  150F'   E1                    	POP	H
  1510'   FE 0D                 	CPI	CR
  1512'   CA 151B'              	JZ	VBA_IN		; an empty line: insert at its start
  1515'   FE 0A                 	CPI	LF
  1517'   CA 151B'              	JZ	VBA_IN
  151A'   23                    	INX	H		; past the last content char
  151B'                         VBA_IN:
  151B'   CD 0000*              	CALL	GOTO
  151E'   C3 153D'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1521'                         VCB_I:
  1521'   CD 068B'              	CALL	GETCNT
  1524'   CD 0834'              	CALL	FNBLNK
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  1527'   CD 0000*              	CALL	CUROFF
  152A'   E5                    	PUSH	H
  152B'   CD 0000*              	CALL	CHARAT
  152E'   E1                    	POP	H
  152F'   FE 20                 	CPI	' '
  1531'   CA 1539'              	JZ	VBI_SK
  1534'   FE 09                 	CPI	TAB
  1536'   C2 153D'              	JNZ	SETINM
  1539'                         VBI_SK:
  1539'   23                    	INX	H		; blanks only: past the last of them
  153A'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  153D'                         SETINM:
  153D'   CD 075A'              	CALL	SETMOV
  1540'                         SETINS:
  1540'   3E 01                 	MVI	A,EM_INS
  1542'   32 29D5'              	STA	EDMODE
  1545'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1546'                         ATCEND:
  1546'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1549'   C8                    	RZ
  154A'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  154D'   FE 0D                 	CPI	CR
  154F'   C8                    	RZ
  1550'   FE 0A                 	CPI	LF
  1552'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1553'                         OPNBRK:
  1553'   CD 1E45'              	CALL	PUTBRK
  1556'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1559'   23                    	INX	H
  155A'   22 0000*              	SHLD	LNDLT
  155D'   C3 018C'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1560'                         ENDBRK:
  1560'   CD 0667'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1563'   C0                    	RNZ
  1564'   CD 1553'              	CALL	OPNBRK
  1567'   CD 0000*              	CALL	CUROFF
  156A'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  156B'   2B                    	DCX	H		;   line, with its own terminator after it
  156C'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  156F'                         VC_O:
  156F'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1572'   CD 14BE'              	CALL	CEND
  1575'   CD 0000*              	CALL	GOTO
  1578'   CD 1553'              	CALL	OPNBRK
  157B'   CD 1560'              	CALL	ENDBRK		; a last line with no line end: the opened line
  157E'   CD 0766'              	CALL	SETILN		;   needs a terminator of its own to exist
  1581'   C3 1540'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1584'                         VCB_O:
  1584'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1587'   CD 05E4'              	CALL	BOL
  158A'   CD 0000*              	CALL	GOTO
  158D'   CD 1553'              	CALL	OPNBRK
  1590'   CD 0000*              	CALL	CUROFF
  1593'   2B                    	DCX	H
  1594'   2B                    	DCX	H
  1595'   CD 0000*              	CALL	GOTO
  1598'   CD 0766'              	CALL	SETILN
  159B'   C3 1540'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  159E'                         VCB_J:
  159E'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15A1'   CD 14BE'              	CALL	CEND		; the join point: this line's content end
  15A4'   22 2A14'              	SHLD	OPLO
  15A7'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  15AA'   CD 0614'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  15AD'   E5                    	PUSH	H
  15AE'   CD 0000*              	CALL	LOGLEN
  15B1'   D1                    	POP	D		; DE = that start
  15B2'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  15B5'   CA 075A'              	JZ	SETMOV
  15B8'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  15B9'                         VJ_WS:
  15B9'   E5                    	PUSH	H
  15BA'   CD 0000*              	CALL	LOGLEN
  15BD'   D1                    	POP	D		; DE = the scan
  15BE'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  15C1'   CA 15D8'              	JZ	VJ_DEL
  15C4'   EB                    	XCHG			; HL = the scan
  15C5'   E5                    	PUSH	H
  15C6'   CD 0000*              	CALL	CHARAT
  15C9'   E1                    	POP	H
  15CA'   FE 20                 	CPI	' '
  15CC'   CA 15D4'              	JZ	VJ_SKIP
  15CF'   FE 09                 	CPI	TAB
  15D1'   C2 15D8'              	JNZ	VJ_DEL
  15D4'                         VJ_SKIP:
  15D4'   23                    	INX	H
  15D5'   C3 15B9'              	JMP	VJ_WS
  15D8'                         VJ_DEL:
  15D8'   22 2A16'              	SHLD	OPHI
  15DB'   CD 13B0'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  15DE'   CD 0775'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  15E1'   CD 0667'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  15E4'   CA 14CF'              	JZ	CLAMPE
  15E7'   CD 0672'              	CALL	CURCHR		; the first char of what was appended
  15EA'   FE 0D                 	CPI	CR
  15EC'   CA 14CF'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  15EF'   FE 0A                 	CPI	LF
  15F1'   CA 14CF'              	JZ	CLAMPE
  15F4'   FE 29                 	CPI	')'
  15F6'   CA 14CF'              	JZ	CLAMPE		; vim puts no space before a ')'
  15F9'   CD 0000*              	CALL	CUROFF
  15FC'   7C                    	MOV	A,H
  15FD'   B5                    	ORA	L
  15FE'   CA 1614'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1601'   2B                    	DCX	H
  1602'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1605'   FE 20                 	CPI	' '
  1607'   CA 14CF'              	JZ	CLAMPE
  160A'   FE 09                 	CPI	TAB
  160C'   CA 14CF'              	JZ	CLAMPE
  160F'   FE 0A                 	CPI	LF
  1611'   CA 14CF'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1614'                         VJ_SP:
  1614'   3E 20                 	MVI	A,' '
  1616'   CD 0000*              	CALL	PUTGAP
  1619'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  161C'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  161D'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1620'                         VC_TILD:
  1620'   CD 068B'              	CALL	GETCNT
  1623'   CD 0760'              	CALL	SETLIN		; only this row changes
  1626'   CD 08E6'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1629'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  162C'   CA 075A'              	JZ	SETMOV
  162F'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  1632'   FE 0D                 	CPI	CR
  1634'   CA 075A'              	JZ	SETMOV		; the line's end: nothing to toggle
  1637'   FE 0A                 	CPI	LF
  1639'   CA 075A'              	JZ	SETMOV
  163C'   47                    	MOV	B,A
  163D'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  163F'   FE 41                 	CPI	'A'
  1641'   DA 164D'              	JC	VT_PUT		; below 'A': no case
  1644'   FE 5B                 	CPI	'Z'+1
  1646'   D2 164D'              	JNC	VT_PUT		; above 'Z': no case
  1649'   78                    	MOV	A,B
  164A'   EE 20                 	XRI	20H		; a letter: flip the case bit
  164C'   47                    	MOV	B,A
  164D'                         VT_PUT:
  164D'   78                    	MOV	A,B
  164E'   32 2A25'              	STA	VRCH		; the calls below do not preserve B
  1651'   CD 018C'              	CALL	MARKMOD
  1654'   21 0001               	LXI	H,1
  1657'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  165A'   3A 2A25'              	LDA	VRCH
  165D'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1660'   C3 14CF'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  1663'                         VC_R:
  1663'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  1666'   3E 03                 	MVI	A,PR
  1668'   32 29FD'              	STA	GPEND
  166B'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  166C'                         VR_DO:
  166C'   AF                    	XRA	A
  166D'   32 29FD'              	STA	GPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  1670'   79                    	MOV	A,C
  1671'   32 2A25'              	STA	VRCH		; the calls below do not preserve C
  1674'   CD 0760'              	CALL	SETLIN		; only this row changed
  1677'   CD 08E6'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  167A'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  167D'   CA 075A'              	JZ	SETMOV		; the end of the text: vim does nothing
  1680'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  1683'   FE 0D                 	CPI	CR
  1685'   CA 075A'              	JZ	SETMOV		; the line's end: nothing to replace
  1688'   FE 0A                 	CPI	LF
  168A'   CA 075A'              	JZ	SETMOV
  168D'   CD 018C'              	CALL	MARKMOD
  1690'   21 0001               	LXI	H,1
  1693'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1696'   3A 2A25'              	LDA	VRCH
  1699'   FE 0D                 	CPI	CR
  169B'   CA 16A8'              	JZ	VR_CR
  169E'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  16A1'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  16A4'   2B                    	DCX	H		;   out, which moves every logical offset
  16A5'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  16A8'                         VR_CR:
  16A8'   CD 1553'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  16AB'   CD 1560'              	CALL	ENDBRK		;   replaced char may have been the text's last
  16AE'   CD 0766'              	CALL	SETILN		;   row above it lost the char that was replaced,
  16B1'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  16B3'   32 29DD'              	STA	ILABOV
  16B6'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  16B7'                         VCB_R:
  16B7'   CD 068B'              	CALL	GETCNT
  16BA'   CD 075A'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  16BD'   21 0000               	LXI	H,0
  16C0'   22 2A26'              	SHLD	RPDEL		; nothing of ours to put back yet
  16C3'   22 2A28'              	SHLD	RPAPP
  16C6'   3E 02                 	MVI	A,EM_REP
  16C8'   32 29D5'              	STA	EDMODE
  16CB'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  16CC'                         VC_D:
  16CC'   3E 64                 	MVI	A,'d'
  16CE'   32 29FF'              	STA	PENDOP
  16D1'   C3 075A'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  16D4'                         VC_C:
  16D4'   3E 63                 	MVI	A,'c'
  16D6'   32 29FF'              	STA	PENDOP
  16D9'   C3 075A'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  16DC'                         VD_DD:
  16DC'   CD 08E6'              	CALL	GLSTAL
  16DF'   CD 068B'              	CALL	GETCNT
  16E2'   22 2A18'              	SHLD	CNTV
  16E5'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  16E7'   32 2A01'              	STA	DDSNG
  16EA'   2B                    	DCX	H
  16EB'   7C                    	MOV	A,H
  16EC'   B5                    	ORA	L
  16ED'   C2 16F8'              	JNZ	VDD_LS
  16F0'   3E 01                 	MVI	A,1
  16F2'   32 2A01'              	STA	DDSNG
  16F5'   C3 16FE'              	JMP	VDD_GO
  16F8'                         VDD_LS:
  16F8'   CD 089F'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  16FB'   DA 075A'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  16FE'                         VDD_GO:
  16FE'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1701'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1704'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1707'   CD 20A8'              	CALL	COPY12		;   every mark in the lines has closed up by then
  170A'   CD 081D'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  170D'   2A 2A18'              	LHLD	CNTV
  1710'   CD 0000*              	CALL	SETC0
  1713'                         VDD_FW:
  1713'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1716'   DA 1864'              	JC	QREFUS		; ... which has no room for them
  1719'   CD 06A0'              	CALL	CNTTST
  171C'   C2 1713'              	JNZ	VDD_FW
  171F'   CD 018C'              	CALL	MARKMOD
  1722'   CD 0A1D'              	CALL	ATEOF
  1725'   D2 1740'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1728'   3E 00                 	MVI	A,0
  172A'   32 2A01'              	STA	DDSNG		; deleted to the end: full repaint
  172D'   CD 0E2C'              	CALL	ONFST
  1730'   CA 0834'              	JZ	FNBLNK		; nothing left before it
  1733'   21 0001               	LXI	H,1		; onto the new last line
  1736'   CD 0000*              	CALL	SETBWD
  1739'   2A 0000*              	LHLD	LNDLT
  173C'   2B                    	DCX	H
  173D'   22 0000*              	SHLD	LNDLT
  1740'                         VDD_UP:
  1740'   CD 0834'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


                                	;    DL + a bottom redraw. ---
  1743'   3A 2A01'              	LDA	DDSNG
  1746'   B7                    	ORA	A
  1747'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1748'   3E 03                 	MVI	A,R_DLIN
  174A'   32 29DA'              	STA	RINTENT
  174D'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  174E'                         QEMPTY:
  174E'   2A 0000*              	LHLD	QBEG
  1751'   EB                    	XCHG
  1752'   2A 0000*              	LHLD	QEND
  1755'   7C                    	MOV	A,H
  1756'   BA                    	CMP	D
  1757'   C0                    	RNZ
  1758'   7D                    	MOV	A,L
  1759'   BB                    	CMP	E
  175A'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  175B'                         VC_Y:
  175B'   3E 79                 	MVI	A,'y'
  175D'   32 29FF'              	STA	PENDOP
  1760'   C3 075A'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1763'                         VY_YY:
  1763'   21 2A08'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1766'   CD 044F'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1769'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  176C'   22 2A49'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  176F'   CD 05E4'              	CALL	BOL
  1772'   22 2A4B'              	SHLD	YPT		; where the lines come from, to put them back
  1775'   CD 18CA'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1778'   CD 190D'              	CALL	YNCOPY		; copied where they lie, if that can be done
  177B'   D2 18D1'              	JNC	YNDONE
  177E'   21 16DC'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1781'   C3 17AD'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1784'                         OPYANK:
  1784'   CD 13E4'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1787'   2A 2A04'              	LHLD	OPSTA
  178A'   EB                    	XCHG			; DE = start
  178B'   2A 2A06'              	LHLD	OPEND2		; HL = end
  178E'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1791'   D2 1795'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1794'   EB                    	XCHG			; ... otherwise the start is
  1795'                         OPY_LO:
  1795'   22 2A49'              	SHLD	YOFF
  1798'   2A 2A14'              	LHLD	OPLO
  179B'   22 2A4B'              	SHLD	YPT		; where the lines come from, to put them back
  179E'   CD 18CA'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  17A1'   CD 1985'              	CALL	YNSPAN		; copied where they lie, if there is room
  17A4'   D2 18D1'              	JNC	YNDONE
  17A7'   21 188B'              	LXI	H,YSPAN
  17AA'   C3 17AD'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  17AD'                         YKGO:
  17AD'   22 2A72'              	SHLD	YACT
  17B0'   2A 2A4B'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  17B3'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  17B4'   2A 2A49'              	LHLD	YOFF		;   survive this -- the put-back below can page
  17B7'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  17BA'   22 2A78'              	SHLD	YCOL		;   them -- but a distance within the lines does
  17BD'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  17C0'   E5                    	PUSH	H		;   pages the window on when the count's lines
  17C1'   2A 2A4B'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  17C4'   EB                    	XCHG			;   window as it was, then names other text
  17C5'   E1                    	POP	H
  17C6'   CD 0000*              	CALL	SUBHD
  17C9'   EB                    	XCHG			; DE = how far behind the cursor they start
  17CA'   CD 0EF9'              	CALL	CURFP
  17CD'   06 00                 	MVI	B,0
  17CF'   CD 0EEF'              	CALL	SUB24
  17D2'   22 2A7A'              	SHLD	YPFP
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  17D5'   32 2A7C'              	STA	YPFP+2
  17D8'   3A 29D9'              	LDA	MODF
  17DB'   32 2A46'              	STA	YMODF
  17DE'   3A 29F2'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  17E1'   32 2A47'              	STA	YDCHG		;   a yank must not become the last change
  17E4'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  17E7'   32 2A48'              	STA	YURPL		;   back are not a change to undo either
  17EA'   3E 01                 	MVI	A,1
  17EC'   32 0000*              	STA	UNDRPL
  17EF'   32 2A71'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  17F2'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  17F5'   22 2A54'              	SHLD	YLDLT
  17F8'   CD 0000*              	CALL	LOGLEN
  17FB'   22 2A76'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  17FE'   2A 2A72'              	LHLD	YACT
  1801'   CD 1863'              	CALL	YCALL		; the lines out of the file, into the register
  1804'   3A 2A41'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1807'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1809'   CA 1847'              	JZ	YK_RF		;   cursor: only the flags are still owed
  180C'   CD 0000*              	CALL	LOGLEN
  180F'   EB                    	XCHG
  1810'   2A 2A76'              	LHLD	YWAS
  1813'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1816'   CA 1828'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1819'   21 2A7A'              	LXI	H,YPFP		; back to where they came from, by its place in
  181C'   CD 0402'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  181F'   CD 03CF'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1822'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1825'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1828'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1828'   2A 2A7A'              	LHLD	YPFP		;   cursor is still owed its place)
  182B'   EB                    	XCHG
  182C'   2A 2A78'              	LHLD	YCOL
  182F'   19                    	DAD	D
  1830'   22 2A6D'              	SHLD	MKPOS
  1833'   3A 2A7C'              	LDA	YPFP+2
  1836'   CE 00                 	ACI	0
  1838'   32 2A6F'              	STA	MKPOS+2
  183B'   CD 03CF'              	CALL	MKPAGE
  183E'   CD 0000*              	CALL	GOTO
  1841'                         YK_RST:
  1841'   2A 2A54'              	LHLD	YLDLT
  1844'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  1847'                         YK_RF:
  1847'   3A 2A46'              	LDA	YMODF
  184A'   32 29D9'              	STA	MODF
  184D'   3A 2A47'              	LDA	YDCHG
  1850'   32 29F2'              	STA	DOTCHG
  1853'   3A 2A48'              	LDA	YURPL
  1856'   32 0000*              	STA	UNDRPL
  1859'   AF                    	XRA	A
  185A'   32 2A71'              	STA	MKHOLD
  185D'   CD 08E6'              	CALL	GLSTAL
  1860'   C3 077B'              	JMP	SETFUL		; the cheap paint cannot carry this
  1863'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1864'                         QREFUS:
  1864'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1867'   CD 174E'              	CALL	QEMPTY
  186A'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  186D'   CD 0000*              	CALL	QKILL
  1870'   3A 2A71'              	LDA	MKHOLD
  1873'   B7                    	ORA	A
  1874'   C2 1883'              	JNZ	QRF_Y
  1877'   21 0000*              	LXI	H,MKSAV
  187A'   11 0000*              	LXI	D,MKTAB
  187D'   CD 20A8'              	CALL	COPY12
  1880'   CD 0000*              	CALL	UNDCLR
  1883'                         QRF_Y:
  1883'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1885'   32 2A41'              	STA	MSGWHT
  1888'   C3 121E'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  188B'                         YSPAN:
  188B'   CD 08E6'              	CALL	GLSTAL
  188E'   CD 13A5'              	CALL	OPSPNL		; HL = the span's length
  1891'   22 2A74'              	SHLD	YTGT
  1894'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  1897'   EB                    	XCHG			; DE = it
  1898'   2A 2A74'              	LHLD	YTGT
  189B'   EB                    	XCHG			; HL = the text's, DE = the span's
  189C'   CD 0000*              	CALL	SUBHD
  189F'   22 2A74'              	SHLD	YTGT		; what the text is left at when the span is out
  18A2'   2A 2A14'              	LHLD	OPLO
  18A5'   CD 0000*              	CALL	GOTO
  18A8'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  18AB'                         YS_LP:
  18AB'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  18AE'   CD 0000*              	CALL	SETC0
  18B1'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  18B4'   DA 1864'              	JC	QREFUS		; ... which has no room for it
  18B7'   CD 0000*              	CALL	LOGLEN
  18BA'   EB                    	XCHG			; DE = what is left
  18BB'   2A 2A74'              	LHLD	YTGT
  18BE'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  18C1'   DA 18C7'              	JC	YS_END		; below it -- cannot happen over whole lines,
  18C4'   C2 18AB'              	JNZ	YS_LP		;   but never spin here if it ever did
  18C7'                         YS_END:
  18C7'   C3 018C'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  18CA'                         YNPRE:
  18CA'   2A 0000*              	LHLD	PGTOPM
  18CD'   22 2A7D'              	SHLD	YNPG
  18D0'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  18D1'                         YNDONE:
  18D1'   2A 2A49'              	LHLD	YOFF
  18D4'   CD 0000*              	CALL	GOTO
  18D7'   2A 0000*              	LHLD	PGTOPM
  18DA'   EB                    	XCHG
  18DB'   2A 2A7D'              	LHLD	YNPG
  18DE'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  18E1'   C2 077B'              	JNZ	SETFUL		; it moved under us: repaint after all
  18E4'   C3 075A'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  18E7'                         YNROOM:
  18E7'   11 0100               	LXI	D,100H
  18EA'   19                    	DAD	D
  18EB'   D8                    	RC			; within a chunk of 64K: no arena holds that
  18EC'   E5                    	PUSH	H		; the span plus its slack
  18ED'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  18F0'   EB                    	XCHG			; HL = free
  18F1'   D1                    	POP	D		; DE = the span plus its slack
  18F2'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  18F5'   DA 18FD'              	JC	YNR_OK
  18F8'   CA 18FD'              	JZ	YNR_OK
  18FB'   37                    	STC			; not enough: the delete-and-put-back path
  18FC'   C9                    	RET
  18FD'                         YNR_OK:
  18FD'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  18FE'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  18FF'                         YNGO:
  18FF'   C5                    	PUSH	B
  1900'   CD 068B'              	CALL	GETCNT		; spent here: this yank is happening
  1903'   CD 08E6'              	CALL	GLSTAL
  1906'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1909'   C1                    	POP	B
  190A'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  190D'                         YNCOPY:
  190D'   2A 29D6'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1910'   7C                    	MOV	A,H		;   the count itself
  1911'   B5                    	ORA	L
  1912'   C2 1918'              	JNZ	YNC_HV
  1915'   21 0001               	LXI	H,1
  1918'                         YNC_HV:
  1918'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1919'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  191A'   B4                    	ORA	H
  191B'   CA 1926'              	JZ	YNC_M
  191E'   E5                    	PUSH	H
  191F'   CD 089F'              	CALL	ONLAST		; vim: a count over one on the last line does
  1922'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1923'   DA 1938'              	JC	YNC_RF
  1926'                         YNC_M:
  1926'   E5                    	PUSH	H
  1927'   CD 081D'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  192A'   E1                    	POP	H
  192B'   CD 1940'              	CALL	YNLINE		; BC = the span, measured where it stands
  192E'   D8                    	RC			; not measurable here: let the pager answer it
  192F'   60                    	MOV	H,B
  1930'   69                    	MOV	L,C
  1931'   CD 18E7'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1934'   D8                    	RC			; no: the delete-and-put-back path
  1935'   C3 18FF'              	JMP	YNGO
  1938'                         YNC_RF:
  1938'   CD 068B'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  193B'   CD 08E6'              	CALL	GLSTAL		;   register alone, and that is the command
  193E'   B7                    	ORA	A		; NC: done
  193F'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1940'                         YNLINE:
  1940'   22 2A7F'              	SHLD	YNCNT		; the lines it still wants
  1943'   2A 0000*              	LHLD	GAPEND
  1946'                         YNL_LP:
  1946'   EB                    	XCHG			; DE = the scan
  1947'   2A 0000*              	LHLD	TXTEND
  194A'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  194D'   EB                    	XCHG			; HL = the scan
  194E'   D2 196E'              	JNC	YNL_EN		; the resident text ran out
  1951'   7E                    	MOV	A,M
  1952'   23                    	INX	H
  1953'   FE 0A                 	CPI	LF
  1955'   C2 1946'              	JNZ	YNL_LP
  1958'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  1959'   2A 2A7F'              	LHLD	YNCNT
  195C'   2B                    	DCX	H
  195D'   22 2A7F'              	SHLD	YNCNT
  1960'   7C                    	MOV	A,H
  1961'   B5                    	ORA	L
  1962'   E1                    	POP	H
  1963'   C2 1946'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1966'   EB                    	XCHG			; DE = past the last of them
  1967'   2A 0000*              	LHLD	GAPEND
  196A'   EB                    	XCHG			; HL = past them, DE = GAPEND
  196B'   C3 197C'              	JMP	YNL_BC
  196E'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  196E'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1971'   C2 1983'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1974'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1977'   EB                    	XCHG			;   count clamps to it as vim's does
  1978'   2A 0000*              	LHLD	GAPEND
  197B'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  197C'                         YNL_BC:
  197C'   CD 0000*              	CALL	SUBHD		; HL = the span
  197F'   44                    	MOV	B,H
  1980'   4D                    	MOV	C,L
  1981'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1982'   C9                    	RET
  1983'                         YNL_NO:
  1983'   37                    	STC
  1984'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1985'                         YNSPAN:
  1985'   CD 13A5'              	CALL	OPSPNL		; HL = the span's length
  1988'   44                    	MOV	B,H
  1989'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  198A'   CD 18E7'              	CALL	YNROOM
  198D'   D8                    	RC			; no room: the delete-and-put-back path
  198E'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  198F'   2A 2A14'              	LHLD	OPLO
  1992'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1995'   C1                    	POP	B
  1996'   C3 18FF'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1999'                         VC_P:
  1999'   CD 174E'              	CALL	QEMPTY
  199C'   CA 1A54'              	JZ	VP_BEL
  199F'   CD 068B'              	CALL	GETCNT
  19A2'   22 2A4D'              	SHLD	PCNT
  19A5'   CD 0000*              	CALL	CUROFF
  19A8'   CD 0614'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  19AB'   C3 19C0'              	JMP	VP_GO
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  19AE'                         VCB_P:
  19AE'   CD 174E'              	CALL	QEMPTY
  19B1'   CA 1A54'              	JZ	VP_BEL
  19B4'   CD 068B'              	CALL	GETCNT
  19B7'   22 2A4D'              	SHLD	PCNT
  19BA'   CD 0000*              	CALL	CUROFF
  19BD'   CD 05E4'              	CALL	BOL
  19C0'                         VP_GO:
  19C0'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  19C3'   CD 0000*              	CALL	CUROFF
  19C6'   EB                    	XCHG
  19C7'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  19CA'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  19CD'   DA 19E2'              	JC	VP_IN
  19D0'   EB                    	XCHG			; HL = the put point = LOGLEN
  19D1'   7C                    	MOV	A,H
  19D2'   B5                    	ORA	L
  19D3'   CA 19DF'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  19D6'   2B                    	DCX	H
  19D7'   CD 0000*              	CALL	CHARAT
  19DA'   FE 0A                 	CPI	LF
  19DC'   CA 19E2'              	JZ	VP_IN
  19DF'                         VP_BRK:
  19DF'   CD 1553'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  19E2'                         VP_IN:
  19E2'   CD 0000*              	CALL	CUROFF
  19E5'   22 2A4F'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  19E8'   2A 0000*              	LHLD	QBEG
  19EB'   EB                    	XCHG
  19EC'   2A 0000*              	LHLD	QEND
  19EF'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  19F2'   EB                    	XCHG
  19F3'   22 2A51'              	SHLD	PLFS
  19F6'   2A 2A4D'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  19F9'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  19FA'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  19FB'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  19FD'   C2 1A01'              	JNZ	VP_PZ
  1A00'   7D                    	MOV	A,L
  1A01'                         VP_PZ:
  1A01'   32 2A53'              	STA	PCPY
  1A04'                         VP_LP:
  1A04'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1A07'   2A 0000*              	LHLD	LNDLT
  1A0A'   EB                    	XCHG
  1A0B'   2A 2A51'              	LHLD	PLFS
  1A0E'   19                    	DAD	D
  1A0F'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A12'   2A 2A4D'              	LHLD	PCNT
  1A15'   2B                    	DCX	H
  1A16'   22 2A4D'              	SHLD	PCNT
  1A19'   7C                    	MOV	A,H
  1A1A'   B5                    	ORA	L
  1A1B'   C2 1A04'              	JNZ	VP_LP
  1A1E'   CD 018C'              	CALL	MARKMOD
  1A21'   2A 2A4F'              	LHLD	PPT
  1A24'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1A27'   CD 08E6'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1A2A'   3A 2A53'              	LDA	PCPY
  1A2D'   B7                    	ORA	A
  1A2E'   CA 0834'              	JZ	FNBLNK
  1A31'   2A 2A51'              	LHLD	PLFS
  1A34'   7C                    	MOV	A,H
  1A35'   B7                    	ORA	A
  1A36'   C2 0834'              	JNZ	FNBLNK
  1A39'   3A 2A53'              	LDA	PCPY
  1A3C'   CD 0DC2'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1A3F'   7C                    	MOV	A,H
  1A40'   B7                    	ORA	A
  1A41'   C2 0834'              	JNZ	FNBLNK
  1A44'   7D                    	MOV	A,L
  1A45'   B7                    	ORA	A
  1A46'   CA 0834'              	JZ	FNBLNK
  1A49'   F5                    	PUSH	PSW
  1A4A'   CD 0766'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1A4D'   F1                    	POP	PSW
  1A4E'   32 29DB'              	STA	ILN		; ... which the lines put now replace
  1A51'   C3 0834'              	JMP	FNBLNK
  1A54'                         VP_BEL:
  1A54'   CD 068B'              	CALL	GETCNT		; the count is spent either way
  1A57'   0E 07                 	MVI	C,BEL
  1A59'   CD 0000*              	CALL	BCONOU
  1A5C'   C3 075A'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  1A5F'                         VIREP:
  1A5F'   78                    	MOV	A,B
  1A60'   FE 01                 	CPI	KT_ACT
  1A62'   CA 1B8F'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  1A65'   FE 02                 	CPI	KT_CHAR
  1A67'   C0                    	RNZ			; ignore anything else
  1A68'   79                    	MOV	A,C
  1A69'   FE 0D                 	CPI	CR
  1A6B'   CA 1ACF'              	JZ	VP_CR
  1A6E'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1A70'   CA 1ACF'              	JZ	VP_CR
  1A73'   FE 08                 	CPI	BS
  1A75'   CA 1ADB'              	JZ	VP_BS
  1A78'   FE 7F                 	CPI	DEL
  1A7A'   CA 1ADB'              	JZ	VP_BS
  1A7D'   32 2A25'              	STA	VRCH		; the calls below do not preserve C
  1A80'   CD 0760'              	CALL	SETLIN		; this row changed
  1A83'   CD 018C'              	CALL	MARKMOD
  1A86'   CD 1546'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1A89'   CA 1AC1'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1A8C'   3A 2A25'              	LDA	VRCH
  1A8F'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1A92'   2A 2A26'              	LHLD	RPDEL
  1A95'   7C                    	MOV	A,H
  1A96'   B5                    	ORA	L
  1A97'   CA 1AAD'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1A9A'   2A 0000*              	LHLD	GAPEND
  1A9D'   EB                    	XCHG
  1A9E'   2A 2A2A'              	LHLD	RPGE
  1AA1'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1AA4'   CA 1AAD'              	JZ	VP_OVW
  1AA7'   21 0000               	LXI	H,0
  1AAA'   22 2A26'              	SHLD	RPDEL		; the text moved: those originals are gone
  1AAD'                         VP_OVW:
  1AAD'   21 0001               	LXI	H,1
  1AB0'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1AB3'   2A 0000*              	LHLD	GAPEND
  1AB6'   22 2A2A'              	SHLD	RPGE
  1AB9'   2A 2A26'              	LHLD	RPDEL
  1ABC'   23                    	INX	H
  1ABD'   22 2A26'              	SHLD	RPDEL
  1AC0'   C9                    	RET
  1AC1'                         VP_APP:
  1AC1'   3A 2A25'              	LDA	VRCH
  1AC4'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1AC7'   2A 2A28'              	LHLD	RPAPP
  1ACA'   23                    	INX	H
  1ACB'   22 2A28'              	SHLD	RPAPP
  1ACE'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1ACF'                         VP_CR:
  1ACF'   21 0000               	LXI	H,0
  1AD2'   22 2A26'              	SHLD	RPDEL		; a line break ends what BS can put back
  1AD5'   22 2A28'              	SHLD	RPAPP
  1AD8'   C3 1B65'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1ADB'                         VP_BS:
  1ADB'   2A 2A28'              	LHLD	RPAPP
  1ADE'   7C                    	MOV	A,H
  1ADF'   B5                    	ORA	L
  1AE0'   CA 1AED'              	JZ	VP_BSD
  1AE3'   2B                    	DCX	H
  1AE4'   22 2A28'              	SHLD	RPAPP		; an appended char: it just goes
  1AE7'   CD 0760'              	CALL	SETLIN
  1AEA'   C3 0000*              	JMP	DELPRV
  1AED'                         VP_BSD:
  1AED'   2A 2A26'              	LHLD	RPDEL
  1AF0'   7C                    	MOV	A,H
  1AF1'   B5                    	ORA	L
  1AF2'   CA 1B19'              	JZ	VP_BSM		; nothing of ours left
  1AF5'   2A 0000*              	LHLD	GAPEND
  1AF8'   EB                    	XCHG
  1AF9'   2A 2A2A'              	LHLD	RPGE
  1AFC'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1AFF'   C2 1B19'              	JNZ	VP_BSM
  1B02'   2A 2A26'              	LHLD	RPDEL
  1B05'   2B                    	DCX	H
  1B06'   22 2A26'              	SHLD	RPDEL
  1B09'   CD 0760'              	CALL	SETLIN
  1B0C'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1B0F'   CD 0000*              	CALL	UNDELF		; the original comes back
  1B12'   2A 0000*              	LHLD	GAPEND
  1B15'   22 2A2A'              	SHLD	RPGE
  1B18'   C9                    	RET
  1B19'                         VP_BSM:
  1B19'   CD 075A'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1B1C'   C3 07C9'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  1B1F'                         VIINS:
  1B1F'   78                    	MOV	A,B
  1B20'   FE 01                 	CPI	KT_ACT
  1B22'   CA 1B8F'              	JZ	VI_ACT
  1B25'   FE 02                 	CPI	KT_CHAR
  1B27'   C0                    	RNZ			; ignore anything else
  1B28'   79                    	MOV	A,C
  1B29'   FE 0D                 	CPI	CR
  1B2B'   CA 1B65'              	JZ	VI_CR
  1B2E'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1B30'   CA 1B65'              	JZ	VI_CR
  1B33'   FE 08                 	CPI	BS
  1B35'   CA 1B7D'              	JZ	VI_BS
  1B38'   FE 7F                 	CPI	DEL
  1B3A'   CA 1B7D'              	JZ	VI_BS
  1B3D'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1B3E'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1B41'   CD 018C'              	CALL	MARKMOD
  1B44'   CD 0760'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1B47'   79                    	MOV	A,C
  1B48'   FE 20                 	CPI	' '
  1B4A'   D8                    	RC			; control char -> keep R_LINE
  1B4B'   FE 7F                 	CPI	DEL
  1B4D'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1B4E'   CD 0781'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1B51'   B7                    	ORA	A
  1B52'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1B53'   3E 04                 	MVI	A,R_ICH
  1B55'   32 29DA'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1B58'   CD 1546'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1B5B'   3E 00                 	MVI	A,0
  1B5D'   C2 1B61'              	JNZ	VI_ICH
  1B60'   3C                    	INR	A
  1B61'                         VI_ICH:
  1B61'   32 29DC'              	STA	ICHAPP
  1B64'   C9                    	RET
  1B65'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1B65'   CD 1546'              	CALL	ATCEND
  1B68'   3E 00                 	MVI	A,0
  1B6A'   CA 1B6E'              	JZ	VI_CRS
  1B6D'   3C                    	INR	A
  1B6E'                         VI_CRS:
  1B6E'   F5                    	PUSH	PSW
  1B6F'   CD 1553'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1B72'   CD 1560'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1B75'   CD 0766'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1B78'   F1                    	POP	PSW
  1B79'   32 29DD'              	STA	ILABOV
  1B7C'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1B7D'                         VI_BS:
  1B7D'   CD 0000*              	CALL	PEEKL
  1B80'   D8                    	RC			; start of the file: nothing to delete
  1B81'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1B83'   CA 1B89'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1B86'   CD 0760'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1B89'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1B89'   CD 018C'              	CALL	MARKMOD
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1B8C'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1B8F'                         VI_ACT:
  1B8F'   79                    	MOV	A,C
  1B90'   FE 0B                 	CPI	ACT_ESC
  1B92'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  1B93'   3E 00                 	MVI	A,EM_CMD
  1B95'   32 29D5'              	STA	EDMODE
  1B98'   CD 075A'              	CALL	SETMOV
  1B9B'   CD 07C9'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1B9E'   C3 08E6'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1BA1'                         RDLINE:
  1BA1'   EB                    	XCHG			; HL = buffer
  1BA2'   22 2A2C'              	SHLD	RLPTR
  1BA5'   3E 00                 	MVI	A,0
  1BA7'   32 2A2E'              	STA	RLLEN
  1BAA'   78                    	MOV	A,B
  1BAB'   32 2A2F'              	STA	RLMAX
  1BAE'   79                    	MOV	A,C
  1BAF'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1BB2'                         RL_LP:
  1BB2'   CD 0000*              	CALL	GETKEY
  1BB5'   78                    	MOV	A,B
  1BB6'   FE 01                 	CPI	KT_ACT
  1BB8'   CA 1C0E'              	JZ	RL_ACT
  1BBB'   FE 02                 	CPI	KT_CHAR
  1BBD'   C2 1BB2'              	JNZ	RL_LP		; ignore other keys
  1BC0'   79                    	MOV	A,C
  1BC1'   FE 0D                 	CPI	CR
  1BC3'   CA 1C1F'              	JZ	RL_DONE
  1BC6'   FE 08                 	CPI	BS
  1BC8'   CA 1BF6'              	JZ	RL_BS
  1BCB'   FE 7F                 	CPI	DEL
  1BCD'   CA 1BF6'              	JZ	RL_BS
  1BD0'   FE 20                 	CPI	' '
  1BD2'   DA 1BB2'              	JC	RL_LP		; control char -> ignore
  1BD5'   3A 2A2E'              	LDA	RLLEN
  1BD8'   47                    	MOV	B,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1BD9'   3A 2A2F'              	LDA	RLMAX
  1BDC'   B8                    	CMP	B
  1BDD'   CA 1BB2'              	JZ	RL_LP		; full -> ignore
  1BE0'   2A 2A2C'              	LHLD	RLPTR
  1BE3'   71                    	MOV	M,C
  1BE4'   23                    	INX	H
  1BE5'   22 2A2C'              	SHLD	RLPTR
  1BE8'   3A 2A2E'              	LDA	RLLEN
  1BEB'   3C                    	INR	A
  1BEC'   32 2A2E'              	STA	RLLEN
  1BEF'   79                    	MOV	A,C
  1BF0'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1BF3'   C3 1BB2'              	JMP	RL_LP
  1BF6'                         RL_BS:				; WM LINEPOP
  1BF6'   3A 2A2E'              	LDA	RLLEN
  1BF9'   B7                    	ORA	A
  1BFA'   CA 1C14'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1BFD'   3D                    	DCR	A
  1BFE'   32 2A2E'              	STA	RLLEN
  1C01'   2A 2A2C'              	LHLD	RLPTR
  1C04'   2B                    	DCX	H
  1C05'   22 2A2C'              	SHLD	RLPTR
  1C08'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1C0B'   C3 1BB2'              	JMP	RL_LP
  1C0E'                         RL_ACT:
  1C0E'   79                    	MOV	A,C
  1C0F'   FE 0B                 	CPI	ACT_ESC
  1C11'   C2 1BB2'              	JNZ	RL_LP
  1C14'                         RL_CAN:
  1C14'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1C16'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1C19'   CD 0760'              	CALL	SETLIN		; redraw one row
  1C1C'   3E FF                 	MVI	A,0FFH		; cancelled
  1C1E'   C9                    	RET
  1C1F'                         RL_DONE:
  1C1F'   AF                    	XRA	A
  1C20'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1C21'                         VC_BZ:
  1C21'   CD 075A'              	CALL	SETMOV
  1C24'   3A 29FE'              	LDA	GSAVE
  1C27'   FE 02                 	CPI	PZ
  1C29'   CA 1C34'              	JZ	VZ_ZZ
  1C2C'   B7                    	ORA	A
  1C2D'   C0                    	RNZ			; 'g' was pending: vim drops both
  1C2E'   3E 02                 	MVI	A,PZ
  1C30'   32 29FD'              	STA	GPEND
  1C33'   C9                    	RET
  1C34'                         VZ_ZZ:
  1C34'   3E 04                 	MVI	A,EO_X
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1C36'   32 2A30'              	STA	EXOP
  1C39'   3E 01                 	MVI	A,1
  1C3B'   32 2A43'              	STA	EXBANG		; no '!'
  1C3E'   AF                    	XRA	A
  1C3F'   32 2A31'              	STA	EXARG		; no file name
  1C42'   3A 29D9'              	LDA	MODF		; as ':x': a changed text is written first
  1C45'   B7                    	ORA	A
  1C46'   CA 1D87'              	JZ	EX_Q
  1C49'   C3 1D21'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1C4C'                         VC_EX:
  1C4C'   CD 068B'              	CALL	GETCNT
  1C4F'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1C52'   11 0000*              	LXI	D,EXBUF
  1C55'   06 28                 	MVI	B,EXMAX
  1C57'   0E 3A                 	MVI	C,':'
  1C59'   CD 1BA1'              	CALL	RDLINE
  1C5C'   B7                    	ORA	A
  1C5D'   C0                    	RNZ			; cancelled
  1C5E'   3A 2A2E'              	LDA	RLLEN
  1C61'   5F                    	MOV	E,A
  1C62'   16 00                 	MVI	D,0
  1C64'   21 0000*              	LXI	H,EXBUF
  1C67'   19                    	DAD	D
  1C68'   36 00                 	MVI	M,0		; the line ends with a 0
  1C6A'   21 0000*              	LXI	H,EXBUF
  1C6D'   CD 223D'              	CALL	SKIPB
  1C70'   C8                    	RZ			; nothing on it
  1C71'   22 2A33'              	SHLD	EXCMD
  1C74'   CD 2431'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1C77'   CD 223D'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1C7A'   56                    	MOV	D,M
  1C7B'   23                    	INX	H
  1C7C'   1E 00                 	MVI	E,0
  1C7E'   CD 2249'              	CALL	ISLOW
  1C81'   DA 1C8C'              	JC	EX_LK
  1C84'   5F                    	MOV	E,A
  1C85'   23                    	INX	H
  1C86'   CD 2249'              	CALL	ISLOW
  1C89'   D2 1CA5'              	JNC	EX_NOT		; a third letter: none of ours
  1C8C'                         EX_LK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1C8C'   E5                    	PUSH	H
  1C8D'   21 2418'              	LXI	H,EXTAB
  1C90'                         EX_TL:
  1C90'   7E                    	MOV	A,M
  1C91'   B7                    	ORA	A
  1C92'   CA 1CA4'              	JZ	EX_NTP		; not in the table
  1C95'   23                    	INX	H
  1C96'   BA                    	CMP	D
  1C97'   7E                    	MOV	A,M
  1C98'   23                    	INX	H
  1C99'   C2 1CA0'              	JNZ	EX_TN
  1C9C'   BB                    	CMP	E
  1C9D'   CA 1CAB'              	JZ	EX_TF
  1CA0'                         EX_TN:
  1CA0'   23                    	INX	H
  1CA1'   C3 1C90'              	JMP	EX_TL
  1CA4'                         EX_NTP:
  1CA4'   E1                    	POP	H
  1CA5'                         EX_NOT:
  1CA5'   21 2301'              	LXI	H,SNOT
  1CA8'   C3 227E'              	JMP	EXERT
  1CAB'                         EX_TF:
  1CAB'   7E                    	MOV	A,M
  1CAC'   32 2A30'              	STA	EXOP
  1CAF'   E1                    	POP	H
  1CB0'   FE 06                 	CPI	EO_S
  1CB2'   CA 24A0'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1CB5'   FE 01                 	CPI	EO_W
  1CB7'   CA 1CC6'              	JZ	EX_RG		; ':N,Mw name' takes a range
  1CBA'   FE 08                 	CPI	EO_R
  1CBC'   CA 1CC6'              	JZ	EX_RG		; ... and ':Nr name' a line
  1CBF'   3A 2A8B'              	LDA	SRNGF
  1CC2'   B7                    	ORA	A
  1CC3'   C2 1CA5'              	JNZ	EX_NOT		; a range on a command that does not take one
  1CC6'                         EX_RG:
                                	;--- '!', then the file name ---
  1CC6'   7E                    	MOV	A,M
  1CC7'   D6 21                 	SUI	'!'
  1CC9'   32 2A43'              	STA	EXBANG		; 0 = '!'
  1CCC'   C2 1CD0'              	JNZ	EX_NB
  1CCF'   23                    	INX	H
  1CD0'                         EX_NB:
  1CD0'   CD 223D'              	CALL	SKIPB
  1CD3'   32 2A31'              	STA	EXARG		; 0 = no file name
  1CD6'   CA 1CEF'              	JZ	EX_RUN
  1CD9'   22 2A33'              	SHLD	EXCMD
  1CDC'   3A 2A30'              	LDA	EXOP
  1CDF'   FE 02                 	CPI	EO_Q
  1CE1'   CA 227B'              	JZ	EX_TRL		; :q takes none
  1CE4'   FE 07                 	CPI	EO_V
  1CE6'   CA 227B'              	JZ	EX_TRL		; nor :ve
  1CE9'   CD 21A7'              	CALL	PARSFN
  1CEC'   C2 226F'              	JNZ	EX_INV
  1CEF'                         EX_RUN:
  1CEF'   3A 2A30'              	LDA	EXOP
  1CF2'   FE 05                 	CPI	EO_E
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1CF4'   CA 1D9E'              	JZ	EX_E
  1CF7'   FE 02                 	CPI	EO_Q
  1CF9'   CA 1D87'              	JZ	EX_Q
  1CFC'   FE 07                 	CPI	EO_V
  1CFE'   CA 2275'              	JZ	EX_V
  1D01'   FE 08                 	CPI	EO_R
  1D03'   CA 1F2F'              	JZ	EX_R
  1D06'   FE 04                 	CPI	EO_X
  1D08'   CA 1D1A'              	JZ	EX_XM
  1D0B'   FE 01                 	CPI	EO_W
  1D0D'   C2 1D21'              	JNZ	EX_W		; :wq
  1D10'   3A 2A8B'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  1D13'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  1D14'   C2 1E4F'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  1D17'   C3 1D21'              	JMP	EX_W
  1D1A'                         EX_XM:
  1D1A'   3A 29D9'              	LDA	MODF		; :x writes only a changed text
  1D1D'   B7                    	ORA	A
  1D1E'   CA 1D87'              	JZ	EX_Q
  1D21'                         EX_W:
  1D21'   CD 200F'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1D24'   D8                    	RC			; refused (message shown)
  1D25'   32 2A32'              	STA	EXBAK
  1D28'   3A 2A30'              	LDA	EXOP
  1D2B'   FE 01                 	CPI	EO_W
  1D2D'   CA 1D44'              	JZ	EX_WK
  1D30'   3A 2A32'              	LDA	EXBAK
  1D33'   B7                    	ORA	A
  1D34'   C2 1D84'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1D37'   3A 2A43'              	LDA	EXBANG
  1D3A'   B7                    	ORA	A
  1D3B'   CA 1D84'              	JZ	EX_WQ		; so it does with '!'
  1D3E'   CD 1D44'              	CALL	EX_WK		; else it may not: keep the text
  1D41'   C3 1D87'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1D44'                         EX_WK:
  1D44'   CD 0CCE'              	CALL	CURRW		; the cursor's row and file position
  1D47'   32 2A35'              	STA	WPROW
  1D4A'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1D4D'   7D                    	MOV	A,L
  1D4E'   E6 7F                 	ANI	7FH
  1D50'   32 2A36'              	STA	WPBYT
  1D53'   7D                    	MOV	A,L
  1D54'   17                    	RAL
  1D55'   7C                    	MOV	A,H
  1D56'   17                    	RAL
  1D57'   5F                    	MOV	E,A
  1D58'   3E 00                 	MVI	A,0
  1D5A'   17                    	RAL
  1D5B'   57                    	MOV	D,A		; DE = HL / 128
  1D5C'   2A 0000*              	LHLD	OUTPOS
  1D5F'   19                    	DAD	D
  1D60'   22 2A37'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1D63'   CD 2044'              	CALL	WRITE
  1D66'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1D69'   2A 2A37'              	LHLD	WPREC
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1D6C'   EB                    	XCHG
  1D6D'   3A 2A36'              	LDA	WPBYT
  1D70'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1D73'   CD 0000*              	CALL	GOTO
  1D76'                         EX_WRW:
  1D76'   21 0000               	LXI	H,0
  1D79'   22 0000*              	SHLD	LNDLT
  1D7C'   3A 2A35'              	LDA	WPROW
  1D7F'   6F                    	MOV	L,A
  1D80'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1D83'   C9                    	RET
  1D84'                         EX_WQ:
  1D84'   CD 2044'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1D87'                         EX_Q:
  1D87'   3A 2A43'              	LDA	EXBANG
  1D8A'   B7                    	ORA	A
  1D8B'   CA 1D95'              	JZ	EX_QT
  1D8E'   3A 29D9'              	LDA	MODF
  1D91'   B7                    	ORA	A
  1D92'   C2 2263'              	JNZ	MSGNWR		; changed, no '!': stay
  1D95'                         EX_QT:
  1D95'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1D98'   3E 01                 	MVI	A,1
  1D9A'   32 29D8'              	STA	QUITF
  1D9D'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1D9E'                         EX_E:
  1D9E'   3A 2A43'              	LDA	EXBANG
  1DA1'   B7                    	ORA	A
  1DA2'   CA 1DAC'              	JZ	EE_GO
  1DA5'   3A 29D9'              	LDA	MODF
  1DA8'   B7                    	ORA	A
  1DA9'   C2 2263'              	JNZ	MSGNWR
  1DAC'                         EE_GO:
  1DAC'   3A 2A31'              	LDA	EXARG
  1DAF'   B7                    	ORA	A
  1DB0'   C2 1DB7'              	JNZ	EE_ARG
  1DB3'   CD 2080'              	CALL	OWNTF		; no name: the buffer's own
  1DB6'   D8                    	RC
  1DB7'                         EE_ARG:
  1DB7'   CD 2096'              	CALL	ISOWN
  1DBA'   21 0001               	LXI	H,1
  1DBD'   C2 1DC4'              	JNZ	EE_LD		; another file: its first line
  1DC0'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1DC3'   23                    	INX	H		; HL = the cursor's line
  1DC4'                         EE_LD:
  1DC4'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1DC6'   32 2A41'              	STA	MSGWHT
  1DC9'   E5                    	PUSH	H
  1DCA'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1DCD'   21 0000*              	LXI	H,TFCB
  1DD0'   11 0000*              	LXI	D,FNAME
  1DD3'   CD 20A8'              	CALL	COPY12		; the buffer's name
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1DD6'   CD 206D'              	CALL	SRCTF
  1DD9'   CD 0000*              	CALL	REOPEN
  1DDC'   CD 020F'              	CALL	MKCLR		; the marks named the buffer that just went
  1DDF'   AF                    	XRA	A
  1DE0'   32 29D9'              	STA	MODF
  1DE3'   E1                    	POP	H
  1DE4'   2B                    	DCX	H
  1DE5'   AF                    	XRA	A
  1DE6'   CD 0000*              	CALL	MVLIND		; down to the line
  1DE9'   CD 0A1D'              	CALL	ATEOF
  1DEC'   DC 0A23'              	CC	LASTLN		; past the last line: onto it
  1DEF'   CD 0F1C'              	CALL	ZSAVE
  1DF2'   C3 0FFF'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  1DF5'                         TFDOS:
  1DF5'   C5                    	PUSH	B
  1DF6'   11 0080               	LXI	D,CMDTAIL
  1DF9'   0E 1A                 	MVI	C,1AH		; set the DMA
  1DFB'   CD 0005               	CALL	BDOS
  1DFE'   C1                    	POP	B
  1DFF'   11 0000*              	LXI	D,TFCB
  1E02'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  1E05'                         EXRNG:
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1E05'   2A 2A8C'              	LHLD	SRNG1
  1E08'   7C                    	MOV	A,H
  1E09'   B5                    	ORA	L
  1E0A'   37                    	STC
  1E0B'   C8                    	RZ
  1E0C'   2A 2A8E'              	LHLD	SRNG2
  1E0F'   EB                    	XCHG
  1E10'   2A 2A8C'              	LHLD	SRNG1
  1E13'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  1E16'   D8                    	RC
  1E17'   EB                    	XCHG			; HL = the last line, DE = the first
  1E18'   CD 0000*              	CALL	SUBHD
  1E1B'   23                    	INX	H
  1E1C'   22 2A96'              	SHLD	SLINES
  1E1F'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  1E20'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  1E21'                         GOLNX:
  1E21'   E5                    	PUSH	H
  1E22'   CD 0EB0'              	CALL	GOLN
  1E25'   CD 0000*              	CALL	CNTLF
  1E28'   23                    	INX	H		; the line the cursor came to rest on
  1E29'   D1                    	POP	D
  1E2A'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  1E2D'                         EXSAVP:
  1E2D'   CD 0CCE'              	CALL	CURRW
  1E30'   32 2A35'              	STA	WPROW
  1E33'   21 2A6D'              	LXI	H,MKPOS
  1E36'   C3 044F'              	JMP	FPSTO
  1E39'                         EXRSTP:
  1E39'   CD 0000*              	CALL	CLRCNT
  1E3C'   CD 03CF'              	CALL	MKPAGE		; page until that place is in the window again
  1E3F'   CD 0000*              	CALL	GOTO
  1E42'   C3 1D76'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  1E45'                         PUTBRK:
  1E45'   3E 0D                 	MVI	A,CR
  1E47'   CD 0000*              	CALL	PUTGAP
  1E4A'   3E 0A                 	MVI	A,LF
  1E4C'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  1E4F'                         EX_WR:
  1E4F'   3A 2A31'              	LDA	EXARG
  1E52'   B7                    	ORA	A
  1E53'   CA 2251'              	JZ	MSGNFN		; No file name
  1E56'   CD 2096'              	CALL	ISOWN
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1E59'   CA 1EF9'              	JZ	EXW_OW
  1E5C'   CD 0000*              	CALL	TEXIST
  1E5F'   32 2A99'              	STA	RWERR		; nonzero: a file of that name is there
  1E62'   CA 1E6C'              	JZ	EXW_GO
  1E65'   3A 2A43'              	LDA	EXBANG
  1E68'   B7                    	ORA	A
  1E69'   C2 2257'              	JNZ	MSGEXI		; File exists (! to force)
  1E6C'                         EXW_GO:
  1E6C'   CD 1E05'              	CALL	EXRNG
  1E6F'   DA 1EF3'              	JC	EXW_BD
  1E72'   CD 1E2D'              	CALL	EXSAVP
  1E75'   2A 2A8C'              	LHLD	SRNG1
  1E78'   CD 1E21'              	CALL	GOLNX
  1E7B'   C2 1EF0'              	JNZ	EXW_NL		; the text has no line N
  1E7E'   3A 2A99'              	LDA	RWERR		; a delete scans the whole directory, there or
  1E81'   B7                    	ORA	A		;   not: only when TEXIST found one
  1E82'   0E 13                 	MVI	C,13H
  1E84'   C4 1DF5'              	CNZ	TFDOS		; delete what is there
  1E87'   0E 16                 	MVI	C,16H
  1E89'   CD 1DF5'              	CALL	TFDOS		; ... and make it
  1E8C'   3C                    	INR	A
  1E8D'   CA 1EE2'              	JZ	EXW_FL		; no directory entry left
  1E90'   3E 80                 	MVI	A,80H
  1E92'   32 2A98'              	STA	RWPTR
  1E95'   AF                    	XRA	A
  1E96'   32 2A99'              	STA	RWERR
  1E99'   2A 2A96'              	LHLD	SLINES
  1E9C'   CD 0000*              	CALL	SETC0		; that many lines, forward
  1E9F'                         EXW_LP:
  1E9F'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  1EA2'   E5                    	PUSH	H
  1EA3'   EB                    	XCHG
  1EA4'   2A 0000*              	LHLD	GAPEND
  1EA7'   CD 1EFF'              	CALL	RWOUT		; the text from the cursor to there
  1EAA'   E1                    	POP	H
  1EAB'   3A 2A99'              	LDA	RWERR
  1EAE'   B7                    	ORA	A
  1EAF'   C2 1ECB'              	JNZ	EXW_EN
  1EB2'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  1EB5'   CD 06A0'              	CALL	CNTTST
  1EB8'   C2 1E9F'              	JNZ	EXW_LP
  1EBB'                         EXW_PD:				; the last record is padded out with ^Z
  1EBB'   3A 2A98'              	LDA	RWPTR
  1EBE'   FE 80                 	CPI	80H
  1EC0'   CA 1ECB'              	JZ	EXW_EN
  1EC3'   3E 1A                 	MVI	A,CPMEOF
  1EC5'   CD 1F0B'              	CALL	RWPUT
  1EC8'   C3 1EBB'              	JMP	EXW_PD
  1ECB'                         EXW_EN:
  1ECB'   0E 10                 	MVI	C,10H
  1ECD'   CD 1DF5'              	CALL	TFDOS		; close
  1ED0'   3A 2A99'              	LDA	RWERR
  1ED3'   B7                    	ORA	A
  1ED4'   C2 1EE2'              	JNZ	EXW_FL
  1ED7'   CD 1E39'              	CALL	EXRSTP
  1EDA'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1EDC'   32 2A41'              	STA	MSGWHT
  1EDF'   C3 075A'              	JMP	SETMOV		; nothing on the screen has changed
  1EE2'                         EXW_FL:				; no room: the part written is not left behind
  1EE2'   0E 13                 	MVI	C,13H
  1EE4'   CD 1DF5'              	CALL	TFDOS
  1EE7'   CD 1E39'              	CALL	EXRSTP
  1EEA'   21 240E'              	LXI	H,SDFUL
  1EED'   C3 2289'              	JMP	EXERR
  1EF0'                         EXW_NL:
  1EF0'   CD 1E39'              	CALL	EXRSTP
  1EF3'                         EXW_BD:
  1EF3'   21 2400'              	LXI	H,SRNGE
  1EF6'   C3 2289'              	JMP	EXERR
  1EF9'                         EXW_OW:
  1EF9'   21 22B8'              	LXI	H,SEXI
  1EFC'   C3 2289'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  1EFF'                         RWOUT:
  1EFF'   CD 0000*              	CALL	CMP16
  1F02'   C8                    	RZ
  1F03'   7E                    	MOV	A,M
  1F04'   23                    	INX	H
  1F05'   CD 1F0B'              	CALL	RWPUT
  1F08'   C3 1EFF'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  1F0B'                         RWPUT:
  1F0B'   E5                    	PUSH	H
  1F0C'   F5                    	PUSH	PSW
  1F0D'   3A 2A98'              	LDA	RWPTR
  1F10'   6F                    	MOV	L,A
  1F11'   26 00                 	MVI	H,0
  1F13'   F1                    	POP	PSW
  1F14'   77                    	MOV	M,A
  1F15'   2C                    	INR	L		; Z: that was the record's last byte
  1F16'   7D                    	MOV	A,L
  1F17'   C2 1F2A'              	JNZ	RWP_ST
  1F1A'   D5                    	PUSH	D
  1F1B'   0E 15                 	MVI	C,15H
  1F1D'   CD 1DF5'              	CALL	TFDOS		; write it
  1F20'   D1                    	POP	D
  1F21'   B7                    	ORA	A
  1F22'   CA 1F28'              	JZ	RWP_OK
  1F25'   32 2A99'              	STA	RWERR
  1F28'                         RWP_OK:
  1F28'   3E 80                 	MVI	A,80H
  1F2A'                         RWP_ST:
  1F2A'   32 2A98'              	STA	RWPTR
  1F2D'   E1                    	POP	H
  1F2E'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  1F2F'                         EX_R:
  1F2F'   3A 2A31'              	LDA	EXARG
  1F32'   B7                    	ORA	A
  1F33'   CA 2251'              	JZ	MSGNFN		; No file name
  1F36'   0E 0F                 	MVI	C,0FH
  1F38'   CD 1DF5'              	CALL	TFDOS		; open
  1F3B'   3C                    	INR	A
  1F3C'   CA 2009'              	JZ	ER_NOF
  1F3F'   CD 0F42'              	CALL	GZONE		; the screen's top line, before anything moves
  1F42'   CD 1E2D'              	CALL	EXSAVP
  1F45'   3A 2A8B'              	LDA	SRNGF
  1F48'   B7                    	ORA	A
  1F49'   CA 1F62'              	JZ	ER_NXT		; no line given: below the cursor's
  1F4C'   2A 2A8E'              	LHLD	SRNG2
  1F4F'   7C                    	MOV	A,H
  1F50'   B5                    	ORA	L
  1F51'   C2 1F5C'              	JNZ	ER_LN
  1F54'   23                    	INX	H
  1F55'   CD 0EB0'              	CALL	GOLN		; ':0r': above line 1 ...
  1F58'   AF                    	XRA	A		;   which never wants a line end put in first
  1F59'   C3 1F84'              	JMP	ER_BRK
  1F5C'                         ER_LN:
  1F5C'   CD 1E21'              	CALL	GOLNX
  1F5F'   C2 1EF0'              	JNZ	EXW_NL		; the text has no line N
  1F62'                         ER_NXT:
  1F62'   21 0001               	LXI	H,1
  1F65'   AF                    	XRA	A
  1F66'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  1F69'   CD 0A1D'              	CALL	ATEOF
  1F6C'   3E 00                 	MVI	A,0
  1F6E'   D2 1F84'              	JNC	ER_BRK		; text follows
  1F71'   2A 0000*              	LHLD	GAPBEG
  1F74'   EB                    	XCHG
  1F75'   2A 0000*              	LHLD	TXTBEG
  1F78'   CD 0000*              	CALL	CMP16
  1F7B'   3E 01                 	MVI	A,1
  1F7D'   CA 1F84'              	JZ	ER_BRK		; nothing before the cursor either
  1F80'   1B                    	DCX	D
  1F81'   1A                    	LDAX	D
  1F82'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  1F84'                         ER_BRK:
  1F84'   32 2A9B'              	STA	RDBRK
  1F87'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  1F8A'   AF                    	XRA	A
  1F8B'   32 2A9A'              	STA	RDANY
  1F8E'                         ER_LP:
  1F8E'   0E 14                 	MVI	C,14H
  1F90'   CD 1DF5'              	CALL	TFDOS		; the next record
  1F93'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1F94'   C2 1FC7'              	JNZ	ER_END
  1F97'   21 0080               	LXI	H,CMDTAIL
  1F9A'   0E 00                 	MVI	C,0
  1F9C'                         ER_SC:				; C = its bytes, up to a ^Z
  1F9C'   7E                    	MOV	A,M
  1F9D'   FE 1A                 	CPI	CPMEOF
  1F9F'   CA 1FA7'              	JZ	ER_GOT
  1FA2'   23                    	INX	H
  1FA3'   0C                    	INR	C
  1FA4'   F2 1F9C'              	JP	ER_SC		; (minus: all 128)
  1FA7'                         ER_GOT:
  1FA7'   79                    	MOV	A,C
  1FA8'   B7                    	ORA	A
  1FA9'   CA 1FC7'              	JZ	ER_END
  1FAC'   C5                    	PUSH	B
  1FAD'   3A 2A9A'              	LDA	RDANY
  1FB0'   B7                    	ORA	A
  1FB1'   CC 1FF8'              	CZ	ER_1ST
  1FB4'   C1                    	POP	B
  1FB5'   06 00                 	MVI	B,0
  1FB7'   11 0080               	LXI	D,CMDTAIL
  1FBA'   C5                    	PUSH	B
  1FBB'   CD 0000*              	CALL	INSBLK
  1FBE'   C1                    	POP	B
  1FBF'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  1FC2'   79                    	MOV	A,C
  1FC3'   17                    	RAL
  1FC4'   DA 1F8E'              	JC	ER_LP		; a full record: there may be more
  1FC7'                         ER_END:
  1FC7'   3A 2A9A'              	LDA	RDANY
  1FCA'   B7                    	ORA	A
  1FCB'   CA 1FE9'              	JZ	ER_PL		; nothing in the file: nothing has changed
  1FCE'   CD 0A1D'              	CALL	ATEOF
  1FD1'   DA 1FDE'              	JC	ER_MD		; the text now ends as the file read ends
  1FD4'   2A 0000*              	LHLD	GAPBEG
  1FD7'   2B                    	DCX	H
  1FD8'   7E                    	MOV	A,M
  1FD9'   FE 0A                 	CPI	LF
  1FDB'   C4 1E45'              	CNZ	PUTBRK		; text follows: what was read ends a line
  1FDE'                         ER_MD:
  1FDE'   3E 01                 	MVI	A,1
  1FE0'   32 29D9'              	STA	MODF
  1FE3'   CD 03CF'              	CALL	MKPAGE		; back to the first line read
  1FE6'   CD 0000*              	CALL	GOTO
  1FE9'                         ER_PL:
  1FE9'   CD 0A1D'              	CALL	ATEOF
  1FEC'   DC 0A23'              	CC	LASTLN		; (nothing read, at the end: the last line)
  1FEF'   CD 0000*              	CALL	CLRCNT
  1FF2'   CD 0F5A'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  1FF5'   C3 077B'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  1FF8'                         ER_1ST:
  1FF8'   3C                    	INR	A
  1FF9'   32 2A9A'              	STA	RDANY
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1FFC'   3A 2A9B'              	LDA	RDBRK
  1FFF'   B7                    	ORA	A
  2000'   C4 1E45'              	CNZ	PUTBRK
  2003'   21 2A6D'              	LXI	H,MKPOS
  2006'   C3 044F'              	JMP	FPSTO
  2009'                         ER_NOF:
  2009'   21 23EF'              	LXI	H,SNOPN
  200C'   C3 227E'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  200F'                         WRCHK:
  200F'   3A 2A31'              	LDA	EXARG
  2012'   B7                    	ORA	A
  2013'   C2 201D'              	JNZ	WC_ARG
  2016'   CD 2080'              	CALL	OWNTF
  2019'   D8                    	RC
  201A'   C3 2032'              	JMP	WC_OWN
  201D'                         WC_ARG:
  201D'   CD 2096'              	CALL	ISOWN
  2020'   CA 2032'              	JZ	WC_OWN
  2023'   3A 2A43'              	LDA	EXBANG
  2026'   B7                    	ORA	A
  2027'   CA 2030'              	JZ	WC_OTH
  202A'   CD 0000*              	CALL	TEXIST
  202D'   C2 2257'              	JNZ	MSGEXI		; File exists (! to force)
  2030'                         WC_OTH:
  2030'   AF                    	XRA	A		; (NC)
  2031'   C9                    	RET
  2032'                         WC_OWN:
  2032'   3A 2A44'              	LDA	ROFLAG		; '-R': this is the file it may not write
  2035'   B7                    	ORA	A
  2036'   CA 2040'              	JZ	WC_OK
  2039'   3A 2A43'              	LDA	EXBANG
  203C'   B7                    	ORA	A
  203D'   C2 225D'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  2040'                         WC_OK:
  2040'   3E 01                 	MVI	A,1
  2042'   B7                    	ORA	A		; (NC)
  2043'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  2044'                         WRITE:
  2044'   3A 2A32'              	LDA	EXBAK
  2047'   CD 0000*              	CALL	WRTO
  204A'   3A 0001*              	LDA	FNAME+1
  204D'   FE 20                 	CPI	' '
  204F'   C2 205B'              	JNZ	WR_HAS
  2052'   21 0000*              	LXI	H,TFCB
  2055'   11 0000*              	LXI	D,FNAME
  2058'   CD 20A8'              	CALL	COPY12
  205B'                         WR_HAS:
  205B'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  205D'   32 2A41'              	STA	MSGWHT
  2060'   CD 2096'              	CALL	ISOWN
  2063'   C2 206D'              	JNZ	SRCTF
  2066'   AF                    	XRA	A
  2067'   32 29D9'              	STA	MODF
  206A'   32 2A42'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  206D'                         SRCTF:
  206D'   21 0000*              	LXI	H,TFCB
  2070'   11 005C               	LXI	D,DFTFCB
  2073'   CD 20A8'              	CALL	COPY12
  2076'   AF                    	XRA	A
  2077'   06 04                 	MVI	B,4
  2079'                         SRC_Z:
  2079'   12                    	STAX	D		; extent, s1, s2, record count: 0
  207A'   13                    	INX	D
  207B'   05                    	DCR	B
  207C'   C2 2079'              	JNZ	SRC_Z
  207F'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  2080'                         OWNTF:
  2080'   3A 0001*              	LDA	FNAME+1
  2083'   FE 20                 	CPI	' '
  2085'   CA 2251'              	JZ	MSGNFN
  2088'   CD 20B3'              	CALL	TFCLR
  208B'   21 0000*              	LXI	H,FNAME
  208E'   11 0000*              	LXI	D,TFCB
  2091'   CD 20A8'              	CALL	COPY12
  2094'   B7                    	ORA	A		; (NC)
  2095'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  2096'                         ISOWN:
  2096'   21 0000*              	LXI	H,TFCB
  2099'   11 0000*              	LXI	D,FNAME
  209C'   06 0C                 	MVI	B,12
  209E'                         IO_LP:
  209E'   1A                    	LDAX	D
  209F'   BE                    	CMP	M
  20A0'   C0                    	RNZ
  20A1'   23                    	INX	H
  20A2'   13                    	INX	D
  20A3'   05                    	DCR	B
  20A4'   C2 209E'              	JNZ	IO_LP
  20A7'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  20A8'                         COPY12:
  20A8'   06 0C                 	MVI	B,12
  20AA'                         CP_LP:
  20AA'   7E                    	MOV	A,M
  20AB'   12                    	STAX	D
  20AC'   23                    	INX	H
  20AD'   13                    	INX	D
  20AE'   05                    	DCR	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  20AF'   C2 20AA'              	JNZ	CP_LP
  20B2'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  20B3'                         TFCLR:
  20B3'   11 0000*              	LXI	D,TFCB
  20B6'   06 24                 	MVI	B,36
  20B8'   AF                    	XRA	A
  20B9'                         TC_LP:
  20B9'   12                    	STAX	D
  20BA'   13                    	INX	D
  20BB'   05                    	DCR	B
  20BC'   C2 20B9'              	JNZ	TC_LP
  20BF'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  20C0'                         FOPEN:
  20C0'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  20C2'   32 2A41'              	STA	MSGWHT
  20C5'   21 005C               	LXI	H,DFTFCB
  20C8'   CD 219A'              	CALL	NRMDRV
  20CB'   11 0000*              	LXI	D,FNAME
  20CE'   CD 20A8'              	CALL	COPY12
  20D1'   CD 0000*              	CALL	OPENZ
  20D4'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  20D7'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  20D9'   C8                    	RZ
  20DA'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  20DD'   32 2A42'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  20E0'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


                                ;============================================================
  20E1'                         ARGSCN:
  20E1'   3A 0080               	LDA	CMDTAIL
  20E4'   47                    	MOV	B,A		; B = what is left of the line
  20E5'   B7                    	ORA	A
  20E6'   C8                    	RZ
  20E7'   21 0081               	LXI	H,CMDTAIL+1
  20EA'                         AS_TOK:				; at a token, or the blanks before one
  20EA'   7E                    	MOV	A,M
  20EB'   FE 20                 	CPI	' '
  20ED'   C2 20F6'              	JNZ	AS_OPT
  20F0'   23                    	INX	H
  20F1'   05                    	DCR	B
  20F2'   C2 20EA'              	JNZ	AS_TOK
  20F5'   C9                    	RET
  20F6'                         AS_OPT:
  20F6'   FE 2B                 	CPI	'+'
  20F8'   CA 2122'              	JZ	AS_PLS
  20FB'   FE 2D                 	CPI	'-'
  20FD'   CA 2111'              	JZ	AS_SW
  2100'   FE 2F                 	CPI	'/'
  2102'   CA 2111'              	JZ	AS_SW
  2105'                         AS_SKP:				; not ours (the file name): on to the next one
  2105'   23                    	INX	H
  2106'   05                    	DCR	B
  2107'   C8                    	RZ
  2108'   7E                    	MOV	A,M
  2109'   FE 20                 	CPI	' '
  210B'   C2 2105'              	JNZ	AS_SKP
  210E'   C3 20EA'              	JMP	AS_TOK
  2111'                         AS_SW:
  2111'   23                    	INX	H
  2112'   05                    	DCR	B
  2113'   C8                    	RZ
  2114'   7E                    	MOV	A,M
  2115'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  2117'   FE 52                 	CPI	'R'
  2119'   C2 2105'              	JNZ	AS_SKP
  211C'   32 2A44'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  211F'   C3 2105'              	JMP	AS_SKP
  2122'                         AS_PLS:
  2122'   3E 01                 	MVI	A,1
  2124'   32 2A45'              	STA	PLUSF		; '+' gets the line even with no number on it
  2127'   11 0000*              	LXI	D,PLUSB
  212A'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  212C'   23                    	INX	H		;   line space, so it is taken as '+' alone
  212D'   05                    	DCR	B
  212E'   CA 2165'              	JZ	AS_PE
  2131'   7E                    	MOV	A,M
  2132'   FE 30                 	CPI	'0'
  2134'   C2 214C'              	JNZ	AS_PD
  2137'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  2137'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  2138'   05                    	DCR	B
  2139'   CA 216D'              	JZ	AS_P1
  213C'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  213D'   FE 30                 	CPI	'0'
  213F'   CA 2137'              	JZ	AS_PZ
  2142'   FE 31                 	CPI	'1'
  2144'   DA 216D'              	JC	AS_P1		; zeros and then no digit at all: line 1
  2147'   FE 3A                 	CPI	'9'+1
  2149'   D2 216D'              	JNC	AS_P1
  214C'                         AS_PD:				; the digits, as typed
  214C'   7E                    	MOV	A,M
  214D'   FE 30                 	CPI	'0'
  214F'   DA 2165'              	JC	AS_PE
  2152'   FE 3A                 	CPI	'9'+1
  2154'   D2 2165'              	JNC	AS_PE
  2157'   79                    	MOV	A,C
  2158'   B7                    	ORA	A
  2159'   CA 2174'              	JZ	AS_POV
  215C'   0D                    	DCR	C
  215D'   7E                    	MOV	A,M
  215E'   12                    	STAX	D
  215F'   13                    	INX	D
  2160'   23                    	INX	H
  2161'   05                    	DCR	B
  2162'   C2 214C'              	JNZ	AS_PD
  2165'                         AS_PE:
  2165'   AF                    	XRA	A
  2166'   12                    	STAX	D		; the digits end with a 0
  2167'   78                    	MOV	A,B
  2168'   B7                    	ORA	A
  2169'   C8                    	RZ
  216A'   C3 20EA'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  216D'                         AS_P1:
  216D'   3E 31                 	MVI	A,'1'
  216F'   12                    	STAX	D
  2170'   13                    	INX	D
  2171'   C3 2165'              	JMP	AS_PE
  2174'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  2174'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  2177'   C3 2165'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  217A'                         ARGGO:
  217A'   3A 2A45'              	LDA	PLUSF
  217D'   B7                    	ORA	A
  217E'   C8                    	RZ
  217F'   21 0000*              	LXI	H,PLUSB
  2182'                         AG_LP:
  2182'   7E                    	MOV	A,M
  2183'   B7                    	ORA	A
  2184'   CA 2193'              	JZ	AG_G
  2187'   4F                    	MOV	C,A
  2188'   06 02                 	MVI	B,KT_CHAR
  218A'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  218B'   CD 0023'              	CALL	VICMD
  218E'   E1                    	POP	H
  218F'   23                    	INX	H
  2190'   C3 2182'              	JMP	AG_LP
  2193'                         AG_G:
  2193'   0E 47                 	MVI	C,'G'
  2195'   06 02                 	MVI	B,KT_CHAR
  2197'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  219A'                         NRMDRV:
  219A'   7E                    	MOV	A,M
  219B'   B7                    	ORA	A
  219C'   C0                    	RNZ
  219D'   E5                    	PUSH	H
  219E'   0E 19                 	MVI	C,BF_CURDSK
  21A0'   CD 0005               	CALL	BDOS
  21A3'   E1                    	POP	H
  21A4'   3C                    	INR	A
  21A5'   77                    	MOV	M,A
  21A6'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  21A7'                         PARSFN:
  21A7'   CD 20B3'              	CALL	TFCLR
  21AA'   11 0000*              	LXI	D,TFCB
  21AD'   23                    	INX	H
  21AE'   7E                    	MOV	A,M
  21AF'   2B                    	DCX	H
  21B0'   FE 3A                 	CPI	':'
  21B2'   C2 21C4'              	JNZ	PF_NM
  21B5'   CD 220A'              	CALL	GETFNC
  21B8'   CA 21C4'              	JZ	PF_NM
  21BB'   D6 40                 	SUI	40H
  21BD'   12                    	STAX	D
  21BE'   FE 11                 	CPI	17
  21C0'   D2 21E8'              	JNC	PF_BAD
  21C3'   23                    	INX	H
  21C4'                         PF_NM:
  21C4'   13                    	INX	D
  21C5'   0E 08                 	MVI	C,8
  21C7'   CD 21EC'              	CALL	CPYNAM
  21CA'   FE 2E                 	CPI	'.'
  21CC'   0E 03                 	MVI	C,3
  21CE'   C4 21FF'              	CNZ	PADFLD		; no type: blanks
  21D1'   CC 21EB'              	CZ	CPYNM0		; '.': the type
  21D4'   3A 0001*              	LDA	TFCB+1
  21D7'   FE 20                 	CPI	' '
  21D9'   CA 21E8'              	JZ	PF_BAD		; no name
  21DC'   CD 223D'              	CALL	SKIPB
  21DF'   C0                    	RNZ			; more after it
  21E0'   21 0000*              	LXI	H,TFCB
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  21E3'   CD 219A'              	CALL	NRMDRV
  21E6'   AF                    	XRA	A
  21E7'   C9                    	RET
  21E8'                         PF_BAD:
  21E8'   F6 01                 	ORI	1
  21EA'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  21EB'                         CPYNM0:
  21EB'   23                    	INX	H
  21EC'                         CPYNAM:
  21EC'   CD 220A'              	CALL	GETFNC
  21EF'   CA 21FF'              	JZ	PADFLD
  21F2'   12                    	STAX	D
  21F3'   13                    	INX	D
  21F4'   0D                    	DCR	C
  21F5'   C2 21EC'              	JNZ	CPYNAM
  21F8'                         CN_SKP:
  21F8'   CD 220A'              	CALL	GETFNC
  21FB'   C2 21F8'              	JNZ	CN_SKP
  21FE'   C9                    	RET
  21FF'                         PADFLD:
  21FF'   F5                    	PUSH	PSW
  2200'                         PD_LP:
  2200'   3E 20                 	MVI	A,' '
  2202'   12                    	STAX	D
  2203'   13                    	INX	D
  2204'   0D                    	DCR	C
  2205'   C2 2200'              	JNZ	PD_LP
  2208'   F1                    	POP	PSW
  2209'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  220A'                         GETFNC:
  220A'   7E                    	MOV	A,M
  220B'   FE 3D                 	CPI	'='
  220D'   C8                    	RZ
  220E'   FE 5F                 	CPI	'_'
  2210'   C8                    	RZ
  2211'   FE 3B                 	CPI	';'
  2213'   C8                    	RZ
  2214'   FE 3C                 	CPI	'<'
  2216'   C8                    	RZ
  2217'   FE 3E                 	CPI	'>'
  2219'   C8                    	RZ
  221A'   FE 2E                 	CPI	'.'
  221C'   C8                    	RZ
  221D'   FE 3A                 	CPI	':'
  221F'   C8                    	RZ
  2220'   FE 2A                 	CPI	'*'
  2222'   C8                    	RZ
  2223'   FE 3F                 	CPI	'?'
  2225'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  2226'   FE 20                 	CPI	' '
  2228'   DA 223B'              	JC	GF_CTL
  222B'   C8                    	RZ
  222C'   23                    	INX	H
  222D'   FE 61                 	CPI	'a'
  222F'   DA 2239'              	JC	GF_DN
  2232'   FE 7B                 	CPI	'z'+1
  2234'   D2 2239'              	JNC	GF_DN
  2237'   E6 DF                 	ANI	0DFH
  2239'                         GF_DN:
  2239'   B7                    	ORA	A
  223A'   C9                    	RET
  223B'                         GF_CTL:
  223B'   BF                    	CMP	A
  223C'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  223D'                         SKIPB:
  223D'   7E                    	MOV	A,M
  223E'   FE 20                 	CPI	' '
  2240'   C2 2247'              	JNZ	SB_DN
  2243'   23                    	INX	H
  2244'   C3 223D'              	JMP	SKIPB
  2247'                         SB_DN:
  2247'   B7                    	ORA	A
  2248'   C9                    	RET
                                
                                ;ISLOW -- A = the char at HL; NC iff a-z.
  2249'                         ISLOW:
  2249'   7E                    	MOV	A,M
  224A'   FE 61                 	CPI	'a'
  224C'   D8                    	RC
  224D'   FE 7B                 	CPI	'z'+1
  224F'   3F                    	CMC
  2250'   C9                    	RET
                                
                                ;--- ex messages (vim's, without the Enn number) ---
  2251'                         MSGNFN:
  2251'   21 229E'              	LXI	H,SNFN
  2254'   C3 2289'              	JMP	EXERR
  2257'                         MSGEXI:
  2257'   21 22B8'              	LXI	H,SEXI
  225A'   C3 2266'              	JMP	EXBNG
  225D'                         MSGRO:
  225D'   21 22C4'              	LXI	H,SRO
  2260'   C3 2266'              	JMP	EXBNG
  2263'                         MSGNWR:
  2263'   21 22AB'              	LXI	H,SNWR
  2266'                         EXBNG:
  2266'   CD 2289'              	CALL	EXERR
  2269'   21 22D0'              	LXI	H,SBNG
  226C'   C3 2284'              	JMP	EXOUT
  226F'                         EX_INV:
  226F'   21 22DE'              	LXI	H,SINV
