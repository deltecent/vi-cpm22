  0677'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
                                ; The text is read where it lies, either side of the gap; keeps BC.
  0678'                         BOL:
  0678'   C5                    	PUSH	B
  0679'   E5                    	PUSH	H
  067A'   CD 0000*              	CALL	CUROFF
  067D'   D1                    	POP	D		; DE = off, HL = the bytes before the gap
  067E'   CD 0000*              	CALL	CMP16
  0681'   DA 06A4'              	JC	BOL_B
  0684'   CA 06A4'              	JZ	BOL_B
  0687'   D5                    	PUSH	D
  0688'   EB                    	XCHG
  0689'   CD 0000*              	CALL	SUBHD
  068C'   44                    	MOV	B,H
  068D'   4D                    	MOV	C,L		; BC = how far past the gap it is
  068E'   2A 0000*              	LHLD	GAPEND
  0691'   09                    	DAD	B
  0692'   D1                    	POP	D
  0693'                         BOL_A:
  0693'   78                    	MOV	A,B
  0694'   B1                    	ORA	C
  0695'   CA 06A4'              	JZ	BOL_B		; back at the gap: the rest is before it
  0698'   2B                    	DCX	H
  0699'   7E                    	MOV	A,M
  069A'   FE 0A                 	CPI	LF
  069C'   CA 06B8'              	JZ	BOL_X
  069F'   1B                    	DCX	D
  06A0'   0B                    	DCX	B
  06A1'   C3 0693'              	JMP	BOL_A
  06A4'                         BOL_B:
  06A4'   2A 0000*              	LHLD	TXTBEG
  06A7'   19                    	DAD	D
  06A8'                         BOL_C:
  06A8'   7A                    	MOV	A,D
  06A9'   B3                    	ORA	E
  06AA'   CA 06B8'              	JZ	BOL_X		; at 0
  06AD'   2B                    	DCX	H
  06AE'   7E                    	MOV	A,M
  06AF'   FE 0A                 	CPI	LF
  06B1'   CA 06B8'              	JZ	BOL_X
  06B4'   1B                    	DCX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06B5'   C3 06A8'              	JMP	BOL_C
  06B8'                         BOL_X:
  06B8'   EB                    	XCHG
  06B9'   C1                    	POP	B
  06BA'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
                                ; Read the same way; keeps BC.
  06BB'                         EOLNL:
  06BB'   C5                    	PUSH	B
  06BC'   E5                    	PUSH	H
  06BD'   CD 0000*              	CALL	CUROFF
  06C0'   D1                    	POP	D		; DE = off, HL = the bytes before the gap
  06C1'   CD 0000*              	CALL	CMP16
  06C4'   D2 06E2'              	JNC	ENL_A
  06C7'   2A 0000*              	LHLD	GAPBEG
  06CA'   44                    	MOV	B,H
  06CB'   4D                    	MOV	C,L
  06CC'   2A 0000*              	LHLD	TXTBEG
  06CF'   19                    	DAD	D
  06D0'                         ENL_B:
  06D0'   7D                    	MOV	A,L
  06D1'   91                    	SUB	C
  06D2'   7C                    	MOV	A,H
  06D3'   98                    	SBB	B
  06D4'   D2 06F0'              	JNC	ENL_G		; at the gap: on from its far side
  06D7'   7E                    	MOV	A,M
  06D8'   FE 0A                 	CPI	LF
  06DA'   CA 070C'              	JZ	ENL_X
  06DD'   23                    	INX	H
  06DE'   13                    	INX	D
  06DF'   C3 06D0'              	JMP	ENL_B
  06E2'                         ENL_A:
  06E2'   D5                    	PUSH	D
  06E3'   EB                    	XCHG
  06E4'   CD 0000*              	CALL	SUBHD
  06E7'   EB                    	XCHG			; DE = how far past the gap it is
  06E8'   2A 0000*              	LHLD	GAPEND
  06EB'   19                    	DAD	D
  06EC'   D1                    	POP	D
  06ED'   C3 06F3'              	JMP	ENL_S
  06F0'                         ENL_G:
  06F0'   2A 0000*              	LHLD	GAPEND
  06F3'                         ENL_S:
  06F3'   E5                    	PUSH	H
  06F4'   2A 0000*              	LHLD	TXTEND
  06F7'   44                    	MOV	B,H
  06F8'   4D                    	MOV	C,L
  06F9'   E1                    	POP	H
  06FA'                         ENL_C:
  06FA'   7D                    	MOV	A,L
  06FB'   91                    	SUB	C
  06FC'   7C                    	MOV	A,H
  06FD'   98                    	SBB	B
  06FE'   D2 070C'              	JNC	ENL_X		; the end of the text
  0701'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  0702'   FE 0A                 	CPI	LF
  0704'   CA 070C'              	JZ	ENL_X
  0707'   23                    	INX	H
  0708'   13                    	INX	D
  0709'   C3 06FA'              	JMP	ENL_C
