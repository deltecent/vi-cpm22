  2E4B'   09C5'                 	DW	VC_J
  2E4D'   6B                    	DB	'k'
  2E4E'   09D7'                 	DW	VC_K
  2E50'   30                    	DB	'0'
  2E51'   0927'                 	DW	VC_0
  2E53'   5E                    	DB	'^'
  2E54'   0945'                 	DW	VC_CRT
  2E56'   24                    	DB	'$'
  2E57'   0983'                 	DW	VC_EOL
  2E59'   0D                    	DB	CR			; <CR> -- down to the first non-blank
  2E5A'   09A7'                 	DW	VC_CR
  2E5C'   77                    	DB	'w'
  2E5D'   0C50'                 	DW	VC_W
