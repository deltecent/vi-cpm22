  27F6'   12                    	STAX	D
  27F7'   13                    	INX	D
  27F8'   0D                    	DCR	C
  27F9'   C2 27F4'              	JNZ	PD_LP
  27FC'   F1                    	POP	PSW
  27FD'   C9                    	RET
