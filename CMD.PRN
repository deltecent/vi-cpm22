  099E'   CD 0A5D'              	CALL	ATEOF
  09A1'   D2 09B5'              	JNC	JC_DN
  09A4'   CD 0A63'              	CALL	LASTLN		; ran past the last line: back onto it
  09A7'   3A 2A85'              	LDA	JKPHN
  09AA'   B7                    	ORA	A
  09AB'   CA 09B5'              	JZ	JC_DN
  09AE'   2A 2A81'              	LHLD	JKMOV
  09B1'   2B                    	DCX	H
  09B2'   22 2A81'              	SHLD	JKMOV
  09B5'                         JC_DN:
  09B5'   2A 2A7F'              	LHLD	JKN		; LNDLT += min(moved, N)
  09B8'   EB                    	XCHG
  09B9'   2A 2A81'              	LHLD	JKMOV
  09BC'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  09BF'   D2 09C3'              	JNC	JC_AD
  09C2'   EB                    	XCHG
  09C3'                         JC_AD:
  09C3'   EB                    	XCHG			; DE = lines moved
  09C4'   2A 0000*              	LHLD	LNDLT
  09C7'   19                    	DAD	D
  09C8'   22 0000*              	SHLD	LNDLT
  09CB'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  09CC'                         KCORE:
  09CC'   7C                    	MOV	A,H
  09CD'   B5                    	ORA	L
  09CE'   C8                    	RZ
  09CF'   22 2A7D'              	SHLD	JKCNT
  09D2'   CD 0D41'              	CALL	CURRW		; limit = row + NEDIT
  09D5'   5F                    	MOV	E,A
  09D6'   16 00                 	MVI	D,0
  09D8'   3A 0000*              	LDA	NEDIT
  09DB'   6F                    	MOV	L,A
  09DC'   26 00                 	MVI	H,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  09DE'   19                    	DAD	D
  09DF'   EB                    	XCHG			; DE = limit
  09E0'   2A 2A7D'              	LHLD	JKCNT
  09E3'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  09E6'   D2 09EA'              	JNC	KC_N
  09E9'   EB                    	XCHG			; HL = limit
  09EA'                         KC_N:
  09EA'   22 2A7F'              	SHLD	JKN		; N = min(count, limit)
  09ED'   EB                    	XCHG			; DE = LFs to find
  09EE'   21 0000               	LXI	H,0
  09F1'   22 2A83'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  09F4'                         KC_ED:
