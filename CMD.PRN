  0C34'   D2 0C51'              	JNC	ES_LND
  0C37'   2A 26E5'              	LHLD	WKI
  0C3A'   23                    	INX	H
  0C3B'   E5                    	PUSH	H		; i+1
  0C3C'   CD 0000*              	CALL	CHARAT
