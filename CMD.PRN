  098D'   7C                    	MOV	A,H
  098E'   A5                    	ANA	L
  098F'   3C                    	INR	A
  0990'   C2 0994'              	JNZ	JL_LS
  0993'   23                    	INX	H		; no content: the line's start
  0994'                         JL_LS:
  0994'   EB                    	XCHG
