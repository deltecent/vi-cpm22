  2499'   02                    	DB	ACT_CURDN
  249A'   080C'                 	DW	VC_J
  249C'   01                    	DB	ACT_CURUP
  249D'   081B'                 	DW	VC_K
  249F'   05                    	DB	ACT_LINST
  24A0'   076E'                 	DW	VC_0
  24A2'   06                    	DB	ACT_LINEN
  24A3'   07CA'                 	DW	VC_EOL
  24A5'   07                    	DB	ACT_PGUP
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  24A6'   0D09'                 	DW	VC_PGUP
  24A8'   08                    	DB	ACT_PGDN
  24A9'   0CDC'                 	DW	VC_PGDN
  24AB'   00                    	DB	0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  24AC'   00                    EDMODE: DB	EM_CMD
  24AD'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  24AF'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  24B0'   00                    MODF:	DB	0		; 1 = unsaved changes
  24B1'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  24B2'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  24B3'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  24B4'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  24B5'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  24B7'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  24B8'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  24B9'   00                    HFROW:	DB	0		; ^D/^U: the cursor's row before the move
  24BA'   00                    HFAMT:	DB	0		; ^D/^U: lines (vim's 'scroll'); 0 = NEDIT/2
  24BB'   0000                  JKCNT:	DW	0		; j/k: count
  24BD'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  24BF'   0000                  JKMOV:	DW	0		; j: lines moved
  24C1'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  24C3'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  24C4'   00                    JKLST:	DB	0		; j: last byte of the scan
  24C5'   0000                  JKVC:	DW	0		; j/k landing: screen column
  24C7'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  24C9'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  24CA'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  24CB'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  24CC'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  24CD'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  24CE'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  24D0'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  24D1'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  24D2'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  24D4'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  24D5'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  24D6'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  24D7'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
  24D8'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  24D9'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  24DA'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


                                				;   so it stops at the line's content end
  24DB'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  24DD'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  24DF'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  24E1'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  24E3'   0000                  CNTV:	DW	0		; motion repeat counter
  24E5'   0000                  TTI:	DW	0		; TAILTAB scan index
  24E7'   0000                  WKI:	DW	0		; scan index
  24E9'   0000                  WKN:	DW	0		; cached LOGLEN
  24EB'   0000                  WKTERM: DW	0		; line terminator offset
  24ED'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  24EF'   00                    WKCLS:	DB	0		; word motion: class of the current run
  24F0'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  24F1'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  24F3'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  24F5'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
  24F7'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  24F9'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  24FA'   00                    RLMAX:	DB	0		; RDLINE: capacity
  24FB'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  24FC'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  24FD'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  24FE'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  2500'   00                    WPROW:	DB	0		; :w -- the cursor's row
  2501'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  2502'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2504'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  2506'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  2507'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  2509'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  250B'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  250C'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  250D'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  250E'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  250F'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  2510'   00                    PLUSF:	DB	0		; command line: '+' was given
  2511'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  2512'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  2513'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  2514'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  2516'   0000                  YPT:	DW	0		; yy: where the lines came from
  2518'   0000                  PCNT:	DW	0		; p/P: copies still to put
  251A'   0000                  PPT:	DW	0		; p/P: the first line put
  251C'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  251E'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  251F'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  2521'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  2522'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  2523'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  2524'   00                    FNDKND: DB	0		; f/F/t/T: which find ';' repeats (0 = none yet)
  2525'   00                    FNDCH:	DB	0		; ... and the character it looked for
  2526'   00                    FNDRUN: DB	0		; the find THIS command is running (',' reverses)
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  2527'   00                    FNDSTP: DB	0		; how far along it starts: 2 for a 't' repeat
  2528'   0000                  FNDN:	DW	0		; occurrences still to count off
  252A'   0000                  FNDCUR: DW	0		; the cursor it started from
  252C'   0000                  FNDLIM: DW	0		; ... and the end of the line it may not pass
  252E'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  252F'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  2532'   00 00 00              MKEDIT: DB	0,0,0		; MKSHFT: where in the file the edit is
  2535'   0000                  MKN:	DW	0		; ... how long it is
  2537'   00                    MKTYP:	DB	0		; ... and which way: 1 text went in, 2 came out
  2538'   00 00 00              MKPOS:	DB	0,0,0		; MKJMP: the file position being jumped to
  253B'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  253C'   00                    MKHOLD: DB	0		; set across YKGO's delete + put back (a yank
                                				;   that could not copy): MKSHFT must leave the
                                				;   marks alone through it
  253D'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  253F'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  2541'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  2543'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  2545'   0000                  YBLK:	DW	0		; ... and where they ended when they came back
                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  2547'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  2549'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
  254B'   0000                  SCNT:	DW	0		; searches still to do (the count)
  254D'   0000                  SOFF:	DW	0		; where the cursor was when the search began
  254F'   0000                  SLDLT:	DW	0		; ... and LNDLT, for the search that fails
  2551'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  2552'   00                    SRNGF:	DB	0		; ex: a line range was given
  2553'   0000                  SRNG1:	DW	0		; ex: its first line
  2555'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  2557'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  2558'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  2559'   00                    SANY:	DB	0		; ':s' something in the range has changed
  255A'   00                    SLCHG:	DB	0		; ':s' this line changed
  255B'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  255D'   0000                  SLINES: DW	0		; ':s' lines of the range still to do
  255F'   0000                  SOFFS:	DW	0		; ':s' the cursor, for a substitute that
  2561'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  2563'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  2564'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
