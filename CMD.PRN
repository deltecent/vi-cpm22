  2930'   44                    	DB	'D'
  2931'   142F'                 	DW	VCB_D
  2933'   43                    	DB	'C'
  2934'   1429'                 	DW	VCB_C
  2936'   63                    	DB	'c'
  2937'   1694'                 	DW	VC_C
  2939'   6F                    	DB	'o'
  293A'   152F'                 	DW	VC_O
  293C'   4F                    	DB	'O'
  293D'   1544'                 	DW	VCB_O
  293F'   4A                    	DB	'J'
  2940'   155E'                 	DW	VCB_J
  2942'   7E                    	DB	'~'
  2943'   15E0'                 	DW	VC_TILD
  2945'   3A                    	DB	':'
