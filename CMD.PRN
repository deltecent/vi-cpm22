  0B24'   CA 0B33'              	JZ	NX_LF
  0B27'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0B2A'   D8                    	RC
  0B2B'   FE 0A                 	CPI	LF
  0B2D'   CA 0B33'              	JZ	NX_LF
  0B30'   2B                    	DCX	H		; a lone CR
  0B31'   AF                    	XRA	A
  0B32'   C9                    	RET
  0B33'                         NX_LF:
