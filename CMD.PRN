  2DBA'   0E44'                 	DW	VC_LOWL
  2DBC'   06                    	DB	06H			; ^F -- page forward
  2DBD'   0E61'                 	DW	VC_PGDN
  2DBF'   02                    	DB	02H			; ^B -- page back
  2DC0'   0EBF'                 	DW	VC_PGUP
  2DC2'   04                    	DB	04H			; ^D -- half page down
  2DC3'   0FA0'                 	DW	VC_HFDN
  2DC5'   15                    	DB	15H			; ^U -- half page up
  2DC6'   1067'                 	DW	VC_HFUP
  2DC8'   0C                    	DB	0CH			; ^L -- redraw
  2DC9'   1216'                 	DW	VC_REDR
  2DCB'   2E                    	DB	'.'			; '.' -- repeat the last change
  2DCC'   017D'                 	DW	VC_DOT
  2DCE'   75                    	DB	'u'			; 'u' -- undo (and undo the undo)
  2DCF'   0545'                 	DW	VC_UNDO
  2DD1'   6D                    	DB	'm'		; m{a-c} -- set a mark
  2DD2'   032E'                 	DW	VC_MK
  2DD4'   60                    	DB	60H		; `{a-c} -- back to its exact spot
  2DD5'   0333'                 	DW	VC_BQ
  2DD7'   27                    	DB	27H		; '{a-c} -- back to its line's first non-blank
  2DD8'   0338'                 	DW	VC_AQ
  2DDA'   00                    	DB	0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  2DDB'   00                    EDMODE: DB	EM_CMD
  2DDC'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  2DDE'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  2DDF'   00                    MODF:	DB	0		; 1 = unsaved changes
  2DE0'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  2DE1'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  2DE2'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  2DE3'   01                    DCHN:	DB	1		; the cells an R_DCH paint deletes (SCRN.MAC reads)
  2DE4'   00                    DCHBS:	DB	0		; 1 = they went left of the cursor (insert's BS)
  2DE5'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  2DE6'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  2DE8'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  2DE9'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  2DEA'   00                    HFAMT:	DB	0		; ^D/^U: rows (vim's 'scroll'); 0 = NEDIT/2
  2DEB'   00                    HFN:	DB	0		; ^D/^U: the rows this one goes
  2DEC'   0000                  HFTP:	DW	0		; ^D/^U: -> the new top line's entry
  2DEE'   00                    HTN:	DB	0		; row table: its entries
  2DEF'   00                    HTCUR:	DB	0		; ... the cursor line's
  2DF0'   00                    HTTP:	DB	0		; ... the top line's
  2DF1'   00                    HTEOF:	DB	0		; ... 1 = its last is the file's last line
  2DF2'   00                    HTBOF:	DB	0		; ... 1 = its first is the file's first
  2DF3'   0000                  RWR:	DW	0		; ^F/^B: rows still to go
  2DF5'   00                    RWMV:	DB	0		; ^F/^B: 1 = the table was made again on the way
  2DF6'   00                    OVDIR:	DB	0		; OVLAP: 0 = h2.. are above h1 in the table
  2DF7'   0000                  JKCNT:	DW	0		; j/k: count
  2DF9'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  2DFB'   0000                  JKMOV:	DW	0		; j: lines moved
  2DFD'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
	MACRO-80 3.44	09-Dec-81	PAGE	1-142


  2DFF'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  2E00'   00                    JKLST:	DB	0		; j: last byte of the scan
  2E01'   0000                  JKVC:	DW	0		; j/k landing: screen column
  2E03'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  2E05'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  2E06'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  2E07'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  2E08'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  2E09'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  2E0A'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  2E0C'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  2E0D'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  2E0E'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  2E10'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  2E11'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  2E12'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  2E13'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
  2E14'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  2E15'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  2E16'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   and its first word is yet to be stepped
  2E17'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  2E19'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  2E1B'   00 00 00              OPSFP:	DB	0,0,0		; operator: the start as a place in the file
  2E1E'   00 00 00              OPSLO:	DB	0,0,0		; ... where its line starts
  2E21'   00 00 00              OPSHI:	DB	0,0,0		; ... where the next line does (OPPGD: the span's
                                				;   high end, whichever line that turned out to be)
  2E24'   00 00 00              OPTOGO: DB	0,0,0		; OPPGD: bytes still to take
  2E27'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  2E29'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  2E2B'   0000                  CNTV:	DW	0		; motion repeat counter
  2E2D'   0000                  WKI:	DW	0		; scan index
  2E2F'   0000                  WKTERM: DW	0		; line terminator offset
  2E31'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  2E33'   00                    WKCLS:	DB	0		; word motion: class of the current run
  2E34'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  2E35'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  2E37'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  2E39'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
  2E3B'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  2E3D'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  2E3E'   00                    RLMAX:	DB	0		; RDLINE: capacity
  2E3F'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  2E40'   00                    EXARG:	DB	0		; ex: 0 = no file name given
	MACRO-80 3.44	09-Dec-81	PAGE	1-143


  2E41'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  2E42'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  2E44'   00                    WPROW:	DB	0		; :w -- the cursor's row
  2E45'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  2E46'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2E48'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  2E4A'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  2E4B'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  2E4D'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  2E4F'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  2E50'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  2E51'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  2E52'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  2E53'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  2E54'   00                    PLUSF:	DB	0		; command line: '+' was given
  2E55'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  2E56'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  2E57'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  2E58'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  2E5A'   0000                  YPT:	DW	0		; yy: where the lines came from
  2E5C'   0000                  PCNT:	DW	0		; p/P: copies still to put
  2E5E'   00 00 00              PPFP:	DB	0,0,0		; p/P: the first line put, a file position
  2E61'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  2E63'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  2E64'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  2E66'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  2E67'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  2E68'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  2E69'   00                    FNDKND: DB	0		; f/F/t/T: which find ';' repeats (0 = none yet)
  2E6A'   00                    FNDCH:	DB	0		; ... and the character it looked for
  2E6B'   00                    FNDRUN: DB	0		; the find THIS command is running (',' reverses)
  2E6C'   00                    FNDSTP: DB	0		; how far along it starts: 2 for a 't' repeat
  2E6D'   0000                  FNDN:	DW	0		; occurrences still to count off
  2E6F'   0000                  FNDCUR: DW	0		; the cursor it started from
  2E71'   0000                  FNDLIM: DW	0		; ... and the end of the line it may not pass
  2E73'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  2E74'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  2E77'   00 00 00              MKEDIT: DB	0,0,0		; MKSHFT: where in the file the edit is
  2E7A'   0000                  MKN:	DW	0		; ... how long it is
  2E7C'   00                    MKTYP:	DB	0		; ... and which way: 1 text went in, 2 came out
  2E7D'   00 00 00              MKPOS:	DB	0,0,0		; MKJMP: the file position being jumped to
  2E80'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  2E81'   00                    MKHOLD: DB	0		; set across YKGO's delete + put back (a yank
                                				;   that could not copy): MKSHFT must leave the
                                				;   marks alone through it
  2E82'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  2E84'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  2E86'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  2E88'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  2E8A'   00 00 00              YPFP:	DB	0,0,0		; ... and where in the file they start
                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  2E8D'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  2E8F'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
	MACRO-80 3.44	09-Dec-81	PAGE	1-144


  2E91'   0000                  SCNT:	DW	0		; searches still to do (the count)
  2E93'   00 00 00              SOFF:	DB	0,0,0		; BRKON: where in the FILE the command began
  2E96'   0000                  SLDLT:	DW	0		; ... and LNDLT: for a search that fails, and
                                				;   any move an ESC stops
  2E98'   00                    BRKARM: DB	0		; nonzero: CNTTST looks for an ESC
  2E99'   00                    BRKHIT: DB	0		; nonzero: one was found, and the count spent
  2E9A'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  2E9B'   00                    SRNGF:	DB	0		; ex: a line range was given
  2E9C'   0000                  SRNG1:	DW	0		; ex: its first line
  2E9E'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  2EA0'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  2EA1'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  2EA2'   00                    SANY:	DB	0		; ':s' something in the range has changed
  2EA3'   00                    SLCHG:	DB	0		; ':s' this line changed
  2EA4'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  2EA6'   0000                  SLINES: DW	0		; ':s' / ':N,Mw' lines of the range still to do
  2EA8'   00                    RWPTR:	DB	0		; ':N,Mw' the next free byte of the record at
                                				;   0080H, as that address's low byte
  2EA9'   00                    RWERR:	DB	0		; ':N,Mw' a record would not go: the disk is full
  2EAA'   00                    RDANY:	DB	0		; ':r' something has been read in
  2EAB'   00                    RDBRK:	DB	0		; ':r' the line above wants a line end first
  2EAC'   00 00 00              SOFFS:	DB	0,0,0		; ':s' the cursor's place in the file, for one that
  2EAF'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  2EB1'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  2EB2'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
