  0BAE'   2A 0000*              	LHLD	LNDLT
  0BB1'   7C                    	MOV	A,H
  0BB2'   FE C0                 	CPI	0C0H
  0BB4'   CA 0BBB'              	JZ	LN_X
  0BB7'   2B                    	DCX	H
  0BB8'                         LN_ST:
  0BB8'   22 0000*              	SHLD	LNDLT
  0BBB'                         LN_X:
  0BBB'   E1                    	POP	H
  0BBC'   C9                    	RET
                                
  0BBD'   AF                    VC_E:	XRA	A
  0BBE'   32 2693'              	STA	WBIG
  0BC1'   C3 0BC9'              	JMP	EDO
  0BC4'   3E 01                 VCBGE:	MVI	A,1
  0BC6'   32 2693'              	STA	WBIG
  0BC9'   CD 06DB'              EDO:	CALL	SETMOV
  0BCC'   CD 066E'              	CALL	GETCNT
  0BCF'   22 26CB'              	SHLD	CNTV
  0BD2'   2A 26CB'              EDO_LP: LHLD	CNTV
  0BD5'   7C                    	MOV	A,H
