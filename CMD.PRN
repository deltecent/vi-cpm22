  2DC9'   52                    	DB	'R'
  2DCA'   1AD7'                 	DW	VCB_R
  2DCC'   64                    	DB	'd'
  2DCD'   1AEC'                 	DW	VC_D
  2DCF'   44                    	DB	'D'
  2DD0'   1855'                 	DW	VCB_D
