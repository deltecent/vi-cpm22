  1D33'   74 74 65 6E           
  1D37'   00                    
                                
                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  1D38'                         EXTAB:
  1D38'   77 00 01              	DB	'w',0,EO_W
  1D3B'   71 00 02              	DB	'q',0,EO_Q
  1D3E'   77 71 03              	DB	'w','q',EO_WQ
  1D41'   78 00 04              	DB	'x',0,EO_X
  1D44'   65 00 05              	DB	'e',0,EO_E
  1D47'   73 00 06              	DB	's',0,EO_S
  1D4A'   76 65 07              	DB	'v','e',EO_V
  1D4D'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  1D4E'                         EXADDR:
  1D4E'   AF                    	XRA	A
  1D4F'   32 23D1'              	STA	SRNGF
  1D52'   7E                    	MOV	A,M
  1D53'   FE 25                 	CPI	'%'
  1D55'   CA 1D7E'              	JZ	EXA_AL
  1D58'   EB                    	XCHG			; DE walks the line, HL takes the number
  1D59'   CD 1D93'              	CALL	EXNUM
  1D5C'   DA 1D7C'              	JC	EXA_NO
  1D5F'   22 23D2'              	SHLD	SRNG1
  1D62'   22 23D4'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  1D65'   1A                    	LDAX	D
  1D66'   FE 2C                 	CPI	','
  1D68'   C2 1D75'              	JNZ	EXA_YS
  1D6B'   13                    	INX	D
  1D6C'   CD 1D93'              	CALL	EXNUM
  1D6F'   DA 1D7C'              	JC	EXA_NO		; ',' with no number: not a range at all
  1D72'   22 23D4'              	SHLD	SRNG2
  1D75'                         EXA_YS:
  1D75'   EB                    	XCHG
  1D76'   3E 01                 	MVI	A,1
  1D78'   32 23D1'              	STA	SRNGF
  1D7B'   C9                    	RET
  1D7C'                         EXA_NO:
  1D7C'   EB                    	XCHG
  1D7D'   C9                    	RET
  1D7E'                         EXA_AL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1D7E'   23                    	INX	H
  1D7F'   E5                    	PUSH	H
  1D80'   21 0001               	LXI	H,1
  1D83'   22 23D2'              	SHLD	SRNG1
  1D86'   21 FFFF               	LXI	H,0FFFFH
  1D89'   22 23D4'              	SHLD	SRNG2
  1D8C'   E1                    	POP	H
  1D8D'   3E 01                 	MVI	A,1
  1D8F'   32 23D1'              	STA	SRNGF
  1D92'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  1D93'                         EXNUM:
  1D93'   1A                    	LDAX	D
  1D94'   D6 30                 	SUI	'0'
  1D96'   D8                    	RC
  1D97'   FE 0A                 	CPI	10
  1D99'   3F                    	CMC
  1D9A'   D8                    	RC
  1D9B'   21 0000               	LXI	H,0
  1D9E'                         EXN_LP:
  1D9E'   1A                    	LDAX	D
  1D9F'   D6 30                 	SUI	'0'
  1DA1'   DA 1DBB'              	JC	EXN_DN
  1DA4'   FE 0A                 	CPI	10
  1DA6'   D2 1DBB'              	JNC	EXN_DN
  1DA9'   13                    	INX	D
  1DAA'   C5                    	PUSH	B
  1DAB'   4F                    	MOV	C,A
  1DAC'   06 00                 	MVI	B,0		; BC = the digit
  1DAE'   D5                    	PUSH	D
  1DAF'   54                    	MOV	D,H
  1DB0'   5D                    	MOV	E,L
  1DB1'   29                    	DAD	H		; *2
  1DB2'   29                    	DAD	H		; *4
  1DB3'   19                    	DAD	D		; *5
  1DB4'   29                    	DAD	H		; *10
  1DB5'   D1                    	POP	D
  1DB6'   09                    	DAD	B
  1DB7'   C1                    	POP	B
  1DB8'   C3 1D9E'              	JMP	EXN_LP
  1DBB'                         EXN_DN:
  1DBB'   B7                    	ORA	A		; CY clear: there was a number
  1DBC'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  1DBD'                         EX_S:
  1DBD'   7E                    	MOV	A,M
  1DBE'   B7                    	ORA	A
  1DBF'   CA 1E01'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  1DC2'   32 23D6'              	STA	SDELIM
  1DC5'   23                    	INX	H
  1DC6'   11 0000*              	LXI	D,SRCHST
  1DC9'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1DCC'   4F                    	MOV	C,A
  1DCD'   CD 1E07'              	CALL	SCOPY
  1DD0'   78                    	MOV	A,B
  1DD1'   B7                    	ORA	A
  1DD2'   CA 1E01'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  1DD5'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  1DD8'   3E 01                 	MVI	A,1
  1DDA'   32 23AF'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  1DDD'   11 23E3'              	LXI	D,SREPL
  1DE0'   0E 24                 	MVI	C,SREPMX
  1DE2'   CD 1E07'              	CALL	SCOPY
  1DE5'   78                    	MOV	A,B
  1DE6'   32 23E2'              	STA	SREPLN
  1DE9'   AF                    	XRA	A
  1DEA'   32 23D7'              	STA	SGFLAG
  1DED'   7E                    	MOV	A,M
  1DEE'   FE 67                 	CPI	'g'
  1DF0'   C2 1DF9'              	JNZ	EX_SG
  1DF3'   23                    	INX	H
  1DF4'   3E 01                 	MVI	A,1
  1DF6'   32 23D7'              	STA	SGFLAG
  1DF9'                         EX_SG:
  1DF9'   7E                    	MOV	A,M
  1DFA'   B7                    	ORA	A
  1DFB'   C2 1BEF'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  1DFE'   C3 1E27'              	JMP	SUBGO
  1E01'                         SUBNOP:
  1E01'   21 1C9B'              	LXI	H,SNOPAT
  1E04'   C3 1BFD'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  1E07'                         SCOPY:
  1E07'   06 00                 	MVI	B,0
  1E09'                         SCP_LP:
  1E09'   78                    	MOV	A,B
  1E0A'   B9                    	CMP	C
  1E0B'   D2 1E24'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  1E0E'   7E                    	MOV	A,M
  1E0F'   B7                    	ORA	A
  1E10'   CA 1E24'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  1E13'   E5                    	PUSH	H
  1E14'   21 23D6'              	LXI	H,SDELIM
  1E17'   BE                    	CMP	M
  1E18'   E1                    	POP	H
  1E19'   CA 1E23'              	JZ	SCP_SK
  1E1C'   12                    	STAX	D
  1E1D'   13                    	INX	D
  1E1E'   23                    	INX	H
  1E1F'   04                    	INR	B
  1E20'   C3 1E09'              	JMP	SCP_LP
  1E23'                         SCP_SK:
  1E23'   23                    	INX	H
  1E24'                         SCP_DN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1E24'   AF                    	XRA	A
  1E25'   12                    	STAX	D
  1E26'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  1E27'                         SUBGO:
  1E27'   CD 0CDE'              	CALL	GZONE
  1E2A'   2A 0000*              	LHLD	LNDLT
  1E2D'   22 23E0'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  1E30'   CD 0000*              	CALL	CUROFF		;   finds nothing puts both back, as the
  1E33'   22 23DE'              	SHLD	SOFFS		;   search's SN_BAD does
  1E36'   AF                    	XRA	A
  1E37'   32 23D8'              	STA	SANY
  1E3A'   21 0000               	LXI	H,0
  1E3D'   22 23DA'              	SHLD	SBACK
  1E40'   3A 23D1'              	LDA	SRNGF
  1E43'   B7                    	ORA	A
  1E44'   CA 1E6D'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  1E47'   2A 23D2'              	LHLD	SRNG1
  1E4A'   7C                    	MOV	A,H
  1E4B'   B5                    	ORA	L
  1E4C'   CA 1EE9'              	JZ	SUBBAD		; ':0s' -- there is no line 0
  1E4F'   2A 23D4'              	LHLD	SRNG2
  1E52'   EB                    	XCHG
  1E53'   2A 23D2'              	LHLD	SRNG1
  1E56'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  1E59'   DA 1EE9'              	JC	SUBBAD		; backwards: vim offers to swap, this refuses
  1E5C'   EB                    	XCHG			; HL = the last line, DE = the first
  1E5D'   CD 0000*              	CALL	SUBHD
  1E60'   23                    	INX	H		; HL = the lines in the range
  1E61'   22 23DC'              	SHLD	SLINES
  1E64'   2A 23D2'              	LHLD	SRNG1
  1E67'   CD 0C6C'              	CALL	GOLN
  1E6A'   C3 1E73'              	JMP	SUBLP
  1E6D'                         SUB_1L:
  1E6D'   21 0001               	LXI	H,1
  1E70'   22 23DC'              	SHLD	SLINES
  1E73'                         SUBLP:
  1E73'   CD 1EEF'              	CALL	SUBLIN		; A = 1 when this line changed
  1E76'   B7                    	ORA	A
  1E77'   CA 1E85'              	JZ	SUB_NX
  1E7A'   3E 01                 	MVI	A,1
  1E7C'   32 23D8'              	STA	SANY
  1E7F'   21 0000               	LXI	H,0
  1E82'   22 23DA'              	SHLD	SBACK		; the cursor is ON the last line changed
  1E85'                         SUB_NX:
  1E85'   2A 23DC'              	LHLD	SLINES
  1E88'   2B                    	DCX	H
  1E89'   22 23DC'              	SHLD	SLINES
  1E8C'   7C                    	MOV	A,H
  1E8D'   B5                    	ORA	L
  1E8E'   CA 1EAC'              	JZ	SUBDON		; the range is spent
  1E91'   21 0001               	LXI	H,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1E94'   AF                    	XRA	A
  1E95'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  1E98'   3A 23D8'              	LDA	SANY
  1E9B'   B7                    	ORA	A
  1E9C'   CA 1EA6'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  1E9F'   2A 23DA'              	LHLD	SBACK
  1EA2'   23                    	INX	H
  1EA3'   22 23DA'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  1EA6'                         SUB_AE:
  1EA6'   CD 07B1'              	CALL	ATEOF
  1EA9'   D2 1E73'              	JNC	SUBLP		; ... unless that ran off the end of the file
  1EAC'                         SUBDON:
  1EAC'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  1EAF'   3A 23D8'              	LDA	SANY
  1EB2'   B7                    	ORA	A
  1EB3'   CA 1ED1'              	JZ	SUBNFD
  1EB6'   3E 01                 	MVI	A,1
  1EB8'   32 2334'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  1EBB'   2A 23DA'              	LHLD	SBACK
  1EBE'   7C                    	MOV	A,H
  1EBF'   B5                    	ORA	L
  1EC0'   CA 1ECB'              	JZ	SUB_PL
  1EC3'   3E FF                 	MVI	A,0FFH
  1EC5'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  1EC8'   CD 0000*              	CALL	CLRCNT
  1ECB'                         SUB_PL:
  1ECB'   CD 0CF6'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  1ECE'   C3 0528'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  1ED1'                         SUBNFD:
  1ED1'   2A 23DE'              	LHLD	SOFFS
  1ED4'   CD 0000*              	CALL	GOTO
  1ED7'   2A 23E0'              	LHLD	SLDLTS
  1EDA'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  1EDD'   21 1C87'              	LXI	H,SNOTFD
  1EE0'   CD 1BFD'              	CALL	EXERR
  1EE3'   21 0000*              	LXI	H,SRCHST
  1EE6'   C3 1BF8'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  1EE9'                         SUBBAD:
  1EE9'   21 1C75'              	LXI	H,SNOT
  1EEC'   C3 1BF2'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  1EEF'                         SUBLIN:
  1EEF'   AF                    	XRA	A
  1EF0'   32 23D9'              	STA	SLCHG
  1EF3'   CD 1F6E'              	CALL	SUBBOL
  1EF6'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  1EF9'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  1EF9'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  1EFC'   DA 1F04'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  1EFF'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  1F01'   C2 1EF9'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  1F04'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  1F04'   CD 0000*              	CALL	CUROFF
  1F07'   E5                    	PUSH	H
  1F08'   CD 105F'              	CALL	CEND
  1F0B'   D1                    	POP	D
  1F0C'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  1F0F'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  1F10'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  1F13'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  1F14'   B7                    	ORA	A		;   span is a line, not a pair.)
  1F15'   FA 1F67'              	JM	SUBL_D		; what is left is shorter than the pattern
  1F18'   44                    	MOV	B,H
  1F19'   4D                    	MOV	C,L		; BC = the start positions a match can take
  1F1A'   11 0000*              	LXI	D,SRCHST
  1F1D'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  1F20'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  1F23'   DA 1F67'              	JC	SUBL_D
  1F26'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  1F29'   EB                    	XCHG
  1F2A'   2A 0000*              	LHLD	GAPEND
  1F2D'   EB                    	XCHG
  1F2E'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  1F31'   EB                    	XCHG
  1F32'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  1F33'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  1F36'   D1                    	POP	D
  1F37'   19                    	DAD	D		; ... and so the match's logical offset
  1F38'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  1F3B'   3A 23D8'              	LDA	SANY
  1F3E'   B7                    	ORA	A
  1F3F'   C2 1F4C'              	JNZ	SUBL_C
  1F42'   3A 23D9'              	LDA	SLCHG
  1F45'   B7                    	ORA	A
  1F46'   C2 1F4C'              	JNZ	SUBL_C
  1F49'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  1F4C'                         SUBL_C:
  1F4C'   3A 0000*              	LDA	SRCHBF
  1F4F'   6F                    	MOV	L,A
  1F50'   26 00                 	MVI	H,0
  1F52'   CD 0000*              	CALL	DELFWD		; the match goes
  1F55'   11 23E2'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  1F58'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  1F5B'                         SUBL_I:
  1F5B'   3E 01                 	MVI	A,1
  1F5D'   32 23D9'              	STA	SLCHG
  1F60'   3A 23D7'              	LDA	SGFLAG
  1F63'   B7                    	ORA	A
  1F64'   C2 1F04'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  1F67'                         SUBL_D:
  1F67'   CD 1F6E'              	CALL	SUBBOL
  1F6A'   3A 23D9'              	LDA	SLCHG
  1F6D'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  1F6E'                         SUBBOL:
  1F6E'   CD 0000*              	CALL	CUROFF
  1F71'   CD 03EB'              	CALL	BOL
  1F74'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  1F77'                         VC_SRCH:
  1F77'   CD 0507'              	CALL	SETMOV
  1F7A'   C5                    	PUSH	B
  1F7B'   CD 049A'              	CALL	GETCNT
  1F7E'   22 23CA'              	SHLD	SCNT
  1F81'   C1                    	POP	B
  1F82'   79                    	MOV	A,C
  1F83'   FE 2F                 	CPI	'/'
  1F85'   3E 00                 	MVI	A,0
  1F87'   CA 1F8C'              	JZ	VS_DIR
  1F8A'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  1F8C'                         VS_DIR:
  1F8C'   32 23AD'              	STA	SDIR
  1F8F'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  1F92'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  1F95'   47                    	MOV	B,A
  1F96'   CD 1752'              	CALL	RDLINE
  1F99'   B7                    	ORA	A
  1F9A'   C0                    	RNZ			; cancelled: nothing happens at all
  1F9B'   3A 2385'              	LDA	RLLEN
  1F9E'   B7                    	ORA	A
  1F9F'   CA 1FB4'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  1FA2'   5F                    	MOV	E,A
  1FA3'   16 00                 	MVI	D,0
  1FA5'   21 0000*              	LXI	H,SRCHST
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1FA8'   19                    	DAD	D
  1FA9'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  1FAB'   7B                    	MOV	A,E
  1FAC'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  1FAF'   3E 01                 	MVI	A,1
  1FB1'   32 23AF'              	STA	SHAVE
  1FB4'                         VS_OLD:
  1FB4'   3A 23AF'              	LDA	SHAVE
  1FB7'   B7                    	ORA	A
  1FB8'   CA 1FC4'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  1FBB'   3A 23AD'              	LDA	SDIR
  1FBE'   32 23AE'              	STA	SDIRE
  1FC1'   C3 1FED'              	JMP	SRCHN
  1FC4'                         VS_NOP:
  1FC4'   21 1C9B'              	LXI	H,SNOPAT
  1FC7'   C3 1BFD'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  1FCA'                         VC_N:
  1FCA'   CD 0507'              	CALL	SETMOV
  1FCD'   3A 23AD'              	LDA	SDIR
  1FD0'   C3 1FDA'              	JMP	VN_GO
  1FD3'                         VCB_N:
  1FD3'   CD 0507'              	CALL	SETMOV
  1FD6'   3A 23AD'              	LDA	SDIR
  1FD9'   2F                    	CMA			; the other way: 0 <-> FFH
  1FDA'                         VN_GO:
  1FDA'   32 23AE'              	STA	SDIRE
  1FDD'   CD 049A'              	CALL	GETCNT
  1FE0'   22 23CA'              	SHLD	SCNT
  1FE3'   3A 23AF'              	LDA	SHAVE
  1FE6'   B7                    	ORA	A
  1FE7'   CA 1FC4'              	JZ	VS_NOP
  1FEA'   C3 1FED'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  1FED'                         SRCHN:
  1FED'   CD 0CDE'              	CALL	GZONE		; the screen's top line, before the cursor moves
  1FF0'   2A 0000*              	LHLD	LNDLT
  1FF3'   22 23CE'              	SHLD	SLDLT		; the sweep moves the cursor with PUTCUR, which
                                				;   does not maintain LNDLT (GOTO does)
  1FF6'   CD 0000*              	CALL	CUROFF
  1FF9'   22 23CC'              	SHLD	SOFF
  1FFC'                         SN_LP:
  1FFC'   CD 2034'              	CALL	SRCHGO
  1FFF'   DA 2019'              	JC	SN_BAD
  2002'   2A 23CA'              	LHLD	SCNT
  2005'   2B                    	DCX	H
  2006'   22 23CA'              	SHLD	SCNT
  2009'   7C                    	MOV	A,H
  200A'   B5                    	ORA	L
  200B'   C2 1FFC'              	JNZ	SN_LP
  200E'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  2011'   3E 01                 	MVI	A,1
  2013'   32 23B0'              	STA	GPKEEP		; land on the match, not the first non-blank
  2016'   C3 0CF6'              	JMP	GPLACE		; (which sets LNDLT itself)
  2019'                         SN_BAD:
  2019'   CD 0000*              	CALL	CLRCNT
  201C'   2A 23CC'              	LHLD	SOFF
  201F'   CD 0000*              	CALL	GOTO
  2022'   2A 23CE'              	LHLD	SLDLT
  2025'   22 0000*              	SHLD	LNDLT		; nothing moved: the row the cursor was on
  2028'   21 1C87'              	LXI	H,SNOTFD
  202B'   CD 1BFD'              	CALL	EXERR
  202E'   21 0000*              	LXI	H,SRCHST
  2031'   C3 1BF8'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  2034'                         SRCHGO:
  2034'   3E 01                 	MVI	A,1
  2036'   32 23D0'              	STA	SSKIP		; this pass starts one past the cursor
  2039'   CD 204B'              	CALL	SRCHW
  203C'   D0                    	RNC
  203D'   3A 23AE'              	LDA	SDIRE
  2040'   2F                    	CMA
  2041'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  2044'   AF                    	XRA	A
  2045'   32 23D0'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  2048'   C3 204B'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  204B'                         SRCHW:
  204B'   3A 23AE'              	LDA	SDIRE
  204E'   32 0000*              	STA	DIRFLG
  2051'   21 FFFF               	LXI	H,0FFFFH
  2054'   22 2331'              	SHLD	CMDCNT
  2057'   AF                    	XRA	A
  2058'   32 0000*              	STA	AUXCNT
  205B'                         SW_LP:
  205B'   CD 2067'              	CALL	SRCH1
  205E'   D0                    	RNC
  205F'   CD 0000*              	CALL	SCRLST
  2062'   D2 205B'              	JNC	SW_LP
  2065'   37                    	STC
  2066'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


                                ; a hit the cursor is ON the match's first character.
  2067'                         SRCH1:
  2067'   11 0000*              	LXI	D,SRCHST
  206A'   3A 0000*              	LDA	DIRFLG
  206D'   B7                    	ORA	A
  206E'   FA 2092'              	JM	SR1_BK
  2071'   21 0000*              	LXI	H,GAPEND
  2074'   CD 0000*              	CALL	FWDCNT
  2077'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  207A'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  207B'   3A 23D0'              	LDA	SSKIP
  207E'   B7                    	ORA	A
  207F'   CA 2088'              	JZ	SR1_FW
  2082'   78                    	MOV	A,B
  2083'   B1                    	ORA	C
  2084'   37                    	STC
  2085'   C8                    	RZ			; no room for a match even before the skip
  2086'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2087'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2088'                         SR1_FW:
  2088'   CD 0000*              	CALL	MATCHF
  208B'   D8                    	RC
  208C'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  208F'   C3 0000*              	JMP	PUTCUR
  2092'                         SR1_BK:
  2092'   21 0000*              	LXI	H,TXTBEG
  2095'   CD 0000*              	CALL	FWDCNT
  2098'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  209B'   D8                    	RC
  209C'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  209F'   CD 0000*              	CALL	MATCHB
  20A2'   D8                    	RC
  20A3'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; QSNAP -- snapshot cursor state into TOFFV/TLINEV/TCOLV (test hook).
                                ;============================================================
  20A6'                         QSNAP:
  20A6'   CD 0000*              	CALL	CUROFF
  20A9'   22 237D'              	SHLD	TOFFV
  20AC'   21 0000               	LXI	H,0
  20AF'   22 237F'              	SHLD	TLINEV
  20B2'   21 0000               	LXI	H,0
  20B5'   22 236B'              	SHLD	WKI
  20B8'                         QS_LP:
  20B8'   2A 236B'              	LHLD	WKI
  20BB'   EB                    	XCHG			; DE = i
  20BC'   2A 237D'              	LHLD	TOFFV
  20BF'   CD 0000*              	CALL	CMP16		; DE=i vs HL=cur: CY iff i < cur
  20C2'   D2 20E1'              	JNC	QS_COL
  20C5'   2A 236B'              	LHLD	WKI
  20C8'   CD 0000*              	CALL	CHARAT
  20CB'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  20CD'   C2 20D7'              	JNZ	QS_NX
  20D0'   2A 237F'              	LHLD	TLINEV
  20D3'   23                    	INX	H
  20D4'   22 237F'              	SHLD	TLINEV
  20D7'                         QS_NX:
  20D7'   2A 236B'              	LHLD	WKI
  20DA'   23                    	INX	H
  20DB'   22 236B'              	SHLD	WKI
  20DE'   C3 20B8'              	JMP	QS_LP
  20E1'                         QS_COL:
  20E1'   2A 237D'              	LHLD	TOFFV
  20E4'   CD 046D'              	CALL	COL
  20E7'   22 2381'              	SHLD	TCOLV
  20EA'   C9                    	RET
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  20EB'                         MSGNAM:
  20EB'   E5                    	PUSH	H
  20EC'   3E 22                 	MVI	A,'"'
  20EE'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  20F1'   E1                    	POP	H
  20F2'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  20F3'   23                    	INX	H
  20F4'   7E                    	MOV	A,M
  20F5'   FE 20                 	CPI	' '
  20F7'   C2 2104'              	JNZ	MN_HAS
  20FA'   21 1CEA'              	LXI	H,SNONM
  20FD'   CD 0000*              	CALL	OUTSTR
  2100'   E1                    	POP	H
  2101'   C3 214E'              	JMP	MN_END
  2104'                         MN_HAS:
  2104'   0E 19                 	MVI	C,BF_CURDSK
  2106'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  2109'   E1                    	POP	H
  210A'   E5                    	PUSH	H
  210B'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  210C'   BE                    	CMP	M
  210D'   CA 211B'              	JZ	MN_NAM
  2110'   7E                    	MOV	A,M
  2111'   C6 40                 	ADI	'A'-1
  2113'   CD 0000*              	CALL	OUTCH
  2116'   3E 3A                 	MVI	A,':'
  2118'   CD 0000*              	CALL	OUTCH
  211B'                         MN_NAM:
  211B'   E1                    	POP	H
  211C'   E5                    	PUSH	H
  211D'   23                    	INX	H
  211E'   0E 08                 	MVI	C,8
  2120'                         MN_NM:
  2120'   7E                    	MOV	A,M
  2121'   FE 20                 	CPI	' '
  2123'   CA 212E'              	JZ	MN_EXT
  2126'   CD 0000*              	CALL	OUTCH
  2129'   23                    	INX	H
  212A'   0D                    	DCR	C
  212B'   C2 2120'              	JNZ	MN_NM
  212E'                         MN_EXT:
  212E'   E1                    	POP	H
  212F'   11 0009               	LXI	D,9
  2132'   19                    	DAD	D		; the type field
  2133'   7E                    	MOV	A,M
  2134'   FE 20                 	CPI	' '
  2136'   CA 214E'              	JZ	MN_END
  2139'   3E 2E                 	MVI	A,'.'
  213B'   CD 0000*              	CALL	OUTCH
  213E'   0E 03                 	MVI	C,3
  2140'                         MN_XL:
  2140'   7E                    	MOV	A,M
  2141'   FE 20                 	CPI	' '
  2143'   CA 214E'              	JZ	MN_END
  2146'   CD 0000*              	CALL	OUTCH
  2149'   23                    	INX	H
  214A'   0D                    	DCR	C
  214B'   C2 2140'              	JNZ	MN_XL
  214E'                         MN_END:
  214E'   3E 22                 	MVI	A,'"'
  2150'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  2153'                         MSGFLG:
  2153'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  2155'   B7                    	ORA	A
  2156'   CA 2166'              	JZ	MF_RO
  2159'   3A 2334'              	LDA	MODF
  215C'   B7                    	ORA	A
  215D'   CA 2166'              	JZ	MF_RO
  2160'   21 1CF4'              	LXI	H,SMODM
  2163'   CD 217B'              	CALL	MF_PUT
  2166'                         MF_RO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  2166'   3A 239B'              	LDA	ROFLAG
  2169'   B7                    	ORA	A
  216A'   CA 2173'              	JZ	MF_NEW
  216D'   21 1CFF'              	LXI	H,SROM
  2170'   CD 217B'              	CALL	MF_PUT
  2173'                         MF_NEW:
  2173'   3A 2399'              	LDA	MSGNEW
  2176'   B7                    	ORA	A
  2177'   C8                    	RZ
  2178'   21 1D0A'              	LXI	H,SNEWM
  217B'                         MF_PUT:
  217B'   78                    	MOV	A,B
  217C'   B7                    	ORA	A
  217D'   C2 2189'              	JNZ	MF_STR
  2180'   06 01                 	MVI	B,1
  2182'   E5                    	PUSH	H
  2183'   3E 20                 	MVI	A,' '
  2185'   CD 0000*              	CALL	OUTCH
  2188'   E1                    	POP	H
  2189'                         MF_STR:
  2189'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  218C'                         EMITW:
  218C'   C5                    	PUSH	B
  218D'   D5                    	PUSH	D
  218E'   06 00                 	MVI	B,0
  2190'   11 2710               	LXI	D,10000
  2193'   CD 21B1'              	CALL	EWDIG
  2196'   11 03E8               	LXI	D,1000
  2199'   CD 21B1'              	CALL	EWDIG
  219C'   11 0064               	LXI	D,100
  219F'   CD 21B1'              	CALL	EWDIG
  21A2'   11 000A               	LXI	D,10
  21A5'   CD 21B1'              	CALL	EWDIG
  21A8'   7D                    	MOV	A,L		; the units digit is always printed
  21A9'   C6 30                 	ADI	'0'
  21AB'   CD 0000*              	CALL	OUTCH
  21AE'   D1                    	POP	D
  21AF'   C1                    	POP	B
  21B0'   C9                    	RET
  21B1'                         EWDIG:
  21B1'   0E 00                 	MVI	C,0
  21B3'                         EW_LP:
  21B3'   7D                    	MOV	A,L
  21B4'   93                    	SUB	E
  21B5'   6F                    	MOV	L,A
  21B6'   7C                    	MOV	A,H
  21B7'   9A                    	SBB	D
  21B8'   67                    	MOV	H,A
  21B9'   DA 21C0'              	JC	EW_DN
  21BC'   0C                    	INR	C
  21BD'   C3 21B3'              	JMP	EW_LP
  21C0'                         EW_DN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  21C0'   19                    	DAD	D		; one subtraction too many: give it back
  21C1'   79                    	MOV	A,C
  21C2'   B7                    	ORA	A
  21C3'   C2 21C9'              	JNZ	EW_PR
  21C6'   78                    	MOV	A,B
  21C7'   B7                    	ORA	A
  21C8'   C8                    	RZ			; a leading zero: write nothing
  21C9'                         EW_PR:
  21C9'   79                    	MOV	A,C
  21CA'   C6 30                 	ADI	'0'
  21CC'   CD 0000*              	CALL	OUTCH
  21CF'   06 01                 	MVI	B,1
  21D1'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  21D2'                         ISEMPT:
  21D2'   2A 0000*              	LHLD	OUTPOS
  21D5'   7C                    	MOV	A,H
  21D6'   B5                    	ORA	L
  21D7'   C0                    	RNZ
  21D8'   CD 0000*              	CALL	LOGLEN
  21DB'   7C                    	MOV	A,H
  21DC'   B5                    	ORA	L
  21DD'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  21DE'                         MSGCTG:
  21DE'   21 0000*              	LXI	H,FNAME
  21E1'   CD 20EB'              	CALL	MSGNAM
  21E4'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  21E6'   CD 2153'              	CALL	MSGFLG
  21E9'   CD 21D2'              	CALL	ISEMPT
  21EC'   C2 21F5'              	JNZ	MG_POS
  21EF'   21 1D1D'              	LXI	H,SNOLIN
  21F2'   C3 0000*              	JMP	OUTSTR
  21F5'                         MG_POS:
  21F5'   21 1D10'              	LXI	H,SLINE
  21F8'   CD 0000*              	CALL	OUTSTR
  21FB'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  21FE'   23                    	INX	H		;   ... so the line it is on
  21FF'   CD 218C'              	CALL	EMITW
  2202'   21 1D17'              	LXI	H,SCOLM
  2205'   CD 0000*              	CALL	OUTSTR
  2208'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  220B'   23                    	INX	H
  220C'   E5                    	PUSH	H
  220D'   CD 218C'              	CALL	EMITW
  2210'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  2213'   23                    	INX	H
  2214'   D1                    	POP	D
  2215'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  2218'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  2219'   E5                    	PUSH	H
  221A'   3E 2D                 	MVI	A,'-'
  221C'   CD 0000*              	CALL	OUTCH
  221F'   E1                    	POP	H
  2220'   C3 218C'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  2223'                         FILMSG:
  2223'   3A 0001*              	LDA	FNAME+1
  2226'   FE 20                 	CPI	' '
  2228'   C8                    	RZ
  2229'   21 0000*              	LXI	H,FNAME
  222C'   CD 20EB'              	CALL	MSGNAM
  222F'   AF                    	XRA	A		; nothing has been changed yet
  2230'   C3 2153'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  2233'                         WRMSG:
  2233'   21 0000*              	LXI	H,TFCB
  2236'   CD 20EB'              	CALL	MSGNAM
  2239'   21 1D2F'              	LXI	H,SWRIT
  223C'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  223F'                         MSGPST:
  223F'   3A 2398'              	LDA	MSGWHT
  2242'   B7                    	ORA	A
  2243'   C8                    	RZ
  2244'   47                    	MOV	B,A
  2245'   AF                    	XRA	A
  2246'   32 2398'              	STA	MSGWHT
  2249'   78                    	MOV	A,B
  224A'   FE 01                 	CPI	MW_FIL
  224C'   CA 225A'              	JZ	MP_FIL
  224F'   FE 02                 	CPI	MW_WRT
  2251'   CA 2260'              	JZ	MP_WRT
  2254'   CD 21DE'              	CALL	MSGCTG
  2257'   C3 0000*              	JMP	SCURS
  225A'                         MP_FIL:
  225A'   CD 2223'              	CALL	FILMSG
  225D'   C3 0000*              	JMP	SCURS
  2260'                         MP_WRT:
  2260'   CD 2233'              	CALL	WRMSG
  2263'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  2266'                         VC_CTLG:
  2266'   3E 03                 	MVI	A,MW_CTG
  2268'   32 2398'              	STA	MSGWHT
  226B'   3E 01                 	MVI	A,R_MOVE
