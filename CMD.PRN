  0970'   B3                    	ORA	E
  0971'   C2 0960'              	JNZ	JC_SC
  0974'   2A 2A93'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  0977'   22 2A97'              	SHLD	JKMOV		;   one if the last LF found ends the file
  097A'   3E 01                 	MVI	A,1
  097C'   32 2A9B'              	STA	JKPHN
  097F'   C3 099D'              	JMP	JC_MV
  0982'                         JC_EOF:
  0982'   2A 2A95'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  0985'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  0988'   7C                    	MOV	A,H
  0989'   B5                    	ORA	L
  098A'   CA 0996'              	JZ	JC_AV
  098D'   3A 2A9C'              	LDA	JKLST
  0990'   FE 0A                 	CPI	LF
  0992'   C2 0996'              	JNZ	JC_AV
  0995'   2B                    	DCX	H
  0996'                         JC_AV:
  0996'   22 2A97'              	SHLD	JKMOV
  0999'   AF                    	XRA	A
  099A'   32 2A9B'              	STA	JKPHN
  099D'                         JC_MV:
  099D'   2A 2A93'              	LHLD	JKCNT
  09A0'   AF                    	XRA	A
  09A1'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  09A4'   CD 0A63'              	CALL	ATEOF
  09A7'   D2 09BB'              	JNC	JC_DN
  09AA'   CD 0A69'              	CALL	LASTLN		; ran past the last line: back onto it
  09AD'   3A 2A9B'              	LDA	JKPHN
  09B0'   B7                    	ORA	A
  09B1'   CA 09BB'              	JZ	JC_DN
  09B4'   2A 2A97'              	LHLD	JKMOV
  09B7'   2B                    	DCX	H
  09B8'   22 2A97'              	SHLD	JKMOV
  09BB'                         JC_DN:
  09BB'   2A 2A95'              	LHLD	JKN		; LNDLT += min(moved, N)
  09BE'   EB                    	XCHG
  09BF'   2A 2A97'              	LHLD	JKMOV
  09C2'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  09C5'   D2 09C9'              	JNC	JC_AD
  09C8'   EB                    	XCHG
  09C9'                         JC_AD:
  09C9'   EB                    	XCHG			; DE = lines moved
  09CA'   2A 0000*              	LHLD	LNDLT
  09CD'   19                    	DAD	D
  09CE'   22 0000*              	SHLD	LNDLT
  09D1'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  09D2'                         KCORE:
  09D2'   7C                    	MOV	A,H
  09D3'   B5                    	ORA	L
  09D4'   C8                    	RZ
  09D5'   22 2A93'              	SHLD	JKCNT
  09D8'   CD 0D47'              	CALL	CURRW		; limit = row + NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  09DB'   5F                    	MOV	E,A
  09DC'   16 00                 	MVI	D,0
  09DE'   3A 0000*              	LDA	NEDIT
  09E1'   6F                    	MOV	L,A
  09E2'   26 00                 	MVI	H,0
  09E4'   19                    	DAD	D
  09E5'   EB                    	XCHG			; DE = limit
  09E6'   2A 2A93'              	LHLD	JKCNT
  09E9'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  09EC'   D2 09F0'              	JNC	KC_N
  09EF'   EB                    	XCHG			; HL = limit
  09F0'                         KC_N:
  09F0'   22 2A95'              	SHLD	JKN		; N = min(count, limit)
  09F3'   EB                    	XCHG			; DE = LFs to find
  09F4'   21 0000               	LXI	H,0
  09F7'   22 2A99'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  09FA'                         KC_ED:
