  09F2'   CD 09F8'              	CALL	ESTEP
  09F5'   C3 09E8'              	JMP	EDO_LP
                                
                                ;ESTEP -- forward to the end of the next word.
  09F8'                         ESTEP:
  09F8'   CD 0000*              	CALL	CUROFF
  09FB'   22 22B4'              	SHLD	WKI
  09FE'   CD 0000*              	CALL	LOGLEN
  0A01'   22 22B6'              	SHLD	WKN
  0A04'   2A 22B4'              	LHLD	WKI
  0A07'   23                    	INX	H
  0A08'   22 22B4'              	SHLD	WKI
  0A0B'                         ES_WS:
  0A0B'   2A 22B4'              	LHLD	WKI
  0A0E'   EB                    	XCHG
  0A0F'   2A 22B6'              	LHLD	WKN
  0A12'   CD 0000*              	CALL	CMP16
  0A15'   D2 0A63'              	JNC	ES_LND
  0A18'   2A 22B4'              	LHLD	WKI
  0A1B'   CD 0000*              	CALL	CHARAT
  0A1E'   CD 04A6'              	CALL	CLASSF
  0A21'   B7                    	ORA	A
