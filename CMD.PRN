  1C9E'                         ISLOW:
  1C9E'   7E                    	MOV	A,M
  1C9F'   FE 61                 	CPI	'a'
  1CA1'   D8                    	RC
  1CA2'   FE 7B                 	CPI	'z'+1
  1CA4'   3F                    	CMC
