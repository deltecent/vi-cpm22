  23DA'   69 66 69 65           
  23DE'   64 5D 00              
  23E1'   5B 72 65 61           SROM:	DB	'[readonly]',0
  23E5'   64 6F 6E 6C           
  23E9'   79 5D 00              
  23EC'   5B 4E 65 77           SNEWM:	DB	'[New]',0
