  29D9'   77 00 01              	DB	'w',0,EO_W
  29DC'   71 00 02              	DB	'q',0,EO_Q
  29DF'   77 71 03              	DB	'w','q',EO_WQ
  29E2'   78 00 04              	DB	'x',0,EO_X
  29E5'   65 00 05              	DB	'e',0,EO_E
  29E8'   73 00 06              	DB	's',0,EO_S
