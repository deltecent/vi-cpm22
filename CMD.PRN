  222F'   21 229E'              	LXI	H,SINV
  2232'   C3 2249'              	JMP	EXERR
  2235'                         EX_V:				; :ve -- the version, on the bottom row
  2235'   21 2259'              	LXI	H,SVER
  2238'   C3 2249'              	JMP	EXERR
  223B'                         EX_TRL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  223B'   21 22B0'              	LXI	H,STRL
