  0A40'   E5                    	PUSH	H
  0A41'   C5                    	PUSH	B
  0A42'   2A 29A4'              	LHLD	JKVC
  0A45'   CD 05D1'              	CALL	CWID
  0A48'   B7                    	ORA	A
  0A49'   CA 0A6C'              	JZ	JL_NX		; a CR
  0A4C'   EB                    	XCHG
