  0A41'                         KC_MV:
  0A41'   E5                    	PUSH	H
  0A42'   2A 2A7D'              	LHLD	JKCNT
  0A45'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0A48'   D1                    	POP	D		; DE = moved
  0A49'   2A 2A7F'              	LHLD	JKN
  0A4C'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0A4F'   DA 0A53'              	JC	KC_AD
  0A52'   EB                    	XCHG			; DE = N
  0A53'                         KC_AD:
  0A53'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0A56'   CD 0000*              	CALL	SUBHD
  0A59'   22 0000*              	SHLD	LNDLT
  0A5C'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0A5D'                         ATEOF:
  0A5D'   CD 0000*              	CALL	RGET0
  0A60'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0A63'                         LASTLN:
  0A63'   2A 0000*              	LHLD	GAPBEG
  0A66'   EB                    	XCHG
  0A67'   2A 0000*              	LHLD	TXTBEG
  0A6A'   CD 0000*              	CALL	CMP16
  0A6D'   21 0000               	LXI	H,0
  0A70'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0A73'   1B                    	DCX	D
  0A74'   1A                    	LDAX	D
  0A75'   FE 0A                 	CPI	LF
  0A77'   C2 0000*              	JNZ	SETBWD
  0A7A'   23                    	INX	H
  0A7B'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0A7E'                         JKLAND:
  0A7E'   21 0000               	LXI	H,0
  0A81'   22 2A87'              	SHLD	JKVC		; screen column
  0A84'   2B                    	DCX	H
  0A85'   22 2A89'              	SHLD	JKLS		; last content char: none yet
  0A88'   CD 0000*              	CALL	RGET0
  0A8B'   11 0000               	LXI	D,0		; DE = chars read
  0A8E'                         JL_RD:
  0A8E'   CD 0000*              	CALL	RDGET
  0A91'   DA 0ACB'              	JC	JL_END
  0A94'   FE 0A                 	CPI	LF
  0A96'   CA 0ACB'              	JZ	JL_END
  0A99'   E5                    	PUSH	H
  0A9A'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0A9B'   2A 2A87'              	LHLD	JKVC
  0A9E'   CD 0611'              	CALL	CWID
  0AA1'   B7                    	ORA	A
  0AA2'   CA 0AC5'              	JZ	JL_NX		; a CR
  0AA5'   EB                    	XCHG
  0AA6'   22 2A89'              	SHLD	JKLS		; the last content char so far
  0AA9'   EB                    	XCHG
  0AAA'   4F                    	MOV	C,A
  0AAB'   06 00                 	MVI	B,0
  0AAD'   09                    	DAD	B		; HL = the column after this char
  0AAE'   22 2A87'              	SHLD	JKVC
  0AB1'   D5                    	PUSH	D
  0AB2'   EB                    	XCHG
  0AB3'   2A 2A77'              	LHLD	GOALCOL
  0AB6'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0AB9'   D1                    	POP	D
  0ABA'   DA 0AC5'              	JC	JL_NX
  0ABD'   CA 0AC5'              	JZ	JL_NX
  0AC0'   C1                    	POP	B		; this char holds the goal column
  0AC1'   E1                    	POP	H
  0AC2'   C3 0AD6'              	JMP	JL_GO
  0AC5'                         JL_NX:
  0AC5'   C1                    	POP	B
  0AC6'   E1                    	POP	H
  0AC7'   13                    	INX	D
  0AC8'   C3 0A8E'              	JMP	JL_RD
  0ACB'                         JL_END:
  0ACB'   2A 2A89'              	LHLD	JKLS		; past the line's end: its last content char
  0ACE'   7C                    	MOV	A,H
  0ACF'   A5                    	ANA	L
  0AD0'   3C                    	INR	A
  0AD1'   C2 0AD5'              	JNZ	JL_LS
  0AD4'   23                    	INX	H		; no content: the line's start
  0AD5'                         JL_LS:
  0AD5'   EB                    	XCHG
  0AD6'                         JL_GO:
  0AD6'   D5                    	PUSH	D		; DE = step from the line start
  0AD7'   CD 0000*              	CALL	CUROFF
  0ADA'   D1                    	POP	D
  0ADB'   19                    	DAD	D
  0ADC'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0ADF'   AF                    VC_W:	XRA	A
  0AE0'   32 2A79'              	STA	WBIG
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0AE3'   C3 0AEB'              	JMP	WDO
  0AE6'   3E 01                 VCBGW:	MVI	A,1
  0AE8'   32 2A79'              	STA	WBIG
  0AEB'   CD 079A'              WDO:	CALL	SETMOV
  0AEE'   AF                    	XRA	A
  0AEF'   32 2A7A'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0AF2'   CD 06CB'              	CALL	GETCNT
  0AF5'   22 2AB1'              	SHLD	CNTV
  0AF8'   2A 2AB1'              WDO_LP: LHLD	CNTV
  0AFB'   7C                    	MOV	A,H
  0AFC'   B5                    	ORA	L
  0AFD'   CA 0B0A'              	JZ	WDO_DN
  0B00'   2B                    	DCX	H
  0B01'   22 2AB1'              	SHLD	CNTV
  0B04'   CD 0B67'              	CALL	FWD1
  0B07'   D2 0AF8'              	JNC	WDO_LP
  0B0A'                         WDO_DN:
  0B0A'   CD 0A5D'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0B0D'   DA 0B1A'              	JC	WDO_NL
  0B10'   FE 0D                 	CPI	CR
  0B12'   CA 0B1A'              	JZ	WDO_NL
  0B15'   FE 0A                 	CPI	LF
  0B17'   C2 05BD'              	JNZ	SETGL
  0B1A'                         WDO_NL:
  0B1A'   CD 0000*              	CALL	PEEKL
  0B1D'   DA 05BD'              	JC	SETGL
  0B20'   FE 0A                 	CPI	LF
  0B22'   CA 05BD'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0B25'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0B27'   32 2A7A'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0B2A'   CD 0C86'              	CALL	DECC		; back onto its last char
  0B2D'   C3 05BD'              	JMP	SETGL
                                
  0B30'   AF                    VC_B:	XRA	A
  0B31'   32 2A79'              	STA	WBIG
  0B34'   C3 0B3C'              	JMP	BDO
  0B37'   3E 01                 VCBGB:	MVI	A,1
  0B39'   32 2A79'              	STA	WBIG
  0B3C'   CD 079A'              BDO:	CALL	SETMOV
  0B3F'   CD 06CB'              	CALL	GETCNT
  0B42'   22 2AB1'              	SHLD	CNTV
  0B45'   CD 0BD7'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0B48'   D2 0B58'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0B4B'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0B4C'   32 2A99'              	STA	PSAVE		;   first char opened an insert).  A count that
  0B4F'   C3 05BD'              	JMP	SETGL		;   runs out at the start has still moved, and
  0B52'                         BDO_LP:				;   its operator stands -- both as vim
  0B52'   CD 0BD7'              	CALL	BCK1
  0B55'   DA 05BD'              	JC	SETGL
  0B58'   2A 2AB1'              BDO_NX: LHLD	CNTV
  0B5B'   2B                    	DCX	H
  0B5C'   22 2AB1'              	SHLD	CNTV
  0B5F'   7C                    	MOV	A,H
  0B60'   B5                    	ORA	L
  0B61'   C2 0B52'              	JNZ	BDO_LP
  0B64'   C3 05BD'              	JMP	SETGL
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
                                ; words before the last run on freely -- 'd2w' there takes the line break and
                                ; the next line's first word as well.
  0B67'                         FWD1:
  0B67'   CD 0C0A'              	CALL	CCLS
  0B6A'   32 2ABD'              	STA	WKCLS		; the starting class
  0B6D'   CD 0C44'              	CALL	INCC
  0B70'   B7                    	ORA	A
  0B71'   CA 0B8A'              	JZ	FW_WD
  0B74'   37                    	STC
  0B75'   F8                    	RM			; -1: already at the end
  0B76'   CD 0BC2'              	CALL	WLAST
  0B79'   C8                    	RZ
  0B7A'   FE 02                 	CPI	2
  0B7C'   C2 0B8A'              	JNZ	FW_WD		; 1: a next line was reached
  0B7F'   CD 0A5D'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0B82'   D4 0C2B'              	CNC	NXLN
  0B85'   D2 0B8A'              	JNC	FW_WD
  0B88'   37                    	STC			; yes: failed
  0B89'   C9                    	RET
  0B8A'                         FW_WD:
  0B8A'   3A 2ABD'              	LDA	WKCLS		; go past the rest of this word
  0B8D'   B7                    	ORA	A
  0B8E'   CA 0BAA'              	JZ	FW_WS
  0B91'                         FW_WLP:
  0B91'   CD 0C0A'              	CALL	CCLS
  0B94'   21 2ABD'              	LXI	H,WKCLS
  0B97'   BE                    	CMP	M
  0B98'   C2 0BAA'              	JNZ	FW_WS
  0B9B'   CD 0C44'              	CALL	INCC
  0B9E'   B7                    	ORA	A
  0B9F'   F8                    	RM			; the end of the file (NC)
  0BA0'   CA 0B91'              	JZ	FW_WLP
  0BA3'   CD 0BC2'              	CALL	WLAST
  0BA6'   C8                    	RZ
  0BA7'   C3 0B91'              	JMP	FW_WLP
  0BAA'                         FW_WS:
  0BAA'   CD 0C0A'              	CALL	CCLS		; then over blanks to the next word
  0BAD'   B7                    	ORA	A
  0BAE'   C0                    	RNZ
  0BAF'   CD 0C12'              	CALL	EMPTY
  0BB2'   C8                    	RZ			; an empty line is a word
  0BB3'   CD 0C44'              	CALL	INCC
  0BB6'   B7                    	ORA	A
  0BB7'   F8                    	RM
  0BB8'   CA 0BAA'              	JZ	FW_WS
  0BBB'   CD 0BC2'              	CALL	WLAST
  0BBE'   C8                    	RZ
  0BBF'   C3 0BAA'              	JMP	FW_WS
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


                                
                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0BC2'                         WLAST:
  0BC2'   47                    	MOV	B,A
  0BC3'   2A 2AB1'              	LHLD	CNTV
  0BC6'   7C                    	MOV	A,H
  0BC7'   B5                    	ORA	L
  0BC8'   C2 0BD3'              	JNZ	WL_X		; words still owed
  0BCB'   3A 2A99'              	LDA	PSAVE
  0BCE'   B7                    	ORA	A
  0BCF'   CA 0BD5'              	JZ	WL_NO		; a plain 'w'
  0BD2'   AF                    	XRA	A
  0BD3'   78                    WL_X:	MOV	A,B
  0BD4'   C9                    	RET
  0BD5'   B0                    WL_NO:	ORA	B
  0BD6'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0BD7'                         BCK1:
  0BD7'   CD 0C86'              	CALL	DECC
  0BDA'   B7                    	ORA	A
  0BDB'   37                    	STC
  0BDC'   F8                    	RM
  0BDD'                         BK_WS:
  0BDD'   CD 0C0A'              	CALL	CCLS		; back over blanks
  0BE0'   B7                    	ORA	A
  0BE1'   C2 0BF1'              	JNZ	BK_WD
  0BE4'   CD 0C12'              	CALL	EMPTY
  0BE7'   C8                    	RZ			; an empty line is a word
  0BE8'   CD 0C86'              	CALL	DECC
  0BEB'   B7                    	ORA	A
  0BEC'   F2 0BDD'              	JP	BK_WS
  0BEF'   AF                    	XRA	A		; the start of the file (NC)
  0BF0'   C9                    	RET
  0BF1'                         BK_WD:
  0BF1'   32 2ABD'              	STA	WKCLS		; back to the start of this word
  0BF4'                         BK_WLP:
  0BF4'   CD 0C86'              	CALL	DECC
  0BF7'   B7                    	ORA	A
  0BF8'   FA 0C08'              	JM	BK_OK		; the start of the file
  0BFB'   CD 0C0A'              	CALL	CCLS
  0BFE'   21 2ABD'              	LXI	H,WKCLS
  0C01'   BE                    	CMP	M
  0C02'   CA 0BF4'              	JZ	BK_WLP
  0C05'   CD 0C44'              	CALL	INCC		; overshot: forward one
  0C08'                         BK_OK:
  0C08'   AF                    	XRA	A
  0C09'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0C0A'                         CCLS:
  0C0A'   CD 0A5D'              	CALL	ATEOF
  0C0D'   D2 074F'              	JNC	CLASSF
  0C10'   AF                    	XRA	A
  0C11'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0C12'                         EMPTY:
  0C12'   CD 0A5D'              	CALL	ATEOF
  0C15'   DA 0C20'              	JC	EM_ST
  0C18'   FE 0D                 	CPI	CR
  0C1A'   CA 0C20'              	JZ	EM_ST
  0C1D'   FE 0A                 	CPI	LF
  0C1F'   C0                    	RNZ
  0C20'                         EM_ST:
  0C20'   CD 0000*              	CALL	PEEKL
  0C23'   DA 0C29'              	JC	EM_Y
  0C26'   FE 0A                 	CPI	LF
  0C28'   C9                    	RET
  0C29'                         EM_Y:
  0C29'   AF                    	XRA	A
  0C2A'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0C2B'                         NXLN:
  0C2B'   FE 0A                 	CPI	LF
  0C2D'   CA 0C3C'              	JZ	NX_LF
  0C30'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0C33'   D8                    	RC
  0C34'   FE 0A                 	CPI	LF
  0C36'   CA 0C3C'              	JZ	NX_LF
  0C39'   2B                    	DCX	H		; a lone CR
  0C3A'   AF                    	XRA	A
  0C3B'   C9                    	RET
  0C3C'                         NX_LF:
  0C3C'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0C3F'   D8                    	RC
  0C40'   2B                    	DCX	H
  0C41'   3E 01                 	MVI	A,1
  0C43'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0C44'                         INCC:
  0C44'   CD 0A5D'              	CALL	ATEOF
  0C47'   DA 0C82'              	JC	IC_END
  0C4A'   FE 0D                 	CPI	CR
  0C4C'   CA 0C6D'              	JZ	IC_NL
  0C4F'   FE 0A                 	CPI	LF
  0C51'   CA 0C6D'              	JZ	IC_NL
  0C54'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0C57'                         IC_CH:
  0C57'   CD 0A5D'              	CALL	ATEOF
  0C5A'   DA 0C69'              	JC	IC_2
  0C5D'   FE 0D                 	CPI	CR
  0C5F'   CA 0C69'              	JZ	IC_2
  0C62'   FE 0A                 	CPI	LF
  0C64'   CA 0C69'              	JZ	IC_2
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C67'   AF                    	XRA	A
  0C68'   C9                    	RET
  0C69'                         IC_2:
  0C69'   3E 02                 	MVI	A,2
  0C6B'   B7                    	ORA	A
  0C6C'   C9                    	RET
  0C6D'                         IC_NL:
  0C6D'   CD 0C2B'              	CALL	NXLN
  0C70'   DA 0C82'              	JC	IC_END
  0C73'   F5                    	PUSH	PSW
  0C74'   CD 0000*              	CALL	PUTCUR
  0C77'   F1                    	POP	PSW
  0C78'   B7                    	ORA	A
  0C79'   CA 0C57'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0C7C'   CD 0CA8'              	CALL	LNINC
  0C7F'   3E 01                 	MVI	A,1
  0C81'   C9                    	RET
  0C82'                         IC_END:
  0C82'   3E FF                 	MVI	A,0FFH
  0C84'   B7                    	ORA	A
  0C85'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0C86'                         DECC:
  0C86'   CD 0000*              	CALL	PEEKL
  0C89'   DA 0C82'              	JC	IC_END
  0C8C'   F5                    	PUSH	PSW
  0C8D'   CD 0000*              	CALL	PUTCUR
  0C90'   F1                    	POP	PSW
  0C91'   FE 0A                 	CPI	LF
  0C93'   3E 00                 	MVI	A,0
  0C95'   C0                    	RNZ
  0C96'   CD 0CB6'              	CALL	LNDEC
  0C99'   CD 0000*              	CALL	PEEKL		; onto its CR
  0C9C'   DA 0CA4'              	JC	DC_1
  0C9F'   FE 0D                 	CPI	CR
  0CA1'   CC 0000*              	CZ	PUTCUR
  0CA4'                         DC_1:
  0CA4'   3E 01                 	MVI	A,1
  0CA6'   B7                    	ORA	A
  0CA7'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0CA8'                         LNINC:
  0CA8'   E5                    	PUSH	H
  0CA9'   2A 0000*              	LHLD	LNDLT
  0CAC'   7C                    	MOV	A,H
  0CAD'   FE 40                 	CPI	40H
  0CAF'   CA 0CC4'              	JZ	LN_X
  0CB2'   23                    	INX	H
  0CB3'   C3 0CC1'              	JMP	LN_ST
  0CB6'                         LNDEC:
  0CB6'   E5                    	PUSH	H
  0CB7'   2A 0000*              	LHLD	LNDLT
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0CBA'   7C                    	MOV	A,H
  0CBB'   FE C0                 	CPI	0C0H
  0CBD'   CA 0CC4'              	JZ	LN_X
  0CC0'   2B                    	DCX	H
  0CC1'                         LN_ST:
  0CC1'   22 0000*              	SHLD	LNDLT
  0CC4'                         LN_X:
  0CC4'   E1                    	POP	H
  0CC5'   C9                    	RET
                                
  0CC6'   AF                    VC_E:	XRA	A
  0CC7'   32 2A79'              	STA	WBIG
  0CCA'   C3 0CD2'              	JMP	EDO
  0CCD'   3E 01                 VCBGE:	MVI	A,1
  0CCF'   32 2A79'              	STA	WBIG
  0CD2'   CD 079A'              EDO:	CALL	SETMOV
  0CD5'   CD 06CB'              	CALL	GETCNT
  0CD8'   22 2AB1'              	SHLD	CNTV
  0CDB'   2A 2AB1'              EDO_LP: LHLD	CNTV
  0CDE'   7C                    	MOV	A,H
  0CDF'   B5                    	ORA	L
  0CE0'   CA 0B0A'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0CE3'   2B                    	DCX	H
  0CE4'   22 2AB1'              	SHLD	CNTV
  0CE7'   CD 0CF5'              	CALL	ESTEP
  0CEA'   21 2A9C'              	LXI	H,CWEOL		; only the count's first word stays where it is
  0CED'   36 00                 	MVI	M,0
  0CEF'   D2 0CDB'              	JNC	EDO_LP
  0CF2'   C3 0B0A'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0CF5'                         ESTEP:
  0CF5'   CD 0C0A'              	CALL	CCLS
  0CF8'   32 2ABD'              	STA	WKCLS		; the starting class
  0CFB'   CD 0C44'              	CALL	INCC
  0CFE'   B7                    	ORA	A
  0CFF'   FA 0D25'              	JM	ES_F
  0D02'   CD 0C0A'              	CALL	CCLS
  0D05'   B7                    	ORA	A
  0D06'   CA 0D10'              	JZ	ES_ST
  0D09'   21 2ABD'              	LXI	H,WKCLS
  0D0C'   BE                    	CMP	M
  0D0D'   CA 0D27'              	JZ	ES_SK		; still in the word it started in: on to its end
  0D10'                         ES_ST:
  0D10'   3A 2A9C'              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0D13'   B7                    	ORA	A		;   that char is the word's end already, and
  0D14'   C2 0D3E'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
  0D17'                         ES_WS:
  0D17'   CD 0C0A'              	CALL	CCLS		; over blanks, line ends and empty lines
  0D1A'   B7                    	ORA	A
  0D1B'   C2 0D27'              	JNZ	ES_SK
  0D1E'   CD 0C44'              	CALL	INCC
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D21'   B7                    	ORA	A
  0D22'   F2 0D17'              	JP	ES_WS
  0D25'                         ES_F:
  0D25'   37                    	STC
  0D26'   C9                    	RET
  0D27'                         ES_SK:
  0D27'   CD 0C0A'              	CALL	CCLS		; past the rest of this word ...
  0D2A'   32 2ABD'              	STA	WKCLS
  0D2D'                         ES_SL:
  0D2D'   CD 0C44'              	CALL	INCC
  0D30'   B7                    	ORA	A
  0D31'   FA 0D25'              	JM	ES_F
  0D34'   CD 0C0A'              	CALL	CCLS
  0D37'   21 2ABD'              	LXI	H,WKCLS
  0D3A'   BE                    	CMP	M
  0D3B'   CA 0D2D'              	JZ	ES_SL
  0D3E'   C3 0C86'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0D41'                         CURRW:
  0D41'   2A 0000*              	LHLD	WINROW
  0D44'   EB                    	XCHG
  0D45'   2A 0000*              	LHLD	LNDLT
  0D48'   19                    	DAD	D		; HL = row (signed)
  0D49'   7C                    	MOV	A,H
  0D4A'   B7                    	ORA	A
  0D4B'   FA 0D5E'              	JM	CRW_0		; above the screen -> top row
  0D4E'   C2 0D59'              	JNZ	CRW_BT		; far below -> bottom row
  0D51'   3A 0000*              	LDA	NEDIT
  0D54'   3D                    	DCR	A		; A = bottom row
  0D55'   BD                    	CMP	L		; CY iff bottom < row
  0D56'   D8                    	RC
  0D57'   7D                    	MOV	A,L
  0D58'   C9                    	RET
  0D59'                         CRW_BT:
  0D59'   3A 0000*              	LDA	NEDIT
  0D5C'   3D                    	DCR	A
  0D5D'   C9                    	RET
  0D5E'                         CRW_0:
  0D5E'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D5F'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0D60'                         SETRWT:
  0D60'   2A 0000*              	LHLD	LNDLT
  0D63'   EB                    	XCHG
  0D64'   6F                    	MOV	L,A
  0D65'   26 00                 	MVI	H,0
  0D67'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0D6A'   22 0000*              	SHLD	WINROW
  0D6D'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0D6E'                         MVROW:
  0D6E'   47                    	MOV	B,A
  0D6F'   CD 0D41'              	CALL	CURRW
  0D72'   90                    	SUB	B		; A = row now - target
  0D73'   C8                    	RZ
  0D74'   DA 0D7D'              	JC	MR_DN
  0D77'   6F                    	MOV	L,A
  0D78'   26 00                 	MVI	H,0
  0D7A'   C3 09CC'              	JMP	KCORE
  0D7D'                         MR_DN:
  0D7D'   2F                    	CMA
  0D7E'   3C                    	INR	A		; A = target - row now
  0D7F'   6F                    	MOV	L,A
  0D80'   26 00                 	MVI	H,0
  0D82'   C3 092F'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0D85'                         VC_HIGH:
  0D85'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0D88'   2B                    	DCX	H		; row = count - 1
  0D89'   7C                    	MOV	A,H
  0D8A'   B7                    	ORA	A
  0D8B'   3A 0000*              	LDA	SCBOT
  0D8E'   C2 0D96'              	JNZ	VH_GO		; >= 256 -> the last text row
  0D91'   BD                    	CMP	L		; CY iff SCBOT < row
  0D92'   DA 0D96'              	JC	VH_GO
  0D95'   7D                    	MOV	A,L
  0D96'                         VH_GO:
  0D96'   CD 0D6E'              	CALL	MVROW
  0D99'   C3 0874'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0D9C'                         VC_MIDL:
  0D9C'   CD 06B8'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0D9F'   3A 0000*              	LDA	SCBOT
  0DA2'   B7                    	ORA	A		; clear CY for the shift
  0DA3'   1F                    	RAR			; A = SCBOT / 2
  0DA4'   CD 0D6E'              	CALL	MVROW
  0DA7'   C3 0874'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


                                ; above the top row, then first non-blank.
  0DAA'                         VC_LOWL:
  0DAA'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0DAD'   2B                    	DCX	H		; count - 1
  0DAE'   3A 0000*              	LDA	SCBOT
  0DB1'   5F                    	MOV	E,A
  0DB2'   16 00                 	MVI	D,0
  0DB4'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0DB5'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0DB8'   3E 00                 	MVI	A,0
  0DBA'   D2 0DC1'              	JNC	VL_GO		; at or past the top -> row 0
  0DBD'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0DC0'   7D                    	MOV	A,L
  0DC1'                         VL_GO:
  0DC1'   CD 0D6E'              	CALL	MVROW
  0DC4'   C3 0874'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0DC7'                         VC_PGDN:
  0DC7'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0DCA'   3A 0000*              	LDA	SCEOF
  0DCD'   B7                    	ORA	A
  0DCE'   CA 0DDC'              	JZ	VPD_N
  0DD1'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0DD4'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0DD5'   C8                    	RZ			; it already is
  0DD6'   CD 0D6E'              	CALL	MVROW
  0DD9'   C3 0DED'              	JMP	VPD_TP
  0DDC'                         VPD_N:
  0DDC'   3A 0000*              	LDA	NEDIT
  0DDF'   D6 02                 	SUI	2
  0DE1'   CD 0E35'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0DE4'   E5                    	PUSH	H
  0DE5'   AF                    	XRA	A
  0DE6'   CD 0D6E'              	CALL	MVROW		; the top line
  0DE9'   E1                    	POP	H
  0DEA'   CD 092F'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0DED'                         VPD_TP:
  0DED'   AF                    	XRA	A
  0DEE'   CD 0D60'              	CALL	SETRWT		; to the top row
  0DF1'   C3 0874'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0DF4'                         VC_PGUP:
  0DF4'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0DF7'   3A 0000*              	LDA	SCBOF
  0DFA'   B7                    	ORA	A
  0DFB'   C0                    	RNZ
  0DFC'   3A 0000*              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0DFF'   47                    	MOV	B,A
  0E00'   3A 0000*              	LDA	SCEOF
  0E03'   B7                    	ORA	A
  0E04'   CA 0E15'              	JZ	VPU_2
  0E07'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0E0A'   FE 02                 	CPI	2
  0E0C'   D2 0E15'              	JNC	VPU_2
  0E0F'   2F                    	CMA
  0E10'   3C                    	INR	A
  0E11'   80                    	ADD	B
  0E12'   C3 0E18'              	JMP	VPU_P
  0E15'                         VPU_2:
  0E15'   78                    	MOV	A,B
  0E16'   D6 02                 	SUI	2
  0E18'                         VPU_P:
  0E18'   CD 0E35'              	CALL	MULSAT		; HL = count * page
  0E1B'   E5                    	PUSH	H
  0E1C'   AF                    	XRA	A
  0E1D'   CD 0D6E'              	CALL	MVROW		; the top line
  0E20'   E1                    	POP	H
  0E21'   CD 09CC'              	CALL	KCORE		; the new top line
  0E24'   AF                    	XRA	A
  0E25'   CD 0D60'              	CALL	SETRWT		; on the top row
  0E28'   3A 0000*              	LDA	NEDIT
  0E2B'   3D                    	DCR	A
  0E2C'   6F                    	MOV	L,A
  0E2D'   26 00                 	MVI	H,0
  0E2F'   CD 092F'              	CALL	JCORE		; the bottom row's line
  0E32'   C3 0874'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0E35'                         MULSAT:
  0E35'   EB                    	XCHG
  0E36'   21 0000               	LXI	H,0
  0E39'   B7                    	ORA	A
  0E3A'   C8                    	RZ
  0E3B'                         MS_LP:
  0E3B'   19                    	DAD	D
  0E3C'   DA 0E44'              	JC	MS_SAT
  0E3F'   3D                    	DCR	A
  0E40'   C2 0E3B'              	JNZ	MS_LP
  0E43'   C9                    	RET
  0E44'                         MS_SAT:
  0E44'   21 FFFF               	LXI	H,0FFFFH
  0E47'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0E48'                         VC_HFDN:
  0E48'   CD 079A'              	CALL	SETMOV
  0E4B'   CD 0D41'              	CALL	CURRW
  0E4E'   32 2A7B'              	STA	HFROW
  0E51'   CD 0EBF'              	CALL	HFCNT		; HL = lines
  0E54'   3A 2A7B'              	LDA	HFROW
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E57'   47                    	MOV	B,A
  0E58'   3A 0000*              	LDA	SCEOF
  0E5B'   B7                    	ORA	A
  0E5C'   CA 0E64'              	JZ	VHD_GO
  0E5F'   3A 0000*              	LDA	SCBOT		; the last line's row
  0E62'   B8                    	CMP	B
  0E63'   C8                    	RZ			; the cursor is on it
  0E64'                         VHD_GO:
  0E64'   CD 092F'              	CALL	JCORE
  0E67'   3A 0000*              	LDA	SCEOF
  0E6A'   B7                    	ORA	A
  0E6B'   C2 0874'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0E6E'   3A 2A7B'              	LDA	HFROW
  0E71'   CD 0D60'              	CALL	SETRWT
  0E74'   3E 01                 	MVI	A,1
  0E76'   32 0000*              	STA	WFILL		; not past the end of the file
  0E79'   C3 0874'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0E7C'                         VC_HFUP:
  0E7C'   CD 079A'              	CALL	SETMOV
  0E7F'   CD 0D41'              	CALL	CURRW
  0E82'   32 2A7B'              	STA	HFROW
  0E85'   CD 0EBF'              	CALL	HFCNT		; HL = lines
  0E88'   CD 0E9F'              	CALL	ONFST
  0E8B'   C8                    	RZ			; the cursor is on the first line
  0E8C'   CD 09CC'              	CALL	KCORE
  0E8F'   3A 0000*              	LDA	SCBOF
  0E92'   B7                    	ORA	A
  0E93'   C2 0874'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0E96'   3A 2A7B'              	LDA	HFROW
  0E99'   CD 0D60'              	CALL	SETRWT
  0E9C'   C3 0874'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0E9F'                         ONFST:
  0E9F'   E5                    	PUSH	H
  0EA0'   2A 0000*              	LHLD	OUTPOS
  0EA3'   7C                    	MOV	A,H
  0EA4'   B5                    	ORA	L
  0EA5'   C2 0EBD'              	JNZ	OF_RET
  0EA8'   2A 0000*              	LHLD	TXTBEG
  0EAB'   EB                    	XCHG			; DE = TXTBEG
  0EAC'   2A 0000*              	LHLD	GAPBEG
  0EAF'                         OF_LP:
  0EAF'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0EB2'   CA 0EBD'              	JZ	OF_RET
  0EB5'   2B                    	DCX	H
  0EB6'   7E                    	MOV	A,M
  0EB7'   FE 0A                 	CPI	LF
  0EB9'   C2 0EAF'              	JNZ	OF_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0EBC'   B7                    	ORA	A		; NZ
  0EBD'                         OF_RET:
  0EBD'   E1                    	POP	H
  0EBE'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0EBF'                         HFCNT:
  0EBF'   2A 2A6F'              	LHLD	CMDCNT
  0EC2'   7C                    	MOV	A,H
  0EC3'   B5                    	ORA	L
  0EC4'   CA 0EDB'              	JZ	HFC_AM
  0EC7'   CD 06CB'              	CALL	GETCNT		; HL = count; clears it
  0ECA'   3A 0000*              	LDA	NEDIT
  0ECD'   5F                    	MOV	E,A
  0ECE'   16 00                 	MVI	D,0
  0ED0'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0ED3'   D2 0ED7'              	JNC	HFC_ST
  0ED6'   EB                    	XCHG			; HL = NEDIT
  0ED7'                         HFC_ST:
  0ED7'   7D                    	MOV	A,L
  0ED8'   32 2A7C'              	STA	HFAMT
  0EDB'                         HFC_AM:
  0EDB'   3A 2A7C'              	LDA	HFAMT
  0EDE'   B7                    	ORA	A
  0EDF'   C2 0EEC'              	JNZ	HFC_HL
  0EE2'   3A 0000*              	LDA	NEDIT
  0EE5'   B7                    	ORA	A
  0EE6'   1F                    	RAR
  0EE7'   B7                    	ORA	A
  0EE8'   C2 0EEC'              	JNZ	HFC_HL
  0EEB'   3C                    	INR	A		; at least one line
  0EEC'                         HFC_HL:
  0EEC'   6F                    	MOV	L,A
  0EED'   26 00                 	MVI	H,0
  0EEF'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0EF0'                         VC_REDR:
  0EF0'   C3 06CB'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0EF3'                         VC_G:
  0EF3'   CD 079A'              	CALL	SETMOV
  0EF6'   CD 0FB5'              	CALL	GZONE		; the screen's top line, before the move
  0EF9'   CD 06F4'              	CALL	BRKON		; ... and an ESC may stop it from here on
  0EFC'   2A 2A6F'              	LHLD	CMDCNT
  0EFF'   7C                    	MOV	A,H
  0F00'   B5                    	ORA	L
  0F01'   C2 0F14'              	JNZ	VG_N
  0F04'   AF                    	XRA	A		; forward
  0F05'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0F08'   CD 072B'              	CALL	BRKOFF
  0F0B'   DA 0743'              	JC	BRKBAK
  0F0E'   CD 0A63'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0F11'   C3 0FCD'              	JMP	GPLACE
  0F14'                         VG_N:
  0F14'   CD 06CB'              	CALL	GETCNT		; HL = target line (1-based)
  0F17'                         VG_LN:
  0F17'   CD 0F23'              	CALL	GOLN
  0F1A'   CD 072B'              	CALL	BRKOFF
  0F1D'   DA 0743'              	JC	BRKBAK
  0F20'   C3 0FCD'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  0F23'                         GOLN:
  0F23'   E5                    	PUSH	H
  0F24'   CD 0000*              	CALL	CNTLF
  0F27'   23                    	INX	H		; HL = the cursor's line
  0F28'   D1                    	POP	D		; DE = the line wanted
  0F29'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  0F2C'   DA 0F37'              	JC	GLN_BK
  0F2F'   EB                    	XCHG
  0F30'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  0F33'   AF                    	XRA	A
  0F34'   C3 0F3C'              	JMP	GLN_MV
  0F37'                         GLN_BK:
  0F37'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  0F3A'   3E FF                 	MVI	A,0FFH
  0F3C'                         GLN_MV:
  0F3C'   CD 0000*              	CALL	MVLIND
  0F3F'   CD 0A5D'              	CALL	ATEOF
  0F42'   DC 0A63'              	CC	LASTLN		; past the last line: onto it
  0F45'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0F46'                         VC_LG:
  0F46'   CD 079A'              	CALL	SETMOV
  0F49'   3A 2A97'              	LDA	GSAVE
  0F4C'   B7                    	ORA	A
  0F4D'   C2 0F56'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F50'   3E 01                 	MVI	A,PG
  0F52'   32 2A96'              	STA	GPEND
  0F55'   C9                    	RET
  0F56'                         VLG_GG:
  0F56'   CD 0FB5'              	CALL	GZONE
  0F59'   CD 06F4'              	CALL	BRKON
  0F5C'   CD 06CB'              	CALL	GETCNT		; HL = target line (no count: 1)
  0F5F'   C3 0F17'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0F62'                         SUB24:
  0F62'   4F                    	MOV	C,A
  0F63'   7D                    	MOV	A,L
  0F64'   93                    	SUB	E
  0F65'   6F                    	MOV	L,A
  0F66'   7C                    	MOV	A,H
  0F67'   9A                    	SBB	D
  0F68'   67                    	MOV	H,A
  0F69'   79                    	MOV	A,C
  0F6A'   98                    	SBB	B
  0F6B'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0F6C'                         CURFP:
  0F6C'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0F6F'                         FPOS:
  0F6F'   C5                    	PUSH	B
  0F70'   D5                    	PUSH	D
  0F71'   EB                    	XCHG
  0F72'   2A 0000*              	LHLD	TXTBEG
  0F75'   EB                    	XCHG
  0F76'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0F79'   EB                    	XCHG			; DE = that
  0F7A'   2A 0000*              	LHLD	OUTPOS
  0F7D'   7C                    	MOV	A,H
  0F7E'   B7                    	ORA	A		; CY = 0
  0F7F'   1F                    	RAR
  0F80'   47                    	MOV	B,A
  0F81'   7D                    	MOV	A,L
  0F82'   1F                    	RAR
  0F83'   67                    	MOV	H,A
  0F84'   3E 00                 	MVI	A,0
  0F86'   1F                    	RAR
  0F87'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0F88'   19                    	DAD	D
  0F89'   78                    	MOV	A,B
  0F8A'   CE 00                 	ACI	0		; A:HL = the position
  0F8C'   D1                    	POP	D
  0F8D'   C1                    	POP	B
  0F8E'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F8F'                         ZSAVE:
  0F8F'   2A 2A6F'              	LHLD	CMDCNT
  0F92'   22 2AD5'              	SHLD	ZSVCNT
  0F95'   2A 0000*              	LHLD	AUXCNT
  0F98'   22 2AD7'              	SHLD	ZSVAUX
  0F9B'   3A 0000*              	LDA	DIRFLG
  0F9E'   32 2AD9'              	STA	ZSVDIR
  0FA1'   C9                    	RET
  0FA2'                         ZREST:
  0FA2'   2A 2AD5'              	LHLD	ZSVCNT
  0FA5'   22 2A6F'              	SHLD	CMDCNT
  0FA8'   2A 2AD7'              	LHLD	ZSVAUX
  0FAB'   22 0000*              	SHLD	AUXCNT
  0FAE'   3A 2AD9'              	LDA	ZSVDIR
  0FB1'   32 0000*              	STA	DIRFLG
  0FB4'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0FB5'                         GZONE:
  0FB5'   CD 0F8F'              	CALL	ZSAVE
  0FB8'   CD 0D41'              	CALL	CURRW
  0FBB'   6F                    	MOV	L,A
  0FBC'   26 00                 	MVI	H,0
  0FBE'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0FC1'   CD 0F6F'              	CALL	FPOS
  0FC4'   22 0000*              	SHLD	ZTOP
  0FC7'   32 0002*              	STA	ZTOP+2
  0FCA'   C3 0FA2'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0FCD'                         GPLACE:
  0FCD'   CD 0F8F'              	CALL	ZSAVE
  0FD0'   CD 0F6C'              	CALL	CURFP
  0FD3'   EB                    	XCHG
  0FD4'   2A 0000*              	LHLD	ZTOP
  0FD7'   EB                    	XCHG
  0FD8'   4F                    	MOV	C,A		; C:HL = the target's position
  0FD9'   3A 0002*              	LDA	ZTOP+2
  0FDC'   47                    	MOV	B,A		; B:DE = the top's
  0FDD'   79                    	MOV	A,C
  0FDE'   CD 0F62'              	CALL	SUB24
  0FE1'   22 2AD2'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  0FE4'   DA 1031'              	JC	GP_UP
  0FE7'   B7                    	ORA	A
  0FE8'   C2 1072'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0FEB'   3A 0000*              	LDA	NEDIT
  0FEE'   5F                    	MOV	E,A
  0FEF'   16 00                 	MVI	D,0
  0FF1'   B7                    	ORA	A
  0FF2'   1F                    	RAR
  0FF3'   6F                    	MOV	L,A
  0FF4'   26 00                 	MVI	H,0
  0FF6'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FF7'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0FFA'   CD 06C4'              	CALL	GBSUB		; HL = bytes from there to the target
  0FFD'   EB                    	XCHG
  0FFE'   2A 2AD2'              	LHLD	ZDIF		; HL = bytes from the top to the target
  1001'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  1004'   DA 1072'              	JC	GP_MID
  1007'   CD 06C4'              	CALL	GBSUB		; HL = the top line's start (resident)
  100A'   01 0000               	LXI	B,0		; BC = lines from the top
  100D'                         GP_CNT:
  100D'   7A                    	MOV	A,D
  100E'   B3                    	ORA	E
  100F'   CA 101E'              	JZ	GP_DN
  1012'   7E                    	MOV	A,M
  1013'   23                    	INX	H
  1014'   1B                    	DCX	D
  1015'   FE 0A                 	CPI	LF
  1017'   C2 100D'              	JNZ	GP_CNT
  101A'   03                    	INX	B
  101B'   C3 100D'              	JMP	GP_CNT
  101E'                         GP_DN:
  101E'   3A 0000*              	LDA	NEDIT
  1021'   3D                    	DCR	A
  1022'   5F                    	MOV	E,A
  1023'   16 00                 	MVI	D,0		; DE = the bottom row
  1025'   60                    	MOV	H,B
  1026'   69                    	MOV	L,C
  1027'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  102A'   DA 107C'              	JC	GP_SET		; A = the bottom row
  102D'   7D                    	MOV	A,L		; on the screen: its row
  102E'   C3 109C'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  1031'                         GP_UP:
  1031'   3C                    	INR	A
  1032'   C2 1072'              	JNZ	GP_MID		; 64K bytes or more above
  1035'   2A 2AD2'              	LHLD	ZDIF
  1038'   EB                    	XCHG
  1039'   21 0000               	LXI	H,0
  103C'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  103F'   7C                    	MOV	A,H
  1040'   B5                    	ORA	L
  1041'   CA 1072'              	JZ	GP_MID		; exactly 64K
  1044'   EB                    	XCHG			; DE = bytes to read
  1045'   AF                    	XRA	A
  1046'   32 2AD4'              	STA	ZLF
  1049'   CD 0000*              	CALL	RGET0
  104C'                         GP_RD:
  104C'   CD 0000*              	CALL	RDGET		; (keeps DE)
  104F'   DA 1072'              	JC	GP_MID
  1052'   FE 0A                 	CPI	LF
  1054'   C2 1068'              	JNZ	GP_RN
  1057'   3A 0000*              	LDA	NEDIT
  105A'   B7                    	ORA	A
  105B'   1F                    	RAR
  105C'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  105E'   E5                    	PUSH	H
  105F'   21 2AD4'              	LXI	H,ZLF
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  1062'   34                    	INR	M
  1063'   BE                    	CMP	M		; CY iff more lines than that
  1064'   E1                    	POP	H
  1065'   DA 1072'              	JC	GP_MID
  1068'                         GP_RN:
  1068'   1B                    	DCX	D
  1069'   7A                    	MOV	A,D
  106A'   B3                    	ORA	E
  106B'   C2 104C'              	JNZ	GP_RD
  106E'   AF                    	XRA	A		; the top row
  106F'   C3 107C'              	JMP	GP_SET
  1072'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  1072'   3E 01                 	MVI	A,1
  1074'   32 0000*              	STA	WFILL		; not past the end of the file
  1077'   3A 0000*              	LDA	NEDIT
  107A'   B7                    	ORA	A
  107B'   1F                    	RAR			; the middle row
  107C'                         GP_SET:
  107C'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  107D'   26 00                 	MVI	H,0
  107F'   22 0000*              	SHLD	WINROW
  1082'   21 0000               	LXI	H,0
  1085'   22 0000*              	SHLD	LNDLT
  1088'   CD 07BB'              	CALL	SETFUL		; the window may have paged: full repaint
  108B'                         GP_FIN:
  108B'   CD 0FA2'              	CALL	ZREST
  108E'   3A 2AFD'              	LDA	GPKEEP
  1091'   B7                    	ORA	A
  1092'   CA 0874'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  1095'   AF                    	XRA	A
  1096'   32 2AFD'              	STA	GPKEEP
  1099'   C3 05BD'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  109C'                         GP_ONS:
  109C'   6F                    	MOV	L,A
  109D'   26 00                 	MVI	H,0		; HL = the row it lands on
  109F'   EB                    	XCHG
  10A0'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  10A3'   EB                    	XCHG
  10A4'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  10A7'   22 0000*              	SHLD	LNDLT
  10AA'   3E 01                 	MVI	A,R_MOVE
  10AC'   32 2A73'              	STA	RINTENT
  10AF'   C3 108B'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  10B2'                         OPPEND:
  10B2'   AF                    	XRA	A
  10B3'   32 2A9C'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  10B6'   3A 2A99'              	LDA	PSAVE
  10B9'   FE 63                 	CPI	'c'
  10BB'   C2 10D8'              	JNZ	OPP_ND
  10BE'   79                    	MOV	A,C
  10BF'   FE 77                 	CPI	'w'
  10C1'   CA 10C9'              	JZ	OPP_W
  10C4'   FE 57                 	CPI	'W'
  10C6'   C2 10D8'              	JNZ	OPP_ND
  10C9'                         OPP_W:
  10C9'   CD 12AB'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  10CC'   DA 10D8'              	JC	OPP_ND
  10CF'   79                    	MOV	A,C
  10D0'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  10D2'   4F                    	MOV	C,A
  10D3'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  10D5'   32 2A9C'              	STA	CWEOL		;   char for the next word's: see ESTEP
  10D8'                         OPP_ND:
  10D8'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  10D9'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  10DB'   C2 10EF'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  10DE'   CD 01F9'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  10E1'   DA 117F'              	JC	OPABRT
  10E4'   79                    	MOV	A,C
  10E5'   FE 67                 	CPI	'g'
  10E7'   C2 117F'              	JNZ	OPABRT
  10EA'   3E 01                 	MVI	A,PG
  10EC'   32 2A97'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  10EF'                         OPP_NG:
  10EF'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  10F0'   21 2A99'              	LXI	H,PSAVE
  10F3'   BE                    	CMP	M
  10F4'   CA 12CC'              	JZ	OPLINE
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  10F7'   79                    	MOV	A,C		; (OPCLS classifies the key)
  10F8'   CD 12E2'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  10FB'   DA 117F'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  10FE'   32 2A9B'              	STA	OPCLSV
  1101'   47                    	MOV	B,A		; B = the class
  1102'   3A 2A99'              	LDA	PSAVE
  1105'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  1107'   C2 1113'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  110A'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  110B'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  110D'   C2 1135'              	JNZ	OPP_GO
  1110'   C3 111E'              	JMP	OPP_NO
  1113'                         OPP_NC:
  1113'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  1115'   C2 1135'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  1118'   78                    	MOV	A,B		;   a charwise register would need a type flag
  1119'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  111B'   CA 1135'              	JZ	OPP_GO		;   within a line -- neither of which is built
  111E'                         OPP_NO:
  111E'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  111F'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  1121'   CA 112F'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  1124'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  1126'   CA 112F'              	JZ	OPP_SW		;   so swallow it before dropping the command
  1129'   CD 0326'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  112C'   C2 117F'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  112F'                         OPP_SW:
  112F'   CD 01F9'              	CALL	MKGETK
  1132'   C3 117F'              	JMP	OPABRT
  1135'                         OPP_GO:
  1135'   AF                    	XRA	A
  1136'   32 2A7A'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  1139'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  113C'   22 2A9D'              	SHLD	OPSTA
  113F'   C5                    	PUSH	B
  1140'   21 2AA1'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  1143'   CD 0429'              	CALL	FPSTO		;   only good until the motion pages the window
  1146'   3A 2A9B'              	LDA	OPCLSV
  1149'   FE 02                 	CPI	2
  114B'   CC 1182'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  114E'   C1                    	POP	B
  114F'   21 29B6'              	LXI	H,CMDTAB
  1152'   CD 00C3'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1155'   3A 2A99'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1158'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1159'   CA 079A'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  115C'   CD 11AE'              	CALL	OPSFIX		; where the start is in the window NOW
  115F'   D2 11CA'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  1162'   22 2A9D'              	SHLD	OPSTA
  1165'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1168'   22 2A9F'              	SHLD	OPEND2
  116B'   3A 2A99'              	LDA	PSAVE
  116E'   FE 79                 	CPI	'y'
  1170'   CA 1838'              	JZ	OPYANK		; a yank takes the span without losing it
  1173'   CD 131D'              	CALL	OPAPPL		; delete the span
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  1176'   3A 2A99'              	LDA	PSAVE
  1179'   FE 63                 	CPI	'c'
  117B'   C0                    	RNZ
  117C'   C3 15F1'              	JMP	SETINS
  117F'                         OPABRT:				; not a motion -> the operator is dropped and
  117F'   C3 00A6'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  1182'                         OPENDS:
  1182'   2A 2A9D'              	LHLD	OPSTA
  1185'   CD 0624'              	CALL	BOL
  1188'   11 2AA4'              	LXI	D,OPSLO
  118B'   CD 11A0'              	CALL	OPE_ST
  118E'   2A 2A9D'              	LHLD	OPSTA
  1191'   CD 0654'              	CALL	NLSTART
  1194'   11 2AA7'              	LXI	D,OPSHI
  1197'   CD 11A0'              	CALL	OPE_ST
  119A'   2A 2A9D'              	LHLD	OPSTA
  119D'   C3 0000*              	JMP	GOTO
  11A0'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  11A0'   D5                    	PUSH	D
  11A1'   CD 0000*              	CALL	GOTO
  11A4'   E1                    	POP	H
  11A5'   C3 0429'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  11A8'                         CURBD:
  11A8'   CD 0F6C'              	CALL	CURFP
  11AB'   EB                    	XCHG
  11AC'   47                    	MOV	B,A
  11AD'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  11AE'                         OPSFIX:
  11AE'   21 2AA1'              	LXI	H,OPSFP
  11B1'   CD 03DC'              	CALL	MKLOAD
  11B4'   CD 11A8'              	CALL	CURBD
  11B7'   2A 2B07'              	LHLD	MKPOS
  11BA'   3A 2B09'              	LDA	MKPOS+2
  11BD'   CD 0F62'              	CALL	SUB24
  11C0'   B4                    	ORA	H
  11C1'   B5                    	ORA	L
  11C2'   C2 03E9'              	JNZ	MKWIN
  11C5'   CD 0000*              	CALL	CUROFF
  11C8'   37                    	STC
  11C9'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  11CA'                         OPPGD:
  11CA'   47                    	MOV	B,A
  11CB'   3A 2A9B'              	LDA	OPCLSV
  11CE'   FE 02                 	CPI	2
  11D0'   C2 128C'              	JNZ	OPG_NO
  11D3'   3A 2A99'              	LDA	PSAVE
  11D6'   FE 64                 	CPI	'd'
  11D8'   C2 128C'              	JNZ	OPG_NO
  11DB'   04                    	INR	B
  11DC'   CA 11EB'              	JZ	OPG_FW
  11DF'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  11E2'   CD 0624'              	CALL	BOL		;   and the high end is OPSHI as it stands
  11E5'   CD 0000*              	CALL	GOTO
  11E8'   C3 1203'              	JMP	OPG_GO
  11EB'                         OPG_FW:
  11EB'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  11EE'   CD 0654'              	CALL	NLSTART		;   landed on, and the low one is where the
  11F1'   11 2AA7'              	LXI	D,OPSHI		;   start line began
  11F4'   CD 11A0'              	CALL	OPE_ST
  11F7'   21 2AA4'              	LXI	H,OPSLO
  11FA'   CD 03DC'              	CALL	MKLOAD
  11FD'   CD 03A9'              	CALL	MKPAGE
  1200'   CD 0000*              	CALL	GOTO
  1203'                         OPG_GO:
  1203'   CD 11A8'              	CALL	CURBD
  1206'   2A 2AA7'              	LHLD	OPSHI
  1209'   3A 2AA9'              	LDA	OPSHI+2
  120C'   CD 0F62'              	CALL	SUB24		; A:HL = the bytes to take
  120F'                         OPG_SV:
  120F'   22 2AAA'              	SHLD	OPTOGO
  1212'   32 2AAC'              	STA	OPTOGO+2
  1215'                         OPG_NX:
  1215'   CD 06A7'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  1218'   CD 0000*              	CALL	SUBHD
  121B'   EB                    	XCHG			; DE = what the window holds past the cursor
  121C'   2A 2AAA'              	LHLD	OPTOGO
  121F'   3A 2AAC'              	LDA	OPTOGO+2
  1222'   B7                    	ORA	A
  1223'   C2 1256'              	JNZ	OPG_PG		; 64K or more to go
  1226'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  1229'   DA 1256'              	JC	OPG_PG
  122C'   CA 1256'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  122F'                         OPG_FN:				; the rest of it is here
  122F'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1230'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  1233'   CD 0000*              	CALL	CUROFF
  1236'   22 2AAD'              	SHLD	OPLO
  1239'   D1                    	POP	D
  123A'   19                    	DAD	D
  123B'   22 2AAF'              	SHLD	OPHI
  123E'   CD 1450'              	CALL	OPDSPN
  1241'   CD 0A5D'              	CALL	ATEOF
  1244'   D2 12A5'              	JNC	OPMID
  1247'   CD 0E9F'              	CALL	ONFST		; deleted to the end of the file: onto the new
  124A'   CA 12A5'              	JZ	OPMID		;   last line, if there is one -- and the pager
  124D'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  1250'   CD 0000*              	CALL	SETBWD
  1253'   C3 12A5'              	JMP	OPMID
  1256'                         OPG_PG:
  1256'   7A                    	MOV	A,D
  1257'   B3                    	ORA	E
  1258'   C2 1271'              	JNZ	OPG_DL
  125B'   CD 0A5D'              	CALL	ATEOF		; nothing held past the cursor
  125E'   21 0000               	LXI	H,0
  1261'   DA 122F'              	JC	OPG_FN		; ... and no more to come: the file ran out
  1264'   2B                    	DCX	H
  1265'   CD 0000*              	CALL	SETC0
  1268'   CD 0000*              	CALL	GOLINE
  126B'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  126E'   C3 1215'              	JMP	OPG_NX
  1271'                         OPG_DL:
  1271'   D5                    	PUSH	D
  1272'   21 FFFF               	LXI	H,0FFFFH
  1275'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1278'   E1                    	POP	H
  1279'   E5                    	PUSH	H
  127A'   CD 0000*              	CALL	DELFWD
  127D'   D1                    	POP	D
  127E'   06 00                 	MVI	B,0
  1280'   2A 2AAA'              	LHLD	OPTOGO
  1283'   3A 2AAC'              	LDA	OPTOGO+2
  1286'   CD 0F62'              	CALL	SUB24
  1289'   C3 120F'              	JMP	OPG_SV
  128C'                         OPG_NO:
  128C'   0E 07                 	MVI	C,BEL
  128E'   CD 0000*              	CALL	BCONOU
  1291'                         OPG_HM:				; the cursor back where the command found it
  1291'   21 2AA1'              	LXI	H,OPSFP
  1294'   CD 03DC'              	CALL	MKLOAD
  1297'   CD 03A9'              	CALL	MKPAGE
  129A'   CD 0000*              	CALL	GOTO
  129D'   AF                    	XRA	A
  129E'   32 2A99'              	STA	PSAVE
  12A1'   3C                    	INR	A
  12A2'   32 2AFD'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  12A5'                         OPMID:
  12A5'   CD 0F8F'              	CALL	ZSAVE
  12A8'   C3 1072'              	JMP	GP_MID
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  12AB'                         ONWHIT:
  12AB'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  12AE'   CA 12CA'              	JZ	OW_YES
  12B1'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  12B4'   FE 20                 	CPI	' '
  12B6'   CA 12CA'              	JZ	OW_YES
  12B9'   FE 09                 	CPI	TAB
  12BB'   CA 12CA'              	JZ	OW_YES
  12BE'   FE 0D                 	CPI	CR
  12C0'   CA 12CA'              	JZ	OW_YES
  12C3'   FE 0A                 	CPI	LF
  12C5'   CA 12CA'              	JZ	OW_YES
  12C8'   B7                    	ORA	A		; a char to change: CY clear
  12C9'   C9                    	RET
  12CA'                         OW_YES:
  12CA'   37                    	STC
  12CB'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  12CC'                         OPLINE:
  12CC'   3A 2A99'              	LDA	PSAVE
  12CF'   FE 63                 	CPI	'c'
  12D1'   CA 079A'              	JZ	SETMOV
  12D4'   FE 79                 	CPI	'y'
  12D6'   CA 1817'              	JZ	VY_YY
  12D9'   21 2AA1'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  12DC'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  12DF'   C3 178D'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  12E2'                         OPCLS:
  12E2'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  12E4'   CA 12F1'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  12E7'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  12E9'   C2 1305'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  12EC'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  12EE'   C3 12F3'              	JMP	OPC_FK
  12F1'                         OPC_SEM:
  12F1'   06 00                 	MVI	B,0		; ';' runs it as it stands
  12F3'                         OPC_FK:
  12F3'   3A 2AF3'              	LDA	FNDKND
  12F6'   B7                    	ORA	A
  12F7'   37                    	STC
  12F8'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  12F9'   A8                    	XRA	B		; ... and now the direction ',' asked for
  12FA'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  12FC'   CA 1303'              	JZ	OPC_EXC
  12FF'   3E 01                 	MVI	A,1
  1301'   B7                    	ORA	A		; CY clear: a motion, class 1
  1302'   C9                    	RET
  1303'                         OPC_EXC:
  1303'   AF                    	XRA	A		; class 0, CY clear
  1304'   C9                    	RET
  1305'                         OPC_TB:
  1305'   47                    	MOV	B,A
  1306'   21 14E5'              	LXI	H,OPCTAB
  1309'                         OPC_LP:
  1309'   7E                    	MOV	A,M
  130A'   B7                    	ORA	A
  130B'   CA 131B'              	JZ	OPC_MS		; end of table -> not a motion
  130E'   B8                    	CMP	B
  130F'   CA 1317'              	JZ	OPC_HT
  1312'   23                    	INX	H
  1313'   23                    	INX	H
  1314'   C3 1309'              	JMP	OPC_LP
  1317'                         OPC_HT:
  1317'   23                    	INX	H
  1318'   7E                    	MOV	A,M		; class byte
  1319'   B7                    	ORA	A		; clear CY
  131A'   C9                    	RET
  131B'                         OPC_MS:
  131B'   37                    	STC
  131C'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  131D'                         OPAPPL:
  131D'   3A 2A9B'              	LDA	OPCLSV
  1320'   FE 02                 	CPI	2
  1322'   CA 14B9'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  1325'   2A 2A9D'              	LHLD	OPSTA
  1328'   EB                    	XCHG			; DE = start
  1329'   2A 2A9F'              	LHLD	OPEND2		; HL = end
  132C'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  132F'   DA 1342'              	JC	OPA_F
  1332'   CA 1342'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  1335'   22 2AAD'              	SHLD	OPLO
  1338'   EB                    	XCHG
  1339'   22 2AAF'              	SHLD	OPHI
  133C'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  133F'   C3 13F9'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  1342'                         OPA_F:
  1342'   EB                    	XCHG			; HL = start, DE = end
  1343'   22 2AAD'              	SHLD	OPLO
  1346'   EB                    	XCHG			; HL = end
  1347'   3A 2A9B'              	LDA	OPCLSV
  134A'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  134C'   CA 13F6'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  134F'   FE 01                 	CPI	1
  1351'   C2 1373'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  1354'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  1355'   22 2AAF'              	SHLD	OPHI		; park it: CEND clobbers DE
  1358'   2B                    	DCX	H		; the line it landed on
  1359'   CD 156F'              	CALL	CEND		; HL = that line's content end
  135C'   EB                    	XCHG			; DE = it
  135D'   2A 2AAF'              	LHLD	OPHI		; HL = hi
  1360'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  1363'   D2 137E'              	JNC	OPA_HI		; hi is inside the line: keep it
  1366'   2A 2AAD'              	LHLD	OPLO
  1369'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  136C'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  136F'   EB                    	XCHG			; HL = the content end: the span stops there
  1370'   C3 137E'              	JMP	OPA_HI
  1373'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  1373'   22 2AAF'              	SHLD	OPHI
  1376'   3A 2A7A'              	LDA	WPULL
  1379'   B7                    	ORA	A
  137A'   CA 13F9'              	JZ	OPA_C1
  137D'   23                    	INX	H
  137E'                         OPA_HI:
  137E'   22 2AAF'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  1381'                         OPA_DO:
  1381'   CD 1445'              	CALL	OPSPNL
  1384'   7C                    	MOV	A,H
  1385'   B5                    	ORA	L
  1386'   C2 138F'              	JNZ	OPA_D1
  1389'   2A 2AAD'              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  138C'   C3 0000*              	JMP	GOTO		;   to where the span starts
  138F'                         OPA_D1:
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  138F'   3A 2A99'              	LDA	PSAVE
  1392'   FE 63                 	CPI	'c'
  1394'   CA 1450'              	JZ	OPDSPN
  1397'   CD 1438'              	CALL	SPNBRK
  139A'   D2 13BB'              	JNC	OPA_D2
  139D'   2A 2AAF'              	LHLD	OPHI
  13A0'   CD 156F'              	CALL	CEND
  13A3'   EB                    	XCHG			; DE = the content end of the line it ends in
  13A4'   2A 2AAF'              	LHLD	OPHI
  13A7'                         OPA_BL:
  13A7'   CD 0000*              	CALL	CMP16
  13AA'   CA 13C1'              	JZ	OPA_BI		; only blanks after it
  13AD'   D5                    	PUSH	D
  13AE'   E5                    	PUSH	H
  13AF'   CD 0000*              	CALL	CHARAT
  13B2'   E1                    	POP	H
  13B3'   D1                    	POP	D
  13B4'   23                    	INX	H
  13B5'   CD 13F0'              	CALL	BLANKQ
  13B8'   CA 13A7'              	JZ	OPA_BL
  13BB'                         OPA_D2:
  13BB'   CD 1450'              	CALL	OPDSPN
  13BE'   C3 1580'              	JMP	CLAMPE
  13C1'                         OPA_BI:
  13C1'   CD 13D3'              	CALL	LOIND
  13C4'   C2 13BB'              	JNZ	OPA_D2
  13C7'   2A 2AAF'              	LHLD	OPHI
  13CA'   CD 0654'              	CALL	NLSTART
  13CD'   22 2AAF'              	SHLD	OPHI
  13D0'   C3 1424'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  13D3'                         LOIND:
  13D3'   2A 2AAD'              	LHLD	OPLO
  13D6'   CD 0624'              	CALL	BOL
  13D9'                         LI_LP:
  13D9'   E5                    	PUSH	H
  13DA'   EB                    	XCHG
  13DB'   2A 2AAD'              	LHLD	OPLO
  13DE'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  13E1'   E1                    	POP	H
  13E2'   C8                    	RZ
  13E3'   E5                    	PUSH	H
  13E4'   CD 0000*              	CALL	CHARAT
  13E7'   E1                    	POP	H
  13E8'   23                    	INX	H
  13E9'   CD 13F0'              	CALL	BLANKQ
  13EC'   CA 13D9'              	JZ	LI_LP
  13EF'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  13F0'                         BLANKQ:
  13F0'   FE 20                 	CPI	' '
  13F2'   C8                    	RZ
  13F3'   FE 09                 	CPI	TAB
  13F5'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  13F6'                         OPA_JP:
  13F6'   22 2AAF'              	SHLD	OPHI
  13F9'                         OPA_C1:
  13F9'   CD 1445'              	CALL	OPSPNL
  13FC'   7C                    	MOV	A,H
  13FD'   B5                    	ORA	L
  13FE'   CA 1381'              	JZ	OPA_DO		; nothing spanned
  1401'   2A 2AAF'              	LHLD	OPHI
  1404'   CD 0624'              	CALL	BOL
  1407'   EB                    	XCHG
  1408'   2A 2AAF'              	LHLD	OPHI
  140B'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  140E'   C2 1381'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  1411'   CD 13D3'              	CALL	LOIND
  1414'   CA 1424'              	JZ	C1_LW		; only blanks before lo: whole lines
  1417'                         C1_CH:
  1417'   2A 2AAF'              	LHLD	OPHI		; back over the line break to the content end
  141A'   2B                    	DCX	H		;   of the line before
  141B'   CD 156F'              	CALL	CEND
  141E'   22 2AAF'              	SHLD	OPHI
  1421'   C3 1381'              	JMP	OPA_DO
  1424'                         C1_LW:
  1424'   2A 2AAD'              	LHLD	OPLO
  1427'   CD 0624'              	CALL	BOL
  142A'   22 2AAD'              	SHLD	OPLO
  142D'   3A 2A99'              	LDA	PSAVE
  1430'   FE 63                 	CPI	'c'
  1432'   CA 1417'              	JZ	C1_CH
  1435'   C3 14CC'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  1438'                         SPNBRK:
  1438'   2A 2AAD'              	LHLD	OPLO
  143B'   CD 0637'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  143E'   EB                    	XCHG			; DE = it
  143F'   2A 2AAF'              	LHLD	OPHI
  1442'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  1445'                         OPSPNL:
  1445'   2A 2AAF'              	LHLD	OPHI
  1448'   EB                    	XCHG
  1449'   2A 2AAD'              	LHLD	OPLO
  144C'   EB                    	XCHG			; HL = hi, DE = lo
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  144D'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  1450'                         OPDSPN:
  1450'   CD 1438'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  1453'   F5                    	PUSH	PSW
  1454'   2A 2AAD'              	LHLD	OPLO
  1457'   CD 0000*              	CALL	GOTO
  145A'   CD 1445'              	CALL	OPSPNL		; HL = hi - lo
  145D'   CD 0000*              	CALL	DELFWD
  1460'   CD 0174'              	CALL	MARKMOD
  1463'   F1                    	POP	PSW
  1464'   DA 07BB'              	JC	SETFUL		; a break went: every row below it moved up
  1467'   C3 07A0'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  146A'                         UNDFNB:
  146A'   CD 0000*              	CALL	CUROFF
  146D'   E5                    	PUSH	H
  146E'   CD 0874'              	CALL	FNBLNK
  1471'   CD 0000*              	CALL	CUROFF
  1474'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  1475'   CD 0000*              	CALL	CMP16
  1478'   D2 0000*              	JNC	UNDHER
  147B'   EB                    	XCHG
  147C'   CD 0000*              	CALL	GOTO
  147F'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  1482'                         OPALSP:
  1482'   2A 2A9D'              	LHLD	OPSTA
  1485'   EB                    	XCHG
  1486'   2A 2A9F'              	LHLD	OPEND2
  1489'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  148C'   DA 149C'              	JC	OPAL_F
  148F'   22 2AAD'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1492'   EB                    	XCHG
  1493'   22 2AAF'              	SHLD	OPHI		; hi-src = start
  1496'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  1499'   C3 14A6'              	JMP	OPAL_R
  149C'                         OPAL_F:
  149C'   EB                    	XCHG			; HL = start
  149D'   22 2AAD'              	SHLD	OPLO		; lo-src = start
  14A0'   2A 2A9F'              	LHLD	OPEND2
  14A3'   22 2AAF'              	SHLD	OPHI		; hi-src = end
  14A6'                         OPAL_R:
  14A6'   2A 2AAD'              	LHLD	OPLO
  14A9'   CD 0624'              	CALL	BOL
  14AC'   22 2AAD'              	SHLD	OPLO		; lo = BOL(low line)
  14AF'   2A 2AAF'              	LHLD	OPHI
  14B2'   CD 0654'              	CALL	NLSTART
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  14B5'   22 2AAF'              	SHLD	OPHI		; hi = start of line past the high line
  14B8'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  14B9'                         OPALIN:
  14B9'   CD 1482'              	CALL	OPALSP
  14BC'   2A 2AAD'              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  14BF'   CD 0654'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  14C2'   EB                    	XCHG			;   the column)
  14C3'   2A 2AAF'              	LHLD	OPHI
  14C6'   CD 0000*              	CALL	CMP16
  14C9'   CC 146A'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  14CC'                         OPDLIN:
  14CC'   CD 1450'              	CALL	OPDSPN
  14CF'   CD 06A7'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  14D2'   DA 14E2'              	JC	OPDL_NB
  14D5'   CD 0000*              	CALL	LOGLEN
  14D8'   7C                    	MOV	A,H
  14D9'   B5                    	ORA	L
  14DA'   C8                    	RZ			; empty buffer
  14DB'   2B                    	DCX	H
  14DC'   CD 0624'              	CALL	BOL
  14DF'   CD 0000*              	CALL	GOTO
  14E2'                         OPDL_NB:
  14E2'   C3 0874'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  14E5'                         OPCTAB:
  14E5'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  14E9'   62 00 42 00           
  14ED'   68 00 6C 00           
  14F1'   30 00 5E 00           
  14F5'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  14F7'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  14FB'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  14FF'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  1503'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1507'   24 01                 
  1509'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  150D'   47 02 48 02           
  1511'   4D 02 4C 02           
  1515'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  1517'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1519'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  151A'                         VCB_C:
  151A'   CD 1526'              	CALL	VCB_CD
  151D'   C3 15F1'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  1520'                         VCB_D:
  1520'   CD 1526'              	CALL	VCB_CD
  1523'   C3 1580'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  1526'                         VCB_CD:
  1526'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1529'   22 2AAD'              	SHLD	OPLO
  152C'   CD 0000*              	CALL	CUROFF
  152F'   CD 156F'              	CALL	CEND		; to the line's content end, the CR,LF left
  1532'   22 2AAF'              	SHLD	OPHI
  1535'   C3 1450'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  1538'                         VC_X:
  1538'   CD 0926'              	CALL	GLSTAL
  153B'   CD 07A0'              	CALL	SETLIN
  153E'   CD 06CB'              	CALL	GETCNT
  1541'   22 2AB1'              	SHLD	CNTV
  1544'   CD 0000*              	CALL	CUROFF
  1547'   22 2AB5'              	SHLD	WKI		; cur
  154A'   CD 156F'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  154D'   EB                    	XCHG			; DE = contentend
  154E'   2A 2AB5'              	LHLD	WKI		; HL = cur
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  1551'   EB                    	XCHG			; HL = contentend, DE = cur
  1552'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  1555'   7C                    	MOV	A,H
  1556'   B5                    	ORA	L
  1557'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  1558'   EB                    	XCHG			; DE = available
  1559'   2A 2AB1'              	LHLD	CNTV		; HL = count
  155C'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  155F'   DA 1565'              	JC	VX_USEA
  1562'   C3 1566'              	JMP	VX_DEL		; count <= available -> HL = count = del
  1565'                         VX_USEA:
  1565'   EB                    	XCHG			; HL = available
  1566'                         VX_DEL:
  1566'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  1569'   CD 0174'              	CALL	MARKMOD
  156C'   C3 1580'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  156F'                         CEND:
  156F'   CD 0637'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1572'   7C                    	MOV	A,H
  1573'   B5                    	ORA	L
  1574'   C8                    	RZ			; the start of the text: nothing before it
  1575'   2B                    	DCX	H
  1576'   E5                    	PUSH	H
  1577'   CD 0000*              	CALL	CHARAT
  157A'   E1                    	POP	H		; HL = term-1
  157B'   FE 0D                 	CPI	CR
  157D'   C8                    	RZ			; a CR before the LF -> the content ends there
  157E'   23                    	INX	H
  157F'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  1580'                         CLAMPE:
  1580'   CD 0000*              	CALL	CUROFF
  1583'   E5                    	PUSH	H
  1584'   CD 0663'              	CALL	EOLC
  1587'   D1                    	POP	D		; DE = cur
  1588'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  158B'   D8                    	RC
  158C'   C8                    	RZ
  158D'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1590'                         VC_I:
  1590'   CD 06CB'              	CALL	GETCNT
  1593'   C3 15EE'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1596'                         VC_A:
  1596'   CD 06CB'              	CALL	GETCNT
  1599'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  159C'   CA 15B3'              	JZ	VA_INS
  159F'   EB                    	XCHG			; HL = cur
  15A0'   E5                    	PUSH	H
  15A1'   CD 0000*              	CALL	CHARAT
  15A4'   E1                    	POP	H
  15A5'   FE 0A                 	CPI	LF
  15A7'   CA 15B3'              	JZ	VA_INS		; on the line terminator -> append in place
  15AA'   FE 0D                 	CPI	CR
  15AC'   CA 15B3'              	JZ	VA_INS
  15AF'   23                    	INX	H
  15B0'   CD 0000*              	CALL	GOTO
  15B3'                         VA_INS:
  15B3'   C3 15EE'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  15B6'                         VCB_A:
  15B6'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15B9'   CD 0663'              	CALL	EOLC		; HL = last content char (the start when empty)
  15BC'   E5                    	PUSH	H
  15BD'   CD 0000*              	CALL	CHARAT
  15C0'   E1                    	POP	H
  15C1'   FE 0D                 	CPI	CR
  15C3'   CA 15CC'              	JZ	VBA_IN		; an empty line: insert at its start
  15C6'   FE 0A                 	CPI	LF
  15C8'   CA 15CC'              	JZ	VBA_IN
  15CB'   23                    	INX	H		; past the last content char
  15CC'                         VBA_IN:
  15CC'   CD 0000*              	CALL	GOTO
  15CF'   C3 15EE'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  15D2'                         VCB_I:
  15D2'   CD 06CB'              	CALL	GETCNT
  15D5'   CD 0874'              	CALL	FNBLNK
  15D8'   CD 0000*              	CALL	CUROFF
  15DB'   E5                    	PUSH	H
  15DC'   CD 0000*              	CALL	CHARAT
  15DF'   E1                    	POP	H
  15E0'   FE 20                 	CPI	' '
  15E2'   CA 15EA'              	JZ	VBI_SK
  15E5'   FE 09                 	CPI	TAB
  15E7'   C2 15EE'              	JNZ	SETINM
  15EA'                         VBI_SK:
  15EA'   23                    	INX	H		; blanks only: past the last of them
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  15EB'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  15EE'                         SETINM:
  15EE'   CD 079A'              	CALL	SETMOV
  15F1'                         SETINS:
  15F1'   3E 01                 	MVI	A,EM_INS
  15F3'   32 2A6E'              	STA	EDMODE
  15F6'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  15F7'                         ATCEND:
  15F7'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  15FA'   C8                    	RZ
  15FB'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  15FE'   FE 0D                 	CPI	CR
  1600'   C8                    	RZ
  1601'   FE 0A                 	CPI	LF
  1603'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1604'                         OPNBRK:
  1604'   CD 1EFB'              	CALL	PUTBRK
  1607'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  160A'   23                    	INX	H
  160B'   22 0000*              	SHLD	LNDLT
  160E'   C3 0174'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1611'                         ENDBRK:
  1611'   CD 06A7'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1614'   C0                    	RNZ
  1615'   CD 1604'              	CALL	OPNBRK
  1618'   CD 0000*              	CALL	CUROFF
  161B'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  161C'   2B                    	DCX	H		;   line, with its own terminator after it
  161D'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1620'                         VC_O:
  1620'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1623'   CD 156F'              	CALL	CEND
  1626'   CD 0000*              	CALL	GOTO
  1629'   CD 1604'              	CALL	OPNBRK
  162C'   CD 1611'              	CALL	ENDBRK		; a last line with no line end: the opened line
  162F'   CD 07A6'              	CALL	SETILN		;   needs a terminator of its own to exist
  1632'   C3 15F1'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1635'                         VCB_O:
  1635'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1638'   CD 0624'              	CALL	BOL
  163B'   CD 0000*              	CALL	GOTO
  163E'   CD 1604'              	CALL	OPNBRK
  1641'   CD 0000*              	CALL	CUROFF
  1644'   2B                    	DCX	H
  1645'   2B                    	DCX	H
  1646'   CD 0000*              	CALL	GOTO
  1649'   CD 07A6'              	CALL	SETILN
  164C'   C3 15F1'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  164F'                         VCB_J:
  164F'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1652'   CD 156F'              	CALL	CEND		; the join point: this line's content end
  1655'   22 2AAD'              	SHLD	OPLO
  1658'   CD 0000*              	CALL	CUROFF
  165B'   CD 0654'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  165E'   E5                    	PUSH	H
  165F'   CD 0000*              	CALL	LOGLEN
  1662'   D1                    	POP	D		; DE = that start
  1663'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1666'   CA 079A'              	JZ	SETMOV
  1669'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  166A'                         VJ_WS:
  166A'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  166B'   CD 0000*              	CALL	LOGLEN
  166E'   D1                    	POP	D		; DE = the scan
  166F'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1672'   CA 1689'              	JZ	VJ_DEL
  1675'   EB                    	XCHG			; HL = the scan
  1676'   E5                    	PUSH	H
  1677'   CD 0000*              	CALL	CHARAT
  167A'   E1                    	POP	H
  167B'   FE 20                 	CPI	' '
  167D'   CA 1685'              	JZ	VJ_SKIP
  1680'   FE 09                 	CPI	TAB
  1682'   C2 1689'              	JNZ	VJ_DEL
  1685'                         VJ_SKIP:
  1685'   23                    	INX	H
  1686'   C3 166A'              	JMP	VJ_WS
  1689'                         VJ_DEL:
  1689'   22 2AAF'              	SHLD	OPHI
  168C'   CD 1450'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  168F'   CD 07B5'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1692'   CD 06A7'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1695'   CA 1580'              	JZ	CLAMPE
  1698'   CD 06B2'              	CALL	CURCHR		; the first char of what was appended
  169B'   FE 0D                 	CPI	CR
  169D'   CA 1580'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  16A0'   FE 0A                 	CPI	LF
  16A2'   CA 1580'              	JZ	CLAMPE
  16A5'   FE 29                 	CPI	')'
  16A7'   CA 1580'              	JZ	CLAMPE		; vim puts no space before a ')'
  16AA'   CD 0000*              	CALL	CUROFF
  16AD'   7C                    	MOV	A,H
  16AE'   B5                    	ORA	L
  16AF'   CA 16C5'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  16B2'   2B                    	DCX	H
  16B3'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  16B6'   FE 20                 	CPI	' '
  16B8'   CA 1580'              	JZ	CLAMPE
  16BB'   FE 09                 	CPI	TAB
  16BD'   CA 1580'              	JZ	CLAMPE
  16C0'   FE 0A                 	CPI	LF
  16C2'   CA 1580'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  16C5'                         VJ_SP:
  16C5'   3E 20                 	MVI	A,' '
  16C7'   CD 0000*              	CALL	PUTGAP
  16CA'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  16CD'   2B                    	DCX	H
  16CE'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  16D1'                         VC_TILD:
  16D1'   CD 06CB'              	CALL	GETCNT
  16D4'   CD 07A0'              	CALL	SETLIN		; only this row changes
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  16D7'   CD 0926'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  16DA'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  16DD'   CA 079A'              	JZ	SETMOV
  16E0'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  16E3'   FE 0D                 	CPI	CR
  16E5'   CA 079A'              	JZ	SETMOV		; the line's end: nothing to toggle
  16E8'   FE 0A                 	CPI	LF
  16EA'   CA 079A'              	JZ	SETMOV
  16ED'   47                    	MOV	B,A
  16EE'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  16F0'   FE 41                 	CPI	'A'
  16F2'   DA 16FE'              	JC	VT_PUT		; below 'A': no case
  16F5'   FE 5B                 	CPI	'Z'+1
  16F7'   D2 16FE'              	JNC	VT_PUT		; above 'Z': no case
  16FA'   78                    	MOV	A,B
  16FB'   EE 20                 	XRI	20H		; a letter: flip the case bit
  16FD'   47                    	MOV	B,A
  16FE'                         VT_PUT:
  16FE'   78                    	MOV	A,B
  16FF'   32 2ABE'              	STA	VRCH		; the calls below do not preserve B
  1702'   CD 0174'              	CALL	MARKMOD
  1705'   21 0001               	LXI	H,1
  1708'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  170B'   3A 2ABE'              	LDA	VRCH
  170E'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1711'   C3 1580'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  1714'                         VC_R:
  1714'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  1717'   3E 03                 	MVI	A,PR
  1719'   32 2A96'              	STA	GPEND
  171C'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  171D'                         VR_DO:
  171D'   AF                    	XRA	A
  171E'   32 2A96'              	STA	GPEND
  1721'   79                    	MOV	A,C
  1722'   32 2ABE'              	STA	VRCH		; the calls below do not preserve C
  1725'   CD 07A0'              	CALL	SETLIN		; only this row changed
  1728'   CD 0926'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  172B'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  172E'   CA 079A'              	JZ	SETMOV		; the end of the text: vim does nothing
  1731'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  1734'   FE 0D                 	CPI	CR
  1736'   CA 079A'              	JZ	SETMOV		; the line's end: nothing to replace
  1739'   FE 0A                 	CPI	LF
  173B'   CA 079A'              	JZ	SETMOV
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  173E'   CD 0174'              	CALL	MARKMOD
  1741'   21 0001               	LXI	H,1
  1744'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1747'   3A 2ABE'              	LDA	VRCH
  174A'   FE 0D                 	CPI	CR
  174C'   CA 1759'              	JZ	VR_CR
  174F'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1752'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1755'   2B                    	DCX	H		;   out, which moves every logical offset
  1756'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1759'                         VR_CR:
  1759'   CD 1604'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  175C'   CD 1611'              	CALL	ENDBRK		;   replaced char may have been the text's last
  175F'   CD 07A6'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1762'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1764'   32 2A76'              	STA	ILABOV
  1767'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1768'                         VCB_R:
  1768'   CD 06CB'              	CALL	GETCNT
  176B'   CD 079A'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  176E'   21 0000               	LXI	H,0
  1771'   22 2ABF'              	SHLD	RPDEL		; nothing of ours to put back yet
  1774'   22 2AC1'              	SHLD	RPAPP
  1777'   3E 02                 	MVI	A,EM_REP
  1779'   32 2A6E'              	STA	EDMODE
  177C'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  177D'                         VC_D:
  177D'   3E 64                 	MVI	A,'d'
  177F'   32 2A98'              	STA	PENDOP
  1782'   C3 079A'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1785'                         VC_C:
  1785'   3E 63                 	MVI	A,'c'
  1787'   32 2A98'              	STA	PENDOP
  178A'   C3 079A'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  178D'                         VD_DD:
  178D'   CD 0926'              	CALL	GLSTAL
  1790'   CD 06CB'              	CALL	GETCNT
  1793'   22 2AB1'              	SHLD	CNTV
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  1796'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1798'   32 2A9A'              	STA	DDSNG
  179B'   2B                    	DCX	H
  179C'   7C                    	MOV	A,H
  179D'   B5                    	ORA	L
  179E'   C2 17AC'              	JNZ	VDD_LS
  17A1'   3E 01                 	MVI	A,1
  17A3'   32 2A9A'              	STA	DDSNG
  17A6'   CD 146A'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  17A9'   C3 17B2'              	JMP	VDD_GO
  17AC'                         VDD_LS:
  17AC'   CD 08DF'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  17AF'   DA 079A'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  17B2'                         VDD_GO:
  17B2'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  17B5'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  17B8'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  17BB'   CD 215E'              	CALL	COPY12		;   every mark in the lines has closed up by then
  17BE'   CD 085D'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  17C1'   2A 2AB1'              	LHLD	CNTV
  17C4'   CD 0000*              	CALL	SETC0
  17C7'                         VDD_FW:
  17C7'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  17CA'   DA 1918'              	JC	QREFUS		; ... which has no room for them
  17CD'   CD 06E0'              	CALL	CNTTST
  17D0'   C2 17C7'              	JNZ	VDD_FW
  17D3'   CD 0174'              	CALL	MARKMOD
  17D6'   CD 0A5D'              	CALL	ATEOF
  17D9'   D2 17F4'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  17DC'   3E 00                 	MVI	A,0
  17DE'   32 2A9A'              	STA	DDSNG		; deleted to the end: full repaint
  17E1'   CD 0E9F'              	CALL	ONFST
  17E4'   CA 0874'              	JZ	FNBLNK		; nothing left before it
  17E7'   21 0001               	LXI	H,1		; onto the new last line
  17EA'   CD 0000*              	CALL	SETBWD
  17ED'   2A 0000*              	LHLD	LNDLT
  17F0'   2B                    	DCX	H
  17F1'   22 0000*              	SHLD	LNDLT
  17F4'                         VDD_UP:
  17F4'   CD 0874'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  17F7'   3A 2A9A'              	LDA	DDSNG
  17FA'   B7                    	ORA	A
  17FB'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  17FC'   3E 03                 	MVI	A,R_DLIN
  17FE'   32 2A73'              	STA	RINTENT
  1801'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1802'                         QEMPTY:
  1802'   2A 0000*              	LHLD	QBEG
  1805'   EB                    	XCHG
  1806'   2A 0000*              	LHLD	QEND
  1809'   7C                    	MOV	A,H
  180A'   BA                    	CMP	D
  180B'   C0                    	RNZ
  180C'   7D                    	MOV	A,L
  180D'   BB                    	CMP	E
  180E'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  180F'                         VC_Y:
  180F'   3E 79                 	MVI	A,'y'
  1811'   32 2A98'              	STA	PENDOP
  1814'   C3 079A'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1817'                         VY_YY:
  1817'   21 2AA1'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  181A'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  181D'   CD 0000*              	CALL	CUROFF
  1820'   22 2AE2'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1823'   CD 0624'              	CALL	BOL
  1826'   22 2AE4'              	SHLD	YPT		; where the lines come from, to put them back
  1829'   CD 197E'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  182C'   CD 19C1'              	CALL	YNCOPY		; copied where they lie, if that can be done
  182F'   D2 1985'              	JNC	YNDONE
  1832'   21 178D'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1835'   C3 1861'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1838'                         OPYANK:
  1838'   CD 1482'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  183B'   2A 2A9D'              	LHLD	OPSTA
  183E'   EB                    	XCHG			; DE = start
  183F'   2A 2A9F'              	LHLD	OPEND2		; HL = end
  1842'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1845'   D2 1849'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1848'   EB                    	XCHG			; ... otherwise the start is
  1849'                         OPY_LO:
  1849'   22 2AE2'              	SHLD	YOFF
  184C'   2A 2AAD'              	LHLD	OPLO
  184F'   22 2AE4'              	SHLD	YPT		; where the lines come from, to put them back
  1852'   CD 197E'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1855'   CD 1A39'              	CALL	YNSPAN		; copied where they lie, if there is room
  1858'   D2 1985'              	JNC	YNDONE
  185B'   21 193F'              	LXI	H,YSPAN
  185E'   C3 1861'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1861'                         YKGO:
  1861'   22 2B0C'              	SHLD	YACT
  1864'   2A 2AE4'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1867'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1868'   2A 2AE2'              	LHLD	YOFF		;   survive this -- the put-back below can page
  186B'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  186E'   22 2B12'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1871'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1874'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1875'   2A 2AE4'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1878'   EB                    	XCHG			;   window as it was, then names other text
  1879'   E1                    	POP	H
  187A'   CD 0000*              	CALL	SUBHD
  187D'   EB                    	XCHG			; DE = how far behind the cursor they start
  187E'   CD 0F6C'              	CALL	CURFP
  1881'   06 00                 	MVI	B,0
  1883'   CD 0F62'              	CALL	SUB24
  1886'   22 2B14'              	SHLD	YPFP
  1889'   32 2B16'              	STA	YPFP+2
  188C'   3A 2A72'              	LDA	MODF
  188F'   32 2ADF'              	STA	YMODF
  1892'   3A 2A8B'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1895'   32 2AE0'              	STA	YDCHG		;   a yank must not become the last change
  1898'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  189B'   32 2AE1'              	STA	YURPL		;   back are not a change to undo either
  189E'   3E 01                 	MVI	A,1
  18A0'   32 0000*              	STA	UNDRPL
  18A3'   32 2B0B'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  18A6'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  18A9'   22 2AEE'              	SHLD	YLDLT
  18AC'   CD 0000*              	CALL	LOGLEN
  18AF'   22 2B10'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  18B2'   2A 2B0C'              	LHLD	YACT
  18B5'   CD 1917'              	CALL	YCALL		; the lines out of the file, into the register
  18B8'   3A 2ADA'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  18BB'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  18BD'   CA 18FB'              	JZ	YK_RF		;   cursor: only the flags are still owed
  18C0'   CD 0000*              	CALL	LOGLEN
  18C3'   EB                    	XCHG
  18C4'   2A 2B10'              	LHLD	YWAS
  18C7'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  18CA'   CA 18DC'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  18CD'   21 2B14'              	LXI	H,YPFP		; back to where they came from, by its place in
  18D0'   CD 03DC'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  18D3'   CD 03A9'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  18D6'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  18D9'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  18DC'                         YK_FIN:				; (nothing came out: nothing went back, and the
  18DC'   2A 2B14'              	LHLD	YPFP		;   cursor is still owed its place)
  18DF'   EB                    	XCHG
  18E0'   2A 2B12'              	LHLD	YCOL
  18E3'   19                    	DAD	D
  18E4'   22 2B07'              	SHLD	MKPOS
  18E7'   3A 2B16'              	LDA	YPFP+2
  18EA'   CE 00                 	ACI	0
  18EC'   32 2B09'              	STA	MKPOS+2
  18EF'   CD 03A9'              	CALL	MKPAGE
  18F2'   CD 0000*              	CALL	GOTO
  18F5'                         YK_RST:
  18F5'   2A 2AEE'              	LHLD	YLDLT
  18F8'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  18FB'                         YK_RF:
  18FB'   3A 2ADF'              	LDA	YMODF
  18FE'   32 2A72'              	STA	MODF
  1901'   3A 2AE0'              	LDA	YDCHG
  1904'   32 2A8B'              	STA	DOTCHG
  1907'   3A 2AE1'              	LDA	YURPL
  190A'   32 0000*              	STA	UNDRPL
  190D'   AF                    	XRA	A
  190E'   32 2B0B'              	STA	MKHOLD
  1911'   CD 0926'              	CALL	GLSTAL
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  1914'   C3 07BB'              	JMP	SETFUL		; the cheap paint cannot carry this
  1917'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1918'                         QREFUS:
  1918'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  191B'   CD 1802'              	CALL	QEMPTY
  191E'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1921'   CD 0000*              	CALL	QKILL
  1924'   3A 2B0B'              	LDA	MKHOLD
  1927'   B7                    	ORA	A
  1928'   C2 1937'              	JNZ	QRF_Y
  192B'   21 0000*              	LXI	H,MKSAV
  192E'   11 0000*              	LXI	D,MKTAB
  1931'   CD 215E'              	CALL	COPY12
  1934'   CD 0000*              	CALL	UNDCLR
  1937'                         QRF_Y:
  1937'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1939'   32 2ADA'              	STA	MSGWHT
  193C'   C3 1291'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  193F'                         YSPAN:
  193F'   CD 0926'              	CALL	GLSTAL
  1942'   CD 1445'              	CALL	OPSPNL		; HL = the span's length
  1945'   22 2B0E'              	SHLD	YTGT
  1948'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  194B'   EB                    	XCHG			; DE = it
  194C'   2A 2B0E'              	LHLD	YTGT
  194F'   EB                    	XCHG			; HL = the text's, DE = the span's
  1950'   CD 0000*              	CALL	SUBHD
  1953'   22 2B0E'              	SHLD	YTGT		; what the text is left at when the span is out
  1956'   2A 2AAD'              	LHLD	OPLO
  1959'   CD 0000*              	CALL	GOTO
  195C'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  195F'                         YS_LP:
  195F'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  1962'   CD 0000*              	CALL	SETC0
  1965'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1968'   DA 1918'              	JC	QREFUS		; ... which has no room for it
  196B'   CD 0000*              	CALL	LOGLEN
  196E'   EB                    	XCHG			; DE = what is left
  196F'   2A 2B0E'              	LHLD	YTGT
  1972'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1975'   DA 197B'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1978'   C2 195F'              	JNZ	YS_LP		;   but never spin here if it ever did
  197B'                         YS_END:
  197B'   C3 0174'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  197E'                         YNPRE:
  197E'   2A 0000*              	LHLD	PGTOPM
  1981'   22 2B17'              	SHLD	YNPG
  1984'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1985'                         YNDONE:
  1985'   2A 2AE2'              	LHLD	YOFF
  1988'   CD 0000*              	CALL	GOTO
  198B'   2A 0000*              	LHLD	PGTOPM
  198E'   EB                    	XCHG
  198F'   2A 2B17'              	LHLD	YNPG
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  1992'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1995'   C2 07BB'              	JNZ	SETFUL		; it moved under us: repaint after all
  1998'   C3 079A'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  199B'                         YNROOM:
  199B'   11 0100               	LXI	D,100H
  199E'   19                    	DAD	D
  199F'   D8                    	RC			; within a chunk of 64K: no arena holds that
  19A0'   E5                    	PUSH	H		; the span plus its slack
  19A1'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  19A4'   EB                    	XCHG			; HL = free
  19A5'   D1                    	POP	D		; DE = the span plus its slack
  19A6'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  19A9'   DA 19B1'              	JC	YNR_OK
  19AC'   CA 19B1'              	JZ	YNR_OK
  19AF'   37                    	STC			; not enough: the delete-and-put-back path
  19B0'   C9                    	RET
  19B1'                         YNR_OK:
  19B1'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  19B2'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  19B3'                         YNGO:
  19B3'   C5                    	PUSH	B
  19B4'   CD 06CB'              	CALL	GETCNT		; spent here: this yank is happening
  19B7'   CD 0926'              	CALL	GLSTAL
  19BA'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  19BD'   C1                    	POP	B
  19BE'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  19C1'                         YNCOPY:
  19C1'   2A 2A6F'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  19C4'   7C                    	MOV	A,H		;   the count itself
  19C5'   B5                    	ORA	L
  19C6'   C2 19CC'              	JNZ	YNC_HV
  19C9'   21 0001               	LXI	H,1
  19CC'                         YNC_HV:
  19CC'   7D                    	MOV	A,L		; a count of one always has its own line to take;
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  19CD'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  19CE'   B4                    	ORA	H
  19CF'   CA 19DA'              	JZ	YNC_M
  19D2'   E5                    	PUSH	H
  19D3'   CD 08DF'              	CALL	ONLAST		; vim: a count over one on the last line does
  19D6'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  19D7'   DA 19EC'              	JC	YNC_RF
  19DA'                         YNC_M:
  19DA'   E5                    	PUSH	H
  19DB'   CD 085D'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  19DE'   E1                    	POP	H
  19DF'   CD 19F4'              	CALL	YNLINE		; BC = the span, measured where it stands
  19E2'   D8                    	RC			; not measurable here: let the pager answer it
  19E3'   60                    	MOV	H,B
  19E4'   69                    	MOV	L,C
  19E5'   CD 199B'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  19E8'   D8                    	RC			; no: the delete-and-put-back path
  19E9'   C3 19B3'              	JMP	YNGO
  19EC'                         YNC_RF:
  19EC'   CD 06CB'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  19EF'   CD 0926'              	CALL	GLSTAL		;   register alone, and that is the command
  19F2'   B7                    	ORA	A		; NC: done
  19F3'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  19F4'                         YNLINE:
  19F4'   22 2B19'              	SHLD	YNCNT		; the lines it still wants
  19F7'   2A 0000*              	LHLD	GAPEND
  19FA'                         YNL_LP:
  19FA'   EB                    	XCHG			; DE = the scan
  19FB'   2A 0000*              	LHLD	TXTEND
  19FE'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1A01'   EB                    	XCHG			; HL = the scan
  1A02'   D2 1A22'              	JNC	YNL_EN		; the resident text ran out
  1A05'   7E                    	MOV	A,M
  1A06'   23                    	INX	H
  1A07'   FE 0A                 	CPI	LF
  1A09'   C2 19FA'              	JNZ	YNL_LP
  1A0C'   E5                    	PUSH	H
  1A0D'   2A 2B19'              	LHLD	YNCNT
  1A10'   2B                    	DCX	H
  1A11'   22 2B19'              	SHLD	YNCNT
  1A14'   7C                    	MOV	A,H
  1A15'   B5                    	ORA	L
  1A16'   E1                    	POP	H
  1A17'   C2 19FA'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1A1A'   EB                    	XCHG			; DE = past the last of them
  1A1B'   2A 0000*              	LHLD	GAPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A1E'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1A1F'   C3 1A30'              	JMP	YNL_BC
  1A22'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1A22'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1A25'   C2 1A37'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1A28'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1A2B'   EB                    	XCHG			;   count clamps to it as vim's does
  1A2C'   2A 0000*              	LHLD	GAPEND
  1A2F'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1A30'                         YNL_BC:
  1A30'   CD 0000*              	CALL	SUBHD		; HL = the span
  1A33'   44                    	MOV	B,H
  1A34'   4D                    	MOV	C,L
  1A35'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1A36'   C9                    	RET
  1A37'                         YNL_NO:
  1A37'   37                    	STC
  1A38'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1A39'                         YNSPAN:
  1A39'   CD 1445'              	CALL	OPSPNL		; HL = the span's length
  1A3C'   44                    	MOV	B,H
  1A3D'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1A3E'   CD 199B'              	CALL	YNROOM
  1A41'   D8                    	RC			; no room: the delete-and-put-back path
  1A42'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1A43'   2A 2AAD'              	LHLD	OPLO
  1A46'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1A49'   C1                    	POP	B
  1A4A'   C3 19B3'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1A4D'                         VC_P:
  1A4D'   CD 1802'              	CALL	QEMPTY
  1A50'   CA 1B23'              	JZ	VP_BEL
  1A53'   CD 06CB'              	CALL	GETCNT
  1A56'   22 2AE6'              	SHLD	PCNT
  1A59'   CD 0000*              	CALL	CUROFF
  1A5C'   CD 0654'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1A5F'   C3 1A74'              	JMP	VP_GO
  1A62'                         VCB_P:
  1A62'   CD 1802'              	CALL	QEMPTY
  1A65'   CA 1B23'              	JZ	VP_BEL
  1A68'   CD 06CB'              	CALL	GETCNT
  1A6B'   22 2AE6'              	SHLD	PCNT
  1A6E'   CD 0000*              	CALL	CUROFF
  1A71'   CD 0624'              	CALL	BOL
  1A74'                         VP_GO:
  1A74'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


                                	;    still makes a new line, so the missing break goes in first ---
  1A77'   CD 0000*              	CALL	CUROFF
  1A7A'   EB                    	XCHG
  1A7B'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1A7E'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1A81'   DA 1A96'              	JC	VP_IN
  1A84'   EB                    	XCHG			; HL = the put point = LOGLEN
  1A85'   7C                    	MOV	A,H
  1A86'   B5                    	ORA	L
  1A87'   CA 1A93'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1A8A'   2B                    	DCX	H
  1A8B'   CD 0000*              	CALL	CHARAT
  1A8E'   FE 0A                 	CPI	LF
  1A90'   CA 1A96'              	JZ	VP_IN
  1A93'                         VP_BRK:
  1A93'   CD 1604'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1A96'                         VP_IN:
  1A96'   21 2AE8'              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1A99'   CD 0429'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1A9C'   CD 0FB5'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1A9F'   2A 0000*              	LHLD	QBEG
  1AA2'   EB                    	XCHG
  1AA3'   2A 0000*              	LHLD	QEND
  1AA6'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1AA9'   EB                    	XCHG
  1AAA'   22 2AEB'              	SHLD	PLFS
  1AAD'   2A 2AE6'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1AB0'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1AB1'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1AB2'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1AB4'   C2 1AB8'              	JNZ	VP_PZ
  1AB7'   7D                    	MOV	A,L
  1AB8'                         VP_PZ:
  1AB8'   32 2AED'              	STA	PCPY
  1ABB'                         VP_LP:
  1ABB'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1ABE'   2A 0000*              	LHLD	LNDLT
  1AC1'   EB                    	XCHG
  1AC2'   2A 2AEB'              	LHLD	PLFS
  1AC5'   19                    	DAD	D
  1AC6'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1AC9'   2A 2AE6'              	LHLD	PCNT
  1ACC'   2B                    	DCX	H
  1ACD'   22 2AE6'              	SHLD	PCNT
  1AD0'   7C                    	MOV	A,H
  1AD1'   B5                    	ORA	L
  1AD2'   C2 1ABB'              	JNZ	VP_LP
  1AD5'   CD 0174'              	CALL	MARKMOD
  1AD8'   21 2AE8'              	LXI	H,PPFP
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1ADB'   CD 03DC'              	CALL	MKLOAD
  1ADE'   CD 03E9'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1AE1'   D2 1B14'              	JNC	VP_PGD
  1AE4'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1AE7'   CD 0926'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1AEA'   3A 2AED'              	LDA	PCPY
  1AED'   B7                    	ORA	A
  1AEE'   CA 0874'              	JZ	FNBLNK
  1AF1'   2A 2AEB'              	LHLD	PLFS
  1AF4'   7C                    	MOV	A,H
  1AF5'   B7                    	ORA	A
  1AF6'   C2 0874'              	JNZ	FNBLNK
  1AF9'   3A 2AED'              	LDA	PCPY
  1AFC'   CD 0E35'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1AFF'   7C                    	MOV	A,H
  1B00'   B7                    	ORA	A
  1B01'   C2 0874'              	JNZ	FNBLNK
  1B04'   7D                    	MOV	A,L
  1B05'   B7                    	ORA	A
  1B06'   CA 0874'              	JZ	FNBLNK
  1B09'   F5                    	PUSH	PSW
  1B0A'   CD 07A6'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1B0D'   F1                    	POP	PSW
  1B0E'   32 2A74'              	STA	ILN		; ... which the lines put now replace
  1B11'   C3 0874'              	JMP	FNBLNK
  1B14'                         VP_PGD:				; the put paged its first line out: page back
  1B14'   CD 03A9'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1B17'   CD 0000*              	CALL	GOTO
  1B1A'   CD 0926'              	CALL	GLSTAL
  1B1D'   CD 0FCD'              	CALL	GPLACE
  1B20'   C3 07BB'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  1B23'                         VP_BEL:
  1B23'   CD 06CB'              	CALL	GETCNT		; the count is spent either way
  1B26'   0E 07                 	MVI	C,BEL
  1B28'   CD 0000*              	CALL	BCONOU
  1B2B'   C3 079A'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  1B2E'                         VIREP:
  1B2E'   79                    	MOV	A,C
  1B2F'   FE 1B                 	CPI	ESC
  1B31'   CA 1C56'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  1B34'   FE 0D                 	CPI	CR
  1B36'   CA 1B9A'              	JZ	VP_CR
  1B39'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1B3B'   CA 1B9A'              	JZ	VP_CR
  1B3E'   FE 08                 	CPI	BS
  1B40'   CA 1BA6'              	JZ	VP_BS
  1B43'   FE 7F                 	CPI	DEL
  1B45'   CA 1BA6'              	JZ	VP_BS
  1B48'   32 2ABE'              	STA	VRCH		; the calls below do not preserve C
  1B4B'   CD 07A0'              	CALL	SETLIN		; this row changed
  1B4E'   CD 0174'              	CALL	MARKMOD
  1B51'   CD 15F7'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1B54'   CA 1B8C'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1B57'   3A 2ABE'              	LDA	VRCH
  1B5A'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1B5D'   2A 2ABF'              	LHLD	RPDEL
  1B60'   7C                    	MOV	A,H
  1B61'   B5                    	ORA	L
  1B62'   CA 1B78'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1B65'   2A 0000*              	LHLD	GAPEND
  1B68'   EB                    	XCHG
  1B69'   2A 2AC3'              	LHLD	RPGE
  1B6C'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1B6F'   CA 1B78'              	JZ	VP_OVW
  1B72'   21 0000               	LXI	H,0
  1B75'   22 2ABF'              	SHLD	RPDEL		; the text moved: those originals are gone
  1B78'                         VP_OVW:
  1B78'   21 0001               	LXI	H,1
  1B7B'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1B7E'   2A 0000*              	LHLD	GAPEND
  1B81'   22 2AC3'              	SHLD	RPGE
  1B84'   2A 2ABF'              	LHLD	RPDEL
  1B87'   23                    	INX	H
  1B88'   22 2ABF'              	SHLD	RPDEL
  1B8B'   C9                    	RET
  1B8C'                         VP_APP:
  1B8C'   3A 2ABE'              	LDA	VRCH
  1B8F'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1B92'   2A 2AC1'              	LHLD	RPAPP
  1B95'   23                    	INX	H
  1B96'   22 2AC1'              	SHLD	RPAPP
  1B99'   C9                    	RET
  1B9A'                         VP_CR:
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1B9A'   21 0000               	LXI	H,0
  1B9D'   22 2ABF'              	SHLD	RPDEL		; a line break ends what BS can put back
  1BA0'   22 2AC1'              	SHLD	RPAPP
  1BA3'   C3 1C2C'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1BA6'                         VP_BS:
  1BA6'   2A 2AC1'              	LHLD	RPAPP
  1BA9'   7C                    	MOV	A,H
  1BAA'   B5                    	ORA	L
  1BAB'   CA 1BB8'              	JZ	VP_BSD
  1BAE'   2B                    	DCX	H
  1BAF'   22 2AC1'              	SHLD	RPAPP		; an appended char: it just goes
  1BB2'   CD 07A0'              	CALL	SETLIN
  1BB5'   C3 0000*              	JMP	DELPRV
  1BB8'                         VP_BSD:
  1BB8'   2A 2ABF'              	LHLD	RPDEL
  1BBB'   7C                    	MOV	A,H
  1BBC'   B5                    	ORA	L
  1BBD'   CA 1BE4'              	JZ	VP_BSM		; nothing of ours left
  1BC0'   2A 0000*              	LHLD	GAPEND
  1BC3'   EB                    	XCHG
  1BC4'   2A 2AC3'              	LHLD	RPGE
  1BC7'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1BCA'   C2 1BE4'              	JNZ	VP_BSM
  1BCD'   2A 2ABF'              	LHLD	RPDEL
  1BD0'   2B                    	DCX	H
  1BD1'   22 2ABF'              	SHLD	RPDEL
  1BD4'   CD 07A0'              	CALL	SETLIN
  1BD7'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1BDA'   CD 0000*              	CALL	UNDELF		; the original comes back
  1BDD'   2A 0000*              	LHLD	GAPEND
  1BE0'   22 2AC3'              	SHLD	RPGE
  1BE3'   C9                    	RET
  1BE4'                         VP_BSM:
  1BE4'   CD 079A'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1BE7'   C3 0809'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  1BEA'                         VIINS:
  1BEA'   79                    	MOV	A,C
  1BEB'   FE 1B                 	CPI	ESC
  1BED'   CA 1C56'              	JZ	VI_ESC
  1BF0'   FE 0D                 	CPI	CR
  1BF2'   CA 1C2C'              	JZ	VI_CR
  1BF5'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1BF7'   CA 1C2C'              	JZ	VI_CR
  1BFA'   FE 08                 	CPI	BS
  1BFC'   CA 1C44'              	JZ	VI_BS
  1BFF'   FE 7F                 	CPI	DEL
  1C01'   CA 1C44'              	JZ	VI_BS
  1C04'   79                    	MOV	A,C
  1C05'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1C08'   CD 0174'              	CALL	MARKMOD
  1C0B'   CD 07A0'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1C0E'   79                    	MOV	A,C
  1C0F'   FE 20                 	CPI	' '
  1C11'   D8                    	RC			; control char -> keep R_LINE
  1C12'   FE 7F                 	CPI	DEL
  1C14'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1C15'   CD 07C1'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1C18'   B7                    	ORA	A
  1C19'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1C1A'   3E 04                 	MVI	A,R_ICH
  1C1C'   32 2A73'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1C1F'   CD 15F7'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1C22'   3E 00                 	MVI	A,0
  1C24'   C2 1C28'              	JNZ	VI_ICH
  1C27'   3C                    	INR	A
  1C28'                         VI_ICH:
  1C28'   32 2A75'              	STA	ICHAPP
  1C2B'   C9                    	RET
  1C2C'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1C2C'   CD 15F7'              	CALL	ATCEND
  1C2F'   3E 00                 	MVI	A,0
  1C31'   CA 1C35'              	JZ	VI_CRS
  1C34'   3C                    	INR	A
  1C35'                         VI_CRS:
  1C35'   F5                    	PUSH	PSW
  1C36'   CD 1604'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1C39'   CD 1611'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1C3C'   CD 07A6'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1C3F'   F1                    	POP	PSW
  1C40'   32 2A76'              	STA	ILABOV
  1C43'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1C44'                         VI_BS:
  1C44'   CD 0000*              	CALL	PEEKL
  1C47'   D8                    	RC			; start of the file: nothing to delete
  1C48'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1C4A'   CA 1C50'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1C4D'   CD 07A0'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1C50'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1C50'   CD 0174'              	CALL	MARKMOD
  1C53'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1C56'                         VI_ESC:
  1C56'   3E 00                 	MVI	A,EM_CMD
  1C58'   32 2A6E'              	STA	EDMODE
  1C5B'   CD 079A'              	CALL	SETMOV
  1C5E'   CD 0809'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1C61'   C3 0926'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1C64'                         RDLINE:
  1C64'   EB                    	XCHG			; HL = buffer
  1C65'   22 2AC5'              	SHLD	RLPTR
  1C68'   3E 00                 	MVI	A,0
  1C6A'   32 2AC7'              	STA	RLLEN
  1C6D'   78                    	MOV	A,B
  1C6E'   32 2AC8'              	STA	RLMAX
  1C71'   79                    	MOV	A,C
  1C72'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1C75'                         RL_LP:
  1C75'   CD 0000*              	CALL	GETKEY
  1C78'   FE 1B                 	CPI	ESC
  1C7A'   CA 1CCA'              	JZ	RL_CAN
  1C7D'   FE 0D                 	CPI	CR
  1C7F'   CA 1CD5'              	JZ	RL_DONE
  1C82'   FE 08                 	CPI	BS
  1C84'   CA 1CB2'              	JZ	RL_BS
  1C87'   FE 7F                 	CPI	DEL
  1C89'   CA 1CB2'              	JZ	RL_BS
  1C8C'   FE 20                 	CPI	' '
  1C8E'   DA 1C75'              	JC	RL_LP		; control char -> ignore
  1C91'   3A 2AC7'              	LDA	RLLEN
  1C94'   47                    	MOV	B,A
  1C95'   3A 2AC8'              	LDA	RLMAX
  1C98'   B8                    	CMP	B
  1C99'   CA 1C75'              	JZ	RL_LP		; full -> ignore
  1C9C'   2A 2AC5'              	LHLD	RLPTR
  1C9F'   71                    	MOV	M,C
  1CA0'   23                    	INX	H
  1CA1'   22 2AC5'              	SHLD	RLPTR
  1CA4'   3A 2AC7'              	LDA	RLLEN
  1CA7'   3C                    	INR	A
  1CA8'   32 2AC7'              	STA	RLLEN
  1CAB'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1CAC'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1CAF'   C3 1C75'              	JMP	RL_LP
  1CB2'                         RL_BS:				; WM LINEPOP
  1CB2'   3A 2AC7'              	LDA	RLLEN
  1CB5'   B7                    	ORA	A
  1CB6'   CA 1CCA'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1CB9'   3D                    	DCR	A
  1CBA'   32 2AC7'              	STA	RLLEN
  1CBD'   2A 2AC5'              	LHLD	RLPTR
  1CC0'   2B                    	DCX	H
  1CC1'   22 2AC5'              	SHLD	RLPTR
  1CC4'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1CC7'   C3 1C75'              	JMP	RL_LP
  1CCA'                         RL_CAN:
  1CCA'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1CCC'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1CCF'   CD 07A0'              	CALL	SETLIN		; redraw one row
  1CD2'   3E FF                 	MVI	A,0FFH		; cancelled
  1CD4'   C9                    	RET
  1CD5'                         RL_DONE:
  1CD5'   AF                    	XRA	A
  1CD6'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  1CD7'                         VC_BZ:
  1CD7'   CD 079A'              	CALL	SETMOV
  1CDA'   3A 2A97'              	LDA	GSAVE
  1CDD'   FE 02                 	CPI	PZ
  1CDF'   CA 1CEA'              	JZ	VZ_ZZ
  1CE2'   B7                    	ORA	A
  1CE3'   C0                    	RNZ			; 'g' was pending: vim drops both
  1CE4'   3E 02                 	MVI	A,PZ
  1CE6'   32 2A96'              	STA	GPEND
  1CE9'   C9                    	RET
  1CEA'                         VZ_ZZ:
  1CEA'   3E 04                 	MVI	A,EO_X
  1CEC'   32 2AC9'              	STA	EXOP
  1CEF'   3E 01                 	MVI	A,1
  1CF1'   32 2ADC'              	STA	EXBANG		; no '!'
  1CF4'   AF                    	XRA	A
  1CF5'   32 2ACA'              	STA	EXARG		; no file name
  1CF8'   3A 2A72'              	LDA	MODF		; as ':x': a changed text is written first
  1CFB'   B7                    	ORA	A
  1CFC'   CA 1E3D'              	JZ	EX_Q
  1CFF'   C3 1DD7'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1D02'                         VC_EX:
  1D02'   CD 06CB'              	CALL	GETCNT
  1D05'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1D08'   11 0000*              	LXI	D,EXBUF
  1D0B'   06 28                 	MVI	B,EXMAX
  1D0D'   0E 3A                 	MVI	C,':'
  1D0F'   CD 1C64'              	CALL	RDLINE
  1D12'   B7                    	ORA	A
  1D13'   C0                    	RNZ			; cancelled
  1D14'   3A 2AC7'              	LDA	RLLEN
  1D17'   5F                    	MOV	E,A
  1D18'   16 00                 	MVI	D,0
  1D1A'   21 0000*              	LXI	H,EXBUF
  1D1D'   19                    	DAD	D
  1D1E'   36 00                 	MVI	M,0		; the line ends with a 0
  1D20'   21 0000*              	LXI	H,EXBUF
  1D23'   CD 22EF'              	CALL	SKIPB
  1D26'   C8                    	RZ			; nothing on it
  1D27'   22 2ACC'              	SHLD	EXCMD
  1D2A'   CD 24E3'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1D2D'   CD 22EF'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1D30'   56                    	MOV	D,M
  1D31'   23                    	INX	H
  1D32'   1E 00                 	MVI	E,0
  1D34'   CD 22FB'              	CALL	ISLOW
  1D37'   DA 1D42'              	JC	EX_LK
  1D3A'   5F                    	MOV	E,A
  1D3B'   23                    	INX	H
  1D3C'   CD 22FB'              	CALL	ISLOW
  1D3F'   D2 1D5B'              	JNC	EX_NOT		; a third letter: none of ours
  1D42'                         EX_LK:
  1D42'   E5                    	PUSH	H
  1D43'   21 24CA'              	LXI	H,EXTAB
  1D46'                         EX_TL:
  1D46'   7E                    	MOV	A,M
  1D47'   B7                    	ORA	A
  1D48'   CA 1D5A'              	JZ	EX_NTP		; not in the table
  1D4B'   23                    	INX	H
  1D4C'   BA                    	CMP	D
  1D4D'   7E                    	MOV	A,M
  1D4E'   23                    	INX	H
  1D4F'   C2 1D56'              	JNZ	EX_TN
  1D52'   BB                    	CMP	E
  1D53'   CA 1D61'              	JZ	EX_TF
  1D56'                         EX_TN:
  1D56'   23                    	INX	H
  1D57'   C3 1D46'              	JMP	EX_TL
  1D5A'                         EX_NTP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1D5A'   E1                    	POP	H
  1D5B'                         EX_NOT:
  1D5B'   21 23B3'              	LXI	H,SNOT
  1D5E'   C3 2330'              	JMP	EXERT
  1D61'                         EX_TF:
  1D61'   7E                    	MOV	A,M
  1D62'   32 2AC9'              	STA	EXOP
  1D65'   E1                    	POP	H
  1D66'   FE 06                 	CPI	EO_S
  1D68'   CA 2552'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1D6B'   FE 01                 	CPI	EO_W
  1D6D'   CA 1D7C'              	JZ	EX_RG		; ':N,Mw name' takes a range
  1D70'   FE 08                 	CPI	EO_R
  1D72'   CA 1D7C'              	JZ	EX_RG		; ... and ':Nr name' a line
  1D75'   3A 2B25'              	LDA	SRNGF
  1D78'   B7                    	ORA	A
  1D79'   C2 1D5B'              	JNZ	EX_NOT		; a range on a command that does not take one
  1D7C'                         EX_RG:
                                	;--- '!', then the file name ---
  1D7C'   7E                    	MOV	A,M
  1D7D'   D6 21                 	SUI	'!'
  1D7F'   32 2ADC'              	STA	EXBANG		; 0 = '!'
  1D82'   C2 1D86'              	JNZ	EX_NB
  1D85'   23                    	INX	H
  1D86'                         EX_NB:
  1D86'   CD 22EF'              	CALL	SKIPB
  1D89'   32 2ACA'              	STA	EXARG		; 0 = no file name
  1D8C'   CA 1DA5'              	JZ	EX_RUN
  1D8F'   22 2ACC'              	SHLD	EXCMD
  1D92'   3A 2AC9'              	LDA	EXOP
  1D95'   FE 02                 	CPI	EO_Q
  1D97'   CA 232D'              	JZ	EX_TRL		; :q takes none
  1D9A'   FE 07                 	CPI	EO_V
  1D9C'   CA 232D'              	JZ	EX_TRL		; nor :ve
  1D9F'   CD 2259'              	CALL	PARSFN
  1DA2'   C2 2321'              	JNZ	EX_INV
  1DA5'                         EX_RUN:
  1DA5'   3A 2AC9'              	LDA	EXOP
  1DA8'   FE 05                 	CPI	EO_E
  1DAA'   CA 1E54'              	JZ	EX_E
  1DAD'   FE 02                 	CPI	EO_Q
  1DAF'   CA 1E3D'              	JZ	EX_Q
  1DB2'   FE 07                 	CPI	EO_V
  1DB4'   CA 2327'              	JZ	EX_V
  1DB7'   FE 08                 	CPI	EO_R
  1DB9'   CA 1FE5'              	JZ	EX_R
  1DBC'   FE 04                 	CPI	EO_X
  1DBE'   CA 1DD0'              	JZ	EX_XM
  1DC1'   FE 01                 	CPI	EO_W
  1DC3'   C2 1DD7'              	JNZ	EX_W		; :wq
  1DC6'   3A 2B25'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  1DC9'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  1DCA'   C2 1F05'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  1DCD'   C3 1DD7'              	JMP	EX_W
  1DD0'                         EX_XM:
  1DD0'   3A 2A72'              	LDA	MODF		; :x writes only a changed text
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1DD3'   B7                    	ORA	A
  1DD4'   CA 1E3D'              	JZ	EX_Q
  1DD7'                         EX_W:
  1DD7'   CD 20C5'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1DDA'   D8                    	RC			; refused (message shown)
  1DDB'   32 2ACB'              	STA	EXBAK
  1DDE'   3A 2AC9'              	LDA	EXOP
  1DE1'   FE 01                 	CPI	EO_W
  1DE3'   CA 1DFA'              	JZ	EX_WK
  1DE6'   3A 2ACB'              	LDA	EXBAK
  1DE9'   B7                    	ORA	A
  1DEA'   C2 1E3A'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1DED'   3A 2ADC'              	LDA	EXBANG
  1DF0'   B7                    	ORA	A
  1DF1'   CA 1E3A'              	JZ	EX_WQ		; so it does with '!'
  1DF4'   CD 1DFA'              	CALL	EX_WK		; else it may not: keep the text
  1DF7'   C3 1E3D'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1DFA'                         EX_WK:
  1DFA'   CD 0D41'              	CALL	CURRW		; the cursor's row and file position
  1DFD'   32 2ACE'              	STA	WPROW
  1E00'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1E03'   7D                    	MOV	A,L
  1E04'   E6 7F                 	ANI	7FH
  1E06'   32 2ACF'              	STA	WPBYT
  1E09'   7D                    	MOV	A,L
  1E0A'   17                    	RAL
  1E0B'   7C                    	MOV	A,H
  1E0C'   17                    	RAL
  1E0D'   5F                    	MOV	E,A
  1E0E'   3E 00                 	MVI	A,0
  1E10'   17                    	RAL
  1E11'   57                    	MOV	D,A		; DE = HL / 128
  1E12'   2A 0000*              	LHLD	OUTPOS
  1E15'   19                    	DAD	D
  1E16'   22 2AD0'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1E19'   CD 20FA'              	CALL	WRITE
  1E1C'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1E1F'   2A 2AD0'              	LHLD	WPREC
  1E22'   EB                    	XCHG
  1E23'   3A 2ACF'              	LDA	WPBYT
  1E26'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1E29'   CD 0000*              	CALL	GOTO
  1E2C'                         EX_WRW:
  1E2C'   21 0000               	LXI	H,0
  1E2F'   22 0000*              	SHLD	LNDLT
  1E32'   3A 2ACE'              	LDA	WPROW
  1E35'   6F                    	MOV	L,A
  1E36'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1E39'   C9                    	RET
  1E3A'                         EX_WQ:
  1E3A'   CD 20FA'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1E3D'                         EX_Q:
  1E3D'   3A 2ADC'              	LDA	EXBANG
  1E40'   B7                    	ORA	A
  1E41'   CA 1E4B'              	JZ	EX_QT
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1E44'   3A 2A72'              	LDA	MODF
  1E47'   B7                    	ORA	A
  1E48'   C2 2315'              	JNZ	MSGNWR		; changed, no '!': stay
  1E4B'                         EX_QT:
  1E4B'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1E4E'   3E 01                 	MVI	A,1
  1E50'   32 2A71'              	STA	QUITF
  1E53'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1E54'                         EX_E:
  1E54'   3A 2ADC'              	LDA	EXBANG
  1E57'   B7                    	ORA	A
  1E58'   CA 1E62'              	JZ	EE_GO
  1E5B'   3A 2A72'              	LDA	MODF
  1E5E'   B7                    	ORA	A
  1E5F'   C2 2315'              	JNZ	MSGNWR
  1E62'                         EE_GO:
  1E62'   3A 2ACA'              	LDA	EXARG
  1E65'   B7                    	ORA	A
  1E66'   C2 1E6D'              	JNZ	EE_ARG
  1E69'   CD 2136'              	CALL	OWNTF		; no name: the buffer's own
  1E6C'   D8                    	RC
  1E6D'                         EE_ARG:
  1E6D'   CD 214C'              	CALL	ISOWN
  1E70'   21 0001               	LXI	H,1
  1E73'   C2 1E7A'              	JNZ	EE_LD		; another file: its first line
  1E76'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1E79'   23                    	INX	H		; HL = the cursor's line
  1E7A'                         EE_LD:
  1E7A'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1E7C'   32 2ADA'              	STA	MSGWHT
  1E7F'   E5                    	PUSH	H
  1E80'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1E83'   21 0000*              	LXI	H,TFCB
  1E86'   11 0000*              	LXI	D,FNAME
  1E89'   CD 215E'              	CALL	COPY12		; the buffer's name
  1E8C'   CD 2123'              	CALL	SRCTF
  1E8F'   CD 0000*              	CALL	REOPEN
  1E92'   CD 01EC'              	CALL	MKCLR		; the marks named the buffer that just went
  1E95'   AF                    	XRA	A
  1E96'   32 2A72'              	STA	MODF
  1E99'   E1                    	POP	H
  1E9A'   2B                    	DCX	H
  1E9B'   AF                    	XRA	A
  1E9C'   CD 0000*              	CALL	MVLIND		; down to the line
  1E9F'   CD 0A5D'              	CALL	ATEOF
  1EA2'   DC 0A63'              	CC	LASTLN		; past the last line: onto it
  1EA5'   CD 0F8F'              	CALL	ZSAVE
  1EA8'   C3 1072'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  1EAB'                         TFDOS:
  1EAB'   C5                    	PUSH	B
  1EAC'   11 0080               	LXI	D,CMDTAIL
  1EAF'   0E 1A                 	MVI	C,1AH		; set the DMA
  1EB1'   CD 0005               	CALL	BDOS
  1EB4'   C1                    	POP	B
  1EB5'   11 0000*              	LXI	D,TFCB
  1EB8'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  1EBB'                         EXRNG:
  1EBB'   2A 2B26'              	LHLD	SRNG1
  1EBE'   7C                    	MOV	A,H
  1EBF'   B5                    	ORA	L
  1EC0'   37                    	STC
  1EC1'   C8                    	RZ
  1EC2'   2A 2B28'              	LHLD	SRNG2
  1EC5'   EB                    	XCHG
  1EC6'   2A 2B26'              	LHLD	SRNG1
  1EC9'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  1ECC'   D8                    	RC
  1ECD'   EB                    	XCHG			; HL = the last line, DE = the first
  1ECE'   CD 0000*              	CALL	SUBHD
  1ED1'   23                    	INX	H
  1ED2'   22 2B30'              	SHLD	SLINES
  1ED5'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  1ED6'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  1ED7'                         GOLNX:
  1ED7'   E5                    	PUSH	H
  1ED8'   CD 0F23'              	CALL	GOLN
  1EDB'   CD 0000*              	CALL	CNTLF
  1EDE'   23                    	INX	H		; the line the cursor came to rest on
  1EDF'   D1                    	POP	D
  1EE0'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  1EE3'                         EXSAVP:
  1EE3'   CD 0D41'              	CALL	CURRW
  1EE6'   32 2ACE'              	STA	WPROW
  1EE9'   21 2B07'              	LXI	H,MKPOS
  1EEC'   C3 0429'              	JMP	FPSTO
  1EEF'                         EXRSTP:
  1EEF'   CD 0000*              	CALL	CLRCNT
  1EF2'   CD 03A9'              	CALL	MKPAGE		; page until that place is in the window again
  1EF5'   CD 0000*              	CALL	GOTO
  1EF8'   C3 1E2C'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  1EFB'                         PUTBRK:
  1EFB'   3E 0D                 	MVI	A,CR
  1EFD'   CD 0000*              	CALL	PUTGAP
  1F00'   3E 0A                 	MVI	A,LF
  1F02'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  1F05'                         EX_WR:
  1F05'   3A 2ACA'              	LDA	EXARG
  1F08'   B7                    	ORA	A
  1F09'   CA 2303'              	JZ	MSGNFN		; No file name
  1F0C'   CD 214C'              	CALL	ISOWN
  1F0F'   CA 1FAF'              	JZ	EXW_OW
  1F12'   CD 0000*              	CALL	TEXIST
  1F15'   32 2B33'              	STA	RWERR		; nonzero: a file of that name is there
  1F18'   CA 1F22'              	JZ	EXW_GO
  1F1B'   3A 2ADC'              	LDA	EXBANG
  1F1E'   B7                    	ORA	A
  1F1F'   C2 2309'              	JNZ	MSGEXI		; File exists (! to force)
  1F22'                         EXW_GO:
  1F22'   CD 1EBB'              	CALL	EXRNG
  1F25'   DA 1FA9'              	JC	EXW_BD
  1F28'   CD 1EE3'              	CALL	EXSAVP
  1F2B'   2A 2B26'              	LHLD	SRNG1
  1F2E'   CD 1ED7'              	CALL	GOLNX
  1F31'   C2 1FA6'              	JNZ	EXW_NL		; the text has no line N
  1F34'   3A 2B33'              	LDA	RWERR		; a delete scans the whole directory, there or
  1F37'   B7                    	ORA	A		;   not: only when TEXIST found one
  1F38'   0E 13                 	MVI	C,13H
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F3A'   C4 1EAB'              	CNZ	TFDOS		; delete what is there
  1F3D'   0E 16                 	MVI	C,16H
  1F3F'   CD 1EAB'              	CALL	TFDOS		; ... and make it
  1F42'   3C                    	INR	A
  1F43'   CA 1F98'              	JZ	EXW_FL		; no directory entry left
  1F46'   3E 80                 	MVI	A,80H
  1F48'   32 2B32'              	STA	RWPTR
  1F4B'   AF                    	XRA	A
  1F4C'   32 2B33'              	STA	RWERR
  1F4F'   2A 2B30'              	LHLD	SLINES
  1F52'   CD 0000*              	CALL	SETC0		; that many lines, forward
  1F55'                         EXW_LP:
  1F55'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  1F58'   E5                    	PUSH	H
  1F59'   EB                    	XCHG
  1F5A'   2A 0000*              	LHLD	GAPEND
  1F5D'   CD 1FB5'              	CALL	RWOUT		; the text from the cursor to there
  1F60'   E1                    	POP	H
  1F61'   3A 2B33'              	LDA	RWERR
  1F64'   B7                    	ORA	A
  1F65'   C2 1F81'              	JNZ	EXW_EN
  1F68'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  1F6B'   CD 06E0'              	CALL	CNTTST
  1F6E'   C2 1F55'              	JNZ	EXW_LP
  1F71'                         EXW_PD:				; the last record is padded out with ^Z
  1F71'   3A 2B32'              	LDA	RWPTR
  1F74'   FE 80                 	CPI	80H
  1F76'   CA 1F81'              	JZ	EXW_EN
  1F79'   3E 1A                 	MVI	A,CPMEOF
  1F7B'   CD 1FC1'              	CALL	RWPUT
  1F7E'   C3 1F71'              	JMP	EXW_PD
  1F81'                         EXW_EN:
  1F81'   0E 10                 	MVI	C,10H
  1F83'   CD 1EAB'              	CALL	TFDOS		; close
  1F86'   3A 2B33'              	LDA	RWERR
  1F89'   B7                    	ORA	A
  1F8A'   C2 1F98'              	JNZ	EXW_FL
  1F8D'   CD 1EEF'              	CALL	EXRSTP
  1F90'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  1F92'   32 2ADA'              	STA	MSGWHT
  1F95'   C3 079A'              	JMP	SETMOV		; nothing on the screen has changed
  1F98'                         EXW_FL:				; no room: the part written is not left behind
  1F98'   0E 13                 	MVI	C,13H
  1F9A'   CD 1EAB'              	CALL	TFDOS
  1F9D'   CD 1EEF'              	CALL	EXRSTP
  1FA0'   21 24C0'              	LXI	H,SDFUL
  1FA3'   C3 233B'              	JMP	EXERR
  1FA6'                         EXW_NL:
  1FA6'   CD 1EEF'              	CALL	EXRSTP
  1FA9'                         EXW_BD:
  1FA9'   21 24B2'              	LXI	H,SRNGE
  1FAC'   C3 233B'              	JMP	EXERR
  1FAF'                         EXW_OW:
  1FAF'   21 236A'              	LXI	H,SEXI
  1FB2'   C3 233B'              	JMP	EXERR
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  1FB5'                         RWOUT:
  1FB5'   CD 0000*              	CALL	CMP16
  1FB8'   C8                    	RZ
  1FB9'   7E                    	MOV	A,M
  1FBA'   23                    	INX	H
  1FBB'   CD 1FC1'              	CALL	RWPUT
  1FBE'   C3 1FB5'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  1FC1'                         RWPUT:
  1FC1'   E5                    	PUSH	H
  1FC2'   F5                    	PUSH	PSW
  1FC3'   3A 2B32'              	LDA	RWPTR
  1FC6'   6F                    	MOV	L,A
  1FC7'   26 00                 	MVI	H,0
  1FC9'   F1                    	POP	PSW
  1FCA'   77                    	MOV	M,A
  1FCB'   2C                    	INR	L		; Z: that was the record's last byte
  1FCC'   7D                    	MOV	A,L
  1FCD'   C2 1FE0'              	JNZ	RWP_ST
  1FD0'   D5                    	PUSH	D
  1FD1'   0E 15                 	MVI	C,15H
  1FD3'   CD 1EAB'              	CALL	TFDOS		; write it
  1FD6'   D1                    	POP	D
  1FD7'   B7                    	ORA	A
  1FD8'   CA 1FDE'              	JZ	RWP_OK
  1FDB'   32 2B33'              	STA	RWERR
  1FDE'                         RWP_OK:
  1FDE'   3E 80                 	MVI	A,80H
  1FE0'                         RWP_ST:
  1FE0'   32 2B32'              	STA	RWPTR
  1FE3'   E1                    	POP	H
  1FE4'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  1FE5'                         EX_R:
  1FE5'   3A 2ACA'              	LDA	EXARG
  1FE8'   B7                    	ORA	A
  1FE9'   CA 2303'              	JZ	MSGNFN		; No file name
  1FEC'   0E 0F                 	MVI	C,0FH
  1FEE'   CD 1EAB'              	CALL	TFDOS		; open
  1FF1'   3C                    	INR	A
  1FF2'   CA 20BF'              	JZ	ER_NOF
  1FF5'   CD 0FB5'              	CALL	GZONE		; the screen's top line, before anything moves
  1FF8'   CD 1EE3'              	CALL	EXSAVP
  1FFB'   3A 2B25'              	LDA	SRNGF
  1FFE'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1FFF'   CA 2018'              	JZ	ER_NXT		; no line given: below the cursor's
  2002'   2A 2B28'              	LHLD	SRNG2
  2005'   7C                    	MOV	A,H
  2006'   B5                    	ORA	L
  2007'   C2 2012'              	JNZ	ER_LN
  200A'   23                    	INX	H
  200B'   CD 0F23'              	CALL	GOLN		; ':0r': above line 1 ...
  200E'   AF                    	XRA	A		;   which never wants a line end put in first
  200F'   C3 203A'              	JMP	ER_BRK
  2012'                         ER_LN:
  2012'   CD 1ED7'              	CALL	GOLNX
  2015'   C2 1FA6'              	JNZ	EXW_NL		; the text has no line N
  2018'                         ER_NXT:
  2018'   21 0001               	LXI	H,1
  201B'   AF                    	XRA	A
  201C'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  201F'   CD 0A5D'              	CALL	ATEOF
  2022'   3E 00                 	MVI	A,0
  2024'   D2 203A'              	JNC	ER_BRK		; text follows
  2027'   2A 0000*              	LHLD	GAPBEG
  202A'   EB                    	XCHG
  202B'   2A 0000*              	LHLD	TXTBEG
  202E'   CD 0000*              	CALL	CMP16
  2031'   3E 01                 	MVI	A,1
  2033'   CA 203A'              	JZ	ER_BRK		; nothing before the cursor either
  2036'   1B                    	DCX	D
  2037'   1A                    	LDAX	D
  2038'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  203A'                         ER_BRK:
  203A'   32 2B35'              	STA	RDBRK
  203D'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  2040'   AF                    	XRA	A
  2041'   32 2B34'              	STA	RDANY
  2044'                         ER_LP:
  2044'   0E 14                 	MVI	C,14H
  2046'   CD 1EAB'              	CALL	TFDOS		; the next record
  2049'   B7                    	ORA	A
  204A'   C2 207D'              	JNZ	ER_END
  204D'   21 0080               	LXI	H,CMDTAIL
  2050'   0E 00                 	MVI	C,0
  2052'                         ER_SC:				; C = its bytes, up to a ^Z
  2052'   7E                    	MOV	A,M
  2053'   FE 1A                 	CPI	CPMEOF
  2055'   CA 205D'              	JZ	ER_GOT
  2058'   23                    	INX	H
  2059'   0C                    	INR	C
  205A'   F2 2052'              	JP	ER_SC		; (minus: all 128)
  205D'                         ER_GOT:
  205D'   79                    	MOV	A,C
  205E'   B7                    	ORA	A
  205F'   CA 207D'              	JZ	ER_END
  2062'   C5                    	PUSH	B
  2063'   3A 2B34'              	LDA	RDANY
  2066'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  2067'   CC 20AE'              	CZ	ER_1ST
  206A'   C1                    	POP	B
  206B'   06 00                 	MVI	B,0
  206D'   11 0080               	LXI	D,CMDTAIL
  2070'   C5                    	PUSH	B
  2071'   CD 0000*              	CALL	INSBLK
  2074'   C1                    	POP	B
  2075'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  2078'   79                    	MOV	A,C
  2079'   17                    	RAL
  207A'   DA 2044'              	JC	ER_LP		; a full record: there may be more
  207D'                         ER_END:
  207D'   3A 2B34'              	LDA	RDANY
  2080'   B7                    	ORA	A
  2081'   CA 209F'              	JZ	ER_PL		; nothing in the file: nothing has changed
  2084'   CD 0A5D'              	CALL	ATEOF
  2087'   DA 2094'              	JC	ER_MD		; the text now ends as the file read ends
  208A'   2A 0000*              	LHLD	GAPBEG
  208D'   2B                    	DCX	H
  208E'   7E                    	MOV	A,M
  208F'   FE 0A                 	CPI	LF
  2091'   C4 1EFB'              	CNZ	PUTBRK		; text follows: what was read ends a line
  2094'                         ER_MD:
  2094'   3E 01                 	MVI	A,1
  2096'   32 2A72'              	STA	MODF
  2099'   CD 03A9'              	CALL	MKPAGE		; back to the first line read
  209C'   CD 0000*              	CALL	GOTO
  209F'                         ER_PL:
  209F'   CD 0A5D'              	CALL	ATEOF
  20A2'   DC 0A63'              	CC	LASTLN		; (nothing read, at the end: the last line)
  20A5'   CD 0000*              	CALL	CLRCNT
  20A8'   CD 0FCD'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  20AB'   C3 07BB'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  20AE'                         ER_1ST:
  20AE'   3C                    	INR	A
  20AF'   32 2B34'              	STA	RDANY
  20B2'   3A 2B35'              	LDA	RDBRK
  20B5'   B7                    	ORA	A
  20B6'   C4 1EFB'              	CNZ	PUTBRK
  20B9'   21 2B07'              	LXI	H,MKPOS
  20BC'   C3 0429'              	JMP	FPSTO
  20BF'                         ER_NOF:
  20BF'   21 24A1'              	LXI	H,SNOPN
  20C2'   C3 2330'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  20C5'                         WRCHK:
  20C5'   3A 2ACA'              	LDA	EXARG
  20C8'   B7                    	ORA	A
  20C9'   C2 20D3'              	JNZ	WC_ARG
  20CC'   CD 2136'              	CALL	OWNTF
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  20CF'   D8                    	RC
  20D0'   C3 20E8'              	JMP	WC_OWN
  20D3'                         WC_ARG:
  20D3'   CD 214C'              	CALL	ISOWN
  20D6'   CA 20E8'              	JZ	WC_OWN
  20D9'   3A 2ADC'              	LDA	EXBANG
  20DC'   B7                    	ORA	A
  20DD'   CA 20E6'              	JZ	WC_OTH
  20E0'   CD 0000*              	CALL	TEXIST
  20E3'   C2 2309'              	JNZ	MSGEXI		; File exists (! to force)
  20E6'                         WC_OTH:
  20E6'   AF                    	XRA	A		; (NC)
  20E7'   C9                    	RET
  20E8'                         WC_OWN:
  20E8'   3A 2ADD'              	LDA	ROFLAG		; '-R': this is the file it may not write
  20EB'   B7                    	ORA	A
  20EC'   CA 20F6'              	JZ	WC_OK
  20EF'   3A 2ADC'              	LDA	EXBANG
  20F2'   B7                    	ORA	A
  20F3'   C2 230F'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  20F6'                         WC_OK:
  20F6'   3E 01                 	MVI	A,1
  20F8'   B7                    	ORA	A		; (NC)
  20F9'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  20FA'                         WRITE:
  20FA'   3A 2ACB'              	LDA	EXBAK
  20FD'   CD 0000*              	CALL	WRTO
  2100'   3A 0001*              	LDA	FNAME+1
  2103'   FE 20                 	CPI	' '
  2105'   C2 2111'              	JNZ	WR_HAS
  2108'   21 0000*              	LXI	H,TFCB
  210B'   11 0000*              	LXI	D,FNAME
  210E'   CD 215E'              	CALL	COPY12
  2111'                         WR_HAS:
  2111'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  2113'   32 2ADA'              	STA	MSGWHT
  2116'   CD 214C'              	CALL	ISOWN
  2119'   C2 2123'              	JNZ	SRCTF
  211C'   AF                    	XRA	A
  211D'   32 2A72'              	STA	MODF
  2120'   32 2ADB'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  2123'                         SRCTF:
  2123'   21 0000*              	LXI	H,TFCB
  2126'   11 005C               	LXI	D,DFTFCB
  2129'   CD 215E'              	CALL	COPY12
  212C'   AF                    	XRA	A
  212D'   06 04                 	MVI	B,4
  212F'                         SRC_Z:
  212F'   12                    	STAX	D		; extent, s1, s2, record count: 0
  2130'   13                    	INX	D
  2131'   05                    	DCR	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  2132'   C2 212F'              	JNZ	SRC_Z
  2135'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  2136'                         OWNTF:
  2136'   3A 0001*              	LDA	FNAME+1
  2139'   FE 20                 	CPI	' '
  213B'   CA 2303'              	JZ	MSGNFN
  213E'   CD 2169'              	CALL	TFCLR
  2141'   21 0000*              	LXI	H,FNAME
  2144'   11 0000*              	LXI	D,TFCB
  2147'   CD 215E'              	CALL	COPY12
  214A'   B7                    	ORA	A		; (NC)
  214B'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  214C'                         ISOWN:
  214C'   21 0000*              	LXI	H,TFCB
  214F'   11 0000*              	LXI	D,FNAME
  2152'   06 0C                 	MVI	B,12
  2154'                         IO_LP:
  2154'   1A                    	LDAX	D
  2155'   BE                    	CMP	M
  2156'   C0                    	RNZ
  2157'   23                    	INX	H
  2158'   13                    	INX	D
  2159'   05                    	DCR	B
  215A'   C2 2154'              	JNZ	IO_LP
  215D'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  215E'                         COPY12:
  215E'   06 0C                 	MVI	B,12
  2160'                         CP_LP:
  2160'   7E                    	MOV	A,M
  2161'   12                    	STAX	D
  2162'   23                    	INX	H
  2163'   13                    	INX	D
  2164'   05                    	DCR	B
  2165'   C2 2160'              	JNZ	CP_LP
  2168'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  2169'                         TFCLR:
  2169'   11 0000*              	LXI	D,TFCB
  216C'   06 24                 	MVI	B,36
  216E'   AF                    	XRA	A
  216F'                         TC_LP:
  216F'   12                    	STAX	D
  2170'   13                    	INX	D
  2171'   05                    	DCR	B
  2172'   C2 216F'              	JNZ	TC_LP
  2175'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


                                ; and has none, as in vim.
  2176'                         FOPEN:
  2176'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  2178'   32 2ADA'              	STA	MSGWHT
  217B'   21 005C               	LXI	H,DFTFCB
  217E'   CD 224C'              	CALL	NRMDRV
  2181'   11 0000*              	LXI	D,FNAME
  2184'   CD 215E'              	CALL	COPY12
  2187'   CD 0000*              	CALL	OPENZ
  218A'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  218D'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  218F'   C8                    	RZ
  2190'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  2193'   32 2ADB'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  2196'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  2197'                         ARGSCN:
  2197'   3A 0080               	LDA	CMDTAIL
  219A'   47                    	MOV	B,A		; B = what is left of the line
  219B'   B7                    	ORA	A
  219C'   C8                    	RZ
  219D'   21 0081               	LXI	H,CMDTAIL+1
  21A0'                         AS_TOK:				; at a token, or the blanks before one
  21A0'   7E                    	MOV	A,M
  21A1'   FE 20                 	CPI	' '
  21A3'   C2 21AC'              	JNZ	AS_OPT
  21A6'   23                    	INX	H
  21A7'   05                    	DCR	B
  21A8'   C2 21A0'              	JNZ	AS_TOK
  21AB'   C9                    	RET
  21AC'                         AS_OPT:
  21AC'   FE 2B                 	CPI	'+'
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  21AE'   CA 21D8'              	JZ	AS_PLS
  21B1'   FE 2D                 	CPI	'-'
  21B3'   CA 21C7'              	JZ	AS_SW
  21B6'   FE 2F                 	CPI	'/'
  21B8'   CA 21C7'              	JZ	AS_SW
  21BB'                         AS_SKP:				; not ours (the file name): on to the next one
  21BB'   23                    	INX	H
  21BC'   05                    	DCR	B
  21BD'   C8                    	RZ
  21BE'   7E                    	MOV	A,M
  21BF'   FE 20                 	CPI	' '
  21C1'   C2 21BB'              	JNZ	AS_SKP
  21C4'   C3 21A0'              	JMP	AS_TOK
  21C7'                         AS_SW:
  21C7'   23                    	INX	H
  21C8'   05                    	DCR	B
  21C9'   C8                    	RZ
  21CA'   7E                    	MOV	A,M
  21CB'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  21CD'   FE 52                 	CPI	'R'
  21CF'   C2 21BB'              	JNZ	AS_SKP
  21D2'   32 2ADD'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  21D5'   C3 21BB'              	JMP	AS_SKP
  21D8'                         AS_PLS:
  21D8'   3E 01                 	MVI	A,1
  21DA'   32 2ADE'              	STA	PLUSF		; '+' gets the line even with no number on it
  21DD'   11 0000*              	LXI	D,PLUSB
  21E0'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  21E2'   23                    	INX	H		;   line space, so it is taken as '+' alone
  21E3'   05                    	DCR	B
  21E4'   CA 221B'              	JZ	AS_PE
  21E7'   7E                    	MOV	A,M
  21E8'   FE 30                 	CPI	'0'
  21EA'   C2 2202'              	JNZ	AS_PD
  21ED'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  21ED'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  21EE'   05                    	DCR	B
  21EF'   CA 2223'              	JZ	AS_P1
  21F2'   7E                    	MOV	A,M
  21F3'   FE 30                 	CPI	'0'
  21F5'   CA 21ED'              	JZ	AS_PZ
  21F8'   FE 31                 	CPI	'1'
  21FA'   DA 2223'              	JC	AS_P1		; zeros and then no digit at all: line 1
  21FD'   FE 3A                 	CPI	'9'+1
  21FF'   D2 2223'              	JNC	AS_P1
  2202'                         AS_PD:				; the digits, as typed
  2202'   7E                    	MOV	A,M
  2203'   FE 30                 	CPI	'0'
  2205'   DA 221B'              	JC	AS_PE
  2208'   FE 3A                 	CPI	'9'+1
  220A'   D2 221B'              	JNC	AS_PE
  220D'   79                    	MOV	A,C
  220E'   B7                    	ORA	A
  220F'   CA 222A'              	JZ	AS_POV
  2212'   0D                    	DCR	C
  2213'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2214'   12                    	STAX	D
  2215'   13                    	INX	D
  2216'   23                    	INX	H
  2217'   05                    	DCR	B
  2218'   C2 2202'              	JNZ	AS_PD
  221B'                         AS_PE:
  221B'   AF                    	XRA	A
  221C'   12                    	STAX	D		; the digits end with a 0
  221D'   78                    	MOV	A,B
  221E'   B7                    	ORA	A
  221F'   C8                    	RZ
  2220'   C3 21A0'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  2223'                         AS_P1:
  2223'   3E 31                 	MVI	A,'1'
  2225'   12                    	STAX	D
  2226'   13                    	INX	D
  2227'   C3 221B'              	JMP	AS_PE
  222A'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  222A'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  222D'   C3 221B'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  2230'                         ARGGO:
  2230'   3A 2ADE'              	LDA	PLUSF
  2233'   B7                    	ORA	A
  2234'   C8                    	RZ
  2235'   21 0000*              	LXI	H,PLUSB
  2238'                         AG_LP:
  2238'   7E                    	MOV	A,M
  2239'   B7                    	ORA	A
  223A'   CA 2247'              	JZ	AG_G
  223D'   4F                    	MOV	C,A
  223E'   E5                    	PUSH	H
  223F'   CD 0023'              	CALL	VICMD
  2242'   E1                    	POP	H
  2243'   23                    	INX	H
  2244'   C3 2238'              	JMP	AG_LP
  2247'                         AG_G:
  2247'   0E 47                 	MVI	C,'G'
  2249'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  224C'                         NRMDRV:
  224C'   7E                    	MOV	A,M
  224D'   B7                    	ORA	A
  224E'   C0                    	RNZ
  224F'   E5                    	PUSH	H
  2250'   0E 19                 	MVI	C,BF_CURDSK
  2252'   CD 0005               	CALL	BDOS
  2255'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  2256'   3C                    	INR	A
  2257'   77                    	MOV	M,A
  2258'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  2259'                         PARSFN:
  2259'   CD 2169'              	CALL	TFCLR
  225C'   11 0000*              	LXI	D,TFCB
  225F'   23                    	INX	H
  2260'   7E                    	MOV	A,M
  2261'   2B                    	DCX	H
  2262'   FE 3A                 	CPI	':'
  2264'   C2 2276'              	JNZ	PF_NM
  2267'   CD 22BC'              	CALL	GETFNC
  226A'   CA 2276'              	JZ	PF_NM
  226D'   D6 40                 	SUI	40H
  226F'   12                    	STAX	D
  2270'   FE 11                 	CPI	17
  2272'   D2 229A'              	JNC	PF_BAD
  2275'   23                    	INX	H
  2276'                         PF_NM:
  2276'   13                    	INX	D
  2277'   0E 08                 	MVI	C,8
  2279'   CD 229E'              	CALL	CPYNAM
  227C'   FE 2E                 	CPI	'.'
  227E'   0E 03                 	MVI	C,3
  2280'   C4 22B1'              	CNZ	PADFLD		; no type: blanks
  2283'   CC 229D'              	CZ	CPYNM0		; '.': the type
  2286'   3A 0001*              	LDA	TFCB+1
  2289'   FE 20                 	CPI	' '
  228B'   CA 229A'              	JZ	PF_BAD		; no name
  228E'   CD 22EF'              	CALL	SKIPB
  2291'   C0                    	RNZ			; more after it
  2292'   21 0000*              	LXI	H,TFCB
  2295'   CD 224C'              	CALL	NRMDRV
  2298'   AF                    	XRA	A
  2299'   C9                    	RET
  229A'                         PF_BAD:
  229A'   F6 01                 	ORI	1
  229C'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  229D'                         CPYNM0:
  229D'   23                    	INX	H
  229E'                         CPYNAM:
  229E'   CD 22BC'              	CALL	GETFNC
  22A1'   CA 22B1'              	JZ	PADFLD
  22A4'   12                    	STAX	D
  22A5'   13                    	INX	D
  22A6'   0D                    	DCR	C
  22A7'   C2 229E'              	JNZ	CPYNAM
  22AA'                         CN_SKP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  22AA'   CD 22BC'              	CALL	GETFNC
  22AD'   C2 22AA'              	JNZ	CN_SKP
