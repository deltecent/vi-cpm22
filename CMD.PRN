  24ED'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  24EE'                         PARSFN:
  24EE'   CD 23FE'              	CALL	TFCLR
  24F1'   11 0000*              	LXI	D,TFCB
  24F4'   23                    	INX	H
  24F5'   7E                    	MOV	A,M
  24F6'   2B                    	DCX	H
  24F7'   FE 3A                 	CPI	':'
  24F9'   C2 250B'              	JNZ	PF_NM
  24FC'   CD 2551'              	CALL	GETFNC
  24FF'   CA 250B'              	JZ	PF_NM
  2502'   D6 40                 	SUI	40H
  2504'   12                    	STAX	D
  2505'   FE 11                 	CPI	17
  2507'   D2 252F'              	JNC	PF_BAD
  250A'   23                    	INX	H
  250B'                         PF_NM:
  250B'   13                    	INX	D
  250C'   0E 08                 	MVI	C,8
  250E'   CD 2533'              	CALL	CPYNAM
  2511'   FE 2E                 	CPI	'.'
  2513'   0E 03                 	MVI	C,3
  2515'   C4 2546'              	CNZ	PADFLD		; no type: blanks
  2518'   CC 2532'              	CZ	CPYNM0		; '.': the type
  251B'   3A 0001*              	LDA	TFCB+1
  251E'   FE 20                 	CPI	' '
  2520'   CA 252F'              	JZ	PF_BAD		; no name
  2523'   CD 2584'              	CALL	SKIPB
  2526'   C0                    	RNZ			; more after it
  2527'   21 0000*              	LXI	H,TFCB
  252A'   CD 24E1'              	CALL	NRMDRV
  252D'   AF                    	XRA	A
  252E'   C9                    	RET
  252F'                         PF_BAD:
  252F'   F6 01                 	ORI	1
  2531'   C9                    	RET
                                
