  0AD3'   F8                    	RM
  0AD4'                         BK_WS:
  0AD4'   CD 0B01'              	CALL	CCLS		; back over blanks
  0AD7'   B7                    	ORA	A
  0AD8'   C2 0AE8'              	JNZ	BK_WD
  0ADB'   CD 0B09'              	CALL	EMPTY
  0ADE'   C8                    	RZ			; an empty line is a word
  0ADF'   CD 0B7D'              	CALL	DECC
