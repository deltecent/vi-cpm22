  0B9F'   E5                    	PUSH	H
  0BA0'   2A 0000*              	LHLD	LNDLT
  0BA3'   7C                    	MOV	A,H
  0BA4'   FE 40                 	CPI	40H
  0BA6'   CA 0BBB'              	JZ	LN_X
  0BA9'   23                    	INX	H
  0BAA'   C3 0BB8'              	JMP	LN_ST
