  23F7'   09F0'                 	DW	VC_W
  23F9'   62                    	DB	'b'
  23FA'   0A41'                 	DW	VC_B
  23FC'   65                    	DB	'e'
  23FD'   0BA6'                 	DW	VC_E
  23FF'   57                    	DB	'W'
  2400'   09F7'                 	DW	VCBGW
