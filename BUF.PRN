                                ;GAPRT -- WM 4972: slide the gap toward higher addresses (cursor right).
  03B0'                         GAPRT:				; WM 4972
  03B0'   EB                    	XCHG
  03B1'   E5                    	PUSH	H
  03B2'   CD 0570'              	CALL	LDHLI
  03B5'   EB                    	XCHG
  03B6'   CD 0560'              	CALL	SPANBC
  03B9'   E1                    	POP	H
  03BA'   E5                    	PUSH	H
  03BB'   CD 056A'              	CALL	LDPAI2
  03BE'   CD 04EA'              	CALL	MEMCPY
  03C1'   E3                    	XTHL
  03C2'   2B                    	DCX	H
  03C3'   2B                    	DCX	H
  03C4'   73                    	MOV	M,E
  03C5'   23                    	INX	H
  03C6'   72                    	MOV	M,D
  03C7'   23                    	INX	H
  03C8'   D1                    	POP	D
  03C9'   73                    	MOV	M,E
  03CA'   23                    	INX	H
  03CB'   72                    	MOV	M,D
  03CC'   B7                    	ORA	A
  03CD'   C3 05A2'              	JMP	POPRET
                                
