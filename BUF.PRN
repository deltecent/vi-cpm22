  05C3'   E5                    	PUSH	H
  05C4'   CD 058E'              	CALL	SUBHD
  05C7'   D1                    	POP	D
  05C8'   37                    	STC
  05C9'   C9                    	RET
                                
                                ;SUBCP2 -- WM 5365: HL := max(0, DE-HL); CY if positive.
  05CA'                         SUBCP2:			       ; WM 5365
  05CA'   CD 05AC'              	CALL	CMP16
  05CD'   CA 05BE'              	JZ	SCLPZ
  05D0'   DA 05BE'              	JC	SCLPZ
  05D3'   EB                    	XCHG
  05D4'   CD 058E'              	CALL	SUBHD
  05D7'   37                    	STC
  05D8'   C9                    	RET
                                
                                
                                ;POPRET -- WM 5387: shared epilogue for the PUSH B/PUSH D/PUSH H prologue.
  05D9'                         POPRET:				; WM 5387
  05D9'   E1                    	POP	H
  05DA'   D1                    	POP	D
  05DB'   C1                    	POP	B
  05DC'   C9                    	RET
                                
                                ;============================================================
                                ; PAGESTP -- the count-limited scroll step.  The disk-eviction seam
                                ; (MKROOM/SPILL/SPILLB/PAGEBOT/REWIND), the deque marks (MARKGB/UPDMARK/RECBASE/
                                ; PTRREC) and the paging drivers (PAGEDIR/PGNEED/PAGEWIN) are all real in
                                ; PAGE.MAC, and CNTTST/CMDCNT/AUXCNT now exist in CMD.MAC.
                                ;============================================================
                                
                                ;PAGESTP -- WM 4311: page one step in the scroll direction, count-limited.
                                ;CNTTST returns Z when the command count (CMDCNT and AUXCNT) is exhausted, so a
                                ;completed edit or motion stops here (RZ); otherwise fall into PAGEDIR to page
                                ;the window one increment in the current scroll direction (DIRFLG: REWIND back,
                                ;FILLBUF forward).  In WM PAGESTP falls through to the physically adjacent
                                ;PAGEDIR; here PAGEDIR lives in PAGE.MAC, so the fall-through is an explicit
                                ;JMP -- same object behavior, PAGEDIR's own POLLBRK still runs.  DELTO's tail
                                ;JMPs here, so a delete made with the count spent returns at once; the count
                                ;loops (dd's QPUTLN, MVLLOOP's line moves, the search sweep through SCRLST)
                                ;are what page the window on past its edge.
                                ;SCRLST -- WM 4307: poll type-ahead, PUTCUR to HL, then (count not spent)
                                ;fall into PAGESTP to page the window one step in the DIRFLG direction.
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  05DD'                         SCRLST:				; WM 4307
  05DD'   CD 0000*              	CALL	POLLBRK
  05E0'   CD 03A1'              	CALL	PUTCUR
                                
  05E3'                         PAGESTP:			; WM 4311
  05E3'   CD 0000*              	CALL	CNTTST
  05E6'   C8                    	RZ
  05E7'   C3 0000*              	JMP	PAGEDIR
                                
                                ;============================================================
                                ; ERRMSG -- WM 664, message-print transcribed; TAIL adapted (see header):
                                ; print the inline 0-terminated message, set ERRFLG, warm-boot to CP/M.
                                ; The message is printed where ERRHK leaves the cursor: VI.MAC points it at the
                                ; screen teardown, so it lands on the bottom row with the terminal restored, as
                                ; a quit leaves it; a harness with no screen leaves it on a RET.  The work files
                                ; are dropped before the warm boot, as a quit drops them.  A second error from
                                ; inside either step ends here too: DISCRD clears its own flag before it
                                ; deletes, so it cannot run twice.
                                ;============================================================
  05EA'                         ERRMSG:				; WM 664 (tail adapted)
  05EA'   3E FF                 	MVI	A,0FFH
  05EC'   32 0A3D'              	STA	ERRFLG		; record that an error fired
  05EF'   2A 060F'              	LHLD	ERRHK
  05F2'   CD 060D'              	CALL	ERMGO		; the cursor to where the message belongs
  05F5'   E1                    	POP	H		; HL -> inline message (after the CALL)
  05F6'                         ERMLP:
  05F6'   7E                    	MOV	A,M
  05F7'   B7                    	ORA	A
  05F8'   CA 0607'              	JZ	ERMEND
  05FB'   E5                    	PUSH	H
  05FC'   5F                    	MOV	E,A
  05FD'   0E 02                 	MVI	C,2		; BDOS console out
  05FF'   CD 0005               	CALL	BDOS
  0602'   E1                    	POP	H
  0603'   23                    	INX	H
  0604'   C3 05F6'              	JMP	ERMLP
  0607'                         ERMEND:
  0607'   CD 0000*              	CALL	DISCRD		; no name.$$$ / VIBACKUP.$$$ left behind
  060A'   C3 0000               	JMP	WBOOT		; adapted tail: back to CP/M
  060D'   E9                    ERMGO:	PCHL
  060E'   C9                    ERMNUL: RET
  060F'   060E'                 ERRHK:	DW	ERMNUL		; the screen's teardown, once there is a screen
                                
                                ;============================================================
                                ; LOGICAL-OFFSET API  (APPENDED -- NOT WordMaster).
                                ; The gap-agnostic view the vi layer (CMD.MAC) uses so it never touches the raw
                                ; pointer row.  A logical offset is a byte index into resident text as if the
                                ; gap were absent:
                                ;   before = GAPBEG - TXTBEG   (bytes before the cursor = cursor logical offset)
                                ;   after  = TXTEND - GAPEND   (bytes at/after the cursor)
                                ;   LOGLEN = before + after
                                ; Most of CMD.MAC's verbs work in these offsets alone; the rest drive WM's
                                ; pointer-based routines (PUTCUR, the line moves, RGET, the matchers, the
                                ; Q-buffer), which page as they go, and a few read the pointer row directly.
                                ;============================================================
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


                                ;CUROFF -- HL = cursor logical offset (= before length).
  0611'                         CUROFF:
  0611'   2A 0A33'              	LHLD	TXTBEG
  0614'   EB                    	XCHG
  0615'   2A 0A35'              	LHLD	GAPBEG
  0618'   CD 058E'              	CALL	SUBHD		; HL = GAPBEG - TXTBEG
  061B'   C9                    	RET
                                
                                ;AFTLN2 -- HL = after length (TXTEND - GAPEND).  Private helper for LOGLEN.
  061C'                         AFTLN2:
  061C'   2A 0A37'              	LHLD	GAPEND
  061F'   EB                    	XCHG
  0620'   2A 0A39'              	LHLD	TXTEND
  0623'   CD 058E'              	CALL	SUBHD
  0626'   C9                    	RET
                                
                                ;LOGLEN -- HL = total resident logical length.
  0627'                         LOGLEN:
  0627'   CD 0611'              	CALL	CUROFF
  062A'   E5                    	PUSH	H
  062B'   CD 061C'              	CALL	AFTLN2
  062E'   D1                    	POP	D
  062F'   19                    	DAD	D
  0630'   C9                    	RET
                                
                                ;L2PHYS -- HL(off) -> HL(physical address).  0 <= off <= LOGLEN.  Private.
  0631'                         L2PHYS:
  0631'   EB                    	XCHG			; DE = off
  0632'   D5                    	PUSH	D
  0633'   CD 0611'              	CALL	CUROFF		; HL = before
  0636'   D1                    	POP	D		; DE = off
  0637'   CD 05AC'              	CALL	CMP16		; DE=off vs HL=before: CY iff off < before
  063A'   DA 0647'              	JC	L2P_BEF
                                	;--- after region: phys = GAPEND + (off - before) ---
  063D'   EB                    	XCHG			; HL=off, DE=before
  063E'   CD 058E'              	CALL	SUBHD		; HL = off - before
  0641'   EB                    	XCHG			; DE = off-before
  0642'   2A 0A37'              	LHLD	GAPEND
  0645'   19                    	DAD	D
  0646'   C9                    	RET
  0647'                         L2P_BEF:
                                	;--- before region: phys = TXTBEG + off  (DE = off, HL = before) ---
  0647'   2A 0A33'              	LHLD	TXTBEG
  064A'   19                    	DAD	D
  064B'   C9                    	RET
                                
                                ;CHARAT -- HL(off) -> A = byte at that logical offset (off < LOGLEN).
  064C'                         CHARAT:
  064C'   CD 0631'              	CALL	L2PHYS
  064F'   7E                    	MOV	A,M
  0650'   C9                    	RET
                                
                                ;CLAMPL -- HL(off) -> HL clamped to [0, LOGLEN].  Private helper for GOTO.
  0651'                         CLAMPL:
  0651'   E5                    	PUSH	H
  0652'   CD 0627'              	CALL	LOGLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  0655'   D1                    	POP	D		; DE = off
  0656'   CD 05AC'              	CALL	CMP16		; DE=off vs HL=LOGLEN
  0659'   DA 0660'              	JC	CLK_KEEP	; off < LOGLEN
  065C'   CA 0660'              	JZ	CLK_KEEP	; off == LOGLEN
  065F'   C9                    	RET			; off > LOGLEN -> HL = LOGLEN
  0660'                         CLK_KEEP:
  0660'   EB                    	XCHG			; HL = off
  0661'   C9                    	RET
                                
                                ;GOTO -- HL(off): move the cursor to that logical offset.
                                ;PUTCUR takes its target address in HL (its entry XCHG moves it to DE).
                                ;The line feeds the cursor crosses are added to LNDLT (subtracted going back).
  0662'                         GOTO:
  0662'   CD 0651'              	CALL	CLAMPL
  0665'   CD 0631'              	CALL	L2PHYS		; HL = physical address
  0668'   E5                    	PUSH	H
  0669'   EB                    	XCHG			; DE = target
  066A'   2A 0A37'              	LHLD	GAPEND
  066D'   CD 05AC'              	CALL	CMP16		; CY iff target < GAPEND (before the gap)
  0670'   DA 067E'              	JC	GTO_BK
  0673'   EB                    	XCHG			; forward: count [GAPEND, target)
  0674'   CD 0692'              	CALL	LFCNT
  0677'   2A 0A7E'              	LHLD	LNDLT
  067A'   19                    	DAD	D
  067B'   C3 068A'              	JMP	GTO_ST
  067E'                         GTO_BK:
  067E'   2A 0A35'              	LHLD	GAPBEG		; back: count [target, GAPBEG)
  0681'   CD 0692'              	CALL	LFCNT
  0684'   2A 0A7E'              	LHLD	LNDLT
  0687'   CD 058E'              	CALL	SUBHD
  068A'                         GTO_ST:
  068A'   22 0A7E'              	SHLD	LNDLT
  068D'   E1                    	POP	H
  068E'   CD 03A1'              	CALL	PUTCUR
  0691'   C9                    	RET
                                
                                ;LFCNT -- DE = start, HL = end (>= start): DE = number of LFs in [start, end).
  0692'                         LFCNT:
  0692'   CD 058E'              	CALL	SUBHD		; HL = end - start
  0695'   44                    	MOV	B,H
  0696'   4D                    	MOV	C,L		; BC = length
  0697'   EB                    	XCHG			; HL = start
  0698'   11 0000               	LXI	D,0
  069B'                         LFC_LP:
  069B'   78                    	MOV	A,B
  069C'   B1                    	ORA	C
  069D'   C8                    	RZ
  069E'   7E                    	MOV	A,M
  069F'   23                    	INX	H
  06A0'   0B                    	DCX	B
  06A1'   FE 0A                 	CPI	LF
  06A3'   C2 069B'              	JNZ	LFC_LP
  06A6'   13                    	INX	D
  06A7'   C3 069B'              	JMP	LFC_LP
                                
                                ;RDGET -- RGET, and CY also when a refill read nothing.  INRDY stays set after
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


                                ;a file's last full record (no ^Z) until a read fails; NEEDIN then returns NC
                                ;having added nothing, and RGET steps past TXTEND leaving BC = FFFFH.  That is
                                ;reported as the end of the text, with BC = 0 so a later call asks NEEDIN again.
  06AA'                         RDGET:
  06AA'   CD 04EC'              	CALL	RGET
  06AD'   D8                    	RC
  06AE'   F5                    	PUSH	PSW
  06AF'   78                    	MOV	A,B
  06B0'   A1                    	ANA	C
  06B1'   3C                    	INR	A		; Z iff BC = FFFFH
  06B2'   CA 06B7'              	JZ	RDG_EF
  06B5'   F1                    	POP	PSW
  06B6'   C9                    	RET
  06B7'                         RDG_EF:
  06B7'   F1                    	POP	PSW
  06B8'   01 0000               	LXI	B,0
  06BB'   37                    	STC
  06BC'   C9                    	RET
                                
                                ;DELFWD -- HL = number of logical bytes to delete forward from the cursor.
  06BD'                         DELFWD:
  06BD'   7C                    	MOV	A,H
  06BE'   B5                    	ORA	L
  06BF'   C8                    	RZ			; nothing to delete
  06C0'   CD 09DE'              	CALL	UNDDLF		; (appended) the span, for 'u', before it goes
  06C3'   EB                    	XCHG			; DE = count
  06C4'   2A 0A37'              	LHLD	GAPEND
  06C7'   19                    	DAD	D		; target = GAPEND + count
  06C8'   AF                    	XRA	A		; S clear -> forward delete
  06C9'   CD 01CA'              	CALL	DELTO
  06CC'   C9                    	RET
                                
                                ;DELPRV -- WM 3260 RUBOUT/DELL: delete the char left of the cursor, and the
                                ;CR too when that leaves one there (a CR,LF goes as one).  PEEKLX pages back
                                ;at the window start and returns at the start of the file.  WM's MARKCUR and
                                ;ROWUP (its screen) are left out; instead a deleted LF moves the cursor up a
                                ;line (LNDLT - 1) for SCRN.MAC.
  06CD'                         DELPRV:				; WM 3260
  06CD'   CD 01C3'              	CALL	PEEKLX
  06D0'   FE 0A                 	CPI	LF
  06D2'   C2 06DE'              	JNZ	DLP_GO
  06D5'   E5                    	PUSH	H
  06D6'   2A 0A7E'              	LHLD	LNDLT
  06D9'   2B                    	DCX	H
  06DA'   22 0A7E'              	SHLD	LNDLT
  06DD'   E1                    	POP	H
  06DE'                         DLP_GO:				; WM 3263 DELL
  06DE'   CD 09FE'              	CALL	UNDDLP		; (appended) that byte, for 'u', before it goes
  06E1'   CD 0055'              	CALL	SETGAPB
  06E4'   CD 01B6'              	CALL	PEEKL
  06E7'   FE 0D                 	CPI	CR
  06E9'   CA 06CD'              	JZ	DELPRV
  06EC'   C9                    	RET
                                
                                
                                ;UNDELF -- APPENDED, NOT WordMaster: give back the byte last swallowed forward
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                                ;into the gap.  A forward delete only moves GAPEND past the byte, so the byte
                                ;itself is still there, inside the gap: GAPEND-1 through DELTO makes it text
                                ;again, with the record marks updated exactly as a delete updates them.
                                ;Replace mode ('R') puts back with it what it overwrote, as vim's BS in Replace
                                ;mode does.  The caller must know the gap has not moved since the delete
                                ;(CMD.MAC keeps GAPEND in RPGE for that); nothing else calls this.
  06ED'                         UNDELF:
  06ED'   2A 0A37'              	LHLD	GAPEND
  06F0'   2B                    	DCX	H
  06F1'   AF                    	XRA	A		; S clear -> the forward (GAPEND) side
  06F2'   CD 01CA'              	CALL	DELTO
  06F5'   C3 0A11'              	JMP	UNDUDF		; (appended) the byte just made text again
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  APPENDED, NOT WordMaster: WM has no undo at all (its QBUFOP /
                                ; QEXEC macro is a command-LINE facility, not this).
                                ;
                                ; Six primitives change resident text, and each one says what it did: PUTGAP
                                ; (one byte in), QGET (the register in), DELFWD (a span out), DELPRV (one byte
                                ; out backward), UNDELF (one byte back in) and QPUTLN (whole lines out).
                                ; Nothing else in the editor reaches the text, so no command can forget to
                                ; record itself -- which is the whole reason the capture sits down here instead
                                ; of at CMD.MAC's edit sites.
                                ;
                                ; A record says only WHERE and HOW MUCH, in LOGICAL offsets, plus where its
                                ; bytes lie in the undo region.  Logical offsets survive the gap sliding (which
                                ; PUTCUR does on every cursor move) because the replay walks the records
                                ; BACKWARD: each step restores the offsets the steps after it were measured
                                ; against.  The bytes are kept for an insert as well as a delete -- an insert
                                ; costs its own text twice, which is nothing -- so the region is settled once
                                ; the command ends and 'u' can walk it either way: backward applying each
                                ; record's inverse to undo, forward applying the records as they stand to redo.
                                ; That is what makes 'u' undo 'u' with ONE region and no capture during the
                                ; replay.
                                ;
                                ; The region is a region of the arena like the Q buffer, inserted between the
                                ; slider and the text, and it grows through the same MKGAP: the pointer row
                                ; reads (UBEG,UEND) as data and (TXTBAS,UBEG) / (UEND,TXTBEG) as the holes
                                ; around it, so NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN and INIBAS all take it in
                                ; their stride unchanged.
                                ;
                                ; DEVIATIONS from vim, all deliberate and all in COMMANDS.md: ONE level of
                                ; undo, so 'u' undoes 'u' as real vi does; the change must still be in the
                                ; RESIDENT window, and 'u' refuses once the pager has moved off it rather than
                                ; chasing it through the file; and a change with more steps than the table
                                ; holds, or one the arena has no spare room to keep, is not undoable at all.
                                ;
                                ; "Moved off it" is PGTOPM, PAGE.MAC's count of the times the pager moved
                                ; TXTBEG.  It is the window's TOP that matters: an offset is measured from
                                ; TXTBEG, so spilling a record out from under it (PAGEOUT) or reading one back
                                ; in (REWIND) shifts every offset, while FILLBUF and PAGEBOT growing TXTEND at
                                ; the bottom shift none.  The OUTREC/SRCREC water marks look like the same
                                ; thing and are not: UPDMARK raises them on every edit.
                                ;============================================================
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  0001                          UR_INS	EQU	1		; text went IN  (undoing takes it back out)
  0002                          UR_DEL	EQU	2		; text came OUT (undoing puts it back)
  0007                          URSIZE	EQU	7		; type, offset(2), length(2), region offset(2)
  0018                          URMAX	EQU	24		; primitive steps one change may hold
                                ;How much of the arena the capture refuses to eat into.  It only has to keep
                                ;MKGAP off its MKROOM path (which wants 256 free), because paging is what undo
                                ;must not do -- so this is deliberately SMALL.  RESVMEM, QROOM's reserve, is
                                ;far too big: a 66 K file leaves under 1700 bytes free, and undo would never
                                ;engage at all on exactly the files that need it most.
  0200                          UNDRSV	EQU	200H		; ... 512 bytes
                                ;How much room the region claims up front, and so the largest change that can
                                ;be kept.  The claim is what lets the capture run without EVER growing the
                                ;region: see UNDGRW for why growing where a primitive can see it is unsafe.
  0400                          UNDCAP	EQU	400H		; 1024 bytes of change
                                
                                ;UNDBEG -- CMD.MAC's command boundary: the NEXT captured change starts a new
                                ;undo.  A flag only, so a command that changes nothing -- a motion, a yank, a
                                ;key that is no command at all -- leaves the last change undoable, exactly as
                                ;'.' keeps the last change it recorded.
  06F8'                         UNDBEG:
  06F8'   D5                    	PUSH	D
  06F9'   E5                    	PUSH	H
  06FA'   3E 01                 	MVI	A,1
  06FC'   32 0A66'              	STA	UNDNEW
  06FF'   CD 0611'              	CALL	CUROFF
  0702'   22 0A7A'              	SHLD	UNDPCU		; where the cursor was as this command began --
  0705'   CD 0714'              	CALL	UNDGRW		;   kept pending, because only a command that
  0708'   E1                    	POP	H		;   really changes text gets to claim it
  0709'   D1                    	POP	D
  070A'   C9                    	RET
                                
                                ;UNDHER -- the change about to start belongs at the CURSOR: 'u' puts it back
                                ;there.  UNDBEG's cursor snapshot without its claim on the region, for a
                                ;command (':s') that cannot know where its first change will be until it has
                                ;found it.  Calling UNDBEG again instead would re-run UNDGRW in the middle of
                                ;the command, which is the one thing UNDGRW must never do -- see below.
  070B'                         UNDHER:
  070B'   E5                    	PUSH	H
  070C'   CD 0611'              	CALL	CUROFF
  070F'   22 0A7A'              	SHLD	UNDPCU
  0712'   E1                    	POP	H
  0713'   C9                    	RET
                                
                                ;UNDGRW -- make sure the region can take a whole change without growing again.
                                ;THE ONLY PLACE THE REGION GROWS, and it runs at the command boundary, where no
                                ;primitive is holding anything.  Growing moves regions about (MKGAP -> MOVGAP),
                                ;and that both invalidates a raw pointer a primitive is in the middle of using
                                ;-- DELPRV hands SETGAPB one -- and overwrites whatever is sitting in the gap,
                                ;which is where a forward-deleted byte waits for 'R's backspace to call UNDELF
                                ;and give it back.  So the room is claimed here, 256 bytes at a time, and the
                                ;capture below never calls MKGAP at all: it writes into the claim or gives up.
                                ;The room has to be claimed as the region's own CONTENT, not left as the hole
                                ;above it: the holes are shared, and the text takes whatever it can reach --
                                ;MOVGAP feeding an insert will walk straight through a hole reserved here, which
                                ;is what made a 200-character insert lose its undo halfway.  Once the bytes are
                                ;inside (UBEG,UEND) the text cannot have them: MOVGAP slides the region aside
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


                                ;instead.  Nothing here holds an address across MKGAP either, because MKGAP
                                ;slides this very region (HOLEUP moves UBEG and UEND) -- UEND is re-read from
                                ;its cell every time round.
  0714'                         UNDGRW:
  0714'   C5                    	PUSH	B
  0715'   D5                    	PUSH	D
  0716'   E5                    	PUSH	H
  0717'                         UNDGRL:
  0717'   21 0A2F'              	LXI	H,UBEG
  071A'   CD 04DA'              	CALL	PRSPAN		; BC = the region's size
  071D'   50                    	MOV	D,B
  071E'   59                    	MOV	E,C
  071F'   21 0400               	LXI	H,UNDCAP
  0722'   CD 05AC'              	CALL	CMP16		; CY iff it is smaller than one change
  0725'   D2 05D9'              	JNC	POPRET
  0728'   CD 08AB'              	CALL	UNDRM		; ... but never at the cost of paging
  072B'   DA 05D9'              	JC	POPRET
  072E'   21 0A31'              	LXI	H,UEND
  0731'   CD 00B0'              	CALL	MKGAP		; 256 free above the region ...
  0734'   2A 0A31'              	LHLD	UEND
  0737'   11 0100               	LXI	D,100H
  073A'   19                    	DAD	D
  073B'   22 0A31'              	SHLD	UEND		; ... taken into it, so the text cannot take
  073E'   C3 0717'              	JMP	UNDGRL		;     them back
                                
                                ;UNDCLR -- nothing is undoable (a fresh buffer; BINIT calls it through INIGAP).
  0741'                         UNDCLR:
  0741'   AF                    	XRA	A
  0742'   32 0A63'              	STA	UNDN
  0745'   32 0A64'              	STA	UNDST
  0748'   32 0A65'              	STA	UNDBAD
  074B'   3E 01                 	MVI	A,1
  074D'   32 0A66'              	STA	UNDNEW
  0750'   C9                    	RET
                                
                                ;UNDRST -- the first capture of a new change: drop the last one and note where
                                ;the file window was, so 'u' can tell the pager has since moved off this change.
  0751'                         UNDRST:
  0751'   AF                    	XRA	A
  0752'   32 0A66'              	STA	UNDNEW
  0755'   32 0A63'              	STA	UNDN
  0758'   32 0A65'              	STA	UNDBAD
  075B'   21 0000               	LXI	H,0
  075E'   22 0A77'              	SHLD	UNDPTR		; the region's content empties (its SIZE stays:
                                				;   that is the room UNDGRW claimed)
  0761'   2A 0000*              	LHLD	PGTOPM
  0764'   22 0A75'              	SHLD	UNDPG
  0767'   2A 0A7A'              	LHLD	UNDPCU
  076A'   22 0A7C'              	SHLD	UNDCUR		; ... and this command does change text, so this
                                				;   is where 'u' will put the cursor back
  076D'   3E 01                 	MVI	A,1
  076F'   32 0A64'              	STA	UNDST		; a change is on the buffer: 'u' undoes it
  0772'   C9                    	RET
                                
                                ;UNDCHG -- the capture every hooked primitive uses.  A = UR_INS / UR_DEL,
                                ;HL = the logical offset it acted at, BC = how many bytes.  The bytes are read
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


                                ;back out of the resident TEXT at that offset -- for a delete before they go,
                                ;for an insert once they have arrived -- so no caller hands over a pointer that
                                ;growing the region could leave stale.
  0773'                         UNDCHG:
  0773'   C5                    	PUSH	B
  0774'   D5                    	PUSH	D
  0775'   E5                    	PUSH	H
  0776'   32 0A6A'              	STA	UNDTY		; the record type, kept out of the registers
  0779'   CD 07F1'              	CALL	EDTGO		; whoever else follows an edit (BC is kept)
  077C'   3A 0A67'              	LDA	UNDRPL
  077F'   B7                    	ORA	A
  0780'   C2 05D9'              	JNZ	POPRET		; 'u' replaying: its own edits are not a change
  0783'   3A 0A66'              	LDA	UNDNEW
  0786'   B7                    	ORA	A
  0787'   CA 078D'              	JZ	UNDC1
  078A'   CD 0751'              	CALL	UNDRST		; the first step of a new change
  078D'                         UNDC1:
  078D'   3A 0A65'              	LDA	UNDBAD
  0790'   B7                    	ORA	A
  0791'   C2 05D9'              	JNZ	POPRET		; this change has already been given up on
  0794'   78                    	MOV	A,B
  0795'   B1                    	ORA	C
  0796'   CA 05D9'              	JZ	POPRET		; a zero-length step is no step
  0799'   60                    	MOV	H,B
  079A'   69                    	MOV	L,C
  079B'   22 0A71'              	SHLD	UNDCL		; UNDAPT spends BC as its countdown, so the
                                				;   length has to be kept somewhere else
  079E'   3A 0A63'              	LDA	UNDN
  07A1'   FE 18                 	CPI	URMAX
  07A3'   D2 07E9'              	JNC	UNDCBD		; no room for another step
                                	;--- where this step's bytes will land in the region ---
  07A6'   2A 0A77'              	LHLD	UNDPTR
  07A9'   22 0A6F'              	SHLD	UNDBO
  07AC'   E1                    	POP	H
  07AD'   E5                    	PUSH	H		; HL = the logical offset again
  07AE'   CD 0861'              	CALL	UNDAPT		; BC bytes of the text there -> the region
  07B1'   DA 07E9'              	JC	UNDCBD
                                	;--- fold it into the last record when it only carries that one on ---
  07B4'   E1                    	POP	H
  07B5'   E5                    	PUSH	H
  07B6'   CD 0809'              	CALL	UNDEXT
  07B9'   CA 05D9'              	JZ	POPRET
                                	;--- otherwise a record of its own ---
  07BC'   3A 0A63'              	LDA	UNDN
  07BF'   CD 07F9'              	CALL	URADDR
  07C2'   3A 0A6A'              	LDA	UNDTY
  07C5'   77                    	MOV	M,A
  07C6'   23                    	INX	H
  07C7'   D1                    	POP	D
  07C8'   D5                    	PUSH	D		; DE = the logical offset
  07C9'   73                    	MOV	M,E
  07CA'   23                    	INX	H
  07CB'   72                    	MOV	M,D
  07CC'   23                    	INX	H
  07CD'   EB                    	XCHG			; DE = the record, past the offset
  07CE'   2A 0A71'              	LHLD	UNDCL
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  07D1'   EB                    	XCHG			; ... and HL back, with DE = the length
  07D2'   73                    	MOV	M,E
  07D3'   23                    	INX	H
  07D4'   72                    	MOV	M,D
  07D5'   23                    	INX	H
  07D6'   3A 0A6F'              	LDA	UNDBO
  07D9'   77                    	MOV	M,A
  07DA'   23                    	INX	H
  07DB'   3A 0A70'              	LDA	UNDBO+1
  07DE'   77                    	MOV	M,A
  07DF'   3A 0A63'              	LDA	UNDN
  07E2'   3C                    	INR	A
  07E3'   32 0A63'              	STA	UNDN
  07E6'   C3 05D9'              	JMP	POPRET
  07E9'                         UNDCBD:
  07E9'   3E 01                 	MVI	A,1
  07EB'   32 0A65'              	STA	UNDBAD		; too big to keep: not undoable at all
  07EE'   C3 05D9'              	JMP	POPRET
                                
                                ;EDTGO -- UNDCHG is the one place every change to the text goes by, the
                                ;replay's own included, so it is also where the editor hears of one: EDTHK is
                                ;called with A = UR_INS / UR_DEL, HL = the logical offset and BC = the length,
                                ;and must keep BC.  VI.MAC points it at the marks; a harness leaves it a RET.
  07F1'                         EDTGO:
  07F1'   E5                    	PUSH	H
  07F2'   2A 07F7'              	LHLD	EDTHK
  07F5'   E3                    	XTHL
  07F6'   C9                    	RET
  07F7'   060E'                 EDTHK:	DW	ERMNUL
                                
                                ;URADDR -- A = a record index -> HL = its address (base + n*8 - n).
  07F9'                         URADDR:
  07F9'   6F                    	MOV	L,A
  07FA'   26 00                 	MVI	H,0
  07FC'   5D                    	MOV	E,L
  07FD'   54                    	MOV	D,H
  07FE'   29                    	DAD	H
  07FF'   29                    	DAD	H
  0800'   29                    	DAD	H		; HL = n*8
  0801'   CD 058E'              	CALL	SUBHD		; HL = n*7
  0804'   11 0000*              	LXI	D,UNDREC
  0807'   19                    	DAD	D
  0808'   C9                    	RET
                                
                                ;UNDEXT -- A = 0 (Z) when this step only carries the last record on: an insert
                                ;starting exactly where the last insert ended, which is what typing does.  Its
                                ;bytes already sit contiguously behind that record's, so only the length grows.
                                ;HL = this step's offset, BC = its length.
  0809'                         UNDEXT:
  0809'   C5                    	PUSH	B
  080A'   D5                    	PUSH	D
  080B'   E5                    	PUSH	H
  080C'   3A 0A6A'              	LDA	UNDTY
  080F'   FE 01                 	CPI	UR_INS
  0811'   C2 085B'              	JNZ	UNDXNO		; only inserts fold
  0814'   3A 0A63'              	LDA	UNDN
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0817'   B7                    	ORA	A
  0818'   CA 085B'              	JZ	UNDXNO		; nothing to fold into
  081B'   3D                    	DCR	A
  081C'   CD 07F9'              	CALL	URADDR
  081F'   22 0A73'              	SHLD	UNDLSA
  0822'   7E                    	MOV	A,M
  0823'   FE 01                 	CPI	UR_INS
  0825'   C2 085B'              	JNZ	UNDXNO
  0828'   2A 0A73'              	LHLD	UNDLSA
  082B'   23                    	INX	H
  082C'   CD 05A7'              	CALL	LDHLI		; HL = the last record's offset
  082F'   EB                    	XCHG
  0830'   2A 0A73'              	LHLD	UNDLSA
  0833'   23                    	INX	H
  0834'   23                    	INX	H
  0835'   23                    	INX	H
  0836'   CD 05A7'              	CALL	LDHLI		; HL = its length
  0839'   19                    	DAD	D		; HL = where it ends
  083A'   EB                    	XCHG
  083B'   E1                    	POP	H
  083C'   E5                    	PUSH	H		; HL = this step's offset
  083D'   CD 05AC'              	CALL	CMP16		; Z iff this step starts exactly there
  0840'   C2 085B'              	JNZ	UNDXNO
  0843'   2A 0A73'              	LHLD	UNDLSA
  0846'   23                    	INX	H
  0847'   23                    	INX	H
  0848'   23                    	INX	H
  0849'   E5                    	PUSH	H
  084A'   CD 05A7'              	CALL	LDHLI		; HL = the last record's length
  084D'   EB                    	XCHG
  084E'   2A 0A71'              	LHLD	UNDCL
  0851'   19                    	DAD	D		; ... grown by this step's
  0852'   EB                    	XCHG
  0853'   E1                    	POP	H
  0854'   73                    	MOV	M,E
  0855'   23                    	INX	H
  0856'   72                    	MOV	M,D
  0857'   AF                    	XRA	A		; Z: folded, no new record
  0858'   C3 05D9'              	JMP	POPRET
  085B'                         UNDXNO:
  085B'   3E 01                 	MVI	A,1
  085D'   B7                    	ORA	A		; NZ: it needs a record of its own
  085E'   C3 05D9'              	JMP	POPRET
                                
                                ;UNDAPT -- append BC bytes of resident text, from logical offset HL, to the
                                ;undo region.  One byte at a time, re-reading the offset through CHARAT and the
                                ;region through its pointer cell every time, so growing the region (which
                                ;slides regions about) can never leave this loop holding a stale address.
                                ;CY if it outgrows the claim, and the caller then gives the change up.
  0861'                         UNDAPT:
  0861'   78                    	MOV	A,B
  0862'   B1                    	ORA	C
  0863'   C8                    	RZ			; nothing to append
  0864'                         UNDAPL:
  0864'   C5                    	PUSH	B
  0865'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0866'   CD 064C'              	CALL	CHARAT		; A = the text byte at this offset
  0869'   CD 0877'              	CALL	UNDAPB		; ... into the region
  086C'   E1                    	POP	H
  086D'   C1                    	POP	B
  086E'   D8                    	RC
  086F'   23                    	INX	H
  0870'   0B                    	DCX	B
  0871'   78                    	MOV	A,B
  0872'   B1                    	ORA	C
  0873'   C2 0864'              	JNZ	UNDAPL
  0876'   C9                    	RET
                                
                                ;UNDAPB -- put the byte in A into the room UNDGRW claimed.  It does NOT grow
                                ;the region -- see UNDGRW -- so CY, and the change given up on, once the room
                                ;is used up: a change bigger than the region is simply not undoable.
  0877'                         UNDAPB:
  0877'   C5                    	PUSH	B
  0878'   D5                    	PUSH	D
  0879'   E5                    	PUSH	H
  087A'   32 0A79'              	STA	UNDB1
  087D'   21 0A2F'              	LXI	H,UBEG
  0880'   CD 04DA'              	CALL	PRSPAN		; BC = the region's size
  0883'   2A 0A77'              	LHLD	UNDPTR
  0886'   EB                    	XCHG			; DE = where the next byte goes
  0887'   60                    	MOV	H,B
  0888'   69                    	MOV	L,C
  0889'   CD 05AC'              	CALL	CMP16		; CY iff that is still inside the region
  088C'   D2 08A2'              	JNC	UNDAPF
  088F'   2A 0A2F'              	LHLD	UBEG		; re-read: a relocation moves the region
  0892'   19                    	DAD	D
  0893'   3A 0A79'              	LDA	UNDB1
  0896'   77                    	MOV	M,A
  0897'   2A 0A77'              	LHLD	UNDPTR
  089A'   23                    	INX	H
  089B'   22 0A77'              	SHLD	UNDPTR
  089E'   B7                    	ORA	A		; CY clear: it went in
  089F'   C3 05D9'              	JMP	POPRET
  08A2'                         UNDAPF:
  08A2'   3E 01                 	MVI	A,1
  08A4'   32 0A65'              	STA	UNDBAD
  08A7'   37                    	STC
  08A8'   C3 05D9'              	JMP	POPRET
                                
                                ;UNDRM -- CY, and the change given up on, unless the arena still holds UNDRSV
                                ;free.  The capture must never page: paging moves the window off the change and
                                ;would invalidate every logical offset the records hold.  Keeping this much
                                ;free also keeps MKGAP off its MKROOM path, so the capture cannot page even by
                                ;accident, and it fails QUIETLY where QROOM raises 'QBUF FULL' -- undo going
                                ;away must never stop the editing.
  08AB'                         UNDRM:
  08AB'   C5                    	PUSH	B
  08AC'   D5                    	PUSH	D
  08AD'   E5                    	PUSH	H
  08AE'   CD 0474'              	CALL	BUFSUM		; DE = the arena's free bytes
  08B1'   21 0200               	LXI	H,UNDRSV
  08B4'   CD 05AC'              	CALL	CMP16		; CY iff less than that is left
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  08B7'   D2 05D9'              	JNC	POPRET
  08BA'   3E 01                 	MVI	A,1
  08BC'   32 0A65'              	STA	UNDBAD
  08BF'   37                    	STC
  08C0'   C3 05D9'              	JMP	POPRET
                                
                                ;---------------------------------------------------------------- the replay
                                
                                ;UNDO -- 'u'.  CY when there is nothing to undo: no change captured, a change
                                ;too big to have been captured, or the pager has moved the window off it.
  08C3'                         UNDO:
  08C3'   AF                    	XRA	A
  08C4'   32 0A69'              	STA	UNDWHY		; refused for want of a change, until told else
  08C7'   3A 0A63'              	LDA	UNDN
  08CA'   B7                    	ORA	A
  08CB'   37                    	STC
  08CC'   C8                    	RZ			; nothing captured
  08CD'   3A 0A65'              	LDA	UNDBAD
  08D0'   B7                    	ORA	A
  08D1'   CA 08DB'              	JZ	UND_OK
  08D4'   3E 02                 	MVI	A,2
  08D6'   32 0A69'              	STA	UNDWHY		; too big to have been captured: CMD.MAC says
  08D9'   37                    	STC			;   so, rather than ringing the bell at a user
  08DA'   C9                    	RET			;   who has no way to know why
  08DB'                         UND_OK:
  08DB'   2A 0000*              	LHLD	PGTOPM
  08DE'   EB                    	XCHG
  08DF'   2A 0A75'              	LHLD	UNDPG
  08E2'   CD 05AC'              	CALL	CMP16
  08E5'   C2 090C'              	JNZ	UNDPGD		; the pager has moved the window's top since,
                                				;   so every offset the records hold has shifted
  08E8'   3E 01                 	MVI	A,1
  08EA'   32 0A67'              	STA	UNDRPL		; the replay's own edits are not a new change
  08ED'   3A 0A64'              	LDA	UNDST
  08F0'   FE 01                 	CPI	1
  08F2'   CA 0913'              	JZ	UNDREV
                                	;--- the last 'u' undid it: apply the records forward again (a redo) ---
  08F5'   AF                    	XRA	A
  08F6'   32 0A68'              	STA	UNDDIR
  08F9'   AF                    	XRA	A
  08FA'                         UNDFWL:
  08FA'   CD 0934'              	CALL	URSTEP
  08FD'   3C                    	INR	A
  08FE'   47                    	MOV	B,A
  08FF'   3A 0A63'              	LDA	UNDN
  0902'   B8                    	CMP	B
  0903'   78                    	MOV	A,B
  0904'   C2 08FA'              	JNZ	UNDFWL
  0907'   3E 01                 	MVI	A,1
  0909'   C3 0925'              	JMP	UNDFIN
  090C'                         UNDPGD:
  090C'   3E 01                 	MVI	A,1
  090E'   32 0A69'              	STA	UNDWHY		; the change is no longer in the window
  0911'   37                    	STC
  0912'   C9                    	RET
  0913'                         UNDREV:
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


                                	;--- undo: the records backward, each one's inverse ---
  0913'   3E 01                 	MVI	A,1
  0915'   32 0A68'              	STA	UNDDIR
  0918'   3A 0A63'              	LDA	UNDN
  091B'                         UNDRVL:
  091B'   3D                    	DCR	A
  091C'   CD 0934'              	CALL	URSTEP
  091F'   B7                    	ORA	A
  0920'   C2 091B'              	JNZ	UNDRVL
  0923'   3E 02                 	MVI	A,2
  0925'                         UNDFIN:
  0925'   32 0A64'              	STA	UNDST
  0928'   AF                    	XRA	A
  0929'   32 0A67'              	STA	UNDRPL
                                	;--- the cursor goes back where the command that changed it began:
                                	;    measured from vim, which restores that and not the change's own
                                	;    offset (CMD.MAC's VC_UNDO holds it inside the line) ---
  092C'   2A 0A7C'              	LHLD	UNDCUR
  092F'   CD 0662'              	CALL	GOTO
  0932'   B7                    	ORA	A		; CY clear: it happened
  0933'   C9                    	RET
                                
                                ;URSTEP -- apply record A: as it stands when UNDDIR is 0 (a redo), inverted
                                ;when it is 1 (an undo).  An insert applied puts its saved bytes back at its
                                ;offset; an insert inverted deletes that many bytes there; a delete is the
                                ;mirror of both.  A is preserved -- UNDO's loops count with it.
  0934'                         URSTEP:
  0934'   F5                    	PUSH	PSW
  0935'   CD 07F9'              	CALL	URADDR
  0938'   7E                    	MOV	A,M
  0939'   32 0A6A'              	STA	UNDTY
  093C'   23                    	INX	H
  093D'   7E                    	MOV	A,M
  093E'   32 0A6B'              	STA	UNDOF
  0941'   23                    	INX	H
  0942'   7E                    	MOV	A,M
  0943'   32 0A6C'              	STA	UNDOF+1
  0946'   23                    	INX	H
  0947'   7E                    	MOV	A,M
  0948'   32 0A6D'              	STA	UNDLN
  094B'   23                    	INX	H
  094C'   7E                    	MOV	A,M
  094D'   32 0A6E'              	STA	UNDLN+1
  0950'   23                    	INX	H
  0951'   7E                    	MOV	A,M
  0952'   32 0A6F'              	STA	UNDBO
  0955'   23                    	INX	H
  0956'   7E                    	MOV	A,M
  0957'   32 0A70'              	STA	UNDBO+1
  095A'   3A 0A6A'              	LDA	UNDTY
  095D'   47                    	MOV	B,A
  095E'   3A 0A68'              	LDA	UNDDIR
  0961'   B7                    	ORA	A
  0962'   CA 096E'              	JZ	URS_AP
  0965'   78                    	MOV	A,B		; an undo inverts the record
  0966'   FE 01                 	CPI	UR_INS
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0968'   CA 0974'              	JZ	URS_DL
  096B'   C3 0982'              	JMP	URS_IN
  096E'                         URS_AP:
  096E'   78                    	MOV	A,B		; a redo applies it as it stands
  096F'   FE 01                 	CPI	UR_INS
  0971'   CA 0982'              	JZ	URS_IN
  0974'                         URS_DL:
                                	;--- take the record's length back out at its offset ---
  0974'   2A 0A6B'              	LHLD	UNDOF
  0977'   CD 0662'              	CALL	GOTO
  097A'   2A 0A6D'              	LHLD	UNDLN
  097D'   CD 06BD'              	CALL	DELFWD
  0980'   F1                    	POP	PSW
  0981'   C9                    	RET
  0982'                         URS_IN:
                                	;--- put the record's saved bytes back in at its offset ---
  0982'   2A 0A6B'              	LHLD	UNDOF
  0985'   CD 0662'              	CALL	GOTO
  0988'   2A 0A6D'              	LHLD	UNDLN
  098B'   44                    	MOV	B,H
  098C'   4D                    	MOV	C,L
  098D'   2A 0A6F'              	LHLD	UNDBO
  0990'                         URSILP:
  0990'   C5                    	PUSH	B
  0991'   E5                    	PUSH	H
  0992'   EB                    	XCHG			; DE = the byte's offset within the region
  0993'   2A 0A2F'              	LHLD	UBEG		; ... re-read every byte: inserting text can
  0996'   19                    	DAD	D		;     slide the region out from under it
  0997'   7E                    	MOV	A,M
  0998'   CD 0045'              	CALL	PUTGAP
  099B'   FE 0A                 	CPI	LF
  099D'   C2 09A7'              	JNZ	URSILN
  09A0'   2A 0A7E'              	LHLD	LNDLT		; a line end put back is the cursor crossing
  09A3'   23                    	INX	H		;   one, and GOTO keeps LNDLT for every move the
  09A4'   22 0A7E'              	SHLD	LNDLT		;   replay makes -- so the renderer needs no
  09A7'                         URSILN:				;   whole-window rescan to find that out
  09A7'   E1                    	POP	H
  09A8'   C1                    	POP	B
  09A9'   23                    	INX	H
  09AA'   0B                    	DCX	B
  09AB'   78                    	MOV	A,B
  09AC'   B1                    	ORA	C
  09AD'   C2 0990'              	JNZ	URSILP
  09B0'   F1                    	POP	PSW
  09B1'   C9                    	RET
                                
                                ;---------------------------------------------------------------- the hooks
                                
                                ;UNDPUT -- PUTGAP's tail: the one byte now sitting just below the cursor.
  09B2'                         UNDPUT:
  09B2'   F5                    	PUSH	PSW
  09B3'   C5                    	PUSH	B
  09B4'   D5                    	PUSH	D
  09B5'   E5                    	PUSH	H
  09B6'   CD 0611'              	CALL	CUROFF
  09B9'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  09BA'   01 0001               	LXI	B,1
  09BD'   3E 01                 	MVI	A,UR_INS
  09BF'   CD 0773'              	CALL	UNDCHG
  09C2'   C3 0A20'              	JMP	UNDHX
                                
                                ;UNDGET -- QGET's tail: BC bytes of register now in, the cursor past them.
                                ;UNDINS is the same entry by its general name: INSBLK itself carries NO hook
                                ;(insert mode records a byte at a time through PUTGAP), so a command that
                                ;splices a block in -- ':s' replacing a match -- has to say so itself, exactly
                                ;as QGET does.  Without it 'u' puts the deleted text back and leaves the
                                ;inserted text there ('a-a-a' undid to 'aZ-aZ-aZ').
  09C5'                         UNDINS:
  09C5'                         UNDGET:
  09C5'   F5                    	PUSH	PSW
  09C6'   C5                    	PUSH	B
  09C7'   D5                    	PUSH	D
  09C8'   E5                    	PUSH	H
  09C9'   78                    	MOV	A,B
  09CA'   B1                    	ORA	C
  09CB'   CA 0A20'              	JZ	UNDHX
  09CE'   CD 0611'              	CALL	CUROFF
  09D1'   50                    	MOV	D,B
  09D2'   59                    	MOV	E,C
  09D3'   CD 058E'              	CALL	SUBHD		; HL = where the put began
  09D6'   3E 01                 	MVI	A,UR_INS
  09D8'   CD 0773'              	CALL	UNDCHG
  09DB'   C3 0A20'              	JMP	UNDHX
                                
                                ;UNDDLF -- DELFWD's head: HL bytes about to go forward from the cursor.
  09DE'                         UNDDLF:
  09DE'   F5                    	PUSH	PSW
  09DF'   C5                    	PUSH	B
  09E0'   D5                    	PUSH	D
  09E1'   E5                    	PUSH	H
  09E2'   44                    	MOV	B,H
  09E3'   4D                    	MOV	C,L
  09E4'   CD 0611'              	CALL	CUROFF
  09E7'   3E 02                 	MVI	A,UR_DEL
  09E9'   CD 0773'              	CALL	UNDCHG
  09EC'   C3 0A20'              	JMP	UNDHX
                                
                                ;UNDDLQ -- QPUTLN's head: BC bytes of whole lines about to go into the register.
  09EF'                         UNDDLQ:
  09EF'   F5                    	PUSH	PSW
  09F0'   C5                    	PUSH	B
  09F1'   D5                    	PUSH	D
  09F2'   E5                    	PUSH	H
  09F3'   CD 0611'              	CALL	CUROFF
  09F6'   3E 02                 	MVI	A,UR_DEL
  09F8'   CD 0773'              	CALL	UNDCHG
  09FB'   C3 0A20'              	JMP	UNDHX
                                
                                ;UNDDLP -- DELPRV's head: the one byte just below the cursor, about to go.
  09FE'                         UNDDLP:
  09FE'   F5                    	PUSH	PSW
  09FF'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0A00'   D5                    	PUSH	D
  0A01'   E5                    	PUSH	H
  0A02'   CD 0611'              	CALL	CUROFF
  0A05'   2B                    	DCX	H
  0A06'   01 0001               	LXI	B,1
  0A09'   3E 02                 	MVI	A,UR_DEL
  0A0B'   CD 0773'              	CALL	UNDCHG
  0A0E'   C3 0A20'              	JMP	UNDHX
                                
                                ;UNDUDF -- UNDELF's tail: the byte DELTO just made text again, at the cursor.
  0A11'                         UNDUDF:
  0A11'   F5                    	PUSH	PSW
  0A12'   C5                    	PUSH	B
  0A13'   D5                    	PUSH	D
  0A14'   E5                    	PUSH	H
  0A15'   CD 0611'              	CALL	CUROFF
  0A18'   01 0001               	LXI	B,1
  0A1B'   3E 01                 	MVI	A,UR_INS
  0A1D'   CD 0773'              	CALL	UNDCHG
                                ;UNDHX -- every hook leaves the primitive's own registers and flags alone.
  0A20'                         UNDHX:
  0A20'   E1                    	POP	H
  0A21'   D1                    	POP	D
  0A22'   C1                    	POP	B
  0A23'   F1                    	POP	PSW
  0A24'   C9                    	RET
                                
                                ;============================================================
                                ; DATA -- the (base,limit) pointer row (WM 6828-6871 layout) + scratch.
                                ; The disassembly's DB values for these cells are aliased code bytes; only the
                                ; order/adjacency is authoritative.  BINIT sets every cell at run time.
                                ;============================================================
  0A25'   0000                  BUFBEG: DW	0		; region-array base
  0A27'   0000                  QBEG:	DW	0		; ^Q scratch buffer begin
  0A29'   0000                  QEND:	DW	0		; ^Q scratch buffer end
  0A2B'   0000                  HOLEQP:	 DW	 0
  0A2D'   0000                  TXTBAS: DW	0		; text base = PBEGMEM+1 (past the 0 sentinel)
                                ;UBEG/UEND -- APPENDED: the undo region, a region of the arena like the Q
                                ;buffer, with UEND its insertion point.  It goes HERE, between the slider and
                                ;the text, so both of the row's interleaved walks stay aligned: the holes from
                                ;BUFBEG are (BUFBEG,QBEG) (QEND,HOLEQP) (TXTBAS,UBEG) (UEND,TXTBEG)
                                ;(GAPBEG,GAPEND) (TXTEND,BUFEND), and the data regions from QBEG are
                                ;(QBEG,QEND) (HOLEQP,TXTBAS) (UBEG,UEND) (TXTBEG,GAPBEG) (GAPEND,TXTEND).
                                ;NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN, PRSPAN and INIBAS's count are all
                                ;untouched by it; INIGAP empties it.
  0A2F'   0000                  UBEG:	DW	0		; undo region begin
  0A31'   0000                  UEND:	DW	0		; undo region end = its insertion point
  0A33'   0000                  TXTBEG: DW	0		; window start
  0A35'   0000                  GAPBEG: DW	0		; cursor / gap start
  0A37'   0000                  GAPEND: DW	0		; gap end / first char after cursor
  0A39'   0000                  TXTEND: DW	0		; window end
  0A3A'                         PRTERM	 EQU	 TXTEND+1	 ; NEXTPR terminator = high byte of TXTEND
  0A3B'   0000                  BUFEND: DW	0		; top of usable text RAM
  0A3C'                         MVGTOP	 EQU	 BUFEND+1	 ; MOVGAP upper bound = high byte of BUFEND
                                
  0A3D'   00                    ERRFLG: DB	0		; nonzero after ERRMSG fired (harness reads it)
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


                                
                                ;The search pattern, in WM's SRCHBUF layout (WM 6900): the length, then the
                                ;string, 0-terminated.  CMD.MAC fills it from the '/' line and passes DE =
                                ;SRCHST; FWDCNT reads the length from the byte below that, as WM does.
  0A3E'   1E                    SRCMAX: DB	SRMAX		; ... its capacity, so CMD.MAC cannot drift
  0A3F'   00                    SRCHBF: DB	0		; the pattern length
  0A40'                         SRCHST: DS	SRMAX+1		; the pattern, 0-terminated
                                
  0A5F'   0000                  L2756:	DW	0		; WM L2756 -- GOLINE's last target position
  0A61'   0000                  QCPDON: DW	0		; (appended) QCPYN: bytes already copied in
                                ;--- 'u' (undo): see the UNDO section above for how these are driven.
  0A63'   00                    UNDN:	DB	0		; steps captured (0 = nothing to undo)
  0A64'   00                    UNDST:	DB	0		; 0 none, 1 change applied ('u' undoes it),
                                				;   2 already undone ('u' puts it back)
  0A65'   00                    UNDBAD: DB	0		; 1 = this change was too big to capture
  0A66'   01                    UNDNEW: DB	1		; 1 = the next capture starts a new change
  0A67'   00                    UNDRPL: DB	0		; 1 = 'u' replaying, so nothing is captured
  0A68'   00                    UNDDIR: DB	0		; the replay's direction (0 forward, 1 inverse)
  0A69'   00                    UNDWHY: DB	0		; 0 = nothing to undo, 1 = it has paged away
  0A6A'   00                    UNDTY:	DB	0		; the step / record type being handled
  0A6B'   0000                  UNDOF:	DW	0		; ... its logical offset
  0A6D'   0000                  UNDLN:	DW	0		; ... its length
  0A6F'   0000                  UNDBO:	DW	0		; ... where its bytes lie in the region
  0A71'   0000                  UNDCL:	DW	0		; the length being captured (BC does not survive)
  0A73'   0000                  UNDLSA: DW	0		; the last record's address (UNDEXT's scratch)
  0A75'   0000                  UNDPG:	DW	0		; PGTOPM when this change was captured
  0A77'   0000                  UNDPTR: DW	0		; the region's write point, as an OFFSET
  0A79'   00                    UNDB1:	DB	0		; the byte going in (PRSPAN wants BC)
  0A7A'   0000                  UNDPCU: DW	0		; the cursor as the current command began
  0A7C'   0000                  UNDCUR: DW	0		; ... as the command that made THIS change began
                                
  0A7E'   0000                  LNDLT:	DW	0		; (appended) lines the cursor moved since the last
                                				;   screen layout (signed; SCRN.MAC consumes it)
                                
                                ;PBEGMEM -- base of the text arena: the first RAM byte past everything the
                                ;program holds.  The gap buffer's text lives from here up to BUFEND.  BUF
                                ;links last but RSV.MAC links after it, holding the reserve block in the RAM
                                ;immediately above the image (it emits no bytes of its own), so the arena
                                ;starts at RSVTOP -- past the reserves -- and is the size it always was.
  0A80'   0000*                 PBEGMEM:DW	RSVTOP
                                
  0A82'                         MEMBAS:				; top of the linked image (RSV.MAC's base)
                                
                                	END
