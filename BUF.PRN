                                ;MCPYR -- WM 5215: copy BC bytes [HL]->[DE] backward.  The loop is
                                ; DEVIATION 4 (see header), as in MEMCPY.
  0553'                         MCPYR:			      ; WM 5215
  0553'   CD 05BD'              	CALL	CKCOPY
