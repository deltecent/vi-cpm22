  04BB'   CD 05F8'              	CALL	LDPAIR
  04BE'   CD 05EC'              	CALL	SPANBC
  04C1'   E1                    	POP	H
  04C2'   D1                    	POP	D
  04C3'   C9                    	RET
                                
                                ;============================================================
                                ; AFTER-CURSOR READ -- WM.ASM 3989-4048 (RGET0, RGET, AFTOFF, RECOUNT), verbatim.
                                ; RPEEK/RPEEKX (WM 3995-4006) are not used and are left out.  WM's CALL GETKEY
                                ; in RGET is KBPOLL here (KEY.MAC owns the ring), as in GOLINE.
                                ;============================================================
                                
                                ;RGET0 -- WM 3989: HL = GAPEND, BC = bytes from there to TXTEND.
  04C4'                         RGET0:				; WM 3989
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  04C4'   CD 04B6'              	CALL	AFTLEN
  04C7'   CD 05FC'              	CALL	LDHLI
  04CA'   C9                    	RET
                                
                                ;RGET -- WM 4007: next char [HL++], BC--; when BC runs out, NEEDIN pages more
                                ;input in and BC is recounted.  CY at the end of the text.
  04CB'                         RGET:				; WM 4007
  04CB'   78                    	MOV	A,B
  04CC'   B1                    	ORA	C
  04CD'   C2 04E1'              	JNZ	RGETCH
  04D0'   CD 04E5'              	CALL	AFTOFF
  04D3'   E5                    	PUSH	H
  04D4'   CD 0000*              	CALL	NEEDIN
  04D7'   E1                    	POP	H
  04D8'   F5                    	PUSH	PSW
  04D9'   CD 0000*              	CALL	KBPOLL		; WM: CALL GETKEY
  04DC'   CD 04EF'              	CALL	RECOUNT
  04DF'   F1                    	POP	PSW
  04E0'   D8                    	RC
  04E1'                         RGETCH:				 ; WM 4021 -- return the next after-cursor char
  04E1'   7E                    	MOV	A,M
  04E2'   0B                    	DCX	B
  04E3'   23                    	INX	H
  04E4'   C9                    	RET
                                
                                ;AFTOFF -- WM 4028: HL = HL - GAPEND (survives the refill moving the text).
  04E5'                         AFTOFF:				; WM 4028
  04E5'   D5                    	PUSH	D
  04E6'   EB                    	XCHG
  04E7'   2A 0000*              	LHLD	GAPEND
  04EA'   CD 05E2'              	CALL	SUBDH
  04ED'   D1                    	POP	D
  04EE'   C9                    	RET
                                
                                ;RECOUNT -- WM 4037: HL = GAPEND + offset, BC = bytes left after a refill.
  04EF'                         RECOUNT:			; WM 4037
  04EF'   D5                    	PUSH	D
  04F0'   EB                    	XCHG
  04F1'   CD 04B6'              	CALL	AFTLEN
  04F4'   CD 05FC'              	CALL	LDHLI
  04F7'   19                    	DAD	D
  04F8'   79                    	MOV	A,C
  04F9'   93                    	SUB	E
  04FA'   4F                    	MOV	C,A
  04FB'   78                    	MOV	A,B
  04FC'   9A                    	SBB	D
  04FD'   47                    	MOV	B,A
  04FE'   D1                    	POP	D
  04FF'   C9                    	RET
                                
