  0590'   E5                    	PUSH	H
  0591'   CD 055B'              	CALL	SUBHD
  0594'   D1                    	POP	D
  0595'   37                    	STC
  0596'   C9                    	RET
                                
                                ;SUBCP2 -- WM 5365: HL := max(0, DE-HL); CY if positive.
  0597'                         SUBCP2:			       ; WM 5365
  0597'   CD 0579'              	CALL	CMP16
  059A'   CA 058B'              	JZ	SCLPZ
  059D'   DA 058B'              	JC	SCLPZ
  05A0'   EB                    	XCHG
  05A1'   CD 055B'              	CALL	SUBHD
  05A4'   37                    	STC
  05A5'   C9                    	RET
                                
                                
                                ;POPRET -- WM 5387: shared epilogue for the PUSH B/PUSH D/PUSH H prologue.
  05A6'                         POPRET:				; WM 5387
  05A6'   E1                    	POP	H
  05A7'   D1                    	POP	D
  05A8'   C1                    	POP	B
  05A9'   C9                    	RET
                                
                                ;============================================================
                                ; PAGESTP -- the count-limited scroll step.  The disk-eviction seam
                                ; (MKROOM/SPILL/SPILLB/PAGEBOT/REWIND), the deque marks (MARKGB/UPDMARK/RECBASE/
                                ; PTRREC) and the paging drivers (PAGEDIR/PGNEED/PAGEWIN) are all real in
                                ; PAGE.MAC, and CNTTST/CMDCNT/AUXCNT now exist in CMD.MAC.
                                ;============================================================
                                
                                ;PAGESTP -- WM 4311: page one step in the scroll direction, count-limited.
                                ;CNTTST returns Z when the command count (CMDCNT and AUXCNT) is exhausted, so a
                                ;completed edit or motion stops here (RZ); otherwise fall into PAGEDIR to page
                                ;the window one increment in the current scroll direction (DIRFLG: REWIND back,
                                ;FILLBUF forward).  In WM PAGESTP falls through to the physically adjacent
                                ;PAGEDIR; here PAGEDIR lives in PAGE.MAC, so the fall-through is an explicit
                                ;JMP -- same object behavior, PAGEDIR's own POLLBRK still runs.  DELTO's tail
                                ;JMPs here, so a delete made with the count spent returns at once; the count
                                ;loops (dd's QPUTLN, MVLLOOP's line moves, the search sweep through SCRLST)
                                ;are what page the window on past its edge.
                                ;SCRLST -- WM 4307: poll type-ahead, PUTCUR to HL, then (count not spent)
                                ;fall into PAGESTP to page the window one step in the DIRFLG direction.
  05AA'                         SCRLST:				; WM 4307
  05AA'   CD 0000*              	CALL	POLLBRK
  05AD'   CD 036E'              	CALL	PUTCUR
                                
  05B0'                         PAGESTP:			; WM 4311
  05B0'   CD 0000*              	CALL	CNTTST
  05B3'   C8                    	RZ
  05B4'   C3 0000*              	JMP	PAGEDIR
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


                                ; ERRMSG -- WM 664, message-print transcribed; TAIL adapted (see header):
                                ; print the inline 0-terminated message, set ERRFLG, warm-boot to CP/M.
                                ; The message is printed where ERRHK leaves the cursor: VI.MAC points it at the
                                ; screen teardown, so it lands on the bottom row with the terminal restored, as
                                ; a quit leaves it; a harness with no screen leaves it on a RET.  The work files
                                ; are dropped before the warm boot, as a quit drops them.  A second error from
                                ; inside either step ends here too: DISCRD clears its own flag before it
                                ; deletes, so it cannot run twice.
                                ;============================================================
  05B7'                         ERRMSG:				; WM 664 (tail adapted)
  05B7'   3E FF                 	MVI	A,0FFH
  05B9'   32 0000*              	STA	ERRFLG		; record that an error fired
  05BC'   2A 05DC'              	LHLD	ERRHK
  05BF'   CD 05DA'              	CALL	ERMGO		; the cursor to where the message belongs
  05C2'   E1                    	POP	H		; HL -> inline message (after the CALL)
  05C3'                         ERMLP:
  05C3'   7E                    	MOV	A,M
  05C4'   B7                    	ORA	A
  05C5'   CA 05D4'              	JZ	ERMEND
  05C8'   E5                    	PUSH	H
  05C9'   5F                    	MOV	E,A
  05CA'   0E 02                 	MVI	C,2		; BDOS console out
  05CC'   CD 0005               	CALL	BDOS
  05CF'   E1                    	POP	H
  05D0'   23                    	INX	H
  05D1'   C3 05C3'              	JMP	ERMLP
  05D4'                         ERMEND:
  05D4'   CD 0000*              	CALL	DISCRD		; no name.$$$ / VIBACKUP.$$$ left behind
  05D7'   C3 0000               	JMP	WBOOT		; adapted tail: back to CP/M
  05DA'   E9                    ERMGO:	PCHL
  05DB'   C9                    ERMNUL: RET
  05DC'   05DB'                 ERRHK:	DW	ERMNUL		; the screen's teardown, once there is a screen
                                
                                ;============================================================
                                ; LOGICAL-OFFSET API  (APPENDED -- NOT WordMaster).
                                ; The gap-agnostic view the vi layer (CMD.MAC) uses so it never touches the raw
                                ; pointer row.  A logical offset is a byte index into resident text as if the
                                ; gap were absent:
                                ;   before = GAPBEG - TXTBEG   (bytes before the cursor = cursor logical offset)
                                ;   after  = TXTEND - GAPEND   (bytes at/after the cursor)
                                ;   LOGLEN = before + after
                                ; Most of CMD.MAC's verbs work in these offsets alone; the rest drive WM's
                                ; pointer-based routines (PUTCUR, the line moves, RGET, the matchers, the
                                ; Q-buffer), which page as they go, and a few read the pointer row directly.
                                ;============================================================
                                
                                ;CUROFF -- HL = cursor logical offset (= before length).
  05DE'                         CUROFF:
  05DE'   2A 0000*              	LHLD	TXTBEG
  05E1'   EB                    	XCHG
  05E2'   2A 0000*              	LHLD	GAPBEG
  05E5'   CD 055B'              	CALL	SUBHD		; HL = GAPBEG - TXTBEG
  05E8'   C9                    	RET
                                
                                ;AFTLN2 -- HL = after length (TXTEND - GAPEND).  Private helper for LOGLEN.
  05E9'                         AFTLN2:
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  05E9'   2A 0000*              	LHLD	GAPEND
  05EC'   EB                    	XCHG
  05ED'   2A 0000*              	LHLD	TXTEND
  05F0'   CD 055B'              	CALL	SUBHD
  05F3'   C9                    	RET
                                
                                ;LOGLEN -- HL = total resident logical length.
  05F4'                         LOGLEN:
  05F4'   CD 05DE'              	CALL	CUROFF
  05F7'   E5                    	PUSH	H
  05F8'   CD 05E9'              	CALL	AFTLN2
  05FB'   D1                    	POP	D
  05FC'   19                    	DAD	D
  05FD'   C9                    	RET
                                
                                ;L2PHYS -- HL(off) -> HL(physical address).  0 <= off <= LOGLEN.  Private.
  05FE'                         L2PHYS:
  05FE'   EB                    	XCHG			; DE = off
  05FF'   D5                    	PUSH	D
  0600'   CD 05DE'              	CALL	CUROFF		; HL = before
  0603'   D1                    	POP	D		; DE = off
  0604'   CD 0579'              	CALL	CMP16		; DE=off vs HL=before: CY iff off < before
  0607'   DA 0614'              	JC	L2P_BEF
                                	;--- after region: phys = GAPEND + (off - before) ---
  060A'   EB                    	XCHG			; HL=off, DE=before
  060B'   CD 055B'              	CALL	SUBHD		; HL = off - before
  060E'   EB                    	XCHG			; DE = off-before
  060F'   2A 0000*              	LHLD	GAPEND
  0612'   19                    	DAD	D
  0613'   C9                    	RET
  0614'                         L2P_BEF:
                                	;--- before region: phys = TXTBEG + off  (DE = off, HL = before) ---
  0614'   2A 0000*              	LHLD	TXTBEG
  0617'   19                    	DAD	D
  0618'   C9                    	RET
                                
                                ;CHARAT -- HL(off) -> A = byte at that logical offset (off < LOGLEN).
  0619'                         CHARAT:
  0619'   CD 05FE'              	CALL	L2PHYS
  061C'   7E                    	MOV	A,M
  061D'   C9                    	RET
                                
                                ;CLAMPL -- HL(off) -> HL clamped to [0, LOGLEN].  Private helper for GOTO.
  061E'                         CLAMPL:
  061E'   E5                    	PUSH	H
  061F'   CD 05F4'              	CALL	LOGLEN
  0622'   D1                    	POP	D		; DE = off
  0623'   CD 0579'              	CALL	CMP16		; DE=off vs HL=LOGLEN
  0626'   DA 062D'              	JC	CLK_KEEP	; off < LOGLEN
  0629'   CA 062D'              	JZ	CLK_KEEP	; off == LOGLEN
  062C'   C9                    	RET			; off > LOGLEN -> HL = LOGLEN
  062D'                         CLK_KEEP:
  062D'   EB                    	XCHG			; HL = off
  062E'   C9                    	RET
                                
                                ;GOTO -- HL(off): move the cursor to that logical offset.
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


                                ;PUTCUR takes its target address in HL (its entry XCHG moves it to DE).
                                ;The line feeds the cursor crosses are added to LNDLT (subtracted going back).
  062F'                         GOTO:
  062F'   CD 061E'              	CALL	CLAMPL
  0632'   CD 05FE'              	CALL	L2PHYS		; HL = physical address
  0635'   E5                    	PUSH	H
  0636'   EB                    	XCHG			; DE = target
  0637'   2A 0000*              	LHLD	GAPEND
  063A'   CD 0579'              	CALL	CMP16		; CY iff target < GAPEND (before the gap)
  063D'   DA 064B'              	JC	GTO_BK
  0640'   EB                    	XCHG			; forward: count [GAPEND, target)
  0641'   CD 065F'              	CALL	LFCNT
  0644'   2A 0000*              	LHLD	LNDLT
  0647'   19                    	DAD	D
  0648'   C3 0657'              	JMP	GTO_ST
  064B'                         GTO_BK:
  064B'   2A 0000*              	LHLD	GAPBEG		; back: count [target, GAPBEG)
  064E'   CD 065F'              	CALL	LFCNT
  0651'   2A 0000*              	LHLD	LNDLT
  0654'   CD 055B'              	CALL	SUBHD
  0657'                         GTO_ST:
  0657'   22 0000*              	SHLD	LNDLT
  065A'   E1                    	POP	H
  065B'   CD 036E'              	CALL	PUTCUR
  065E'   C9                    	RET
                                
                                ;LFCNT -- DE = start, HL = end (>= start): DE = number of LFs in [start, end).
  065F'                         LFCNT:
  065F'   CD 055B'              	CALL	SUBHD		; HL = end - start
  0662'   44                    	MOV	B,H
  0663'   4D                    	MOV	C,L		; BC = length
  0664'   EB                    	XCHG			; HL = start
  0665'   11 0000               	LXI	D,0
  0668'                         LFC_LP:
  0668'   78                    	MOV	A,B
  0669'   B1                    	ORA	C
  066A'   C8                    	RZ
  066B'   7E                    	MOV	A,M
  066C'   23                    	INX	H
  066D'   0B                    	DCX	B
  066E'   FE 0A                 	CPI	LF
  0670'   C2 0668'              	JNZ	LFC_LP
  0673'   13                    	INX	D
  0674'   C3 0668'              	JMP	LFC_LP
                                
                                ;RDGET -- RGET, and CY also when a refill read nothing.  INRDY stays set after
                                ;a file's last full record (no ^Z) until a read fails; NEEDIN then returns NC
                                ;having added nothing, and RGET steps past TXTEND leaving BC = FFFFH.  That is
                                ;reported as the end of the text, with BC = 0 so a later call asks NEEDIN again.
  0677'                         RDGET:
  0677'   CD 04B9'              	CALL	RGET
  067A'   D8                    	RC
  067B'   F5                    	PUSH	PSW
  067C'   78                    	MOV	A,B
  067D'   A1                    	ANA	C
  067E'   3C                    	INR	A		; Z iff BC = FFFFH
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  067F'   CA 0684'              	JZ	RDG_EF
  0682'   F1                    	POP	PSW
  0683'   C9                    	RET
  0684'                         RDG_EF:
  0684'   F1                    	POP	PSW
  0685'   01 0000               	LXI	B,0
  0688'   37                    	STC
  0689'   C9                    	RET
                                
                                ;DELFWD -- HL = number of logical bytes to delete forward from the cursor.
  068A'                         DELFWD:
  068A'   7C                    	MOV	A,H
  068B'   B5                    	ORA	L
  068C'   C8                    	RZ			; nothing to delete
  068D'   CD 0AD3'              	CALL	UNDDLF		; (appended) the span, for 'u', before it goes
  0690'   EB                    	XCHG			; DE = count
  0691'   2A 0000*              	LHLD	GAPEND
  0694'   19                    	DAD	D		; target = GAPEND + count
  0695'   AF                    	XRA	A		; S clear -> forward delete
  0696'   CD 0207'              	CALL	DELTO
  0699'   C9                    	RET
                                
                                ;DELPRV -- WM 3260 RUBOUT/DELL: delete the char left of the cursor, and the
                                ;CR too when that leaves one there (a CR,LF goes as one).  PEEKLX pages back
                                ;at the window start and returns at the start of the file.  WM's MARKCUR and
                                ;ROWUP (its screen) are left out; instead a deleted LF moves the cursor up a
                                ;line (LNDLT - 1) for SCRN.MAC.
  069A'                         DELPRV:				; WM 3260
  069A'   CD 0200'              	CALL	PEEKLX
  069D'   FE 0A                 	CPI	LF
  069F'   C2 06AB'              	JNZ	DLP_GO
  06A2'   E5                    	PUSH	H
  06A3'   2A 0000*              	LHLD	LNDLT
  06A6'   2B                    	DCX	H
  06A7'   22 0000*              	SHLD	LNDLT
  06AA'   E1                    	POP	H
  06AB'                         DLP_GO:				; WM 3263 DELL
  06AB'   CD 0AF3'              	CALL	UNDDLP		; (appended) that byte, for 'u', before it goes
  06AE'   CD 0067'              	CALL	SETGAPB
  06B1'   CD 01F3'              	CALL	PEEKL
  06B4'   FE 0D                 	CPI	CR
  06B6'   CA 069A'              	JZ	DELPRV
  06B9'   C9                    	RET
                                
                                
                                ;UNDELF -- APPENDED, NOT WordMaster: give back the byte last swallowed forward
                                ;into the gap.  A forward delete only moves GAPEND past the byte, so the byte
                                ;itself is still there, inside the gap: GAPEND-1 through DELTO makes it text
                                ;again, with the record marks updated exactly as a delete updates them.
                                ;Replace mode ('R') puts back with it what it overwrote, as vim's BS in Replace
                                ;mode does.  The caller must know the gap has not moved since the delete
                                ;(CMD.MAC keeps GAPEND in RPGE for that); nothing else calls this.
  06BA'                         UNDELF:
  06BA'   2A 0000*              	LHLD	GAPEND
  06BD'   2B                    	DCX	H
  06BE'   AF                    	XRA	A		; S clear -> the forward (GAPEND) side
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  06BF'   CD 0207'              	CALL	DELTO
  06C2'   C3 0B06'              	JMP	UNDUDF		; (appended) the byte just made text again
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  APPENDED, NOT WordMaster: WM has no undo at all (its QBUFOP /
                                ; QEXEC macro is a command-LINE facility, not this).
                                ;
                                ; Six primitives change resident text, and each one says what it did: PUTGAP
                                ; (one byte in), QGET (the register in), DELFWD (a span out), DELPRV (one byte
                                ; out backward), UNDELF (one byte back in) and QPUTLN (whole lines out).
                                ; Nothing else in the editor reaches the text, so no command can forget to
                                ; record itself -- which is the whole reason the capture sits down here instead
                                ; of at CMD.MAC's edit sites.
                                ;
                                ; A record says only WHERE and HOW MUCH, in LOGICAL offsets, plus where its
                                ; bytes lie in the undo region.  Logical offsets survive the gap sliding (which
                                ; PUTCUR does on every cursor move) because the replay walks the records
                                ; BACKWARD: each step restores the offsets the steps after it were measured
                                ; against.  The bytes are kept for an insert as well as a delete -- an insert
                                ; costs its own text twice, which is nothing -- so the region is settled once
                                ; the command ends and 'u' can walk it either way: backward applying each
                                ; record's inverse to undo, forward applying the records as they stand to redo.
                                ; That is what makes 'u' undo 'u' with ONE region and no capture during the
                                ; replay.
                                ;
                                ; The region is a region of the arena like the Q buffer, inserted between the
                                ; slider and the text, and it grows through the same MKGAP: the pointer row
                                ; reads (UBEG,UEND) as data and (TXTBAS,UBEG) / (UEND,TXTBEG) as the holes
                                ; around it, so NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN and INIBAS all take it in
                                ; their stride unchanged.
                                ;
                                ; DEVIATIONS from vim, all deliberate and all in COMMANDS.md: ONE level of
                                ; undo, so 'u' undoes 'u' as real vi does; the change must still be in the
                                ; RESIDENT window, and 'u' refuses once the pager has moved off it rather than
                                ; chasing it through the file; and a change with more steps than the table
                                ; holds, or one the arena has no spare room to keep, is not undoable at all.
                                ;
                                ; "Moved off it" is PGTOPM, PAGE.MAC's count of the times the pager moved
                                ; TXTBEG.  It is the window's TOP that matters: an offset is measured from
                                ; TXTBEG, so spilling a record out from under it (PAGEOUT) or reading one back
                                ; in (REWIND) shifts every offset, while FILLBUF and PAGEBOT growing TXTEND at
                                ; the bottom shift none.  The OUTREC/SRCREC water marks look like the same
                                ; thing and are not: UPDMARK raises them on every edit.
                                ;============================================================
                                
  0001                          UR_INS	EQU	1		; text went IN  (undoing takes it back out)
  0002                          UR_DEL	EQU	2		; text came OUT (undoing puts it back)
  0007                          URSIZE	EQU	7		; type, offset(2), length(2), region offset(2)
  0018                          URMAX	EQU	24		; primitive steps one change may hold
                                ;How much of the arena the capture refuses to eat into.  It only has to keep
                                ;MKGAP off its MKROOM path (which wants 256 free), because paging is what undo
                                ;must not do -- so this is deliberately SMALL.  RESVMEM, QROOM's reserve, is
                                ;far too big: a 66 K file leaves under 1700 bytes free, and undo would never
                                ;engage at all on exactly the files that need it most.
  0200                          UNDRSV	EQU	200H		; ... 512 bytes
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


                                ;How much room the region claims up front, and so the largest change that can
                                ;be kept.  The claim is what lets the capture run without EVER growing the
                                ;region: see UNDGRW for why growing where a primitive can see it is unsafe.
  0400                          UNDCAP	EQU	400H		; 1024 bytes of change
                                
                                ;UNDBEG -- CMD.MAC's command boundary: the NEXT captured change starts a new
                                ;undo.  A flag only, so a command that changes nothing -- a motion, a yank, a
                                ;key that is no command at all -- leaves the last change undoable, exactly as
                                ;'.' keeps the last change it recorded.
  06C5'                         UNDBEG:
  06C5'   D5                    	PUSH	D
  06C6'   E5                    	PUSH	H
  06C7'   3E 01                 	MVI	A,1
  06C9'   32 0B1B'              	STA	UNDNEW
  06CC'   CD 05DE'              	CALL	CUROFF
  06CF'   22 0000*              	SHLD	UNDPCU		; where the cursor was as this command began --
  06D2'   CD 06E1'              	CALL	UNDGRW		;   kept pending, because only a command that
  06D5'   E1                    	POP	H		;   really changes text gets to claim it
  06D6'   D1                    	POP	D
  06D7'   C9                    	RET
                                
                                ;UNDHER -- the change about to start belongs at the CURSOR: 'u' puts it back
                                ;there.  UNDBEG's cursor snapshot without its claim on the region, for a
                                ;command (':s') that cannot know where its first change will be until it has
                                ;found it.  Calling UNDBEG again instead would re-run UNDGRW in the middle of
                                ;the command, which is the one thing UNDGRW must never do -- see below.
  06D8'                         UNDHER:
  06D8'   E5                    	PUSH	H
  06D9'   CD 05DE'              	CALL	CUROFF
  06DC'   22 0000*              	SHLD	UNDPCU
  06DF'   E1                    	POP	H
  06E0'   C9                    	RET
                                
                                ;UNDGRW -- make sure the region can take a whole change without growing again.
                                ;THE ONLY PLACE THE REGION GROWS, and it runs at the command boundary, where no
                                ;primitive is holding anything.  Growing moves regions about (MKGAP -> MOVGAP),
                                ;and that both invalidates a raw pointer a primitive is in the middle of using
                                ;-- DELPRV hands SETGAPB one -- and overwrites whatever is sitting in the gap,
                                ;which is where a forward-deleted byte waits for 'R's backspace to call UNDELF
                                ;and give it back.  So the room is claimed here, 256 bytes at a time, and the
                                ;capture below never calls MKGAP at all: it writes into the claim or gives up.
                                ;The room has to be claimed as the region's own CONTENT, not left as the hole
                                ;above it: the holes are shared, and the text takes whatever it can reach --
                                ;MOVGAP feeding an insert will walk straight through a hole reserved here, which
                                ;is what made a 200-character insert lose its undo halfway.  Once the bytes are
                                ;inside (UBEG,UEND) the text cannot have them: MOVGAP slides the region aside
                                ;instead.  Nothing here holds an address across MKGAP either, because MKGAP
                                ;slides this very region (HOLEUP moves UBEG and UEND) -- UEND is re-read from
                                ;its cell every time round.
  06E1'                         UNDGRW:
  06E1'   C5                    	PUSH	B
  06E2'   D5                    	PUSH	D
  06E3'   E5                    	PUSH	H
  06E4'                         UNDGRL:
  06E4'   21 0000*              	LXI	H,UBEG
  06E7'   CD 04A7'              	CALL	PRSPAN		; BC = the region's size
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  06EA'   50                    	MOV	D,B
  06EB'   59                    	MOV	E,C
  06EC'   21 0400               	LXI	H,UNDCAP
  06EF'   CD 0579'              	CALL	CMP16		; CY iff it is smaller than one change
  06F2'   D2 05A6'              	JNC	POPRET
  06F5'   CD 0878'              	CALL	UNDRM		; ... but never at the cost of paging
  06F8'   DA 05A6'              	JC	POPRET
  06FB'   21 0000*              	LXI	H,UEND
  06FE'   CD 00BC'              	CALL	MKGAP		; 256 free above the region ...
  0701'   2A 0000*              	LHLD	UEND
  0704'   11 0100               	LXI	D,100H
  0707'   19                    	DAD	D
  0708'   22 0000*              	SHLD	UEND		; ... taken into it, so the text cannot take
  070B'   C3 06E4'              	JMP	UNDGRL		;     them back
                                
                                ;UNDCLR -- nothing is undoable (a fresh buffer; BINIT calls it through INIGAP).
  070E'                         UNDCLR:
  070E'   AF                    	XRA	A
  070F'   32 0000*              	STA	UNDN
  0712'   32 0000*              	STA	UNDST
  0715'   32 0000*              	STA	UNDBAD
  0718'   3E 01                 	MVI	A,1
  071A'   32 0B1B'              	STA	UNDNEW
  071D'   C9                    	RET
                                
                                ;UNDRST -- the first capture of a new change: drop the last one and note where
                                ;the file window was, so 'u' can tell the pager has since moved off this change.
  071E'                         UNDRST:
  071E'   AF                    	XRA	A
  071F'   32 0B1B'              	STA	UNDNEW
  0722'   32 0000*              	STA	UNDN
  0725'   32 0000*              	STA	UNDBAD
  0728'   21 0000               	LXI	H,0
  072B'   22 0000*              	SHLD	UNDPTR		; the region's content empties (its SIZE stays:
                                				;   that is the room UNDGRW claimed)
  072E'   2A 0000*              	LHLD	PGTOPM
  0731'   22 0000*              	SHLD	UNDPG
  0734'   2A 0000*              	LHLD	UNDPCU
  0737'   22 0000*              	SHLD	UNDCUR		; ... and this command does change text, so this
                                				;   is where 'u' will put the cursor back
  073A'   3E 01                 	MVI	A,1
  073C'   32 0000*              	STA	UNDST		; a change is on the buffer: 'u' undoes it
  073F'   C9                    	RET
                                
                                ;UNDCHG -- the capture every hooked primitive uses.  A = UR_INS / UR_DEL,
                                ;HL = the logical offset it acted at, BC = how many bytes.  The bytes are read
                                ;back out of the resident TEXT at that offset -- for a delete before they go,
                                ;for an insert once they have arrived -- so no caller hands over a pointer that
                                ;growing the region could leave stale.
  0740'                         UNDCHG:
  0740'   C5                    	PUSH	B
  0741'   D5                    	PUSH	D
  0742'   E5                    	PUSH	H
  0743'   32 0000*              	STA	UNDTY		; the record type, kept out of the registers
  0746'   CD 07BE'              	CALL	EDTGO		; whoever else follows an edit (BC is kept)
  0749'   3A 0000*              	LDA	UNDRPL
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  074C'   B7                    	ORA	A
  074D'   C2 05A6'              	JNZ	POPRET		; 'u' replaying: its own edits are not a change
  0750'   3A 0B1B'              	LDA	UNDNEW
  0753'   B7                    	ORA	A
  0754'   CA 075A'              	JZ	UNDC1
  0757'   CD 071E'              	CALL	UNDRST		; the first step of a new change
  075A'                         UNDC1:
  075A'   3A 0000*              	LDA	UNDBAD
  075D'   B7                    	ORA	A
  075E'   C2 05A6'              	JNZ	POPRET		; this change has already been given up on
  0761'   78                    	MOV	A,B
  0762'   B1                    	ORA	C
  0763'   CA 05A6'              	JZ	POPRET		; a zero-length step is no step
  0766'   60                    	MOV	H,B
  0767'   69                    	MOV	L,C
  0768'   22 0000*              	SHLD	UNDCL		; UNDAPT spends BC as its countdown, so the
                                				;   length has to be kept somewhere else
  076B'   3A 0000*              	LDA	UNDN
  076E'   FE 18                 	CPI	URMAX
  0770'   D2 07B6'              	JNC	UNDCBD		; no room for another step
                                	;--- where this step's bytes will land in the region ---
  0773'   2A 0000*              	LHLD	UNDPTR
  0776'   22 0000*              	SHLD	UNDBO
  0779'   E1                    	POP	H
  077A'   E5                    	PUSH	H		; HL = the logical offset again
  077B'   CD 082E'              	CALL	UNDAPT		; BC bytes of the text there -> the region
  077E'   DA 07B6'              	JC	UNDCBD
                                	;--- fold it into the last record when it only carries that one on ---
  0781'   E1                    	POP	H
  0782'   E5                    	PUSH	H
  0783'   CD 07D6'              	CALL	UNDEXT
  0786'   CA 05A6'              	JZ	POPRET
                                	;--- otherwise a record of its own ---
  0789'   3A 0000*              	LDA	UNDN
  078C'   CD 07C6'              	CALL	URADDR
  078F'   3A 0000*              	LDA	UNDTY
  0792'   77                    	MOV	M,A
  0793'   23                    	INX	H
  0794'   D1                    	POP	D
  0795'   D5                    	PUSH	D		; DE = the logical offset
  0796'   73                    	MOV	M,E
  0797'   23                    	INX	H
  0798'   72                    	MOV	M,D
  0799'   23                    	INX	H
  079A'   EB                    	XCHG			; DE = the record, past the offset
  079B'   2A 0000*              	LHLD	UNDCL
  079E'   EB                    	XCHG			; ... and HL back, with DE = the length
  079F'   73                    	MOV	M,E
  07A0'   23                    	INX	H
  07A1'   72                    	MOV	M,D
  07A2'   23                    	INX	H
  07A3'   3A 0000*              	LDA	UNDBO
  07A6'   77                    	MOV	M,A
  07A7'   23                    	INX	H
  07A8'   3A 0001*              	LDA	UNDBO+1
  07AB'   77                    	MOV	M,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  07AC'   3A 0000*              	LDA	UNDN
  07AF'   3C                    	INR	A
  07B0'   32 0000*              	STA	UNDN
  07B3'   C3 05A6'              	JMP	POPRET
  07B6'                         UNDCBD:
  07B6'   3E 01                 	MVI	A,1
  07B8'   32 0000*              	STA	UNDBAD		; too big to keep: not undoable at all
  07BB'   C3 05A6'              	JMP	POPRET
                                
                                ;EDTGO -- UNDCHG is the one place every change to the text goes by, the
                                ;replay's own included, so it is also where the editor hears of one: EDTHK is
                                ;called with A = UR_INS / UR_DEL, HL = the logical offset and BC = the length,
                                ;and must keep BC.  VI.MAC points it at the marks; a harness leaves it a RET.
  07BE'                         EDTGO:
  07BE'   E5                    	PUSH	H
  07BF'   2A 07C4'              	LHLD	EDTHK
  07C2'   E3                    	XTHL
  07C3'   C9                    	RET
  07C4'   05DB'                 EDTHK:	DW	ERMNUL
                                
                                ;URADDR -- A = a record index -> HL = its address (base + n*8 - n).
  07C6'                         URADDR:
  07C6'   6F                    	MOV	L,A
  07C7'   26 00                 	MVI	H,0
  07C9'   5D                    	MOV	E,L
  07CA'   54                    	MOV	D,H
  07CB'   29                    	DAD	H
  07CC'   29                    	DAD	H
  07CD'   29                    	DAD	H		; HL = n*8
  07CE'   CD 055B'              	CALL	SUBHD		; HL = n*7
  07D1'   11 0000*              	LXI	D,UNDREC
  07D4'   19                    	DAD	D
  07D5'   C9                    	RET
                                
                                ;UNDEXT -- A = 0 (Z) when this step only carries the last record on: an insert
                                ;starting exactly where the last insert ended, which is what typing does.  Its
                                ;bytes already sit contiguously behind that record's, so only the length grows.
                                ;HL = this step's offset, BC = its length.
  07D6'                         UNDEXT:
  07D6'   C5                    	PUSH	B
  07D7'   D5                    	PUSH	D
  07D8'   E5                    	PUSH	H
  07D9'   3A 0000*              	LDA	UNDTY
  07DC'   FE 01                 	CPI	UR_INS
  07DE'   C2 0828'              	JNZ	UNDXNO		; only inserts fold
  07E1'   3A 0000*              	LDA	UNDN
  07E4'   B7                    	ORA	A
  07E5'   CA 0828'              	JZ	UNDXNO		; nothing to fold into
  07E8'   3D                    	DCR	A
  07E9'   CD 07C6'              	CALL	URADDR
  07EC'   22 0000*              	SHLD	UNDLSA
  07EF'   7E                    	MOV	A,M
  07F0'   FE 01                 	CPI	UR_INS
  07F2'   C2 0828'              	JNZ	UNDXNO
  07F5'   2A 0000*              	LHLD	UNDLSA
  07F8'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  07F9'   CD 0574'              	CALL	LDHLI		; HL = the last record's offset
  07FC'   EB                    	XCHG
  07FD'   2A 0000*              	LHLD	UNDLSA
  0800'   23                    	INX	H
  0801'   23                    	INX	H
  0802'   23                    	INX	H
  0803'   CD 0574'              	CALL	LDHLI		; HL = its length
  0806'   19                    	DAD	D		; HL = where it ends
  0807'   EB                    	XCHG
  0808'   E1                    	POP	H
  0809'   E5                    	PUSH	H		; HL = this step's offset
  080A'   CD 0579'              	CALL	CMP16		; Z iff this step starts exactly there
  080D'   C2 0828'              	JNZ	UNDXNO
  0810'   2A 0000*              	LHLD	UNDLSA
  0813'   23                    	INX	H
  0814'   23                    	INX	H
  0815'   23                    	INX	H
  0816'   E5                    	PUSH	H
  0817'   CD 0574'              	CALL	LDHLI		; HL = the last record's length
  081A'   EB                    	XCHG
  081B'   2A 0000*              	LHLD	UNDCL
  081E'   19                    	DAD	D		; ... grown by this step's
  081F'   EB                    	XCHG
  0820'   E1                    	POP	H
  0821'   73                    	MOV	M,E
  0822'   23                    	INX	H
  0823'   72                    	MOV	M,D
  0824'   AF                    	XRA	A		; Z: folded, no new record
  0825'   C3 05A6'              	JMP	POPRET
  0828'                         UNDXNO:
  0828'   3E 01                 	MVI	A,1
  082A'   B7                    	ORA	A		; NZ: it needs a record of its own
  082B'   C3 05A6'              	JMP	POPRET
                                
                                ;UNDAPT -- append BC bytes of resident text, from logical offset HL, to the
                                ;undo region.  One byte at a time, re-reading the offset through CHARAT and the
                                ;region through its pointer cell every time, so growing the region (which
                                ;slides regions about) can never leave this loop holding a stale address.
                                ;CY if it outgrows the claim, and the caller then gives the change up.
  082E'                         UNDAPT:
  082E'   78                    	MOV	A,B
  082F'   B1                    	ORA	C
  0830'   C8                    	RZ			; nothing to append
  0831'                         UNDAPL:
  0831'   C5                    	PUSH	B
  0832'   E5                    	PUSH	H
  0833'   CD 0619'              	CALL	CHARAT		; A = the text byte at this offset
  0836'   CD 0844'              	CALL	UNDAPB		; ... into the region
  0839'   E1                    	POP	H
  083A'   C1                    	POP	B
  083B'   D8                    	RC
  083C'   23                    	INX	H
  083D'   0B                    	DCX	B
  083E'   78                    	MOV	A,B
  083F'   B1                    	ORA	C
  0840'   C2 0831'              	JNZ	UNDAPL
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0843'   C9                    	RET
                                
                                ;UNDAPB -- put the byte in A into the room UNDGRW claimed.  It does NOT grow
                                ;the region -- see UNDGRW -- so CY, and the change given up on, once the room
                                ;is used up: a change bigger than the region is simply not undoable.
  0844'                         UNDAPB:
  0844'   C5                    	PUSH	B
  0845'   D5                    	PUSH	D
  0846'   E5                    	PUSH	H
  0847'   32 0000*              	STA	UNDB1
  084A'   21 0000*              	LXI	H,UBEG
  084D'   CD 04A7'              	CALL	PRSPAN		; BC = the region's size
  0850'   2A 0000*              	LHLD	UNDPTR
  0853'   EB                    	XCHG			; DE = where the next byte goes
  0854'   60                    	MOV	H,B
  0855'   69                    	MOV	L,C
  0856'   CD 0579'              	CALL	CMP16		; CY iff that is still inside the region
  0859'   D2 086F'              	JNC	UNDAPF
  085C'   2A 0000*              	LHLD	UBEG		; re-read: a relocation moves the region
  085F'   19                    	DAD	D
  0860'   3A 0000*              	LDA	UNDB1
  0863'   77                    	MOV	M,A
  0864'   2A 0000*              	LHLD	UNDPTR
  0867'   23                    	INX	H
  0868'   22 0000*              	SHLD	UNDPTR
  086B'   B7                    	ORA	A		; CY clear: it went in
  086C'   C3 05A6'              	JMP	POPRET
  086F'                         UNDAPF:
  086F'   3E 01                 	MVI	A,1
  0871'   32 0000*              	STA	UNDBAD
  0874'   37                    	STC
  0875'   C3 05A6'              	JMP	POPRET
                                
                                ;UNDRM -- CY, and the change given up on, unless the arena still holds UNDRSV
                                ;free.  The capture must never page: paging moves the window off the change and
                                ;would invalidate every logical offset the records hold.  Keeping this much
                                ;free also keeps MKGAP off its MKROOM path, so the capture cannot page even by
                                ;accident, and it fails QUIETLY where QROOM raises 'QBUF FULL' -- undo going
                                ;away must never stop the editing.
  0878'                         UNDRM:
  0878'   C5                    	PUSH	B
  0879'   D5                    	PUSH	D
  087A'   E5                    	PUSH	H
  087B'   CD 0441'              	CALL	BUFSUM		; DE = the arena's free bytes
  087E'   21 0200               	LXI	H,UNDRSV
  0881'   CD 0579'              	CALL	CMP16		; CY iff less than that is left
  0884'   D2 05A6'              	JNC	POPRET
  0887'   3E 01                 	MVI	A,1
  0889'   32 0000*              	STA	UNDBAD
  088C'   37                    	STC
  088D'   C3 05A6'              	JMP	POPRET
                                
                                ;---------------------------------------------------------------- the replay
                                
                                ;UNDO -- 'u'.  CY when there is nothing to undo: no change captured, a change
                                ;too big to have been captured, or the pager has moved the window off it.
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0890'                         UNDO:
  0890'   AF                    	XRA	A
  0891'   32 0000*              	STA	UNDWHY		; refused for want of a change, until told else
  0894'   3A 0000*              	LDA	UNDBAD		; asked BEFORE the count of records: a change
  0897'   B7                    	ORA	A		;   too big from its very first step leaves
  0898'   CA 08A2'              	JZ	UND_OK		;   none, and is still not 'nothing to undo'
  089B'   3E 02                 	MVI	A,2
  089D'   32 0000*              	STA	UNDWHY		; too big to have been captured: CMD.MAC says
  08A0'   37                    	STC			;   so, rather than ringing the bell at a user
  08A1'   C9                    	RET			;   who has no way to know why
  08A2'                         UND_OK:
  08A2'   3A 0000*              	LDA	UNDN
  08A5'   B7                    	ORA	A
  08A6'   37                    	STC
  08A7'   C8                    	RZ			; nothing captured
  08A8'   2A 0000*              	LHLD	PGTOPM
  08AB'   EB                    	XCHG
  08AC'   2A 0000*              	LHLD	UNDPG
  08AF'   CD 0579'              	CALL	CMP16
  08B2'   C2 08E5'              	JNZ	UNDPGD		; the pager has moved the window's top since,
                                				;   so every offset the records hold has shifted
  08B5'   3E FF                 	MVI	A,0FFH
  08B7'   32 0000*              	STA	UNDML		; (no step taken yet)
  08BA'   AF                    	XRA	A
  08BB'   32 0000*              	STA	UNDLK
  08BE'   32 0000*              	STA	UNDLC
  08C1'   3E 01                 	MVI	A,1
  08C3'   32 0000*              	STA	UNDRPL		; the replay's own edits are not a new change
  08C6'   3A 0000*              	LDA	UNDST
  08C9'   FE 01                 	CPI	1
  08CB'   CA 08EC'              	JZ	UNDREV
                                	;--- the last 'u' undid it: apply the records forward again (a redo) ---
  08CE'   AF                    	XRA	A
  08CF'   32 0000*              	STA	UNDDIR
  08D2'   AF                    	XRA	A
  08D3'                         UNDFWL:
  08D3'   CD 090D'              	CALL	URSTEP
  08D6'   3C                    	INR	A
  08D7'   47                    	MOV	B,A
  08D8'   3A 0000*              	LDA	UNDN
  08DB'   B8                    	CMP	B
  08DC'   78                    	MOV	A,B
  08DD'   C2 08D3'              	JNZ	UNDFWL
  08E0'   3E 01                 	MVI	A,1
  08E2'   C3 08FE'              	JMP	UNDFIN
  08E5'                         UNDPGD:
  08E5'   3E 01                 	MVI	A,1
  08E7'   32 0000*              	STA	UNDWHY		; the change is no longer in the window
  08EA'   37                    	STC
  08EB'   C9                    	RET
  08EC'                         UNDREV:
                                	;--- undo: the records backward, each one's inverse ---
  08EC'   3E 01                 	MVI	A,1
  08EE'   32 0000*              	STA	UNDDIR
  08F1'   3A 0000*              	LDA	UNDN
  08F4'                         UNDRVL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  08F4'   3D                    	DCR	A
  08F5'   CD 090D'              	CALL	URSTEP
  08F8'   B7                    	ORA	A
  08F9'   C2 08F4'              	JNZ	UNDRVL
  08FC'   3E 02                 	MVI	A,2
  08FE'                         UNDFIN:
  08FE'   32 0000*              	STA	UNDST
  0901'   AF                    	XRA	A
  0902'   32 0000*              	STA	UNDRPL
                                	;--- the cursor goes back where the command that changed it began:
                                	;    measured from vim, which restores that and not the change's own
                                	;    offset (CMD.MAC's VC_UNDO holds it inside the line) ---
  0905'   2A 0000*              	LHLD	UNDCUR
  0908'   CD 062F'              	CALL	GOTO
  090B'   B7                    	ORA	A		; CY clear: it happened
  090C'   C9                    	RET
                                
                                ;URSTEP -- apply record A: as it stands when UNDDIR is 0 (a redo), inverted
                                ;when it is 1 (an undo).  An insert applied puts its saved bytes back at its
                                ;offset; an insert inverted deletes that many bytes there; a delete is the
                                ;mirror of both.  A is preserved -- UNDO's loops count with it.
  090D'                         URSTEP:
  090D'   F5                    	PUSH	PSW
  090E'   CD 07C6'              	CALL	URADDR
  0911'   7E                    	MOV	A,M
  0912'   32 0000*              	STA	UNDTY
  0915'   23                    	INX	H
  0916'   7E                    	MOV	A,M
  0917'   32 0000*              	STA	UNDOF
  091A'   23                    	INX	H
  091B'   7E                    	MOV	A,M
  091C'   32 0001*              	STA	UNDOF+1
  091F'   23                    	INX	H
  0920'   7E                    	MOV	A,M
  0921'   32 0000*              	STA	UNDLN
  0924'   23                    	INX	H
  0925'   7E                    	MOV	A,M
  0926'   32 0001*              	STA	UNDLN+1
  0929'   23                    	INX	H
  092A'   7E                    	MOV	A,M
  092B'   32 0000*              	STA	UNDBO
  092E'   23                    	INX	H
  092F'   7E                    	MOV	A,M
  0930'   32 0001*              	STA	UNDBO+1
  0933'   2A 0000*              	LHLD	UNDBO		; a line end among its bytes: more than one
  0936'   EB                    	XCHG			;   line changes (UNDML: CMD.MAC picks the
  0937'   2A 0000*              	LHLD	UBEG		;   repaint by it)
  093A'   19                    	DAD	D
  093B'   EB                    	XCHG
  093C'   2A 0000*              	LHLD	UNDLN
  093F'   19                    	DAD	D
  0940'   CD 065F'              	CALL	LFCNT
  0943'   7A                    	MOV	A,D
  0944'   B3                    	ORA	E
  0945'   CA 094D'              	JZ	URS_1L
  0948'   3E 01                 	MVI	A,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  094A'   32 0000*              	STA	UNDML
  094D'                         URS_1L:
  094D'   3A 0000*              	LDA	UNDTY
  0950'   47                    	MOV	B,A
  0951'   3A 0000*              	LDA	UNDDIR
  0954'   B7                    	ORA	A
  0955'   CA 0961'              	JZ	URS_AP
  0958'   78                    	MOV	A,B		; an undo inverts the record
  0959'   FE 01                 	CPI	UR_INS
  095B'   CA 0967'              	JZ	URS_DL
  095E'   C3 0977'              	JMP	URS_IN
  0961'                         URS_AP:
  0961'   78                    	MOV	A,B		; a redo applies it as it stands
  0962'   FE 01                 	CPI	UR_INS
  0964'   CA 0977'              	JZ	URS_IN
  0967'                         URS_DL:
                                	;--- take the record's length back out at its offset ---
  0967'   CD 09A9'              	CALL	URGOTO
  096A'   3E 02                 	MVI	A,2
  096C'   CD 09CF'              	CALL	URLNQ
  096F'   2A 0000*              	LHLD	UNDLN
  0972'   CD 068A'              	CALL	DELFWD
  0975'   F1                    	POP	PSW
  0976'   C9                    	RET
  0977'                         URS_IN:
                                	;--- put the record's saved bytes back in at its offset ---
  0977'   CD 09A9'              	CALL	URGOTO
  097A'   3E 01                 	MVI	A,1
  097C'   CD 09CF'              	CALL	URLNQ
  097F'   2A 0000*              	LHLD	UNDLN
  0982'   44                    	MOV	B,H
  0983'   4D                    	MOV	C,L
  0984'   2A 0000*              	LHLD	UNDBO
  0987'                         URSILP:
  0987'   C5                    	PUSH	B
  0988'   E5                    	PUSH	H
  0989'   EB                    	XCHG			; DE = the byte's offset within the region
  098A'   2A 0000*              	LHLD	UBEG		; ... re-read every byte: inserting text can
  098D'   19                    	DAD	D		;     slide the region out from under it
  098E'   7E                    	MOV	A,M
  098F'   CD 0054'              	CALL	PUTGAP
  0992'   FE 0A                 	CPI	LF
  0994'   C2 099E'              	JNZ	URSILN
  0997'   2A 0000*              	LHLD	LNDLT		; a line end put back is the cursor crossing
  099A'   23                    	INX	H		;   one, and GOTO keeps LNDLT for every move the
  099B'   22 0000*              	SHLD	LNDLT		;   replay makes -- so the renderer needs no
  099E'                         URSILN:				;   whole-window rescan to find that out
  099E'   E1                    	POP	H
  099F'   C1                    	POP	B
  09A0'   23                    	INX	H
  09A1'   0B                    	DCX	B
  09A2'   78                    	MOV	A,B
  09A3'   B1                    	ORA	C
  09A4'   C2 0987'              	JNZ	URSILP
  09A7'   F1                    	POP	PSW
  09A8'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


                                
                                ;URGOTO -- the cursor to the record's offset.  The line the first step is on
                                ;is the change's (UNDL0 = LNDLT there, which GOTO keeps up); a later step on
                                ;another line makes the change more than one line's (UNDML).
  09A9'                         URGOTO:
  09A9'   2A 0000*              	LHLD	UNDOF
  09AC'   CD 062F'              	CALL	GOTO
  09AF'   2A 0000*              	LHLD	LNDLT
  09B2'   EB                    	XCHG
  09B3'   3A 0000*              	LDA	UNDML
  09B6'   3C                    	INR	A
  09B7'   C2 09C2'              	JNZ	URG_1
  09BA'   32 0000*              	STA	UNDML		; (0: one line, so far)
  09BD'   EB                    	XCHG
  09BE'   22 0000*              	SHLD	UNDL0
  09C1'   C9                    	RET
  09C2'                         URG_1:
  09C2'   2A 0000*              	LHLD	UNDL0
  09C5'   CD 0579'              	CALL	CMP16
  09C8'   C8                    	RZ
  09C9'   3E 01                 	MVI	A,1
  09CB'   32 0000*              	STA	UNDML
  09CE'   C9                    	RET
                                
                                ;URLNQ -- the step about to be taken at the cursor puts the record's bytes in
                                ;(A = 1) or takes them out (A = 2).  UNDLK stays that for as long as every
                                ;step does the same, with whole lines -- it starts at a line's start and the
                                ;bytes end in a line end -- and at the place the first one did (UNDLL0 =
                                ;LNDLT there); UNDLC counts the lines.  Anything else and UNDLK is 0FFH.
                                ;Two more ways of taking a whole line out are known for what they are: steps
                                ;at one line's start that end with a line only when the last has gone (UNDLK
                                ;is 3 until then), and one step from a line's END that takes its line end and
                                ;the next line's text -- the line under it, so UNDLL0 is that line's.
                                ;CMD.MAC opens the rows for lines put back, or closes them up, by these.
  09CF'                         URLNQ:
  09CF'   47                    	MOV	B,A
  09D0'   3A 0000*              	LDA	UNDLK
  09D3'   B7                    	ORA	A
  09D4'   CA 09F1'              	JZ	URL_1
  09D7'   F6 01                 	ORI	1		; (2 and 3 are both lines going)
  09D9'   4F                    	MOV	C,A
  09DA'   78                    	MOV	A,B
  09DB'   F6 01                 	ORI	1
  09DD'   B9                    	CMP	C
  09DE'   C2 0AA1'              	JNZ	URL_NO
  09E1'   2A 0000*              	LHLD	UNDLL0
  09E4'   EB                    	XCHG
  09E5'   2A 0000*              	LHLD	LNDLT
  09E8'   CD 0579'              	CALL	CMP16
  09EB'   C2 0AA1'              	JNZ	URL_NO
  09EE'   C3 09F7'              	JMP	URL_2
  09F1'                         URL_1:
  09F1'   2A 0000*              	LHLD	LNDLT
  09F4'   22 0000*              	SHLD	UNDLL0
  09F7'                         URL_2:
  09F7'   CD 05DE'              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  09FA'   7C                    	MOV	A,H
  09FB'   B5                    	ORA	L
  09FC'   CA 0A50'              	JZ	URL_3
  09FF'   2A 0000*              	LHLD	GAPBEG
  0A02'   2B                    	DCX	H
  0A03'   7E                    	MOV	A,M
  0A04'   FE 0A                 	CPI	LF
  0A06'   CA 0A50'              	JZ	URL_3
                                	;--- not at a line's start.  One step that takes out a line end and
                                	;    what follows it as far as the next ('o' and what was typed) is
                                	;    the line under that one going, all the same: UNDLL0 as for it ---
  0A09'   78                    	MOV	A,B
  0A0A'   FE 02                 	CPI	2
  0A0C'   C2 0AA1'              	JNZ	URL_NO
  0A0F'   3A 0000*              	LDA	UNDLK
  0A12'   B7                    	ORA	A
  0A13'   C2 0AA1'              	JNZ	URL_NO
  0A16'   2A 0000*              	LHLD	UNDBO
  0A19'   EB                    	XCHG
  0A1A'   2A 0000*              	LHLD	UBEG
  0A1D'   19                    	DAD	D
  0A1E'   7E                    	MOV	A,M
  0A1F'   FE 0D                 	CPI	CR
  0A21'   CA 0A29'              	JZ	URL_B0
  0A24'   FE 0A                 	CPI	LF
  0A26'   C2 0AA1'              	JNZ	URL_NO
  0A29'                         URL_B0:
  0A29'   2A 0000*              	LHLD	UNDLN
  0A2C'   EB                    	XCHG
  0A2D'   2A 0000*              	LHLD	GAPEND
  0A30'   19                    	DAD	D
  0A31'   EB                    	XCHG			; DE = the text after what goes
  0A32'   2A 0000*              	LHLD	TXTEND
  0A35'   CD 0579'              	CALL	CMP16
  0A38'   D2 0A46'              	JNC	URL_B1		; (the end of the text)
  0A3B'   1A                    	LDAX	D
  0A3C'   FE 0D                 	CPI	CR
  0A3E'   CA 0A46'              	JZ	URL_B1
  0A41'   FE 0A                 	CPI	LF
  0A43'   C2 0AA1'              	JNZ	URL_NO
  0A46'                         URL_B1:
  0A46'   2A 0000*              	LHLD	UNDLL0
  0A49'   23                    	INX	H
  0A4A'   22 0000*              	SHLD	UNDLL0
  0A4D'   C3 0A70'              	JMP	URL_4
  0A50'                         URL_3:
  0A50'   2A 0000*              	LHLD	UNDLN
  0A53'   7C                    	MOV	A,H
  0A54'   B5                    	ORA	L
  0A55'   CA 0AA1'              	JZ	URL_NO
  0A58'   EB                    	XCHG
  0A59'   2A 0000*              	LHLD	UNDBO
  0A5C'   19                    	DAD	D
  0A5D'   EB                    	XCHG
  0A5E'   2A 0000*              	LHLD	UBEG
  0A61'   19                    	DAD	D		; HL = past the record's bytes
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0A62'   2B                    	DCX	H
  0A63'   7E                    	MOV	A,M
  0A64'   FE 0A                 	CPI	LF
  0A66'   CA 0A70'              	JZ	URL_4
  0A69'   78                    	MOV	A,B		; steps that take text out at one place take
  0A6A'   FE 02                 	CPI	2		;   what is there each time, so it is the last
  0A6C'   C2 0AA1'              	JNZ	URL_NO		;   of them that has to end with a line: 3
  0A6F'   04                    	INR	B		;   until it does ('O': the text typed goes,
  0A70'                         URL_4:				;   then the line end before it)
  0A70'   2A 0000*              	LHLD	UNDLN
  0A73'   EB                    	XCHG
  0A74'   2A 0000*              	LHLD	UNDBO
  0A77'   19                    	DAD	D
  0A78'   EB                    	XCHG
  0A79'   2A 0000*              	LHLD	UBEG
  0A7C'   19                    	DAD	D
  0A7D'   E5                    	PUSH	H
  0A7E'   2A 0000*              	LHLD	UNDBO
  0A81'   EB                    	XCHG
  0A82'   2A 0000*              	LHLD	UBEG
  0A85'   19                    	DAD	D
  0A86'   EB                    	XCHG			; DE = their start
  0A87'   E1                    	POP	H
  0A88'   C5                    	PUSH	B
  0A89'   CD 065F'              	CALL	LFCNT
  0A8C'   C1                    	POP	B
  0A8D'   7A                    	MOV	A,D
  0A8E'   B7                    	ORA	A
  0A8F'   C2 0AA1'              	JNZ	URL_NO
  0A92'   3A 0000*              	LDA	UNDLC
  0A95'   83                    	ADD	E
  0A96'   DA 0AA1'              	JC	URL_NO
  0A99'   32 0000*              	STA	UNDLC
  0A9C'   78                    	MOV	A,B
  0A9D'   32 0000*              	STA	UNDLK
  0AA0'   C9                    	RET
  0AA1'                         URL_NO:
  0AA1'   3E FF                 	MVI	A,0FFH
  0AA3'   32 0000*              	STA	UNDLK
  0AA6'   C9                    	RET
                                
                                ;---------------------------------------------------------------- the hooks
                                
                                ;UNDPUT -- PUTGAP's tail: the one byte now sitting just below the cursor.
  0AA7'                         UNDPUT:
  0AA7'   F5                    	PUSH	PSW
  0AA8'   C5                    	PUSH	B
  0AA9'   D5                    	PUSH	D
  0AAA'   E5                    	PUSH	H
  0AAB'   CD 05DE'              	CALL	CUROFF
  0AAE'   2B                    	DCX	H
  0AAF'   01 0001               	LXI	B,1
  0AB2'   3E 01                 	MVI	A,UR_INS
  0AB4'   CD 0740'              	CALL	UNDCHG
  0AB7'   C3 0B15'              	JMP	UNDHX
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


                                ;UNDGET -- QGET's tail: BC bytes of register now in, the cursor past them.
                                ;UNDINS is the same entry by its general name: INSBLK itself carries NO hook
                                ;(insert mode records a byte at a time through PUTGAP), so a command that
                                ;splices a block in -- ':s' replacing a match -- has to say so itself, exactly
                                ;as QGET does.  Without it 'u' puts the deleted text back and leaves the
                                ;inserted text there ('a-a-a' undid to 'aZ-aZ-aZ').
  0ABA'                         UNDINS:
  0ABA'                         UNDGET:
  0ABA'   F5                    	PUSH	PSW
  0ABB'   C5                    	PUSH	B
  0ABC'   D5                    	PUSH	D
  0ABD'   E5                    	PUSH	H
  0ABE'   78                    	MOV	A,B
  0ABF'   B1                    	ORA	C
  0AC0'   CA 0B15'              	JZ	UNDHX
  0AC3'   CD 05DE'              	CALL	CUROFF
  0AC6'   50                    	MOV	D,B
  0AC7'   59                    	MOV	E,C
  0AC8'   CD 055B'              	CALL	SUBHD		; HL = where the put began
  0ACB'   3E 01                 	MVI	A,UR_INS
  0ACD'   CD 0740'              	CALL	UNDCHG
  0AD0'   C3 0B15'              	JMP	UNDHX
                                
                                ;UNDDLF -- DELFWD's head: HL bytes about to go forward from the cursor.
  0AD3'                         UNDDLF:
  0AD3'   F5                    	PUSH	PSW
  0AD4'   C5                    	PUSH	B
  0AD5'   D5                    	PUSH	D
  0AD6'   E5                    	PUSH	H
  0AD7'   44                    	MOV	B,H
  0AD8'   4D                    	MOV	C,L
  0AD9'   CD 05DE'              	CALL	CUROFF
  0ADC'   3E 02                 	MVI	A,UR_DEL
  0ADE'   CD 0740'              	CALL	UNDCHG
  0AE1'   C3 0B15'              	JMP	UNDHX
                                
                                ;UNDDLQ -- QPUTLN's head: BC bytes of whole lines about to go into the register.
  0AE4'                         UNDDLQ:
  0AE4'   F5                    	PUSH	PSW
  0AE5'   C5                    	PUSH	B
  0AE6'   D5                    	PUSH	D
  0AE7'   E5                    	PUSH	H
  0AE8'   CD 05DE'              	CALL	CUROFF
  0AEB'   3E 02                 	MVI	A,UR_DEL
  0AED'   CD 0740'              	CALL	UNDCHG
  0AF0'   C3 0B15'              	JMP	UNDHX
                                
                                ;UNDDLP -- DELPRV's head: the one byte just below the cursor, about to go.
  0AF3'                         UNDDLP:
  0AF3'   F5                    	PUSH	PSW
  0AF4'   C5                    	PUSH	B
  0AF5'   D5                    	PUSH	D
  0AF6'   E5                    	PUSH	H
  0AF7'   CD 05DE'              	CALL	CUROFF
  0AFA'   2B                    	DCX	H
  0AFB'   01 0001               	LXI	B,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0AFE'   3E 02                 	MVI	A,UR_DEL
  0B00'   CD 0740'              	CALL	UNDCHG
  0B03'   C3 0B15'              	JMP	UNDHX
                                
                                ;UNDUDF -- UNDELF's tail: the byte DELTO just made text again, at the cursor.
  0B06'                         UNDUDF:
  0B06'   F5                    	PUSH	PSW
  0B07'   C5                    	PUSH	B
  0B08'   D5                    	PUSH	D
  0B09'   E5                    	PUSH	H
  0B0A'   CD 05DE'              	CALL	CUROFF
  0B0D'   01 0001               	LXI	B,1
  0B10'   3E 01                 	MVI	A,UR_INS
  0B12'   CD 0740'              	CALL	UNDCHG
                                ;UNDHX -- every hook leaves the primitive's own registers and flags alone.
  0B15'                         UNDHX:
  0B15'   E1                    	POP	H
  0B16'   D1                    	POP	D
  0B17'   C1                    	POP	B
  0B18'   F1                    	POP	PSW
  0B19'   C9                    	RET
                                
                                ;============================================================
                                ; DATA -- what the image carries: the cells that start at something.
                                ;============================================================
                                ;The cells that start at zero are not in the image: RSV.MAC names them, in
                                ;the RAM just above it, and BUF.MAC's ZINIT clears them before anything runs.
                                ;Their order there is the order they had here, and code depends on it.
                                ;WM's (base,limit) pointer row, the search pattern and 'u''s state are there.
                                	EXTRN	BUFBEG, QBEG, QEND, HOLEQP, TXTBAS, UBEG
                                	EXTRN	UEND, TXTBEG, GAPBEG, GAPEND, TXTEND, PRTERM
                                	EXTRN	BUFEND, MVGTOP, ERRFLG, SRCHBF, SRCHST, L2756
                                	EXTRN	QCPDON, UNDN, UNDST, UNDBAD, UNDRPL, UNDDIR
                                	EXTRN	UNDWHY, UNDTY, UNDOF, UNDLN, UNDBO, UNDCL
                                	EXTRN	UNDLSA, UNDPG, UNDPTR, UNDB1, UNDPCU, UNDCUR
                                	EXTRN	UNDLK, UNDLC, UNDLL0, UNDML, UNDL0, LNDLT
                                
  0B1A'   1E                    SRCMAX: DB	SRMAX		; SRCHST's capacity, so CMD.MAC cannot drift
  0B1B'   01                    UNDNEW: DB	1		; 'u': 1 = the next capture starts a new change
                                
                                ;PBEGMEM -- base of the text arena: the first RAM byte past everything the
                                ;program holds.  The gap buffer's text lives from here up to BUFEND.  BUF
                                ;links last but RSV.MAC links after it, holding the reserve block in the RAM
                                ;immediately above the image (it emits no bytes of its own), so the arena
                                ;starts at RSVTOP -- past the reserves -- and is the size it always was.
  0B1C'   0000*                 PBEGMEM:DW	RSVTOP
                                
  0B1E'                         MEMBAS:				; top of the linked image (RSV.MAC's base)
                                
                                	END
