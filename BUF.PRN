  0586'   2B                    	DCX	H
  0587'   1B                    	DCX	D
  0588'   7E                    	MOV	A,M
  0589'   12                    	STAX	D
  058A'   2B                    	DCX	H
  058B'   1B                    	DCX	D
  058C'   7E                    	MOV	A,M
  058D'   12                    	STAX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  058E'                         MCPRCT:
  058E'   0D                    	DCR	C
  058F'   C2 056E'              	JNZ	MCPRBO
  0592'   05                    	DCR	B
  0593'   C2 056B'              	JNZ	MCPRKB
  0596'   C9                    	RET
                                
                                ;BCDIV8 -- DEVIATION 4: BC := BC / 8, for a BC whose low three bits are 0;
                                ; Z if that is 0.  Each byte is rotated right three times: C's low bits are
                                ; 0, so it is exact; B's go to its top, and from there to the top of C.
  0597'                         BCDIV8:
  0597'   79                    	MOV	A,C
  0598'   0F                    	RRC
  0599'   0F                    	RRC
  059A'   0F                    	RRC
  059B'   4F                    	MOV	C,A
  059C'   78                    	MOV	A,B
  059D'   0F                    	RRC
  059E'   0F                    	RRC
  059F'   0F                    	RRC
  05A0'   47                    	MOV	B,A
  05A1'   E6 E0                 	ANI	0E0H
  05A3'   B1                    	ORA	C
  05A4'   4F                    	MOV	C,A
  05A5'   78                    	MOV	A,B
  05A6'   E6 1F                 	ANI	1FH
  05A8'   47                    	MOV	B,A
  05A9'   B1                    	ORA	C
  05AA'   C9                    	RET
                                
                                ;CKCOPY -- WM 5249: copy-length sanity guard ('COPY ERR').
  05AB'                         CKCOPY:				; WM 5249
  05AB'   78                    	MOV	A,B
  05AC'   F6 17                 	ORI	17H
  05AE'   3C                    	INR	A
  05AF'   C0                    	RNZ
  05B0'   CD 062D'              	CALL	ERRMSG
  05B3'   43 4F 50 59           	DB	'COPY ERR',0H
  05B7'   20 45 52 52           
  05BB'   00                    
                                
                                ;NEGHL -- WM 5258: HL := -HL.
  05BC'                         NEGHL:				; WM 5258
  05BC'   F5                    	PUSH	PSW
  05BD'   AF                    	XRA	A
  05BE'   95                    	SUB	L
  05BF'   6F                    	MOV	L,A
  05C0'   3E 00                 	MVI	A,0H
  05C2'   9C                    	SBB	H
  05C3'   67                    	MOV	H,A
  05C4'   F1                    	POP	PSW
  05C5'   C9                    	RET
                                
                                ;NEGBC -- WM 5270: BC := -BC.
  05C6'                         NEGBC:				; WM 5270
  05C6'   F5                    	PUSH	PSW
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  05C7'   AF                    	XRA	A
  05C8'   91                    	SUB	C
  05C9'   4F                    	MOV	C,A
  05CA'   3E 00                 	MVI	A,0H
  05CC'   98                    	SBB	B
  05CD'   47                    	MOV	B,A
  05CE'   F1                    	POP	PSW
  05CF'   C9                    	RET
                                
                                ;SUBDH -- WM 5282: HL := DE - HL.  SUBHD -- WM 5286: HL := HL - DE.
  05D0'                         SUBDH:				; WM 5282
  05D0'   EB                    	XCHG
  05D1'                         SUBHD:				; WM 5286
  05D1'   D5                    	PUSH	D
  05D2'   EB                    	XCHG
  05D3'   CD 05BC'              	CALL	NEGHL
  05D6'   EB                    	XCHG
  05D7'   19                    	DAD	D
  05D8'   D1                    	POP	D
  05D9'   C9                    	RET
                                
                                ;SPANBC -- WM 5296: BC := HL - DE (HL kept; Z if zero).
  05DA'                         SPANBC:				; WM 5296
  05DA'   E5                    	PUSH	H
  05DB'   CD 05D1'              	CALL	SUBHD
  05DE'   44                    	MOV	B,H
  05DF'   4D                    	MOV	C,L
  05E0'   E1                    	POP	H
  05E1'   78                    	MOV	A,B
  05E2'   B1                    	ORA	C
  05E3'   C9                    	RET
                                
                                ;LDPAI2/LDPAIR -- WM 5307/5312: load a (base,limit) pair into DE,HL.
                                ;NOTE: LDPAIR falls through into LDHLI (no RET) -- DE := base, HL := limit.
  05E4'                         LDPAI2:			       ; WM 5307
  05E4'   2B                    	DCX	H
  05E5'   2B                    	DCX	H
  05E6'                         LDPAIR:				; WM 5312
  05E6'   5E                    	MOV	E,M
  05E7'   23                    	INX	H
  05E8'   56                    	MOV	D,M
  05E9'   23                    	INX	H
                                ;LDHLI -- WM 5320: HL := word@HL.
  05EA'                         LDHLI:				; WM 5320
  05EA'   7E                    	MOV	A,M
  05EB'   23                    	INX	H
  05EC'   66                    	MOV	H,M
  05ED'   6F                    	MOV	L,A
  05EE'   C9                    	RET
                                
                                ;CMP16 -- WM 5333: 16-bit unsigned compare DE against HL (D-H, then E-L).
                                ;A preserved; only flags returned.  CY iff DE < HL; Z iff DE == HL.
  05EF'                         CMP16:				; WM 5333
  05EF'   C5                    	PUSH	B
  05F0'   47                    	MOV	B,A
  05F1'   7A                    	MOV	A,D
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  05F2'   94                    	SUB	H
  05F3'   C2 05F8'              	JNZ	CMPLOW
  05F6'   7B                    	MOV	A,E
  05F7'   95                    	SUB	L
  05F8'                         CMPLOW:				 ; WM 5342
  05F8'   78                    	MOV	A,B
  05F9'   C1                    	POP	B
  05FA'   C9                    	RET
                                
                                ;SUBCLP -- WM 5348: HL := max(0, HL-DE); CY if positive.
  05FB'                         SUBCLP:				; WM 5348
  05FB'   CD 05EF'              	CALL	CMP16
  05FE'   DA 0606'              	JC	SCLPPO
  0601'                         SCLPZ:				; WM 5352
  0601'   21 0000               	LXI	H,0H
  0604'   B7                    	ORA	A
  0605'   C9                    	RET
  0606'                         SCLPPO:				 ; WM 5357
  0606'   E5                    	PUSH	H
  0607'   CD 05D1'              	CALL	SUBHD
  060A'   D1                    	POP	D
  060B'   37                    	STC
  060C'   C9                    	RET
                                
                                ;SUBCP2 -- WM 5365: HL := max(0, DE-HL); CY if positive.
  060D'                         SUBCP2:			       ; WM 5365
  060D'   CD 05EF'              	CALL	CMP16
  0610'   CA 0601'              	JZ	SCLPZ
  0613'   DA 0601'              	JC	SCLPZ
  0616'   EB                    	XCHG
  0617'   CD 05D1'              	CALL	SUBHD
  061A'   37                    	STC
  061B'   C9                    	RET
                                
                                
                                ;POPRET -- WM 5387: shared epilogue for the PUSH B/PUSH D/PUSH H prologue.
  061C'                         POPRET:				; WM 5387
  061C'   E1                    	POP	H
  061D'   D1                    	POP	D
  061E'   C1                    	POP	B
  061F'   C9                    	RET
                                
                                ;============================================================
                                ; PAGESTP -- the count-limited scroll step.  The disk-eviction seam
                                ; (MKROOM/SPILL/SPILLB/PAGEBOT/REWIND), the deque marks (MARKGB/UPDMARK/RECBASE/
                                ; PTRREC) and the paging drivers (PAGEDIR/PGNEED/PAGEWIN) are all real in
                                ; PAGE.MAC, and CNTTST/CMDCNT/AUXCNT now exist in CMD.MAC.
                                ;============================================================
                                
                                ;PAGESTP -- WM 4311: page one step in the scroll direction, count-limited.
                                ;CNTTST returns Z when the command count (CMDCNT and AUXCNT) is exhausted, so a
                                ;completed edit or motion stops here (RZ); otherwise fall into PAGEDIR to page
                                ;the window one increment in the current scroll direction (DIRFLG: REWIND back,
                                ;FILLBUF forward).  In WM PAGESTP falls through to the physically adjacent
                                ;PAGEDIR; here PAGEDIR lives in PAGE.MAC, so the fall-through is an explicit
                                ;JMP -- same object behavior, PAGEDIR's own POLLBRK still runs.  DELTO's tail
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


                                ;JMPs here, so a delete made with the count spent returns at once; the count
                                ;loops (dd's QPUTLN, MVLLOOP's line moves, the search sweep through SCRLST)
                                ;are what page the window on past its edge.
                                ;SCRLST -- WM 4307: poll type-ahead, PUTCUR to HL, then (count not spent)
                                ;fall into PAGESTP to page the window one step in the DIRFLG direction.
  0620'                         SCRLST:				; WM 4307
  0620'   CD 0000*              	CALL	POLLBRK
  0623'   CD 036E'              	CALL	PUTCUR
                                
  0626'                         PAGESTP:			; WM 4311
  0626'   CD 0000*              	CALL	CNTTST
  0629'   C8                    	RZ
  062A'   C3 0000*              	JMP	PAGEDIR
                                
                                ;============================================================
                                ; ERRMSG -- WM 664, message-print transcribed; TAIL adapted (see header):
                                ; print the inline 0-terminated message, set ERRFLG, warm-boot to CP/M.
                                ; The message is printed where ERRHK leaves the cursor: VI.MAC points it at the
                                ; screen teardown, so it lands on the bottom row with the terminal restored, as
                                ; a quit leaves it; a harness with no screen leaves it on a RET.  The work files
                                ; are dropped before the warm boot, as a quit drops them.  A second error from
                                ; inside either step ends here too: DISCRD clears its own flag before it
                                ; deletes, so it cannot run twice.
                                ;============================================================
  062D'                         ERRMSG:				; WM 664 (tail adapted)
  062D'   3E FF                 	MVI	A,0FFH
  062F'   32 0000*              	STA	ERRFLG		; record that an error fired
  0632'   2A 0652'              	LHLD	ERRHK
  0635'   CD 0650'              	CALL	ERMGO		; the cursor to where the message belongs
  0638'   E1                    	POP	H		; HL -> inline message (after the CALL)
  0639'                         ERMLP:
  0639'   7E                    	MOV	A,M
  063A'   B7                    	ORA	A
  063B'   CA 064A'              	JZ	ERMEND
  063E'   E5                    	PUSH	H
  063F'   5F                    	MOV	E,A
  0640'   0E 02                 	MVI	C,2		; BDOS console out
  0642'   CD 0005               	CALL	BDOS
  0645'   E1                    	POP	H
  0646'   23                    	INX	H
  0647'   C3 0639'              	JMP	ERMLP
  064A'                         ERMEND:
  064A'   CD 0000*              	CALL	DISCRD		; no name.$$$ / VIBACKUP.$$$ left behind
  064D'   C3 0000               	JMP	WBOOT		; adapted tail: back to CP/M
  0650'   E9                    ERMGO:	PCHL
  0651'   C9                    ERMNUL: RET
  0652'   0651'                 ERRHK:	DW	ERMNUL		; the screen's teardown, once there is a screen
                                
                                ;MEMERR -- DEVIATION 3 (see header): the arena has no room for what the key
                                ;asked.  Called as ERRMSG is, the message inline after the CALL, and goes on
                                ;through MEMHK with the stack as it found it, so whatever MEMHK names reads the
                                ;message where ERRMSG would.  MEMHK is ERRMSG until the editor is up.
  0654'                         MEMERR:
  0654'   2A 0658'              	LHLD	MEMHK
  0657'   E9                    	PCHL
  0658'   062D'                 MEMHK:	DW	ERRMSG		; VI.MAC points it at CMD.MAC's MEMABT
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


                                
                                ;============================================================
                                ; LOGICAL-OFFSET API  (APPENDED -- NOT WordMaster).
                                ; The gap-agnostic view the vi layer (CMD.MAC) uses so it never touches the raw
                                ; pointer row.  A logical offset is a byte index into resident text as if the
                                ; gap were absent:
                                ;   before = GAPBEG - TXTBEG   (bytes before the cursor = cursor logical offset)
                                ;   after  = TXTEND - GAPEND   (bytes at/after the cursor)
                                ;   LOGLEN = before + after
                                ; Most of CMD.MAC's verbs work in these offsets alone; the rest drive WM's
                                ; pointer-based routines (PUTCUR, the line moves, RGET, the matchers, the
                                ; Q-buffer), which page as they go, and a few read the pointer row directly.
                                ;============================================================
                                
                                ;CUROFF -- HL = cursor logical offset (= before length).
  065A'                         CUROFF:
  065A'   2A 0000*              	LHLD	TXTBEG
  065D'   EB                    	XCHG
  065E'   2A 0000*              	LHLD	GAPBEG
  0661'   CD 05D1'              	CALL	SUBHD		; HL = GAPBEG - TXTBEG
  0664'   C9                    	RET
                                
                                ;AFTLN2 -- HL = after length (TXTEND - GAPEND).  Private helper for LOGLEN.
  0665'                         AFTLN2:
  0665'   2A 0000*              	LHLD	GAPEND
  0668'   EB                    	XCHG
  0669'   2A 0000*              	LHLD	TXTEND
  066C'   CD 05D1'              	CALL	SUBHD
  066F'   C9                    	RET
                                
                                ;LOGLEN -- HL = total resident logical length.
  0670'                         LOGLEN:
  0670'   CD 065A'              	CALL	CUROFF
  0673'   E5                    	PUSH	H
  0674'   CD 0665'              	CALL	AFTLN2
  0677'   D1                    	POP	D
  0678'   19                    	DAD	D
  0679'   C9                    	RET
                                
                                ;L2PHYS -- HL(off) -> HL(physical address).  0 <= off <= LOGLEN.  Private.
  067A'                         L2PHYS:
  067A'   EB                    	XCHG			; DE = off
  067B'   D5                    	PUSH	D
  067C'   CD 065A'              	CALL	CUROFF		; HL = before
  067F'   D1                    	POP	D		; DE = off
  0680'   CD 05EF'              	CALL	CMP16		; DE=off vs HL=before: CY iff off < before
  0683'   DA 0690'              	JC	L2P_BEF
                                	;--- after region: phys = GAPEND + (off - before) ---
  0686'   EB                    	XCHG			; HL=off, DE=before
  0687'   CD 05D1'              	CALL	SUBHD		; HL = off - before
  068A'   EB                    	XCHG			; DE = off-before
  068B'   2A 0000*              	LHLD	GAPEND
  068E'   19                    	DAD	D
  068F'   C9                    	RET
  0690'                         L2P_BEF:
                                	;--- before region: phys = TXTBEG + off  (DE = off, HL = before) ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  0690'   2A 0000*              	LHLD	TXTBEG
  0693'   19                    	DAD	D
  0694'   C9                    	RET
                                
                                ;CHARAT -- HL(off) -> A = byte at that logical offset (off < LOGLEN).
  0695'                         CHARAT:
  0695'   CD 067A'              	CALL	L2PHYS
  0698'   7E                    	MOV	A,M
  0699'   C9                    	RET
                                
                                ;CLAMPL -- HL(off) -> HL clamped to [0, LOGLEN].  Private helper for GOTO.
  069A'                         CLAMPL:
  069A'   E5                    	PUSH	H
  069B'   CD 0670'              	CALL	LOGLEN
  069E'   D1                    	POP	D		; DE = off
  069F'   CD 05EF'              	CALL	CMP16		; DE=off vs HL=LOGLEN
  06A2'   DA 06A9'              	JC	CLK_KEEP	; off < LOGLEN
  06A5'   CA 06A9'              	JZ	CLK_KEEP	; off == LOGLEN
  06A8'   C9                    	RET			; off > LOGLEN -> HL = LOGLEN
  06A9'                         CLK_KEEP:
  06A9'   EB                    	XCHG			; HL = off
  06AA'   C9                    	RET
                                
                                ;GOTO -- HL(off): move the cursor to that logical offset.
                                ;PUTCUR takes its target address in HL (its entry XCHG moves it to DE).
                                ;The line feeds the cursor crosses are added to LNDLT (subtracted going back).
  06AB'                         GOTO:
  06AB'   CD 069A'              	CALL	CLAMPL
  06AE'   CD 067A'              	CALL	L2PHYS		; HL = physical address
  06B1'   E5                    	PUSH	H
  06B2'   EB                    	XCHG			; DE = target
  06B3'   2A 0000*              	LHLD	GAPEND
  06B6'   CD 05EF'              	CALL	CMP16		; CY iff target < GAPEND (before the gap)
  06B9'   DA 06C7'              	JC	GTO_BK
  06BC'   EB                    	XCHG			; forward: count [GAPEND, target)
  06BD'   CD 06DB'              	CALL	LFCNT
  06C0'   2A 0000*              	LHLD	LNDLT
  06C3'   19                    	DAD	D
  06C4'   C3 06D3'              	JMP	GTO_ST
  06C7'                         GTO_BK:
  06C7'   2A 0000*              	LHLD	GAPBEG		; back: count [target, GAPBEG)
  06CA'   CD 06DB'              	CALL	LFCNT
  06CD'   2A 0000*              	LHLD	LNDLT
  06D0'   CD 05D1'              	CALL	SUBHD
  06D3'                         GTO_ST:
  06D3'   22 0000*              	SHLD	LNDLT
  06D6'   E1                    	POP	H
  06D7'   CD 036E'              	CALL	PUTCUR
  06DA'   C9                    	RET
                                
                                ;LFCNT -- DE = start, HL = end (>= start): DE = number of LFs in [start, end).
                                ;Clobbers BC.  KBPOLL every 256 bytes: a span can be the whole window (#40).
  06DB'                         LFCNT:
  06DB'   CD 05D1'              	CALL	SUBHD		; HL = end - start
  06DE'   44                    	MOV	B,H
  06DF'   4D                    	MOV	C,L		; BC = length
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  06E0'   EB                    	XCHG			; HL = start
  06E1'   11 0000               	LXI	D,0
  06E4'   04                    	INR	B
  06E5'   0C                    	INR	C
  06E6'   C3 06F1'              	JMP	LFC_CT
  06E9'                         LFC_LP:
  06E9'   7E                    	MOV	A,M
  06EA'   23                    	INX	H
  06EB'   FE 0A                 	CPI	LF
  06ED'   C2 06F1'              	JNZ	LFC_CT
  06F0'   13                    	INX	D
  06F1'                         LFC_CT:
  06F1'   0D                    	DCR	C
  06F2'   C2 06E9'              	JNZ	LFC_LP
  06F5'   05                    	DCR	B
  06F6'   C8                    	RZ
  06F7'   CD 0000*              	CALL	KBPOLL		; 256 bytes counted
  06FA'   C3 06E9'              	JMP	LFC_LP
                                
                                ;RDGET -- RGET, and CY also when a refill read nothing.  INRDY stays set after
                                ;a file's last full record (no ^Z) until a read fails; NEEDIN then returns NC
                                ;having added nothing, and RGET steps past TXTEND leaving BC = FFFFH.  That is
                                ;reported as the end of the text, with BC = 0 so a later call asks NEEDIN again.
  06FD'                         RDGET:
  06FD'   CD 04B9'              	CALL	RGET
  0700'   D8                    	RC
  0701'   F5                    	PUSH	PSW
  0702'   78                    	MOV	A,B
  0703'   A1                    	ANA	C
  0704'   3C                    	INR	A		; Z iff BC = FFFFH
  0705'   CA 070A'              	JZ	RDG_EF
  0708'   F1                    	POP	PSW
  0709'   C9                    	RET
  070A'                         RDG_EF:
  070A'   F1                    	POP	PSW
  070B'   01 0000               	LXI	B,0
  070E'   37                    	STC
  070F'   C9                    	RET
                                
                                ;DELFWD -- HL = number of logical bytes to delete forward from the cursor.
  0710'                         DELFWD:
  0710'   7C                    	MOV	A,H
  0711'   B5                    	ORA	L
  0712'   C8                    	RZ			; nothing to delete
  0713'   CD 0B9A'              	CALL	UNDDLF		; (appended) the span, for 'u', before it goes
  0716'   EB                    	XCHG			; DE = count
  0717'   2A 0000*              	LHLD	GAPEND
  071A'   19                    	DAD	D		; target = GAPEND + count
  071B'   AF                    	XRA	A		; S clear -> forward delete
  071C'   CD 0207'              	CALL	DELTO
  071F'   C9                    	RET
                                
                                ;DELPRV -- WM 3260 RUBOUT/DELL: delete the char left of the cursor, and the
                                ;CR too when that leaves one there (a CR,LF goes as one).  PEEKLX pages back
                                ;at the window start and returns at the start of the file.  WM's MARKCUR and
                                ;ROWUP (its screen) are left out; instead a deleted LF moves the cursor up a
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


                                ;line (LNDLT - 1) for SCRN.MAC.
  0720'                         DELPRV:				; WM 3260
  0720'   CD 0200'              	CALL	PEEKLX
  0723'   FE 0A                 	CPI	LF
  0725'   C2 0731'              	JNZ	DLP_GO
  0728'   E5                    	PUSH	H
  0729'   2A 0000*              	LHLD	LNDLT
  072C'   2B                    	DCX	H
  072D'   22 0000*              	SHLD	LNDLT
  0730'   E1                    	POP	H
  0731'                         DLP_GO:				; WM 3263 DELL
  0731'   CD 0BBA'              	CALL	UNDDLP		; (appended) that byte, for 'u', before it goes
  0734'   CD 0067'              	CALL	SETGAPB
  0737'   CD 01F3'              	CALL	PEEKL
  073A'   FE 0D                 	CPI	CR
  073C'   CA 0720'              	JZ	DELPRV
  073F'   C9                    	RET
                                
                                
                                ;UNDELF -- APPENDED, NOT WordMaster: give back the byte last swallowed forward
                                ;into the gap.  A forward delete only moves GAPEND past the byte, so the byte
                                ;itself is still there, inside the gap: GAPEND-1 through DELTO makes it text
                                ;again, with the record marks updated exactly as a delete updates them.
                                ;Replace mode ('R') puts back with it what it overwrote, as vim's BS in Replace
                                ;mode does.  The caller must know the gap has not moved since the delete
                                ;(CMD.MAC keeps GAPEND in RPGE for that); nothing else calls this.
  0740'                         UNDELF:
  0740'   2A 0000*              	LHLD	GAPEND
  0743'   2B                    	DCX	H
  0744'   AF                    	XRA	A		; S clear -> the forward (GAPEND) side
  0745'   CD 0207'              	CALL	DELTO
  0748'   C3 0BCD'              	JMP	UNDUDF		; (appended) the byte just made text again
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  APPENDED, NOT WordMaster: WM has no undo at all (its QBUFOP /
                                ; QEXEC macro is a command-LINE facility, not this).
                                ;
                                ; Six primitives change resident text, and each one says what it did: PUTGAP
                                ; (one byte in), QGET (the register in), DELFWD (a span out), DELPRV (one byte
                                ; out backward), UNDELF (one byte back in) and QPUTLN (whole lines out).
                                ; Nothing else in the editor reaches the text, so no command can forget to
                                ; record itself -- which is the whole reason the capture sits down here instead
                                ; of at CMD.MAC's edit sites.
                                ;
                                ; A record says only WHERE and HOW MUCH, in LOGICAL offsets, plus where its
                                ; bytes lie in the undo region.  Logical offsets survive the gap sliding (which
                                ; PUTCUR does on every cursor move) because the replay walks the records
                                ; BACKWARD: each step restores the offsets the steps after it were measured
                                ; against.  The bytes are kept for an insert as well as a delete -- an insert
                                ; costs its own text twice, which is nothing -- so the region is settled once
                                ; the command ends and 'u' can walk it either way: backward applying each
                                ; record's inverse to undo, forward applying the records as they stand to redo.
                                ; That is what makes 'u' undo 'u' with ONE region and no capture during the
                                ; replay.
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


                                ; The region is a region of the arena like the Q buffer, inserted between the
                                ; slider and the text, and it grows through the same MKGAP: the pointer row
                                ; reads (UBEG,UEND) as data and (TXTBAS,UBEG) / (UEND,TXTBEG) as the holes
                                ; around it, so NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN and INIBAS all take it in
                                ; their stride unchanged.
                                ;
                                ; DEVIATIONS from vim, all deliberate and all in COMMANDS.md: ONE level of
                                ; undo, so 'u' undoes 'u' as real vi does; the change must still be in the
                                ; RESIDENT window, and 'u' refuses once the pager has moved off it rather than
                                ; chasing it through the file; and a change with more steps than the table
                                ; holds, or one the arena has no spare room to keep, is not undoable at all.
                                ;
                                ; "Moved off it" is PGTOPM, PAGE.MAC's count of the times the pager moved
                                ; TXTBEG.  It is the window's TOP that matters: an offset is measured from
                                ; TXTBEG, so spilling a record out from under it (PAGEOUT) or reading one back
                                ; in (REWIND) shifts every offset, while FILLBUF and PAGEBOT growing TXTEND at
                                ; the bottom shift none.  The OUTREC/SRCREC water marks look like the same
                                ; thing and are not: UPDMARK moves them on every edit (OUTREC down,
                                ; SRCREC up).
                                ;============================================================
                                
  0001                          UR_INS	EQU	1		; text went IN  (undoing takes it back out)
  0002                          UR_DEL	EQU	2		; text came OUT (undoing puts it back)
  0007                          URSIZE	EQU	7		; type, offset(2), length(2), region offset(2)
  0018                          URMAX	EQU	24		; primitive steps one change may hold
                                ;How much of the arena the capture refuses to eat into.  It only has to keep
                                ;MKGAP off its MKROOM path (which wants 256 free), because paging is what undo
                                ;must not do -- so this is deliberately SMALL.  RESVMEM, QROOM's reserve, is
                                ;far too big: a 66 K file leaves under 1700 bytes free, and undo would never
                                ;engage at all on exactly the files that need it most.
  0200                          UNDRSV	EQU	200H		; ... 512 bytes
                                ;How much room the region claims up front, and so the largest change that can
                                ;be kept.  The claim is what lets the capture run without EVER growing the
                                ;region: see UNDGRW for why growing where a primitive can see it is unsafe.
  0400                          UNDCAP	EQU	400H		; 1024 bytes of change
                                
                                ;UNDBEG -- CMD.MAC's command boundary: the NEXT captured change starts a new
                                ;undo.  A flag only, so a command that changes nothing -- a motion, a yank, a
                                ;key that is no command at all -- leaves the last change undoable, exactly as
                                ;'.' keeps the last change it recorded.
  074B'                         UNDBEG:
  074B'   D5                    	PUSH	D
  074C'   E5                    	PUSH	H
  074D'   3E 01                 	MVI	A,1
  074F'   32 0BE2'              	STA	UNDNEW
  0752'   CD 0761'              	CALL	UNDPC0		; where the cursor was as this command began --
  0755'   CD 076E'              	CALL	UNDGRW		;   kept pending, because only a command that
  0758'   E1                    	POP	H		;   really changes text gets to claim it
  0759'   D1                    	POP	D
  075A'   C9                    	RET
                                
                                ;UNDHER -- the change about to start belongs at the CURSOR: 'u' puts it back
                                ;there.  UNDBEG's cursor snapshot without its claim on the region, for a
                                ;command (':s') that cannot know where its first change will be until it has
                                ;found it.  Calling UNDBEG again instead would re-run UNDGRW in the middle of
                                ;the command, which is the one thing UNDGRW must never do -- see below.
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  075B'                         UNDHER:
  075B'   E5                    	PUSH	H
  075C'   CD 0761'              	CALL	UNDPC0
  075F'   E1                    	POP	H
  0760'   C9                    	RET
                                
                                ;UNDPC0 -- the cursor's offset now, and the window's top it is measured from
                                ;(OUTPOS, in records): the command may page before its first capture, and
                                ;UNDRST moves the offset by what the top moved (#43).  Clobbers DE and HL.
  0761'                         UNDPC0:
  0761'   CD 065A'              	CALL	CUROFF
  0764'   22 0000*              	SHLD	UNDPCU
  0767'   2A 0000*              	LHLD	OUTPOS
  076A'   22 0000*              	SHLD	UNDPCO
  076D'   C9                    	RET
                                
                                ;UNDGRW -- make sure the region can take a whole change without growing again.
                                ;THE ONLY PLACE THE REGION GROWS, and it runs at the command boundary, where no
                                ;primitive is holding anything.  Growing moves regions about (MKGAP -> MOVGAP),
                                ;and that both invalidates a raw pointer a primitive is in the middle of using
                                ;-- DELPRV hands SETGAPB one -- and overwrites whatever is sitting in the gap,
                                ;which is where a forward-deleted byte waits for 'R's backspace to call UNDELF
                                ;and give it back.  So the room is claimed here, 256 bytes at a time, and the
                                ;capture below never calls MKGAP at all: it writes into the claim or gives up.
                                ;The room has to be claimed as the region's own CONTENT, not left as the hole
                                ;above it: the holes are shared, and the text takes whatever it can reach --
                                ;MOVGAP feeding an insert will walk straight through a hole reserved here, which
                                ;is what made a 200-character insert lose its undo halfway.  Once the bytes are
                                ;inside (UBEG,UEND) the text cannot have them: MOVGAP slides the region aside
                                ;instead.  Nothing here holds an address across MKGAP either, because MKGAP
                                ;slides this very region (HOLEUP moves UBEG and UEND) -- UEND is re-read from
                                ;its cell every time round.
  076E'                         UNDGRW:
  076E'   C5                    	PUSH	B
  076F'   D5                    	PUSH	D
  0770'   E5                    	PUSH	H
  0771'                         UNDGRL:
  0771'   21 0000*              	LXI	H,UBEG
  0774'   CD 04A7'              	CALL	PRSPAN		; BC = the region's size
  0777'   50                    	MOV	D,B
  0778'   59                    	MOV	E,C
  0779'   21 0400               	LXI	H,UNDCAP
  077C'   CD 05EF'              	CALL	CMP16		; CY iff it is smaller than one change
  077F'   D2 061C'              	JNC	POPRET
  0782'   CD 093F'              	CALL	UNDRM		; ... but never at the cost of paging
  0785'   DA 061C'              	JC	POPRET
  0788'   21 0000*              	LXI	H,UEND
  078B'   CD 00BC'              	CALL	MKGAP		; 256 free above the region ...
  078E'   2A 0000*              	LHLD	UEND
  0791'   11 0100               	LXI	D,100H
  0794'   19                    	DAD	D
  0795'   22 0000*              	SHLD	UEND		; ... taken into it, so the text cannot take
  0798'   C3 0771'              	JMP	UNDGRL		;     them back
                                
                                ;UNDCLR -- nothing is undoable (a fresh buffer; BINIT calls it through INIGAP).
  079B'                         UNDCLR:
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  079B'   AF                    	XRA	A
  079C'   32 0000*              	STA	UNDN
  079F'   32 0000*              	STA	UNDST
  07A2'   32 0000*              	STA	UNDBAD
  07A5'   3E 01                 	MVI	A,1
  07A7'   32 0BE2'              	STA	UNDNEW
  07AA'   C9                    	RET
                                
                                ;UNDRST -- the first capture of a new change: drop the last one and note where
                                ;the file window was, so 'u' can tell the pager has since moved off this change.
  07AB'                         UNDRST:
  07AB'   AF                    	XRA	A
  07AC'   32 0BE2'              	STA	UNDNEW
  07AF'   32 0000*              	STA	UNDN
  07B2'   32 0000*              	STA	UNDBAD
  07B5'   21 0000               	LXI	H,0
  07B8'   22 0000*              	SHLD	UNDPTR		; the region's content empties (its SIZE stays:
                                				;   that is the room UNDGRW claimed)
  07BB'   2A 0000*              	LHLD	PGTOPM
  07BE'   22 0000*              	SHLD	UNDPG
  07C1'   2A 0000*              	LHLD	OUTPOS		; ... and this command does change text, so
  07C4'   EB                    	XCHG			;   where it began is where 'u' will put the
  07C5'   2A 0000*              	LHLD	UNDPCO		;   cursor back.  It was measured from the top
  07C8'   CD 05D1'              	CALL	SUBHD		;   the window had then: a page before this
  07CB'   29                    	DAD	H		;   first capture moved the top by HL records
  07CC'   29                    	DAD	H		;   (#43: 'dd' on a full window spills before
  07CD'   29                    	DAD	H		;   it takes the line), so the offset moves by
  07CE'   29                    	DAD	H		;   128 bytes a record.  Above the top now is
  07CF'   29                    	DAD	H		;   where nothing can be put back: the top.
  07D0'   29                    	DAD	H
  07D1'   29                    	DAD	H
  07D2'   EB                    	XCHG
  07D3'   2A 0000*              	LHLD	UNDPCU
  07D6'   19                    	DAD	D
  07D7'   7C                    	MOV	A,H
  07D8'   B7                    	ORA	A
  07D9'   F2 07DF'              	JP	URSTCU
  07DC'   21 0000               	LXI	H,0
  07DF'   22 0000*              URSTCU:	SHLD	UNDCUR
  07E2'   3E 01                 	MVI	A,1
  07E4'   32 0000*              	STA	UNDST		; a change is on the buffer: 'u' undoes it
  07E7'   C9                    	RET
                                
                                ;UNDCHG -- the capture every hooked primitive uses.  A = UR_INS / UR_DEL,
                                ;HL = the logical offset it acted at, BC = how many bytes.  The bytes are read
                                ;back out of the resident TEXT at that offset -- for a delete before they go,
                                ;for an insert once they have arrived -- so no caller hands over a pointer that
                                ;growing the region could leave stale.
  07E8'                         UNDCHG:
  07E8'   C5                    	PUSH	B
  07E9'   D5                    	PUSH	D
  07EA'   E5                    	PUSH	H
  07EB'   32 0000*              	STA	UNDTY		; the record type, kept out of the registers
  07EE'   CD 0866'              	CALL	EDTGO		; whoever else follows an edit (BC is kept)
  07F1'   3A 0000*              	LDA	UNDRPL
  07F4'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  07F5'   C2 061C'              	JNZ	POPRET		; 'u' replaying: its own edits are not a change
  07F8'   3A 0BE2'              	LDA	UNDNEW
  07FB'   B7                    	ORA	A
  07FC'   CA 0802'              	JZ	UNDC1
  07FF'   CD 07AB'              	CALL	UNDRST		; the first step of a new change
  0802'                         UNDC1:
  0802'   3A 0000*              	LDA	UNDBAD
  0805'   B7                    	ORA	A
  0806'   C2 061C'              	JNZ	POPRET		; this change has already been given up on
  0809'   78                    	MOV	A,B
  080A'   B1                    	ORA	C
  080B'   CA 061C'              	JZ	POPRET		; a zero-length step is no step
  080E'   60                    	MOV	H,B
  080F'   69                    	MOV	L,C
  0810'   22 0000*              	SHLD	UNDCL		; UNDAPT spends BC as its countdown, so the
                                				;   length has to be kept somewhere else
  0813'   3A 0000*              	LDA	UNDN
  0816'   FE 18                 	CPI	URMAX
  0818'   D2 085E'              	JNC	UNDCBD		; no room for another step
                                	;--- where this step's bytes will land in the region ---
  081B'   2A 0000*              	LHLD	UNDPTR
  081E'   22 0000*              	SHLD	UNDBO
  0821'   E1                    	POP	H
  0822'   E5                    	PUSH	H		; HL = the logical offset again
  0823'   CD 08D6'              	CALL	UNDAPT		; BC bytes of the text there -> the region
  0826'   DA 085E'              	JC	UNDCBD
                                	;--- fold it into the last record when it only carries that one on ---
  0829'   E1                    	POP	H
  082A'   E5                    	PUSH	H
  082B'   CD 087E'              	CALL	UNDEXT
  082E'   CA 061C'              	JZ	POPRET
                                	;--- otherwise a record of its own ---
  0831'   3A 0000*              	LDA	UNDN
  0834'   CD 086E'              	CALL	URADDR
  0837'   3A 0000*              	LDA	UNDTY
  083A'   77                    	MOV	M,A
  083B'   23                    	INX	H
  083C'   D1                    	POP	D
  083D'   D5                    	PUSH	D		; DE = the logical offset
  083E'   73                    	MOV	M,E
  083F'   23                    	INX	H
  0840'   72                    	MOV	M,D
  0841'   23                    	INX	H
  0842'   EB                    	XCHG			; DE = the record, past the offset
  0843'   2A 0000*              	LHLD	UNDCL
  0846'   EB                    	XCHG			; ... and HL back, with DE = the length
  0847'   73                    	MOV	M,E
  0848'   23                    	INX	H
  0849'   72                    	MOV	M,D
  084A'   23                    	INX	H
  084B'   3A 0000*              	LDA	UNDBO
  084E'   77                    	MOV	M,A
  084F'   23                    	INX	H
  0850'   3A 0001*              	LDA	UNDBO+1
  0853'   77                    	MOV	M,A
  0854'   3A 0000*              	LDA	UNDN
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0857'   3C                    	INR	A
  0858'   32 0000*              	STA	UNDN
  085B'   C3 061C'              	JMP	POPRET
  085E'                         UNDCBD:
  085E'   3E 01                 	MVI	A,1
  0860'   32 0000*              	STA	UNDBAD		; too big to keep: not undoable at all
  0863'   C3 061C'              	JMP	POPRET
                                
                                ;EDTGO -- UNDCHG is the one place every change to the text goes by, the
                                ;replay's own included, so it is also where the editor hears of one: EDTHK is
                                ;called with A = UR_INS / UR_DEL, HL = the logical offset and BC = the length,
                                ;and must keep BC.  VI.MAC points it at the marks; a harness leaves it a RET.
  0866'                         EDTGO:
  0866'   E5                    	PUSH	H
  0867'   2A 086C'              	LHLD	EDTHK
  086A'   E3                    	XTHL
  086B'   C9                    	RET
  086C'   0651'                 EDTHK:	DW	ERMNUL
                                
                                ;URADDR -- A = a record index -> HL = its address (base + n*8 - n).
  086E'                         URADDR:
  086E'   6F                    	MOV	L,A
  086F'   26 00                 	MVI	H,0
  0871'   5D                    	MOV	E,L
  0872'   54                    	MOV	D,H
  0873'   29                    	DAD	H
  0874'   29                    	DAD	H
  0875'   29                    	DAD	H		; HL = n*8
  0876'   CD 05D1'              	CALL	SUBHD		; HL = n*7
  0879'   11 0000*              	LXI	D,UNDREC
  087C'   19                    	DAD	D
  087D'   C9                    	RET
                                
                                ;UNDEXT -- A = 0 (Z) when this step only carries the last record on: an insert
                                ;starting exactly where the last insert ended, which is what typing does.  Its
                                ;bytes already sit contiguously behind that record's, so only the length grows.
                                ;HL = this step's offset, BC = its length.
  087E'                         UNDEXT:
  087E'   C5                    	PUSH	B
  087F'   D5                    	PUSH	D
  0880'   E5                    	PUSH	H
  0881'   3A 0000*              	LDA	UNDTY
  0884'   FE 01                 	CPI	UR_INS
  0886'   C2 08D0'              	JNZ	UNDXNO		; only inserts fold
  0889'   3A 0000*              	LDA	UNDN
  088C'   B7                    	ORA	A
  088D'   CA 08D0'              	JZ	UNDXNO		; nothing to fold into
  0890'   3D                    	DCR	A
  0891'   CD 086E'              	CALL	URADDR
  0894'   22 0000*              	SHLD	UNDLSA
  0897'   7E                    	MOV	A,M
  0898'   FE 01                 	CPI	UR_INS
  089A'   C2 08D0'              	JNZ	UNDXNO
  089D'   2A 0000*              	LHLD	UNDLSA
  08A0'   23                    	INX	H
  08A1'   CD 05EA'              	CALL	LDHLI		; HL = the last record's offset
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  08A4'   EB                    	XCHG
  08A5'   2A 0000*              	LHLD	UNDLSA
  08A8'   23                    	INX	H
  08A9'   23                    	INX	H
  08AA'   23                    	INX	H
  08AB'   CD 05EA'              	CALL	LDHLI		; HL = its length
  08AE'   19                    	DAD	D		; HL = where it ends
  08AF'   EB                    	XCHG
  08B0'   E1                    	POP	H
  08B1'   E5                    	PUSH	H		; HL = this step's offset
  08B2'   CD 05EF'              	CALL	CMP16		; Z iff this step starts exactly there
  08B5'   C2 08D0'              	JNZ	UNDXNO
  08B8'   2A 0000*              	LHLD	UNDLSA
  08BB'   23                    	INX	H
  08BC'   23                    	INX	H
  08BD'   23                    	INX	H
  08BE'   E5                    	PUSH	H
  08BF'   CD 05EA'              	CALL	LDHLI		; HL = the last record's length
  08C2'   EB                    	XCHG
  08C3'   2A 0000*              	LHLD	UNDCL
  08C6'   19                    	DAD	D		; ... grown by this step's
  08C7'   EB                    	XCHG
  08C8'   E1                    	POP	H
  08C9'   73                    	MOV	M,E
  08CA'   23                    	INX	H
  08CB'   72                    	MOV	M,D
  08CC'   AF                    	XRA	A		; Z: folded, no new record
  08CD'   C3 061C'              	JMP	POPRET
  08D0'                         UNDXNO:
  08D0'   3E 01                 	MVI	A,1
  08D2'   B7                    	ORA	A		; NZ: it needs a record of its own
  08D3'   C3 061C'              	JMP	POPRET
                                
                                ;UNDAPT -- append BC bytes of resident text, from logical offset HL, to the
                                ;undo region.  CY, and the change given up on, if they do not all fit the room
                                ;UNDGRW claimed: then NOTHING is copied, so a change too big to keep costs no
                                ;capture at all (#36).  Otherwise the bytes go in with at most two MEMCPYs, the
                                ;run before the gap and the run after it.  Each hook hands over a span on ONE
                                ;side of the gap, but the split costs little and keeps the contract whole.
                                ;The addresses are resolved here and used at once: nothing UNDAPT calls can
                                ;move a region (no MKGAP, no paging; MEMCPY's KBPOLL only fills the key ring,
                                ;and at 1 K a copy never reaches it), so none can go stale in the middle.
  08D6'                         UNDAPT:
  08D6'   78                    	MOV	A,B
  08D7'   B1                    	ORA	C
  08D8'   C8                    	RZ			; nothing to append
  08D9'   E5                    	PUSH	H		; the offset
  08DA'   C5                    	PUSH	B		; ... and the length
  08DB'   21 0000*              	LXI	H,UBEG
  08DE'   CD 04A7'              	CALL	PRSPAN		; BC = the region's size
  08E1'   2A 0000*              	LHLD	UNDPTR
  08E4'   EB                    	XCHG
  08E5'   60                    	MOV	H,B
  08E6'   69                    	MOV	L,C
  08E7'   CD 05D1'              	CALL	SUBHD		; HL = the room left in it
  08EA'   EB                    	XCHG			; DE = the room
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  08EB'   E1                    	POP	H
  08EC'   E5                    	PUSH	H		; HL = the length
  08ED'   CD 05EF'              	CALL	CMP16		; CY iff the room is short of it
  08F0'   DA 0936'              	JC	UNDAPF
  08F3'                         UNDAPR:
  08F3'   CD 065A'              	CALL	CUROFF		; HL = the bytes before the gap (DE is lost)
  08F6'   C1                    	POP	B		; BC = the bytes still to copy
  08F7'   D1                    	POP	D		; DE = their offset
  08F8'   78                    	MOV	A,B
  08F9'   B1                    	ORA	C
  08FA'   C8                    	RZ			; all in (NC from the ORA)
  08FB'   D5                    	PUSH	D
  08FC'   CD 05EF'              	CALL	CMP16		; CY iff they start before the gap
  08FF'   D2 090D'              	JNC	UNDAPA		; at or after it: one run, the rest
  0902'   CD 05D1'              	CALL	SUBHD		; HL = how many lie before the gap
  0905'   50                    	MOV	D,B
  0906'   59                    	MOV	E,C
  0907'   CD 05EF'              	CALL	CMP16		; CY iff fewer are left than that
  090A'   D2 090F'              	JNC	UNDAPN		; the run stops at the gap
  090D'                         UNDAPA:
  090D'   60                    	MOV	H,B
  090E'   69                    	MOV	L,C		; the run is all that is left
  090F'                         UNDAPN:
  090F'   79                    	MOV	A,C		; HL = this run, BC = left, the offset stacked
  0910'   95                    	SUB	L
  0911'   4F                    	MOV	C,A
  0912'   78                    	MOV	A,B
  0913'   9C                    	SBB	H
  0914'   47                    	MOV	B,A		; BC = what is left after it
  0915'   EB                    	XCHG			; DE = the run
  0916'   E1                    	POP	H
  0917'   E5                    	PUSH	H		; HL = its offset
  0918'   19                    	DAD	D
  0919'   E3                    	XTHL			; the next run's offset stacked, HL = this one's
  091A'   C5                    	PUSH	B		; ... and what will be left
  091B'   42                    	MOV	B,D
  091C'   4B                    	MOV	C,E		; BC = the run
  091D'   CD 067A'              	CALL	L2PHYS		; HL = where it sits in the text
  0920'   E5                    	PUSH	H
  0921'   2A 0000*              	LHLD	UNDPTR
  0924'   E5                    	PUSH	H
  0925'   09                    	DAD	B
  0926'   22 0000*              	SHLD	UNDPTR		; the write point moves past it
  0929'   D1                    	POP	D
  092A'   2A 0000*              	LHLD	UBEG
  092D'   19                    	DAD	D
  092E'   EB                    	XCHG			; DE = where it goes in the region
  092F'   E1                    	POP	H		; HL = the text
  0930'   CD 04EE'              	CALL	MEMCPY
  0933'   C3 08F3'              	JMP	UNDAPR
  0936'                         UNDAPF:
  0936'   C1                    	POP	B
  0937'   E1                    	POP	H
  0938'   3E 01                 	MVI	A,1
  093A'   32 0000*              	STA	UNDBAD		; too big for the room: not undoable at all
  093D'   37                    	STC
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  093E'   C9                    	RET
                                
                                ;UNDRM -- CY, and the change given up on, unless the arena still holds UNDRSV
                                ;free.  The capture must never page: paging moves the window off the change and
                                ;would invalidate every logical offset the records hold.  Keeping this much
                                ;free also keeps MKGAP off its MKROOM path, so the capture cannot page even by
                                ;accident, and it fails QUIETLY where QROOM raises 'QBUF FULL' -- undo going
                                ;away must never stop the editing.
  093F'                         UNDRM:
  093F'   C5                    	PUSH	B
  0940'   D5                    	PUSH	D
  0941'   E5                    	PUSH	H
  0942'   CD 0441'              	CALL	BUFSUM		; DE = the arena's free bytes
  0945'   21 0200               	LXI	H,UNDRSV
  0948'   CD 05EF'              	CALL	CMP16		; CY iff less than that is left
  094B'   D2 061C'              	JNC	POPRET
  094E'   3E 01                 	MVI	A,1
  0950'   32 0000*              	STA	UNDBAD
  0953'   37                    	STC
  0954'   C3 061C'              	JMP	POPRET
                                
                                ;---------------------------------------------------------------- the replay
                                
                                ;UNDO -- 'u'.  CY when there is nothing to undo: no change captured, a change
                                ;too big to have been captured, or the pager has moved the window off it.
  0957'                         UNDO:
  0957'   AF                    	XRA	A
  0958'   32 0000*              	STA	UNDWHY		; refused for want of a change, until told else
  095B'   3A 0000*              	LDA	UNDBAD		; asked BEFORE the count of records: a change
  095E'   B7                    	ORA	A		;   too big from its very first step leaves
  095F'   CA 0969'              	JZ	UND_OK		;   none, and is still not 'nothing to undo'
  0962'   3E 02                 	MVI	A,2
  0964'   32 0000*              	STA	UNDWHY		; too big to have been captured: CMD.MAC says
  0967'   37                    	STC			;   so, rather than ringing the bell at a user
  0968'   C9                    	RET			;   who has no way to know why
  0969'                         UND_OK:
  0969'   3A 0000*              	LDA	UNDN
  096C'   B7                    	ORA	A
  096D'   37                    	STC
  096E'   C8                    	RZ			; nothing captured
  096F'   2A 0000*              	LHLD	PGTOPM
  0972'   EB                    	XCHG
  0973'   2A 0000*              	LHLD	UNDPG
  0976'   CD 05EF'              	CALL	CMP16
  0979'   C2 09AC'              	JNZ	UNDPGD		; the pager has moved the window's top since,
                                				;   so every offset the records hold has shifted
  097C'   3E FF                 	MVI	A,0FFH
  097E'   32 0000*              	STA	UNDML		; (no step taken yet)
  0981'   AF                    	XRA	A
  0982'   32 0000*              	STA	UNDLK
  0985'   32 0000*              	STA	UNDLC
  0988'   3E 01                 	MVI	A,1
  098A'   32 0000*              	STA	UNDRPL		; the replay's own edits are not a new change
  098D'   3A 0000*              	LDA	UNDST
  0990'   FE 01                 	CPI	1
  0992'   CA 09B3'              	JZ	UNDREV
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


                                	;--- the last 'u' undid it: apply the records forward again (a redo) ---
  0995'   AF                    	XRA	A
  0996'   32 0000*              	STA	UNDDIR
  0999'   AF                    	XRA	A
  099A'                         UNDFWL:
  099A'   CD 09D4'              	CALL	URSTEP
  099D'   3C                    	INR	A
  099E'   47                    	MOV	B,A
  099F'   3A 0000*              	LDA	UNDN
  09A2'   B8                    	CMP	B
  09A3'   78                    	MOV	A,B
  09A4'   C2 099A'              	JNZ	UNDFWL
  09A7'   3E 01                 	MVI	A,1
  09A9'   C3 09C5'              	JMP	UNDFIN
  09AC'                         UNDPGD:
  09AC'   3E 01                 	MVI	A,1
  09AE'   32 0000*              	STA	UNDWHY		; the change is no longer in the window
  09B1'   37                    	STC
  09B2'   C9                    	RET
  09B3'                         UNDREV:
                                	;--- undo: the records backward, each one's inverse ---
  09B3'   3E 01                 	MVI	A,1
  09B5'   32 0000*              	STA	UNDDIR
  09B8'   3A 0000*              	LDA	UNDN
  09BB'                         UNDRVL:
  09BB'   3D                    	DCR	A
  09BC'   CD 09D4'              	CALL	URSTEP
  09BF'   B7                    	ORA	A
  09C0'   C2 09BB'              	JNZ	UNDRVL
  09C3'   3E 02                 	MVI	A,2
  09C5'                         UNDFIN:
  09C5'   32 0000*              	STA	UNDST
  09C8'   AF                    	XRA	A
  09C9'   32 0000*              	STA	UNDRPL
                                	;--- the cursor goes back where the command that changed it began:
                                	;    measured from vim, which restores that and not the change's own
                                	;    offset (CMD.MAC's VC_UNDO holds it inside the line) ---
  09CC'   2A 0000*              	LHLD	UNDCUR
  09CF'   CD 06AB'              	CALL	GOTO
  09D2'   B7                    	ORA	A		; CY clear: it happened
  09D3'   C9                    	RET
                                
                                ;URSTEP -- apply record A: as it stands when UNDDIR is 0 (a redo), inverted
                                ;when it is 1 (an undo).  An insert applied puts its saved bytes back at its
                                ;offset; an insert inverted deletes that many bytes there; a delete is the
                                ;mirror of both.  A is preserved -- UNDO's loops count with it.
  09D4'                         URSTEP:
  09D4'   F5                    	PUSH	PSW
  09D5'   CD 086E'              	CALL	URADDR
  09D8'   7E                    	MOV	A,M
  09D9'   32 0000*              	STA	UNDTY
  09DC'   23                    	INX	H
  09DD'   7E                    	MOV	A,M
  09DE'   32 0000*              	STA	UNDOF
  09E1'   23                    	INX	H
  09E2'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  09E3'   32 0001*              	STA	UNDOF+1
  09E6'   23                    	INX	H
  09E7'   7E                    	MOV	A,M
  09E8'   32 0000*              	STA	UNDLN
  09EB'   23                    	INX	H
  09EC'   7E                    	MOV	A,M
  09ED'   32 0001*              	STA	UNDLN+1
  09F0'   23                    	INX	H
  09F1'   7E                    	MOV	A,M
  09F2'   32 0000*              	STA	UNDBO
  09F5'   23                    	INX	H
  09F6'   7E                    	MOV	A,M
  09F7'   32 0001*              	STA	UNDBO+1
  09FA'   2A 0000*              	LHLD	UNDBO		; a line end among its bytes: more than one
  09FD'   EB                    	XCHG			;   line changes (UNDML: CMD.MAC picks the
  09FE'   2A 0000*              	LHLD	UBEG		;   repaint by it)
  0A01'   19                    	DAD	D
  0A02'   EB                    	XCHG
  0A03'   2A 0000*              	LHLD	UNDLN
  0A06'   19                    	DAD	D
  0A07'   CD 06DB'              	CALL	LFCNT
  0A0A'   7A                    	MOV	A,D
  0A0B'   B3                    	ORA	E
  0A0C'   CA 0A14'              	JZ	URS_1L
  0A0F'   3E 01                 	MVI	A,1
  0A11'   32 0000*              	STA	UNDML
  0A14'                         URS_1L:
  0A14'   3A 0000*              	LDA	UNDTY
  0A17'   47                    	MOV	B,A
  0A18'   3A 0000*              	LDA	UNDDIR
  0A1B'   B7                    	ORA	A
  0A1C'   CA 0A28'              	JZ	URS_AP
  0A1F'   78                    	MOV	A,B		; an undo inverts the record
  0A20'   FE 01                 	CPI	UR_INS
  0A22'   CA 0A2E'              	JZ	URS_DL
  0A25'   C3 0A3E'              	JMP	URS_IN
  0A28'                         URS_AP:
  0A28'   78                    	MOV	A,B		; a redo applies it as it stands
  0A29'   FE 01                 	CPI	UR_INS
  0A2B'   CA 0A3E'              	JZ	URS_IN
  0A2E'                         URS_DL:
                                	;--- take the record's length back out at its offset ---
  0A2E'   CD 0A70'              	CALL	URGOTO
  0A31'   3E 02                 	MVI	A,2
  0A33'   CD 0A96'              	CALL	URLNQ
  0A36'   2A 0000*              	LHLD	UNDLN
  0A39'   CD 0710'              	CALL	DELFWD
  0A3C'   F1                    	POP	PSW
  0A3D'   C9                    	RET
  0A3E'                         URS_IN:
                                	;--- put the record's saved bytes back in at its offset ---
  0A3E'   CD 0A70'              	CALL	URGOTO
  0A41'   3E 01                 	MVI	A,1
  0A43'   CD 0A96'              	CALL	URLNQ
  0A46'   2A 0000*              	LHLD	UNDLN
  0A49'   44                    	MOV	B,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0A4A'   4D                    	MOV	C,L
  0A4B'   2A 0000*              	LHLD	UNDBO
  0A4E'                         URSILP:
  0A4E'   C5                    	PUSH	B
  0A4F'   E5                    	PUSH	H
  0A50'   EB                    	XCHG			; DE = the byte's offset within the region
  0A51'   2A 0000*              	LHLD	UBEG		; ... re-read every byte: inserting text can
  0A54'   19                    	DAD	D		;     slide the region out from under it
  0A55'   7E                    	MOV	A,M
  0A56'   CD 0054'              	CALL	PUTGAP
  0A59'   FE 0A                 	CPI	LF
  0A5B'   C2 0A65'              	JNZ	URSILN
  0A5E'   2A 0000*              	LHLD	LNDLT		; a line end put back is the cursor crossing
  0A61'   23                    	INX	H		;   one, and GOTO keeps LNDLT for every move the
  0A62'   22 0000*              	SHLD	LNDLT		;   replay makes -- so the renderer needs no
  0A65'                         URSILN:				;   whole-window rescan to find that out
  0A65'   E1                    	POP	H
  0A66'   C1                    	POP	B
  0A67'   23                    	INX	H
  0A68'   0B                    	DCX	B
  0A69'   78                    	MOV	A,B
  0A6A'   B1                    	ORA	C
  0A6B'   C2 0A4E'              	JNZ	URSILP
  0A6E'   F1                    	POP	PSW
  0A6F'   C9                    	RET
                                
                                ;URGOTO -- the cursor to the record's offset.  The line the first step is on
                                ;is the change's (UNDL0 = LNDLT there, which GOTO keeps up); a later step on
                                ;another line makes the change more than one line's (UNDML).
  0A70'                         URGOTO:
  0A70'   2A 0000*              	LHLD	UNDOF
  0A73'   CD 06AB'              	CALL	GOTO
  0A76'   2A 0000*              	LHLD	LNDLT
  0A79'   EB                    	XCHG
  0A7A'   3A 0000*              	LDA	UNDML
  0A7D'   3C                    	INR	A
  0A7E'   C2 0A89'              	JNZ	URG_1
  0A81'   32 0000*              	STA	UNDML		; (0: one line, so far)
  0A84'   EB                    	XCHG
  0A85'   22 0000*              	SHLD	UNDL0
  0A88'   C9                    	RET
  0A89'                         URG_1:
  0A89'   2A 0000*              	LHLD	UNDL0
  0A8C'   CD 05EF'              	CALL	CMP16
  0A8F'   C8                    	RZ
  0A90'   3E 01                 	MVI	A,1
  0A92'   32 0000*              	STA	UNDML
  0A95'   C9                    	RET
                                
                                ;URLNQ -- the step about to be taken at the cursor puts the record's bytes in
                                ;(A = 1) or takes them out (A = 2).  UNDLK stays that for as long as every
                                ;step does the same, with whole lines -- it starts at a line's start and the
                                ;bytes end in a line end -- and at the place the first one did (UNDLL0 =
                                ;LNDLT there); UNDLC counts the lines.  Anything else and UNDLK is 0FFH.
                                ;Two more ways of taking a whole line out are known for what they are: steps
                                ;at one line's start that end with a line only when the last has gone (UNDLK
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


                                ;is 3 until then), and one step from a line's END that takes its line end and
                                ;the next line's text -- the line under it, so UNDLL0 is that line's.
                                ;CMD.MAC opens the rows for lines put back, or closes them up, by these.
  0A96'                         URLNQ:
  0A96'   47                    	MOV	B,A
  0A97'   3A 0000*              	LDA	UNDLK
  0A9A'   B7                    	ORA	A
  0A9B'   CA 0AB8'              	JZ	URL_1
  0A9E'   F6 01                 	ORI	1		; (2 and 3 are both lines going)
  0AA0'   4F                    	MOV	C,A
  0AA1'   78                    	MOV	A,B
  0AA2'   F6 01                 	ORI	1
  0AA4'   B9                    	CMP	C
  0AA5'   C2 0B68'              	JNZ	URL_NO
  0AA8'   2A 0000*              	LHLD	UNDLL0
  0AAB'   EB                    	XCHG
  0AAC'   2A 0000*              	LHLD	LNDLT
  0AAF'   CD 05EF'              	CALL	CMP16
  0AB2'   C2 0B68'              	JNZ	URL_NO
  0AB5'   C3 0ABE'              	JMP	URL_2
  0AB8'                         URL_1:
  0AB8'   2A 0000*              	LHLD	LNDLT
  0ABB'   22 0000*              	SHLD	UNDLL0
  0ABE'                         URL_2:
  0ABE'   CD 065A'              	CALL	CUROFF
  0AC1'   7C                    	MOV	A,H
  0AC2'   B5                    	ORA	L
  0AC3'   CA 0B17'              	JZ	URL_3
  0AC6'   2A 0000*              	LHLD	GAPBEG
  0AC9'   2B                    	DCX	H
  0ACA'   7E                    	MOV	A,M
  0ACB'   FE 0A                 	CPI	LF
  0ACD'   CA 0B17'              	JZ	URL_3
                                	;--- not at a line's start.  One step that takes out a line end and
                                	;    what follows it as far as the next ('o' and what was typed) is
                                	;    the line under that one going, all the same: UNDLL0 as for it ---
  0AD0'   78                    	MOV	A,B
  0AD1'   FE 02                 	CPI	2
  0AD3'   C2 0B68'              	JNZ	URL_NO
  0AD6'   3A 0000*              	LDA	UNDLK
  0AD9'   B7                    	ORA	A
  0ADA'   C2 0B68'              	JNZ	URL_NO
  0ADD'   2A 0000*              	LHLD	UNDBO
  0AE0'   EB                    	XCHG
  0AE1'   2A 0000*              	LHLD	UBEG
  0AE4'   19                    	DAD	D
  0AE5'   7E                    	MOV	A,M
  0AE6'   FE 0D                 	CPI	CR
  0AE8'   CA 0AF0'              	JZ	URL_B0
  0AEB'   FE 0A                 	CPI	LF
  0AED'   C2 0B68'              	JNZ	URL_NO
  0AF0'                         URL_B0:
  0AF0'   2A 0000*              	LHLD	UNDLN
  0AF3'   EB                    	XCHG
  0AF4'   2A 0000*              	LHLD	GAPEND
  0AF7'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0AF8'   EB                    	XCHG			; DE = the text after what goes
  0AF9'   2A 0000*              	LHLD	TXTEND
  0AFC'   CD 05EF'              	CALL	CMP16
  0AFF'   D2 0B0D'              	JNC	URL_B1		; (the end of the text)
  0B02'   1A                    	LDAX	D
  0B03'   FE 0D                 	CPI	CR
  0B05'   CA 0B0D'              	JZ	URL_B1
  0B08'   FE 0A                 	CPI	LF
  0B0A'   C2 0B68'              	JNZ	URL_NO
  0B0D'                         URL_B1:
  0B0D'   2A 0000*              	LHLD	UNDLL0
  0B10'   23                    	INX	H
  0B11'   22 0000*              	SHLD	UNDLL0
  0B14'   C3 0B37'              	JMP	URL_4
  0B17'                         URL_3:
  0B17'   2A 0000*              	LHLD	UNDLN
  0B1A'   7C                    	MOV	A,H
  0B1B'   B5                    	ORA	L
  0B1C'   CA 0B68'              	JZ	URL_NO
  0B1F'   EB                    	XCHG
  0B20'   2A 0000*              	LHLD	UNDBO
  0B23'   19                    	DAD	D
  0B24'   EB                    	XCHG
  0B25'   2A 0000*              	LHLD	UBEG
  0B28'   19                    	DAD	D		; HL = past the record's bytes
  0B29'   2B                    	DCX	H
  0B2A'   7E                    	MOV	A,M
  0B2B'   FE 0A                 	CPI	LF
  0B2D'   CA 0B37'              	JZ	URL_4
  0B30'   78                    	MOV	A,B		; steps that take text out at one place take
  0B31'   FE 02                 	CPI	2		;   what is there each time, so it is the last
  0B33'   C2 0B68'              	JNZ	URL_NO		;   of them that has to end with a line: 3
  0B36'   04                    	INR	B		;   until it does ('O': the text typed goes,
  0B37'                         URL_4:				;   then the line end before it)
  0B37'   2A 0000*              	LHLD	UNDLN
  0B3A'   EB                    	XCHG
  0B3B'   2A 0000*              	LHLD	UNDBO
  0B3E'   19                    	DAD	D
  0B3F'   EB                    	XCHG
  0B40'   2A 0000*              	LHLD	UBEG
  0B43'   19                    	DAD	D
  0B44'   E5                    	PUSH	H
  0B45'   2A 0000*              	LHLD	UNDBO
  0B48'   EB                    	XCHG
  0B49'   2A 0000*              	LHLD	UBEG
  0B4C'   19                    	DAD	D
  0B4D'   EB                    	XCHG			; DE = their start
  0B4E'   E1                    	POP	H
  0B4F'   C5                    	PUSH	B
  0B50'   CD 06DB'              	CALL	LFCNT
  0B53'   C1                    	POP	B
  0B54'   7A                    	MOV	A,D
  0B55'   B7                    	ORA	A
  0B56'   C2 0B68'              	JNZ	URL_NO
  0B59'   3A 0000*              	LDA	UNDLC
  0B5C'   83                    	ADD	E
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0B5D'   DA 0B68'              	JC	URL_NO
  0B60'   32 0000*              	STA	UNDLC
  0B63'   78                    	MOV	A,B
  0B64'   32 0000*              	STA	UNDLK
  0B67'   C9                    	RET
  0B68'                         URL_NO:
  0B68'   3E FF                 	MVI	A,0FFH
  0B6A'   32 0000*              	STA	UNDLK
  0B6D'   C9                    	RET
                                
                                ;---------------------------------------------------------------- the hooks
                                
                                ;UNDPUT -- PUTGAP's tail: the one byte now sitting just below the cursor.
  0B6E'                         UNDPUT:
  0B6E'   F5                    	PUSH	PSW
  0B6F'   C5                    	PUSH	B
  0B70'   D5                    	PUSH	D
  0B71'   E5                    	PUSH	H
  0B72'   CD 065A'              	CALL	CUROFF
  0B75'   2B                    	DCX	H
  0B76'   01 0001               	LXI	B,1
  0B79'   3E 01                 	MVI	A,UR_INS
  0B7B'   CD 07E8'              	CALL	UNDCHG
  0B7E'   C3 0BDC'              	JMP	UNDHX
                                
                                ;UNDGET -- QGET's tail: BC bytes of register now in, the cursor past them.
                                ;UNDINS is the same entry by its general name: INSBLK itself carries NO hook
                                ;(insert mode records a byte at a time through PUTGAP), so a command that
                                ;splices a block in -- ':s' replacing a match -- has to say so itself, exactly
                                ;as QGET does.  Without it 'u' puts the deleted text back and leaves the
                                ;inserted text there ('a-a-a' undid to 'aZ-aZ-aZ').
  0B81'                         UNDINS:
  0B81'                         UNDGET:
  0B81'   F5                    	PUSH	PSW
  0B82'   C5                    	PUSH	B
  0B83'   D5                    	PUSH	D
  0B84'   E5                    	PUSH	H
  0B85'   78                    	MOV	A,B
  0B86'   B1                    	ORA	C
  0B87'   CA 0BDC'              	JZ	UNDHX
  0B8A'   CD 065A'              	CALL	CUROFF
  0B8D'   50                    	MOV	D,B
  0B8E'   59                    	MOV	E,C
  0B8F'   CD 05D1'              	CALL	SUBHD		; HL = where the put began
  0B92'   3E 01                 	MVI	A,UR_INS
  0B94'   CD 07E8'              	CALL	UNDCHG
  0B97'   C3 0BDC'              	JMP	UNDHX
                                
                                ;UNDDLF -- DELFWD's head: HL bytes about to go forward from the cursor.
  0B9A'                         UNDDLF:
  0B9A'   F5                    	PUSH	PSW
  0B9B'   C5                    	PUSH	B
  0B9C'   D5                    	PUSH	D
  0B9D'   E5                    	PUSH	H
  0B9E'   44                    	MOV	B,H
  0B9F'   4D                    	MOV	C,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0BA0'   CD 065A'              	CALL	CUROFF
  0BA3'   3E 02                 	MVI	A,UR_DEL
  0BA5'   CD 07E8'              	CALL	UNDCHG
  0BA8'   C3 0BDC'              	JMP	UNDHX
                                
                                ;UNDDLQ -- QPUTLN's head: BC bytes of whole lines about to go into the register.
  0BAB'                         UNDDLQ:
  0BAB'   F5                    	PUSH	PSW
  0BAC'   C5                    	PUSH	B
  0BAD'   D5                    	PUSH	D
  0BAE'   E5                    	PUSH	H
  0BAF'   CD 065A'              	CALL	CUROFF
  0BB2'   3E 02                 	MVI	A,UR_DEL
  0BB4'   CD 07E8'              	CALL	UNDCHG
  0BB7'   C3 0BDC'              	JMP	UNDHX
                                
                                ;UNDDLP -- DELPRV's head: the one byte just below the cursor, about to go.
  0BBA'                         UNDDLP:
  0BBA'   F5                    	PUSH	PSW
  0BBB'   C5                    	PUSH	B
  0BBC'   D5                    	PUSH	D
  0BBD'   E5                    	PUSH	H
  0BBE'   CD 065A'              	CALL	CUROFF
  0BC1'   2B                    	DCX	H
  0BC2'   01 0001               	LXI	B,1
  0BC5'   3E 02                 	MVI	A,UR_DEL
  0BC7'   CD 07E8'              	CALL	UNDCHG
  0BCA'   C3 0BDC'              	JMP	UNDHX
                                
                                ;UNDUDF -- UNDELF's tail: the byte DELTO just made text again, at the cursor.
  0BCD'                         UNDUDF:
  0BCD'   F5                    	PUSH	PSW
  0BCE'   C5                    	PUSH	B
  0BCF'   D5                    	PUSH	D
  0BD0'   E5                    	PUSH	H
  0BD1'   CD 065A'              	CALL	CUROFF
  0BD4'   01 0001               	LXI	B,1
  0BD7'   3E 01                 	MVI	A,UR_INS
  0BD9'   CD 07E8'              	CALL	UNDCHG
                                ;UNDHX -- every hook leaves the primitive's own registers and flags alone.
  0BDC'                         UNDHX:
  0BDC'   E1                    	POP	H
  0BDD'   D1                    	POP	D
  0BDE'   C1                    	POP	B
  0BDF'   F1                    	POP	PSW
  0BE0'   C9                    	RET
                                
                                ;============================================================
                                ; DATA -- what the image carries: the cells that start at something.
                                ;============================================================
                                ;The cells that start at zero are not in the image: RSV.MAC names them, in
                                ;the RAM just above it, and BUF.MAC's ZINIT clears them before anything runs.
                                ;Their order there is the order they had here, and code depends on it.
                                ;WM's (base,limit) pointer row, the search pattern and 'u''s state are there.
                                	EXTRN	BUFBEG, QBEG, QEND, HOLEQP, TXTBAS, UBEG
                                	EXTRN	UEND, TXTBEG, GAPBEG, GAPEND, TXTEND, PRTERM
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


                                	EXTRN	BUFEND, MVGTOP, ERRFLG, SRCHBF, SRCHST, L2756
                                	EXTRN	QCPDON, UNDN, UNDST, UNDBAD, UNDRPL, UNDDIR
                                	EXTRN	UNDWHY, UNDTY, UNDOF, UNDLN, UNDBO, UNDCL
                                	EXTRN	UNDLSA, UNDPG, UNDPTR, UNDPCU, UNDCUR, UNDPCO
                                	EXTRN	UNDLK, UNDLC, UNDLL0, UNDML, UNDL0, LNDLT
                                
  0BE1'   1E                    SRCMAX: DB	SRMAX		; SRCHST's capacity, so CMD.MAC cannot drift
  0BE2'   01                    UNDNEW: DB	1		; 'u': 1 = the next capture starts a new change
                                
                                ;PBEGMEM -- base of the text arena: the first RAM byte past everything the
                                ;program holds.  The gap buffer's text lives from here up to BUFEND.  BUF
                                ;links last but RSV.MAC links after it, holding the reserve block in the RAM
                                ;immediately above the image (it emits no bytes of its own), so the arena
                                ;starts at RSVTOP -- past the reserves -- and is the size it always was.
  0BE3'   0000*                 PBEGMEM:DW	RSVTOP
                                
  0BE5'                         MEMBAS:				; top of the linked image (RSV.MAC's base)
                                
                                	END
