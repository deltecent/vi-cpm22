                                ;============================================================
                                ; AFTER-CURSOR READ -- WM.ASM 3989-4048 (RGET0, RGET, AFTOFF, RECOUNT), verbatim.
                                ; RPEEK/RPEEKX (WM 3995-4006) are not used and are left out.  WM's CALL GETKEY
                                ; in RGET is KBPOLL here (KEY.MAC owns the ring), as in GOLINE.
                                ;============================================================
                                
                                ;RGET0 -- WM 3989: HL = GAPEND, BC = bytes from there to TXTEND.
  04DF'                         RGET0:				; WM 3989
  04DF'   CD 04D1'              	CALL	AFTLEN
  04E2'   CD 05A1'              	CALL	LDHLI
  04E5'   C9                    	RET
                                
                                ;RGET -- WM 4007: next char [HL++], BC--; when BC runs out, NEEDIN pages more
                                ;input in and BC is recounted.  CY at the end of the text.
  04E6'                         RGET:				; WM 4007
  04E6'   78                    	MOV	A,B
  04E7'   B1                    	ORA	C
  04E8'   C2 04FC'              	JNZ	RGETCH
  04EB'   CD 0500'              	CALL	AFTOFF
  04EE'   E5                    	PUSH	H
  04EF'   CD 0000*              	CALL	NEEDIN
  04F2'   E1                    	POP	H
  04F3'   F5                    	PUSH	PSW
  04F4'   CD 0000*              	CALL	KBPOLL		; WM: CALL GETKEY
  04F7'   CD 050A'              	CALL	RECOUNT
  04FA'   F1                    	POP	PSW
  04FB'   D8                    	RC
  04FC'                         RGETCH:				 ; WM 4021 -- return the next after-cursor char
  04FC'   7E                    	MOV	A,M
  04FD'   0B                    	DCX	B
  04FE'   23                    	INX	H
  04FF'   C9                    	RET
                                
                                ;AFTOFF -- WM 4028: HL = HL - GAPEND (survives the refill moving the text).
  0500'                         AFTOFF:				; WM 4028
  0500'   D5                    	PUSH	D
  0501'   EB                    	XCHG
