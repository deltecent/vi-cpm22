  0577'   C8                    	RZ
  0578'   04                    	INR	B
  0579'   0C                    	INR	C
  057A'   C3 05A0'              	JMP	MCPRCT
  057D'                         MCPRKB:
  057D'   CD 0000*              	CALL	KBPOLL		; 2 K copied: take a waiting key (#30)
  0580'                         MCPRBO:
  0580'   2B                    	DCX	H
  0581'   1B                    	DCX	D
  0582'   7E                    	MOV	A,M
  0583'   12                    	STAX	D
  0584'   2B                    	DCX	H
  0585'   1B                    	DCX	D
  0586'   7E                    	MOV	A,M
  0587'   12                    	STAX	D
  0588'   2B                    	DCX	H
  0589'   1B                    	DCX	D
  058A'   7E                    	MOV	A,M
  058B'   12                    	STAX	D
  058C'   2B                    	DCX	H
  058D'   1B                    	DCX	D
