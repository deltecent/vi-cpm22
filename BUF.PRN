  03A3'   C3 03B4'              	JMP	GAPRT
  03A6'                         PUTCERR:			; WM 2447
  03A6'   CD 05B7'              	CALL	ERRMSG
  03A9'   50 55 54 43           	DB	'PUTCUR ERR',0H
  03AD'   55 52 20 45           
  03B1'   52 52 00              
                                
