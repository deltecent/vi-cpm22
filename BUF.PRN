	MACRO-80 3.44	09-Dec-81	PAGE	1


                                ;============================================================
                                ; FILE:    BUF.MAC
                                ; PROJECT: VI
                                ; MODULE:  WordMaster's gap buffer, transcribed VERBATIM from WM.ASM.
                                ;
                                ; This is a direct transcription of MicroPro WordMaster 5.55A's gap-buffer
                                ; primitives.  WordMaster's control flow, register usage and instruction
                                ; sequence are reproduced exactly (same assembled object code); only the
                                ; label NAMES are translated -- WM.ASM's address-derived labels (Lxxxx) are
                                ; renamed to descriptive names, which changes nothing in the assembled bytes.
                                ; Every routine cites its WM.ASM source line, so it still diffs against WM.ASM.
                                ;
                                ; WHAT IS HERE: the gap buffer and the WordMaster routines that walk it --
                                ; insert (PUTGAP/INSBLK/INSSTR), delete (DELTO), cursor move (PUTCUR and
                                ; the gap slides), the pointer-row mechanics (MOVGAP/NEXTPR/BUFSUM/PRSPAN), the
                                ; Q-buffer (the vi yank register), the line moves (MVLMAX/GOLINE/SCRLST), the
                                ; string matchers (MATCHF/MATCHB) and the screen reads (LINPOSB/RGET).  The
                                ; disk is PAGE.MAC's: MKGAP reaches it through MKROOM when RAM is full, CKLOW
                                ; through REWIND, SETGAPB/DELTO through UPDMARK, PAGESTP through PAGEDIR.  A
                                ; file that fits in RAM is the run in which nothing has paged out -- the same
                                ; code runs either way.
                                ;
                                ; NOT TRANSCRIBED: CHRPOS (WM 2158; the cursor moves by address, with PUTCUR),
                                ; INSREPL (WM 1836; ':s' splices through INSSTR) and WM's screen/command init
                                ; (WM 365-377).  WM's PGCONST (WM 412) runs from PAGE.MAC's OPENFIL.
                                ;
                                ; DEVIATION FROM WM: ERRMSG's TAIL.  WM's ERRMSG (WM 664) prints its inline
                                ; message then longjmps to its own command loop.  Here only the tail differs:
                                ; print the WM message, set ERRFLG, and warm-boot to CP/M, so an error that
                                ; fires surfaces loudly.  The editor is left the way a quit leaves it: the
                                ; message goes on the bottom row (ERRHK, the editor's screen teardown) and no
                                ; work file stays on the disk (PAGE.MAC's DISCRD).
                                ;
                                ; APPENDED (non-WM), each section tagged where it starts:
                                ;   * the LOGICAL-OFFSET API (CUROFF/LOGLEN/CHARAT/GOTO/LFCNT, DELFWD, UNDELF,
                                ;     and DELPRV, which is WM's RUBOUT) -- a logical offset is a byte index
                                ;     into resident text as if the gap were absent.  It lives here, with the
                                ;     pointer row it reads.
                                ;   * single-level undo ('u'), captured inside the primitives that change text.
                                ;   * LNDLT/RDGET, the cursor-line tracking the renderer reads.
                                ;============================================================
                                
  0000                          WBOOT	EQU	0		; CP/M warm boot
  0005                          BDOS	EQU	5		; BDOS entry
  0006                          MEMTOP	EQU	6		; word here = BDOS base (top of usable TPA)
  001A                          EOF	EQU	1AH		; ^Z
  000A                          LF	EQU	0AH
  000D                          CR	EQU	0DH
  0008                          BS	EQU	08H
  0009                          TAB	EQU	09H
  001B                          ESC	EQU	1BH
  001E                          SRMAX	EQU	30		; the longest search pattern ('/' line)
  0D80                          RESVMEM EQU	0D80H		; WM 25: the arena QROOM keeps free past
                                				;   the Q-buffer
                                
                                ;--- Primitives the exerciser / editor calls (all WordMaster names). ----------
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                                	PUBLIC	BINIT
                                	PUBLIC	INSBLK, INSCNT, INSSTR, PUTGAP, DELTO
                                	PUBLIC	PUTCUR, PEEKL, PEEKLX
                                	PUBLIC	BUFSUM, PRSPAN, AFTLEN, SPANBC
                                
                                ;--- The (base,limit) pointer row + arena bounds it reads/reports. ------------
                                	PUBLIC	BUFBEG, QBEG, QEND, TXTBAS
                                	PUBLIC	TXTBEG, GAPBEG, GAPEND, TXTEND, BUFEND
                                	PUBLIC	PBEGMEM, ERRFLG
                                
                                ;--- The Q-buffer: the vi layer's yank register.  WM.ASM 1528-1600. ----------
                                	PUBLIC	QCOPY, QGET, QKILL, QROOM, QPUTLN
                                	PUBLIC	QCPYN			 ; ... and the APPENDED copy that does not delete
                                
                                ;--- String search: the pattern and the two matchers.  WM.ASM 2035-2150. -----
                                	PUBLIC	MATCHF, MATCHB, FWDCNT, SUBLEN
                                	PUBLIC	SRCHBF, SRCHST, SRCMAX
                                
                                ;--- APPENDED pointer-free logical-offset API (see header; NOT WordMaster). ----
                                	PUBLIC	CUROFF, LOGLEN, CHARAT, GOTO, LFCNT
                                	PUBLIC	DELFWD, DELPRV, UNDELF
                                
                                ;--- APPENDED single-level undo ('u'; NOT WordMaster -- WM has none). ---------
                                	PUBLIC	UNDBEG, UNDO, UNDRPL
                                	PUBLIC	UNDHER			 ; ... where the next change starts
                                	PUBLIC	UNDINS			 ; ... a block insert, for 'u'
                                	PUBLIC	UNDN, UNDST, UNDBAD	 ; ... and its state, for a probe
                                	PUBLIC	UNDWHY			 ; why UNDO refused (CMD.MAC's message)
                                	PUBLIC	UNDNEW			 ; ... and the change it captured
                                	PUBLIC	UNDCUR			 ; where 'u' puts the cursor back
                                	PUBLIC	UBEG, UEND		 ; ... and the region's bounds
                                
                                ;--- Helpers PAGE.MAC (the file-I/O layer) links against. ---------------------
                                ;NOTE: only 6 characters of a name are significant, so SUBCP2 is named to
                                ;stay clear of the local SUBCLP rather than being SUBCLP2.  PUTHOLE -> PUTHOL
                                ;is safe: no local PUTHOL, and PAGE.MAC's EXTRN
                                ;truncates identically.
                                	PUBLIC	MEMCPY, CMP16, LDHLI, PUTHOLE
                                	PUBLIC	SUBHD, POPRET, ERRMSG, SUBCP2
                                
                                ;--- The disk seam, in PAGE.MAC.  MKGAP calls MKROOM; CKLOW
                                ;    calls REWIND; INSBLK calls MARKGB and SETGAPB/DELTO call UPDMARK. ----------
                                	EXTRN	MKROOM, REWIND, UPDMARK, MARKGB
                                	EXTRN	PAGEDIR			; PAGE.MAC -- page one step (PAGESTP falls in)
                                	EXTRN	CNTTST			; CMD.MAC  -- count-exhausted test (PAGESTP)
                                
                                ;--- Line move (WM MVLMAX..SETBWD, GOLINE, SCRLST) -- the vi layer's paging nav.
                                	PUBLIC	MVLMAX, MVLIND, SETBWD, CLRCNT
                                	PUBLIC	GOLINE			; WM 2228 -- CMD.MAC pages to a mark with it
                                	PUBLIC	SCRLST			; WM 4307 -- the search sweep's page step
                                	PUBLIC	SETC0			; WM 1054 -- the line kill's count set
                                	EXTRN	CMDCNT			; CMD.MAC  -- WM CMDCNT
                                	EXTRN	AUXCNT, NEWFIL, DIRFLG	; PAGE.MAC -- WM L271E / NEWFIL / DIRFLG
                                	EXTRN	MOREIN, POLLBRK		; PAGE.MAC -- WM 4743 / WM 6199
                                	EXTRN	PGTOPM			; PAGE.MAC -- the paged-window signature
                                	EXTRN	DISCRD			; PAGE.MAC -- drop the work files (ERRMSG)
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                                	PUBLIC	ERRHK			; VI.MAC   -- ERRMSG's screen hook
                                	PUBLIC	EDTHK			; VI.MAC   -- UNDCHG's hook for the marks
                                	EXTRN	KBPOLL			; KEY.MAC  -- WM GETKEY (type-ahead drain)
                                	EXTRN	UNDREC, RSVTOP		; RSV.MAC  -- the captured change, and the
                                					;   top of the reserve block = arena base
                                
                                ;--- Screen reads (WM LINPOSB/LINEPOS, RGET0/RGET) -- the renderer's text access.
                                	PUBLIC	LINPSB, RGET0, RGET
                                	EXTRN	PAGEWIN			; PAGE.MAC -- WM 4350 (LINEPOS pages back)
                                	EXTRN	NEEDIN			; PAGE.MAC -- WM 4617 (RGET pages in)
                                
                                ;--- APPENDED (NOT WordMaster): cursor line tracking for the renderer. ----------
                                	PUBLIC	LNDLT, RDGET
                                
  0000'                         	CSEG
                                
                                ;============================================================
                                ; INIT -- WM.ASM 341-364 (pointer row) + 378-388 (BUFEND from the TPA top).
                                ; Aims every region base at PBEGMEM, writes the 0 sentinel at PBEGMEM, sets
                                ; TXTBAS = PBEGMEM+1, collapses the gap pointers onto TXTBAS, then sets BUFEND
                                ; from the word at 0006.  (WM's PGCONST tail runs from PAGE.MAC's OPENFIL.)
                                ;============================================================
  0000'                         BINIT:				; WM 341
  0000'   2A 0A7A'              	LHLD	PBEGMEM
  0003'   EB                    	XCHG
  0004'   21 0A1F'              	LXI	H,BUFBEG
  0007'   3E 04                 	MVI	A,4
  0009'                         INIBAS:				 ; WM 346 -- copy PBEGMEM into each region base
  0009'   73                    	MOV	M,E
  000A'   23                    	INX	H
  000B'   72                    	MOV	M,D
  000C'   23                    	INX	H
  000D'   3D                    	DCR	A
  000E'   C2 0009'              	JNZ	INIBAS
  0011'   AF                    	XRA	A
  0012'   12                    	STAX	D		; [PBEGMEM] = 0  (the sentinel)
  0013'   13                    	INX	D
  0014'   EB                    	XCHG
  0015'   22 0A27'              	SHLD	TXTBAS		; TXTBAS = PBEGMEM+1
  0018'                         INIGAP:				 ; WM 359 -- reset the gap pointers to TXTBAS
  0018'   2A 0A27'              	LHLD	TXTBAS
  001B'   22 0A29'              	SHLD	UBEG		; (appended) the undo region, empty, below the
  001E'   22 0A2B'              	SHLD	UEND		;   text -- see the UNDO section
  0021'   CD 073B'              	CALL	UNDCLR		; ... and nothing to undo into it yet
  0024'   2A 0A27'              	LHLD	TXTBAS
  0027'   22 0A2D'              	SHLD	TXTBEG
  002A'   22 0A2F'              	SHLD	GAPBEG
  002D'   22 0A31'              	SHLD	GAPEND
  0030'   22 0A33'              	SHLD	TXTEND
  0033'   2A 0006               	LHLD	MEMTOP		; WM 378 -- word@0006 = BDOS base
  0036'   7D                    	MOV	A,L
  0037'   FE 06                 	CPI	6H
  0039'   CA 0040'              	JZ	INITOP
  003C'   7C                    	MOV	A,H
  003D'   D6 07                 	SUI	7H		; back off 7 pages below BDOS
  003F'   67                    	MOV	H,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


  0040'                         INITOP:				 ; WM 386
  0040'   2B                    	DCX	H
  0041'   22 0A35'              	SHLD	BUFEND		; top of usable text RAM
  0044'   C9                    	RET
                                
                                ;============================================================
                                ; INSERT -- WM.ASM 1744-1941
                                ;============================================================
                                
                                ;PUTGAP -- WM 1744: ensure a free gap byte (GAPRSV), store A at the gap,
                                ;advance and record GAPBEG (SETGAPB -> UPDMARK).
  0045'                         PUTGAP:				; WM 1744
  0045'   F5                    	PUSH	PSW
  0046'   CD 009D'              	CALL	GAPRSV
  0049'   CD 05A1'              	CALL	LDHLI
  004C'   F1                    	POP	PSW
  004D'   77                    	MOV	M,A
  004E'   23                    	INX	H
  004F'   CD 0055'              	CALL	SETGAPB
  0052'   C3 09AC'              	JMP	UNDPUT		; (appended) that byte, for 'u'
                                
                                ;SETGAPB -- WM 1629: store GAPBEG, then UPDMARK.
  0055'                         SETGAPB:			; WM 1629
  0055'   22 0A2F'              	SHLD	GAPBEG
  0058'   CD 0000*              	CALL	UPDMARK
  005B'   C9                    	RET
                                
                                ;INSBLK -- WM 1853: splice BC bytes at [DE] into the text at the cursor.
                                ;INSCNT -- WM 1842: insert C bytes (from [DE]) at HL.
  005C'                         INSCNT:				; WM 1842
  005C'   4F                    	MOV	C,A
  005D'   06 00                 	MVI	B,0H
  005F'   C3 0065'              	JMP	INSCOM
  0062'                         INSBLK:				; WM 1853
  0062'   21 0A2F'              	LXI	H,GAPBEG
  0065'                         INSCOM:				 ; WM 1856
  0065'   CD 0000*              	CALL	MARKGB
  0068'   CD 00D5'              	CALL	CKLEN
  006B'   C8                    	RZ
  006C'                         INSLP:				; WM 1861 -- make gap room, copy a chunk
  006C'   CD 00B0'              	CALL	MKGAP
  006F'   CD 0087'              	CALL	CPYGAP
  0072'   05                    	DCR	B
  0073'   C2 006C'              	JNZ	INSLP
  0076'   B7                    	ORA	A
  0077'   C9                    	RET
                                
                                ;INSSTR -- WM 1848: splice a LENGTH-PREFIXED string into the text at the
                                ;cursor -- the length byte with its string just above it, which is the shape
                                ;WM's RDSTR leaves a string in (and SRCHBF/SRCHST here).  WM hardwires its one
                                ;string buffer, SRCHBUF; this takes the pointer in DE, because ':s' keeps its
                                ;replacement in its own.  Empty inserts nothing.  The 'u' capture goes with it:
                                ;INSBLK carries no hook of its own, so every caller would otherwise have to
                                ;remember, as QGET does by hand.
  0078'                         INSSTR:				; WM 1848
  0078'   1A                    	LDAX	D		; the length, just below the string (WM 1849)
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  0079'   13                    	INX	D
  007A'   B7                    	ORA	A
  007B'   C8                    	RZ
  007C'   4F                    	MOV	C,A
  007D'   06 00                 	MVI	B,0
  007F'   C5                    	PUSH	B		; the length, for the 'u' capture
  0080'   CD 0062'              	CALL	INSBLK
  0083'   C1                    	POP	B
  0084'   C3 09BF'              	JMP	UNDINS
                                
                                ;CPYGAP -- WM 1870: copy C bytes [DE]->gap (masking bit 7), advance the ptr.
  0087'                         CPYGAP:				; WM 1870
  0087'   E5                    	PUSH	H
  0088'   CD 05A1'              	CALL	LDHLI
  008B'                         CPYGLP:				 ; WM 1874
  008B'   1A                    	LDAX	D
  008C'   E6 7F                 	ANI	7FH
  008E'   77                    	MOV	M,A
  008F'   13                    	INX	D
  0090'   23                    	INX	H
  0091'   0D                    	DCR	C
  0092'   C2 008B'              	JNZ	CPYGLP
  0095'   EB                    	XCHG
  0096'   E3                    	XTHL
  0097'   73                    	MOV	M,E
  0098'   23                    	INX	H
  0099'   72                    	MOV	M,D
  009A'   2B                    	DCX	H
  009B'                         CPYGDN:				 ; WM 1889
  009B'   D1                    	POP	D
  009C'   C9                    	RET
                                
                                ;GAPRSV -- WM 1896: guarantee at least one free gap byte before an insert.
  009D'                         GAPRSV:				; WM 1896
  009D'   D5                    	PUSH	D
  009E'   2A 0A2F'              	LHLD	GAPBEG
  00A1'   EB                    	XCHG
  00A2'   2A 0A31'              	LHLD	GAPEND
  00A5'   CD 05A6'              	CALL	CMP16
  00A8'   D1                    	POP	D
  00A9'   21 0A2F'              	LXI	H,GAPBEG
  00AC'   D8                    	RC
  00AD'                         MKGAPB:				; WM 1907
  00AD'   21 0A2F'              	LXI	H,GAPBEG
                                
                                ;MKGAP -- WM 1913: enlarge the gap when empty; relocate text (MOVGAP) or, when
                                ;RAM is full, page out via MKROOM; 'MEM FULL' if no room can be made.
  00B0'                         MKGAP:				; WM 1913
  00B0'   C5                    	PUSH	B
  00B1'   D5                    	PUSH	D
  00B2'   E5                    	PUSH	H
  00B3'                         MKGAPL:				; WM 1919
  00B3'   CD 04D4'              	CALL	PRSPAN
  00B6'   78                    	MOV	A,B
  00B7'   B7                    	ORA	A
  00B8'   C2 05D3'              	JNZ	POPRET
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  00BB'   CD 046E'              	CALL	BUFSUM
  00BE'   7A                    	MOV	A,D
  00BF'   B7                    	ORA	A
  00C0'   C2 0425'              	JNZ	MOVGAP
  00C3'   CD 0000*              	CALL	MKROOM
  00C6'   D2 00B3'              	JNC	MKGAPL
  00C9'   CD 05E4'              	CALL	ERRMSG
  00CC'   4D 45 4D 20           	DB	'MEM FULL',0H
  00D0'   46 55 4C 4C           
  00D4'   00                    
                                
                                ;CKLEN -- WM 1934: set up the chunked-copy B/C counters; Z if count is zero.
  00D5'                         CKLEN:				; WM 1934
  00D5'   CD 0562'              	CALL	CKCOPY
  00D8'   04                    	INR	B
  00D9'   0C                    	INR	C
  00DA'   0D                    	DCR	C
  00DB'   C0                    	RNZ
  00DC'   05                    	DCR	B
  00DD'   C9                    	RET
                                
                                ;============================================================
                                ; Q-BUFFER -- WM.ASM 1528-1600.  A SECOND gap buffer (QBEG..QEND, with QEND as
                                ; its insertion point) that WordMaster grows through the same MKGAP machinery as
                                ; the text.  The vi layer uses it as the yank register: QCOPY fills it, deleting
                                ; what it takes (which is what makes 'dd' fill the register), QGET copies it
                                ; back into the text at the cursor ('p'), QKILL empties it.
                                ;
                                ; The register is NOT a fixed block -- it is a region of the arena, so its
                                ; ceiling is QROOM's: everything but RESVMEM, with the text free to page out
                                ; from underneath it.  Overflow raises 'QBUF FULL' from INSIDE QCOPY's chunk
                                ; loop, which leaves what has already moved in the register and gone from the
                                ; text, so text + register is conserved and a put gives back exactly what was
                                ; taken.
                                ;============================================================
                                
                                ;QROOM -- WM 1594: 'QBUF FULL' unless the arena still holds RESVMEM beyond the
                                ;Q-buffer.  The TEXT is not counted against it: the text pages out to make room.
  00DE'                         QROOM:				; WM 1594
  00DE'   C5                    	PUSH	B
  00DF'   D5                    	PUSH	D
  00E0'   E5                    	PUSH	H
  00E1'   21 0A21'              	LXI	H,QBEG
  00E4'   CD 04D4'              	CALL	PRSPAN
  00E7'   2A 0A1F'              	LHLD	BUFBEG
  00EA'   EB                    	XCHG
  00EB'   2A 0A35'              	LHLD	BUFEND
  00EE'   CD 0588'              	CALL	SUBHD
  00F1'   CD 057D'              	CALL	NEGBC
  00F4'   09                    	DAD	B
  00F5'   11 0D80               	LXI	D,RESVMEM
  00F8'   CD 05A6'              	CALL	CMP16
  00FB'   DA 05D3'              	JC	POPRET
  00FE'   CD 05E4'              	CALL	ERRMSG
  0101'   51 42 55 46           	DB	'QBUF FULL',0H
  0105'   20 46 55 4C           
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  0109'   4C 00                 
                                
                                ;QCOPY -- WM 1563: copy the span BC out of the text into the Q-buffer whose
                                ;insertion pointer is at HL, DELETING it as it goes.  The source is re-read from
                                ;GAPEND on every chunk because MKGAP may MOVGAP between chunks (and that fixes up
                                ;only the pointer row) or MKROOM (which pages the text out entirely), so no raw
                                ;source pointer would survive the loop -- GAPEND is safe precisely BECAUSE the
                                ;delete advances it.
  010B'                         QCOPY:				; WM 1563
  010B'   CD 00D5'              	CALL	CKLEN
  010E'   C8                    	RZ
  010F'                         QCPYLP:				; WM 1566
  010F'   CD 00B0'              	CALL	MKGAP
  0112'   CD 00DE'              	CALL	QROOM
  0115'   EB                    	XCHG
  0116'   2A 0A31'              	LHLD	GAPEND
  0119'   EB                    	XCHG
  011A'   CD 0087'              	CALL	CPYGAP
  011D'   EB                    	XCHG
  011E'   22 0A31'              	SHLD	GAPEND		; the gap swallows the source: THIS is the delete
  0121'   EB                    	XCHG
  0122'   CD 0000*              	CALL	UPDMARK
  0125'   05                    	DCR	B
  0126'   C2 010F'              	JNZ	QCPYLP
  0129'   C9                    	RET
                                
                                ;QCPYN -- APPENDED (NOT WordMaster): copy BC bytes forward from the cursor into
                                ;the Q-buffer WITHOUT taking them out of the text.  This is the verb WordMaster
                                ;has no need of: QCOPY above copies by DELETING, and can re-read its source
                                ;from GAPEND on every chunk precisely BECAUSE the delete advances GAPEND past
                                ;what it has taken.  A copy that leaves the text alone has no such pointer --
                                ;MKGAP may MOVGAP between chunks, which relocates the text and fixes up only
                                ;the pointer row.
                                ;
                                ;What survives MOVGAP is a COUNT, so that is what this keeps: the source is
                                ;GAPEND plus the bytes already moved, worked out afresh each chunk.  What no
                                ;count survives is MKGAP reaching MKROOM -- a spill writes resident text out to
                                ;disk and the source is then not in RAM at all -- so the CALLER must show there
                                ;is room for the whole copy before calling (CMD.MAC's YNROOM: the span plus a
                                ;chunk's slack, free).  With that held every MKGAP here finds 256 bytes free
                                ;and relocates rather than pages.
                                ;
                                ;The text is not touched: no delete, no UPDMARK, and nothing for 'u' to capture.
                                ;The caller is expected to have QKILLed: this appends, as QCOPY does.
  012A'                         QCPYN:				; (appended) BC = the span at the cursor
  012A'   21 0000               	LXI	H,0
  012D'   22 0A5B'              	SHLD	QCPDON		; nothing of it has gone in yet
  0130'   CD 00D5'              	CALL	CKLEN		; B = chunks, C = the first chunk's length
  0133'   CA 015F'              	JZ	QCPYND		; an empty span: nothing to do
  0136'                         QCPYNL:
  0136'   21 0A23'              	LXI	H,QEND
  0139'   CD 00B0'              	CALL	MKGAP		; room for a chunk above the register
  013C'   CD 00DE'              	CALL	QROOM		; ... and the register's own ceiling
  013F'   2A 0A5B'              	LHLD	QCPDON		; where this chunk's source lies NOW
  0142'   EB                    	XCHG
  0143'   2A 0A31'              	LHLD	GAPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  0146'   19                    	DAD	D
  0147'   EB                    	XCHG			; DE = the source
  0148'   21 0A23'              	LXI	H,QEND
  014B'   CD 0087'              	CALL	CPYGAP		; C bytes [DE] -> the register, QEND advanced
  014E'   EB                    	XCHG			; HL = the source past the chunk
  014F'   E5                    	PUSH	H
  0150'   2A 0A31'              	LHLD	GAPEND		; (re-read: CPYGAP cannot have moved it, but the
  0153'   EB                    	XCHG			;   next pass's MKGAP can, so the COUNT is what
  0154'   E1                    	POP	H		;   is kept)
  0155'   CD 0588'              	CALL	SUBHD		; HL = what has gone in altogether
  0158'   22 0A5B'              	SHLD	QCPDON
  015B'   05                    	DCR	B
  015C'   C2 0136'              	JNZ	QCPYNL
  015F'                         QCPYND:
  015F'   B7                    	ORA	A		; NC, and it has to be SAID: the last thing through
  0160'   C9                    	RET			;   here was SUBHD, whose DAD leaves the carry set,
                                				;   and the caller reads the carry to tell a copy
                                				;   that ran from one that could not
                                
                                ;QGET -- WM 1541: splice the whole Q-buffer into the text at the cursor.
  0161'                         QGET:				; WM 1541
  0161'   21 0A21'              	LXI	H,QBEG
  0164'   CD 04D4'              	CALL	PRSPAN
  0167'   C5                    	PUSH	B		; (appended) the length, for the 'u' capture
  0168'   CD 05A1'              	CALL	LDHLI
  016B'   EB                    	XCHG
  016C'   CD 0062'              	CALL	INSBLK
  016F'   C1                    	POP	B
  0170'   C3 09BF'              	JMP	UNDGET		; (appended) the register just put in, for 'u'
                                
                                ;QKILL -- WM 1529: empty the Q-buffer (QEND := QBEG).
  0173'                         QKILL:				; WM 1529
  0173'   2A 0A21'              	LHLD	QBEG
  0176'   22 0A23'              	SHLD	QEND
  0179'   C9                    	RET
                                
                                ;QPUTLN -- WM 1552: take the line at the cursor into the Q-buffer, DELETING it.
                                ;This is WM's QPUT loop body without its own CNTTST loop, because the vi layer
                                ;runs the count (VD_DD does exactly that).               GOLINE finds where the
                                ;line ends, SPANBC measures from the gap to there, QCOPY takes that span, HOLEQ
                                ;slides the hole above the Q-buffer back out of the way, and PAGESTP advances
                                ;the window a step -- so a count runs past the resident window, as dd's does.
                                ;Ends on PAGESTP exactly as DELTO does, so the caller's CNTTST loop is the same.
  017A'                         QPUTLN:				; WM 1552
  017A'   21 0A23'              	LXI	H,QEND
  017D'   CD 00B0'              	CALL	MKGAP
  0180'   CD 022F'              	CALL	GOLINE
  0183'   EB                    	XCHG
  0184'   2A 0A31'              	LHLD	GAPEND
  0187'   EB                    	XCHG
  0188'   CD 0591'              	CALL	SPANBC
  018B'   CD 09E9'              	CALL	UNDDLQ		; (appended) those lines, for 'u', before they go
  018E'   21 0A23'              	LXI	H,QEND
  0191'   CD 010B'              	CALL	QCOPY
  0194'   CD 0492'              	CALL	HOLEQ
  0197'   C3 05DD'              	JMP	PAGESTP
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


                                
                                ;============================================================
                                ; PROBE / DELETE -- WM.ASM 991-1001, 1790-1829
                                ;============================================================
                                
                                ;CKLOW -- WM 1790: CY if HL is below TXTBEG (pages back via REWIND when paged).
  019A'                         CKLOW:				; WM 1790
  019A'   EB                    	XCHG
  019B'   2A 0A2D'              	LHLD	TXTBEG
  019E'   CD 05A6'              	CALL	CMP16
  01A1'   EB                    	XCHG
  01A2'   D0                    	RNC
  01A3'   EB                    	XCHG
  01A4'   2A 0A2F'              	LHLD	GAPBEG
  01A7'   CD 0587'              	CALL	SUBDH
  01AA'   E5                    	PUSH	H
  01AB'   CD 0000*              	CALL	REWIND
  01AE'   2A 0A2F'              	LHLD	GAPBEG
  01B1'   D1                    	POP	D
  01B2'   F5                    	PUSH	PSW
  01B3'   19                    	DAD	D
  01B4'   F1                    	POP	PSW
  01B5'   C9                    	RET
                                
                                ;PEEKL -- WM 1812: char immediately left of the cursor (GAPBEG-1) into A;
                                ;CY (A=0) at TXTBEG.
  01B6'                         PEEKL:				; WM 1812
  01B6'   2A 0A2F'              	LHLD	GAPBEG
  01B9'   2B                    	DCX	H
  01BA'   D5                    	PUSH	D
  01BB'   CD 019A'              	CALL	CKLOW
  01BE'   D1                    	POP	D
  01BF'   D8                    	RC
  01C0'   7E                    	MOV	A,M
  01C1'   B7                    	ORA	A
  01C2'   C9                    	RET
                                
                                ;PEEKLX -- WM 1824: PEEKL; on edge (CY) drop the caller's return address.
  01C3'                         PEEKLX:				; WM 1824
  01C3'   CD 01B6'              	CALL	PEEKL
  01C6'   D0                    	RNC
  01C7'   33                    	INX	SP
  01C8'   33                    	INX	SP
  01C9'   C9                    	RET
                                
                                ;DELTO -- WM 991: swallow the cursor..HL span into the gap (extend GAPBEG
                                ;backward when S set, GAPEND forward otherwise), then UPDMARK + page.
  01CA'                         DELTO:				; WM 991
  01CA'   FA 01D3'              	JM	DELBK
  01CD'   22 0A31'              	SHLD	GAPEND
  01D0'   C3 01D6'              	JMP	DELUPD
  01D3'                         DELBK:				; WM 996 -- backward delete
  01D3'   22 0A2F'              	SHLD	GAPBEG
  01D6'                         DELUPD:				 ; WM 999
  01D6'   CD 0000*              	CALL	UPDMARK
  01D9'   C3 05DD'              	JMP	PAGESTP
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


                                
                                ;============================================================
                                ; LINE MOVE -- WM.ASM 1007-1042 (MVLMAX..SETBWD), verbatim.
                                ; CMDCNT/DIRFLG in, loop GOLINE + SCRLST until CNTTST says the count is spent,
                                ; so the cursor moves AND the window pages with it (whole file with FFFFH).
                                ;============================================================
                                
                                ;MVLMAX -- WM 1008: move to the far end (A = direction, count = FFFFH).
  01DC'                         MVLMAX:				; WM 1008
  01DC'   21 FFFF               	LXI	H,0FFFFH
                                ;MVLIND -- WM 1012: DIRFLG = A, CMDCNT = HL, then move lines.
  01DF'                         MVLIND:			       ; WM 1012
  01DF'   32 0000*              	STA	DIRFLG
                                ;MVLINS -- WM 1016: CMDCNT = HL, then move that many lines.
  01E2'                         MVLINS:			       ; WM 1016
  01E2'   22 0000*              	SHLD	CMDCNT
                                ;MVLLOOP -- WM 1020: GOLINE + SCRLST until the line count runs out.
  01E5'                         MVLLOOP:			; WM 1020
  01E5'   CD 022F'              	CALL	GOLINE
  01E8'   CD 05D7'              	CALL	SCRLST
  01EB'   CD 0000*              	CALL	CNTTST
  01EE'   C2 01E5'              	JNZ	MVLLOOP
  01F1'   C9                    	RET
                                
                                
                                ;(WM 1045, the line kill -- GOLINE + DELTO -- is not carried: 'dd' takes its
                                ;lines through QPUTLN, and nothing called it.)
                                
                                ;SETC0 -- WM 1054: CMDCNT = HL, forward (DIRFLG = 0).
  01F2'                         SETC0:				; WM 1054
  01F2'   AF                    	XRA	A
                                ;SETCNT -- WM 1058: CMDCNT = HL, DIRFLG = A, clear L271E.
  01F3'                         SETCNT:				; WM 1058
  01F3'   32 0000*              	STA	DIRFLG
  01F6'   AF                    	XRA	A
  01F7'   32 0000*              	STA	AUXCNT
  01FA'   22 0000*              	SHLD	CMDCNT
  01FD'   C9                    	RET
                                
                                ;CLRCNT -- WM 1142: clear the command count and direction.  WM runs it on
                                ;every command-mode command (and on ESC out of video), so a save never
                                ;inherits a backward DIRFLG from the last motion.
  01FE'                         CLRCNT:				; WM 1142
  01FE'   E5                    	PUSH	H
  01FF'   21 0000               	LXI	H,0H
  0202'   CD 01F2'              	CALL	SETC0
  0205'   E1                    	POP	H
  0206'   C9                    	RET
                                
                                ;SETBWD -- WM 1039: backward move of HL lines (DIRFLG = FFH), then MVLIND.
  0207'                         SETBWD:				; WM 1039
  0207'   3E FF                 	MVI	A,0FFH
  0209'   FE AF                 	CPI	0AFH
  020B'   C3 01DF'              	JMP	MVLIND
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


                                ; LINE SCAN -- WM.ASM 2224-2410 (GOLINE, NLFWD/SCANF, NLBACK/SCANB, WCMATCH,
                                ; ISWBRK/ISALNUM), verbatim.  Leaves ISDIGIT (WM 5862), UPCASE (WM 825) and
                                ; ISWHITE (WM 6011) follow.  WM's CALL GETKEY (type-ahead drain) is KBPOLL
                                ; here: KEY.MAC owns the ring and its GETKEY is the blocking vi decoder.
                                ;============================================================
                                
                                ;LINPOSB -- WM 2199: HL lines back, count set by SETCNT (backward), then
                                ;LINEPOS.  The renderer uses it to find the top line of the screen.
  020E'                         LINPOSB:			; WM 2199
  020E'   3E FF                 	MVI	A,0FFH
  0210'   CD 01F3'              	CALL	SETCNT
                                ;LINEPOS -- WM 2204: GOLINE; when the count is not spent, PAGEWIN and scan
                                ;once more with the original count.  HL = the line start; CY = partial.
  0213'                         LINEPOS:			; WM 2204
  0213'   D5                    	PUSH	D
  0214'   2A 0000*              	LHLD	CMDCNT
  0217'   E5                    	PUSH	H
  0218'   CD 022F'              	CALL	GOLINE
  021B'   D1                    	POP	D
  021C'   D2 009B'              	JNC	CPYGDN
  021F'   F5                    	PUSH	PSW
  0220'   CD 0000*              	CALL	PAGEWIN
  0223'   D2 0229'              	JNC	LNPSTO
  0226'   F1                    	POP	PSW
  0227'   D1                    	POP	D
  0228'   C9                    	RET
  0229'                         LNPSTO:				 ; WM 2218 -- store the count, rescan (falls in)
  0229'   F1                    	POP	PSW
  022A'   EB                    	XCHG
  022B'   22 0000*              	SHLD	CMDCNT
  022E'   D1                    	POP	D
                                
  020E'                         LINPSB	EQU	LINPOSB		; 6-char export alias (LINPOSB/LINEPOS share LINPOS)
                                
                                ;GOLINE -- WM 2228: move CMDCNT lines from the cursor (NLFWD forward,
                                ;NLBACK backward).  Returns HL = target; CY if the count is not exhausted
                                ;(the window must page and the scan continue).
  022F'                         GOLINE:				; WM 2228
  022F'   C5                    	PUSH	B
  0230'   D5                    	PUSH	D
  0231'   2A 0000*              	LHLD	CMDCNT
  0234'   EB                    	XCHG
  0235'   21 0000*              	LXI	H,DIRFLG
  0238'   7A                    	MOV	A,D
  0239'   B3                    	ORA	E
  023A'   C2 023E'              	JNZ	GOLDIR
  023D'   35                    	DCR	M
  023E'                         GOLDIR:				; WM 2239 -- forward: count newlines toward TXTEND
  023E'   7E                    	MOV	A,M
  023F'   B7                    	ORA	A
  0240'   FA 025A'              	JM	GOLBK
  0243'   CD 04D1'              	CALL	AFTLEN
  0246'   CD 05A1'              	CALL	LDHLI
  0249'                         GOLFLP:				; WM 2246 -- forward newline-count loop
  0249'   CD 02A8'              	CALL	NLFWD
  024C'   DA 0276'              	JC	GOLSWP
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  024F'   05                    	DCR	B
  0250'   0D                    	DCR	C
  0251'   1B                    	DCX	D
  0252'   7A                    	MOV	A,D
  0253'   B3                    	ORA	E
  0254'   C2 0249'              	JNZ	GOLFLP
  0257'   C3 0276'              	JMP	GOLSWP
  025A'                         GOLBK:				; WM 2257 -- backward: count newlines toward TXTBEG
  025A'   13                    	INX	D
  025B'   21 0A2D'              	LXI	H,TXTBEG
  025E'   CD 04D4'              	CALL	PRSPAN
  0261'   2A 0A2F'              	LHLD	GAPBEG
  0264'                         GOLBLP:				; WM 2263 -- backward newline-count loop
  0264'   CD 0000*              	CALL	KBPOLL		; WM: CALL GETKEY
  0267'   CD 02BF'              	CALL	NLBACK
  026A'   DA 02A1'              	JC	GOLBEX
  026D'   05                    	DCR	B
  026E'   0D                    	DCR	C
  026F'   1B                    	DCX	D
  0270'   7A                    	MOV	A,D
  0271'   B3                    	ORA	E
  0272'   C2 0264'              	JNZ	GOLBLP
  0275'   23                    	INX	H
  0276'                         GOLSWP:				; WM 2275 -- swap to the result pointer
  0276'   EB                    	XCHG
  0277'                         GOLFIN:				; WM 2278 -- store the position and remaining count
  0277'   AF                    	XRA	A
  0278'                         GOLAUX:				; WM 2281 -- store L271E; note if more input remains
  0278'   32 0000*              	STA	AUXCNT
  027B'   CD 0000*              	CALL	MOREIN
  027E'   C2 0287'              	JNZ	GOLSAV
  0281'   21 0000               	LXI	H,0H
  0284'   22 0000*              	SHLD	AUXCNT
  0287'                         GOLSAV:				; WM 2288 -- save CMDCNT and the target position
  0287'   22 0000*              	SHLD	CMDCNT
  028A'   EB                    	XCHG
  028B'   22 0A59'              	SHLD	L2756
  028E'   3A 0000*              	LDA	DIRFLG
  0291'   B7                    	ORA	A
  0292'   E5                    	PUSH	H
  0293'   21 FFFF               	LXI	H,0FFFFH
  0296'   19                    	DAD	D
  0297'   DA 05D3'              	JC	POPRET
  029A'   2A 0000*              	LHLD	NEWFIL		; H = AUXCNT low byte (PAGE.MAC keeps WM's adjacency)
  029D'   29                    	DAD	H
  029E'   C3 05D3'              	JMP	POPRET
  02A1'                         GOLBEX:				; WM 2302 -- step back one and retry the backward count
  02A1'   1B                    	DCX	D
  02A2'   EB                    	XCHG
  02A3'   3E FF                 	MVI	A,0FFH
  02A5'   C3 0278'              	JMP	GOLAUX
                                
                                ;NLFWD -- WM 2309: scan forward to the next newline.
  02A8'                         NLFWD:				; WM 2309
  02A8'   3E 0A                 	MVI	A,LF
                                ;SCANF -- WM 2313: scan forward over BC bytes for a char (wildcard-aware).
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  02AA'                         SCANF:				; WM 2313
  02AA'   04                    	INR	B
  02AB'   0C                    	INR	C
  02AC'   C3 02B5'              	JMP	SCFCNT
  02AF'                         SCFCMP:				; WM 2318
  02AF'   BE                    	CMP	M
  02B0'   C4 02D6'              	CNZ	WCMATCH
  02B3'   23                    	INX	H
  02B4'   C8                    	RZ
  02B5'                         SCFCNT:				; WM 2324
  02B5'   0D                    	DCR	C
  02B6'   C2 02AF'              	JNZ	SCFCMP
  02B9'   05                    	DCR	B
  02BA'   C2 02AF'              	JNZ	SCFCMP
  02BD'   37                    	STC
  02BE'   C9                    	RET
                                
                                ;NLBACK -- WM 2333: scan backward to a newline.
  02BF'                         NLBACK:				; WM 2333
  02BF'   3E 0A                 	MVI	A,LF
                                ;SCANB -- WM 2337: scan backward over BC bytes for a char.
  02C1'                         SCANB:				; WM 2337
  02C1'   04                    	INR	B
  02C2'   0C                    	INR	C
  02C3'   C3 02CC'              	JMP	SCBCNT
  02C6'                         SCBCMP:				; WM 2342
  02C6'   2B                    	DCX	H
  02C7'   BE                    	CMP	M
  02C8'   C4 02D6'              	CNZ	WCMATCH
  02CB'   C8                    	RZ
  02CC'                         SCBCNT:				; WM 2348
  02CC'   0D                    	DCR	C
  02CD'   C2 02C6'              	JNZ	SCBCMP
  02D0'   05                    	DCR	B
  02D1'   C2 02C6'              	JNZ	SCBCMP
  02D4'   37                    	STC
  02D5'   C9                    	RET
                                
                                ;WCMATCH -- WM 2363: match one search wildcard (^A any, ^S separator,
                                ;^O not-next) against [HL].  Z on a match.
  02D6'                         WCMATCH:			; WM 2363
  02D6'   FE 13                 	CPI	13H
  02D8'   CA 02F2'              	JZ	WCSEP
  02DB'   D0                    	RNC
  02DC'   FE 01                 	CPI	1H
  02DE'   C8                    	RZ
  02DF'   FE 0F                 	CPI	0FH
  02E1'   C0                    	RNZ
  02E2'   13                    	INX	D
  02E3'   1A                    	LDAX	D
  02E4'   1B                    	DCX	D
  02E5'   B7                    	ORA	A
  02E6'   CA 02F0'              	JZ	WCYES
  02E9'   BE                    	CMP	M
  02EA'   3E 0F                 	MVI	A,0FH
  02EC'   CA 02FB'              	JZ	WCNO
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02EF'   13                    	INX	D
  02F0'                         WCYES:				; WM 2381 -- report a match
  02F0'   BF                    	CMP	A
  02F1'   C9                    	RET
  02F2'                         WCSEP:				; WM 2385 -- ^S: match a non-alphanumeric
  02F2'   7E                    	MOV	A,M
  02F3'   CD 0302'              	CALL	ISALNUM
  02F6'   3E 13                 	MVI	A,13H
  02F8'   D2 02F0'              	JNC	WCYES
  02FB'                         WCNO:				; WM 2391 -- report a mismatch
  02FB'   B7                    	ORA	A
  02FC'   C9                    	RET
                                
                                ;ISWBRK -- WM 2396: whitespace or non-alphanumeric word-break test.
  02FD'                         ISWBRK:				; WM 2396
  02FD'   CD 0320'              	CALL	ISWHITE
  0300'   37                    	STC
  0301'   C8                    	RZ
                                ;ISALNUM -- WM 2402: carry set iff A is a letter or digit.
  0302'                         ISALNUM:			; WM 2402
  0302'   CD 0310'              	CALL	ISDIGIT
  0305'   D8                    	RC
  0306'   CD 0317'              	CALL	UPCASE
  0309'   FE 41                 	CPI	'A'
  030B'   3F                    	CMC
  030C'   D0                    	RNC
  030D'   FE 5B                 	CPI	'['
  030F'   C9                    	RET
                                
                                ;ISDIGIT -- WM 5862: carry set iff A is '0'..'9'.
  0310'                         ISDIGIT:			; WM 5862
  0310'   FE 30                 	CPI	'0'
  0312'   3F                    	CMC
  0313'   D0                    	RNC
  0314'   FE 3A                 	CPI	':'
  0316'   C9                    	RET
                                
                                ;UPCASE -- WM 825: fold A (a-z) to upper case.
  0317'                         UPCASE:				; WM 825
  0317'   FE 61                 	CPI	'a'
  0319'   D8                    	RC
  031A'   FE 7B                 	CPI	'{'
  031C'   D0                    	RNC
  031D'   E6 DF                 	ANI	0DFH
  031F'   C9                    	RET
                                
                                ;ISWHITE -- WM 6011: Z if A is TAB / space / LF / CR.
  0320'                         ISWHITE:			; WM 6011
  0320'   FE 09                 	CPI	TAB
  0322'   C8                    	RZ
  0323'   FE 20                 	CPI	' '
  0325'   C8                    	RZ
  0326'   FE 0A                 	CPI	LF
  0328'   C8                    	RZ
  0329'   FE 0D                 	CPI	CR
  032B'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


                                
                                ;============================================================
                                ; STRING SEARCH -- WM.ASM 2035-2150 (FWDCNT, SUBLEN/SUBHA, MATCHF, MATCHB),
                                ; verbatim.  These are the engine half of WM's find; the vi layer (CMD.MAC)
                                ; supplies the rest, because vi's search is not WordMaster's:
                                ;
                                ;   - WM reads the pattern off its command line with RDSTR (WM 1310) as part
                                ;     of the search itself.  vi prompts for it on the bottom row and keeps it
                                ;     for 'n', so SRCHBF is filled by CMD.MAC and RDSTR is not transcribed.
                                ;   - MATCHF leaves HL one PAST the match (WordMaster's find lands after the
                                ;     string); vi lands ON its first character, so CMD.MAC's forward search
                                ;     backs up over the pattern with SUBLEN.  MATCHB already returns the
                                ;     match's first character, so only the forward side needs it.
                                ;   - WM's SUBB/SUBS/SUBSA (find-and-replace) and INSREPL are NOT here: no
                                ;     ':s' yet.  ADDAHL and GBSUBL, which only they use, are left out too.
                                ;
                                ; The pattern is WM's layout: a length byte, then the string, 0-terminated.
                                ; DE points at the STRING (SRCHST), so FWDCNT reads the length from the byte
                                ; just below DE and SUBLEN from SRCHBF, exactly as WM does.
                                ;============================================================
                                
                                ;FWDCNT -- WM 2035: BC := the bytes of the pointer pair at HL that a match
                                ;could still start in -- its span, less the pattern length, plus one.  CY if
                                ;that went negative: the text is shorter than the pattern.  Keeps DE.
  032C'                         FWDCNT:				; WM 2035
  032C'   CD 04D4'              	CALL	PRSPAN
  032F'   03                    	INX	B
  0330'   1B                    	DCX	D
  0331'   1A                    	LDAX	D		; the length byte, just below the string
  0332'   13                    	INX	D
  0333'   C5                    	PUSH	B
  0334'   47                    	MOV	B,A
  0335'   79                    	MOV	A,C
  0336'   90                    	SUB	B
  0337'   C1                    	POP	B
  0338'   4F                    	MOV	C,A
  0339'   78                    	MOV	A,B
  033A'   DE 00                 	SBI	0H
  033C'   47                    	MOV	B,A
  033D'   C9                    	RET
                                
                                ;SUBLEN -- WM 2061: HL := HL - the pattern length.
  033E'                         SUBLEN:				; WM 2061
  033E'   3A 0A39'              	LDA	SRCHBF
                                
                                ;SUBHA -- WM 2063: HL := HL - A, unsigned.
  0341'                         SUBHA:				; WM 2063
  0341'   E5                    	PUSH	H
  0342'   67                    	MOV	H,A
  0343'   7D                    	MOV	A,L
  0344'   94                    	SUB	H
  0345'   E1                    	POP	H
  0346'   6F                    	MOV	L,A
  0347'   7C                    	MOV	A,H
  0348'   DE 00                 	SBI	0H
  034A'   67                    	MOV	H,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  034B'   C9                    	RET
                                
                                ;MATCHF -- WM 2089: find DE's string in the BC bytes from HL, forward.
                                ;SCANF finds each candidate first character (so the search wildcards work
                                ;through WCMATCH) and the loop compares the rest.  CY = not found; on a hit
                                ;HL is one past the match's LAST character and DE is the pattern again.
  034C'                         MATCHF:				; WM 2089
  034C'   1A                    	LDAX	D
  034D'   B7                    	ORA	A
  034E'   C8                    	RZ
  034F'   D5                    	PUSH	D
  0350'   CD 02AA'              	CALL	SCANF
  0353'   DA 0372'              	JC	MATCHX
  0356'   05                    	DCR	B
  0357'   0D                    	DCR	C
  0358'   E5                    	PUSH	H
  0359'                         MATCFL:				; WM 2102 -- the rest of the pattern
  0359'   13                    	INX	D
  035A'   1A                    	LDAX	D
  035B'   B7                    	ORA	A
  035C'   CA 0371'              	JZ	MATCFY
  035F'   BE                    	CMP	M
  0360'   23                    	INX	H
  0361'   CA 0359'              	JZ	MATCFL
  0364'   2B                    	DCX	H
  0365'   CD 02D6'              	CALL	WCMATCH
  0368'   23                    	INX	H
  0369'   CA 0359'              	JZ	MATCFL
  036C'   E1                    	POP	H		; that candidate failed: SCANF went one past
  036D'   D1                    	POP	D		;   it, so the retry cannot sit still
  036E'   C3 034C'              	JMP	MATCHF
  0371'                         MATCFY:				; WM 2116 -- matched: drop the saved pointer
  0371'   D1                    	POP	D
  0372'                         MATCHX:				; WM 2118 -- restore DE and return
  0372'   D1                    	POP	D
  0373'   C9                    	RET
                                
                                ;MATCHB -- WM 2124: the same, backward.  Unlike MATCHF this one returns HL
                                ;ON the match's FIRST character.  A match is only found while it lies wholly
                                ;inside the span, so one straddling the cursor is not seen (see CMD.MAC).
  0374'                         MATCHB:				; WM 2124
  0374'   1A                    	LDAX	D
  0375'   B7                    	ORA	A
  0376'   C8                    	RZ
  0377'   23                    	INX	H
  0378'                         MATCBS:				; WM 2128 -- back to the next candidate
  0378'   D5                    	PUSH	D
  0379'   1A                    	LDAX	D
  037A'   CD 02C1'              	CALL	SCANB
  037D'   DA 0372'              	JC	MATCHX
  0380'   05                    	DCR	B
  0381'   0D                    	DCR	C
  0382'   E5                    	PUSH	H
  0383'                         MATCBL:				; WM 2138 -- the rest of the pattern
  0383'   13                    	INX	D
  0384'   23                    	INX	H
