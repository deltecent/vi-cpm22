  03B4'   13                    	INX	D
  03B5'   23                    	INX	H
  03B6'   1A                    	LDAX	D
  03B7'   B7                    	ORA	A
  03B8'   CA 03C5'              	JZ	MATCBE
  03BB'   BE                    	CMP	M
  03BC'   CA 03B4'              	JZ	MATCBL
  03BF'   CD 0307'              	CALL	WCMATCH
  03C2'   CA 03B4'              	JZ	MATCBL
  03C5'                         MATCBE:				; WM 2149 -- A = 0 only when it matched
