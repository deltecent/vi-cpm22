  038F'   EB                    	XCHG
  0390'   11 0000*              	LXI	D,TXTBEG
  0393'   C3 03D4'              	JMP	GAPLF
  0396'                         PUTCRT:				; WM 2438 -- target after the gap -> slide right
  0396'   2A 0000*              	LHLD	GAPEND
