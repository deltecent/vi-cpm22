  05CA'   CD 05AC'              	CALL	CMP16
  05CD'   CA 05BE'              	JZ	SCLPZ
  05D0'   DA 05BE'              	JC	SCLPZ
  05D3'   EB                    	XCHG
  05D4'   CD 058E'              	CALL	SUBHD
  05D7'   37                    	STC
  05D8'   C9                    	RET
                                
                                
                                ;POPRET -- WM 5387: shared epilogue for the PUSH B/PUSH D/PUSH H prologue.
  05D9'                         POPRET:				; WM 5387
  05D9'   E1                    	POP	H
  05DA'   D1                    	POP	D
  05DB'   C1                    	POP	B
  05DC'   C9                    	RET
                                
                                ;============================================================
                                ; PAGESTP -- the count-limited scroll step.  The disk-eviction seam
                                ; (MKROOM/SPILL/SPILLB/PAGEBOT/REWIND), the deque marks (MARKGB/UPDMARK/RECBASE/
                                ; PTRREC) and the paging drivers (PAGEDIR/PGNEED/PAGEWIN) are all real in
                                ; PAGE.MAC, and CNTTST/CMDCNT/AUXCNT now exist in CMD.MAC.
                                ;============================================================
                                
                                ;PAGESTP -- WM 4311: page one step in the scroll direction, count-limited.
                                ;CNTTST returns Z when the command count (CMDCNT and AUXCNT) is exhausted, so a
                                ;completed edit or motion stops here (RZ); otherwise fall into PAGEDIR to page
                                ;the window one increment in the current scroll direction (DIRFLG: REWIND back,
                                ;FILLBUF forward).  In WM PAGESTP falls through to the physically adjacent
                                ;PAGEDIR; here PAGEDIR lives in PAGE.MAC, so the fall-through is an explicit
                                ;JMP -- same object behavior, PAGEDIR's own POLLBRK still runs.  DELTO's tail
                                ;JMPs here, so a delete made with the count spent returns at once; the count
                                ;loops (dd's QPUTLN, MVLLOOP's line moves, the search sweep through SCRLST)
                                ;are what page the window on past its edge.
                                ;SCRLST -- WM 4307: poll type-ahead, PUTCUR to HL, then (count not spent)
                                ;fall into PAGESTP to page the window one step in the DIRFLG direction.
  05DD'                         SCRLST:				; WM 4307
  05DD'   CD 0000*              	CALL	POLLBRK
  05E0'   CD 03A1'              	CALL	PUTCUR
                                
  05E3'                         PAGESTP:			; WM 4311
  05E3'   CD 0000*              	CALL	CNTTST
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  05E6'   C8                    	RZ
  05E7'   C3 0000*              	JMP	PAGEDIR
                                
                                ;============================================================
                                ; ERRMSG -- WM 664, message-print transcribed; TAIL adapted (see header):
                                ; print the inline 0-terminated message, set ERRFLG, warm-boot to CP/M.
                                ;============================================================
  05EA'                         ERRMSG:				; WM 664 (tail adapted)
  05EA'   E1                    	POP	H		; HL -> inline message (after the CALL)
  05EB'   3E FF                 	MVI	A,0FFH
  05ED'   32 0A25'              	STA	ERRFLG		; record that an error fired
  05F0'                         ERMLP:
  05F0'   7E                    	MOV	A,M
  05F1'   B7                    	ORA	A
  05F2'   CA 0601'              	JZ	ERMEND
  05F5'   E5                    	PUSH	H
  05F6'   5F                    	MOV	E,A
  05F7'   0E 02                 	MVI	C,2		; BDOS console out
  05F9'   CD 0005               	CALL	BDOS
  05FC'   E1                    	POP	H
  05FD'   23                    	INX	H
  05FE'   C3 05F0'              	JMP	ERMLP
  0601'                         ERMEND:
  0601'   C3 0000               	JMP	WBOOT		; adapted tail: back to CP/M
                                
                                ;============================================================
                                ; LOGICAL-OFFSET API  (APPENDED -- NOT WordMaster).
                                ; The gap-agnostic view the vi layer (CMD.MAC) uses so it never touches the raw
                                ; pointer row.  A logical offset is a byte index into resident text as if the
                                ; gap were absent:
                                ;   before = GAPBEG - TXTBEG   (bytes before the cursor = cursor logical offset)
                                ;   after  = TXTEND - GAPEND   (bytes at/after the cursor)
                                ;   LOGLEN = before + after
                                ; Most of CMD.MAC's verbs work in these offsets alone; the rest drive WM's
                                ; pointer-based routines (PUTCUR, the line moves, RGET, the matchers, the
                                ; Q-buffer), which page as they go, and a few read the pointer row directly.
                                ;============================================================
                                
                                ;CUROFF -- HL = cursor logical offset (= before length).
  0604'                         CUROFF:
  0604'   2A 0A1B'              	LHLD	TXTBEG
  0607'   EB                    	XCHG
  0608'   2A 0A1D'              	LHLD	GAPBEG
  060B'   CD 058E'              	CALL	SUBHD		; HL = GAPBEG - TXTBEG
  060E'   C9                    	RET
                                
                                ;AFTLN2 -- HL = after length (TXTEND - GAPEND).  Private helper for LOGLEN.
  060F'                         AFTLN2:
  060F'   2A 0A1F'              	LHLD	GAPEND
  0612'   EB                    	XCHG
  0613'   2A 0A21'              	LHLD	TXTEND
  0616'   CD 058E'              	CALL	SUBHD
  0619'   C9                    	RET
                                
                                ;LOGLEN -- HL = total resident logical length.
  061A'                         LOGLEN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  061A'   CD 0604'              	CALL	CUROFF
  061D'   E5                    	PUSH	H
  061E'   CD 060F'              	CALL	AFTLN2
  0621'   D1                    	POP	D
  0622'   19                    	DAD	D
  0623'   C9                    	RET
                                
                                ;L2PHYS -- HL(off) -> HL(physical address).  0 <= off <= LOGLEN.  Private.
  0624'                         L2PHYS:
  0624'   EB                    	XCHG			; DE = off
  0625'   D5                    	PUSH	D
  0626'   CD 0604'              	CALL	CUROFF		; HL = before
  0629'   D1                    	POP	D		; DE = off
  062A'   CD 05AC'              	CALL	CMP16		; DE=off vs HL=before: CY iff off < before
  062D'   DA 063A'              	JC	L2P_BEF
                                	;--- after region: phys = GAPEND + (off - before) ---
  0630'   EB                    	XCHG			; HL=off, DE=before
  0631'   CD 058E'              	CALL	SUBHD		; HL = off - before
  0634'   EB                    	XCHG			; DE = off-before
  0635'   2A 0A1F'              	LHLD	GAPEND
  0638'   19                    	DAD	D
  0639'   C9                    	RET
  063A'                         L2P_BEF:
                                	;--- before region: phys = TXTBEG + off  (DE = off, HL = before) ---
  063A'   2A 0A1B'              	LHLD	TXTBEG
  063D'   19                    	DAD	D
  063E'   C9                    	RET
                                
                                ;CHARAT -- HL(off) -> A = byte at that logical offset (off < LOGLEN).
  063F'                         CHARAT:
  063F'   CD 0624'              	CALL	L2PHYS
  0642'   7E                    	MOV	A,M
  0643'   C9                    	RET
                                
                                ;CLAMPL -- HL(off) -> HL clamped to [0, LOGLEN].  Private helper for GOTO.
  0644'                         CLAMPL:
  0644'   E5                    	PUSH	H
  0645'   CD 061A'              	CALL	LOGLEN
  0648'   D1                    	POP	D		; DE = off
  0649'   CD 05AC'              	CALL	CMP16		; DE=off vs HL=LOGLEN
  064C'   DA 0653'              	JC	CLK_KEEP	; off < LOGLEN
  064F'   CA 0653'              	JZ	CLK_KEEP	; off == LOGLEN
  0652'   C9                    	RET			; off > LOGLEN -> HL = LOGLEN
  0653'                         CLK_KEEP:
  0653'   EB                    	XCHG			; HL = off
  0654'   C9                    	RET
                                
                                ;GOTO -- HL(off): move the cursor to that logical offset.
                                ;PUTCUR takes its target address in HL (its entry XCHG moves it to DE).
                                ;The line feeds the cursor crosses are added to LNDLT (subtracted going back).
  0655'                         GOTO:
  0655'   CD 0644'              	CALL	CLAMPL
  0658'   CD 0624'              	CALL	L2PHYS		; HL = physical address
  065B'   E5                    	PUSH	H
  065C'   EB                    	XCHG			; DE = target
  065D'   2A 0A1F'              	LHLD	GAPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  0660'   CD 05AC'              	CALL	CMP16		; CY iff target < GAPEND (before the gap)
  0663'   DA 0671'              	JC	GTO_BK
  0666'   EB                    	XCHG			; forward: count [GAPEND, target)
  0667'   CD 0685'              	CALL	LFCNT
  066A'   2A 0A66'              	LHLD	LNDLT
  066D'   19                    	DAD	D
  066E'   C3 067D'              	JMP	GTO_ST
  0671'                         GTO_BK:
  0671'   2A 0A1D'              	LHLD	GAPBEG		; back: count [target, GAPBEG)
  0674'   CD 0685'              	CALL	LFCNT
  0677'   2A 0A66'              	LHLD	LNDLT
  067A'   CD 058E'              	CALL	SUBHD
  067D'                         GTO_ST:
  067D'   22 0A66'              	SHLD	LNDLT
  0680'   E1                    	POP	H
  0681'   CD 03A1'              	CALL	PUTCUR
  0684'   C9                    	RET
                                
                                ;LFCNT -- DE = start, HL = end (>= start): DE = number of LFs in [start, end).
  0685'                         LFCNT:
  0685'   CD 058E'              	CALL	SUBHD		; HL = end - start
  0688'   44                    	MOV	B,H
  0689'   4D                    	MOV	C,L		; BC = length
  068A'   EB                    	XCHG			; HL = start
  068B'   11 0000               	LXI	D,0
  068E'                         LFC_LP:
  068E'   78                    	MOV	A,B
  068F'   B1                    	ORA	C
  0690'   C8                    	RZ
  0691'   7E                    	MOV	A,M
  0692'   23                    	INX	H
  0693'   0B                    	DCX	B
  0694'   FE 0A                 	CPI	LF
  0696'   C2 068E'              	JNZ	LFC_LP
  0699'   13                    	INX	D
  069A'   C3 068E'              	JMP	LFC_LP
                                
                                ;RDGET -- RGET, and CY also when a refill read nothing.  INRDY stays set after
                                ;a file's last full record (no ^Z) until a read fails; NEEDIN then returns NC
                                ;having added nothing, and RGET steps past TXTEND leaving BC = FFFFH.  That is
                                ;reported as the end of the text, with BC = 0 so a later call asks NEEDIN again.
  069D'                         RDGET:
  069D'   CD 04EC'              	CALL	RGET
  06A0'   D8                    	RC
  06A1'   F5                    	PUSH	PSW
  06A2'   78                    	MOV	A,B
  06A3'   A1                    	ANA	C
  06A4'   3C                    	INR	A		; Z iff BC = FFFFH
  06A5'   CA 06AA'              	JZ	RDG_EF
  06A8'   F1                    	POP	PSW
  06A9'   C9                    	RET
  06AA'                         RDG_EF:
  06AA'   F1                    	POP	PSW
  06AB'   01 0000               	LXI	B,0
  06AE'   37                    	STC
  06AF'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


                                
                                ;DELFWD -- HL = number of logical bytes to delete forward from the cursor.
  06B0'                         DELFWD:
  06B0'   7C                    	MOV	A,H
  06B1'   B5                    	ORA	L
  06B2'   C8                    	RZ			; nothing to delete
  06B3'   CD 09C6'              	CALL	UNDDLF		; (appended) the span, for 'u', before it goes
  06B6'   EB                    	XCHG			; DE = count
  06B7'   2A 0A1F'              	LHLD	GAPEND
  06BA'   19                    	DAD	D		; target = GAPEND + count
  06BB'   AF                    	XRA	A		; S clear -> forward delete
  06BC'   CD 01CA'              	CALL	DELTO
  06BF'   C9                    	RET
                                
                                ;DELPRV -- WM 3260 RUBOUT/DELL: delete the char left of the cursor, and the
                                ;CR too when that leaves one there (a CR,LF goes as one).  PEEKLX pages back
                                ;at the window start and returns at the start of the file.  WM's MARKCUR and
                                ;ROWUP (its screen) are left out; instead a deleted LF moves the cursor up a
                                ;line (LNDLT - 1) for SCRN.MAC.
  06C0'                         DELPRV:				; WM 3260
  06C0'   CD 01C3'              	CALL	PEEKLX
  06C3'   FE 0A                 	CPI	LF
  06C5'   C2 06D1'              	JNZ	DLP_GO
  06C8'   E5                    	PUSH	H
  06C9'   2A 0A66'              	LHLD	LNDLT
  06CC'   2B                    	DCX	H
  06CD'   22 0A66'              	SHLD	LNDLT
  06D0'   E1                    	POP	H
  06D1'                         DLP_GO:				; WM 3263 DELL
  06D1'   CD 09E6'              	CALL	UNDDLP		; (appended) that byte, for 'u', before it goes
  06D4'   CD 0055'              	CALL	SETGAPB
  06D7'   CD 01B6'              	CALL	PEEKL
  06DA'   FE 0D                 	CPI	CR
  06DC'   CA 06C0'              	JZ	DELPRV
  06DF'   C9                    	RET
                                
                                
                                ;UNDELF -- APPENDED, NOT WordMaster: give back the byte last swallowed forward
                                ;into the gap.  A forward delete only moves GAPEND past the byte, so the byte
                                ;itself is still there, inside the gap: GAPEND-1 through DELTO makes it text
                                ;again, with the record marks updated exactly as a delete updates them.
                                ;Replace mode ('R') puts back with it what it overwrote, as vim's BS in Replace
                                ;mode does.  The caller must know the gap has not moved since the delete
                                ;(CMD.MAC keeps GAPEND in RPGE for that); nothing else calls this.
  06E0'                         UNDELF:
  06E0'   2A 0A1F'              	LHLD	GAPEND
  06E3'   2B                    	DCX	H
  06E4'   AF                    	XRA	A		; S clear -> the forward (GAPEND) side
  06E5'   CD 01CA'              	CALL	DELTO
  06E8'   C3 09F9'              	JMP	UNDUDF		; (appended) the byte just made text again
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  APPENDED, NOT WordMaster: WM has no undo at all (its QBUFOP /
                                ; QEXEC macro is a command-LINE facility, not this).
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                                ; Six primitives change resident text, and each one says what it did: PUTGAP
                                ; (one byte in), QGET (the register in), DELFWD (a span out), DELPRV (one byte
                                ; out backward), UNDELF (one byte back in) and QPUTLN (whole lines out).
                                ; Nothing else in the editor reaches the text, so no command can forget to
                                ; record itself -- which is the whole reason the capture sits down here instead
                                ; of at CMD.MAC's edit sites.
                                ;
                                ; A record says only WHERE and HOW MUCH, in LOGICAL offsets, plus where its
                                ; bytes lie in the undo region.  Logical offsets survive the gap sliding (which
                                ; PUTCUR does on every cursor move) because the replay walks the records
                                ; BACKWARD: each step restores the offsets the steps after it were measured
                                ; against.  The bytes are kept for an insert as well as a delete -- an insert
                                ; costs its own text twice, which is nothing -- so the region is settled once
                                ; the command ends and 'u' can walk it either way: backward applying each
                                ; record's inverse to undo, forward applying the records as they stand to redo.
                                ; That is what makes 'u' undo 'u' with ONE region and no capture during the
                                ; replay.
                                ;
                                ; The region is a region of the arena like the Q buffer, inserted between the
                                ; slider and the text, and it grows through the same MKGAP: the pointer row
                                ; reads (UBEG,UEND) as data and (TXTBAS,UBEG) / (UEND,TXTBEG) as the holes
                                ; around it, so NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN and INIBAS all take it in
                                ; their stride unchanged.
                                ;
                                ; DEVIATIONS from vim, all deliberate and all in COMMANDS.md: ONE level of
                                ; undo, so 'u' undoes 'u' as real vi does; the change must still be in the
                                ; RESIDENT window, and 'u' refuses once the pager has moved off it rather than
                                ; chasing it through the file; and a change with more steps than the table
                                ; holds, or one the arena has no spare room to keep, is not undoable at all.
                                ;
                                ; "Moved off it" is PGTOPM, PAGE.MAC's count of the times the pager moved
                                ; TXTBEG.  It is the window's TOP that matters: an offset is measured from
                                ; TXTBEG, so spilling a record out from under it (PAGEOUT) or reading one back
                                ; in (REWIND) shifts every offset, while FILLBUF and PAGEBOT growing TXTEND at
                                ; the bottom shift none.  The OUTREC/SRCREC water marks look like the same
                                ; thing and are not: UPDMARK raises them on every edit.
                                ;============================================================
                                
  0001                          UR_INS	EQU	1		; text went IN  (undoing takes it back out)
  0002                          UR_DEL	EQU	2		; text came OUT (undoing puts it back)
  0007                          URSIZE	EQU	7		; type, offset(2), length(2), region offset(2)
  0018                          URMAX	EQU	24		; primitive steps one change may hold
                                ;How much of the arena the capture refuses to eat into.  It only has to keep
                                ;MKGAP off its MKROOM path (which wants 256 free), because paging is what undo
                                ;must not do -- so this is deliberately SMALL.  RESVMEM, QROOM's reserve, is
                                ;far too big: a 66 K file leaves under 1700 bytes free, and undo would never
                                ;engage at all on exactly the files that need it most.
  0200                          UNDRSV	EQU	200H		; ... 512 bytes
                                ;How much room the region claims up front, and so the largest change that can
                                ;be kept.  The claim is what lets the capture run without EVER growing the
                                ;region: see UNDGRW for why growing where a primitive can see it is unsafe.
  0400                          UNDCAP	EQU	400H		; 1024 bytes of change
                                
                                ;UNDBEG -- CMD.MAC's command boundary: the NEXT captured change starts a new
                                ;undo.  A flag only, so a command that changes nothing -- a motion, a yank, a
                                ;key that is no command at all -- leaves the last change undoable, exactly as
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


                                ;'.' keeps the last change it recorded.
  06EB'                         UNDBEG:
  06EB'   D5                    	PUSH	D
  06EC'   E5                    	PUSH	H
  06ED'   3E 01                 	MVI	A,1
  06EF'   32 0A4E'              	STA	UNDNEW
  06F2'   CD 0604'              	CALL	CUROFF
  06F5'   22 0A62'              	SHLD	UNDPCU		; where the cursor was as this command began --
  06F8'   CD 0707'              	CALL	UNDGRW		;   kept pending, because only a command that
  06FB'   E1                    	POP	H		;   really changes text gets to claim it
  06FC'   D1                    	POP	D
  06FD'   C9                    	RET
                                
                                ;UNDHER -- the change about to start belongs at the CURSOR: 'u' puts it back
                                ;there.  UNDBEG's cursor snapshot without its claim on the region, for a
                                ;command (':s') that cannot know where its first change will be until it has
                                ;found it.  Calling UNDBEG again instead would re-run UNDGRW in the middle of
                                ;the command, which is the one thing UNDGRW must never do -- see below.
  06FE'                         UNDHER:
  06FE'   E5                    	PUSH	H
  06FF'   CD 0604'              	CALL	CUROFF
  0702'   22 0A62'              	SHLD	UNDPCU
  0705'   E1                    	POP	H
  0706'   C9                    	RET
                                
                                ;UNDGRW -- make sure the region can take a whole change without growing again.
                                ;THE ONLY PLACE THE REGION GROWS, and it runs at the command boundary, where no
                                ;primitive is holding anything.  Growing moves regions about (MKGAP -> MOVGAP),
                                ;and that both invalidates a raw pointer a primitive is in the middle of using
                                ;-- DELPRV hands SETGAPB one -- and overwrites whatever is sitting in the gap,
                                ;which is where a forward-deleted byte waits for 'R's backspace to call UNDELF
                                ;and give it back.  So the room is claimed here, 256 bytes at a time, and the
                                ;capture below never calls MKGAP at all: it writes into the claim or gives up.
                                ;The room has to be claimed as the region's own CONTENT, not left as the hole
                                ;above it: the holes are shared, and the text takes whatever it can reach --
                                ;MOVGAP feeding an insert will walk straight through a hole reserved here, which
                                ;is what made a 200-character insert lose its undo halfway.  Once the bytes are
                                ;inside (UBEG,UEND) the text cannot have them: MOVGAP slides the region aside
                                ;instead.  Nothing here holds an address across MKGAP either, because MKGAP
                                ;slides this very region (HOLEUP moves UBEG and UEND) -- UEND is re-read from
                                ;its cell every time round.
  0707'                         UNDGRW:
  0707'   C5                    	PUSH	B
  0708'   D5                    	PUSH	D
  0709'   E5                    	PUSH	H
  070A'                         UNDGRL:
  070A'   21 0A17'              	LXI	H,UBEG
  070D'   CD 04DA'              	CALL	PRSPAN		; BC = the region's size
  0710'   50                    	MOV	D,B
  0711'   59                    	MOV	E,C
  0712'   21 0400               	LXI	H,UNDCAP
  0715'   CD 05AC'              	CALL	CMP16		; CY iff it is smaller than one change
  0718'   D2 05D9'              	JNC	POPRET
  071B'   CD 0893'              	CALL	UNDRM		; ... but never at the cost of paging
  071E'   DA 05D9'              	JC	POPRET
  0721'   21 0A19'              	LXI	H,UEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  0724'   CD 00B0'              	CALL	MKGAP		; 256 free above the region ...
  0727'   2A 0A19'              	LHLD	UEND
  072A'   11 0100               	LXI	D,100H
  072D'   19                    	DAD	D
  072E'   22 0A19'              	SHLD	UEND		; ... taken into it, so the text cannot take
  0731'   C3 070A'              	JMP	UNDGRL		;     them back
                                
                                ;UNDCLR -- nothing is undoable (a fresh buffer; BINIT calls it through INIGAP).
  0734'                         UNDCLR:
  0734'   AF                    	XRA	A
  0735'   32 0A4B'              	STA	UNDN
  0738'   32 0A4C'              	STA	UNDST
  073B'   32 0A4D'              	STA	UNDBAD
  073E'   3E 01                 	MVI	A,1
  0740'   32 0A4E'              	STA	UNDNEW
  0743'   C9                    	RET
                                
                                ;UNDRST -- the first capture of a new change: drop the last one and note where
                                ;the file window was, so 'u' can tell the pager has since moved off this change.
  0744'                         UNDRST:
  0744'   AF                    	XRA	A
  0745'   32 0A4E'              	STA	UNDNEW
  0748'   32 0A4B'              	STA	UNDN
  074B'   32 0A4D'              	STA	UNDBAD
  074E'   21 0000               	LXI	H,0
  0751'   22 0A5F'              	SHLD	UNDPTR		; the region's content empties (its SIZE stays:
                                				;   that is the room UNDGRW claimed)
  0754'   2A 0000*              	LHLD	PGTOPM
  0757'   22 0A5D'              	SHLD	UNDPG
  075A'   2A 0A62'              	LHLD	UNDPCU
  075D'   22 0A64'              	SHLD	UNDCUR		; ... and this command does change text, so this
                                				;   is where 'u' will put the cursor back
  0760'   3E 01                 	MVI	A,1
  0762'   32 0A4C'              	STA	UNDST		; a change is on the buffer: 'u' undoes it
  0765'   C9                    	RET
                                
                                ;UNDCHG -- the capture every hooked primitive uses.  A = UR_INS / UR_DEL,
                                ;HL = the logical offset it acted at, BC = how many bytes.  The bytes are read
                                ;back out of the resident TEXT at that offset -- for a delete before they go,
                                ;for an insert once they have arrived -- so no caller hands over a pointer that
                                ;growing the region could leave stale.
  0766'                         UNDCHG:
  0766'   C5                    	PUSH	B
  0767'   D5                    	PUSH	D
  0768'   E5                    	PUSH	H
  0769'   32 0A52'              	STA	UNDTY		; the record type, kept out of the registers
  076C'   3A 0A4F'              	LDA	UNDRPL
  076F'   B7                    	ORA	A
  0770'   C2 05D9'              	JNZ	POPRET		; 'u' replaying: its own edits are not a change
  0773'   3A 0A4E'              	LDA	UNDNEW
  0776'   B7                    	ORA	A
  0777'   CA 077D'              	JZ	UNDC1
  077A'   CD 0744'              	CALL	UNDRST		; the first step of a new change
  077D'                         UNDC1:
  077D'   3A 0A4D'              	LDA	UNDBAD
  0780'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  0781'   C2 05D9'              	JNZ	POPRET		; this change has already been given up on
  0784'   78                    	MOV	A,B
  0785'   B1                    	ORA	C
  0786'   CA 05D9'              	JZ	POPRET		; a zero-length step is no step
  0789'   60                    	MOV	H,B
  078A'   69                    	MOV	L,C
  078B'   22 0A59'              	SHLD	UNDCL		; UNDAPT spends BC as its countdown, so the
                                				;   length has to be kept somewhere else
  078E'   3A 0A4B'              	LDA	UNDN
  0791'   FE 18                 	CPI	URMAX
  0793'   D2 07D9'              	JNC	UNDCBD		; no room for another step
                                	;--- where this step's bytes will land in the region ---
  0796'   2A 0A5F'              	LHLD	UNDPTR
  0799'   22 0A57'              	SHLD	UNDBO
  079C'   E1                    	POP	H
  079D'   E5                    	PUSH	H		; HL = the logical offset again
  079E'   CD 0849'              	CALL	UNDAPT		; BC bytes of the text there -> the region
  07A1'   DA 07D9'              	JC	UNDCBD
                                	;--- fold it into the last record when it only carries that one on ---
  07A4'   E1                    	POP	H
  07A5'   E5                    	PUSH	H
  07A6'   CD 07F1'              	CALL	UNDEXT
  07A9'   CA 05D9'              	JZ	POPRET
                                	;--- otherwise a record of its own ---
  07AC'   3A 0A4B'              	LDA	UNDN
  07AF'   CD 07E1'              	CALL	URADDR
  07B2'   3A 0A52'              	LDA	UNDTY
  07B5'   77                    	MOV	M,A
  07B6'   23                    	INX	H
  07B7'   D1                    	POP	D
  07B8'   D5                    	PUSH	D		; DE = the logical offset
  07B9'   73                    	MOV	M,E
  07BA'   23                    	INX	H
  07BB'   72                    	MOV	M,D
  07BC'   23                    	INX	H
  07BD'   EB                    	XCHG			; DE = the record, past the offset
  07BE'   2A 0A59'              	LHLD	UNDCL
  07C1'   EB                    	XCHG			; ... and HL back, with DE = the length
  07C2'   73                    	MOV	M,E
  07C3'   23                    	INX	H
  07C4'   72                    	MOV	M,D
  07C5'   23                    	INX	H
  07C6'   3A 0A57'              	LDA	UNDBO
  07C9'   77                    	MOV	M,A
  07CA'   23                    	INX	H
  07CB'   3A 0A58'              	LDA	UNDBO+1
  07CE'   77                    	MOV	M,A
  07CF'   3A 0A4B'              	LDA	UNDN
  07D2'   3C                    	INR	A
  07D3'   32 0A4B'              	STA	UNDN
  07D6'   C3 05D9'              	JMP	POPRET
  07D9'                         UNDCBD:
  07D9'   3E 01                 	MVI	A,1
  07DB'   32 0A4D'              	STA	UNDBAD		; too big to keep: not undoable at all
  07DE'   C3 05D9'              	JMP	POPRET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


                                ;URADDR -- A = a record index -> HL = its address (base + n*8 - n).
  07E1'                         URADDR:
  07E1'   6F                    	MOV	L,A
  07E2'   26 00                 	MVI	H,0
  07E4'   5D                    	MOV	E,L
  07E5'   54                    	MOV	D,H
  07E6'   29                    	DAD	H
  07E7'   29                    	DAD	H
  07E8'   29                    	DAD	H		; HL = n*8
  07E9'   CD 058E'              	CALL	SUBHD		; HL = n*7
  07EC'   11 0000*              	LXI	D,UNDREC
  07EF'   19                    	DAD	D
  07F0'   C9                    	RET
                                
                                ;UNDEXT -- A = 0 (Z) when this step only carries the last record on: an insert
                                ;starting exactly where the last insert ended, which is what typing does.  Its
                                ;bytes already sit contiguously behind that record's, so only the length grows.
                                ;HL = this step's offset, BC = its length.
  07F1'                         UNDEXT:
  07F1'   C5                    	PUSH	B
  07F2'   D5                    	PUSH	D
  07F3'   E5                    	PUSH	H
  07F4'   3A 0A52'              	LDA	UNDTY
  07F7'   FE 01                 	CPI	UR_INS
  07F9'   C2 0843'              	JNZ	UNDXNO		; only inserts fold
  07FC'   3A 0A4B'              	LDA	UNDN
  07FF'   B7                    	ORA	A
  0800'   CA 0843'              	JZ	UNDXNO		; nothing to fold into
  0803'   3D                    	DCR	A
  0804'   CD 07E1'              	CALL	URADDR
  0807'   22 0A5B'              	SHLD	UNDLSA
  080A'   7E                    	MOV	A,M
  080B'   FE 01                 	CPI	UR_INS
  080D'   C2 0843'              	JNZ	UNDXNO
  0810'   2A 0A5B'              	LHLD	UNDLSA
  0813'   23                    	INX	H
  0814'   CD 05A7'              	CALL	LDHLI		; HL = the last record's offset
  0817'   EB                    	XCHG
  0818'   2A 0A5B'              	LHLD	UNDLSA
  081B'   23                    	INX	H
  081C'   23                    	INX	H
  081D'   23                    	INX	H
  081E'   CD 05A7'              	CALL	LDHLI		; HL = its length
  0821'   19                    	DAD	D		; HL = where it ends
  0822'   EB                    	XCHG
  0823'   E1                    	POP	H
  0824'   E5                    	PUSH	H		; HL = this step's offset
  0825'   CD 05AC'              	CALL	CMP16		; Z iff this step starts exactly there
  0828'   C2 0843'              	JNZ	UNDXNO
  082B'   2A 0A5B'              	LHLD	UNDLSA
  082E'   23                    	INX	H
  082F'   23                    	INX	H
  0830'   23                    	INX	H
  0831'   E5                    	PUSH	H
  0832'   CD 05A7'              	CALL	LDHLI		; HL = the last record's length
  0835'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0836'   2A 0A59'              	LHLD	UNDCL
  0839'   19                    	DAD	D		; ... grown by this step's
  083A'   EB                    	XCHG
  083B'   E1                    	POP	H
  083C'   73                    	MOV	M,E
  083D'   23                    	INX	H
  083E'   72                    	MOV	M,D
  083F'   AF                    	XRA	A		; Z: folded, no new record
  0840'   C3 05D9'              	JMP	POPRET
  0843'                         UNDXNO:
  0843'   3E 01                 	MVI	A,1
  0845'   B7                    	ORA	A		; NZ: it needs a record of its own
  0846'   C3 05D9'              	JMP	POPRET
                                
                                ;UNDAPT -- append BC bytes of resident text, from logical offset HL, to the
                                ;undo region.  One byte at a time, re-reading the offset through CHARAT and the
                                ;region through its pointer cell every time, so growing the region (which
                                ;slides regions about) can never leave this loop holding a stale address.
                                ;CY if it outgrows the claim, and the caller then gives the change up.
  0849'                         UNDAPT:
  0849'   78                    	MOV	A,B
  084A'   B1                    	ORA	C
  084B'   C8                    	RZ			; nothing to append
  084C'                         UNDAPL:
  084C'   C5                    	PUSH	B
  084D'   E5                    	PUSH	H
  084E'   CD 063F'              	CALL	CHARAT		; A = the text byte at this offset
  0851'   CD 085F'              	CALL	UNDAPB		; ... into the region
  0854'   E1                    	POP	H
  0855'   C1                    	POP	B
  0856'   D8                    	RC
  0857'   23                    	INX	H
  0858'   0B                    	DCX	B
  0859'   78                    	MOV	A,B
  085A'   B1                    	ORA	C
  085B'   C2 084C'              	JNZ	UNDAPL
  085E'   C9                    	RET
                                
                                ;UNDAPB -- put the byte in A into the room UNDGRW claimed.  It does NOT grow
                                ;the region -- see UNDGRW -- so CY, and the change given up on, once the room
                                ;is used up: a change bigger than the region is simply not undoable.
  085F'                         UNDAPB:
  085F'   C5                    	PUSH	B
  0860'   D5                    	PUSH	D
  0861'   E5                    	PUSH	H
  0862'   32 0A61'              	STA	UNDB1
  0865'   21 0A17'              	LXI	H,UBEG
  0868'   CD 04DA'              	CALL	PRSPAN		; BC = the region's size
  086B'   2A 0A5F'              	LHLD	UNDPTR
  086E'   EB                    	XCHG			; DE = where the next byte goes
  086F'   60                    	MOV	H,B
  0870'   69                    	MOV	L,C
  0871'   CD 05AC'              	CALL	CMP16		; CY iff that is still inside the region
  0874'   D2 088A'              	JNC	UNDAPF
  0877'   2A 0A17'              	LHLD	UBEG		; re-read: a relocation moves the region
  087A'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  087B'   3A 0A61'              	LDA	UNDB1
  087E'   77                    	MOV	M,A
  087F'   2A 0A5F'              	LHLD	UNDPTR
  0882'   23                    	INX	H
  0883'   22 0A5F'              	SHLD	UNDPTR
  0886'   B7                    	ORA	A		; CY clear: it went in
  0887'   C3 05D9'              	JMP	POPRET
  088A'                         UNDAPF:
  088A'   3E 01                 	MVI	A,1
  088C'   32 0A4D'              	STA	UNDBAD
  088F'   37                    	STC
  0890'   C3 05D9'              	JMP	POPRET
                                
                                ;UNDRM -- CY, and the change given up on, unless the arena still holds UNDRSV
                                ;free.  The capture must never page: paging moves the window off the change and
                                ;would invalidate every logical offset the records hold.  Keeping this much
                                ;free also keeps MKGAP off its MKROOM path, so the capture cannot page even by
                                ;accident, and it fails QUIETLY where QROOM raises 'QBUF FULL' -- undo going
                                ;away must never stop the editing.
  0893'                         UNDRM:
  0893'   C5                    	PUSH	B
  0894'   D5                    	PUSH	D
  0895'   E5                    	PUSH	H
  0896'   CD 0474'              	CALL	BUFSUM		; DE = the arena's free bytes
  0899'   21 0200               	LXI	H,UNDRSV
  089C'   CD 05AC'              	CALL	CMP16		; CY iff less than that is left
  089F'   D2 05D9'              	JNC	POPRET
  08A2'   3E 01                 	MVI	A,1
  08A4'   32 0A4D'              	STA	UNDBAD
  08A7'   37                    	STC
  08A8'   C3 05D9'              	JMP	POPRET
                                
                                ;---------------------------------------------------------------- the replay
                                
                                ;UNDO -- 'u'.  CY when there is nothing to undo: no change captured, a change
                                ;too big to have been captured, or the pager has moved the window off it.
  08AB'                         UNDO:
  08AB'   AF                    	XRA	A
  08AC'   32 0A51'              	STA	UNDWHY		; refused for want of a change, until told else
  08AF'   3A 0A4B'              	LDA	UNDN
  08B2'   B7                    	ORA	A
  08B3'   37                    	STC
  08B4'   C8                    	RZ			; nothing captured
  08B5'   3A 0A4D'              	LDA	UNDBAD
  08B8'   B7                    	ORA	A
  08B9'   CA 08C3'              	JZ	UND_OK
  08BC'   3E 02                 	MVI	A,2
  08BE'   32 0A51'              	STA	UNDWHY		; too big to have been captured: CMD.MAC says
  08C1'   37                    	STC			;   so, rather than ringing the bell at a user
  08C2'   C9                    	RET			;   who has no way to know why
  08C3'                         UND_OK:
  08C3'   2A 0000*              	LHLD	PGTOPM
  08C6'   EB                    	XCHG
  08C7'   2A 0A5D'              	LHLD	UNDPG
  08CA'   CD 05AC'              	CALL	CMP16
  08CD'   C2 08F4'              	JNZ	UNDPGD		; the pager has moved the window's top since,
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


                                				;   so every offset the records hold has shifted
  08D0'   3E 01                 	MVI	A,1
  08D2'   32 0A4F'              	STA	UNDRPL		; the replay's own edits are not a new change
  08D5'   3A 0A4C'              	LDA	UNDST
  08D8'   FE 01                 	CPI	1
  08DA'   CA 08FB'              	JZ	UNDREV
                                	;--- the last 'u' undid it: apply the records forward again (a redo) ---
  08DD'   AF                    	XRA	A
  08DE'   32 0A50'              	STA	UNDDIR
  08E1'   AF                    	XRA	A
  08E2'                         UNDFWL:
  08E2'   CD 091C'              	CALL	URSTEP
  08E5'   3C                    	INR	A
  08E6'   47                    	MOV	B,A
  08E7'   3A 0A4B'              	LDA	UNDN
  08EA'   B8                    	CMP	B
  08EB'   78                    	MOV	A,B
  08EC'   C2 08E2'              	JNZ	UNDFWL
  08EF'   3E 01                 	MVI	A,1
  08F1'   C3 090D'              	JMP	UNDFIN
  08F4'                         UNDPGD:
  08F4'   3E 01                 	MVI	A,1
  08F6'   32 0A51'              	STA	UNDWHY		; the change is no longer in the window
  08F9'   37                    	STC
  08FA'   C9                    	RET
  08FB'                         UNDREV:
                                	;--- undo: the records backward, each one's inverse ---
  08FB'   3E 01                 	MVI	A,1
  08FD'   32 0A50'              	STA	UNDDIR
  0900'   3A 0A4B'              	LDA	UNDN
  0903'                         UNDRVL:
  0903'   3D                    	DCR	A
  0904'   CD 091C'              	CALL	URSTEP
  0907'   B7                    	ORA	A
  0908'   C2 0903'              	JNZ	UNDRVL
  090B'   3E 02                 	MVI	A,2
  090D'                         UNDFIN:
  090D'   32 0A4C'              	STA	UNDST
  0910'   AF                    	XRA	A
  0911'   32 0A4F'              	STA	UNDRPL
                                	;--- the cursor goes back where the command that changed it began:
                                	;    measured from vim, which restores that and not the change's own
                                	;    offset (CMD.MAC's VC_UNDO holds it inside the line) ---
  0914'   2A 0A64'              	LHLD	UNDCUR
  0917'   CD 0655'              	CALL	GOTO
  091A'   B7                    	ORA	A		; CY clear: it happened
  091B'   C9                    	RET
                                
                                ;URSTEP -- apply record A: as it stands when UNDDIR is 0 (a redo), inverted
                                ;when it is 1 (an undo).  An insert applied puts its saved bytes back at its
                                ;offset; an insert inverted deletes that many bytes there; a delete is the
                                ;mirror of both.  A is preserved -- UNDO's loops count with it.
  091C'                         URSTEP:
  091C'   F5                    	PUSH	PSW
  091D'   CD 07E1'              	CALL	URADDR
  0920'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0921'   32 0A52'              	STA	UNDTY
  0924'   23                    	INX	H
  0925'   7E                    	MOV	A,M
  0926'   32 0A53'              	STA	UNDOF
  0929'   23                    	INX	H
  092A'   7E                    	MOV	A,M
  092B'   32 0A54'              	STA	UNDOF+1
  092E'   23                    	INX	H
  092F'   7E                    	MOV	A,M
  0930'   32 0A55'              	STA	UNDLN
  0933'   23                    	INX	H
  0934'   7E                    	MOV	A,M
  0935'   32 0A56'              	STA	UNDLN+1
  0938'   23                    	INX	H
  0939'   7E                    	MOV	A,M
  093A'   32 0A57'              	STA	UNDBO
  093D'   23                    	INX	H
  093E'   7E                    	MOV	A,M
  093F'   32 0A58'              	STA	UNDBO+1
  0942'   3A 0A52'              	LDA	UNDTY
  0945'   47                    	MOV	B,A
  0946'   3A 0A50'              	LDA	UNDDIR
  0949'   B7                    	ORA	A
  094A'   CA 0956'              	JZ	URS_AP
  094D'   78                    	MOV	A,B		; an undo inverts the record
  094E'   FE 01                 	CPI	UR_INS
  0950'   CA 095C'              	JZ	URS_DL
  0953'   C3 096A'              	JMP	URS_IN
  0956'                         URS_AP:
  0956'   78                    	MOV	A,B		; a redo applies it as it stands
  0957'   FE 01                 	CPI	UR_INS
  0959'   CA 096A'              	JZ	URS_IN
  095C'                         URS_DL:
                                	;--- take the record's length back out at its offset ---
  095C'   2A 0A53'              	LHLD	UNDOF
  095F'   CD 0655'              	CALL	GOTO
  0962'   2A 0A55'              	LHLD	UNDLN
  0965'   CD 06B0'              	CALL	DELFWD
  0968'   F1                    	POP	PSW
  0969'   C9                    	RET
  096A'                         URS_IN:
                                	;--- put the record's saved bytes back in at its offset ---
  096A'   2A 0A53'              	LHLD	UNDOF
  096D'   CD 0655'              	CALL	GOTO
  0970'   2A 0A55'              	LHLD	UNDLN
  0973'   44                    	MOV	B,H
  0974'   4D                    	MOV	C,L
  0975'   2A 0A57'              	LHLD	UNDBO
  0978'                         URSILP:
  0978'   C5                    	PUSH	B
  0979'   E5                    	PUSH	H
  097A'   EB                    	XCHG			; DE = the byte's offset within the region
  097B'   2A 0A17'              	LHLD	UBEG		; ... re-read every byte: inserting text can
  097E'   19                    	DAD	D		;     slide the region out from under it
  097F'   7E                    	MOV	A,M
  0980'   CD 0045'              	CALL	PUTGAP
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0983'   FE 0A                 	CPI	LF
  0985'   C2 098F'              	JNZ	URSILN
  0988'   2A 0A66'              	LHLD	LNDLT		; a line end put back is the cursor crossing
  098B'   23                    	INX	H		;   one, and GOTO keeps LNDLT for every move the
  098C'   22 0A66'              	SHLD	LNDLT		;   replay makes -- so the renderer needs no
  098F'                         URSILN:				;   whole-window rescan to find that out
  098F'   E1                    	POP	H
  0990'   C1                    	POP	B
  0991'   23                    	INX	H
  0992'   0B                    	DCX	B
  0993'   78                    	MOV	A,B
  0994'   B1                    	ORA	C
  0995'   C2 0978'              	JNZ	URSILP
  0998'   F1                    	POP	PSW
  0999'   C9                    	RET
                                
                                ;---------------------------------------------------------------- the hooks
                                
                                ;UNDPUT -- PUTGAP's tail: the one byte now sitting just below the cursor.
  099A'                         UNDPUT:
  099A'   F5                    	PUSH	PSW
  099B'   C5                    	PUSH	B
  099C'   D5                    	PUSH	D
  099D'   E5                    	PUSH	H
  099E'   CD 0604'              	CALL	CUROFF
  09A1'   2B                    	DCX	H
  09A2'   01 0001               	LXI	B,1
  09A5'   3E 01                 	MVI	A,UR_INS
  09A7'   CD 0766'              	CALL	UNDCHG
  09AA'   C3 0A08'              	JMP	UNDHX
                                
                                ;UNDGET -- QGET's tail: BC bytes of register now in, the cursor past them.
                                ;UNDINS is the same entry by its general name: INSBLK itself carries NO hook
                                ;(insert mode records a byte at a time through PUTGAP), so a command that
                                ;splices a block in -- ':s' replacing a match -- has to say so itself, exactly
                                ;as QGET does.  Without it 'u' puts the deleted text back and leaves the
                                ;inserted text there ('a-a-a' undid to 'aZ-aZ-aZ').
  09AD'                         UNDINS:
  09AD'                         UNDGET:
  09AD'   F5                    	PUSH	PSW
  09AE'   C5                    	PUSH	B
  09AF'   D5                    	PUSH	D
  09B0'   E5                    	PUSH	H
  09B1'   78                    	MOV	A,B
  09B2'   B1                    	ORA	C
  09B3'   CA 0A08'              	JZ	UNDHX
  09B6'   CD 0604'              	CALL	CUROFF
  09B9'   50                    	MOV	D,B
  09BA'   59                    	MOV	E,C
  09BB'   CD 058E'              	CALL	SUBHD		; HL = where the put began
  09BE'   3E 01                 	MVI	A,UR_INS
  09C0'   CD 0766'              	CALL	UNDCHG
  09C3'   C3 0A08'              	JMP	UNDHX
                                
                                ;UNDDLF -- DELFWD's head: HL bytes about to go forward from the cursor.
  09C6'                         UNDDLF:
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  09C6'   F5                    	PUSH	PSW
  09C7'   C5                    	PUSH	B
  09C8'   D5                    	PUSH	D
  09C9'   E5                    	PUSH	H
  09CA'   44                    	MOV	B,H
  09CB'   4D                    	MOV	C,L
  09CC'   CD 0604'              	CALL	CUROFF
  09CF'   3E 02                 	MVI	A,UR_DEL
  09D1'   CD 0766'              	CALL	UNDCHG
  09D4'   C3 0A08'              	JMP	UNDHX
                                
                                ;UNDDLQ -- QPUTLN's head: BC bytes of whole lines about to go into the register.
  09D7'                         UNDDLQ:
  09D7'   F5                    	PUSH	PSW
  09D8'   C5                    	PUSH	B
  09D9'   D5                    	PUSH	D
  09DA'   E5                    	PUSH	H
  09DB'   CD 0604'              	CALL	CUROFF
  09DE'   3E 02                 	MVI	A,UR_DEL
  09E0'   CD 0766'              	CALL	UNDCHG
  09E3'   C3 0A08'              	JMP	UNDHX
                                
                                ;UNDDLP -- DELPRV's head: the one byte just below the cursor, about to go.
  09E6'                         UNDDLP:
  09E6'   F5                    	PUSH	PSW
  09E7'   C5                    	PUSH	B
  09E8'   D5                    	PUSH	D
  09E9'   E5                    	PUSH	H
  09EA'   CD 0604'              	CALL	CUROFF
  09ED'   2B                    	DCX	H
  09EE'   01 0001               	LXI	B,1
  09F1'   3E 02                 	MVI	A,UR_DEL
  09F3'   CD 0766'              	CALL	UNDCHG
  09F6'   C3 0A08'              	JMP	UNDHX
                                
                                ;UNDUDF -- UNDELF's tail: the byte DELTO just made text again, at the cursor.
  09F9'                         UNDUDF:
  09F9'   F5                    	PUSH	PSW
  09FA'   C5                    	PUSH	B
  09FB'   D5                    	PUSH	D
  09FC'   E5                    	PUSH	H
  09FD'   CD 0604'              	CALL	CUROFF
  0A00'   01 0001               	LXI	B,1
  0A03'   3E 01                 	MVI	A,UR_INS
  0A05'   CD 0766'              	CALL	UNDCHG
                                ;UNDHX -- every hook leaves the primitive's own registers and flags alone.
  0A08'                         UNDHX:
  0A08'   E1                    	POP	H
  0A09'   D1                    	POP	D
  0A0A'   C1                    	POP	B
  0A0B'   F1                    	POP	PSW
  0A0C'   C9                    	RET
                                
                                ;============================================================
                                ; DATA -- the (base,limit) pointer row (WM 6828-6871 layout) + scratch.
                                ; The disassembly's DB values for these cells are aliased code bytes; only the
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


                                ; order/adjacency is authoritative.  BINIT sets every cell at run time.
                                ;============================================================
  0A0D'   0000                  BUFBEG: DW	0		; region-array base
  0A0F'   0000                  QBEG:	DW	0		; ^Q scratch buffer begin
  0A11'   0000                  QEND:	DW	0		; ^Q scratch buffer end
  0A13'   0000                  HOLEQP:	 DW	 0
  0A15'   0000                  TXTBAS: DW	0		; text base = PBEGMEM+1 (past the 0 sentinel)
                                ;UBEG/UEND -- APPENDED: the undo region, a region of the arena like the Q
                                ;buffer, with UEND its insertion point.  It goes HERE, between the slider and
                                ;the text, so both of the row's interleaved walks stay aligned: the holes from
                                ;BUFBEG are (BUFBEG,QBEG) (QEND,HOLEQP) (TXTBAS,UBEG) (UEND,TXTBEG)
                                ;(GAPBEG,GAPEND) (TXTEND,BUFEND), and the data regions from QBEG are
                                ;(QBEG,QEND) (HOLEQP,TXTBAS) (UBEG,UEND) (TXTBEG,GAPBEG) (GAPEND,TXTEND).
                                ;NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN, PRSPAN and INIBAS's count are all
                                ;untouched by it; INIGAP empties it.
  0A17'   0000                  UBEG:	DW	0		; undo region begin
  0A19'   0000                  UEND:	DW	0		; undo region end = its insertion point
  0A1B'   0000                  TXTBEG: DW	0		; window start
  0A1D'   0000                  GAPBEG: DW	0		; cursor / gap start
  0A1F'   0000                  GAPEND: DW	0		; gap end / first char after cursor
  0A21'   0000                  TXTEND: DW	0		; window end
  0A22'                         PRTERM	 EQU	 TXTEND+1	 ; NEXTPR terminator = high byte of TXTEND
  0A23'   0000                  BUFEND: DW	0		; top of usable text RAM
  0A24'                         MVGTOP	 EQU	 BUFEND+1	 ; MOVGAP upper bound = high byte of BUFEND
                                
  0A25'   00                    ERRFLG: DB	0		; nonzero after ERRMSG fired (harness reads it)
                                
                                ;The search pattern, in WM's SRCHBUF layout (WM 6900): the length, then the
                                ;string, 0-terminated.  CMD.MAC fills it from the '/' line and passes DE =
                                ;SRCHST; FWDCNT reads the length from the byte below that, as WM does.
  0A26'   1E                    SRCMAX: DB	SRMAX		; ... its capacity, so CMD.MAC cannot drift
  0A27'   00                    SRCHBF: DB	0		; the pattern length
  0A28'                         SRCHST: DS	SRMAX+1		; the pattern, 0-terminated
                                
  0A47'   0000                  L2756:	DW	0		; WM L2756 -- GOLINE's last target position
  0A49'   0000                  QCPDON: DW	0		; (appended) QCPYN: bytes already copied in
                                ;--- 'u' (undo): see the UNDO section above for how these are driven.
  0A4B'   00                    UNDN:	DB	0		; steps captured (0 = nothing to undo)
  0A4C'   00                    UNDST:	DB	0		; 0 none, 1 change applied ('u' undoes it),
                                				;   2 already undone ('u' puts it back)
  0A4D'   00                    UNDBAD: DB	0		; 1 = this change was too big to capture
  0A4E'   01                    UNDNEW: DB	1		; 1 = the next capture starts a new change
  0A4F'   00                    UNDRPL: DB	0		; 1 = 'u' replaying, so nothing is captured
  0A50'   00                    UNDDIR: DB	0		; the replay's direction (0 forward, 1 inverse)
  0A51'   00                    UNDWHY: DB	0		; 0 = nothing to undo, 1 = it has paged away
  0A52'   00                    UNDTY:	DB	0		; the step / record type being handled
  0A53'   0000                  UNDOF:	DW	0		; ... its logical offset
  0A55'   0000                  UNDLN:	DW	0		; ... its length
  0A57'   0000                  UNDBO:	DW	0		; ... where its bytes lie in the region
  0A59'   0000                  UNDCL:	DW	0		; the length being captured (BC does not survive)
  0A5B'   0000                  UNDLSA: DW	0		; the last record's address (UNDEXT's scratch)
  0A5D'   0000                  UNDPG:	DW	0		; PGTOPM when this change was captured
  0A5F'   0000                  UNDPTR: DW	0		; the region's write point, as an OFFSET
  0A61'   00                    UNDB1:	DB	0		; the byte going in (PRSPAN wants BC)
  0A62'   0000                  UNDPCU: DW	0		; the cursor as the current command began
  0A64'   0000                  UNDCUR: DW	0		; ... as the command that made THIS change began
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


                                
  0A66'   0000                  LNDLT:	DW	0		; (appended) lines the cursor moved since the last
                                				;   screen layout (signed; SCRN.MAC consumes it)
                                
                                ;PBEGMEM -- base of the text arena: the first RAM byte past everything the
                                ;program holds.  The gap buffer's text lives from here up to BUFEND.  BUF
                                ;links last but RSV.MAC links after it, holding the reserve block in the RAM
                                ;immediately above the image (it emits no bytes of its own), so the arena
                                ;starts at RSVTOP -- past the reserves -- and is the size it always was.
  0A68'   0000*                 PBEGMEM:DW	RSVTOP
                                
  0A6A'                         MEMBAS:				; top of the linked image (RSV.MAC's base)
                                
                                	END
