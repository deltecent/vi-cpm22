  057C'   94                    	SUB	H
  057D'   C2 0582'              	JNZ	CMPLOW
  0580'   7B                    	MOV	A,E
  0581'   95                    	SUB	L
  0582'                         CMPLOW:				 ; WM 5342
  0582'   78                    	MOV	A,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  0583'   C1                    	POP	B
  0584'   C9                    	RET
                                
                                ;SUBCLP -- WM 5348: HL := max(0, HL-DE); CY if positive.
  0585'                         SUBCLP:				; WM 5348
  0585'   CD 0579'              	CALL	CMP16
  0588'   DA 0590'              	JC	SCLPPO
  058B'                         SCLPZ:				; WM 5352
  058B'   21 0000               	LXI	H,0H
  058E'   B7                    	ORA	A
  058F'   C9                    	RET
  0590'                         SCLPPO:				 ; WM 5357
  0590'   E5                    	PUSH	H
  0591'   CD 055B'              	CALL	SUBHD
  0594'   D1                    	POP	D
  0595'   37                    	STC
  0596'   C9                    	RET
                                
                                ;SUBCP2 -- WM 5365: HL := max(0, DE-HL); CY if positive.
  0597'                         SUBCP2:			       ; WM 5365
  0597'   CD 0579'              	CALL	CMP16
  059A'   CA 058B'              	JZ	SCLPZ
  059D'   DA 058B'              	JC	SCLPZ
  05A0'   EB                    	XCHG
  05A1'   CD 055B'              	CALL	SUBHD
  05A4'   37                    	STC
  05A5'   C9                    	RET
                                
                                
                                ;POPRET -- WM 5387: shared epilogue for the PUSH B/PUSH D/PUSH H prologue.
  05A6'                         POPRET:				; WM 5387
  05A6'   E1                    	POP	H
  05A7'   D1                    	POP	D
  05A8'   C1                    	POP	B
  05A9'   C9                    	RET
                                
                                ;============================================================
                                ; PAGESTP -- the count-limited scroll step.  The disk-eviction seam
                                ; (MKROOM/SPILL/SPILLB/PAGEBOT/REWIND), the deque marks (MARKGB/UPDMARK/RECBASE/
                                ; PTRREC) and the paging drivers (PAGEDIR/PGNEED/PAGEWIN) are all real in
                                ; PAGE.MAC, and CNTTST/CMDCNT/AUXCNT now exist in CMD.MAC.
                                ;============================================================
                                
                                ;PAGESTP -- WM 4311: page one step in the scroll direction, count-limited.
                                ;CNTTST returns Z when the command count (CMDCNT and AUXCNT) is exhausted, so a
                                ;completed edit or motion stops here (RZ); otherwise fall into PAGEDIR to page
                                ;the window one increment in the current scroll direction (DIRFLG: REWIND back,
                                ;FILLBUF forward).  In WM PAGESTP falls through to the physically adjacent
                                ;PAGEDIR; here PAGEDIR lives in PAGE.MAC, so the fall-through is an explicit
                                ;JMP -- same object behavior, PAGEDIR's own POLLBRK still runs.  DELTO's tail
                                ;JMPs here, so a delete made with the count spent returns at once; the count
                                ;loops (dd's QPUTLN, MVLLOOP's line moves, the search sweep through SCRLST)
                                ;are what page the window on past its edge.
                                ;SCRLST -- WM 4307: poll type-ahead, PUTCUR to HL, then (count not spent)
                                ;fall into PAGESTP to page the window one step in the DIRFLG direction.
  05AA'                         SCRLST:				; WM 4307
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  05AA'   CD 0000*              	CALL	POLLBRK
  05AD'   CD 036E'              	CALL	PUTCUR
                                
  05B0'                         PAGESTP:			; WM 4311
  05B0'   CD 0000*              	CALL	CNTTST
  05B3'   C8                    	RZ
  05B4'   C3 0000*              	JMP	PAGEDIR
                                
                                ;============================================================
                                ; ERRMSG -- WM 664, message-print transcribed; TAIL adapted (see header):
                                ; print the inline 0-terminated message, set ERRFLG, warm-boot to CP/M.
                                ; The message is printed where ERRHK leaves the cursor: VI.MAC points it at the
                                ; screen teardown, so it lands on the bottom row with the terminal restored, as
                                ; a quit leaves it; a harness with no screen leaves it on a RET.  The work files
                                ; are dropped before the warm boot, as a quit drops them.  A second error from
                                ; inside either step ends here too: DISCRD clears its own flag before it
                                ; deletes, so it cannot run twice.
                                ;============================================================
  05B7'                         ERRMSG:				; WM 664 (tail adapted)
  05B7'   3E FF                 	MVI	A,0FFH
  05B9'   32 0000*              	STA	ERRFLG		; record that an error fired
  05BC'   2A 05DC'              	LHLD	ERRHK
  05BF'   CD 05DA'              	CALL	ERMGO		; the cursor to where the message belongs
  05C2'   E1                    	POP	H		; HL -> inline message (after the CALL)
  05C3'                         ERMLP:
  05C3'   7E                    	MOV	A,M
  05C4'   B7                    	ORA	A
  05C5'   CA 05D4'              	JZ	ERMEND
  05C8'   E5                    	PUSH	H
  05C9'   5F                    	MOV	E,A
  05CA'   0E 02                 	MVI	C,2		; BDOS console out
  05CC'   CD 0005               	CALL	BDOS
  05CF'   E1                    	POP	H
  05D0'   23                    	INX	H
  05D1'   C3 05C3'              	JMP	ERMLP
  05D4'                         ERMEND:
  05D4'   CD 0000*              	CALL	DISCRD		; no name.$$$ / VIBACKUP.$$$ left behind
  05D7'   C3 0000               	JMP	WBOOT		; adapted tail: back to CP/M
  05DA'   E9                    ERMGO:	PCHL
  05DB'   C9                    ERMNUL: RET
  05DC'   05DB'                 ERRHK:	DW	ERMNUL		; the screen's teardown, once there is a screen
                                
                                ;MEMERR -- DEVIATION 3 (see header): the arena has no room for what the key
                                ;asked.  Called as ERRMSG is, the message inline after the CALL, and goes on
                                ;through MEMHK with the stack as it found it, so whatever MEMHK names reads the
                                ;message where ERRMSG would.  MEMHK is ERRMSG until the editor is up.
  05DE'                         MEMERR:
  05DE'   2A 05E2'              	LHLD	MEMHK
  05E1'   E9                    	PCHL
  05E2'   05B7'                 MEMHK:	DW	ERRMSG		; VI.MAC points it at CMD.MAC's MEMABT
                                
                                ;============================================================
                                ; LOGICAL-OFFSET API  (APPENDED -- NOT WordMaster).
                                ; The gap-agnostic view the vi layer (CMD.MAC) uses so it never touches the raw
                                ; pointer row.  A logical offset is a byte index into resident text as if the
                                ; gap were absent:
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


                                ;   before = GAPBEG - TXTBEG   (bytes before the cursor = cursor logical offset)
                                ;   after  = TXTEND - GAPEND   (bytes at/after the cursor)
                                ;   LOGLEN = before + after
                                ; Most of CMD.MAC's verbs work in these offsets alone; the rest drive WM's
                                ; pointer-based routines (PUTCUR, the line moves, RGET, the matchers, the
                                ; Q-buffer), which page as they go, and a few read the pointer row directly.
                                ;============================================================
                                
                                ;CUROFF -- HL = cursor logical offset (= before length).
  05E4'                         CUROFF:
  05E4'   2A 0000*              	LHLD	TXTBEG
  05E7'   EB                    	XCHG
  05E8'   2A 0000*              	LHLD	GAPBEG
  05EB'   CD 055B'              	CALL	SUBHD		; HL = GAPBEG - TXTBEG
  05EE'   C9                    	RET
                                
                                ;AFTLN2 -- HL = after length (TXTEND - GAPEND).  Private helper for LOGLEN.
  05EF'                         AFTLN2:
  05EF'   2A 0000*              	LHLD	GAPEND
  05F2'   EB                    	XCHG
  05F3'   2A 0000*              	LHLD	TXTEND
  05F6'   CD 055B'              	CALL	SUBHD
  05F9'   C9                    	RET
                                
                                ;LOGLEN -- HL = total resident logical length.
  05FA'                         LOGLEN:
  05FA'   CD 05E4'              	CALL	CUROFF
  05FD'   E5                    	PUSH	H
  05FE'   CD 05EF'              	CALL	AFTLN2
  0601'   D1                    	POP	D
  0602'   19                    	DAD	D
  0603'   C9                    	RET
                                
                                ;L2PHYS -- HL(off) -> HL(physical address).  0 <= off <= LOGLEN.  Private.
  0604'                         L2PHYS:
  0604'   EB                    	XCHG			; DE = off
  0605'   D5                    	PUSH	D
  0606'   CD 05E4'              	CALL	CUROFF		; HL = before
  0609'   D1                    	POP	D		; DE = off
  060A'   CD 0579'              	CALL	CMP16		; DE=off vs HL=before: CY iff off < before
  060D'   DA 061A'              	JC	L2P_BEF
                                	;--- after region: phys = GAPEND + (off - before) ---
  0610'   EB                    	XCHG			; HL=off, DE=before
  0611'   CD 055B'              	CALL	SUBHD		; HL = off - before
  0614'   EB                    	XCHG			; DE = off-before
  0615'   2A 0000*              	LHLD	GAPEND
  0618'   19                    	DAD	D
  0619'   C9                    	RET
  061A'                         L2P_BEF:
                                	;--- before region: phys = TXTBEG + off  (DE = off, HL = before) ---
  061A'   2A 0000*              	LHLD	TXTBEG
  061D'   19                    	DAD	D
  061E'   C9                    	RET
                                
                                ;CHARAT -- HL(off) -> A = byte at that logical offset (off < LOGLEN).
  061F'                         CHARAT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  061F'   CD 0604'              	CALL	L2PHYS
  0622'   7E                    	MOV	A,M
  0623'   C9                    	RET
                                
                                ;CLAMPL -- HL(off) -> HL clamped to [0, LOGLEN].  Private helper for GOTO.
  0624'                         CLAMPL:
  0624'   E5                    	PUSH	H
  0625'   CD 05FA'              	CALL	LOGLEN
  0628'   D1                    	POP	D		; DE = off
  0629'   CD 0579'              	CALL	CMP16		; DE=off vs HL=LOGLEN
  062C'   DA 0633'              	JC	CLK_KEEP	; off < LOGLEN
  062F'   CA 0633'              	JZ	CLK_KEEP	; off == LOGLEN
  0632'   C9                    	RET			; off > LOGLEN -> HL = LOGLEN
  0633'                         CLK_KEEP:
  0633'   EB                    	XCHG			; HL = off
  0634'   C9                    	RET
                                
                                ;GOTO -- HL(off): move the cursor to that logical offset.
                                ;PUTCUR takes its target address in HL (its entry XCHG moves it to DE).
                                ;The line feeds the cursor crosses are added to LNDLT (subtracted going back).
  0635'                         GOTO:
  0635'   CD 0624'              	CALL	CLAMPL
  0638'   CD 0604'              	CALL	L2PHYS		; HL = physical address
  063B'   E5                    	PUSH	H
  063C'   EB                    	XCHG			; DE = target
  063D'   2A 0000*              	LHLD	GAPEND
  0640'   CD 0579'              	CALL	CMP16		; CY iff target < GAPEND (before the gap)
  0643'   DA 0651'              	JC	GTO_BK
  0646'   EB                    	XCHG			; forward: count [GAPEND, target)
  0647'   CD 0665'              	CALL	LFCNT
  064A'   2A 0000*              	LHLD	LNDLT
  064D'   19                    	DAD	D
  064E'   C3 065D'              	JMP	GTO_ST
  0651'                         GTO_BK:
  0651'   2A 0000*              	LHLD	GAPBEG		; back: count [target, GAPBEG)
  0654'   CD 0665'              	CALL	LFCNT
  0657'   2A 0000*              	LHLD	LNDLT
  065A'   CD 055B'              	CALL	SUBHD
  065D'                         GTO_ST:
  065D'   22 0000*              	SHLD	LNDLT
  0660'   E1                    	POP	H
  0661'   CD 036E'              	CALL	PUTCUR
  0664'   C9                    	RET
                                
                                ;LFCNT -- DE = start, HL = end (>= start): DE = number of LFs in [start, end).
  0665'                         LFCNT:
  0665'   CD 055B'              	CALL	SUBHD		; HL = end - start
  0668'   44                    	MOV	B,H
  0669'   4D                    	MOV	C,L		; BC = length
  066A'   EB                    	XCHG			; HL = start
  066B'   11 0000               	LXI	D,0
  066E'                         LFC_LP:
  066E'   78                    	MOV	A,B
  066F'   B1                    	ORA	C
  0670'   C8                    	RZ
  0671'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0672'   23                    	INX	H
  0673'   0B                    	DCX	B
  0674'   FE 0A                 	CPI	LF
  0676'   C2 066E'              	JNZ	LFC_LP
  0679'   13                    	INX	D
  067A'   C3 066E'              	JMP	LFC_LP
                                
                                ;RDGET -- RGET, and CY also when a refill read nothing.  INRDY stays set after
                                ;a file's last full record (no ^Z) until a read fails; NEEDIN then returns NC
                                ;having added nothing, and RGET steps past TXTEND leaving BC = FFFFH.  That is
                                ;reported as the end of the text, with BC = 0 so a later call asks NEEDIN again.
  067D'                         RDGET:
  067D'   CD 04B9'              	CALL	RGET
  0680'   D8                    	RC
  0681'   F5                    	PUSH	PSW
  0682'   78                    	MOV	A,B
  0683'   A1                    	ANA	C
  0684'   3C                    	INR	A		; Z iff BC = FFFFH
  0685'   CA 068A'              	JZ	RDG_EF
  0688'   F1                    	POP	PSW
  0689'   C9                    	RET
  068A'                         RDG_EF:
  068A'   F1                    	POP	PSW
  068B'   01 0000               	LXI	B,0
  068E'   37                    	STC
  068F'   C9                    	RET
                                
                                ;DELFWD -- HL = number of logical bytes to delete forward from the cursor.
  0690'                         DELFWD:
  0690'   7C                    	MOV	A,H
  0691'   B5                    	ORA	L
  0692'   C8                    	RZ			; nothing to delete
  0693'   CD 0AD9'              	CALL	UNDDLF		; (appended) the span, for 'u', before it goes
  0696'   EB                    	XCHG			; DE = count
  0697'   2A 0000*              	LHLD	GAPEND
  069A'   19                    	DAD	D		; target = GAPEND + count
  069B'   AF                    	XRA	A		; S clear -> forward delete
  069C'   CD 0207'              	CALL	DELTO
  069F'   C9                    	RET
                                
                                ;DELPRV -- WM 3260 RUBOUT/DELL: delete the char left of the cursor, and the
                                ;CR too when that leaves one there (a CR,LF goes as one).  PEEKLX pages back
                                ;at the window start and returns at the start of the file.  WM's MARKCUR and
                                ;ROWUP (its screen) are left out; instead a deleted LF moves the cursor up a
                                ;line (LNDLT - 1) for SCRN.MAC.
  06A0'                         DELPRV:				; WM 3260
  06A0'   CD 0200'              	CALL	PEEKLX
  06A3'   FE 0A                 	CPI	LF
  06A5'   C2 06B1'              	JNZ	DLP_GO
  06A8'   E5                    	PUSH	H
  06A9'   2A 0000*              	LHLD	LNDLT
  06AC'   2B                    	DCX	H
  06AD'   22 0000*              	SHLD	LNDLT
  06B0'   E1                    	POP	H
  06B1'                         DLP_GO:				; WM 3263 DELL
  06B1'   CD 0AF9'              	CALL	UNDDLP		; (appended) that byte, for 'u', before it goes
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  06B4'   CD 0067'              	CALL	SETGAPB
  06B7'   CD 01F3'              	CALL	PEEKL
  06BA'   FE 0D                 	CPI	CR
  06BC'   CA 06A0'              	JZ	DELPRV
  06BF'   C9                    	RET
                                
                                
                                ;UNDELF -- APPENDED, NOT WordMaster: give back the byte last swallowed forward
                                ;into the gap.  A forward delete only moves GAPEND past the byte, so the byte
                                ;itself is still there, inside the gap: GAPEND-1 through DELTO makes it text
                                ;again, with the record marks updated exactly as a delete updates them.
                                ;Replace mode ('R') puts back with it what it overwrote, as vim's BS in Replace
                                ;mode does.  The caller must know the gap has not moved since the delete
                                ;(CMD.MAC keeps GAPEND in RPGE for that); nothing else calls this.
  06C0'                         UNDELF:
  06C0'   2A 0000*              	LHLD	GAPEND
  06C3'   2B                    	DCX	H
  06C4'   AF                    	XRA	A		; S clear -> the forward (GAPEND) side
  06C5'   CD 0207'              	CALL	DELTO
  06C8'   C3 0B0C'              	JMP	UNDUDF		; (appended) the byte just made text again
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  APPENDED, NOT WordMaster: WM has no undo at all (its QBUFOP /
                                ; QEXEC macro is a command-LINE facility, not this).
                                ;
                                ; Six primitives change resident text, and each one says what it did: PUTGAP
                                ; (one byte in), QGET (the register in), DELFWD (a span out), DELPRV (one byte
                                ; out backward), UNDELF (one byte back in) and QPUTLN (whole lines out).
                                ; Nothing else in the editor reaches the text, so no command can forget to
                                ; record itself -- which is the whole reason the capture sits down here instead
                                ; of at CMD.MAC's edit sites.
                                ;
                                ; A record says only WHERE and HOW MUCH, in LOGICAL offsets, plus where its
                                ; bytes lie in the undo region.  Logical offsets survive the gap sliding (which
                                ; PUTCUR does on every cursor move) because the replay walks the records
                                ; BACKWARD: each step restores the offsets the steps after it were measured
                                ; against.  The bytes are kept for an insert as well as a delete -- an insert
                                ; costs its own text twice, which is nothing -- so the region is settled once
                                ; the command ends and 'u' can walk it either way: backward applying each
                                ; record's inverse to undo, forward applying the records as they stand to redo.
                                ; That is what makes 'u' undo 'u' with ONE region and no capture during the
                                ; replay.
                                ;
                                ; The region is a region of the arena like the Q buffer, inserted between the
                                ; slider and the text, and it grows through the same MKGAP: the pointer row
                                ; reads (UBEG,UEND) as data and (TXTBAS,UBEG) / (UEND,TXTBEG) as the holes
                                ; around it, so NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN and INIBAS all take it in
                                ; their stride unchanged.
                                ;
                                ; DEVIATIONS from vim, all deliberate and all in COMMANDS.md: ONE level of
                                ; undo, so 'u' undoes 'u' as real vi does; the change must still be in the
                                ; RESIDENT window, and 'u' refuses once the pager has moved off it rather than
                                ; chasing it through the file; and a change with more steps than the table
                                ; holds, or one the arena has no spare room to keep, is not undoable at all.
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


                                ; "Moved off it" is PGTOPM, PAGE.MAC's count of the times the pager moved
                                ; TXTBEG.  It is the window's TOP that matters: an offset is measured from
                                ; TXTBEG, so spilling a record out from under it (PAGEOUT) or reading one back
                                ; in (REWIND) shifts every offset, while FILLBUF and PAGEBOT growing TXTEND at
                                ; the bottom shift none.  The OUTREC/SRCREC water marks look like the same
                                ; thing and are not: UPDMARK moves them on every edit (OUTREC down,
                                ; SRCREC up).
                                ;============================================================
                                
  0001                          UR_INS	EQU	1		; text went IN  (undoing takes it back out)
  0002                          UR_DEL	EQU	2		; text came OUT (undoing puts it back)
  0007                          URSIZE	EQU	7		; type, offset(2), length(2), region offset(2)
  0018                          URMAX	EQU	24		; primitive steps one change may hold
                                ;How much of the arena the capture refuses to eat into.  It only has to keep
                                ;MKGAP off its MKROOM path (which wants 256 free), because paging is what undo
                                ;must not do -- so this is deliberately SMALL.  RESVMEM, QROOM's reserve, is
                                ;far too big: a 66 K file leaves under 1700 bytes free, and undo would never
                                ;engage at all on exactly the files that need it most.
  0200                          UNDRSV	EQU	200H		; ... 512 bytes
                                ;How much room the region claims up front, and so the largest change that can
                                ;be kept.  The claim is what lets the capture run without EVER growing the
                                ;region: see UNDGRW for why growing where a primitive can see it is unsafe.
  0400                          UNDCAP	EQU	400H		; 1024 bytes of change
                                
                                ;UNDBEG -- CMD.MAC's command boundary: the NEXT captured change starts a new
                                ;undo.  A flag only, so a command that changes nothing -- a motion, a yank, a
                                ;key that is no command at all -- leaves the last change undoable, exactly as
                                ;'.' keeps the last change it recorded.
  06CB'                         UNDBEG:
  06CB'   D5                    	PUSH	D
  06CC'   E5                    	PUSH	H
  06CD'   3E 01                 	MVI	A,1
  06CF'   32 0B21'              	STA	UNDNEW
  06D2'   CD 05E4'              	CALL	CUROFF
  06D5'   22 0000*              	SHLD	UNDPCU		; where the cursor was as this command began --
  06D8'   CD 06E7'              	CALL	UNDGRW		;   kept pending, because only a command that
  06DB'   E1                    	POP	H		;   really changes text gets to claim it
  06DC'   D1                    	POP	D
  06DD'   C9                    	RET
                                
                                ;UNDHER -- the change about to start belongs at the CURSOR: 'u' puts it back
                                ;there.  UNDBEG's cursor snapshot without its claim on the region, for a
                                ;command (':s') that cannot know where its first change will be until it has
                                ;found it.  Calling UNDBEG again instead would re-run UNDGRW in the middle of
                                ;the command, which is the one thing UNDGRW must never do -- see below.
  06DE'                         UNDHER:
  06DE'   E5                    	PUSH	H
  06DF'   CD 05E4'              	CALL	CUROFF
  06E2'   22 0000*              	SHLD	UNDPCU
  06E5'   E1                    	POP	H
  06E6'   C9                    	RET
                                
                                ;UNDGRW -- make sure the region can take a whole change without growing again.
                                ;THE ONLY PLACE THE REGION GROWS, and it runs at the command boundary, where no
                                ;primitive is holding anything.  Growing moves regions about (MKGAP -> MOVGAP),
                                ;and that both invalidates a raw pointer a primitive is in the middle of using
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


                                ;-- DELPRV hands SETGAPB one -- and overwrites whatever is sitting in the gap,
                                ;which is where a forward-deleted byte waits for 'R's backspace to call UNDELF
                                ;and give it back.  So the room is claimed here, 256 bytes at a time, and the
                                ;capture below never calls MKGAP at all: it writes into the claim or gives up.
                                ;The room has to be claimed as the region's own CONTENT, not left as the hole
                                ;above it: the holes are shared, and the text takes whatever it can reach --
                                ;MOVGAP feeding an insert will walk straight through a hole reserved here, which
                                ;is what made a 200-character insert lose its undo halfway.  Once the bytes are
                                ;inside (UBEG,UEND) the text cannot have them: MOVGAP slides the region aside
                                ;instead.  Nothing here holds an address across MKGAP either, because MKGAP
                                ;slides this very region (HOLEUP moves UBEG and UEND) -- UEND is re-read from
                                ;its cell every time round.
  06E7'                         UNDGRW:
  06E7'   C5                    	PUSH	B
  06E8'   D5                    	PUSH	D
  06E9'   E5                    	PUSH	H
  06EA'                         UNDGRL:
  06EA'   21 0000*              	LXI	H,UBEG
  06ED'   CD 04A7'              	CALL	PRSPAN		; BC = the region's size
  06F0'   50                    	MOV	D,B
  06F1'   59                    	MOV	E,C
  06F2'   21 0400               	LXI	H,UNDCAP
  06F5'   CD 0579'              	CALL	CMP16		; CY iff it is smaller than one change
  06F8'   D2 05A6'              	JNC	POPRET
  06FB'   CD 087E'              	CALL	UNDRM		; ... but never at the cost of paging
  06FE'   DA 05A6'              	JC	POPRET
  0701'   21 0000*              	LXI	H,UEND
  0704'   CD 00BC'              	CALL	MKGAP		; 256 free above the region ...
  0707'   2A 0000*              	LHLD	UEND
  070A'   11 0100               	LXI	D,100H
  070D'   19                    	DAD	D
  070E'   22 0000*              	SHLD	UEND		; ... taken into it, so the text cannot take
  0711'   C3 06EA'              	JMP	UNDGRL		;     them back
                                
                                ;UNDCLR -- nothing is undoable (a fresh buffer; BINIT calls it through INIGAP).
  0714'                         UNDCLR:
  0714'   AF                    	XRA	A
  0715'   32 0000*              	STA	UNDN
  0718'   32 0000*              	STA	UNDST
  071B'   32 0000*              	STA	UNDBAD
  071E'   3E 01                 	MVI	A,1
  0720'   32 0B21'              	STA	UNDNEW
  0723'   C9                    	RET
                                
                                ;UNDRST -- the first capture of a new change: drop the last one and note where
                                ;the file window was, so 'u' can tell the pager has since moved off this change.
  0724'                         UNDRST:
  0724'   AF                    	XRA	A
  0725'   32 0B21'              	STA	UNDNEW
  0728'   32 0000*              	STA	UNDN
  072B'   32 0000*              	STA	UNDBAD
  072E'   21 0000               	LXI	H,0
  0731'   22 0000*              	SHLD	UNDPTR		; the region's content empties (its SIZE stays:
                                				;   that is the room UNDGRW claimed)
  0734'   2A 0000*              	LHLD	PGTOPM
  0737'   22 0000*              	SHLD	UNDPG
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  073A'   2A 0000*              	LHLD	UNDPCU
  073D'   22 0000*              	SHLD	UNDCUR		; ... and this command does change text, so this
                                				;   is where 'u' will put the cursor back
  0740'   3E 01                 	MVI	A,1
  0742'   32 0000*              	STA	UNDST		; a change is on the buffer: 'u' undoes it
  0745'   C9                    	RET
                                
                                ;UNDCHG -- the capture every hooked primitive uses.  A = UR_INS / UR_DEL,
                                ;HL = the logical offset it acted at, BC = how many bytes.  The bytes are read
                                ;back out of the resident TEXT at that offset -- for a delete before they go,
                                ;for an insert once they have arrived -- so no caller hands over a pointer that
                                ;growing the region could leave stale.
  0746'                         UNDCHG:
  0746'   C5                    	PUSH	B
  0747'   D5                    	PUSH	D
  0748'   E5                    	PUSH	H
  0749'   32 0000*              	STA	UNDTY		; the record type, kept out of the registers
  074C'   CD 07C4'              	CALL	EDTGO		; whoever else follows an edit (BC is kept)
  074F'   3A 0000*              	LDA	UNDRPL
  0752'   B7                    	ORA	A
  0753'   C2 05A6'              	JNZ	POPRET		; 'u' replaying: its own edits are not a change
  0756'   3A 0B21'              	LDA	UNDNEW
  0759'   B7                    	ORA	A
  075A'   CA 0760'              	JZ	UNDC1
  075D'   CD 0724'              	CALL	UNDRST		; the first step of a new change
  0760'                         UNDC1:
  0760'   3A 0000*              	LDA	UNDBAD
  0763'   B7                    	ORA	A
  0764'   C2 05A6'              	JNZ	POPRET		; this change has already been given up on
  0767'   78                    	MOV	A,B
  0768'   B1                    	ORA	C
  0769'   CA 05A6'              	JZ	POPRET		; a zero-length step is no step
  076C'   60                    	MOV	H,B
  076D'   69                    	MOV	L,C
  076E'   22 0000*              	SHLD	UNDCL		; UNDAPT spends BC as its countdown, so the
                                				;   length has to be kept somewhere else
  0771'   3A 0000*              	LDA	UNDN
  0774'   FE 18                 	CPI	URMAX
  0776'   D2 07BC'              	JNC	UNDCBD		; no room for another step
                                	;--- where this step's bytes will land in the region ---
  0779'   2A 0000*              	LHLD	UNDPTR
  077C'   22 0000*              	SHLD	UNDBO
  077F'   E1                    	POP	H
  0780'   E5                    	PUSH	H		; HL = the logical offset again
  0781'   CD 0834'              	CALL	UNDAPT		; BC bytes of the text there -> the region
  0784'   DA 07BC'              	JC	UNDCBD
                                	;--- fold it into the last record when it only carries that one on ---
  0787'   E1                    	POP	H
  0788'   E5                    	PUSH	H
  0789'   CD 07DC'              	CALL	UNDEXT
  078C'   CA 05A6'              	JZ	POPRET
                                	;--- otherwise a record of its own ---
  078F'   3A 0000*              	LDA	UNDN
  0792'   CD 07CC'              	CALL	URADDR
  0795'   3A 0000*              	LDA	UNDTY
  0798'   77                    	MOV	M,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  0799'   23                    	INX	H
  079A'   D1                    	POP	D
  079B'   D5                    	PUSH	D		; DE = the logical offset
  079C'   73                    	MOV	M,E
  079D'   23                    	INX	H
  079E'   72                    	MOV	M,D
  079F'   23                    	INX	H
  07A0'   EB                    	XCHG			; DE = the record, past the offset
  07A1'   2A 0000*              	LHLD	UNDCL
  07A4'   EB                    	XCHG			; ... and HL back, with DE = the length
  07A5'   73                    	MOV	M,E
  07A6'   23                    	INX	H
  07A7'   72                    	MOV	M,D
  07A8'   23                    	INX	H
  07A9'   3A 0000*              	LDA	UNDBO
  07AC'   77                    	MOV	M,A
  07AD'   23                    	INX	H
  07AE'   3A 0001*              	LDA	UNDBO+1
  07B1'   77                    	MOV	M,A
  07B2'   3A 0000*              	LDA	UNDN
  07B5'   3C                    	INR	A
  07B6'   32 0000*              	STA	UNDN
  07B9'   C3 05A6'              	JMP	POPRET
  07BC'                         UNDCBD:
  07BC'   3E 01                 	MVI	A,1
  07BE'   32 0000*              	STA	UNDBAD		; too big to keep: not undoable at all
  07C1'   C3 05A6'              	JMP	POPRET
                                
                                ;EDTGO -- UNDCHG is the one place every change to the text goes by, the
                                ;replay's own included, so it is also where the editor hears of one: EDTHK is
                                ;called with A = UR_INS / UR_DEL, HL = the logical offset and BC = the length,
                                ;and must keep BC.  VI.MAC points it at the marks; a harness leaves it a RET.
  07C4'                         EDTGO:
  07C4'   E5                    	PUSH	H
  07C5'   2A 07CA'              	LHLD	EDTHK
  07C8'   E3                    	XTHL
  07C9'   C9                    	RET
  07CA'   05DB'                 EDTHK:	DW	ERMNUL
                                
                                ;URADDR -- A = a record index -> HL = its address (base + n*8 - n).
  07CC'                         URADDR:
  07CC'   6F                    	MOV	L,A
  07CD'   26 00                 	MVI	H,0
  07CF'   5D                    	MOV	E,L
  07D0'   54                    	MOV	D,H
  07D1'   29                    	DAD	H
  07D2'   29                    	DAD	H
  07D3'   29                    	DAD	H		; HL = n*8
  07D4'   CD 055B'              	CALL	SUBHD		; HL = n*7
  07D7'   11 0000*              	LXI	D,UNDREC
  07DA'   19                    	DAD	D
  07DB'   C9                    	RET
                                
                                ;UNDEXT -- A = 0 (Z) when this step only carries the last record on: an insert
                                ;starting exactly where the last insert ended, which is what typing does.  Its
                                ;bytes already sit contiguously behind that record's, so only the length grows.
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


                                ;HL = this step's offset, BC = its length.
  07DC'                         UNDEXT:
  07DC'   C5                    	PUSH	B
  07DD'   D5                    	PUSH	D
  07DE'   E5                    	PUSH	H
  07DF'   3A 0000*              	LDA	UNDTY
  07E2'   FE 01                 	CPI	UR_INS
  07E4'   C2 082E'              	JNZ	UNDXNO		; only inserts fold
  07E7'   3A 0000*              	LDA	UNDN
  07EA'   B7                    	ORA	A
  07EB'   CA 082E'              	JZ	UNDXNO		; nothing to fold into
  07EE'   3D                    	DCR	A
  07EF'   CD 07CC'              	CALL	URADDR
  07F2'   22 0000*              	SHLD	UNDLSA
  07F5'   7E                    	MOV	A,M
  07F6'   FE 01                 	CPI	UR_INS
  07F8'   C2 082E'              	JNZ	UNDXNO
  07FB'   2A 0000*              	LHLD	UNDLSA
  07FE'   23                    	INX	H
  07FF'   CD 0574'              	CALL	LDHLI		; HL = the last record's offset
  0802'   EB                    	XCHG
  0803'   2A 0000*              	LHLD	UNDLSA
  0806'   23                    	INX	H
  0807'   23                    	INX	H
  0808'   23                    	INX	H
  0809'   CD 0574'              	CALL	LDHLI		; HL = its length
  080C'   19                    	DAD	D		; HL = where it ends
  080D'   EB                    	XCHG
  080E'   E1                    	POP	H
  080F'   E5                    	PUSH	H		; HL = this step's offset
  0810'   CD 0579'              	CALL	CMP16		; Z iff this step starts exactly there
  0813'   C2 082E'              	JNZ	UNDXNO
  0816'   2A 0000*              	LHLD	UNDLSA
  0819'   23                    	INX	H
  081A'   23                    	INX	H
  081B'   23                    	INX	H
  081C'   E5                    	PUSH	H
  081D'   CD 0574'              	CALL	LDHLI		; HL = the last record's length
  0820'   EB                    	XCHG
  0821'   2A 0000*              	LHLD	UNDCL
  0824'   19                    	DAD	D		; ... grown by this step's
  0825'   EB                    	XCHG
  0826'   E1                    	POP	H
  0827'   73                    	MOV	M,E
  0828'   23                    	INX	H
  0829'   72                    	MOV	M,D
  082A'   AF                    	XRA	A		; Z: folded, no new record
  082B'   C3 05A6'              	JMP	POPRET
  082E'                         UNDXNO:
  082E'   3E 01                 	MVI	A,1
  0830'   B7                    	ORA	A		; NZ: it needs a record of its own
  0831'   C3 05A6'              	JMP	POPRET
                                
                                ;UNDAPT -- append BC bytes of resident text, from logical offset HL, to the
                                ;undo region.  One byte at a time, re-reading the offset through CHARAT and the
                                ;region through its pointer cell every time, so growing the region (which
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


                                ;slides regions about) can never leave this loop holding a stale address.
                                ;CY if it outgrows the claim, and the caller then gives the change up.
  0834'                         UNDAPT:
  0834'   78                    	MOV	A,B
  0835'   B1                    	ORA	C
  0836'   C8                    	RZ			; nothing to append
  0837'                         UNDAPL:
  0837'   C5                    	PUSH	B
  0838'   E5                    	PUSH	H
  0839'   CD 061F'              	CALL	CHARAT		; A = the text byte at this offset
  083C'   CD 084A'              	CALL	UNDAPB		; ... into the region
  083F'   E1                    	POP	H
  0840'   C1                    	POP	B
  0841'   D8                    	RC
  0842'   23                    	INX	H
  0843'   0B                    	DCX	B
  0844'   78                    	MOV	A,B
  0845'   B1                    	ORA	C
  0846'   C2 0837'              	JNZ	UNDAPL
  0849'   C9                    	RET
                                
                                ;UNDAPB -- put the byte in A into the room UNDGRW claimed.  It does NOT grow
                                ;the region -- see UNDGRW -- so CY, and the change given up on, once the room
                                ;is used up: a change bigger than the region is simply not undoable.
  084A'                         UNDAPB:
  084A'   C5                    	PUSH	B
  084B'   D5                    	PUSH	D
  084C'   E5                    	PUSH	H
  084D'   32 0000*              	STA	UNDB1
  0850'   21 0000*              	LXI	H,UBEG
  0853'   CD 04A7'              	CALL	PRSPAN		; BC = the region's size
  0856'   2A 0000*              	LHLD	UNDPTR
  0859'   EB                    	XCHG			; DE = where the next byte goes
  085A'   60                    	MOV	H,B
  085B'   69                    	MOV	L,C
  085C'   CD 0579'              	CALL	CMP16		; CY iff that is still inside the region
  085F'   D2 0875'              	JNC	UNDAPF
  0862'   2A 0000*              	LHLD	UBEG		; re-read: a relocation moves the region
  0865'   19                    	DAD	D
  0866'   3A 0000*              	LDA	UNDB1
  0869'   77                    	MOV	M,A
  086A'   2A 0000*              	LHLD	UNDPTR
  086D'   23                    	INX	H
  086E'   22 0000*              	SHLD	UNDPTR
  0871'   B7                    	ORA	A		; CY clear: it went in
  0872'   C3 05A6'              	JMP	POPRET
  0875'                         UNDAPF:
  0875'   3E 01                 	MVI	A,1
  0877'   32 0000*              	STA	UNDBAD
  087A'   37                    	STC
  087B'   C3 05A6'              	JMP	POPRET
                                
                                ;UNDRM -- CY, and the change given up on, unless the arena still holds UNDRSV
                                ;free.  The capture must never page: paging moves the window off the change and
                                ;would invalidate every logical offset the records hold.  Keeping this much
                                ;free also keeps MKGAP off its MKROOM path, so the capture cannot page even by
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


                                ;accident, and it fails QUIETLY where QROOM raises 'QBUF FULL' -- undo going
                                ;away must never stop the editing.
  087E'                         UNDRM:
  087E'   C5                    	PUSH	B
  087F'   D5                    	PUSH	D
  0880'   E5                    	PUSH	H
  0881'   CD 0441'              	CALL	BUFSUM		; DE = the arena's free bytes
  0884'   21 0200               	LXI	H,UNDRSV
  0887'   CD 0579'              	CALL	CMP16		; CY iff less than that is left
  088A'   D2 05A6'              	JNC	POPRET
  088D'   3E 01                 	MVI	A,1
  088F'   32 0000*              	STA	UNDBAD
  0892'   37                    	STC
  0893'   C3 05A6'              	JMP	POPRET
                                
                                ;---------------------------------------------------------------- the replay
                                
                                ;UNDO -- 'u'.  CY when there is nothing to undo: no change captured, a change
                                ;too big to have been captured, or the pager has moved the window off it.
  0896'                         UNDO:
  0896'   AF                    	XRA	A
  0897'   32 0000*              	STA	UNDWHY		; refused for want of a change, until told else
  089A'   3A 0000*              	LDA	UNDBAD		; asked BEFORE the count of records: a change
  089D'   B7                    	ORA	A		;   too big from its very first step leaves
  089E'   CA 08A8'              	JZ	UND_OK		;   none, and is still not 'nothing to undo'
  08A1'   3E 02                 	MVI	A,2
  08A3'   32 0000*              	STA	UNDWHY		; too big to have been captured: CMD.MAC says
  08A6'   37                    	STC			;   so, rather than ringing the bell at a user
  08A7'   C9                    	RET			;   who has no way to know why
  08A8'                         UND_OK:
  08A8'   3A 0000*              	LDA	UNDN
  08AB'   B7                    	ORA	A
  08AC'   37                    	STC
  08AD'   C8                    	RZ			; nothing captured
  08AE'   2A 0000*              	LHLD	PGTOPM
  08B1'   EB                    	XCHG
  08B2'   2A 0000*              	LHLD	UNDPG
  08B5'   CD 0579'              	CALL	CMP16
  08B8'   C2 08EB'              	JNZ	UNDPGD		; the pager has moved the window's top since,
                                				;   so every offset the records hold has shifted
  08BB'   3E FF                 	MVI	A,0FFH
  08BD'   32 0000*              	STA	UNDML		; (no step taken yet)
  08C0'   AF                    	XRA	A
  08C1'   32 0000*              	STA	UNDLK
  08C4'   32 0000*              	STA	UNDLC
  08C7'   3E 01                 	MVI	A,1
  08C9'   32 0000*              	STA	UNDRPL		; the replay's own edits are not a new change
  08CC'   3A 0000*              	LDA	UNDST
  08CF'   FE 01                 	CPI	1
  08D1'   CA 08F2'              	JZ	UNDREV
                                	;--- the last 'u' undid it: apply the records forward again (a redo) ---
  08D4'   AF                    	XRA	A
  08D5'   32 0000*              	STA	UNDDIR
  08D8'   AF                    	XRA	A
  08D9'                         UNDFWL:
  08D9'   CD 0913'              	CALL	URSTEP
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  08DC'   3C                    	INR	A
  08DD'   47                    	MOV	B,A
  08DE'   3A 0000*              	LDA	UNDN
  08E1'   B8                    	CMP	B
  08E2'   78                    	MOV	A,B
  08E3'   C2 08D9'              	JNZ	UNDFWL
  08E6'   3E 01                 	MVI	A,1
  08E8'   C3 0904'              	JMP	UNDFIN
  08EB'                         UNDPGD:
  08EB'   3E 01                 	MVI	A,1
  08ED'   32 0000*              	STA	UNDWHY		; the change is no longer in the window
  08F0'   37                    	STC
  08F1'   C9                    	RET
  08F2'                         UNDREV:
                                	;--- undo: the records backward, each one's inverse ---
  08F2'   3E 01                 	MVI	A,1
  08F4'   32 0000*              	STA	UNDDIR
  08F7'   3A 0000*              	LDA	UNDN
  08FA'                         UNDRVL:
  08FA'   3D                    	DCR	A
  08FB'   CD 0913'              	CALL	URSTEP
  08FE'   B7                    	ORA	A
  08FF'   C2 08FA'              	JNZ	UNDRVL
  0902'   3E 02                 	MVI	A,2
  0904'                         UNDFIN:
  0904'   32 0000*              	STA	UNDST
  0907'   AF                    	XRA	A
  0908'   32 0000*              	STA	UNDRPL
                                	;--- the cursor goes back where the command that changed it began:
                                	;    measured from vim, which restores that and not the change's own
                                	;    offset (CMD.MAC's VC_UNDO holds it inside the line) ---
  090B'   2A 0000*              	LHLD	UNDCUR
  090E'   CD 0635'              	CALL	GOTO
  0911'   B7                    	ORA	A		; CY clear: it happened
  0912'   C9                    	RET
                                
                                ;URSTEP -- apply record A: as it stands when UNDDIR is 0 (a redo), inverted
                                ;when it is 1 (an undo).  An insert applied puts its saved bytes back at its
                                ;offset; an insert inverted deletes that many bytes there; a delete is the
                                ;mirror of both.  A is preserved -- UNDO's loops count with it.
  0913'                         URSTEP:
  0913'   F5                    	PUSH	PSW
  0914'   CD 07CC'              	CALL	URADDR
  0917'   7E                    	MOV	A,M
  0918'   32 0000*              	STA	UNDTY
  091B'   23                    	INX	H
  091C'   7E                    	MOV	A,M
  091D'   32 0000*              	STA	UNDOF
  0920'   23                    	INX	H
  0921'   7E                    	MOV	A,M
  0922'   32 0001*              	STA	UNDOF+1
  0925'   23                    	INX	H
  0926'   7E                    	MOV	A,M
  0927'   32 0000*              	STA	UNDLN
  092A'   23                    	INX	H
  092B'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  092C'   32 0001*              	STA	UNDLN+1
  092F'   23                    	INX	H
  0930'   7E                    	MOV	A,M
  0931'   32 0000*              	STA	UNDBO
  0934'   23                    	INX	H
  0935'   7E                    	MOV	A,M
  0936'   32 0001*              	STA	UNDBO+1
  0939'   2A 0000*              	LHLD	UNDBO		; a line end among its bytes: more than one
  093C'   EB                    	XCHG			;   line changes (UNDML: CMD.MAC picks the
  093D'   2A 0000*              	LHLD	UBEG		;   repaint by it)
  0940'   19                    	DAD	D
  0941'   EB                    	XCHG
  0942'   2A 0000*              	LHLD	UNDLN
  0945'   19                    	DAD	D
  0946'   CD 0665'              	CALL	LFCNT
  0949'   7A                    	MOV	A,D
  094A'   B3                    	ORA	E
  094B'   CA 0953'              	JZ	URS_1L
  094E'   3E 01                 	MVI	A,1
  0950'   32 0000*              	STA	UNDML
  0953'                         URS_1L:
  0953'   3A 0000*              	LDA	UNDTY
  0956'   47                    	MOV	B,A
  0957'   3A 0000*              	LDA	UNDDIR
  095A'   B7                    	ORA	A
  095B'   CA 0967'              	JZ	URS_AP
  095E'   78                    	MOV	A,B		; an undo inverts the record
  095F'   FE 01                 	CPI	UR_INS
  0961'   CA 096D'              	JZ	URS_DL
  0964'   C3 097D'              	JMP	URS_IN
  0967'                         URS_AP:
  0967'   78                    	MOV	A,B		; a redo applies it as it stands
  0968'   FE 01                 	CPI	UR_INS
  096A'   CA 097D'              	JZ	URS_IN
  096D'                         URS_DL:
                                	;--- take the record's length back out at its offset ---
  096D'   CD 09AF'              	CALL	URGOTO
  0970'   3E 02                 	MVI	A,2
  0972'   CD 09D5'              	CALL	URLNQ
  0975'   2A 0000*              	LHLD	UNDLN
  0978'   CD 0690'              	CALL	DELFWD
  097B'   F1                    	POP	PSW
  097C'   C9                    	RET
  097D'                         URS_IN:
                                	;--- put the record's saved bytes back in at its offset ---
  097D'   CD 09AF'              	CALL	URGOTO
  0980'   3E 01                 	MVI	A,1
  0982'   CD 09D5'              	CALL	URLNQ
  0985'   2A 0000*              	LHLD	UNDLN
  0988'   44                    	MOV	B,H
  0989'   4D                    	MOV	C,L
  098A'   2A 0000*              	LHLD	UNDBO
  098D'                         URSILP:
  098D'   C5                    	PUSH	B
  098E'   E5                    	PUSH	H
  098F'   EB                    	XCHG			; DE = the byte's offset within the region
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0990'   2A 0000*              	LHLD	UBEG		; ... re-read every byte: inserting text can
  0993'   19                    	DAD	D		;     slide the region out from under it
  0994'   7E                    	MOV	A,M
  0995'   CD 0054'              	CALL	PUTGAP
  0998'   FE 0A                 	CPI	LF
  099A'   C2 09A4'              	JNZ	URSILN
  099D'   2A 0000*              	LHLD	LNDLT		; a line end put back is the cursor crossing
  09A0'   23                    	INX	H		;   one, and GOTO keeps LNDLT for every move the
  09A1'   22 0000*              	SHLD	LNDLT		;   replay makes -- so the renderer needs no
  09A4'                         URSILN:				;   whole-window rescan to find that out
  09A4'   E1                    	POP	H
  09A5'   C1                    	POP	B
  09A6'   23                    	INX	H
  09A7'   0B                    	DCX	B
  09A8'   78                    	MOV	A,B
  09A9'   B1                    	ORA	C
  09AA'   C2 098D'              	JNZ	URSILP
  09AD'   F1                    	POP	PSW
  09AE'   C9                    	RET
                                
                                ;URGOTO -- the cursor to the record's offset.  The line the first step is on
                                ;is the change's (UNDL0 = LNDLT there, which GOTO keeps up); a later step on
                                ;another line makes the change more than one line's (UNDML).
  09AF'                         URGOTO:
  09AF'   2A 0000*              	LHLD	UNDOF
  09B2'   CD 0635'              	CALL	GOTO
  09B5'   2A 0000*              	LHLD	LNDLT
  09B8'   EB                    	XCHG
  09B9'   3A 0000*              	LDA	UNDML
  09BC'   3C                    	INR	A
  09BD'   C2 09C8'              	JNZ	URG_1
  09C0'   32 0000*              	STA	UNDML		; (0: one line, so far)
  09C3'   EB                    	XCHG
  09C4'   22 0000*              	SHLD	UNDL0
  09C7'   C9                    	RET
  09C8'                         URG_1:
  09C8'   2A 0000*              	LHLD	UNDL0
  09CB'   CD 0579'              	CALL	CMP16
  09CE'   C8                    	RZ
  09CF'   3E 01                 	MVI	A,1
  09D1'   32 0000*              	STA	UNDML
  09D4'   C9                    	RET
                                
                                ;URLNQ -- the step about to be taken at the cursor puts the record's bytes in
                                ;(A = 1) or takes them out (A = 2).  UNDLK stays that for as long as every
                                ;step does the same, with whole lines -- it starts at a line's start and the
                                ;bytes end in a line end -- and at the place the first one did (UNDLL0 =
                                ;LNDLT there); UNDLC counts the lines.  Anything else and UNDLK is 0FFH.
                                ;Two more ways of taking a whole line out are known for what they are: steps
                                ;at one line's start that end with a line only when the last has gone (UNDLK
                                ;is 3 until then), and one step from a line's END that takes its line end and
                                ;the next line's text -- the line under it, so UNDLL0 is that line's.
                                ;CMD.MAC opens the rows for lines put back, or closes them up, by these.
  09D5'                         URLNQ:
  09D5'   47                    	MOV	B,A
  09D6'   3A 0000*              	LDA	UNDLK
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  09D9'   B7                    	ORA	A
  09DA'   CA 09F7'              	JZ	URL_1
  09DD'   F6 01                 	ORI	1		; (2 and 3 are both lines going)
  09DF'   4F                    	MOV	C,A
  09E0'   78                    	MOV	A,B
  09E1'   F6 01                 	ORI	1
  09E3'   B9                    	CMP	C
  09E4'   C2 0AA7'              	JNZ	URL_NO
  09E7'   2A 0000*              	LHLD	UNDLL0
  09EA'   EB                    	XCHG
  09EB'   2A 0000*              	LHLD	LNDLT
  09EE'   CD 0579'              	CALL	CMP16
  09F1'   C2 0AA7'              	JNZ	URL_NO
  09F4'   C3 09FD'              	JMP	URL_2
  09F7'                         URL_1:
  09F7'   2A 0000*              	LHLD	LNDLT
  09FA'   22 0000*              	SHLD	UNDLL0
  09FD'                         URL_2:
  09FD'   CD 05E4'              	CALL	CUROFF
  0A00'   7C                    	MOV	A,H
  0A01'   B5                    	ORA	L
  0A02'   CA 0A56'              	JZ	URL_3
  0A05'   2A 0000*              	LHLD	GAPBEG
  0A08'   2B                    	DCX	H
  0A09'   7E                    	MOV	A,M
  0A0A'   FE 0A                 	CPI	LF
  0A0C'   CA 0A56'              	JZ	URL_3
                                	;--- not at a line's start.  One step that takes out a line end and
                                	;    what follows it as far as the next ('o' and what was typed) is
                                	;    the line under that one going, all the same: UNDLL0 as for it ---
  0A0F'   78                    	MOV	A,B
  0A10'   FE 02                 	CPI	2
  0A12'   C2 0AA7'              	JNZ	URL_NO
  0A15'   3A 0000*              	LDA	UNDLK
  0A18'   B7                    	ORA	A
  0A19'   C2 0AA7'              	JNZ	URL_NO
  0A1C'   2A 0000*              	LHLD	UNDBO
  0A1F'   EB                    	XCHG
  0A20'   2A 0000*              	LHLD	UBEG
  0A23'   19                    	DAD	D
  0A24'   7E                    	MOV	A,M
  0A25'   FE 0D                 	CPI	CR
  0A27'   CA 0A2F'              	JZ	URL_B0
  0A2A'   FE 0A                 	CPI	LF
  0A2C'   C2 0AA7'              	JNZ	URL_NO
  0A2F'                         URL_B0:
  0A2F'   2A 0000*              	LHLD	UNDLN
  0A32'   EB                    	XCHG
  0A33'   2A 0000*              	LHLD	GAPEND
  0A36'   19                    	DAD	D
  0A37'   EB                    	XCHG			; DE = the text after what goes
  0A38'   2A 0000*              	LHLD	TXTEND
  0A3B'   CD 0579'              	CALL	CMP16
  0A3E'   D2 0A4C'              	JNC	URL_B1		; (the end of the text)
  0A41'   1A                    	LDAX	D
  0A42'   FE 0D                 	CPI	CR
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0A44'   CA 0A4C'              	JZ	URL_B1
  0A47'   FE 0A                 	CPI	LF
  0A49'   C2 0AA7'              	JNZ	URL_NO
  0A4C'                         URL_B1:
  0A4C'   2A 0000*              	LHLD	UNDLL0
  0A4F'   23                    	INX	H
  0A50'   22 0000*              	SHLD	UNDLL0
  0A53'   C3 0A76'              	JMP	URL_4
  0A56'                         URL_3:
  0A56'   2A 0000*              	LHLD	UNDLN
  0A59'   7C                    	MOV	A,H
  0A5A'   B5                    	ORA	L
  0A5B'   CA 0AA7'              	JZ	URL_NO
  0A5E'   EB                    	XCHG
  0A5F'   2A 0000*              	LHLD	UNDBO
  0A62'   19                    	DAD	D
  0A63'   EB                    	XCHG
  0A64'   2A 0000*              	LHLD	UBEG
  0A67'   19                    	DAD	D		; HL = past the record's bytes
  0A68'   2B                    	DCX	H
  0A69'   7E                    	MOV	A,M
  0A6A'   FE 0A                 	CPI	LF
  0A6C'   CA 0A76'              	JZ	URL_4
  0A6F'   78                    	MOV	A,B		; steps that take text out at one place take
  0A70'   FE 02                 	CPI	2		;   what is there each time, so it is the last
  0A72'   C2 0AA7'              	JNZ	URL_NO		;   of them that has to end with a line: 3
  0A75'   04                    	INR	B		;   until it does ('O': the text typed goes,
  0A76'                         URL_4:				;   then the line end before it)
  0A76'   2A 0000*              	LHLD	UNDLN
  0A79'   EB                    	XCHG
  0A7A'   2A 0000*              	LHLD	UNDBO
  0A7D'   19                    	DAD	D
  0A7E'   EB                    	XCHG
  0A7F'   2A 0000*              	LHLD	UBEG
  0A82'   19                    	DAD	D
  0A83'   E5                    	PUSH	H
  0A84'   2A 0000*              	LHLD	UNDBO
  0A87'   EB                    	XCHG
  0A88'   2A 0000*              	LHLD	UBEG
  0A8B'   19                    	DAD	D
  0A8C'   EB                    	XCHG			; DE = their start
  0A8D'   E1                    	POP	H
  0A8E'   C5                    	PUSH	B
  0A8F'   CD 0665'              	CALL	LFCNT
  0A92'   C1                    	POP	B
  0A93'   7A                    	MOV	A,D
  0A94'   B7                    	ORA	A
  0A95'   C2 0AA7'              	JNZ	URL_NO
  0A98'   3A 0000*              	LDA	UNDLC
  0A9B'   83                    	ADD	E
  0A9C'   DA 0AA7'              	JC	URL_NO
  0A9F'   32 0000*              	STA	UNDLC
  0AA2'   78                    	MOV	A,B
  0AA3'   32 0000*              	STA	UNDLK
  0AA6'   C9                    	RET
  0AA7'                         URL_NO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0AA7'   3E FF                 	MVI	A,0FFH
  0AA9'   32 0000*              	STA	UNDLK
  0AAC'   C9                    	RET
                                
                                ;---------------------------------------------------------------- the hooks
                                
                                ;UNDPUT -- PUTGAP's tail: the one byte now sitting just below the cursor.
  0AAD'                         UNDPUT:
  0AAD'   F5                    	PUSH	PSW
  0AAE'   C5                    	PUSH	B
  0AAF'   D5                    	PUSH	D
  0AB0'   E5                    	PUSH	H
  0AB1'   CD 05E4'              	CALL	CUROFF
  0AB4'   2B                    	DCX	H
  0AB5'   01 0001               	LXI	B,1
  0AB8'   3E 01                 	MVI	A,UR_INS
  0ABA'   CD 0746'              	CALL	UNDCHG
  0ABD'   C3 0B1B'              	JMP	UNDHX
                                
                                ;UNDGET -- QGET's tail: BC bytes of register now in, the cursor past them.
                                ;UNDINS is the same entry by its general name: INSBLK itself carries NO hook
                                ;(insert mode records a byte at a time through PUTGAP), so a command that
                                ;splices a block in -- ':s' replacing a match -- has to say so itself, exactly
                                ;as QGET does.  Without it 'u' puts the deleted text back and leaves the
                                ;inserted text there ('a-a-a' undid to 'aZ-aZ-aZ').
  0AC0'                         UNDINS:
  0AC0'                         UNDGET:
  0AC0'   F5                    	PUSH	PSW
  0AC1'   C5                    	PUSH	B
  0AC2'   D5                    	PUSH	D
  0AC3'   E5                    	PUSH	H
  0AC4'   78                    	MOV	A,B
  0AC5'   B1                    	ORA	C
  0AC6'   CA 0B1B'              	JZ	UNDHX
  0AC9'   CD 05E4'              	CALL	CUROFF
  0ACC'   50                    	MOV	D,B
  0ACD'   59                    	MOV	E,C
  0ACE'   CD 055B'              	CALL	SUBHD		; HL = where the put began
  0AD1'   3E 01                 	MVI	A,UR_INS
  0AD3'   CD 0746'              	CALL	UNDCHG
  0AD6'   C3 0B1B'              	JMP	UNDHX
                                
                                ;UNDDLF -- DELFWD's head: HL bytes about to go forward from the cursor.
  0AD9'                         UNDDLF:
  0AD9'   F5                    	PUSH	PSW
  0ADA'   C5                    	PUSH	B
  0ADB'   D5                    	PUSH	D
  0ADC'   E5                    	PUSH	H
  0ADD'   44                    	MOV	B,H
  0ADE'   4D                    	MOV	C,L
  0ADF'   CD 05E4'              	CALL	CUROFF
  0AE2'   3E 02                 	MVI	A,UR_DEL
  0AE4'   CD 0746'              	CALL	UNDCHG
  0AE7'   C3 0B1B'              	JMP	UNDHX
                                
                                ;UNDDLQ -- QPUTLN's head: BC bytes of whole lines about to go into the register.
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0AEA'                         UNDDLQ:
  0AEA'   F5                    	PUSH	PSW
  0AEB'   C5                    	PUSH	B
  0AEC'   D5                    	PUSH	D
  0AED'   E5                    	PUSH	H
  0AEE'   CD 05E4'              	CALL	CUROFF
  0AF1'   3E 02                 	MVI	A,UR_DEL
  0AF3'   CD 0746'              	CALL	UNDCHG
  0AF6'   C3 0B1B'              	JMP	UNDHX
                                
                                ;UNDDLP -- DELPRV's head: the one byte just below the cursor, about to go.
  0AF9'                         UNDDLP:
  0AF9'   F5                    	PUSH	PSW
  0AFA'   C5                    	PUSH	B
  0AFB'   D5                    	PUSH	D
  0AFC'   E5                    	PUSH	H
  0AFD'   CD 05E4'              	CALL	CUROFF
  0B00'   2B                    	DCX	H
  0B01'   01 0001               	LXI	B,1
  0B04'   3E 02                 	MVI	A,UR_DEL
  0B06'   CD 0746'              	CALL	UNDCHG
  0B09'   C3 0B1B'              	JMP	UNDHX
                                
                                ;UNDUDF -- UNDELF's tail: the byte DELTO just made text again, at the cursor.
  0B0C'                         UNDUDF:
  0B0C'   F5                    	PUSH	PSW
  0B0D'   C5                    	PUSH	B
  0B0E'   D5                    	PUSH	D
  0B0F'   E5                    	PUSH	H
  0B10'   CD 05E4'              	CALL	CUROFF
  0B13'   01 0001               	LXI	B,1
  0B16'   3E 01                 	MVI	A,UR_INS
  0B18'   CD 0746'              	CALL	UNDCHG
                                ;UNDHX -- every hook leaves the primitive's own registers and flags alone.
  0B1B'                         UNDHX:
  0B1B'   E1                    	POP	H
  0B1C'   D1                    	POP	D
  0B1D'   C1                    	POP	B
  0B1E'   F1                    	POP	PSW
  0B1F'   C9                    	RET
                                
                                ;============================================================
                                ; DATA -- what the image carries: the cells that start at something.
                                ;============================================================
                                ;The cells that start at zero are not in the image: RSV.MAC names them, in
                                ;the RAM just above it, and BUF.MAC's ZINIT clears them before anything runs.
                                ;Their order there is the order they had here, and code depends on it.
                                ;WM's (base,limit) pointer row, the search pattern and 'u''s state are there.
                                	EXTRN	BUFBEG, QBEG, QEND, HOLEQP, TXTBAS, UBEG
                                	EXTRN	UEND, TXTBEG, GAPBEG, GAPEND, TXTEND, PRTERM
                                	EXTRN	BUFEND, MVGTOP, ERRFLG, SRCHBF, SRCHST, L2756
                                	EXTRN	QCPDON, UNDN, UNDST, UNDBAD, UNDRPL, UNDDIR
                                	EXTRN	UNDWHY, UNDTY, UNDOF, UNDLN, UNDBO, UNDCL
                                	EXTRN	UNDLSA, UNDPG, UNDPTR, UNDB1, UNDPCU, UNDCUR
                                	EXTRN	UNDLK, UNDLC, UNDLL0, UNDML, UNDL0, LNDLT
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0B20'   1E                    SRCMAX: DB	SRMAX		; SRCHST's capacity, so CMD.MAC cannot drift
  0B21'   01                    UNDNEW: DB	1		; 'u': 1 = the next capture starts a new change
                                
                                ;PBEGMEM -- base of the text arena: the first RAM byte past everything the
                                ;program holds.  The gap buffer's text lives from here up to BUFEND.  BUF
                                ;links last but RSV.MAC links after it, holding the reserve block in the RAM
                                ;immediately above the image (it emits no bytes of its own), so the arena
                                ;starts at RSVTOP -- past the reserves -- and is the size it always was.
  0B22'   0000*                 PBEGMEM:DW	RSVTOP
                                
  0B24'                         MEMBAS:				; top of the linked image (RSV.MAC's base)
                                
                                	END
