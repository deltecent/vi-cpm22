  03DD'   23                    	INX	H
  03DE'   D1                    	POP	D
  03DF'   73                    	MOV	M,E
  03E0'   23                    	INX	H
  03E1'   72                    	MOV	M,D
  03E2'   B7                    	ORA	A
  03E3'   C3 062E'              	JMP	POPRET
                                
                                ;GAPLF -- WM 5000: slide the gap toward lower addresses (cursor left).
  03E6'                         GAPLF:				; WM 5000
  03E6'   EB                    	XCHG
