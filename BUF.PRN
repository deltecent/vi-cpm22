  0401'   2B                    	DCX	H
  0402'   73                    	MOV	M,E
  0403'   B7                    	ORA	A
  0404'   C3 062E'              	JMP	POPRET
                                
                                ;PUTHOLE -- WM 5031: move the gap so it begins at address DE.
  0407'                         PUTHOLE:			; WM 5031
