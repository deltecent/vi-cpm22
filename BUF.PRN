                                ;============================================================
                                ; AFTER-CURSOR READ -- WM.ASM 3989-4048 (RGET0, RGET, AFTOFF, RECOUNT), verbatim.
                                ; RPEEK/RPEEKX (WM 3995-4006) are not used and are left out.  WM's CALL GETKEY
                                ; in RGET is KBPOLL here (KEY.MAC owns the ring), as in GOLINE.
                                ;============================================================
                                
                                ;RGET0 -- WM 3989: HL = GAPEND, BC = bytes from there to TXTEND.
  04E5'                         RGET0:				; WM 3989
  04E5'   CD 04D7'              	CALL	AFTLEN
  04E8'   CD 05A7'              	CALL	LDHLI
  04EB'   C9                    	RET
                                
                                ;RGET -- WM 4007: next char [HL++], BC--; when BC runs out, NEEDIN pages more
                                ;input in and BC is recounted.  CY at the end of the text.
  04EC'                         RGET:				; WM 4007
  04EC'   78                    	MOV	A,B
  04ED'   B1                    	ORA	C
  04EE'   C2 0502'              	JNZ	RGETCH
  04F1'   CD 0506'              	CALL	AFTOFF
  04F4'   E5                    	PUSH	H
  04F5'   CD 0000*              	CALL	NEEDIN
  04F8'   E1                    	POP	H
  04F9'   F5                    	PUSH	PSW
  04FA'   CD 0000*              	CALL	KBPOLL		; WM: CALL GETKEY
  04FD'   CD 0510'              	CALL	RECOUNT
  0500'   F1                    	POP	PSW
  0501'   D8                    	RC
  0502'                         RGETCH:				 ; WM 4021 -- return the next after-cursor char
  0502'   7E                    	MOV	A,M
  0503'   0B                    	DCX	B
  0504'   23                    	INX	H
  0505'   C9                    	RET
                                
                                ;AFTOFF -- WM 4028: HL = HL - GAPEND (survives the refill moving the text).
