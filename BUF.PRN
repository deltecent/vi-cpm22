                                ;BUFSUM -- WM 5080: DE = the sum of the pair spans walked from BUFBEG -- the
                                ;row's holes, so the arena's free bytes (MKGAP tests D for a free page).
  043D'                         BUFSUM:				; WM 5080
  043D'   C5                    	PUSH	B
  043E'   E5                    	PUSH	H
  043F'   11 0000               	LXI	D,0H
  0442'   21 09D6'              	LXI	H,BUFBEG
  0445'                         BSUMLP:				 ; WM 5086
  0445'   CD 04A3'              	CALL	PRSPAN
  0448'   EB                    	XCHG
  0449'   09                    	DAD	B
  044A'   EB                    	XCHG
  044B'   CD 0454'              	CALL	NEXTPR
  044E'   D2 0445'              	JNC	BSUMLP
  0451'   E1                    	POP	H
  0452'   C1                    	POP	B
  0453'   C9                    	RET
