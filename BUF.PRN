  03F4'   23                    	INX	H
  03F5'   56                    	MOV	D,M
  03F6'   E3                    	XTHL
  03F7'   CD 0553'              	CALL	MCPYR
  03FA'   E3                    	XTHL
  03FB'   72                    	MOV	M,D
