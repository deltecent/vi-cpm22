  050B'   CD 058D'              	CALL	SUBDH
  050E'   D1                    	POP	D
  050F'   C9                    	RET
                                
                                ;RECOUNT -- WM 4037: HL = GAPEND + offset, BC = bytes left after a refill.
  0510'                         RECOUNT:			; WM 4037
  0510'   D5                    	PUSH	D
  0511'   EB                    	XCHG
  0512'   CD 04D7'              	CALL	AFTLEN
  0515'   CD 05A7'              	CALL	LDHLI
  0518'   19                    	DAD	D
