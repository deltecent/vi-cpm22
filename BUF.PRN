                                ;MEMCPY -- WM 5186: copy BC bytes [HL]->[DE] forward.
  04EA'                         MEMCPY:				; WM 5186
  04EA'   CD 0531'              	CALL	CKCOPY
  04ED'   CD 0575'              	CALL	CMP16
  04F0'   C2 04FA'              	JNZ	MCPYSU
  04F3'   09                    	DAD	B
  04F4'   EB                    	XCHG
  04F5'   09                    	DAD	B
  04F6'   01 0000               	LXI	B,0H
  04F9'   C9                    	RET
  04FA'                         MCPYSU:				 ; WM 5196
  04FA'   04                    	INR	B
  04FB'   0C                    	INR	C
  04FC'   C3 0503'              	JMP	MCPYCT
  04FF'                         MCPYBO:				 ; WM 5201
  04FF'   7E                    	MOV	A,M
  0500'   12                    	STAX	D
  0501'   23                    	INX	H
  0502'   13                    	INX	D
  0503'                         MCPYCT:				 ; WM 5207
  0503'   0D                    	DCR	C
  0504'   C2 04FF'              	JNZ	MCPYBO
  0507'   05                    	DCR	B
  0508'   C2 04FF'              	JNZ	MCPYBO
  050B'   C9                    	RET
                                
                                ;MCPYR -- WM 5215: copy BC bytes [HL]->[DE] backward.
  050C'                         MCPYR:			      ; WM 5215
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  050C'   CD 0531'              	CALL	CKCOPY
  050F'   CD 0575'              	CALL	CMP16
  0512'   C2 051F'              	JNZ	MCPRSU
  0515'   CD 054C'              	CALL	NEGBC
  0518'   09                    	DAD	B
  0519'   EB                    	XCHG
  051A'   09                    	DAD	B
  051B'   01 0000               	LXI	B,0H
  051E'   C9                    	RET
  051F'                         MCPRSU:				 ; WM 5226
  051F'   04                    	INR	B
  0520'   0C                    	INR	C
  0521'   C3 0528'              	JMP	MCPRCT
  0524'                         MCPRBO:				 ; WM 5231
  0524'   2B                    	DCX	H
  0525'   1B                    	DCX	D
  0526'   7E                    	MOV	A,M
  0527'   12                    	STAX	D
  0528'                         MCPRCT:				 ; WM 5237
  0528'   0D                    	DCR	C
  0529'   C2 0524'              	JNZ	MCPRBO
  052C'   05                    	DCR	B
  052D'   C2 0524'              	JNZ	MCPRBO
  0530'   C9                    	RET
                                
                                ;CKCOPY -- WM 5249: copy-length sanity guard ('COPY ERR').
  0531'                         CKCOPY:				; WM 5249
