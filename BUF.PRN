  04B2'   CD 0571'              	CALL	LDHLI
  04B5'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


                                ;RGET -- WM 4007: next char [HL++], BC--; when BC runs out, NEEDIN pages more
                                ;input in and BC is recounted.  CY at the end of the text.
  04B6'                         RGET:				; WM 4007
  04B6'   78                    	MOV	A,B
  04B7'   B1                    	ORA	C
  04B8'   C2 04CC'              	JNZ	RGETCH
  04BB'   CD 04D0'              	CALL	AFTOFF
  04BE'   E5                    	PUSH	H
  04BF'   CD 0000*              	CALL	NEEDIN
  04C2'   E1                    	POP	H
  04C3'   F5                    	PUSH	PSW
  04C4'   CD 0000*              	CALL	KBPOLL		; WM: CALL GETKEY
  04C7'   CD 04DA'              	CALL	RECOUNT
  04CA'   F1                    	POP	PSW
  04CB'   D8                    	RC
  04CC'                         RGETCH:				 ; WM 4021 -- return the next after-cursor char
  04CC'   7E                    	MOV	A,M
  04CD'   0B                    	DCX	B
  04CE'   23                    	INX	H
  04CF'   C9                    	RET
                                
                                ;AFTOFF -- WM 4028: HL = HL - GAPEND (survives the refill moving the text).
  04D0'                         AFTOFF:				; WM 4028
