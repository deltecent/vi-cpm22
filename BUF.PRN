	MACRO-80 3.44	09-Dec-81	PAGE	1


                                ;============================================================
                                ; FILE:    BUF.MAC
                                ; PROJECT: VI
                                ; MODULE:  WordMaster's gap buffer, transcribed VERBATIM from WM.ASM.
                                ;
                                ; This is a direct transcription of MicroPro WordMaster 5.55A's gap-buffer
                                ; primitives.  WordMaster's control flow, register usage and instruction
                                ; sequence are reproduced exactly (same assembled object code); only the
                                ; label NAMES are translated -- WM.ASM's address-derived labels (Lxxxx) are
                                ; renamed to descriptive names, which changes nothing in the assembled bytes.
                                ; Every routine cites its WM.ASM source line, so it still diffs against WM.ASM.
                                ;
                                ; WHAT IS HERE: the gap buffer and the WordMaster routines that walk it --
                                ; insert (PUTGAP/INSBLK/INSSTR), delete (DELTO), cursor move (PUTCUR and
                                ; the gap slides), the pointer-row mechanics (MOVGAP/NEXTPR/BUFSUM/PRSPAN), the
                                ; Q-buffer (the vi yank register), the line moves (MVLMAX/GOLINE/SCRLST), the
                                ; string matchers (MATCHF/MATCHB) and the screen reads (LINPOSB/RGET).  The
                                ; disk is PAGE.MAC's: MKGAP reaches it through MKROOM when RAM is full, CKLOW
                                ; through REWIND, SETGAPB/DELTO through UPDMARK, PAGESTP through PAGEDIR.  A
                                ; file that fits in RAM is the run in which nothing has paged out -- the same
                                ; code runs either way.
                                ;
                                ; NOT TRANSCRIBED: CHRPOS (WM 2158; the cursor moves by address, with PUTCUR),
                                ; INSREPL (WM 1836; ':s' splices through INSSTR) and WM's screen/command init
                                ; (WM 365-377).  WM's PGCONST (WM 412) runs from PAGE.MAC's OPENFIL.
                                ;
                                ; DEVIATIONS FROM WM (each is also flagged where it is):
                                ;   1. ERRMSG's TAIL.  WM's ERRMSG (WM 664) prints its inline message then
                                ;      longjmps to its own command loop.  Here only the tail differs: print
                                ;      the WM message, set ERRFLG, and warm-boot to CP/M, so an error that
                                ;      fires surfaces loudly.  The editor is left the way a quit leaves it:
                                ;      the message goes on the bottom row (ERRHK, the editor's screen
                                ;      teardown) and no work file stays on the disk (PAGE.MAC's DISCRD).
                                ;   2. PUTGAP calls UPDMARK BEFORE it stores the byte (WM bug, issue #31).
                                ;      WM's PUTGAP (WM 1744) stores, steps GAPBEG past the byte and only then
                                ;      reaches UPDMARK through SETGAPB, so a byte stored in the LAST byte of
                                ;      a 128-byte record leaves that record counted as unchanged; after a
                                ;      page back the save then keeps its old copy on disk.  See PUTGAP.
                                ;
                                ; APPENDED (non-WM), each section tagged where it starts:
                                ;   * the LOGICAL-OFFSET API (CUROFF/LOGLEN/CHARAT/GOTO/LFCNT, DELFWD, UNDELF,
                                ;     and DELPRV, which is WM's RUBOUT) -- a logical offset is a byte index
                                ;     into resident text as if the gap were absent.  It lives here, with the
                                ;     pointer row it reads.
                                ;   * single-level undo ('u'), captured inside the primitives that change text.
                                ;   * LNDLT/RDGET, the cursor-line tracking the renderer reads.
                                ;============================================================
                                
  0000                          WBOOT	EQU	0		; CP/M warm boot
  0005                          BDOS	EQU	5		; BDOS entry
  0006                          MEMTOP	EQU	6		; word here = BDOS base (top of usable TPA)
  001A                          EOF	EQU	1AH		; ^Z
  000A                          LF	EQU	0AH
  000D                          CR	EQU	0DH
  0008                          BS	EQU	08H
  0009                          TAB	EQU	09H
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


  001B                          ESC	EQU	1BH
  001E                          SRMAX	EQU	30		; the longest search pattern ('/' line)
  0D80                          RESVMEM EQU	0D80H		; WM 25: the arena QROOM keeps free past
                                				;   the Q-buffer
                                
                                ;--- Primitives the exerciser / editor calls (all WordMaster names). ----------
                                	PUBLIC	ZINIT, BINIT
                                	PUBLIC	INSBLK, INSSTR, PUTGAP, DELTO
                                	PUBLIC	PUTCUR, PEEKL, PEEKLX
                                	PUBLIC	BUFSUM, PRSPAN, AFTLEN, SPANBC
                                
                                ;--- The (base,limit) pointer row + arena bounds it reads/reports. ------------
                                	PUBLIC	PBEGMEM
                                
                                ;--- The Q-buffer: the vi layer's yank register.  WM.ASM 1528-1600. ----------
                                	PUBLIC	QCOPY, QGET, QKILL, QROOM, QPUTLN
                                	PUBLIC	QCPYN			 ; ... and the APPENDED copy that does not delete
                                
                                ;--- String search: the pattern and the two matchers.  WM.ASM 2035-2150. -----
                                	PUBLIC	MATCHF, MATCHB, FWDCNT, SUBLEN
                                	PUBLIC	SRCMAX
                                
                                ;--- APPENDED pointer-free logical-offset API (see header; NOT WordMaster). ----
                                	PUBLIC	CUROFF, LOGLEN, CHARAT, GOTO, LFCNT
                                	PUBLIC	DELFWD, DELPRV, UNDELF
                                
                                ;--- APPENDED single-level undo ('u'; NOT WordMaster -- WM has none). ---------
                                	PUBLIC	UNDBEG, UNDO
                                	PUBLIC	UNDHER			 ; ... where the next change starts
                                	PUBLIC	UNDINS			 ; ... a block insert, for 'u'
                                	PUBLIC	UNDCLR
                                	PUBLIC	UNDNEW			 ; ... and the change it captured
                                
                                ;--- Helpers PAGE.MAC (the file-I/O layer) links against. ---------------------
                                ;NOTE: only 6 characters of a name are significant, so SUBCP2 is named to
                                ;stay clear of the local SUBCLP rather than being SUBCLP2.  PUTHOLE -> PUTHOL
                                ;is safe: no local PUTHOL, and PAGE.MAC's EXTRN
                                ;truncates identically.
                                	PUBLIC	MEMCPY, CMP16, LDHLI, PUTHOLE
                                	PUBLIC	SUBHD, POPRET, ERRMSG, SUBCP2
                                
                                ;--- The disk seam, in PAGE.MAC.  MKGAP calls MKROOM; CKLOW
                                ;    calls REWIND; INSBLK calls MARKGB and SETGAPB/DELTO call UPDMARK. ----------
                                	EXTRN	MKROOM, REWIND, UPDMARK, MARKGB
                                	EXTRN	PAGEDIR			; PAGE.MAC -- page one step (PAGESTP falls in)
                                	EXTRN	CNTTST			; CMD.MAC  -- count-exhausted test (PAGESTP)
                                
                                ;--- Line move (WM MVLMAX..SETBWD, GOLINE, SCRLST) -- the vi layer's paging nav.
                                	PUBLIC	MVLMAX, MVLIND, SETBWD, CLRCNT
                                	PUBLIC	GOLINE			; WM 2228 -- CMD.MAC pages to a mark with it
                                	PUBLIC	SCRLST			; WM 4307 -- the search sweep's page step
                                	PUBLIC	SETC0			; WM 1054 -- the line kill's count set
                                	EXTRN	CMDCNT			; CMD.MAC  -- WM CMDCNT
                                	EXTRN	AUXCNT, NEWFIL, DIRFLG	; PAGE.MAC -- WM L271E / NEWFIL / DIRFLG
                                	EXTRN	MOREIN, POLLBRK		; PAGE.MAC -- WM 4743 / WM 6199
                                	EXTRN	PGTOPM			; PAGE.MAC -- the paged-window signature
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                                	EXTRN	DISCRD			; PAGE.MAC -- drop the work files (ERRMSG)
                                	PUBLIC	ERRHK			; VI.MAC   -- ERRMSG's screen hook
                                	PUBLIC	EDTHK			; VI.MAC   -- UNDCHG's hook for the marks
                                	EXTRN	KBPOLL			; KEY.MAC  -- WM GETKEY (type-ahead drain)
                                	EXTRN	UNDREC, RSVTOP		; RSV.MAC  -- the captured change, and the
                                					;   top of the reserve block = arena base
                                	EXTRN	RSVZ, RSVZN		; RSV.MAC  -- the cells that start at zero
                                
                                ;--- Screen reads (WM LINPOSB/LINEPOS, RGET0/RGET) -- the renderer's text access.
                                	PUBLIC	LINPSB, RGET0, RGET
                                	EXTRN	PAGEWIN			; PAGE.MAC -- WM 4350 (LINEPOS pages back)
                                	EXTRN	NEEDIN			; PAGE.MAC -- WM 4617 (RGET pages in)
                                
                                ;--- APPENDED (NOT WordMaster): cursor line tracking for the renderer. ----------
                                	PUBLIC	RDGET
                                
  0000'                         	CSEG
                                
                                ;============================================================
                                ; INIT -- WM.ASM 341-364 (pointer row) + 378-388 (BUFEND from the TPA top).
                                ; Aims every region base at PBEGMEM, writes the 0 sentinel at PBEGMEM, sets
                                ; TXTBAS = PBEGMEM+1, collapses the gap pointers onto TXTBAS, then sets BUFEND
                                ; from the word at 0006.  (WM's PGCONST tail runs from PAGE.MAC's OPENFIL.)
                                ;
                                ; ZINIT is the first call every program makes: it clears the cells that start
                                ; at zero (RSV.MAC, RSVZ on) and falls into BINIT.  They are not in the image,
                                ; so nothing but this makes them zero.  OPENFIL calls BINIT itself, to empty
                                ; the buffer for a new file, and must leave those cells as they are.
                                ;============================================================
  0000'                         ZINIT:				; APPENDED (not WordMaster)
  0000'   21 0000*              	LXI	H,RSVZ
  0003'   01 0000*              	LXI	B,RSVZN
  0006'                         ZINIT1:
  0006'   36 00                 	MVI	M,0
  0008'   23                    	INX	H
  0009'   0B                    	DCX	B
  000A'   78                    	MOV	A,B
  000B'   B1                    	ORA	C
  000C'   C2 0006'              	JNZ	ZINIT1
  000F'                         BINIT:				; WM 341
  000F'   2A 0B1C'              	LHLD	PBEGMEM
  0012'   EB                    	XCHG
  0013'   21 0000*              	LXI	H,BUFBEG
  0016'   3E 04                 	MVI	A,4
  0018'                         INIBAS:				 ; WM 346 -- copy PBEGMEM into each region base
  0018'   73                    	MOV	M,E
  0019'   23                    	INX	H
  001A'   72                    	MOV	M,D
  001B'   23                    	INX	H
  001C'   3D                    	DCR	A
  001D'   C2 0018'              	JNZ	INIBAS
  0020'   AF                    	XRA	A
  0021'   12                    	STAX	D		; [PBEGMEM] = 0  (the sentinel)
  0022'   13                    	INX	D
  0023'   EB                    	XCHG
  0024'   22 0000*              	SHLD	TXTBAS		; TXTBAS = PBEGMEM+1
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


  0027'                         INIGAP:				 ; WM 359 -- reset the gap pointers to TXTBAS
  0027'   2A 0000*              	LHLD	TXTBAS
  002A'   22 0000*              	SHLD	UBEG		; (appended) the undo region, empty, below the
  002D'   22 0000*              	SHLD	UEND		;   text -- see the UNDO section
  0030'   CD 070E'              	CALL	UNDCLR		; ... and nothing to undo into it yet
  0033'   2A 0000*              	LHLD	TXTBAS
  0036'   22 0000*              	SHLD	TXTBEG
  0039'   22 0000*              	SHLD	GAPBEG
  003C'   22 0000*              	SHLD	GAPEND
  003F'   22 0000*              	SHLD	TXTEND
  0042'   2A 0006               	LHLD	MEMTOP		; WM 378 -- word@0006 = BDOS base
  0045'   7D                    	MOV	A,L
  0046'   FE 06                 	CPI	6H
  0048'   CA 004F'              	JZ	INITOP
  004B'   7C                    	MOV	A,H
  004C'   D6 07                 	SUI	7H		; back off 7 pages below BDOS
  004E'   67                    	MOV	H,A
  004F'                         INITOP:				 ; WM 386
  004F'   2B                    	DCX	H
  0050'   22 0000*              	SHLD	BUFEND		; top of usable text RAM
  0053'   C9                    	RET
                                
                                ;============================================================
                                ; INSERT -- WM.ASM 1744-1941
                                ;============================================================
                                
                                ;PUTGAP -- WM 1744: ensure a free gap byte (GAPRSV), store A at the gap,
                                ;advance and record GAPBEG (SETGAPB -> UPDMARK).
                                ;
                                ;DEVIATION 2 (WM bug, issue #31): the CALL UPDMARK before the store is not
                                ;WordMaster's.  UPDMARK lowers OUTREC -- the first record of the work file the
                                ;save must write again -- to OUTPOS plus the WHOLE records between TXTBEG and
                                ;GAPBEG.  Called only after GAPBEG has stepped past the new byte (WM's order),
                                ;a byte stored in the last byte of a record makes that record whole, so it is
                                ;counted as unchanged.  After a move that pages back, the records read in are
                                ;still in the work file (OUTREC above OUTPOS) and the save skips every record
                                ;below OUTREC: it kept the old copy, losing the inserted byte from the file
                                ;while the screen showed it.  Measured on the 100 K file: OUTPOS 0, the cursor
                                ;at offset 1279 (10 x 128 - 1), 'iX' then ':w' saved the old '6' there.
                                ;Marked here, after GAPRSV (which may page, moving TXTBEG and OUTPOS) and
                                ;before the store, GAPBEG still points AT the byte about to change, so its
                                ;record is the first one counted as changed -- the order INSBLK already uses
                                ;(INSCOM's MARKGB before it copies).  The later UPDMARK in SETGAPB still runs
                                ;and changes nothing.  UPDMARK keeps every register.  Test: accept_vi.py
                                ;insert_record_end (the size groups).
  0054'                         PUTGAP:				; WM 1744
  0054'   F5                    	PUSH	PSW
  0055'   CD 00A9'              	CALL	GAPRSV
  0058'   CD 0000*              	CALL	UPDMARK		; DEVIATION 2 (#31): mark before the store
  005B'   CD 0574'              	CALL	LDHLI
  005E'   F1                    	POP	PSW
  005F'   77                    	MOV	M,A
  0060'   23                    	INX	H
  0061'   CD 0067'              	CALL	SETGAPB
  0064'   C3 0AA7'              	JMP	UNDPUT		; (appended) that byte, for 'u'
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


                                ;SETGAPB -- WM 1629: store GAPBEG, then UPDMARK.
  0067'                         SETGAPB:			; WM 1629
  0067'   22 0000*              	SHLD	GAPBEG
  006A'   CD 0000*              	CALL	UPDMARK
  006D'   C9                    	RET
                                
                                ;INSBLK -- WM 1853: splice BC bytes at [DE] into the text at the cursor.
  006E'                         INSBLK:				; WM 1853
  006E'   21 0000*              	LXI	H,GAPBEG
  0071'                         INSCOM:				 ; WM 1856
  0071'   CD 0000*              	CALL	MARKGB
  0074'   CD 00E1'              	CALL	CKLEN
  0077'   C8                    	RZ
  0078'                         INSLP:				; WM 1861 -- make gap room, copy a chunk
  0078'   CD 00BC'              	CALL	MKGAP
  007B'   CD 0093'              	CALL	CPYGAP
  007E'   05                    	DCR	B
  007F'   C2 0078'              	JNZ	INSLP
  0082'   B7                    	ORA	A
  0083'   C9                    	RET
                                
                                ;INSSTR -- WM 1848: splice a LENGTH-PREFIXED string into the text at the
                                ;cursor -- the length byte with its string just above it, which is the shape
                                ;WM's RDSTR leaves a string in (and SRCHBF/SRCHST here).  WM hardwires its one
                                ;string buffer, SRCHBUF; this takes the pointer in DE, because ':s' keeps its
                                ;replacement in its own.  Empty inserts nothing.  The 'u' capture goes with it:
                                ;INSBLK carries no hook of its own, so every caller would otherwise have to
                                ;remember, as QGET does by hand.
  0084'                         INSSTR:				; WM 1848
  0084'   1A                    	LDAX	D		; the length, just below the string (WM 1849)
  0085'   13                    	INX	D
  0086'   B7                    	ORA	A
  0087'   C8                    	RZ
  0088'   4F                    	MOV	C,A
  0089'   06 00                 	MVI	B,0
  008B'   C5                    	PUSH	B		; the length, for the 'u' capture
  008C'   CD 006E'              	CALL	INSBLK
  008F'   C1                    	POP	B
  0090'   C3 0ABA'              	JMP	UNDINS
                                
                                ;CPYGAP -- WM 1870: copy C bytes [DE]->gap (masking bit 7), advance the ptr.
  0093'                         CPYGAP:				; WM 1870
  0093'   E5                    	PUSH	H
  0094'   CD 0574'              	CALL	LDHLI
  0097'                         CPYGLP:				 ; WM 1874
  0097'   1A                    	LDAX	D
  0098'   E6 7F                 	ANI	7FH
  009A'   77                    	MOV	M,A
  009B'   13                    	INX	D
  009C'   23                    	INX	H
  009D'   0D                    	DCR	C
  009E'   C2 0097'              	JNZ	CPYGLP
  00A1'   EB                    	XCHG
  00A2'   E3                    	XTHL
  00A3'   73                    	MOV	M,E
  00A4'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  00A5'   72                    	MOV	M,D
  00A6'   2B                    	DCX	H
  00A7'                         CPYGDN:				 ; WM 1889
  00A7'   D1                    	POP	D
  00A8'   C9                    	RET
                                
                                ;GAPRSV -- WM 1896: guarantee at least one free gap byte before an insert.
  00A9'                         GAPRSV:				; WM 1896
  00A9'   D5                    	PUSH	D
  00AA'   2A 0000*              	LHLD	GAPBEG
  00AD'   EB                    	XCHG
  00AE'   2A 0000*              	LHLD	GAPEND
  00B1'   CD 0579'              	CALL	CMP16
  00B4'   D1                    	POP	D
  00B5'   21 0000*              	LXI	H,GAPBEG
  00B8'   D8                    	RC
  00B9'                         MKGAPB:				; WM 1907
  00B9'   21 0000*              	LXI	H,GAPBEG
                                
                                ;MKGAP -- WM 1913: enlarge the gap when empty; relocate text (MOVGAP) or, when
                                ;RAM is full, page out via MKROOM; 'MEM FULL' if no room can be made.
  00BC'                         MKGAP:				; WM 1913
  00BC'   C5                    	PUSH	B
  00BD'   D5                    	PUSH	D
  00BE'   E5                    	PUSH	H
  00BF'                         MKGAPL:				; WM 1919
  00BF'   CD 04A7'              	CALL	PRSPAN
  00C2'   78                    	MOV	A,B
  00C3'   B7                    	ORA	A
  00C4'   C2 05A6'              	JNZ	POPRET
  00C7'   CD 0441'              	CALL	BUFSUM
  00CA'   7A                    	MOV	A,D
  00CB'   B7                    	ORA	A
  00CC'   C2 03F8'              	JNZ	MOVGAP
  00CF'   CD 0000*              	CALL	MKROOM
  00D2'   D2 00BF'              	JNC	MKGAPL
  00D5'   CD 05B7'              	CALL	ERRMSG
  00D8'   4D 45 4D 20           	DB	'MEM FULL',0H
  00DC'   46 55 4C 4C           
  00E0'   00                    
                                
                                ;CKLEN -- WM 1934: set up the chunked-copy B/C counters; Z if count is zero.
  00E1'                         CKLEN:				; WM 1934
  00E1'   CD 0535'              	CALL	CKCOPY
  00E4'   04                    	INR	B
  00E5'   0C                    	INR	C
  00E6'   0D                    	DCR	C
  00E7'   C0                    	RNZ
  00E8'   05                    	DCR	B
  00E9'   C9                    	RET
                                
                                ;============================================================
                                ; Q-BUFFER -- WM.ASM 1528-1600.  A SECOND gap buffer (QBEG..QEND, with QEND as
                                ; its insertion point) that WordMaster grows through the same MKGAP machinery as
                                ; the text.  The vi layer uses it as the yank register: QCOPY fills it, deleting
                                ; what it takes (which is what makes 'dd' fill the register), QGET copies it
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


                                ; back into the text at the cursor ('p'), QKILL empties it.
                                ;
                                ; The register is NOT a fixed block -- it is a region of the arena, so its
                                ; ceiling is QROOM's: everything but RESVMEM, with the text free to page out
                                ; from underneath it.  Overflow raises 'QBUF FULL' from INSIDE QCOPY's chunk
                                ; loop, and that is fatal -- so the line yank (QPUTLN) asks QFIT first and
                                ; returns carry instead, with what earlier passes moved still in the register
                                ; and gone from the text for its caller to put back.
                                ;============================================================
                                
                                ;QROOM -- WM 1594: 'QBUF FULL' unless the arena still holds RESVMEM beyond the
                                ;Q-buffer.  The TEXT is not counted against it: the text pages out to make room.
  00EA'                         QROOM:				; WM 1594
  00EA'   C5                    	PUSH	B
  00EB'   D5                    	PUSH	D
  00EC'   E5                    	PUSH	H
  00ED'   21 0000*              	LXI	H,QBEG
  00F0'   CD 04A7'              	CALL	PRSPAN
  00F3'   2A 0000*              	LHLD	BUFBEG
  00F6'   EB                    	XCHG
  00F7'   2A 0000*              	LHLD	BUFEND
  00FA'   CD 055B'              	CALL	SUBHD
  00FD'   CD 0550'              	CALL	NEGBC
  0100'   09                    	DAD	B
  0101'   11 0D80               	LXI	D,RESVMEM
  0104'   CD 0579'              	CALL	CMP16
  0107'   DA 05A6'              	JC	POPRET
  010A'   CD 05B7'              	CALL	ERRMSG
  010D'   51 42 55 46           	DB	'QBUF FULL',0H
  0111'   20 46 55 4C           
  0115'   4C 00                 
                                
                                ;QCOPY -- WM 1563: copy the span BC out of the text into the Q-buffer whose
                                ;insertion pointer is at HL, DELETING it as it goes.  The source is re-read from
                                ;GAPEND on every chunk because MKGAP may MOVGAP between chunks (and that fixes up
                                ;only the pointer row) or MKROOM (which pages the text out entirely), so no raw
                                ;source pointer would survive the loop -- GAPEND is safe precisely BECAUSE the
                                ;delete advances it.
  0117'                         QCOPY:				; WM 1563
  0117'   CD 00E1'              	CALL	CKLEN
  011A'   C8                    	RZ
  011B'                         QCPYLP:				; WM 1566
  011B'   CD 00BC'              	CALL	MKGAP
  011E'   CD 00EA'              	CALL	QROOM
  0121'   EB                    	XCHG
  0122'   2A 0000*              	LHLD	GAPEND
  0125'   EB                    	XCHG
  0126'   CD 0093'              	CALL	CPYGAP
  0129'   EB                    	XCHG
  012A'   22 0000*              	SHLD	GAPEND		; the gap swallows the source: THIS is the delete
  012D'   EB                    	XCHG
  012E'   CD 0000*              	CALL	UPDMARK
  0131'   05                    	DCR	B
  0132'   C2 011B'              	JNZ	QCPYLP
  0135'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


                                ;QCPYN -- APPENDED (NOT WordMaster): copy BC bytes forward from the cursor into
                                ;the Q-buffer WITHOUT taking them out of the text.  This is the verb WordMaster
                                ;has no need of: QCOPY above copies by DELETING, and can re-read its source
                                ;from GAPEND on every chunk precisely BECAUSE the delete advances GAPEND past
                                ;what it has taken.  A copy that leaves the text alone has no such pointer --
                                ;MKGAP may MOVGAP between chunks, which relocates the text and fixes up only
                                ;the pointer row.
                                ;
                                ;What survives MOVGAP is a COUNT, so that is what this keeps: the source is
                                ;GAPEND plus the bytes already moved, worked out afresh each chunk.  What no
                                ;count survives is MKGAP reaching MKROOM -- a spill writes resident text out to
                                ;disk and the source is then not in RAM at all -- so the CALLER must show there
                                ;is room for the whole copy before calling (CMD.MAC's YNROOM: the span plus a
                                ;chunk's slack, free).  With that held every MKGAP here finds 256 bytes free
                                ;and relocates rather than pages.
                                ;
                                ;The text is not touched: no delete, no UPDMARK, and nothing for 'u' to capture.
                                ;The caller is expected to have QKILLed: this appends, as QCOPY does.
  0136'                         QCPYN:				; (appended) BC = the span at the cursor
  0136'   21 0000               	LXI	H,0
  0139'   22 0000*              	SHLD	QCPDON		; nothing of it has gone in yet
  013C'   CD 00E1'              	CALL	CKLEN		; B = chunks, C = the first chunk's length
  013F'   CA 016B'              	JZ	QCPYND		; an empty span: nothing to do
  0142'                         QCPYNL:
  0142'   21 0000*              	LXI	H,QEND
  0145'   CD 00BC'              	CALL	MKGAP		; room for a chunk above the register
  0148'   CD 00EA'              	CALL	QROOM		; ... and the register's own ceiling
  014B'   2A 0000*              	LHLD	QCPDON		; where this chunk's source lies NOW
  014E'   EB                    	XCHG
  014F'   2A 0000*              	LHLD	GAPEND
  0152'   19                    	DAD	D
  0153'   EB                    	XCHG			; DE = the source
  0154'   21 0000*              	LXI	H,QEND
  0157'   CD 0093'              	CALL	CPYGAP		; C bytes [DE] -> the register, QEND advanced
  015A'   EB                    	XCHG			; HL = the source past the chunk
  015B'   E5                    	PUSH	H
  015C'   2A 0000*              	LHLD	GAPEND		; (re-read: CPYGAP cannot have moved it, but the
  015F'   EB                    	XCHG			;   next pass's MKGAP can, so the COUNT is what
  0160'   E1                    	POP	H		;   is kept)
  0161'   CD 055B'              	CALL	SUBHD		; HL = what has gone in altogether
  0164'   22 0000*              	SHLD	QCPDON
  0167'   05                    	DCR	B
  0168'   C2 0142'              	JNZ	QCPYNL
  016B'                         QCPYND:
  016B'   B7                    	ORA	A		; NC, and it has to be SAID: the last thing through
  016C'   C9                    	RET			;   here was SUBHD, whose DAD leaves the carry set,
                                				;   and the caller reads the carry to tell a copy
                                				;   that ran from one that could not
                                
                                ;QGET -- WM 1541: splice the whole Q-buffer into the text at the cursor.
  016D'                         QGET:				; WM 1541
  016D'   21 0000*              	LXI	H,QBEG
  0170'   CD 04A7'              	CALL	PRSPAN
  0173'   C5                    	PUSH	B		; (appended) the length, for the 'u' capture
  0174'   CD 0574'              	CALL	LDHLI
  0177'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0178'   CD 006E'              	CALL	INSBLK
  017B'   C1                    	POP	B
  017C'   C3 0ABA'              	JMP	UNDGET		; (appended) the register just put in, for 'u'
                                
                                ;QKILL -- WM 1529: empty the Q-buffer (QEND := QBEG).
  017F'                         QKILL:				; WM 1529
  017F'   2A 0000*              	LHLD	QBEG
  0182'   22 0000*              	SHLD	QEND
  0185'   C9                    	RET
                                
                                ;QPUTLN -- WM 1552: take the line at the cursor into the Q-buffer, DELETING it.
                                ;This is WM's QPUT loop body without its own CNTTST loop, because the vi layer
                                ;runs the count (VD_DD does exactly that).               GOLINE finds where the
                                ;line ends, SPANBC measures from the gap to there, QCOPY takes that span, HOLEQ
                                ;slides the hole above the Q-buffer back out of the way, and PAGESTP advances
                                ;the window a step -- so a count runs past the resident window, as dd's does.
                                ;Ends on PAGESTP exactly as DELTO does, so the caller's CNTTST loop is the same.
                                ;APPENDED: NC when the pass went; CY, with nothing of it taken, when the
                                ;register has no room for it (QFIT).  What earlier passes took is still in the
                                ;register and gone from the text, for the caller to put back.
  0186'                         QPUTLN:				; WM 1552
  0186'   21 0000*              	LXI	H,QEND
  0189'   CD 00BC'              	CALL	MKGAP
  018C'   CD 026C'              	CALL	GOLINE
  018F'   EB                    	XCHG
  0190'   2A 0000*              	LHLD	GAPEND
  0193'   EB                    	XCHG
  0194'   CD 0564'              	CALL	SPANBC
  0197'   CD 01B3'              	CALL	QFIT		; (appended) will the register hold them?
  019A'   DA 01AE'              	JC	QPL_NO
  019D'   CD 0AE4'              	CALL	UNDDLQ		; (appended) those lines, for 'u', before they go
  01A0'   21 0000*              	LXI	H,QEND
  01A3'   CD 0117'              	CALL	QCOPY
  01A6'   CD 0465'              	CALL	HOLEQ
  01A9'   CD 05B0'              	CALL	PAGESTP
  01AC'   B7                    	ORA	A		; (appended) NC: they went
  01AD'   C9                    	RET
  01AE'                         QPL_NO:				; (appended) CY: nothing of this pass was taken
  01AE'   CD 0465'              	CALL	HOLEQ
  01B1'   37                    	STC
  01B2'   C9                    	RET
                                
                                ;QFIT -- APPENDED (NOT WordMaster): CY if the register cannot take BC more
                                ;bytes and still leave QROOM its reserve.  Keeps BC.  QROOM asks the same
                                ;thing a chunk at a time from inside QCOPY and its answer is fatal; asked here
                                ;first, for the whole pass and before a byte has moved, the answer is one the
                                ;caller can refuse on -- and with every pass asked, QROOM's is never reached
                                ;from a line yank.
  01B3'                         QFIT:
  01B3'   C5                    	PUSH	B
  01B4'   21 0000*              	LXI	H,QBEG
  01B7'   CD 04A7'              	CALL	PRSPAN		; BC = what the register holds
  01BA'   2A 0000*              	LHLD	BUFBEG
  01BD'   EB                    	XCHG
  01BE'   2A 0000*              	LHLD	BUFEND
  01C1'   CD 055B'              	CALL	SUBHD		; HL = the arena
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01C4'   CD 0550'              	CALL	NEGBC
  01C7'   09                    	DAD	B		; ... less the register
  01C8'   C1                    	POP	B
  01C9'   7D                    	MOV	A,L
  01CA'   91                    	SUB	C
  01CB'   6F                    	MOV	L,A
  01CC'   7C                    	MOV	A,H
  01CD'   98                    	SBB	B
  01CE'   67                    	MOV	H,A		; ... less these lines
  01CF'   D8                    	RC			; not even that much
  01D0'   7D                    	MOV	A,L
  01D1'   D6 81                 	SUI	(RESVMEM+1) AND 0FFH
  01D3'   7C                    	MOV	A,H
  01D4'   DE 0D                 	SBI	(RESVMEM+1) SHR 8	; CY unless more than the reserve is left
  01D6'   C9                    	RET
                                
                                ;============================================================
                                ; PROBE / DELETE -- WM.ASM 991-1001, 1790-1829
                                ;============================================================
                                
                                ;CKLOW -- WM 1790: CY if HL is below TXTBEG (pages back via REWIND when paged).
  01D7'                         CKLOW:				; WM 1790
  01D7'   EB                    	XCHG
  01D8'   2A 0000*              	LHLD	TXTBEG
  01DB'   CD 0579'              	CALL	CMP16
  01DE'   EB                    	XCHG
  01DF'   D0                    	RNC
  01E0'   EB                    	XCHG
  01E1'   2A 0000*              	LHLD	GAPBEG
  01E4'   CD 055A'              	CALL	SUBDH
  01E7'   E5                    	PUSH	H
  01E8'   CD 0000*              	CALL	REWIND
  01EB'   2A 0000*              	LHLD	GAPBEG
  01EE'   D1                    	POP	D
  01EF'   F5                    	PUSH	PSW
  01F0'   19                    	DAD	D
  01F1'   F1                    	POP	PSW
  01F2'   C9                    	RET
                                
                                ;PEEKL -- WM 1812: char immediately left of the cursor (GAPBEG-1) into A;
                                ;CY (A=0) at TXTBEG.
  01F3'                         PEEKL:				; WM 1812
  01F3'   2A 0000*              	LHLD	GAPBEG
  01F6'   2B                    	DCX	H
  01F7'   D5                    	PUSH	D
  01F8'   CD 01D7'              	CALL	CKLOW
  01FB'   D1                    	POP	D
  01FC'   D8                    	RC
  01FD'   7E                    	MOV	A,M
  01FE'   B7                    	ORA	A
  01FF'   C9                    	RET
                                
                                ;PEEKLX -- WM 1824: PEEKL; on edge (CY) drop the caller's return address.
  0200'                         PEEKLX:				; WM 1824
  0200'   CD 01F3'              	CALL	PEEKL
  0203'   D0                    	RNC
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


  0204'   33                    	INX	SP
  0205'   33                    	INX	SP
  0206'   C9                    	RET
                                
                                ;DELTO -- WM 991: swallow the cursor..HL span into the gap (extend GAPBEG
                                ;backward when S set, GAPEND forward otherwise), then UPDMARK + page.
  0207'                         DELTO:				; WM 991
  0207'   FA 0210'              	JM	DELBK
  020A'   22 0000*              	SHLD	GAPEND
  020D'   C3 0213'              	JMP	DELUPD
  0210'                         DELBK:				; WM 996 -- backward delete
  0210'   22 0000*              	SHLD	GAPBEG
  0213'                         DELUPD:				 ; WM 999
  0213'   CD 0000*              	CALL	UPDMARK
  0216'   C3 05B0'              	JMP	PAGESTP
                                
                                ;============================================================
                                ; LINE MOVE -- WM.ASM 1007-1042 (MVLMAX..SETBWD), verbatim.
                                ; CMDCNT/DIRFLG in, loop GOLINE + SCRLST until CNTTST says the count is spent,
                                ; so the cursor moves AND the window pages with it (whole file with FFFFH).
                                ;============================================================
                                
                                ;MVLMAX -- WM 1008: move to the far end (A = direction, count = FFFFH).
  0219'                         MVLMAX:				; WM 1008
  0219'   21 FFFF               	LXI	H,0FFFFH
                                ;MVLIND -- WM 1012: DIRFLG = A, CMDCNT = HL, then move lines.
  021C'                         MVLIND:			       ; WM 1012
  021C'   32 0000*              	STA	DIRFLG
                                ;MVLINS -- WM 1016: CMDCNT = HL, then move that many lines.
  021F'                         MVLINS:			       ; WM 1016
  021F'   22 0000*              	SHLD	CMDCNT
                                ;MVLLOOP -- WM 1020: GOLINE + SCRLST until the line count runs out.
  0222'                         MVLLOOP:			; WM 1020
  0222'   CD 026C'              	CALL	GOLINE
  0225'   CD 05AA'              	CALL	SCRLST
  0228'   CD 0000*              	CALL	CNTTST
  022B'   C2 0222'              	JNZ	MVLLOOP
  022E'   C9                    	RET
                                
                                
                                ;(WM 1045, the line kill -- GOLINE + DELTO -- is not carried: 'dd' takes its
                                ;lines through QPUTLN, and nothing called it.)
                                
                                ;SETC0 -- WM 1054: CMDCNT = HL, forward (DIRFLG = 0).
  022F'                         SETC0:				; WM 1054
  022F'   AF                    	XRA	A
                                ;SETCNT -- WM 1058: CMDCNT = HL, DIRFLG = A, clear L271E.
  0230'                         SETCNT:				; WM 1058
  0230'   32 0000*              	STA	DIRFLG
  0233'   AF                    	XRA	A
  0234'   32 0000*              	STA	AUXCNT
  0237'   22 0000*              	SHLD	CMDCNT
  023A'   C9                    	RET
                                
                                ;CLRCNT -- WM 1142: clear the command count and direction.  WM runs it on
                                ;every command-mode command (and on ESC out of video), so a save never
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


                                ;inherits a backward DIRFLG from the last motion.
  023B'                         CLRCNT:				; WM 1142
  023B'   E5                    	PUSH	H
  023C'   21 0000               	LXI	H,0H
  023F'   CD 022F'              	CALL	SETC0
  0242'   E1                    	POP	H
  0243'   C9                    	RET
                                
                                ;SETBWD -- WM 1039: backward move of HL lines (DIRFLG = FFH), then MVLIND.
  0244'                         SETBWD:				; WM 1039
  0244'   3E FF                 	MVI	A,0FFH
  0246'   FE AF                 	CPI	0AFH
  0248'   C3 021C'              	JMP	MVLIND
                                
                                ;============================================================
                                ; LINE SCAN -- WM.ASM 2224-2360 (GOLINE, NLFWD/SCANF, NLBACK/SCANB), verbatim
                                ; but for one cut: WM's search wildcards (WCMATCH, WM 2363, and the leaves only
                                ; it called -- ISWBRK/ISALNUM, ISDIGIT, UPCASE, ISWHITE) are NOT here.  The
                                ; scanners and the matchers compared through WCMATCH on every byte that did
                                ; not match, which was two thirds of the cost of looking for a newline, and no
                                ; pattern the editor can build holds a wildcard: CMD.MAC's RDLINE drops every
                                ; control character.  WM's CALL GETKEY (type-ahead drain) is KBPOLL here:
                                ; KEY.MAC owns the ring and its GETKEY is the blocking vi decoder.
                                ;============================================================
                                
                                ;LINPOSB -- WM 2199: HL lines back, count set by SETCNT (backward), then
                                ;LINEPOS.  The renderer uses it to find the top line of the screen.
  024B'                         LINPOSB:			; WM 2199
  024B'   3E FF                 	MVI	A,0FFH
  024D'   CD 0230'              	CALL	SETCNT
                                ;LINEPOS -- WM 2204: GOLINE; when the count is not spent, PAGEWIN and scan
                                ;once more with the original count.  HL = the line start; CY = partial.
  0250'                         LINEPOS:			; WM 2204
  0250'   D5                    	PUSH	D
  0251'   2A 0000*              	LHLD	CMDCNT
  0254'   E5                    	PUSH	H
  0255'   CD 026C'              	CALL	GOLINE
  0258'   D1                    	POP	D
  0259'   D2 00A7'              	JNC	CPYGDN
  025C'   F5                    	PUSH	PSW
  025D'   CD 0000*              	CALL	PAGEWIN
  0260'   D2 0266'              	JNC	LNPSTO
  0263'   F1                    	POP	PSW
  0264'   D1                    	POP	D
  0265'   C9                    	RET
  0266'                         LNPSTO:				 ; WM 2218 -- store the count, rescan (falls in)
  0266'   F1                    	POP	PSW
  0267'   EB                    	XCHG
  0268'   22 0000*              	SHLD	CMDCNT
  026B'   D1                    	POP	D
                                
  024B'                         LINPSB	EQU	LINPOSB		; 6-char export alias (LINPOSB/LINEPOS share LINPOS)
                                
                                ;GOLINE -- WM 2228: move CMDCNT lines from the cursor (NLFWD forward,
                                ;NLBACK backward).  Returns HL = target; CY if the count is not exhausted
                                ;(the window must page and the scan continue).
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  026C'                         GOLINE:				; WM 2228
  026C'   C5                    	PUSH	B
  026D'   D5                    	PUSH	D
  026E'   2A 0000*              	LHLD	CMDCNT
  0271'   EB                    	XCHG
  0272'   21 0000*              	LXI	H,DIRFLG
  0275'   7A                    	MOV	A,D
  0276'   B3                    	ORA	E
  0277'   C2 027B'              	JNZ	GOLDIR
  027A'   35                    	DCR	M
  027B'                         GOLDIR:				; WM 2239 -- forward: count newlines toward TXTEND
  027B'   7E                    	MOV	A,M
  027C'   B7                    	ORA	A
  027D'   FA 0297'              	JM	GOLBK
  0280'   CD 04A4'              	CALL	AFTLEN
  0283'   CD 0574'              	CALL	LDHLI
  0286'                         GOLFLP:				; WM 2246 -- forward newline-count loop
  0286'   CD 02E5'              	CALL	NLFWD
  0289'   DA 02B3'              	JC	GOLSWP
  028C'   05                    	DCR	B
  028D'   0D                    	DCR	C
  028E'   1B                    	DCX	D
  028F'   7A                    	MOV	A,D
  0290'   B3                    	ORA	E
  0291'   C2 0286'              	JNZ	GOLFLP
  0294'   C3 02B3'              	JMP	GOLSWP
  0297'                         GOLBK:				; WM 2257 -- backward: count newlines toward TXTBEG
  0297'   13                    	INX	D
  0298'   21 0000*              	LXI	H,TXTBEG
  029B'   CD 04A7'              	CALL	PRSPAN
  029E'   2A 0000*              	LHLD	GAPBEG
  02A1'                         GOLBLP:				; WM 2263 -- backward newline-count loop
  02A1'   CD 0000*              	CALL	KBPOLL		; WM: CALL GETKEY
  02A4'   CD 02F9'              	CALL	NLBACK
  02A7'   DA 02DE'              	JC	GOLBEX
  02AA'   05                    	DCR	B
  02AB'   0D                    	DCR	C
  02AC'   1B                    	DCX	D
  02AD'   7A                    	MOV	A,D
  02AE'   B3                    	ORA	E
  02AF'   C2 02A1'              	JNZ	GOLBLP
  02B2'   23                    	INX	H
  02B3'                         GOLSWP:				; WM 2275 -- swap to the result pointer
  02B3'   EB                    	XCHG
  02B4'                         GOLFIN:				; WM 2278 -- store the position and remaining count
  02B4'   AF                    	XRA	A
  02B5'                         GOLAUX:				; WM 2281 -- store L271E; note if more input remains
  02B5'   32 0000*              	STA	AUXCNT
  02B8'   CD 0000*              	CALL	MOREIN
  02BB'   C2 02C4'              	JNZ	GOLSAV
  02BE'   21 0000               	LXI	H,0H
  02C1'   22 0000*              	SHLD	AUXCNT
  02C4'                         GOLSAV:				; WM 2288 -- save CMDCNT and the target position
  02C4'   22 0000*              	SHLD	CMDCNT
  02C7'   EB                    	XCHG
  02C8'   22 0000*              	SHLD	L2756
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02CB'   3A 0000*              	LDA	DIRFLG
  02CE'   B7                    	ORA	A
  02CF'   E5                    	PUSH	H
  02D0'   21 FFFF               	LXI	H,0FFFFH
  02D3'   19                    	DAD	D
  02D4'   DA 05A6'              	JC	POPRET
  02D7'   2A 0000*              	LHLD	NEWFIL		; H = AUXCNT low byte (PAGE.MAC keeps WM's adjacency)
  02DA'   29                    	DAD	H
  02DB'   C3 05A6'              	JMP	POPRET
  02DE'                         GOLBEX:				; WM 2302 -- step back one and retry the backward count
  02DE'   1B                    	DCX	D
  02DF'   EB                    	XCHG
  02E0'   3E FF                 	MVI	A,0FFH
  02E2'   C3 02B5'              	JMP	GOLAUX
                                
                                ;NLFWD -- WM 2309: scan forward to the next newline.
  02E5'                         NLFWD:				; WM 2309
  02E5'   3E 0A                 	MVI	A,LF
                                ;SCANF -- WM 2313: scan forward over BC bytes for a char (WM's CNZ WCMATCH
                                ; after each CMP M is cut, here and in SCANB).
  02E7'                         SCANF:				; WM 2313
  02E7'   04                    	INR	B
  02E8'   0C                    	INR	C
  02E9'   C3 02EF'              	JMP	SCFCNT
  02EC'                         SCFCMP:				; WM 2318
  02EC'   BE                    	CMP	M
  02ED'   23                    	INX	H
  02EE'   C8                    	RZ
  02EF'                         SCFCNT:				; WM 2324
  02EF'   0D                    	DCR	C
  02F0'   C2 02EC'              	JNZ	SCFCMP
  02F3'   05                    	DCR	B
  02F4'   C2 02EC'              	JNZ	SCFCMP
  02F7'   37                    	STC
  02F8'   C9                    	RET
                                
                                ;NLBACK -- WM 2333: scan backward to a newline.
  02F9'                         NLBACK:				; WM 2333
  02F9'   3E 0A                 	MVI	A,LF
                                ;SCANB -- WM 2337: scan backward over BC bytes for a char.
  02FB'                         SCANB:				; WM 2337
  02FB'   04                    	INR	B
  02FC'   0C                    	INR	C
  02FD'   C3 0303'              	JMP	SCBCNT
  0300'                         SCBCMP:				; WM 2342
  0300'   2B                    	DCX	H
  0301'   BE                    	CMP	M
  0302'   C8                    	RZ
  0303'                         SCBCNT:				; WM 2348
  0303'   0D                    	DCR	C
  0304'   C2 0300'              	JNZ	SCBCMP
  0307'   05                    	DCR	B
  0308'   C2 0300'              	JNZ	SCBCMP
  030B'   37                    	STC
  030C'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


                                ;============================================================
                                ; STRING SEARCH -- WM.ASM 2035-2150 (FWDCNT, SUBLEN/SUBHA, MATCHF, MATCHB),
                                ; verbatim.  These are the engine half of WM's find; the vi layer (CMD.MAC)
                                ; supplies the rest, because vi's search is not WordMaster's:
                                ;
                                ;   - WM reads the pattern off its command line with RDSTR (WM 1310) as part
                                ;     of the search itself.  vi prompts for it on the bottom row and keeps it
                                ;     for 'n', so SRCHBF is filled by CMD.MAC and RDSTR is not transcribed.
                                ;   - MATCHF leaves HL one PAST the match (WordMaster's find lands after the
                                ;     string); vi lands ON its first character, so CMD.MAC's forward search
                                ;     backs up over the pattern with SUBLEN.  MATCHB already returns the
                                ;     match's first character, so only the forward side needs it.
                                ;   - WM's SUBB/SUBS/SUBSA (find-and-replace) and INSREPL are NOT here: no
                                ;     ':s' yet.  ADDAHL and GBSUBL, which only they use, are left out too.
                                ;
                                ; The pattern is WM's layout: a length byte, then the string, 0-terminated.
                                ; DE points at the STRING (SRCHST), so FWDCNT reads the length from the byte
                                ; just below DE and SUBLEN from SRCHBF, exactly as WM does.
                                ;============================================================
                                
                                ;FWDCNT -- WM 2035: BC := the bytes of the pointer pair at HL that a match
                                ;could still start in -- its span, less the pattern length, plus one.  CY if
                                ;that went negative: the text is shorter than the pattern.  Keeps DE.
  030D'                         FWDCNT:				; WM 2035
  030D'   CD 04A7'              	CALL	PRSPAN
  0310'   03                    	INX	B
  0311'   1B                    	DCX	D
  0312'   1A                    	LDAX	D		; the length byte, just below the string
  0313'   13                    	INX	D
  0314'   C5                    	PUSH	B
  0315'   47                    	MOV	B,A
  0316'   79                    	MOV	A,C
  0317'   90                    	SUB	B
  0318'   C1                    	POP	B
  0319'   4F                    	MOV	C,A
  031A'   78                    	MOV	A,B
  031B'   DE 00                 	SBI	0H
  031D'   47                    	MOV	B,A
  031E'   C9                    	RET
                                
                                ;SUBLEN -- WM 2061: HL := HL - the pattern length.
  031F'                         SUBLEN:				; WM 2061
  031F'   3A 0000*              	LDA	SRCHBF
                                
                                ;SUBHA -- WM 2063: HL := HL - A, unsigned.
  0322'                         SUBHA:				; WM 2063
  0322'   E5                    	PUSH	H
  0323'   67                    	MOV	H,A
  0324'   7D                    	MOV	A,L
  0325'   94                    	SUB	H
  0326'   E1                    	POP	H
  0327'   6F                    	MOV	L,A
  0328'   7C                    	MOV	A,H
  0329'   DE 00                 	SBI	0H
  032B'   67                    	MOV	H,A
  032C'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


                                
                                ;MATCHF -- WM 2089: find DE's string in the BC bytes from HL, forward.
                                ;SCANF finds each candidate first character and the loop compares the rest
                                ;(WM's wildcard retry through WCMATCH is cut from both loops; see LINE SCAN).  CY = not found; on a hit
                                ;HL is one past the match's LAST character and DE is the pattern again.
  032D'                         MATCHF:				; WM 2089
  032D'   1A                    	LDAX	D
  032E'   B7                    	ORA	A
  032F'   C8                    	RZ
  0330'   D5                    	PUSH	D
  0331'   CD 02E7'              	CALL	SCANF
  0334'   DA 034B'              	JC	MATCHX
  0337'   05                    	DCR	B
  0338'   0D                    	DCR	C
  0339'   E5                    	PUSH	H
  033A'                         MATCFL:				; WM 2102 -- the rest of the pattern
  033A'   13                    	INX	D
  033B'   1A                    	LDAX	D
  033C'   B7                    	ORA	A
  033D'   CA 034A'              	JZ	MATCFY
  0340'   BE                    	CMP	M
  0341'   23                    	INX	H
  0342'   CA 033A'              	JZ	MATCFL
  0345'   E1                    	POP	H		; that candidate failed: SCANF went one past
  0346'   D1                    	POP	D		;   it, so the retry cannot sit still
  0347'   C3 032D'              	JMP	MATCHF
  034A'                         MATCFY:				; WM 2116 -- matched: drop the saved pointer
  034A'   D1                    	POP	D
  034B'                         MATCHX:				; WM 2118 -- restore DE and return
  034B'   D1                    	POP	D
  034C'   C9                    	RET
                                
                                ;MATCHB -- WM 2124: the same, backward.  Unlike MATCHF this one returns HL
                                ;ON the match's FIRST character.  A match is only found while it lies wholly
                                ;inside the span, so one straddling the cursor is not seen (see CMD.MAC).
  034D'                         MATCHB:				; WM 2124
  034D'   1A                    	LDAX	D
  034E'   B7                    	ORA	A
  034F'   C8                    	RZ
  0350'   23                    	INX	H
  0351'                         MATCBS:				; WM 2128 -- back to the next candidate
  0351'   D5                    	PUSH	D
  0352'   1A                    	LDAX	D
  0353'   CD 02FB'              	CALL	SCANB
  0356'   DA 034B'              	JC	MATCHX
  0359'   05                    	DCR	B
  035A'   0D                    	DCR	C
  035B'   E5                    	PUSH	H
  035C'                         MATCBL:				; WM 2138 -- the rest of the pattern
  035C'   13                    	INX	D
  035D'   23                    	INX	H
  035E'   1A                    	LDAX	D
  035F'   B7                    	ORA	A
  0360'   CA 0367'              	JZ	MATCBE
  0363'   BE                    	CMP	M
  0364'   CA 035C'              	JZ	MATCBL
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  0367'                         MATCBE:				; WM 2149 -- A = 0 only when it matched
  0367'   E1                    	POP	H
  0368'   D1                    	POP	D
  0369'   B7                    	ORA	A
  036A'   C2 0351'              	JNZ	MATCBS
  036D'   C9                    	RET
                                
