  045B'   CD 04B9'              	CALL	PRSPAN
  045E'   EB                    	XCHG
  045F'   09                    	DAD	B
  0460'   EB                    	XCHG
  0461'   CD 046A'              	CALL	NEXTPR
  0464'   D2 045B'              	JNC	BSUMLP
  0467'   E1                    	POP	H
  0468'   C1                    	POP	B
  0469'   C9                    	RET
                                
