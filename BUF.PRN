                                ;============================================================
                                ; PAGESTP -- the count-limited scroll step.  The disk-eviction seam
                                ; (MKROOM/SPILL/SPILLB/PAGEBOT/REWIND), the deque marks (MARKGB/UPDMARK/RECBASE/
                                ; PTRREC) and the paging drivers (PAGEDIR/PGNEED/PAGEWIN) are all real in
                                ; PAGE.MAC, and CNTTST/CMDCNT/AUXCNT now exist in CMD.MAC.
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


                                ;============================================================
                                
                                ;PAGESTP -- WM 4311: page one step in the scroll direction, count-limited.
                                ;CNTTST returns Z when the command count (CMDCNT and AUXCNT) is exhausted, so a
                                ;completed edit or motion stops here (RZ); otherwise fall into PAGEDIR to page
                                ;the window one increment in the current scroll direction (DIRFLG: REWIND back,
                                ;FILLBUF forward).  In WM PAGESTP falls through to the physically adjacent
                                ;PAGEDIR; here PAGEDIR lives in PAGE.MAC, so the fall-through is an explicit
                                ;JMP -- same object behavior, PAGEDIR's own POLLBRK still runs.  DELTO's tail
                                ;JMPs here, so a delete made with the count spent returns at once; the count
                                ;loops (dd's QPUTLN, MVLLOOP's line moves, the search sweep through SCRLST)
                                ;are what page the window on past its edge.
                                ;SCRLST -- WM 4307: poll type-ahead, PUTCUR to HL, then (count not spent)
                                ;fall into PAGESTP to page the window one step in the DIRFLG direction.
  0598'                         SCRLST:				; WM 4307
  0598'   CD 0000*              	CALL	POLLBRK
  059B'   CD 035C'              	CALL	PUTCUR
                                
  059E'                         PAGESTP:			; WM 4311
  059E'   CD 0000*              	CALL	CNTTST
  05A1'   C8                    	RZ
  05A2'   C3 0000*              	JMP	PAGEDIR
                                
                                ;============================================================
                                ; ERRMSG -- WM 664, message-print transcribed; TAIL adapted (see header):
                                ; print the inline 0-terminated message, set ERRFLG, warm-boot to CP/M.
                                ; The message is printed where ERRHK leaves the cursor: VI.MAC points it at the
                                ; screen teardown, so it lands on the bottom row with the terminal restored, as
                                ; a quit leaves it; a harness with no screen leaves it on a RET.  The work files
                                ; are dropped before the warm boot, as a quit drops them.  A second error from
                                ; inside either step ends here too: DISCRD clears its own flag before it
                                ; deletes, so it cannot run twice.
                                ;============================================================
  05A5'                         ERRMSG:				; WM 664 (tail adapted)
  05A5'   3E FF                 	MVI	A,0FFH
  05A7'   32 0B20'              	STA	ERRFLG		; record that an error fired
  05AA'   2A 05CA'              	LHLD	ERRHK
  05AD'   CD 05C8'              	CALL	ERMGO		; the cursor to where the message belongs
  05B0'   E1                    	POP	H		; HL -> inline message (after the CALL)
  05B1'                         ERMLP:
  05B1'   7E                    	MOV	A,M
  05B2'   B7                    	ORA	A
  05B3'   CA 05C2'              	JZ	ERMEND
  05B6'   E5                    	PUSH	H
  05B7'   5F                    	MOV	E,A
  05B8'   0E 02                 	MVI	C,2		; BDOS console out
  05BA'   CD 0005               	CALL	BDOS
  05BD'   E1                    	POP	H
  05BE'   23                    	INX	H
  05BF'   C3 05B1'              	JMP	ERMLP
  05C2'                         ERMEND:
  05C2'   CD 0000*              	CALL	DISCRD		; no name.$$$ / VIBACKUP.$$$ left behind
  05C5'   C3 0000               	JMP	WBOOT		; adapted tail: back to CP/M
  05C8'   E9                    ERMGO:	PCHL
  05C9'   C9                    ERMNUL: RET
  05CA'   05C9'                 ERRHK:	DW	ERMNUL		; the screen's teardown, once there is a screen
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


                                
                                ;============================================================
                                ; LOGICAL-OFFSET API  (APPENDED -- NOT WordMaster).
                                ; The gap-agnostic view the vi layer (CMD.MAC) uses so it never touches the raw
                                ; pointer row.  A logical offset is a byte index into resident text as if the
                                ; gap were absent:
                                ;   before = GAPBEG - TXTBEG   (bytes before the cursor = cursor logical offset)
                                ;   after  = TXTEND - GAPEND   (bytes at/after the cursor)
                                ;   LOGLEN = before + after
                                ; Most of CMD.MAC's verbs work in these offsets alone; the rest drive WM's
                                ; pointer-based routines (PUTCUR, the line moves, RGET, the matchers, the
                                ; Q-buffer), which page as they go, and a few read the pointer row directly.
                                ;============================================================
                                
                                ;CUROFF -- HL = cursor logical offset (= before length).
  05CC'                         CUROFF:
  05CC'   2A 0B16'              	LHLD	TXTBEG
  05CF'   EB                    	XCHG
  05D0'   2A 0B18'              	LHLD	GAPBEG
  05D3'   CD 0549'              	CALL	SUBHD		; HL = GAPBEG - TXTBEG
  05D6'   C9                    	RET
                                
                                ;AFTLN2 -- HL = after length (TXTEND - GAPEND).  Private helper for LOGLEN.
  05D7'                         AFTLN2:
  05D7'   2A 0B1A'              	LHLD	GAPEND
  05DA'   EB                    	XCHG
  05DB'   2A 0B1C'              	LHLD	TXTEND
  05DE'   CD 0549'              	CALL	SUBHD
  05E1'   C9                    	RET
                                
                                ;LOGLEN -- HL = total resident logical length.
  05E2'                         LOGLEN:
  05E2'   CD 05CC'              	CALL	CUROFF
  05E5'   E5                    	PUSH	H
  05E6'   CD 05D7'              	CALL	AFTLN2
  05E9'   D1                    	POP	D
  05EA'   19                    	DAD	D
  05EB'   C9                    	RET
                                
                                ;L2PHYS -- HL(off) -> HL(physical address).  0 <= off <= LOGLEN.  Private.
  05EC'                         L2PHYS:
  05EC'   EB                    	XCHG			; DE = off
  05ED'   D5                    	PUSH	D
  05EE'   CD 05CC'              	CALL	CUROFF		; HL = before
  05F1'   D1                    	POP	D		; DE = off
  05F2'   CD 0567'              	CALL	CMP16		; DE=off vs HL=before: CY iff off < before
  05F5'   DA 0602'              	JC	L2P_BEF
                                	;--- after region: phys = GAPEND + (off - before) ---
  05F8'   EB                    	XCHG			; HL=off, DE=before
  05F9'   CD 0549'              	CALL	SUBHD		; HL = off - before
  05FC'   EB                    	XCHG			; DE = off-before
  05FD'   2A 0B1A'              	LHLD	GAPEND
  0600'   19                    	DAD	D
  0601'   C9                    	RET
  0602'                         L2P_BEF:
                                	;--- before region: phys = TXTBEG + off  (DE = off, HL = before) ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  0602'   2A 0B16'              	LHLD	TXTBEG
  0605'   19                    	DAD	D
  0606'   C9                    	RET
                                
                                ;CHARAT -- HL(off) -> A = byte at that logical offset (off < LOGLEN).
  0607'                         CHARAT:
  0607'   CD 05EC'              	CALL	L2PHYS
  060A'   7E                    	MOV	A,M
  060B'   C9                    	RET
                                
                                ;CLAMPL -- HL(off) -> HL clamped to [0, LOGLEN].  Private helper for GOTO.
  060C'                         CLAMPL:
  060C'   E5                    	PUSH	H
  060D'   CD 05E2'              	CALL	LOGLEN
  0610'   D1                    	POP	D		; DE = off
  0611'   CD 0567'              	CALL	CMP16		; DE=off vs HL=LOGLEN
  0614'   DA 061B'              	JC	CLK_KEEP	; off < LOGLEN
  0617'   CA 061B'              	JZ	CLK_KEEP	; off == LOGLEN
  061A'   C9                    	RET			; off > LOGLEN -> HL = LOGLEN
  061B'                         CLK_KEEP:
  061B'   EB                    	XCHG			; HL = off
  061C'   C9                    	RET
                                
                                ;GOTO -- HL(off): move the cursor to that logical offset.
                                ;PUTCUR takes its target address in HL (its entry XCHG moves it to DE).
                                ;The line feeds the cursor crosses are added to LNDLT (subtracted going back).
  061D'                         GOTO:
  061D'   CD 060C'              	CALL	CLAMPL
  0620'   CD 05EC'              	CALL	L2PHYS		; HL = physical address
  0623'   E5                    	PUSH	H
  0624'   EB                    	XCHG			; DE = target
  0625'   2A 0B1A'              	LHLD	GAPEND
  0628'   CD 0567'              	CALL	CMP16		; CY iff target < GAPEND (before the gap)
  062B'   DA 0639'              	JC	GTO_BK
  062E'   EB                    	XCHG			; forward: count [GAPEND, target)
  062F'   CD 064D'              	CALL	LFCNT
  0632'   2A 0B68'              	LHLD	LNDLT
  0635'   19                    	DAD	D
  0636'   C3 0645'              	JMP	GTO_ST
  0639'                         GTO_BK:
  0639'   2A 0B18'              	LHLD	GAPBEG		; back: count [target, GAPBEG)
  063C'   CD 064D'              	CALL	LFCNT
  063F'   2A 0B68'              	LHLD	LNDLT
  0642'   CD 0549'              	CALL	SUBHD
  0645'                         GTO_ST:
  0645'   22 0B68'              	SHLD	LNDLT
  0648'   E1                    	POP	H
  0649'   CD 035C'              	CALL	PUTCUR
  064C'   C9                    	RET
                                
                                ;LFCNT -- DE = start, HL = end (>= start): DE = number of LFs in [start, end).
  064D'                         LFCNT:
  064D'   CD 0549'              	CALL	SUBHD		; HL = end - start
  0650'   44                    	MOV	B,H
  0651'   4D                    	MOV	C,L		; BC = length
  0652'   EB                    	XCHG			; HL = start
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  0653'   11 0000               	LXI	D,0
  0656'                         LFC_LP:
  0656'   78                    	MOV	A,B
  0657'   B1                    	ORA	C
  0658'   C8                    	RZ
  0659'   7E                    	MOV	A,M
  065A'   23                    	INX	H
  065B'   0B                    	DCX	B
  065C'   FE 0A                 	CPI	LF
  065E'   C2 0656'              	JNZ	LFC_LP
  0661'   13                    	INX	D
  0662'   C3 0656'              	JMP	LFC_LP
                                
                                ;RDGET -- RGET, and CY also when a refill read nothing.  INRDY stays set after
                                ;a file's last full record (no ^Z) until a read fails; NEEDIN then returns NC
                                ;having added nothing, and RGET steps past TXTEND leaving BC = FFFFH.  That is
                                ;reported as the end of the text, with BC = 0 so a later call asks NEEDIN again.
  0665'                         RDGET:
  0665'   CD 04A7'              	CALL	RGET
  0668'   D8                    	RC
  0669'   F5                    	PUSH	PSW
  066A'   78                    	MOV	A,B
  066B'   A1                    	ANA	C
  066C'   3C                    	INR	A		; Z iff BC = FFFFH
  066D'   CA 0672'              	JZ	RDG_EF
  0670'   F1                    	POP	PSW
  0671'   C9                    	RET
  0672'                         RDG_EF:
  0672'   F1                    	POP	PSW
  0673'   01 0000               	LXI	B,0
  0676'   37                    	STC
  0677'   C9                    	RET
                                
                                ;DELFWD -- HL = number of logical bytes to delete forward from the cursor.
  0678'                         DELFWD:
  0678'   7C                    	MOV	A,H
  0679'   B5                    	ORA	L
  067A'   C8                    	RZ			; nothing to delete
  067B'   CD 0AC1'              	CALL	UNDDLF		; (appended) the span, for 'u', before it goes
  067E'   EB                    	XCHG			; DE = count
  067F'   2A 0B1A'              	LHLD	GAPEND
  0682'   19                    	DAD	D		; target = GAPEND + count
  0683'   AF                    	XRA	A		; S clear -> forward delete
  0684'   CD 01F5'              	CALL	DELTO
  0687'   C9                    	RET
                                
                                ;DELPRV -- WM 3260 RUBOUT/DELL: delete the char left of the cursor, and the
                                ;CR too when that leaves one there (a CR,LF goes as one).  PEEKLX pages back
                                ;at the window start and returns at the start of the file.  WM's MARKCUR and
                                ;ROWUP (its screen) are left out; instead a deleted LF moves the cursor up a
                                ;line (LNDLT - 1) for SCRN.MAC.
  0688'                         DELPRV:				; WM 3260
  0688'   CD 01EE'              	CALL	PEEKLX
  068B'   FE 0A                 	CPI	LF
  068D'   C2 0699'              	JNZ	DLP_GO
  0690'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0691'   2A 0B68'              	LHLD	LNDLT
  0694'   2B                    	DCX	H
  0695'   22 0B68'              	SHLD	LNDLT
  0698'   E1                    	POP	H
  0699'                         DLP_GO:				; WM 3263 DELL
  0699'   CD 0AE1'              	CALL	UNDDLP		; (appended) that byte, for 'u', before it goes
  069C'   CD 0055'              	CALL	SETGAPB
  069F'   CD 01E1'              	CALL	PEEKL
  06A2'   FE 0D                 	CPI	CR
  06A4'   CA 0688'              	JZ	DELPRV
  06A7'   C9                    	RET
                                
                                
                                ;UNDELF -- APPENDED, NOT WordMaster: give back the byte last swallowed forward
                                ;into the gap.  A forward delete only moves GAPEND past the byte, so the byte
                                ;itself is still there, inside the gap: GAPEND-1 through DELTO makes it text
                                ;again, with the record marks updated exactly as a delete updates them.
                                ;Replace mode ('R') puts back with it what it overwrote, as vim's BS in Replace
                                ;mode does.  The caller must know the gap has not moved since the delete
                                ;(CMD.MAC keeps GAPEND in RPGE for that); nothing else calls this.
  06A8'                         UNDELF:
  06A8'   2A 0B1A'              	LHLD	GAPEND
  06AB'   2B                    	DCX	H
  06AC'   AF                    	XRA	A		; S clear -> the forward (GAPEND) side
  06AD'   CD 01F5'              	CALL	DELTO
  06B0'   C3 0AF4'              	JMP	UNDUDF		; (appended) the byte just made text again
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  APPENDED, NOT WordMaster: WM has no undo at all (its QBUFOP /
                                ; QEXEC macro is a command-LINE facility, not this).
                                ;
                                ; Six primitives change resident text, and each one says what it did: PUTGAP
                                ; (one byte in), QGET (the register in), DELFWD (a span out), DELPRV (one byte
                                ; out backward), UNDELF (one byte back in) and QPUTLN (whole lines out).
                                ; Nothing else in the editor reaches the text, so no command can forget to
                                ; record itself -- which is the whole reason the capture sits down here instead
                                ; of at CMD.MAC's edit sites.
                                ;
                                ; A record says only WHERE and HOW MUCH, in LOGICAL offsets, plus where its
                                ; bytes lie in the undo region.  Logical offsets survive the gap sliding (which
                                ; PUTCUR does on every cursor move) because the replay walks the records
                                ; BACKWARD: each step restores the offsets the steps after it were measured
                                ; against.  The bytes are kept for an insert as well as a delete -- an insert
                                ; costs its own text twice, which is nothing -- so the region is settled once
                                ; the command ends and 'u' can walk it either way: backward applying each
                                ; record's inverse to undo, forward applying the records as they stand to redo.
                                ; That is what makes 'u' undo 'u' with ONE region and no capture during the
                                ; replay.
                                ;
                                ; The region is a region of the arena like the Q buffer, inserted between the
                                ; slider and the text, and it grows through the same MKGAP: the pointer row
                                ; reads (UBEG,UEND) as data and (TXTBAS,UBEG) / (UEND,TXTBEG) as the holes
                                ; around it, so NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN and INIBAS all take it in
                                ; their stride unchanged.
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                                ; DEVIATIONS from vim, all deliberate and all in COMMANDS.md: ONE level of
                                ; undo, so 'u' undoes 'u' as real vi does; the change must still be in the
                                ; RESIDENT window, and 'u' refuses once the pager has moved off it rather than
                                ; chasing it through the file; and a change with more steps than the table
                                ; holds, or one the arena has no spare room to keep, is not undoable at all.
                                ;
                                ; "Moved off it" is PGTOPM, PAGE.MAC's count of the times the pager moved
                                ; TXTBEG.  It is the window's TOP that matters: an offset is measured from
                                ; TXTBEG, so spilling a record out from under it (PAGEOUT) or reading one back
                                ; in (REWIND) shifts every offset, while FILLBUF and PAGEBOT growing TXTEND at
                                ; the bottom shift none.  The OUTREC/SRCREC water marks look like the same
                                ; thing and are not: UPDMARK raises them on every edit.
                                ;============================================================
                                
  0001                          UR_INS	EQU	1		; text went IN  (undoing takes it back out)
  0002                          UR_DEL	EQU	2		; text came OUT (undoing puts it back)
  0007                          URSIZE	EQU	7		; type, offset(2), length(2), region offset(2)
  0018                          URMAX	EQU	24		; primitive steps one change may hold
                                ;How much of the arena the capture refuses to eat into.  It only has to keep
                                ;MKGAP off its MKROOM path (which wants 256 free), because paging is what undo
                                ;must not do -- so this is deliberately SMALL.  RESVMEM, QROOM's reserve, is
                                ;far too big: a 66 K file leaves under 1700 bytes free, and undo would never
                                ;engage at all on exactly the files that need it most.
  0200                          UNDRSV	EQU	200H		; ... 512 bytes
                                ;How much room the region claims up front, and so the largest change that can
                                ;be kept.  The claim is what lets the capture run without EVER growing the
                                ;region: see UNDGRW for why growing where a primitive can see it is unsafe.
  0400                          UNDCAP	EQU	400H		; 1024 bytes of change
                                
                                ;UNDBEG -- CMD.MAC's command boundary: the NEXT captured change starts a new
                                ;undo.  A flag only, so a command that changes nothing -- a motion, a yank, a
                                ;key that is no command at all -- leaves the last change undoable, exactly as
                                ;'.' keeps the last change it recorded.
  06B3'                         UNDBEG:
  06B3'   D5                    	PUSH	D
  06B4'   E5                    	PUSH	H
  06B5'   3E 01                 	MVI	A,1
  06B7'   32 0B49'              	STA	UNDNEW
  06BA'   CD 05CC'              	CALL	CUROFF
  06BD'   22 0B5D'              	SHLD	UNDPCU		; where the cursor was as this command began --
  06C0'   CD 06CF'              	CALL	UNDGRW		;   kept pending, because only a command that
  06C3'   E1                    	POP	H		;   really changes text gets to claim it
  06C4'   D1                    	POP	D
  06C5'   C9                    	RET
                                
                                ;UNDHER -- the change about to start belongs at the CURSOR: 'u' puts it back
                                ;there.  UNDBEG's cursor snapshot without its claim on the region, for a
                                ;command (':s') that cannot know where its first change will be until it has
                                ;found it.  Calling UNDBEG again instead would re-run UNDGRW in the middle of
                                ;the command, which is the one thing UNDGRW must never do -- see below.
  06C6'                         UNDHER:
  06C6'   E5                    	PUSH	H
  06C7'   CD 05CC'              	CALL	CUROFF
  06CA'   22 0B5D'              	SHLD	UNDPCU
  06CD'   E1                    	POP	H
  06CE'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


                                
                                ;UNDGRW -- make sure the region can take a whole change without growing again.
                                ;THE ONLY PLACE THE REGION GROWS, and it runs at the command boundary, where no
                                ;primitive is holding anything.  Growing moves regions about (MKGAP -> MOVGAP),
                                ;and that both invalidates a raw pointer a primitive is in the middle of using
                                ;-- DELPRV hands SETGAPB one -- and overwrites whatever is sitting in the gap,
                                ;which is where a forward-deleted byte waits for 'R's backspace to call UNDELF
                                ;and give it back.  So the room is claimed here, 256 bytes at a time, and the
                                ;capture below never calls MKGAP at all: it writes into the claim or gives up.
                                ;The room has to be claimed as the region's own CONTENT, not left as the hole
                                ;above it: the holes are shared, and the text takes whatever it can reach --
                                ;MOVGAP feeding an insert will walk straight through a hole reserved here, which
                                ;is what made a 200-character insert lose its undo halfway.  Once the bytes are
                                ;inside (UBEG,UEND) the text cannot have them: MOVGAP slides the region aside
                                ;instead.  Nothing here holds an address across MKGAP either, because MKGAP
                                ;slides this very region (HOLEUP moves UBEG and UEND) -- UEND is re-read from
                                ;its cell every time round.
  06CF'                         UNDGRW:
  06CF'   C5                    	PUSH	B
  06D0'   D5                    	PUSH	D
  06D1'   E5                    	PUSH	H
  06D2'                         UNDGRL:
  06D2'   21 0B12'              	LXI	H,UBEG
  06D5'   CD 0495'              	CALL	PRSPAN		; BC = the region's size
  06D8'   50                    	MOV	D,B
  06D9'   59                    	MOV	E,C
  06DA'   21 0400               	LXI	H,UNDCAP
  06DD'   CD 0567'              	CALL	CMP16		; CY iff it is smaller than one change
  06E0'   D2 0594'              	JNC	POPRET
  06E3'   CD 0866'              	CALL	UNDRM		; ... but never at the cost of paging
  06E6'   DA 0594'              	JC	POPRET
  06E9'   21 0B14'              	LXI	H,UEND
  06EC'   CD 00AA'              	CALL	MKGAP		; 256 free above the region ...
  06EF'   2A 0B14'              	LHLD	UEND
  06F2'   11 0100               	LXI	D,100H
  06F5'   19                    	DAD	D
  06F6'   22 0B14'              	SHLD	UEND		; ... taken into it, so the text cannot take
  06F9'   C3 06D2'              	JMP	UNDGRL		;     them back
                                
                                ;UNDCLR -- nothing is undoable (a fresh buffer; BINIT calls it through INIGAP).
  06FC'                         UNDCLR:
  06FC'   AF                    	XRA	A
  06FD'   32 0B46'              	STA	UNDN
  0700'   32 0B47'              	STA	UNDST
  0703'   32 0B48'              	STA	UNDBAD
  0706'   3E 01                 	MVI	A,1
  0708'   32 0B49'              	STA	UNDNEW
  070B'   C9                    	RET
                                
                                ;UNDRST -- the first capture of a new change: drop the last one and note where
                                ;the file window was, so 'u' can tell the pager has since moved off this change.
  070C'                         UNDRST:
  070C'   AF                    	XRA	A
  070D'   32 0B49'              	STA	UNDNEW
  0710'   32 0B46'              	STA	UNDN
  0713'   32 0B48'              	STA	UNDBAD
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  0716'   21 0000               	LXI	H,0
  0719'   22 0B5A'              	SHLD	UNDPTR		; the region's content empties (its SIZE stays:
                                				;   that is the room UNDGRW claimed)
  071C'   2A 0000*              	LHLD	PGTOPM
  071F'   22 0B58'              	SHLD	UNDPG
  0722'   2A 0B5D'              	LHLD	UNDPCU
  0725'   22 0B5F'              	SHLD	UNDCUR		; ... and this command does change text, so this
                                				;   is where 'u' will put the cursor back
  0728'   3E 01                 	MVI	A,1
  072A'   32 0B47'              	STA	UNDST		; a change is on the buffer: 'u' undoes it
  072D'   C9                    	RET
                                
                                ;UNDCHG -- the capture every hooked primitive uses.  A = UR_INS / UR_DEL,
                                ;HL = the logical offset it acted at, BC = how many bytes.  The bytes are read
                                ;back out of the resident TEXT at that offset -- for a delete before they go,
                                ;for an insert once they have arrived -- so no caller hands over a pointer that
                                ;growing the region could leave stale.
  072E'                         UNDCHG:
  072E'   C5                    	PUSH	B
  072F'   D5                    	PUSH	D
  0730'   E5                    	PUSH	H
  0731'   32 0B4D'              	STA	UNDTY		; the record type, kept out of the registers
  0734'   CD 07AC'              	CALL	EDTGO		; whoever else follows an edit (BC is kept)
  0737'   3A 0B4A'              	LDA	UNDRPL
  073A'   B7                    	ORA	A
  073B'   C2 0594'              	JNZ	POPRET		; 'u' replaying: its own edits are not a change
  073E'   3A 0B49'              	LDA	UNDNEW
  0741'   B7                    	ORA	A
  0742'   CA 0748'              	JZ	UNDC1
  0745'   CD 070C'              	CALL	UNDRST		; the first step of a new change
  0748'                         UNDC1:
  0748'   3A 0B48'              	LDA	UNDBAD
  074B'   B7                    	ORA	A
  074C'   C2 0594'              	JNZ	POPRET		; this change has already been given up on
  074F'   78                    	MOV	A,B
  0750'   B1                    	ORA	C
  0751'   CA 0594'              	JZ	POPRET		; a zero-length step is no step
  0754'   60                    	MOV	H,B
  0755'   69                    	MOV	L,C
  0756'   22 0B54'              	SHLD	UNDCL		; UNDAPT spends BC as its countdown, so the
                                				;   length has to be kept somewhere else
  0759'   3A 0B46'              	LDA	UNDN
  075C'   FE 18                 	CPI	URMAX
  075E'   D2 07A4'              	JNC	UNDCBD		; no room for another step
                                	;--- where this step's bytes will land in the region ---
  0761'   2A 0B5A'              	LHLD	UNDPTR
  0764'   22 0B52'              	SHLD	UNDBO
  0767'   E1                    	POP	H
  0768'   E5                    	PUSH	H		; HL = the logical offset again
  0769'   CD 081C'              	CALL	UNDAPT		; BC bytes of the text there -> the region
  076C'   DA 07A4'              	JC	UNDCBD
                                	;--- fold it into the last record when it only carries that one on ---
  076F'   E1                    	POP	H
  0770'   E5                    	PUSH	H
  0771'   CD 07C4'              	CALL	UNDEXT
  0774'   CA 0594'              	JZ	POPRET
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


                                	;--- otherwise a record of its own ---
  0777'   3A 0B46'              	LDA	UNDN
  077A'   CD 07B4'              	CALL	URADDR
  077D'   3A 0B4D'              	LDA	UNDTY
  0780'   77                    	MOV	M,A
  0781'   23                    	INX	H
  0782'   D1                    	POP	D
  0783'   D5                    	PUSH	D		; DE = the logical offset
  0784'   73                    	MOV	M,E
  0785'   23                    	INX	H
  0786'   72                    	MOV	M,D
  0787'   23                    	INX	H
  0788'   EB                    	XCHG			; DE = the record, past the offset
  0789'   2A 0B54'              	LHLD	UNDCL
  078C'   EB                    	XCHG			; ... and HL back, with DE = the length
  078D'   73                    	MOV	M,E
  078E'   23                    	INX	H
  078F'   72                    	MOV	M,D
  0790'   23                    	INX	H
  0791'   3A 0B52'              	LDA	UNDBO
  0794'   77                    	MOV	M,A
  0795'   23                    	INX	H
  0796'   3A 0B53'              	LDA	UNDBO+1
  0799'   77                    	MOV	M,A
  079A'   3A 0B46'              	LDA	UNDN
  079D'   3C                    	INR	A
  079E'   32 0B46'              	STA	UNDN
  07A1'   C3 0594'              	JMP	POPRET
  07A4'                         UNDCBD:
  07A4'   3E 01                 	MVI	A,1
  07A6'   32 0B48'              	STA	UNDBAD		; too big to keep: not undoable at all
  07A9'   C3 0594'              	JMP	POPRET
                                
                                ;EDTGO -- UNDCHG is the one place every change to the text goes by, the
                                ;replay's own included, so it is also where the editor hears of one: EDTHK is
                                ;called with A = UR_INS / UR_DEL, HL = the logical offset and BC = the length,
                                ;and must keep BC.  VI.MAC points it at the marks; a harness leaves it a RET.
  07AC'                         EDTGO:
  07AC'   E5                    	PUSH	H
  07AD'   2A 07B2'              	LHLD	EDTHK
  07B0'   E3                    	XTHL
  07B1'   C9                    	RET
  07B2'   05C9'                 EDTHK:	DW	ERMNUL
                                
                                ;URADDR -- A = a record index -> HL = its address (base + n*8 - n).
  07B4'                         URADDR:
  07B4'   6F                    	MOV	L,A
  07B5'   26 00                 	MVI	H,0
  07B7'   5D                    	MOV	E,L
  07B8'   54                    	MOV	D,H
  07B9'   29                    	DAD	H
  07BA'   29                    	DAD	H
  07BB'   29                    	DAD	H		; HL = n*8
  07BC'   CD 0549'              	CALL	SUBHD		; HL = n*7
  07BF'   11 0000*              	LXI	D,UNDREC
  07C2'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  07C3'   C9                    	RET
                                
                                ;UNDEXT -- A = 0 (Z) when this step only carries the last record on: an insert
                                ;starting exactly where the last insert ended, which is what typing does.  Its
                                ;bytes already sit contiguously behind that record's, so only the length grows.
                                ;HL = this step's offset, BC = its length.
  07C4'                         UNDEXT:
  07C4'   C5                    	PUSH	B
  07C5'   D5                    	PUSH	D
  07C6'   E5                    	PUSH	H
  07C7'   3A 0B4D'              	LDA	UNDTY
  07CA'   FE 01                 	CPI	UR_INS
  07CC'   C2 0816'              	JNZ	UNDXNO		; only inserts fold
  07CF'   3A 0B46'              	LDA	UNDN
  07D2'   B7                    	ORA	A
  07D3'   CA 0816'              	JZ	UNDXNO		; nothing to fold into
  07D6'   3D                    	DCR	A
  07D7'   CD 07B4'              	CALL	URADDR
  07DA'   22 0B56'              	SHLD	UNDLSA
  07DD'   7E                    	MOV	A,M
  07DE'   FE 01                 	CPI	UR_INS
  07E0'   C2 0816'              	JNZ	UNDXNO
  07E3'   2A 0B56'              	LHLD	UNDLSA
  07E6'   23                    	INX	H
  07E7'   CD 0562'              	CALL	LDHLI		; HL = the last record's offset
  07EA'   EB                    	XCHG
  07EB'   2A 0B56'              	LHLD	UNDLSA
  07EE'   23                    	INX	H
  07EF'   23                    	INX	H
  07F0'   23                    	INX	H
  07F1'   CD 0562'              	CALL	LDHLI		; HL = its length
  07F4'   19                    	DAD	D		; HL = where it ends
  07F5'   EB                    	XCHG
  07F6'   E1                    	POP	H
  07F7'   E5                    	PUSH	H		; HL = this step's offset
  07F8'   CD 0567'              	CALL	CMP16		; Z iff this step starts exactly there
  07FB'   C2 0816'              	JNZ	UNDXNO
  07FE'   2A 0B56'              	LHLD	UNDLSA
  0801'   23                    	INX	H
  0802'   23                    	INX	H
  0803'   23                    	INX	H
  0804'   E5                    	PUSH	H
  0805'   CD 0562'              	CALL	LDHLI		; HL = the last record's length
  0808'   EB                    	XCHG
  0809'   2A 0B54'              	LHLD	UNDCL
  080C'   19                    	DAD	D		; ... grown by this step's
  080D'   EB                    	XCHG
  080E'   E1                    	POP	H
  080F'   73                    	MOV	M,E
  0810'   23                    	INX	H
  0811'   72                    	MOV	M,D
  0812'   AF                    	XRA	A		; Z: folded, no new record
  0813'   C3 0594'              	JMP	POPRET
  0816'                         UNDXNO:
  0816'   3E 01                 	MVI	A,1
  0818'   B7                    	ORA	A		; NZ: it needs a record of its own
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0819'   C3 0594'              	JMP	POPRET
                                
                                ;UNDAPT -- append BC bytes of resident text, from logical offset HL, to the
                                ;undo region.  One byte at a time, re-reading the offset through CHARAT and the
                                ;region through its pointer cell every time, so growing the region (which
                                ;slides regions about) can never leave this loop holding a stale address.
                                ;CY if it outgrows the claim, and the caller then gives the change up.
  081C'                         UNDAPT:
  081C'   78                    	MOV	A,B
  081D'   B1                    	ORA	C
  081E'   C8                    	RZ			; nothing to append
  081F'                         UNDAPL:
  081F'   C5                    	PUSH	B
  0820'   E5                    	PUSH	H
  0821'   CD 0607'              	CALL	CHARAT		; A = the text byte at this offset
  0824'   CD 0832'              	CALL	UNDAPB		; ... into the region
  0827'   E1                    	POP	H
  0828'   C1                    	POP	B
  0829'   D8                    	RC
  082A'   23                    	INX	H
  082B'   0B                    	DCX	B
  082C'   78                    	MOV	A,B
  082D'   B1                    	ORA	C
  082E'   C2 081F'              	JNZ	UNDAPL
  0831'   C9                    	RET
                                
                                ;UNDAPB -- put the byte in A into the room UNDGRW claimed.  It does NOT grow
                                ;the region -- see UNDGRW -- so CY, and the change given up on, once the room
                                ;is used up: a change bigger than the region is simply not undoable.
  0832'                         UNDAPB:
  0832'   C5                    	PUSH	B
  0833'   D5                    	PUSH	D
  0834'   E5                    	PUSH	H
  0835'   32 0B5C'              	STA	UNDB1
  0838'   21 0B12'              	LXI	H,UBEG
  083B'   CD 0495'              	CALL	PRSPAN		; BC = the region's size
  083E'   2A 0B5A'              	LHLD	UNDPTR
  0841'   EB                    	XCHG			; DE = where the next byte goes
  0842'   60                    	MOV	H,B
  0843'   69                    	MOV	L,C
  0844'   CD 0567'              	CALL	CMP16		; CY iff that is still inside the region
  0847'   D2 085D'              	JNC	UNDAPF
  084A'   2A 0B12'              	LHLD	UBEG		; re-read: a relocation moves the region
  084D'   19                    	DAD	D
  084E'   3A 0B5C'              	LDA	UNDB1
  0851'   77                    	MOV	M,A
  0852'   2A 0B5A'              	LHLD	UNDPTR
  0855'   23                    	INX	H
  0856'   22 0B5A'              	SHLD	UNDPTR
  0859'   B7                    	ORA	A		; CY clear: it went in
  085A'   C3 0594'              	JMP	POPRET
  085D'                         UNDAPF:
  085D'   3E 01                 	MVI	A,1
  085F'   32 0B48'              	STA	UNDBAD
  0862'   37                    	STC
  0863'   C3 0594'              	JMP	POPRET
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


                                
                                ;UNDRM -- CY, and the change given up on, unless the arena still holds UNDRSV
                                ;free.  The capture must never page: paging moves the window off the change and
                                ;would invalidate every logical offset the records hold.  Keeping this much
                                ;free also keeps MKGAP off its MKROOM path, so the capture cannot page even by
                                ;accident, and it fails QUIETLY where QROOM raises 'QBUF FULL' -- undo going
                                ;away must never stop the editing.
  0866'                         UNDRM:
  0866'   C5                    	PUSH	B
  0867'   D5                    	PUSH	D
  0868'   E5                    	PUSH	H
  0869'   CD 042F'              	CALL	BUFSUM		; DE = the arena's free bytes
  086C'   21 0200               	LXI	H,UNDRSV
  086F'   CD 0567'              	CALL	CMP16		; CY iff less than that is left
  0872'   D2 0594'              	JNC	POPRET
  0875'   3E 01                 	MVI	A,1
  0877'   32 0B48'              	STA	UNDBAD
  087A'   37                    	STC
  087B'   C3 0594'              	JMP	POPRET
                                
                                ;---------------------------------------------------------------- the replay
                                
                                ;UNDO -- 'u'.  CY when there is nothing to undo: no change captured, a change
                                ;too big to have been captured, or the pager has moved the window off it.
  087E'                         UNDO:
  087E'   AF                    	XRA	A
  087F'   32 0B4C'              	STA	UNDWHY		; refused for want of a change, until told else
  0882'   3A 0B48'              	LDA	UNDBAD		; asked BEFORE the count of records: a change
  0885'   B7                    	ORA	A		;   too big from its very first step leaves
  0886'   CA 0890'              	JZ	UND_OK		;   none, and is still not 'nothing to undo'
  0889'   3E 02                 	MVI	A,2
  088B'   32 0B4C'              	STA	UNDWHY		; too big to have been captured: CMD.MAC says
  088E'   37                    	STC			;   so, rather than ringing the bell at a user
  088F'   C9                    	RET			;   who has no way to know why
  0890'                         UND_OK:
  0890'   3A 0B46'              	LDA	UNDN
  0893'   B7                    	ORA	A
  0894'   37                    	STC
  0895'   C8                    	RZ			; nothing captured
  0896'   2A 0000*              	LHLD	PGTOPM
  0899'   EB                    	XCHG
  089A'   2A 0B58'              	LHLD	UNDPG
  089D'   CD 0567'              	CALL	CMP16
  08A0'   C2 08D3'              	JNZ	UNDPGD		; the pager has moved the window's top since,
                                				;   so every offset the records hold has shifted
  08A3'   3E FF                 	MVI	A,0FFH
  08A5'   32 0B65'              	STA	UNDML		; (no step taken yet)
  08A8'   AF                    	XRA	A
  08A9'   32 0B61'              	STA	UNDLK
  08AC'   32 0B62'              	STA	UNDLC
  08AF'   3E 01                 	MVI	A,1
  08B1'   32 0B4A'              	STA	UNDRPL		; the replay's own edits are not a new change
  08B4'   3A 0B47'              	LDA	UNDST
  08B7'   FE 01                 	CPI	1
  08B9'   CA 08DA'              	JZ	UNDREV
                                	;--- the last 'u' undid it: apply the records forward again (a redo) ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  08BC'   AF                    	XRA	A
  08BD'   32 0B4B'              	STA	UNDDIR
  08C0'   AF                    	XRA	A
  08C1'                         UNDFWL:
  08C1'   CD 08FB'              	CALL	URSTEP
  08C4'   3C                    	INR	A
  08C5'   47                    	MOV	B,A
  08C6'   3A 0B46'              	LDA	UNDN
  08C9'   B8                    	CMP	B
  08CA'   78                    	MOV	A,B
  08CB'   C2 08C1'              	JNZ	UNDFWL
  08CE'   3E 01                 	MVI	A,1
  08D0'   C3 08EC'              	JMP	UNDFIN
  08D3'                         UNDPGD:
  08D3'   3E 01                 	MVI	A,1
  08D5'   32 0B4C'              	STA	UNDWHY		; the change is no longer in the window
  08D8'   37                    	STC
  08D9'   C9                    	RET
  08DA'                         UNDREV:
                                	;--- undo: the records backward, each one's inverse ---
  08DA'   3E 01                 	MVI	A,1
  08DC'   32 0B4B'              	STA	UNDDIR
  08DF'   3A 0B46'              	LDA	UNDN
  08E2'                         UNDRVL:
  08E2'   3D                    	DCR	A
  08E3'   CD 08FB'              	CALL	URSTEP
  08E6'   B7                    	ORA	A
  08E7'   C2 08E2'              	JNZ	UNDRVL
  08EA'   3E 02                 	MVI	A,2
  08EC'                         UNDFIN:
  08EC'   32 0B47'              	STA	UNDST
  08EF'   AF                    	XRA	A
  08F0'   32 0B4A'              	STA	UNDRPL
                                	;--- the cursor goes back where the command that changed it began:
                                	;    measured from vim, which restores that and not the change's own
                                	;    offset (CMD.MAC's VC_UNDO holds it inside the line) ---
  08F3'   2A 0B5F'              	LHLD	UNDCUR
  08F6'   CD 061D'              	CALL	GOTO
  08F9'   B7                    	ORA	A		; CY clear: it happened
  08FA'   C9                    	RET
                                
                                ;URSTEP -- apply record A: as it stands when UNDDIR is 0 (a redo), inverted
                                ;when it is 1 (an undo).  An insert applied puts its saved bytes back at its
                                ;offset; an insert inverted deletes that many bytes there; a delete is the
                                ;mirror of both.  A is preserved -- UNDO's loops count with it.
  08FB'                         URSTEP:
  08FB'   F5                    	PUSH	PSW
  08FC'   CD 07B4'              	CALL	URADDR
  08FF'   7E                    	MOV	A,M
  0900'   32 0B4D'              	STA	UNDTY
  0903'   23                    	INX	H
  0904'   7E                    	MOV	A,M
  0905'   32 0B4E'              	STA	UNDOF
  0908'   23                    	INX	H
  0909'   7E                    	MOV	A,M
  090A'   32 0B4F'              	STA	UNDOF+1
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  090D'   23                    	INX	H
  090E'   7E                    	MOV	A,M
  090F'   32 0B50'              	STA	UNDLN
  0912'   23                    	INX	H
  0913'   7E                    	MOV	A,M
  0914'   32 0B51'              	STA	UNDLN+1
  0917'   23                    	INX	H
  0918'   7E                    	MOV	A,M
  0919'   32 0B52'              	STA	UNDBO
  091C'   23                    	INX	H
  091D'   7E                    	MOV	A,M
  091E'   32 0B53'              	STA	UNDBO+1
  0921'   2A 0B52'              	LHLD	UNDBO		; a line end among its bytes: more than one
  0924'   EB                    	XCHG			;   line changes (UNDML: CMD.MAC picks the
  0925'   2A 0B12'              	LHLD	UBEG		;   repaint by it)
  0928'   19                    	DAD	D
  0929'   EB                    	XCHG
  092A'   2A 0B50'              	LHLD	UNDLN
  092D'   19                    	DAD	D
  092E'   CD 064D'              	CALL	LFCNT
  0931'   7A                    	MOV	A,D
  0932'   B3                    	ORA	E
  0933'   CA 093B'              	JZ	URS_1L
  0936'   3E 01                 	MVI	A,1
  0938'   32 0B65'              	STA	UNDML
  093B'                         URS_1L:
  093B'   3A 0B4D'              	LDA	UNDTY
  093E'   47                    	MOV	B,A
  093F'   3A 0B4B'              	LDA	UNDDIR
  0942'   B7                    	ORA	A
  0943'   CA 094F'              	JZ	URS_AP
  0946'   78                    	MOV	A,B		; an undo inverts the record
  0947'   FE 01                 	CPI	UR_INS
  0949'   CA 0955'              	JZ	URS_DL
  094C'   C3 0965'              	JMP	URS_IN
  094F'                         URS_AP:
  094F'   78                    	MOV	A,B		; a redo applies it as it stands
  0950'   FE 01                 	CPI	UR_INS
  0952'   CA 0965'              	JZ	URS_IN
  0955'                         URS_DL:
                                	;--- take the record's length back out at its offset ---
  0955'   CD 0997'              	CALL	URGOTO
  0958'   3E 02                 	MVI	A,2
  095A'   CD 09BD'              	CALL	URLNQ
  095D'   2A 0B50'              	LHLD	UNDLN
  0960'   CD 0678'              	CALL	DELFWD
  0963'   F1                    	POP	PSW
  0964'   C9                    	RET
  0965'                         URS_IN:
                                	;--- put the record's saved bytes back in at its offset ---
  0965'   CD 0997'              	CALL	URGOTO
  0968'   3E 01                 	MVI	A,1
  096A'   CD 09BD'              	CALL	URLNQ
  096D'   2A 0B50'              	LHLD	UNDLN
  0970'   44                    	MOV	B,H
  0971'   4D                    	MOV	C,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0972'   2A 0B52'              	LHLD	UNDBO
  0975'                         URSILP:
  0975'   C5                    	PUSH	B
  0976'   E5                    	PUSH	H
  0977'   EB                    	XCHG			; DE = the byte's offset within the region
  0978'   2A 0B12'              	LHLD	UBEG		; ... re-read every byte: inserting text can
  097B'   19                    	DAD	D		;     slide the region out from under it
  097C'   7E                    	MOV	A,M
  097D'   CD 0045'              	CALL	PUTGAP
  0980'   FE 0A                 	CPI	LF
  0982'   C2 098C'              	JNZ	URSILN
  0985'   2A 0B68'              	LHLD	LNDLT		; a line end put back is the cursor crossing
  0988'   23                    	INX	H		;   one, and GOTO keeps LNDLT for every move the
  0989'   22 0B68'              	SHLD	LNDLT		;   replay makes -- so the renderer needs no
  098C'                         URSILN:				;   whole-window rescan to find that out
  098C'   E1                    	POP	H
  098D'   C1                    	POP	B
  098E'   23                    	INX	H
  098F'   0B                    	DCX	B
  0990'   78                    	MOV	A,B
  0991'   B1                    	ORA	C
  0992'   C2 0975'              	JNZ	URSILP
  0995'   F1                    	POP	PSW
  0996'   C9                    	RET
                                
                                ;URGOTO -- the cursor to the record's offset.  The line the first step is on
                                ;is the change's (UNDL0 = LNDLT there, which GOTO keeps up); a later step on
                                ;another line makes the change more than one line's (UNDML).
  0997'                         URGOTO:
  0997'   2A 0B4E'              	LHLD	UNDOF
  099A'   CD 061D'              	CALL	GOTO
  099D'   2A 0B68'              	LHLD	LNDLT
  09A0'   EB                    	XCHG
  09A1'   3A 0B65'              	LDA	UNDML
  09A4'   3C                    	INR	A
  09A5'   C2 09B0'              	JNZ	URG_1
  09A8'   32 0B65'              	STA	UNDML		; (0: one line, so far)
  09AB'   EB                    	XCHG
  09AC'   22 0B66'              	SHLD	UNDL0
  09AF'   C9                    	RET
  09B0'                         URG_1:
  09B0'   2A 0B66'              	LHLD	UNDL0
  09B3'   CD 0567'              	CALL	CMP16
  09B6'   C8                    	RZ
  09B7'   3E 01                 	MVI	A,1
  09B9'   32 0B65'              	STA	UNDML
  09BC'   C9                    	RET
                                
                                ;URLNQ -- the step about to be taken at the cursor puts the record's bytes in
                                ;(A = 1) or takes them out (A = 2).  UNDLK stays that for as long as every
                                ;step does the same, with whole lines -- it starts at a line's start and the
                                ;bytes end in a line end -- and at the place the first one did (UNDLL0 =
                                ;LNDLT there); UNDLC counts the lines.  Anything else and UNDLK is 0FFH.
                                ;Two more ways of taking a whole line out are known for what they are: steps
                                ;at one line's start that end with a line only when the last has gone (UNDLK
                                ;is 3 until then), and one step from a line's END that takes its line end and
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


                                ;the next line's text -- the line under it, so UNDLL0 is that line's.
                                ;CMD.MAC opens the rows for lines put back, or closes them up, by these.
  09BD'                         URLNQ:
  09BD'   47                    	MOV	B,A
  09BE'   3A 0B61'              	LDA	UNDLK
  09C1'   B7                    	ORA	A
  09C2'   CA 09DF'              	JZ	URL_1
  09C5'   F6 01                 	ORI	1		; (2 and 3 are both lines going)
  09C7'   4F                    	MOV	C,A
  09C8'   78                    	MOV	A,B
  09C9'   F6 01                 	ORI	1
  09CB'   B9                    	CMP	C
  09CC'   C2 0A8F'              	JNZ	URL_NO
  09CF'   2A 0B63'              	LHLD	UNDLL0
  09D2'   EB                    	XCHG
  09D3'   2A 0B68'              	LHLD	LNDLT
  09D6'   CD 0567'              	CALL	CMP16
  09D9'   C2 0A8F'              	JNZ	URL_NO
  09DC'   C3 09E5'              	JMP	URL_2
  09DF'                         URL_1:
  09DF'   2A 0B68'              	LHLD	LNDLT
  09E2'   22 0B63'              	SHLD	UNDLL0
  09E5'                         URL_2:
  09E5'   CD 05CC'              	CALL	CUROFF
  09E8'   7C                    	MOV	A,H
  09E9'   B5                    	ORA	L
  09EA'   CA 0A3E'              	JZ	URL_3
  09ED'   2A 0B18'              	LHLD	GAPBEG
  09F0'   2B                    	DCX	H
  09F1'   7E                    	MOV	A,M
  09F2'   FE 0A                 	CPI	LF
  09F4'   CA 0A3E'              	JZ	URL_3
                                	;--- not at a line's start.  One step that takes out a line end and
                                	;    what follows it as far as the next ('o' and what was typed) is
                                	;    the line under that one going, all the same: UNDLL0 as for it ---
  09F7'   78                    	MOV	A,B
  09F8'   FE 02                 	CPI	2
  09FA'   C2 0A8F'              	JNZ	URL_NO
  09FD'   3A 0B61'              	LDA	UNDLK
  0A00'   B7                    	ORA	A
  0A01'   C2 0A8F'              	JNZ	URL_NO
  0A04'   2A 0B52'              	LHLD	UNDBO
  0A07'   EB                    	XCHG
  0A08'   2A 0B12'              	LHLD	UBEG
  0A0B'   19                    	DAD	D
  0A0C'   7E                    	MOV	A,M
  0A0D'   FE 0D                 	CPI	CR
  0A0F'   CA 0A17'              	JZ	URL_B0
  0A12'   FE 0A                 	CPI	LF
  0A14'   C2 0A8F'              	JNZ	URL_NO
  0A17'                         URL_B0:
  0A17'   2A 0B50'              	LHLD	UNDLN
  0A1A'   EB                    	XCHG
  0A1B'   2A 0B1A'              	LHLD	GAPEND
  0A1E'   19                    	DAD	D
  0A1F'   EB                    	XCHG			; DE = the text after what goes
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0A20'   2A 0B1C'              	LHLD	TXTEND
  0A23'   CD 0567'              	CALL	CMP16
  0A26'   D2 0A34'              	JNC	URL_B1		; (the end of the text)
  0A29'   1A                    	LDAX	D
  0A2A'   FE 0D                 	CPI	CR
  0A2C'   CA 0A34'              	JZ	URL_B1
  0A2F'   FE 0A                 	CPI	LF
  0A31'   C2 0A8F'              	JNZ	URL_NO
  0A34'                         URL_B1:
  0A34'   2A 0B63'              	LHLD	UNDLL0
  0A37'   23                    	INX	H
  0A38'   22 0B63'              	SHLD	UNDLL0
  0A3B'   C3 0A5E'              	JMP	URL_4
  0A3E'                         URL_3:
  0A3E'   2A 0B50'              	LHLD	UNDLN
  0A41'   7C                    	MOV	A,H
  0A42'   B5                    	ORA	L
  0A43'   CA 0A8F'              	JZ	URL_NO
  0A46'   EB                    	XCHG
  0A47'   2A 0B52'              	LHLD	UNDBO
  0A4A'   19                    	DAD	D
  0A4B'   EB                    	XCHG
  0A4C'   2A 0B12'              	LHLD	UBEG
  0A4F'   19                    	DAD	D		; HL = past the record's bytes
  0A50'   2B                    	DCX	H
  0A51'   7E                    	MOV	A,M
  0A52'   FE 0A                 	CPI	LF
  0A54'   CA 0A5E'              	JZ	URL_4
  0A57'   78                    	MOV	A,B		; steps that take text out at one place take
  0A58'   FE 02                 	CPI	2		;   what is there each time, so it is the last
  0A5A'   C2 0A8F'              	JNZ	URL_NO		;   of them that has to end with a line: 3
  0A5D'   04                    	INR	B		;   until it does ('O': the text typed goes,
  0A5E'                         URL_4:				;   then the line end before it)
  0A5E'   2A 0B50'              	LHLD	UNDLN
  0A61'   EB                    	XCHG
  0A62'   2A 0B52'              	LHLD	UNDBO
  0A65'   19                    	DAD	D
  0A66'   EB                    	XCHG
  0A67'   2A 0B12'              	LHLD	UBEG
  0A6A'   19                    	DAD	D
  0A6B'   E5                    	PUSH	H
  0A6C'   2A 0B52'              	LHLD	UNDBO
  0A6F'   EB                    	XCHG
  0A70'   2A 0B12'              	LHLD	UBEG
  0A73'   19                    	DAD	D
  0A74'   EB                    	XCHG			; DE = their start
  0A75'   E1                    	POP	H
  0A76'   C5                    	PUSH	B
  0A77'   CD 064D'              	CALL	LFCNT
  0A7A'   C1                    	POP	B
  0A7B'   7A                    	MOV	A,D
  0A7C'   B7                    	ORA	A
  0A7D'   C2 0A8F'              	JNZ	URL_NO
  0A80'   3A 0B62'              	LDA	UNDLC
  0A83'   83                    	ADD	E
  0A84'   DA 0A8F'              	JC	URL_NO
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0A87'   32 0B62'              	STA	UNDLC
  0A8A'   78                    	MOV	A,B
  0A8B'   32 0B61'              	STA	UNDLK
  0A8E'   C9                    	RET
  0A8F'                         URL_NO:
  0A8F'   3E FF                 	MVI	A,0FFH
  0A91'   32 0B61'              	STA	UNDLK
  0A94'   C9                    	RET
                                
                                ;---------------------------------------------------------------- the hooks
                                
                                ;UNDPUT -- PUTGAP's tail: the one byte now sitting just below the cursor.
  0A95'                         UNDPUT:
  0A95'   F5                    	PUSH	PSW
  0A96'   C5                    	PUSH	B
  0A97'   D5                    	PUSH	D
  0A98'   E5                    	PUSH	H
  0A99'   CD 05CC'              	CALL	CUROFF
  0A9C'   2B                    	DCX	H
  0A9D'   01 0001               	LXI	B,1
  0AA0'   3E 01                 	MVI	A,UR_INS
  0AA2'   CD 072E'              	CALL	UNDCHG
  0AA5'   C3 0B03'              	JMP	UNDHX
                                
                                ;UNDGET -- QGET's tail: BC bytes of register now in, the cursor past them.
                                ;UNDINS is the same entry by its general name: INSBLK itself carries NO hook
                                ;(insert mode records a byte at a time through PUTGAP), so a command that
                                ;splices a block in -- ':s' replacing a match -- has to say so itself, exactly
                                ;as QGET does.  Without it 'u' puts the deleted text back and leaves the
                                ;inserted text there ('a-a-a' undid to 'aZ-aZ-aZ').
  0AA8'                         UNDINS:
  0AA8'                         UNDGET:
  0AA8'   F5                    	PUSH	PSW
  0AA9'   C5                    	PUSH	B
  0AAA'   D5                    	PUSH	D
  0AAB'   E5                    	PUSH	H
  0AAC'   78                    	MOV	A,B
  0AAD'   B1                    	ORA	C
  0AAE'   CA 0B03'              	JZ	UNDHX
  0AB1'   CD 05CC'              	CALL	CUROFF
  0AB4'   50                    	MOV	D,B
  0AB5'   59                    	MOV	E,C
  0AB6'   CD 0549'              	CALL	SUBHD		; HL = where the put began
  0AB9'   3E 01                 	MVI	A,UR_INS
  0ABB'   CD 072E'              	CALL	UNDCHG
  0ABE'   C3 0B03'              	JMP	UNDHX
                                
                                ;UNDDLF -- DELFWD's head: HL bytes about to go forward from the cursor.
  0AC1'                         UNDDLF:
  0AC1'   F5                    	PUSH	PSW
  0AC2'   C5                    	PUSH	B
  0AC3'   D5                    	PUSH	D
  0AC4'   E5                    	PUSH	H
  0AC5'   44                    	MOV	B,H
  0AC6'   4D                    	MOV	C,L
  0AC7'   CD 05CC'              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0ACA'   3E 02                 	MVI	A,UR_DEL
  0ACC'   CD 072E'              	CALL	UNDCHG
  0ACF'   C3 0B03'              	JMP	UNDHX
                                
                                ;UNDDLQ -- QPUTLN's head: BC bytes of whole lines about to go into the register.
  0AD2'                         UNDDLQ:
  0AD2'   F5                    	PUSH	PSW
  0AD3'   C5                    	PUSH	B
  0AD4'   D5                    	PUSH	D
  0AD5'   E5                    	PUSH	H
  0AD6'   CD 05CC'              	CALL	CUROFF
  0AD9'   3E 02                 	MVI	A,UR_DEL
  0ADB'   CD 072E'              	CALL	UNDCHG
  0ADE'   C3 0B03'              	JMP	UNDHX
                                
                                ;UNDDLP -- DELPRV's head: the one byte just below the cursor, about to go.
  0AE1'                         UNDDLP:
  0AE1'   F5                    	PUSH	PSW
  0AE2'   C5                    	PUSH	B
  0AE3'   D5                    	PUSH	D
  0AE4'   E5                    	PUSH	H
  0AE5'   CD 05CC'              	CALL	CUROFF
  0AE8'   2B                    	DCX	H
  0AE9'   01 0001               	LXI	B,1
  0AEC'   3E 02                 	MVI	A,UR_DEL
  0AEE'   CD 072E'              	CALL	UNDCHG
  0AF1'   C3 0B03'              	JMP	UNDHX
                                
                                ;UNDUDF -- UNDELF's tail: the byte DELTO just made text again, at the cursor.
  0AF4'                         UNDUDF:
  0AF4'   F5                    	PUSH	PSW
  0AF5'   C5                    	PUSH	B
  0AF6'   D5                    	PUSH	D
  0AF7'   E5                    	PUSH	H
  0AF8'   CD 05CC'              	CALL	CUROFF
  0AFB'   01 0001               	LXI	B,1
  0AFE'   3E 01                 	MVI	A,UR_INS
  0B00'   CD 072E'              	CALL	UNDCHG
                                ;UNDHX -- every hook leaves the primitive's own registers and flags alone.
  0B03'                         UNDHX:
  0B03'   E1                    	POP	H
  0B04'   D1                    	POP	D
  0B05'   C1                    	POP	B
  0B06'   F1                    	POP	PSW
  0B07'   C9                    	RET
                                
                                ;============================================================
                                ; DATA -- the (base,limit) pointer row (WM 6828-6871 layout) + scratch.
                                ; The disassembly's DB values for these cells are aliased code bytes; only the
                                ; order/adjacency is authoritative.  BINIT sets every cell at run time.
                                ;============================================================
  0B08'   0000                  BUFBEG: DW	0		; region-array base
  0B0A'   0000                  QBEG:	DW	0		; ^Q scratch buffer begin
  0B0C'   0000                  QEND:	DW	0		; ^Q scratch buffer end
  0B0E'   0000                  HOLEQP:	 DW	 0
  0B10'   0000                  TXTBAS: DW	0		; text base = PBEGMEM+1 (past the 0 sentinel)
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


                                ;UBEG/UEND -- APPENDED: the undo region, a region of the arena like the Q
                                ;buffer, with UEND its insertion point.  It goes HERE, between the slider and
                                ;the text, so both of the row's interleaved walks stay aligned: the holes from
                                ;BUFBEG are (BUFBEG,QBEG) (QEND,HOLEQP) (TXTBAS,UBEG) (UEND,TXTBEG)
                                ;(GAPBEG,GAPEND) (TXTEND,BUFEND), and the data regions from QBEG are
                                ;(QBEG,QEND) (HOLEQP,TXTBAS) (UBEG,UEND) (TXTBEG,GAPBEG) (GAPEND,TXTEND).
                                ;NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN, PRSPAN and INIBAS's count are all
                                ;untouched by it; INIGAP empties it.
  0B12'   0000                  UBEG:	DW	0		; undo region begin
  0B14'   0000                  UEND:	DW	0		; undo region end = its insertion point
  0B16'   0000                  TXTBEG: DW	0		; window start
  0B18'   0000                  GAPBEG: DW	0		; cursor / gap start
  0B1A'   0000                  GAPEND: DW	0		; gap end / first char after cursor
  0B1C'   0000                  TXTEND: DW	0		; window end
  0B1D'                         PRTERM	 EQU	 TXTEND+1	 ; NEXTPR terminator = high byte of TXTEND
  0B1E'   0000                  BUFEND: DW	0		; top of usable text RAM
  0B1F'                         MVGTOP	 EQU	 BUFEND+1	 ; MOVGAP upper bound = high byte of BUFEND
                                
  0B20'   00                    ERRFLG: DB	0		; nonzero after ERRMSG fired (harness reads it)
                                
                                ;The search pattern, in WM's SRCHBUF layout (WM 6900): the length, then the
                                ;string, 0-terminated.  CMD.MAC fills it from the '/' line and passes DE =
                                ;SRCHST; FWDCNT reads the length from the byte below that, as WM does.
  0B21'   1E                    SRCMAX: DB	SRMAX		; ... its capacity, so CMD.MAC cannot drift
  0B22'   00                    SRCHBF: DB	0		; the pattern length
  0B23'                         SRCHST: DS	SRMAX+1		; the pattern, 0-terminated
                                
  0B42'   0000                  L2756:	DW	0		; WM L2756 -- GOLINE's last target position
  0B44'   0000                  QCPDON: DW	0		; (appended) QCPYN: bytes already copied in
                                ;--- 'u' (undo): see the UNDO section above for how these are driven.
  0B46'   00                    UNDN:	DB	0		; steps captured (0 = nothing to undo)
  0B47'   00                    UNDST:	DB	0		; 0 none, 1 change applied ('u' undoes it),
                                				;   2 already undone ('u' puts it back)
  0B48'   00                    UNDBAD: DB	0		; 1 = this change was too big to capture
  0B49'   01                    UNDNEW: DB	1		; 1 = the next capture starts a new change
  0B4A'   00                    UNDRPL: DB	0		; 1 = 'u' replaying, so nothing is captured
  0B4B'   00                    UNDDIR: DB	0		; the replay's direction (0 forward, 1 inverse)
  0B4C'   00                    UNDWHY: DB	0		; 0 = nothing to undo, 1 = it has paged away
  0B4D'   00                    UNDTY:	DB	0		; the step / record type being handled
  0B4E'   0000                  UNDOF:	DW	0		; ... its logical offset
  0B50'   0000                  UNDLN:	DW	0		; ... its length
  0B52'   0000                  UNDBO:	DW	0		; ... where its bytes lie in the region
  0B54'   0000                  UNDCL:	DW	0		; the length being captured (BC does not survive)
  0B56'   0000                  UNDLSA: DW	0		; the last record's address (UNDEXT's scratch)
  0B58'   0000                  UNDPG:	DW	0		; PGTOPM when this change was captured
  0B5A'   0000                  UNDPTR: DW	0		; the region's write point, as an OFFSET
  0B5C'   00                    UNDB1:	DB	0		; the byte going in (PRSPAN wants BC)
  0B5D'   0000                  UNDPCU: DW	0		; the cursor as the current command began
  0B5F'   0000                  UNDCUR: DW	0		; ... as the command that made THIS change began
  0B61'   00                    UNDLK:	DB	0		; the replay: 1 = whole lines put in, 2 = taken
  0B62'   00                    UNDLC:	DB	0		;   out, 0FFH neither; how many; and LNDLT where
  0B63'   0000                  UNDLL0:	DW	0		;   they start (URLNQ)
  0B65'   00                    UNDML:	DB	0		; the replay: 0 = every step on one line, no
                                				;   line end put back or taken (0FFH: no step
                                				;   yet, 1: not so)
  0B66'   0000                  UNDL0:	DW	0		; ... LNDLT with the cursor on that line
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


                                
  0B68'   0000                  LNDLT:	DW	0		; (appended) lines the cursor moved since the last
                                				;   screen layout (signed; SCRN.MAC consumes it)
                                
                                ;PBEGMEM -- base of the text arena: the first RAM byte past everything the
                                ;program holds.  The gap buffer's text lives from here up to BUFEND.  BUF
                                ;links last but RSV.MAC links after it, holding the reserve block in the RAM
                                ;immediately above the image (it emits no bytes of its own), so the arena
                                ;starts at RSVTOP -- past the reserves -- and is the size it always was.
  0B6A'   0000*                 PBEGMEM:DW	RSVTOP
                                
  0B6C'                         MEMBAS:				; top of the linked image (RSV.MAC's base)
                                
                                	END
