                                ;============================================================
                                ; PAGESTP -- the count-limited scroll step.  The disk-eviction seam
                                ; (MKROOM/SPILL/SPILLB/PAGEBOT/REWIND), the deque marks (MARKGB/UPDMARK/RECBASE/
                                ; PTRREC) and the paging drivers (PAGEDIR/PGNEED/PAGEWIN) are all real in
                                ; PAGE.MAC, and CNTTST/CMDCNT/AUXCNT now exist in CMD.MAC.
                                ;============================================================
                                
                                ;PAGESTP -- WM 4311: page one step in the scroll direction, count-limited.
                                ;CNTTST returns Z when the command count (CMDCNT and AUXCNT) is exhausted, so a
                                ;completed edit or motion stops here (RZ); otherwise fall into PAGEDIR to page
                                ;the window one increment in the current scroll direction (DIRFLG: REWIND back,
                                ;FILLBUF forward).  In WM PAGESTP falls through to the physically adjacent
                                ;PAGEDIR; here PAGEDIR lives in PAGE.MAC, so the fall-through is an explicit
                                ;JMP -- same object behavior, PAGEDIR's own POLLBRK still runs.  DELTO's tail
                                ;JMPs here, so a delete made with the count spent returns at once; the count
                                ;loops (dd's QPUTLN, MVLLOOP's line moves, the search sweep through SCRLST)
                                ;are what page the window on past its edge.
                                ;SCRLST -- WM 4307: poll type-ahead, PUTCUR to HL, then (count not spent)
                                ;fall into PAGESTP to page the window one step in the DIRFLG direction.
  05A7'                         SCRLST:				; WM 4307
  05A7'   CD 0000*              	CALL	POLLBRK
  05AA'   CD 036B'              	CALL	PUTCUR
                                
  05AD'                         PAGESTP:			; WM 4311
  05AD'   CD 0000*              	CALL	CNTTST
  05B0'   C8                    	RZ
  05B1'   C3 0000*              	JMP	PAGEDIR
                                
                                ;============================================================
                                ; ERRMSG -- WM 664, message-print transcribed; TAIL adapted (see header):
                                ; print the inline 0-terminated message, set ERRFLG, warm-boot to CP/M.
                                ; The message is printed where ERRHK leaves the cursor: VI.MAC points it at the
                                ; screen teardown, so it lands on the bottom row with the terminal restored, as
                                ; a quit leaves it; a harness with no screen leaves it on a RET.  The work files
                                ; are dropped before the warm boot, as a quit drops them.  A second error from
                                ; inside either step ends here too: DISCRD clears its own flag before it
                                ; deletes, so it cannot run twice.
                                ;============================================================
  05B4'                         ERRMSG:				; WM 664 (tail adapted)
  05B4'   3E FF                 	MVI	A,0FFH
  05B6'   32 0000*              	STA	ERRFLG		; record that an error fired
  05B9'   2A 05D9'              	LHLD	ERRHK
  05BC'   CD 05D7'              	CALL	ERMGO		; the cursor to where the message belongs
  05BF'   E1                    	POP	H		; HL -> inline message (after the CALL)
  05C0'                         ERMLP:
  05C0'   7E                    	MOV	A,M
  05C1'   B7                    	ORA	A
  05C2'   CA 05D1'              	JZ	ERMEND
  05C5'   E5                    	PUSH	H
  05C6'   5F                    	MOV	E,A
  05C7'   0E 02                 	MVI	C,2		; BDOS console out
  05C9'   CD 0005               	CALL	BDOS
  05CC'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  05CD'   23                    	INX	H
  05CE'   C3 05C0'              	JMP	ERMLP
  05D1'                         ERMEND:
  05D1'   CD 0000*              	CALL	DISCRD		; no name.$$$ / VIBACKUP.$$$ left behind
  05D4'   C3 0000               	JMP	WBOOT		; adapted tail: back to CP/M
  05D7'   E9                    ERMGO:	PCHL
  05D8'   C9                    ERMNUL: RET
  05D9'   05D8'                 ERRHK:	DW	ERMNUL		; the screen's teardown, once there is a screen
                                
                                ;============================================================
                                ; LOGICAL-OFFSET API  (APPENDED -- NOT WordMaster).
                                ; The gap-agnostic view the vi layer (CMD.MAC) uses so it never touches the raw
                                ; pointer row.  A logical offset is a byte index into resident text as if the
                                ; gap were absent:
                                ;   before = GAPBEG - TXTBEG   (bytes before the cursor = cursor logical offset)
                                ;   after  = TXTEND - GAPEND   (bytes at/after the cursor)
                                ;   LOGLEN = before + after
                                ; Most of CMD.MAC's verbs work in these offsets alone; the rest drive WM's
                                ; pointer-based routines (PUTCUR, the line moves, RGET, the matchers, the
                                ; Q-buffer), which page as they go, and a few read the pointer row directly.
                                ;============================================================
                                
                                ;CUROFF -- HL = cursor logical offset (= before length).
  05DB'                         CUROFF:
  05DB'   2A 0000*              	LHLD	TXTBEG
  05DE'   EB                    	XCHG
  05DF'   2A 0000*              	LHLD	GAPBEG
  05E2'   CD 0558'              	CALL	SUBHD		; HL = GAPBEG - TXTBEG
  05E5'   C9                    	RET
                                
                                ;AFTLN2 -- HL = after length (TXTEND - GAPEND).  Private helper for LOGLEN.
  05E6'                         AFTLN2:
  05E6'   2A 0000*              	LHLD	GAPEND
  05E9'   EB                    	XCHG
  05EA'   2A 0000*              	LHLD	TXTEND
  05ED'   CD 0558'              	CALL	SUBHD
  05F0'   C9                    	RET
                                
                                ;LOGLEN -- HL = total resident logical length.
  05F1'                         LOGLEN:
  05F1'   CD 05DB'              	CALL	CUROFF
  05F4'   E5                    	PUSH	H
  05F5'   CD 05E6'              	CALL	AFTLN2
  05F8'   D1                    	POP	D
  05F9'   19                    	DAD	D
  05FA'   C9                    	RET
                                
                                ;L2PHYS -- HL(off) -> HL(physical address).  0 <= off <= LOGLEN.  Private.
  05FB'                         L2PHYS:
  05FB'   EB                    	XCHG			; DE = off
  05FC'   D5                    	PUSH	D
  05FD'   CD 05DB'              	CALL	CUROFF		; HL = before
  0600'   D1                    	POP	D		; DE = off
  0601'   CD 0576'              	CALL	CMP16		; DE=off vs HL=before: CY iff off < before
  0604'   DA 0611'              	JC	L2P_BEF
                                	;--- after region: phys = GAPEND + (off - before) ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  0607'   EB                    	XCHG			; HL=off, DE=before
  0608'   CD 0558'              	CALL	SUBHD		; HL = off - before
  060B'   EB                    	XCHG			; DE = off-before
  060C'   2A 0000*              	LHLD	GAPEND
  060F'   19                    	DAD	D
  0610'   C9                    	RET
  0611'                         L2P_BEF:
                                	;--- before region: phys = TXTBEG + off  (DE = off, HL = before) ---
  0611'   2A 0000*              	LHLD	TXTBEG
  0614'   19                    	DAD	D
  0615'   C9                    	RET
                                
                                ;CHARAT -- HL(off) -> A = byte at that logical offset (off < LOGLEN).
  0616'                         CHARAT:
  0616'   CD 05FB'              	CALL	L2PHYS
  0619'   7E                    	MOV	A,M
  061A'   C9                    	RET
                                
                                ;CLAMPL -- HL(off) -> HL clamped to [0, LOGLEN].  Private helper for GOTO.
  061B'                         CLAMPL:
  061B'   E5                    	PUSH	H
  061C'   CD 05F1'              	CALL	LOGLEN
  061F'   D1                    	POP	D		; DE = off
  0620'   CD 0576'              	CALL	CMP16		; DE=off vs HL=LOGLEN
  0623'   DA 062A'              	JC	CLK_KEEP	; off < LOGLEN
  0626'   CA 062A'              	JZ	CLK_KEEP	; off == LOGLEN
  0629'   C9                    	RET			; off > LOGLEN -> HL = LOGLEN
  062A'                         CLK_KEEP:
  062A'   EB                    	XCHG			; HL = off
  062B'   C9                    	RET
                                
                                ;GOTO -- HL(off): move the cursor to that logical offset.
                                ;PUTCUR takes its target address in HL (its entry XCHG moves it to DE).
                                ;The line feeds the cursor crosses are added to LNDLT (subtracted going back).
  062C'                         GOTO:
  062C'   CD 061B'              	CALL	CLAMPL
  062F'   CD 05FB'              	CALL	L2PHYS		; HL = physical address
  0632'   E5                    	PUSH	H
  0633'   EB                    	XCHG			; DE = target
  0634'   2A 0000*              	LHLD	GAPEND
  0637'   CD 0576'              	CALL	CMP16		; CY iff target < GAPEND (before the gap)
  063A'   DA 0648'              	JC	GTO_BK
  063D'   EB                    	XCHG			; forward: count [GAPEND, target)
  063E'   CD 065C'              	CALL	LFCNT
  0641'   2A 0000*              	LHLD	LNDLT
  0644'   19                    	DAD	D
  0645'   C3 0654'              	JMP	GTO_ST
  0648'                         GTO_BK:
  0648'   2A 0000*              	LHLD	GAPBEG		; back: count [target, GAPBEG)
  064B'   CD 065C'              	CALL	LFCNT
  064E'   2A 0000*              	LHLD	LNDLT
  0651'   CD 0558'              	CALL	SUBHD
  0654'                         GTO_ST:
  0654'   22 0000*              	SHLD	LNDLT
  0657'   E1                    	POP	H
  0658'   CD 036B'              	CALL	PUTCUR
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  065B'   C9                    	RET
                                
                                ;LFCNT -- DE = start, HL = end (>= start): DE = number of LFs in [start, end).
  065C'                         LFCNT:
  065C'   CD 0558'              	CALL	SUBHD		; HL = end - start
  065F'   44                    	MOV	B,H
  0660'   4D                    	MOV	C,L		; BC = length
  0661'   EB                    	XCHG			; HL = start
  0662'   11 0000               	LXI	D,0
  0665'                         LFC_LP:
  0665'   78                    	MOV	A,B
  0666'   B1                    	ORA	C
  0667'   C8                    	RZ
  0668'   7E                    	MOV	A,M
  0669'   23                    	INX	H
  066A'   0B                    	DCX	B
  066B'   FE 0A                 	CPI	LF
  066D'   C2 0665'              	JNZ	LFC_LP
  0670'   13                    	INX	D
  0671'   C3 0665'              	JMP	LFC_LP
                                
                                ;RDGET -- RGET, and CY also when a refill read nothing.  INRDY stays set after
                                ;a file's last full record (no ^Z) until a read fails; NEEDIN then returns NC
                                ;having added nothing, and RGET steps past TXTEND leaving BC = FFFFH.  That is
                                ;reported as the end of the text, with BC = 0 so a later call asks NEEDIN again.
  0674'                         RDGET:
  0674'   CD 04B6'              	CALL	RGET
  0677'   D8                    	RC
  0678'   F5                    	PUSH	PSW
  0679'   78                    	MOV	A,B
  067A'   A1                    	ANA	C
  067B'   3C                    	INR	A		; Z iff BC = FFFFH
  067C'   CA 0681'              	JZ	RDG_EF
  067F'   F1                    	POP	PSW
  0680'   C9                    	RET
  0681'                         RDG_EF:
  0681'   F1                    	POP	PSW
  0682'   01 0000               	LXI	B,0
  0685'   37                    	STC
  0686'   C9                    	RET
                                
                                ;DELFWD -- HL = number of logical bytes to delete forward from the cursor.
  0687'                         DELFWD:
  0687'   7C                    	MOV	A,H
  0688'   B5                    	ORA	L
  0689'   C8                    	RZ			; nothing to delete
  068A'   CD 0AD0'              	CALL	UNDDLF		; (appended) the span, for 'u', before it goes
  068D'   EB                    	XCHG			; DE = count
  068E'   2A 0000*              	LHLD	GAPEND
  0691'   19                    	DAD	D		; target = GAPEND + count
  0692'   AF                    	XRA	A		; S clear -> forward delete
  0693'   CD 0204'              	CALL	DELTO
  0696'   C9                    	RET
                                
                                ;DELPRV -- WM 3260 RUBOUT/DELL: delete the char left of the cursor, and the
                                ;CR too when that leaves one there (a CR,LF goes as one).  PEEKLX pages back
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


                                ;at the window start and returns at the start of the file.  WM's MARKCUR and
                                ;ROWUP (its screen) are left out; instead a deleted LF moves the cursor up a
                                ;line (LNDLT - 1) for SCRN.MAC.
  0697'                         DELPRV:				; WM 3260
  0697'   CD 01FD'              	CALL	PEEKLX
  069A'   FE 0A                 	CPI	LF
  069C'   C2 06A8'              	JNZ	DLP_GO
  069F'   E5                    	PUSH	H
  06A0'   2A 0000*              	LHLD	LNDLT
  06A3'   2B                    	DCX	H
  06A4'   22 0000*              	SHLD	LNDLT
  06A7'   E1                    	POP	H
  06A8'                         DLP_GO:				; WM 3263 DELL
  06A8'   CD 0AF0'              	CALL	UNDDLP		; (appended) that byte, for 'u', before it goes
  06AB'   CD 0064'              	CALL	SETGAPB
  06AE'   CD 01F0'              	CALL	PEEKL
  06B1'   FE 0D                 	CPI	CR
  06B3'   CA 0697'              	JZ	DELPRV
  06B6'   C9                    	RET
                                
                                
                                ;UNDELF -- APPENDED, NOT WordMaster: give back the byte last swallowed forward
                                ;into the gap.  A forward delete only moves GAPEND past the byte, so the byte
                                ;itself is still there, inside the gap: GAPEND-1 through DELTO makes it text
                                ;again, with the record marks updated exactly as a delete updates them.
                                ;Replace mode ('R') puts back with it what it overwrote, as vim's BS in Replace
                                ;mode does.  The caller must know the gap has not moved since the delete
                                ;(CMD.MAC keeps GAPEND in RPGE for that); nothing else calls this.
  06B7'                         UNDELF:
  06B7'   2A 0000*              	LHLD	GAPEND
  06BA'   2B                    	DCX	H
  06BB'   AF                    	XRA	A		; S clear -> the forward (GAPEND) side
  06BC'   CD 0204'              	CALL	DELTO
  06BF'   C3 0B03'              	JMP	UNDUDF		; (appended) the byte just made text again
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  APPENDED, NOT WordMaster: WM has no undo at all (its QBUFOP /
                                ; QEXEC macro is a command-LINE facility, not this).
                                ;
                                ; Six primitives change resident text, and each one says what it did: PUTGAP
                                ; (one byte in), QGET (the register in), DELFWD (a span out), DELPRV (one byte
                                ; out backward), UNDELF (one byte back in) and QPUTLN (whole lines out).
                                ; Nothing else in the editor reaches the text, so no command can forget to
                                ; record itself -- which is the whole reason the capture sits down here instead
                                ; of at CMD.MAC's edit sites.
                                ;
                                ; A record says only WHERE and HOW MUCH, in LOGICAL offsets, plus where its
                                ; bytes lie in the undo region.  Logical offsets survive the gap sliding (which
                                ; PUTCUR does on every cursor move) because the replay walks the records
                                ; BACKWARD: each step restores the offsets the steps after it were measured
                                ; against.  The bytes are kept for an insert as well as a delete -- an insert
                                ; costs its own text twice, which is nothing -- so the region is settled once
                                ; the command ends and 'u' can walk it either way: backward applying each
                                ; record's inverse to undo, forward applying the records as they stand to redo.
                                ; That is what makes 'u' undo 'u' with ONE region and no capture during the
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                                ; replay.
                                ;
                                ; The region is a region of the arena like the Q buffer, inserted between the
                                ; slider and the text, and it grows through the same MKGAP: the pointer row
                                ; reads (UBEG,UEND) as data and (TXTBAS,UBEG) / (UEND,TXTBEG) as the holes
                                ; around it, so NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN and INIBAS all take it in
                                ; their stride unchanged.
                                ;
                                ; DEVIATIONS from vim, all deliberate and all in COMMANDS.md: ONE level of
                                ; undo, so 'u' undoes 'u' as real vi does; the change must still be in the
                                ; RESIDENT window, and 'u' refuses once the pager has moved off it rather than
                                ; chasing it through the file; and a change with more steps than the table
                                ; holds, or one the arena has no spare room to keep, is not undoable at all.
                                ;
                                ; "Moved off it" is PGTOPM, PAGE.MAC's count of the times the pager moved
                                ; TXTBEG.  It is the window's TOP that matters: an offset is measured from
                                ; TXTBEG, so spilling a record out from under it (PAGEOUT) or reading one back
                                ; in (REWIND) shifts every offset, while FILLBUF and PAGEBOT growing TXTEND at
                                ; the bottom shift none.  The OUTREC/SRCREC water marks look like the same
                                ; thing and are not: UPDMARK raises them on every edit.
                                ;============================================================
                                
  0001                          UR_INS	EQU	1		; text went IN  (undoing takes it back out)
  0002                          UR_DEL	EQU	2		; text came OUT (undoing puts it back)
  0007                          URSIZE	EQU	7		; type, offset(2), length(2), region offset(2)
  0018                          URMAX	EQU	24		; primitive steps one change may hold
                                ;How much of the arena the capture refuses to eat into.  It only has to keep
                                ;MKGAP off its MKROOM path (which wants 256 free), because paging is what undo
                                ;must not do -- so this is deliberately SMALL.  RESVMEM, QROOM's reserve, is
                                ;far too big: a 66 K file leaves under 1700 bytes free, and undo would never
                                ;engage at all on exactly the files that need it most.
  0200                          UNDRSV	EQU	200H		; ... 512 bytes
                                ;How much room the region claims up front, and so the largest change that can
                                ;be kept.  The claim is what lets the capture run without EVER growing the
                                ;region: see UNDGRW for why growing where a primitive can see it is unsafe.
  0400                          UNDCAP	EQU	400H		; 1024 bytes of change
                                
                                ;UNDBEG -- CMD.MAC's command boundary: the NEXT captured change starts a new
                                ;undo.  A flag only, so a command that changes nothing -- a motion, a yank, a
                                ;key that is no command at all -- leaves the last change undoable, exactly as
                                ;'.' keeps the last change it recorded.
  06C2'                         UNDBEG:
  06C2'   D5                    	PUSH	D
  06C3'   E5                    	PUSH	H
  06C4'   3E 01                 	MVI	A,1
  06C6'   32 0B18'              	STA	UNDNEW
  06C9'   CD 05DB'              	CALL	CUROFF
  06CC'   22 0000*              	SHLD	UNDPCU		; where the cursor was as this command began --
  06CF'   CD 06DE'              	CALL	UNDGRW		;   kept pending, because only a command that
  06D2'   E1                    	POP	H		;   really changes text gets to claim it
  06D3'   D1                    	POP	D
  06D4'   C9                    	RET
                                
                                ;UNDHER -- the change about to start belongs at the CURSOR: 'u' puts it back
                                ;there.  UNDBEG's cursor snapshot without its claim on the region, for a
                                ;command (':s') that cannot know where its first change will be until it has
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


                                ;found it.  Calling UNDBEG again instead would re-run UNDGRW in the middle of
                                ;the command, which is the one thing UNDGRW must never do -- see below.
  06D5'                         UNDHER:
  06D5'   E5                    	PUSH	H
  06D6'   CD 05DB'              	CALL	CUROFF
  06D9'   22 0000*              	SHLD	UNDPCU
  06DC'   E1                    	POP	H
  06DD'   C9                    	RET
                                
                                ;UNDGRW -- make sure the region can take a whole change without growing again.
                                ;THE ONLY PLACE THE REGION GROWS, and it runs at the command boundary, where no
                                ;primitive is holding anything.  Growing moves regions about (MKGAP -> MOVGAP),
                                ;and that both invalidates a raw pointer a primitive is in the middle of using
                                ;-- DELPRV hands SETGAPB one -- and overwrites whatever is sitting in the gap,
                                ;which is where a forward-deleted byte waits for 'R's backspace to call UNDELF
                                ;and give it back.  So the room is claimed here, 256 bytes at a time, and the
                                ;capture below never calls MKGAP at all: it writes into the claim or gives up.
                                ;The room has to be claimed as the region's own CONTENT, not left as the hole
                                ;above it: the holes are shared, and the text takes whatever it can reach --
                                ;MOVGAP feeding an insert will walk straight through a hole reserved here, which
                                ;is what made a 200-character insert lose its undo halfway.  Once the bytes are
                                ;inside (UBEG,UEND) the text cannot have them: MOVGAP slides the region aside
                                ;instead.  Nothing here holds an address across MKGAP either, because MKGAP
                                ;slides this very region (HOLEUP moves UBEG and UEND) -- UEND is re-read from
                                ;its cell every time round.
  06DE'                         UNDGRW:
  06DE'   C5                    	PUSH	B
  06DF'   D5                    	PUSH	D
  06E0'   E5                    	PUSH	H
  06E1'                         UNDGRL:
  06E1'   21 0000*              	LXI	H,UBEG
  06E4'   CD 04A4'              	CALL	PRSPAN		; BC = the region's size
  06E7'   50                    	MOV	D,B
  06E8'   59                    	MOV	E,C
  06E9'   21 0400               	LXI	H,UNDCAP
  06EC'   CD 0576'              	CALL	CMP16		; CY iff it is smaller than one change
  06EF'   D2 05A3'              	JNC	POPRET
  06F2'   CD 0875'              	CALL	UNDRM		; ... but never at the cost of paging
  06F5'   DA 05A3'              	JC	POPRET
  06F8'   21 0000*              	LXI	H,UEND
  06FB'   CD 00B9'              	CALL	MKGAP		; 256 free above the region ...
  06FE'   2A 0000*              	LHLD	UEND
  0701'   11 0100               	LXI	D,100H
  0704'   19                    	DAD	D
  0705'   22 0000*              	SHLD	UEND		; ... taken into it, so the text cannot take
  0708'   C3 06E1'              	JMP	UNDGRL		;     them back
                                
                                ;UNDCLR -- nothing is undoable (a fresh buffer; BINIT calls it through INIGAP).
  070B'                         UNDCLR:
  070B'   AF                    	XRA	A
  070C'   32 0000*              	STA	UNDN
  070F'   32 0000*              	STA	UNDST
  0712'   32 0000*              	STA	UNDBAD
  0715'   3E 01                 	MVI	A,1
  0717'   32 0B18'              	STA	UNDNEW
  071A'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


                                
                                ;UNDRST -- the first capture of a new change: drop the last one and note where
                                ;the file window was, so 'u' can tell the pager has since moved off this change.
  071B'                         UNDRST:
  071B'   AF                    	XRA	A
  071C'   32 0B18'              	STA	UNDNEW
  071F'   32 0000*              	STA	UNDN
  0722'   32 0000*              	STA	UNDBAD
  0725'   21 0000               	LXI	H,0
  0728'   22 0000*              	SHLD	UNDPTR		; the region's content empties (its SIZE stays:
                                				;   that is the room UNDGRW claimed)
  072B'   2A 0000*              	LHLD	PGTOPM
  072E'   22 0000*              	SHLD	UNDPG
  0731'   2A 0000*              	LHLD	UNDPCU
  0734'   22 0000*              	SHLD	UNDCUR		; ... and this command does change text, so this
                                				;   is where 'u' will put the cursor back
  0737'   3E 01                 	MVI	A,1
  0739'   32 0000*              	STA	UNDST		; a change is on the buffer: 'u' undoes it
  073C'   C9                    	RET
                                
                                ;UNDCHG -- the capture every hooked primitive uses.  A = UR_INS / UR_DEL,
                                ;HL = the logical offset it acted at, BC = how many bytes.  The bytes are read
                                ;back out of the resident TEXT at that offset -- for a delete before they go,
                                ;for an insert once they have arrived -- so no caller hands over a pointer that
                                ;growing the region could leave stale.
  073D'                         UNDCHG:
  073D'   C5                    	PUSH	B
  073E'   D5                    	PUSH	D
  073F'   E5                    	PUSH	H
  0740'   32 0000*              	STA	UNDTY		; the record type, kept out of the registers
  0743'   CD 07BB'              	CALL	EDTGO		; whoever else follows an edit (BC is kept)
  0746'   3A 0000*              	LDA	UNDRPL
  0749'   B7                    	ORA	A
  074A'   C2 05A3'              	JNZ	POPRET		; 'u' replaying: its own edits are not a change
  074D'   3A 0B18'              	LDA	UNDNEW
  0750'   B7                    	ORA	A
  0751'   CA 0757'              	JZ	UNDC1
  0754'   CD 071B'              	CALL	UNDRST		; the first step of a new change
  0757'                         UNDC1:
  0757'   3A 0000*              	LDA	UNDBAD
  075A'   B7                    	ORA	A
  075B'   C2 05A3'              	JNZ	POPRET		; this change has already been given up on
  075E'   78                    	MOV	A,B
  075F'   B1                    	ORA	C
  0760'   CA 05A3'              	JZ	POPRET		; a zero-length step is no step
  0763'   60                    	MOV	H,B
  0764'   69                    	MOV	L,C
  0765'   22 0000*              	SHLD	UNDCL		; UNDAPT spends BC as its countdown, so the
                                				;   length has to be kept somewhere else
  0768'   3A 0000*              	LDA	UNDN
  076B'   FE 18                 	CPI	URMAX
  076D'   D2 07B3'              	JNC	UNDCBD		; no room for another step
                                	;--- where this step's bytes will land in the region ---
  0770'   2A 0000*              	LHLD	UNDPTR
  0773'   22 0000*              	SHLD	UNDBO
  0776'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  0777'   E5                    	PUSH	H		; HL = the logical offset again
  0778'   CD 082B'              	CALL	UNDAPT		; BC bytes of the text there -> the region
  077B'   DA 07B3'              	JC	UNDCBD
                                	;--- fold it into the last record when it only carries that one on ---
  077E'   E1                    	POP	H
  077F'   E5                    	PUSH	H
  0780'   CD 07D3'              	CALL	UNDEXT
  0783'   CA 05A3'              	JZ	POPRET
                                	;--- otherwise a record of its own ---
  0786'   3A 0000*              	LDA	UNDN
  0789'   CD 07C3'              	CALL	URADDR
  078C'   3A 0000*              	LDA	UNDTY
  078F'   77                    	MOV	M,A
  0790'   23                    	INX	H
  0791'   D1                    	POP	D
  0792'   D5                    	PUSH	D		; DE = the logical offset
  0793'   73                    	MOV	M,E
  0794'   23                    	INX	H
  0795'   72                    	MOV	M,D
  0796'   23                    	INX	H
  0797'   EB                    	XCHG			; DE = the record, past the offset
  0798'   2A 0000*              	LHLD	UNDCL
  079B'   EB                    	XCHG			; ... and HL back, with DE = the length
  079C'   73                    	MOV	M,E
  079D'   23                    	INX	H
  079E'   72                    	MOV	M,D
  079F'   23                    	INX	H
  07A0'   3A 0000*              	LDA	UNDBO
  07A3'   77                    	MOV	M,A
  07A4'   23                    	INX	H
  07A5'   3A 0001*              	LDA	UNDBO+1
  07A8'   77                    	MOV	M,A
  07A9'   3A 0000*              	LDA	UNDN
  07AC'   3C                    	INR	A
  07AD'   32 0000*              	STA	UNDN
  07B0'   C3 05A3'              	JMP	POPRET
  07B3'                         UNDCBD:
  07B3'   3E 01                 	MVI	A,1
  07B5'   32 0000*              	STA	UNDBAD		; too big to keep: not undoable at all
  07B8'   C3 05A3'              	JMP	POPRET
                                
                                ;EDTGO -- UNDCHG is the one place every change to the text goes by, the
                                ;replay's own included, so it is also where the editor hears of one: EDTHK is
                                ;called with A = UR_INS / UR_DEL, HL = the logical offset and BC = the length,
                                ;and must keep BC.  VI.MAC points it at the marks; a harness leaves it a RET.
  07BB'                         EDTGO:
  07BB'   E5                    	PUSH	H
  07BC'   2A 07C1'              	LHLD	EDTHK
  07BF'   E3                    	XTHL
  07C0'   C9                    	RET
  07C1'   05D8'                 EDTHK:	DW	ERMNUL
                                
                                ;URADDR -- A = a record index -> HL = its address (base + n*8 - n).
  07C3'                         URADDR:
  07C3'   6F                    	MOV	L,A
  07C4'   26 00                 	MVI	H,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  07C6'   5D                    	MOV	E,L
  07C7'   54                    	MOV	D,H
  07C8'   29                    	DAD	H
  07C9'   29                    	DAD	H
  07CA'   29                    	DAD	H		; HL = n*8
  07CB'   CD 0558'              	CALL	SUBHD		; HL = n*7
  07CE'   11 0000*              	LXI	D,UNDREC
  07D1'   19                    	DAD	D
  07D2'   C9                    	RET
                                
                                ;UNDEXT -- A = 0 (Z) when this step only carries the last record on: an insert
                                ;starting exactly where the last insert ended, which is what typing does.  Its
                                ;bytes already sit contiguously behind that record's, so only the length grows.
                                ;HL = this step's offset, BC = its length.
  07D3'                         UNDEXT:
  07D3'   C5                    	PUSH	B
  07D4'   D5                    	PUSH	D
  07D5'   E5                    	PUSH	H
  07D6'   3A 0000*              	LDA	UNDTY
  07D9'   FE 01                 	CPI	UR_INS
  07DB'   C2 0825'              	JNZ	UNDXNO		; only inserts fold
  07DE'   3A 0000*              	LDA	UNDN
  07E1'   B7                    	ORA	A
  07E2'   CA 0825'              	JZ	UNDXNO		; nothing to fold into
  07E5'   3D                    	DCR	A
  07E6'   CD 07C3'              	CALL	URADDR
  07E9'   22 0000*              	SHLD	UNDLSA
  07EC'   7E                    	MOV	A,M
  07ED'   FE 01                 	CPI	UR_INS
  07EF'   C2 0825'              	JNZ	UNDXNO
  07F2'   2A 0000*              	LHLD	UNDLSA
  07F5'   23                    	INX	H
  07F6'   CD 0571'              	CALL	LDHLI		; HL = the last record's offset
  07F9'   EB                    	XCHG
  07FA'   2A 0000*              	LHLD	UNDLSA
  07FD'   23                    	INX	H
  07FE'   23                    	INX	H
  07FF'   23                    	INX	H
  0800'   CD 0571'              	CALL	LDHLI		; HL = its length
  0803'   19                    	DAD	D		; HL = where it ends
  0804'   EB                    	XCHG
  0805'   E1                    	POP	H
  0806'   E5                    	PUSH	H		; HL = this step's offset
  0807'   CD 0576'              	CALL	CMP16		; Z iff this step starts exactly there
  080A'   C2 0825'              	JNZ	UNDXNO
  080D'   2A 0000*              	LHLD	UNDLSA
  0810'   23                    	INX	H
  0811'   23                    	INX	H
  0812'   23                    	INX	H
  0813'   E5                    	PUSH	H
  0814'   CD 0571'              	CALL	LDHLI		; HL = the last record's length
  0817'   EB                    	XCHG
  0818'   2A 0000*              	LHLD	UNDCL
  081B'   19                    	DAD	D		; ... grown by this step's
  081C'   EB                    	XCHG
  081D'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  081E'   73                    	MOV	M,E
  081F'   23                    	INX	H
  0820'   72                    	MOV	M,D
  0821'   AF                    	XRA	A		; Z: folded, no new record
  0822'   C3 05A3'              	JMP	POPRET
  0825'                         UNDXNO:
  0825'   3E 01                 	MVI	A,1
  0827'   B7                    	ORA	A		; NZ: it needs a record of its own
  0828'   C3 05A3'              	JMP	POPRET
                                
                                ;UNDAPT -- append BC bytes of resident text, from logical offset HL, to the
                                ;undo region.  One byte at a time, re-reading the offset through CHARAT and the
                                ;region through its pointer cell every time, so growing the region (which
                                ;slides regions about) can never leave this loop holding a stale address.
                                ;CY if it outgrows the claim, and the caller then gives the change up.
  082B'                         UNDAPT:
  082B'   78                    	MOV	A,B
  082C'   B1                    	ORA	C
  082D'   C8                    	RZ			; nothing to append
  082E'                         UNDAPL:
  082E'   C5                    	PUSH	B
  082F'   E5                    	PUSH	H
  0830'   CD 0616'              	CALL	CHARAT		; A = the text byte at this offset
  0833'   CD 0841'              	CALL	UNDAPB		; ... into the region
  0836'   E1                    	POP	H
  0837'   C1                    	POP	B
  0838'   D8                    	RC
  0839'   23                    	INX	H
  083A'   0B                    	DCX	B
  083B'   78                    	MOV	A,B
  083C'   B1                    	ORA	C
  083D'   C2 082E'              	JNZ	UNDAPL
  0840'   C9                    	RET
                                
                                ;UNDAPB -- put the byte in A into the room UNDGRW claimed.  It does NOT grow
                                ;the region -- see UNDGRW -- so CY, and the change given up on, once the room
                                ;is used up: a change bigger than the region is simply not undoable.
  0841'                         UNDAPB:
  0841'   C5                    	PUSH	B
  0842'   D5                    	PUSH	D
  0843'   E5                    	PUSH	H
  0844'   32 0000*              	STA	UNDB1
  0847'   21 0000*              	LXI	H,UBEG
  084A'   CD 04A4'              	CALL	PRSPAN		; BC = the region's size
  084D'   2A 0000*              	LHLD	UNDPTR
  0850'   EB                    	XCHG			; DE = where the next byte goes
  0851'   60                    	MOV	H,B
  0852'   69                    	MOV	L,C
  0853'   CD 0576'              	CALL	CMP16		; CY iff that is still inside the region
  0856'   D2 086C'              	JNC	UNDAPF
  0859'   2A 0000*              	LHLD	UBEG		; re-read: a relocation moves the region
  085C'   19                    	DAD	D
  085D'   3A 0000*              	LDA	UNDB1
  0860'   77                    	MOV	M,A
  0861'   2A 0000*              	LHLD	UNDPTR
  0864'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0865'   22 0000*              	SHLD	UNDPTR
  0868'   B7                    	ORA	A		; CY clear: it went in
  0869'   C3 05A3'              	JMP	POPRET
  086C'                         UNDAPF:
  086C'   3E 01                 	MVI	A,1
  086E'   32 0000*              	STA	UNDBAD
  0871'   37                    	STC
  0872'   C3 05A3'              	JMP	POPRET
                                
                                ;UNDRM -- CY, and the change given up on, unless the arena still holds UNDRSV
                                ;free.  The capture must never page: paging moves the window off the change and
                                ;would invalidate every logical offset the records hold.  Keeping this much
                                ;free also keeps MKGAP off its MKROOM path, so the capture cannot page even by
                                ;accident, and it fails QUIETLY where QROOM raises 'QBUF FULL' -- undo going
                                ;away must never stop the editing.
  0875'                         UNDRM:
  0875'   C5                    	PUSH	B
  0876'   D5                    	PUSH	D
  0877'   E5                    	PUSH	H
  0878'   CD 043E'              	CALL	BUFSUM		; DE = the arena's free bytes
  087B'   21 0200               	LXI	H,UNDRSV
  087E'   CD 0576'              	CALL	CMP16		; CY iff less than that is left
  0881'   D2 05A3'              	JNC	POPRET
  0884'   3E 01                 	MVI	A,1
  0886'   32 0000*              	STA	UNDBAD
  0889'   37                    	STC
  088A'   C3 05A3'              	JMP	POPRET
                                
                                ;---------------------------------------------------------------- the replay
                                
                                ;UNDO -- 'u'.  CY when there is nothing to undo: no change captured, a change
                                ;too big to have been captured, or the pager has moved the window off it.
  088D'                         UNDO:
  088D'   AF                    	XRA	A
  088E'   32 0000*              	STA	UNDWHY		; refused for want of a change, until told else
  0891'   3A 0000*              	LDA	UNDBAD		; asked BEFORE the count of records: a change
  0894'   B7                    	ORA	A		;   too big from its very first step leaves
  0895'   CA 089F'              	JZ	UND_OK		;   none, and is still not 'nothing to undo'
  0898'   3E 02                 	MVI	A,2
  089A'   32 0000*              	STA	UNDWHY		; too big to have been captured: CMD.MAC says
  089D'   37                    	STC			;   so, rather than ringing the bell at a user
  089E'   C9                    	RET			;   who has no way to know why
  089F'                         UND_OK:
  089F'   3A 0000*              	LDA	UNDN
  08A2'   B7                    	ORA	A
  08A3'   37                    	STC
  08A4'   C8                    	RZ			; nothing captured
  08A5'   2A 0000*              	LHLD	PGTOPM
  08A8'   EB                    	XCHG
  08A9'   2A 0000*              	LHLD	UNDPG
  08AC'   CD 0576'              	CALL	CMP16
  08AF'   C2 08E2'              	JNZ	UNDPGD		; the pager has moved the window's top since,
                                				;   so every offset the records hold has shifted
  08B2'   3E FF                 	MVI	A,0FFH
  08B4'   32 0000*              	STA	UNDML		; (no step taken yet)
  08B7'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  08B8'   32 0000*              	STA	UNDLK
  08BB'   32 0000*              	STA	UNDLC
  08BE'   3E 01                 	MVI	A,1
  08C0'   32 0000*              	STA	UNDRPL		; the replay's own edits are not a new change
  08C3'   3A 0000*              	LDA	UNDST
  08C6'   FE 01                 	CPI	1
  08C8'   CA 08E9'              	JZ	UNDREV
                                	;--- the last 'u' undid it: apply the records forward again (a redo) ---
  08CB'   AF                    	XRA	A
  08CC'   32 0000*              	STA	UNDDIR
  08CF'   AF                    	XRA	A
  08D0'                         UNDFWL:
  08D0'   CD 090A'              	CALL	URSTEP
  08D3'   3C                    	INR	A
  08D4'   47                    	MOV	B,A
  08D5'   3A 0000*              	LDA	UNDN
  08D8'   B8                    	CMP	B
  08D9'   78                    	MOV	A,B
  08DA'   C2 08D0'              	JNZ	UNDFWL
  08DD'   3E 01                 	MVI	A,1
  08DF'   C3 08FB'              	JMP	UNDFIN
  08E2'                         UNDPGD:
  08E2'   3E 01                 	MVI	A,1
  08E4'   32 0000*              	STA	UNDWHY		; the change is no longer in the window
  08E7'   37                    	STC
  08E8'   C9                    	RET
  08E9'                         UNDREV:
                                	;--- undo: the records backward, each one's inverse ---
  08E9'   3E 01                 	MVI	A,1
  08EB'   32 0000*              	STA	UNDDIR
  08EE'   3A 0000*              	LDA	UNDN
  08F1'                         UNDRVL:
  08F1'   3D                    	DCR	A
  08F2'   CD 090A'              	CALL	URSTEP
  08F5'   B7                    	ORA	A
  08F6'   C2 08F1'              	JNZ	UNDRVL
  08F9'   3E 02                 	MVI	A,2
  08FB'                         UNDFIN:
  08FB'   32 0000*              	STA	UNDST
  08FE'   AF                    	XRA	A
  08FF'   32 0000*              	STA	UNDRPL
                                	;--- the cursor goes back where the command that changed it began:
                                	;    measured from vim, which restores that and not the change's own
                                	;    offset (CMD.MAC's VC_UNDO holds it inside the line) ---
  0902'   2A 0000*              	LHLD	UNDCUR
  0905'   CD 062C'              	CALL	GOTO
  0908'   B7                    	ORA	A		; CY clear: it happened
  0909'   C9                    	RET
                                
                                ;URSTEP -- apply record A: as it stands when UNDDIR is 0 (a redo), inverted
                                ;when it is 1 (an undo).  An insert applied puts its saved bytes back at its
                                ;offset; an insert inverted deletes that many bytes there; a delete is the
                                ;mirror of both.  A is preserved -- UNDO's loops count with it.
  090A'                         URSTEP:
  090A'   F5                    	PUSH	PSW
  090B'   CD 07C3'              	CALL	URADDR
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  090E'   7E                    	MOV	A,M
  090F'   32 0000*              	STA	UNDTY
  0912'   23                    	INX	H
  0913'   7E                    	MOV	A,M
  0914'   32 0000*              	STA	UNDOF
  0917'   23                    	INX	H
  0918'   7E                    	MOV	A,M
  0919'   32 0001*              	STA	UNDOF+1
  091C'   23                    	INX	H
  091D'   7E                    	MOV	A,M
  091E'   32 0000*              	STA	UNDLN
  0921'   23                    	INX	H
  0922'   7E                    	MOV	A,M
  0923'   32 0001*              	STA	UNDLN+1
  0926'   23                    	INX	H
  0927'   7E                    	MOV	A,M
  0928'   32 0000*              	STA	UNDBO
  092B'   23                    	INX	H
  092C'   7E                    	MOV	A,M
  092D'   32 0001*              	STA	UNDBO+1
  0930'   2A 0000*              	LHLD	UNDBO		; a line end among its bytes: more than one
  0933'   EB                    	XCHG			;   line changes (UNDML: CMD.MAC picks the
  0934'   2A 0000*              	LHLD	UBEG		;   repaint by it)
  0937'   19                    	DAD	D
  0938'   EB                    	XCHG
  0939'   2A 0000*              	LHLD	UNDLN
  093C'   19                    	DAD	D
  093D'   CD 065C'              	CALL	LFCNT
  0940'   7A                    	MOV	A,D
  0941'   B3                    	ORA	E
  0942'   CA 094A'              	JZ	URS_1L
  0945'   3E 01                 	MVI	A,1
  0947'   32 0000*              	STA	UNDML
  094A'                         URS_1L:
  094A'   3A 0000*              	LDA	UNDTY
  094D'   47                    	MOV	B,A
  094E'   3A 0000*              	LDA	UNDDIR
  0951'   B7                    	ORA	A
  0952'   CA 095E'              	JZ	URS_AP
  0955'   78                    	MOV	A,B		; an undo inverts the record
  0956'   FE 01                 	CPI	UR_INS
  0958'   CA 0964'              	JZ	URS_DL
  095B'   C3 0974'              	JMP	URS_IN
  095E'                         URS_AP:
  095E'   78                    	MOV	A,B		; a redo applies it as it stands
  095F'   FE 01                 	CPI	UR_INS
  0961'   CA 0974'              	JZ	URS_IN
  0964'                         URS_DL:
                                	;--- take the record's length back out at its offset ---
  0964'   CD 09A6'              	CALL	URGOTO
  0967'   3E 02                 	MVI	A,2
  0969'   CD 09CC'              	CALL	URLNQ
  096C'   2A 0000*              	LHLD	UNDLN
  096F'   CD 0687'              	CALL	DELFWD
  0972'   F1                    	POP	PSW
  0973'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0974'                         URS_IN:
                                	;--- put the record's saved bytes back in at its offset ---
  0974'   CD 09A6'              	CALL	URGOTO
  0977'   3E 01                 	MVI	A,1
  0979'   CD 09CC'              	CALL	URLNQ
  097C'   2A 0000*              	LHLD	UNDLN
  097F'   44                    	MOV	B,H
  0980'   4D                    	MOV	C,L
  0981'   2A 0000*              	LHLD	UNDBO
  0984'                         URSILP:
  0984'   C5                    	PUSH	B
  0985'   E5                    	PUSH	H
  0986'   EB                    	XCHG			; DE = the byte's offset within the region
  0987'   2A 0000*              	LHLD	UBEG		; ... re-read every byte: inserting text can
  098A'   19                    	DAD	D		;     slide the region out from under it
  098B'   7E                    	MOV	A,M
  098C'   CD 0054'              	CALL	PUTGAP
  098F'   FE 0A                 	CPI	LF
  0991'   C2 099B'              	JNZ	URSILN
  0994'   2A 0000*              	LHLD	LNDLT		; a line end put back is the cursor crossing
  0997'   23                    	INX	H		;   one, and GOTO keeps LNDLT for every move the
  0998'   22 0000*              	SHLD	LNDLT		;   replay makes -- so the renderer needs no
  099B'                         URSILN:				;   whole-window rescan to find that out
  099B'   E1                    	POP	H
  099C'   C1                    	POP	B
  099D'   23                    	INX	H
  099E'   0B                    	DCX	B
  099F'   78                    	MOV	A,B
  09A0'   B1                    	ORA	C
  09A1'   C2 0984'              	JNZ	URSILP
  09A4'   F1                    	POP	PSW
  09A5'   C9                    	RET
                                
                                ;URGOTO -- the cursor to the record's offset.  The line the first step is on
                                ;is the change's (UNDL0 = LNDLT there, which GOTO keeps up); a later step on
                                ;another line makes the change more than one line's (UNDML).
  09A6'                         URGOTO:
  09A6'   2A 0000*              	LHLD	UNDOF
  09A9'   CD 062C'              	CALL	GOTO
  09AC'   2A 0000*              	LHLD	LNDLT
  09AF'   EB                    	XCHG
  09B0'   3A 0000*              	LDA	UNDML
  09B3'   3C                    	INR	A
  09B4'   C2 09BF'              	JNZ	URG_1
  09B7'   32 0000*              	STA	UNDML		; (0: one line, so far)
  09BA'   EB                    	XCHG
  09BB'   22 0000*              	SHLD	UNDL0
  09BE'   C9                    	RET
  09BF'                         URG_1:
  09BF'   2A 0000*              	LHLD	UNDL0
  09C2'   CD 0576'              	CALL	CMP16
  09C5'   C8                    	RZ
  09C6'   3E 01                 	MVI	A,1
  09C8'   32 0000*              	STA	UNDML
  09CB'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


                                ;URLNQ -- the step about to be taken at the cursor puts the record's bytes in
                                ;(A = 1) or takes them out (A = 2).  UNDLK stays that for as long as every
                                ;step does the same, with whole lines -- it starts at a line's start and the
                                ;bytes end in a line end -- and at the place the first one did (UNDLL0 =
                                ;LNDLT there); UNDLC counts the lines.  Anything else and UNDLK is 0FFH.
                                ;Two more ways of taking a whole line out are known for what they are: steps
                                ;at one line's start that end with a line only when the last has gone (UNDLK
                                ;is 3 until then), and one step from a line's END that takes its line end and
                                ;the next line's text -- the line under it, so UNDLL0 is that line's.
                                ;CMD.MAC opens the rows for lines put back, or closes them up, by these.
  09CC'                         URLNQ:
  09CC'   47                    	MOV	B,A
  09CD'   3A 0000*              	LDA	UNDLK
  09D0'   B7                    	ORA	A
  09D1'   CA 09EE'              	JZ	URL_1
  09D4'   F6 01                 	ORI	1		; (2 and 3 are both lines going)
  09D6'   4F                    	MOV	C,A
  09D7'   78                    	MOV	A,B
  09D8'   F6 01                 	ORI	1
  09DA'   B9                    	CMP	C
  09DB'   C2 0A9E'              	JNZ	URL_NO
  09DE'   2A 0000*              	LHLD	UNDLL0
  09E1'   EB                    	XCHG
  09E2'   2A 0000*              	LHLD	LNDLT
  09E5'   CD 0576'              	CALL	CMP16
  09E8'   C2 0A9E'              	JNZ	URL_NO
  09EB'   C3 09F4'              	JMP	URL_2
  09EE'                         URL_1:
  09EE'   2A 0000*              	LHLD	LNDLT
  09F1'   22 0000*              	SHLD	UNDLL0
  09F4'                         URL_2:
  09F4'   CD 05DB'              	CALL	CUROFF
  09F7'   7C                    	MOV	A,H
  09F8'   B5                    	ORA	L
  09F9'   CA 0A4D'              	JZ	URL_3
  09FC'   2A 0000*              	LHLD	GAPBEG
  09FF'   2B                    	DCX	H
  0A00'   7E                    	MOV	A,M
  0A01'   FE 0A                 	CPI	LF
  0A03'   CA 0A4D'              	JZ	URL_3
                                	;--- not at a line's start.  One step that takes out a line end and
                                	;    what follows it as far as the next ('o' and what was typed) is
                                	;    the line under that one going, all the same: UNDLL0 as for it ---
  0A06'   78                    	MOV	A,B
  0A07'   FE 02                 	CPI	2
  0A09'   C2 0A9E'              	JNZ	URL_NO
  0A0C'   3A 0000*              	LDA	UNDLK
  0A0F'   B7                    	ORA	A
  0A10'   C2 0A9E'              	JNZ	URL_NO
  0A13'   2A 0000*              	LHLD	UNDBO
  0A16'   EB                    	XCHG
  0A17'   2A 0000*              	LHLD	UBEG
  0A1A'   19                    	DAD	D
  0A1B'   7E                    	MOV	A,M
  0A1C'   FE 0D                 	CPI	CR
  0A1E'   CA 0A26'              	JZ	URL_B0
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0A21'   FE 0A                 	CPI	LF
  0A23'   C2 0A9E'              	JNZ	URL_NO
  0A26'                         URL_B0:
  0A26'   2A 0000*              	LHLD	UNDLN
  0A29'   EB                    	XCHG
  0A2A'   2A 0000*              	LHLD	GAPEND
  0A2D'   19                    	DAD	D
  0A2E'   EB                    	XCHG			; DE = the text after what goes
  0A2F'   2A 0000*              	LHLD	TXTEND
  0A32'   CD 0576'              	CALL	CMP16
  0A35'   D2 0A43'              	JNC	URL_B1		; (the end of the text)
  0A38'   1A                    	LDAX	D
  0A39'   FE 0D                 	CPI	CR
  0A3B'   CA 0A43'              	JZ	URL_B1
  0A3E'   FE 0A                 	CPI	LF
  0A40'   C2 0A9E'              	JNZ	URL_NO
  0A43'                         URL_B1:
  0A43'   2A 0000*              	LHLD	UNDLL0
  0A46'   23                    	INX	H
  0A47'   22 0000*              	SHLD	UNDLL0
  0A4A'   C3 0A6D'              	JMP	URL_4
  0A4D'                         URL_3:
  0A4D'   2A 0000*              	LHLD	UNDLN
  0A50'   7C                    	MOV	A,H
  0A51'   B5                    	ORA	L
  0A52'   CA 0A9E'              	JZ	URL_NO
  0A55'   EB                    	XCHG
  0A56'   2A 0000*              	LHLD	UNDBO
  0A59'   19                    	DAD	D
  0A5A'   EB                    	XCHG
  0A5B'   2A 0000*              	LHLD	UBEG
  0A5E'   19                    	DAD	D		; HL = past the record's bytes
  0A5F'   2B                    	DCX	H
  0A60'   7E                    	MOV	A,M
  0A61'   FE 0A                 	CPI	LF
  0A63'   CA 0A6D'              	JZ	URL_4
  0A66'   78                    	MOV	A,B		; steps that take text out at one place take
  0A67'   FE 02                 	CPI	2		;   what is there each time, so it is the last
  0A69'   C2 0A9E'              	JNZ	URL_NO		;   of them that has to end with a line: 3
  0A6C'   04                    	INR	B		;   until it does ('O': the text typed goes,
  0A6D'                         URL_4:				;   then the line end before it)
  0A6D'   2A 0000*              	LHLD	UNDLN
  0A70'   EB                    	XCHG
  0A71'   2A 0000*              	LHLD	UNDBO
  0A74'   19                    	DAD	D
  0A75'   EB                    	XCHG
  0A76'   2A 0000*              	LHLD	UBEG
  0A79'   19                    	DAD	D
  0A7A'   E5                    	PUSH	H
  0A7B'   2A 0000*              	LHLD	UNDBO
  0A7E'   EB                    	XCHG
  0A7F'   2A 0000*              	LHLD	UBEG
  0A82'   19                    	DAD	D
  0A83'   EB                    	XCHG			; DE = their start
  0A84'   E1                    	POP	H
  0A85'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0A86'   CD 065C'              	CALL	LFCNT
  0A89'   C1                    	POP	B
  0A8A'   7A                    	MOV	A,D
  0A8B'   B7                    	ORA	A
  0A8C'   C2 0A9E'              	JNZ	URL_NO
  0A8F'   3A 0000*              	LDA	UNDLC
  0A92'   83                    	ADD	E
  0A93'   DA 0A9E'              	JC	URL_NO
  0A96'   32 0000*              	STA	UNDLC
  0A99'   78                    	MOV	A,B
  0A9A'   32 0000*              	STA	UNDLK
  0A9D'   C9                    	RET
  0A9E'                         URL_NO:
  0A9E'   3E FF                 	MVI	A,0FFH
  0AA0'   32 0000*              	STA	UNDLK
  0AA3'   C9                    	RET
                                
                                ;---------------------------------------------------------------- the hooks
                                
                                ;UNDPUT -- PUTGAP's tail: the one byte now sitting just below the cursor.
  0AA4'                         UNDPUT:
  0AA4'   F5                    	PUSH	PSW
  0AA5'   C5                    	PUSH	B
  0AA6'   D5                    	PUSH	D
  0AA7'   E5                    	PUSH	H
  0AA8'   CD 05DB'              	CALL	CUROFF
  0AAB'   2B                    	DCX	H
  0AAC'   01 0001               	LXI	B,1
  0AAF'   3E 01                 	MVI	A,UR_INS
  0AB1'   CD 073D'              	CALL	UNDCHG
  0AB4'   C3 0B12'              	JMP	UNDHX
                                
                                ;UNDGET -- QGET's tail: BC bytes of register now in, the cursor past them.
                                ;UNDINS is the same entry by its general name: INSBLK itself carries NO hook
                                ;(insert mode records a byte at a time through PUTGAP), so a command that
                                ;splices a block in -- ':s' replacing a match -- has to say so itself, exactly
                                ;as QGET does.  Without it 'u' puts the deleted text back and leaves the
                                ;inserted text there ('a-a-a' undid to 'aZ-aZ-aZ').
  0AB7'                         UNDINS:
  0AB7'                         UNDGET:
  0AB7'   F5                    	PUSH	PSW
  0AB8'   C5                    	PUSH	B
  0AB9'   D5                    	PUSH	D
  0ABA'   E5                    	PUSH	H
  0ABB'   78                    	MOV	A,B
  0ABC'   B1                    	ORA	C
  0ABD'   CA 0B12'              	JZ	UNDHX
  0AC0'   CD 05DB'              	CALL	CUROFF
  0AC3'   50                    	MOV	D,B
  0AC4'   59                    	MOV	E,C
  0AC5'   CD 0558'              	CALL	SUBHD		; HL = where the put began
  0AC8'   3E 01                 	MVI	A,UR_INS
  0ACA'   CD 073D'              	CALL	UNDCHG
  0ACD'   C3 0B12'              	JMP	UNDHX
                                
                                ;UNDDLF -- DELFWD's head: HL bytes about to go forward from the cursor.
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0AD0'                         UNDDLF:
  0AD0'   F5                    	PUSH	PSW
  0AD1'   C5                    	PUSH	B
  0AD2'   D5                    	PUSH	D
  0AD3'   E5                    	PUSH	H
  0AD4'   44                    	MOV	B,H
  0AD5'   4D                    	MOV	C,L
  0AD6'   CD 05DB'              	CALL	CUROFF
  0AD9'   3E 02                 	MVI	A,UR_DEL
  0ADB'   CD 073D'              	CALL	UNDCHG
  0ADE'   C3 0B12'              	JMP	UNDHX
                                
                                ;UNDDLQ -- QPUTLN's head: BC bytes of whole lines about to go into the register.
  0AE1'                         UNDDLQ:
  0AE1'   F5                    	PUSH	PSW
  0AE2'   C5                    	PUSH	B
  0AE3'   D5                    	PUSH	D
  0AE4'   E5                    	PUSH	H
  0AE5'   CD 05DB'              	CALL	CUROFF
  0AE8'   3E 02                 	MVI	A,UR_DEL
  0AEA'   CD 073D'              	CALL	UNDCHG
  0AED'   C3 0B12'              	JMP	UNDHX
                                
                                ;UNDDLP -- DELPRV's head: the one byte just below the cursor, about to go.
  0AF0'                         UNDDLP:
  0AF0'   F5                    	PUSH	PSW
  0AF1'   C5                    	PUSH	B
  0AF2'   D5                    	PUSH	D
  0AF3'   E5                    	PUSH	H
  0AF4'   CD 05DB'              	CALL	CUROFF
  0AF7'   2B                    	DCX	H
  0AF8'   01 0001               	LXI	B,1
  0AFB'   3E 02                 	MVI	A,UR_DEL
  0AFD'   CD 073D'              	CALL	UNDCHG
  0B00'   C3 0B12'              	JMP	UNDHX
                                
                                ;UNDUDF -- UNDELF's tail: the byte DELTO just made text again, at the cursor.
  0B03'                         UNDUDF:
  0B03'   F5                    	PUSH	PSW
  0B04'   C5                    	PUSH	B
  0B05'   D5                    	PUSH	D
  0B06'   E5                    	PUSH	H
  0B07'   CD 05DB'              	CALL	CUROFF
  0B0A'   01 0001               	LXI	B,1
  0B0D'   3E 01                 	MVI	A,UR_INS
  0B0F'   CD 073D'              	CALL	UNDCHG
                                ;UNDHX -- every hook leaves the primitive's own registers and flags alone.
  0B12'                         UNDHX:
  0B12'   E1                    	POP	H
  0B13'   D1                    	POP	D
  0B14'   C1                    	POP	B
  0B15'   F1                    	POP	PSW
  0B16'   C9                    	RET
                                
                                ;============================================================
                                ; DATA -- what the image carries: the cells that start at something.
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


                                ;============================================================
                                ;The cells that start at zero are not in the image: RSV.MAC names them, in
                                ;the RAM just above it, and BUF.MAC's ZINIT clears them before anything runs.
                                ;Their order there is the order they had here, and code depends on it.
                                ;WM's (base,limit) pointer row, the search pattern and 'u''s state are there.
                                	EXTRN	BUFBEG, QBEG, QEND, HOLEQP, TXTBAS, UBEG
                                	EXTRN	UEND, TXTBEG, GAPBEG, GAPEND, TXTEND, PRTERM
                                	EXTRN	BUFEND, MVGTOP, ERRFLG, SRCHBF, SRCHST, L2756
                                	EXTRN	QCPDON, UNDN, UNDST, UNDBAD, UNDRPL, UNDDIR
                                	EXTRN	UNDWHY, UNDTY, UNDOF, UNDLN, UNDBO, UNDCL
                                	EXTRN	UNDLSA, UNDPG, UNDPTR, UNDB1, UNDPCU, UNDCUR
                                	EXTRN	UNDLK, UNDLC, UNDLL0, UNDML, UNDL0, LNDLT
                                
  0B17'   1E                    SRCMAX: DB	SRMAX		; SRCHST's capacity, so CMD.MAC cannot drift
  0B18'   01                    UNDNEW: DB	1		; 'u': 1 = the next capture starts a new change
                                
                                ;PBEGMEM -- base of the text arena: the first RAM byte past everything the
                                ;program holds.  The gap buffer's text lives from here up to BUFEND.  BUF
                                ;links last but RSV.MAC links after it, holding the reserve block in the RAM
                                ;immediately above the image (it emits no bytes of its own), so the arena
                                ;starts at RSVTOP -- past the reserves -- and is the size it always was.
  0B19'   0000*                 PBEGMEM:DW	RSVTOP
                                
  0B1B'                         MEMBAS:				; top of the linked image (RSV.MAC's base)
                                
                                	END
