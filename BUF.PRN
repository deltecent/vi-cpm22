  0532'   F6 17                 	ORI	17H
  0534'   3C                    	INR	A
  0535'   C0                    	RNZ
  0536'   CD 05B3'              	CALL	ERRMSG
  0539'   43 4F 50 59           	DB	'COPY ERR',0H
  053D'   20 45 52 52           
  0541'   00                    
                                
                                ;NEGHL -- WM 5258: HL := -HL.
  0542'                         NEGHL:				; WM 5258
  0542'   F5                    	PUSH	PSW
  0543'   AF                    	XRA	A
  0544'   95                    	SUB	L
  0545'   6F                    	MOV	L,A
  0546'   3E 00                 	MVI	A,0H
  0548'   9C                    	SBB	H
  0549'   67                    	MOV	H,A
  054A'   F1                    	POP	PSW
  054B'   C9                    	RET
                                
                                ;NEGBC -- WM 5270: BC := -BC.
  054C'                         NEGBC:				; WM 5270
  054C'   F5                    	PUSH	PSW
  054D'   AF                    	XRA	A
  054E'   91                    	SUB	C
  054F'   4F                    	MOV	C,A
  0550'   3E 00                 	MVI	A,0H
  0552'   98                    	SBB	B
