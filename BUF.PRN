                                ;============================================================
                                ; AFTER-CURSOR READ -- WM.ASM 3989-4048 (RGET0, RGET, AFTOFF, RECOUNT), verbatim.
                                ; RPEEK/RPEEKX (WM 3995-4006) are not used and are left out.  WM's CALL GETKEY
                                ; in RGET is KBPOLL here (KEY.MAC owns the ring), as in GOLINE.
                                ;============================================================
                                
                                ;RGET0 -- WM 3989: HL = GAPEND, BC = bytes from there to TXTEND.
  04B2'                         RGET0:				; WM 3989
  04B2'   CD 04A4'              	CALL	AFTLEN
  04B5'   CD 0574'              	CALL	LDHLI
  04B8'   C9                    	RET
                                
                                ;RGET -- WM 4007: next char [HL++], BC--; when BC runs out, NEEDIN pages more
                                ;input in and BC is recounted.  CY at the end of the text.
  04B9'                         RGET:				; WM 4007
  04B9'   78                    	MOV	A,B
  04BA'   B1                    	ORA	C
  04BB'   C2 04CF'              	JNZ	RGETCH
  04BE'   CD 04D3'              	CALL	AFTOFF
  04C1'   E5                    	PUSH	H
  04C2'   CD 0000*              	CALL	NEEDIN
  04C5'   E1                    	POP	H
  04C6'   F5                    	PUSH	PSW
  04C7'   CD 0000*              	CALL	KBPOLL		; WM: CALL GETKEY
  04CA'   CD 04DD'              	CALL	RECOUNT
  04CD'   F1                    	POP	PSW
  04CE'   D8                    	RC
  04CF'                         RGETCH:				 ; WM 4021 -- return the next after-cursor char
  04CF'   7E                    	MOV	A,M
  04D0'   0B                    	DCX	B
  04D1'   23                    	INX	H
  04D2'   C9                    	RET
                                
                                ;AFTOFF -- WM 4028: HL = HL - GAPEND (survives the refill moving the text).
  04D3'                         AFTOFF:				; WM 4028
  04D3'   D5                    	PUSH	D
  04D4'   EB                    	XCHG
  04D5'   2A 0000*              	LHLD	GAPEND
  04D8'   CD 055A'              	CALL	SUBDH
  04DB'   D1                    	POP	D
  04DC'   C9                    	RET
                                
                                ;RECOUNT -- WM 4037: HL = GAPEND + offset, BC = bytes left after a refill.
  04DD'                         RECOUNT:			; WM 4037
