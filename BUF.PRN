  03ED'   B7                    	ORA	A
  03EE'   C3 05A2'              	JMP	POPRET
                                
                                ;PUTHOLE -- WM 5031: move the gap so it begins at address DE.
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  03F1'                         PUTHOLE:			; WM 5031
