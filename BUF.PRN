  0387'   05                    	DCR	B
  0388'   0D                    	DCR	C
  0389'   E5                    	PUSH	H
  038A'                         MATCFL:				; WM 2102 -- the rest of the pattern
  038A'   13                    	INX	D
  038B'   1A                    	LDAX	D
  038C'   B7                    	ORA	A
  038D'   CA 03A2'              	JZ	MATCFY
  0390'   BE                    	CMP	M
  0391'   23                    	INX	H
  0392'   CA 038A'              	JZ	MATCFL
  0395'   2B                    	DCX	H
  0396'   CD 0307'              	CALL	WCMATCH
  0399'   23                    	INX	H
  039A'   CA 038A'              	JZ	MATCFL
  039D'   E1                    	POP	H		; that candidate failed: SCANF went one past
  039E'   D1                    	POP	D		;   it, so the retry cannot sit still
  039F'   C3 037D'              	JMP	MATCHF
  03A2'                         MATCFY:				; WM 2116 -- matched: drop the saved pointer
  03A2'   D1                    	POP	D
  03A3'                         MATCHX:				; WM 2118 -- restore DE and return
  03A3'   D1                    	POP	D
  03A4'   C9                    	RET
                                
                                ;MATCHB -- WM 2124: the same, backward.  Unlike MATCHF this one returns HL
                                ;ON the match's FIRST character.  A match is only found while it lies wholly
                                ;inside the span, so one straddling the cursor is not seen (see CMD.MAC).
  03A5'                         MATCHB:				; WM 2124
  03A5'   1A                    	LDAX	D
  03A6'   B7                    	ORA	A
  03A7'   C8                    	RZ
  03A8'   23                    	INX	H
  03A9'                         MATCBS:				; WM 2128 -- back to the next candidate
  03A9'   D5                    	PUSH	D
  03AA'   1A                    	LDAX	D
  03AB'   CD 02F2'              	CALL	SCANB
  03AE'   DA 03A3'              	JC	MATCHX
  03B1'   05                    	DCR	B
  03B2'   0D                    	DCR	C
  03B3'   E5                    	PUSH	H
