  03D2'   23                    	INX	H
  03D3'   E5                    	PUSH	H
  03D4'   CD 0570'              	CALL	LDHLI
  03D7'   CD 0560'              	CALL	SPANBC
  03DA'   E3                    	XTHL
  03DB'   23                    	INX	H
  03DC'   23                    	INX	H
  03DD'   5E                    	MOV	E,M
  03DE'   23                    	INX	H
  03DF'   56                    	MOV	D,M
  03E0'   E3                    	XTHL
  03E1'   CD 050C'              	CALL	MCPYR
  03E4'   E3                    	XTHL
  03E5'   72                    	MOV	M,D
  03E6'   2B                    	DCX	H
  03E7'   73                    	MOV	M,E
  03E8'   D1                    	POP	D
  03E9'   2B                    	DCX	H
  03EA'   72                    	MOV	M,D
