  03E7'   23                    	INX	H
  03E8'   23                    	INX	H
  03E9'   E5                    	PUSH	H
  03EA'   CD 05FC'              	CALL	LDHLI
  03ED'   CD 05EC'              	CALL	SPANBC
  03F0'   E3                    	XTHL
  03F1'   23                    	INX	H
