                                ;AFTLEN -- WM 5164: BC := after-cursor text length (GAPEND..TXTEND).
  04A0'                         AFTLEN:				; WM 5164
  04A0'   21 09E8'              	LXI	H,GAPEND
                                ;PRSPAN -- WM 5168: BC := span (limit-base) of the pointer pair at HL.
  04A3'                         PRSPAN:				; WM 5168
  04A3'   D5                    	PUSH	D
  04A4'   E5                    	PUSH	H
  04A5'   CD 056C'              	CALL	LDPAIR
  04A8'   CD 0560'              	CALL	SPANBC
  04AB'   E1                    	POP	H
  04AC'   D1                    	POP	D
  04AD'   C9                    	RET
                                
                                ;============================================================
                                ; AFTER-CURSOR READ -- WM.ASM 3989-4048 (RGET0, RGET, AFTOFF, RECOUNT), verbatim.
                                ; RPEEK/RPEEKX (WM 3995-4006) are not used and are left out.  WM's CALL GETKEY
                                ; in RGET is KBPOLL here (KEY.MAC owns the ring), as in GOLINE.
                                ;============================================================
                                
                                ;RGET0 -- WM 3989: HL = GAPEND, BC = bytes from there to TXTEND.
  04AE'                         RGET0:				; WM 3989
  04AE'   CD 04A0'              	CALL	AFTLEN
  04B1'   CD 0570'              	CALL	LDHLI
  04B4'   C9                    	RET
                                
                                ;RGET -- WM 4007: next char [HL++], BC--; when BC runs out, NEEDIN pages more
                                ;input in and BC is recounted.  CY at the end of the text.
  04B5'                         RGET:				; WM 4007
  04B5'   78                    	MOV	A,B
  04B6'   B1                    	ORA	C
  04B7'   C2 04CB'              	JNZ	RGETCH
  04BA'   CD 04CF'              	CALL	AFTOFF
  04BD'   E5                    	PUSH	H
  04BE'   CD 0000*              	CALL	NEEDIN
  04C1'   E1                    	POP	H
  04C2'   F5                    	PUSH	PSW
  04C3'   CD 0000*              	CALL	KBPOLL		; WM: CALL GETKEY
  04C6'   CD 04D9'              	CALL	RECOUNT
  04C9'   F1                    	POP	PSW
  04CA'   D8                    	RC
  04CB'                         RGETCH:				 ; WM 4021 -- return the next after-cursor char
  04CB'   7E                    	MOV	A,M
  04CC'   0B                    	DCX	B
  04CD'   23                    	INX	H
  04CE'   C9                    	RET
                                
                                ;AFTOFF -- WM 4028: HL = HL - GAPEND (survives the refill moving the text).
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04CF'                         AFTOFF:				; WM 4028
  04CF'   D5                    	PUSH	D
  04D0'   EB                    	XCHG
  04D1'   2A 09E8'              	LHLD	GAPEND
  04D4'   CD 0556'              	CALL	SUBDH
  04D7'   D1                    	POP	D
  04D8'   C9                    	RET
                                
                                ;RECOUNT -- WM 4037: HL = GAPEND + offset, BC = bytes left after a refill.
  04D9'                         RECOUNT:			; WM 4037
  04D9'   D5                    	PUSH	D
  04DA'   EB                    	XCHG
  04DB'   CD 04A0'              	CALL	AFTLEN
  04DE'   CD 0570'              	CALL	LDHLI
  04E1'   19                    	DAD	D
  04E2'   79                    	MOV	A,C
  04E3'   93                    	SUB	E
  04E4'   4F                    	MOV	C,A
  04E5'   78                    	MOV	A,B
  04E6'   9A                    	SBB	D
  04E7'   47                    	MOV	B,A
  04E8'   D1                    	POP	D
  04E9'   C9                    	RET
                                
                                ;============================================================
                                ; 16-BIT HELPER LIBRARY -- WM.ASM 5186-5391
