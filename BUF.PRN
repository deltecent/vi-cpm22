  058E'   7E                    	MOV	A,M
  058F'   12                    	STAX	D
  0590'   2B                    	DCX	H
  0591'   1B                    	DCX	D
  0592'   7E                    	MOV	A,M
  0593'   12                    	STAX	D
  0594'   2B                    	DCX	H
  0595'   1B                    	DCX	D
  0596'   7E                    	MOV	A,M
  0597'   12                    	STAX	D
  0598'   2B                    	DCX	H
  0599'   1B                    	DCX	D
  059A'   7E                    	MOV	A,M
  059B'   12                    	STAX	D
  059C'   2B                    	DCX	H
  059D'   1B                    	DCX	D
  059E'   7E                    	MOV	A,M
  059F'   12                    	STAX	D
  05A0'                         MCPRCT:
  05A0'   0D                    	DCR	C
  05A1'   C2 0580'              	JNZ	MCPRBO
  05A4'   05                    	DCR	B
  05A5'   C2 057D'              	JNZ	MCPRKB
  05A8'   C9                    	RET
                                
                                ;BCDIV8 -- DEVIATION 4: BC := BC / 8, for a BC whose low three bits are 0;
                                ; Z if that is 0.  Each byte is rotated right three times: C's low bits are
                                ; 0, so it is exact; B's go to its top, and from there to the top of C.
  05A9'                         BCDIV8:
  05A9'   79                    	MOV	A,C
  05AA'   0F                    	RRC
  05AB'   0F                    	RRC
  05AC'   0F                    	RRC
  05AD'   4F                    	MOV	C,A
  05AE'   78                    	MOV	A,B
  05AF'   0F                    	RRC
  05B0'   0F                    	RRC
  05B1'   0F                    	RRC
  05B2'   47                    	MOV	B,A
  05B3'   E6 E0                 	ANI	0E0H
  05B5'   B1                    	ORA	C
  05B6'   4F                    	MOV	C,A
  05B7'   78                    	MOV	A,B
  05B8'   E6 1F                 	ANI	1FH
  05BA'   47                    	MOV	B,A
  05BB'   B1                    	ORA	C
  05BC'   C9                    	RET
                                
                                ;CKCOPY -- WM 5249: copy-length sanity guard ('COPY ERR').
  05BD'                         CKCOPY:				; WM 5249
  05BD'   78                    	MOV	A,B
  05BE'   F6 17                 	ORI	17H
  05C0'   3C                    	INR	A
  05C1'   C0                    	RNZ
  05C2'   CD 063F'              	CALL	ERRMSG
  05C5'   43 4F 50 59           	DB	'COPY ERR',0H
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  05C9'   20 45 52 52           
  05CD'   00                    
                                
                                ;NEGHL -- WM 5258: HL := -HL.
  05CE'                         NEGHL:				; WM 5258
  05CE'   F5                    	PUSH	PSW
  05CF'   AF                    	XRA	A
  05D0'   95                    	SUB	L
  05D1'   6F                    	MOV	L,A
  05D2'   3E 00                 	MVI	A,0H
  05D4'   9C                    	SBB	H
  05D5'   67                    	MOV	H,A
  05D6'   F1                    	POP	PSW
  05D7'   C9                    	RET
                                
                                ;NEGBC -- WM 5270: BC := -BC.
  05D8'                         NEGBC:				; WM 5270
  05D8'   F5                    	PUSH	PSW
  05D9'   AF                    	XRA	A
  05DA'   91                    	SUB	C
  05DB'   4F                    	MOV	C,A
  05DC'   3E 00                 	MVI	A,0H
  05DE'   98                    	SBB	B
  05DF'   47                    	MOV	B,A
  05E0'   F1                    	POP	PSW
  05E1'   C9                    	RET
                                
                                ;SUBDH -- WM 5282: HL := DE - HL.  SUBHD -- WM 5286: HL := HL - DE.
  05E2'                         SUBDH:				; WM 5282
  05E2'   EB                    	XCHG
  05E3'                         SUBHD:				; WM 5286
  05E3'   D5                    	PUSH	D
  05E4'   EB                    	XCHG
  05E5'   CD 05CE'              	CALL	NEGHL
  05E8'   EB                    	XCHG
  05E9'   19                    	DAD	D
  05EA'   D1                    	POP	D
  05EB'   C9                    	RET
                                
                                ;SPANBC -- WM 5296: BC := HL - DE (HL kept; Z if zero).
  05EC'                         SPANBC:				; WM 5296
  05EC'   E5                    	PUSH	H
  05ED'   CD 05E3'              	CALL	SUBHD
  05F0'   44                    	MOV	B,H
  05F1'   4D                    	MOV	C,L
  05F2'   E1                    	POP	H
  05F3'   78                    	MOV	A,B
  05F4'   B1                    	ORA	C
  05F5'   C9                    	RET
                                
                                ;LDPAI2/LDPAIR -- WM 5307/5312: load a (base,limit) pair into DE,HL.
                                ;NOTE: LDPAIR falls through into LDHLI (no RET) -- DE := base, HL := limit.
  05F6'                         LDPAI2:			       ; WM 5307
  05F6'   2B                    	DCX	H
  05F7'   2B                    	DCX	H
  05F8'                         LDPAIR:				; WM 5312
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  05F8'   5E                    	MOV	E,M
  05F9'   23                    	INX	H
  05FA'   56                    	MOV	D,M
  05FB'   23                    	INX	H
                                ;LDHLI -- WM 5320: HL := word@HL.
  05FC'                         LDHLI:				; WM 5320
  05FC'   7E                    	MOV	A,M
  05FD'   23                    	INX	H
  05FE'   66                    	MOV	H,M
  05FF'   6F                    	MOV	L,A
  0600'   C9                    	RET
                                
                                ;CMP16 -- WM 5333: 16-bit unsigned compare DE against HL (D-H, then E-L).
                                ;A preserved; only flags returned.  CY iff DE < HL; Z iff DE == HL.
  0601'                         CMP16:				; WM 5333
  0601'   C5                    	PUSH	B
  0602'   47                    	MOV	B,A
  0603'   7A                    	MOV	A,D
  0604'   94                    	SUB	H
  0605'   C2 060A'              	JNZ	CMPLOW
  0608'   7B                    	MOV	A,E
  0609'   95                    	SUB	L
  060A'                         CMPLOW:				 ; WM 5342
  060A'   78                    	MOV	A,B
  060B'   C1                    	POP	B
  060C'   C9                    	RET
                                
                                ;SUBCLP -- WM 5348: HL := max(0, HL-DE); CY if positive.
  060D'                         SUBCLP:				; WM 5348
  060D'   CD 0601'              	CALL	CMP16
  0610'   DA 0618'              	JC	SCLPPO
  0613'                         SCLPZ:				; WM 5352
  0613'   21 0000               	LXI	H,0H
  0616'   B7                    	ORA	A
  0617'   C9                    	RET
  0618'                         SCLPPO:				 ; WM 5357
  0618'   E5                    	PUSH	H
  0619'   CD 05E3'              	CALL	SUBHD
  061C'   D1                    	POP	D
  061D'   37                    	STC
  061E'   C9                    	RET
                                
                                ;SUBCP2 -- WM 5365: HL := max(0, DE-HL); CY if positive.
  061F'                         SUBCP2:			       ; WM 5365
  061F'   CD 0601'              	CALL	CMP16
  0622'   CA 0613'              	JZ	SCLPZ
  0625'   DA 0613'              	JC	SCLPZ
  0628'   EB                    	XCHG
  0629'   CD 05E3'              	CALL	SUBHD
  062C'   37                    	STC
  062D'   C9                    	RET
                                
                                
                                ;POPRET -- WM 5387: shared epilogue for the PUSH B/PUSH D/PUSH H prologue.
  062E'                         POPRET:				; WM 5387
  062E'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  062F'   D1                    	POP	D
  0630'   C1                    	POP	B
  0631'   C9                    	RET
                                
                                ;============================================================
                                ; PAGESTP -- the count-limited scroll step.  The disk-eviction seam
                                ; (MKROOM/SPILL/SPILLB/PAGEBOT/REWIND), the deque marks (MARKGB/UPDMARK/RECBASE/
                                ; PTRREC) and the paging drivers (PAGEDIR/PGNEED/PAGEWIN) are all real in
                                ; PAGE.MAC, and CNTTST/CMDCNT/AUXCNT now exist in CMD.MAC.
                                ;============================================================
                                
                                ;PAGESTP -- WM 4311: page one step in the scroll direction, count-limited.
                                ;CNTTST returns Z when the command count (CMDCNT and AUXCNT) is exhausted, so a
                                ;completed edit or motion stops here (RZ); otherwise fall into PAGEDIR to page
                                ;the window one increment in the current scroll direction (DIRFLG: REWIND back,
                                ;FILLBUF forward).  In WM PAGESTP falls through to the physically adjacent
                                ;PAGEDIR; here PAGEDIR lives in PAGE.MAC, so the fall-through is an explicit
                                ;JMP -- same object behavior, PAGEDIR's own POLLBRK still runs.  DELTO's tail
                                ;JMPs here, so a delete made with the count spent returns at once; the count
                                ;loops (dd's QPUTLN, MVLLOOP's line moves, the search sweep through SCRLST)
                                ;are what page the window on past its edge.
                                ;SCRLST -- WM 4307: poll type-ahead, PUTCUR to HL, then (count not spent)
                                ;fall into PAGESTP to page the window one step in the DIRFLG direction.
  0632'                         SCRLST:				; WM 4307
  0632'   CD 0000*              	CALL	POLLBRK
  0635'   CD 0380'              	CALL	PUTCUR
                                
  0638'                         PAGESTP:			; WM 4311
  0638'   CD 0000*              	CALL	CNTTST
  063B'   C8                    	RZ
  063C'   C3 0000*              	JMP	PAGEDIR
                                
                                ;============================================================
                                ; ERRMSG -- WM 664, message-print transcribed; TAIL adapted (see header):
                                ; print the inline 0-terminated message, set ERRFLG, warm-boot to CP/M.
                                ; The message is printed where ERRHK leaves the cursor: VI.MAC points it at the
                                ; screen teardown, so it lands on the bottom row with the terminal restored, as
                                ; a quit leaves it; a harness with no screen leaves it on a RET.  The work files
                                ; are dropped before the warm boot, as a quit drops them.  A second error from
                                ; inside either step ends here too: DISCRD clears its own flag before it
                                ; deletes, so it cannot run twice.
                                ;============================================================
  063F'                         ERRMSG:				; WM 664 (tail adapted)
  063F'   3E FF                 	MVI	A,0FFH
  0641'   32 0000*              	STA	ERRFLG		; record that an error fired
  0644'   2A 0664'              	LHLD	ERRHK
  0647'   CD 0662'              	CALL	ERMGO		; the cursor to where the message belongs
  064A'   E1                    	POP	H		; HL -> inline message (after the CALL)
  064B'                         ERMLP:
  064B'   7E                    	MOV	A,M
  064C'   B7                    	ORA	A
  064D'   CA 065C'              	JZ	ERMEND
  0650'   E5                    	PUSH	H
  0651'   5F                    	MOV	E,A
  0652'   0E 02                 	MVI	C,2		; BDOS console out
  0654'   CD 0005               	CALL	BDOS
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0657'   E1                    	POP	H
  0658'   23                    	INX	H
  0659'   C3 064B'              	JMP	ERMLP
  065C'                         ERMEND:
  065C'   CD 0000*              	CALL	DISCRD		; no name.$$$ / VIBACKUP.$$$ left behind
  065F'   C3 0000               	JMP	WBOOT		; adapted tail: back to CP/M
  0662'   E9                    ERMGO:	PCHL
  0663'   C9                    ERMNUL: RET
  0664'   0663'                 ERRHK:	DW	ERMNUL		; the screen's teardown, once there is a screen
                                
                                ;MEMERR -- DEVIATION 3 (see header): the arena has no room for what the key
                                ;asked.  Called as ERRMSG is, the message inline after the CALL, and goes on
                                ;through MEMHK with the stack as it found it, so whatever MEMHK names reads the
                                ;message where ERRMSG would.  MEMHK is ERRMSG until the editor is up.
  0666'                         MEMERR:
  0666'   2A 066A'              	LHLD	MEMHK
  0669'   E9                    	PCHL
  066A'   063F'                 MEMHK:	DW	ERRMSG		; VI.MAC points it at CMD.MAC's MEMABT
                                
                                ;============================================================
                                ; LOGICAL-OFFSET API  (APPENDED -- NOT WordMaster).
                                ; The gap-agnostic view the vi layer (CMD.MAC) uses so it never touches the raw
                                ; pointer row.  A logical offset is a byte index into resident text as if the
                                ; gap were absent:
                                ;   before = GAPBEG - TXTBEG   (bytes before the cursor = cursor logical offset)
                                ;   after  = TXTEND - GAPEND   (bytes at/after the cursor)
                                ;   LOGLEN = before + after
                                ; Most of CMD.MAC's verbs work in these offsets alone; the rest drive WM's
                                ; pointer-based routines (PUTCUR, the line moves, RGET, the matchers, the
                                ; Q-buffer), which page as they go, and a few read the pointer row directly.
                                ;============================================================
                                
                                ;CUROFF -- HL = cursor logical offset (= before length).
  066C'                         CUROFF:
  066C'   2A 0000*              	LHLD	TXTBEG
  066F'   EB                    	XCHG
  0670'   2A 0000*              	LHLD	GAPBEG
  0673'   CD 05E3'              	CALL	SUBHD		; HL = GAPBEG - TXTBEG
  0676'   C9                    	RET
                                
                                ;AFTLN2 -- HL = after length (TXTEND - GAPEND).  Private helper for LOGLEN.
  0677'                         AFTLN2:
  0677'   2A 0000*              	LHLD	GAPEND
  067A'   EB                    	XCHG
  067B'   2A 0000*              	LHLD	TXTEND
  067E'   CD 05E3'              	CALL	SUBHD
  0681'   C9                    	RET
                                
                                ;LOGLEN -- HL = total resident logical length.
  0682'                         LOGLEN:
  0682'   CD 066C'              	CALL	CUROFF
  0685'   E5                    	PUSH	H
  0686'   CD 0677'              	CALL	AFTLN2
  0689'   D1                    	POP	D
  068A'   19                    	DAD	D
  068B'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                                
                                ;L2PHYS -- HL(off) -> HL(physical address).  0 <= off <= LOGLEN.  Private.
  068C'                         L2PHYS:
  068C'   EB                    	XCHG			; DE = off
  068D'   D5                    	PUSH	D
  068E'   CD 066C'              	CALL	CUROFF		; HL = before
  0691'   D1                    	POP	D		; DE = off
  0692'   CD 0601'              	CALL	CMP16		; DE=off vs HL=before: CY iff off < before
  0695'   DA 06A2'              	JC	L2P_BEF
                                	;--- after region: phys = GAPEND + (off - before) ---
  0698'   EB                    	XCHG			; HL=off, DE=before
  0699'   CD 05E3'              	CALL	SUBHD		; HL = off - before
  069C'   EB                    	XCHG			; DE = off-before
  069D'   2A 0000*              	LHLD	GAPEND
  06A0'   19                    	DAD	D
  06A1'   C9                    	RET
  06A2'                         L2P_BEF:
                                	;--- before region: phys = TXTBEG + off  (DE = off, HL = before) ---
  06A2'   2A 0000*              	LHLD	TXTBEG
  06A5'   19                    	DAD	D
  06A6'   C9                    	RET
                                
                                ;CHARAT -- HL(off) -> A = byte at that logical offset (off < LOGLEN).
  06A7'                         CHARAT:
  06A7'   CD 068C'              	CALL	L2PHYS
  06AA'   7E                    	MOV	A,M
  06AB'   C9                    	RET
                                
                                ;CLAMPL -- HL(off) -> HL clamped to [0, LOGLEN].  Private helper for GOTO.
  06AC'                         CLAMPL:
  06AC'   E5                    	PUSH	H
  06AD'   CD 0682'              	CALL	LOGLEN
  06B0'   D1                    	POP	D		; DE = off
  06B1'   CD 0601'              	CALL	CMP16		; DE=off vs HL=LOGLEN
  06B4'   DA 06BB'              	JC	CLK_KEEP	; off < LOGLEN
  06B7'   CA 06BB'              	JZ	CLK_KEEP	; off == LOGLEN
  06BA'   C9                    	RET			; off > LOGLEN -> HL = LOGLEN
  06BB'                         CLK_KEEP:
  06BB'   EB                    	XCHG			; HL = off
  06BC'   C9                    	RET
                                
                                ;GOTO -- HL(off): move the cursor to that logical offset.
                                ;PUTCUR takes its target address in HL (its entry XCHG moves it to DE).
                                ;The line feeds the cursor crosses are added to LNDLT (subtracted going back).
  06BD'                         GOTO:
  06BD'   CD 06AC'              	CALL	CLAMPL
  06C0'   CD 068C'              	CALL	L2PHYS		; HL = physical address
  06C3'   E5                    	PUSH	H
  06C4'   EB                    	XCHG			; DE = target
  06C5'   2A 0000*              	LHLD	GAPEND
  06C8'   CD 0601'              	CALL	CMP16		; CY iff target < GAPEND (before the gap)
  06CB'   DA 06D9'              	JC	GTO_BK
  06CE'   EB                    	XCHG			; forward: count [GAPEND, target)
  06CF'   CD 06ED'              	CALL	LFCNT
  06D2'   2A 0000*              	LHLD	LNDLT
  06D5'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  06D6'   C3 06E5'              	JMP	GTO_ST
  06D9'                         GTO_BK:
  06D9'   2A 0000*              	LHLD	GAPBEG		; back: count [target, GAPBEG)
  06DC'   CD 06ED'              	CALL	LFCNT
  06DF'   2A 0000*              	LHLD	LNDLT
  06E2'   CD 05E3'              	CALL	SUBHD
  06E5'                         GTO_ST:
  06E5'   22 0000*              	SHLD	LNDLT
  06E8'   E1                    	POP	H
  06E9'   CD 0380'              	CALL	PUTCUR
  06EC'   C9                    	RET
                                
                                ;LFCNT -- DE = start, HL = end (>= start): DE = number of LFs in [start, end).
                                ;Clobbers BC.  KBPOLL every 256 bytes: a span can be the whole window (#40).
  06ED'                         LFCNT:
  06ED'   CD 05E3'              	CALL	SUBHD		; HL = end - start
  06F0'   44                    	MOV	B,H
  06F1'   4D                    	MOV	C,L		; BC = length
  06F2'   EB                    	XCHG			; HL = start
  06F3'   11 0000               	LXI	D,0
  06F6'   04                    	INR	B
  06F7'   0C                    	INR	C
  06F8'   C3 0703'              	JMP	LFC_CT
  06FB'                         LFC_LP:
  06FB'   7E                    	MOV	A,M
  06FC'   23                    	INX	H
  06FD'   FE 0A                 	CPI	LF
  06FF'   C2 0703'              	JNZ	LFC_CT
  0702'   13                    	INX	D
  0703'                         LFC_CT:
  0703'   0D                    	DCR	C
  0704'   C2 06FB'              	JNZ	LFC_LP
  0707'   05                    	DCR	B
  0708'   C8                    	RZ
  0709'   CD 0000*              	CALL	KBPOLL		; 256 bytes counted
  070C'   C3 06FB'              	JMP	LFC_LP
                                
                                ;RDGET -- RGET, and CY also when a refill read nothing.  INRDY stays set after
                                ;a file's last full record (no ^Z) until a read fails; NEEDIN then returns NC
                                ;having added nothing, and RGET steps past TXTEND leaving BC = FFFFH.  That is
                                ;reported as the end of the text, with BC = 0 so a later call asks NEEDIN again.
  070F'                         RDGET:
  070F'   CD 04CB'              	CALL	RGET
  0712'   D8                    	RC
  0713'   F5                    	PUSH	PSW
  0714'   78                    	MOV	A,B
  0715'   A1                    	ANA	C
  0716'   3C                    	INR	A		; Z iff BC = FFFFH
  0717'   CA 071C'              	JZ	RDG_EF
  071A'   F1                    	POP	PSW
  071B'   C9                    	RET
  071C'                         RDG_EF:
  071C'   F1                    	POP	PSW
  071D'   01 0000               	LXI	B,0
  0720'   37                    	STC
  0721'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


                                
                                ;DELFWD -- HL = number of logical bytes to delete forward from the cursor.
  0722'                         DELFWD:
  0722'   7C                    	MOV	A,H
  0723'   B5                    	ORA	L
  0724'   C8                    	RZ			; nothing to delete
  0725'   CD 0C13'              	CALL	UNDDLF		; (appended) the span, for 'u', before it goes
  0728'   EB                    	XCHG			; DE = count
  0729'   2A 0000*              	LHLD	GAPEND
  072C'   19                    	DAD	D		; target = GAPEND + count
  072D'   AF                    	XRA	A		; S clear -> forward delete
  072E'   CD 0207'              	CALL	DELTO
  0731'   C9                    	RET
                                
                                ;DELPRV -- WM 3260 RUBOUT/DELL: delete the char left of the cursor, and the
                                ;CR too when that leaves one there (a CR,LF goes as one).  PEEKLX pages back
                                ;at the window start and returns at the start of the file.  WM's MARKCUR and
                                ;ROWUP (its screen) are left out; instead a deleted LF moves the cursor up a
                                ;line (LNDLT - 1) for SCRN.MAC.
  0732'                         DELPRV:				; WM 3260
  0732'   CD 0200'              	CALL	PEEKLX
  0735'   FE 0A                 	CPI	LF
  0737'   C2 0743'              	JNZ	DLP_GO
  073A'   E5                    	PUSH	H
  073B'   2A 0000*              	LHLD	LNDLT
  073E'   2B                    	DCX	H
  073F'   22 0000*              	SHLD	LNDLT
  0742'   E1                    	POP	H
  0743'                         DLP_GO:				; WM 3263 DELL
  0743'   CD 0C33'              	CALL	UNDDLP		; (appended) that byte, for 'u', before it goes
  0746'   CD 0067'              	CALL	SETGAPB
  0749'   CD 01F3'              	CALL	PEEKL
  074C'   FE 0D                 	CPI	CR
  074E'   CA 0732'              	JZ	DELPRV
  0751'   C9                    	RET
                                
                                
                                ;UNDELF -- APPENDED, NOT WordMaster: give back the byte last swallowed forward
                                ;into the gap.  A forward delete only moves GAPEND past the byte, so the byte
                                ;itself is still there, inside the gap: GAPEND-1 through DELTO makes it text
                                ;again, with the record marks updated exactly as a delete updates them.
                                ;Replace mode ('R') puts back with it what it overwrote, as vim's BS in Replace
                                ;mode does.  The caller must know the gap has not moved since the delete
                                ;(CMD.MAC keeps GAPEND in RPGE for that); nothing else calls this.
  0752'                         UNDELF:
  0752'   2A 0000*              	LHLD	GAPEND
  0755'   2B                    	DCX	H
  0756'   AF                    	XRA	A		; S clear -> the forward (GAPEND) side
  0757'   CD 0207'              	CALL	DELTO
  075A'   C3 0C46'              	JMP	UNDUDF		; (appended) the byte just made text again
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  APPENDED, NOT WordMaster: WM has no undo at all (its QBUFOP /
                                ; QEXEC macro is a command-LINE facility, not this).
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


                                ; Six primitives change resident text, and each one says what it did: PUTGAP
                                ; (one byte in), QGET (the register in), DELFWD (a span out), DELPRV (one byte
                                ; out backward), UNDELF (one byte back in) and QPUTLN (whole lines out).
                                ; Nothing else in the editor reaches the text, so no command can forget to
                                ; record itself -- which is the whole reason the capture sits down here instead
                                ; of at CMD.MAC's edit sites.
                                ;
                                ; A record says only WHERE and HOW MUCH, in LOGICAL offsets, plus where its
                                ; bytes lie in the undo region.  Logical offsets survive the gap sliding (which
                                ; PUTCUR does on every cursor move) because the replay walks the records
                                ; BACKWARD: each step restores the offsets the steps after it were measured
                                ; against.  The bytes are kept for an insert as well as a delete -- an insert
                                ; costs its own text twice, which is nothing -- so the region is settled once
                                ; the command ends and 'u' can walk it either way: backward applying each
                                ; record's inverse to undo, forward applying the records as they stand to redo.
                                ; That is what makes 'u' undo 'u' with ONE region and no capture during the
                                ; replay.
                                ;
                                ; The region is a region of the arena like the Q buffer, inserted between the
                                ; slider and the text, and it grows through the same MKGAP: the pointer row
                                ; reads (UBEG,UEND) as data and (TXTBAS,UBEG) / (UEND,TXTBEG) as the holes
                                ; around it, so NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN and INIBAS all take it in
                                ; their stride unchanged.
                                ;
                                ; DEVIATIONS from vim, all deliberate and all in COMMANDS.md: ONE level of
                                ; undo, so 'u' undoes 'u' as real vi does; the change must still be in the
                                ; RESIDENT window, and 'u' refuses once the pager has moved off it rather than
                                ; chasing it through the file; and a change with more steps than the table
                                ; holds, or one the arena has no spare room to keep, is not undoable at all.
                                ;
                                ; "Moved off it" is PGTOPM, PAGE.MAC's count of the times the pager moved
                                ; TXTBEG.  It is the window's TOP that matters: an offset is measured from
                                ; TXTBEG, so spilling a record out from under it (PAGEOUT) or reading one back
                                ; in (REWIND) shifts every offset, while FILLBUF and PAGEBOT growing TXTEND at
                                ; the bottom shift none.  The OUTREC/SRCREC water marks look like the same
                                ; thing and are not: UPDMARK moves them on every edit (OUTREC down,
                                ; SRCREC up).
                                ;============================================================
                                
  0001                          UR_INS	EQU	1		; text went IN  (undoing takes it back out)
  0002                          UR_DEL	EQU	2		; text came OUT (undoing puts it back)
  0007                          URSIZE	EQU	7		; type, offset(2), length(2), region offset(2)
  0018                          URMAX	EQU	24		; primitive steps one change may hold
                                ;How much of the arena the capture refuses to eat into.  It only has to keep
                                ;MKGAP off its MKROOM path (which wants 256 free), because paging is what undo
                                ;must not do -- so this is deliberately SMALL.  RESVMEM, QROOM's reserve, is
                                ;far too big: a 66 K file leaves under 1700 bytes free, and undo would never
                                ;engage at all on exactly the files that need it most.
  0200                          UNDRSV	EQU	200H		; ... 512 bytes
                                ;How much room the region claims up front, and so the largest change that can
                                ;be kept.  The claim is what lets the capture run without EVER growing the
                                ;region: see UNDGRW for why growing where a primitive can see it is unsafe.
  0400                          UNDCAP	EQU	400H		; 1024 bytes of change
                                
                                ;UNDBEG -- CMD.MAC's command boundary: the NEXT captured change starts a new
                                ;undo.  A flag only, so a command that changes nothing -- a motion, a yank, a
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


                                ;key that is no command at all -- leaves the last change undoable, exactly as
                                ;'.' keeps the last change it recorded.
  075D'                         UNDBEG:
  075D'   D5                    	PUSH	D
  075E'   E5                    	PUSH	H
  075F'   3E 01                 	MVI	A,1
  0761'   32 0C5B'              	STA	UNDNEW
  0764'   CD 0773'              	CALL	UNDPC0		; where the cursor was as this command began --
  0767'   CD 0780'              	CALL	UNDGRW		;   kept pending, because only a command that
  076A'   E1                    	POP	H		;   really changes text gets to claim it
  076B'   D1                    	POP	D
  076C'   C9                    	RET
                                
                                ;UNDHER -- the change about to start belongs at the CURSOR: 'u' puts it back
                                ;there.  UNDBEG's cursor snapshot without its claim on the region, for a
                                ;command (':s') that cannot know where its first change will be until it has
                                ;found it.  Calling UNDBEG again instead would re-run UNDGRW in the middle of
                                ;the command, which is the one thing UNDGRW must never do -- see below.
  076D'                         UNDHER:
  076D'   E5                    	PUSH	H
  076E'   CD 0773'              	CALL	UNDPC0
  0771'   E1                    	POP	H
  0772'   C9                    	RET
                                
                                ;UNDPC0 -- the cursor's offset now, and the window's top it is measured from
                                ;(OUTPOS, in records): the command may page before its first capture, and
                                ;UNDRST moves the offset by what the top moved (#43).  Clobbers DE and HL.
  0773'                         UNDPC0:
  0773'   CD 066C'              	CALL	CUROFF
  0776'   22 0000*              	SHLD	UNDPCU
  0779'   2A 0000*              	LHLD	OUTPOS
  077C'   22 0000*              	SHLD	UNDPCO
  077F'   C9                    	RET
                                
                                ;UNDGRW -- make sure the region can take a whole change without growing again.
                                ;THE ONLY PLACE THE REGION GROWS, and it runs at the command boundary, where no
                                ;primitive is holding anything.  Growing moves regions about (MKGAP -> MOVGAP),
                                ;and that both invalidates a raw pointer a primitive is in the middle of using
                                ;-- DELPRV hands SETGAPB one -- and overwrites whatever is sitting in the gap,
                                ;which is where a forward-deleted byte waits for 'R's backspace to call UNDELF
                                ;and give it back.  So the room is claimed here, 256 bytes at a time, and the
                                ;capture below never calls MKGAP at all: it writes into the claim or gives up.
                                ;The room has to be claimed as the region's own CONTENT, not left as the hole
                                ;above it: the holes are shared, and the text takes whatever it can reach --
                                ;MOVGAP feeding an insert will walk straight through a hole reserved here, which
                                ;is what made a 200-character insert lose its undo halfway.  Once the bytes are
                                ;inside (UBEG,UEND) the text cannot have them: MOVGAP slides the region aside
                                ;instead.  Nothing here holds an address across MKGAP either, because MKGAP
                                ;slides this very region (HOLEUP moves UBEG and UEND) -- UEND is re-read from
                                ;its cell every time round.
  0780'                         UNDGRW:
  0780'   C5                    	PUSH	B
  0781'   D5                    	PUSH	D
  0782'   E5                    	PUSH	H
  0783'                         UNDGRL:
  0783'   21 0000*              	LXI	H,UBEG
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0786'   CD 04B9'              	CALL	PRSPAN		; BC = the region's size
  0789'   50                    	MOV	D,B
  078A'   59                    	MOV	E,C
  078B'   21 0400               	LXI	H,UNDCAP
  078E'   CD 0601'              	CALL	CMP16		; CY iff it is smaller than one change
  0791'   D2 062E'              	JNC	POPRET
  0794'   CD 0954'              	CALL	UNDRM		; ... but never at the cost of paging
  0797'   DA 062E'              	JC	POPRET
  079A'   21 0000*              	LXI	H,UEND
  079D'   CD 00BC'              	CALL	MKGAP		; 256 free above the region ...
  07A0'   2A 0000*              	LHLD	UEND
  07A3'   11 0100               	LXI	D,100H
  07A6'   19                    	DAD	D
  07A7'   22 0000*              	SHLD	UEND		; ... taken into it, so the text cannot take
  07AA'   C3 0783'              	JMP	UNDGRL		;     them back
                                
                                ;UNDCLR -- nothing is undoable (a fresh buffer; BINIT calls it through INIGAP).
  07AD'                         UNDCLR:
  07AD'   AF                    	XRA	A
  07AE'   32 0000*              	STA	UNDN
  07B1'   32 0000*              	STA	UNDST
  07B4'   32 0000*              	STA	UNDBAD
  07B7'   3E 01                 	MVI	A,1
  07B9'   32 0C5B'              	STA	UNDNEW
  07BC'   C9                    	RET
                                
                                ;UNDRST -- the first capture of a new change: drop the last one and note where
                                ;the file window was, so 'u' can tell the pager has since moved off this change.
  07BD'                         UNDRST:
  07BD'   AF                    	XRA	A
  07BE'   32 0C5B'              	STA	UNDNEW
  07C1'   32 0000*              	STA	UNDN
  07C4'   32 0000*              	STA	UNDBAD
  07C7'   21 0000               	LXI	H,0
  07CA'   22 0000*              	SHLD	UNDPTR		; the region's content empties (its SIZE stays:
                                				;   that is the room UNDGRW claimed)
  07CD'   2A 0000*              	LHLD	PGTOPM
  07D0'   22 0000*              	SHLD	UNDPG
  07D3'   2A 0000*              	LHLD	UNDPCU		; ... and this command does change text, so
  07D6'   CD 07E2'              	CALL	UNDSHF		;   where it began is where 'u' will put the
  07D9'   22 0000*              	SHLD	UNDCUR		;   cursor back -- moved by any page since
                                				;   (#43: 'dd' on a full window spills before
                                				;   it takes the line)
  07DC'   3E 01                 	MVI	A,1
  07DE'   32 0000*              	STA	UNDST		; a change is on the buffer: 'u' undoes it
  07E1'   C9                    	RET
                                
                                ;UNDSHF -- HL = a logical offset measured when the window's top was record
                                ;UNDPCO: the same place, measured from the top as it is now (OUTPOS).  A page
                                ;off the top moves every offset down 128 bytes a record.  A place that has
                                ;itself gone above the top cannot be reached: 0, the top.  Clobbers DE.
                                ;The replay pages only when a step putting bytes back finds no room, and the
                                ;steps before it leave the room their change freed: in every change tried
                                ;that step was the replay's last, and only the cursor came after it (#45).
  07E2'                         UNDSHF:
  07E2'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  07E3'   2A 0000*              	LHLD	OUTPOS
  07E6'   EB                    	XCHG
  07E7'   2A 0000*              	LHLD	UNDPCO
  07EA'   CD 05E3'              	CALL	SUBHD		; HL = records the top moved, negated
  07ED'   29                    	DAD	H
  07EE'   29                    	DAD	H
  07EF'   29                    	DAD	H
  07F0'   29                    	DAD	H
  07F1'   29                    	DAD	H
  07F2'   29                    	DAD	H
  07F3'   29                    	DAD	H		; ... times 128
  07F4'   D1                    	POP	D
  07F5'   19                    	DAD	D
  07F6'   7C                    	MOV	A,H
  07F7'   B7                    	ORA	A
  07F8'   F0                    	RP
  07F9'   21 0000               	LXI	H,0
  07FC'   C9                    	RET
                                
                                ;UNDCHG -- the capture every hooked primitive uses.  A = UR_INS / UR_DEL,
                                ;HL = the logical offset it acted at, BC = how many bytes.  The bytes are read
                                ;back out of the resident TEXT at that offset -- for a delete before they go,
                                ;for an insert once they have arrived -- so no caller hands over a pointer that
                                ;growing the region could leave stale.
  07FD'                         UNDCHG:
  07FD'   C5                    	PUSH	B
  07FE'   D5                    	PUSH	D
  07FF'   E5                    	PUSH	H
  0800'   32 0000*              	STA	UNDTY		; the record type, kept out of the registers
  0803'   CD 087B'              	CALL	EDTGO		; whoever else follows an edit (BC is kept)
  0806'   3A 0000*              	LDA	UNDRPL
  0809'   B7                    	ORA	A
  080A'   C2 062E'              	JNZ	POPRET		; 'u' replaying: its own edits are not a change
  080D'   3A 0C5B'              	LDA	UNDNEW
  0810'   B7                    	ORA	A
  0811'   CA 0817'              	JZ	UNDC1
  0814'   CD 07BD'              	CALL	UNDRST		; the first step of a new change
  0817'                         UNDC1:
  0817'   3A 0000*              	LDA	UNDBAD
  081A'   B7                    	ORA	A
  081B'   C2 062E'              	JNZ	POPRET		; this change has already been given up on
  081E'   78                    	MOV	A,B
  081F'   B1                    	ORA	C
  0820'   CA 062E'              	JZ	POPRET		; a zero-length step is no step
  0823'   60                    	MOV	H,B
  0824'   69                    	MOV	L,C
  0825'   22 0000*              	SHLD	UNDCL		; UNDAPT spends BC as its countdown, so the
                                				;   length has to be kept somewhere else
  0828'   3A 0000*              	LDA	UNDN
  082B'   FE 18                 	CPI	URMAX
  082D'   D2 0873'              	JNC	UNDCBD		; no room for another step
                                	;--- where this step's bytes will land in the region ---
  0830'   2A 0000*              	LHLD	UNDPTR
  0833'   22 0000*              	SHLD	UNDBO
  0836'   E1                    	POP	H
  0837'   E5                    	PUSH	H		; HL = the logical offset again
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0838'   CD 08EB'              	CALL	UNDAPT		; BC bytes of the text there -> the region
  083B'   DA 0873'              	JC	UNDCBD
                                	;--- fold it into the last record when it only carries that one on ---
  083E'   E1                    	POP	H
  083F'   E5                    	PUSH	H
  0840'   CD 0893'              	CALL	UNDEXT
  0843'   CA 062E'              	JZ	POPRET
                                	;--- otherwise a record of its own ---
  0846'   3A 0000*              	LDA	UNDN
  0849'   CD 0883'              	CALL	URADDR
  084C'   3A 0000*              	LDA	UNDTY
  084F'   77                    	MOV	M,A
  0850'   23                    	INX	H
  0851'   D1                    	POP	D
  0852'   D5                    	PUSH	D		; DE = the logical offset
  0853'   73                    	MOV	M,E
  0854'   23                    	INX	H
  0855'   72                    	MOV	M,D
  0856'   23                    	INX	H
  0857'   EB                    	XCHG			; DE = the record, past the offset
  0858'   2A 0000*              	LHLD	UNDCL
  085B'   EB                    	XCHG			; ... and HL back, with DE = the length
  085C'   73                    	MOV	M,E
  085D'   23                    	INX	H
  085E'   72                    	MOV	M,D
  085F'   23                    	INX	H
  0860'   3A 0000*              	LDA	UNDBO
  0863'   77                    	MOV	M,A
  0864'   23                    	INX	H
  0865'   3A 0001*              	LDA	UNDBO+1
  0868'   77                    	MOV	M,A
  0869'   3A 0000*              	LDA	UNDN
  086C'   3C                    	INR	A
  086D'   32 0000*              	STA	UNDN
  0870'   C3 062E'              	JMP	POPRET
  0873'                         UNDCBD:
  0873'   3E 01                 	MVI	A,1
  0875'   32 0000*              	STA	UNDBAD		; too big to keep: not undoable at all
  0878'   C3 062E'              	JMP	POPRET
                                
                                ;EDTGO -- UNDCHG is the one place every change to the text goes by, the
                                ;replay's own included, so it is also where the editor hears of one: EDTHK is
                                ;called with A = UR_INS / UR_DEL, HL = the logical offset and BC = the length,
                                ;and must keep BC.  VI.MAC points it at the marks; a harness leaves it a RET.
  087B'                         EDTGO:
  087B'   E5                    	PUSH	H
  087C'   2A 0881'              	LHLD	EDTHK
  087F'   E3                    	XTHL
  0880'   C9                    	RET
  0881'   0663'                 EDTHK:	DW	ERMNUL
                                
                                ;URADDR -- A = a record index -> HL = its address (base + n*8 - n).
  0883'                         URADDR:
  0883'   6F                    	MOV	L,A
  0884'   26 00                 	MVI	H,0
  0886'   5D                    	MOV	E,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0887'   54                    	MOV	D,H
  0888'   29                    	DAD	H
  0889'   29                    	DAD	H
  088A'   29                    	DAD	H		; HL = n*8
  088B'   CD 05E3'              	CALL	SUBHD		; HL = n*7
  088E'   11 0000*              	LXI	D,UNDREC
  0891'   19                    	DAD	D
  0892'   C9                    	RET
                                
                                ;UNDEXT -- A = 0 (Z) when this step only carries the last record on: an insert
                                ;starting exactly where the last insert ended, which is what typing does.  Its
                                ;bytes already sit contiguously behind that record's, so only the length grows.
                                ;HL = this step's offset, BC = its length.
  0893'                         UNDEXT:
  0893'   C5                    	PUSH	B
  0894'   D5                    	PUSH	D
  0895'   E5                    	PUSH	H
  0896'   3A 0000*              	LDA	UNDTY
  0899'   FE 01                 	CPI	UR_INS
  089B'   C2 08E5'              	JNZ	UNDXNO		; only inserts fold
  089E'   3A 0000*              	LDA	UNDN
  08A1'   B7                    	ORA	A
  08A2'   CA 08E5'              	JZ	UNDXNO		; nothing to fold into
  08A5'   3D                    	DCR	A
  08A6'   CD 0883'              	CALL	URADDR
  08A9'   22 0000*              	SHLD	UNDLSA
  08AC'   7E                    	MOV	A,M
  08AD'   FE 01                 	CPI	UR_INS
  08AF'   C2 08E5'              	JNZ	UNDXNO
  08B2'   2A 0000*              	LHLD	UNDLSA
  08B5'   23                    	INX	H
  08B6'   CD 05FC'              	CALL	LDHLI		; HL = the last record's offset
  08B9'   EB                    	XCHG
  08BA'   2A 0000*              	LHLD	UNDLSA
  08BD'   23                    	INX	H
  08BE'   23                    	INX	H
  08BF'   23                    	INX	H
  08C0'   CD 05FC'              	CALL	LDHLI		; HL = its length
  08C3'   19                    	DAD	D		; HL = where it ends
  08C4'   EB                    	XCHG
  08C5'   E1                    	POP	H
  08C6'   E5                    	PUSH	H		; HL = this step's offset
  08C7'   CD 0601'              	CALL	CMP16		; Z iff this step starts exactly there
  08CA'   C2 08E5'              	JNZ	UNDXNO
  08CD'   2A 0000*              	LHLD	UNDLSA
  08D0'   23                    	INX	H
  08D1'   23                    	INX	H
  08D2'   23                    	INX	H
  08D3'   E5                    	PUSH	H
  08D4'   CD 05FC'              	CALL	LDHLI		; HL = the last record's length
  08D7'   EB                    	XCHG
  08D8'   2A 0000*              	LHLD	UNDCL
  08DB'   19                    	DAD	D		; ... grown by this step's
  08DC'   EB                    	XCHG
  08DD'   E1                    	POP	H
  08DE'   73                    	MOV	M,E
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  08DF'   23                    	INX	H
  08E0'   72                    	MOV	M,D
  08E1'   AF                    	XRA	A		; Z: folded, no new record
  08E2'   C3 062E'              	JMP	POPRET
  08E5'                         UNDXNO:
  08E5'   3E 01                 	MVI	A,1
  08E7'   B7                    	ORA	A		; NZ: it needs a record of its own
  08E8'   C3 062E'              	JMP	POPRET
                                
                                ;UNDAPT -- append BC bytes of resident text, from logical offset HL, to the
                                ;undo region.  CY, and the change given up on, if they do not all fit the room
                                ;UNDGRW claimed: then NOTHING is copied, so a change too big to keep costs no
                                ;capture at all (#36).  Otherwise the bytes go in with at most two MEMCPYs, the
                                ;run before the gap and the run after it.  Each hook hands over a span on ONE
                                ;side of the gap, but the split costs little and keeps the contract whole.
                                ;The addresses are resolved here and used at once: nothing UNDAPT calls can
                                ;move a region (no MKGAP, no paging; MEMCPY's KBPOLL only fills the key ring,
                                ;and at 1 K a copy never reaches it), so none can go stale in the middle.
  08EB'                         UNDAPT:
  08EB'   78                    	MOV	A,B
  08EC'   B1                    	ORA	C
  08ED'   C8                    	RZ			; nothing to append
  08EE'   E5                    	PUSH	H		; the offset
  08EF'   C5                    	PUSH	B		; ... and the length
  08F0'   21 0000*              	LXI	H,UBEG
  08F3'   CD 04B9'              	CALL	PRSPAN		; BC = the region's size
  08F6'   2A 0000*              	LHLD	UNDPTR
  08F9'   EB                    	XCHG
  08FA'   60                    	MOV	H,B
  08FB'   69                    	MOV	L,C
  08FC'   CD 05E3'              	CALL	SUBHD		; HL = the room left in it
  08FF'   EB                    	XCHG			; DE = the room
  0900'   E1                    	POP	H
  0901'   E5                    	PUSH	H		; HL = the length
  0902'   CD 0601'              	CALL	CMP16		; CY iff the room is short of it
  0905'   DA 094B'              	JC	UNDAPF
  0908'                         UNDAPR:
  0908'   CD 066C'              	CALL	CUROFF		; HL = the bytes before the gap (DE is lost)
  090B'   C1                    	POP	B		; BC = the bytes still to copy
  090C'   D1                    	POP	D		; DE = their offset
  090D'   78                    	MOV	A,B
  090E'   B1                    	ORA	C
  090F'   C8                    	RZ			; all in (NC from the ORA)
  0910'   D5                    	PUSH	D
  0911'   CD 0601'              	CALL	CMP16		; CY iff they start before the gap
  0914'   D2 0922'              	JNC	UNDAPA		; at or after it: one run, the rest
  0917'   CD 05E3'              	CALL	SUBHD		; HL = how many lie before the gap
  091A'   50                    	MOV	D,B
  091B'   59                    	MOV	E,C
  091C'   CD 0601'              	CALL	CMP16		; CY iff fewer are left than that
  091F'   D2 0924'              	JNC	UNDAPN		; the run stops at the gap
  0922'                         UNDAPA:
  0922'   60                    	MOV	H,B
  0923'   69                    	MOV	L,C		; the run is all that is left
  0924'                         UNDAPN:
  0924'   79                    	MOV	A,C		; HL = this run, BC = left, the offset stacked
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0925'   95                    	SUB	L
  0926'   4F                    	MOV	C,A
  0927'   78                    	MOV	A,B
  0928'   9C                    	SBB	H
  0929'   47                    	MOV	B,A		; BC = what is left after it
  092A'   EB                    	XCHG			; DE = the run
  092B'   E1                    	POP	H
  092C'   E5                    	PUSH	H		; HL = its offset
  092D'   19                    	DAD	D
  092E'   E3                    	XTHL			; the next run's offset stacked, HL = this one's
  092F'   C5                    	PUSH	B		; ... and what will be left
  0930'   42                    	MOV	B,D
  0931'   4B                    	MOV	C,E		; BC = the run
  0932'   CD 068C'              	CALL	L2PHYS		; HL = where it sits in the text
  0935'   E5                    	PUSH	H
  0936'   2A 0000*              	LHLD	UNDPTR
  0939'   E5                    	PUSH	H
  093A'   09                    	DAD	B
  093B'   22 0000*              	SHLD	UNDPTR		; the write point moves past it
  093E'   D1                    	POP	D
  093F'   2A 0000*              	LHLD	UBEG
  0942'   19                    	DAD	D
  0943'   EB                    	XCHG			; DE = where it goes in the region
  0944'   E1                    	POP	H		; HL = the text
  0945'   CD 0500'              	CALL	MEMCPY
  0948'   C3 0908'              	JMP	UNDAPR
  094B'                         UNDAPF:
  094B'   C1                    	POP	B
  094C'   E1                    	POP	H
  094D'   3E 01                 	MVI	A,1
  094F'   32 0000*              	STA	UNDBAD		; too big for the room: not undoable at all
  0952'   37                    	STC
  0953'   C9                    	RET
                                
                                ;UNDRM -- CY, and the change given up on, unless the arena still holds UNDRSV
                                ;free.  The capture must never page: paging moves the window off the change and
                                ;would invalidate every logical offset the records hold.  Keeping this much
                                ;free also keeps MKGAP off its MKROOM path, so the capture cannot page even by
                                ;accident, and it fails QUIETLY where QROOM raises 'QBUF FULL' -- undo going
                                ;away must never stop the editing.
  0954'                         UNDRM:
  0954'   C5                    	PUSH	B
  0955'   D5                    	PUSH	D
  0956'   E5                    	PUSH	H
  0957'   CD 0453'              	CALL	BUFSUM		; DE = the arena's free bytes
  095A'   21 0200               	LXI	H,UNDRSV
  095D'   CD 0601'              	CALL	CMP16		; CY iff less than that is left
  0960'   D2 062E'              	JNC	POPRET
  0963'   3E 01                 	MVI	A,1
  0965'   32 0000*              	STA	UNDBAD
  0968'   37                    	STC
  0969'   C3 062E'              	JMP	POPRET
                                
                                ;---------------------------------------------------------------- the replay
                                
                                ;UNDO -- 'u'.  CY when there is nothing to undo: no change captured, a change
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


                                ;too big to have been captured, or the pager has moved the window off it.
  096C'                         UNDO:
  096C'   AF                    	XRA	A
  096D'   32 0000*              	STA	UNDWHY		; refused for want of a change, until told else
  0970'   3A 0000*              	LDA	UNDBAD		; asked BEFORE the count of records: a change
  0973'   B7                    	ORA	A		;   too big from its very first step leaves
  0974'   CA 097E'              	JZ	UND_OK		;   none, and is still not 'nothing to undo'
  0977'   3E 02                 	MVI	A,2
  0979'   32 0000*              	STA	UNDWHY		; too big to have been captured: CMD.MAC says
  097C'   37                    	STC			;   so, rather than ringing the bell at a user
  097D'   C9                    	RET			;   who has no way to know why
  097E'                         UND_OK:
  097E'   3A 0000*              	LDA	UNDN
  0981'   B7                    	ORA	A
  0982'   37                    	STC
  0983'   C8                    	RZ			; nothing captured
  0984'   2A 0000*              	LHLD	PGTOPM
  0987'   EB                    	XCHG
  0988'   2A 0000*              	LHLD	UNDPG
  098B'   CD 0601'              	CALL	CMP16
  098E'   C2 09C7'              	JNZ	UNDPGD		; the pager has moved the window's top since,
                                				;   so every offset the records hold has shifted
  0991'   2A 0000*              	LHLD	OUTPOS		; ... but the replay may move it itself: the
  0994'   22 0000*              	SHLD	UNDPCO		;   bytes going back can need room the window
                                				;   has not got (#45), and every offset read
                                				;   from here on goes through UNDSHF
  0997'   3E FF                 	MVI	A,0FFH
  0999'   32 0000*              	STA	UNDML		; (no step taken yet)
  099C'   AF                    	XRA	A
  099D'   32 0000*              	STA	UNDLK
  09A0'   32 0000*              	STA	UNDLC
  09A3'   3E 01                 	MVI	A,1
  09A5'   32 0000*              	STA	UNDRPL		; the replay's own edits are not a new change
  09A8'   3A 0000*              	LDA	UNDST
  09AB'   FE 01                 	CPI	1
  09AD'   CA 09CE'              	JZ	UNDREV
                                	;--- the last 'u' undid it: apply the records forward again (a redo) ---
  09B0'   AF                    	XRA	A
  09B1'   32 0000*              	STA	UNDDIR
  09B4'   AF                    	XRA	A
  09B5'                         UNDFWL:
  09B5'   CD 09F5'              	CALL	URSTEP
  09B8'   3C                    	INR	A
  09B9'   47                    	MOV	B,A
  09BA'   3A 0000*              	LDA	UNDN
  09BD'   B8                    	CMP	B
  09BE'   78                    	MOV	A,B
  09BF'   C2 09B5'              	JNZ	UNDFWL
  09C2'   3E 01                 	MVI	A,1
  09C4'   C3 09E0'              	JMP	UNDFIN
  09C7'                         UNDPGD:
  09C7'   3E 01                 	MVI	A,1
  09C9'   32 0000*              	STA	UNDWHY		; the change is no longer in the window
  09CC'   37                    	STC
  09CD'   C9                    	RET
  09CE'                         UNDREV:
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


                                	;--- undo: the records backward, each one's inverse ---
  09CE'   3E 01                 	MVI	A,1
  09D0'   32 0000*              	STA	UNDDIR
  09D3'   3A 0000*              	LDA	UNDN
  09D6'                         UNDRVL:
  09D6'   3D                    	DCR	A
  09D7'   CD 09F5'              	CALL	URSTEP
  09DA'   B7                    	ORA	A
  09DB'   C2 09D6'              	JNZ	UNDRVL
  09DE'   3E 02                 	MVI	A,2
  09E0'                         UNDFIN:
  09E0'   32 0000*              	STA	UNDST
  09E3'   AF                    	XRA	A
  09E4'   32 0000*              	STA	UNDRPL
                                	;--- the cursor goes back where the command that changed it began:
                                	;    measured from vim, which restores that and not the change's own
                                	;    offset (CMD.MAC's VC_UNDO holds it inside the line) ---
  09E7'   2A 0000*              	LHLD	UNDCUR
  09EA'   CD 07E2'              	CALL	UNDSHF		; (the replay paged: CMD.MAC reads the cell
  09ED'   22 0000*              	SHLD	UNDCUR		;   again, so it is moved where it sits)
  09F0'   CD 06BD'              	CALL	GOTO
  09F3'   B7                    	ORA	A		; CY clear: it happened
  09F4'   C9                    	RET
                                
                                ;URSTEP -- apply record A: as it stands when UNDDIR is 0 (a redo), inverted
                                ;when it is 1 (an undo).  An insert applied puts its saved bytes back at its
                                ;offset; an insert inverted deletes that many bytes there; a delete is the
                                ;mirror of both.  A is preserved -- UNDO's loops count with it.
  09F5'                         URSTEP:
  09F5'   F5                    	PUSH	PSW
  09F6'   CD 0883'              	CALL	URADDR
  09F9'   7E                    	MOV	A,M
  09FA'   32 0000*              	STA	UNDTY
  09FD'   23                    	INX	H
  09FE'   7E                    	MOV	A,M
  09FF'   32 0000*              	STA	UNDOF
  0A02'   23                    	INX	H
  0A03'   7E                    	MOV	A,M
  0A04'   32 0001*              	STA	UNDOF+1
  0A07'   23                    	INX	H
  0A08'   7E                    	MOV	A,M
  0A09'   32 0000*              	STA	UNDLN
  0A0C'   23                    	INX	H
  0A0D'   7E                    	MOV	A,M
  0A0E'   32 0001*              	STA	UNDLN+1
  0A11'   23                    	INX	H
  0A12'   7E                    	MOV	A,M
  0A13'   32 0000*              	STA	UNDBO
  0A16'   23                    	INX	H
  0A17'   7E                    	MOV	A,M
  0A18'   32 0001*              	STA	UNDBO+1
  0A1B'   2A 0000*              	LHLD	UNDBO		; a line end among its bytes: more than one
  0A1E'   EB                    	XCHG			;   line changes (UNDML: CMD.MAC picks the
  0A1F'   2A 0000*              	LHLD	UBEG		;   repaint by it)
  0A22'   19                    	DAD	D
  0A23'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0A24'   2A 0000*              	LHLD	UNDLN
  0A27'   19                    	DAD	D
  0A28'   CD 06ED'              	CALL	LFCNT
  0A2B'   7A                    	MOV	A,D
  0A2C'   B3                    	ORA	E
  0A2D'   CA 0A35'              	JZ	URS_1L
  0A30'   3E 01                 	MVI	A,1
  0A32'   32 0000*              	STA	UNDML
  0A35'                         URS_1L:
  0A35'   3A 0000*              	LDA	UNDTY
  0A38'   47                    	MOV	B,A
  0A39'   3A 0000*              	LDA	UNDDIR
  0A3C'   B7                    	ORA	A
  0A3D'   CA 0A49'              	JZ	URS_AP
  0A40'   78                    	MOV	A,B		; an undo inverts the record
  0A41'   FE 01                 	CPI	UR_INS
  0A43'   CA 0A4F'              	JZ	URS_DL
  0A46'   C3 0A5F'              	JMP	URS_IN
  0A49'                         URS_AP:
  0A49'   78                    	MOV	A,B		; a redo applies it as it stands
  0A4A'   FE 01                 	CPI	UR_INS
  0A4C'   CA 0A5F'              	JZ	URS_IN
  0A4F'                         URS_DL:
                                	;--- take the record's length back out at its offset ---
  0A4F'   CD 0AE6'              	CALL	URGOTO
  0A52'   3E 02                 	MVI	A,2
  0A54'   CD 0B0F'              	CALL	URLNQ
  0A57'   2A 0000*              	LHLD	UNDLN
  0A5A'   CD 0722'              	CALL	DELFWD
  0A5D'   F1                    	POP	PSW
  0A5E'   C9                    	RET
  0A5F'                         URS_IN:
                                	;--- put the record's saved bytes back in at its offset: a run at a
                                	;    time, as many as the gap holds, not a PUTGAP a byte (#42: 800
                                	;    bytes took 2.5 s, most of it UPDMARK and the marks' shift run
                                	;    once per byte) ---
  0A5F'   CD 0AE6'              	CALL	URGOTO
  0A62'   3E 01                 	MVI	A,1
  0A64'   CD 0B0F'              	CALL	URLNQ
  0A67'   2A 0000*              	LHLD	UNDBO		; the line ends among them: the cursor crosses
  0A6A'   EB                    	XCHG			;   each one as it goes in, and GOTO keeps LNDLT
  0A6B'   2A 0000*              	LHLD	UBEG		;   for every move the replay makes -- so the
  0A6E'   19                    	DAD	D		;   renderer needs no whole-window rescan to
  0A6F'   EB                    	XCHG			;   find that out
  0A70'   2A 0000*              	LHLD	UNDLN
  0A73'   19                    	DAD	D
  0A74'   CD 06ED'              	CALL	LFCNT
  0A77'   2A 0000*              	LHLD	LNDLT
  0A7A'   19                    	DAD	D
  0A7B'   22 0000*              	SHLD	LNDLT
  0A7E'   CD 0000*              	CALL	UPDMARK		; the record the first byte lands in changes
                                				;   (before the store, as PUTGAP and INSBLK do)
  0A81'   21 0000               	LXI	H,0
  0A84'   E5                    	PUSH	H		; how many are in so far
  0A85'                         URSILP:
  0A85'   D1                    	POP	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0A86'   D5                    	PUSH	D
  0A87'   2A 0000*              	LHLD	UNDLN
  0A8A'   CD 05E3'              	CALL	SUBHD		; HL = how many are still to go
  0A8D'   7C                    	MOV	A,H
  0A8E'   B5                    	ORA	L
  0A8F'   CA 0ACE'              	JZ	URSIDN
  0A92'   E5                    	PUSH	H
  0A93'   21 0000*              	LXI	H,GAPBEG
  0A96'   CD 04B9'              	CALL	PRSPAN		; BC = the gap
  0A99'   78                    	MOV	A,B
  0A9A'   B1                    	ORA	C
  0A9B'   CC 00B9'              	CZ	MKGAPB		; room is made only when the gap is empty, as
  0A9E'   21 0000*              	LXI	H,GAPBEG	;   PUTGAP's GAPRSV makes it, so this pages
  0AA1'   CD 04B9'              	CALL	PRSPAN		;   exactly where a byte at a time would
  0AA4'   E1                    	POP	H		; HL = still to go, BC = the gap
  0AA5'   50                    	MOV	D,B
  0AA6'   59                    	MOV	E,C
  0AA7'   CD 0601'              	CALL	CMP16		; CY iff the gap holds fewer
  0AAA'   DA 0AAF'              	JC	URSIRN		; ... then a run of all the gap
  0AAD'   44                    	MOV	B,H
  0AAE'   4D                    	MOV	C,L		; ... else a run of the rest
  0AAF'                         URSIRN:
  0AAF'   E1                    	POP	H		; HL = how many are in
  0AB0'   E5                    	PUSH	H
  0AB1'   09                    	DAD	B
  0AB2'   E3                    	XTHL			; (in after this run) stacked, HL = in before
  0AB3'   EB                    	XCHG
  0AB4'   2A 0000*              	LHLD	UNDBO
  0AB7'   19                    	DAD	D
  0AB8'   EB                    	XCHG
  0AB9'   2A 0000*              	LHLD	UBEG		; re-read every run: making room can slide the
  0ABC'   19                    	DAD	D		;   region out from under it
  0ABD'   E5                    	PUSH	H		; the source
  0ABE'   2A 0000*              	LHLD	GAPBEG
  0AC1'   E5                    	PUSH	H
  0AC2'   09                    	DAD	B
  0AC3'   22 0000*              	SHLD	GAPBEG		; the gap begins past the run
  0AC6'   D1                    	POP	D		; DE = where it goes
  0AC7'   E1                    	POP	H		; HL = the source
  0AC8'   CD 0500'              	CALL	MEMCPY
  0ACB'   C3 0A85'              	JMP	URSILP
  0ACE'                         URSIDN:
  0ACE'   E1                    	POP	H
  0ACF'   CD 0000*              	CALL	UPDMARK		; (SETGAPB's, at the new GAPBEG)
  0AD2'   2A 0000*              	LHLD	UNDLN		; the marks follow the run once, as they do a
  0AD5'   44                    	MOV	B,H		;   put (UNDGET): the edit found from the
  0AD6'   4D                    	MOV	C,L		;   cursor, now past the bytes
  0AD7'   CD 066C'              	CALL	CUROFF
  0ADA'   50                    	MOV	D,B
  0ADB'   59                    	MOV	E,C
  0ADC'   CD 05E3'              	CALL	SUBHD		; HL = where the bytes began
  0ADF'   3E 01                 	MVI	A,UR_INS
  0AE1'   CD 087B'              	CALL	EDTGO
  0AE4'   F1                    	POP	PSW
  0AE5'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


                                ;URGOTO -- the cursor to the record's offset.  The line the first step is on
                                ;is the change's (UNDL0 = LNDLT there, which GOTO keeps up); a later step on
                                ;another line makes the change more than one line's (UNDML).
  0AE6'                         URGOTO:
  0AE6'   2A 0000*              	LHLD	UNDOF
  0AE9'   CD 07E2'              	CALL	UNDSHF		; (an earlier step may have paged)
  0AEC'   CD 06BD'              	CALL	GOTO
  0AEF'   2A 0000*              	LHLD	LNDLT
  0AF2'   EB                    	XCHG
  0AF3'   3A 0000*              	LDA	UNDML
  0AF6'   3C                    	INR	A
  0AF7'   C2 0B02'              	JNZ	URG_1
  0AFA'   32 0000*              	STA	UNDML		; (0: one line, so far)
  0AFD'   EB                    	XCHG
  0AFE'   22 0000*              	SHLD	UNDL0
  0B01'   C9                    	RET
  0B02'                         URG_1:
  0B02'   2A 0000*              	LHLD	UNDL0
  0B05'   CD 0601'              	CALL	CMP16
  0B08'   C8                    	RZ
  0B09'   3E 01                 	MVI	A,1
  0B0B'   32 0000*              	STA	UNDML
  0B0E'   C9                    	RET
                                
                                ;URLNQ -- the step about to be taken at the cursor puts the record's bytes in
                                ;(A = 1) or takes them out (A = 2).  UNDLK stays that for as long as every
                                ;step does the same, with whole lines -- it starts at a line's start and the
                                ;bytes end in a line end -- and at the place the first one did (UNDLL0 =
                                ;LNDLT there); UNDLC counts the lines.  Anything else and UNDLK is 0FFH.
                                ;Two more ways of taking a whole line out are known for what they are: steps
                                ;at one line's start that end with a line only when the last has gone (UNDLK
                                ;is 3 until then), and one step from a line's END that takes its line end and
                                ;the next line's text -- the line under it, so UNDLL0 is that line's.
                                ;CMD.MAC opens the rows for lines put back, or closes them up, by these.
  0B0F'                         URLNQ:
  0B0F'   47                    	MOV	B,A
  0B10'   3A 0000*              	LDA	UNDLK
  0B13'   B7                    	ORA	A
  0B14'   CA 0B31'              	JZ	URL_1
  0B17'   F6 01                 	ORI	1		; (2 and 3 are both lines going)
  0B19'   4F                    	MOV	C,A
  0B1A'   78                    	MOV	A,B
  0B1B'   F6 01                 	ORI	1
  0B1D'   B9                    	CMP	C
  0B1E'   C2 0BE1'              	JNZ	URL_NO
  0B21'   2A 0000*              	LHLD	UNDLL0
  0B24'   EB                    	XCHG
  0B25'   2A 0000*              	LHLD	LNDLT
  0B28'   CD 0601'              	CALL	CMP16
  0B2B'   C2 0BE1'              	JNZ	URL_NO
  0B2E'   C3 0B37'              	JMP	URL_2
  0B31'                         URL_1:
  0B31'   2A 0000*              	LHLD	LNDLT
  0B34'   22 0000*              	SHLD	UNDLL0
  0B37'                         URL_2:
  0B37'   CD 066C'              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0B3A'   7C                    	MOV	A,H
  0B3B'   B5                    	ORA	L
  0B3C'   CA 0B90'              	JZ	URL_3
  0B3F'   2A 0000*              	LHLD	GAPBEG
  0B42'   2B                    	DCX	H
  0B43'   7E                    	MOV	A,M
  0B44'   FE 0A                 	CPI	LF
  0B46'   CA 0B90'              	JZ	URL_3
                                	;--- not at a line's start.  One step that takes out a line end and
                                	;    what follows it as far as the next ('o' and what was typed) is
                                	;    the line under that one going, all the same: UNDLL0 as for it ---
  0B49'   78                    	MOV	A,B
  0B4A'   FE 02                 	CPI	2
  0B4C'   C2 0BE1'              	JNZ	URL_NO
  0B4F'   3A 0000*              	LDA	UNDLK
  0B52'   B7                    	ORA	A
  0B53'   C2 0BE1'              	JNZ	URL_NO
  0B56'   2A 0000*              	LHLD	UNDBO
  0B59'   EB                    	XCHG
  0B5A'   2A 0000*              	LHLD	UBEG
  0B5D'   19                    	DAD	D
  0B5E'   7E                    	MOV	A,M
  0B5F'   FE 0D                 	CPI	CR
  0B61'   CA 0B69'              	JZ	URL_B0
  0B64'   FE 0A                 	CPI	LF
  0B66'   C2 0BE1'              	JNZ	URL_NO
  0B69'                         URL_B0:
  0B69'   2A 0000*              	LHLD	UNDLN
  0B6C'   EB                    	XCHG
  0B6D'   2A 0000*              	LHLD	GAPEND
  0B70'   19                    	DAD	D
  0B71'   EB                    	XCHG			; DE = the text after what goes
  0B72'   2A 0000*              	LHLD	TXTEND
  0B75'   CD 0601'              	CALL	CMP16
  0B78'   D2 0B86'              	JNC	URL_B1		; (the end of the text)
  0B7B'   1A                    	LDAX	D
  0B7C'   FE 0D                 	CPI	CR
  0B7E'   CA 0B86'              	JZ	URL_B1
  0B81'   FE 0A                 	CPI	LF
  0B83'   C2 0BE1'              	JNZ	URL_NO
  0B86'                         URL_B1:
  0B86'   2A 0000*              	LHLD	UNDLL0
  0B89'   23                    	INX	H
  0B8A'   22 0000*              	SHLD	UNDLL0
  0B8D'   C3 0BB0'              	JMP	URL_4
  0B90'                         URL_3:
  0B90'   2A 0000*              	LHLD	UNDLN
  0B93'   7C                    	MOV	A,H
  0B94'   B5                    	ORA	L
  0B95'   CA 0BE1'              	JZ	URL_NO
  0B98'   EB                    	XCHG
  0B99'   2A 0000*              	LHLD	UNDBO
  0B9C'   19                    	DAD	D
  0B9D'   EB                    	XCHG
  0B9E'   2A 0000*              	LHLD	UBEG
  0BA1'   19                    	DAD	D		; HL = past the record's bytes
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0BA2'   2B                    	DCX	H
  0BA3'   7E                    	MOV	A,M
  0BA4'   FE 0A                 	CPI	LF
  0BA6'   CA 0BB0'              	JZ	URL_4
  0BA9'   78                    	MOV	A,B		; steps that take text out at one place take
  0BAA'   FE 02                 	CPI	2		;   what is there each time, so it is the last
  0BAC'   C2 0BE1'              	JNZ	URL_NO		;   of them that has to end with a line: 3
  0BAF'   04                    	INR	B		;   until it does ('O': the text typed goes,
  0BB0'                         URL_4:				;   then the line end before it)
  0BB0'   2A 0000*              	LHLD	UNDLN
  0BB3'   EB                    	XCHG
  0BB4'   2A 0000*              	LHLD	UNDBO
  0BB7'   19                    	DAD	D
  0BB8'   EB                    	XCHG
  0BB9'   2A 0000*              	LHLD	UBEG
  0BBC'   19                    	DAD	D
  0BBD'   E5                    	PUSH	H
  0BBE'   2A 0000*              	LHLD	UNDBO
  0BC1'   EB                    	XCHG
  0BC2'   2A 0000*              	LHLD	UBEG
  0BC5'   19                    	DAD	D
  0BC6'   EB                    	XCHG			; DE = their start
  0BC7'   E1                    	POP	H
  0BC8'   C5                    	PUSH	B
  0BC9'   CD 06ED'              	CALL	LFCNT
  0BCC'   C1                    	POP	B
  0BCD'   7A                    	MOV	A,D
  0BCE'   B7                    	ORA	A
  0BCF'   C2 0BE1'              	JNZ	URL_NO
  0BD2'   3A 0000*              	LDA	UNDLC
  0BD5'   83                    	ADD	E
  0BD6'   DA 0BE1'              	JC	URL_NO
  0BD9'   32 0000*              	STA	UNDLC
  0BDC'   78                    	MOV	A,B
  0BDD'   32 0000*              	STA	UNDLK
  0BE0'   C9                    	RET
  0BE1'                         URL_NO:
  0BE1'   3E FF                 	MVI	A,0FFH
  0BE3'   32 0000*              	STA	UNDLK
  0BE6'   C9                    	RET
                                
                                ;---------------------------------------------------------------- the hooks
                                
                                ;UNDPUT -- PUTGAP's tail: the one byte now sitting just below the cursor.
  0BE7'                         UNDPUT:
  0BE7'   F5                    	PUSH	PSW
  0BE8'   C5                    	PUSH	B
  0BE9'   D5                    	PUSH	D
  0BEA'   E5                    	PUSH	H
  0BEB'   CD 066C'              	CALL	CUROFF
  0BEE'   2B                    	DCX	H
  0BEF'   01 0001               	LXI	B,1
  0BF2'   3E 01                 	MVI	A,UR_INS
  0BF4'   CD 07FD'              	CALL	UNDCHG
  0BF7'   C3 0C55'              	JMP	UNDHX
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


                                ;UNDGET -- QGET's tail: BC bytes of register now in, the cursor past them.
                                ;UNDINS is the same entry by its general name: INSBLK itself carries NO hook
                                ;(insert mode records a byte at a time through PUTGAP), so a command that
                                ;splices a block in -- ':s' replacing a match -- has to say so itself, exactly
                                ;as QGET does.  Without it 'u' puts the deleted text back and leaves the
                                ;inserted text there ('a-a-a' undid to 'aZ-aZ-aZ').
  0BFA'                         UNDINS:
  0BFA'                         UNDGET:
  0BFA'   F5                    	PUSH	PSW
  0BFB'   C5                    	PUSH	B
  0BFC'   D5                    	PUSH	D
  0BFD'   E5                    	PUSH	H
  0BFE'   78                    	MOV	A,B
  0BFF'   B1                    	ORA	C
  0C00'   CA 0C55'              	JZ	UNDHX
  0C03'   CD 066C'              	CALL	CUROFF
  0C06'   50                    	MOV	D,B
  0C07'   59                    	MOV	E,C
  0C08'   CD 05E3'              	CALL	SUBHD		; HL = where the put began
  0C0B'   3E 01                 	MVI	A,UR_INS
  0C0D'   CD 07FD'              	CALL	UNDCHG
  0C10'   C3 0C55'              	JMP	UNDHX
                                
                                ;UNDDLF -- DELFWD's head: HL bytes about to go forward from the cursor.
  0C13'                         UNDDLF:
  0C13'   F5                    	PUSH	PSW
  0C14'   C5                    	PUSH	B
  0C15'   D5                    	PUSH	D
  0C16'   E5                    	PUSH	H
  0C17'   44                    	MOV	B,H
  0C18'   4D                    	MOV	C,L
  0C19'   CD 066C'              	CALL	CUROFF
  0C1C'   3E 02                 	MVI	A,UR_DEL
  0C1E'   CD 07FD'              	CALL	UNDCHG
  0C21'   C3 0C55'              	JMP	UNDHX
                                
                                ;UNDDLQ -- QPUTLN's head: BC bytes of whole lines about to go into the register.
  0C24'                         UNDDLQ:
  0C24'   F5                    	PUSH	PSW
  0C25'   C5                    	PUSH	B
  0C26'   D5                    	PUSH	D
  0C27'   E5                    	PUSH	H
  0C28'   CD 066C'              	CALL	CUROFF
  0C2B'   3E 02                 	MVI	A,UR_DEL
  0C2D'   CD 07FD'              	CALL	UNDCHG
  0C30'   C3 0C55'              	JMP	UNDHX
                                
                                ;UNDDLP -- DELPRV's head: the one byte just below the cursor, about to go.
  0C33'                         UNDDLP:
  0C33'   F5                    	PUSH	PSW
  0C34'   C5                    	PUSH	B
  0C35'   D5                    	PUSH	D
  0C36'   E5                    	PUSH	H
  0C37'   CD 066C'              	CALL	CUROFF
  0C3A'   2B                    	DCX	H
  0C3B'   01 0001               	LXI	B,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0C3E'   3E 02                 	MVI	A,UR_DEL
  0C40'   CD 07FD'              	CALL	UNDCHG
  0C43'   C3 0C55'              	JMP	UNDHX
                                
                                ;UNDUDF -- UNDELF's tail: the byte DELTO just made text again, at the cursor.
  0C46'                         UNDUDF:
  0C46'   F5                    	PUSH	PSW
  0C47'   C5                    	PUSH	B
  0C48'   D5                    	PUSH	D
  0C49'   E5                    	PUSH	H
  0C4A'   CD 066C'              	CALL	CUROFF
  0C4D'   01 0001               	LXI	B,1
  0C50'   3E 01                 	MVI	A,UR_INS
  0C52'   CD 07FD'              	CALL	UNDCHG
                                ;UNDHX -- every hook leaves the primitive's own registers and flags alone.
  0C55'                         UNDHX:
  0C55'   E1                    	POP	H
  0C56'   D1                    	POP	D
  0C57'   C1                    	POP	B
  0C58'   F1                    	POP	PSW
  0C59'   C9                    	RET
                                
                                ;============================================================
                                ; DATA -- what the image carries: the cells that start at something.
                                ;============================================================
                                ;The cells that start at zero are not in the image: RSV.MAC names them, in
                                ;the RAM just above it, and BUF.MAC's ZINIT clears them before anything runs.
                                ;Their order there is the order they had here, and code depends on it.
                                ;WM's (base,limit) pointer row, the search pattern and 'u''s state are there.
                                	EXTRN	BUFBEG, QBEG, QEND, HOLEQP, TXTBAS, UBEG
                                	EXTRN	UEND, TXTBEG, GAPBEG, GAPEND, TXTEND, PRTERM
                                	EXTRN	BUFEND, MVGTOP, ERRFLG, SRCHBF, SRCHST, L2756
                                	EXTRN	QCPDON, UNDN, UNDST, UNDBAD, UNDRPL, UNDDIR
                                	EXTRN	UNDWHY, UNDTY, UNDOF, UNDLN, UNDBO, UNDCL
                                	EXTRN	UNDLSA, UNDPG, UNDPTR, UNDPCU, UNDCUR, UNDPCO
                                	EXTRN	UNDLK, UNDLC, UNDLL0, UNDML, UNDL0, LNDLT
                                
  0C5A'   1E                    SRCMAX: DB	SRMAX		; SRCHST's capacity, so CMD.MAC cannot drift
  0C5B'   01                    UNDNEW: DB	1		; 'u': 1 = the next capture starts a new change
                                
                                ;PBEGMEM -- base of the text arena: the first RAM byte past everything the
                                ;program holds.  The gap buffer's text lives from here up to BUFEND.  BUF
                                ;links last but RSV.MAC links after it, holding the reserve block in the RAM
                                ;immediately above the image (it emits no bytes of its own), so the arena
                                ;starts at RSVTOP -- past the reserves -- and is the size it always was.
  0C5C'   0000*                 PBEGMEM:DW	RSVTOP
                                
  0C5E'                         MEMBAS:				; top of the linked image (RSV.MAC's base)
                                
                                	END
