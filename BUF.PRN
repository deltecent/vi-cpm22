  05C2'   37                    	STC
  05C3'   C9                    	RET
                                
                                ;SUBCP2 -- WM 5365: HL := max(0, DE-HL); CY if positive.
  05C4'                         SUBCP2:			       ; WM 5365
  05C4'   CD 05A6'              	CALL	CMP16
  05C7'   CA 05B8'              	JZ	SCLPZ
  05CA'   DA 05B8'              	JC	SCLPZ
  05CD'   EB                    	XCHG
  05CE'   CD 0588'              	CALL	SUBHD
  05D1'   37                    	STC
  05D2'   C9                    	RET
                                
                                
                                ;POPRET -- WM 5387: shared epilogue for the PUSH B/PUSH D/PUSH H prologue.
  05D3'                         POPRET:				; WM 5387
  05D3'   E1                    	POP	H
  05D4'   D1                    	POP	D
  05D5'   C1                    	POP	B
  05D6'   C9                    	RET
                                
                                ;============================================================
                                ; PAGESTP -- the count-limited scroll step.  The disk-eviction seam
                                ; (MKROOM/SPILL/SPILLB/PAGEBOT/REWIND), the deque marks (MARKGB/UPDMARK/RECBASE/
                                ; PTRREC) and the paging drivers (PAGEDIR/PGNEED/PAGEWIN) are all real in
                                ; PAGE.MAC, and CNTTST/CMDCNT/AUXCNT now exist in CMD.MAC.
                                ;============================================================
                                
                                ;PAGESTP -- WM 4311: page one step in the scroll direction, count-limited.
                                ;CNTTST returns Z when the command count (CMDCNT and AUXCNT) is exhausted, so a
                                ;completed edit or motion stops here (RZ); otherwise fall into PAGEDIR to page
                                ;the window one increment in the current scroll direction (DIRFLG: REWIND back,
                                ;FILLBUF forward).  In WM PAGESTP falls through to the physically adjacent
                                ;PAGEDIR; here PAGEDIR lives in PAGE.MAC, so the fall-through is an explicit
                                ;JMP -- same object behavior, PAGEDIR's own POLLBRK still runs.  DELTO's tail
                                ;JMPs here, so a delete made with the count spent returns at once; the count
                                ;loops (dd's QPUTLN, MVLLOOP's line moves, the search sweep through SCRLST)
                                ;are what page the window on past its edge.
                                ;SCRLST -- WM 4307: poll type-ahead, PUTCUR to HL, then (count not spent)
                                ;fall into PAGESTP to page the window one step in the DIRFLG direction.
  05D7'                         SCRLST:				; WM 4307
  05D7'   CD 0000*              	CALL	POLLBRK
  05DA'   CD 039B'              	CALL	PUTCUR
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


                                
  05DD'                         PAGESTP:			; WM 4311
  05DD'   CD 0000*              	CALL	CNTTST
  05E0'   C8                    	RZ
  05E1'   C3 0000*              	JMP	PAGEDIR
                                
                                ;============================================================
                                ; ERRMSG -- WM 664, message-print transcribed; TAIL adapted (see header):
                                ; print the inline 0-terminated message, set ERRFLG, warm-boot to CP/M.
                                ; The message is printed where ERRHK leaves the cursor: VI.MAC points it at the
                                ; screen teardown, so it lands on the bottom row with the terminal restored, as
                                ; a quit leaves it; a harness with no screen leaves it on a RET.  The work files
                                ; are dropped before the warm boot, as a quit drops them.  A second error from
                                ; inside either step ends here too: DISCRD clears its own flag before it
                                ; deletes, so it cannot run twice.
                                ;============================================================
  05E4'                         ERRMSG:				; WM 664 (tail adapted)
  05E4'   3E FF                 	MVI	A,0FFH
  05E6'   32 0A37'              	STA	ERRFLG		; record that an error fired
  05E9'   2A 0609'              	LHLD	ERRHK
  05EC'   CD 0607'              	CALL	ERMGO		; the cursor to where the message belongs
  05EF'   E1                    	POP	H		; HL -> inline message (after the CALL)
  05F0'                         ERMLP:
  05F0'   7E                    	MOV	A,M
  05F1'   B7                    	ORA	A
  05F2'   CA 0601'              	JZ	ERMEND
  05F5'   E5                    	PUSH	H
  05F6'   5F                    	MOV	E,A
  05F7'   0E 02                 	MVI	C,2		; BDOS console out
  05F9'   CD 0005               	CALL	BDOS
  05FC'   E1                    	POP	H
  05FD'   23                    	INX	H
  05FE'   C3 05F0'              	JMP	ERMLP
  0601'                         ERMEND:
  0601'   CD 0000*              	CALL	DISCRD		; no name.$$$ / VIBACKUP.$$$ left behind
  0604'   C3 0000               	JMP	WBOOT		; adapted tail: back to CP/M
  0607'   E9                    ERMGO:	PCHL
  0608'   C9                    ERMNUL: RET
  0609'   0608'                 ERRHK:	DW	ERMNUL		; the screen's teardown, once there is a screen
                                
                                ;============================================================
                                ; LOGICAL-OFFSET API  (APPENDED -- NOT WordMaster).
                                ; The gap-agnostic view the vi layer (CMD.MAC) uses so it never touches the raw
                                ; pointer row.  A logical offset is a byte index into resident text as if the
                                ; gap were absent:
                                ;   before = GAPBEG - TXTBEG   (bytes before the cursor = cursor logical offset)
                                ;   after  = TXTEND - GAPEND   (bytes at/after the cursor)
                                ;   LOGLEN = before + after
                                ; Most of CMD.MAC's verbs work in these offsets alone; the rest drive WM's
                                ; pointer-based routines (PUTCUR, the line moves, RGET, the matchers, the
                                ; Q-buffer), which page as they go, and a few read the pointer row directly.
                                ;============================================================
                                
                                ;CUROFF -- HL = cursor logical offset (= before length).
  060B'                         CUROFF:
  060B'   2A 0A2D'              	LHLD	TXTBEG
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  060E'   EB                    	XCHG
  060F'   2A 0A2F'              	LHLD	GAPBEG
  0612'   CD 0588'              	CALL	SUBHD		; HL = GAPBEG - TXTBEG
  0615'   C9                    	RET
                                
                                ;AFTLN2 -- HL = after length (TXTEND - GAPEND).  Private helper for LOGLEN.
  0616'                         AFTLN2:
  0616'   2A 0A31'              	LHLD	GAPEND
  0619'   EB                    	XCHG
  061A'   2A 0A33'              	LHLD	TXTEND
  061D'   CD 0588'              	CALL	SUBHD
  0620'   C9                    	RET
                                
                                ;LOGLEN -- HL = total resident logical length.
  0621'                         LOGLEN:
  0621'   CD 060B'              	CALL	CUROFF
  0624'   E5                    	PUSH	H
  0625'   CD 0616'              	CALL	AFTLN2
  0628'   D1                    	POP	D
  0629'   19                    	DAD	D
  062A'   C9                    	RET
                                
                                ;L2PHYS -- HL(off) -> HL(physical address).  0 <= off <= LOGLEN.  Private.
  062B'                         L2PHYS:
  062B'   EB                    	XCHG			; DE = off
  062C'   D5                    	PUSH	D
  062D'   CD 060B'              	CALL	CUROFF		; HL = before
  0630'   D1                    	POP	D		; DE = off
  0631'   CD 05A6'              	CALL	CMP16		; DE=off vs HL=before: CY iff off < before
  0634'   DA 0641'              	JC	L2P_BEF
                                	;--- after region: phys = GAPEND + (off - before) ---
  0637'   EB                    	XCHG			; HL=off, DE=before
  0638'   CD 0588'              	CALL	SUBHD		; HL = off - before
  063B'   EB                    	XCHG			; DE = off-before
  063C'   2A 0A31'              	LHLD	GAPEND
  063F'   19                    	DAD	D
  0640'   C9                    	RET
  0641'                         L2P_BEF:
                                	;--- before region: phys = TXTBEG + off  (DE = off, HL = before) ---
  0641'   2A 0A2D'              	LHLD	TXTBEG
  0644'   19                    	DAD	D
  0645'   C9                    	RET
                                
                                ;CHARAT -- HL(off) -> A = byte at that logical offset (off < LOGLEN).
  0646'                         CHARAT:
  0646'   CD 062B'              	CALL	L2PHYS
  0649'   7E                    	MOV	A,M
  064A'   C9                    	RET
                                
                                ;CLAMPL -- HL(off) -> HL clamped to [0, LOGLEN].  Private helper for GOTO.
  064B'                         CLAMPL:
  064B'   E5                    	PUSH	H
  064C'   CD 0621'              	CALL	LOGLEN
  064F'   D1                    	POP	D		; DE = off
  0650'   CD 05A6'              	CALL	CMP16		; DE=off vs HL=LOGLEN
  0653'   DA 065A'              	JC	CLK_KEEP	; off < LOGLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  0656'   CA 065A'              	JZ	CLK_KEEP	; off == LOGLEN
  0659'   C9                    	RET			; off > LOGLEN -> HL = LOGLEN
  065A'                         CLK_KEEP:
  065A'   EB                    	XCHG			; HL = off
  065B'   C9                    	RET
                                
                                ;GOTO -- HL(off): move the cursor to that logical offset.
                                ;PUTCUR takes its target address in HL (its entry XCHG moves it to DE).
                                ;The line feeds the cursor crosses are added to LNDLT (subtracted going back).
  065C'                         GOTO:
  065C'   CD 064B'              	CALL	CLAMPL
  065F'   CD 062B'              	CALL	L2PHYS		; HL = physical address
  0662'   E5                    	PUSH	H
  0663'   EB                    	XCHG			; DE = target
  0664'   2A 0A31'              	LHLD	GAPEND
  0667'   CD 05A6'              	CALL	CMP16		; CY iff target < GAPEND (before the gap)
  066A'   DA 0678'              	JC	GTO_BK
  066D'   EB                    	XCHG			; forward: count [GAPEND, target)
  066E'   CD 068C'              	CALL	LFCNT
  0671'   2A 0A78'              	LHLD	LNDLT
  0674'   19                    	DAD	D
  0675'   C3 0684'              	JMP	GTO_ST
  0678'                         GTO_BK:
  0678'   2A 0A2F'              	LHLD	GAPBEG		; back: count [target, GAPBEG)
  067B'   CD 068C'              	CALL	LFCNT
  067E'   2A 0A78'              	LHLD	LNDLT
  0681'   CD 0588'              	CALL	SUBHD
  0684'                         GTO_ST:
  0684'   22 0A78'              	SHLD	LNDLT
  0687'   E1                    	POP	H
  0688'   CD 039B'              	CALL	PUTCUR
  068B'   C9                    	RET
                                
                                ;LFCNT -- DE = start, HL = end (>= start): DE = number of LFs in [start, end).
  068C'                         LFCNT:
  068C'   CD 0588'              	CALL	SUBHD		; HL = end - start
  068F'   44                    	MOV	B,H
  0690'   4D                    	MOV	C,L		; BC = length
  0691'   EB                    	XCHG			; HL = start
  0692'   11 0000               	LXI	D,0
  0695'                         LFC_LP:
  0695'   78                    	MOV	A,B
  0696'   B1                    	ORA	C
  0697'   C8                    	RZ
  0698'   7E                    	MOV	A,M
  0699'   23                    	INX	H
  069A'   0B                    	DCX	B
  069B'   FE 0A                 	CPI	LF
  069D'   C2 0695'              	JNZ	LFC_LP
  06A0'   13                    	INX	D
  06A1'   C3 0695'              	JMP	LFC_LP
                                
                                ;RDGET -- RGET, and CY also when a refill read nothing.  INRDY stays set after
                                ;a file's last full record (no ^Z) until a read fails; NEEDIN then returns NC
                                ;having added nothing, and RGET steps past TXTEND leaving BC = FFFFH.  That is
                                ;reported as the end of the text, with BC = 0 so a later call asks NEEDIN again.
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  06A4'                         RDGET:
  06A4'   CD 04E6'              	CALL	RGET
  06A7'   D8                    	RC
  06A8'   F5                    	PUSH	PSW
  06A9'   78                    	MOV	A,B
  06AA'   A1                    	ANA	C
  06AB'   3C                    	INR	A		; Z iff BC = FFFFH
  06AC'   CA 06B1'              	JZ	RDG_EF
  06AF'   F1                    	POP	PSW
  06B0'   C9                    	RET
  06B1'                         RDG_EF:
  06B1'   F1                    	POP	PSW
  06B2'   01 0000               	LXI	B,0
  06B5'   37                    	STC
  06B6'   C9                    	RET
                                
                                ;DELFWD -- HL = number of logical bytes to delete forward from the cursor.
  06B7'                         DELFWD:
  06B7'   7C                    	MOV	A,H
  06B8'   B5                    	ORA	L
  06B9'   C8                    	RZ			; nothing to delete
  06BA'   CD 09D8'              	CALL	UNDDLF		; (appended) the span, for 'u', before it goes
  06BD'   EB                    	XCHG			; DE = count
  06BE'   2A 0A31'              	LHLD	GAPEND
  06C1'   19                    	DAD	D		; target = GAPEND + count
  06C2'   AF                    	XRA	A		; S clear -> forward delete
  06C3'   CD 01CA'              	CALL	DELTO
  06C6'   C9                    	RET
                                
                                ;DELPRV -- WM 3260 RUBOUT/DELL: delete the char left of the cursor, and the
                                ;CR too when that leaves one there (a CR,LF goes as one).  PEEKLX pages back
                                ;at the window start and returns at the start of the file.  WM's MARKCUR and
                                ;ROWUP (its screen) are left out; instead a deleted LF moves the cursor up a
                                ;line (LNDLT - 1) for SCRN.MAC.
  06C7'                         DELPRV:				; WM 3260
  06C7'   CD 01C3'              	CALL	PEEKLX
  06CA'   FE 0A                 	CPI	LF
  06CC'   C2 06D8'              	JNZ	DLP_GO
  06CF'   E5                    	PUSH	H
  06D0'   2A 0A78'              	LHLD	LNDLT
  06D3'   2B                    	DCX	H
  06D4'   22 0A78'              	SHLD	LNDLT
  06D7'   E1                    	POP	H
  06D8'                         DLP_GO:				; WM 3263 DELL
  06D8'   CD 09F8'              	CALL	UNDDLP		; (appended) that byte, for 'u', before it goes
  06DB'   CD 0055'              	CALL	SETGAPB
  06DE'   CD 01B6'              	CALL	PEEKL
  06E1'   FE 0D                 	CPI	CR
  06E3'   CA 06C7'              	JZ	DELPRV
  06E6'   C9                    	RET
                                
                                
                                ;UNDELF -- APPENDED, NOT WordMaster: give back the byte last swallowed forward
                                ;into the gap.  A forward delete only moves GAPEND past the byte, so the byte
                                ;itself is still there, inside the gap: GAPEND-1 through DELTO makes it text
                                ;again, with the record marks updated exactly as a delete updates them.
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                                ;Replace mode ('R') puts back with it what it overwrote, as vim's BS in Replace
                                ;mode does.  The caller must know the gap has not moved since the delete
                                ;(CMD.MAC keeps GAPEND in RPGE for that); nothing else calls this.
  06E7'                         UNDELF:
  06E7'   2A 0A31'              	LHLD	GAPEND
  06EA'   2B                    	DCX	H
  06EB'   AF                    	XRA	A		; S clear -> the forward (GAPEND) side
  06EC'   CD 01CA'              	CALL	DELTO
  06EF'   C3 0A0B'              	JMP	UNDUDF		; (appended) the byte just made text again
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  APPENDED, NOT WordMaster: WM has no undo at all (its QBUFOP /
                                ; QEXEC macro is a command-LINE facility, not this).
                                ;
                                ; Six primitives change resident text, and each one says what it did: PUTGAP
                                ; (one byte in), QGET (the register in), DELFWD (a span out), DELPRV (one byte
                                ; out backward), UNDELF (one byte back in) and QPUTLN (whole lines out).
                                ; Nothing else in the editor reaches the text, so no command can forget to
                                ; record itself -- which is the whole reason the capture sits down here instead
                                ; of at CMD.MAC's edit sites.
                                ;
                                ; A record says only WHERE and HOW MUCH, in LOGICAL offsets, plus where its
                                ; bytes lie in the undo region.  Logical offsets survive the gap sliding (which
                                ; PUTCUR does on every cursor move) because the replay walks the records
                                ; BACKWARD: each step restores the offsets the steps after it were measured
                                ; against.  The bytes are kept for an insert as well as a delete -- an insert
                                ; costs its own text twice, which is nothing -- so the region is settled once
                                ; the command ends and 'u' can walk it either way: backward applying each
                                ; record's inverse to undo, forward applying the records as they stand to redo.
                                ; That is what makes 'u' undo 'u' with ONE region and no capture during the
                                ; replay.
                                ;
                                ; The region is a region of the arena like the Q buffer, inserted between the
                                ; slider and the text, and it grows through the same MKGAP: the pointer row
                                ; reads (UBEG,UEND) as data and (TXTBAS,UBEG) / (UEND,TXTBEG) as the holes
                                ; around it, so NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN and INIBAS all take it in
                                ; their stride unchanged.
                                ;
                                ; DEVIATIONS from vim, all deliberate and all in COMMANDS.md: ONE level of
                                ; undo, so 'u' undoes 'u' as real vi does; the change must still be in the
                                ; RESIDENT window, and 'u' refuses once the pager has moved off it rather than
                                ; chasing it through the file; and a change with more steps than the table
                                ; holds, or one the arena has no spare room to keep, is not undoable at all.
                                ;
                                ; "Moved off it" is PGTOPM, PAGE.MAC's count of the times the pager moved
                                ; TXTBEG.  It is the window's TOP that matters: an offset is measured from
                                ; TXTBEG, so spilling a record out from under it (PAGEOUT) or reading one back
                                ; in (REWIND) shifts every offset, while FILLBUF and PAGEBOT growing TXTEND at
                                ; the bottom shift none.  The OUTREC/SRCREC water marks look like the same
                                ; thing and are not: UPDMARK raises them on every edit.
                                ;============================================================
                                
  0001                          UR_INS	EQU	1		; text went IN  (undoing takes it back out)
  0002                          UR_DEL	EQU	2		; text came OUT (undoing puts it back)
  0007                          URSIZE	EQU	7		; type, offset(2), length(2), region offset(2)
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  0018                          URMAX	EQU	24		; primitive steps one change may hold
                                ;How much of the arena the capture refuses to eat into.  It only has to keep
                                ;MKGAP off its MKROOM path (which wants 256 free), because paging is what undo
                                ;must not do -- so this is deliberately SMALL.  RESVMEM, QROOM's reserve, is
                                ;far too big: a 66 K file leaves under 1700 bytes free, and undo would never
                                ;engage at all on exactly the files that need it most.
  0200                          UNDRSV	EQU	200H		; ... 512 bytes
                                ;How much room the region claims up front, and so the largest change that can
                                ;be kept.  The claim is what lets the capture run without EVER growing the
                                ;region: see UNDGRW for why growing where a primitive can see it is unsafe.
  0400                          UNDCAP	EQU	400H		; 1024 bytes of change
                                
                                ;UNDBEG -- CMD.MAC's command boundary: the NEXT captured change starts a new
                                ;undo.  A flag only, so a command that changes nothing -- a motion, a yank, a
                                ;key that is no command at all -- leaves the last change undoable, exactly as
                                ;'.' keeps the last change it recorded.
  06F2'                         UNDBEG:
  06F2'   D5                    	PUSH	D
  06F3'   E5                    	PUSH	H
  06F4'   3E 01                 	MVI	A,1
  06F6'   32 0A60'              	STA	UNDNEW
  06F9'   CD 060B'              	CALL	CUROFF
  06FC'   22 0A74'              	SHLD	UNDPCU		; where the cursor was as this command began --
  06FF'   CD 070E'              	CALL	UNDGRW		;   kept pending, because only a command that
  0702'   E1                    	POP	H		;   really changes text gets to claim it
  0703'   D1                    	POP	D
  0704'   C9                    	RET
                                
                                ;UNDHER -- the change about to start belongs at the CURSOR: 'u' puts it back
                                ;there.  UNDBEG's cursor snapshot without its claim on the region, for a
                                ;command (':s') that cannot know where its first change will be until it has
                                ;found it.  Calling UNDBEG again instead would re-run UNDGRW in the middle of
                                ;the command, which is the one thing UNDGRW must never do -- see below.
  0705'                         UNDHER:
  0705'   E5                    	PUSH	H
  0706'   CD 060B'              	CALL	CUROFF
  0709'   22 0A74'              	SHLD	UNDPCU
  070C'   E1                    	POP	H
  070D'   C9                    	RET
                                
                                ;UNDGRW -- make sure the region can take a whole change without growing again.
                                ;THE ONLY PLACE THE REGION GROWS, and it runs at the command boundary, where no
                                ;primitive is holding anything.  Growing moves regions about (MKGAP -> MOVGAP),
                                ;and that both invalidates a raw pointer a primitive is in the middle of using
                                ;-- DELPRV hands SETGAPB one -- and overwrites whatever is sitting in the gap,
                                ;which is where a forward-deleted byte waits for 'R's backspace to call UNDELF
                                ;and give it back.  So the room is claimed here, 256 bytes at a time, and the
                                ;capture below never calls MKGAP at all: it writes into the claim or gives up.
                                ;The room has to be claimed as the region's own CONTENT, not left as the hole
                                ;above it: the holes are shared, and the text takes whatever it can reach --
                                ;MOVGAP feeding an insert will walk straight through a hole reserved here, which
                                ;is what made a 200-character insert lose its undo halfway.  Once the bytes are
                                ;inside (UBEG,UEND) the text cannot have them: MOVGAP slides the region aside
                                ;instead.  Nothing here holds an address across MKGAP either, because MKGAP
                                ;slides this very region (HOLEUP moves UBEG and UEND) -- UEND is re-read from
                                ;its cell every time round.
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  070E'                         UNDGRW:
  070E'   C5                    	PUSH	B
  070F'   D5                    	PUSH	D
  0710'   E5                    	PUSH	H
  0711'                         UNDGRL:
  0711'   21 0A29'              	LXI	H,UBEG
  0714'   CD 04D4'              	CALL	PRSPAN		; BC = the region's size
  0717'   50                    	MOV	D,B
  0718'   59                    	MOV	E,C
  0719'   21 0400               	LXI	H,UNDCAP
  071C'   CD 05A6'              	CALL	CMP16		; CY iff it is smaller than one change
  071F'   D2 05D3'              	JNC	POPRET
  0722'   CD 08A5'              	CALL	UNDRM		; ... but never at the cost of paging
  0725'   DA 05D3'              	JC	POPRET
  0728'   21 0A2B'              	LXI	H,UEND
  072B'   CD 00B0'              	CALL	MKGAP		; 256 free above the region ...
  072E'   2A 0A2B'              	LHLD	UEND
  0731'   11 0100               	LXI	D,100H
  0734'   19                    	DAD	D
  0735'   22 0A2B'              	SHLD	UEND		; ... taken into it, so the text cannot take
  0738'   C3 0711'              	JMP	UNDGRL		;     them back
                                
                                ;UNDCLR -- nothing is undoable (a fresh buffer; BINIT calls it through INIGAP).
  073B'                         UNDCLR:
  073B'   AF                    	XRA	A
  073C'   32 0A5D'              	STA	UNDN
  073F'   32 0A5E'              	STA	UNDST
  0742'   32 0A5F'              	STA	UNDBAD
  0745'   3E 01                 	MVI	A,1
  0747'   32 0A60'              	STA	UNDNEW
  074A'   C9                    	RET
                                
                                ;UNDRST -- the first capture of a new change: drop the last one and note where
                                ;the file window was, so 'u' can tell the pager has since moved off this change.
  074B'                         UNDRST:
  074B'   AF                    	XRA	A
  074C'   32 0A60'              	STA	UNDNEW
  074F'   32 0A5D'              	STA	UNDN
  0752'   32 0A5F'              	STA	UNDBAD
  0755'   21 0000               	LXI	H,0
  0758'   22 0A71'              	SHLD	UNDPTR		; the region's content empties (its SIZE stays:
                                				;   that is the room UNDGRW claimed)
  075B'   2A 0000*              	LHLD	PGTOPM
  075E'   22 0A6F'              	SHLD	UNDPG
  0761'   2A 0A74'              	LHLD	UNDPCU
  0764'   22 0A76'              	SHLD	UNDCUR		; ... and this command does change text, so this
                                				;   is where 'u' will put the cursor back
  0767'   3E 01                 	MVI	A,1
  0769'   32 0A5E'              	STA	UNDST		; a change is on the buffer: 'u' undoes it
  076C'   C9                    	RET
                                
                                ;UNDCHG -- the capture every hooked primitive uses.  A = UR_INS / UR_DEL,
                                ;HL = the logical offset it acted at, BC = how many bytes.  The bytes are read
                                ;back out of the resident TEXT at that offset -- for a delete before they go,
                                ;for an insert once they have arrived -- so no caller hands over a pointer that
                                ;growing the region could leave stale.
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  076D'                         UNDCHG:
  076D'   C5                    	PUSH	B
  076E'   D5                    	PUSH	D
  076F'   E5                    	PUSH	H
  0770'   32 0A64'              	STA	UNDTY		; the record type, kept out of the registers
  0773'   CD 07EB'              	CALL	EDTGO		; whoever else follows an edit (BC is kept)
  0776'   3A 0A61'              	LDA	UNDRPL
  0779'   B7                    	ORA	A
  077A'   C2 05D3'              	JNZ	POPRET		; 'u' replaying: its own edits are not a change
  077D'   3A 0A60'              	LDA	UNDNEW
  0780'   B7                    	ORA	A
  0781'   CA 0787'              	JZ	UNDC1
  0784'   CD 074B'              	CALL	UNDRST		; the first step of a new change
  0787'                         UNDC1:
  0787'   3A 0A5F'              	LDA	UNDBAD
  078A'   B7                    	ORA	A
  078B'   C2 05D3'              	JNZ	POPRET		; this change has already been given up on
  078E'   78                    	MOV	A,B
  078F'   B1                    	ORA	C
  0790'   CA 05D3'              	JZ	POPRET		; a zero-length step is no step
  0793'   60                    	MOV	H,B
  0794'   69                    	MOV	L,C
  0795'   22 0A6B'              	SHLD	UNDCL		; UNDAPT spends BC as its countdown, so the
                                				;   length has to be kept somewhere else
  0798'   3A 0A5D'              	LDA	UNDN
  079B'   FE 18                 	CPI	URMAX
  079D'   D2 07E3'              	JNC	UNDCBD		; no room for another step
                                	;--- where this step's bytes will land in the region ---
  07A0'   2A 0A71'              	LHLD	UNDPTR
  07A3'   22 0A69'              	SHLD	UNDBO
  07A6'   E1                    	POP	H
  07A7'   E5                    	PUSH	H		; HL = the logical offset again
  07A8'   CD 085B'              	CALL	UNDAPT		; BC bytes of the text there -> the region
  07AB'   DA 07E3'              	JC	UNDCBD
                                	;--- fold it into the last record when it only carries that one on ---
  07AE'   E1                    	POP	H
  07AF'   E5                    	PUSH	H
  07B0'   CD 0803'              	CALL	UNDEXT
  07B3'   CA 05D3'              	JZ	POPRET
                                	;--- otherwise a record of its own ---
  07B6'   3A 0A5D'              	LDA	UNDN
  07B9'   CD 07F3'              	CALL	URADDR
  07BC'   3A 0A64'              	LDA	UNDTY
  07BF'   77                    	MOV	M,A
  07C0'   23                    	INX	H
  07C1'   D1                    	POP	D
  07C2'   D5                    	PUSH	D		; DE = the logical offset
  07C3'   73                    	MOV	M,E
  07C4'   23                    	INX	H
  07C5'   72                    	MOV	M,D
  07C6'   23                    	INX	H
  07C7'   EB                    	XCHG			; DE = the record, past the offset
  07C8'   2A 0A6B'              	LHLD	UNDCL
  07CB'   EB                    	XCHG			; ... and HL back, with DE = the length
  07CC'   73                    	MOV	M,E
  07CD'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  07CE'   72                    	MOV	M,D
  07CF'   23                    	INX	H
  07D0'   3A 0A69'              	LDA	UNDBO
  07D3'   77                    	MOV	M,A
  07D4'   23                    	INX	H
  07D5'   3A 0A6A'              	LDA	UNDBO+1
  07D8'   77                    	MOV	M,A
  07D9'   3A 0A5D'              	LDA	UNDN
  07DC'   3C                    	INR	A
  07DD'   32 0A5D'              	STA	UNDN
  07E0'   C3 05D3'              	JMP	POPRET
  07E3'                         UNDCBD:
  07E3'   3E 01                 	MVI	A,1
  07E5'   32 0A5F'              	STA	UNDBAD		; too big to keep: not undoable at all
  07E8'   C3 05D3'              	JMP	POPRET
                                
                                ;EDTGO -- UNDCHG is the one place every change to the text goes by, the
                                ;replay's own included, so it is also where the editor hears of one: EDTHK is
                                ;called with A = UR_INS / UR_DEL, HL = the logical offset and BC = the length,
                                ;and must keep BC.  VI.MAC points it at the marks; a harness leaves it a RET.
  07EB'                         EDTGO:
  07EB'   E5                    	PUSH	H
  07EC'   2A 07F1'              	LHLD	EDTHK
  07EF'   E3                    	XTHL
  07F0'   C9                    	RET
  07F1'   0608'                 EDTHK:	DW	ERMNUL
                                
                                ;URADDR -- A = a record index -> HL = its address (base + n*8 - n).
  07F3'                         URADDR:
  07F3'   6F                    	MOV	L,A
  07F4'   26 00                 	MVI	H,0
  07F6'   5D                    	MOV	E,L
  07F7'   54                    	MOV	D,H
  07F8'   29                    	DAD	H
  07F9'   29                    	DAD	H
  07FA'   29                    	DAD	H		; HL = n*8
  07FB'   CD 0588'              	CALL	SUBHD		; HL = n*7
  07FE'   11 0000*              	LXI	D,UNDREC
  0801'   19                    	DAD	D
  0802'   C9                    	RET
                                
                                ;UNDEXT -- A = 0 (Z) when this step only carries the last record on: an insert
                                ;starting exactly where the last insert ended, which is what typing does.  Its
                                ;bytes already sit contiguously behind that record's, so only the length grows.
                                ;HL = this step's offset, BC = its length.
  0803'                         UNDEXT:
  0803'   C5                    	PUSH	B
  0804'   D5                    	PUSH	D
  0805'   E5                    	PUSH	H
  0806'   3A 0A64'              	LDA	UNDTY
  0809'   FE 01                 	CPI	UR_INS
  080B'   C2 0855'              	JNZ	UNDXNO		; only inserts fold
  080E'   3A 0A5D'              	LDA	UNDN
  0811'   B7                    	ORA	A
  0812'   CA 0855'              	JZ	UNDXNO		; nothing to fold into
  0815'   3D                    	DCR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0816'   CD 07F3'              	CALL	URADDR
  0819'   22 0A6D'              	SHLD	UNDLSA
  081C'   7E                    	MOV	A,M
  081D'   FE 01                 	CPI	UR_INS
  081F'   C2 0855'              	JNZ	UNDXNO
  0822'   2A 0A6D'              	LHLD	UNDLSA
  0825'   23                    	INX	H
  0826'   CD 05A1'              	CALL	LDHLI		; HL = the last record's offset
  0829'   EB                    	XCHG
  082A'   2A 0A6D'              	LHLD	UNDLSA
  082D'   23                    	INX	H
  082E'   23                    	INX	H
  082F'   23                    	INX	H
  0830'   CD 05A1'              	CALL	LDHLI		; HL = its length
  0833'   19                    	DAD	D		; HL = where it ends
  0834'   EB                    	XCHG
  0835'   E1                    	POP	H
  0836'   E5                    	PUSH	H		; HL = this step's offset
  0837'   CD 05A6'              	CALL	CMP16		; Z iff this step starts exactly there
  083A'   C2 0855'              	JNZ	UNDXNO
  083D'   2A 0A6D'              	LHLD	UNDLSA
  0840'   23                    	INX	H
  0841'   23                    	INX	H
  0842'   23                    	INX	H
  0843'   E5                    	PUSH	H
  0844'   CD 05A1'              	CALL	LDHLI		; HL = the last record's length
  0847'   EB                    	XCHG
  0848'   2A 0A6B'              	LHLD	UNDCL
  084B'   19                    	DAD	D		; ... grown by this step's
  084C'   EB                    	XCHG
  084D'   E1                    	POP	H
  084E'   73                    	MOV	M,E
  084F'   23                    	INX	H
  0850'   72                    	MOV	M,D
  0851'   AF                    	XRA	A		; Z: folded, no new record
  0852'   C3 05D3'              	JMP	POPRET
  0855'                         UNDXNO:
  0855'   3E 01                 	MVI	A,1
  0857'   B7                    	ORA	A		; NZ: it needs a record of its own
  0858'   C3 05D3'              	JMP	POPRET
                                
                                ;UNDAPT -- append BC bytes of resident text, from logical offset HL, to the
                                ;undo region.  One byte at a time, re-reading the offset through CHARAT and the
                                ;region through its pointer cell every time, so growing the region (which
                                ;slides regions about) can never leave this loop holding a stale address.
                                ;CY if it outgrows the claim, and the caller then gives the change up.
  085B'                         UNDAPT:
  085B'   78                    	MOV	A,B
  085C'   B1                    	ORA	C
  085D'   C8                    	RZ			; nothing to append
  085E'                         UNDAPL:
  085E'   C5                    	PUSH	B
  085F'   E5                    	PUSH	H
  0860'   CD 0646'              	CALL	CHARAT		; A = the text byte at this offset
  0863'   CD 0871'              	CALL	UNDAPB		; ... into the region
  0866'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0867'   C1                    	POP	B
  0868'   D8                    	RC
  0869'   23                    	INX	H
  086A'   0B                    	DCX	B
  086B'   78                    	MOV	A,B
  086C'   B1                    	ORA	C
  086D'   C2 085E'              	JNZ	UNDAPL
  0870'   C9                    	RET
                                
                                ;UNDAPB -- put the byte in A into the room UNDGRW claimed.  It does NOT grow
                                ;the region -- see UNDGRW -- so CY, and the change given up on, once the room
                                ;is used up: a change bigger than the region is simply not undoable.
  0871'                         UNDAPB:
  0871'   C5                    	PUSH	B
  0872'   D5                    	PUSH	D
  0873'   E5                    	PUSH	H
  0874'   32 0A73'              	STA	UNDB1
  0877'   21 0A29'              	LXI	H,UBEG
  087A'   CD 04D4'              	CALL	PRSPAN		; BC = the region's size
  087D'   2A 0A71'              	LHLD	UNDPTR
  0880'   EB                    	XCHG			; DE = where the next byte goes
  0881'   60                    	MOV	H,B
  0882'   69                    	MOV	L,C
  0883'   CD 05A6'              	CALL	CMP16		; CY iff that is still inside the region
  0886'   D2 089C'              	JNC	UNDAPF
  0889'   2A 0A29'              	LHLD	UBEG		; re-read: a relocation moves the region
  088C'   19                    	DAD	D
  088D'   3A 0A73'              	LDA	UNDB1
  0890'   77                    	MOV	M,A
  0891'   2A 0A71'              	LHLD	UNDPTR
  0894'   23                    	INX	H
  0895'   22 0A71'              	SHLD	UNDPTR
  0898'   B7                    	ORA	A		; CY clear: it went in
  0899'   C3 05D3'              	JMP	POPRET
  089C'                         UNDAPF:
  089C'   3E 01                 	MVI	A,1
  089E'   32 0A5F'              	STA	UNDBAD
  08A1'   37                    	STC
  08A2'   C3 05D3'              	JMP	POPRET
                                
                                ;UNDRM -- CY, and the change given up on, unless the arena still holds UNDRSV
                                ;free.  The capture must never page: paging moves the window off the change and
                                ;would invalidate every logical offset the records hold.  Keeping this much
                                ;free also keeps MKGAP off its MKROOM path, so the capture cannot page even by
                                ;accident, and it fails QUIETLY where QROOM raises 'QBUF FULL' -- undo going
                                ;away must never stop the editing.
  08A5'                         UNDRM:
  08A5'   C5                    	PUSH	B
  08A6'   D5                    	PUSH	D
  08A7'   E5                    	PUSH	H
  08A8'   CD 046E'              	CALL	BUFSUM		; DE = the arena's free bytes
  08AB'   21 0200               	LXI	H,UNDRSV
  08AE'   CD 05A6'              	CALL	CMP16		; CY iff less than that is left
  08B1'   D2 05D3'              	JNC	POPRET
  08B4'   3E 01                 	MVI	A,1
  08B6'   32 0A5F'              	STA	UNDBAD
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  08B9'   37                    	STC
  08BA'   C3 05D3'              	JMP	POPRET
                                
                                ;---------------------------------------------------------------- the replay
                                
                                ;UNDO -- 'u'.  CY when there is nothing to undo: no change captured, a change
                                ;too big to have been captured, or the pager has moved the window off it.
  08BD'                         UNDO:
  08BD'   AF                    	XRA	A
  08BE'   32 0A63'              	STA	UNDWHY		; refused for want of a change, until told else
  08C1'   3A 0A5D'              	LDA	UNDN
  08C4'   B7                    	ORA	A
  08C5'   37                    	STC
  08C6'   C8                    	RZ			; nothing captured
  08C7'   3A 0A5F'              	LDA	UNDBAD
  08CA'   B7                    	ORA	A
  08CB'   CA 08D5'              	JZ	UND_OK
  08CE'   3E 02                 	MVI	A,2
  08D0'   32 0A63'              	STA	UNDWHY		; too big to have been captured: CMD.MAC says
  08D3'   37                    	STC			;   so, rather than ringing the bell at a user
  08D4'   C9                    	RET			;   who has no way to know why
  08D5'                         UND_OK:
  08D5'   2A 0000*              	LHLD	PGTOPM
  08D8'   EB                    	XCHG
  08D9'   2A 0A6F'              	LHLD	UNDPG
  08DC'   CD 05A6'              	CALL	CMP16
  08DF'   C2 0906'              	JNZ	UNDPGD		; the pager has moved the window's top since,
                                				;   so every offset the records hold has shifted
  08E2'   3E 01                 	MVI	A,1
  08E4'   32 0A61'              	STA	UNDRPL		; the replay's own edits are not a new change
  08E7'   3A 0A5E'              	LDA	UNDST
  08EA'   FE 01                 	CPI	1
  08EC'   CA 090D'              	JZ	UNDREV
                                	;--- the last 'u' undid it: apply the records forward again (a redo) ---
  08EF'   AF                    	XRA	A
  08F0'   32 0A62'              	STA	UNDDIR
  08F3'   AF                    	XRA	A
  08F4'                         UNDFWL:
  08F4'   CD 092E'              	CALL	URSTEP
  08F7'   3C                    	INR	A
  08F8'   47                    	MOV	B,A
  08F9'   3A 0A5D'              	LDA	UNDN
  08FC'   B8                    	CMP	B
  08FD'   78                    	MOV	A,B
  08FE'   C2 08F4'              	JNZ	UNDFWL
  0901'   3E 01                 	MVI	A,1
  0903'   C3 091F'              	JMP	UNDFIN
  0906'                         UNDPGD:
  0906'   3E 01                 	MVI	A,1
  0908'   32 0A63'              	STA	UNDWHY		; the change is no longer in the window
  090B'   37                    	STC
  090C'   C9                    	RET
  090D'                         UNDREV:
                                	;--- undo: the records backward, each one's inverse ---
  090D'   3E 01                 	MVI	A,1
  090F'   32 0A62'              	STA	UNDDIR
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0912'   3A 0A5D'              	LDA	UNDN
  0915'                         UNDRVL:
  0915'   3D                    	DCR	A
  0916'   CD 092E'              	CALL	URSTEP
  0919'   B7                    	ORA	A
  091A'   C2 0915'              	JNZ	UNDRVL
  091D'   3E 02                 	MVI	A,2
  091F'                         UNDFIN:
  091F'   32 0A5E'              	STA	UNDST
  0922'   AF                    	XRA	A
  0923'   32 0A61'              	STA	UNDRPL
                                	;--- the cursor goes back where the command that changed it began:
                                	;    measured from vim, which restores that and not the change's own
                                	;    offset (CMD.MAC's VC_UNDO holds it inside the line) ---
  0926'   2A 0A76'              	LHLD	UNDCUR
  0929'   CD 065C'              	CALL	GOTO
  092C'   B7                    	ORA	A		; CY clear: it happened
  092D'   C9                    	RET
                                
                                ;URSTEP -- apply record A: as it stands when UNDDIR is 0 (a redo), inverted
                                ;when it is 1 (an undo).  An insert applied puts its saved bytes back at its
                                ;offset; an insert inverted deletes that many bytes there; a delete is the
                                ;mirror of both.  A is preserved -- UNDO's loops count with it.
  092E'                         URSTEP:
  092E'   F5                    	PUSH	PSW
  092F'   CD 07F3'              	CALL	URADDR
  0932'   7E                    	MOV	A,M
  0933'   32 0A64'              	STA	UNDTY
  0936'   23                    	INX	H
  0937'   7E                    	MOV	A,M
  0938'   32 0A65'              	STA	UNDOF
  093B'   23                    	INX	H
  093C'   7E                    	MOV	A,M
  093D'   32 0A66'              	STA	UNDOF+1
  0940'   23                    	INX	H
  0941'   7E                    	MOV	A,M
  0942'   32 0A67'              	STA	UNDLN
  0945'   23                    	INX	H
  0946'   7E                    	MOV	A,M
  0947'   32 0A68'              	STA	UNDLN+1
  094A'   23                    	INX	H
  094B'   7E                    	MOV	A,M
  094C'   32 0A69'              	STA	UNDBO
  094F'   23                    	INX	H
  0950'   7E                    	MOV	A,M
  0951'   32 0A6A'              	STA	UNDBO+1
  0954'   3A 0A64'              	LDA	UNDTY
  0957'   47                    	MOV	B,A
  0958'   3A 0A62'              	LDA	UNDDIR
  095B'   B7                    	ORA	A
  095C'   CA 0968'              	JZ	URS_AP
  095F'   78                    	MOV	A,B		; an undo inverts the record
  0960'   FE 01                 	CPI	UR_INS
  0962'   CA 096E'              	JZ	URS_DL
  0965'   C3 097C'              	JMP	URS_IN
  0968'                         URS_AP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0968'   78                    	MOV	A,B		; a redo applies it as it stands
  0969'   FE 01                 	CPI	UR_INS
  096B'   CA 097C'              	JZ	URS_IN
  096E'                         URS_DL:
                                	;--- take the record's length back out at its offset ---
  096E'   2A 0A65'              	LHLD	UNDOF
  0971'   CD 065C'              	CALL	GOTO
  0974'   2A 0A67'              	LHLD	UNDLN
  0977'   CD 06B7'              	CALL	DELFWD
  097A'   F1                    	POP	PSW
  097B'   C9                    	RET
  097C'                         URS_IN:
                                	;--- put the record's saved bytes back in at its offset ---
  097C'   2A 0A65'              	LHLD	UNDOF
  097F'   CD 065C'              	CALL	GOTO
  0982'   2A 0A67'              	LHLD	UNDLN
  0985'   44                    	MOV	B,H
  0986'   4D                    	MOV	C,L
  0987'   2A 0A69'              	LHLD	UNDBO
  098A'                         URSILP:
  098A'   C5                    	PUSH	B
  098B'   E5                    	PUSH	H
  098C'   EB                    	XCHG			; DE = the byte's offset within the region
  098D'   2A 0A29'              	LHLD	UBEG		; ... re-read every byte: inserting text can
  0990'   19                    	DAD	D		;     slide the region out from under it
  0991'   7E                    	MOV	A,M
  0992'   CD 0045'              	CALL	PUTGAP
  0995'   FE 0A                 	CPI	LF
  0997'   C2 09A1'              	JNZ	URSILN
  099A'   2A 0A78'              	LHLD	LNDLT		; a line end put back is the cursor crossing
  099D'   23                    	INX	H		;   one, and GOTO keeps LNDLT for every move the
  099E'   22 0A78'              	SHLD	LNDLT		;   replay makes -- so the renderer needs no
  09A1'                         URSILN:				;   whole-window rescan to find that out
  09A1'   E1                    	POP	H
  09A2'   C1                    	POP	B
  09A3'   23                    	INX	H
  09A4'   0B                    	DCX	B
  09A5'   78                    	MOV	A,B
  09A6'   B1                    	ORA	C
  09A7'   C2 098A'              	JNZ	URSILP
  09AA'   F1                    	POP	PSW
  09AB'   C9                    	RET
                                
                                ;---------------------------------------------------------------- the hooks
                                
                                ;UNDPUT -- PUTGAP's tail: the one byte now sitting just below the cursor.
  09AC'                         UNDPUT:
  09AC'   F5                    	PUSH	PSW
  09AD'   C5                    	PUSH	B
  09AE'   D5                    	PUSH	D
  09AF'   E5                    	PUSH	H
  09B0'   CD 060B'              	CALL	CUROFF
  09B3'   2B                    	DCX	H
  09B4'   01 0001               	LXI	B,1
  09B7'   3E 01                 	MVI	A,UR_INS
  09B9'   CD 076D'              	CALL	UNDCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  09BC'   C3 0A1A'              	JMP	UNDHX
                                
                                ;UNDGET -- QGET's tail: BC bytes of register now in, the cursor past them.
                                ;UNDINS is the same entry by its general name: INSBLK itself carries NO hook
                                ;(insert mode records a byte at a time through PUTGAP), so a command that
                                ;splices a block in -- ':s' replacing a match -- has to say so itself, exactly
                                ;as QGET does.  Without it 'u' puts the deleted text back and leaves the
                                ;inserted text there ('a-a-a' undid to 'aZ-aZ-aZ').
  09BF'                         UNDINS:
  09BF'                         UNDGET:
  09BF'   F5                    	PUSH	PSW
  09C0'   C5                    	PUSH	B
  09C1'   D5                    	PUSH	D
  09C2'   E5                    	PUSH	H
  09C3'   78                    	MOV	A,B
  09C4'   B1                    	ORA	C
  09C5'   CA 0A1A'              	JZ	UNDHX
  09C8'   CD 060B'              	CALL	CUROFF
  09CB'   50                    	MOV	D,B
  09CC'   59                    	MOV	E,C
  09CD'   CD 0588'              	CALL	SUBHD		; HL = where the put began
  09D0'   3E 01                 	MVI	A,UR_INS
  09D2'   CD 076D'              	CALL	UNDCHG
  09D5'   C3 0A1A'              	JMP	UNDHX
                                
                                ;UNDDLF -- DELFWD's head: HL bytes about to go forward from the cursor.
  09D8'                         UNDDLF:
  09D8'   F5                    	PUSH	PSW
  09D9'   C5                    	PUSH	B
  09DA'   D5                    	PUSH	D
  09DB'   E5                    	PUSH	H
  09DC'   44                    	MOV	B,H
  09DD'   4D                    	MOV	C,L
  09DE'   CD 060B'              	CALL	CUROFF
  09E1'   3E 02                 	MVI	A,UR_DEL
  09E3'   CD 076D'              	CALL	UNDCHG
  09E6'   C3 0A1A'              	JMP	UNDHX
                                
                                ;UNDDLQ -- QPUTLN's head: BC bytes of whole lines about to go into the register.
  09E9'                         UNDDLQ:
  09E9'   F5                    	PUSH	PSW
  09EA'   C5                    	PUSH	B
  09EB'   D5                    	PUSH	D
  09EC'   E5                    	PUSH	H
  09ED'   CD 060B'              	CALL	CUROFF
  09F0'   3E 02                 	MVI	A,UR_DEL
  09F2'   CD 076D'              	CALL	UNDCHG
  09F5'   C3 0A1A'              	JMP	UNDHX
                                
                                ;UNDDLP -- DELPRV's head: the one byte just below the cursor, about to go.
  09F8'                         UNDDLP:
  09F8'   F5                    	PUSH	PSW
  09F9'   C5                    	PUSH	B
  09FA'   D5                    	PUSH	D
  09FB'   E5                    	PUSH	H
  09FC'   CD 060B'              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  09FF'   2B                    	DCX	H
  0A00'   01 0001               	LXI	B,1
  0A03'   3E 02                 	MVI	A,UR_DEL
  0A05'   CD 076D'              	CALL	UNDCHG
  0A08'   C3 0A1A'              	JMP	UNDHX
                                
                                ;UNDUDF -- UNDELF's tail: the byte DELTO just made text again, at the cursor.
  0A0B'                         UNDUDF:
  0A0B'   F5                    	PUSH	PSW
  0A0C'   C5                    	PUSH	B
  0A0D'   D5                    	PUSH	D
  0A0E'   E5                    	PUSH	H
  0A0F'   CD 060B'              	CALL	CUROFF
  0A12'   01 0001               	LXI	B,1
  0A15'   3E 01                 	MVI	A,UR_INS
  0A17'   CD 076D'              	CALL	UNDCHG
                                ;UNDHX -- every hook leaves the primitive's own registers and flags alone.
  0A1A'                         UNDHX:
  0A1A'   E1                    	POP	H
  0A1B'   D1                    	POP	D
  0A1C'   C1                    	POP	B
  0A1D'   F1                    	POP	PSW
  0A1E'   C9                    	RET
                                
                                ;============================================================
                                ; DATA -- the (base,limit) pointer row (WM 6828-6871 layout) + scratch.
                                ; The disassembly's DB values for these cells are aliased code bytes; only the
                                ; order/adjacency is authoritative.  BINIT sets every cell at run time.
                                ;============================================================
  0A1F'   0000                  BUFBEG: DW	0		; region-array base
  0A21'   0000                  QBEG:	DW	0		; ^Q scratch buffer begin
  0A23'   0000                  QEND:	DW	0		; ^Q scratch buffer end
  0A25'   0000                  HOLEQP:	 DW	 0
  0A27'   0000                  TXTBAS: DW	0		; text base = PBEGMEM+1 (past the 0 sentinel)
                                ;UBEG/UEND -- APPENDED: the undo region, a region of the arena like the Q
                                ;buffer, with UEND its insertion point.  It goes HERE, between the slider and
                                ;the text, so both of the row's interleaved walks stay aligned: the holes from
                                ;BUFBEG are (BUFBEG,QBEG) (QEND,HOLEQP) (TXTBAS,UBEG) (UEND,TXTBEG)
                                ;(GAPBEG,GAPEND) (TXTEND,BUFEND), and the data regions from QBEG are
                                ;(QBEG,QEND) (HOLEQP,TXTBAS) (UBEG,UEND) (TXTBEG,GAPBEG) (GAPEND,TXTEND).
                                ;NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN, PRSPAN and INIBAS's count are all
                                ;untouched by it; INIGAP empties it.
  0A29'   0000                  UBEG:	DW	0		; undo region begin
  0A2B'   0000                  UEND:	DW	0		; undo region end = its insertion point
  0A2D'   0000                  TXTBEG: DW	0		; window start
  0A2F'   0000                  GAPBEG: DW	0		; cursor / gap start
  0A31'   0000                  GAPEND: DW	0		; gap end / first char after cursor
  0A33'   0000                  TXTEND: DW	0		; window end
  0A34'                         PRTERM	 EQU	 TXTEND+1	 ; NEXTPR terminator = high byte of TXTEND
  0A35'   0000                  BUFEND: DW	0		; top of usable text RAM
  0A36'                         MVGTOP	 EQU	 BUFEND+1	 ; MOVGAP upper bound = high byte of BUFEND
                                
  0A37'   00                    ERRFLG: DB	0		; nonzero after ERRMSG fired (harness reads it)
                                
                                ;The search pattern, in WM's SRCHBUF layout (WM 6900): the length, then the
                                ;string, 0-terminated.  CMD.MAC fills it from the '/' line and passes DE =
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


                                ;SRCHST; FWDCNT reads the length from the byte below that, as WM does.
  0A38'   1E                    SRCMAX: DB	SRMAX		; ... its capacity, so CMD.MAC cannot drift
  0A39'   00                    SRCHBF: DB	0		; the pattern length
  0A3A'                         SRCHST: DS	SRMAX+1		; the pattern, 0-terminated
                                
  0A59'   0000                  L2756:	DW	0		; WM L2756 -- GOLINE's last target position
  0A5B'   0000                  QCPDON: DW	0		; (appended) QCPYN: bytes already copied in
                                ;--- 'u' (undo): see the UNDO section above for how these are driven.
  0A5D'   00                    UNDN:	DB	0		; steps captured (0 = nothing to undo)
  0A5E'   00                    UNDST:	DB	0		; 0 none, 1 change applied ('u' undoes it),
                                				;   2 already undone ('u' puts it back)
  0A5F'   00                    UNDBAD: DB	0		; 1 = this change was too big to capture
  0A60'   01                    UNDNEW: DB	1		; 1 = the next capture starts a new change
  0A61'   00                    UNDRPL: DB	0		; 1 = 'u' replaying, so nothing is captured
  0A62'   00                    UNDDIR: DB	0		; the replay's direction (0 forward, 1 inverse)
  0A63'   00                    UNDWHY: DB	0		; 0 = nothing to undo, 1 = it has paged away
  0A64'   00                    UNDTY:	DB	0		; the step / record type being handled
  0A65'   0000                  UNDOF:	DW	0		; ... its logical offset
  0A67'   0000                  UNDLN:	DW	0		; ... its length
  0A69'   0000                  UNDBO:	DW	0		; ... where its bytes lie in the region
  0A6B'   0000                  UNDCL:	DW	0		; the length being captured (BC does not survive)
  0A6D'   0000                  UNDLSA: DW	0		; the last record's address (UNDEXT's scratch)
  0A6F'   0000                  UNDPG:	DW	0		; PGTOPM when this change was captured
  0A71'   0000                  UNDPTR: DW	0		; the region's write point, as an OFFSET
  0A73'   00                    UNDB1:	DB	0		; the byte going in (PRSPAN wants BC)
  0A74'   0000                  UNDPCU: DW	0		; the cursor as the current command began
  0A76'   0000                  UNDCUR: DW	0		; ... as the command that made THIS change began
                                
  0A78'   0000                  LNDLT:	DW	0		; (appended) lines the cursor moved since the last
                                				;   screen layout (signed; SCRN.MAC consumes it)
                                
                                ;PBEGMEM -- base of the text arena: the first RAM byte past everything the
                                ;program holds.  The gap buffer's text lives from here up to BUFEND.  BUF
                                ;links last but RSV.MAC links after it, holding the reserve block in the RAM
                                ;immediately above the image (it emits no bytes of its own), so the arena
                                ;starts at RSVTOP -- past the reserves -- and is the size it always was.
  0A7A'   0000*                 PBEGMEM:DW	RSVTOP
                                
  0A7C'                         MEMBAS:				; top of the linked image (RSV.MAC's base)
                                
                                	END
