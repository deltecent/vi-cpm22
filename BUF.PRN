  04D8'   D1                    	POP	D
  04D9'   C9                    	RET
                                
                                ;RECOUNT -- WM 4037: HL = GAPEND + offset, BC = bytes left after a refill.
  04DA'                         RECOUNT:			; WM 4037
  04DA'   D5                    	PUSH	D
  04DB'   EB                    	XCHG
  04DC'   CD 04A1'              	CALL	AFTLEN
  04DF'   CD 0571'              	CALL	LDHLI
  04E2'   19                    	DAD	D
  04E3'   79                    	MOV	A,C
  04E4'   93                    	SUB	E
  04E5'   4F                    	MOV	C,A
  04E6'   78                    	MOV	A,B
  04E7'   9A                    	SBB	D
  04E8'   47                    	MOV	B,A
  04E9'   D1                    	POP	D
  04EA'   C9                    	RET
                                
