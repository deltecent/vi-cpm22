  05C6'   44                    	MOV	B,H
  05C7'   4D                    	MOV	C,L
  05C8'   E1                    	POP	H
  05C9'   78                    	MOV	A,B
  05CA'   B1                    	ORA	C
  05CB'   C9                    	RET
                                
                                ;LDPAI2/LDPAIR -- WM 5307/5312: load a (base,limit) pair into DE,HL.
                                ;NOTE: LDPAIR falls through into LDHLI (no RET) -- DE := base, HL := limit.
  05CC'                         LDPAI2:			       ; WM 5307
  05CC'   2B                    	DCX	H
  05CD'   2B                    	DCX	H
  05CE'                         LDPAIR:				; WM 5312
  05CE'   5E                    	MOV	E,M
  05CF'   23                    	INX	H
  05D0'   56                    	MOV	D,M
  05D1'   23                    	INX	H
                                ;LDHLI -- WM 5320: HL := word@HL.
  05D2'                         LDHLI:				; WM 5320
  05D2'   7E                    	MOV	A,M
  05D3'   23                    	INX	H
  05D4'   66                    	MOV	H,M
  05D5'   6F                    	MOV	L,A
  05D6'   C9                    	RET
                                
                                ;CMP16 -- WM 5333: 16-bit unsigned compare DE against HL (D-H, then E-L).
                                ;A preserved; only flags returned.  CY iff DE < HL; Z iff DE == HL.
  05D7'                         CMP16:				; WM 5333
  05D7'   C5                    	PUSH	B
  05D8'   47                    	MOV	B,A
  05D9'   7A                    	MOV	A,D
  05DA'   94                    	SUB	H
  05DB'   C2 05E0'              	JNZ	CMPLOW
  05DE'   7B                    	MOV	A,E
  05DF'   95                    	SUB	L
  05E0'                         CMPLOW:				 ; WM 5342
  05E0'   78                    	MOV	A,B
  05E1'   C1                    	POP	B
  05E2'   C9                    	RET
                                
                                ;SUBCLP -- WM 5348: HL := max(0, HL-DE); CY if positive.
  05E3'                         SUBCLP:				; WM 5348
  05E3'   CD 05D7'              	CALL	CMP16
  05E6'   DA 05EE'              	JC	SCLPPO
  05E9'                         SCLPZ:				; WM 5352
  05E9'   21 0000               	LXI	H,0H
  05EC'   B7                    	ORA	A
  05ED'   C9                    	RET
  05EE'                         SCLPPO:				 ; WM 5357
  05EE'   E5                    	PUSH	H
  05EF'   CD 05B9'              	CALL	SUBHD
  05F2'   D1                    	POP	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  05F3'   37                    	STC
  05F4'   C9                    	RET
                                
                                ;SUBCP2 -- WM 5365: HL := max(0, DE-HL); CY if positive.
  05F5'                         SUBCP2:			       ; WM 5365
  05F5'   CD 05D7'              	CALL	CMP16
  05F8'   CA 05E9'              	JZ	SCLPZ
  05FB'   DA 05E9'              	JC	SCLPZ
  05FE'   EB                    	XCHG
  05FF'   CD 05B9'              	CALL	SUBHD
  0602'   37                    	STC
  0603'   C9                    	RET
                                
                                
                                ;POPRET -- WM 5387: shared epilogue for the PUSH B/PUSH D/PUSH H prologue.
  0604'                         POPRET:				; WM 5387
  0604'   E1                    	POP	H
  0605'   D1                    	POP	D
  0606'   C1                    	POP	B
  0607'   C9                    	RET
                                
                                ;============================================================
                                ; PAGESTP -- the count-limited scroll step.  The disk-eviction seam
                                ; (MKROOM/SPILL/SPILLB/PAGEBOT/REWIND), the deque marks (MARKGB/UPDMARK/RECBASE/
                                ; PTRREC) and the paging drivers (PAGEDIR/PGNEED/PAGEWIN) are all real in
                                ; PAGE.MAC, and CNTTST/CMDCNT/AUXCNT now exist in CMD.MAC.
                                ;============================================================
                                
                                ;PAGESTP -- WM 4311: page one step in the scroll direction, count-limited.
                                ;CNTTST returns Z when the command count (CMDCNT and AUXCNT) is exhausted, so a
                                ;completed edit or motion stops here (RZ); otherwise fall into PAGEDIR to page
                                ;the window one increment in the current scroll direction (DIRFLG: REWIND back,
                                ;FILLBUF forward).  In WM PAGESTP falls through to the physically adjacent
                                ;PAGEDIR; here PAGEDIR lives in PAGE.MAC, so the fall-through is an explicit
                                ;JMP -- same object behavior, PAGEDIR's own POLLBRK still runs.  DELTO's tail
                                ;JMPs here, so a delete made with the count spent returns at once; the count
                                ;loops (dd's QPUTLN, MVLLOOP's line moves, the search sweep through SCRLST)
                                ;are what page the window on past its edge.
                                ;SCRLST -- WM 4307: poll type-ahead, PUTCUR to HL, then (count not spent)
                                ;fall into PAGESTP to page the window one step in the DIRFLG direction.
  0608'                         SCRLST:				; WM 4307
  0608'   CD 0000*              	CALL	POLLBRK
  060B'   CD 03CC'              	CALL	PUTCUR
                                
  060E'                         PAGESTP:			; WM 4311
  060E'   CD 0000*              	CALL	CNTTST
  0611'   C8                    	RZ
  0612'   C3 0000*              	JMP	PAGEDIR
                                
                                ;============================================================
                                ; ERRMSG -- WM 664, message-print transcribed; TAIL adapted (see header):
                                ; print the inline 0-terminated message, set ERRFLG, warm-boot to CP/M.
                                ; The message is printed where ERRHK leaves the cursor: VI.MAC points it at the
                                ; screen teardown, so it lands on the bottom row with the terminal restored, as
                                ; a quit leaves it; a harness with no screen leaves it on a RET.  The work files
                                ; are dropped before the warm boot, as a quit drops them.  A second error from
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


                                ; inside either step ends here too: DISCRD clears its own flag before it
                                ; deletes, so it cannot run twice.
                                ;============================================================
  0615'                         ERRMSG:				; WM 664 (tail adapted)
  0615'   3E FF                 	MVI	A,0FFH
  0617'   32 0AA7'              	STA	ERRFLG		; record that an error fired
  061A'   2A 063A'              	LHLD	ERRHK
  061D'   CD 0638'              	CALL	ERMGO		; the cursor to where the message belongs
  0620'   E1                    	POP	H		; HL -> inline message (after the CALL)
  0621'                         ERMLP:
  0621'   7E                    	MOV	A,M
  0622'   B7                    	ORA	A
  0623'   CA 0632'              	JZ	ERMEND
  0626'   E5                    	PUSH	H
  0627'   5F                    	MOV	E,A
  0628'   0E 02                 	MVI	C,2		; BDOS console out
  062A'   CD 0005               	CALL	BDOS
  062D'   E1                    	POP	H
  062E'   23                    	INX	H
  062F'   C3 0621'              	JMP	ERMLP
  0632'                         ERMEND:
  0632'   CD 0000*              	CALL	DISCRD		; no name.$$$ / VIBACKUP.$$$ left behind
  0635'   C3 0000               	JMP	WBOOT		; adapted tail: back to CP/M
  0638'   E9                    ERMGO:	PCHL
  0639'   C9                    ERMNUL: RET
  063A'   0639'                 ERRHK:	DW	ERMNUL		; the screen's teardown, once there is a screen
                                
                                ;============================================================
                                ; LOGICAL-OFFSET API  (APPENDED -- NOT WordMaster).
                                ; The gap-agnostic view the vi layer (CMD.MAC) uses so it never touches the raw
                                ; pointer row.  A logical offset is a byte index into resident text as if the
                                ; gap were absent:
                                ;   before = GAPBEG - TXTBEG   (bytes before the cursor = cursor logical offset)
                                ;   after  = TXTEND - GAPEND   (bytes at/after the cursor)
                                ;   LOGLEN = before + after
                                ; Most of CMD.MAC's verbs work in these offsets alone; the rest drive WM's
                                ; pointer-based routines (PUTCUR, the line moves, RGET, the matchers, the
                                ; Q-buffer), which page as they go, and a few read the pointer row directly.
                                ;============================================================
                                
                                ;CUROFF -- HL = cursor logical offset (= before length).
  063C'                         CUROFF:
  063C'   2A 0A9D'              	LHLD	TXTBEG
  063F'   EB                    	XCHG
  0640'   2A 0A9F'              	LHLD	GAPBEG
  0643'   CD 05B9'              	CALL	SUBHD		; HL = GAPBEG - TXTBEG
  0646'   C9                    	RET
                                
                                ;AFTLN2 -- HL = after length (TXTEND - GAPEND).  Private helper for LOGLEN.
  0647'                         AFTLN2:
  0647'   2A 0AA1'              	LHLD	GAPEND
  064A'   EB                    	XCHG
  064B'   2A 0AA3'              	LHLD	TXTEND
  064E'   CD 05B9'              	CALL	SUBHD
  0651'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


                                ;LOGLEN -- HL = total resident logical length.
  0652'                         LOGLEN:
  0652'   CD 063C'              	CALL	CUROFF
  0655'   E5                    	PUSH	H
  0656'   CD 0647'              	CALL	AFTLN2
  0659'   D1                    	POP	D
  065A'   19                    	DAD	D
  065B'   C9                    	RET
                                
                                ;L2PHYS -- HL(off) -> HL(physical address).  0 <= off <= LOGLEN.  Private.
  065C'                         L2PHYS:
  065C'   EB                    	XCHG			; DE = off
  065D'   D5                    	PUSH	D
  065E'   CD 063C'              	CALL	CUROFF		; HL = before
  0661'   D1                    	POP	D		; DE = off
  0662'   CD 05D7'              	CALL	CMP16		; DE=off vs HL=before: CY iff off < before
  0665'   DA 0672'              	JC	L2P_BEF
                                	;--- after region: phys = GAPEND + (off - before) ---
  0668'   EB                    	XCHG			; HL=off, DE=before
  0669'   CD 05B9'              	CALL	SUBHD		; HL = off - before
  066C'   EB                    	XCHG			; DE = off-before
  066D'   2A 0AA1'              	LHLD	GAPEND
  0670'   19                    	DAD	D
  0671'   C9                    	RET
  0672'                         L2P_BEF:
                                	;--- before region: phys = TXTBEG + off  (DE = off, HL = before) ---
  0672'   2A 0A9D'              	LHLD	TXTBEG
  0675'   19                    	DAD	D
  0676'   C9                    	RET
                                
                                ;CHARAT -- HL(off) -> A = byte at that logical offset (off < LOGLEN).
  0677'                         CHARAT:
  0677'   CD 065C'              	CALL	L2PHYS
  067A'   7E                    	MOV	A,M
  067B'   C9                    	RET
                                
                                ;CLAMPL -- HL(off) -> HL clamped to [0, LOGLEN].  Private helper for GOTO.
  067C'                         CLAMPL:
  067C'   E5                    	PUSH	H
  067D'   CD 0652'              	CALL	LOGLEN
  0680'   D1                    	POP	D		; DE = off
  0681'   CD 05D7'              	CALL	CMP16		; DE=off vs HL=LOGLEN
  0684'   DA 068B'              	JC	CLK_KEEP	; off < LOGLEN
  0687'   CA 068B'              	JZ	CLK_KEEP	; off == LOGLEN
  068A'   C9                    	RET			; off > LOGLEN -> HL = LOGLEN
  068B'                         CLK_KEEP:
  068B'   EB                    	XCHG			; HL = off
  068C'   C9                    	RET
                                
                                ;GOTO -- HL(off): move the cursor to that logical offset.
                                ;PUTCUR takes its target address in HL (its entry XCHG moves it to DE).
                                ;The line feeds the cursor crosses are added to LNDLT (subtracted going back).
  068D'                         GOTO:
  068D'   CD 067C'              	CALL	CLAMPL
  0690'   CD 065C'              	CALL	L2PHYS		; HL = physical address
  0693'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0694'   EB                    	XCHG			; DE = target
  0695'   2A 0AA1'              	LHLD	GAPEND
  0698'   CD 05D7'              	CALL	CMP16		; CY iff target < GAPEND (before the gap)
  069B'   DA 06A9'              	JC	GTO_BK
  069E'   EB                    	XCHG			; forward: count [GAPEND, target)
  069F'   CD 06BD'              	CALL	LFCNT
  06A2'   2A 0AEB'              	LHLD	LNDLT
  06A5'   19                    	DAD	D
  06A6'   C3 06B5'              	JMP	GTO_ST
  06A9'                         GTO_BK:
  06A9'   2A 0A9F'              	LHLD	GAPBEG		; back: count [target, GAPBEG)
  06AC'   CD 06BD'              	CALL	LFCNT
  06AF'   2A 0AEB'              	LHLD	LNDLT
  06B2'   CD 05B9'              	CALL	SUBHD
  06B5'                         GTO_ST:
  06B5'   22 0AEB'              	SHLD	LNDLT
  06B8'   E1                    	POP	H
  06B9'   CD 03CC'              	CALL	PUTCUR
  06BC'   C9                    	RET
                                
                                ;LFCNT -- DE = start, HL = end (>= start): DE = number of LFs in [start, end).
  06BD'                         LFCNT:
  06BD'   CD 05B9'              	CALL	SUBHD		; HL = end - start
  06C0'   44                    	MOV	B,H
  06C1'   4D                    	MOV	C,L		; BC = length
  06C2'   EB                    	XCHG			; HL = start
  06C3'   11 0000               	LXI	D,0
  06C6'                         LFC_LP:
  06C6'   78                    	MOV	A,B
  06C7'   B1                    	ORA	C
  06C8'   C8                    	RZ
  06C9'   7E                    	MOV	A,M
  06CA'   23                    	INX	H
  06CB'   0B                    	DCX	B
  06CC'   FE 0A                 	CPI	LF
  06CE'   C2 06C6'              	JNZ	LFC_LP
  06D1'   13                    	INX	D
  06D2'   C3 06C6'              	JMP	LFC_LP
                                
                                ;RDGET -- RGET, and CY also when a refill read nothing.  INRDY stays set after
                                ;a file's last full record (no ^Z) until a read fails; NEEDIN then returns NC
                                ;having added nothing, and RGET steps past TXTEND leaving BC = FFFFH.  That is
                                ;reported as the end of the text, with BC = 0 so a later call asks NEEDIN again.
  06D5'                         RDGET:
  06D5'   CD 0517'              	CALL	RGET
  06D8'   D8                    	RC
  06D9'   F5                    	PUSH	PSW
  06DA'   78                    	MOV	A,B
  06DB'   A1                    	ANA	C
  06DC'   3C                    	INR	A		; Z iff BC = FFFFH
  06DD'   CA 06E2'              	JZ	RDG_EF
  06E0'   F1                    	POP	PSW
  06E1'   C9                    	RET
  06E2'                         RDG_EF:
  06E2'   F1                    	POP	PSW
  06E3'   01 0000               	LXI	B,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  06E6'   37                    	STC
  06E7'   C9                    	RET
                                
                                ;DELFWD -- HL = number of logical bytes to delete forward from the cursor.
  06E8'                         DELFWD:
  06E8'   7C                    	MOV	A,H
  06E9'   B5                    	ORA	L
  06EA'   C8                    	RZ			; nothing to delete
  06EB'   CD 0A48'              	CALL	UNDDLF		; (appended) the span, for 'u', before it goes
  06EE'   EB                    	XCHG			; DE = count
  06EF'   2A 0AA1'              	LHLD	GAPEND
  06F2'   19                    	DAD	D		; target = GAPEND + count
  06F3'   AF                    	XRA	A		; S clear -> forward delete
  06F4'   CD 01FB'              	CALL	DELTO
  06F7'   C9                    	RET
                                
                                ;DELPRV -- WM 3260 RUBOUT/DELL: delete the char left of the cursor, and the
                                ;CR too when that leaves one there (a CR,LF goes as one).  PEEKLX pages back
                                ;at the window start and returns at the start of the file.  WM's MARKCUR and
                                ;ROWUP (its screen) are left out; instead a deleted LF moves the cursor up a
                                ;line (LNDLT - 1) for SCRN.MAC.
  06F8'                         DELPRV:				; WM 3260
  06F8'   CD 01F4'              	CALL	PEEKLX
  06FB'   FE 0A                 	CPI	LF
  06FD'   C2 0709'              	JNZ	DLP_GO
  0700'   E5                    	PUSH	H
  0701'   2A 0AEB'              	LHLD	LNDLT
  0704'   2B                    	DCX	H
  0705'   22 0AEB'              	SHLD	LNDLT
  0708'   E1                    	POP	H
  0709'                         DLP_GO:				; WM 3263 DELL
  0709'   CD 0A68'              	CALL	UNDDLP		; (appended) that byte, for 'u', before it goes
  070C'   CD 0055'              	CALL	SETGAPB
  070F'   CD 01E7'              	CALL	PEEKL
  0712'   FE 0D                 	CPI	CR
  0714'   CA 06F8'              	JZ	DELPRV
  0717'   C9                    	RET
                                
                                
                                ;UNDELF -- APPENDED, NOT WordMaster: give back the byte last swallowed forward
                                ;into the gap.  A forward delete only moves GAPEND past the byte, so the byte
                                ;itself is still there, inside the gap: GAPEND-1 through DELTO makes it text
                                ;again, with the record marks updated exactly as a delete updates them.
                                ;Replace mode ('R') puts back with it what it overwrote, as vim's BS in Replace
                                ;mode does.  The caller must know the gap has not moved since the delete
                                ;(CMD.MAC keeps GAPEND in RPGE for that); nothing else calls this.
  0718'                         UNDELF:
  0718'   2A 0AA1'              	LHLD	GAPEND
  071B'   2B                    	DCX	H
  071C'   AF                    	XRA	A		; S clear -> the forward (GAPEND) side
  071D'   CD 01FB'              	CALL	DELTO
  0720'   C3 0A7B'              	JMP	UNDUDF		; (appended) the byte just made text again
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  APPENDED, NOT WordMaster: WM has no undo at all (its QBUFOP /
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


                                ; QEXEC macro is a command-LINE facility, not this).
                                ;
                                ; Six primitives change resident text, and each one says what it did: PUTGAP
                                ; (one byte in), QGET (the register in), DELFWD (a span out), DELPRV (one byte
                                ; out backward), UNDELF (one byte back in) and QPUTLN (whole lines out).
                                ; Nothing else in the editor reaches the text, so no command can forget to
                                ; record itself -- which is the whole reason the capture sits down here instead
                                ; of at CMD.MAC's edit sites.
                                ;
                                ; A record says only WHERE and HOW MUCH, in LOGICAL offsets, plus where its
                                ; bytes lie in the undo region.  Logical offsets survive the gap sliding (which
                                ; PUTCUR does on every cursor move) because the replay walks the records
                                ; BACKWARD: each step restores the offsets the steps after it were measured
                                ; against.  The bytes are kept for an insert as well as a delete -- an insert
                                ; costs its own text twice, which is nothing -- so the region is settled once
                                ; the command ends and 'u' can walk it either way: backward applying each
                                ; record's inverse to undo, forward applying the records as they stand to redo.
                                ; That is what makes 'u' undo 'u' with ONE region and no capture during the
                                ; replay.
                                ;
                                ; The region is a region of the arena like the Q buffer, inserted between the
                                ; slider and the text, and it grows through the same MKGAP: the pointer row
                                ; reads (UBEG,UEND) as data and (TXTBAS,UBEG) / (UEND,TXTBEG) as the holes
                                ; around it, so NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN and INIBAS all take it in
                                ; their stride unchanged.
                                ;
                                ; DEVIATIONS from vim, all deliberate and all in COMMANDS.md: ONE level of
                                ; undo, so 'u' undoes 'u' as real vi does; the change must still be in the
                                ; RESIDENT window, and 'u' refuses once the pager has moved off it rather than
                                ; chasing it through the file; and a change with more steps than the table
                                ; holds, or one the arena has no spare room to keep, is not undoable at all.
                                ;
                                ; "Moved off it" is PGTOPM, PAGE.MAC's count of the times the pager moved
                                ; TXTBEG.  It is the window's TOP that matters: an offset is measured from
                                ; TXTBEG, so spilling a record out from under it (PAGEOUT) or reading one back
                                ; in (REWIND) shifts every offset, while FILLBUF and PAGEBOT growing TXTEND at
                                ; the bottom shift none.  The OUTREC/SRCREC water marks look like the same
                                ; thing and are not: UPDMARK raises them on every edit.
                                ;============================================================
                                
  0001                          UR_INS	EQU	1		; text went IN  (undoing takes it back out)
  0002                          UR_DEL	EQU	2		; text came OUT (undoing puts it back)
  0007                          URSIZE	EQU	7		; type, offset(2), length(2), region offset(2)
  0018                          URMAX	EQU	24		; primitive steps one change may hold
                                ;How much of the arena the capture refuses to eat into.  It only has to keep
                                ;MKGAP off its MKROOM path (which wants 256 free), because paging is what undo
                                ;must not do -- so this is deliberately SMALL.  RESVMEM, QROOM's reserve, is
                                ;far too big: a 66 K file leaves under 1700 bytes free, and undo would never
                                ;engage at all on exactly the files that need it most.
  0200                          UNDRSV	EQU	200H		; ... 512 bytes
                                ;How much room the region claims up front, and so the largest change that can
                                ;be kept.  The claim is what lets the capture run without EVER growing the
                                ;region: see UNDGRW for why growing where a primitive can see it is unsafe.
  0400                          UNDCAP	EQU	400H		; 1024 bytes of change
                                
                                ;UNDBEG -- CMD.MAC's command boundary: the NEXT captured change starts a new
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


                                ;undo.  A flag only, so a command that changes nothing -- a motion, a yank, a
                                ;key that is no command at all -- leaves the last change undoable, exactly as
                                ;'.' keeps the last change it recorded.
  0723'                         UNDBEG:
  0723'   D5                    	PUSH	D
  0724'   E5                    	PUSH	H
  0725'   3E 01                 	MVI	A,1
  0727'   32 0AD0'              	STA	UNDNEW
  072A'   CD 063C'              	CALL	CUROFF
  072D'   22 0AE4'              	SHLD	UNDPCU		; where the cursor was as this command began --
  0730'   CD 073F'              	CALL	UNDGRW		;   kept pending, because only a command that
  0733'   E1                    	POP	H		;   really changes text gets to claim it
  0734'   D1                    	POP	D
  0735'   C9                    	RET
                                
                                ;UNDHER -- the change about to start belongs at the CURSOR: 'u' puts it back
                                ;there.  UNDBEG's cursor snapshot without its claim on the region, for a
                                ;command (':s') that cannot know where its first change will be until it has
                                ;found it.  Calling UNDBEG again instead would re-run UNDGRW in the middle of
                                ;the command, which is the one thing UNDGRW must never do -- see below.
  0736'                         UNDHER:
  0736'   E5                    	PUSH	H
  0737'   CD 063C'              	CALL	CUROFF
  073A'   22 0AE4'              	SHLD	UNDPCU
  073D'   E1                    	POP	H
  073E'   C9                    	RET
                                
                                ;UNDGRW -- make sure the region can take a whole change without growing again.
                                ;THE ONLY PLACE THE REGION GROWS, and it runs at the command boundary, where no
                                ;primitive is holding anything.  Growing moves regions about (MKGAP -> MOVGAP),
                                ;and that both invalidates a raw pointer a primitive is in the middle of using
                                ;-- DELPRV hands SETGAPB one -- and overwrites whatever is sitting in the gap,
                                ;which is where a forward-deleted byte waits for 'R's backspace to call UNDELF
                                ;and give it back.  So the room is claimed here, 256 bytes at a time, and the
                                ;capture below never calls MKGAP at all: it writes into the claim or gives up.
                                ;The room has to be claimed as the region's own CONTENT, not left as the hole
                                ;above it: the holes are shared, and the text takes whatever it can reach --
                                ;MOVGAP feeding an insert will walk straight through a hole reserved here, which
                                ;is what made a 200-character insert lose its undo halfway.  Once the bytes are
                                ;inside (UBEG,UEND) the text cannot have them: MOVGAP slides the region aside
                                ;instead.  Nothing here holds an address across MKGAP either, because MKGAP
                                ;slides this very region (HOLEUP moves UBEG and UEND) -- UEND is re-read from
                                ;its cell every time round.
  073F'                         UNDGRW:
  073F'   C5                    	PUSH	B
  0740'   D5                    	PUSH	D
  0741'   E5                    	PUSH	H
  0742'                         UNDGRL:
  0742'   21 0A99'              	LXI	H,UBEG
  0745'   CD 0505'              	CALL	PRSPAN		; BC = the region's size
  0748'   50                    	MOV	D,B
  0749'   59                    	MOV	E,C
  074A'   21 0400               	LXI	H,UNDCAP
  074D'   CD 05D7'              	CALL	CMP16		; CY iff it is smaller than one change
  0750'   D2 0604'              	JNC	POPRET
  0753'   CD 08D6'              	CALL	UNDRM		; ... but never at the cost of paging
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  0756'   DA 0604'              	JC	POPRET
  0759'   21 0A9B'              	LXI	H,UEND
  075C'   CD 00B0'              	CALL	MKGAP		; 256 free above the region ...
  075F'   2A 0A9B'              	LHLD	UEND
  0762'   11 0100               	LXI	D,100H
  0765'   19                    	DAD	D
  0766'   22 0A9B'              	SHLD	UEND		; ... taken into it, so the text cannot take
  0769'   C3 0742'              	JMP	UNDGRL		;     them back
                                
                                ;UNDCLR -- nothing is undoable (a fresh buffer; BINIT calls it through INIGAP).
  076C'                         UNDCLR:
  076C'   AF                    	XRA	A
  076D'   32 0ACD'              	STA	UNDN
  0770'   32 0ACE'              	STA	UNDST
  0773'   32 0ACF'              	STA	UNDBAD
  0776'   3E 01                 	MVI	A,1
  0778'   32 0AD0'              	STA	UNDNEW
  077B'   C9                    	RET
                                
                                ;UNDRST -- the first capture of a new change: drop the last one and note where
                                ;the file window was, so 'u' can tell the pager has since moved off this change.
  077C'                         UNDRST:
  077C'   AF                    	XRA	A
  077D'   32 0AD0'              	STA	UNDNEW
  0780'   32 0ACD'              	STA	UNDN
  0783'   32 0ACF'              	STA	UNDBAD
  0786'   21 0000               	LXI	H,0
  0789'   22 0AE1'              	SHLD	UNDPTR		; the region's content empties (its SIZE stays:
                                				;   that is the room UNDGRW claimed)
  078C'   2A 0000*              	LHLD	PGTOPM
  078F'   22 0ADF'              	SHLD	UNDPG
  0792'   2A 0AE4'              	LHLD	UNDPCU
  0795'   22 0AE6'              	SHLD	UNDCUR		; ... and this command does change text, so this
                                				;   is where 'u' will put the cursor back
  0798'   3E 01                 	MVI	A,1
  079A'   32 0ACE'              	STA	UNDST		; a change is on the buffer: 'u' undoes it
  079D'   C9                    	RET
                                
                                ;UNDCHG -- the capture every hooked primitive uses.  A = UR_INS / UR_DEL,
                                ;HL = the logical offset it acted at, BC = how many bytes.  The bytes are read
                                ;back out of the resident TEXT at that offset -- for a delete before they go,
                                ;for an insert once they have arrived -- so no caller hands over a pointer that
                                ;growing the region could leave stale.
  079E'                         UNDCHG:
  079E'   C5                    	PUSH	B
  079F'   D5                    	PUSH	D
  07A0'   E5                    	PUSH	H
  07A1'   32 0AD4'              	STA	UNDTY		; the record type, kept out of the registers
  07A4'   CD 081C'              	CALL	EDTGO		; whoever else follows an edit (BC is kept)
  07A7'   3A 0AD1'              	LDA	UNDRPL
  07AA'   B7                    	ORA	A
  07AB'   C2 0604'              	JNZ	POPRET		; 'u' replaying: its own edits are not a change
  07AE'   3A 0AD0'              	LDA	UNDNEW
  07B1'   B7                    	ORA	A
  07B2'   CA 07B8'              	JZ	UNDC1
  07B5'   CD 077C'              	CALL	UNDRST		; the first step of a new change
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  07B8'                         UNDC1:
  07B8'   3A 0ACF'              	LDA	UNDBAD
  07BB'   B7                    	ORA	A
  07BC'   C2 0604'              	JNZ	POPRET		; this change has already been given up on
  07BF'   78                    	MOV	A,B
  07C0'   B1                    	ORA	C
  07C1'   CA 0604'              	JZ	POPRET		; a zero-length step is no step
  07C4'   60                    	MOV	H,B
  07C5'   69                    	MOV	L,C
  07C6'   22 0ADB'              	SHLD	UNDCL		; UNDAPT spends BC as its countdown, so the
                                				;   length has to be kept somewhere else
  07C9'   3A 0ACD'              	LDA	UNDN
  07CC'   FE 18                 	CPI	URMAX
  07CE'   D2 0814'              	JNC	UNDCBD		; no room for another step
                                	;--- where this step's bytes will land in the region ---
  07D1'   2A 0AE1'              	LHLD	UNDPTR
  07D4'   22 0AD9'              	SHLD	UNDBO
  07D7'   E1                    	POP	H
  07D8'   E5                    	PUSH	H		; HL = the logical offset again
  07D9'   CD 088C'              	CALL	UNDAPT		; BC bytes of the text there -> the region
  07DC'   DA 0814'              	JC	UNDCBD
                                	;--- fold it into the last record when it only carries that one on ---
  07DF'   E1                    	POP	H
  07E0'   E5                    	PUSH	H
  07E1'   CD 0834'              	CALL	UNDEXT
  07E4'   CA 0604'              	JZ	POPRET
                                	;--- otherwise a record of its own ---
  07E7'   3A 0ACD'              	LDA	UNDN
  07EA'   CD 0824'              	CALL	URADDR
  07ED'   3A 0AD4'              	LDA	UNDTY
  07F0'   77                    	MOV	M,A
  07F1'   23                    	INX	H
  07F2'   D1                    	POP	D
  07F3'   D5                    	PUSH	D		; DE = the logical offset
  07F4'   73                    	MOV	M,E
  07F5'   23                    	INX	H
  07F6'   72                    	MOV	M,D
  07F7'   23                    	INX	H
  07F8'   EB                    	XCHG			; DE = the record, past the offset
  07F9'   2A 0ADB'              	LHLD	UNDCL
  07FC'   EB                    	XCHG			; ... and HL back, with DE = the length
  07FD'   73                    	MOV	M,E
  07FE'   23                    	INX	H
  07FF'   72                    	MOV	M,D
  0800'   23                    	INX	H
  0801'   3A 0AD9'              	LDA	UNDBO
  0804'   77                    	MOV	M,A
  0805'   23                    	INX	H
  0806'   3A 0ADA'              	LDA	UNDBO+1
  0809'   77                    	MOV	M,A
  080A'   3A 0ACD'              	LDA	UNDN
  080D'   3C                    	INR	A
  080E'   32 0ACD'              	STA	UNDN
  0811'   C3 0604'              	JMP	POPRET
  0814'                         UNDCBD:
  0814'   3E 01                 	MVI	A,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0816'   32 0ACF'              	STA	UNDBAD		; too big to keep: not undoable at all
  0819'   C3 0604'              	JMP	POPRET
                                
                                ;EDTGO -- UNDCHG is the one place every change to the text goes by, the
                                ;replay's own included, so it is also where the editor hears of one: EDTHK is
                                ;called with A = UR_INS / UR_DEL, HL = the logical offset and BC = the length,
                                ;and must keep BC.  VI.MAC points it at the marks; a harness leaves it a RET.
  081C'                         EDTGO:
  081C'   E5                    	PUSH	H
  081D'   2A 0822'              	LHLD	EDTHK
  0820'   E3                    	XTHL
  0821'   C9                    	RET
  0822'   0639'                 EDTHK:	DW	ERMNUL
                                
                                ;URADDR -- A = a record index -> HL = its address (base + n*8 - n).
  0824'                         URADDR:
  0824'   6F                    	MOV	L,A
  0825'   26 00                 	MVI	H,0
  0827'   5D                    	MOV	E,L
  0828'   54                    	MOV	D,H
  0829'   29                    	DAD	H
  082A'   29                    	DAD	H
  082B'   29                    	DAD	H		; HL = n*8
  082C'   CD 05B9'              	CALL	SUBHD		; HL = n*7
  082F'   11 0000*              	LXI	D,UNDREC
  0832'   19                    	DAD	D
  0833'   C9                    	RET
                                
                                ;UNDEXT -- A = 0 (Z) when this step only carries the last record on: an insert
                                ;starting exactly where the last insert ended, which is what typing does.  Its
                                ;bytes already sit contiguously behind that record's, so only the length grows.
                                ;HL = this step's offset, BC = its length.
  0834'                         UNDEXT:
  0834'   C5                    	PUSH	B
  0835'   D5                    	PUSH	D
  0836'   E5                    	PUSH	H
  0837'   3A 0AD4'              	LDA	UNDTY
  083A'   FE 01                 	CPI	UR_INS
  083C'   C2 0886'              	JNZ	UNDXNO		; only inserts fold
  083F'   3A 0ACD'              	LDA	UNDN
  0842'   B7                    	ORA	A
  0843'   CA 0886'              	JZ	UNDXNO		; nothing to fold into
  0846'   3D                    	DCR	A
  0847'   CD 0824'              	CALL	URADDR
  084A'   22 0ADD'              	SHLD	UNDLSA
  084D'   7E                    	MOV	A,M
  084E'   FE 01                 	CPI	UR_INS
  0850'   C2 0886'              	JNZ	UNDXNO
  0853'   2A 0ADD'              	LHLD	UNDLSA
  0856'   23                    	INX	H
  0857'   CD 05D2'              	CALL	LDHLI		; HL = the last record's offset
  085A'   EB                    	XCHG
  085B'   2A 0ADD'              	LHLD	UNDLSA
  085E'   23                    	INX	H
  085F'   23                    	INX	H
  0860'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0861'   CD 05D2'              	CALL	LDHLI		; HL = its length
  0864'   19                    	DAD	D		; HL = where it ends
  0865'   EB                    	XCHG
  0866'   E1                    	POP	H
  0867'   E5                    	PUSH	H		; HL = this step's offset
  0868'   CD 05D7'              	CALL	CMP16		; Z iff this step starts exactly there
  086B'   C2 0886'              	JNZ	UNDXNO
  086E'   2A 0ADD'              	LHLD	UNDLSA
  0871'   23                    	INX	H
  0872'   23                    	INX	H
  0873'   23                    	INX	H
  0874'   E5                    	PUSH	H
  0875'   CD 05D2'              	CALL	LDHLI		; HL = the last record's length
  0878'   EB                    	XCHG
  0879'   2A 0ADB'              	LHLD	UNDCL
  087C'   19                    	DAD	D		; ... grown by this step's
  087D'   EB                    	XCHG
  087E'   E1                    	POP	H
  087F'   73                    	MOV	M,E
  0880'   23                    	INX	H
  0881'   72                    	MOV	M,D
  0882'   AF                    	XRA	A		; Z: folded, no new record
  0883'   C3 0604'              	JMP	POPRET
  0886'                         UNDXNO:
  0886'   3E 01                 	MVI	A,1
  0888'   B7                    	ORA	A		; NZ: it needs a record of its own
  0889'   C3 0604'              	JMP	POPRET
                                
                                ;UNDAPT -- append BC bytes of resident text, from logical offset HL, to the
                                ;undo region.  One byte at a time, re-reading the offset through CHARAT and the
                                ;region through its pointer cell every time, so growing the region (which
                                ;slides regions about) can never leave this loop holding a stale address.
                                ;CY if it outgrows the claim, and the caller then gives the change up.
  088C'                         UNDAPT:
  088C'   78                    	MOV	A,B
  088D'   B1                    	ORA	C
  088E'   C8                    	RZ			; nothing to append
  088F'                         UNDAPL:
  088F'   C5                    	PUSH	B
  0890'   E5                    	PUSH	H
  0891'   CD 0677'              	CALL	CHARAT		; A = the text byte at this offset
  0894'   CD 08A2'              	CALL	UNDAPB		; ... into the region
  0897'   E1                    	POP	H
  0898'   C1                    	POP	B
  0899'   D8                    	RC
  089A'   23                    	INX	H
  089B'   0B                    	DCX	B
  089C'   78                    	MOV	A,B
  089D'   B1                    	ORA	C
  089E'   C2 088F'              	JNZ	UNDAPL
  08A1'   C9                    	RET
                                
                                ;UNDAPB -- put the byte in A into the room UNDGRW claimed.  It does NOT grow
                                ;the region -- see UNDGRW -- so CY, and the change given up on, once the room
                                ;is used up: a change bigger than the region is simply not undoable.
  08A2'                         UNDAPB:
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  08A2'   C5                    	PUSH	B
  08A3'   D5                    	PUSH	D
  08A4'   E5                    	PUSH	H
  08A5'   32 0AE3'              	STA	UNDB1
  08A8'   21 0A99'              	LXI	H,UBEG
  08AB'   CD 0505'              	CALL	PRSPAN		; BC = the region's size
  08AE'   2A 0AE1'              	LHLD	UNDPTR
  08B1'   EB                    	XCHG			; DE = where the next byte goes
  08B2'   60                    	MOV	H,B
  08B3'   69                    	MOV	L,C
  08B4'   CD 05D7'              	CALL	CMP16		; CY iff that is still inside the region
  08B7'   D2 08CD'              	JNC	UNDAPF
  08BA'   2A 0A99'              	LHLD	UBEG		; re-read: a relocation moves the region
  08BD'   19                    	DAD	D
  08BE'   3A 0AE3'              	LDA	UNDB1
  08C1'   77                    	MOV	M,A
  08C2'   2A 0AE1'              	LHLD	UNDPTR
  08C5'   23                    	INX	H
  08C6'   22 0AE1'              	SHLD	UNDPTR
  08C9'   B7                    	ORA	A		; CY clear: it went in
  08CA'   C3 0604'              	JMP	POPRET
  08CD'                         UNDAPF:
  08CD'   3E 01                 	MVI	A,1
  08CF'   32 0ACF'              	STA	UNDBAD
  08D2'   37                    	STC
  08D3'   C3 0604'              	JMP	POPRET
                                
                                ;UNDRM -- CY, and the change given up on, unless the arena still holds UNDRSV
                                ;free.  The capture must never page: paging moves the window off the change and
                                ;would invalidate every logical offset the records hold.  Keeping this much
                                ;free also keeps MKGAP off its MKROOM path, so the capture cannot page even by
                                ;accident, and it fails QUIETLY where QROOM raises 'QBUF FULL' -- undo going
                                ;away must never stop the editing.
  08D6'                         UNDRM:
  08D6'   C5                    	PUSH	B
  08D7'   D5                    	PUSH	D
  08D8'   E5                    	PUSH	H
  08D9'   CD 049F'              	CALL	BUFSUM		; DE = the arena's free bytes
  08DC'   21 0200               	LXI	H,UNDRSV
  08DF'   CD 05D7'              	CALL	CMP16		; CY iff less than that is left
  08E2'   D2 0604'              	JNC	POPRET
  08E5'   3E 01                 	MVI	A,1
  08E7'   32 0ACF'              	STA	UNDBAD
  08EA'   37                    	STC
  08EB'   C3 0604'              	JMP	POPRET
                                
                                ;---------------------------------------------------------------- the replay
                                
                                ;UNDO -- 'u'.  CY when there is nothing to undo: no change captured, a change
                                ;too big to have been captured, or the pager has moved the window off it.
  08EE'                         UNDO:
  08EE'   AF                    	XRA	A
  08EF'   32 0AD3'              	STA	UNDWHY		; refused for want of a change, until told else
  08F2'   3A 0ACF'              	LDA	UNDBAD		; asked BEFORE the count of records: a change
  08F5'   B7                    	ORA	A		;   too big from its very first step leaves
  08F6'   CA 0900'              	JZ	UND_OK		;   none, and is still not 'nothing to undo'
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  08F9'   3E 02                 	MVI	A,2
  08FB'   32 0AD3'              	STA	UNDWHY		; too big to have been captured: CMD.MAC says
  08FE'   37                    	STC			;   so, rather than ringing the bell at a user
  08FF'   C9                    	RET			;   who has no way to know why
  0900'                         UND_OK:
  0900'   3A 0ACD'              	LDA	UNDN
  0903'   B7                    	ORA	A
  0904'   37                    	STC
  0905'   C8                    	RZ			; nothing captured
  0906'   2A 0000*              	LHLD	PGTOPM
  0909'   EB                    	XCHG
  090A'   2A 0ADF'              	LHLD	UNDPG
  090D'   CD 05D7'              	CALL	CMP16
  0910'   C2 093C'              	JNZ	UNDPGD		; the pager has moved the window's top since,
                                				;   so every offset the records hold has shifted
  0913'   3E FF                 	MVI	A,0FFH
  0915'   32 0AE8'              	STA	UNDML		; (no step taken yet)
  0918'   3E 01                 	MVI	A,1
  091A'   32 0AD1'              	STA	UNDRPL		; the replay's own edits are not a new change
  091D'   3A 0ACE'              	LDA	UNDST
  0920'   FE 01                 	CPI	1
  0922'   CA 0943'              	JZ	UNDREV
                                	;--- the last 'u' undid it: apply the records forward again (a redo) ---
  0925'   AF                    	XRA	A
  0926'   32 0AD2'              	STA	UNDDIR
  0929'   AF                    	XRA	A
  092A'                         UNDFWL:
  092A'   CD 0964'              	CALL	URSTEP
  092D'   3C                    	INR	A
  092E'   47                    	MOV	B,A
  092F'   3A 0ACD'              	LDA	UNDN
  0932'   B8                    	CMP	B
  0933'   78                    	MOV	A,B
  0934'   C2 092A'              	JNZ	UNDFWL
  0937'   3E 01                 	MVI	A,1
  0939'   C3 0955'              	JMP	UNDFIN
  093C'                         UNDPGD:
  093C'   3E 01                 	MVI	A,1
  093E'   32 0AD3'              	STA	UNDWHY		; the change is no longer in the window
  0941'   37                    	STC
  0942'   C9                    	RET
  0943'                         UNDREV:
                                	;--- undo: the records backward, each one's inverse ---
  0943'   3E 01                 	MVI	A,1
  0945'   32 0AD2'              	STA	UNDDIR
  0948'   3A 0ACD'              	LDA	UNDN
  094B'                         UNDRVL:
  094B'   3D                    	DCR	A
  094C'   CD 0964'              	CALL	URSTEP
  094F'   B7                    	ORA	A
  0950'   C2 094B'              	JNZ	UNDRVL
  0953'   3E 02                 	MVI	A,2
  0955'                         UNDFIN:
  0955'   32 0ACE'              	STA	UNDST
  0958'   AF                    	XRA	A
  0959'   32 0AD1'              	STA	UNDRPL
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


                                	;--- the cursor goes back where the command that changed it began:
                                	;    measured from vim, which restores that and not the change's own
                                	;    offset (CMD.MAC's VC_UNDO holds it inside the line) ---
  095C'   2A 0AE6'              	LHLD	UNDCUR
  095F'   CD 068D'              	CALL	GOTO
  0962'   B7                    	ORA	A		; CY clear: it happened
  0963'   C9                    	RET
                                
                                ;URSTEP -- apply record A: as it stands when UNDDIR is 0 (a redo), inverted
                                ;when it is 1 (an undo).  An insert applied puts its saved bytes back at its
                                ;offset; an insert inverted deletes that many bytes there; a delete is the
                                ;mirror of both.  A is preserved -- UNDO's loops count with it.
  0964'                         URSTEP:
  0964'   F5                    	PUSH	PSW
  0965'   CD 0824'              	CALL	URADDR
  0968'   7E                    	MOV	A,M
  0969'   32 0AD4'              	STA	UNDTY
  096C'   23                    	INX	H
  096D'   7E                    	MOV	A,M
  096E'   32 0AD5'              	STA	UNDOF
  0971'   23                    	INX	H
  0972'   7E                    	MOV	A,M
  0973'   32 0AD6'              	STA	UNDOF+1
  0976'   23                    	INX	H
  0977'   7E                    	MOV	A,M
  0978'   32 0AD7'              	STA	UNDLN
  097B'   23                    	INX	H
  097C'   7E                    	MOV	A,M
  097D'   32 0AD8'              	STA	UNDLN+1
  0980'   23                    	INX	H
  0981'   7E                    	MOV	A,M
  0982'   32 0AD9'              	STA	UNDBO
  0985'   23                    	INX	H
  0986'   7E                    	MOV	A,M
  0987'   32 0ADA'              	STA	UNDBO+1
  098A'   2A 0AD9'              	LHLD	UNDBO		; a line end among its bytes: more than one
  098D'   EB                    	XCHG			;   line changes (UNDML: CMD.MAC picks the
  098E'   2A 0A99'              	LHLD	UBEG		;   repaint by it)
  0991'   19                    	DAD	D
  0992'   EB                    	XCHG
  0993'   2A 0AD7'              	LHLD	UNDLN
  0996'   19                    	DAD	D
  0997'   CD 06BD'              	CALL	LFCNT
  099A'   7A                    	MOV	A,D
  099B'   B3                    	ORA	E
  099C'   CA 09A4'              	JZ	URS_1L
  099F'   3E 01                 	MVI	A,1
  09A1'   32 0AE8'              	STA	UNDML
  09A4'                         URS_1L:
  09A4'   3A 0AD4'              	LDA	UNDTY
  09A7'   47                    	MOV	B,A
  09A8'   3A 0AD2'              	LDA	UNDDIR
  09AB'   B7                    	ORA	A
  09AC'   CA 09B8'              	JZ	URS_AP
  09AF'   78                    	MOV	A,B		; an undo inverts the record
  09B0'   FE 01                 	CPI	UR_INS
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  09B2'   CA 09BE'              	JZ	URS_DL
  09B5'   C3 09C9'              	JMP	URS_IN
  09B8'                         URS_AP:
  09B8'   78                    	MOV	A,B		; a redo applies it as it stands
  09B9'   FE 01                 	CPI	UR_INS
  09BB'   CA 09C9'              	JZ	URS_IN
  09BE'                         URS_DL:
                                	;--- take the record's length back out at its offset ---
  09BE'   CD 09F6'              	CALL	URGOTO
  09C1'   2A 0AD7'              	LHLD	UNDLN
  09C4'   CD 06E8'              	CALL	DELFWD
  09C7'   F1                    	POP	PSW
  09C8'   C9                    	RET
  09C9'                         URS_IN:
                                	;--- put the record's saved bytes back in at its offset ---
  09C9'   CD 09F6'              	CALL	URGOTO
  09CC'   2A 0AD7'              	LHLD	UNDLN
  09CF'   44                    	MOV	B,H
  09D0'   4D                    	MOV	C,L
  09D1'   2A 0AD9'              	LHLD	UNDBO
  09D4'                         URSILP:
  09D4'   C5                    	PUSH	B
  09D5'   E5                    	PUSH	H
  09D6'   EB                    	XCHG			; DE = the byte's offset within the region
  09D7'   2A 0A99'              	LHLD	UBEG		; ... re-read every byte: inserting text can
  09DA'   19                    	DAD	D		;     slide the region out from under it
  09DB'   7E                    	MOV	A,M
  09DC'   CD 0045'              	CALL	PUTGAP
  09DF'   FE 0A                 	CPI	LF
  09E1'   C2 09EB'              	JNZ	URSILN
  09E4'   2A 0AEB'              	LHLD	LNDLT		; a line end put back is the cursor crossing
  09E7'   23                    	INX	H		;   one, and GOTO keeps LNDLT for every move the
  09E8'   22 0AEB'              	SHLD	LNDLT		;   replay makes -- so the renderer needs no
  09EB'                         URSILN:				;   whole-window rescan to find that out
  09EB'   E1                    	POP	H
  09EC'   C1                    	POP	B
  09ED'   23                    	INX	H
  09EE'   0B                    	DCX	B
  09EF'   78                    	MOV	A,B
  09F0'   B1                    	ORA	C
  09F1'   C2 09D4'              	JNZ	URSILP
  09F4'   F1                    	POP	PSW
  09F5'   C9                    	RET
                                
                                ;URGOTO -- the cursor to the record's offset.  The line the first step is on
                                ;is the change's (UNDL0 = LNDLT there, which GOTO keeps up); a later step on
                                ;another line makes the change more than one line's (UNDML).
  09F6'                         URGOTO:
  09F6'   2A 0AD5'              	LHLD	UNDOF
  09F9'   CD 068D'              	CALL	GOTO
  09FC'   2A 0AEB'              	LHLD	LNDLT
  09FF'   EB                    	XCHG
  0A00'   3A 0AE8'              	LDA	UNDML
  0A03'   3C                    	INR	A
  0A04'   C2 0A0F'              	JNZ	URG_1
  0A07'   32 0AE8'              	STA	UNDML		; (0: one line, so far)
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0A0A'   EB                    	XCHG
  0A0B'   22 0AE9'              	SHLD	UNDL0
  0A0E'   C9                    	RET
  0A0F'                         URG_1:
  0A0F'   2A 0AE9'              	LHLD	UNDL0
  0A12'   CD 05D7'              	CALL	CMP16
  0A15'   C8                    	RZ
  0A16'   3E 01                 	MVI	A,1
  0A18'   32 0AE8'              	STA	UNDML
  0A1B'   C9                    	RET
                                
                                ;---------------------------------------------------------------- the hooks
                                
                                ;UNDPUT -- PUTGAP's tail: the one byte now sitting just below the cursor.
  0A1C'                         UNDPUT:
  0A1C'   F5                    	PUSH	PSW
  0A1D'   C5                    	PUSH	B
  0A1E'   D5                    	PUSH	D
  0A1F'   E5                    	PUSH	H
  0A20'   CD 063C'              	CALL	CUROFF
  0A23'   2B                    	DCX	H
  0A24'   01 0001               	LXI	B,1
  0A27'   3E 01                 	MVI	A,UR_INS
  0A29'   CD 079E'              	CALL	UNDCHG
  0A2C'   C3 0A8A'              	JMP	UNDHX
                                
                                ;UNDGET -- QGET's tail: BC bytes of register now in, the cursor past them.
                                ;UNDINS is the same entry by its general name: INSBLK itself carries NO hook
                                ;(insert mode records a byte at a time through PUTGAP), so a command that
                                ;splices a block in -- ':s' replacing a match -- has to say so itself, exactly
                                ;as QGET does.  Without it 'u' puts the deleted text back and leaves the
                                ;inserted text there ('a-a-a' undid to 'aZ-aZ-aZ').
  0A2F'                         UNDINS:
  0A2F'                         UNDGET:
  0A2F'   F5                    	PUSH	PSW
  0A30'   C5                    	PUSH	B
  0A31'   D5                    	PUSH	D
  0A32'   E5                    	PUSH	H
  0A33'   78                    	MOV	A,B
  0A34'   B1                    	ORA	C
  0A35'   CA 0A8A'              	JZ	UNDHX
  0A38'   CD 063C'              	CALL	CUROFF
  0A3B'   50                    	MOV	D,B
  0A3C'   59                    	MOV	E,C
  0A3D'   CD 05B9'              	CALL	SUBHD		; HL = where the put began
  0A40'   3E 01                 	MVI	A,UR_INS
  0A42'   CD 079E'              	CALL	UNDCHG
  0A45'   C3 0A8A'              	JMP	UNDHX
                                
                                ;UNDDLF -- DELFWD's head: HL bytes about to go forward from the cursor.
  0A48'                         UNDDLF:
  0A48'   F5                    	PUSH	PSW
  0A49'   C5                    	PUSH	B
  0A4A'   D5                    	PUSH	D
  0A4B'   E5                    	PUSH	H
  0A4C'   44                    	MOV	B,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0A4D'   4D                    	MOV	C,L
  0A4E'   CD 063C'              	CALL	CUROFF
  0A51'   3E 02                 	MVI	A,UR_DEL
  0A53'   CD 079E'              	CALL	UNDCHG
  0A56'   C3 0A8A'              	JMP	UNDHX
                                
                                ;UNDDLQ -- QPUTLN's head: BC bytes of whole lines about to go into the register.
  0A59'                         UNDDLQ:
  0A59'   F5                    	PUSH	PSW
  0A5A'   C5                    	PUSH	B
  0A5B'   D5                    	PUSH	D
  0A5C'   E5                    	PUSH	H
  0A5D'   CD 063C'              	CALL	CUROFF
  0A60'   3E 02                 	MVI	A,UR_DEL
  0A62'   CD 079E'              	CALL	UNDCHG
  0A65'   C3 0A8A'              	JMP	UNDHX
                                
                                ;UNDDLP -- DELPRV's head: the one byte just below the cursor, about to go.
  0A68'                         UNDDLP:
  0A68'   F5                    	PUSH	PSW
  0A69'   C5                    	PUSH	B
  0A6A'   D5                    	PUSH	D
  0A6B'   E5                    	PUSH	H
  0A6C'   CD 063C'              	CALL	CUROFF
  0A6F'   2B                    	DCX	H
  0A70'   01 0001               	LXI	B,1
  0A73'   3E 02                 	MVI	A,UR_DEL
  0A75'   CD 079E'              	CALL	UNDCHG
  0A78'   C3 0A8A'              	JMP	UNDHX
                                
                                ;UNDUDF -- UNDELF's tail: the byte DELTO just made text again, at the cursor.
  0A7B'                         UNDUDF:
  0A7B'   F5                    	PUSH	PSW
  0A7C'   C5                    	PUSH	B
  0A7D'   D5                    	PUSH	D
  0A7E'   E5                    	PUSH	H
  0A7F'   CD 063C'              	CALL	CUROFF
  0A82'   01 0001               	LXI	B,1
  0A85'   3E 01                 	MVI	A,UR_INS
  0A87'   CD 079E'              	CALL	UNDCHG
                                ;UNDHX -- every hook leaves the primitive's own registers and flags alone.
  0A8A'                         UNDHX:
  0A8A'   E1                    	POP	H
  0A8B'   D1                    	POP	D
  0A8C'   C1                    	POP	B
  0A8D'   F1                    	POP	PSW
  0A8E'   C9                    	RET
                                
                                ;============================================================
                                ; DATA -- the (base,limit) pointer row (WM 6828-6871 layout) + scratch.
                                ; The disassembly's DB values for these cells are aliased code bytes; only the
                                ; order/adjacency is authoritative.  BINIT sets every cell at run time.
                                ;============================================================
  0A8F'   0000                  BUFBEG: DW	0		; region-array base
  0A91'   0000                  QBEG:	DW	0		; ^Q scratch buffer begin
  0A93'   0000                  QEND:	DW	0		; ^Q scratch buffer end
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0A95'   0000                  HOLEQP:	 DW	 0
  0A97'   0000                  TXTBAS: DW	0		; text base = PBEGMEM+1 (past the 0 sentinel)
                                ;UBEG/UEND -- APPENDED: the undo region, a region of the arena like the Q
                                ;buffer, with UEND its insertion point.  It goes HERE, between the slider and
                                ;the text, so both of the row's interleaved walks stay aligned: the holes from
                                ;BUFBEG are (BUFBEG,QBEG) (QEND,HOLEQP) (TXTBAS,UBEG) (UEND,TXTBEG)
                                ;(GAPBEG,GAPEND) (TXTEND,BUFEND), and the data regions from QBEG are
                                ;(QBEG,QEND) (HOLEQP,TXTBAS) (UBEG,UEND) (TXTBEG,GAPBEG) (GAPEND,TXTEND).
                                ;NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN, PRSPAN and INIBAS's count are all
                                ;untouched by it; INIGAP empties it.
  0A99'   0000                  UBEG:	DW	0		; undo region begin
  0A9B'   0000                  UEND:	DW	0		; undo region end = its insertion point
  0A9D'   0000                  TXTBEG: DW	0		; window start
  0A9F'   0000                  GAPBEG: DW	0		; cursor / gap start
  0AA1'   0000                  GAPEND: DW	0		; gap end / first char after cursor
  0AA3'   0000                  TXTEND: DW	0		; window end
  0AA4'                         PRTERM	 EQU	 TXTEND+1	 ; NEXTPR terminator = high byte of TXTEND
  0AA5'   0000                  BUFEND: DW	0		; top of usable text RAM
  0AA6'                         MVGTOP	 EQU	 BUFEND+1	 ; MOVGAP upper bound = high byte of BUFEND
                                
  0AA7'   00                    ERRFLG: DB	0		; nonzero after ERRMSG fired (harness reads it)
                                
                                ;The search pattern, in WM's SRCHBUF layout (WM 6900): the length, then the
                                ;string, 0-terminated.  CMD.MAC fills it from the '/' line and passes DE =
                                ;SRCHST; FWDCNT reads the length from the byte below that, as WM does.
  0AA8'   1E                    SRCMAX: DB	SRMAX		; ... its capacity, so CMD.MAC cannot drift
  0AA9'   00                    SRCHBF: DB	0		; the pattern length
  0AAA'                         SRCHST: DS	SRMAX+1		; the pattern, 0-terminated
                                
  0AC9'   0000                  L2756:	DW	0		; WM L2756 -- GOLINE's last target position
  0ACB'   0000                  QCPDON: DW	0		; (appended) QCPYN: bytes already copied in
                                ;--- 'u' (undo): see the UNDO section above for how these are driven.
  0ACD'   00                    UNDN:	DB	0		; steps captured (0 = nothing to undo)
  0ACE'   00                    UNDST:	DB	0		; 0 none, 1 change applied ('u' undoes it),
                                				;   2 already undone ('u' puts it back)
  0ACF'   00                    UNDBAD: DB	0		; 1 = this change was too big to capture
  0AD0'   01                    UNDNEW: DB	1		; 1 = the next capture starts a new change
  0AD1'   00                    UNDRPL: DB	0		; 1 = 'u' replaying, so nothing is captured
  0AD2'   00                    UNDDIR: DB	0		; the replay's direction (0 forward, 1 inverse)
  0AD3'   00                    UNDWHY: DB	0		; 0 = nothing to undo, 1 = it has paged away
  0AD4'   00                    UNDTY:	DB	0		; the step / record type being handled
  0AD5'   0000                  UNDOF:	DW	0		; ... its logical offset
  0AD7'   0000                  UNDLN:	DW	0		; ... its length
  0AD9'   0000                  UNDBO:	DW	0		; ... where its bytes lie in the region
  0ADB'   0000                  UNDCL:	DW	0		; the length being captured (BC does not survive)
  0ADD'   0000                  UNDLSA: DW	0		; the last record's address (UNDEXT's scratch)
  0ADF'   0000                  UNDPG:	DW	0		; PGTOPM when this change was captured
  0AE1'   0000                  UNDPTR: DW	0		; the region's write point, as an OFFSET
  0AE3'   00                    UNDB1:	DB	0		; the byte going in (PRSPAN wants BC)
  0AE4'   0000                  UNDPCU: DW	0		; the cursor as the current command began
  0AE6'   0000                  UNDCUR: DW	0		; ... as the command that made THIS change began
  0AE8'   00                    UNDML:	DB	0		; the replay: 0 = every step on one line, no
                                				;   line end put back or taken (0FFH: no step
                                				;   yet, 1: not so)
  0AE9'   0000                  UNDL0:	DW	0		; ... LNDLT with the cursor on that line
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0AEB'   0000                  LNDLT:	DW	0		; (appended) lines the cursor moved since the last
                                				;   screen layout (signed; SCRN.MAC consumes it)
                                
                                ;PBEGMEM -- base of the text arena: the first RAM byte past everything the
                                ;program holds.  The gap buffer's text lives from here up to BUFEND.  BUF
                                ;links last but RSV.MAC links after it, holding the reserve block in the RAM
                                ;immediately above the image (it emits no bytes of its own), so the arena
                                ;starts at RSVTOP -- past the reserves -- and is the size it always was.
  0AED'   0000*                 PBEGMEM:DW	RSVTOP
                                
  0AEF'                         MEMBAS:				; top of the linked image (RSV.MAC's base)
                                
                                	END
