  0553'   47                    	MOV	B,A
  0554'   F1                    	POP	PSW
  0555'   C9                    	RET
                                
                                ;SUBDH -- WM 5282: HL := DE - HL.  SUBHD -- WM 5286: HL := HL - DE.
  0556'                         SUBDH:				; WM 5282
  0556'   EB                    	XCHG
  0557'                         SUBHD:				; WM 5286
  0557'   D5                    	PUSH	D
  0558'   EB                    	XCHG
  0559'   CD 0542'              	CALL	NEGHL
  055C'   EB                    	XCHG
  055D'   19                    	DAD	D
  055E'   D1                    	POP	D
  055F'   C9                    	RET
                                
                                ;SPANBC -- WM 5296: BC := HL - DE (HL kept; Z if zero).
  0560'                         SPANBC:				; WM 5296
  0560'   E5                    	PUSH	H
  0561'   CD 0557'              	CALL	SUBHD
  0564'   44                    	MOV	B,H
  0565'   4D                    	MOV	C,L
  0566'   E1                    	POP	H
  0567'   78                    	MOV	A,B
  0568'   B1                    	ORA	C
  0569'   C9                    	RET
                                
                                ;LDPAI2/LDPAIR -- WM 5307/5312: load a (base,limit) pair into DE,HL.
                                ;NOTE: LDPAIR falls through into LDHLI (no RET) -- DE := base, HL := limit.
  056A'                         LDPAI2:			       ; WM 5307
  056A'   2B                    	DCX	H
  056B'   2B                    	DCX	H
  056C'                         LDPAIR:				; WM 5312
  056C'   5E                    	MOV	E,M
  056D'   23                    	INX	H
  056E'   56                    	MOV	D,M
  056F'   23                    	INX	H
                                ;LDHLI -- WM 5320: HL := word@HL.
  0570'                         LDHLI:				; WM 5320
  0570'   7E                    	MOV	A,M
  0571'   23                    	INX	H
  0572'   66                    	MOV	H,M
  0573'   6F                    	MOV	L,A
  0574'   C9                    	RET
                                
                                ;CMP16 -- WM 5333: 16-bit unsigned compare DE against HL (D-H, then E-L).
                                ;A preserved; only flags returned.  CY iff DE < HL; Z iff DE == HL.
  0575'                         CMP16:				; WM 5333
  0575'   C5                    	PUSH	B
  0576'   47                    	MOV	B,A
  0577'   7A                    	MOV	A,D
  0578'   94                    	SUB	H
  0579'   C2 057E'              	JNZ	CMPLOW
  057C'   7B                    	MOV	A,E
  057D'   95                    	SUB	L
  057E'                         CMPLOW:				 ; WM 5342
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  057E'   78                    	MOV	A,B
  057F'   C1                    	POP	B
  0580'   C9                    	RET
                                
                                ;SUBCLP -- WM 5348: HL := max(0, HL-DE); CY if positive.
  0581'                         SUBCLP:				; WM 5348
  0581'   CD 0575'              	CALL	CMP16
  0584'   DA 058C'              	JC	SCLPPO
  0587'                         SCLPZ:				; WM 5352
  0587'   21 0000               	LXI	H,0H
  058A'   B7                    	ORA	A
  058B'   C9                    	RET
  058C'                         SCLPPO:				 ; WM 5357
  058C'   E5                    	PUSH	H
  058D'   CD 0557'              	CALL	SUBHD
  0590'   D1                    	POP	D
  0591'   37                    	STC
  0592'   C9                    	RET
                                
                                ;SUBCP2 -- WM 5365: HL := max(0, DE-HL); CY if positive.
  0593'                         SUBCP2:			       ; WM 5365
  0593'   CD 0575'              	CALL	CMP16
  0596'   CA 0587'              	JZ	SCLPZ
  0599'   DA 0587'              	JC	SCLPZ
  059C'   EB                    	XCHG
  059D'   CD 0557'              	CALL	SUBHD
  05A0'   37                    	STC
  05A1'   C9                    	RET
                                
                                
                                ;POPRET -- WM 5387: shared epilogue for the PUSH B/PUSH D/PUSH H prologue.
  05A2'                         POPRET:				; WM 5387
  05A2'   E1                    	POP	H
  05A3'   D1                    	POP	D
  05A4'   C1                    	POP	B
  05A5'   C9                    	RET
                                
                                ;============================================================
                                ; PAGESTP -- the count-limited scroll step.  The disk-eviction seam
                                ; (MKROOM/SPILL/SPILLB/PAGEBOT/REWIND), the deque marks (MARKGB/UPDMARK/RECBASE/
                                ; PTRREC) and the paging drivers (PAGEDIR/PGNEED/PAGEWIN) are all real in
                                ; PAGE.MAC, and CNTTST/CMDCNT/AUXCNT now exist in CMD.MAC.
                                ;============================================================
                                
                                ;PAGESTP -- WM 4311: page one step in the scroll direction, count-limited.
                                ;CNTTST returns Z when the command count (CMDCNT and AUXCNT) is exhausted, so a
                                ;completed edit or motion stops here (RZ); otherwise fall into PAGEDIR to page
                                ;the window one increment in the current scroll direction (DIRFLG: REWIND back,
                                ;FILLBUF forward).  In WM PAGESTP falls through to the physically adjacent
                                ;PAGEDIR; here PAGEDIR lives in PAGE.MAC, so the fall-through is an explicit
                                ;JMP -- same object behavior, PAGEDIR's own POLLBRK still runs.  DELTO's tail
                                ;JMPs here, so a delete made with the count spent returns at once; the count
                                ;loops (dd's QPUTLN, MVLLOOP's line moves, the search sweep through SCRLST)
                                ;are what page the window on past its edge.
                                ;SCRLST -- WM 4307: poll type-ahead, PUTCUR to HL, then (count not spent)
                                ;fall into PAGESTP to page the window one step in the DIRFLG direction.
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  05A6'                         SCRLST:				; WM 4307
  05A6'   CD 0000*              	CALL	POLLBRK
  05A9'   CD 036A'              	CALL	PUTCUR
                                
  05AC'                         PAGESTP:			; WM 4311
  05AC'   CD 0000*              	CALL	CNTTST
  05AF'   C8                    	RZ
  05B0'   C3 0000*              	JMP	PAGEDIR
                                
                                ;============================================================
                                ; ERRMSG -- WM 664, message-print transcribed; TAIL adapted (see header):
                                ; print the inline 0-terminated message, set ERRFLG, warm-boot to CP/M.
                                ;============================================================
  05B3'                         ERRMSG:				; WM 664 (tail adapted)
  05B3'   E1                    	POP	H		; HL -> inline message (after the CALL)
  05B4'   3E FF                 	MVI	A,0FFH
  05B6'   32 09EE'              	STA	ERRFLG		; record that an error fired
  05B9'                         ERMLP:
  05B9'   7E                    	MOV	A,M
  05BA'   B7                    	ORA	A
  05BB'   CA 05CA'              	JZ	ERMEND
  05BE'   E5                    	PUSH	H
  05BF'   5F                    	MOV	E,A
  05C0'   0E 02                 	MVI	C,2		; BDOS console out
  05C2'   CD 0005               	CALL	BDOS
  05C5'   E1                    	POP	H
  05C6'   23                    	INX	H
  05C7'   C3 05B9'              	JMP	ERMLP
  05CA'                         ERMEND:
  05CA'   C3 0000               	JMP	WBOOT		; adapted tail: back to CP/M
                                
                                ;============================================================
                                ; LOGICAL-OFFSET API  (APPENDED -- NOT WordMaster).
                                ; The gap-agnostic view the vi layer (CMD.MAC) uses so it never touches the raw
                                ; pointer row.  A logical offset is a byte index into resident text as if the
                                ; gap were absent:
                                ;   before = GAPBEG - TXTBEG   (bytes before the cursor = cursor logical offset)
                                ;   after  = TXTEND - GAPEND   (bytes at/after the cursor)
                                ;   LOGLEN = before + after
                                ; Most of CMD.MAC's verbs work in these offsets alone; the rest drive WM's
                                ; pointer-based routines (PUTCUR, the line moves, RGET, the matchers, the
                                ; Q-buffer), which page as they go, and a few read the pointer row directly.
                                ;============================================================
                                
                                ;CUROFF -- HL = cursor logical offset (= before length).
  05CD'                         CUROFF:
  05CD'   2A 09E4'              	LHLD	TXTBEG
  05D0'   EB                    	XCHG
  05D1'   2A 09E6'              	LHLD	GAPBEG
  05D4'   CD 0557'              	CALL	SUBHD		; HL = GAPBEG - TXTBEG
  05D7'   C9                    	RET
                                
                                ;AFTLN2 -- HL = after length (TXTEND - GAPEND).  Private helper for LOGLEN.
  05D8'                         AFTLN2:
  05D8'   2A 09E8'              	LHLD	GAPEND
  05DB'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  05DC'   2A 09EA'              	LHLD	TXTEND
  05DF'   CD 0557'              	CALL	SUBHD
  05E2'   C9                    	RET
                                
                                ;LOGLEN -- HL = total resident logical length.
  05E3'                         LOGLEN:
  05E3'   CD 05CD'              	CALL	CUROFF
  05E6'   E5                    	PUSH	H
  05E7'   CD 05D8'              	CALL	AFTLN2
  05EA'   D1                    	POP	D
  05EB'   19                    	DAD	D
  05EC'   C9                    	RET
                                
                                ;L2PHYS -- HL(off) -> HL(physical address).  0 <= off <= LOGLEN.  Private.
  05ED'                         L2PHYS:
  05ED'   EB                    	XCHG			; DE = off
  05EE'   D5                    	PUSH	D
  05EF'   CD 05CD'              	CALL	CUROFF		; HL = before
  05F2'   D1                    	POP	D		; DE = off
  05F3'   CD 0575'              	CALL	CMP16		; DE=off vs HL=before: CY iff off < before
  05F6'   DA 0603'              	JC	L2P_BEF
                                	;--- after region: phys = GAPEND + (off - before) ---
  05F9'   EB                    	XCHG			; HL=off, DE=before
  05FA'   CD 0557'              	CALL	SUBHD		; HL = off - before
  05FD'   EB                    	XCHG			; DE = off-before
  05FE'   2A 09E8'              	LHLD	GAPEND
  0601'   19                    	DAD	D
  0602'   C9                    	RET
  0603'                         L2P_BEF:
                                	;--- before region: phys = TXTBEG + off  (DE = off, HL = before) ---
  0603'   2A 09E4'              	LHLD	TXTBEG
  0606'   19                    	DAD	D
  0607'   C9                    	RET
                                
                                ;CHARAT -- HL(off) -> A = byte at that logical offset (off < LOGLEN).
  0608'                         CHARAT:
  0608'   CD 05ED'              	CALL	L2PHYS
  060B'   7E                    	MOV	A,M
  060C'   C9                    	RET
                                
                                ;CLAMPL -- HL(off) -> HL clamped to [0, LOGLEN].  Private helper for GOTO.
  060D'                         CLAMPL:
  060D'   E5                    	PUSH	H
  060E'   CD 05E3'              	CALL	LOGLEN
  0611'   D1                    	POP	D		; DE = off
  0612'   CD 0575'              	CALL	CMP16		; DE=off vs HL=LOGLEN
  0615'   DA 061C'              	JC	CLK_KEEP	; off < LOGLEN
  0618'   CA 061C'              	JZ	CLK_KEEP	; off == LOGLEN
  061B'   C9                    	RET			; off > LOGLEN -> HL = LOGLEN
  061C'                         CLK_KEEP:
  061C'   EB                    	XCHG			; HL = off
  061D'   C9                    	RET
                                
                                ;GOTO -- HL(off): move the cursor to that logical offset.
                                ;PUTCUR takes its target address in HL (its entry XCHG moves it to DE).
                                ;The line feeds the cursor crosses are added to LNDLT (subtracted going back).
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  061E'                         GOTO:
  061E'   CD 060D'              	CALL	CLAMPL
  0621'   CD 05ED'              	CALL	L2PHYS		; HL = physical address
  0624'   E5                    	PUSH	H
  0625'   EB                    	XCHG			; DE = target
  0626'   2A 09E8'              	LHLD	GAPEND
  0629'   CD 0575'              	CALL	CMP16		; CY iff target < GAPEND (before the gap)
  062C'   DA 063A'              	JC	GTO_BK
  062F'   EB                    	XCHG			; forward: count [GAPEND, target)
  0630'   CD 064E'              	CALL	LFCNT
  0633'   2A 0A2D'              	LHLD	LNDLT
  0636'   19                    	DAD	D
  0637'   C3 0646'              	JMP	GTO_ST
  063A'                         GTO_BK:
  063A'   2A 09E6'              	LHLD	GAPBEG		; back: count [target, GAPBEG)
  063D'   CD 064E'              	CALL	LFCNT
  0640'   2A 0A2D'              	LHLD	LNDLT
  0643'   CD 0557'              	CALL	SUBHD
  0646'                         GTO_ST:
  0646'   22 0A2D'              	SHLD	LNDLT
  0649'   E1                    	POP	H
  064A'   CD 036A'              	CALL	PUTCUR
  064D'   C9                    	RET
                                
                                ;LFCNT -- DE = start, HL = end (>= start): DE = number of LFs in [start, end).
  064E'                         LFCNT:
  064E'   CD 0557'              	CALL	SUBHD		; HL = end - start
  0651'   44                    	MOV	B,H
  0652'   4D                    	MOV	C,L		; BC = length
  0653'   EB                    	XCHG			; HL = start
  0654'   11 0000               	LXI	D,0
  0657'                         LFC_LP:
  0657'   78                    	MOV	A,B
  0658'   B1                    	ORA	C
  0659'   C8                    	RZ
  065A'   7E                    	MOV	A,M
  065B'   23                    	INX	H
  065C'   0B                    	DCX	B
  065D'   FE 0A                 	CPI	LF
  065F'   C2 0657'              	JNZ	LFC_LP
  0662'   13                    	INX	D
  0663'   C3 0657'              	JMP	LFC_LP
                                
                                ;RDGET -- RGET, and CY also when a refill read nothing.  INRDY stays set after
                                ;a file's last full record (no ^Z) until a read fails; NEEDIN then returns NC
                                ;having added nothing, and RGET steps past TXTEND leaving BC = FFFFH.  That is
                                ;reported as the end of the text, with BC = 0 so a later call asks NEEDIN again.
  0666'                         RDGET:
  0666'   CD 04B5'              	CALL	RGET
  0669'   D8                    	RC
  066A'   F5                    	PUSH	PSW
  066B'   78                    	MOV	A,B
  066C'   A1                    	ANA	C
  066D'   3C                    	INR	A		; Z iff BC = FFFFH
  066E'   CA 0673'              	JZ	RDG_EF
  0671'   F1                    	POP	PSW
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  0672'   C9                    	RET
  0673'                         RDG_EF:
  0673'   F1                    	POP	PSW
  0674'   01 0000               	LXI	B,0
  0677'   37                    	STC
  0678'   C9                    	RET
                                
                                ;DELFWD -- HL = number of logical bytes to delete forward from the cursor.
  0679'                         DELFWD:
  0679'   7C                    	MOV	A,H
  067A'   B5                    	ORA	L
  067B'   C8                    	RZ			; nothing to delete
  067C'   CD 098F'              	CALL	UNDDLF		; (appended) the span, for 'u', before it goes
  067F'   EB                    	XCHG			; DE = count
  0680'   2A 09E8'              	LHLD	GAPEND
  0683'   19                    	DAD	D		; target = GAPEND + count
  0684'   AF                    	XRA	A		; S clear -> forward delete
  0685'   CD 0193'              	CALL	DELTO
  0688'   C9                    	RET
                                
                                ;DELPRV -- WM 3260 RUBOUT/DELL: delete the char left of the cursor, and the
                                ;CR too when that leaves one there (a CR,LF goes as one).  PEEKLX pages back
                                ;at the window start and returns at the start of the file.  WM's MARKCUR and
                                ;ROWUP (its screen) are left out; instead a deleted LF moves the cursor up a
                                ;line (LNDLT - 1) for SCRN.MAC.
  0689'                         DELPRV:				; WM 3260
  0689'   CD 018C'              	CALL	PEEKLX
  068C'   FE 0A                 	CPI	LF
  068E'   C2 069A'              	JNZ	DLP_GO
  0691'   E5                    	PUSH	H
  0692'   2A 0A2D'              	LHLD	LNDLT
  0695'   2B                    	DCX	H
  0696'   22 0A2D'              	SHLD	LNDLT
  0699'   E1                    	POP	H
  069A'                         DLP_GO:				; WM 3263 DELL
  069A'   CD 09AF'              	CALL	UNDDLP		; (appended) that byte, for 'u', before it goes
  069D'   CD 0055'              	CALL	SETGAPB
  06A0'   CD 017F'              	CALL	PEEKL
  06A3'   FE 0D                 	CPI	CR
  06A5'   CA 0689'              	JZ	DELPRV
  06A8'   C9                    	RET
                                
                                
                                ;UNDELF -- APPENDED, NOT WordMaster: give back the byte last swallowed forward
                                ;into the gap.  A forward delete only moves GAPEND past the byte, so the byte
                                ;itself is still there, inside the gap: GAPEND-1 through DELTO makes it text
                                ;again, with the record marks updated exactly as a delete updates them.
                                ;Replace mode ('R') puts back with it what it overwrote, as vim's BS in Replace
                                ;mode does.  The caller must know the gap has not moved since the delete
                                ;(CMD.MAC keeps GAPEND in RPGE for that); nothing else calls this.
  06A9'                         UNDELF:
  06A9'   2A 09E8'              	LHLD	GAPEND
  06AC'   2B                    	DCX	H
  06AD'   AF                    	XRA	A		; S clear -> the forward (GAPEND) side
  06AE'   CD 0193'              	CALL	DELTO
  06B1'   C3 09C2'              	JMP	UNDUDF		; (appended) the byte just made text again
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  APPENDED, NOT WordMaster: WM has no undo at all (its QBUFOP /
                                ; QEXEC macro is a command-LINE facility, not this).
                                ;
                                ; Six primitives change resident text, and each one says what it did: PUTGAP
                                ; (one byte in), QGET (the register in), DELFWD (a span out), DELPRV (one byte
                                ; out backward), UNDELF (one byte back in) and QPUTLN (whole lines out).
                                ; Nothing else in the editor reaches the text, so no command can forget to
                                ; record itself -- which is the whole reason the capture sits down here instead
                                ; of at CMD.MAC's edit sites.
                                ;
                                ; A record says only WHERE and HOW MUCH, in LOGICAL offsets, plus where its
                                ; bytes lie in the undo region.  Logical offsets survive the gap sliding (which
                                ; PUTCUR does on every cursor move) because the replay walks the records
                                ; BACKWARD: each step restores the offsets the steps after it were measured
                                ; against.  The bytes are kept for an insert as well as a delete -- an insert
                                ; costs its own text twice, which is nothing -- so the region is settled once
                                ; the command ends and 'u' can walk it either way: backward applying each
                                ; record's inverse to undo, forward applying the records as they stand to redo.
                                ; That is what makes 'u' undo 'u' with ONE region and no capture during the
                                ; replay.
                                ;
                                ; The region is a region of the arena like the Q buffer, inserted between the
                                ; slider and the text, and it grows through the same MKGAP: the pointer row
                                ; reads (UBEG,UEND) as data and (TXTBAS,UBEG) / (UEND,TXTBEG) as the holes
                                ; around it, so NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN and INIBAS all take it in
                                ; their stride unchanged.
                                ;
                                ; DEVIATIONS from vim, all deliberate and all in COMMANDS.md: ONE level of
                                ; undo, so 'u' undoes 'u' as real vi does; the change must still be in the
                                ; RESIDENT window, and 'u' refuses once the pager has moved off it rather than
                                ; chasing it through the file; and a change with more steps than the table
                                ; holds, or one the arena has no spare room to keep, is not undoable at all.
                                ;
                                ; "Moved off it" is PGTOPM, PAGE.MAC's count of the times the pager moved
                                ; TXTBEG.  It is the window's TOP that matters: an offset is measured from
                                ; TXTBEG, so spilling a record out from under it (PAGEOUT) or reading one back
                                ; in (REWIND) shifts every offset, while FILLBUF and PAGEBOT growing TXTEND at
                                ; the bottom shift none.  The OUTREC/SRCREC water marks look like the same
                                ; thing and are not: UPDMARK raises them on every edit.
                                ;============================================================
                                
  0001                          UR_INS	EQU	1		; text went IN  (undoing takes it back out)
  0002                          UR_DEL	EQU	2		; text came OUT (undoing puts it back)
  0007                          URSIZE	EQU	7		; type, offset(2), length(2), region offset(2)
  0018                          URMAX	EQU	24		; primitive steps one change may hold
                                ;How much of the arena the capture refuses to eat into.  It only has to keep
                                ;MKGAP off its MKROOM path (which wants 256 free), because paging is what undo
                                ;must not do -- so this is deliberately SMALL.  RESVMEM, QROOM's reserve, is
                                ;far too big: a 66 K file leaves under 1700 bytes free, and undo would never
                                ;engage at all on exactly the files that need it most.
  0200                          UNDRSV	EQU	200H		; ... 512 bytes
                                ;How much room the region claims up front, and so the largest change that can
                                ;be kept.  The claim is what lets the capture run without EVER growing the
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                                ;region: see UNDGRW for why growing where a primitive can see it is unsafe.
  0400                          UNDCAP	EQU	400H		; 1024 bytes of change
                                
                                ;UNDBEG -- CMD.MAC's command boundary: the NEXT captured change starts a new
                                ;undo.  A flag only, so a command that changes nothing -- a motion, a yank, a
                                ;key that is no command at all -- leaves the last change undoable, exactly as
                                ;'.' keeps the last change it recorded.
  06B4'                         UNDBEG:
  06B4'   D5                    	PUSH	D
  06B5'   E5                    	PUSH	H
  06B6'   3E 01                 	MVI	A,1
  06B8'   32 0A15'              	STA	UNDNEW
  06BB'   CD 05CD'              	CALL	CUROFF
  06BE'   22 0A29'              	SHLD	UNDPCU		; where the cursor was as this command began --
  06C1'   CD 06D0'              	CALL	UNDGRW		;   kept pending, because only a command that
  06C4'   E1                    	POP	H		;   really changes text gets to claim it
  06C5'   D1                    	POP	D
  06C6'   C9                    	RET
                                
                                ;UNDHER -- the change about to start belongs at the CURSOR: 'u' puts it back
                                ;there.  UNDBEG's cursor snapshot without its claim on the region, for a
                                ;command (':s') that cannot know where its first change will be until it has
                                ;found it.  Calling UNDBEG again instead would re-run UNDGRW in the middle of
                                ;the command, which is the one thing UNDGRW must never do -- see below.
  06C7'                         UNDHER:
  06C7'   E5                    	PUSH	H
  06C8'   CD 05CD'              	CALL	CUROFF
  06CB'   22 0A29'              	SHLD	UNDPCU
  06CE'   E1                    	POP	H
  06CF'   C9                    	RET
                                
                                ;UNDGRW -- make sure the region can take a whole change without growing again.
                                ;THE ONLY PLACE THE REGION GROWS, and it runs at the command boundary, where no
                                ;primitive is holding anything.  Growing moves regions about (MKGAP -> MOVGAP),
                                ;and that both invalidates a raw pointer a primitive is in the middle of using
                                ;-- DELPRV hands SETGAPB one -- and overwrites whatever is sitting in the gap,
                                ;which is where a forward-deleted byte waits for 'R's backspace to call UNDELF
                                ;and give it back.  So the room is claimed here, 256 bytes at a time, and the
                                ;capture below never calls MKGAP at all: it writes into the claim or gives up.
                                ;The room has to be claimed as the region's own CONTENT, not left as the hole
                                ;above it: the holes are shared, and the text takes whatever it can reach --
                                ;MOVGAP feeding an insert will walk straight through a hole reserved here, which
                                ;is what made a 200-character insert lose its undo halfway.  Once the bytes are
                                ;inside (UBEG,UEND) the text cannot have them: MOVGAP slides the region aside
                                ;instead.  Nothing here holds an address across MKGAP either, because MKGAP
                                ;slides this very region (HOLEUP moves UBEG and UEND) -- UEND is re-read from
                                ;its cell every time round.
  06D0'                         UNDGRW:
  06D0'   C5                    	PUSH	B
  06D1'   D5                    	PUSH	D
  06D2'   E5                    	PUSH	H
  06D3'                         UNDGRL:
  06D3'   21 09E0'              	LXI	H,UBEG
  06D6'   CD 04A3'              	CALL	PRSPAN		; BC = the region's size
  06D9'   50                    	MOV	D,B
  06DA'   59                    	MOV	E,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  06DB'   21 0400               	LXI	H,UNDCAP
  06DE'   CD 0575'              	CALL	CMP16		; CY iff it is smaller than one change
  06E1'   D2 05A2'              	JNC	POPRET
  06E4'   CD 085C'              	CALL	UNDRM		; ... but never at the cost of paging
  06E7'   DA 05A2'              	JC	POPRET
  06EA'   21 09E2'              	LXI	H,UEND
  06ED'   CD 00B0'              	CALL	MKGAP		; 256 free above the region ...
  06F0'   2A 09E2'              	LHLD	UEND
  06F3'   11 0100               	LXI	D,100H
  06F6'   19                    	DAD	D
  06F7'   22 09E2'              	SHLD	UEND		; ... taken into it, so the text cannot take
  06FA'   C3 06D3'              	JMP	UNDGRL		;     them back
                                
                                ;UNDCLR -- nothing is undoable (a fresh buffer; BINIT calls it through INIGAP).
  06FD'                         UNDCLR:
  06FD'   AF                    	XRA	A
  06FE'   32 0A12'              	STA	UNDN
  0701'   32 0A13'              	STA	UNDST
  0704'   32 0A14'              	STA	UNDBAD
  0707'   3E 01                 	MVI	A,1
  0709'   32 0A15'              	STA	UNDNEW
  070C'   C9                    	RET
                                
                                ;UNDRST -- the first capture of a new change: drop the last one and note where
                                ;the file window was, so 'u' can tell the pager has since moved off this change.
  070D'                         UNDRST:
  070D'   AF                    	XRA	A
  070E'   32 0A15'              	STA	UNDNEW
  0711'   32 0A12'              	STA	UNDN
  0714'   32 0A14'              	STA	UNDBAD
  0717'   21 0000               	LXI	H,0
  071A'   22 0A26'              	SHLD	UNDPTR		; the region's content empties (its SIZE stays:
                                				;   that is the room UNDGRW claimed)
  071D'   2A 0000*              	LHLD	PGTOPM
  0720'   22 0A24'              	SHLD	UNDPG
  0723'   2A 0A29'              	LHLD	UNDPCU
  0726'   22 0A2B'              	SHLD	UNDCUR		; ... and this command does change text, so this
                                				;   is where 'u' will put the cursor back
  0729'   3E 01                 	MVI	A,1
  072B'   32 0A13'              	STA	UNDST		; a change is on the buffer: 'u' undoes it
  072E'   C9                    	RET
                                
                                ;UNDCHG -- the capture every hooked primitive uses.  A = UR_INS / UR_DEL,
                                ;HL = the logical offset it acted at, BC = how many bytes.  The bytes are read
                                ;back out of the resident TEXT at that offset -- for a delete before they go,
                                ;for an insert once they have arrived -- so no caller hands over a pointer that
                                ;growing the region could leave stale.
  072F'                         UNDCHG:
  072F'   C5                    	PUSH	B
  0730'   D5                    	PUSH	D
  0731'   E5                    	PUSH	H
  0732'   32 0A19'              	STA	UNDTY		; the record type, kept out of the registers
  0735'   3A 0A16'              	LDA	UNDRPL
  0738'   B7                    	ORA	A
  0739'   C2 05A2'              	JNZ	POPRET		; 'u' replaying: its own edits are not a change
  073C'   3A 0A15'              	LDA	UNDNEW
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  073F'   B7                    	ORA	A
  0740'   CA 0746'              	JZ	UNDC1
  0743'   CD 070D'              	CALL	UNDRST		; the first step of a new change
  0746'                         UNDC1:
  0746'   3A 0A14'              	LDA	UNDBAD
  0749'   B7                    	ORA	A
  074A'   C2 05A2'              	JNZ	POPRET		; this change has already been given up on
  074D'   78                    	MOV	A,B
  074E'   B1                    	ORA	C
  074F'   CA 05A2'              	JZ	POPRET		; a zero-length step is no step
  0752'   60                    	MOV	H,B
  0753'   69                    	MOV	L,C
  0754'   22 0A20'              	SHLD	UNDCL		; UNDAPT spends BC as its countdown, so the
                                				;   length has to be kept somewhere else
  0757'   3A 0A12'              	LDA	UNDN
  075A'   FE 18                 	CPI	URMAX
  075C'   D2 07A2'              	JNC	UNDCBD		; no room for another step
                                	;--- where this step's bytes will land in the region ---
  075F'   2A 0A26'              	LHLD	UNDPTR
  0762'   22 0A1E'              	SHLD	UNDBO
  0765'   E1                    	POP	H
  0766'   E5                    	PUSH	H		; HL = the logical offset again
  0767'   CD 0812'              	CALL	UNDAPT		; BC bytes of the text there -> the region
  076A'   DA 07A2'              	JC	UNDCBD
                                	;--- fold it into the last record when it only carries that one on ---
  076D'   E1                    	POP	H
  076E'   E5                    	PUSH	H
  076F'   CD 07BA'              	CALL	UNDEXT
  0772'   CA 05A2'              	JZ	POPRET
                                	;--- otherwise a record of its own ---
  0775'   3A 0A12'              	LDA	UNDN
  0778'   CD 07AA'              	CALL	URADDR
  077B'   3A 0A19'              	LDA	UNDTY
  077E'   77                    	MOV	M,A
  077F'   23                    	INX	H
  0780'   D1                    	POP	D
  0781'   D5                    	PUSH	D		; DE = the logical offset
  0782'   73                    	MOV	M,E
  0783'   23                    	INX	H
  0784'   72                    	MOV	M,D
  0785'   23                    	INX	H
  0786'   EB                    	XCHG			; DE = the record, past the offset
  0787'   2A 0A20'              	LHLD	UNDCL
  078A'   EB                    	XCHG			; ... and HL back, with DE = the length
  078B'   73                    	MOV	M,E
  078C'   23                    	INX	H
  078D'   72                    	MOV	M,D
  078E'   23                    	INX	H
  078F'   3A 0A1E'              	LDA	UNDBO
  0792'   77                    	MOV	M,A
  0793'   23                    	INX	H
  0794'   3A 0A1F'              	LDA	UNDBO+1
  0797'   77                    	MOV	M,A
  0798'   3A 0A12'              	LDA	UNDN
  079B'   3C                    	INR	A
  079C'   32 0A12'              	STA	UNDN
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  079F'   C3 05A2'              	JMP	POPRET
  07A2'                         UNDCBD:
  07A2'   3E 01                 	MVI	A,1
  07A4'   32 0A14'              	STA	UNDBAD		; too big to keep: not undoable at all
  07A7'   C3 05A2'              	JMP	POPRET
                                
                                ;URADDR -- A = a record index -> HL = its address (base + n*8 - n).
  07AA'                         URADDR:
  07AA'   6F                    	MOV	L,A
  07AB'   26 00                 	MVI	H,0
  07AD'   5D                    	MOV	E,L
  07AE'   54                    	MOV	D,H
  07AF'   29                    	DAD	H
  07B0'   29                    	DAD	H
  07B1'   29                    	DAD	H		; HL = n*8
  07B2'   CD 0557'              	CALL	SUBHD		; HL = n*7
  07B5'   11 0000*              	LXI	D,UNDREC
  07B8'   19                    	DAD	D
  07B9'   C9                    	RET
                                
                                ;UNDEXT -- A = 0 (Z) when this step only carries the last record on: an insert
                                ;starting exactly where the last insert ended, which is what typing does.  Its
                                ;bytes already sit contiguously behind that record's, so only the length grows.
                                ;HL = this step's offset, BC = its length.
  07BA'                         UNDEXT:
  07BA'   C5                    	PUSH	B
  07BB'   D5                    	PUSH	D
  07BC'   E5                    	PUSH	H
  07BD'   3A 0A19'              	LDA	UNDTY
  07C0'   FE 01                 	CPI	UR_INS
  07C2'   C2 080C'              	JNZ	UNDXNO		; only inserts fold
  07C5'   3A 0A12'              	LDA	UNDN
  07C8'   B7                    	ORA	A
  07C9'   CA 080C'              	JZ	UNDXNO		; nothing to fold into
  07CC'   3D                    	DCR	A
  07CD'   CD 07AA'              	CALL	URADDR
  07D0'   22 0A22'              	SHLD	UNDLSA
  07D3'   7E                    	MOV	A,M
  07D4'   FE 01                 	CPI	UR_INS
  07D6'   C2 080C'              	JNZ	UNDXNO
  07D9'   2A 0A22'              	LHLD	UNDLSA
  07DC'   23                    	INX	H
  07DD'   CD 0570'              	CALL	LDHLI		; HL = the last record's offset
  07E0'   EB                    	XCHG
  07E1'   2A 0A22'              	LHLD	UNDLSA
  07E4'   23                    	INX	H
  07E5'   23                    	INX	H
  07E6'   23                    	INX	H
  07E7'   CD 0570'              	CALL	LDHLI		; HL = its length
  07EA'   19                    	DAD	D		; HL = where it ends
  07EB'   EB                    	XCHG
  07EC'   E1                    	POP	H
  07ED'   E5                    	PUSH	H		; HL = this step's offset
  07EE'   CD 0575'              	CALL	CMP16		; Z iff this step starts exactly there
  07F1'   C2 080C'              	JNZ	UNDXNO
  07F4'   2A 0A22'              	LHLD	UNDLSA
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  07F7'   23                    	INX	H
  07F8'   23                    	INX	H
  07F9'   23                    	INX	H
  07FA'   E5                    	PUSH	H
  07FB'   CD 0570'              	CALL	LDHLI		; HL = the last record's length
  07FE'   EB                    	XCHG
  07FF'   2A 0A20'              	LHLD	UNDCL
  0802'   19                    	DAD	D		; ... grown by this step's
  0803'   EB                    	XCHG
  0804'   E1                    	POP	H
  0805'   73                    	MOV	M,E
  0806'   23                    	INX	H
  0807'   72                    	MOV	M,D
  0808'   AF                    	XRA	A		; Z: folded, no new record
  0809'   C3 05A2'              	JMP	POPRET
  080C'                         UNDXNO:
  080C'   3E 01                 	MVI	A,1
  080E'   B7                    	ORA	A		; NZ: it needs a record of its own
  080F'   C3 05A2'              	JMP	POPRET
                                
                                ;UNDAPT -- append BC bytes of resident text, from logical offset HL, to the
                                ;undo region.  One byte at a time, re-reading the offset through CHARAT and the
                                ;region through its pointer cell every time, so growing the region (which
                                ;slides regions about) can never leave this loop holding a stale address.
                                ;CY if it outgrows the claim, and the caller then gives the change up.
  0812'                         UNDAPT:
  0812'   78                    	MOV	A,B
  0813'   B1                    	ORA	C
  0814'   C8                    	RZ			; nothing to append
  0815'                         UNDAPL:
  0815'   C5                    	PUSH	B
  0816'   E5                    	PUSH	H
  0817'   CD 0608'              	CALL	CHARAT		; A = the text byte at this offset
  081A'   CD 0828'              	CALL	UNDAPB		; ... into the region
  081D'   E1                    	POP	H
  081E'   C1                    	POP	B
  081F'   D8                    	RC
  0820'   23                    	INX	H
  0821'   0B                    	DCX	B
  0822'   78                    	MOV	A,B
  0823'   B1                    	ORA	C
  0824'   C2 0815'              	JNZ	UNDAPL
  0827'   C9                    	RET
                                
                                ;UNDAPB -- put the byte in A into the room UNDGRW claimed.  It does NOT grow
                                ;the region -- see UNDGRW -- so CY, and the change given up on, once the room
                                ;is used up: a change bigger than the region is simply not undoable.
  0828'                         UNDAPB:
  0828'   C5                    	PUSH	B
  0829'   D5                    	PUSH	D
  082A'   E5                    	PUSH	H
  082B'   32 0A28'              	STA	UNDB1
  082E'   21 09E0'              	LXI	H,UBEG
  0831'   CD 04A3'              	CALL	PRSPAN		; BC = the region's size
  0834'   2A 0A26'              	LHLD	UNDPTR
  0837'   EB                    	XCHG			; DE = where the next byte goes
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0838'   60                    	MOV	H,B
  0839'   69                    	MOV	L,C
  083A'   CD 0575'              	CALL	CMP16		; CY iff that is still inside the region
  083D'   D2 0853'              	JNC	UNDAPF
  0840'   2A 09E0'              	LHLD	UBEG		; re-read: a relocation moves the region
  0843'   19                    	DAD	D
  0844'   3A 0A28'              	LDA	UNDB1
  0847'   77                    	MOV	M,A
  0848'   2A 0A26'              	LHLD	UNDPTR
  084B'   23                    	INX	H
  084C'   22 0A26'              	SHLD	UNDPTR
  084F'   B7                    	ORA	A		; CY clear: it went in
  0850'   C3 05A2'              	JMP	POPRET
  0853'                         UNDAPF:
  0853'   3E 01                 	MVI	A,1
  0855'   32 0A14'              	STA	UNDBAD
  0858'   37                    	STC
  0859'   C3 05A2'              	JMP	POPRET
                                
                                ;UNDRM -- CY, and the change given up on, unless the arena still holds UNDRSV
                                ;free.  The capture must never page: paging moves the window off the change and
                                ;would invalidate every logical offset the records hold.  Keeping this much
                                ;free also keeps MKGAP off its MKROOM path, so the capture cannot page even by
                                ;accident, and it fails QUIETLY where QROOM raises 'QBUF FULL' -- undo going
                                ;away must never stop the editing.
  085C'                         UNDRM:
  085C'   C5                    	PUSH	B
  085D'   D5                    	PUSH	D
  085E'   E5                    	PUSH	H
  085F'   CD 043D'              	CALL	BUFSUM		; DE = the arena's free bytes
  0862'   21 0200               	LXI	H,UNDRSV
  0865'   CD 0575'              	CALL	CMP16		; CY iff less than that is left
  0868'   D2 05A2'              	JNC	POPRET
  086B'   3E 01                 	MVI	A,1
  086D'   32 0A14'              	STA	UNDBAD
  0870'   37                    	STC
  0871'   C3 05A2'              	JMP	POPRET
                                
                                ;---------------------------------------------------------------- the replay
                                
                                ;UNDO -- 'u'.  CY when there is nothing to undo: no change captured, a change
                                ;too big to have been captured, or the pager has moved the window off it.
  0874'                         UNDO:
  0874'   AF                    	XRA	A
  0875'   32 0A18'              	STA	UNDWHY		; refused for want of a change, until told else
  0878'   3A 0A12'              	LDA	UNDN
  087B'   B7                    	ORA	A
  087C'   37                    	STC
  087D'   C8                    	RZ			; nothing captured
  087E'   3A 0A14'              	LDA	UNDBAD
  0881'   B7                    	ORA	A
  0882'   CA 088C'              	JZ	UND_OK
  0885'   3E 02                 	MVI	A,2
  0887'   32 0A18'              	STA	UNDWHY		; too big to have been captured: CMD.MAC says
  088A'   37                    	STC			;   so, rather than ringing the bell at a user
  088B'   C9                    	RET			;   who has no way to know why
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  088C'                         UND_OK:
  088C'   2A 0000*              	LHLD	PGTOPM
  088F'   EB                    	XCHG
  0890'   2A 0A24'              	LHLD	UNDPG
  0893'   CD 0575'              	CALL	CMP16
  0896'   C2 08BD'              	JNZ	UNDPGD		; the pager has moved the window's top since,
                                				;   so every offset the records hold has shifted
  0899'   3E 01                 	MVI	A,1
  089B'   32 0A16'              	STA	UNDRPL		; the replay's own edits are not a new change
  089E'   3A 0A13'              	LDA	UNDST
  08A1'   FE 01                 	CPI	1
  08A3'   CA 08C4'              	JZ	UNDREV
                                	;--- the last 'u' undid it: apply the records forward again (a redo) ---
  08A6'   AF                    	XRA	A
  08A7'   32 0A17'              	STA	UNDDIR
  08AA'   AF                    	XRA	A
  08AB'                         UNDFWL:
  08AB'   CD 08E5'              	CALL	URSTEP
  08AE'   3C                    	INR	A
  08AF'   47                    	MOV	B,A
  08B0'   3A 0A12'              	LDA	UNDN
  08B3'   B8                    	CMP	B
  08B4'   78                    	MOV	A,B
  08B5'   C2 08AB'              	JNZ	UNDFWL
  08B8'   3E 01                 	MVI	A,1
  08BA'   C3 08D6'              	JMP	UNDFIN
  08BD'                         UNDPGD:
  08BD'   3E 01                 	MVI	A,1
  08BF'   32 0A18'              	STA	UNDWHY		; the change is no longer in the window
  08C2'   37                    	STC
  08C3'   C9                    	RET
  08C4'                         UNDREV:
                                	;--- undo: the records backward, each one's inverse ---
  08C4'   3E 01                 	MVI	A,1
  08C6'   32 0A17'              	STA	UNDDIR
  08C9'   3A 0A12'              	LDA	UNDN
  08CC'                         UNDRVL:
  08CC'   3D                    	DCR	A
  08CD'   CD 08E5'              	CALL	URSTEP
  08D0'   B7                    	ORA	A
  08D1'   C2 08CC'              	JNZ	UNDRVL
  08D4'   3E 02                 	MVI	A,2
  08D6'                         UNDFIN:
  08D6'   32 0A13'              	STA	UNDST
  08D9'   AF                    	XRA	A
  08DA'   32 0A16'              	STA	UNDRPL
                                	;--- the cursor goes back where the command that changed it began:
                                	;    measured from vim, which restores that and not the change's own
                                	;    offset (CMD.MAC's VC_UNDO holds it inside the line) ---
  08DD'   2A 0A2B'              	LHLD	UNDCUR
  08E0'   CD 061E'              	CALL	GOTO
  08E3'   B7                    	ORA	A		; CY clear: it happened
  08E4'   C9                    	RET
                                
                                ;URSTEP -- apply record A: as it stands when UNDDIR is 0 (a redo), inverted
                                ;when it is 1 (an undo).  An insert applied puts its saved bytes back at its
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


                                ;offset; an insert inverted deletes that many bytes there; a delete is the
                                ;mirror of both.  A is preserved -- UNDO's loops count with it.
  08E5'                         URSTEP:
  08E5'   F5                    	PUSH	PSW
  08E6'   CD 07AA'              	CALL	URADDR
  08E9'   7E                    	MOV	A,M
  08EA'   32 0A19'              	STA	UNDTY
  08ED'   23                    	INX	H
  08EE'   7E                    	MOV	A,M
  08EF'   32 0A1A'              	STA	UNDOF
  08F2'   23                    	INX	H
  08F3'   7E                    	MOV	A,M
  08F4'   32 0A1B'              	STA	UNDOF+1
  08F7'   23                    	INX	H
  08F8'   7E                    	MOV	A,M
  08F9'   32 0A1C'              	STA	UNDLN
  08FC'   23                    	INX	H
  08FD'   7E                    	MOV	A,M
  08FE'   32 0A1D'              	STA	UNDLN+1
  0901'   23                    	INX	H
  0902'   7E                    	MOV	A,M
  0903'   32 0A1E'              	STA	UNDBO
  0906'   23                    	INX	H
  0907'   7E                    	MOV	A,M
  0908'   32 0A1F'              	STA	UNDBO+1
  090B'   3A 0A19'              	LDA	UNDTY
  090E'   47                    	MOV	B,A
  090F'   3A 0A17'              	LDA	UNDDIR
  0912'   B7                    	ORA	A
  0913'   CA 091F'              	JZ	URS_AP
  0916'   78                    	MOV	A,B		; an undo inverts the record
  0917'   FE 01                 	CPI	UR_INS
  0919'   CA 0925'              	JZ	URS_DL
  091C'   C3 0933'              	JMP	URS_IN
  091F'                         URS_AP:
  091F'   78                    	MOV	A,B		; a redo applies it as it stands
  0920'   FE 01                 	CPI	UR_INS
  0922'   CA 0933'              	JZ	URS_IN
  0925'                         URS_DL:
                                	;--- take the record's length back out at its offset ---
  0925'   2A 0A1A'              	LHLD	UNDOF
  0928'   CD 061E'              	CALL	GOTO
  092B'   2A 0A1C'              	LHLD	UNDLN
  092E'   CD 0679'              	CALL	DELFWD
  0931'   F1                    	POP	PSW
  0932'   C9                    	RET
  0933'                         URS_IN:
                                	;--- put the record's saved bytes back in at its offset ---
  0933'   2A 0A1A'              	LHLD	UNDOF
  0936'   CD 061E'              	CALL	GOTO
  0939'   2A 0A1C'              	LHLD	UNDLN
  093C'   44                    	MOV	B,H
  093D'   4D                    	MOV	C,L
  093E'   2A 0A1E'              	LHLD	UNDBO
  0941'                         URSILP:
  0941'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0942'   E5                    	PUSH	H
  0943'   EB                    	XCHG			; DE = the byte's offset within the region
  0944'   2A 09E0'              	LHLD	UBEG		; ... re-read every byte: inserting text can
  0947'   19                    	DAD	D		;     slide the region out from under it
  0948'   7E                    	MOV	A,M
  0949'   CD 0045'              	CALL	PUTGAP
  094C'   FE 0A                 	CPI	LF
  094E'   C2 0958'              	JNZ	URSILN
  0951'   2A 0A2D'              	LHLD	LNDLT		; a line end put back is the cursor crossing
  0954'   23                    	INX	H		;   one, and GOTO keeps LNDLT for every move the
  0955'   22 0A2D'              	SHLD	LNDLT		;   replay makes -- so the renderer needs no
  0958'                         URSILN:				;   whole-window rescan to find that out
  0958'   E1                    	POP	H
  0959'   C1                    	POP	B
  095A'   23                    	INX	H
  095B'   0B                    	DCX	B
  095C'   78                    	MOV	A,B
  095D'   B1                    	ORA	C
  095E'   C2 0941'              	JNZ	URSILP
  0961'   F1                    	POP	PSW
  0962'   C9                    	RET
                                
                                ;---------------------------------------------------------------- the hooks
                                
                                ;UNDPUT -- PUTGAP's tail: the one byte now sitting just below the cursor.
  0963'                         UNDPUT:
  0963'   F5                    	PUSH	PSW
  0964'   C5                    	PUSH	B
  0965'   D5                    	PUSH	D
  0966'   E5                    	PUSH	H
  0967'   CD 05CD'              	CALL	CUROFF
  096A'   2B                    	DCX	H
  096B'   01 0001               	LXI	B,1
  096E'   3E 01                 	MVI	A,UR_INS
  0970'   CD 072F'              	CALL	UNDCHG
  0973'   C3 09D1'              	JMP	UNDHX
                                
                                ;UNDGET -- QGET's tail: BC bytes of register now in, the cursor past them.
                                ;UNDINS is the same entry by its general name: INSBLK itself carries NO hook
                                ;(insert mode records a byte at a time through PUTGAP), so a command that
                                ;splices a block in -- ':s' replacing a match -- has to say so itself, exactly
                                ;as QGET does.  Without it 'u' puts the deleted text back and leaves the
                                ;inserted text there ('a-a-a' undid to 'aZ-aZ-aZ').
  0976'                         UNDINS:
  0976'                         UNDGET:
  0976'   F5                    	PUSH	PSW
  0977'   C5                    	PUSH	B
  0978'   D5                    	PUSH	D
  0979'   E5                    	PUSH	H
  097A'   78                    	MOV	A,B
  097B'   B1                    	ORA	C
  097C'   CA 09D1'              	JZ	UNDHX
  097F'   CD 05CD'              	CALL	CUROFF
  0982'   50                    	MOV	D,B
  0983'   59                    	MOV	E,C
  0984'   CD 0557'              	CALL	SUBHD		; HL = where the put began
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0987'   3E 01                 	MVI	A,UR_INS
  0989'   CD 072F'              	CALL	UNDCHG
  098C'   C3 09D1'              	JMP	UNDHX
                                
                                ;UNDDLF -- DELFWD's head: HL bytes about to go forward from the cursor.
  098F'                         UNDDLF:
  098F'   F5                    	PUSH	PSW
  0990'   C5                    	PUSH	B
  0991'   D5                    	PUSH	D
  0992'   E5                    	PUSH	H
  0993'   44                    	MOV	B,H
  0994'   4D                    	MOV	C,L
  0995'   CD 05CD'              	CALL	CUROFF
  0998'   3E 02                 	MVI	A,UR_DEL
  099A'   CD 072F'              	CALL	UNDCHG
  099D'   C3 09D1'              	JMP	UNDHX
                                
                                ;UNDDLQ -- QPUTLN's head: BC bytes of whole lines about to go into the register.
  09A0'                         UNDDLQ:
  09A0'   F5                    	PUSH	PSW
  09A1'   C5                    	PUSH	B
  09A2'   D5                    	PUSH	D
  09A3'   E5                    	PUSH	H
  09A4'   CD 05CD'              	CALL	CUROFF
  09A7'   3E 02                 	MVI	A,UR_DEL
  09A9'   CD 072F'              	CALL	UNDCHG
  09AC'   C3 09D1'              	JMP	UNDHX
                                
                                ;UNDDLP -- DELPRV's head: the one byte just below the cursor, about to go.
  09AF'                         UNDDLP:
  09AF'   F5                    	PUSH	PSW
  09B0'   C5                    	PUSH	B
  09B1'   D5                    	PUSH	D
  09B2'   E5                    	PUSH	H
  09B3'   CD 05CD'              	CALL	CUROFF
  09B6'   2B                    	DCX	H
  09B7'   01 0001               	LXI	B,1
  09BA'   3E 02                 	MVI	A,UR_DEL
  09BC'   CD 072F'              	CALL	UNDCHG
  09BF'   C3 09D1'              	JMP	UNDHX
                                
                                ;UNDUDF -- UNDELF's tail: the byte DELTO just made text again, at the cursor.
  09C2'                         UNDUDF:
  09C2'   F5                    	PUSH	PSW
  09C3'   C5                    	PUSH	B
  09C4'   D5                    	PUSH	D
  09C5'   E5                    	PUSH	H
  09C6'   CD 05CD'              	CALL	CUROFF
  09C9'   01 0001               	LXI	B,1
  09CC'   3E 01                 	MVI	A,UR_INS
  09CE'   CD 072F'              	CALL	UNDCHG
                                ;UNDHX -- every hook leaves the primitive's own registers and flags alone.
  09D1'                         UNDHX:
  09D1'   E1                    	POP	H
  09D2'   D1                    	POP	D
  09D3'   C1                    	POP	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  09D4'   F1                    	POP	PSW
  09D5'   C9                    	RET
                                
                                ;============================================================
                                ; DATA -- the (base,limit) pointer row (WM 6828-6871 layout) + scratch.
                                ; The disassembly's DB values for these cells are aliased code bytes; only the
                                ; order/adjacency is authoritative.  BINIT sets every cell at run time.
                                ;============================================================
  09D6'   0000                  BUFBEG: DW	0		; region-array base
  09D8'   0000                  QBEG:	DW	0		; ^Q scratch buffer begin
  09DA'   0000                  QEND:	DW	0		; ^Q scratch buffer end
  09DC'   0000                  HOLEQP:	 DW	 0
  09DE'   0000                  TXTBAS: DW	0		; text base = PBEGMEM+1 (past the 0 sentinel)
                                ;UBEG/UEND -- APPENDED: the undo region, a region of the arena like the Q
                                ;buffer, with UEND its insertion point.  It goes HERE, between the slider and
                                ;the text, so both of the row's interleaved walks stay aligned: the holes from
                                ;BUFBEG are (BUFBEG,QBEG) (QEND,HOLEQP) (TXTBAS,UBEG) (UEND,TXTBEG)
                                ;(GAPBEG,GAPEND) (TXTEND,BUFEND), and the data regions from QBEG are
                                ;(QBEG,QEND) (HOLEQP,TXTBAS) (UBEG,UEND) (TXTBEG,GAPBEG) (GAPEND,TXTEND).
                                ;NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN, PRSPAN and INIBAS's count are all
                                ;untouched by it; INIGAP empties it.
  09E0'   0000                  UBEG:	DW	0		; undo region begin
  09E2'   0000                  UEND:	DW	0		; undo region end = its insertion point
  09E4'   0000                  TXTBEG: DW	0		; window start
  09E6'   0000                  GAPBEG: DW	0		; cursor / gap start
  09E8'   0000                  GAPEND: DW	0		; gap end / first char after cursor
  09EA'   0000                  TXTEND: DW	0		; window end
  09EB'                         PRTERM	 EQU	 TXTEND+1	 ; NEXTPR terminator = high byte of TXTEND
  09EC'   0000                  BUFEND: DW	0		; top of usable text RAM
  09ED'                         MVGTOP	 EQU	 BUFEND+1	 ; MOVGAP upper bound = high byte of BUFEND
                                
  09EE'   00                    ERRFLG: DB	0		; nonzero after ERRMSG fired (harness reads it)
                                
                                ;The search pattern, in WM's SRCHBUF layout (WM 6900): the length, then the
                                ;string, 0-terminated.  CMD.MAC fills it from the '/' line and passes DE =
                                ;SRCHST; FWDCNT reads the length from the byte below that, as WM does.
  09EF'   1E                    SRCMAX: DB	SRMAX		; ... its capacity, so CMD.MAC cannot drift
  09F0'   00                    SRCHBF: DB	0		; the pattern length
  09F1'                         SRCHST: DS	SRMAX+1		; the pattern, 0-terminated
                                
  0A10'   0000                  L2756:	DW	0		; WM L2756 -- GOLINE's last target position
                                ;--- 'u' (undo): see the UNDO section above for how these are driven.
  0A12'   00                    UNDN:	DB	0		; steps captured (0 = nothing to undo)
  0A13'   00                    UNDST:	DB	0		; 0 none, 1 change applied ('u' undoes it),
                                				;   2 already undone ('u' puts it back)
  0A14'   00                    UNDBAD: DB	0		; 1 = this change was too big to capture
  0A15'   01                    UNDNEW: DB	1		; 1 = the next capture starts a new change
  0A16'   00                    UNDRPL: DB	0		; 1 = 'u' replaying, so nothing is captured
  0A17'   00                    UNDDIR: DB	0		; the replay's direction (0 forward, 1 inverse)
  0A18'   00                    UNDWHY: DB	0		; 0 = nothing to undo, 1 = it has paged away
  0A19'   00                    UNDTY:	DB	0		; the step / record type being handled
  0A1A'   0000                  UNDOF:	DW	0		; ... its logical offset
  0A1C'   0000                  UNDLN:	DW	0		; ... its length
  0A1E'   0000                  UNDBO:	DW	0		; ... where its bytes lie in the region
  0A20'   0000                  UNDCL:	DW	0		; the length being captured (BC does not survive)
  0A22'   0000                  UNDLSA: DW	0		; the last record's address (UNDEXT's scratch)
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0A24'   0000                  UNDPG:	DW	0		; PGTOPM when this change was captured
  0A26'   0000                  UNDPTR: DW	0		; the region's write point, as an OFFSET
  0A28'   00                    UNDB1:	DB	0		; the byte going in (PRSPAN wants BC)
  0A29'   0000                  UNDPCU: DW	0		; the cursor as the current command began
  0A2B'   0000                  UNDCUR: DW	0		; ... as the command that made THIS change began
                                
  0A2D'   0000                  LNDLT:	DW	0		; (appended) lines the cursor moved since the last
                                				;   screen layout (signed; SCRN.MAC consumes it)
                                
                                ;PBEGMEM -- base of the text arena: the first RAM byte past everything the
                                ;program holds.  The gap buffer's text lives from here up to BUFEND.  BUF
                                ;links last but RSV.MAC links after it, holding the reserve block in the RAM
                                ;immediately above the image (it emits no bytes of its own), so the arena
                                ;starts at RSVTOP -- past the reserves -- and is the size it always was.
  0A2F'   0000*                 PBEGMEM:DW	RSVTOP
                                
  0A31'                         MEMBAS:				; top of the linked image (RSV.MAC's base)
                                
                                	END
